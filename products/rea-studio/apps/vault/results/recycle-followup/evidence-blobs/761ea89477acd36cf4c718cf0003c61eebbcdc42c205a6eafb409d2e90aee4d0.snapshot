import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import{fileURLToPath}from'node:url';import{createHash}from'node:crypto';
const root=fileURLToPath(new URL('./',import.meta.url)),stage=fileURLToPath(new URL('../keepass-recycle-bin-generation-fix-next/',import.meta.url)),old=fileURLToPath(new URL('../keepass-recycle-independent-review/',import.meta.url)),hash=b=>createHash('sha256').update(b).digest('hex');
const identity=async rel=>{const b=await fs.readFile(path.join(root,rel));return{path:rel,bytes:b.length,sha256:hash(b)};};const before=JSON.parse(await fs.readFile(path.join(root,'source-before.json')));
const manifestBytes=await fs.readFile(path.join(stage,'manifest.json')),receiptBytes=await fs.readFile(path.join(stage,'validation.json'));assert.equal(hash(manifestBytes),before.manifest.sha256);assert.equal(hash(receiptBytes),before.receipt.sha256);const rows=JSON.parse(manifestBytes).records;for(const r of rows){const b=await fs.readFile(path.join(stage,r.path));assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);}
async function names(dir=stage,prefix=''){let out=[];for(const e of await fs.readdir(dir,{withFileTypes:true})){assert.equal(e.isSymbolicLink(),false);const rel=prefix+e.name;if(e.isDirectory()){if(rel!=='.local')out.push(...await names(path.join(dir,e.name),rel+'/'));}else if(!['manifest.json','freeze.json'].includes(rel))out.push(rel);}return out;}assert.deepEqual((await names()).sort(),rows.map(r=>r.path).sort());
const oldManifest=await fs.readFile(path.join(old,'review-manifest.json'));assert.equal(hash(oldManifest),before.priorReviewManifest.sha256);for(const r of JSON.parse(oldManifest).files){const b=await fs.readFile(path.join(old,r.path));assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);}
const test=await identity('bin-boundaries.test.mjs');assert.equal(test.sha256,'c095a6eadde6805eac2f7b50806f695aa95aa2794f8d86d5024aa7a80653354a');const out=await fs.readFile(path.join(root,'stdout.txt'),'utf8');for(const[n,value]of[['tests',7],['pass',7],['fail',0],['skipped',0]])assert.equal(Number(new RegExp('^# '+n+' (\\d+)$','m').exec(out)?.[1]),value);
const host=JSON.parse(await fs.readFile(path.join(root,'browser-host.json')));assert.equal(host.sourceStage,'work/keepass-recycle-bin-generation-fix-next');assert.equal(host.ownedSyntheticOnly,true);assert.equal(await fs.stat(host.dataDir).then(()=>true,()=>false),false);
const browser={schema:'rea-private-recycle-bin-correction-browser/v1',at:new Date().toISOString(),host,actualBrowser:'Chrome extension agent-created tab1647945729, closed',scope:['confirmed recycle','masked readonly preview','confirmed previous-group restore','retained one history row','lock/unlock/reopen persistence'],screenshots:await Promise.all(['browser-preview.png','browser-history.png','browser-reopened-history.png'].map(identity)),accessibility:await Promise.all(['browser-preview.txt','browser-history.txt','browser-reopened-history.txt'].map(identity)),delayedBrowserHTTPCases:0,hostNormalExit:0,hostClosed:true,syntheticTempRemoved:true,userHostsTouched:false};await fs.writeFile(path.join(root,'browser-validation.json'),JSON.stringify(browser,null,2)+'\n',{flag:'wx'});
const after={at:new Date().toISOString(),candidate:before.candidate,all208Exact:true,strictInventory:true,priorIndependent61Exact:true,runtime:before.runtime};await fs.writeFile(path.join(root,'source-after.json'),JSON.stringify(after,null,2)+'\n',{flag:'wx'});
const receipt={schema:'rea-independent-vault-bin-generation-fix-review/v1',at:new Date().toISOString(),candidate:before.candidate,candidateReceipt:before.receipt,candidateManifest:before.manifest,sourceBefore:await identity('source-before.json'),sourceAfter:await identity('source-after.json'),runtime:before.runtime,counts:{tests:7,pass:7,fail:0,skips:0,unchangedOriginalIndependentCases:5,newConfirmationControls:2,newOriginalAssemblyExecutions:0,ownedActualBrowserHosts:1,actualNormalBrowserWorkflow:1,delayedBrowserHTTP:0},exactTest:test,helper:await identity('ui-helper.mjs'),newTest:await identity('confirmation-controls.test.mjs'),stdout:await identity('stdout.txt'),stderr:await identity('stderr.txt'),browser:await identity('browser-validation.json'),oldIndependentReview:{path:'work/keepass-recycle-independent-review',receiptSha256:'6f142bc4a2c6e7df42b00bc23d586924684cbb768ff326f40434382a3d52d36c',manifestSha256:before.priorReviewManifest.sha256,all61Unchanged:true},changeVerified:'Exactly two post-active-list viewCurrent→binCurrent substitutions; backend five bytes unchanged.',failedAuthorAdjacentDiagnostic:'Invalid stale-token premise, not a confirmed preview-loss case; no extra counter.',resolvedFiniteOriginalFailures:3,acceptance:'Finite two-guard correction accepted for root integration review; current production tests/publication remain root-owned.',harnessFailure:'manifest-schema-v1 preserved; no candidate runtime case executed until corrected.',productionModified:false,authorStageModified:false,priorEvidenceRebound:false,fullCompatibility:false,securityParity:false,performanceClaim:false};await fs.writeFile(path.join(root,'review-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
async function walk(dir=root,prefix=''){let files=[];for(const e of await fs.readdir(dir,{withFileTypes:true})){assert.equal(e.isSymbolicLink(),false);const rel=prefix+e.name;if(e.isDirectory())files.push(...await walk(path.join(dir,e.name),rel+'/'));else if(!['review-manifest.json','review-freeze.json'].includes(rel))files.push(await identity(rel));}return files;}
const files=(await walk()).sort((a,b)=>a.path.localeCompare(b.path));await fs.writeFile(path.join(root,'review-manifest.json'),JSON.stringify({schema:'rea-strict-fix-independent-review-preservation/v1',files,excludes:['review-manifest.json','review-freeze.json']},null,2)+'\n',{flag:'wx'});const freeze={at:new Date().toISOString(),validation:await identity('review-validation.json'),manifest:await identity('review-manifest.json'),files:files.length};await fs.writeFile(path.join(root,'review-freeze.json'),JSON.stringify(freeze,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(freeze));
