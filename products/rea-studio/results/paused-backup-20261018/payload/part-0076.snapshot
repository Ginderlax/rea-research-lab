    {
      "id": "grafana.candidate.9126fd79eb2b26b30c63",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Editing and saving an alert rule resets its state to **Normal**. The rule re-enters **Pending** or **Alerting** on the next evaluation if the condition is still met. This is standard [Grafana Alerting](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/alerting/) behavior and isn't specific to the Loki data source.",
      "headingPath": [
        "Loki alerting",
        "Best practices",
        "Handle no data versus zero results"
