import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{spawn}from'node:child_process';import{createHash}from'node:crypto';
const here=import.meta.dirname,workspace=path.resolve(here,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),studio=path.join(repo,'products/rea-studio'),hash=b=>createHash('sha256').update(b).digest('hex'),ident=async p=>{const b=await fs.readFile(p);return{bytes:b.length,sha256:hash(b)}},write=async(n,x)=>fs.writeFile(path.join(here,n),JSON.stringify(x,null,2)+'\n',{flag:'wx'});
const installationPath='work/editor-save-production-installation/installation.json',ib=await fs.readFile(path.join(workspace,installationPath));assert.equal(hash(ib),'498973b4e5f9fdcfa1df8d43b069a340836ece2c9d218f8d3dde0b1808c44907');const installation=JSON.parse(ib);assert.equal(installation.installed.length,8);for(const r of installation.installed)assert.deepEqual(await ident(path.join(repo,r.destination)),r.after);
const planPath='work/editor-save-publication-plan',mb=await fs.readFile(path.join(workspace,planPath,'freeze-manifest.json'));assert.equal(hash(mb),'3df49c5e2c5b28433876d8cbd759eed74375031d92db8aa43af761fbada32c91');const selection=JSON.parse(await fs.readFile(path.join(workspace,planPath,'proposed-focused-selection.json'))),tests=selection.expandedEditorSelection;assert.equal(tests.length,15);assert.equal(new Set(tests).size,15);assert.equal(selection.expandedEditorRegistrations,78);
async function walk(base,prefix=''){const rows=[];for(const e of await fs.readdir(base,{withFileTypes:true})){assert(!e.isSymbolicLink());if(e.isDirectory()){if(!['results','.local'].includes(e.name))rows.push(...await walk(path.join(base,e.name),prefix+e.name+'/'));}else rows.push(prefix+e.name);}return rows.sort();}
const paths=['server.mjs','catalog.mjs','package.json',...(await walk(path.join(studio,'lib'))).map(p=>'lib/'+p),...(await walk(path.join(studio,'public'))).map(p=>'public/'+p),...(await walk(path.join(studio,'apps/editor'))).map(p=>'apps/editor/'+p)];const before=[];for(const rel of paths){const b=await fs.readFile(path.join(studio,rel)),repoRelative='products/rea-studio/'+rel,snapshot='sources/'+repoRelative+'.snapshot';await fs.mkdir(path.dirname(path.join(here,snapshot)),{recursive:true});await fs.writeFile(path.join(here,snapshot),b,{flag:'wx'});before.push({path:repoRelative,bytes:b.length,sha256:hash(b),snapshot});}await write('sources.before.json',before);
const startedAt=new Date().toISOString(),runner=await ident(path.join(here,'run-current.mjs')),node=await ident(process.execPath),env={...process.env};delete env.NODE_TEST_CONTEXT;const p=spawn(process.execPath,['--test','--test-concurrency=1','--test-reporter=tap',...tests],{cwd:studio,env,windowsHide:true,stdio:['ignore','pipe','pipe']}),chunks={stdout:[],stderr:[]},sizes={stdout:0,stderr:0};let problem=null;const stop=s=>{problem??=s;p.kill();},deadline=setTimeout(()=>stop('Test controller120-second deadline'),120000);for(const name of['stdout','stderr'])p[name].on('data',b=>{sizes[name]+=b.length;if(sizes[name]>8*1024*1024)stop('Captured stream exceeds8MiB');else chunks[name].push(b)});p.once('error',e=>problem??=e.message);const ended=await new Promise(r=>p.once('close',(code,signal)=>r({code,signal})));clearTimeout(deadline);const stdout=Buffer.concat(chunks.stdout).toString('utf8'),stderr=Buffer.concat(chunks.stderr).toString('utf8');await fs.writeFile(path.join(here,'tests.stdout.txt'),stdout,{flag:'wx'});await fs.writeFile(path.join(here,'tests.stderr.txt'),stderr,{flag:'wx'});const counts=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(k=>[k,Number(stdout.match(new RegExp('^# '+k+' (\\d+)$','m'))?.[1])]));const after=[];for(const r of before){const current=await ident(path.join(repo,r.path));after.push({...r,...current});assert.deepEqual(current,{bytes:r.bytes,sha256:r.sha256});}assert.deepEqual(before,after);await write('sources.after.json',after);assert.deepEqual(await ident(path.join(here,'run-current.mjs')),runner);assert.deepEqual(await ident(path.join(workspace,installationPath)),{bytes:ib.length,sha256:hash(ib)});
const result={schema:'rea-editor-save-current-integration-validation/v1',startedAt,completedAt:new Date().toISOString(),status:ended.code===0&&counts.tests===78&&counts.pass===78?'passed-finite-current-editor-selection':'failed-current-selection',counts,exitCode:ended.code,signal:ended.signal,problem,sourceStable:true,currentSources:before,selectedTests:tests,selectedTestFiles:15,controller:{pid:p.pid,deadlineMilliseconds:120000,maxCapturePerStreamBytes:8388608,closed:true},runner:{path:'run-current.mjs',...runner},runtime:{path:process.execPath,version:process.version,...node},installation:{path:installationPath,bytes:ib.length,sha256:hash(ib)},raw:{stdout:{path:'tests.stdout.txt',...await ident(path.join(here,'tests.stdout.txt'))},stderr:{path:'tests.stderr.txt',...await ident(path.join(here,'tests.stderr.txt'))}},metadataCorrection:{oldFrozenPlanUnchanged:true,oldProseFiles:16,actualBoundSelectionFiles:15,tests:78,classification:'Finite count/prose correction; not a product fault.'},normalTestsWriteAppsResults:false,historicalStageOrReviewRebound:false,originalEditorEngineOrWorkbenchExecutions:0,benchmarks:0,browserExecutions:0,gitRuntimeTestsIncluded:true,fullProductParity:false,universalSuperiority:false};await write('validation.json',result);console.log(JSON.stringify({counts,sourceStable:true,currentSources:before.length,selectedFiles:15,status:result.status,originalEditorEngine:0,benchmarks:0,controllerClosed:true}));
