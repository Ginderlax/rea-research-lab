import fs from'node:fs/promises';import path from'node:path';import{fileURLToPath}from'node:url';import{createHash}from'node:crypto';
const own=path.dirname(fileURLToPath(import.meta.url)),workspace=path.resolve(own,'../..'),prior=path.join(workspace,'WORK/keepass-group-active-list-fix-next'),sha=b=>createHash('sha256').update(b).digest('hex');
async function write(p,b){const file=path.join(own,p);await fs.mkdir(path.dirname(file),{recursive:true});await fs.writeFile(file,b);}
const epoch=[];for(const name of(await fs.readdir(path.join(own,'products/rea-studio/apps/vault'),{withFileTypes:true})).filter(e=>e.isFile()).map(e=>e.name).sort()){const p='products/rea-studio/apps/vault/'+name,b=await fs.readFile(path.join(own,p));await write('epochs/backend-v1/source/'+p+'.snapshot',b);epoch.push({path:p,bytes:b.length,sha256:sha(b)})}
for(const name of['baseline.json','failure-ledger.json','runs/backend-v1/run.json','runs/backend-v2/run.json','runs/original-v1/run.json','runs/original-v2/run.json']){const b=await fs.readFile(path.join(own,name));await write('epochs/backend-v1/evidence/'+name+'.snapshot',b);epoch.push({path:name,bytes:b.length,sha256:sha(b)})}
await write('epochs/backend-v1/manifest.json',JSON.stringify({schema:'rea-vault-group-edit-backend-epoch/v1',createdAt:new Date().toISOString(),inventory:epoch,accepted:['backend-v2 18/18 zero skips','original-v2 4/4 zero skips, seven actual managed assembly loads'],scope:'Backend candidate preserved before corrected-client UI extension; original GUI/full program zero.'},null,2)+'\n');
const manifestBytes=await fs.readFile(path.join(prior,'manifest.json'));if(sha(manifestBytes)!=='d24b555cc9f35f4720920d385c97496803e787f69f76caca4af0fcf2b4c4acdd')throw new Error('Corrected client343 manifest mismatch');const manifest=JSON.parse(manifestBytes);if(manifest.inventory.length!==343)throw new Error('Corrected client343 roster mismatch');for(const row of manifest.inventory){const b=await fs.readFile(path.join(prior,row.path));if(b.length!==row.bytes||sha(b)!==row.sha256)throw new Error('Corrected client343 inventory mismatch '+row.path)}
const client=await fs.readFile(path.join(prior,'products/rea-studio/apps/vault/client.mjs'));if(client.length!==24831||sha(client)!=='6409badcd044cadc07d17edd4d749165f5cd5498d206f946f299da48d05477a5')throw new Error('Corrected client mismatch');await write('authority/client343/manifest.json.snapshot',manifestBytes);await write('authority/client343/client.mjs.snapshot',client);await write('products/rea-studio/apps/vault/client.mjs',client);await write('ui-baseline.json',JSON.stringify({schema:'rea-vault-group-edit-ui-baseline/v1',createdAt:new Date().toISOString(),source:'WORK/keepass-group-active-list-fix-next',manifestSha256:sha(manifestBytes),verifiedInventoryCount:343,client:{bytes:client.length,sha256:sha(client)},backendEpoch:'epochs/backend-v1/manifest.json'},null,2)+'\n');console.log(JSON.stringify({backendEpochFiles:epoch.length,correctedClientVerified:343}));
