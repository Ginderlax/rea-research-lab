    },
    {
      "id": "grafana.candidate.169149e2f4b69c8831c5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In environments where network address translation (NAT) is used, ensure you use the network interface address and not a final public address; otherwise, you might see errors such as `bind: cannot assign requested address` in the logs.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[server]`",
        "`http_addr`"
      ],
      "source": {
