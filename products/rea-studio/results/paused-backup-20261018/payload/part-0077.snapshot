    },
    {
      "id": "grafana.candidate.6900cedb3bc1f3b55d03",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana requires a database to store its configuration data, such as users, data sources, and dashboards. The exact requirements depend on the size of the Grafana installation and the features you use.",
      "headingPath": [
        "Install Grafana",
