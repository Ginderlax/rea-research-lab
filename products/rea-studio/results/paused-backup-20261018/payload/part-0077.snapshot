    {
      "id": "grafana.candidate.d208184a0b8df6191529",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The anonymous devices feature enhances the management and monitoring of anonymous access within your Grafana instance. This feature is part of ongoing efforts to provide more control and transparency over anonymous usage.",
      "headingPath": [
        "Anonymous authentication",
        "Anonymous devices"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/anonymous-auth/index.md",
