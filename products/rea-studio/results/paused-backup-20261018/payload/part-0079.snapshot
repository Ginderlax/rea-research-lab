    },
    {
      "id": "grafana.candidate.c34473bf102b479b28ec",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We've added support for many new query types, including: SLO/SLI Values, RUM data, Events, and monitor group status.",
      "headingPath": [
        "What's new in Grafana v9.4",
        "Enterprise Datasources",
        "DataDog Datasource"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-4.md",
        "gitBlobSha": "45ce56665ca4f35f5a04a6213b45a29d1a3ddfc8",
        "sha256": "0149bcb00d079050a094ddb9bace1bde360efead88bd7cff979538dbd3130f77",
        "lineStart": 278,
        "lineEnd": 278,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v9-4.md#L278-L278"
      },
