    {
      "id": "grafana.candidate.89f8f0c4f5c286dd6318",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "URL to a remote HTTP image renderer service, for example, `http://localhost:8081/render`, that Grafana can use to render panels and dashboards to PNG-images using HTTP requests to an external service.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[rendering]`",
        "`server_url`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
