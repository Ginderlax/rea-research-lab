    {
      "id": "grafana.candidate.31593f3a216fdebbab6a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Produces an error or data depending on the **String Input** and **Error type** fields. When the **String Input** field is empty, the scenario triggers the selected error type. When the field contains CSV values (default: `1,20,90,30,5,0`), it returns time-series data like the CSV Metric Values scenario, regardless of the error type.",
      "headingPath": [
        "TestData query editor",
