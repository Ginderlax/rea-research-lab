    {
      "id": "grafana.candidate.8cc0066f8ba306450303",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Select **Slow Query** and set the **String Input** field to a duration longer than your evaluation interval (for example, `30s` for a rule evaluated every `10s`). The default delay is `5s`. Use this to verify timeout behavior and confirm that alerts transition to the expected state when queries take too long.",
      "headingPath": [
        "TestData alerting",
        "Test error and no-data conditions",
        "Timeouts"
      ],
      "source": {
        "path": "docs/sources/datasources/testdata/alerting/index.md",
