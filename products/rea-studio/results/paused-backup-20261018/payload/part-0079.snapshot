    {
      "id": "grafana.candidate.dddd252c339dd4e6ef61",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This transformation combines values from Query A and Query B into a unified table, enhancing the presentation of data for better insights.",
      "headingPath": [
        "Transform data",
        "Transformation functions",
        "Merge series/tables"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/transform-data/index.md",
