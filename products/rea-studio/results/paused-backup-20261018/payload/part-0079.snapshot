    {
      "id": "grafana.candidate.066145ab5e0039136e22",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For more information, refer to [Request security](../../setup-grafana/configure-security/configure-request-security/).",
      "headingPath": [
        "What's new in Grafana v7.4",
        "Grafana Enterprise features",
        "Request security"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-4.md",
