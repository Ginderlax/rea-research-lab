import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{spawn}from'node:child_process';const here=import.meta.dirname,repo=path.resolve(here,'../../outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex');async function tree(d,p=''){const out=[];for(const e of await fs.readdir(d,{withFileTypes:true})){assert(!e.isSymbolicLink());if(e.isDirectory())out.push(...await tree(path.join(d,e.name),p+e.name+'/'));else out.push(p+e.name);}return out;}
export async function authenticate(){const scopes=[['sketch-layout-precision-next','freeze-manifest.json','1dd88ded543ef519876546a668ad6e258755a87bf07fd7eb563d4f707b66ffd1',188],['sketch-alignment-next','freeze-manifest.json','4684a6dffad102c461531476d4c24ad8b8eb5783b226aad9bbf82e2b81e0f2c7',277],['sketch-alignment-independent-review','review-manifest.json','fed8216fa2a85da04ea0d2a16750f1fbb3891959f122272adb05222019f85559',111]],rows=[];for(const[d,n,pin,count]of scopes){const root=path.resolve(here,'..',d),b=await fs.readFile(path.join(root,n));assert.equal(sha(b),pin);const m=JSON.parse(b);assert.equal(m.files,count);for(const r of m.records){const x=await fs.readFile(path.join(root,r.path));assert.equal(x.length,r.bytes);assert.equal(sha(x),r.sha256,r.path);}assert.deepEqual((await tree(root)).sort(),[...m.records.map(r=>r.path),n].sort());rows.push({path:'work/'+d,files:count,manifestSHA256:pin});}const baseline=JSON.parse(await fs.readFile(path.join(here,'candidate/source-baseline.json.snapshot')));for(const r of baseline){const b=await fs.readFile(path.join(repo,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256,r.path);}return{at:new Date().toISOString(),scopes:rows,SketchBaseline14:baseline,wholeLabClaim:false};}
if(process.argv[1]===import.meta.filename){const variant=process.argv[2]??'main',tests=variant==='main'?['fresh.test.mjs','replay-review.test.mjs','replay-ui-review.test.mjs']:['replay-fractional-diagnostics.test.mjs'];assert(['main','diagnostic'].includes(variant));const dir=path.join(here,'runs',variant+'-'+new Date().toISOString().replace(/:/g,'-'));await fs.mkdir(dir,{recursive:true});const before=await authenticate(),source=[];for(const p of['run.mjs','original-oracle.mjs','fixtures.mjs',...tests,...(variant==='main'?['replay-ui-fixture.mjs']:[])]){const b=await fs.readFile(path.join(here,p));await fs.mkdir(path.join(dir,'source'),{recursive:true});await fs.writeFile(path.join(dir,'source',p+'.snapshot'),b,{flag:'wx'});source.push({path:p,bytes:b.length,sha256:sha(b)});}await fs.writeFile(path.join(dir,'before.json'),JSON.stringify({before,source},null,2)+'\n');const child=spawn(process.execPath,['--max-old-space-size=256','--test','--test-isolation=none','--test-concurrency=1','--test-reporter=tap',...tests],{cwd:here,env:{...process.env,PRECISION_FRESH_OUTPUT:path.join(dir,'fresh-observations.json'),SKETCH_REVIEW_OBSERVATIONS:path.join(dir,'replay-original-observations.json'),SKETCH_UI_OBSERVATIONS:path.join(dir,'replay-ui-observations.json')},stdio:['ignore','pipe','pipe']}),stdout=[],stderr=[],bytes={stdout:0,stderr:0};let limit=null;for(const[k,stream,cap]of[['stdout',child.stdout,4*1024*1024],['stderr',child.stderr,2*1024*1024]])stream.on('data',b=>{bytes[k]+=b.length;(k==='stdout'?stdout:stderr).push(b);if(bytes[k]>cap){limit=k+' cap';child.kill();}});const timer=setTimeout(()=>{limit='30-second owned child deadline';child.kill();},30000),status=await new Promise((resolve,reject)=>{child.once('error',reject);child.once('close',(code,signal)=>resolve({code,signal}));});clearTimeout(timer);await fs.writeFile(path.join(dir,'stdout.txt'),Buffer.concat(stdout));await fs.writeFile(path.join(dir,'stderr.txt'),Buffer.concat(stderr));const after=await authenticate();for(const r of source)assert.equal(sha(await fs.readFile(path.join(here,r.path))),r.sha256);await fs.writeFile(path.join(dir,'run.json'),JSON.stringify({schema:'rea-sketch-precision-independent-run/v1',variant,tests,before,after,source,status,limit,bytes,sourceStable:true,Node:process.version,bounds:{oldSpaceMiB:256,childDeadlineMs:30000,stdoutMiB:4,stderrMiB:2,VMUnitDeadlineMs:500,hardRSSWatchdog:false},originalGUI:0,actualBrowser:0,benchmarks:0},null,2)+'\n');console.log(JSON.stringify({directory:path.relative(here,dir),status,limit,sourceStable:true}));process.exitCode=status.code??1;}
