    },
    {
      "id": "grafana.candidate.e027cd4b332b3db18604",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Template variables in annotations are resolved at query time using the current dashboard variable values.",
      "headingPath": [
