    {
      "id": "grafana.candidate.f0df99cf83a486e71e9a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The time-series value field is named after the sample type from the profile type ID. For example, a query using `process_cpu:samples:count:cpu:nanoseconds` produces a value field named `samples`.",
      "headingPath": [
        "Parca query editor",
        "Metrics query results"
