import test from 'node:test';import assert from 'node:assert/strict';import {fixture,deferred,button,field,openEntry,beginRestore} from './ui-fixture.mjs';
test('same-editor draft typed after a restore request remains visible when the delayed response completes',async t=>{const arrived=deferred(),release=deferred(),f=await fixture(t,'same-editor-restore-draft',async(action,input,real)=>{const result=await real();if(action==='historyRestore'){arrived.resolve();await release.promise;}return result;}),restore=await beginRestore(f.root),pending=restore.start();await arrived.promise;const notes=field(f.root,'Notes');f.observation.notesDisabledWhilePending=notes.disabled;notes.value='Draft typed after restore request was issued';release.resolve();await pending;f.observation.after={title:field(f.root,'Title').value,notes:field(f.root,'Notes').value};assert.equal(f.observation.after.notes,'Draft typed after restore request was issued','An enabled editor must retain a draft typed after request capture, or block editing during the operation.');});
test('same-editor draft typed after a save request remains visible when the delayed response completes',async t=>{const arrived=deferred(),release=deferred(),f=await fixture(t,'same-editor-save-draft',async(action,input,real)=>{const result=await real();if(action==='save'){arrived.resolve();await release.promise;}return result;});await openEntry(f.root,'Entry A');field(f.root,'Notes').value='A submitted edit';const pending=button(f.root,'Save encrypted entry').click();await arrived.promise;const notes=field(f.root,'Notes');f.observation.notesDisabledWhilePending=notes.disabled;notes.value='A subsequent draft while save is pending';release.resolve();await pending;f.observation.after={title:field(f.root,'Title').value,notes:field(f.root,'Notes').value};assert.equal(f.observation.after.notes,'A subsequent draft while save is pending','An enabled editor must retain a subsequent draft or block editing during the operation.');});
