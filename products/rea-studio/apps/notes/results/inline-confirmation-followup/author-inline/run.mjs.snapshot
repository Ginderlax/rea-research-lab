import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath,pathToFileURL} from 'node:url';import {createHash} from 'node:crypto';import {spawn} from 'node:child_process';import assert from 'node:assert/strict';
const root=path.dirname(fileURLToPath(import.meta.url)),studio=path.join(root,'products/rea-studio'),hash=b=>createHash('sha256').update(b).digest('hex'),kind=process.argv[2];assert.ok(['fresh','focused'].includes(kind));
const run=path.join(root,'runs',kind+'-'+new Date().toISOString().replaceAll(':','-'));await fs.mkdir(run,{recursive:true});
const save=async(p,b)=>{const target=path.join(run,p);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b,{flag:'wx'});},json=(p,v)=>save(p,JSON.stringify(v,null,2)+'\n');
const names=(await fs.readdir(path.join(studio,'apps/notes'),{withFileTypes:true})).filter(r=>r.isFile()).map(r=>'apps/notes/'+r.name);for(const r of await fs.readdir(path.join(studio,'apps/notes/fixtures'),{withFileTypes:true}))if(r.isFile())names.push('apps/notes/fixtures/'+r.name);names.push('server.mjs','catalog.mjs','lib/storage.mjs');names.sort();
const stamp=async p=>{const b=await fs.readFile(path.join(studio,p));return{path:p,bytes:b.length,sha256:hash(b)};},before=await Promise.all(names.map(stamp));for(const r of before)await save('source/'+r.path+'.snapshot',await fs.readFile(path.join(studio,r.path)));await json('source-before.json',before);
const legacy=['app.test.mjs','app.integration.test.mjs','jex.test.mjs','notebooks.test.mjs','notebooks.integration.test.mjs','notebook-trash.test.mjs','notebook-trash.integration.test.mjs','notebook-trash.ui.test.mjs','notebook-trash-review.test.mjs','notebook-trash-publication-boundaries.test.mjs','notebook-trash-fresh-boundaries.test.mjs'],selected=kind==='fresh'?['notebook-confirmation.ui.test.mjs']:[...legacy,'notebook-confirmation.ui.test.mjs'],args=['--test','--test-concurrency=1','--test-reporter=tap',...selected.map(n=>'apps/notes/'+n)];
const env={...process.env,NOTES_REVIEW_OUTPUT:pathToFileURL(path.join(run,'observations')+path.sep).href};delete env.NODE_TEST_CONTEXT;const start=new Date().toISOString(),runtime=await fs.readFile(process.execPath);
const result=await new Promise(resolve=>{const p=spawn(process.execPath,args,{cwd:studio,env,shell:false,windowsHide:true,stdio:['ignore','pipe','pipe']}),chunks={stdout:[],stderr:[]},sizes={stdout:0,stderr:0};let error=null;const stop=reason=>{error??=reason;p.kill('SIGKILL');};for(const[name,cap]of[['stdout',8*1024*1024],['stderr',2*1024*1024]])p[name].on('data',b=>{const take=Math.max(0,Math.min(cap-sizes[name],b.length));if(take)chunks[name].push(Buffer.from(b.subarray(0,take)));sizes[name]+=take;if(take!==b.length)stop(name+' retention cap');});const timer=setTimeout(()=>stop('180-second child deadline'),180000);p.on('error',e=>error??=e.message);p.on('close',(code,signal)=>{clearTimeout(timer);resolve({pid:p.pid??null,code,signal,error,sizes,stdout:Buffer.concat(chunks.stdout),stderr:Buffer.concat(chunks.stderr)});});});
const end=new Date().toISOString();await save('tests.stdout.txt',result.stdout);await save('tests.stderr.txt',result.stderr);const after=await Promise.all(names.map(stamp));await json('source-after.json',after);const stable=JSON.stringify(before)===JSON.stringify(after),stdout=result.stdout.toString('utf8'),summary=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(n=>[n,Number(stdout.match(new RegExp('^# '+n+' (\\d+)$','m'))?.[1]??-1)]));
const receipt={schema:'rea-notes-inline-confirmation-candidate-attempt/v1',kind,start,end,durationMs:Date.parse(end)-Date.parse(start),arguments:args,summary,expectedTests:kind==='fresh'?9:68,sourceStable:stable,sourceFiles:before.length,sourceBefore:before,sourceAfter:after,...result,stdout:undefined,stderr:undefined,raw:{stdoutSha256:hash(result.stdout),stderrSha256:hash(result.stderr)},runtime:{node:process.version,exe:process.execPath,sha256:hash(runtime)},limits:{childDeadlineMs:180000,retainedStdoutBytes:8*1024*1024,retainedStderrBytes:2*1024*1024,fingerprintIODedicatedDeadline:false,WindowsAtomicDescendantContainment:false},productionChanged:false,browserExecuted:false,performanceMeasured:false};await json('attempt.json',receipt);console.log(JSON.stringify({run:path.relative(root,run).replaceAll('\\','/'),summary,sourceStable:stable,sourceFiles:before.length,code:result.code,error:result.error,receiptSha256:hash(Buffer.from(JSON.stringify(receipt,null,2)+'\n'))}));if(result.code||result.error||!stable||summary.tests!==receipt.expectedTests||summary.fail||summary.skipped||summary.cancelled)process.exitCode=1;
