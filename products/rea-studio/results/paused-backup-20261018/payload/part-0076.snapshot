    {
      "id": "grafana.candidate.5cfed052cc3636294a54",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A derived field produces a single value per log line, so you can't combine multiple labels or capture groups into one field or link.",
      "headingPath": [
        "Configure the Loki data source",
        "Configure the data source in the UI",
        "Additional settings",
        "Derived fields"
      ],
      "source": {
        "path": "docs/sources/datasources/loki/configure/index.md",
