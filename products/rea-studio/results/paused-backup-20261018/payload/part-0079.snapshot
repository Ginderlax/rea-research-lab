    {
      "id": "grafana.candidate.d1a61f0a21cf489c1a9a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use full URLs for links. When linking to versioned docs, replace the version with the version interpolation placeholder (for example, <GRAFANA_VERSION>, <TEMPO_VERSION>, <MIMIR_VERSION>) so the system can determine the correct set of docs to point to. For example, \"https://grafana.com/docs/grafana/latest/administration/\" becomes \"https://grafana.com/docs/grafana/<GRAFANA_VERSION>/administration/\".",
      "headingPath": [
        "What’s new in Grafana v10.2",
        "Feature"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-2.md",
        "gitBlobSha": "7d4ec24043eb9bcda5315a42539dff326de3311d",
        "sha256": "7b87afe9eb18608849e77d623cc25d90d705d2d30805424878e3a2ce9d2c71b5",
        "lineStart": 33,
        "lineEnd": 33,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-2.md#L33-L33"
      },
