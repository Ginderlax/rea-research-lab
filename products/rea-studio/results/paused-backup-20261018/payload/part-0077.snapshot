    {
      "id": "grafana.candidate.acd496275b0c1850d0eb",
      "syntaxRole": "table-row",
      "sourceText": "| `allowed_groups`         | No       | Yes                | List of comma- or space-separated groups. The user should be a member of at least one group to log in.                                                                                                                                                                                                                                                                                                                                                                                                              |                               |",
      "headingPath": [
        "Configure Okta OIDC authentication",
        "Configuration options"
