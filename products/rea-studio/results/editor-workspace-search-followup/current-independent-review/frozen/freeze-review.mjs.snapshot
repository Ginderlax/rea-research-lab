import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const root=import.meta.dirname,sha=bytes=>createHash('sha256').update(bytes).digest('hex');
async function inventory(folder='',result={}){for(const item of (await fs.readdir(path.join(root,folder),{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const name=folder?folder+'/'+item.name:item.name;if(name==='freeze-manifest.json')continue;assert.ok(!item.isSymbolicLink());if(item.isDirectory())await inventory(name,result);else{assert.ok(item.isFile());const bytes=await fs.readFile(path.join(root,name));result[name]={bytes:bytes.length,sha256:sha(bytes)};}}return result;}
if(process.argv.includes('--verify-only')){const bytes=await fs.readFile(path.join(root,'freeze-manifest.json')),manifest=JSON.parse(bytes);assert.deepEqual(await inventory(),manifest.inventory);console.log(JSON.stringify({status:'exact frozen inventory verified',files:Object.keys(manifest.inventory).length,manifestSHA256:sha(bytes)}));}
else{const rows=await inventory(),receipt=await fs.readFile(path.join(root,'review-validation.json')),manifest={schema:'rea-editor-path-independent-review-freeze/v1',frozenAt:new Date().toISOString(),files:Object.keys(rows).length,totalBytes:Object.values(rows).reduce((sum,row)=>sum+row.bytes,0),receiptSHA256:sha(receipt),inventory:rows};await fs.writeFile(path.join(root,'freeze-manifest.json'),JSON.stringify(manifest,null,2)+'\n',{flag:'wx'});assert.deepEqual(await inventory(),rows);console.log(JSON.stringify({status:'frozen',files:manifest.files,totalBytes:manifest.totalBytes,receiptSHA256:sha(receipt),manifestSHA256:sha(await fs.readFile(path.join(root,'freeze-manifest.json')))}));}
