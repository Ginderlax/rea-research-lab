for r in files:pin(read(E/r['path']),r)
outer=read(RUN/'artifact-12055060226.zip');assert ident(outer)=={'bytes':2259983,'sha256':'01d7f27625788f9ee693a350dab707cc80238b5a2b2aaf7c546887a0686be225'}
with zipfile.ZipFile(io.BytesIO(outer)) as z:
