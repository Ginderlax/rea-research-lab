assert rawmeta['run']['id']==38926216286 and rawmeta['run']['head_sha']==HEAD and rawmeta['run']['conclusion']=='failure'
assert rawmeta['jobs']['total_count']==len(rawmeta['jobs']['jobs'])==2 and all(r['conclusion']=='failure' for r in rawmeta['jobs']['jobs'])
