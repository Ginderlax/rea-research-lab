    },
    {
      "id": "grafana.candidate.e65feb8def7d39eed681",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana comes with built-in support for many data sources. If you need other data sources, you can also install one of the many data source plugins. If the plugin you need doesn't exist, you can develop a custom plugin.",
      "headingPath": [
        "Data sources"
      ],
      "source": {
        "path": "docs/sources/datasources/_index.md",
