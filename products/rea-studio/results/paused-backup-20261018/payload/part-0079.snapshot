    {
      "id": "grafana.candidate.87719976caa56606e461",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use the buttons in the lower right corner to zoom in or out. You can also use the mouse wheel or touchpad scroll, together with either Ctrl or Cmd key to do so.",
      "headingPath": [
        "Node graph",
        "Node graph navigation",
        "Zoom"
      ],
      "source": {
