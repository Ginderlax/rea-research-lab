      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.d9fa0d48dfa8cdeb8b41",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Below is the list of approved, static endpoints and calls for general use. Any other paths are subject to change and are not maintained for general user consumption.",
      "headingPath": [
        "Grafana Cloud API"
      ],
      "source": {
        "path": "docs/sources/developer-resources/api-reference/cloud-api/_index.md",
