    {
      "id": "grafana.candidate.37499d2b007539f5e164",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use full URLs for links. When linking to versioned docs, replace the version with the version interpolation placeholder (for example, <GRAFANA_VERSION>, <TEMPO_VERSION>, <MIMIR_VERSION>) so the system can determine the correct set of docs to point to. For example, \"https://grafana.com/docs/grafana/latest/administration/\" becomes \"https://grafana.com/docs/grafana/<GRAFANA_VERSION>/administration/\".",
      "headingPath": [
        "What’s new in Grafana v10.3",
        "Feature"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-3.md",
        "gitBlobSha": "e43fdcd331e25519da2fbdea223ad59ec4f7ad4c",
        "sha256": "0e1c94c3c83b280306b5bf6a8543bb3a2707c17132691f3d48d3818f08b029c7",
        "lineStart": 38,
        "lineEnd": 38,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-3.md#L38-L38"
