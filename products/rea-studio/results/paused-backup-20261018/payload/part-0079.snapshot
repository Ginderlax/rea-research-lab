        "sha256": "4ac4a4d84503349934037643cc351a7722532a4c4189aab283838810ba2f6731",
        "lineStart": 140,
        "lineEnd": 140,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-0.md#L140-L140"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.302069f2e453045a9029",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Just a quick note**: the upgrade to enable subfolders can cause some issues with alerts in certain cases. We think these cases are pretty rare, but just in case, you’ll want to check for this:",
      "headingPath": [
        "What’s new in Grafana v11.0",
        "Dashboards and visualizations",
        "Subfolders"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-0.md",
