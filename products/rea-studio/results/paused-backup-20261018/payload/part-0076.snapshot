    {
      "id": "grafana.candidate.64fc6125107680ef594f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The standalone plugin requires Grafana 12.3.0 or later. The OpenTSDB data source bundled with Grafana 12.2 and earlier continues to work as before. These versions are unaffected by the externalization.",
      "headingPath": [
        "OpenTSDB data source",
        "Plugin updates"
      ],
      "source": {
        "path": "docs/sources/datasources/opentsdb/_index.md",
