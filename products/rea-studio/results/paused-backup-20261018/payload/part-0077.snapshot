    {
      "id": "grafana.candidate.b63fa25551a52239b0a2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This setting also applies to core backend HTTP data sources where query requests use an HTTP client with timeout set.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[dataproxy]`",
        "`timeout`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
