    {
      "id": "grafana.candidate.11d1b5e8937a9ff4a53a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "_Logs_ are structured records of events or messages generated by a system or application&mdash;that is, a series of text records with status updates from your system or app. They generally include timestamps, messages, and context information like the severity of the logged event.",
      "headingPath": [
        "Logs"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/logs/index.md",
