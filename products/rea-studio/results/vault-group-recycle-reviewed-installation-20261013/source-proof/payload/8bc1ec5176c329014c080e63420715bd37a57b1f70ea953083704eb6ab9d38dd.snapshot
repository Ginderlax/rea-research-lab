import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const work=import.meta.dirname,old=path.join(work,'root-vault-group-dom-review-next'),fresh=path.join(work,'root-vault-group-dom-active-list-review'),candidate=path.join(work,'keepass-group-active-list-fix-next'),digest=process.argv[2],records=Number(process.argv[3]),clientSHA=process.argv[4],sha=b=>createHash('sha256').update(b).digest('hex');assert(/^[0-9a-f]{64}$/.test(digest));assert(/^[0-9a-f]{64}$/.test(clientSHA));assert(Number.isSafeInteger(records)&&records>0);
const mb=await fs.readFile(path.join(old,'manifest.json'));assert.equal(sha(mb),'9450b6c9504fb865a3fa7c96f7a11ec6d82ce7d127eb723f62c91d97e2018240');for(const row of JSON.parse(mb).inventory){const b=await fs.readFile(path.join(old,row.path));assert.equal(b.length,row.bytes);assert.equal(sha(b),row.sha256);}const cm=await fs.readFile(path.join(candidate,'manifest.json'));assert.equal(sha(cm),digest);assert.equal(JSON.parse(cm).inventory.length,records);const cb=await fs.readFile(path.join(candidate,'products/rea-studio/apps/vault/client.mjs'));assert.equal(sha(cb),clientSHA);
await fs.mkdir(fresh,{recursive:false});const oldTest=await fs.readFile(path.join(old,'probe.test.mjs')),newTest=Buffer.from(oldTest.toString().replaceAll('../keepass-group-bin-coherence-fix-next/','../keepass-group-active-list-fix-next/'));assert.equal(oldTest.toString().split('../keepass-group-bin-coherence-fix-next/').length,3);const oldBody=oldTest.toString().slice(oldTest.toString().indexOf('class Element')),newBody=newTest.toString().slice(newTest.toString().indexOf('class Element'));assert.equal(newBody,oldBody);await fs.writeFile(path.join(fresh,'probe.test.mjs'),newTest,{flag:'wx'});
const oldRun=await fs.readFile(path.join(old,'run.mjs'));let run=oldRun.toString();const replacements=[['work/keepass-group-bin-coherence-fix-next','work/keepass-group-active-list-fix-next'],['4db08d661ec1fd9d61cee593b66c470513bddc99d28594ca584c79324049fef0',digest],['m.inventory.length,456','m.inventory.length,'+records],['records:456','records:'+records],['df55f9917f5aa074d3026e0afaaa011bbc185f0c8022656ec7e75320f8eb801c',clientSHA],['work/root-vault-group-dom-review-next/','work/root-vault-group-dom-active-list-review/']];for(const [before,after] of replacements){assert(run.includes(before),before);run=run.replaceAll(before,after);}await fs.writeFile(path.join(fresh,'run.mjs'),run,{flag:'wx'});await fs.writeFile(path.join(fresh,'preparation.json'),JSON.stringify({scope:'Exact six independent root case bodies replayed through final corrected client; two imports and collector paths/pins only. Previous5/6 failure remains immutable.',oldReviewManifestSha256:sha(mb),candidate:{manifestSha256:digest,records,clientSHA256:clientSHA},test:{beforeSHA256:sha(oldTest),afterSHA256:sha(newTest),bodySHA256:sha(Buffer.from(oldBody)),bodiesUnchanged:true},collector:{beforeSHA256:sha(oldRun),afterSHA256:sha(Buffer.from(run)),replacements}},null,2)+'\n',{flag:'wx'});await fs.copyFile(import.meta.filename,path.join(fresh,'preparation-collector.mjs.snapshot'));console.log(JSON.stringify({stage:fresh,caseBodiesUnchanged:true}));
