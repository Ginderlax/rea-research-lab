import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const base=path.resolve(import.meta.dirname,'..'),lab=path.join(base,'outputs/rea-research-lab'),stage=path.join(base,'work/sketch-alignment-next'),sha=b=>createHash('sha256').update(b).digest('hex'),commit='a2ec2889babf7d2295469c6d90ebe77fae57df84';assert.equal(fs.existsSync(stage),false);fs.mkdirSync(stage,{recursive:true});const sourceRows=[];
for(const name of fs.readdirSync(path.join(lab,'products/rea-studio/apps/sketch'))){const source=path.join(lab,'products/rea-studio/apps/sketch',name);if(!fs.statSync(source).isFile())continue;const b=fs.readFileSync(source),n='products/rea-studio/apps/sketch/'+name,destination=path.join(stage,n);fs.mkdirSync(path.dirname(destination),{recursive:true});fs.writeFileSync(destination,b,{flag:'wx'});const before=path.join(stage,'baseline',n+'.snapshot');fs.mkdirSync(path.dirname(before),{recursive:true});fs.writeFileSync(before,b,{flag:'wx'});sourceRows.push({path:n,bytes:b.length,sha256:sha(b)});}
for(const name of ['lib/client-test.mjs','lib/dom-fixture.mjs','lib/storage.mjs']){const p=path.join(lab,'products/rea-studio',name);if(!fs.existsSync(p))continue;const b=fs.readFileSync(p),n='products/rea-studio/'+name,destination=path.join(stage,n);fs.mkdirSync(path.dirname(destination),{recursive:true});fs.writeFileSync(destination,b,{flag:'wx'});sourceRows.push({path:n,bytes:b.length,sha256:sha(b)});}
const fetched=[];for(const sourcePath of ['packages/excalidraw/align.ts','packages/excalidraw/distribute.ts','packages/excalidraw/groups.ts','packages/excalidraw/element/bounds.ts','packages/excalidraw/actions/actionAlign.tsx','packages/excalidraw/actions/actionDistribute.tsx','LICENSE']){const url='https://raw.githubusercontent.com/excalidraw/excalidraw/'+commit+'/'+sourcePath,response=await fetch(url,{signal:AbortSignal.timeout(60000)});assert.equal(response.status,200,url);const b=Buffer.from(await response.arrayBuffer()),n='original/'+sourcePath+'.snapshot';fs.mkdirSync(path.dirname(path.join(stage,n)),{recursive:true});fs.writeFileSync(path.join(stage,n),b,{flag:'wx'});fetched.push({sourcePath,url,path:n,bytes:b.length,sha256:sha(b),status:response.status});}
fs.writeFileSync(path.join(stage,'source-baseline.json'),JSON.stringify(sourceRows,null,2)+'\n',{flag:'wx'});fs.writeFileSync(path.join(stage,'source-provenance.json'),JSON.stringify({schema:'rea-sketch-alignment-source-provenance/v1',release:'@excalidraw/excalidraw 0.18.1',commit,tag:'v0.18.1',fetched,sourceAssisted:true,cleanRoomClaim:false,originalAppExecutions:0,libraryOracleExecuted:false,baseline:sourceRows},null,2)+'\n',{flag:'wx'});fs.copyFileSync(import.meta.filename,path.join(stage,'prepare.mjs.snapshot'),fs.constants.COPYFILE_EXCL);console.log(JSON.stringify({stage,baselineFiles:sourceRows.length,pinnedOfficialSources:fetched.length,productionWrites:0}));
