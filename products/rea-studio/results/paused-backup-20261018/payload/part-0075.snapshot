    },
    {
      "id": "grafana.candidate.772f6235bf105e5cd79a",
      "syntaxRole": "list-item",
      "sourceText": "- Reduce duplicate notifications by grouping `DatasourceError` alerts. Use the `datasource_uid` label to group errors from the same data source.",
      "headingPath": [
        "Handle connectivity errors in alerts",
        "Handle query errors in Grafana Alerting",
        "Reduce redundant error notifications"
      ],
      "source": {
