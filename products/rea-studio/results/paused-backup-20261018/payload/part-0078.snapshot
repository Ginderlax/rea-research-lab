    {
      "id": "grafana.candidate.e4543cce3bb0c0e4abce",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana Labs offers limited support for public preview features, and breaking changes might occur prior to the feature being made generally available. To use this feature, enable the `queryEditorNext` feature toggle in your Grafana configuration file or contact Support.",
      "headingPath": [
