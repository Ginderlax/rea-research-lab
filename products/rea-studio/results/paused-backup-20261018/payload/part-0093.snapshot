// A distinct hosted-only committed Notes36 source boundary. No installation/composition.
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import {createHash} from 'node:crypto';
import {spawnSync} from 'node:child_process';
import {fileURLToPath} from 'node:url';
const repository=path.resolve(fileURLToPath(new URL('../../../',import.meta.url))),studio=path.join(repository,'products/rea-studio');
const self='products/rea-studio/scripts/verify-notes36-installed-cloud.mjs';
export const declarationSource={path:'products/rea-studio/results/notes36-source-transition-20261016/current-source-declaration.json',bytes:60830,sha256:'c0a488389094d898a7f6d308e9977192327f194ce3d271135dfcd2007e8a73bb'};
export const sourceLimits={files:2000,totalBytes:64*1024*1024,fileBytes:8*1024*1024,depth:32};
export const identity=bytes=>({bytes:bytes.length,sha256:createHash('sha256').update(bytes).digest('hex')});
const pin=row=>({bytes:row.bytes,sha256:row.sha256});
export function safe(name){assert(typeof name==='string'&&name.length>0&&name.length<=4096&&!/[\\:\x00-\x1f\x7f]/.test(name)&&!name.startsWith('/')&&name.split('/').every(part=>part&&part!=='.'&&part!=='..'));return name;}
export function git(args,maxBuffer=32*1024*1024){const result=spawnSync('git',args,{cwd:repository,windowsHide:true,shell:false,timeout:30000,maxBuffer});assert.equal(result.error,undefined);assert.equal(result.status,0);return result.stdout;}
export function readSource(name,maxBytes=8*1024*1024){let at=repository;for(const part of safe(name).split('/')){at=path.join(at,part);assert(!fs.lstatSync(at).isSymbolicLink());}const item=fs.lstatSync(at);assert(item.isFile()&&item.size<=maxBytes);const bytes=fs.readFileSync(at);assert.equal(bytes.length,item.size);return bytes;}
export function gitSource(name){const bytes=readSource(name);assert.deepEqual(bytes,git(['show','HEAD:'+safe(name)]));return bytes;}
export function execution(){return Object.fromEntries(['CI','GITHUB_ACTIONS','RUNNER_ENVIRONMENT','RUNNER_OS','RUNNER_ARCH','GITHUB_SHA','GITHUB_RUN_ID','GITHUB_RUN_ATTEMPT','GITHUB_REPOSITORY','GITHUB_JOB'].map(name=>{assert.equal(typeof process.env[name],'string');return[name,process.env[name]];}));}
export function assertHosted(){assert.equal(process.platform,'win32');assert.equal(process.version,'v24.16.0');assert.equal(process.env.CI,'true');assert.equal(process.env.GITHUB_ACTIONS,'true');assert.equal(process.env.RUNNER_ENVIRONMENT,'github-hosted');assert.equal(process.env.RUNNER_OS,'Windows');assert.equal(process.env.RUNNER_ARCH,'X64');assert.equal(process.env.GITHUB_REPOSITORY,'Ginderlax/rea-research-lab');assert(['finite-twenty-one-file-selection','eight-real-chromium-scenarios'].includes(process.env.GITHUB_JOB));for(const name of['GITHUB_SHA','GITHUB_RUN_ID','GITHUB_RUN_ATTEMPT','RUNNER_TEMP'])assert(process.env[name]);assert.equal(git(['rev-parse','HEAD']).toString('utf8').trim(),process.env.GITHUB_SHA);assert.equal(git(['rev-parse','--show-object-format']).toString('utf8').trim(),'sha1');assert.equal(path.resolve(fileURLToPath(import.meta.url)),path.join(repository,self));gitSource(self);assert.equal(git(['status','--porcelain=v1','-z','--untracked-files=all']).length,0,'Committed Notes36 requires a clean checkout; no overlays');}
export function ownedEvidence(value){assert(path.isAbsolute(value));const root=fs.realpathSync(value),temporary=fs.realpathSync(process.env.RUNNER_TEMP),relative=path.relative(temporary,root);assert(relative&&relative!=='..'&&!relative.startsWith('..'+path.sep)&&!path.isAbsolute(relative));assert(!fs.lstatSync(root).isSymbolicLink());return root;}
export function evidenceBytes(root,name){let filename=root;for(const part of safe(name).split('/')){filename=path.join(filename,part);assert(!fs.lstatSync(filename).isSymbolicLink());}const item=fs.lstatSync(filename);assert(item.isFile()&&item.size<=8*1024*1024);const bytes=fs.readFileSync(filename);assert.equal(bytes.length,item.size);return bytes;}
export function saveBytes(root,name,bytes){const filename=path.join(root,safe(name));fs.mkdirSync(path.dirname(filename),{recursive:true});fs.writeFileSync(filename,bytes,{flag:'wx'});}
export function saveJSON(root,name,value){saveBytes(root,name,Buffer.from(JSON.stringify(value,null,2)+'\n'));}
function noteFiles(directory,depth=0){assert(depth<=32);assert(fs.lstatSync(directory).isDirectory()&&!fs.lstatSync(directory).isSymbolicLink());const names=[];for(const item of fs.readdirSync(directory,{withFileTypes:true})){if(item.name==='results')continue;assert(!item.isSymbolicLink());const filename=path.join(directory,item.name);if(item.isDirectory())names.push(...noteFiles(filename,depth+1));else{assert(item.isFile());names.push(path.relative(repository,filename).replaceAll('\\','/'));}}return names.sort();}
export function activeCensus(){const rows=[],budget={files:0,bytes:0};function add(filename){const item=fs.lstatSync(filename);assert(item.isFile()&&!item.isSymbolicLink()&&item.size<=sourceLimits.fileBytes);budget.files++;budget.bytes+=item.size;assert(budget.files<=sourceLimits.files&&budget.bytes<=sourceLimits.totalBytes);const bytes=fs.readFileSync(filename);assert.equal(bytes.length,item.size);rows.push({path:path.relative(studio,filename).replaceAll('\\','/'),...identity(bytes)});}function walk(directory,depth=0){assert(depth<=sourceLimits.depth);assert(fs.lstatSync(directory).isDirectory()&&!fs.lstatSync(directory).isSymbolicLink());for(const item of fs.readdirSync(directory,{withFileTypes:true})){if(['node_modules','.local','results'].includes(item.name))continue;assert(!item.isSymbolicLink());const filename=path.join(directory,item.name);if(item.isDirectory())walk(filename,depth+1);else if(item.isFile()&&/\.(mjs|json|html|css|ps1)$/.test(item.name))add(filename);}}for(const name of['apps','lib','public','browser-tests','scripts','tests'])walk(path.join(studio,name));for(const name of['server.mjs','catalog.mjs','package.json'])add(path.join(studio,name));return rows.sort((a,b)=>a.path.localeCompare(b.path));}
function tree(){const result=new Map();for(const raw of git(['ls-tree','-r','-z','--full-tree','HEAD','--','products/rea-studio']).toString('utf8').split('\0').filter(Boolean)){const match=/^(100644|100755) blob ([0-9a-f]{40})\t(.+)$/.exec(raw);assert(match,'Only ordinary committed source blobs');assert(!result.has(match[3]));result.set(match[3],match[2]);}return result;}
function eligible(name){const relative=name.slice('products/rea-studio/'.length);if(['server.mjs','catalog.mjs','package.json'].includes(relative))return true;const parts=relative.split('/');return['apps','lib','public','browser-tests','scripts','tests'].includes(parts[0])&&!parts.some(part=>['node_modules','.local','results'].includes(part))&&/\.(mjs|json|html|css|ps1)$/.test(parts.at(-1));}
export function authenticateCensus(rows,declaration){assertHosted();const objects=tree(),expected=[...objects.keys()].filter(eligible).map(name=>name.slice('products/rea-studio/'.length)).sort();assert.equal(new Set(rows.map(row=>row.path)).size,rows.length);assert.deepEqual(rows.map(row=>safe(row.path)).sort(),expected,'Complete committed six-directory name closure');let notes=0;for(const row of rows){const name='products/rea-studio/'+safe(row.path),bytes=readSource(name);assert.deepEqual(identity(bytes),pin(row));assert.equal(createHash('sha1').update(Buffer.from('blob '+bytes.length+'\0')).update(bytes).digest('hex'),objects.get(name));if(row.path.startsWith('apps/notes/')){const fixed=declaration.currentNotesSources.find(item=>item.path===name);assert(fixed);assert.deepEqual(pin(row),pin(fixed));notes++;}}assert.equal(notes,34);return{activeSixDirectorySources:rows.length,eligibleNotesSources:34,allNotesFiles:36,exactInstalledTargets:7,eligibleInstalledTargets:6,allEligibleGitBlobs:rows.length,excludedGitTargets:[],sourceOverlay:false,allOtherGitBlobsAuthenticated:true};}
export function proof(){assertHosted();const captured=new Map();let total=0;function read(row){const bytes=readSource(row.path,256*1024);assert.deepEqual(identity(bytes),pin(row));assert.deepEqual(bytes,git(['show','HEAD:'+row.path]));assert(!captured.has(row.path),'Distinct fixed proof paths');captured.set(row.path,bytes);total+=bytes.length;assert(captured.size<=64&&total<=8*1024*1024);return bytes;}
 const raw=read(declarationSource),declaration=JSON.parse(raw);assert.equal(declaration.schema,'rea-Notes36-current-source-declaration/v1');assert.equal(declaration.sourceOnly,true);assert.equal(declaration.sourceInstallationPerformedByDeclaration,false);assert.equal(declaration.actualInstalledBehaviorAccepted,false);assert.equal(declaration.historicalReceiptsRebound,false);assert.equal(declaration.externalDeclarationPinRequired,true);assert.equal(declaration.selfIdentityContained,false);assert.equal(declaration.otherProofRowCount,59);assert.equal(declaration.combinedProofRowCount,60);assert.equal(declaration.proofFileLimit,64);assert.equal(declaration.proofByteLimit,8*1024*1024);assert.equal(declaration.proofIndividualByteLimit,256*1024);assert.equal(declaration.otherProofRows.length,59);assert(!declaration.otherProofRows.some(row=>row.path===declarationSource.path));
 for(const row of declaration.otherProofRows)read(row);assert.equal(captured.size,60);assert.equal(declaration.currentNotesSources.length,36);assert.equal(new Set(declaration.currentNotesSources.map(row=>row.path)).size,36);assert.deepEqual(noteFiles(path.join(studio,'apps/notes')),declaration.currentNotesSources.map(row=>row.path).sort());for(const row of declaration.currentNotesSources)assert.deepEqual(identity(captured.get(row.path)),pin(row));
 const bundle=JSON.parse(captured.get(declaration.frozenFeatureBundle.path));assert.deepEqual(identity(captured.get(declaration.frozenFeatureBundle.path)),pin(declaration.frozenFeatureBundle));assert.equal(bundle.schema,'rea-Notes-new-to-do-cloud-source-bundle/v1');assert.equal(bundle.productionInstalled,false);assert.equal(bundle.historicalReceiptsRebound,false);assert.deepEqual(bundle.featureAuthority,declaration.frozenFeatureAuthority);assert.deepEqual(bundle.featureIndependentPeer,declaration.frozenFeatureIndependentPeer);assert.deepEqual(bundle.composedNotesSources,declaration.currentNotesSources);assert.deepEqual(bundle.transitions,declaration.installedTargets);assert.equal(bundle.transitions.length,7);assert.equal(bundle.transitions.filter(row=>row.before).length,3);assert.equal(bundle.transitions.filter(row=>!row.before).length,4);assert.equal(bundle.transitions.filter(row=>/\.(mjs|json|html|css|ps1)$/.test(row.path)).length,6);
 for(const row of bundle.transitions){assert.deepEqual(identity(captured.get(row.path)),pin(row.after));assert.deepEqual(identity(captured.get(row.afterImage.path)),pin(row.after));if(row.before)assert.deepEqual(identity(captured.get(row.beforeImage.path)),pin(row.before));else assert.equal(row.beforeImage,null);}
 assert.equal(bundle.payloads.length,17);for(const row of bundle.payloads)assert.deepEqual(identity(captured.get(row.path)),pin(row));assert.deepEqual(bundle.fixedTests,declaration.fixedTests);assert.equal(bundle.fixedTests.length,21);assert.deepEqual(declaration.currentNotesSources.filter(row=>row.path.endsWith('.test.mjs')).map(row=>row.path).sort(),[...bundle.fixedTests].sort());assert.equal(bundle.plannedGroups,111);assert.equal(declaration.finiteGroups,111);assert.equal(bundle.oldNamedGroupsRequired.length,23);assert.equal(bundle.newNamedGroupsRequired.length,19);assert.deepEqual(bundle.oldNamedGroupsRequired,declaration.oldNamedGroupsRequired);assert.deepEqual(bundle.newNamedGroupsRequired,declaration.newNamedGroupsRequired);assert.deepEqual(bundle.separateComparisonCounts,{existingConversionAndCompletion:20,newParentAndType:4,newDesktopCommandArguments:2,addedToTestGroupCounts:false});assert.deepEqual(bundle.separateComparisonCounts,declaration.separateComparisonCounts);
 return{declaration,bundle,captured,readFiles:60,readBytes:total,fileLimit:64,byteLimit:8*1024*1024,currentSources:declaration.currentNotesSources.map(row=>({...row})),sourceInputs:[...captured].map(([name,bytes])=>({path:name,...identity(bytes)}))};}
const sameAttempt=value=>{assert.deepEqual(value.execution,execution());assert.equal(value.sourceCommit,process.env.GITHUB_SHA);};
function expectedAuthentication(current,census){return{allNotesFiles:36,eligibleNotesSources:34,installedTargets:7,eligibleInstalledTargets:6,sourceOverlay:false,all36NotesGitBlobsAuthenticated:true,sourceInputs:current.sourceInputs,proofReadFiles:60,proofReadBytes:current.readBytes,proofFileLimit:64,proofByteLimit:8*1024*1024,sourceAuthentication:authenticateCensus(census,current.declaration)};}
export function readInstalled(root){assertHosted();root=ownedEvidence(root);const raw=evidenceBytes(root,'notes36-source-check.json'),value=JSON.parse(raw),current=proof(),before=JSON.parse(evidenceBytes(root,'notes36-source-before.json'));assert.equal(value.schema,'rea-Notes36-committed-source-check/v1');assert.equal(value.status,'verified-unexecuted-committed-sources');sameAttempt(value);assert.equal(value.phase,'before');assert.equal(value.sourceOnly,true);assert.equal(value.sourceOverlay,false);assert.equal(value.sourceMutationPerformed,false);assert.equal(value.sourceInstallationPerformedByHelper,false);assert.equal(value.historicalReceiptsRebound,false);assert.equal(value.applicationExecutions+value.originalExecutions+value.browserExecutions,0);assert.deepEqual(value.declaration,declarationSource);assert.deepEqual(value.currentSources,current.currentSources);assert.deepEqual(value.authentication,expectedAuthentication(current,before));assert.deepEqual(value.census,identity(evidenceBytes(root,'notes36-source-before.json')));assert.deepEqual(activeCensus(),before);return{declaration:current.declaration,bundle:current.bundle,receipt:identity(raw),value,current,before,after:before,root};}
export function verifyPostcheck(root,installation){const raw=evidenceBytes(root,'notes36-postrun-source-check.json'),value=JSON.parse(raw);assert.equal(value.schema,'rea-Notes36-committed-postrun-source-check/v1');assert.equal(value.status,'source-verified');sameAttempt(value);assert.equal(value.sourceOverlay,false);assert.equal(value.sourceMutationPerformed,false);assert.equal(value.sourceInstallationPerformedByHelper,false);assert.equal(value.historicalReceiptsRebound,false);assert.deepEqual(value.beforeReceipt,installation.receipt);assert.deepEqual(value.currentSources,installation.current.currentSources);assert.deepEqual(value.authentication,installation.value.authentication);assert.equal(value.sourceStable,true);assert.equal(value.applicationExecutions+value.originalExecutions+value.browserExecutions,0);assert.deepEqual(JSON.parse(evidenceBytes(root,'notes36-source-after.json')),installation.before);return identity(raw);}
function command(){assertHosted();const args=process.argv.slice(2);assert.equal(args.length,4);assert.equal(args[0],'--phase');assert(['before','after'].includes(args[1]));assert.equal(args[2],'--evidence');const root=ownedEvidence(args[3]),phase=args[1],after=phase==='after',name=after?'notes36-postrun-source-check.json':'notes36-source-check.json';let value={schema:after?'rea-Notes36-committed-postrun-source-check/v1':'rea-Notes36-committed-source-check/v1',status:'failed',phase,execution:execution(),sourceCommit:process.env.GITHUB_SHA,sourceOnly:true,sourceOverlay:false,sourceMutationPerformed:false,sourceInstallationPerformedByHelper:false,historicalReceiptsRebound:false,applicationExecutions:0,originalExecutions:0,browserExecutions:0,fullParity:false,superiority:false};try{const current=proof(),census=activeCensus();value.declaration=declarationSource;value.currentSources=current.currentSources;value.authentication=expectedAuthentication(current,census);saveJSON(root,after?'notes36-source-after.json':'notes36-source-before.json',census);if(after){const installed=readInstalled(root);assert.deepEqual(value.authentication,installed.value.authentication);value.beforeReceipt=installed.receipt;value.sourceStable=true;value.status='source-verified';}else{for(const[name,bytes]of current.captured)saveBytes(root,'notes36-proof-source/'+name+'.snapshot',bytes);value.census=identity(evidenceBytes(root,'notes36-source-before.json'));value.status='verified-unexecuted-committed-sources';}}catch(error){value.failure={name:error.name,message:error.message,stack:error.stack};process.exitCode=1;}saveJSON(root,name,value);console.log(JSON.stringify({phase,status:value.status,allNotesFiles:value.authentication?.allNotesFiles??null,sourceCommit:value.sourceCommit}));}
if(process.argv[1]&&path.resolve(process.argv[1])===path.resolve(fileURLToPath(import.meta.url)))command();
