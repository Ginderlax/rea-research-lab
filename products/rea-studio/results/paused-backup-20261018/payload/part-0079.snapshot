          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.aa7aea52594e40696478",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Whenever a metric is selected in the query editor, a suitable preprocessing option is automatically selected for you. To avoid breaking changes, preprocessing is not enabled by default on existing queries. If you want to use preprocessing for existing queries, you have to manually select one in the query editor.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Grafana OSS features",
        "Data source updates",
        "Google Cloud Monitoring data source"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-0.md",
        "gitBlobSha": "08364874bf79c35cb3f0d907a16891c4cfb0eb1c",
        "sha256": "6f07cb510f8b0da003b838c600c8c34236d365c4cc7688913f7fe726f50a0fd7",
        "lineStart": 234,
        "lineEnd": 234,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v8-0.md#L234-L234"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
