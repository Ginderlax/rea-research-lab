    {
      "id": "grafana.candidate.d13b433233ff3fc7bdd5",
      "syntaxRole": "table-row",
      "sourceText": "| `grafana_alertmanager_peer_position`                           | The position an Alertmanager instance believes it holds, which defines its role in the cluster. Peers should be numbered sequentially, starting from zero. |",
      "headingPath": [
        "Configure high availability",
