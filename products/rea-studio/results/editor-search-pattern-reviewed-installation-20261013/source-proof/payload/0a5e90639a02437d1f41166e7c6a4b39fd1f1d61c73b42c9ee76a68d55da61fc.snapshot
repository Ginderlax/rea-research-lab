import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import{createHash}from'node:crypto';
const here=import.meta.dirname,run=process.argv[2],action=process.argv[3];assert.match(run??'',/^runs\/browser-[0-9TZ-]+$/);assert(['state','stop'].includes(action));
const id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});const self=await fs.readFile(import.meta.filename),node=id(await fs.readFile(process.execPath));assert.equal(node.sha256,'b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3');
const binding=JSON.parse(await fs.readFile(path.join(here,run,'host-binding.json')));assert(Number.isSafeInteger(binding.port)&&binding.port>1024&&binding.port<65536);
const url=`http://127.0.0.1:${binding.port}`,session=await(await fetch(url+'/session',{signal:AbortSignal.timeout(5000)})).json();assert(typeof session.token==='string');
const response=await fetch(url+'/qa/'+action,{method:'POST',headers:{'content-type':'application/json','x-review-token':session.token},body:'{}',signal:AbortSignal.timeout(5000)});const raw=await response.text();assert(raw.length<16384);const result=JSON.parse(raw);assert(response.ok,raw);assert((await fs.readFile(import.meta.filename)).equals(self));
const record={at:new Date().toISOString(),action,status:response.status,result,collector:id(self),node,nodeVersion:process.version,sessionTokenPersisted:false};const filename=`control-${action}-${record.at.replace(/[:.]/g,'-')}.json`;await fs.writeFile(path.join(here,run,filename),JSON.stringify(record,null,2)+'\n',{flag:'wx'});await fs.writeFile(path.join(here,run,filename+'.mjs.snapshot'),self,{flag:'wx'});process.stdout.write(JSON.stringify(record)+'\n');
