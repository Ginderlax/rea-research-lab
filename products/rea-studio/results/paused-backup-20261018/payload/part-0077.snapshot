    },
    {
      "id": "grafana.candidate.4789cb3823c737c0d917",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For \"sqlite3\" only. Setting to enable/disable [Write-Ahead Logging](https://sqlite.org/wal.html). The default value is `false` (disabled).",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[database]`",
        "`wal`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
