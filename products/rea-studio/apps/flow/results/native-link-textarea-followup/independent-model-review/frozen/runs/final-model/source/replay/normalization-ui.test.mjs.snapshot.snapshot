import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs/promises';import path from'node:path';import os from'node:os';import{fixture,linkScene}from'../fixture.mjs';import{handle}from'file:///C:/Users/evanh/Documents/Codex/2026-10-12/go/work/flow-native-textarea-normalization-fix-next/candidate/products/rea-studio/apps/flow/server.mjs';
const rootSeed=JSON.parse(await fs.readFile(new URL('../source/browser28-seed.json.snapshot',import.meta.url),'utf8')),observations=[];
const normalized=value=>value.replace(/\r\n?/g,'\n'),source=ending=>JSON.stringify(linkScene(),null,3).replace(/\n/g,ending)+ending;
async function owned(label,options,body){const f=await fixture(options);try{await body(f);}finally{f.release();const downloads=[];for(const blob of f.downloads)downloads.push(await blob.text());observations.push({label,scope:'Actual candidate client and real in-memory handle with modeled native textarea CR normalization; Blob contents observed, not a real browser file download.',calls:f.calls,downloads,sectionText:f.section.textContent,nativeText:f.field('Native Node-RED flow JSON')?.value??null});await f.close();}}
test.after(async()=>{const out=process.env.FLOW_LINK_OBSERVATIONS??path.join(os.tmpdir(),'rea-flow-normalization-observations-'+process.pid);await fs.mkdir(out,{recursive:true});await fs.writeFile(path.join(out,'normalization-ui.json'),JSON.stringify({observations,actualBrowserExecutions:0,originalExecutions:0,programmaticWhileDisabledProbes:true},null,2)+'\n');});
for(const [label,raw]of[['actual-root-seed',rootSeed.text],['CRLF',source('\r\n')],['bareCR',source('\r')],['LF',source('\n')]])test('unchanged saved '+label+' deploys its exact raw source despite native textarea normalization',async()=>owned(label,{rawText:raw},async f=>{await f.load();assert.equal(f.field('Native Node-RED flow JSON').value,normalized(raw));await f.button('Deploy native flow').click();assert.equal(f.calls.filter(x=>x.action==='native-deploy').length,1);const inspected=await handle({action:'native-inspect',input:{id:f.saved.flow.id},store:f.store});assert.equal(inspected.flow.deployedRevision,f.saved.flow.revision);assert.equal((await handle({action:'native-export',input:{id:f.saved.flow.id},store:f.store})).text,raw);}));
test('U+2028, astral and combining Unicode are preserved without extra normalization in Deploy and Export',async()=>{const doc=linkScene();doc.vendor.unicode='before\u2028after 😀 e\u0301 é';const raw=JSON.stringify(doc,null,3)+'\n';await owned('unicode',{rawText:raw},async f=>{await f.load();assert.equal(f.field('Native Node-RED flow JSON').value,raw);await f.button('Deploy native flow').click();assert.equal(f.calls.filter(x=>x.action==='native-deploy').length,1);await f.button('Export Node-RED JSON').click();assert.equal(await f.downloads[0].text(),raw);});});
test('unchanged loaded actual-root CRLF source exports exact raw decoded text',async()=>owned('loaded-raw-export',{rawText:rootSeed.text},async f=>{await f.load();await f.button('Export Node-RED JSON').click();assert.equal(f.downloads.length,1);assert.equal(await f.downloads[0].text(),rootSeed.text);assert.equal(f.calls.filter(x=>x.action==='native-validate').at(-1).input.text,rootSeed.text);}));
test('new imported bareCR decoded file text exports and saves its backing source unchanged',async()=>owned('imported-raw-export',{},async f=>{await f.load();const raw=source('\r'),file=f.field('Import Node-RED flow file');file.files=[{name:'owned-import.json',size:Buffer.byteLength(raw),text:async()=>raw}];await file.fire('change');assert.equal(f.field('Native Node-RED flow JSON').value,normalized(raw));await f.button('Export Node-RED JSON').click();assert.equal(await f.downloads[0].text(),raw);await f.button('Save native draft').click();assert.equal(f.calls.filter(x=>x.action==='native-save').at(-1).input.text,raw);}));
test('renaming and saving an otherwise unchanged loaded CRLF draft does not rewrite saved raw text',async()=>owned('save-raw',{rawText:rootSeed.text},async f=>{await f.load();f.field('Native flow name').value='Renamed owned fixture';await f.field('Native flow name').fire('input');await f.button('Save native draft').click();assert.equal(f.calls.filter(x=>x.action==='native-save').at(-1).input.text,rootSeed.text);assert.equal((await handle({action:'native-export',input:{id:f.saved.flow.id},store:f.store})).text,rootSeed.text);}));
test('genuine content, whitespace and non-normalization Unicode differences still refuse deployment without an API request',async()=>owned('real-dirty',{rawText:rootSeed.text},async f=>{await f.load();const field=f.field('Native Node-RED flow JSON');for(const raw of['\n'+normalized(rootSeed.text),normalized(rootSeed.text).replace('nativeMetadata','changedMetadata'),normalized(rootSeed.text).replace('opaque publisher revision','é vs e\u0301')]){field.value=raw;await field.fire('input');await f.button('Deploy native flow').click();assert.equal(f.calls.filter(x=>x.action==='native-deploy').length,0);assert.match(f.section.textContent,/Save the edited draft/);assert.equal(field.value,raw);}}));
test('held Export validation cannot export an unvalidated newer programmatic draft or stale raw backing',async()=>{let enabled=false;await owned('held-export',{rawText:rootSeed.text,hold:a=>enabled&&a==='native-validate'},async f=>{await f.load();enabled=true;const pending=f.button('Export Node-RED JSON').click();try{await f.held;const changed=JSON.stringify({...rootSeed.document,newer:'keep export draft'}),field=f.field('Native Node-RED flow JSON');field.value=changed;await field.fire('input',{programmatic:true});f.release();await pending;assert.equal(field.value,changed);assert.equal(f.downloads.length,0);}finally{f.release();await pending;}});});
test('held committed Save retains newer programmatic input, advances its saved baseline and permits a later explicit Save/Deploy',async()=>{let enabled=false;await owned('held-save',{rawText:rootSeed.text,hold:a=>enabled&&a==='native-save'},async f=>{await f.load();enabled=true;const pending=f.button('Save native draft').click();try{const held=await f.held;assert.equal(held.response.flow.text,rootSeed.text);const changed=JSON.stringify({...rootSeed.document,newer:'keep save draft'}),field=f.field('Native Node-RED flow JSON');field.value=changed;await field.fire('input',{programmatic:true});f.release();await pending;assert.equal(field.value,changed);assert.equal((await handle({action:'native-export',input:{id:f.saved.flow.id},store:f.store})).text,rootSeed.text);await f.button('Deploy native flow').click();assert.equal(f.calls.filter(x=>x.action==='native-deploy').length,0);await f.button('Save native draft').click();assert.equal((await handle({action:'native-export',input:{id:f.saved.flow.id},store:f.store})).text,changed);await f.button('Deploy native flow').click();assert.equal(f.calls.filter(x=>x.action==='native-deploy').length,1);}finally{f.release();await pending;}});});
test('disposed native view cannot export a held validation result or revive raw text',async()=>{let enabled=false;await owned('disposed-export',{rawText:rootSeed.text,hold:a=>enabled&&a==='native-validate'},async f=>{await f.load();enabled=true;const field=f.field('Native Node-RED flow JSON'),pending=f.button('Export Node-RED JSON').click();try{await f.held;f.dispose();f.release();await pending;assert.equal(field.value,'');assert.equal(f.downloads.length,0);assert.equal(f.section.children.length,0);}finally{f.release();await pending;}});});
test('held file text cannot replace a newer programmatic native document',async()=>owned('held-import',{},async f=>{await f.load();let started,release;const ready=new Promise(r=>started=r),loaded=new Promise(r=>release=r),file=f.field('Import Node-RED flow file');file.files=[{name:'held-owned.json',size:Buffer.byteLength(rootSeed.text),text:async()=>{started();return loaded;}}];const pending=file.fire('change');try{await ready;const changed=JSON.stringify({...linkScene(),newer:'keep import draft'}),field=f.field('Native Node-RED flow JSON');field.value=changed;await field.fire('input',{programmatic:true});release(rootSeed.text);await pending;assert.equal(field.value,changed);}finally{release(rootSeed.text);await pending;}}));
test('held imported file completion after disposal stays scrubbed',async()=>owned('disposed-import',{},async f=>{await f.load();let started,release;const ready=new Promise(r=>started=r),loaded=new Promise(r=>release=r),file=f.field('Import Node-RED flow file'),field=f.field('Native Node-RED flow JSON');file.files=[{name:'held-owned.json',size:Buffer.byteLength(rootSeed.text),text:async()=>{started();return loaded;}}];const pending=file.fire('change');try{await ready;f.dispose();release(rootSeed.text);await pending;assert.equal(field.value,'');assert.equal(f.section.children.length,0);}finally{release(rootSeed.text);await pending;}}));
