    {
      "id": "grafana.candidate.545c6a243aafd3fd06e7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When a viewer changes `profile_type`, the `label` drop-down refreshes with the labels for that profile type, and `label_value` refreshes with the values for the selected label.",
