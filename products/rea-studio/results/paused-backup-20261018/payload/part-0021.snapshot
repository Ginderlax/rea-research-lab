import pathlib,json,hashlib,gzip,zipfile,io,zlib
base=pathlib.Path(__file__).resolve().parent.parent;work=base/'work';repo=base/'outputs/rea-research-lab'
stage=work/'cloud-full1100-native-metadata-failure-public-20261016-next';public=stage/'public-candidate';a=json.loads((stage/'copy-authority.json').read_bytes())
