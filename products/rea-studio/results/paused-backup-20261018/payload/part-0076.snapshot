    {
      "id": "grafana.candidate.1662538a37931239abb6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In Explore, you can retrieve the context surrounding your log results by clicking the **Show context** button. You can then investigate the logs from the same log stream that came before and after the log message you're interested in.",
      "headingPath": [
        "Loki query editor",
        "Create a log query",
        "Show log context"
      ],
      "source": {
        "path": "docs/sources/datasources/loki/query-editor/index.md",
