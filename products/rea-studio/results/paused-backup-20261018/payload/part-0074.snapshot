    {
      "id": "grafana.candidate.b662135757106832b0f0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "It is important to note that all matched policies are **exact** matches. Grafana supports regular expressions for creating label matchers. It does not support regular expression or partial matching in the search for policies.",
      "headingPath": [
        "Configure notification policies",
        "Search for policies"
      ],
      "source": {
