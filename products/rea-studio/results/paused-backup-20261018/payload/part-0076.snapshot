      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.f118d356ae2d9f229bd2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For an introduction to ES|QL syntax and concepts, refer to [Get started with ES|QL queries](https://www.elastic.co/docs/reference/query-languages/esql/esql-getting-started) in the Elasticsearch documentation.",
      "headingPath": [
        "Elasticsearch query editor",
        "ES|QL query editor"
      ],
      "source": {
        "path": "docs/sources/datasources/elasticsearch/query-editor/index.md",
