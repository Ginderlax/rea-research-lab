    {
      "id": "grafana.candidate.75cc697207230ff9a6c6",
      "syntaxRole": "table-row",
      "sourceText": "| **Label values**  | `label` (required), `metric` (optional) | Returns values for a specific label, optionally filtered by metric.             | Label: `job`, Metric: `http_requests_total` → returns `api-server`, `web`, `worker`     |",
      "headingPath": [
        "Prometheus template variables",
        "Query variable types"
      ],
      "source": {
