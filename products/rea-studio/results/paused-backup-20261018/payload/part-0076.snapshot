    {
      "id": "grafana.candidate.ae0803afff99363d171c",
      "syntaxRole": "table-row",
      "sourceText": "| Version           | The PostgreSQL server version. Determines which functions are available in the query builder. The default is 9.3. When you save the data source, Grafana auto-detects the server version and updates this field if it can connect successfully.                                                                                                                                                                                                                                                               |",
      "headingPath": [
        "Configure the PostgreSQL data source",
