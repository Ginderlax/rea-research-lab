MAX_ARCHIVE=32*1024*1024
MAX_RAW_TOTAL=64*1024*1024
MAX_MEMBER=24*1024*1024
def pin(raw):return {'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()}
def canonical(value):return json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode('utf-8')
def safe(name):
 assert isinstance(name,str)and name and not re.search(r'[\\:\x00-\x1f\x7f]',name)and not name.startswith('/')
 assert all(p not in ('','.','..')for p in name.split('/'));return name
def no_link(p):
 for part in [p,*p.parents]:
  try:s=part.lstat()
  except FileNotFoundError:continue
  assert not stat.S_ISLNK(s.st_mode)and not getattr(s,'st_file_attributes',0)&getattr(stat,'FILE_ATTRIBUTE_REPARSE_POINT',0x400),str(part)
 return p
def read(p,limit=MAX_MEMBER):
 no_link(p);s=p.stat();assert stat.S_ISREG(s.st_mode)and s.st_size<=limit
 b=p.read_bytes();assert len(b)==s.st_size;return b
def json_bytes(raw):
 def pairs(rows):
  result={}
  for k,v in rows:assert k not in result,'Duplicate JSON key';result[k]=v
  return result
 return json.loads(raw.decode('utf-8-sig'),object_pairs_hook=pairs,parse_constant=lambda value:(_ for _ in ()).throw(ValueError(value)))
def json_file(p):return json_bytes(read(p,64*1024*1024))
def same_pin(raw,row):assert pin(raw)=={k:row[k]for k in ('bytes','sha256')}
def rows_map(rows):
 assert isinstance(rows,list);result={}
 for row in rows:
  name=safe(row['path']);assert name not in result;assert type(row['bytes'])is int and row['bytes']>=0 and re.fullmatch(r'[0-9a-f]{64}',row['sha256']);result[name]=row
 return result
def sha_object(raw):return hashlib.sha1(b'blob '+str(len(raw)).encode()+b'\0'+raw).hexdigest()
def eligible(name):
 parts=PurePosixPath(safe(name)).parts
 return bool(parts and not any(p in ('.local','node_modules')for p in parts[:-1])and(parts[0]in ['apps','lib','public','scripts','tests']or name in ['server.mjs','catalog.mjs','package.json'])and re.search(r'\.(mjs|json|html|css|ps1)$',name))
def same_attempt(value,tested):
 assert value['GITHUB_RUN_ID']==RUN and value['GITHUB_RUN_ATTEMPT']==str(ATTEMPT)and value['GITHUB_SHA']==tested and value['GITHUB_REPOSITORY']==REPOSITORY
def api_tree(value,tree_sha):
 assert value['sha']==tree_sha and value['truncated']is False and isinstance(value['tree'],list)
 found={}
 for row in value['tree']:
  name=safe(row['path']);assert name not in found;found[name]=row
 return found
def unpack(raw,destination):
 destination.mkdir(exist_ok=False);records=[];names=set();casefold=set()
 with zipfile.ZipFile(io.BytesIO(raw))as archive:
  entries=archive.infolist();assert len(entries)<=3000 and sum(e.file_size for e in entries)<=MAX_RAW_TOTAL
  for e in entries:
   name=e.filename[:-1]if e.is_dir()else e.filename;safe(name)
   assert e.filename not in names and e.filename.casefold()not in casefold
   names.add(e.filename);casefold.add(e.filename.casefold())
   assert not e.flag_bits&1 and not stat.S_ISLNK(e.external_attr>>16)and 0<=e.file_size<=MAX_MEMBER
   p=destination.joinpath(*PurePosixPath(name).parts);assert p.resolve().is_relative_to(destination.resolve());no_link(p)
   if e.is_dir():p.mkdir(parents=True,exist_ok=True);continue
   data=archive.read(e);assert len(data)==e.file_size and zlib.crc32(data)&0xffffffff==e.CRC
   p.parent.mkdir(parents=True,exist_ok=True)
   with p.open('xb')as stream:stream.write(data)
   assert read(p)==data;records.append({'path':e.filename,**pin(data)})
 return records
assert len(sys.argv)==3
source=Path(sys.argv[1]).resolve();metadata=Path(sys.argv[2]).resolve();base=Path(__file__).resolve().parent/'cloud-verification-backups'
assert source.is_relative_to(base.resolve())and metadata.is_relative_to(source.parent.resolve())and source.name=='artifact-'+ARTIFACT+'.zip'
no_link(source);no_link(metadata)
control={name:json_file(metadata/(name+'.json'))for name in ['run','jobs','artifacts','tested-commit','tested-tree','branch-commit','branch-tree']}
run=control['run'];assert str(run['id'])==RUN and run['head_sha']==HEAD and run['run_attempt']==ATTEMPT and run['status']=='completed'
assert run['repository']['full_name']==REPOSITORY and run['head_repository']['full_name']==REPOSITORY
jobs=control['jobs'];assert jobs['total_count']==len(jobs['jobs'])==1
job=jobs['jobs'][0];assert str(job['id'])==JOB and str(job['run_id'])==RUN and job['run_attempt']==ATTEMPT and job['status']=='completed'
assert job['runner_group_name']=='GitHub Actions'and'windows-2022'in job['labels']
artifacts=control['artifacts'];assert artifacts['total_count']==len(artifacts['artifacts'])==1
artifact=artifacts['artifacts'][0];assert str(artifact['id'])==ARTIFACT and artifact['expired']is False and artifact['name']=='development-oracle-windows-'+RUN+'-'+str(ATTEMPT)
assert str(artifact['workflow_run']['id'])==RUN and artifact['workflow_run']['head_sha']==HEAD
outer=read(source,MAX_ARCHIVE);assert len(outer)==artifact['size_in_bytes']and artifact['digest']=='sha256:'+pin(outer)['sha256']
folder=source.parent/('artifact-'+ARTIFACT+'-notes36-full-superset-reader-v1');assert not folder.exists();folder.mkdir()
outer_files=unpack(outer,folder/'downloaded-contents');assert len(outer_files)==1 and outer_files[0]['path'].endswith('.zip')
inner=read(folder/'downloaded-contents'/outer_files[0]['path'],MAX_ARCHIVE)
files=unpack(inner,folder/'readable-evidence');evidence=folder/'readable-evidence';by_name=rows_map(files)
report={'schema':'rea-notes36-full-superset-portable-backup/v1','runId':RUN,'jobId':JOB,'artifactId':ARTIFACT,'branchHead':HEAD,'artifact':pin(outer),'innerArchive':pin(inner),'allCRCAndBytesReadable':True,'readableEvidence':str(evidence),'files':files,'fileCountObserved':len(files),'fixedProposal':FROZEN,'qualificationStage':'readable-backup-complete','recordedContractPassed':False,'qualificationErrors':[],'productExecutions':0,'originalExecutions':0,'tests':0,'builds':0,'syntaxChecks':0,'activeSourceWrites':0,'fullParity':False,'superiority':False,'historicalD24Cause':'unresolved; a later full pass cannot diagnose historical redacted failures','acceptanceScope':'This is a readback of separately hosted current implemented checks on one exact source epoch. Full original-product feature parity, universal superiority, performance, security and real-browser acceptance are not established here.'}
def evidence_bytes(name):
 safe(name);assert name in by_name;raw=read(evidence/name);same_pin(raw,by_name[name]);return raw
def evidence_json(name):return json_bytes(evidence_bytes(name))
def phase(value):report['qualificationStage']=value
try:
 phase('source-proof')
 a=evidence_json('attempt-validation.json');tested=a['repositoryCommit'];assert re.fullmatch(r'[0-9a-f]{40}',tested)
 assert a['schema']=='rea-cloud-development-attempt/v1'and a['scope']=='full-oracle-experiment'and a['phase']=='terminal'and a['snapshotScope']=='active'and a['sourceOnly']is False
 assert a['executionEnvironment']=='github-hosted'and a['runtime']['version']=='v24.16.0'and a['runtime']['platform']=='win32'
 same_attempt(a['environment'],tested);assert a['environment']['RUNNER_ENVIRONMENT']=='github-hosted'and a['environment']['RUNNER_OS']=='Windows'
 tested_commit=control['tested-commit'];branch_commit=control['branch-commit'];assert tested_commit['sha']==tested and branch_commit['sha']==HEAD
 # Raw Git commit API bodies identify their own trees. PR merge testing is bridged
 # only when the actual tested tree is identical to this exact branch source tree.
 tree_sha=tested_commit['tree']['sha'];assert branch_commit['tree']['sha']==tree_sha
 tree=api_tree(control['tested-tree'],tree_sha);branch_tree=api_tree(control['branch-tree'],tree_sha);assert tree==branch_tree
 before=evidence_json('source-before.json');after=evidence_json('source-after.json');assert before==after and a['sourceStable']is True
 census=rows_map(before);assert len(census)==a['sourceFiles']==FROZEN['expectedCensusFiles']
 ordered=[{k:row[k]for k in ['path','bytes','sha256']}for row in sorted(before,key=lambda r:r['path'])]
 assert hashlib.sha256(canonical(ordered)).hexdigest()==FROZEN['sourceCensusCanonicalSHA256']
 tree_names=set()
 for name,row in tree.items():
  if name.startswith('products/rea-studio/')and eligible(name[len('products/rea-studio/'):]):
   assert row['type']=='blob'and row['mode']in ['100644','100755'];tree_names.add(name[len('products/rea-studio/'):])
 overlay_names={r['path'][len('products/rea-studio/'):]for r in ORACLE}
 assert set(census)==tree_names|overlay_names
 snapshots=evidence_json('source-snapshot-manifest.json');assert snapshots['schema']=='rea-cloud-source-snapshots/v1'and snapshots['snapshotScope']=='active'and snapshots['censusFiles']==len(census)
 snapshot_rows=snapshots['files'];assert len(snapshot_rows)==a['sourceSnapshotFiles']==FROZEN['expectedActiveSnapshots']
