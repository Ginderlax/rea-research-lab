    },
    {
      "id": "grafana.candidate.e8abb223ff115b5aeb5f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can also transform a query result into value mappings. With this option, every row in the configuration query result defines a single value mapping row. See the following example.",
      "headingPath": [
