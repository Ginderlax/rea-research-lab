    },
    {
      "id": "grafana.candidate.cb27c3f7ee54095f3929",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Role sync allows you to map user roles from an identity provider to Grafana. To enable role sync, configure role attribute and possible values for the Editor, Admin, and Grafana Admin roles. For more information about user roles, refer to [Roles and permissions](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/administration/roles-and-permissions/).",
      "headingPath": [
        "Configure role sync for SAML"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/configure-saml-team-role-mapping/_index.md",
        "gitBlobSha": "727e58aab87aa12f202bdd630c6b5d4a2d80ec31",
        "sha256": "ee4d4ffddc50f2b7c4ad41a2aaaea84eaeae21bba1b53770850ee119744b6cc1",
