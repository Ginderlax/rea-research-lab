  "findings": [
    {
      "id": "KVH-REVIEW-RESTORE-SELECTION",
      "priority": "P1",
      "source": "client.mjs",
      "sourceSha256": "9d3f4c9fa20678ce9b34966a73f433e8b07b5d0f3a3db04c1074839c158de986",
      "trigger": "Delay the read issued after restoring Entry A; select Entry B or New entry before that response arrives.",
      "actual": "The late A result is assigned to global selected before the version check. B/New fields remain visible, but the next Save sends A ID and overwrites A with those fields.",
      "expected": "Check that the view/editor/selection is still current before assigning selected; preserve the user-selected entry identity and draft.",
      "reproductions": [
        "restore-selection-observation.json",
        "boundary-observations/restore-read-new-entry.json",
        "boundary-observations/restore-read-lock.json"
      ],
      "relatedBoundary": "Lock while that response is held clears the visible secrets, but late assignment resurrects selected A and unlock unexpectedly opens A.",
      "scope": "Actual frozen client/server and encrypted in-memory store with an owned DOM element model and deterministic delayed transport. Original GUI and live HTTP loss are not demonstrated.",
      "newHistoryRegression": true
    },
    {
      "id": "KVH-REVIEW-ORDINARY-SAVE-DRAFT",
      "priority": "P2",
      "source": "client.mjs",
      "trigger": "Delay the completed Save A response; open B and type an unsaved draft; release A response.",
      "actual": "The A completion unconditionally clears selected, refreshes the list and renders New entry, discarding the B draft.",
      "expected": "Use a captured editor/view generation to avoid replacing a different editor after awaited mutation completion.",
      "reproductions": [
        "boundary-observations/ordinary-save-other-editor.json"
      ],
      "preExisting": true,
      "baselineEvidence": "The ordinary Save handler is byte-identical to baseline client.mjs.snapshot line84.",
      "scope": "Pre-existing local UI lifecycle behavior found during this candidate review; no new history algorithm claim."
    }
  ],
  "passingControls": [
    "Late explicit history preview after New cannot populate the stale editor",
    "Delayed post-restore list after selecting B does not redirect B Save",
    "Failed restore persistence leaves ciphertext, active entry and history unchanged"
  ],
  "originalExecutionsByReviewer": 0,
