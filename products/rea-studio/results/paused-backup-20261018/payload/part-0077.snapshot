    {
      "id": "grafana.candidate.726f25ee640e6b0188c9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Access key requires permissions to the S3 bucket for the 's3:PutObject' and 's3:PutObjectAcl' actions.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[external_image_storage.s3]`",
        "`access_key`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
