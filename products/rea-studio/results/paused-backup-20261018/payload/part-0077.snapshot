    {
      "id": "grafana.candidate.4c060d2a411f4e940fc7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The following command runs the Grafana Enterprise container and specifies version 9.4.7. If you want to run a different version, modify the version number section.",
