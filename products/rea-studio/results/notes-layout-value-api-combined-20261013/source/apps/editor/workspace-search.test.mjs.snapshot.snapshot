import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import {createHash} from 'node:crypto';
import {createWorkspace} from '../../lib/storage.mjs';
import {handle} from './server.mjs';
import {SEARCH_LIMITS} from './workspace-search.mjs';
const sha=bytes=>createHash('sha256').update(bytes).digest('hex');
async function fixture(t){const directory=await fs.mkdtemp(path.join(os.tmpdir(),'rea-search-stage-'));t.after(async()=>{assert.equal(path.dirname(directory),path.resolve(os.tmpdir()));assert.ok(path.basename(directory).startsWith('rea-search-stage-'));await fs.rm(directory,{recursive:true,force:true});});const workspace=await createWorkspace(path.join(directory,'workspace'));const put=async(name,value)=>{const file=workspace.resolve(name);await fs.mkdir(path.dirname(file),{recursive:true});await fs.writeFile(file,value);};return{directory,workspace,put,call:input=>handle({action:'search',input,workspace})};}
test('saved-file search reports exact UTF-16 positions, CRLF/BOM lines, literal text and byte revisions',async t=>{const{put,call,workspace}=await fixture(t),content='\ufeff🧪.* .*\r\nsecond .*\n',bytes=Buffer.from(content);await put('nested/a.txt',bytes);const result=await call({query:'.*'});assert.equal(result.source,'saved-files');assert.equal(result.truncated,false);assert.deepEqual(result.matches.map(({line,column,endColumn,start,end})=>({line,column,endColumn,start,end})),[{line:1,column:3,endColumn:5,start:2,end:4},{line:1,column:6,endColumn:8,start:5,end:7},{line:2,column:8,endColumn:10,start:16,end:18}]);for(const row of result.matches)assert.equal(row.revision,sha(bytes));assert.ok((await fs.readFile(workspace.resolve('nested/a.txt'))).equals(bytes));});
test('Unicode case-insensitive literal search and non-overlap preserve single-line semantics',async t=>{const{put,call}=await fixture(t);await put('unicode.txt','Kelvin K K k; Σ σ ς; 🧪🧪; aaaa\n');assert.equal((await call({query:'k',matchCase:false})).matches.length,4);assert.equal((await call({query:'σ',matchCase:false})).matches.length,3);assert.equal((await call({query:'aa'})).matches.length,2);assert.equal((await call({query:'🧪'})).matches.length,2);assert.equal((await call({query:'Σ'})).matches.length,1);});
test('query errors, ignored metadata, binary/invalid UTF-8 and oversized files are explicit and leave bytes unchanged',async t=>{const{put,call}=await fixture(t);await put('.git/hidden','needle');await put('node_modules/pkg','needle');await put('.rea-save-owned','needle');await put('binary',Buffer.from([110,101,101,100,108,101,0]));await put('invalid',Buffer.from([0xc0,0xaf]));await put('large','x'.repeat(SEARCH_LIMITS.fileBytes+1));await put('ok','needle');const result=await call({query:'needle'});assert.deepEqual(result.matches.map(row=>row.path),['ok']);assert.deepEqual(result.skipped.map(row=>row.reason).sort(),['binary','file-size-limit','invalid-utf8']);assert.equal(result.truncated,false);for(const input of [{query:''},{query:'a\nb'},{query:'x\r'},{query:'\0'},{query:'x'.repeat(SEARCH_LIMITS.queryBytes+1)},{query:'x',matchCase:1}])await assert.rejects(call(input),/search text|Match case/);});
test('a static directory junction is skipped and direct workspace resolution rejects it',async t=>{const{directory,workspace,put,call}=await fixture(t);const outside=path.join(directory,'outside');await fs.mkdir(outside);await fs.writeFile(path.join(outside,'secret'),'needle outside');await fs.symlink(outside,path.join(workspace.root,'linked'),process.platform==='win32'?'junction':'dir');await put('inside','needle');const result=await call({query:'needle'});assert.deepEqual(result.matches.map(row=>row.path),['inside']);assert.throws(()=>workspace.resolve('linked/secret'),/links|outside/);assert.equal(await fs.readFile(path.join(outside,'secret'),'utf8'),'needle outside');});
test('match and preview limits disclose truncation with bounded responses',async t=>{const{put,call}=await fixture(t);await put('many','needle '.repeat(SEARCH_LIMITS.matches+1));const result=await call({query:'needle'});assert.equal(result.matches.length,SEARCH_LIMITS.matches);assert.deepEqual(result.limitReasons,['match-limit']);assert.equal(result.truncated,true);assert.ok(result.matches.every(row=>row.preview.length<=400));assert.ok(Buffer.byteLength(JSON.stringify(result))<=SEARCH_LIMITS.outputBytes);});
test('a complete exact-match-limit result does not claim unobserved extra matches',async t=>{const{put,call}=await fixture(t);await put('exact','needle '.repeat(SEARCH_LIMITS.matches));const result=await call({query:'needle'});assert.equal(result.matches.length,SEARCH_LIMITS.matches);assert.equal(result.truncated,false);});
test('file and directory-depth bounds identify incomplete searches',async t=>{const{put,call}=await fixture(t);await Promise.all(Array.from({length:SEARCH_LIMITS.files+1},(_,i)=>put(`${i.toString().padStart(4,'0')}.txt`,'needle')));let result=await call({query:'needle'});assert.equal(result.inspectedFiles,SEARCH_LIMITS.files);assert.ok(result.limitReasons.includes('file-limit'));const deep=await fixture(t);await deep.put('d/'.repeat(13)+'deep.txt','needle');result=await deep.call({query:'needle'});assert.deepEqual(result.limitReasons,['directory-depth']);assert.equal(result.matches.length,0);});
test('the aggregate byte bound stops before another accepted-size file',async t=>{const{put,call}=await fixture(t),content='needle\n'+'x'.repeat(SEARCH_LIMITS.fileBytes-7);for(let i=0;i<17;i++)await put(`${i.toString().padStart(2,'0')}.txt`,content);const result=await call({query:'needle'});assert.equal(result.readBytes,SEARCH_LIMITS.scanBytes);assert.equal(result.searchedFiles,16);assert.equal(result.matches.length,16);assert.deepEqual(result.limitReasons,['scan-byte-limit']);});
