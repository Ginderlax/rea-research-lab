    {
      "id": "grafana.candidate.cfe491fcf8c39297f474",
      "syntaxRole": "table-row",
      "sourceText": "| **Classic query** | query string                            | _Deprecated._ Legacy syntax using functions like `label_values(metric, label)`. | `label_values(http_requests_total, job)`                                                |",
      "headingPath": [
        "Prometheus template variables",
