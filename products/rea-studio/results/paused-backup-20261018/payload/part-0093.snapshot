import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';

const here=path.dirname(fileURLToPath(import.meta.url));
const sha=bytes=>createHash('sha256').update(bytes).digest('hex');
const read=async name=>JSON.parse(await fs.readFile(path.join(here,name)));
const fingerprint=async name=>sha(await fs.readFile(path.join(here,name)));
const preservation=await read('baseline-preservation.json');
const disclosure=await read('timing-disclosures.json');
const snapshots={};
for(const name of ['benchmark.mjs','benchmark-worker.mjs','verify-candidate.mjs','run-validation.mjs','verify-heldout-selection.mjs','verify-budget.mjs','run-post-checks.mjs']){
  const bytes=await fs.readFile(path.join(here,name)),target='preserved/stage-executed/'+name+'.quiet.snapshot';
  try{assert.equal(await fingerprint(target),sha(bytes));}catch(error){if(error.code!=='ENOENT')throw error;await fs.writeFile(path.join(here,target),bytes);}
  snapshots[name]={path:target,sha256:sha(bytes)};
}
const median=values=>values.sort((a,b)=>a-b)[Math.floor(values.length/2)];
const timingReceipts=[];
for(const name of ['candidate-count-paired-1791832538174.json','candidate-count-paired-1791832905477.json','candidate-lean-paired-1791832996107.json']){
  const receiptPath='results/'+name,receipt=await read(receiptPath),confounded=receiptPath===disclosure.receipt;
  assert.equal(receipt.records.length,105);
  const candidateName=Object.keys(receipt.sourceHashes).find(key=>/^candidate-(?!baseline)/.test(key));
  const candidateHash=await fingerprint(candidateName);
  assert.equal(candidateHash,receipt.sourceHashes[candidateName]);
  assert.equal(receipt.sourceHashes['candidate-baseline.mjs'],preservation.productionSHA256);
  const executedSourceSnapshots={};
  for(const [source,hash]of Object.entries(receipt.sourceHashes)){
    const snapshot=source==='benchmark.mjs'&&confounded?'preserved/stage-executed/benchmark.mjs.v1.snapshot':snapshots[source]?.path??source;
    assert.equal(await fingerprint(snapshot),hash);executedSourceSnapshots[snapshot]=hash;
  }
