    {
      "id": "grafana.candidate.2232fa578c163ae218d6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Recorded queries allow you to see trends over time by taking a snapshot of a data point on a set interval. This can give you insight into historic trends.",
      "headingPath": [
        "Recorded queries (deprecated)"
      ],
      "source": {
        "path": "docs/sources/administration/recorded-queries/index.md",
