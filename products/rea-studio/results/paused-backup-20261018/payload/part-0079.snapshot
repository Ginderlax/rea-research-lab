    },
    {
      "id": "grafana.candidate.47572ae67fb4b43ef453",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Public dashboards insights provide valuable information about your public dashboard usage. You can easily access and view important metrics such as the daily query count, the number of views in the last 30 days, and the number of errors in the last 30 days.",
      "headingPath": [
        "What’s new in Grafana v10.0",
        "Public dashboards",
        "Public dashboards insights"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-0.md",
