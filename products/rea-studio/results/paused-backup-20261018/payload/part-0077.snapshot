    {
      "id": "grafana.candidate.906c26ea2c47f60b33c3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Specifies whether Grafana is running in Azure with Managed Identity configured (for example, running in a Azure Virtual Machines instance). Disabled by default, needs to be explicitly enabled.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[azure]`",
        "`managed_identity_enabled`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 1393,
        "lineEnd": 1393,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L1393-L1393"
      },
      "applicability": {
