    {
      "id": "grafana.candidate.6718979b344395cccb39",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The path, which is the final part of a channel, usually contains the identifier of some concrete resource such as the ID of a dashboard that a user is currently looking at. But a path can be anything.",
      "headingPath": [
        "Set up Grafana Live",
        "Grafana Live channel",
        "Channel structure"
      ],
