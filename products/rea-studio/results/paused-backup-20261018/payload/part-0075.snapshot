    {
      "id": "grafana.candidate.52b37155b793b4db951e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, notification messages include alert details, such as the number of alerts, their status, and annotations to help responders address alert issues. Notification messages can also be customized.",
      "headingPath": [
        "Introduction to Grafana Alerting",
        "Fundamentals",
        "Notification messages"
      ],
      "source": {
        "path": "docs/sources/alerting/fundamentals/_index.md",
