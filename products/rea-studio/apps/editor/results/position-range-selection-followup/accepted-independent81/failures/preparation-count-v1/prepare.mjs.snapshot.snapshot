import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,stage=path.resolve(here,'../editor-position-range-selection-fix-next'),repo=path.resolve(here,'../../outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex');async function keep(p,b){const q=path.join(here,p);await fs.mkdir(path.dirname(q),{recursive:true});await fs.writeFile(q,b,{flag:'wx'});}const mb=await fs.readFile(path.join(stage,'freeze-manifest.json'));assert.equal(sha(mb),'77ae818b4539341ab6f2f0126efaf8974117136f207747450d821df7c09baa1d');const m=JSON.parse(mb);assert.equal(m.files,319);assert(Array.isArray(m.inventory));for(const r of m.inventory){const b=await fs.readFile(path.join(stage,r.path));assert.equal(b.length,r.bytes,r.path);assert.equal(sha(b),r.sha256,r.path);}const rb=await fs.readFile(path.join(stage,'validation.json'));assert.equal(sha(rb),'a3c6ebeda22082c9c7e7d98f2ae71d501c873c60ba6473f860f66abdaf9fbd7c');const runtime=await fs.readFile(path.join(stage,'position-range-selection.mjs'));assert.equal(sha(runtime),'9f5d89b260e88fc1c2197d23a9c2b0ca25fcff688c5eba839471c7a4fe499aa8');assert.equal(sha(runtime.toString().replace('  apply:function(...values){','  apply(...values){').replace('  call:function(...values){','  call(...values){')),'7ad0b5ebb78ea575ca381551b7f827776523c606d9a481801f0eb34a67e2f1c1');
for(const p of['freeze-manifest.json','validation.json','README.md','source-stability-audit.json','source-transformations.json','contracts.json','inheritance-correction.json','acquisition.json','position-range-selection.mjs'])await keep('candidate/'+p+'.snapshot',await fs.readFile(path.join(stage,p)));const acquisition=JSON.parse(await fs.readFile(path.join(stage,'acquisition.json')));for(const r of acquisition.records)await keep(r.path,await fs.readFile(path.join(stage,r.path)));
const oracle=await fs.readFile(path.join(stage,'review-replay/oracle.mjs')),authority=await fs.readFile(path.join(stage,'review-replay/authority.mjs')),text=authority.toString().replace("stage=path.resolve(root,'../../editor-position-range-selection-next'),discovery=path.resolve(root,'../../vscode-extension-api-discovery-next')","stage=path.resolve(root,'../editor-position-range-selection-next'),discovery=path.resolve(root,'../vscode-extension-api-discovery-next')");assert.notEqual(text,authority.toString());await keep('oracle.mjs',oracle);await keep('authority.mjs',text);await keep('adapters/original-authority.mjs.snapshot',authority);await keep('oracle-adapter.json',JSON.stringify({oracleSourceSHA256:sha(oracle),oracleEdited:false,authorityBeforeSHA256:sha(authority),authorityAfterSHA256:sha(text),authorityChanges:'Only two relative stage/discovery root resolutions; exact original/source/Node/parser gates unchanged',compiler:'Authenticated official TypeScript5.9.3, exact released source body composition; prior independent oracle reused, fresh test bodies owned'},null,2)+'\n');
const prior=JSON.parse(await fs.readFile(path.resolve(here,'../editor-search-save-current-browser-next/source-before.json'))),current=[];for(const old of prior.filter(r=>r.path.startsWith('products/rea-studio/apps/editor/'))){const b=await fs.readFile(path.join(repo,old.path)),r={path:old.path,bytes:b.length,sha256:sha(b),priorBrowserSHA256:old.sha256,matchesPrior:sha(b)===old.sha256};current.push(r);await keep('current-source/'+r.path+'.snapshot',b);}assert.equal(current.length,31);await keep('current-before.json',JSON.stringify(current,null,2)+'\n');await keep('authentication-before.json',JSON.stringify({at:new Date().toISOString(),candidateFiles:319,candidateManifestSHA256:sha(mb),candidateReceiptSHA256:sha(rb),candidateRuntimeSHA256:sha(runtime),inverseRuntimeSHA256:'7ad0b5ebb78ea575ca381551b7f827776523c606d9a481801f0eb34a67e2f1c1',originalSourceFiles:acquisition.records.length,currentEditorSources:31,matchesPriorBrowser31:current.every(r=>r.matchesPrior),candidateExecuted:false},null,2)+'\n');console.log(JSON.stringify({candidate319Authenticated:true,exactInverse:true,currentEditor31:current.length,originalSourceFiles:acquisition.records.length}));
