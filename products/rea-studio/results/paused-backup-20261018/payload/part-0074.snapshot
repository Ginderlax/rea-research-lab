    {
      "id": "grafana.candidate.a2f2bae747c8400329f6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Cloud Traces supports three redaction modes that control how unauthorized spans are handled in trace by ID search responses. The active mode is configured per tenant. To change the mode for your organization, contact Grafana Support.",
