    {
      "id": "grafana.candidate.c59b355b3872f684a031",
      "syntaxRole": "table-row",
      "sourceText": "| Calculate from data | This setting determines if the data is already a calculated heatmap (from the data source/transformer), or one that should be calculated in the panel. |",
      "headingPath": [
        "Heatmap",
        "Configuration options",
        "Heatmap options"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/heatmap/index.md",
