import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {spawn} from 'node:child_process';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const root=fileURLToPath(new URL('./',import.meta.url)),hash=bytes=>createHash('sha256').update(bytes).digest('hex'),baseline=JSON.parse(await fs.readFile(path.join(root,'production-baseline-manifest.json'),'utf8'));
async function baselineStable(){for(const item of baseline.files){assert.equal(hash(await fs.readFile(path.join(baseline.productionRoot,item.path))),item.sha256);assert.equal(hash(await fs.readFile(path.join(root,'production-baseline',item.path))),item.sha256);}}await baselineStable();
async function walk(folder,prefix=''){const names=[];for(const item of await fs.readdir(path.join(root,folder),{withFileTypes:true})){const name=prefix+item.name;if(item.isDirectory())names.push(...await walk(path.join(folder,item.name),name+'/'));else names.push(name);}return names;}
const sourceNames=['preserve-baseline.mjs','prepare-references.mjs','preview.mjs','preview-client.mjs','verify-stage.mjs','README.md','THIRD-PARTY-NOTICE.md','source-provenance.json','production-baseline-manifest.json'];for(const prefix of ['apps/sketch','lib','references'])for(const name of await walk(prefix))if(/\.(mjs|md|ts|txt)$/.test(name))sourceNames.push(prefix+'/'+name);
async function fingerprints(names){const rows=[];for(const name of names){const bytes=await fs.readFile(path.join(root,name));rows.push({path:name,bytes:bytes.length,sha256:hash(bytes)});}return rows;}
const before=await fingerprints(sourceNames.sort()),startedAtUtc=new Date().toISOString();const child=spawn(process.execPath,['--test','--test-concurrency=1','--test-reporter=tap',...['app.test.mjs','client.test.mjs','vendor-oracle.test.mjs','geometry.test.mjs','geometry-client.test.mjs'].map(name=>path.join(root,'apps/sketch',name))],{cwd:path.resolve(root,'../../'),windowsHide:true}),stdout=[],stderr=[];child.stdout.on('data',bytes=>stdout.push(bytes));child.stderr.on('data',bytes=>stderr.push(bytes));const exitCode=await new Promise(resolve=>child.on('close',resolve));const out=Buffer.concat(stdout),err=Buffer.concat(stderr);await fs.writeFile(path.join(root,'tests-final.stdout.txt'),out);await fs.writeFile(path.join(root,'tests-final.stderr.txt'),err);assert.equal(exitCode,0);const text=out.toString('utf8'),summary=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(label=>[label,Number(text.match(new RegExp(`^# ${label} (\\d+)$`,'m'))?.[1]??-1)]));assert.deepEqual(summary,{tests:28,pass:28,fail:0,cancelled:0,skipped:0,todo:0});assert.deepEqual(await fingerprints(sourceNames.sort()),before);await baselineStable();
const browser=JSON.parse(await fs.readFile(path.join(root,'browser-observations.json'),'utf8'));assert.ok(Object.values(browser.checks).every(Boolean));assert.equal(browser.consoleErrors.length,0);const browserSources=before.filter(item=>['apps/sketch/core.mjs','apps/sketch/client.mjs','apps/sketch/server.mjs','lib/storage.mjs','preview.mjs','preview-client.mjs'].includes(item.path));browser.sourceFingerprints=browserSources;browser.screenshot={path:'browser-proof.jpg',sha256:hash(await fs.readFile(path.join(root,'browser-proof.jpg'))),unalteredNativeCapture:true};browser.privateHostStopped=true;browser.privateAgentTabClosed=true;await fs.writeFile(path.join(root,'browser-evidence.json'),JSON.stringify(browser,null,2)+'\n');
const oldOracle=await import('./apps/sketch/vendor-oracle.mjs');const vendorResult=await oldOracle.runOracle();await fs.writeFile(path.join(root,'original-legacy-observations.json'),JSON.stringify(vendorResult,null,2)+'\n');const geometry=JSON.parse(await fs.readFile(path.join(root,'geometry-original-observations.json'),'utf8'));assert.equal(geometry.comparisons.length,17);const evidenceNames=['tests-final.stdout.txt','tests-final.stderr.txt','tests-first.stdout.txt','tests-first.stderr.txt','client-first.stdout.txt','client-first.stderr.txt','client-final.stdout.txt','client-final.stderr.txt','references.stdout.txt','references.stderr.txt','geometry-original-observations.json','original-legacy-observations.json','browser-observations.json','browser-evidence.json','browser-proof.jpg',...await walk('failures').then(names=>names.map(name=>'failures/'+name))],evidence=await fingerprints(evidenceNames.sort());
const report={schema:'rea-sketch-geometry-stage-validation/v1',startedAtUtc,completedAtUtc:new Date().toISOString(),runtime:process.version,platform:process.platform,summary,sourceBytesStableAcrossRun:true,productionBytesStableAcrossRun:true,sourceFingerprints:before,productionBaselineFingerprints:baseline.files,evidenceFingerprints:evidence,original:geometry.original,sourceAssisted:true,applicationUsesOriginalRuntime:false,originalComparativeContexts:17,unchangedOriginalHelpers:geometry.unchangedHelpers,legacyOriginalOracle:vendorResult.assertions,browserChecks:browser.checks,privatePreviewOrigin:browser.origin,privateHostStopped:true,failuresPreserved:true,failureTypes:['Reference map lacked erased type definitions; pinned official commit fallback','Two client-test harness errors; no runtime source change','Documentation patch validation error','Clipped screenshot timeout; unchanged native full capture succeeded'],remainingGaps:['Normal diamond anchor contract compared; sub-pixel/degenerate clamp is intentionally different','Curved/multi-point/bound lines, locked/rotated objects and unknown types preserve as opaque records','Native rough/pressure renderer, external binding repair, fonts and full original UI not exercised','Browser covered actual local drawing/history/persistence; original compatibility is finite helper/API evidence','No full feature/security/performance conclusion'],fullFeatureParity:false,productionSecurityVerified:false,universalSuperiority:false,productionIntegrated:false};const receipt=path.join(root,'stage-validation.json');await fs.writeFile(receipt,JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({summary,sourceFiles:before.length,productionFiles:baseline.files.length,evidenceFiles:evidence.length,originalContexts:geometry.comparisons.length,browserChecks:Object.keys(browser.checks).length,receiptSha256:hash(await fs.readFile(receipt)),runtime:before.filter(item=>['apps/sketch/core.mjs','apps/sketch/client.mjs','apps/sketch/server.mjs'].includes(item.path))}));
