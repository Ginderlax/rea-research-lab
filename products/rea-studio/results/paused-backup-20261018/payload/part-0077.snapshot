    {
      "id": "grafana.candidate.3fe62f2e247031c5929e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The Grafana server has several built-in security features that you can opt-in to enhance security. This section describes additional techniques you can use to harden security.",
      "headingPath": [
        "Configure security hardening",
        "Additional security hardening"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md",
        "gitBlobSha": "3d53e64d215efc829e6827f523ce8947fa777722",
        "sha256": "a854d8317e4a2fc51bb82f7a31ee6438dc48f45d8ae483e504521c35e34c73df",
