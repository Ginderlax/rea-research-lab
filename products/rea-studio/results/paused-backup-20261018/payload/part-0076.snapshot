      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.1ad00008442f09985d60",
      "syntaxRole": "table-row",
      "sourceText": "| **Query Type**  | Sets the type of data the query returns: **Profile** for flame graph data, **Metric** for time-series data, or **Both**. You can only select **Both** in Explore. Panels on dashboards allow only one visualization.       |",
      "headingPath": [
        "Query profile data",
        "Pyroscope query editor",
        "Query options"
      ],
      "source": {
        "path": "docs/sources/datasources/pyroscope/query-editor/index.md",
        "gitBlobSha": "f610ea6b5c725af436b9ddfad56ce462b258b8f0",
        "sha256": "c2bb15fd3956e70aee467819618adca7470b3f5b2a1f9f22afee217306b82382",
        "lineStart": 117,
        "lineEnd": 117,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/pyroscope/query-editor/index.md#L117-L117"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.1fbf794e356175e1438e",
      "syntaxRole": "table-row",
      "sourceText": "| **Group by**    | Groups metric data by one or more labels. Without a **Group by** label, metric data aggregates over all labels into a single time series. **Group by** applies only to metric data and doesn't change the profile results. |",
      "headingPath": [
        "Query profile data",
        "Pyroscope query editor",
        "Query options"
      ],
      "source": {
        "path": "docs/sources/datasources/pyroscope/query-editor/index.md",
        "gitBlobSha": "f610ea6b5c725af436b9ddfad56ce462b258b8f0",
        "sha256": "c2bb15fd3956e70aee467819618adca7470b3f5b2a1f9f22afee217306b82382",
        "lineStart": 118,
        "lineEnd": 118,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/pyroscope/query-editor/index.md#L118-L118"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.4fe9baa7961c5aeb5c64",
      "syntaxRole": "table-row",
      "sourceText": "| **Limit**       | Sets the maximum number of time series returned when **Group by** is set. The series returned are always ordered by descending value for the total aggregated data over the time period. Doesn't apply to profile queries. |",
      "headingPath": [
        "Query profile data",
        "Pyroscope query editor",
        "Query options"
      ],
      "source": {
        "path": "docs/sources/datasources/pyroscope/query-editor/index.md",
        "gitBlobSha": "f610ea6b5c725af436b9ddfad56ce462b258b8f0",
        "sha256": "c2bb15fd3956e70aee467819618adca7470b3f5b2a1f9f22afee217306b82382",
        "lineStart": 119,
        "lineEnd": 119,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/pyroscope/query-editor/index.md#L119-L119"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.321b6732bcea91058fbf",
      "syntaxRole": "table-row",
      "sourceText": "| **Span ID**     | Sets the span ID from which to search for profiles, so you can view the profile associated with a specific trace span. This option supports Trace to profiles, for example, `64f170a95f537095`.                            |",
      "headingPath": [
        "Query profile data",
        "Pyroscope query editor",
        "Query options"
      ],
      "source": {
        "path": "docs/sources/datasources/pyroscope/query-editor/index.md",
        "gitBlobSha": "f610ea6b5c725af436b9ddfad56ce462b258b8f0",
        "sha256": "c2bb15fd3956e70aee467819618adca7470b3f5b2a1f9f22afee217306b82382",
        "lineStart": 120,
        "lineEnd": 120,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/pyroscope/query-editor/index.md#L120-L120"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.d38f5c88eff49a9a9ee2",
      "syntaxRole": "table-row",
      "sourceText": "| **Max Nodes**   | Sets the maximum number of nodes rendered in the flame graph. Lower values improve performance for large profiles by aggregating smaller nodes. The field placeholder shows the default value, `16384`.                    |",
      "headingPath": [
        "Query profile data",
        "Pyroscope query editor",
        "Query options"
      ],
      "source": {
        "path": "docs/sources/datasources/pyroscope/query-editor/index.md",
