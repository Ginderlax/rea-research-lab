    },
    {
      "id": "grafana.candidate.025dafa0bd893dc93ec8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "But with a single data source, it would display just the value of the query:",
      "headingPath": [
        "Annotation and label template reference",
        "Variables",
        "$values",
        "$value"
      ],
      "source": {
