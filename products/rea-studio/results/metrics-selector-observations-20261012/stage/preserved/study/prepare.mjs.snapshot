import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const here=fileURLToPath(new URL('./',import.meta.url)),old=path.resolve(here,'../metrics-standard-dispatch-next'),selector=path.resolve(here,'../metrics-selector-control-next'),workspace=path.resolve(here,'../..'),studio=path.join(workspace,'outputs/rea-research-lab/products/rea-studio'),sha=b=>createHash('sha256').update(b).digest('hex');
const oldBytes=await fs.readFile(path.join(old,'measurement-validation.json')),selectorBytes=await fs.readFile(path.join(selector,'selector-validation.json'));
assert.equal(sha(oldBytes),'8a7abd6333e050ed838fdde07415d26485b58b31452d8ed6d561d40f374bca9d');assert.equal(sha(selectorBytes),'b582c0da35dcd8b81a701cd1252c995c0ffb1e7307932b5b9f1279e737378aa6');
const oldReceipt=JSON.parse(oldBytes),selectorReceipt=JSON.parse(selectorBytes),copies=[];
async function copy(root,name,target,expected){const bytes=await fs.readFile(path.join(root,name));assert.equal(sha(bytes),expected.sha256,name);assert.equal(bytes.length,expected.bytes,name);const output=path.join(here,target);await fs.mkdir(path.dirname(output),{recursive:true});await fs.writeFile(output,bytes,{flag:'wx'});copies.push({sourceRoot:root,sourcePath:name,path:target,bytes:bytes.length,sha256:sha(bytes)});}
for(const name of ['canonical.mjs','authenticate-original.mjs','watch-owned-process.ps1','parse-observer.ps1'])await copy(old,name,name,oldReceipt.inventory[name]);
for(const name of ['memory-worker.mjs','memory-runner.mjs','benchmark-worker.mjs','benchmark.mjs','timing-runner.mjs','harness.test.mjs','check-harnesses.mjs'])await copy(old,name,'preserved/harness-baseline/'+name,oldReceipt.inventory[name]);
for(const name of ['candidate-baseline.mjs','candidate-module-control.mjs','selector-control.mjs'])await copy(selector,name,name,selectorReceipt.inventory[name]);
for(const name of ['candidate-contract.json','results/candidate-module-control.json','results/full-boundary-attempt-1791838474977.json','results/selector-controls.json','results/work-cap.json','verify-work-cap.mjs'])await copy(selector,name,'preserved/selector/'+name,selectorReceipt.inventory[name]);
await copy(selector,'preserved/sources.json','preserved/sources.json',selectorReceipt.inventory['preserved/sources.json']);
for(const[name,bytes]of [['preserved/previous-measurement-validation.json',oldBytes],['preserved/selector-validation.json',selectorBytes]])await fs.writeFile(path.join(here,name),bytes,{flag:'wx'});
const productionNames=['server.mjs','catalog.mjs','lib/storage.mjs','apps/metrics/server.mjs','apps/metrics/client.mjs','apps/metrics/core.mjs','apps/metrics/native-calculations.mjs','apps/metrics/results/native-calculations-verification.json'],production=[];
for(const name of productionNames){const bytes=await fs.readFile(path.join(studio,name));if(name.endsWith('/native-calculations.mjs'))assert.equal(sha(bytes),'9269cf8c32be9bf2c075b67019e82e41272d9495f0321fefc17b2c5695a91371');const output=path.join(here,'preserved/production',name+'.snapshot');await fs.mkdir(path.dirname(output),{recursive:true});await fs.writeFile(output,bytes,{flag:'wx'});production.push({path:name,bytes:bytes.length,sha256:sha(bytes)});}
await fs.writeFile(path.join(here,'preservation.json'),JSON.stringify({schemaVersion:1,createdAt:new Date().toISOString(),previousMeasurementReceiptSHA256:sha(oldBytes),selectorReceiptSHA256:sha(selectorBytes),copies,production,scope:'Exact bounded selected snapshots from frozen prior studies; no older source/evidence written. Current source identities/route inspection only; no timing/memory workload.'},null,2)+'\n',{flag:'wx'});
await fs.mkdir(path.join(here,'results'),{recursive:true});await fs.mkdir(path.join(here,'fixtures'),{recursive:true});console.log(JSON.stringify({copies:copies.length,productionSnapshots:production.length,oldStagesChanged:false}));
