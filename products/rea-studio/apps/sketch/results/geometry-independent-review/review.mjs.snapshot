import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import {spawnSync} from 'node:child_process';import {gunzipSync} from 'node:zlib';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),lab=path.resolve(here,'../../outputs/rea-research-lab'),studio=path.join(lab,'products/rea-studio'),app=path.join(studio,'apps/sketch'),study=path.join(app,'results/geometry-source-study'),hash=b=>createHash('sha256').update(b).digest('hex'),read=async p=>JSON.parse(await fs.readFile(p,'utf8'));
const receiptBytes=await fs.readFile(path.join(app,'results/geometry-validation.json')),receipt=JSON.parse(receiptBytes),manifestBytes=await fs.readFile(path.join(study,'manifest.json')),manifest=JSON.parse(manifestBytes);assert.ok(hash(receiptBytes).startsWith('728f'));assert.equal(hash(manifestBytes),'73e5206e093c2a610117509ebb57508534b48a30cf77ea793577812b49e63bf9');assert.equal(manifest.files.length,90);assert.equal(manifest.sourceFiles,51);assert.equal(manifest.productionBaseline.length,11);
const rows=[];async function preserve(source,relative){const bytes=await fs.readFile(source),target=path.join(here,'baseline',relative);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,bytes,{flag:'wx'});rows.push({source:path.relative(lab,source).replaceAll('\\','/'),path:'baseline/'+relative,bytes:bytes.length,sha256:hash(bytes)});return bytes;}
for(const row of manifest.files){assert.ok(row.path&&!path.isAbsolute(row.path)&&!row.path.split(/[\\/]/).includes('..'));const bytes=await preserve(path.join(study,row.path),'study/'+row.path);assert.equal(bytes.length,row.bytes);assert.equal(hash(bytes),row.sha256);}
for(const row of receipt.sourceFingerprints){const bytes=await preserve(path.join(app,row.path),'app/'+row.path);assert.equal(bytes.length,row.bytes);assert.equal(hash(bytes),row.sha256);}
await preserve(path.join(app,'results/geometry-validation.json'),'geometry-validation.json');await preserve(path.join(study,'manifest.json'),'study-manifest.json');const collector=await preserve(path.join(studio,'scripts/verify-sketch-geometry.mjs'),'verify-sketch-geometry.mjs');assert.equal(hash(collector),receipt.collectorSha256);for(const row of receipt.evidence){const bytes=await preserve(path.join(app,row.path),'app/'+row.path);assert.equal(bytes.length,row.bytes);assert.equal(hash(bytes),row.sha256);}
for(const name of ['core.mjs','client.mjs'])assert.deepEqual(await fs.readFile(path.join(app,name)),await fs.readFile(path.join(study,'stage-source/apps/sketch/'+name+'.snapshot')));
const stageReceipt=await read(path.join(study,'stage-evidence/stage-validation.json.snapshot'));assert.equal(hash(await fs.readFile(path.join(study,'stage-evidence/stage-validation.json.snapshot'))),receipt.reviewedStageReceiptSha256);for(const row of stageReceipt.sourceFingerprints)assert.equal(hash(await fs.readFile(path.join(study,'stage-source/'+row.path+'.snapshot'))),row.sha256);for(const row of manifest.productionBaseline)assert.equal(hash(await fs.readFile(path.join(study,'production-before/'+row.path+'.snapshot'))),row.sha256);
const provenance=await read(path.join(study,'stage-source/source-provenance.json.snapshot')),original={};for(const [name,file]of [['archive','package.tgz'],['bundle','bundle.js'],['map','source-map.json']]){original[name]=await fs.readFile(path.join(app,'.local/original',file));assert.equal(hash(original[name]),receipt.originalPins[name]);}
const tar=gunzipSync(original.archive,{maxOutputLength:256*1024*1024});const archiveEntries=new Map();for(let offset=0;offset+512<=tar.length;){const header=tar.subarray(offset,offset+512);if(header.every(value=>value===0))break;const name=header.subarray(0,100).toString().replace(/\0.*$/s,''),size=parseInt(header.subarray(124,136).toString().replace(/\0.*$/s,'').trim(),8)||0;assert.ok(Number.isSafeInteger(size)&&size>=0&&offset+512+size<=tar.length);if(name==='package/dist/dev/chunk-4FTI6OG3.js'||name==='package/dist/dev/chunk-4FTI6OG3.js.map')archiveEntries.set(name,tar.subarray(offset+512,offset+512+size));offset+=512+Math.ceil(size/512)*512;}
assert.deepEqual(archiveEntries.get('package/dist/dev/chunk-4FTI6OG3.js'),original.bundle);assert.deepEqual(archiveEntries.get('package/dist/dev/chunk-4FTI6OG3.js.map'),original.map);assert.equal(provenance.unchangedTestOnlyHelpers.length,25);for(const row of provenance.unchangedTestOnlyHelpers){const helper=await fs.readFile(path.join(study,'stage-source/'+row.path+'.snapshot'));assert.equal(hash(helper),row.sha256);assert.deepEqual(original.bundle.subarray(row.byteStart,row.byteStart+row.byteLength),helper);}
const map=JSON.parse(original.map),references=[];for(const row of provenance.sources??provenance.retainedSources??[]){const source=await fs.readFile(path.join(study,'stage-source/'+row.path+'.snapshot'));assert.equal(hash(source),row.sha256);if(row.authenticatedFromOfficialArchive){const index=map.sources.indexOf(row.releaseSourceMapPath);assert.ok(index>=0);assert.equal(hash(map.sourcesContent[index]),row.sha256);}references.push({path:row.path,sha256:row.sha256,authenticatedAgainstReleaseSourceMap:row.authenticatedFromOfficialArchive===true,pinnedCommitFetch:row.pinnedCommitFetch===true});}
const previousRaw=await fs.readFile(path.join(app,'results/geometry-tests.stdout.txt'),'utf8'),marker=previousRaw.match(/^# SKETCH_GEOMETRY_OBSERVATIONS (.+)$/m);assert.ok(marker);const marked=JSON.parse(marker[1]),detailed=await read(path.join(app,'results/geometry-original-observations.json'));assert.equal(marked.comparativeContexts,17);assert.deepEqual(marked.directCalls,{getDiamondPoints:8,getSizeFromPoints:8,getNormalizedDimensions:0,restoreElement:18,serializeAsJSON:1});assert.equal(marked.totalDirectCalls,35);assert.deepEqual(detailed.geometry.directCalls,marked.directCalls);assert.equal(detailed.geometry.comparisons.length,17);assert.equal(detailed.legacy.assertions.originalIndividualElementRestoration.count,6);
const observations=path.join(here,'observations');await fs.mkdir(observations,{recursive:true});const env={...process.env,REA_SKETCH_OBSERVATION_DIR:observations};delete env.NODE_TEST_CONTEXT;const run=spawnSync(process.execPath,['--test','--test-concurrency=1','--test-reporter=tap',...['app.test.mjs','client.test.mjs','vendor-oracle.test.mjs','geometry.test.mjs','geometry-client.test.mjs'].map(name=>'apps/sketch/'+name)],{cwd:studio,env,encoding:'utf8',windowsHide:true,timeout:30000,maxBuffer:4*1024*1024});await fs.writeFile(path.join(here,'tests.stdout.txt'),run.stdout,{flag:'wx'});await fs.writeFile(path.join(here,'tests.stderr.txt'),run.stderr,{flag:'wx'});assert.equal(run.status,0,run.stderr);const summary=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(name=>[name,Number(run.stdout.match(new RegExp('^# '+name+' (\\d+)$','m'))?.[1])]));assert.deepEqual(summary,{tests:28,pass:28,fail:0,cancelled:0,skipped:0,todo:0});for(const row of rows)assert.equal(hash(await fs.readFile(path.join(lab,row.source))),row.sha256,'Frozen production/results/source changed '+row.source);
const core=await import(new URL('../../outputs/rea-research-lab/products/rea-studio/apps/sketch/core.mjs',import.meta.url)),scene=shape=>({name:'Independent synthetic geometry',shapes:[shape],view:{zoom:1,x:0,y:0}}),base={id:'synthetic',x:0,y:0,w:100,h:80,type:'diamond'},checks=[];
function polygonHit(points,x,y){let inside=false;for(let a=0,b=points.length-1;a<points.length;b=a++){const pa=points[a],pb=points[b];if(((pa[1]>y)!==(pb[1]>y))&&(x<(pb[0]-pa[0])*(y-pa[1])/(pb[1]-pa[1])+pa[0]))inside=!inside;}return inside;}
let gridPoints=0;for(const dimensions of [[100,80],[3,5],[-99,-43],[0.25,0.5]]){const d=core.validateScene(scene({...base,w:dimensions[0],h:dimensions[1]})).shapes[0],points=core.diamondPoints(d),b=core.bounds(d);for(let x=b.x+b.w*.071;x<b.x+b.w;x+=Math.max(b.w*.089,.0001))for(let y=b.y+b.h*.113;y<b.y+b.h;y+=Math.max(b.h*.079,.0001)){assert.equal(core.hitShape(d,x,y,0),polygonHit(points,x,y));gridPoints++;}}
checks.push({name:'independent polygon ray-crossing versus actual zero-tolerance hit geometry',sampledPoints:gridPoints});for(const [w,h]of [[-100,80],[100,-80],[-100,-80],[0,0]]){const s=core.validateScene(scene({...base,type:'line',w,h})).shapes[0],doc=core.exportExcalidraw(scene(s));assert.equal(doc.elements[0].points[1][0],w);assert.equal(doc.elements[0].points[1][1],h);assert.deepEqual(core.exportExcalidraw(core.importExcalidraw(doc)),doc);}checks.push({name:'signed line independent zero/negative output/import cases',cases:4});
const opaque=core.exportExcalidraw(scene(base));opaque.unknown=JSON.parse('{"__proto__":{"inert":true},"future":[1,2]}');opaque.elements[0].angle=.25;opaque.elements[0].customData={retained:'<script>inert</script>'};assert.deepEqual(core.exportExcalidraw(core.importExcalidraw(opaque)),opaque);assert.equal({}.inert,undefined);assert.doesNotMatch(core.svg(core.importExcalidraw(opaque)),/script|polygon/);checks.push({name:'opaque rotated own-prototype metadata preserved without SVG rendering'});
assert.throws(()=>core.validateDocument({type:'excalidraw',version:2,elements:[],oversized:'a'.repeat(4*1024*1024)}),/4 MiB/);assert.throws(()=>core.validateDocument({type:'excalidraw',version:2,elements:[{id:'bad',type:'diamond',x:Infinity}]}),/finite/);checks.push({name:'native output/document size and non-finite bounds reject'});
const output={schema:'rea-sketch-geometry-independent-production-review/v1',checkedAtUtc:new Date().toISOString(),runtime:process.version,scope:'Read-only source/preservation/original binding review; focused 28 tests run directly with observation directory under this review. No app/results or production source mutation.',acceptedFiniteSlice:true,productionReceiptSha256:hash(receiptBytes),studyManifestSha256:hash(manifestBytes),preservationFilesVerified:90,stageSourcesVerified:51,baselineFilesVerified:11,coreAndClientExactStage:true,originalArchiveBundleAndMapAuthenticated:true,unchangedHelperSlicesVerified:25,sourceReferences:references,summary,originalCampaign:{contexts:17,directCalls:marked.directCalls,totalGeometryDirectCalls:35,legacyFixtureIndividualRestorations:6,fullOriginalRendererUiExecutions:0,scope:'35 is geometry campaign count only; legacy fixture assertions/executions are separate, not a whole-suite total.'},independentChecks:checks,sourceAndPublishedEvidenceBytesStableAcrossReview:true,sourceFingerprints:rows,rawEvidence:{stdoutSha256:hash(run.stdout),stderrSha256:hash(run.stderr)},confirmedFindings:[],limits:['Existing geometry persistence test leaves owned synthetic app .local/test-fixtures directories; it does not write published results, and universal cleanup is not claimed.','Legacy runOracle has additional helper calls beyond its six-element restoration corpus. The collector invokes it again after the 28-test child. The geometry35 tally does not include either legacy run.','SVG is editable-projection-only; opaque native records and metadata are preserved but not rendered. Tiny/degenerate diamond clamping and transparent interior geometric selection remain explicit deviations.','Collector accumulates child raw streams without a configured child timeout or log cap; finite frozen corpus passed, but adversarial/unbounded collector-output robustness is not demonstrated.','No full original UI/renderer/default repair, original-grade security, performance superiority or real-world parity conclusion.'],fullParity:false,securityCertified:false,performanceSuperiority:false};await fs.writeFile(path.join(here,'review-validation.json'),JSON.stringify(output,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({summary,preservation:90,helpers:25,checks,receiptSha256:hash(JSON.stringify(output,null,2)+'\n')}));
