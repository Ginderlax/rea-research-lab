    {
      "id": "grafana.candidate.c2fb9e90ae1ede8f4ecb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We announced the deprecation of the grafana/toolkit in v9.3 (November 2022) and have a new tool called create-plugin now available as a replacement. We encourage you to migrate and use our updated tooling. All grafana/toolkit commands except `build` are removed in Grafana v10.",
      "headingPath": [
        "Breaking changes in Grafana v10.0",
        "For Plugin Developers",
        "grafana/toolkit CLI commands have been removed and migrated to the create-plugin package",
        "Description"
      ],
      "source": {
        "path": "docs/sources/breaking-changes/breaking-changes-v10-0.md",
        "gitBlobSha": "f55c473a793866712b72c992a0f3e962e71e945b",
