import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import {spawn} from 'node:child_process';
import {createHash} from 'node:crypto';
import {collect} from './tap-observations.mjs';
import {start} from './products/rea-studio/server.mjs';
const root=import.meta.dirname,app='products/rea-studio/apps/notes/',study=app+'results/notebooks-followup/',sha=b=>createHash('sha256').update(b).digest('hex'),run=path.join(root,'runs',new Date().toISOString().replaceAll(':','-'));
await fs.mkdir(run,{recursive:true});
const read=relative=>fs.readFile(path.join(root,relative)),json=async relative=>JSON.parse(await read(relative));
const preservation=await json(study+'preservation-manifest.json'),historical=await json(study+'stage/stage-validation.json.snapshot'),adaptations=await json('adaptations.json'),baseline=await json(study+'stage/baseline.json.snapshot');
assert.equal(preservation.count,283);assert.equal(preservation.files.length,283);assert.equal(preservation.originalManifestSha256,'825f8881734b845a8fac1c3fd26696dc0bf0ee79cc67a02cd6cd3d3c779d2f5c');assert.equal(preservation.originalReceiptSha256,'588dec534d9994a7ecccfa76930ad3a0cc363b5e90ca7562e1d280217c63d7f8');
async function fingerprint(relative){const bytes=await read(relative);return{path:relative,bytes:bytes.length,sha256:sha(bytes)};}
async function authenticate(){for(const e of preservation.files){assert.ok(e.preservedPath&&!e.preservedPath.includes('\\')&&!e.preservedPath.startsWith('/')&&!e.preservedPath.split('/').includes('..'));const b=await read(study+'stage/'+e.preservedPath);assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256,e.originalPath);}const carrier=await read(study+preservation.manifestCarrier.path);assert.equal(sha(carrier),preservation.originalManifestSha256);const receipt=await read(study+'stage/stage-validation.json.snapshot');assert.equal(sha(receipt),preservation.originalReceiptSha256);}
async function list(dir,relative=''){let out=[];for(const item of await fs.readdir(path.join(root,dir,relative),{withFileTypes:true})){if(item.name==='results')continue;const child=relative?relative+'/'+item.name:item.name;if(item.isDirectory())out.push(...await list(dir,child));else if(item.isFile())out.push(dir+'/'+child);else throw new Error('Unexpected source link.');}return out;}
const executableFiles=(await list('products')).sort(),ownedFiles=['record-adapter.mjs','tap-observations.mjs','held-review.mjs','held-review-adaptations.json','prepare-held-review.mjs','prepare-notes-notebooks-adapter.mjs','adaptations.json',study+'preservation-manifest.json'];
async function capture(){await authenticate();return Promise.all([...executableFiles,...ownedFiles].sort().map(fingerprint));}
const before=await capture();await fs.writeFile(path.join(run,'source-before.json'),JSON.stringify(before,null,2));for(const e of before){const target=path.join(run,'source-before',e.path+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,await read(e.path));}
const productionBefore=[];for(const e of baseline.sources){const b=await fs.readFile(path.resolve(root,'../../outputs/rea-research-lab',e.path));const actual=sha(b);if(!e.path.startsWith('products/rea-studio/requirements/'))assert.equal(actual,e.sha256,e.path);productionBefore.push({path:e.path,expectedSha256:e.sha256,sha256:actual,bytes:b.length,checkedAgainstHistorical:e.path.startsWith('products/rea-studio/requirements/')?false:true});}
await fs.writeFile(path.join(run,'production-before.json'),JSON.stringify(productionBefore,null,2));
for(const e of executableFiles){const original=preservation.files.find(x=>x.originalPath===e);assert.ok(original,'Unexpected executable fixture '+e);const current=before.find(x=>x.path===e),change=adaptations.changed.find(x=>x.path===e);assert.equal(current.sha256,change?.newSha256??original.sha256,e);if(change)assert.equal(change.oldSha256,original.sha256);}
async function child(label,args){const started=Date.now(),env={...process.env};delete env.NODE_TEST_CONTEXT;let outBytes=0,errorBytes=0,stdout=[],stderr=[],reason=null;const child=spawn(process.execPath,args,{cwd:root,windowsHide:true,env,stdio:['ignore','pipe','pipe']});const stop=why=>{if(!reason){reason=why;child.kill();}};const timer=setTimeout(()=>stop('child-deadline'),180000);child.stdout.on('data',b=>{outBytes+=b.length;if(outBytes>8*1024*1024)stop('stdout-cap');else stdout.push(b);});child.stderr.on('data',b=>{errorBytes+=b.length;if(errorBytes>2*1024*1024)stop('stderr-cap');else stderr.push(b);});const exit=await new Promise((resolve,reject)=>{child.once('error',reject);child.once('close',(code,signal)=>resolve({code,signal}));}).finally(()=>clearTimeout(timer));const text=Buffer.concat(stdout).toString('utf8'),errors=Buffer.concat(stderr).toString('utf8');await fs.writeFile(path.join(run,label+'.stdout.txt'),text);await fs.writeFile(path.join(run,label+'.stderr.txt'),errors);const receipt={...exit,reason,stdoutBytes:outBytes,stderrBytes:errorBytes,elapsedMs:Date.now()-started,args};await fs.writeFile(path.join(run,label+'.process.json'),JSON.stringify(receipt,null,2));assert.equal(reason,null);assert.equal(exit.code,0,errors+'\n'+text);return{text,receipt};}
const tests=['app.test.mjs','app.integration.test.mjs','jex.test.mjs','notebooks.test.mjs','notebooks.integration.test.mjs'];
const focused=await child('focused',['--test','--test-concurrency=1','--test-reporter=tap',...tests.map(p=>app+p)]),totals={};for(const key of ['tests','pass','fail','cancelled','skipped']){const hit=focused.text.match(new RegExp('^# '+key+' (\\d+)$','m'));assert.ok(hit,key);totals[key]=Number(hit[1]);}assert.deepEqual(totals,{tests:28,pass:28,fail:0,cancelled:0,skipped:0});
const originalObservations=collect(focused.text,'notebookOriginalObservations'),httpObservation=collect(focused.text,'notebookHttpObservation');assert.equal(originalObservations.length,2);assert.equal(originalObservations[0].comparisons,24);assert.equal(originalObservations[0].originalMoveContractExecutions,2);assert.equal(originalObservations[1].candidateOriginalMoveComparisons,2);assert.equal(originalObservations[1].originalMoveExecutions,2);
await fs.writeFile(path.join(run,'observations.json'),JSON.stringify({originalObservations,httpObservation},null,2));
const held=await child('held-review',['held-review.mjs']),heldReceipt=await json('.local/root-held-review/review-validation.json');assert.equal(heldReceipt.actualAdapterHeldPersistenceCases,2);assert.equal(heldReceipt.passed,true);await fs.copyFile(path.join(root,'.local/root-held-review/review-validation.json'),path.join(run,'held-review-validation.json'));
const data=await fs.mkdtemp(path.join(os.tmpdir(),'rea-notebook-adapter-routes-'));let host;const routes=[];try{host=await start({port:0,dataDir:data});for(const [route,status]of[['/apps/notes/client.mjs',200],['/apps/notes/markdown.mjs',200],['/apps/notes/server.mjs',404],['/apps/notes/notebooks.mjs',404],['/apps/notes/notebook-original-oracle.mjs',404],['/apps/notes/results/notebooks-followup/stage/source-provenance.json.snapshot',404],['/apps/notes/results/notebooks-followup/stage/source/packages/lib/models/Folder.ts.snapshot',404]]){const response=await fetch(host.url+route);await response.arrayBuffer();assert.equal(response.status,status,route);routes.push({route,status:response.status});}}finally{await host?.close();assert.equal(path.dirname(data),path.resolve(os.tmpdir()));assert.ok(path.basename(data).startsWith('rea-notebook-adapter-routes-'));await fs.rm(data,{recursive:true,force:true});}
const runtime=await Promise.all(['client.mjs','server.mjs','notebooks.mjs','jex.mjs','markdown.mjs'].map(async p=>({path:app+p,text:(await read(app+p)).toString('utf8')})));for(const e of runtime){assert.doesNotMatch(e.text,/from\s+['"][^'"]*(?:original-oracle|notebooks-followup|source\/)/);assert.doesNotMatch(e.text,/stripTypeScriptTypes|runInNewContext/);}
const after=await capture();assert.deepEqual(after,before);await fs.writeFile(path.join(run,'source-after.json'),JSON.stringify(after,null,2));
const productionAfter=[];for(const e of productionBefore){const b=await fs.readFile(path.resolve(root,'../../outputs/rea-research-lab',e.path));productionAfter.push({path:e.path,sha256:sha(b),bytes:b.length});assert.equal(sha(b),e.sha256,'Production source changed while adapting '+e.path);}await fs.writeFile(path.join(run,'production-after.json'),JSON.stringify(productionAfter,null,2));
const receipt={schema:'rea-notebook-production-adapter-run/v1',checkedAt:new Date().toISOString(),run:path.relative(root,run).replaceAll('\\','/'),sourceStable:true,productionChanged:false,all283OriginalBytesPreserved:true,adaptations,totals,actualAdapterHeldPersistenceCases:2,heldObservations:heldReceipt.observations,routes,originalAccounting:{nestingComparisons:20,pathComparisons:4,candidateOriginalMoveComparisons:2,exactComparisons:26,additionalOriginalMoveContractExecutions:2,originalMoveExecutionsIncludingComparedCases:4,originalMethodContexts:3,originalFullApplicationExecutions:0,originalDatabaseExecutions:0,originalGuiExecutions:0,fixedClockAndMemoryPersistenceStubs:true},originalObservations,httpObservation,old22SerializerReceipt:{sha256:'82b53a9c9c0594b0364f2752e78bef85d374d53a2f4a5b2580daa8edc6079d9f',checks:22,rebound:false},historicalStageReceiptSha256:preservation.originalReceiptSha256,historicalManifestSha256:preservation.originalManifestSha256,sourceFingerprints:before,processes:{focused:focused.receipt,held:held.receipt},runtimeOriginalImports:false,fullProductParity:false,securitySuperiority:false,performanceCompared:false};await fs.writeFile(path.join(run,'validation.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({passed:true,run:receipt.run,totals,heldCases:2,preservation:283,sourceStable:true}));
