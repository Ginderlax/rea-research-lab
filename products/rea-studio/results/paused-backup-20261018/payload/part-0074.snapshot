    {
      "id": "grafana.candidate.24f20434d48ac7b65732",
      "syntaxRole": "list-item",
      "sourceText": "- **Admin**: Can create, edit, or delete a dashboard. Can edit or delete a folder, and create dashboards and subfolders in a folder. Administrators can also change dashboard and folder permissions.",
      "headingPath": [
        "Roles and permissions",
        "Dashboard permissions"
      ],
      "source": {
