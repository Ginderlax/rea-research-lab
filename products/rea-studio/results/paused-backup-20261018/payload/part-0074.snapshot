        "sha256": "dafa7c19ee68542fc45ac71e3acad55935ca1bfe337a2b0e08cd56fbf4106578",
        "lineStart": 84,
        "lineEnd": 84,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/recorded-queries/index.md#L84-L84"
      },
      "applicability": {
