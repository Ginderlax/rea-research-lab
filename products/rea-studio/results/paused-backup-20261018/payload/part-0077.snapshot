    {
      "id": "grafana.candidate.50e01431a2513f3c104b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To enable JWT ID token validation:",
      "headingPath": [
        "Configure Okta OIDC authentication",
        "Configure Okta authentication client using the Grafana configuration file",
        "Configure JWT ID token validation"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/okta/index.md",
        "gitBlobSha": "4de8751f865ff55ac58451811f4eafc681a66671",
