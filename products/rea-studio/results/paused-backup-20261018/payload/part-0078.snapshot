    {
      "id": "grafana.candidate.a5b398e838bf6c37d345",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you open a panel in full-screen view mode, Grafana displays a **View panel** sidebar with controls for adjusting the panel. These controls make it easier to view specific data or identify patterns and correlations. Because these controls exist in view mode, you don't need edit permissions to use them, and the changes you make don't affect the saved dashboard.",
      "headingPath": [
        "Panel overview",
        "View mode panel controls"
      ],
