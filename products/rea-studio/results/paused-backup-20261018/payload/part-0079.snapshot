    {
      "id": "grafana.candidate.4b30ab05b00bcf896c01",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now use more parameters to find traces.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Grafana OSS features",
        "Data source updates",
        "Jaeger data source"
      ],
