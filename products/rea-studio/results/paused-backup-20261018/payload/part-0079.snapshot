    {
      "id": "grafana.candidate.49f7eee3d04f1062087a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, the starting value of a gauge is the minimum value, not zero. You can change the starting value from which every gauge will be filled when you don't want it to be the minimum value. This option is especially useful in cases where the range of data values includes negative numbers. If you leave this empty, Grafana uses the configured minimum value.",
      "headingPath": [
        "Gauge",
        "Configuration options",
        "Gauge options",
        "Neutral value"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/gauge/index.md",
        "gitBlobSha": "f93201fcfc0254672ca2ebc6f3763e46a0c1d600",
        "sha256": "fb8fdde6ddeb541c69a34e35a5f1025dfc106f6e570786c8f031cdf66b571194",
        "lineStart": 156,
        "lineEnd": 159,
