const sourceFiles={};for(const name of ['candidate-baseline.mjs','candidate-inline-control.mjs','candidate-module-control.mjs','selector-control.mjs','verify-selector-controls.mjs','canonical.mjs','authenticate-original.mjs'])sourceFiles[name]=sha(await fs.readFile(path.join(here,name)));const receipt={schemaVersion:1,checkedAt:new Date().toISOString(),status:failures.length?'failed':'passed',authority,sourceFiles,seed:'0x41d7be69',inputs:cases.length,inputSHA256:corpus.digest('hex'),actualInputFixture:{path:'fixtures/selector-heldout.graph.jsonl',bytes:Buffer.byteLength(corpusText),sha256:sha(corpusText)},expectedOutputSHA256:outputs.digest('hex'),comparisons:comparisonCount,counts,registryComparisons:registryCount,boundedMultiSelectionComparisons:boundedMultiCount,cacheAliasComparisons:cacheAliasCount,emptyMissingExceptionComparisons:exceptionCount,failures,scope:'Independently shaped p95 and standard/multi-selection controls plus truthy direct registry flags, bounded 25000-sample cache/array-alias cases and empty/missing shortcuts. Original versus baseline, exact inline comparator and new module-boundary candidate; no performance measurements.',timingMeasurementRun:false,memoryMeasurementRun:false,fullProductComplete:false,universalSuperiorityEstablished:false};await fs.writeFile(path.join(here,'results/selector-controls.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({status:receipt.status,inputs:cases.length,comparisons:comparisonCount,counts,failures:failures.length,inputSHA256:receipt.inputSHA256}));if(failures.length)process.exitCode=1;
