    {
      "id": "grafana.candidate.18a948c3e4afcd7bbf94",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Starting with Grafana v13.2, the InfluxDB data source is a standalone plugin, preinstalled in both Grafana OSS and Enterprise. This enables more frequent updates independent of Grafana releases. Grafana automatically checks the plugin catalog and installs the latest version on each server restart.",
      "headingPath": [
        "InfluxDB data source",
        "Plugin updates"
      ],
