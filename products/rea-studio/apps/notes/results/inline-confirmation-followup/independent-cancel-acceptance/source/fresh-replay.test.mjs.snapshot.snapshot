import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';
import {ui,gate,find} from './fixture.mjs';
import {render} from '../notes-inline-confirmation-next/products/rea-studio/apps/notes/client.mjs';
const observations=[];
const dialog=f=>find(f.root,n=>n.attributes.role==='alertdialog'),button=(panel,text)=>find(panel,n=>n.tagName==='button'&&n.textContent===text),mutations=f=>f.calls.filter(c=>['notebook-trash','notebook-restore'].includes(c.action));
function nativeDialogForbidden(){let calls=0;window.confirm=()=>{calls++;throw new Error('Native dialog used');};return()=>calls;}
async function press(panel,key,{shiftKey=false}={}){let prevented=false;const event={key,shiftKey,preventDefault:()=>{prevented=true;}};panel.onkeydown(event);if(!prevented&&(key==='Enter'||key===' ')&&document.activeElement?.tagName==='button'&&!document.activeElement.disabled)await document.activeElement.onclick();return prevented;}
test('visible Trash cancellation names recursive scope, keeps state and performs no backend read or mutation',async t=>{
 const f=await ui(t),native=nativeDialogForbidden();f.manage();const before=JSON.stringify(f.read()),calls=f.calls.length,pending=f.click(f.byText('Move notebook to trash')),panel=dialog(f);assert.ok(panel);assert.equal(panel.attributes['aria-modal'],'true');assert.equal(panel.attributes['aria-labelledby'],panel.children[0].id);assert.equal(panel.attributes['aria-describedby'],panel.children[1].id);assert.match(panel.children[1].textContent,/“Parent”.*all its subnotebooks and regular notes/);assert.match(panel.children[1].textContent,/Attachments remain stored/);assert.equal(document.activeElement,button(panel,'Cancel'));await f.click(button(panel,'Cancel'));await pending;assert.equal(JSON.stringify(f.read()),before);assert.equal(f.calls.length,calls);assert.equal(dialog(f),null);assert.equal(document.activeElement,f.byText('Move notebook to trash'));assert.equal(native(),0);observations.push({case:'visible cancel',requests:0,mutation:false,nativeDialogCalls:0});
});
test('real Confirm Trash and Restore preserve recursive backend behavior and explicitly include separately trashed notes',async t=>{
 const f=await ui(t),native=nativeDialogForbidden();await f.api('delete',{id:f.note.id,revision:f.note.revision});f.manage();await f.confirmNotebook('Move notebook to trash');assert.ok(f.read().notes[f.note.id].deletedAt);const p=f.click(f.byText('Restore notebook')),panel=dialog(f);assert.match(panel.children[1].textContent,/including notes trashed separately/);assert.match(panel.children[1].textContent,/If its parent remains in trash/);await f.click(button(panel,'Confirm restore notebook'));await p;const state=f.read();assert.equal(state.notes[f.note.id].deletedAt,null);assert.equal(state.records[f.child].props.deleted_time,'0');assert.equal(state.records[f.parent].props.deleted_time,'0');assert.deepEqual(mutations(f).map(r=>[r.action,r.input.id,r.input.confirmed]),[['notebook-trash',f.parent,true],['notebook-restore',f.parent,true]]);assert.equal(native(),0);observations.push({case:'recursive confirm and restore',acceptedMutations:2,separateNoteRestored:true,nativeDialogCalls:0});
});
test('keyboard Tab and reverse Tab stay in the dialog; Escape cancels and preserves preexisting inert state',async t=>{
 const f=await ui(t);f.manage();const preserved=f.root.children[0];preserved.inert=true;const p=f.click(f.byText('Move notebook to trash')),panel=dialog(f),cancel=button(panel,'Cancel'),confirm=button(panel,'Confirm move to trash');assert.equal(document.activeElement,cancel);assert.ok(f.root.children.filter(n=>!n.children.includes(panel)).every(n=>n.inert===true));assert.equal(await press(panel,'Tab'),true);assert.equal(document.activeElement,confirm);await press(panel,'Tab');assert.equal(document.activeElement,cancel);await press(panel,'Tab',{shiftKey:true});assert.equal(document.activeElement,confirm);await press(panel,'Tab',{shiftKey:true});assert.equal(document.activeElement,cancel);await press(panel,'Escape');await p;assert.equal(mutations(f).length,0);assert.equal(preserved.inert,true);assert.equal(f.root.children[1].inert,undefined);assert.equal(document.activeElement,f.byText('Move notebook to trash'));observations.push({case:'keyboard escape and focus',mutation:false});
});
test('keyboard Enter on focused Confirm submits once and Space on focused Cancel does not restore',async t=>{
 const f=await ui(t);f.manage();const p=f.click(f.byText('Move notebook to trash')),panel=dialog(f);await press(panel,'Tab');await press(panel,'Enter');await p;assert.equal(mutations(f).length,1);const restore=f.click(f.byText('Restore notebook')),next=dialog(f);await press(next,' ');await restore;assert.equal(mutations(f).length,1);assert.ok(f.read().notes[f.note.id].deletedAt);observations.push({case:'keyboard confirm and cancel',acceptedMutations:1});
});
test('one confirmation/request stays pending across actual commit, refusing duplicate triggers/buttons and cancellation after submission',async t=>{
 const g=gate();let held=true;const f=await ui(t,async({action})=>{if(action==='notebook-trash'&&held){g.enter();await g.held;}});f.manage();const p=f.click(f.byText('Move notebook to trash')),panel=dialog(f),confirm=button(panel,'Confirm move to trash'),cancel=button(panel,'Cancel');const confirmed=f.click(confirm);await g.started;assert.ok(f.read().notes[f.note.id].deletedAt);assert.equal(panel.attributes['aria-busy'],'true');assert.equal(document.activeElement,panel);assert.equal(confirm.disabled,true);assert.equal(cancel.disabled,true);assert.equal(f.byLabel('Markdown note').disabled,true);await confirm.onclick();await cancel.onclick();await f.byText('Move notebook to trash').onclick();await f.byText('Restore notebook').onclick();await press(panel,'Escape');assert.equal(mutations(f).length,1);held=false;g.release();await confirmed;await p;assert.equal(dialog(f),null);assert.equal(f.byLabel('Markdown note').disabled,false);observations.push({case:'held single commit',acceptedMutations:1});
});
test('dirty draft refuses confirmation before any operation, retaining all typed content',async t=>{
 const f=await ui(t),native=nativeDialogForbidden();await f.open();f.manage();f.type(f.byLabel('Markdown note'),'Owned newer draft');const count=f.calls.length,before=JSON.stringify(f.read());await f.click(f.byText('Move notebook to trash'));assert.equal(dialog(f),null);assert.equal(f.calls.length,count);assert.equal(JSON.stringify(f.read()),before);assert.equal(f.byLabel('Markdown note').value,'Owned newer draft');assert.equal(native(),0);observations.push({case:'dirty guard',requests:0});
});
test('failed real commit closes confirmation, restores controls and allows a subsequent explicit retry',async t=>{
 const f=await ui(t);f.manage();const before=JSON.stringify(f.read()),set=f.store.set;f.store.set=async()=>{throw new Error('Synthetic notebook persistence denied');};await f.confirmNotebook('Move notebook to trash');assert.equal(JSON.stringify(f.read()),before);assert.equal(dialog(f),null);assert.equal(f.byLabel('Manage notebook').disabled,false);assert.match(find(f.root,n=>n.attributes.role==='status').textContent,/persistence denied/);f.store.set=set;await f.confirmNotebook('Move notebook to trash');assert.ok(f.read().notes[f.note.id].deletedAt);assert.equal(mutations(f).length,2);observations.push({case:'failed persistence and retry',attemptedMutations:2,acceptedMutations:1});
});
test('disposing an unanswered dialog cancels it without API calls and ignores retained old buttons',async t=>{
 const f=await ui(t);f.manage();const count=f.calls.length,before=JSON.stringify(f.read()),p=f.click(f.byText('Move notebook to trash')),panel=dialog(f),confirm=button(panel,'Confirm move to trash');f.dispose();f.dispose();await p;await confirm.onclick();assert.equal(dialog(f),null);assert.equal(f.calls.length,count);assert.equal(JSON.stringify(f.read()),before);observations.push({case:'dispose before confirm',requests:0});
});
test('disposing after committed held response prevents old publication while a fresh view reads the committed trash',async t=>{
 const g=gate();let held=true;const f=await ui(t,async({action})=>{if(action==='notebook-trash'&&held){g.enter();await g.held;}});await f.open();f.manage();const p=f.confirmNotebook('Move notebook to trash');await g.started;assert.ok(f.read().notes[f.note.id].deletedAt);f.dispose();const status=find(f.root,n=>n.attributes.role==='status'),oldText=status.textContent,count=f.calls.length;held=false;g.release();await p;assert.equal(status.textContent,oldText);assert.equal(f.calls.length,count);assert.equal(dialog(f),null);const next=new f.root.constructor('root'),dispose=await render(next,f.api);t.after(dispose);assert.match(find(next,n=>n.attributes['aria-label']==='Manage notebook').options.find(n=>n.value===f.parent).textContent,/trash/);assert.equal(find(next,n=>n.tagName==='button'&&n.textContent.startsWith('A note ·')),null);observations.push({case:'dispose after actual commit',acceptedMutations:1,lateViewReads:0,freshViewCommittedTrash:true});
});
test.after(async()=>{const folder=new URL(process.env.NOTES_REVIEW_OUTPUT??'../../.local/notes-inline-confirmation/',import.meta.url);await fs.mkdir(folder,{recursive:true});await fs.writeFile(new URL('inline-confirmation.json',folder),JSON.stringify(observations,null,2)+'\n');});
