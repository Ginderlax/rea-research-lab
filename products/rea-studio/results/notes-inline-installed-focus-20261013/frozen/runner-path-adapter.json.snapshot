{
  "schema": "rea-notes-current-production-focus-path-adapter/v1",
  "sourceRoot": "work/notes-inline-cancel-no-read-next",
  "sourcePath": "run.mjs",
  "replacement": {
    "from": "studio=path.join(root,'products/rea-studio')",
    "to": "studio=path.resolve(root,'../../outputs/rea-research-lab/products/rea-studio')"
  },
  "applicationSourceSubstitutions": 0,
  "selectedKind": "focused",
  "onlyStudioLocationChanged": true,
  "productionWrites": 0
}
