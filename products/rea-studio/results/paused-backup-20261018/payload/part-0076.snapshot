    {
      "id": "grafana.candidate.b7dfa127eb4fde8e7a79",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Google Cloud Monitoring is Google Cloud Platform's native monitoring and observability service that collects metrics, events, and metadata from GCP resources, hosted uptime probes, and application instrumentation. The Google Cloud Monitoring data source in Grafana allows you to query and visualize this data alongside metrics from other systems, creating unified dashboards for comprehensive infrastructure and application monitoring.",
      "headingPath": [
        "Google Cloud Monitoring data source"
      ],
      "source": {
        "path": "docs/sources/datasources/google-cloud-monitoring/_index.md",
        "gitBlobSha": "063a5b3fc27cb0450c1c9fa9e184dc42e0b6ae28",
        "sha256": "4b38ce742fc9cdfd379e697bf8a0ef8914a4cf48fa0f4d9cfc2509d63957655c",
        "lineStart": 30,
        "lineEnd": 30,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/google-cloud-monitoring/_index.md#L30-L30"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.31106bbb8f906cc1faee",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana ships with the Google Cloud Monitoring data source preinstalled in both Grafana OSS and Grafana Enterprise, so there's nothing for you to install. It's packaged as a standalone plugin that updates independently of Grafana releases. For details, refer to [Plugin updates](#plugin-updates).",
      "headingPath": [
        "Google Cloud Monitoring data source"
      ],
      "source": {
        "path": "docs/sources/datasources/google-cloud-monitoring/_index.md",
