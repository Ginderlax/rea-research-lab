    {
      "id": "grafana.candidate.0a5af0d2dedf0b0b8284",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can use `*` as the Grafana organization in the mapping if you want all users from a given SAML Organization to be added to all existing Grafana organizations.",
      "headingPath": [
        "Configure organization mapping for SAML"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/configure-saml-org-mapping/_index.md",
