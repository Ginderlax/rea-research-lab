import test from'node:test';import assert from'node:assert/strict';import{randomBytes,createHash,createCipheriv}from'node:crypto';import{createAesContext,makeAesProperties,parseAesProperties,AES_LIMITS}from'./sevenzip-aes.mjs';
test('bounded AES primitive performs genuine CBC with released UTF16LE/counter SHA256 construction and zero padding',()=>{const password=randomBytes(18).toString('base64url')+'λ😀',salt=randomBytes(7),iv=randomBytes(11),properties=makeAesProperties({cyclesPower:4,salt,iv}),input=randomBytes(35),ctx=createAesContext(password);let manualKey,padded;try{const hash=createHash('sha256'),pass=Buffer.from(password,'utf16le');for(let i=0;i<16;i++){const counter=Buffer.alloc(8);counter.writeUInt32LE(i);hash.update(salt);hash.update(pass);hash.update(counter);}pass.fill(0);manualKey=hash.digest();const fullIV=Buffer.alloc(16);iv.copy(fullIV);padded=Buffer.alloc(48);input.copy(padded);const cipher=createCipheriv('aes-256-cbc',manualKey,fullIV);cipher.setAutoPadding(false);const expected=Buffer.concat([cipher.update(padded),cipher.final()]),actual=ctx.encrypt(input,{properties});assert.deepEqual(actual.packed,expected);assert.deepEqual(ctx.decrypt(actual.packed,properties,input.length),input);assert.equal(actual.packed.length,48);assert.deepEqual(parseAesProperties(properties).salt,salt);}finally{manualKey?.fill(0);padded?.fill(0);ctx.close();}});
test('direct63 decoding and empty-property defaults match finite released source branches without exposing key material',()=>{const password=randomBytes(18).toString('base64url'),input=randomBytes(16),ctx=createAesContext(password);try{for(const properties of[Buffer.from([63]),Buffer.alloc(0)]){const decoded=parseAesProperties(properties),pass=Buffer.from(password,'utf16le');let key;if(decoded.cyclesPower===63){key=Buffer.alloc(32);pass.copy(key,0,0,32);}else key=createHash('sha256').update(pass).update(Buffer.alloc(8)).digest();pass.fill(0);const cipher=createCipheriv('aes-256-cbc',key,decoded.iv);cipher.setAutoPadding(false);const ciphertext=Buffer.concat([cipher.update(input),cipher.final()]);key.fill(0);assert.deepEqual(ctx.decrypt(ciphertext,properties,input.length),input);}}finally{ctx.close();}});
test('password/properties/cipher lengths/shared input/KDF and closed-context limits fail before unintended work',()=>{assert.throws(()=>createAesContext(undefined),/requires a password/);assert.throws(()=>createAesContext('x'.repeat(AES_LIMITS.passwordUnits+1)),/length bound/);for(const p of[Buffer.from([21]),Buffer.from([0,0]),Buffer.from([192]),Buffer.from([192,255])])assert.throws(()=>parseAesProperties(p),/bound|properties/);assert.throws(()=>parseAesProperties(new Uint8Array(new SharedArrayBuffer(1))),/shared/);const password=randomBytes(8).toString('hex'),ctx=createAesContext(password,{maxSteps:0});try{assert.throws(()=>ctx.encrypt(Buffer.alloc(1)),/step budget/);}finally{ctx.close();}const other=createAesContext(password);try{assert.throws(()=>other.decrypt(Buffer.alloc(15),Buffer.from([0]),15),/size mismatch/);assert.throws(()=>other.encrypt(new Array(100000000)),/Buffer or Uint8Array/);other.close();assert.throws(()=>other.encrypt(Buffer.alloc(0)),/closed/);}finally{other.close();}});
