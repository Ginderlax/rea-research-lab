    {
      "id": "grafana.candidate.312643e1a3efd7776046",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This suits users who prefer working entirely in the UI. Note that these paths commit to `main` without a pull request, so use them only when `main` allows direct writes; when `main` requires review, prefer Option 1.",
      "headingPath": [
        "Testing sandboxes with Git Sync",
        "Promote a sandbox to main",
        "Option 4: Promote from the Grafana UI"
      ],
      "source": {
