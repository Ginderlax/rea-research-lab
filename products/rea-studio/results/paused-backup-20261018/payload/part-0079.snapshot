    },
    {
      "id": "grafana.candidate.d1d2d8b79958a74ea9e1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Description. Include an overview of the feature and problem it solves, and where to learn more (like a link to the docs).",
      "headingPath": [
        "What’s new in Grafana v10.0",
        "Feature"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-0.md",
        "gitBlobSha": "744b2d1230211f70aa6158231d9505e732ac0315",
        "sha256": "dd311853975cca7ef6ad474588f832614dd9c445856343920d238a1ddf183739",
        "lineStart": 28,
        "lineEnd": 28,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-0.md#L28-L28"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
