    {
      "id": "grafana.candidate.f62047c5f7d3b48b6225",
      "syntaxRole": "list-item",
      "sourceText": "- **Metrics**: Control access to metric data points using LogQL with labels such as `job` or `region` and access for metrics `__name__`.",
      "headingPath": [
        "Label Based Access Control (LBAC) for data sources",
        "Logs, metrics, and traces filtering with LBAC"
      ],
