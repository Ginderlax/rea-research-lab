import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const own=path.dirname(fileURLToPath(import.meta.url)),base=path.resolve(own,'../..'),repo=path.join(base,'outputs/rea-research-lab');
const sha=b=>createHash('sha256').update(b).digest('hex');
const files=[
 'products/rea-studio/requirements/workspace-products.json',
 'products/rea-studio/requirements/system-products.json',
 'products/rea-studio/requirements/visual-products.json',
