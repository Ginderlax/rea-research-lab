import fs from 'node:fs/promises';import {createReadStream} from 'node:fs';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const own=path.dirname(fileURLToPath(import.meta.url)),stage=path.resolve(own,'../metrics-algorithm-measurement-next'),sha=b=>createHash('sha256').update(b).digest('hex'),json=async file=>JSON.parse(await fs.readFile(file,'utf8'));
async function identity(file){const b=await fs.readFile(file);return{bytes:b.length,sha256:sha(b)}}async function streamIdentity(file){const hash=createHash('sha256');let bytes=0;for await(const part of createReadStream(file)){bytes+=part.length;hash.update(part)}return{bytes,sha256:hash.digest('hex')}}
const expected={receipt:'b6a3faf96d8fcc48158742892e74f2923c8931b25aa84ce00615a3439aee1c2b',manifest:'6f918727383492e06b3acf856d9f4e2cb938ad3e05fef082f2f3021a6801b2bc',preflight:'fa24a42a8a0c60ce7cf832390e23e0197d7301379203ff302f0a807c2c027b67'},receiptPath=path.join(stage,'readiness-validation.json'),manifestPath=path.join(stage,'freeze-manifest.json'),preflightPath=path.join(stage,'memory-preflight.control.json'),receiptIdentity=await identity(receiptPath),manifestIdentity=await identity(manifestPath),preflightIdentity=await identity(preflightPath);assert.equal(receiptIdentity.sha256,expected.receipt);assert.equal(manifestIdentity.sha256,expected.manifest);assert.equal(preflightIdentity.sha256,expected.preflight);
const receipt=await json(receiptPath),manifest=await json(manifestPath),preflight=await json(preflightPath),entries=Object.entries(manifest.inventory);assert.equal(manifest.files,117);assert.equal(entries.length,117);assert.equal(manifest.receiptSHA256,expected.receipt);let aggregate=0;const matched=[];
for(const [name,expected]of entries){const file=path.resolve(stage,name);assert.ok(file.startsWith(stage+path.sep));const actual=await identity(file);assert.deepEqual(actual,expected);aggregate+=actual.bytes;matched.push({path:name,...actual})}assert.equal(aggregate,manifest.aggregateBytes);
const previous=await json(path.join(stage,'preserved/previous-memory-preflight.control.json'));assert.deepEqual(preflight.expectedFiles,previous.expectedFiles);assert.equal(Object.keys(preflight.expectedFiles).length,7);assert.equal(preflight.expectedMetadataSHA256,previous.expectedMetadataSHA256);assert.equal(preflight.canonicalSourceSHA256,previous.canonicalSourceSHA256);assert.equal(preflight.workloadSourceSHA256,previous.workloadSourceSHA256);
const fixtureMatches=[];for(const [name,value]of Object.entries(preflight.expectedFiles)){for(const [file,hash,bytes]of [[value.inputPath,value.inputFileSHA256,value.inputBytes],[value.path,value.sha256,value.bytes]]){const actual=await identity(path.join(stage,file));assert.equal(actual.sha256,hash);assert.equal(actual.bytes,bytes);fixtureMatches.push({workload:name,path:file,...actual})}}
const preservation=await json(path.join(stage,'preservation.json')),priorByteComparisons=[];for(const copy of preservation.copies.filter(e=>e.sourcePath==='workloads.mjs'||e.sourcePath==='canonical.mjs'||e.sourcePath.startsWith('fixtures/'))){const current=await identity(path.join(stage,copy.path)),previous=await identity(path.join(copy.sourceRoot,copy.sourcePath));assert.deepEqual(current,previous);assert.equal(current.sha256,copy.sha256);priorByteComparisons.push({source:path.join(copy.sourceRoot,copy.sourcePath),current:copy.path,...current})}
const originals=[];for(const[file,hash]of Object.entries(receipt.authority.files)){const actual=await identity(file);assert.equal(actual.sha256,hash);originals.push({source:file,...actual})}assert.equal(originals.length,6);const provenance=await json(path.join(stage,'original-provenance.json'));for(const copy of provenance.originalCopies){const original=originals.find(e=>e.source===copy.source);assert.ok(original);assert.equal(copy.sha256,original.sha256);assert.equal((await identity(path.join(stage,copy.path))).sha256,original.sha256)}
const archives=[];for(const e of receipt.originalArchiveIdentities){const actual=await identity(e.source);assert.equal(actual.sha256,e.sha256);assert.equal(actual.bytes,e.bytes);archives.push({source:e.source,...actual,copyOrExecutionPerformed:false})}assert.equal(archives.length,2);const runtime=await streamIdentity(receipt.runtime.execPath);assert.equal(runtime.sha256,receipt.runtime.executableSHA256);
for(const [name,hash]of [['candidate-baseline.mjs','9269cf8c32be9bf2c075b67019e82e41272d9495f0321fefc17b2c5695a91371'],['candidate-algorithm.mjs','225a47ad0c6e089c67ce591013797b20a876630132af2b8060f9380afed3ed53'],['selector-algorithm.mjs','de334c498bb286c640661d8a3df05794fb66ebb02a3629231f18dbcb3c9bd58c']])assert.equal((await identity(path.join(stage,name))).sha256,hash);
assert.equal(receipt.timingMeasurementRun,false);assert.equal(receipt.memoryMeasurementRun,false);assert.equal(receipt.measurementBranchExecutionTested,false);assert.equal(receipt.performanceEstablished,false);assert.equal(receipt.machineLevelIsolationEstablished,false);assert.equal(receipt.prospective.timingChildren,147);assert.equal(receipt.prospective.isolatedMemoryChildren,147);assert.deepEqual(preflight.limits,{samplesPerWorkloadAndImplementation:7,childWallSeconds:120,childOldSpaceMiB:256,childRSSMiB:512,stdoutBytes:4194304});
const sourceAssessment={prospectivePlan:'MEASUREMENT-PLAN.md',timing:'benchmark.mjs retains60s/2MiB child controls; timing-runner.mjs retains600s/4MiB outer controls; role orders rotate and all raw outcomes kept',memory:'memory-runner.mjs enforces120s child timer,256MiB old space,512MiB sampled/checkpoint RSS and4MiB capture, aborts subsequent samples on failure; no separate outer watchdog',observer:'watch-owned-process.ps1 samples numeric PID nominally every100ms; no process start-time identity, machine isolation or instantaneous spike enforcement',signed:'summary.mjs differences preserve sign; missing/non-finite pairs censored, zero control has no percentage; future raw consolidation requires authentication',release:'Serializer/cache-reread validation after retained snapshot and before release can retain allocator/RSS pressure; release is diagnostic, not leak proof',authorization:'Separate new root quiet authorization required for timing and memory, later than preflight; no measurement branch execution in this review'};
for(const [name,expected]of entries)assert.deepEqual(await identity(path.join(stage,name)),expected);assert.deepEqual(await identity(manifestPath),manifestIdentity);
const result={schema:'rea-independent-metrics-algorithm-readiness-authentication/v1',createdAt:new Date().toISOString(),status:'PASS_NO_AUTHENTICATION_BLOCKER',stage,readiness:{...receiptIdentity},freezeManifest:{...manifestIdentity,artifacts:117,aggregateBytes:aggregate},preflight:preflightIdentity,all117BeforeAndAfterMatch:true,priorWorkloads:{count:7,completeSpecPacketBindingsExact:true,metadataAndGeneratorBindingsExact:true,fixturesAuthenticated:14,priorByteComparisons},candidate:receipt.candidate,originals,archives,runtime:{source:receipt.runtime.execPath,...runtime,versionClaim:receipt.runtime.version,newRuntimeInvocationOrMeasurement: false},sourceAssessment,disclosedLimitsAccepted:true,blockers:[],executions:{tests:0,reducerExecutions:0,originalExecutions:0,timingSequences:0,memorySequences:0,profiles:0},scope:'Read-only byte authentication and bounded source inspection; does not establish future measurement-branch success, complete parity, performance or machine isolation. Stage untouched; own receipt outside stage.'};await fs.writeFile(path.join(own,'review-validation.json'),JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify({status:result.status,artifacts:117,priorWorkloads:7,fixtures:14,originalFiles:6,archives:2,receipt:await identity(path.join(own,'review-validation.json')),stageUnchanged:true}));
