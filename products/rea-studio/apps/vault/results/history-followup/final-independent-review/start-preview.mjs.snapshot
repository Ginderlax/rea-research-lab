import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createInterface} from 'node:readline';import {start} from './host/server.mjs';import {arm,release} from './host/apps/vault/server.mjs';
const own=path.dirname(fileURLToPath(import.meta.url)),dataDir=path.join(own,'.local/browser-data'),instance=await start({port:0,dataDir});let closed=false;async function close(){if(closed)return;closed=true;release();await instance.close();process.exit(0);}for(const signal of ['SIGINT','SIGTERM'])process.on(signal,close);
const call=async(action,input={})=>{const response=await fetch(instance.url+'/api/vault/'+action,{method:'POST',headers:{'content-type':'application/json','x-rea-token':instance.token},body:JSON.stringify(input)}),body=await response.json();if(!response.ok)throw new Error(body.error);return body.result;};
const initial=await call('status');let id;if(!initial.exists){await call('create',{password:'owned browser pass 2026'});id=(await call('save',{title:'Browser history',group:'Owned fixture',username:'synthetic',password:'first synthetic',notes:'Original browser notes'})).id;const entry=(await call('read',{id})).entry;await call('save',{...entry,password:'second synthetic',notes:'Second browser notes'});await call('lock');}const record={url:instance.url+'/#vault',dataDir,pid:process.pid,seeded:!initial.exists,...(id?{entryId:id}:{}),scope:'Owned synthetic fixture; no user workspace or original application process'};await fs.mkdir(path.join(own,'.local'),{recursive:true});await fs.writeFile(path.join(own,'.local/preview-info.json'),JSON.stringify(record,null,2)+'\n');console.log('OWNED_PREVIEW '+JSON.stringify(record));
const commands=createInterface({input:process.stdin});commands.on('line',async line=>{try{const value=JSON.parse(line);if(value.command==='arm'){arm(value.action);console.log('OWNED_GATE_ARMED '+value.action);}else if(value.command==='release'){release();console.log('OWNED_GATE_RELEASED');}else if(value.command==='stop'){await close();}else if(value.command==='observe'){const entries=(await call('list')).entries,selected=entries.find(e=>e.title==='Browser history'),entry=selected?(await call('read',{id:selected.id})).entry:undefined,history=selected?(await call('historyList',{id:selected.id})):undefined;await fs.writeFile(path.join(own,'.local',value.name+'.json'),JSON.stringify({entries,entry,history},null,2)+'\n');console.log('OWNED_OBSERVATION '+value.name);}else throw new Error('Unknown owned preview command');}catch(error){console.log('OWNED_COMMAND_ERROR '+error.message);}});
