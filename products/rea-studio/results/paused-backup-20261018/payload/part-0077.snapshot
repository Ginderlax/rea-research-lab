    },
    {
      "id": "grafana.candidate.e71133edd48ccb02e751",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can rotate data keys to disable the active data key and therefore stop using them for encryption operations. For high-availability setups, you might need to wait until the data keys cache's time-to-live (TTL) expires to ensure that all rotated data keys are no longer being used for encryption operations.",
      "headingPath": [
        "Configure database encryption",
        "Operational work",
        "Rotate data keys"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-database-encryption/_index.md",
        "gitBlobSha": "936ab7c1d208cbcd86c66db25b399c78675a122b",
        "sha256": "511e359127e5ceaf00a6eeb39834e100fdb31f51a3261d71f49ab872f60129bc",
        "lineStart": 78,
        "lineEnd": 78,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-security/configure-database-encryption/_index.md#L78-L78"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.aabe8a01717c6d37313c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Data key rotation does **not** implicitly re-encrypt secrets. Grafana will continue to use rotated data keys to decrypt secrets still encrypted with them. To completely stop using rotated data keys for both encryption and decryption, see [secrets re-encryption](#re-encrypt-secrets).",
      "headingPath": [
        "Configure database encryption",
        "Operational work",
