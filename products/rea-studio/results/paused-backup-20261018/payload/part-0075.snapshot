    {
      "id": "grafana.candidate.f09e6ca22adea5a681bb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To reference log groups in a monitoring account, use ARNs instead of LogGroup names.",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Query CloudWatch Logs",
        "Query log groups and Amazon CloudWatch Logs data sources with OpenSearch SQL"
      ],
      "source": {
