    {
      "id": "grafana.candidate.225f8aa285b55429b848",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana adjusts the query time range to align with the dynamically calculated step interval. This ensures consistent metric visualization and supports Prometheus result caching. However, this alignment can cause minor visual differences, such as a slight gap at the graph's right edge or a shifted start time. For example, a `15s` step aligns timestamps to Unix times divisible by 15 seconds. A `1w` Min step aligns the range to the start of the week (Thursday at 00:00 UTC in Prometheus).",
      "headingPath": [
        "Prometheus query editor",
        "Query options",
        "Type"
      ],
      "source": {
        "path": "docs/sources/datasources/prometheus/query-editor/_index.md",
        "gitBlobSha": "cdc563c3108dcd9de35912dff1febc0228715bda",
        "sha256": "dc2247aa971e1b7926cb68555c77d8874fd592b3a2d6c533b9124b98204dc690",
