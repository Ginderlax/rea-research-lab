        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.7fdae26624121accadfe",
      "syntaxRole": "list-item",
      "sourceText": "- _`<ACCOUNT_ID>`_ is the ID of the AWS account that hosts your secrets.",
      "headingPath": [
        "Use Terraform to provision secure values",
        "Provision a keeper",
        "Define a keeper"
      ],
      "source": {
        "path": "docs/sources/as-code/infrastructure-as-code/terraform/terraform-secrets-management.md",
        "gitBlobSha": "52977e9c09c75dbafbdbbdb7ab05a511e921e281",
