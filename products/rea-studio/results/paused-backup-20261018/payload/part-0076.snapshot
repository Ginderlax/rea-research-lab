    {
      "id": "grafana.candidate.406f7ea1ff9a9c4cb2ef",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Prometheus annotations work differently from SQL-based annotations. Instead of querying a table of events, you write a PromQL expression that returns time-series data. Grafana converts the query results into annotation events using these rules:",
      "headingPath": [
        "Prometheus annotations",
        "How Prometheus annotations work"
      ],
