    {
      "id": "grafana.candidate.9e1b07ba37e38732d238",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If set to `true`, the Grafana server redirects requests that have a Host-header value that is mismatched to the actual domain. This might help to mitigate some DNS rebinding attacks.",
      "headingPath": [
        "Configure security hardening",
        "Additional security hardening",
