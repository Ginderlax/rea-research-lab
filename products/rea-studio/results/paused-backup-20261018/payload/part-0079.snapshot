    {
      "id": "grafana.candidate.06d8ad4b8d874bcfdfdc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "After the number of Viewers or Editors has reached its license limit, only Admins will see a banner in Grafana indicating that the license limit has been reached. Previously, all users saw the banner.",
      "headingPath": [
        "What's new in Grafana v7.4",
        "Grafana Enterprise features",
        "Licensing changes"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-4.md",
