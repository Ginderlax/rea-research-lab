    },
    {
      "id": "grafana.candidate.a95010a6c6d7607f3c6a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When adding a data source, ensure the database user you specify has only SELECT permissions on the relevant database and tables. Grafana does not validate the safety of queries, which means they can include potentially harmful SQL statements, such as `USE otherdb`; or `DROP TABLE user;`, which could get executed. To minimize this risk, Grafana strongly recommends creating a dedicated MSSQL user with restricted permissions.",
      "headingPath": [
        "Configure the Microsoft SQL Server data source",
        "Configure the data source in the UI",
        "Database user permissions"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/configure/index.md",
        "gitBlobSha": "468ac6d022bd91271e046308509eabab23316d3c",
        "sha256": "78f3473345c7acf1680b5e482fdc29c61c6d73576e857090bae5239629ed0887",
        "lineStart": 420,
        "lineEnd": 420,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/mssql/configure/index.md#L420-L420"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.d2e343b24dcee6071b6c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you use older versions of Microsoft SQL Server, such as 2008 and 2008R2, you might need to disable encryption before you can connect the data source.",
      "headingPath": [
        "Configure the Microsoft SQL Server data source",
        "Configure the data source in the UI",
        "Diagnose connection issues"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/configure/index.md",
