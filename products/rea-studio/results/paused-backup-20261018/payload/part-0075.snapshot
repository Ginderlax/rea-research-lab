    {
      "id": "grafana.candidate.5fe99d339d7f458e51f1",
      "syntaxRole": "table-row",
      "sourceText": "| Amount of synced resources per repository | 20               | 1,000             | No limit        | No limit               |",
      "headingPath": [
        "Usage and performance limitations",
        "Usage tiers and limits"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/git-sync/usage-limits.md",
        "gitBlobSha": "259bfe6ffcef787e176c67fcf3b490f8ca9e966e",
        "sha256": "0cc8f7958ef6206b1f6ae32efdb03081375fab9f7c98f50e4b61847ff95c95ac",
        "lineStart": 47,
        "lineEnd": 47,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/as-code/observability-as-code/git-sync/usage-limits.md#L47-L47"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
