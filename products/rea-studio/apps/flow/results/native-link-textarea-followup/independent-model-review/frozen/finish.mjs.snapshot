import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const own=import.meta.dirname,base=path.resolve(own,'../..'),sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)});function save(p,b){fs.writeFileSync(path.join(own,p),b,{flag:'wx'});}const json=p=>JSON.parse(fs.readFileSync(path.join(own,p)));
const before=json('authority-before.json'),after=before.map(r=>{const b=fs.readFileSync(path.join(base,r.root,r.path));assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});return{...r};});save('authority-after.json',JSON.stringify(after,null,2)+'\n');
const rootName='work/root-flow-link-review-preservation-next',mb=fs.readFileSync(path.join(base,rootName,'manifest.json'));assert.equal(sha(mb),'fd3fbb1e3b20cd0d4e21b996717c71e3dab5b504759ec30958488897d06efaaa');const rm=JSON.parse(mb);assert.equal(rm.inventory.length,38);for(const r of rm.inventory)assert.deepEqual(id(fs.readFileSync(path.join(base,rootName,r.path))),{bytes:r.bytes,sha256:r.sha256});save('root-seven-historical-manifest.json.snapshot',mb);save('root-seven-historical-validation.json.snapshot',fs.readFileSync(path.join(base,rootName,'validation.json')));
const final=json('runs/final-model-v2/run.json');assert.equal(final.exit.code,0);assert.equal(final.failure,null);assert.deepEqual(final.summary,{tests:24,pass:24,fail:0,cancelled:0,skipped:0,todo:0});assert.equal(final.sourceStable,true);assert.deepEqual(json('runs/final-model-v2/source-before.json'),json('runs/final-model-v2/source-after.json'));
const stage=path.join(base,'work/flow-native-textarea-normalization-fix-next'),transform=JSON.parse(fs.readFileSync(path.join(stage,'client-transformation.json'))),adapters=json('input-adapters.json');let replay=fs.readFileSync(path.join(own,'replay/normalization-ui.test.mjs'),'utf8'),fixture=fs.readFileSync(path.join(own,'fixture.mjs'),'utf8');for(const c of [...adapters.changes].reverse()){if(replay.includes(c.after))replay=replay.replace(c.after,c.before);else{assert(fixture.includes(c.after));fixture=fixture.replace(c.after,c.before);}}assert.deepEqual(Buffer.from(replay),fs.readFileSync(path.join(stage,'candidate/products/rea-studio/apps/flow/normalization-ui.test.mjs')));assert.deepEqual(Buffer.from(fixture),fs.readFileSync(path.join(stage,'candidate/products/rea-studio/apps/flow/normalization-ui-fixture.mjs')));
const guards=[];function rejected(name,fn){assert.throws(fn);guards.push({name,passed:true,rejected:true,sourceOnly:true});}function exact(b,r){assert.deepEqual(id(b),r);}const client=fs.readFileSync(path.join(stage,'candidate/products/rea-studio/apps/flow/client.mjs'));
rejected('same-size client mutation rejected by pinned client identity',()=>{const b=Buffer.from(client);b[70]^=1;exact(b,transform.after);});rejected('truncated client rejected',()=>exact(client.subarray(0,-1),transform.after));rejected('14 retained bodies cannot be relabeled after editing a test assertion',()=>assert.equal(sha(Buffer.from(replay.replace('assert.equal(f.downloads.length,0)','assert.equal(f.downloads.length,1)'))),sha(Buffer.from(replay))));rejected('ordinary disabled field dispatch cannot be silently replaced with programmatic dispatch',()=>assert.deepEqual(Buffer.from(fixture.replace('this.disabled&&!event.programmatic','this.disabled')),Buffer.from(fixture)));rejected('changing an inverse source substitution fails exact reconstruction',()=>{let inverse=client.toString();for(const c of [...transform.edits].reverse())inverse=inverse.replace(c.after,c.before);inverse+='\n';assert.equal(sha(Buffer.from(inverse)),transform.before.sha256);});
save('source-negative-gates.json',JSON.stringify({guards,applicationExecutions:0,originalExecutions:0,scope:'In-memory proof identity guards only; not product fault probes.'},null,2)+'\n');
save('read-diagnostics.json',JSON.stringify({schema:'rea-flow-review-read-diagnostic/v1',initialWrongPath:'work/root-flow-link-independent-review-v2/review-validation.json',actualPath:'work/root-flow-link-independent-review-v2/validation.json',classification:'Reviewer filename assumption during read-only inventory; preserved as incomplete read, not product defect',modelRecorderFailure:'runs/final-model/collector-failure.json',noAuthorSourcesChanged:true},null,2)+'\n');
const receipt={schema:'rea-flow-native-textarea-independent-finite-review/v1',at:new Date().toISOString(),finiteModelAcceptance:true,confirmedFaults:[],author:{folder:'work/flow-native-textarea-normalization-fix-next',manifestSHA256:'70c19b06ecca7b79a9461cb53680429cee2bdc91e022c5015fdf19b258f69ce9',strictPayloads:197,validationSHA256:'ad69d3e5cad566979cccfb01e3ce4627a84ad6392e73ea3f8417da7a4901b5fc',client:transform.after,clientInverseSubstitutions:16,fixtureInverseSubstitutions:7},historicalAuthorities:[{folder:'work/flow-native-link-next',files:457,manifestSHA256:'0a03866476a81f83762bdfc10d65be639c24f25778b6c03fdac5b9ee906bea5d'},{folder:'work/root-flow-link-browser-review-next',files:28,manifestSHA256:'bae3c0a14e33e8bdd083a86046c6f1e15c455805d4d8e24f899ba0d0793c5f2b'},{folder:rootName,files:38,manifestSHA256:sha(mb)}],finalRun:{path:'runs/final-model-v2/run.json',...id(fs.readFileSync(path.join(own,'runs/final-model-v2/run.json'))),...final.summary,sourceStable:true},retainedBodyReplayGroups:14,freshIndependentGroups:10,sourceOnlyNegativeGuards:5,uniqueFinalGroups:24,observedModelTestExecutionsAcrossTwoRuns:48,sourceQualifiedModelTestExecutions:24,initialSpecReporterRun:{rawPass:24,rawFail:0,childExitNotRecorded:true,sourceAfterNotCollected:true,finalAcceptance:false,collectorFailureRetained:true},sourceRowsBeforeAfter:711,finalOwnedSourceFiles:5,replayAdapters:'Runtime import/seed paths only; exact inverse validated. Model infrastructure reused, reviewer fresh bodies are independent.',newOriginalExecutions:0,newOriginalCompilerCalls:0,newRuntimeOriginalHosts:0,newHTTPHosts:0,newBrowserExecutions:0,actualBrowserAcceptance:false,actualFileDownloadDelivery:false,productionWrites:0,publicWrites:0,benchmarks:0,childRunnerLaunches:2,ownedChildrenClosed:true,programmaticDisabledMutationsQualified:true,nativeBusyDisablingPreserved:true,scope:'Actual source-assisted candidate client and its in-memory server handler tested via CRLF/bare-CR normalizing DOM model. No complete Node-RED/editor/GUI acceptance.',remainingIndependentUIReview:['Actual native textarea interaction across LF/CRLF/bareCR and raw Unicode.','Browser file import decoding and decoded-text/UTF-8 download delivery.','Actual pending operations and mounted/disposed controls; modeled disabled mutations are defensive only.'],fullProductParity:false,securityEquivalence:false,universalSuperiority:false,oldReceiptsRebound:false};save('review-validation.json',JSON.stringify(receipt,null,2)+'\n');
function files(p=''){const result=[];for(const d of fs.readdirSync(path.join(own,p),{withFileTypes:true})){assert(!d.isSymbolicLink());const n=p?p+'/'+d.name:d.name;if(d.isDirectory())result.push(...files(n));else{assert(d.isFile());if(n!=='manifest.json')result.push(n);}}return result;}const inventory=files().sort().map(p=>{const b=fs.readFileSync(path.join(own,p));assert(b.length<=32*1024*1024);assert(!(b[0]===77&&b[1]===90));assert(!(b[0]===80&&b[1]===75));return{path:p,...id(b)};});const m=Buffer.from(JSON.stringify({schema:'rea-flow-native-textarea-independent-strict-freeze/v1',at:new Date().toISOString(),strict:true,inventory,files:inventory.length,reviewReceipt:{path:'review-validation.json',...id(fs.readFileSync(path.join(own,'review-validation.json')))},sourceStable:true,finiteModelAcceptance:true,browserAccepted:false,productionWrites:0,newOriginalExecutions:0},null,2)+'\n');save('manifest.json',m);console.log(JSON.stringify({files:inventory.length,manifest:id(m),receipt:id(fs.readFileSync(path.join(own,'review-validation.json'))),final24pass:true,fresh10:true,browserAccepted:false}));
