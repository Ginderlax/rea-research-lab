    },
    {
      "id": "grafana.candidate.a00dade7305350dfd444",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you change your organization name in the Grafana UI this setting needs to be updated to match the new name.",
      "headingPath": [
        "Anonymous authentication",
        "Configuration"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/anonymous-auth/index.md",
        "gitBlobSha": "27c65e7bd028472cdead8f8e346ca73fb86fdb34",
        "sha256": "ad1718bf8069e74debc30703f3a64242ac51230674dc415f68ba7174b51e2a5f",
        "lineStart": 62,
        "lineEnd": 62,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/anonymous-auth/index.md#L62-L62"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.968784e0f6232556be3f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Anonymous access lets people use Grafana without login credentials. It was an early way to share dashboards, but Public dashboards gives you a more secure way to share dashboards.",
      "headingPath": [
        "Anonymous authentication",
        "Licensing for anonymous access"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/anonymous-auth/index.md",
        "gitBlobSha": "27c65e7bd028472cdead8f8e346ca73fb86fdb34",
        "sha256": "ad1718bf8069e74debc30703f3a64242ac51230674dc415f68ba7174b51e2a5f",
        "lineStart": 68,
        "lineEnd": 68,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/anonymous-auth/index.md#L68-L68"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.ba120cca2573be2ddd79",
      "syntaxRole": "list-item",
      "sourceText": "- **Counting rule**: Grafana counts 1 anonymous user for every 3 anonymous devices detected.",
      "headingPath": [
        "Anonymous authentication",
        "Licensing for anonymous access",
        "How anonymous usage is counted"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/anonymous-auth/index.md",
        "gitBlobSha": "27c65e7bd028472cdead8f8e346ca73fb86fdb34",
