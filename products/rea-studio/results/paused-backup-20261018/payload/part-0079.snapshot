    },
    {
      "id": "grafana.candidate.5cd7f4b007032d24f014",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Gauges are single-value visualizations that allow you to quickly visualize where a value falls within a defined or calculated min and max range. With repeat options, you can display multiple gauges, each corresponding to a different series, column, or row.",
      "headingPath": [
        "Gauge"
      ],
