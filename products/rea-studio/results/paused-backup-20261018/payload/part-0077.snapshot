        "sha256": "c76f5bf33aa9948420698d8a2f35a8495645f0e19c57f16743f2e31ec133f9a7",
        "lineStart": 232,
        "lineEnd": 232,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-docker.md#L232-L232"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.da4247992c46d2decae6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can apply this technique to any configuration options in `conf/grafana.ini` by setting `GF_<SectionName>_<KeyName>__FILE` to the file path that contains the secret information. For more information about Docker secret command usage, refer to [docker secret](https://docs.docker.com/engine/reference/commandline/secret/).",
      "headingPath": [
        "Configure a Grafana Docker image",
        "Configure Grafana with Docker Secrets"
      ],
      "source": {
