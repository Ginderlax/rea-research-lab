    {
      "id": "grafana.candidate.dee97b94b3758cefb46c",
      "syntaxRole": "table-row",
      "sourceText": "| IAM policy missing required permissions          | Attach the appropriate IAM policy to your user or role. For metrics, you need `cloudwatch:ListMetrics`, `cloudwatch:GetMetricData`, and related permissions. For logs, you need `logs:DescribeLogGroups`, `logs:StartQuery`, `logs:GetQueryResults`, and related permissions. Refer to [Configure CloudWatch](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/aws-cloudwatch/configure/) for complete policy examples. |",
      "headingPath": [
        "Troubleshoot Amazon CloudWatch data source issues",
        "Authentication errors",
        "\"Access Denied\" or \"Not authorized to perform this operation\""
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/troubleshooting/index.md",
        "gitBlobSha": "beaeae2cfe415b08e86f250d421cb38d035fbede",
        "sha256": "79b4e209733bce22ae7957e88f953312e123bcebdda66984b637a9800c34625b",
        "lineStart": 55,
        "lineEnd": 55,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/aws-cloudwatch/troubleshooting/index.md#L55-L55"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
