    },
    {
      "id": "grafana.candidate.ae0fc6fff3b2959b343f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The rule query offset is taken from the `query_offset` value in the rule group configuration. If empty, it defaults to the [`rule_query_offset` configuration setting](ref:configure-grafana-rule_query_offset), which is `1m` by default.",
      "headingPath": [
