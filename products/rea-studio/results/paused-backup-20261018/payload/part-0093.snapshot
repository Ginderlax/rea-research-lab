const record={schema:'rea-native-calculation-performance-followup/v1',recordedAt:new Date().toISOString(),artifacts,implementation:{path:currentPath,sha256:currentSha},baselineSourceRevision:'50155ea79ca43fd38842619e9acab7c0ea1976b0',originalRelease:'@grafana/data13.2.3',differential:{comparisons:differential.comparisons,standardHelperComparisons:differential.standardHelperComparisons,failures:differential.failures.length,receipt:'products/rea-studio/apps/metrics/results/native-calculations-verification.json'},selectedChange:'Shared sorted percentile input within one calculation call; single queue allocation and in-place assembly of a private result. No sorted-data cache persists across calls.',selectedSummary:shared.summary,retainedAlternative:'Direct standard-result literal was rejected after its separate trial had a slower large-standard median. The trial and exact source are retained.',limits:['Exploratory five synthetic workloads, three fresh process samples per implementation/workload; finite data does not establish all-input or whole-product superiority.','Both original and candidate modules are loaded in each child for exact-output checks, so reported memory is not an isolated implementation resource benchmark.','Three selected-change standard/single-percentile workloads have slower candidate medians, recorded without a significance claim.','Concurrent development activity, scheduling, warmup, small samples and the shared validation setup limit inference.','Worker verifies original archive and retained original module hashes, and dependency archive/location; the full independent differential runner separately authenticates actual lodash runtime bytes against its archive.'],fullFeatureParityEstablished:false,universalSuperiorityEstablished:false};
