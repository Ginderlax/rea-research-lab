    },
    {
      "id": "grafana.candidate.c86c57ef3c877c0c7cd8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The Grafana 7.0 stable release is scheduled for the 18th of May. In the meantime, if you want to know more about what we've been up to and what is coming, sign up for our online GrafanaCon conference.",
      "headingPath": [
        "What's new in Grafana v7.0"
