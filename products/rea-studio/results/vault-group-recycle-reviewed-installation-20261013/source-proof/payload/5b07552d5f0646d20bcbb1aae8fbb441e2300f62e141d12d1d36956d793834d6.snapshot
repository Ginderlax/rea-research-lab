import test from'node:test';import assert from'node:assert/strict';import{randomUUID}from'node:crypto';import fs from'node:fs/promises';import path from'node:path';import{fileURLToPath}from'node:url';
import{render}from'../keepass-group-recycle-next/products/rea-studio/apps/vault/client.mjs';import{handle,dispose}from'../keepass-group-recycle-next/products/rea-studio/apps/vault/server.mjs';import{Element,descendants,button,field,deferred}from'../keepass-group-recycle-next/products/rea-studio/apps/vault/ui-fixture.mjs';
const own=path.dirname(fileURLToPath(import.meta.url));function row(root,name){const r=descendants(root).find(e=>e.tagName==='section'&&e.children.some(c=>c.tagName==='strong'&&c.textContent===name));assert(r);return r;}
for(const close of [false,true])test('held descendant entry-bin read after group purge '+(close?'explicit-close control':'must not republish purged password'),async t=>{const workspace={root:'owned-postfreeze-'+randomUUID()},store={value:null,get:async()=>structuredClone(store.value),set:async(k,v)=>{store.value=structuredClone(v)}},call=(action,input={})=>handle({action,input,store,workspace}),entered=deferred(),release=deferred(),calls=[];await call('create',{password:'Owned synthetic group probe master'});const A=(await call('save',{title:'A',group:'Parent/Selected',password:'owned-synthetic-purged-secret'})).id;globalThis.document={createElement:tag=>new Element(tag)};const root=new Element('main'),cleanup=await render(root,async(action,input)=>{calls.push({action,id:input?.id});const result=await call(action,input);if(action==='recycleRead'){entered.resolve();await release.promise;}return result;});const observed={close,A};t.after(async()=>{release.resolve();cleanup();dispose(workspace);delete globalThis.document;await fs.writeFile(path.join(own,close?'control.json':'failure.json'),JSON.stringify({observed,calls,scope:'Actual frozen777 staged client/handler, controlled held completed read response, synthetic in-memory encrypted store and owned DOM model; no HTTP/browser'},null,2)+'\n');});await button(root,'Show groups').click();let g=row(root,'Selected');field(g,'Confirm recycle group and descendants').checked=true;await button(g,'Recycle group and descendants').click();await button(root,'Show recycle bin').click();const pending=button(root,'Preview recycled entry').click();await entered.promise;if(close)await button(root,'Close recycle bin').click();await button(root,'Show recycled groups').click();g=row(root,'Selected');field(g,'Confirm permanently delete group and descendants').checked=true;await button(g,'Permanently delete group and descendants').click();observed.afterPurge={active:(await call('list')).entries.length,bin:(await call('recycleList')).entries.length,groupBin:(await call('recycleGroupList',{bin:true})).groups.map(r=>r.name)};assert.equal(observed.afterPurge.bin,0);release.resolve();await pending;observed.secretRepublished=descendants(root).some(e=>e.value==='owned-synthetic-purged-secret');observed.remainingEntryBinRows=descendants(root).filter(e=>e.tagName==='strong'&&e.textContent==='A').length;assert.equal(observed.secretRepublished,false,'A completed old entry read must not republish the permanently purged descendant password.');});
