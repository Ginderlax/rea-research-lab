    {
      "id": "grafana.candidate.069cb0103dc7378d3963",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To print the value of something, use `{{` and `}}`. You can print the value of a [variable](#variables), a field of a variable, the result of a function, or the value of dot.",
      "headingPath": [
        "Alerting template language",
        "Print"
      ],
      "source": {
        "path": "docs/sources/alerting/configure-notifications/template-notifications/language.md",
        "gitBlobSha": "7a61e727b00769b04a469d01da199d00c5fed9e1",
        "sha256": "bda2acacaf8b0ce3dd8ce5a7cef1e180a41b2b9f7900788171f2874446b0dbfc",
        "lineStart": 58,
        "lineEnd": 58,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/configure-notifications/template-notifications/language.md#L58-L58"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
