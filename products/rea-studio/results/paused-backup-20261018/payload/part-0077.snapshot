    {
      "id": "grafana.candidate.17900712668b1de2a0d4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set to `true` to log the SQL calls and execution times.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[database]`",
        "`log_queries`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
