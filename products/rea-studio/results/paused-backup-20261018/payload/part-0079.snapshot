    {
      "id": "grafana.candidate.1b146a32a6b8d8c86bf5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We are announcing a license change to the anonymous access feature in Grafana 11. As you may already be aware, anonymous access allows users access to Grafana without login credentials. Anonymous access was an early feature of Grafana to share dashboards; however, we recently introduced [Public Dashboards](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/dashboards/share-dashboards-panels/shared-dashboards) which allows you to share dashboards in a more secure manner. We also noticed that anonymous access inadvertently resulted in user licensing issues. After careful consideration, we have decided to charge for the continued use of anonymous access starting in Grafana 11.",
      "headingPath": [
        "What’s new in Grafana v11.0",
        "Authentication and authorization",
        "Anonymous users are billed in Grafana Enterprise"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-0.md",
        "gitBlobSha": "718032fb1fcee4d964da6aa4e9da332a64bf509a",
        "sha256": "4ac4a4d84503349934037643cc351a7722532a4c4189aab283838810ba2f6731",
        "lineStart": 387,
        "lineEnd": 387,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-0.md#L387-L387"
      },
      "applicability": {
        "status": "excluded-by-paid-or-hosted-section-heading",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ],
        "restriction": "What’s new in Grafana v11.0 > Authentication and authorization > Anonymous users are billed in Grafana Enterprise"
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.a4b190aa70d9661b1dec",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "[Anonymous authentication](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-access/configure-authentication/grafana/#anonymous-authentication) is disabled by default in Grafana Cloud. This licensing change only affects Grafana Enterprise (self-managed) edition. Anonymous users will be charged as active users in Grafana Enterprise.",
      "headingPath": [
        "What’s new in Grafana v11.0",
        "Authentication and authorization",
        "Anonymous users are billed in Grafana Enterprise"
      ],
      "source": {
