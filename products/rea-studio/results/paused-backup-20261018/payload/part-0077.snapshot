      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c9bbde9fd74401033c55",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "> **Note:** If you are on a Linux system (for example, Debian or Ubuntu), you might need to add `sudo` before the command or add your user to the `docker` group. For more information, refer to [Linux post-installation steps for Docker Engine](https://docs.docker.com/engine/install/linux-postinstall/).",
      "headingPath": [
        "Run Grafana Docker image",
        "Run Grafana via Docker Compose",
        "Run the latest stable version of Grafana"
      ],
      "source": {
