    {
      "id": "grafana.candidate.bf86ccf180f51e81079b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To create advanced queries, switch to **Code mode** by clicking **Code** in the upper right of the editor window. Code mode supports the auto-completion of tables, columns, SQL keywords, standard SQL functions, Grafana template variables, and Grafana macros. Columns cannot be completed before a table has been specified.",
      "headingPath": [
        "PostgreSQL query editor",
        "PostgreSQL Code mode"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/query-editor/_index.md",
        "gitBlobSha": "da418c753c9813f78e1d4eed64e0946e46a50b3e",
        "sha256": "039487ccd5bee34210f2a93dfc270b66e758127ff361f491daa43c2203030f7f",
        "lineStart": 54,
        "lineEnd": 54,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/query-editor/_index.md#L54-L54"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.7eabc17b0b7d3637115b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If a table or column name is a reserved word or contains mixed case or special characters, use double quotes in SQL. For example, `\"user\"` or `\"Created At\"`.",
      "headingPath": [
        "PostgreSQL query editor",
        "PostgreSQL Code mode"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/query-editor/_index.md",
        "gitBlobSha": "da418c753c9813f78e1d4eed64e0946e46a50b3e",
        "sha256": "039487ccd5bee34210f2a93dfc270b66e758127ff361f491daa43c2203030f7f",
        "lineStart": 57,
        "lineEnd": 57,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/query-editor/_index.md#L57-L57"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.828d8f1d7d1d754100a6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Select **Table** or **Time Series** as the format. Click the **{}** in the bottom right to format the query. Click the **downward caret** to expand the Code mode editor. **CTRL/CMD + Return** serves as a keyboard shortcut to execute the query.",
      "headingPath": [
        "PostgreSQL query editor",
        "PostgreSQL Code mode"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/query-editor/_index.md",
        "gitBlobSha": "da418c753c9813f78e1d4eed64e0946e46a50b3e",
        "sha256": "039487ccd5bee34210f2a93dfc270b66e758127ff361f491daa43c2203030f7f",
        "lineStart": 62,
        "lineEnd": 62,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/query-editor/_index.md#L62-L62"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.f804d172a59268a87fe9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Changes made to a query in Code mode don't transfer to Builder mode and are discarded. You're prompted to copy your code to the clipboard to save any changes.",
      "headingPath": [
        "PostgreSQL query editor",
        "PostgreSQL Code mode"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/query-editor/_index.md",
