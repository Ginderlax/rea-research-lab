    {
      "id": "grafana.candidate.eb5697fb1ed068d7cd10",
      "syntaxRole": "table-row",
      "sourceText": "| GA    | `v1`       | Generally Available. Stable with backward compatibility guarantees          | For production use       | Yes                 |",
      "headingPath": [
        "The new HTTP API structure in Grafana",
        "Understand the components",
        "Version (`<version>`)"
      ],
      "source": {
        "path": "docs/sources/developer-resources/api-reference/http-api/apis.md",
        "gitBlobSha": "57cb1db078e37847766f644175fa4057c6bfec77",
        "sha256": "66c492fe7124bb08a985cbf9c935975b5c3da503a48728a2bdd42b51376b3684",
        "lineStart": 99,
        "lineEnd": 99,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/developer-resources/api-reference/http-api/apis.md#L99-L99"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss",
          "cloud"
        ]
      },
