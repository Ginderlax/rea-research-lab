    },
    {
      "id": "grafana.candidate.5119ba628febf993e302",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you use PDC with SigV4 (AWS Signature Version 4 Authentication), the PDC agent must allow internet egress to `sts.<region>.amazonaws.com:443`.",
      "headingPath": [
        "Configure the Elasticsearch data source",
        "Private data source connect (PDC) and Elasticsearch"
