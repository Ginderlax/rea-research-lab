import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import {start} from './products/rea-studio/server.mjs';
const root=path.dirname(fileURLToPath(import.meta.url)),repo=path.resolve(root,'../../outputs/rea-research-lab'),hash=bytes=>createHash('sha256').update(bytes).digest('hex'),sources=[];
for(const name of ['index.html','studio.mjs','style.css']){const relative='products/rea-studio/public/'+name,bytes=await fs.readFile(path.join(repo,relative));await fs.mkdir(path.dirname(path.join(root,relative)),{recursive:true});await fs.writeFile(path.join(root,relative),bytes);const preserved=path.join(root,'baseline',relative+'.snapshot');await fs.mkdir(path.dirname(preserved),{recursive:true});await fs.writeFile(preserved,bytes);sources.push({path:relative,source:path.join(repo,relative),bytes:bytes.length,sha256:hash(bytes),role:'Exact production host UI shell for isolated staged browser QA'});}await fs.writeFile(path.join(root,'browser-baseline.json'),JSON.stringify({sources},null,2)+'\n');
const host=await start({port:0,dataDir:path.join(root,'.local/browser-data')});const fixture=await fs.readFile(new URL('./products/rea-studio/apps/notes/fixtures/pinned-joplin.jex',import.meta.url));const response=await fetch(host.url+'/api/notes/jex-import',{method:'POST',headers:{'content-type':'application/json','x-rea-token':host.token},body:JSON.stringify({base64:fixture.toString('base64')})});if(!response.ok)throw new Error(await response.text());await fs.writeFile(path.join(root,'.local/browser-host.json'),JSON.stringify({url:host.url,sources},null,2)+'\n');console.log(JSON.stringify({url:host.url+'/#notes',privateEphemeralHost:true}));let closed=false;async function stop(){if(closed)return;closed=true;await host.close();process.exit(0);}process.on('SIGINT',stop);process.on('SIGTERM',stop);setInterval(()=>{},1000);
