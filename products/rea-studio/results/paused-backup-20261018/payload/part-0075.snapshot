    {
      "id": "grafana.candidate.d61620db8cdb5a755cf8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Classic condition checks if any time series data matches the alert condition. It always produce one alert instance only, no matter how many time series meet the condition.",
