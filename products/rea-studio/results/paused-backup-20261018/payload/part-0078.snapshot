    {
      "id": "grafana.candidate.1f2c38c865760fd2c85c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Based on specific data source, certain query editors allow you to select the label or labels to add to your query. Labels are fields that consist of key/value pairs representing information in the data. Some data sources allow for selecting fields.",
