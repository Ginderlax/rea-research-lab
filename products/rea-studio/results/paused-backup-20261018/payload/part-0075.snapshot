    {
      "id": "grafana.candidate.c8347f1e069559b3e404",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If Grafana has been set up to send images in notifications, however notifications are still being received without them, follow the troubleshooting steps below:",
      "headingPath": [
        "Use images in notifications",
        "Troubleshooting"
      ],
