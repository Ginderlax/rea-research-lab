    },
    {
      "id": "grafana.candidate.fcc01c2056860593d5a5",
      "syntaxRole": "list-item",
      "sourceText": "- **Reset value**: The value the counter resets to, typically `0`.",
      "headingPath": [
        "OpenTSDB query editor",
        "Rate section",
        "Counter settings"
      ],
      "source": {
        "path": "docs/sources/datasources/opentsdb/query-editor/index.md",
