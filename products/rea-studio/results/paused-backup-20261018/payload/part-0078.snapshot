    },
    {
      "id": "grafana.candidate.bad42f5b9250633c40b8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In this URL, the query parameter `var-example=value` represents the dashboard variable `example` with a value of `value`.",
      "headingPath": [
        "Dashboard URL variables",
        "Variables as query parameters"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/build-dashboards/create-dashboard-url-variables/index.md",
        "gitBlobSha": "24aff38ae5ef68283008fce248d7fe7b5e3eaeae",
