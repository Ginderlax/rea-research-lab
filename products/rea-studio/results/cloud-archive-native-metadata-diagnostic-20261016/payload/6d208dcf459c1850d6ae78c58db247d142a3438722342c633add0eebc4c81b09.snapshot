// Read-only orchestration and backup. No captured source is imported or executed.
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import {spawnSync} from 'node:child_process';
import {createHash} from 'node:crypto';
const RUN='PENDING_RUN',HEAD='PENDING_HEAD',JOB='PENDING_JOB',ATTEMPT='1';
const READER='unpack-archive-native-diagnostic-r3-PENDING.py',READER_BYTES=34332,READER_SHA256='82ddbd65a3b7f51368591479c107cdc1689ff0ccbe1285a291ca8a2c55555942';
assert(/^\d+$/.test(RUN)&&/^\d+$/.test(JOB)&&/^[0-9a-f]{40}$/.test(HEAD)&&Number.isSafeInteger(READER_BYTES)&&/^[0-9a-f]{64}$/.test(READER_SHA256),'Unbound template refuses before credentials, files or network');
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab');
const repo='/repos/Ginderlax/rea-research-lab',workflow='.github/workflows/archive-native-metadata-diagnostic.yml',jobName='five-unchanged-archive-checks';
const sha=bytes=>createHash('sha256').update(bytes).digest('hex'),identity=bytes=>({bytes:bytes.length,sha256:sha(bytes)});
async function exists(file){try{await fs.lstat(file);return true;}catch(error){if(error.code==='ENOENT')return false;throw error;}}
async function ownedRegular(file,maximum){const info=await fs.lstat(file);assert(info.isFile()&&!info.isSymbolicLink()&&info.size<=maximum);const bytes=await fs.readFile(file);assert.equal(bytes.length,info.size);return bytes;}
const credential=spawnSync('git',['credential','fill'],{cwd:lab,env:{...process.env,GIT_TERMINAL_PROMPT:'0',GCM_INTERACTIVE:'Never'},input:'protocol=https\nhost=github.com\n\n',encoding:'utf8',windowsHide:true,timeout:20000,maxBuffer:128*1024});
assert.equal(credential.status,0,'Saved GitHub authentication unavailable');
const fields=Object.fromEntries(credential.stdout.split('\n').filter(line=>line.includes('=')).map(line=>{const at=line.indexOf('=');return[line.slice(0,at),line.slice(at+1)];}));assert(fields.password);
const headers={Accept:'application/vnd.github+json','User-Agent':'REA-native-diagnostic-backup','X-GitHub-Api-Version':'2022-11-28',Authorization:'Bearer '+fields.password};
async function get(endpoint,limit){
 assert(endpoint.startsWith(repo+'/'));
 const response=await fetch('https://api.github.com'+endpoint,{headers,signal:AbortSignal.timeout(60000)});assert.equal(response.status,200,'Read-only GitHub GET failed');
 const declared=Number(response.headers.get('content-length'));assert(!declared||declared<=limit);const chunks=[];let total=0;
 for await(const chunk of response.body){total+=chunk.length;assert(total<=limit,'Bounded API or artifact read');chunks.push(chunk);}return Buffer.concat(chunks);
}
const folder=path.join(work,'cloud-verification-backups','run-'+RUN);await fs.mkdir(folder,{recursive:true});
const control=path.join(folder,'native-diagnostic-control-plane-'+new Date().toISOString().replace(/[:.]/g,'-'));await fs.mkdir(control,{recursive:false});
const records=await Promise.all(['run','jobs','artifacts'].map(async kind=>{
 const bytes=await get(repo+'/actions/runs/'+RUN+(kind==='run'?'':'/'+kind),512*1024);const value=JSON.parse(bytes);const file=path.join(control,kind+'.json');await fs.writeFile(file,bytes,{flag:'wx'});assert.deepEqual(await fs.readFile(file),bytes);return{kind,path:file,...identity(bytes),value};
}));
const [actual,jobs,artifacts]=records.map(row=>row.value);
assert.equal(String(actual.id),RUN);assert.equal(String(actual.run_attempt),ATTEMPT);assert.equal(actual.head_sha,HEAD);assert.equal(actual.head_branch,'codex/rea-cloud-recovery-20261015');assert.equal(actual.path,workflow);assert(['push','workflow_dispatch'].includes(actual.event));assert.equal(actual.repository.full_name,'Ginderlax/rea-research-lab');
assert.equal(jobs.total_count,1);assert.equal(jobs.jobs.length,1);const job=jobs.jobs[0];assert.equal(String(job.id),JOB);assert.equal(String(job.run_id),RUN);assert.equal(job.head_sha,HEAD);assert.equal(job.name,jobName);assert(job.labels.includes('windows-2022'));assert.equal(job.runner_group_name,'GitHub Actions');
const summary={schema:'rea-native-diagnostic-readonly-collection/v1',collectedAtUtc:new Date().toISOString(),runId:RUN,jobId:JOB,headSHA:HEAD,runAttempt:ATTEMPT,runStatus:actual.status,runConclusion:actual.conclusion,jobStatus:job.status,jobConclusion:job.conclusion,metadata:records.map(({value,...row})=>row),artifacts:[],localCandidateExecutions:0,localProductExecutions:0,localTests:0,localBuilds:0,localSyntaxChecks:0,historicalD24CauseProven:false,fullSuiteAcceptance:false,fullParity:false,superiority:false};
if(actual.status!=='completed'||job.status!=='completed'){
 summary.collectionState='Nonterminal raw API snapshot only; no complete backup or diagnostic acceptance claimed.';
 await fs.writeFile(path.join(control,'nonterminal-observation.json'),JSON.stringify(summary,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(summary));
}else{
 const rawLog=await get(repo+'/actions/jobs/'+JOB+'/logs',4*1024*1024),log=path.join(control,'job-'+JOB+'-logs.txt');await fs.writeFile(log,rawLog,{flag:'wx'});assert.deepEqual(await fs.readFile(log),rawLog);summary.rawJobLog={path:log,...identity(rawLog)};
 const commitBytes=await get(repo+'/git/commits/'+HEAD,512*1024),commit=JSON.parse(commitBytes);assert.equal(commit.sha,HEAD);assert(/^[0-9a-f]{40}$/.test(commit.tree.sha));
 const treeBytes=await get(repo+'/git/trees/'+commit.tree.sha+'?recursive=1',32*1024*1024),tree=JSON.parse(treeBytes);assert.equal(tree.sha,commit.tree.sha);assert.equal(tree.truncated,false);assert(tree.tree.length<=100000);
 for(const[kind,bytes]of [['commit',commitBytes],['tree',treeBytes]]){const file=path.join(control,kind+'.json');await fs.writeFile(file,bytes,{flag:'wx'});assert.deepEqual(await fs.readFile(file),bytes);summary.metadata.push({kind,path:file,...identity(bytes)});}
 assert.equal(artifacts.total_count,1);assert.equal(artifacts.artifacts.length,1);const artifact=artifacts.artifacts[0];
 assert.equal(artifact.name,'archive-native-diagnostic-'+RUN+'-'+ATTEMPT);assert.equal(String(artifact.workflow_run.id),RUN);assert.equal(artifact.workflow_run.head_sha,HEAD);assert.equal(artifact.expired,false);assert(Number.isSafeInteger(artifact.id)&&artifact.id>0&&Number.isSafeInteger(artifact.size_in_bytes)&&artifact.size_in_bytes>0&&artifact.size_in_bytes<=8*1024*1024);assert(/^sha256:[0-9a-f]{64}$/.test(artifact.digest));
 const expected=artifact.digest.slice('sha256:'.length),zip=path.join(folder,'artifact-'+artifact.id+'.zip');
 if(!await exists(zip)){const bytes=await get(repo+'/actions/artifacts/'+artifact.id+'/zip',8*1024*1024);assert.equal(bytes.length,artifact.size_in_bytes);assert.equal(sha(bytes),expected);await fs.writeFile(zip,bytes,{flag:'wx'});}
 const raw=await ownedRegular(zip,8*1024*1024);assert.equal(raw.length,artifact.size_in_bytes);assert.equal(sha(raw),expected);
 const reader=path.join(work,READER),readerRaw=await ownedRegular(reader,256*1024);assert.equal(readerRaw.length,READER_BYTES);assert.equal(sha(readerRaw),READER_SHA256);
 const report=path.join(folder,'artifact-'+artifact.id+'-native-diagnostic-reader-r3-v1','local-native-diagnostic-backup-verification.json');
 if(!await exists(report)){
  const child=spawnSync('C:/Users/evanh/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/python.exe',[reader,zip,expected,control,String(artifact.id)],{encoding:'utf8',windowsHide:true,timeout:120000,maxBuffer:4*1024*1024});
  const stdout=Buffer.from(child.stdout??''),stderr=Buffer.from(child.stderr??'');for(const[kind,bytes]of [['stdout',stdout],['stderr',stderr]])await fs.writeFile(path.join(control,'backup-reader-'+kind+'.txt'),bytes,{flag:'wx'});
  summary.backupReaderInvocation={reader:READER,...identity(readerRaw),exitCode:child.status,signal:child.signal??null,error:child.error?{name:child.error.name,code:child.error.code??null}:null,stdout:identity(stdout),stderr:identity(stderr)};
  if(child.status!==0){summary.collectionState='All raw uploaded ZIP bytes preserved; data-only backup reader failed. No diagnostic acceptance claimed.';summary.artifacts.push({artifactId:String(artifact.id),path:zip,...identity(raw),readabilityVerified:false});await fs.writeFile(path.join(control,'collection-summary-reader-failed.json'),JSON.stringify(summary,null,2)+'\n',{flag:'wx'});throw new Error('Data-only diagnostic backup reader failed; original ZIP and raw diagnostics preserved.');}
 }
 const verified=JSON.parse(await ownedRegular(report,2*1024*1024));assert.equal(verified.schema,'rea-local-native-metadata-diagnostic-backup/v1');assert.equal(verified.runId,RUN);assert.equal(verified.jobId,JOB);assert.equal(verified.headSHA,HEAD);assert.equal(verified.artifactId,String(artifact.id));assert.deepEqual(verified.artifactIdentity,identity(raw));assert.equal(verified.allCRCAndBytesReadable,true);assert.equal(verified.historicalD24CauseProven,false);
 summary.artifacts.push({artifactId:String(artifact.id),path:zip,...identity(raw),readabilityVerified:true,readableFileCount:verified.files.length,backupVerification:report,diagnosticFiveChecksAccepted:verified.diagnosticFiveChecksAccepted,nativeObservationsQualified:verified.nativeObservationsQualified,completeTwoWorkerObservations:verified.completeTwoWorkerObservations,auditErrors:verified.auditErrors});
 summary.collectionState='Complete readable uploaded bytes retained. Native observations and the strict five-check diagnostic outcome are separately qualified; failed product checks stay failed.';
 const file=path.join(control,'collection-summary.json');await fs.writeFile(file,JSON.stringify(summary,null,2)+'\n',{flag:'wx'});assert.deepEqual(JSON.parse(await fs.readFile(file,'utf8')),summary);console.log(JSON.stringify(summary));
}
