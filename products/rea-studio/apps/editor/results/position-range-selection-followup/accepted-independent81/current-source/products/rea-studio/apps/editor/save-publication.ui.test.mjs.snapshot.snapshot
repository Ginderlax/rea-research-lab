import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import os from 'node:os';
import {render} from './client.mjs';import {handle} from './server.mjs';import {createWorkspace} from '../../lib/storage.mjs';
class Element{constructor(tag){this.tagName=tag;this.children=[];this.attributes={};this.value='';this.textContent='';this.disabled=false;this.checked=false;this.style={};this.selectionStart=this.selectionEnd=0;}append(...nodes){this.children.push(...nodes);}prepend(...nodes){this.children.unshift(...nodes);}replaceChildren(...nodes){this.children=[...nodes];}insertBefore(node,before){const i=this.children.indexOf(before);this.children.splice(i<0?this.children.length:i,0,node);}setAttribute(name,value){this.attributes[name]=value;}focus(){this.focused=true;}setSelectionRange(start,end){this.selectionStart=start;this.selectionEnd=end;}}
const all=root=>[root,...root.children.flatMap(all)],field=(root,label)=>all(root).find(node=>node.attributes['aria-label']===label),button=(root,label)=>all(root).find(node=>node.tagName==='button'&&node.textContent===label),deferred=()=>{let resolve;const promise=new Promise(r=>resolve=r);return{promise,resolve};};
async function fixture(t,id,realConflict=false){const folder=await fs.mkdtemp(path.join(os.tmpdir(),'rea-save-ui-')),workspace=await createWorkspace(path.join(folder,'workspace'));await fs.writeFile(workspace.resolve('a.txt'),'original A\n');await fs.writeFile(workspace.resolve('b.txt'),'original B\n');const previous={document:globalThis.document,window:globalThis.window};globalThis.document={createElement:tag=>new Element(tag)};globalThis.window={confirm:()=>true};const root=new Element('main'),arrived=deferred(),release=deferred(),calls=[];let saves=0,firstOutcome=null;const api=async(action,input)=>{calls.push({action,input:structuredClone(input)});if(action==='save'&&++saves===1){if(realConflict)await fs.writeFile(workspace.resolve('a.txt'),'external saved A\n');let result,error;try{result=await handle({action,input,workspace});}catch(failure){error=failure;}firstOutcome={input:structuredClone(input),result,error:error?.message,diskA:await fs.readFile(workspace.resolve('a.txt'),'utf8')};arrived.resolve();await release.promise;if(error)throw error;return result;}return action==='gitStatus'?{initialized:false}:handle({action,input,workspace});};const dispose=await render(root,api);await button(root,'a.txt').onclick();const editor=field(root,'File contents');editor.value='captured save A\n';editor.oninput();const pending=button(root,'Save file').onclick();t.after(async()=>{release.resolve();await pending;dispose();globalThis.document=previous.document;globalThis.window=previous.window;assert.equal(path.dirname(path.resolve(folder)),path.resolve(os.tmpdir()));assert.ok(path.basename(folder).startsWith('rea-save-ui-'));await fs.rm(folder,{recursive:true,force:true});});await arrived.promise;return{root,workspace,editor,pending,arrived,release,dispose,calls,observe:async extra=>{const value={id,...extra,firstOutcome,editorValue:editor.value,editorDisabled:editor.disabled,saveDisabled:button(root,'Save file').disabled,status:all(root).filter(node=>node.attributes.role==='status').map(node=>node.textContent),tabs:all(root).filter(node=>node.attributes['aria-pressed']!==undefined).map(node=>({label:node.textContent,active:node.attributes['aria-pressed']})),calls,diskA:await fs.readFile(workspace.resolve('a.txt'),'utf8'),diskB:await fs.readFile(workspace.resolve('b.txt'),'utf8')};console.log(JSON.stringify({editorSavePublicationObservation:value}));return value;}};}
test('pending duplicate requests are refused while typing stays enabled; later save uses the committed revision',async t=>{const f=await fixture(t,'pending-retry');assert.equal(button(f.root,'Save file').disabled,true);assert.equal(f.editor.disabled,false);f.editor.value='newer draft for retry\n';f.editor.oninput();await button(f.root,'Save file').onclick();f.editor.onkeydown({ctrlKey:true,key:'s',preventDefault(){}});assert.equal(f.calls.filter(row=>row.action==='save').length,1);f.release.resolve();await f.pending;assert.equal(button(f.root,'Save file').disabled,false);assert.equal(f.editor.value,'newer draft for retry\n');await button(f.root,'Save file').onclick();const result=await f.observe({successfulRetry:true});assert.equal(f.calls.filter(row=>row.action==='save').length,2);assert.equal(result.diskA,'newer draft for retry\n');assert.ok(result.tabs.some(row=>row.label==='a.txt'&&row.active==='true'));});
test('actual revision failure retains draft and releases pending state; reopened current revision can save',async t=>{const f=await fixture(t,'real-conflict',true);f.editor.value='newer draft after conflict\n';f.editor.oninput();f.release.resolve();await f.pending;assert.equal(f.editor.value,'newer draft after conflict\n');assert.equal(button(f.root,'Save file').disabled,false);assert.ok(all(f.root).some(node=>/File changed since/.test(node.textContent)));await button(f.root,'Save file').onclick();assert.equal(await fs.readFile(f.workspace.resolve('a.txt'),'utf8'),'external saved A\n');await button(f.root,'Close tab').onclick();field(f.root,'Relative file path').value='a.txt';await button(f.root,'Open file').onclick();f.editor.value='successful reopened save\n';f.editor.oninput();await button(f.root,'Save file').onclick();const result=await f.observe({realConflictRetry:true});assert.equal(result.diskA,'successful reopened save\n');assert.equal(result.saveDisabled,false);assert.match(result.firstOutcome.error,/File changed since/);});
test('disposed save views refuse fresh save activation and suppress their held completion',async t=>{const f=await fixture(t,'disposed-activation');f.dispose();const before=all(f.root).filter(node=>node.attributes.role==='status').map(node=>node.textContent);await button(f.root,'Save file').onclick();assert.equal(f.calls.filter(row=>row.action==='save').length,1);f.release.resolve();await f.pending;const result=await f.observe({disposed:true,before});assert.deepEqual(result.status,before);assert.equal(result.diskA,'captured save A\n');});
test('another document can save while the first response is held without losing its active context',async t=>{const f=await fixture(t,'two-documents');await button(f.root,'b.txt').onclick();f.editor.value='committed B while A held\n';f.editor.oninput();await button(f.root,'Save file').onclick();const before=all(f.root).filter(node=>node.attributes.role==='status').map(node=>node.textContent);f.release.resolve();await f.pending;const result=await f.observe({twoDocuments:true,before});assert.equal(result.editorValue,'committed B while A held\n');assert.deepEqual(result.status,before);assert.equal(result.diskA,'captured save A\n');assert.equal(result.diskB,'committed B while A held\n');assert.ok(result.tabs.some(row=>row.label==='b.txt'&&row.active==='true'));});
