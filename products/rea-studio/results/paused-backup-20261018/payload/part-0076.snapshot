    {
      "id": "grafana.candidate.33a06be3dd530d72622d",
      "syntaxRole": "table-row",
      "sourceText": "| **Max open**      | The maximum number of open connections to the database. If set to `0`, there is no limit. If `max open` is greater than `0` and less than `max idle`, `max idle` is adjusted to match.       |",
      "headingPath": [
        "Configure the Microsoft SQL Server data source",
        "Configure the data source in the UI"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/configure/index.md",
