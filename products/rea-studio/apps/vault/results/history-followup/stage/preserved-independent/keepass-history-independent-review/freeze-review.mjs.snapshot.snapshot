const old=JSON.parse(await fs.readFile(path.join(stage,'baseline-validation.json')));for(const row of old.appFiles)if(sha(await fs.readFile(path.join(repo,row.path)))!==row.sha256)throw new Error('Production source changed during review: '+row.path);
