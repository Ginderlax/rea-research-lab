    {
      "id": "grafana.candidate.5310a6119377522c6eff",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana doesn't have built-in support for conditionally omitting entire `WHERE` clauses based on variable selection. Use one of these patterns to achieve conditional filtering.",
      "headingPath": [
        "Microsoft SQL Server template variables",
        "Conditional SQL clauses"
      ],
      "source": {
