  "atomicContracts": [
    {
      "id": "grafana.oss.dashboard.custom-layout",
      "contractKind": "authored-observable-behavior",
      "given": "a dashboard using Custom layout",
      "when": "manually position or resize a panel",
      "then": "the saved panel uses the requested position and size",
      "source": {
        "path": "docs/sources/visualizations/dashboards/build-dashboards/create-dashboard/_index.md",
        "gitBlobSha": "fd219e23bfc50a2e71b5702fad688f15b70f78b0",
        "sha256": "57452e87c1a1acc1456f97b28bae24dbe22704ca2f96e5f73591e1a6ff201fee",
        "lineStart": 257,
        "lineEnd": 257,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/dashboards/build-dashboards/create-dashboard/_index.md#L257-L257"
      },
      "sourceExcerpt": "- **Custom**: You can position and size panels individually. This is the default selection for a new dashboard. **Show/hide rules** are not supported.",
      "applicability": {
        "status": "reviewed-oss-section-contract",
        "documentProducts": [
          "cloud",
          "enterprise",
          "oss"
        ],
        "editionBoundary": "Show/hide rules are not supported for this layout."
      },
      "platform": {
        "classification": "platform-scope-not-yet-normalized",
        "scopeVerified": false
      },
      "scopeLimitations": [
        "Show/hide rules are not supported for this layout."
      ],
      "sourceReviewed": true,
