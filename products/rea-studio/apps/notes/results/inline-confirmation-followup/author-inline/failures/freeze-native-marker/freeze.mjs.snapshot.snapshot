import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
import {collect} from '../../outputs/rea-research-lab/products/rea-studio/scripts/read-rabin-tap.mjs';
const root=path.dirname(fileURLToPath(import.meta.url)),workspace=path.resolve(root,'../..'),lab=path.join(workspace,'outputs/rea-research-lab'),studio=path.join(root,'products/rea-studio'),hash=b=>createHash('sha256').update(b).digest('hex');
const read=p=>fs.readFile(path.join(root,p)),parse=async p=>JSON.parse(await read(p)),put=(p,v)=>fs.writeFile(path.join(root,p),JSON.stringify(v,null,2)+'\n',{flag:'wx'});
const baseline=await parse('baseline-source28.json'),original=await parse('baseline-original-source31.json');assert.equal(baseline.length,28);assert.equal(original.length,31);const candidate=[];
for(const r of [...baseline,...original]){const inert=await read('baseline/'+r.path+'.snapshot');assert.equal(inert.length,r.bytes);assert.equal(hash(inert),r.sha256);const production=await fs.readFile(path.join(lab,r.path));assert.equal(production.length,r.bytes);assert.equal(hash(production),r.sha256,'Production epoch changed '+r.path);const b=await read(r.path);if(original.includes(r)){assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256,'Original helper prerequisite mutated '+r.path);}else candidate.push({path:r.path,bytes:b.length,sha256:hash(b),baselineSha256:r.sha256,changed:hash(b)!==r.sha256});}
const extra='products/rea-studio/apps/notes/notebook-confirmation.ui.test.mjs',extraBytes=await read(extra);candidate.push({path:extra,bytes:extraBytes.length,sha256:hash(extraBytes),baselineSha256:null,changed:true});
const runs=[];for(const n of (await fs.readdir(path.join(root,'runs'))).sort()){const prefix='runs/'+n+'/',r=await parse(prefix+'attempt.json');assert.equal(r.code,0);assert.equal(r.error,null);assert.equal(r.sourceStable,true);assert.equal(r.summary.fail,0);assert.equal(r.summary.skipped,0);assert.equal(r.summary.cancelled,0);assert.equal(hash(await read(prefix+'tests.stdout.txt')),r.raw.stdoutSha256);assert.equal(hash(await read(prefix+'tests.stderr.txt')),r.raw.stderrSha256);assert.deepEqual(await parse(prefix+'source-before.json'),await parse(prefix+'source-after.json'));runs.push({path:prefix+'attempt.json',sha256:hash(await read(prefix+'attempt.json')),kind:r.kind,summary:r.summary,start:r.start,end:r.end,source:r.sourceBefore});}
assert.equal(runs.length,2);const focused=runs.find(r=>r.kind==='focused'),fresh=runs.find(r=>r.kind==='fresh');assert.equal(focused.summary.tests,68);assert.equal(fresh.summary.tests,9);assert.equal(focused.source.length,29);for(const r of focused.source){const b=await fs.readFile(path.join(studio,r.path));assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);}
const observations=await parse(path.dirname(focused.path)+'/observations/inline-confirmation.json');assert.equal(observations.length,9);const native=observations.filter(r=>Object.hasOwn(r,'nativeDialogCalls'));assert.ok(native.length>=3);assert.ok(native.every(r=>r.nativeDialogCalls===0));
const raw=(await read(path.dirname(focused.path)+'/tests.stdout.txt')).toString('utf8'),organization=collect(raw,'notebookOriginalObservations'),trash=collect(raw,'notebookTrashOriginal'),http=collect(raw,'notebookTrashHttp');assert.equal(trash.topLevelOriginalExecutions,13);assert.equal(trash.fullApplicationExecutions,0);assert.equal(http.originalApplicationExecutions,0);
const backend=candidate.filter(r=>['server.mjs','notebooks.mjs','notebook-trash.mjs','notebook-original-oracle.mjs','notebook-trash-original-oracle.mjs','jex.mjs','markdown.mjs'].some(n=>r.path==='products/rea-studio/apps/notes/'+n));assert.equal(backend.length,7);assert.ok(backend.every(r=>!r.changed));
const client=candidate.find(r=>r.path.endsWith('/client.mjs')),clientText=(await read(client.path)).toString();assert.ok(!clientText.slice(clientText.indexOf('trashNotebook.onclick'),clientText.indexOf('moveNote.onclick')).includes('window.confirm'));assert.ok(clientText.includes("dialog.setAttribute('role','alertdialog')"));
const adapters=[];for(const r of candidate.filter(r=>r.changed&&r.baselineSha256&&r.path.endsWith('.mjs')&&!r.path.endsWith('/client.mjs'))){const before=(await read('baseline/'+r.path+'.snapshot')).toString(),after=(await read(r.path)).toString();adapters.push({path:r.path,beforeSha256:r.baselineSha256,afterSha256:r.sha256,before,after,scope:r.path.endsWith('notebook-trash.ui.test.mjs')?'Two prior semantic bodies retargeted to explicit Cancel/Confirm DOM actions and the common synthetic fixture; old native prompt assertions become visible scope assertions. Baseline Owned note fixture title becomes A note.':'Fixture exposes explicit confirmation user action and disposal/focus model, or successful old actions call that helper; backend assertions unchanged. Dirty rejection actions remain direct.'});}
await put('test-adapter-source-pairs.json',adapters);assert.equal(adapters.length,4);
const sourceInspection={appShell:{path:'products/rea-studio/public/studio.mjs',sha256:hash(await fs.readFile(path.join(lab,'products/rea-studio/public/studio.mjs'))),contract:'Existing app shell calls a returned render cleanup on app replacement; no app-shell changes proposed.'},staticHost:{path:'products/rea-studio/server.mjs',baselineSha256:baseline.find(r=>r.path==='products/rea-studio/server.mjs').sha256,contract:'Candidate code stays in existing client.mjs and imports only unchanged markdown.mjs, so no host import-routing change is needed.'}};await put('host-source-inspection.json',sourceInspection);
const copyList=candidate.filter(r=>r.changed).map(r=>({...r,sourcePath:'work/notes-inline-confirmation-next/'+r.path,destination:r.path,bytesExactRequired:true,prospectiveOnly:true}));assert.equal(copyList.length,7);await put('proposed-copy-list.json',{schema:'rea-notes-inline-confirmation-live-proposal/v1',entries:copyList,installed:false,independentReviewPending:true,rootBrowserAcceptancePending:true});
const receipt={schema:'rea-notes-inline-confirmation-candidate-validation/v1',at:new Date().toISOString(),authorFiniteAcceptance:true,independentAcceptance:false,productionInstallation:false,sourceFiles:29,sourceFingerprints:candidate,baseline:{sourceFiles:28,currentProductionBeforeAndFinalExact:true,focused138ReceiptSha256:hash(await read('authority/focused138-integration-validation.json.snapshot')),focused149ManifestSha256:hash(await read('authority/focused138-freeze-manifest.json.snapshot')),priorFrozen149AuthenticatedAtPreparation:true,historicalReferencesSha256:hash(await read('authority/historical-stage-references.json.snapshot')),historicalBodiesUnchangedAtTheirPaths:true,originalSourceAndLedgers31Exact:true},focused:{...focused,source:undefined},earlierFresh:{...fresh,source:undefined,boundary:'The earlier9 pass used the first candidate. Subsequent narrow pending-dialog focus and README changes are retained by distinct exact source snapshots; current source acceptance is the68 run only.'},observations,original:{organization,trash,boundary:'Replay of existing exact released Joplin helper slices with synthetic SQL/load/save and fixed clock; full original app/database/GUI executions zero. No new original-source acquisition or claimed held-out original corpus. Current synthetic fixture consumes historical serialization; no serializer re-execution.'},http,changedFiles:copyList.map(r=>r.path),unchangedBackendIdentities:backend,adapters:{files:4,sourcePairsPath:'test-adapter-source-pairs.json',automaticConfirmationInProduct:false,automaticConfirmationInFixture:false,explicitUserActionHelper:true},failures:{behaviorTests:0,retainedPreparationErrors:2,path:'preparation-errors.json'},limits:{childDeadlineMs:180000,retainedStdoutBytes:8*1024*1024,retainedStderrBytes:2*1024*1024,fingerprintIODedicatedDeadline:false,hardMemoryWatchdog:false,WindowsAtomicDescendantContainment:false},boundaries:{notebookTrashRestoreOnly:true,otherNativeDialogsRetained:true,unmountBeforeConfirmSubmitsNoNotebookRequest:true,unmountAfterCommitDoesNotUndoCommit:true,lateNotebookPublicationSuppressed:true,allOtherClientAsyncLifecycleExhaustivelyCovered:false,DOMModelKeyboardFocusFinite:true,realBrowserExecuted:false,assistiveTechnologyExecuted:false,performanceMeasured:false,fullProductParity:false}};await put('validation.json',receipt);
async function walk(folder,prefix=''){let out=[];for(const r of(await fs.readdir(folder,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const p=prefix+r.name;if(r.isDirectory())out.push(...await walk(path.join(folder,r.name),p+'/'));else{assert.ok(r.isFile());out.push(p);}}return out;}
const rows=[];for(const p of await walk(root)){if(p==='freeze-manifest.json'||p==='public-map-proposal.json')continue;const b=await read(p);rows.push({path:p,bytes:b.length,sha256:hash(b)});}const excluded=rows.filter(r=>r.sha256==='044885c906ba7d8cb97a95fbdd6bc2323ba31a3c301e7ed1d6e592acec8944af').map(r=>({...r,reason:'Synthetic binary TAR/JEX; generated carrier remains local with exact identity, source/input metadata retained.'}));
await put('public-map-proposal.json',{schema:'rea-notes-inline-confirmation-public-map-proposal/v1',installed:false,publicPayloads:rows.filter(r=>!excluded.some(e=>e.path===r.path)).map(r=>({...r,sourcePath:'work/notes-inline-confirmation-next/'+r.path,proposedPath:'inline-confirmation/'+r.path.split('/').map(s=>s==='.local'?'private-local':s).join('/')+'.snapshot'})),excluded,metadataToPreserveSeparately:['public-map-proposal.json','freeze-manifest.json'],priorFocused138History:'Only exact receipts/manifests and source bindings are copied here. Its frozen149 and earlier app epochs remain separately unchanged.'});
const inventory={};for(const p of await walk(root)){if(p==='freeze-manifest.json')continue;const b=await read(p);inventory[p]={bytes:b.length,sha256:hash(b)};}const manifest={schema:'rea-notes-inline-confirmation-freeze/v1',at:new Date().toISOString(),files:Object.keys(inventory).length,bytes:Object.values(inventory).reduce((n,r)=>n+r.bytes,0),inventory};await put('freeze-manifest.json',manifest);for(const[p,r]of Object.entries(inventory)){const b=await read(p);assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);}
console.log(JSON.stringify({files:manifest.files,bytes:manifest.bytes,manifestSha256:hash(await read('freeze-manifest.json')),receiptSha256:hash(await read('validation.json')),clientSha256:client.sha256,sourceFiles:29,currentFocused:focused.summary,changedFiles:copyList.map(r=>r.path),publicMapSha256:hash(await read('public-map-proposal.json')),excludedBinaryCopies:excluded.length}));
