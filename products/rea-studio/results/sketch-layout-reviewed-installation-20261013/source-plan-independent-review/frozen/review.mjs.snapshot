async function tree(root,p=''){const rows=[];for(const e of await fs.readdir(root,{withFileTypes:true})){assert.equal(e.isSymbolicLink(),false);const q=p+e.name;if(e.isDirectory())rows.push(...await tree(path.join(root,e.name),q+'/'));else{assert.ok(e.isFile());rows.push(q);}}return rows.sort();}
