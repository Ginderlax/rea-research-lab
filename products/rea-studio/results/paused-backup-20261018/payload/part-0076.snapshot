    {
      "id": "grafana.candidate.82fe9b9c2c5bd3f16c88",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can create nested variables, sometimes called [chained variables](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/dashboards/variables/add-template-variables/#chained-variables).",
      "headingPath": [
        "InfluxDB template variables",
        "Chain or nest variables"
      ],
