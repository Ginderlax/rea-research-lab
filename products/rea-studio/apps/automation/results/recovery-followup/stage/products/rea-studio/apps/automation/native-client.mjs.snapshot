import {nativeExample,nativeRoutingExample} from './native-example.mjs';
const byteLimit=2*1024*1024,ns='http://www.w3.org/2000/svg';
function el(tag,text,attrs={}){const element=document.createElement(tag);if(text!==undefined)element.textContent=text;Object.assign(element,attrs);if(attrs.role)element.setAttribute('role',attrs.role);return element;}
function button(text,fn){const element=el('button',text,{type:'button',className:'button'});element.addEventListener('click',fn);return element;}
function field(text,input){const element=el('label',text);element.style.display='grid';element.style.gap='6px';element.append(input);return element;}
function svg(tag,attrs={}){const element=document.createElementNS(ns,tag);for(const[key,value]of Object.entries(attrs))element.setAttribute(key,String(value));return element;}
function choose(values){const select=el('select');for(const[value,label]of values)select.append(el('option',label,{value}));return select;}
export async function renderNative(root,api){
 let workflow=nativeExample(),recordId='',revision=0,selectedName='',available=[],activeRun=null,check=null,pollGeneration=0;
 const heading=el('h2','Native n8n workflows'),intro=el('p','Import and preserve n8n workflow JSON. Run the supported Manual Trigger, Edit Fields, If, HTTP Request, Wait, Switch 3.4 and Merge 3.2 versions locally. Unknown nodes stay in the document; execution checks the reachable graph first.',{className:'muted'}),status=el('p','New example · save before running',{role:'status',className:'status'}),actions=el('div',undefined,{className:'row'}),picker=el('select'),name=el('input'),diagram=el('div',undefined,{className:'card'}),issues=el('pre'),documentJSON=el('textarea',undefined,{rows:14,spellcheck:false}),result=el('pre'),history=el('div',undefined,{className:'card'});
 documentJSON.style.width='100%';issues.style.whiteSpace='pre-wrap';result.style.whiteSpace='pre-wrap';diagram.style.overflow='auto';
 const nodeName=el('input'),position=el('input'),parameters=el('textarea',undefined,{rows:9,spellcheck:false}),nodeInfo=el('p'),author=el('div',undefined,{className:'card'}),from=el('select'),to=el('select'),port=el('select'),inputPort=el('select'),kind=choose([['set','Edit Fields 3.4'],['if','If 2.3'],['httpRequest','HTTP Request 4.4'],['wait','Wait 1.1'],['switch','Switch 3.4'],['merge','Merge 3.2']]);parameters.style.width='100%';
 async function attempt(operation){try{await operation();}catch(error){status.textContent=error.message;status.style.color='#b42318';}}
 function mark(text){status.textContent=text;status.style.color='';}
 function readJSON(text){if(new TextEncoder().encode(text).length>byteLimit)throw new Error('Workflow JSON exceeds 2 MiB');return JSON.parse(text);}
 function selectNode(name){const node=workflow.nodes.find(value=>value.name===name);if(!node)throw new Error('The selected node no longer exists');selectedName=name;nodeName.value=node.name;position.value=JSON.stringify(node.position);parameters.value=JSON.stringify(node.parameters,null,2);nodeInfo.textContent=`${node.type} · version ${node.typeVersion}`;}
 function refreshPicker(){picker.replaceChildren(el('option','Choose a saved native workflow',{value:''}));for(const record of available)picker.append(el('option',`${record.name} · revision ${record.revision}`,{value:record.id}));picker.value=recordId;}
 function ports(node,input=false){if(input)return node?.type==='n8n-nodes-base.merge'?Math.min(10,Math.max(2,Number(node.parameters.numberInputs)||2)):1;if(node?.type==='n8n-nodes-base.if')return 2;if(node?.type==='n8n-nodes-base.switch')return node.parameters.mode==='expression'?Math.min(100,Math.max(1,Number(node.parameters.numberOutputs)||4)):Math.min(100,Math.max(1,(node.parameters.rules?.values?.length??0)+(node.parameters.options?.fallbackOutput==='extra'?1:0)));return 1;}
 function refreshPorts(){for(const[select,node,input]of[[port,workflow.nodes.find(node=>node.name===from.value),false],[inputPort,workflow.nodes.find(node=>node.name===to.value),true]]){const previous=select.value;select.replaceChildren();for(let index=0;index<ports(node,input);index++)select.append(el('option',(input?'Input ':'Output ')+index,{value:String(index)}));select.value=previous!==''&&Number(previous)<ports(node,input)?previous:'0';}}
 from.addEventListener('change',refreshPorts);to.addEventListener('change',refreshPorts);
 function redraw(){const priorFrom=from.value,priorTo=to.value;name.value=workflow.name;documentJSON.value=JSON.stringify(workflow,null,2);from.replaceChildren();to.replaceChildren();for(const node of workflow.nodes)for(const select of[from,to])select.append(el('option',node.name,{value:node.name}));if(selectedName&&!workflow.nodes.some(node=>node.name===selectedName)){selectedName='';nodeInfo.textContent='Choose a node in the diagram';nodeName.value='';position.value='';parameters.value='{}';}
  if(workflow.nodes.some(node=>node.name===priorFrom))from.value=priorFrom;if(workflow.nodes.some(node=>node.name===priorTo))to.value=priorTo;refreshPorts();
  const height=Math.max(125,Math.ceil(workflow.nodes.length/5)*135),drawing=svg('svg',{viewBox:`0 0 1120 ${height}`,width:1120,height,role:'img','aria-label':'Native workflow nodes and main connections'}),locations=new Map(workflow.nodes.map((node,index)=>[node.name,{x:15+(index%5)*220,y:15+Math.floor(index/5)*135}]));
  for(const[source,connections]of Object.entries(workflow.connections??{}))for(const[index,targets]of(connections.main??[]).entries())for(const target of targets){const a=locations.get(source),b=locations.get(target.node);if(!a||!b)continue;drawing.append(svg('path',{d:`M${a.x+195},${a.y+40} C${a.x+215},${a.y+40} ${b.x-20},${b.y+40} ${b.x},${b.y+40}`,fill:'none',stroke:index===1?'#b45309':'#64748b','stroke-width':2}));const label=svg('text',{x:a.x+195,y:a.y+35,'font-size':10});label.textContent=`${index} → input ${target.index}`;drawing.append(label);}
  for(const node of workflow.nodes){const{x,y}=locations.get(node.name),group=svg('g',{role:'button',tabindex:0,'aria-label':`Edit ${node.name}`}),rectangle=svg('rect',{x,y,width:195,height:80,rx:8,fill:'#f8fafc',stroke:selectedName===node.name?'#2563eb':'#cbd5e1'}),title=svg('text',{x:x+10,y:y+25,'font-size':13,fill:'#0f172a'}),type=svg('text',{x:x+10,y:y+48,'font-size':10,fill:'#475569'}),version=svg('text',{x:x+10,y:y+66,'font-size':10,fill:'#475569'});title.textContent=node.name.length>23?`${node.name.slice(0,22)}…`:node.name;type.textContent=node.type.replace('n8n-nodes-base.','').slice(0,29);version.textContent=`Version ${node.typeVersion}`;group.append(rectangle,title,type,version);const edit=()=>attempt(async()=>{selectNode(node.name);redraw();mark('Editing node · save to retain changes');});group.addEventListener('click',edit);group.addEventListener('keydown',event=>{if(event.key==='Enter'||event.key===' '){event.preventDefault();edit();}});drawing.append(group);}diagram.replaceChildren(el('h3','Workflow diagram'),drawing);
  issues.textContent=check?check.executable?'Supported graph · ready to run':check.issues.map(issue=>`${issue.node??'Workflow'}: ${issue.message}`).join('\n'):'Check the graph before running';
 }
 async function validate(){check=await api('native-validate',{workflow});redraw();return check;}
 async function showHistory(){const id=recordId;history.replaceChildren(el('h3','Native execution history'));if(!id){history.append(el('p','Save to retain executions.'));return;}const{runs}=await api('native-history',{id});if(recordId!==id)return;for(const run of [...runs].reverse()){history.append(button(`${run.startedAt} · ${run.status} · revision ${run.revision}`,()=>attempt(()=>monitor({id:run.workflowId,runId:run.id}))));}}
 async function monitor(identity){const generation=++pollGeneration;activeRun=identity;runButton.disabled=true;cancelButton.disabled=false;try{let current;do{current=(await api('native-status',identity)).run;if(generation!==pollGeneration||!root.isConnected)return;result.textContent=JSON.stringify(current,null,2);mark(current.status==='waiting'?`Waiting until ${current.waitUntil} · continuation saved`:current.status==='failed'?`${current.status}: ${current.error?.message??'Execution failed'}`:`Execution ${current.status}`);if(['ready','running','waiting'].includes(current.status))await new Promise(done=>setTimeout(done,250));}while(['ready','running','waiting'].includes(current.status));await showHistory();}finally{if(generation===pollGeneration){activeRun=null;runButton.disabled=false;cancelButton.disabled=true;}}}
 picker.addEventListener('change',()=>attempt(async()=>{const selected=picker.value;if(!selected)return;const response=await api('native-get',{id:selected});if(picker.value!==selected)return;workflow=response.record.workflow;recordId=response.record.id;revision=response.record.revision;selectedName='';check=response.preflight;redraw();await showHistory();mark(`Loaded revision ${revision}`);}));
 name.addEventListener('input',()=>{workflow.name=name.value;documentJSON.value=JSON.stringify(workflow,null,2);check=null;});
 const save=()=>attempt(async()=>{const currentId=recordId,currentRevision=revision,document=structuredClone(workflow);const response=await api('native-save',{id:currentId||undefined,expectedRevision:currentId?currentRevision:undefined,workflow:document});if(recordId!==currentId||revision!==currentRevision||JSON.stringify(workflow)!==JSON.stringify(document)){available=(await api('native-list')).workflows;refreshPicker();mark('Captured document saved; editor changed during saving. Reload the saved version to edit it.');return;}recordId=response.record.id;revision=response.record.revision;workflow=response.record.workflow;check=response.preflight;available=(await api('native-list')).workflows;refreshPicker();redraw();await showHistory();mark(`Saved revision ${revision}`);});
 actions.append(picker,button('New routing example',()=>{workflow=nativeRoutingExample();recordId='';revision=0;selectedName='';check=null;refreshPicker();redraw();history.replaceChildren();mark('New routing example · unsaved');}),button('New native example',()=>{workflow=nativeExample();recordId='';revision=0;selectedName='';check=null;refreshPicker();redraw();history.replaceChildren();mark('New example · unsaved');}),button('Save native workflow',save),button('Check supported graph',()=>attempt(async()=>{const checked=await validate();mark(checked.executable?'Supported graph':'Execution unavailable · review the listed issues');})));
 author.append(el('h3','Edit a native node'),nodeInfo,field('Node name',nodeName),field('Saved position [x, y]',position),field('Native parameters JSON',parameters),button('Apply node changes',()=>attempt(async()=>{const index=workflow.nodes.findIndex(node=>node.name===selectedName);if(index<0)throw new Error('Choose a current node in the diagram first');const nextName=nodeName.value;if(workflow.nodes.some((node,i)=>i!==index&&node.name===nextName))throw new Error('Node names must be unique');const draft=structuredClone(workflow),oldName=selectedName;draft.nodes[index]={...draft.nodes[index],name:nextName,position:readJSON(position.value),parameters:readJSON(parameters.value)};if(nextName!==oldName){const connections=Object.fromEntries(Object.entries(draft.connections??{}).map(([source,types])=>[source===oldName?nextName:source,Object.fromEntries(Object.entries(types).map(([type,outputs])=>[type,outputs.map(targets=>targets.map(target=>({...target,node:target.node===oldName?nextName:target.node})))]))]));draft.connections=connections;}const checked=await api('native-validate',{workflow:draft});workflow=draft;selectedName=nextName;check=checked;redraw();mark('Node updated · unsaved');})),field('Add node type',kind),button('Add native node',()=>attempt(async()=>{const defaults={switch:{mode:'expression',numberOutputs:2,output:0,options:{}},merge:{mode:'append',numberInputs:2,options:{}},set:{assignments:{assignments:[]},options:{}},if:{conditions:{options:{caseSensitive:true,typeValidation:'strict',version:3},conditions:[],combinator:'and'},options:{}},wait:{resume:'timeInterval',amount:1,unit:'seconds'},httpRequest:{authentication:'none',method:'GET',url:new URL('/api/health',location.origin).href,options:{timeout:10000}}};let name=`${kind.value} ${workflow.nodes.length+1}`;while(workflow.nodes.some(node=>node.name===name))name+=' new';const draft=structuredClone(workflow);draft.nodes.push({id:crypto.randomUUID(),name,type:`n8n-nodes-base.${kind.value}`,typeVersion:{set:3.4,if:2.3,wait:1.1,httpRequest:4.4,switch:3.4,merge:3.2}[kind.value],position:[0,0],parameters:defaults[kind.value]});check=await api('native-validate',{workflow:draft});workflow=draft;selectNode(name);redraw();mark('Node added · connect it and save');})),field('Connect from',from),field('Connect to',to),field('Output',port),field('Target input',inputPort),button('Add native connection',()=>attempt(async()=>{const draft=structuredClone(workflow),source=draft.nodes.find(node=>node.name===from.value);if(!source||!draft.nodes.some(node=>node.name===to.value))throw new Error('Choose two current nodes');const output=Number(port.value),input=Number(inputPort.value),destination=draft.nodes.find(node=>node.name===to.value);if(!Number.isInteger(output)||output<0||output>=ports(source)||!Number.isInteger(input)||input<0||input>=ports(destination,true))throw new Error('Choose current output and input ports');draft.connections??={};const types=Object.hasOwn(draft.connections,source.name)?draft.connections[source.name]:{};Object.defineProperty(draft.connections,source.name,{value:types,enumerable:true,writable:true,configurable:true});types.main??=[];while(types.main.length<=output)types.main.push([]);if(!types.main[output].some(target=>target.node===to.value&&target.index===input&&target.type==='main'))types.main[output].push({node:to.value,type:'main',index:input});check=await api('native-validate',{workflow:draft});workflow=draft;redraw();mark('Connection added · unsaved');})),button('Remove native connection',()=>attempt(async()=>{const draft=structuredClone(workflow),targets=draft.connections?.[from.value]?.main?.[Number(port.value)];if(!targets)throw new Error('Connection does not exist');draft.connections[from.value].main[Number(port.value)]=targets.filter(target=>!(target.node===to.value&&target.index===Number(inputPort.value)&&target.type==='main'));check=await api('native-validate',{workflow:draft});workflow=draft;redraw();mark('Connection removed · unsaved');})));
 const file=el('input',undefined,{type:'file',accept:'.json,application/json'});file.addEventListener('change',()=>attempt(async()=>{const selected=file.files?.[0];if(!selected)return;if(selected.size>byteLimit)throw new Error('Workflow JSON exceeds 2 MiB');documentJSON.value=await selected.text();mark('File loaded into JSON editor · apply to import');}));
 const jsonEditor=el('details');jsonEditor.append(el('summary','Native workflow JSON · import and export'),file,documentJSON,button('Apply native JSON',()=>attempt(async()=>{const document=readJSON(documentJSON.value),checked=await api('native-validate',{workflow:document});workflow=checked.workflow;recordId='';revision=0;selectedName='';check=checked;refreshPicker();redraw();history.replaceChildren();mark('Imported · unknown fields preserved · save as a new native workflow');})),button('Download native JSON',()=>{const url=URL.createObjectURL(new Blob([JSON.stringify(workflow,null,2)],{type:'application/json'})),link=el('a','',{href:url,download:'native-n8n-workflow.json'});link.click();setTimeout(()=>URL.revokeObjectURL(url),500);}));
 const runButton=button('Run saved native revision',()=>attempt(async()=>{if(!recordId)throw new Error('Save the native workflow first');if(activeRun)throw new Error('An execution is already being monitored');const id=recordId,{run}=await api('native-start',{id});await monitor({id,runId:run.id});})),cancelButton=button('Cancel native execution',()=>attempt(async()=>{if(!activeRun)throw new Error('No native execution is being monitored');const identity={...activeRun};await api('native-cancel',identity);mark('Cancellation recorded');}));cancelButton.disabled=true;
 const execution=el('div',undefined,{className:'card'});execution.append(el('h3','Run native workflow'),el('p','Runs use the saved revision, beginning with one empty item from Manual Trigger. Wait saves a continuation for up to 60 seconds; after a host restart, opening this panel starts due waits again. Interrupted HTTP operations are recorded and are not automatically replayed. History hides sensitive field names and observed secret strings; unfinished continuation files retain working data locally.',{className:'muted'}),runButton,cancelButton,result);
 root.append(heading,intro,status,actions,field('Native workflow name',name),diagram,issues,author,jsonEditor,execution,history);available=(await api('native-list')).workflows;refreshPicker();redraw();await showHistory();
}
