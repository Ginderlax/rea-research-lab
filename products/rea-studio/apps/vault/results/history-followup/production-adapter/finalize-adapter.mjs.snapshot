import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
const root=import.meta.dirname,sha=b=>createHash('sha256').update(b).digest('hex'),read=n=>fs.readFile(path.join(root,n)),bind=async n=>{const b=await read(n);return{path:n,bytes:b.length,sha256:sha(b)}};const runs=await fs.readdir(path.join(root,'runs'));assert.equal(runs.length,1);const run='runs/'+runs[0],receipt=JSON.parse(await read(run+'/validation.json'));assert.deepEqual(receipt.counts,{tests:41,pass:41,fail:0,skipped:0,cancelled:0});assert.deepEqual(receipt.additionalIndependentProbeCounts,{tests:11,pass:11,fail:0,skipped:0,cancelled:0});assert.equal(receipt.sourceStable,true);for(const e of receipt.sourceBefore)assert.equal(sha(await read(e.path)),e.sha256,'Tested source changed '+e.path);
const final={schema:'rea-vault-production-adapter-final/v1',completed:new Date().toISOString(),status:'FROZEN_ADAPTER_ONLY',productionEdited:false,focused:await bind(run+'/validation.json'),counts:receipt.counts,additionalProbeCounts:receipt.additionalIndependentProbeCounts,sourceStable:true,runtimeByteIdentical:true,runtime:JSON.parse(await read('adaptations.json')).runtime,sourceFingerprints:receipt.sourceBefore,externalFingerprints:receipt.externalBefore,preservation:receipt.preservation,originalAccounting:receipt.originalAccounting,candidateAccounting:receipt.candidateAccounting,routes:receipt.routes,adaptations:receipt.adaptations,independentProbePathAdapters:receipt.independentProvenance.adaptations,old18CompatibilityReceiptSha256:receipt.old18CompatibilityReceiptSha256,oldCompatibilityRebound:false,normalTestsWriteAppResults:false,applicationImportsOriginalRuntime:false,sourceOnlyPathsPrivate:true,independentBrowserReviewPreservedSeparatelyAfterItsFreeze:true,fullProductParity:false,securityParity:false,superiority:false};await fs.writeFile(path.join(root,'adapter-validation.json'),JSON.stringify(final,null,2)+'\n',{flag:'wx'});
const files=[];async function walk(relative=''){for(const e of await fs.readdir(path.join(root,relative),{withFileTypes:true})){const n=relative?relative+'/'+e.name:e.name;if(['adapter-manifest.json','adapter-freeze.json'].includes(n)||n==='.local/vault-history-fixtures'||n==='.local/independent-observations'||n==='independent-probes/.local')continue;if(e.isDirectory())await walk(n);else if(e.isFile())files.push(await bind(n));else throw new Error('Unexpected link '+n);}}await walk();files.sort((a,b)=>a.path.localeCompare(b.path,'en'));await fs.writeFile(path.join(root,'adapter-manifest.json'),JSON.stringify({schema:'rea-vault-production-adapter-strict-manifest/v1',count:files.length,files,excludedMutableDirectories:['.local/vault-history-fixtures','.local/independent-observations','independent-probes/.local'],metadataExclusions:['adapter-manifest.json','adapter-freeze.json'],strictInventory:true},null,2)+'\n',{flag:'wx'});const freeze={schema:'rea-vault-production-adapter-freeze/v1',frozenAt:new Date().toISOString(),count:files.length,receipt:await bind('adapter-validation.json'),manifest:await bind('adapter-manifest.json'),runtimeByteIdentical:true,allExecutableTestDocAndEvidenceFilesFrozen:true,productionEdited:false};await fs.writeFile(path.join(root,'adapter-freeze.json'),JSON.stringify(freeze,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(freeze));
