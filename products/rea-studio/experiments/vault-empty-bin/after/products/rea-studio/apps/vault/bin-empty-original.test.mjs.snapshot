}
test('actual released empty-bin nested/direct and disabled-bin library contracts agree', async t => { for (const disabled of [false, true]) await original(t, disabled ? 'disabled-existing-bin' : 'nested-direct-bin', fixture(disabled)); });
test('actual released empty-bin save/reopen and fresh empty-bin no-op remain exact', async t => { await original(t, 'native-save-reopen', fixture(), { save: true }); await original(t, 'already-empty-bin', fixture(false, true)); });
