def common_attempt(bundle,receipt,after,expected_auth):
 attempt=load('new-todo-'+ROLE+'-attempt.json');assert attempt['schema']=='rea-Notes-new-todo-'+ROLE+'-attempt/v1'and attempt['status']=='passed'and attempt['phase']==ROLE and attempt['role']==ROLE and attempt['execution']==execution and attempt['sourceCommit']==HEAD
 assert attempt['sourceOverlay']is True and attempt['productionInstalled']is False and attempt['historicalReceiptsRebound']is False and attempt['sourceStable']is True and attempt['applicationSourcesChanged']is False
 assert attempt['exactTargets']==7 and attempt['eligibleTargets']==6 and attempt['composedNotesFiles']==36 and attempt['composition']==identity(content('notes-new-todo-composition.json'))
 for k in('originalFullApplicationExecutions','originalDatabaseExecutions','originalGuiExecutions'):assert attempt[k]==0
 assert attempt['sourceFiles']==len(after)and attempt['sourceCapturedBeforeExecution']is True and attempt['notesSourceAuthentication']==expected_auth and attempt['sourceAuthentication']==expected_auth
 assert load('new-todo-'+ROLE+'-source-before.json')==load('new-todo-'+ROLE+'-source-after.json')==after
 t=attempt['tooling'];assert t['readFiles']==12 and t['fileLimit']==12 and t['byteLimit']==8388608 and len(t['paths'])==12 and len(mapping(t['paths']))==12
 collector=content('active-source/scripts/verify-notes-new-todo-cloud.mjs.snapshot').decode();literal=re.findall(r"source\('([^']+)',(\d+),'([0-9a-f]{64})'\)",collector);assert len(literal)==11
 expected_tooling={name:{'bytes':int(n),'sha256':digest}for name,n,digest in literal};expected_tooling[COMPOSER]=PINS[COMPOSER];assert mapping(t['paths'])==expected_tooling
 for name,p in expected_tooling.items():data=content('tooling-source/'+name+'.snapshot');assert identity(data)==p;gitbound(name,data)
 assert t['readBytes']==sum(r['bytes']for r in t['paths'])and t['readBytes']<=8388608 and t['selfSource']=={'path':COLLECTOR,**PINS[COLLECTOR],'GitBound':True}
 assert len(attempt['children'])==1;child=attempt['children'][0];assert child['exitCode']==0 and child['signal']is None and child['closeObserved']is True and child['spawnError']is None and child['stopReason']is None and child['droppedOutputBytes']==0
 assert child['stdoutBytes']==len(content(ROLE+'-stdout.txt'))and child['stderrBytes']==len(content(ROLE+'-stderr.txt'))
 events=[json.loads(line)for line in content(ROLE+'-events.jsonl').decode().splitlines()];assert events and [r['sequence']for r in events]==list(range(1,len(events)+1))and events[0]['kind']=='child-started'and events[-1]['kind']=='child-closed'
 workflow=load('new-todo-workflow-attempt.json');assert workflow['schema']=='rea-Notes-new-todo-experiment-workflow-attempt/v1'and workflow['role']==ROLE and workflow['sourceCommit']==HEAD and workflow['runId']==RUN and workflow['runAttempt']=='1'and workflow['runnerEnvironment']=='github-hosted'
 for k in('checkoutOutcome','sourceBeforeOutcome','verificationOutcome','sourceAfterOutcome'):assert workflow[k]=='success'
 assert workflow['sourceOverlay']is True and workflow['exactOverlayTargets']==7 and workflow['composedNotesFiles']==36 and workflow['productionInstallationPerformedByWorkflow']is False and workflow['historicalReceiptsRebound']is False
 if ROLE=='browser':assert workflow['acquisitionOutcome']=='success'and workflow['browserPostcheckOutcome']=='success'
 return attempt
def finite_results(bundle,attempt):
 raw=content('finite-stdout.txt').decode();summary={}
 for key in('tests','pass','fail','cancelled','skipped','todo'):
  rows=re.findall(r'^# '+key+r' (\d+)\r?$',raw,re.M);assert len(rows)==1;summary[key]=int(rows[0])
 assert summary=={'tests':111,'pass':111,'fail':0,'cancelled':0,'skipped':0,'todo':0}and attempt['productTests']==111
