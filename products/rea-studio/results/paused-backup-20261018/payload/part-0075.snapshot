    {
      "id": "grafana.candidate.b29b8ae7d4eaa49a41cd",
      "syntaxRole": "list-item",
      "sourceText": "- **Staged promotion**: You develop in a sandbox, then promote finished work to the `main` branch.",
      "headingPath": [
