        assert identity(content(filename)) == pin(row)
    assert attempt['notesVerifierSource'] == {'path': 'products/rea-studio/scripts/verify-notes-todo-browser-cloud.mjs',
        'bytes': 20439, 'sha256': '3afc8bb1ca5b496454c1cae10181e9b32466b39fd8ec0a908320c41ad6a027f0'}
    fixed_browser_sources = {
        'notes-browser-bundle.json.snapshot': {'bytes': 3113, 'sha256': '5153f72e1ee05c6974c8da5f274038914e4ab5f1dbeb884b4fe79706f5e25a1c'},
        'source/scripts/verify-cloud-browser.mjs.snapshot': {'bytes': 42730, 'sha256': 'c53ae435a68fb5aeda447375115207aeee2774320581426754cdce4f3d5e0c99'},
        'source/browser-tests/notes-todo.spec.mjs.snapshot': {'bytes': 35386, 'sha256': '4f7c8b377f5636c239ccceb0bf253632968c50ea18d13175de9a41298a65a58e'},
        'source/browser-tests/playwright.notes-todo.config.mjs.snapshot': {'bytes': 1087, 'sha256': '0a6152b28ef986e92029f2f80aa231c17d175041ba592a2ec6450320aaa0ae48'},
        'source/browser-tests/notes-todo-roster.json.snapshot': {'bytes': 852, 'sha256': '299be61b3c65c6d162640087fe5e00e03b1a1dee99b59e05843476fb965d42e4'},
