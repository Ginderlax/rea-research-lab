import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const root=import.meta.dirname,workspace=path.resolve(root,'../..'),source=path.join(workspace,'work/editor-search-pattern-next/collect-focused.mjs'),before=await fs.readFile(source),text=before.toString(),changes=[{before:"'search-pattern.integration.test.mjs'];",after:"'search-pattern.integration.test.mjs','textarea-navigation.ui.test.mjs'];"},{before:"path.join(root,'production-before.json')",after:"path.join(root,'history/author573/production-before.json.snapshot')"},{before:'new pattern tests only',after:'new pattern and native-normalizing textarea-model tests only'}];let next=text;for(const c of changes){assert.equal(next.split(c.before).length,2);next=next.replace(c.before,c.after);}const after=Buffer.from(next);await fs.writeFile(path.join(root,'collect-focused.mjs'),after,{flag:'wx'});await fs.writeFile(path.join(root,'focused-collector-adapter.json'),JSON.stringify({oldAuthorCollectorSHA256:createHash('sha256').update(before).digest('hex'),newCorrectionCollectorSHA256:createHash('sha256').update(after).digest('hex'),changes,appCodeModifiedByCollector:false,originalBodiesNotSilentlyRewritten:true},null,2)+'\n',{flag:'wx'});
