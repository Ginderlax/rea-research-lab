    },
    {
      "id": "grafana.candidate.a07da513711c21aa6284",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The OpenTSDB data source supports query-type template variables that fetch values directly from OpenTSDB. These variables dynamically populate based on data in your OpenTSDB database.",
      "headingPath": [
        "OpenTSDB template variables",
        "Query variable"
      ],
