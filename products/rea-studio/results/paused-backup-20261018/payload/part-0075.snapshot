      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.4b7b9bef04e5f0321431",
      "syntaxRole": "table-row",
      "sourceText": "| `value_hash`  | Computed                  | Read-only SHA-256 hash of the stored value. The provider uses it to detect rotation. Don't set it yourself.                                                                                                                                                                                            |",
      "headingPath": [
        "Use Terraform to provision secure values",
        "Define a secure value",
        "Schema reference"
      ],
