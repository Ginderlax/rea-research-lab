    {
      "id": "grafana.candidate.fdd154ef2ce3ba828671",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "An [alert rule](ref:alert-rules) consists of one or more queries and expressions that select the data you want to measure. It also contains a condition, which is the threshold that an alert rule must meet or exceed to fire.",
      "headingPath": [
        "Introduction to Grafana Alerting",
        "Fundamentals",
        "Alert rules"
      ],
      "source": {
