    {
      "id": "grafana.candidate.8eed28de35c11fc5d820",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now use the new variable `$__rate_interval` in Prometheus for rate functions mainly. `$__rate_interval` in general is one scrape interval larger than `$__interval` but is never smaller than four times the scrape interval (which is 15s by default). See the [Prometheus data source](../../datasources/prometheus/#using-__rate_interval-variable) for more details.",
      "headingPath": [
        "What's new in Grafana v7.2",
        "\\$\\_\\_rate_interval for Prometheus"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-2.md",
        "gitBlobSha": "b14fe6b9f0ce989975bd191eded6a4b1402c46e6",
        "sha256": "468de39518e517dcb959966b9f0e9a4dbbe8183a20ebc586d1f5bbb1b1a21f79",
