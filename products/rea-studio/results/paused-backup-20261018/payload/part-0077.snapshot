    },
    {
      "id": "grafana.candidate.d059563e6631aaeb94dc",
      "syntaxRole": "list-item",
      "sourceText": "- **SSO**: Properly setting up Grafana with your current IAM solution enables users to access Grafana with the same credentials they use for other applications.",
      "headingPath": [
        "Plan your IAM integration strategy",
        "Benefits of integrating with an IAM provider"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/_index.md",
        "gitBlobSha": "63f14286dc00550c860501a81f311188c9f26bde",
        "sha256": "b225f8d5068b6e330e18c0916c7295be963d055af907c0790708a7bbd383b7af",
        "lineStart": 28,
        "lineEnd": 28,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/_index.md#L28-L28"
      },
      "applicability": {
        "status": "unresolved-no-explicit-oss-products-label",
        "products": []
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
