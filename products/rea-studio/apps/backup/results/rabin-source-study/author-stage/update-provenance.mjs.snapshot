import {readFile,writeFile} from 'node:fs/promises';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const file=new URL('source-provenance.json',import.meta.url),record=JSON.parse(await readFile(file)),hash=bytes=>createHash('sha256').update(bytes).digest('hex'),go=await readFile(new URL('references/restic-go.mod',import.meta.url)),compressionReceiptBytes=await readFile(new URL('../backup-compression-next/draft-validation.json',import.meta.url)),compression=JSON.parse(compressionReceiptBytes);assert.match(go.toString('utf8'),/github\.com\/restic\/chunker v0\.4\.0/);assert.equal(hash(go),'d166913ed4897cf69069ef5be090b2d79a857fc28328bb950e12655b5a54f176');
record.resticDependencyBinding={url:'https://raw.githubusercontent.com/restic/restic/6aa3a516ce654808a1f28f9fa21e9b7c8e6e90bf/go.mod',path:'references/restic-go.mod',bytes:go.length,sha256:hash(go),module:'github.com/restic/chunker',version:'v0.4.0',retrievedAtUtc:new Date().toISOString()};record.compressionStageBase={schema:compression.schema,receiptSha256:hash(compressionReceiptBytes),baseSourceFingerprints:compression.fingerprints,scope:'Staged native compression writer is copied locally. Only restic.mjs file capture/chunking description are adapted; root compression stage is unchanged.'};record.retainedCompressionReferences=await Promise.all(['references/restic-repository.go','references/RESTIC-LICENSE.txt'].map(async path=>{const bytes=await readFile(new URL(path,import.meta.url));return{path,bytes:bytes.length,sha256:hash(bytes)};}));record.originalRuntimeWrapper=false;record.productionIntegrated=false;record.fullFeatureParity=false;record.universalSuperiority=false;await writeFile(file,JSON.stringify(record,null,2)+'\n');
