const manifest={schema:'rea-Notes-new-todo-R5-cloud-pass-preservation/v1',createdAtUtc:new Date().toISOString(),status:'passed-fixed-experimental-source-contracts',runId:run,runAttempt:1,sourceCommit:commit,testedGitCommit:commit,runURL:'https://github.com/Ginderlax/rea-research-lab/actions/runs/'+run,executionEnvironment:'github-hosted',runnerLabel:'windows-2022',node:'v24.16.0',runConclusion:'success',jobs,sourceMode:'experimental-seven-target-Notes-composition',sourceOverlay:true,productionInstalled:false,sourceOverlayTargets:7,eligibleOverlayTargets:6,baselineNotesFiles:32,composedNotesFiles:36,sourceCensusFiles:393,allOtherEligibleGitBlobs:387,sourceStable:true,alwaysComposerPostchecksPassed:2,separateBrowserPostcheckPassed:true,finite111Acceptance:true,realBrowser8Acceptance:true,countsAggregatedAcrossJobs:false,separateOriginalComparisonCounts:bundle.separateComparisonCounts,originalComparisonQualification:'Only the pinned released Joplin helper bodies and delegated desktop command arguments are compared. Existing20 conversion/completion comparisons,4 parent/type comparisons and2 delegated command-argument comparisons are separate observations, never added to111. New-note persistence, original provisional save, database, desktop GUI and original full application are not executed. Candidate-only defaults, API/error handling, revisions and browser workflows do not establish full original-product parity.',clockAttribution:'All raw original-helper clock values, raw child events and job/attempt times are preserved unchanged. The1790000000123 value belongs to the existing fixed original-helper comparison observation, not elapsed performance or an actual execution date. This new89e run does not rebind the b635 failed attempt or historical installed92/8 receipts.',originalFullApplicationExecutions:0,originalDatabaseExecutions:0,originalGuiExecutions:0,completeReadableLocalBackupVerified:true,readableUploadedFiles:1108,completePublicHostedArtifactZips:2,everyUploadedF