import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import{createHash}from'node:crypto';
const work=import.meta.dirname,own=path.join(work,'flow-vault-proof-transition-next'),lab=path.resolve(work,'../outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)});
const source=await fs.readFile(path.join(lab,'products/rea-studio/results/editor-vault-combined-20261013/source-before.json.snapshot')),before=JSON.parse(source);assert.equal(before.length,737);assert.equal(sha(source),'8d2f8ca7414ed9db51d2980264da3daa660adef30ceedbc6c2a4c2b493bb97d1');
for(const r of before)assert.deepEqual(id(await fs.readFile(path.join(lab,'products/rea-studio',r.path))),{bytes:r.bytes,sha256:r.sha256});
await fs.writeFile(path.join(own,'freezer.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});
await fs.writeFile(path.join(own,'freeze-validation.json'),JSON.stringify({sourceOnly:true,priorCurrentApplicationSourcesAuthenticated:737,priorSourcesStable:true,currentDevelopmentUnchanged:true,development: id(await fs.readFile(path.join(lab,'products/rea-studio/results/development-validation.json'))),publicAndProductionWrites:0,originalBrowserApplicationExecutions:0},null,2)+'\n',{flag:'wx'});
const inventory=[];async function walk(p=''){for(const e of(await fs.readdir(path.join(own,p),{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const n=p?p+'/'+e.name:e.name;assert(!e.isSymbolicLink());if(e.isDirectory())await walk(n);else{assert(e.isFile());const b=await fs.readFile(path.join(own,n));inventory.push({path:n,...id(b)});}}}await walk();
const b=Buffer.from(JSON.stringify({schema:'rea-flow-vault-proof-transition-strict-freeze/v1',at:new Date().toISOString(),strict:true,inventory,files:inventory.length,sourceOnly:true,productionWrites:0,independentReviewRequired:true,applicationOriginalBrowserBenchmarkExecutions:0},null,2)+'\n');await fs.writeFile(path.join(own,'manifest.json'),b,{flag:'wx'});console.log(JSON.stringify({files:inventory.length,manifestSHA256:sha(b)}));
