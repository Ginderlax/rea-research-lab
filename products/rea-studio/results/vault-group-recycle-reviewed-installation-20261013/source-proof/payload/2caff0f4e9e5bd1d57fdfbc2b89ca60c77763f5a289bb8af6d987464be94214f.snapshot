import test from 'node:test';import assert from 'node:assert/strict';import {randomBytes} from 'node:crypto';
import {recycleGroupView,recycleGroupRead,deleteRecycleGroup,restoreRecycleGroup,recycleView} from './recycle.mjs';
import {materializeKdbxDocument,decodeKdbxDate,encodeKdbxDate} from './kdbx.mjs';import {nodes,one,text,put,element,serializeXml} from './xml.mjs';
import {fixture,edit,ids,now,restoreNow,old,uuid64,findGroup,selection} from './group-fixture.mjs';
const options={confirm:true,now,binId:ids.bin};
function remove(data,key,id=ids.target,extra={}){const g=selection(data,key,id,extra.bin??false);return deleteRecycleGroup(data,id,g.recycleRevision,key,{...options,...extra});}
test('recursive group recycle/restore keeps exact descendants, UUID/history/unknown XML and does not touch descendants',()=>{const key=randomBytes(32),data=fixture(),before=JSON.stringify(data),xml=materializeKdbxDocument(data),sub=serializeXml(findGroup(xml,ids.deep)),e=serializeXml(nodes(findGroup(xml,ids.target),'Entry')[0]),result=remove(data,key);assert.equal(JSON.stringify(data),before);assert.equal(result.result.groupCount,2);assert.equal(result.result.entryCount,2);assert.deepEqual(result.result.affectedEntryIds,[ids.a,ids.b]);assert.equal(recycleView(result.data,key).entries.length,1);const after=materializeKdbxDocument(result.data),g=findGroup(after,ids.target);assert.equal(serializeXml(findGroup(after,ids.deep)),sub);assert.equal(serializeXml(nodes(g,'Entry')[0]),e);assert.equal(text(one(g,'PreviousParentGroup')),uuid64(ids.parent));assert.equal(text(one(one(g,'Times'),'UsageCount')),'6');assert.equal(text(one(one(findGroup(after,ids.bin),'Times'),'UsageCount')),'1');assert.equal(text(one(one(findGroup(after,ids.root),'Times'),'UsageCount')),'6');assert.equal(text(one(one(findGroup(after,ids.parent),'Times'),'UsageCount')),'5');assert.equal(decodeKdbxDate(text(one(one(g,'Times'),'LastModificationTime'))),old.replace('Z','.000Z'));const selected=selection(result.data,key,ids.target,true),restored=restoreRecycleGroup(result.data,ids.target,selected.recycleRevision,key,{confirm:true,now:restoreNow}),restoredXml=materializeKdbxDocument(restored.data);assert.equal(recycleView(restored.data,key).entries.length,3);assert.equal(text(one(findGroup(restoredXml,ids.target),'PreviousParentGroup')),uuid64(ids.bin));assert.equal(text(one(one(findGroup(restoredXml,ids.target),'Times'),'UsageCount')),'6');assert.equal(serializeXml(findGroup(restoredXml,ids.deep)),sub);});
test('group preview is UUID-bound, finite, copy-owned and excludes all passwords/history payloads',()=>{const key=randomBytes(32),data=fixture(),g=selection(data,key),r=recycleGroupRead(data,g.id,g.recycleRevision,key);assert.equal(r.group.descendantGroups.length,2);assert.equal(r.group.entries.length,2);assert(!JSON.stringify(r).includes('only synthetic secret'));assert(!JSON.stringify(r).includes('Unknown.Entry'));r.group.entries[0].title='mutated';assert.equal(data.entries[0].title,'A');assert.throws(()=>recycleGroupRead(data,g.id,g.recycleRevision,randomBytes(32)),/selection changed/);});
test('purge adds native tombstones in released entry-first/postorder/group-last sequence',()=>{const key=randomBytes(32),data=fixture(),result=remove(data,key,ids.target,{permanent:true}),deleted=nodes(one(one(materializeKdbxDocument(result.data),'Root'),'DeletedObjects'),'DeletedObject');assert.deepEqual(deleted.map(d=>text(one(d,'UUID'))),[ids.a,ids.b,ids.deep,ids.target].map(uuid64));assert(deleted.every(d=>decodeKdbxDate(text(one(d,'DeletionTime')))===now.replace('Z','.000Z')));assert.equal(result.data.entries.length,1);assert.equal(result.result.permanent,true);});
test('root refusal and confirmations are transactional; disabled recycle permanently deletes',()=>{const key=randomBytes(32),data=fixture(),before=JSON.stringify(data),g=selection(data,key),root=selection(data,key,ids.root);assert.equal(root.canDelete,false);assert.throws(()=>deleteRecycleGroup(data,root.id,root.recycleRevision,key,options),/root group/);assert.throws(()=>deleteRecycleGroup(data,g.id,g.recycleRevision,key),/confirmation/);assert.throws(()=>deleteRecycleGroup(data,g.id,g.recycleRevision,key,{...options,permanent:'yes'}),/boolean/);assert.equal(JSON.stringify(data),before);const disabled=edit(data,x=>put(one(x,'Meta'),'RecycleBinEnabled','False'));assert.equal(remove(disabled,key).result.permanent,true);});
test('bin descendants, bin itself and ancestor containing the bin permanently delete; dangling bin UUID retained',()=>{const key=randomBytes(32),data=remove(fixture(),key).data;assert.equal(remove(data,key,ids.target,{bin:true}).result.permanent,true);const bin=remove(data,key,ids.bin,{bin:true});assert.equal(bin.data.entries.length,1);assert.equal(recycleGroupView(bin.data,key).hasBin,false);assert.equal(text(one(one(materializeKdbxDocument(bin.data),'Meta'),'RecycleBinUUID')),uuid64(ids.bin));const nested=edit(data,x=>{const root=findGroup(x,ids.root),parent=findGroup(x,ids.parent),bin=findGroup(x,ids.bin);root.children=root.children.filter(n=>n!==bin);parent.children.push(bin)});const parent=selection(nested,key,ids.parent);assert.equal(parent.deleteIsPermanent,true);assert.equal(remove(nested,key,ids.parent).result.permanent,true);});
test('previous-parent zero, missing, self, subtree, same parent and bin ancestry refuse without root fallback',()=>{const key=randomBytes(32),data=remove(fixture(),key).data;for(const id of ['00000000-0000-0000-0000-000000000000','eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee',ids.target,ids.deep,ids.bin]){const bad=edit(data,x=>put(findGroup(x,ids.target),'PreviousParentGroup',uuid64(id))),g=selection(bad,key,ids.target,true),before=JSON.stringify(bad);assert.equal(g.canRestorePreviousGroup,false);assert.throws(()=>restoreRecycleGroup(bad,g.id,g.recycleRevision,key,{confirm:true,now}),/previous parent/);assert.equal(JSON.stringify(bad),before);}const bin=selection(data,key,ids.bin,true);assert.throws(()=>restoreRecycleGroup(data,bin.id,bin.recycleRevision,key,{confirm:true,now}),/descendant group/);});
test('whole-graph tokens reject stale competing changes and entry tokens cannot authorize groups',()=>{const key=randomBytes(32),data=fixture(),g=selection(data,key),e=recycleView(data,key).entries[0],changed=edit(data,x=>put(findGroup(x,ids.other),'Notes','changed'));assert.throws(()=>deleteRecycleGroup(changed,g.id,g.recycleRevision,key,options),/selection changed/);assert.throws(()=>deleteRecycleGroup(data,g.id,e.recycleRevision,key,options),/selection changed/);assert.throws(()=>recycleGroupView(data,key,{bin:'true'}),/boolean/);});
test('tombstone overflow is rejected before altering any original subtree',()=>{const key=randomBytes(32),data=edit(fixture(),x=>{const deleted=one(one(x,'Root'),'DeletedObjects');for(let i=0;i<9997;i++)deleted.children.push(element('DeletedObject',[element('UUID',uuid64(ids.c)),element('DeletionTime',encodeKdbxDate(now))]))}),g=selection(data,key),before=JSON.stringify(data);assert.throws(()=>deleteRecycleGroup(data,g.id,g.recycleRevision,key,{...options,permanent:true}),/tombstone limit/);assert.equal(JSON.stringify(data),before);});
