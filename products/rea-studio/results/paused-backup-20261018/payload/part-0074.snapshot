    {
      "id": "grafana.candidate.c4a4814263637a4782b1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Mute timings are not inherited from a parent notification policy, and they have to be configured on each level. For instructions, refer to [Configure mute timings](ref:configure-mute-timings).",
      "headingPath": [
        "Configure notification policies",
        "Mute timings"
      ],
      "source": {
        "path": "docs/sources/alerting/configure-notifications/create-notification-policy.md",
