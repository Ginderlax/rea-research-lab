    {
      "id": "grafana.candidate.c95f8fc63604282fd7c5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This mode is ideal for advanced users who need full control over the SQL query or want to use features not available in visual query mode. It's especially useful for writing subqueries, using macros, or applying advanced filtering and formatting. You can switch back to visual mode, but note that some custom queries may not be fully compatible.",
      "headingPath": [
        "Microsoft SQL Server query editor",
        "Code mode"
      ],
      "source": {
