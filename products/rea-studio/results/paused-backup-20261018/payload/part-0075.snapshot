    {
      "id": "grafana.candidate.1e7514973839c21dd003",
      "syntaxRole": "procedural-step",
      "sourceText": "1. **Limit results**: Always use `take` or `limit` to restrict the number of annotations. Too many annotations can clutter your dashboard and impact performance.",
      "headingPath": [
        "Azure Monitor annotations",
        "Best practices"
      ],
      "source": {
