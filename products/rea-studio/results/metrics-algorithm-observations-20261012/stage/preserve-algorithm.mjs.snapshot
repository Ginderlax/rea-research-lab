import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),source=path.resolve(here,'../metrics-selector-algorithm-next'),sha=bytes=>createHash('sha256').update(bytes).digest('hex'),fp=async file=>{const bytes=await fs.readFile(file);return {bytes:bytes.length,sha256:sha(bytes)};};
const safe=name=>{const file=path.resolve(source,name),relative=path.relative(source,file);assert.ok(relative&&!path.isAbsolute(relative)&&relative!=='..'&&!relative.startsWith('..'+path.sep));return file;};
const manifestRecord=await fp(safe('freeze-manifest.json'));assert.equal(manifestRecord.sha256,'4ba611ee5cf9d9c1e8e6a8b210dae381f17e1e7f75820700c519067201c221dd');const manifest=JSON.parse(await fs.readFile(safe('freeze-manifest.json')));assert.equal(Object.keys(manifest.inventory).length,88);
const records={...manifest.inventory,'freeze-manifest.json':manifestRecord},copies=[],excluded=[];
for(const [name,record]of Object.entries(records)){assert.deepEqual(await fp(safe(name)),record);if(/\.(?:tgz|zip|exe)$/i.test(name)){excluded.push({path:name,...record,retainedLocal:true});continue;}const target=path.join(here,'preserved/full-algorithm-stage',name);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,await fs.readFile(safe(name)),{flag:'wx'});assert.deepEqual(await fp(target),record);copies.push({path:'preserved/full-algorithm-stage/'+name,sourcePath:name,...record});}
for(const [name,record]of Object.entries(records))assert.deepEqual(await fp(safe(name)),record);
const output={schema:'rea-metrics-full-algorithm-stage-preservation/v1',preparedAt:new Date().toISOString(),sourceStage:'../metrics-selector-algorithm-next',manifest:manifestRecord,frozenInventoryFiles:88,totalIncludingSelfExcludedManifest:89,copies,publicationExcludedLocalArchives:excluded,sourceBeforeAfterStable:true,preservedAsInertEvidence:true,candidateAccepted:false,measuredWorkloadsExecuted:0};await fs.writeFile(path.join(here,'full-algorithm-preservation.json'),JSON.stringify(output,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({manifestSHA256:manifestRecord.sha256,authenticatedFiles:89,preservedFiles:copies.length,excludedFiles:excluded.length,sourceStable:true}));
