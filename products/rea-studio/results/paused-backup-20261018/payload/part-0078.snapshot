      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c3f0932cc9b5920f618c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The Tempo data source supports streaming responses to TraceQL queries so you can see partial query results as they come in without waiting for the whole query to finish.",
      "headingPath": [
        "Before you begin",
        "View query results",
        "Stream results"
      ],
      "source": {
        "path": "docs/sources/shared/datasources/tempo-editor-traceql.md",
        "gitBlobSha": "003a449fd9604839ca39a071ca081b2985cca7ad",
        "sha256": "9c7845760d6acd3125be422446a3a81278de8126cebeba1e25349ed54ac6152a",
        "lineStart": 155,
        "lineEnd": 155,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/shared/datasources/tempo-editor-traceql.md#L155-L155"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.49e5624273705324c515",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Streaming is available for both the **Search** and **TraceQL** query types, and you'll get immediate visibility of incoming traces on the results table.",
      "headingPath": [
        "Before you begin",
        "View query results",
        "Stream results"
      ],
      "source": {
        "path": "docs/sources/shared/datasources/tempo-editor-traceql.md",
