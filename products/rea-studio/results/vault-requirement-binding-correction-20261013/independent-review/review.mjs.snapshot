import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const own=import.meta.dirname,base=path.resolve(own,'../..'),stage=path.join(base,'work/vault-requirement-binding-correction-v2-next'),repo=path.join(base,'outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)}),seen=new Map();
function read(root,p,e){assert(p.split('/').every(s=>s&&s!=='.'&&s!=='..')&&!/[\\:\x00-\x1f]/.test(p));let at=root;for(const s of p.split('/')){at=path.join(at,s);assert(!fs.lstatSync(at).isSymbolicLink());}const b=fs.readFileSync(at);assert(b.length<=32*1024*1024);const r=id(b);if(e)assert.deepEqual(r,{bytes:e.bytes,sha256:e.sha256},p);const key=root+'|'+p;if(seen.has(key))assert.deepEqual(seen.get(key).identity,r);else seen.set(key,{root:path.relative(base,root).replaceAll('\\','/'),path:p,identity:r});return b;}const json=(root,p,e)=>JSON.parse(read(root,p,e));function save(p,b){const at=path.join(own,p);fs.mkdirSync(path.dirname(at),{recursive:true});fs.writeFileSync(at,b,{flag:'wx'});}
const mb=read(stage,'manifest.json');assert.equal(sha(mb),'6d05393de6a4932a1fd150d10beba6fc77af36e4678c840aff8bf587ca4d7bdf');const m=JSON.parse(mb);assert.equal(m.inventory.length,12);assert.deepEqual(fs.readdirSync(stage).sort(),[...m.inventory.map(r=>r.path),'manifest.json'].sort());for(const r of m.inventory){read(stage,r.path,r);save('source/'+r.path+'.snapshot',read(stage,r.path,r));}save('source/manifest.json.snapshot',mb);
const audit=json(stage,'audit.json'),installation=json(stage,'installation-authority.json.snapshot');assert.equal(sha(read(stage,'installation-authority.json.snapshot')),'89c6f2f0b5c81becc957506d590ead6c7cd550e33e8519f0ff2c3c77ec2d253d');assert.equal(audit.proposals.length,2);assert.equal(audit.changedLocalEvidence.length,4);assert.equal(audit.allLocalEvidence.length,251);assert.equal(audit.allLocalEvidence.filter(r=>!r.matches).length,4);
const before=json(stage,'system-products.json.before.snapshot'),after=json(stage,'system-products.json.after.snapshot'),project=structuredClone(before),allBefore=project.products.flatMap(p=>p.local_implementation_evidence??[]);const names=['server.mjs','client.mjs','README.md','recycle.mjs'];assert.deepEqual(audit.changedLocalEvidence.map(r=>r.path).sort(),names.map(n=>'products/rea-studio/apps/vault/'+n).sort());
for(const r of audit.changedLocalEvidence){const row=allBefore.find(e=>e.path===r.path);assert(row);assert.deepEqual({bytes:row.bytes,sha256:row.sha256},r.before);const installed=installation.proposals.find(e=>e.destination===r.path);assert(installed);assert.deepEqual(installed.before,r.before);assert.deepEqual(installed.after,r.after);read(repo,r.path,r.after);row.bytes=r.after.bytes;row.sha256=r.after.sha256;}
assert.deepEqual(project,after);const readmeBefore=read(stage,'requirements-README.md.before.snapshot'),readmeAfter=read(stage,'requirements-README.md.after.snapshot'),needle='adds installed finite evidence and refreshes four reviewed implementation-byte references.',replacement='adds installed finite evidence and refreshes eight reviewed implementation-byte references: four Editor and four Vault paths.';assert.equal(readmeBefore.toString().split(needle).length-1,1);assert.equal(readmeBefore.toString().replace(needle,replacement),readmeAfter.toString());for(const r of audit.proposals){const current=read(repo,r.path,r.before);read(stage,r.source,r.after);assert.deepEqual(current,r.path.endsWith('/README.md')?readmeBefore:read(stage,'system-products.json.before.snapshot'));}
const sources=[],capabilities=[],allRows=[];for(const file of ['workspace-products.json','visual-products.json','system-products.json']){const j=json(stage,file+'.before.snapshot'),candidate=file==='system-products.json'?after:j;read(repo,'products/rea-studio/requirements/'+file,id(read(stage,file+'.before.snapshot')));const local=file==='workspace-products.json'?candidate.localImplementationEvidence:file==='visual-products.json'?candidate.baselineProducts.flatMap(p=>p.implementationFiles??[]):candidate.products.flatMap(p=>p.local_implementation_evidence??[]);const caps=file==='workspace-products.json'?j.capabilities:file==='visual-products.json'?j.baselineProducts.flatMap(p=>p.requirements):j.products.flatMap(p=>p.capabilities);sources.push(...j.sources.map(s=>({registry:file,id:s.id,sha256:s.sha256})));capabilities.push(...caps.map(c=>({registry:file,id:c.id})));for(const row of local){const actual=id(read(repo,row.path));assert.equal(row.sha256,actual.sha256);if(row.bytes!==undefined)assert.equal(row.bytes,actual.bytes);allRows.push({registry:file,path:row.path,actual});}}
assert.equal(allRows.length,251);assert.equal(sources.length,159);assert.equal(capabilities.length,232);assert.deepEqual(sources,json(stage,'original-source-identities.json'));assert.deepEqual(capabilities,json(stage,'capability-identities.json'));assert.deepEqual(before.sources,after.sources);assert.deepEqual(before.products.map(p=>p.capabilities),after.products.map(p=>p.capabilities));
const oldRoot=path.join(base,'work/vault-requirement-binding-correction-next'),old=[];for(const p of fs.readdirSync(oldRoot)){assert(/^(failed-collector\.mjs|(?:system|workspace|visual)-products\.json\.before)\.snapshot$/.test(p));const b=read(oldRoot,p);old.push({path:p,...id(b)});if(p==='failed-collector.mjs.snapshot')save('source/first-failed-collector.mjs.snapshot',b);else assert.deepEqual(b,read(stage,p));}assert.equal(old.length,4);save('old-failed-plan-identities.json',JSON.stringify(old,null,2)+'\n');
const code=read(stage,'collector.mjs.snapshot').toString();assert(code.includes('assert.equal(changes.length,4)'));assert(code.includes('changedLocalEvidence:3'));save('recorder-diagnostic.json',JSON.stringify({schema:'rea-metadata-count-recorder-diagnostic/v1',printedSummaryCount:3,authoritativeAuditArrayLength:4,sourceAssertionCount:4,classification:'Hardcoded stdout diagnostic is stale; strict audit and semantic comparison prove four actual changed references, including README. No plan bytes rewritten.',firstCollector:'Assumed3 runtime-only references; failed before production. Exact failed source/three unchanged snapshots are preserved.'},null,2)+'\n');
const devPath='products/rea-studio/results/development-validation.json',devBytes=read(repo,devPath);assert.equal(sha(devBytes),'333303c8bd8cd131da3f01e1414b0fba92bc321b2b63f178ab91d138b2bcfa44');const dev=JSON.parse(devBytes);assert.equal(dev.summary.tests,937);assert.equal(dev.summary.pass,937);assert.equal(dev.source_files.length,737);for(const r of dev.source_files){assert(!r.path.startsWith('requirements/'));assert.equal(sha(read(repo,'products/rea-studio/'+r.path)),r.sha256);}const status=read(repo,'products/rea-studio/STATUS.json');assert.equal(sha(status),'1f6eec5b4a171713ed42374cd1fd5b3878e1cfe891173394e4cd20cf4396df4b');const migrationRoot=path.join(base,'work/editor-vault-proof-migration-next'),live=json(migrationRoot,'live-verifier-copy-list.json');assert.equal(live.records.length,8);for(const r of live.records)read(repo,r.destination,r.after);
const identities=[...seen.values()];save('source-before.json',JSON.stringify(identities,null,2)+'\n');for(const r of identities)read(path.join(base,r.root),r.path,r.identity);save('source-after.json',JSON.stringify([...seen.values()],null,2)+'\n');assert.deepEqual([...seen.values()],identities);
save('review-validation.json',JSON.stringify({schema:'rea-vault-requirement-binding-independent-source-review/v1',at:new Date().toISOString(),metadataPlanAccepted:true,finiteSourceOnlyAcceptance:true,planManifestSHA256:sha(mb),strictPlanPayloads:12,proposals:2,changedLocalEvidence:4,changedLocalEvidencePaths:audit.changedLocalEvidence.map(r=>r.path),allLocalEvidenceAudited:251,allProposedLocalRefsMatchCurrent:true,originalSourceIdentities:159,capabilityIDs:232,otherSemanticDataUnchanged:true,readmeSingleExactPhraseSubstitution:true,installed30AuthoritySHA256:sha(read(stage,'installation-authority.json.snapshot')),applicationSourcesUnchanged:737,applicationSourceRequirementsExcluded:true,currentDevelopmentReceipt:{path:devPath,...id(devBytes),tests:937,testReexecution:false},currentStatusUnchanged:true,currentEightRootScriptsUnchanged:true,sourceBeforeAfterStable:true,authenticatedSourceIdentities:identities.length,hardcodedSummaryCount3Qualified:true,confirmedFaults:[],productionWrites:0,publicWrites:0,applicationExecutions:0,originalExecutions:0,browserExecutions:0,benchmarks:0,fullProductParity:false,scope:'Metadata-only source identity repair. Two exact proposed replacements only; no behavior acceptance added.'},null,2)+'\n');
function files(p=''){const out=[];for(const d of fs.readdirSync(path.join(own,p),{withFileTypes:true})){assert(!d.isSymbolicLink());const n=p?p+'/'+d.name:d.name;if(d.isDirectory())out.push(...files(n));else if(n!=='manifest.json')out.push(n);}return out;}const inventory=files().sort().map(p=>({path:p,...id(fs.readFileSync(path.join(own,p)))}));const frozen=Buffer.from(JSON.stringify({schema:'rea-vault-requirement-binding-independent-strict-freeze/v1',at:new Date().toISOString(),strict:true,inventory,files:inventory.length,metadataPlanAccepted:true,productionWrites:0,planManifestSHA256:sha(mb)},null,2)+'\n');save('manifest.json',frozen);console.log(JSON.stringify({accepted:true,files:inventory.length,manifest:id(frozen),receipt:id(fs.readFileSync(path.join(own,'review-validation.json'))),changedRefs:4,proposals:2,sourceStable:true,productionWrites:0}));
