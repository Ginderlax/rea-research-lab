import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';import{fileURLToPath}from'node:url';
const root=fileURLToPath(new URL('./',import.meta.url)),stage=fileURLToPath(new URL('../keepass-recycle-bin-generation-fix-next/',import.meta.url)),old=fileURLToPath(new URL('../keepass-recycle-independent-review/',import.meta.url)),hash=b=>createHash('sha256').update(b).digest('hex');
const manifestBytes=await fs.readFile(path.join(stage,'manifest.json')),receiptBytes=await fs.readFile(path.join(stage,'validation.json'));assert.equal(hash(manifestBytes),'17e9757a0bf58173c433465b12bf2a10a62570b1b5e85bd38bad29c96b88f775');assert.equal(hash(receiptBytes),'316a97f3565823f007bd9a8e66167f453d249747bc06ffa14132fe7cfd07d4e5');const manifest=JSON.parse(manifestBytes),receipt=JSON.parse(receiptBytes),records=manifest.files??manifest.records;assert.equal(records.length,208);for(const r of records){const b=await fs.readFile(path.join(stage,r.path));assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);}
