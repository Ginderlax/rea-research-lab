import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const own=import.meta.dirname,base=path.resolve(own,'../..'),repo=path.join(base,'outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)});const json=p=>JSON.parse(fs.readFileSync(path.join(own,p)));function save(p,b){const at=path.join(own,p);fs.mkdirSync(path.dirname(at),{recursive:true});fs.writeFileSync(at,b,{flag:'wx'});}function safe(p){assert(p&&typeof p==='string'&&p.split('/').every(s=>s&&s!=='.'&&s!=='..'&&s!=='.local')&&!/[\\:\x00-\x1f\x7f]/.test(p));return p;}
const sourceMap=json('base-public-source-map.json'),proposal=json('base-installation-proposals.json'),browserRoot='work/root-flow-corrected-browser-review-next',browser=path.join(base,browserRoot),mb=fs.readFileSync(path.join(browser,'manifest.json'));assert.equal(sha(mb),'0ca2b70bfab5f5da6537e0eabd8829e0bbf0d582b4580926b06bc47ed89a5bee');const manifest=JSON.parse(mb);assert.equal(manifest.inventory.length,38);const br=jsonFrom(browser,'browser-observations.json'),host=jsonFrom(browser,'validation.json');function jsonFrom(root,p){return JSON.parse(fs.readFileSync(path.join(root,p)));}assert.equal(br.finiteObservations,12);assert.equal(br.pass,12);assert.equal(br.fail,0);assert(br.observations.every(r=>r.pass));assert.equal(br.nativeDownloadsDelivered,3);assert.equal(br.nativeFileChooserImports,1);assert.equal(br.heldTransportResponses,0);assert.equal(br.pendingDisposalNativeBrowserAcceptance,false);assert.equal(br.bareCRNativeBrowserAcceptance,false);assert.equal(host.sourceRoster,13);assert.equal(host.sourceStable,true);assert.equal(host.finalState.runs.length,4);assert.equal(host.finalReadError,null);assert.equal(host.cleanupError,null);assert.equal(host.sourceError,null);assert.equal(host.ownedHostClosed,true);assert.equal(host.ownedDataRemoved,true);assert.equal(host.privateControlRemoved,true);
const browserRows=[...manifest.inventory,{path:'manifest.json',...id(mb)}];for(const r of browserRows){const b=fs.readFileSync(path.join(browser,safe(r.path)));assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});sourceMap.records.push({epoch:'root-corrected-browser',sourceRoot:browserRoot,sourcePath:r.path,publicPath:sourceMap.publicPrefix+'/root-corrected-browser/frozen/'+r.path+'.snapshot',...id(b),inert:true,originalExecutable:false});}sourceMap.epochs.push({name:'root-corrected-browser',sourceRoot:browserRoot,manifest:'manifest.json',manifestIdentity:id(mb),strictPayloads:38,mappedRows:39,sidecars:['manifest.json']});sourceMap.pendingCorrectedRootBrowser=false;assert.equal(sourceMap.records.length,830);save('authority/root-corrected-browser.manifest.json.snapshot',mb);save('authority/root-corrected-browser.observations.json.snapshot',fs.readFileSync(path.join(browser,'browser-observations.json')));save('authority/root-corrected-browser.validation.json.snapshot',fs.readFileSync(path.join(browser,'validation.json')));
const publicNames=new Set(),identities=new Map(),sourceRows=[];for(const r of sourceMap.records){safe(r.publicPath);assert(r.publicPath.startsWith(sourceMap.publicPrefix+'/')&&r.publicPath.endsWith('.snapshot'));assert(!publicNames.has(r.publicPath));publicNames.add(r.publicPath);const b=fs.readFileSync(path.join(base,r.sourceRoot,r.sourcePath));assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});assert(!(b[0]===77&&b[1]===90));assert(!(b[0]===80&&b[1]===75));assert(!(b[0]===31&&b[1]===139));new TextDecoder('utf8',{fatal:true}).decode(b);const key=r.bytes+':'+r.sha256;identities.set(key,(identities.get(key)??0)+1);sourceRows.push({sourceRoot:r.sourceRoot,sourcePath:r.sourcePath,...id(b)});}sourceMap.duplicateByteIdentities=sourceMap.records.length-identities.size;sourceMap.distinctByteIdentities=identities.size;sourceMap.uniquePublicPaths=publicNames.size;
for(const r of json('excluded-local-carriers.json').records)assert(!identities.has(r.bytes+':'+r.sha256));
const overlays=[];for(const filename of ['README.md','NATIVE-FLOWS.md','NATIVE-LINKS.md','NATIVE-TEXT-SOURCE.md','LINK-SOURCE-NOTICE.md']){const p='proposals/'+filename,b=fs.readFileSync(path.join(own,p));save('proposal-before-doc-overlays/'+filename+'.snapshot',b);let text=b.toString(),edits=[];function replace(before,after){assert.equal(text.split(before).length-1,1,filename);text=text.replace(before,after);edits.push({before,after,occurrences:1});}
  if(filename==='README.md'){replace('## Static-link work stage','## Static-link follow-up');replace('Production integration and actual browser acceptance remain pending.','Current installation awaits root approval and source-bound installed-path tests; the finite actual-browser checks are preserved separately.');}
  if(filename==='NATIVE-FLOWS.md')replace('The work-stage runner adds bounded static Link In and Link Out.','The bounded manual runner includes static Link In and Link Out.');
  if(['README.md','NATIVE-FLOWS.md','NATIVE-LINKS.md'].includes(filename))replace('Corrected independent/browser acceptance remains pending.','The independent 24-group model review and separate root 12-observation browser review apply only to their recorded sources and finite checks; installed-path acceptance remains pending.');
  if(filename==='NATIVE-LINKS.md')replace('Staging receipts, failed attempts and source bindings are kept outside the application; production installation and actual browser review remain pending.','Frozen staging receipts, failed attempts and source bindings are preserved below as separate epochs. Root installation and installed-path tests remain pending; the finite corrected browser review is separately bound.');
  if(filename==='NATIVE-TEXT-SOURCE.md'){replace('The current correction selector has **75 tests**:','The preserved staged correction selector has **75 tests**:');replace('Corrected independent/browser acceptance is pending.','The independent model review passes 24 groups (14 retained bodies and 10 fresh controls). The separate normal-host browser review passes 12 observations, one file import and three exact 1,812-byte native downloads. Held-response, bare-CR browser and pending-disposal browser acceptance remain open. Installed-path test acceptance remains pending.');}
  if(filename==='LINK-SOURCE-NOTICE.md')replace('The work-stage acquisition and final source-provenance records give exact paths, lengths, digests, fixture adapters and additional authenticated verification dependencies. The Node-RED test helper is used only for tests and carries its own Apache-2.0 notice. The full license text is retained with the exact original source files in the stage. Public preservation paths and test cache bootstrap/adapters must be authenticated during a future production integration; this work-stage notice does not assert installation.','The preserved acquisition and source-provenance records below give exact paths, lengths, digests, fixture adapters and additional authenticated verification dependencies. The Node-RED test helper is used only for tests and carries its own Apache-2.0 notice. Complete publisher and test-helper license texts are retained with the exact selected source snapshots. The original-test current-layout adapter resolves the default locked cache and forwards that chosen cache to its plain test child; two normalization tests adapt only their seed paths. These proposals preserve assertions and require root installed-path validation. Application code has no original runtime dependency.');
  const appendix='\n\n## Preserved source and finite evidence\n\nThe [static-link source provenance](results/native-link-textarea-followup/static-link-stage/frozen/source-provenance.json.snapshot), [publisher Apache-2.0 license](results/native-link-textarea-followup/static-link-stage/frozen/official-source/node-red-nodes/LICENSE.snapshot.snapshot), [runtime license](results/native-link-textarea-followup/static-link-stage/frozen/official-source/node-red-runtime/LICENSE.snapshot.snapshot) and [test-helper license](results/native-link-textarea-followup/static-link-stage/frozen/verification-source/node-red-node-test-helper/LICENSE.snapshot.snapshot) retain complete source notices. Compressed carriers and installed original dependencies remain local-only.\n\nHistorical native34/51-runtime/828-scalar, [author static57](results/native-link-textarea-followup/static-link-stage/frozen/validation.json.snapshot), [author corrected75](results/native-link-textarea-followup/textarea-correction/frozen/validation.json.snapshot), [independent model24](results/native-link-textarea-followup/independent-model-review/frozen/review-validation.json.snapshot), [negative browser8](results/native-link-textarea-followup/root-negative-browser/frozen/browser-observations.json.snapshot) and [corrected browser12](results/native-link-textarea-followup/root-corrected-browser/frozen/browser-observations.json.snapshot) stay separate source epochs. The author original groups contain9 compiler fixtures,7 handler cases and8 full test-helper flows per accepted campaign; the root static review separately records128 compiler calls. This publication planner runs none of those comparisons.\n\nThe corrected normal shared-host browser preserves exact raw CRLF across loaded Save and three actual downloads, one file import, static link connection/deployment isolation and reload persistence. The browser does not cover held transport responses, bare-CR input or pending disposal. Programmatic edits of disabled controls are defensive model probes, not real user typing evidence. No full Node-RED editor/runtime parity, security equivalence or superiority is established.\n';text+=appendix;edits.push({before:'',after:appendix,appendOnly:true});let inverse=text.slice(0,-appendix.length);for(const e of [...edits.slice(0,-1)].reverse()){assert.equal(inverse.split(e.after).length-1,1);inverse=inverse.replace(e.after,e.before);}assert.equal(inverse,b.toString());fs.writeFileSync(path.join(own,p),text);const row=proposal.proposals.find(r=>r.sourcePath===p);assert(row);row.after=id(Buffer.from(text));row.documentationOverlay=true;row.runtimeSemanticsUnchangedFromAcceptedCandidate=true;overlays.push({file:filename,before:id(b),after:row.after,edits,inverseExact:true});}
save('documentation-overlays.json',JSON.stringify({schema:'rea-flow-publication-exact-doc-overlays/v1',records:overlays,docsOnly:true,behaviorChanges:0,originalNoticeRetained:true},null,2)+'\n');
for(const row of proposal.proposals){assert(row.destination.startsWith('products/rea-studio/apps/flow/'));safe(row.destination);const b=fs.readFileSync(path.join(own,row.sourcePath));assert.deepEqual(id(b),row.after);if(row.before)assert.deepEqual(id(fs.readFileSync(path.join(repo,row.destination))),row.before);else assert(!fs.existsSync(path.join(repo,row.destination)));}proposal.documentationOverlayPending=false;proposal.publicPrefix=sourceMap.publicPrefix;proposal.sourceAssistedOriginalRuntimeInApp=false;proposal.installedPathAcceptance=false;save('installation-proposals.json',JSON.stringify(proposal,null,2)+'\n');save('public-source-map.json',JSON.stringify(sourceMap,null,2)+'\n');save('duplicate-identities.json',JSON.stringify({aliases:830,uniquePublicPaths:publicNames.size,distinctByteIdentities:identities.size,duplicateAliases:830-identities.size,groups:[...identities].filter(([,n])=>n>1).map(([identity,aliases])=>({identity,aliases})),allDuplicateSourcesAuthenticated:true},null,2)+'\n');
const reg=json('original-registry-identities.json'),currentReg=[],metadataTransitions=[];for(const r of reg.registries){const b=fs.readFileSync(path.join(repo,'products/rea-studio/requirements',r.filename)),j=JSON.parse(b),caps=r.filename==='workspace-products.json'?j.capabilities:r.filename==='visual-products.json'?j.baselineProducts.flatMap(p=>p.requirements):j.products.flatMap(p=>p.capabilities);assert.deepEqual(j.sources.map(s=>({id:s.id,sha256:s.sha256})),r.sourceIDs);assert.deepEqual(caps.map(c=>c.id),r.capabilityIDs);currentReg.push({filename:r.filename,identity:id(b),sourceIDs:r.sourceIDs.length,capabilityIDs:r.capabilityIDs.length});if(sha(b)!==r.identity.sha256)metadataTransitions.push({filename:r.filename,before:r.identity,after:id(b),originalIdentitiesUnchanged:true,authority:'Parent-owned metadata changes, no frozen requirement snapshot rebasing.'});}save('current-registry-identity-audit.json',JSON.stringify({current:currentReg,metadataTransitions,sourceIDs:159,capabilityIDs:232,oldCapturePreserved:true},null,2)+'\n');
for(const r of sourceRows)assert.deepEqual(id(fs.readFileSync(path.join(base,r.sourceRoot,r.sourcePath))),{bytes:r.bytes,sha256:r.sha256});save('source-before-after.json',JSON.stringify({records:sourceRows,beforeAfterExact:true,capturedAfterBrowserFreeze:true},null,2)+'\n');
