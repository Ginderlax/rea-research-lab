    {
      "id": "grafana.candidate.cbca1816326386fb4394",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**To enable managed identity for Grafana:**",
      "headingPath": [
        "Configure the Microsoft SQL Server data source",
        "Configure the data source in the UI",
        "Azure Entra ID (formerly Azure AD) Authentication",
        "Managed Identity"
