    },
    {
      "id": "grafana.candidate.72b822536bf10902c329",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, Grafana app plugins and their pages appear under the \"More apps\" section in the navigation menu. However, as a Grafana administrator, you might want to improve user experience by relocating specific pages or entire app plugins to more relevant sections of the navigation hierarchy. This guide shows you how to customize the placement of app plugin pages across different parts of your Grafana navigation menu.",
      "headingPath": [
        "Customize navigation placement of app plugin pages"
      ],
      "source": {
        "path": "docs/sources/administration/plugin-management/customize-nav-bar.md",
        "gitBlobSha": "0e227c9a4f378e8b09d6352aaf74b0b1c5e17a90",
        "sha256": "b5c9c5411c81dc47fbb4f2ebf82e020280ee03300aff381187272fdc8326fc28",
        "lineStart": 21,
        "lineEnd": 21,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/plugin-management/customize-nav-bar.md#L21-L21"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.62dcde3b4c3f8344326d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can change the location of your app plugin pages in two ways:",
      "headingPath": [
        "Customize navigation placement of app plugin pages",
        "Customize app and page navigation placement"
      ],
      "source": {
