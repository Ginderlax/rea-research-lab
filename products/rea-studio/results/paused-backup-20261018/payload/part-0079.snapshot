    {
      "id": "grafana.candidate.8d9e3963f0773ec4cc73",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We've made improvements to all [Enterprise Datasources](../../introduction/grafana-enterprise/#enterprise-data-sources), fixing small bugs, and updating libraries. We've also added many new features and support for additional APIs. Refer to each datasource's documentation and the change log for additional information.",
      "headingPath": [
        "What's new in Grafana v9.4",
        "Enterprise Datasources"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-4.md",
