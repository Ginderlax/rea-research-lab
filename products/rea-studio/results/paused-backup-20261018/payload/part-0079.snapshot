    {
      "id": "grafana.candidate.979600da2593a4047cb1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana admins struggle to effectively communicate important updates and maintenance information to their users through traditional channels like email and Slack. Now you can display customizable banners within the Grafana interface to ensure critical information is visible and timely. This ensures that all users are immediately informed of important updates, maintenance schedules, compliance info, or other crucial messages, reducing the likelihood of missed communications and enhancing overall user awareness and engagement.",
      "headingPath": [
        "What’s new in Grafana v11.3",
        "Announcement banner"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-3.md",
        "gitBlobSha": "5eb55341a0458eac320b2317223af815e066d128",
        "sha256": "42f0fbcea86ed7f49f166bc9b279b95673f27c4ef505737f7b54ede18c391332",
        "lineStart": 252,
        "lineEnd": 252,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-3.md#L252-L252"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
