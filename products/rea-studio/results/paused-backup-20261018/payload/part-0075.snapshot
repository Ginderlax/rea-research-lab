    {
      "id": "grafana.candidate.3d12316ccdfa8b69513b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Regular expressions use [RE2 syntax](https://github.com/google/re2/wiki/Syntax) and are fully anchored, so the pattern must match the entire label value. Use `.*` or `.+` to match part of a value, for example `label:severity=~.*crit.*`. Matching is case-sensitive by default. To match without case sensitivity, add the `(?i)` inline flag, for example `label:severity=~(?i)critical`.",
      "headingPath": [
        "View alert rules",
        "Filter and save searches",
        "Search syntax",
        "Match labels with regular expressions"
      ],
      "source": {
        "path": "docs/sources/alerting/monitor-status/view-alert-rules.md",
        "gitBlobSha": "8c9b1d2717c656eb52fd46c59d04076d4edc2d17",
        "sha256": "36dd4e303d44c42ef9058ee321cafc4548d44dfb40702df4ff1426893676454e",
