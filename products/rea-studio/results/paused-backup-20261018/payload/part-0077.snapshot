    {
      "id": "grafana.candidate.07dd2deeb35de0ddd38b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana keeps track of all synchronized users in teams, and you can see which users have been synchronized in the team members list, see `LDAP` label in screenshot. This mechanism allows Grafana to remove an existing synchronized user from a team when its group membership changes. This mechanism also enables you to manually add a user as member of a team, and it will not be removed when the user signs in. This gives you flexibility to combine LDAP group memberships and Grafana team memberships.",
      "headingPath": [
        "Configure Team Sync"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-team-sync.md",
        "gitBlobSha": "a4fe4b28c48fda88856bdaf12a8ec9c266ed5640",
        "sha256": "869ebf8d7bc6c944deab0c743530d10152310b6617e96159c9ba2760ea1a78e7",
        "lineStart": 24,
        "lineEnd": 25,
