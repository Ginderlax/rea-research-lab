        "lineStart": 19,
        "lineEnd": 19,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/shared/alerts/template-language.md#L19-L19"
      },
      "applicability": {
        "status": "unresolved-no-explicit-oss-products-label",
        "products": []
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.2e22d5829db7e3f700aa",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "`range` iterates over an array or map, and dot (`.`) is set to the current element of the array:",
      "headingPath": [
        "If",
        "Range"
      ],
      "source": {
        "path": "docs/sources/shared/alerts/template-language.md",
