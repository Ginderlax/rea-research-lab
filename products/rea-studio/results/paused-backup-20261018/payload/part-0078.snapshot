    {
      "id": "grafana.candidate.8b3d012971c19eb77dc0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you create a dashboard link, you can include the time range and current template variables to directly jump to the same context in another dashboard. This way, you don’t have to worry whether the person you send the link to is looking at the right data. For other types of links, refer to [Data link variables](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/panels-visualizations/configure-data-links/#data-link-variables).",
      "headingPath": [
        "Manage dashboard links",
        "Dashboard links"
      ],
