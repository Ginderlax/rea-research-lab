      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.deed6580a6006fca7c0c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You cannot edit imported alerting resources in the Grafana UI in the same way as alerting resources that were not imported. You can only edit imported contact points, notification policies, templates, and mute timings in the source where they were created. For example, if you manage your alerting resources using files from disk, you cannot edit the data in Terraform or from within Grafana.",
      "headingPath": [
        "Provision Alerting resources"
      ],
      "source": {
        "path": "docs/sources/alerting/set-up/provision-alerting-resources/_index.md",
