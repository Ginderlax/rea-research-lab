        "lineStart": 625,
        "lineEnd": 625,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/panels-visualizations/visualizations/geomap/index.md#L625-L625"
      },
      "applicability": {
