    {
      "id": "grafana.candidate.f4455c388e5f2fc1f278",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The [Queries](../../panels-visualizations/#add-a-query) topic has been updated as a result of this change.",
      "headingPath": [
        "What's new in Grafana v7.2",
        "Drag to reorder queries"
