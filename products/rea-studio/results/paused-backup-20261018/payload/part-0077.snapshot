    {
      "id": "grafana.candidate.7b058b52042bb7506991",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana supports specifying custom configuration settings using [environment variables](../../configure-grafana/#override-configuration-with-environment-variables).",
      "headingPath": [
        "Run Grafana Docker image",
        "Run Grafana via Docker CLI",
        "Use environment variables to configure Grafana"
      ],
      "source": {
