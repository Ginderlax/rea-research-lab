    {
      "id": "grafana.candidate.ffb372dbf154eccaac5d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This option is visible only if it's available in the data source. It overrides the default cache timeout if your time series store has a query cache. Specify this value as a numeric value in seconds.",
      "headingPath": [
        "Query and transform data",
        "Query options",
        "Cache timeout"
      ],
