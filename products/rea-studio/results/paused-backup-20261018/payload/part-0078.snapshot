    {
      "id": "grafana.candidate.6570c7deab3d5264905d",
      "syntaxRole": "list-item",
      "sourceText": "- Grafana provisioning has a new schema. Please refer to [Provisioning RBAC with Grafana](/docs/grafana/latest/administration/roles-and-permissions/access-control/rbac-grafana-provisioning/) to learn more about provisioning.",
      "headingPath": [
        "Upgrade to Grafana v9.0",
        "Technical notes",
        "Role-based access control: changes for general release"
      ],
      "source": {
        "path": "docs/sources/upgrade-guide/upgrade-v9.0/index.md",
