    {
      "id": "grafana.candidate.d4eb07e6a6d4fdd212f9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The up and down arrows, which were previously the only way to change query order, have been removed. Instead, there is now a grab icon that allows you to drag and drop queries in a list to change their order.",
      "headingPath": [
        "What's new in Grafana v7.2",
        "Drag to reorder queries"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-2.md",
