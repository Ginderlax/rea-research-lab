    {
      "id": "grafana.candidate.315c9317a2803bf011b0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**New cumulative and window calculations available in Add field from calculation**",
      "headingPath": [
        "What’s new in Grafana v11.2",
        "Dashboards and visualizations",
        "Transformation updates"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-2.md",
        "gitBlobSha": "ceccf569bb3670f6d3ae8c4db9fa3befbb8ef80a",
        "sha256": "e3947d9db32859fc717703f21b781da2366f7e2bda8dcfaeb51f1812ec5a1342",
        "lineStart": 91,
        "lineEnd": 91,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-2.md#L91-L91"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.0c5259b3d703c3019db3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The **Add field from calculation** transformation now supports both cumulative and window calculations. The cumulative function calculates on the current row and all preceding rows. You can calculate the total or the mean of your data up to and including the current row. With the window function you can calculate the mean, standard deviation, or variance on a specified set (window) of your data. The window can either be trailing or centered. With a trailing window the current row will be the last row in the window. With a centered window the window will be centered on the current row.",
      "headingPath": [
        "What’s new in Grafana v11.2",
        "Dashboards and visualizations",
        "Transformation updates"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-2.md",
        "gitBlobSha": "ceccf569bb3670f6d3ae8c4db9fa3befbb8ef80a",
        "sha256": "e3947d9db32859fc717703f21b781da2366f7e2bda8dcfaeb51f1812ec5a1342",
