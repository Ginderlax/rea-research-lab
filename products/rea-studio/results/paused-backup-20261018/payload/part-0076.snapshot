        "lineEnd": 358,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/mssql/configure/index.md#L358-L358"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.ba8823a85ac62d5161cf",
      "syntaxRole": "procedural-step",
      "sourceText": "1. In the SQL Server data source configuration, set **Authentication** to **Azure AD Authentication** and the Azure Authentication type to **Managed Identity**.",
      "headingPath": [
        "Configure the Microsoft SQL Server data source",
        "Configure the data source in the UI",
        "Azure Entra ID (formerly Azure AD) Authentication",
        "Managed Identity"
      ],
