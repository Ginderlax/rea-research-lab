    },
    {
      "id": "grafana.candidate.1d252a58a5e34254ed94",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, this also enables fallback service credentials. To disable fallback credentials at the instance level:",
      "headingPath": [
        "Configure the Azure Monitor data source",
        "Configure authentication",
        "Current User",
        "Current User Grafana server configuration"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/configure/index.md",
        "gitBlobSha": "919384f53d9fafa0c605f03c3a584a26e4d9130a",
        "sha256": "6eb14e0ca3df71ab6d1092349af5a09af935ff0a05b241d8abf6201b518ebbc4",
        "lineStart": 415,
        "lineEnd": 415,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/azure-monitor/configure/index.md#L415-L415"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
