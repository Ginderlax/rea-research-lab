import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import {here} from './harness.mjs';
const original=path.resolve(here,'../keepass-history-independent-review'),sha=b=>createHash('sha256').update(b).digest('hex'),files=[];
async function copy(rel){const stat=await fs.lstat(path.join(original,rel));if(stat.isSymbolicLink())throw new Error('Unexpected independent trace link.');if(stat.isDirectory()){for(const name of await fs.readdir(path.join(original,rel)))await copy(rel+'/'+name);return}const bytes=await fs.readFile(path.join(original,rel)),target=path.join(here,'independent-failure',rel+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});try{const previous=await fs.readFile(target);if(sha(previous)!==sha(bytes))throw new Error('Immutable earlier independent trace changed '+rel)}catch(error){if(error.code!=='ENOENT')throw error;await fs.writeFile(target,bytes,{flag:'wx'})}files.push({path:rel+'.snapshot',bytes:bytes.length,sha256:sha(bytes)})}
for(const name of ['runs/selection-boundaries','boundary-observations','selection-boundaries.test.mjs','ui-fixture.mjs'])await copy(name);await fs.writeFile(path.join(here,'independent-failure/boundary-preservation.json'),JSON.stringify({source:'Independent frozen old-stage diagnostic cases; six groups, three observed failures and three passing controls; not rebound to corrected candidate.',files},null,2),{flag:'wx'});console.log(JSON.stringify({preserved:files.length}));
