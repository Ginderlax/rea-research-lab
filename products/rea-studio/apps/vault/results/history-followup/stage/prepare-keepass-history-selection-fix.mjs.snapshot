import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
const work=import.meta.dirname,old=path.join(work,'keepass-history-next'),next=path.join(work,'keepass-history-selection-fix-next'),sha=b=>createHash('sha256').update(b).digest('hex');const bytes=await fs.readFile(path.join(old,'preservation-manifest.json'));if(sha(bytes)!=='9b9383f3722113d0f4e5228f2360d8eea93653efc2b69f1571a01cace862bcbd')throw new Error('Old freeze identity changed');const manifest=JSON.parse(bytes);if(manifest.count!==181)throw new Error('Old inventory count changed');await fs.mkdir(next,{recursive:false});
for(const f of manifest.files){const b=await fs.readFile(path.join(old,f.path));if(b.length!==f.bytes||sha(b)!==f.sha256)throw new Error('Old artifact changed '+f.path);for(const target of [path.join(next,f.path),path.join(next,'preserved-original-stage',f.path+'.snapshot')]){await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b)}}
for(const name of ['preservation-manifest.json','freeze.json'])await fs.copyFile(path.join(old,name),path.join(next,'preserved-original-stage',name+'.snapshot'));
const review=path.join(work,'keepass-history-independent-review');await fs.mkdir(path.join(next,'independent-failure'));async function copy(dir,rel=''){for(const e of await fs.readdir(dir,{withFileTypes:true})){const name=rel?rel+'/'+e.name:e.name;if(e.isSymbolicLink())throw new Error('Unexpected review link');if(e.isDirectory()){if(name!=='.local')await copy(path.join(dir,e.name),name)}else{const destination=path.join(next,'independent-failure',name+'.snapshot');await fs.mkdir(path.dirname(destination),{recursive:true});await fs.copyFile(path.join(dir,e.name),destination)}}}await copy(review);
await fs.writeFile(path.join(next,'correction-baseline.json'),JSON.stringify({oldStageManifestSha256:sha(bytes),oldFiles:manifest.files,preservationPrefix:'preserved-original-stage/',suffix:'.snapshot',independentFailureOriginalTestSha256:'e6e28c97c3236afea08989e57b25f8f185adce6f8014e77bb18e51c8fb4eaeb1',productionChanged:false},null,2));await fs.copyFile(import.meta.filename,path.join(next,'prepare-keepass-history-selection-fix.mjs'));console.log(JSON.stringify({next,preserved:181}));
