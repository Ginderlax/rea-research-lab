    {
      "id": "grafana.candidate.4c36393be580d07c09de",
      "syntaxRole": "procedural-step",
      "sourceText": "1. You must have set `client_id` (env var `GF_AUTH_AZUREAD_CLIENT_ID`) under `[auth.azuread]` in the Grafana server configuration for this to work. This must match the Entra ID/Entra ID App Registration Application (client) ID.",
      "headingPath": [
        "Configure Microsoft Entra ID OAuth authentication",
        "Register your application with Microsoft Entra ID"
      ],
