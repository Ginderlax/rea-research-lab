    },
    {
      "id": "grafana.candidate.0297161f5dceb219d623",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The following example provisions an AWS Secrets Manager keeper. Add it to `main.tf`, or to any other `.tf` file in the same working directory.",
      "headingPath": [
        "Use Terraform to provision secure values",
        "Provision a keeper",
        "Define a keeper"
      ],
      "source": {
        "path": "docs/sources/as-code/infrastructure-as-code/terraform/terraform-secrets-management.md",
        "gitBlobSha": "52977e9c09c75dbafbdbbdb7ab05a511e921e281",
        "sha256": "408746cac5de95be048c327c72a92ce56e80f5a9bcb4614d2ab66a4dc946630b",
        "lineStart": 436,
        "lineEnd": 436,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/as-code/infrastructure-as-code/terraform/terraform-secrets-management.md#L436-L436"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.635c60d58f6edd72663f",
      "syntaxRole": "list-item",
      "sourceText": "- _`<REGION>`_ is the AWS region that hosts your secrets, for example `us-east-1`.",
      "headingPath": [
        "Use Terraform to provision secure values",
        "Provision a keeper",
        "Define a keeper"
      ],
      "source": {
        "path": "docs/sources/as-code/infrastructure-as-code/terraform/terraform-secrets-management.md",
