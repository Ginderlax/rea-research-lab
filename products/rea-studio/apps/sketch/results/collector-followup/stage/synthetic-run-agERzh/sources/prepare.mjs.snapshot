import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),lab=path.resolve(here,'../../outputs/rea-research-lab'),studio=path.join(lab,'products/rea-studio'),hash=b=>createHash('sha256').update(b).digest('hex'),names=['scripts/verify-sketch-geometry.mjs','apps/sketch/results/geometry-validation.json','apps/sketch/results/geometry-original-observations.json','apps/sketch/results/geometry-tests.stdout.txt','apps/sketch/results/geometry-tests.stderr.txt','apps/sketch/results/geometry-source-study/manifest.json'];await fs.mkdir(path.join(here,'baseline'),{recursive:true});await fs.mkdir(path.join(here,'candidate'),{recursive:true});const rows=[];
for(const name of names){const bytes=await fs.readFile(path.join(studio,name)),relative='baseline/'+name;await fs.mkdir(path.dirname(path.join(here,relative)),{recursive:true});await fs.writeFile(path.join(here,relative),bytes,{flag:'wx'});rows.push({source:name,path:relative,bytes:bytes.length,sha256:hash(bytes)});}
const old=await fs.readFile(path.join(studio,'scripts/verify-sketch-geometry.mjs'),'utf8');assert.equal(hash(old),'cf044f4be673201b19247cb9bc9d31c86d713aef70d51fdb6c3508332a49621d');await fs.writeFile(path.join(here,'candidate/verify-sketch-geometry.mjs'),old,{flag:'wx'});await fs.writeFile(path.join(here,'baseline-manifest.json'),JSON.stringify({createdAt:new Date().toISOString(),scope:'Exact current collector and28-case geometry evidence, unchanged source/legacy accounting; no production mutation.',files:rows},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({preserved:rows.length,collectorSha256:hash(old)}));
