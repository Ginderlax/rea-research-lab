    },
    {
      "id": "grafana.candidate.00426d219ead89cf35f6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Elasticsearch supports the use of filters. You can use them to specify any number of key/value filters, and Grafana applies them automatically to all of your Elasticsearch queries.",
      "headingPath": [
        "Elasticsearch template variables",
        "Use filters"
      ],
      "source": {
        "path": "docs/sources/datasources/elasticsearch/template-variables/index.md",
