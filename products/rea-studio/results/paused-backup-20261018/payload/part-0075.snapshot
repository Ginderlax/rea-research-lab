        "lineStart": 92,
        "lineEnd": 92,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/fundamentals/alert-rule-evaluation/nodata-and-error-states.md#L92-L92"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
