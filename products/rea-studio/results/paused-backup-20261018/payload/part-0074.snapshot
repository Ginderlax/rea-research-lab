    {
      "id": "grafana.candidate.b7f06a6db454bacc2e73",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In custom notification templates, you can use [`.Alert.SilenceURL`](ref:silence-url) to redirect users to the UI where they can silence the given alert.",
      "headingPath": [
        "Configure silences",
        "URL link to a silence form"
      ],
      "source": {
