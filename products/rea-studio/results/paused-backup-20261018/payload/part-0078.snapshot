    },
    {
      "id": "grafana.candidate.f8fd89afe437fbdcd46d",
      "syntaxRole": "list-item",
      "sourceText": "- The `from` field specifies which query reference (refId) to use as the source for the recorded metric.",
      "headingPath": [
        "Grafana-managed endpoints",
        "Alert rules",
        "Example Response:",
        "Recording rules"
      ],
      "source": {
        "path": "docs/sources/shared/alerts/alerting_provisioning.md",
        "gitBlobSha": "aa2d47b881f09b496f3b438a9487a05b56c65ff4",
        "sha256": "3b548e3122c7859f6f6838cf99ef98b72faf15a00837f7eb7cc4ded8eef49dfb",
        "lineStart": 318,
        "lineEnd": 318,
