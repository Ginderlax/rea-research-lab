    {
      "id": "grafana.candidate.06a9292cb52819b6bbcc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "[Explore](../../explore/) takes user-defined correlations to display links inside the visualizations. If a correlation links to a query, you can click on that link to run the related query and see results in [Explore Split View](../../explore/#split-and-compare). If a correlation links to an external URL, you can click on the link to open the URL in a new tab in your browser.",
      "headingPath": [
