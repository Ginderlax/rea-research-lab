import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),sha=bytes=>createHash('sha256').update(bytes).digest('hex');
const source=await fs.readFile(path.join(here,'candidate-isolated.mjs'),'utf8'),baseline=await fs.readFile(path.join(here,'candidate-baseline.mjs'),'utf8');
const section=(text,start,end)=>{const a=text.indexOf(start),b=text.indexOf(end,a+start.length);assert.ok(a>=0&&b>a,'Exact source boundary missing.');return text.slice(a,b).trimEnd();};
const standard=section(baseline,'export function doStandardCalcs(','\nfunction special('),special=section(baseline,'function special(','\nconst specialIds');
assert.equal(section(source,'export function doStandardCalcs(','const selectionUnavailable = Symbol('),standard);
assert.equal(section(source,'function special(','\nconst specialIds'),special);
const sources={},evidence={};
for(const name of ['candidate-baseline.mjs','candidate-isolated.mjs','build-isolated-trial.mjs','verify-candidate.mjs','verify-heldout-selection.mjs','verify-budget.mjs','run-validation.mjs','run-post-checks.mjs'])sources[name]=sha(await fs.readFile(path.join(here,name)));
for(const name of ['candidate-isolated.json','candidate-isolated-selection-heldout.json','candidate-isolated-budget.json','candidate-isolated-validation.interval.json','candidate-isolated-post-checks.interval.json']){const bytes=await fs.readFile(path.join(here,'results',name));evidence[name]={sha256:sha(bytes),receipt:JSON.parse(bytes)};}
const full=evidence['candidate-isolated.json'].receipt,held=evidence['candidate-isolated-selection-heldout.json'].receipt,budget=evidence['candidate-isolated-budget.json'].receipt;
assert.equal(full.implementationSha256,sources['candidate-isolated.mjs']);assert.equal(full.status,'passed');assert.equal(full.failures.length,0);assert.equal(full.comparisons,2910751);assert.equal(full.standardHelperComparisons,14240);assert.equal(full.cacheComparisons,48240);
assert.equal(held.sourceSHA256,sources['candidate-isolated.mjs']);assert.equal(held.failureCount,0);assert.equal(held.comparisons,3888);assert.equal(held.registryComparisons,864);
assert.equal(budget.sourceSHA256,sources['candidate-isolated.mjs']);assert.equal(budget.outputAndInputAndStateExact,true);assert.equal(budget.comparisons,18);assert.equal(budget.boundedFallbackExecutionCount,5);
const failed=await fs.readFile(path.join(here,'results/build-isolated-trial.failed.mjs.snapshot'));assert.equal(sha(failed),'717929c643e92dc17fe067f1fcb289594999719b6aab04d1c50524fe43f027d7');
const corrected=await fs.readFile(path.join(here,'build-isolated-trial.mjs')),snapshot='preserved/stage-executed/build-isolated-trial.corrected.snapshot';
try{assert.equal(sha(await fs.readFile(path.join(here,snapshot))),sha(corrected));}catch(error){if(error.code!=='ENOENT')throw error;await fs.writeFile(path.join(here,snapshot),corrected);}
const receipt={schemaVersion:1,checkedAt:new Date().toISOString(),scope:'Prospective separate single-percentile staged helper; production frozen and prior quiet timing records unchanged.',sources,sourceIdentity:{standardSectionSHA256:sha(standard),completeSharedSpecialSectionSHA256:sha(special),bothSectionsIdenticalToPreservedBaseline:true},evidence,correctedBuilderSnapshot:{path:snapshot,sha256:sha(corrected)},priorBuilderFailure:{path:'results/build-isolated-trial-failure.json',sha256:sha(await fs.readFile(path.join(here,'results/build-isolated-trial-failure.json'))),snapshotSHA256:sha(failed),originalFailureRetained:true},semanticsPassed:true,formalTimingRun:false,performanceEstablished:false,futureTimingRequiresNewCoordinatedQuietWindow:true,selectedForIntegration:null,productionChanged:false,allDocumentedFeaturesEnumerated:false,fullProductComplete:false,universalSuperiorityEstablished:false};
const bytes=JSON.stringify(receipt,null,2)+'\n';await fs.writeFile(path.join(here,'isolated-review.json'),bytes);console.log(JSON.stringify({receipt:path.join(here,'isolated-review.json'),sha256:sha(bytes),candidateSHA256:sources['candidate-isolated.mjs'],fullComparisons:full.comparisons,standardHelpers:full.standardHelperComparisons,heldout:held.comparisons,registry:held.registryComparisons,budget:budget.comparisons,budgetFallbackExecuted:budget.boundedFallbackExecutionCount,formalTimingRun:false}));
import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),lab=path.resolve(here,'../../outputs/rea-research-lab'),app=path.join(lab,'products/rea-studio/apps/metrics'),sha=bytes=>createHash('sha256').update(bytes).digest('hex'),preservation=JSON.parse(await fs.readFile(path.join(here,'baseline-preservation.json')));
assert.equal(sha(await fs.readFile(path.join(app,'native-calculations.mjs'))),preservation.productionSHA256);
for(const [name,record]of Object.entries(preservation.files))assert.equal(sha(await fs.readFile(path.join(here,'preserved',name))),record.sha256);
assert.equal(sha(await fs.readFile(path.join(app,'results/native-calculations-verification.json'))),preservation.files['native-calculations-verification.json'].sha256);
const inventory={};async function walk(folder){for(const entry of await fs.readdir(folder,{withFileTypes:true})){const target=path.join(folder,entry.name);if(entry.isDirectory())await walk(target);else if(entry.isFile()&&entry.name!=='optimization-stage.json'){const bytes=await fs.readFile(target);inventory[path.relative(here,target).replaceAll('\\','/')]={bytes:bytes.length,sha256:sha(bytes)};}}}await walk(here);
const trials=JSON.parse(await fs.readFile(path.join(here,'trials.json')));
for(const trial of trials.trials){const stem='results/'+trial.file.slice(0,-4),name=stem+'.json';if(inventory[name]){const receipt=JSON.parse(await fs.readFile(path.join(here,name)));assert.equal(receipt.implementationSha256,trial.sha256);trial.status=receipt.status;trial.fullReplay={path:name,sha256:inventory[name].sha256,comparisons:receipt.comparisons,standardHelperComparisons:receipt.standardHelperComparisons,cacheComparisonsIncluded:receipt.cacheComparisons,failures:receipt.failures.length,expectedOutputSHA256:receipt.expectedOutputSha256};}for(const suffix of ['-selection-heldout.json','-budget.json']){const extra=stem+suffix;if(inventory[extra]){const result=JSON.parse(await fs.readFile(path.join(here,extra)));assert.equal(result.sourceSHA256,trial.sha256);(trial.additionalEvidence??=[]).push({path:extra,sha256:inventory[extra].sha256,comparisons:result.comparisons,registryComparisons:result.registryComparisons,budgetFallbackExecutionCount:result.boundedFallbackExecutionCount});}}}
const review=JSON.parse(await fs.readFile(path.join(here,'timing-review.json')));
for(const timing of review.timingReceipts){assert.equal(inventory[timing.path].sha256,timing.sha256);for(const [name,fingerprint] of Object.entries(timing.executedSourceSnapshots))assert.equal(inventory[name].sha256,fingerprint);}
assert.equal(inventory[review.failedBuilder.snapshot].sha256,review.failedBuilder.sha256);
const paired=review.timingReceipts;
const isolated=JSON.parse(await fs.readFile(path.join(here,'isolated-review.json')));for(const [name,fingerprint]of Object.entries(isolated.sources))assert.equal(inventory[name].sha256,fingerprint);for(const [name,record]of Object.entries(isolated.evidence))assert.equal(inventory['results/'+name].sha256,record.sha256);
const receipt={schemaVersion:2,checkedAt:new Date().toISOString(),scope:'Ignored source-assisted Metrics optimization stage, production and historical evidence unchanged.',productionSourceSHA256:preservation.productionSHA256,productionVerificationSHA256:preservation.files['native-calculations-verification.json'].sha256,preservedFiles:Object.keys(preservation.files).length,allPreservedFingerprintsVerified:true,trials:trials.trials,inventory,formalPairedTimingStatus:'Two quiet paired sequences preserved and verified; broader and lean trials are not selected. One overlapping sequence is exploratory only.',pairedReceipts:paired,timingReview:{path:'timing-review.json',sha256:inventory['timing-review.json'].sha256,quietWindowClosed:true,fullValidationBeforeFormalTiming:true},prospectiveIsolatedTrial:{path:'isolated-review.json',sha256:inventory['isolated-review.json'].sha256,candidateSHA256:isolated.sources['candidate-isolated.mjs'],semanticsPassed:isolated.semanticsPassed,formalTimingRun:false,performanceEstablished:false},selectedForIntegration:null,productionChanged:false,allDocumentedFeaturesEnumerated:false,fullProductComplete:false,universalSuperiorityEstablished:false};
await fs.writeFile(path.join(here,'optimization-stage.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({receipt:path.join(here,'optimization-stage.json'),sha256:sha(Buffer.from(JSON.stringify(receipt,null,2)+'\n')),preservedFiles:receipt.preservedFiles,validatedTrials:receipt.trials.filter(row=>row.status==='passed').length,formalQuietReceipts:paired.filter(row=>row.classification==='formal-quiet').length,exploratoryTimingReceipts:paired.filter(row=>row.classification==='exploratory-confounded').length}));
