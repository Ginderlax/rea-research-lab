      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.d3d2107320d9424f648f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The feature previously referred to as DataSource Start Pages or Cheat Sheets has been renamed to Query Editor Help, and is now supported in panel query editors (depending on the data source), as well as in Explore.",
      "headingPath": [
        "What's new in Grafana v7.4",
        "Curated dashboards for Google Cloud Monitoring",
        "Query Editor Help"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-4.md",
        "gitBlobSha": "10f50eec0a661654510f63805294c24968acadad",
        "sha256": "edb4cc6f7fd075796d11237820052a62e2220cdfb904cbc4c113af5f6734066d",
        "lineStart": 180,
        "lineEnd": 180,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v7-4.md#L180-L180"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.14751683937aa8de02a0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "[Queries](../../panels-visualizations/query-transform-data/#manage-queries) was updated as a result of this feature.",
      "headingPath": [
        "What's new in Grafana v7.4",
        "Curated dashboards for Google Cloud Monitoring",
        "Query Editor Help"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-4.md",
