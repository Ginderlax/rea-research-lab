import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';
import {render} from '../editor-search-path-fix-next/products/rea-studio/apps/editor/client.mjs';import {handle} from '../editor-search-path-fix-next/products/rea-studio/apps/editor/server.mjs';import {createWorkspace} from '../editor-search-path-fix-next/products/rea-studio/lib/storage.mjs';
class Element{constructor(tag){this.tagName=tag;this.children=[];this.attributes={};this.value='';this.textContent='';this.disabled=false;this.checked=false;this.style={};this.selectionStart=this.selectionEnd=0;this.selectionCalls=[];}append(...nodes){this.children.push(...nodes);}prepend(...nodes){this.children.unshift(...nodes);}replaceChildren(...nodes){this.children=[...nodes];}insertBefore(node,before){const i=this.children.indexOf(before);this.children.splice(i<0?this.children.length:i,0,node);}setAttribute(name,value){this.attributes[name]=value;}focus(){this.focused=true;}setSelectionRange(start,end){this.selectionStart=start;this.selectionEnd=end;this.selectionCalls.push([start,end]);}}
const all=root=>[root,...root.children.flatMap(all)],field=(root,label)=>all(root).find(node=>node.attributes['aria-label']===label),button=(root,label)=>all(root).find(node=>node.tagName==='button'&&node.textContent===label),deferred=()=>{let resolve;const promise=new Promise(r=>resolve=r);return{promise,resolve};};let sequence=0;
async function fixture(t,id,hold=false){const folder=path.join(import.meta.dirname,'runs',id+'-'+Date.now()+'-'+sequence++),workspace=await createWorkspace(path.join(folder,'workspace'));await fs.writeFile(workspace.resolve('a.txt'),'🧬target saved A\n');await fs.writeFile(workspace.resolve('b.txt'),'second target saved B\n');const previous={document:globalThis.document,window:globalThis.window};globalThis.document={createElement:tag=>new Element(tag)};globalThis.window={confirm:()=>false};const root=new Element('main'),arrived=deferred(),release=deferred(),calls=[];let searches=0;const api=async(action,input)=>{calls.push({action,input:structuredClone(input)});const result=action==='gitStatus'?{initialized:false}:await handle({action,input,workspace});if(action==='search'&&++searches===1&&hold){arrived.resolve();await release.promise;}return result;};const dispose=await render(root,api);t.after(()=>{release.resolve();dispose();globalThis.document=previous.document;globalThis.window=previous.window;});await button(root,'b.txt').onclick();field(root,'Find in saved files').value='target';return{folder,workspace,root,arrived,release,dispose,calls,observe:async extra=>{const editor=field(root,'File contents'),result={...extra,editorValue:editor.value,selectionCalls:editor.selectionCalls,searchButtons:all(field(root,'Workspace search results')).filter(node=>node.tagName==='button').map(node=>node.textContent),status:all(root).filter(node=>node.attributes.role==='status').map(node=>node.textContent),calls};await fs.writeFile(path.join(folder,'observation.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});return result;}};}
test('held search response does not publish after a case-option generation change',async t=>{const f=await fixture(t,'held-search-option',true),pending=button(f.root,'Search saved files').onclick();await f.arrived.promise;const caseControl=field(f.root,'Match case in workspace search');caseControl.checked=false;caseControl.onchange();f.release.resolve();await pending;const observation=await f.observe({caseChanged:true});assert.deepEqual(observation.searchButtons,[]);assert.equal(observation.editorValue,'second target saved B\n');assert.ok(observation.status.some(value=>value.includes('Search options changed')));assert.equal(button(f.root,'Search saved files').disabled,false);});
test('newer search response remains published when an older held response settles',async t=>{const f=await fixture(t,'held-search-newer',true),pending=button(f.root,'Search saved files').onclick();await f.arrived.promise;const query=field(f.root,'Find in saved files');query.value='second';query.oninput();await button(f.root,'Search saved files').onclick();f.release.resolve();await pending;const observation=await f.observe({newerQuery:'second'});assert.deepEqual(observation.searchButtons,['b.txt:1:1']);assert.equal(observation.editorValue,'second target saved B\n');assert.equal(button(f.root,'Search saved files').disabled,false);});
test('disposal prevents a held search response from publishing rows',async t=>{const f=await fixture(t,'held-search-disposal',true),pending=button(f.root,'Search saved files').onclick();await f.arrived.promise;f.dispose();f.release.resolve();await pending;const observation=await f.observe({disposed:true});assert.deepEqual(observation.searchButtons,[]);assert.equal(observation.editorValue,'second target saved B\n');});
test('ordinary saved-result navigation selects exact positions and preserves an existing unsaved draft',async t=>{const f=await fixture(t,'normal-draft-navigation'),editor=field(f.root,'File contents');editor.value='private unsaved B draft';editor.oninput();await button(f.root,'Search saved files').onclick();await button(f.root,'a.txt:1:3').onclick();assert.equal(editor.value,'🧬target saved A\n');assert.deepEqual(editor.selectionCalls.at(-1),[2,8]);const selections=editor.selectionCalls.length;await button(f.root,'b.txt:1:8').onclick();const observation=await f.observe({normalNavigation:true});assert.equal(observation.editorValue,'private unsaved B draft');assert.equal(editor.selectionCalls.length,selections);assert.ok(observation.status.some(value=>value.includes('current draft was retained')));assert.equal(await fs.readFile(f.workspace.resolve('b.txt'),'utf8'),'second target saved B\n');assert.ok(button(f.root,'b.txt •'));});
test('changed saved bytes after search open with revision warning and no stale selection',async t=>{const f=await fixture(t,'changed-revision');await button(f.root,'Search saved files').onclick();await fs.writeFile(f.workspace.resolve('a.txt'),'changed disk target\n');await button(f.root,'a.txt:1:3').onclick();const observation=await f.observe({diskChanged:true});assert.equal(observation.editorValue,'changed disk target\n');assert.deepEqual(observation.selectionCalls,[]);assert.ok(observation.status.some(value=>value.includes('saved-file snapshot')));});
