    {
      "id": "grafana.candidate.2d38d32c5911ec4092b3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For the callback URL to be correct, it might be necessary to set the `root_url` option in the `[server]`section of the Grafana configuration file. For example, if you are serving Grafana behind a proxy.",
