import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import{createHash}from'node:crypto';const old=path.join(import.meta.dirname,'editor-search-next'),root=path.join(import.meta.dirname,'editor-search-fix-next'),sha=b=>createHash('sha256').update(b).digest('hex'),manifestBytes=await fs.readFile(path.join(old,'freeze-manifest.json')),manifest=JSON.parse(manifestBytes);assert.equal(sha(manifestBytes),'44e8efd72f09c7cc5caa598f43dbe099dd73982477249ecfed2fddfb2a26a7a6');
await fs.mkdir(root,{recursive:true});let files=0;for(const[name,row]of Object.entries(manifest.inventory)){const b=await fs.readFile(path.join(old,name));assert.equal(b.length,row.bytes);assert.equal(sha(b),row.sha256);if(name.startsWith('products/')||['baseline.json','SEARCH.md','collect-final.mjs','original-search-comparison.mjs','preserve-initial-search.mjs'].includes(name)){const target=path.join(root,name);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b,{flag:'wx'});files++;}}
await fs.writeFile(path.join(root,'prior-stage-manifest.json.snapshot'),manifestBytes,{flag:'wx'});await fs.writeFile(path.join(root,'prior-stage-reference.json'),JSON.stringify({schema:'rea-editor-search-fix-prior-reference/v1',priorStage:old,manifestSHA256:sha(manifestBytes),all140PriorArtifactsAuthenticated:true,priorReceiptSHA256:manifest.receiptSHA256,priorFullTreeRecopied:false,priorFormalTests:37,priorCandidateAccepted:false,knownFinding:'Search-result open() published an older file before validating a changed originating search generation.',productionUnchanged:true},null,2)+'\n',{flag:'wx'});await fs.writeFile(path.join(root,'prepare.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});console.log(JSON.stringify({status:'PASS',copiedFiles:files,root}));
