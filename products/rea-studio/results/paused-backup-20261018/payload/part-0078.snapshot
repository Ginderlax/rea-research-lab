    {
      "id": "grafana.candidate.b63473c7c3af2cf70d9b",
      "syntaxRole": "list-item",
      "sourceText": "- Error responses break the assumption that the query returns tabular data.",
      "headingPath": [
        "SQL expressions",
        "Known limitations",
        "Schema changes and missing data"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/sql-expressions/index.md",
        "gitBlobSha": "3e545e4b2f9dfa0e933cbe79b173d05a64036723",
