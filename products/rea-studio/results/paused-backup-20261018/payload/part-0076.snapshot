    },
    {
      "id": "grafana.candidate.de64e1b9e343a9466251",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Some functions accept a second argument, which can itself be another function that returns a series. If you need to add a second argument that is a function, Grafana recommends using a series reference from a second query instead of embedding the function directly.",
      "headingPath": [
        "Graphite query editor",
        "Functions"
      ],
