  else{Object.assign(record,await browserPrerequisites());const dataRoot=fs.mkdtempSync(path.join(fs.realpathSync(process.env.RUNNER_TEMP),'rea-new-todo-synthetic-browser-'));record.ownedDataRoot=dataRoot;await run([path.join(tools,'node_modules/playwright/cli.js'),'test','--config',path.join(tools,'playwright.notes-new-todo.config.mjs')],11*60000,'eight-new-todo-real-browser-cases',{REA_BROWSER_EVIDENCE:evidence,REA_BROWSER_DATA_ROOT:dataRoot});record.browser=browserResults();record.productTests=8;}
