    {
      "id": "grafana.candidate.3d201fc4de850616c666",
      "syntaxRole": "list-item",
      "sourceText": "- **Group interval**: `2m`. This ensures follow-up notifications for the same alert group will be sent at intervals of 2 minutes. While the default is 5 minutes, we chose 2 minutes here to provide faster feedback for demonstration purposes.",
      "headingPath": [
        "Set up the Grafana stack",
        "Setting up alert rule grouping",
        "Notification Policy"
      ],
