      "id": "grafana.candidate.aa64e11580eb7d22ea53",
      "syntaxRole": "table-row",
      "sourceText": "| `hosted_domain`              | No       | Yes                | Specifies the domain to restrict access to users from that domain. This value is appended to the authorization request using the `hd` parameter.                                                                                                                                                                                                                                                                                                                                                |                                                    |",
      "headingPath": [
        "Configure Google OAuth authentication",
        "Configuration options"
      ],
      "source": {
