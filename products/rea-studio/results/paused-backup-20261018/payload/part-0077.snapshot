    {
      "id": "grafana.candidate.425fc0a54db8625c3d6e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We only support one private key format: PKCS#8.",
      "headingPath": [
        "Troubleshooting",
        "Troubleshoot SAML authentication in Grafana",
        "SAML authentication fails with error:"
      ],
