    {
      "id": "grafana.candidate.2497470c9cf3182750cb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "View read-only query definitions for provisioned alerts from the Alert rule details page. Check quickly if your alert rule queries are correct, without diving into your \"as-code\" repository for rule definitions.",
      "headingPath": [
        "What's new in Grafana v9.4",
        "Alerting",
        "Alerting: alert rules",
        "View query definitions for provisioned alerts"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-4.md",
