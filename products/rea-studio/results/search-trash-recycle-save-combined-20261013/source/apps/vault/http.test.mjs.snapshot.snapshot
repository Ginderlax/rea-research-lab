import test,{after} from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import {spawn} from 'node:child_process';
import {here,temp,original,observations,pass,observationsDirectory} from './harness.mjs';
const httpObservations=[];
after(async()=>{await fs.mkdir(observationsDirectory,{recursive:true});await fs.writeFile(path.join(observationsDirectory,'history-http.json'),JSON.stringify({httpObservations,originalProcessExecutions:observations.length,observations},null,2));console.log('REA_KEEPASS_HISTORY_HTTP '+JSON.stringify({hostProcesses:httpObservations.filter(x=>x.event==='host').length,originalProcessExecutions:observations.length,detail:path.join(observationsDirectory,'history-http.json')}))});
async function host(directory){const env={...process.env};delete env.NODE_TEST_CONTEXT;const p=spawn(process.execPath,[path.join(here,'http-runner.mjs'),directory],{env,windowsHide:true,stdio:['ignore','pipe','pipe','ipc']});let logs='',bytes=0,ready,rejectReady;
 const promise=new Promise((r,j)=>{ready=r;rejectReady=j}),timer=setTimeout(()=>{p.kill();rejectReady(new Error('Stage host deadline exceeded'))},30000);
 for(const stream of [p.stdout,p.stderr])stream.on('data',c=>{bytes+=c.length;if(bytes>1024*1024){p.kill();rejectReady(new Error('Stage host logs exceed bound'))}else logs+=c.toString('utf8')});
 p.once('error',rejectReady);p.once('exit',code=>{clearTimeout(timer);if(!ready)rejectReady(new Error('Stage host exited '+code+logs))});
 p.once('message',value=>{ready(value);ready=null});const value=await promise;httpObservations.push({event:'host',pid:p.pid,url:value.url});
 let closed=false;return {...value,async close(){if(closed)return;closed=true;await new Promise((r,j)=>{const stopper=setTimeout(()=>{p.kill();j(new Error('Stage host cleanup deadline'))},5000);p.once('exit',code=>{clearTimeout(stopper);clearTimeout(timer);httpObservations.push({event:'closed',pid:p.pid,code,logs});code===0?r():j(new Error('Stage host exit '+code+logs))});p.send('close')})},async api(action,input={},status=200){const response=await fetch(value.url+'/api/vault/'+action,{method:'POST',headers:{'content-type':'application/json','x-rea-token':value.token},body:JSON.stringify(input),signal:AbortSignal.timeout(10000)}),body=await response.json();assert.equal(response.status,status,action+': '+JSON.stringify(body));httpObservations.push({event:'api',action,status:response.status});return status===200?body.result:body}};
}
test('disk HTTP edit/history/confirmed restore survive genuine process restart and release opens native export',async t=>{
 const dir=await temp(t),dataDir=path.join(dir,'state');let current=await host(dataDir);t.after(()=>current.close());await current.api('create',{password:pass});
 const seed={title:'HTTP history',username:'synthetic-user',password:'HTTP first synthetic secret',url:'https://example.invalid',group:'Parent/Child',notes:'initial λ🎛',totpSecret:''};const {id}=await current.api('save',seed);await current.api('save',{...seed,id,password:'HTTP second synthetic secret'});const oldList=await current.api('historyList',{id});assert.equal(oldList.revisions.length,1);assert.equal(JSON.stringify(oldList).includes('synthetic secret'),false);assert.equal(JSON.stringify(oldList).includes(seed.notes),false);
 const record=path.join(dataDir,'vault/records/vault.database.json'),before=await fs.readFile(record,'utf8');assert.equal(before.includes(seed.password),false);assert.equal(before.includes(seed.notes),false);
 for(const input of [{id,...oldList.revisions[0],confirm:false},{id,...oldList.revisions[0],index:5,confirm:true},{id,...oldList.revisions[0],revision:'0'.repeat(64),confirm:true}])await current.api('historyRestore',input,400);assert.equal(await fs.readFile(record,'utf8'),before);
 await current.close();current=await host(dataDir);assert.equal((await current.api('status')).locked,true);await current.api('historyList',{id},400);await current.api('unlock',{password:'synthetic-wrong-master'},400);assert.equal((await current.api('status')).locked,true);await current.api('unlock',{password:pass});const reloaded=await current.api('historyList',{id});assert.deepEqual(reloaded,oldList);
 const preview=await current.api('historyRead',{id,...reloaded.revisions[0]});assert.equal(preview.entry.password,seed.password);await current.api('historyRestore',{id,...reloaded.revisions[0],confirm:true});assert.equal((await current.api('read',{id})).entry.password,seed.password);assert.equal((await current.api('historyList',{id})).revisions.length,2);
 const exported=await current.api('exportKdbx',{password:pass,options:{kdf:'aes',rounds:100}}),target=path.join(dir,'native-http.kdbx');await fs.writeFile(target,Buffer.from(exported.fileBase64,'base64'));const opened=await original(dir,{mode:'read',database:target});assert.equal(opened.entry.fields.Password.value,seed.password);assert.equal(opened.history.length,2);assert.equal(opened.history[1].fields.Password.value,'HTTP second synthetic secret');assert.equal(opened.entry.fields.Notes.value,seed.notes);
 await current.close();current=await host(dataDir);await current.api('unlock',{password:pass});assert.equal((await current.api('read',{id})).entry.password,seed.password);assert.equal((await current.api('historyList',{id})).revisions.length,2);
});
test('master-key rotation preserves history through restart, invalidates old private selection token and rejects old password',async t=>{
 const dir=await temp(t),dataDir=path.join(dir,'state');let current=await host(dataDir);t.after(()=>current.close());await current.api('create',{password:pass});const seed={title:'Rotation history',password:'first synthetic',notes:'private notes',group:'',totpSecret:''};const {id}=await current.api('save',seed);await current.api('save',{...seed,id,password:'second synthetic'});const old=(await current.api('historyList',{id})).revisions[0];
 const record=path.join(dataDir,'vault/records/vault.database.json'),before=await fs.readFile(record,'utf8');await current.api('changePassword',{currentPassword:'wrong synthetic password',newPassword:'Synthetic-new-history-master'},400);assert.equal(await fs.readFile(record,'utf8'),before);
 await current.api('changePassword',{currentPassword:pass,newPassword:'Synthetic-new-history-master'});await current.api('historyRestore',{id,...old,confirm:true},400);const fresh=(await current.api('historyList',{id})).revisions[0];assert.notEqual(fresh.revision,old.revision);assert.equal((await current.api('historyRead',{id,...fresh})).entry.password,seed.password);
 await current.close();current=await host(dataDir);await current.api('unlock',{password:pass},400);await current.api('unlock',{password:'Synthetic-new-history-master'});assert.equal((await current.api('read',{id})).entry.password,'second synthetic');assert.deepEqual((await current.api('historyList',{id})).revisions[0],fresh);await current.api('historyRestore',{id,...fresh,confirm:true});assert.equal((await current.api('read',{id})).entry.password,seed.password);
});
