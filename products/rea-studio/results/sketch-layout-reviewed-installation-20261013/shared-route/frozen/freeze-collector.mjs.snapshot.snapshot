import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const base=path.resolve(import.meta.dirname,'..'),root=path.join(base,'work/sketch-layout-static-route-next'),lab=path.join(base,'outputs/rea-research-lab/products/rea-studio'),sha=b=>createHash('sha256').update(b).digest('hex'),bad='runs/baseline-fixed-test-2026-10-13T03-01-48.330Z',good='runs/corrected-2026-10-13T03-01-48.918Z';const json=n=>JSON.parse(fs.readFileSync(path.join(root,n))),negative=json(bad+'/attempt.json'),positive=json(good+'/attempt.json');assert.deepEqual(negative.before,negative.after);assert.deepEqual(positive.before,positive.after);assert.equal(negative.summary.pass,1);assert.equal(negative.summary.fail,1);assert.equal(positive.summary.pass,2);assert.equal(positive.summary.fail,0);const changed=negative.before.filter(r=>positive.after.find(n=>n.path===r.path)?.sha256!==r.sha256);assert.deepEqual(changed.map(r=>r.path),['products/rea-studio/server.mjs']);const before=fs.readFileSync(path.join(lab,'server.mjs'),'utf8'),after=fs.readFileSync(path.join(root,'products/rea-studio/server.mjs'),'utf8'),line="        ['/apps/sketch/layout.mjs', ['apps/sketch/layout.mjs', 'text/javascript; charset=utf-8']],\n";assert.equal(after.split(line).length,2);assert.equal(after.replace(line,''),before);for(const r of positive.after){const b=fs.readFileSync(path.join(root,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);}const runtime={path:'products/rea-studio/server.mjs',before:{bytes:Buffer.byteLength(before),sha256:sha(Buffer.from(before))},after:{bytes:Buffer.byteLength(after),sha256:sha(Buffer.from(after))},exactInsertedLine:line,inverseReconstructsCurrentServer:true};const record={schema:'rea-sketch-layout-static-route-validation/v1',at:new Date().toISOString(),sourceOnlyPrivateStage:false,httpFiniteAcceptance:true,baseline:{run:bad,summary:negative.summary,sourceFiles:10,sourceStable:true},current:{run:good,s