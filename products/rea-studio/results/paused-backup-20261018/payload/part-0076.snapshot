    },
    {
      "id": "grafana.candidate.1590b3d22733674d6290",
      "syntaxRole": "table-row",
      "sourceText": "| **Profile type** | None                | Returns the profile types available from the data source. The drop-down displays a readable label, while the variable value is the full profile type ID, such as `process_cpu:cpu:nanoseconds:cpu:nanoseconds`. |",
      "headingPath": [
        "Pyroscope template variables",
        "Query variable types"
      ],
      "source": {
        "path": "docs/sources/datasources/pyroscope/template-variables/index.md",
        "gitBlobSha": "caf634b1a820210b00d4bdb88707f26b3153956d",
        "sha256": "a557cc0df0191ca0078ee4f1d6c14f8525e2489d04c09038c1f384ac8d67663e",
        "lineStart": 32,
        "lineEnd": 32,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/pyroscope/template-variables/index.md#L32-L32"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.43b13c5e2b425ed4d20d",
      "syntaxRole": "table-row",
      "sourceText": "| **Label**        | Profile type        | Returns the label names available for the selected profile type, such as `service_name`, `namespace`, and `region`.                                                                                             |",
      "headingPath": [
        "Pyroscope template variables",
        "Query variable types"
      ],
      "source": {
        "path": "docs/sources/datasources/pyroscope/template-variables/index.md",
