    },
    {
      "id": "grafana.candidate.63328869135fb898e78f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Where _`<SECTION NAME>`_ is the text within the square brackets (`[` and `]`) in the configuration file. All letters must be uppercase, periods (`.`) and dashes (`-`) must replaced by underscores (`_`). For example, if you have these configuration settings:",
      "headingPath": [
        "Configure Grafana",
        "Override configuration with environment variables"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
