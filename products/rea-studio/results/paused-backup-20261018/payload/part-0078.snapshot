      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.bd0eaa9bead0816570b3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To learn how to activate streaming, refer to [Streaming](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/tempo/configure-tempo-data-source/#streaming) in the Tempo data source documentation.",
      "headingPath": [
        "Before you begin",
