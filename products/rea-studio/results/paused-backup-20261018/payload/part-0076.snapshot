    {
      "id": "grafana.candidate.9306b1413858e7b81a63",
      "syntaxRole": "table-row",
      "sourceText": "| `$__timeTo()`                             | Replaces the value with the end of the currently active time selection (RFC3339Nano). Example: `'2020-07-13T20:19:09.254Z'`.                                                                                  |",
      "headingPath": [
        "PostgreSQL query editor",
