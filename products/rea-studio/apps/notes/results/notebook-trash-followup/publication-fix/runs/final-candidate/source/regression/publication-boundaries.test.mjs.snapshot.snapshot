import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import {ui,memory,gate,find} from './ui-fixture.mjs';
const observations=[];
test('enabled typing while Save response is held preserves all four fields and permits saving the newer revision',async t=>{
 const g=gate();let hold=false;const f=await ui(t,async({action})=>{if(action==='save'&&hold){g.enter();await g.held;}});await f.open();hold=true;const pending=f.click(f.byText('Save note'));await g.started;
 for(const [label,value]of[['Note title','Retained title'],['Note tags','new, tags'],['Markdown note','Retained body']])f.type(f.byLabel(label),value);f.type(f.byLabel('Notebook'),f.parent);hold=false;g.release();await pending;
 assert.equal(f.byLabel('Note title').value,'Retained title');assert.equal(f.byLabel('Note tags').value,'new, tags');assert.equal(f.byLabel('Notebook').value,f.parent);assert.equal(f.byLabel('Markdown note').value,'Retained body');assert.equal(f.byText('Save note').disabled,false);
 await f.click(f.byText('Save note'));const saved=f.read().notes[f.note.id];assert.equal(saved.body,'Retained body');assert.equal(saved.title,'Retained title');assert.equal(saved.notebookId,f.parent);assert.deepEqual(saved.tags,['new','tags']);assert.equal(saved.revision,3);observations.push({case:'same-editor four fields',revision:saved.revision,passed:true});
});
test('edit then undo during Save still retains the enabled draft and dirty policy',async t=>{
 const g=gate();let hold=false;const f=await ui(t,async({action})=>{if(action==='save'&&hold){g.enter();await g.held;}});await f.open();f.manage();hold=true;const pending=f.click(f.byText('Save note'));await g.started;f.type(f.byLabel('Markdown note'),'Temporary edit');f.type(f.byLabel('Markdown note'),'Saved body');hold=false;g.release();await pending;
 const count=f.calls.length;await f.click(f.byText('Move notebook to trash'));assert.equal(f.calls.length,count);assert.equal(f.read().notes[f.note.id].deletedAt,null);assert.equal(f.byLabel('Markdown note').value,'Saved body');observations.push({case:'revision prevents edit-undo publication',passed:true});
});
test('New note selection during Save prevents previous note publication into the new draft',async t=>{
 const g=gate();let hold=false;const f=await ui(t,async({action})=>{if(action==='save'&&hold){g.enter();await g.held;}});await f.open();hold=true;const pending=f.click(f.byText('Save note'));await g.started;await f.click(f.byText('New note'));f.type(f.byLabel('Note title'),'Owned new note');f.type(f.byLabel('Markdown note'),'Independent new body');hold=false;g.release();await pending;
 assert.equal(f.byLabel('Note title').value,'Owned new note');assert.equal(f.byLabel('Markdown note').value,'Independent new body');await f.click(f.byText('Save note'));const notes=Object.values(f.read().notes);assert.equal(notes.length,2);assert.equal(notes.find(n=>n.id!==f.note.id).body,'Independent new body');assert.equal(f.read().notes[f.note.id].body,'Saved body');observations.push({case:'new-note selection',passed:true});
});
test('typing while post-Save refresh is held retains body and dirty status',async t=>{
 const g=gate();let hold=false;const f=await ui(t,async({action})=>{if(action==='list'&&hold){g.enter();await g.held;}});await f.open();hold=true;const pending=f.click(f.byText('Save note'));await g.started;f.type(f.byLabel('Markdown note'),'Draft during refresh');hold=false;g.release();await pending;assert.equal(f.byLabel('Markdown note').value,'Draft during refresh');assert.equal(find(f.root,n=>n.attributes.role==='status').textContent,'Unsaved draft. Save to keep this note.');await f.click(f.byText('Save note'));assert.equal(f.read().notes[f.note.id].body,'Draft during refresh');observations.push({case:'post-Save refresh typing',passed:true});
});
test('older post-Save active list cannot republish a note after a newer notebook-trash refresh',async t=>{
 const g=gate();let hold=false;const f=await ui(t,async({action})=>{if(action==='list'&&hold){hold=false;g.enter();await g.held;}});await f.open();f.manage();hold=true;const pending=f.click(f.byText('Save note'));await g.started;await f.click(f.byText('Move notebook to trash'));assert.equal(find(f.root,n=>n.tagName==='button'&&n.textContent.startsWith('A note ·')),null);g.release();await pending;
 const republished=Boolean(find(f.root,n=>n.tagName==='button'&&n.textContent.startsWith('A note ·')));observations.push({case:'late old list after cascade',republished,backendDeleted:Boolean(f.read().notes[f.note.id].deletedAt),saveEnabled:!f.byText('Save note').disabled,calls:f.calls});assert.equal(republished,false);assert.equal(f.byText('Save note').disabled,true);
});
test('Restore request captures id, revision and confirmation before yielding to the queue',async()=>{
 const f=memory();let a=await f.call('notebook-create',{title:'A',revision:0}),b=await f.call('notebook-create',{title:'B',revision:a.revision});await f.call('notebook-trash',{id:a.notebook.id,revision:b.revision,confirmed:true});let state=await f.call('notebook-list');await f.call('notebook-trash',{id:b.notebook.id,revision:state.revision,confirmed:true});state=await f.call('notebook-list');const request={id:a.notebook.id,revision:state.revision,confirmed:true},pending=f.call('notebook-restore',request);request.id=b.notebook.id;request.revision=-1;request.confirmed=false;await pending;state=await f.call('notebook-list');assert.equal(state.notebooks.find(n=>n.id===a.notebook.id).trashed,false);assert.equal(state.notebooks.find(n=>n.id===b.notebook.id).trashed,true);observations.push({case:'captured restore primitives',passed:true});
});
test('older notebook-list completion cannot overwrite newer trashed organization after the second refresh await',async t=>{
 const g=gate();let hold=false;const f=await ui(t,async({action})=>{if(action==='notebook-list'&&hold){hold=false;g.enter();await g.held;}});await f.open();f.manage();hold=true;const pending=f.click(f.byText('Save note'));await g.started;await f.click(f.byText('Move notebook to trash'));const choice=f.byLabel('Manage notebook');assert.match(choice.options.find(o=>o.value===f.parent).textContent,/trash/);g.release();await pending;assert.match(choice.options.find(o=>o.value===f.parent).textContent,/trash/);assert.equal(f.byText('Save note').disabled,true);assert.ok(f.read().notes[f.note.id].deletedAt);observations.push({case:'second refresh await generation',passed:true});
});
test.after(async()=>{const dir=new URL(process.env.NOTES_REVIEW_OUTPUT??'../.local/observations/',import.meta.url);await fs.mkdir(dir,{recursive:true});await fs.writeFile(new URL('publication-boundaries.json',dir),JSON.stringify(observations,null,2)+'\n');});
