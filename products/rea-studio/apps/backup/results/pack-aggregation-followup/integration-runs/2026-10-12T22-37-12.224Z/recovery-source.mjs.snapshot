import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import {createHash} from 'node:crypto';
import {pathToFileURL} from 'node:url';
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab'),studio=path.join(lab,'products/rea-studio'),publicRoot=path.join(studio,'apps/backup/results/pack-aggregation-followup'),failed=path.join(publicRoot,'collector-failed-64'),sha=b=>createHash('sha256').update(b).digest('hex');
const failureBytes=await fs.readFile(path.join(failed,'preservation-manifest.json'));assert.equal(sha(failureBytes),'4cd723fa5998643e2b327ea8173901723c06f17c699c52bda1890c64374b4a02');const failure=JSON.parse(failureBytes);assert.equal(failure.snapshots.length,50);for(const e of failure.snapshots){const b=await fs.readFile(path.join(failed,e.path));assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256);}
const attemptBytes=await fs.readFile(path.join(failed,'attempt.json')),attempt=JSON.parse(attemptBytes);assert.deepEqual(attempt.summary,{tests:64,pass:64,fail:0,cancelled:0,skipped:0,todo:0});assert.equal(attempt.exitCode,0);assert.equal(attempt.sourceStable,true);assert.deepEqual(attempt.before,attempt.after);assert.equal(attempt.before.length,42);for(const e of attempt.before){const b=await fs.readFile(path.join(studio,e.path));assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256);}
const helperPath=path.join(studio,'scripts/read-rabin-tap.mjs'),helperBytes=await fs.readFile(helperPath);assert.equal(sha(helperBytes),'a7068f3e4d8db328636e2daa1e9cd55a7c5d7327320f19edeedc88ed28466dba');const {collect,unescapeTapJson}=await import(pathToFileURL(helperPath));const stdout=await fs.readFile(path.join(failed,'stdout.txt')),raw=stdout.toString();const markers=label=>[...raw.matchAll(new RegExp('^# (\\{"'+label+'":.+\\})$','gm'))].map(m=>JSON.parse(unescapeTapJson(m[1]))[label]);
const packPolicy=markers('nativePackPolicyObservation'),host=[collect(raw,'nativePackHostObservation')],smallMutation=markers('nativeSmallMutationObservation'),ownership=collect(raw,'packOperationOwnershipObservations'),mutationFixture=[collect(raw,'nativeMutationFixture')],compressionOriginal=collect(raw,'originalCompressionReviewObservations'),corruptPack=markers('mutatedPackStructure'),corruptionCases=[...raw.matchAll(/^# (\{"case":.+\})$/gm)].map(m=>JSON.parse(unescapeTapJson(m[1])));
assert.equal(packPolicy.filter(o=>o.phase==='first-snapshot').length,3);for(const o of packPolicy.filter(o=>o.phase==='first-snapshot')){assert.equal(o.allStorageHeaderPayloadAndIndexVerified,true);assert.equal(o.dataPacks,1);assert.equal(o.uniqueDataBlobs,2);assert.equal(o.dataRows.length,2);}assert.equal(packPolicy.filter(o=>o.phase==='repeat-snapshot').length,4);for(const o of packPolicy.filter(o=>o.phase==='repeat-snapshot')){assert.equal(o.addedDataPacks,0);assert.equal(o.addedDataRows,0);}for(const key of ['restartPersistence','exactDataPackAndRowDedup','httpRestoreBytesAndMtime','originalRestoreBytes'])assert.equal(host[0][key],true);assert.equal(host[0].commands.length,2);assert.equal(smallMutation.length,2);assert.equal(ownership.length,17);assert.equal(mutationFixture[0].sha256,'30ef6132bb13a7945b1f5c5d8155ccc607a315f1fc5272f7f560b3bac491c366');assert.equal(compressionOriginal.length,17);assert.equal(compressionOriginal.filter(o=>o.exitCode===1).length,7);assert.equal(corruptPack.length,5);for(const o of corruptPack){assert.equal(o.otherCiphertextsPreserved,true);assert.equal(o.recomputedOffsets,true);assert.equal(o.unchangedRows,o.blobRows-1);}for(const name of ['index-length','payload-mac','header-mac','frame-magic','frame-truncated-tree','decoded-budget']){const o=corruptionCases.find(o=>o.case===name);assert.ok(o);assert.equal(o.restoreDestinationCreated,false);assert.deepEqual(o.appLocksBeforeOriginal,[]);}const boundary=corruptionCases.find(o=>o.case==='decoded-metadata-budget');assert.equal(boundary.originalAccepts,true);assert.equal(boundary.candidateAccepts,false);
const preservationBytes=await fs.readFile(path.join(publicRoot,'preservation-manifest.json'));assert.equal(sha(preservationBytes),'77228c9ebbac44fa66f5eac9adab810038da21b46c57749098dec9ed4daa32e0');const sourceRunnerBytes=await fs.readFile(path.join(failed,'verify-backup-pack-integration.mjs.snapshot')),recoverySource=await fs.readFile(import.meta.filename);assert.equal(sha(await fs.readFile(process.execPath)),attempt.runtime.sha256);
const receipt={schema:'rea-backup-pack-integration-validation/v1',startedAtUtc:attempt.startedAtUtc,completedAtUtc:attempt.completedAtUtc,summary:attempt.summary,durationMs:attempt.durationMs,exitCode:0,sourceStable:true,implementationFingerprints:attempt.before,selectedTests:attempt.arguments.slice(4),observations:{packPolicy,host,smallMutation,ownership,mutationFixture,compressionOriginal,corruptPack,corruptionCases},runnerSHA256:sha(sourceRunnerBytes),runtime:attempt.runtime,arguments:attempt.arguments,preservationSHA256:sha(preservationBytes),adaptation:{runtimeChanged:true,packAggregationIntegrated:true,dataPackTargetBytes:16777216,overlapRejectedBeforeMutation:true,sourceMutationFixtureOnly:'4 MiB+1 to owned deterministic 24 MiB+1; generic authenticated structure/dedup and all original check/restore assertions retained',existingOriginalCheckRestoreAssertionsRetained:true,corruptionFixture:'Single indexed blob mutation in an aggregate pack; other ciphertexts preserved and all offsets recomputed.'},collectorRecovery:{recoveredAtUtc:new Date().toISOString(),behaviourTestsRerun:false,testSourcesRemainExact:true,sourceRunnerSHA256:sha(sourceRunnerBytes),recoveryRunnerSHA256:sha(recoverySource),tapHelperSHA256:sha(helperBytes),originalRawSHA256:sha(stdout),failedCollectorPreservationSHA256:sha(failureBytes),failedCollectorExitCode:1,testChildExitCode:0,scope:'Reverses pinned Node TAP escaping in the already source-stable passing64 raw transcript. This is record parsing, not another behavioural or performance run.'},collectionScope:'64 selected production integration checks; complete Studio validation separately runs all current Backup tests.',limits:{childDeadlineMs:900000,stdoutBytes:16777216,stderrBytes:4194304,selectedSourceInventoryOnly:true,rootChildKillOnlyNoDescendantIsolationClaim:true,cooperativeTrustedLocalOriginals:true},fullParity:false,universalSuperiority:false,performanceCompared:false};
const runName='2026-10-12T22-37-12.224Z',retained=[];async function save(relative,b){const filename=path.join(publicRoot,relative);await fs.mkdir(path.dirname(filename),{recursive:true});await fs.writeFile(filename,b,{flag:'wx'});retained.push({path:relative,bytes:b.length,sha256:sha(b)});}
for(const e of failure.snapshots.filter(e=>!e.path.startsWith('collector-process.')))await save('integration-runs/'+runName+'/'+e.path,await fs.readFile(path.join(failed,e.path)));
await save('integration-runs/'+runName+'/recovery-source.mjs.snapshot',recoverySource);await save('integration-runs/'+runName+'/tap-helper.mjs.snapshot',helperBytes);const receiptBytes=Buffer.from(JSON.stringify(receipt,null,2)+'\n');await save('integration-runs/'+runName+'/validation.json',receiptBytes);await fs.writeFile(path.join(publicRoot,'integration-validation.json'),receiptBytes,{flag:'wx'});const runManifestBytes=Buffer.from(JSON.stringify({schema:'rea-backup-pack-integration-run-preservation/v1',recordedAtUtc:new Date().toISOString(),retained,receiptSHA256:sha(receiptBytes),runPath:'integration-runs/'+runName,exactCopies:true,collectorRecoveryWithoutBehaviourRerun:true},null,2)+'\n');await fs.writeFile(path.join(publicRoot,'integration-run-manifest.json'),runManifestBytes,{flag:'wx'});for(const e of attempt.before)assert.equal(sha(await fs.readFile(path.join(studio,e.path))),e.sha256);assert.equal(sha(await fs.readFile(helperPath)),sha(helperBytes));assert.equal(sha(await fs.readFile(import.meta.filename)),sha(recoverySource));console.log(JSON.stringify({summary:receipt.summary,durationMs:receipt.durationMs,sourceFiles:42,retained:retained.length,sourceStable:true,receiptSHA256:sha(receiptBytes),runManifestSHA256:sha(runManifestBytes),behaviourRerun:false,collectorRecovery:true}));
