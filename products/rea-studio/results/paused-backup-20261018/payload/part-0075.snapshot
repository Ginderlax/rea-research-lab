    {
      "id": "grafana.candidate.1ed3d97a119597fef584",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Each policy consists of a set of label matchers (0 or more) that specify which alerts they are or aren't interested in handling. A matching policy refers to a notification policy with label matchers that match the alert instance’s labels.",
      "headingPath": [
        "Notification policies"
      ],
      "source": {
        "path": "docs/sources/alerting/fundamentals/notifications/notification-policies.md",
