readme = readme.replace('CSV data, calculations and dashboard views', 'CSV data, calculations and native Grafana dashboard editing'); readme = readme.replace('Declarative DAG execution and histories', 'HTTP workflows, waits, saved calls, cancellation and histories'); readme = readme.replace('ZIP creation, validation and extraction', 'ZIP/ZIP64, TAR and GZIP creation, validation and extraction');
