    {
      "id": "grafana.candidate.43c8eda38946a12a09bc",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Pass the plugins you want to be installed to Docker with the `GF_PLUGINS_PREINSTALL` environment variable as a comma-separated list.",
