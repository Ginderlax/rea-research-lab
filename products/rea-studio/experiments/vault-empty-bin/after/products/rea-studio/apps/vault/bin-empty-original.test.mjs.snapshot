    for (const row of after.deleted.slice(count)) assert.equal(row.time, restoreNow.replace('Z', '.000Z'));
    assert.equal(actual.after.groups.some(row => row.id === ids.bin), true); assert.equal(actual.after.deleted.some(row => row.id === ids.bin), false);
    assert.equal(actual.inputHeaderVersion, record.syntheticInput.headerVersion); assert.equal(actual.savePerformed, save);
    if (save) { assert.deepEqual(actual.reopened, actual.after); assert([0x00040000, 0x00040001].includes(actual.outputHeaderVersion)); } else { assert.equal(actual.reopened, null); assert.equal(actual.outputHeaderVersion, actual.inputHeaderVersion); }
    record.headerVersionObservation = { input: actual.inputHeaderVersion, output: actual.outputHeaderVersion, savePerformed: save, downgradeObserved: actual.outputHeaderVersion < actual.inputHeaderVersion, sameFormatVersionClaimed: false, note: 'The deleted A entry carried QualityCheck=false; released save may choose4.0 after deletion. Actual header identity is retained; comparison covers named projections, not unchanged version or arbitrary XML.' };
    record.timestampComparison = { originalDatesRewritten: false, candidateUsesSingleCapturedClock: true, originalUsesPerRecursiveCallUTC: true, originalDatesWithinObservedBounds: true, exactTimestampEqualityClaimed: false };
    record.status = 'passed'; record.comparisonPassed = true;
  } catch (error) { record.status = 'failed'; record.failure = { name: error.name, message: error.message }; throw error; }
  finally {
    record.completedAtUtc = new Date().toISOString(); await writeRecord(); observations.push({ path: path.basename(output('.json')), ...record });
