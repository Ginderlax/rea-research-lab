    },
    {
      "id": "grafana.candidate.f10745763bedd3fcb466",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The default images for Grafana are created using the Alpine Linux project and can be found in the Alpine official image. For instructions on configuring a Docker image for Grafana, refer to [Configure a Grafana Docker image](../../configure-docker/).",
      "headingPath": [
        "Run Grafana Docker image"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/installation/docker/index.md",
        "gitBlobSha": "4775409c5b7e8b32342ff84f543f3e11c51aa950",
