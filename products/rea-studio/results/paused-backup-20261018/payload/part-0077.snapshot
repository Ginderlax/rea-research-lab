    },
    {
      "id": "grafana.candidate.75d0898a4d9bbe1f60b7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If any of your options contains the expression `$__<PROVIDER>{<ARGUMENT>}`or `${<ENVIRONMENT VARIABLE>}`, then Grafana evaluates them. The evaluation runs the provider with the provided argument to get the final value of the option.",
      "headingPath": [
        "Configure Grafana",
        "Variable expansion"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 123,
        "lineEnd": 124,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L123-L124"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.ad4bd15f27f91bf87b27",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The `env` provider expands environment variables. If you set an option to `$__env{PORT}` the value of the `PORT` environment variable replaces it. For environment variables you can also use the short-hand syntax `${PORT}`.",
      "headingPath": [
        "Configure Grafana",
        "Variable expansion",
        "`env` provider"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 130,
        "lineEnd": 132,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L130-L132"
      },
