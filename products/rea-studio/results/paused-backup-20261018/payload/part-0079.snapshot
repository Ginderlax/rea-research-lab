    {
      "id": "grafana.candidate.6c940760fb142d9322f2",
      "syntaxRole": "list-item",
      "sourceText": "- **Generate dashboard save changes summary** - You can now generate a summary of the changes you've made to a dashboard when you save it. This is great for effortlessly tracking the history of a dashboard.",
      "headingPath": [
        "What’s new in Grafana v10.2",
        "Dashboards and visualizations",
        "Use AI to generate titles, descriptions, and change summaries"
      ],
