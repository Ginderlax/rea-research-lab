    {
      "id": "grafana.candidate.6d3caaa7194f3752372c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana uses semicolons (`;`) to comment out lines in the INI file. To uncomment a line, remove the semicolon (`;`) from the beginning of that line.",
      "headingPath": [
        "Configure Grafana",
        "Remove comments in the .ini files"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
