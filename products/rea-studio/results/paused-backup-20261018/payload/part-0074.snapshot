      },
      "applicability": {
        "status": "excluded-by-paid-or-hosted-section-heading",
        "products": [
          "enterprise",
          "oss"
        ],
        "restriction": "Grafana Enterprise license > Grafana Enterprise license restrictions > Tiered licensing (deprecated)"
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
