          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.9bcc698bc437f4c20c69",
      "syntaxRole": "table-row",
      "sourceText": "| **Auto max idle** | When enabled, automatically sets `max idle` to match `max open`. If `max open` isn't set, it defaults to `100`.                                                                              |",
      "headingPath": [
        "Configure the Microsoft SQL Server data source",
        "Configure the data source in the UI"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/configure/index.md",
