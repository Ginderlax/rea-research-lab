import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs/promises';import path from'node:path';import{mount,button,field,groupRow,click,type,walk,observations,ids}from'./ui-fixture.mjs';
async function newGroup(u){await click(button(u.root,'Show groups'));await click(button(groupRow(u.root,'Selected'),'New child group'));await type(field(u.root,'Group name'),'Submitted child');await type(field(u.root,'Group notes'),'Submitted notes');}
for(const mode of['create','save'])test('independent '+mode+' retains newer enabled group draft while final group-list response is held',async t=>{
 const u=await mount(t,mode+'-late-group-list');if(mode==='create')await newGroup(u);else{await click(button(u.root,'Show groups'));await click(button(groupRow(u.root,'Selected'),'Edit group details'));await type(field(u.root,'Group notes'),'Submitted edit');}
 const held=u.hold('recycleGroupList'),saving=click(button(u.root,mode==='create'?'Create group':'Save group details'));await held.started.promise;
 const name=field(u.root,'Group name'),notes=field(u.root,'Group notes');await type(name,'Newer unsaved group name');await type(notes,'Newer unsaved group notes');held.release.resolve();await saving;
 const names=walk(u.root).filter(n=>n.tagName==='LABEL'&&n._text==='Group name');const details=names.map(n=>n.children[0].value);observations.push({name:mode+'-late-list-assertion',newerNameVisible:details,notesControls:walk(u.root).filter(n=>n.tagName==='LABEL'&&n._text==='Group notes').map(n=>n.children[0].value)});assert.deepEqual(details,['Newer unsaved group name'],'A later list response must preserve enabled name/notes edits');assert.equal(field(u.root,'Group notes').value,'Newer unsaved group notes');
});
test('independent first active-list wait retains a newly typed create draft and subsequent Save targets the new UUID/MAC',async t=>{
 const u=await mount(t,'create-UUID-continuation');await newGroup(u);const held=u.hold('list'),creating=click(button(u.root,'Create group'));const result=await held.started.promise;await type(field(u.root,'Group name'),'Continuing child');await type(field(u.root,'Group notes'),'Later notes retained');held.release.resolve();await creating;
 assert.equal(field(u.root,'Group name').value,'Continuing child');assert.equal(field(u.root,'Group notes').value,'Later notes retained');const calls=u.calls.filter(c=>c.action==='groupCreate');assert.equal(calls.length,1);const newId=calls[0].result.id;assert.notEqual(newId,ids.target);assert.match(newId,/^[a-f0-9-]{36}$/);await click(button(u.root,'Save group details'));const saved=u.calls.filter(c=>c.action==='groupSave');assert.equal(saved.length,1);assert.equal(saved[0].input.id,newId);assert.notEqual(saved[0].input.revision,calls[0].input.revision);assert.match(saved[0].input.revision,/^[a-f0-9]{64}$/);const groups=(await u.direct('recycleGroupList',{bin:false})).groups;assert.equal(groups.find(g=>g.id===newId).name,'Continuing child');assert.equal(groups.filter(g=>g.parentId===ids.target).length,2);
});
test('independent failed group persistence retains the editable draft and retries exactly once without duplicate children',async t=>{
 const u=await mount(t,'failed-group-persistence');await newGroup(u);const before=u.store.identity();u.store.failNext();await click(button(u.root,'Create group'));assert.equal(u.store.identity(),before);assert.equal(field(u.root,'Group name').value,'Submitted child');assert.equal(field(u.root,'Group notes').value,'Submitted notes');assert(walk(u.root).some(n=>n._text==='Owned persistence failure'));await click(button(u.root,'Create group'));const rows=(await u.direct('recycleGroupList',{bin:false})).groups;assert.equal(rows.filter(g=>g.name==='Submitted child').length,1);
});
test('independent closed group panel stays closed during held active list and newer entry draft remains enabled',async t=>{
 const u=await mount(t,'closed-panel-late-active-list');await newGroup(u);const held=u.hold('list'),creating=click(button(u.root,'Create group'));await held.started.promise;await type(field(u.root,'Title'),'Newer entry title');await type(field(u.root,'Password'),'Owned newer entry draft password');field(u.root,'Confirm discarding unsaved group draft').checked=true;await click(button(u.root,'Close group panel'));held.release.resolve();await creating;assert.equal(field(u.root,'Title').value,'Newer entry title');assert.equal(field(u.root,'Password').value,'Owned newer entry draft password');assert(!walk(u.root).some(n=>n.tagName==='H3'&&n.textContent==='Groups'));
});
test('independent selected entry and dirty new-entry guards refuse group edits before encrypted writes',async t=>{
 const u=await mount(t,'selected-entry-guard');await click(button(groupRow(u.root,'A'),'Open entry'));await click(button(u.root,'Show groups'));await click(button(groupRow(u.root,'Selected'),'Edit group details'));const before=u.store.identity();await click(button(u.root,'Save group details'));assert.equal(u.store.identity(),before);assert.equal(u.calls.filter(c=>c.action==='groupSave').length,0);assert.equal(field(u.root,'Title').value,'A');await click(button(u.root,'New entry'));await type(field(u.root,'Title'),'Dirty new entry');await click(button(u.root,'Save group details'));assert.equal(u.store.identity(),before);assert.equal(u.calls.filter(c=>c.action==='groupSave').length,0);assert.equal(field(u.root,'Title').value,'Dirty new entry');
});
test.after(async()=>{if(process.env.VAULT_GROUP_REVIEW_OUTPUT)await fs.writeFile(path.join(process.env.VAULT_GROUP_REVIEW_OUTPUT,'observations.json'),JSON.stringify(observations,null,2)+'\n',{flag:'wx'});});
