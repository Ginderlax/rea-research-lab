import fs from 'node:fs/promises';import path from 'node:path';import os from 'node:os';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';import {pathToFileURL} from 'node:url';import readline from 'node:readline';
const here=import.meta.dirname,stage=path.resolve(here,'../notes-inline-confirmation-next'),repo=path.resolve(here,'../../outputs/rea-research-lab'),folder=path.join(here,'browser'),copyRoot=path.join(folder,'studio'),sha=b=>createHash('sha256').update(b).digest('hex'),save=(n,v)=>fs.writeFile(path.join(folder,n),JSON.stringify(v,null,2)+'\n',{flag:'wx'});await fs.mkdir(folder,{recursive:true});
const files=['server.mjs','catalog.mjs','lib/storage.mjs',...['client','server','markdown','jex','notebooks','notebook-trash'].map(n=>'apps/notes/'+n+'.mjs')],source=[];for(const[p,base]of[...files.map(p=>[p,path.join(stage,'products/rea-studio')]),...['index.html','studio.mjs','style.css'].map(p=>['public/'+p,path.join(repo,'products/rea-studio')])]){const b=await fs.readFile(path.join(base,p)),target=path.join(copyRoot,p);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b,{flag:'wx'});source.push({path:p,original:path.relative(here,path.join(base,p)).replaceAll('\\','/'),bytes:b.length,sha256:sha(b)});}await save('source-before.json',source);
const tempPrefix=path.resolve(os.tmpdir(),'notes-inline-review-'),dataDir=await fs.mkdtemp(tempPrefix),module=await import(pathToFileURL(path.join(copyRoot,'server.mjs')).href),host=await module.start({port:0,dataDir}),requests=[];let phase='seed',closing=false;
host.server.prependListener('request',(req,res)=>{const r={at:new Date().toISOString(),phase,method:req.method,url:req.url};requests.push(r);res.once('finish',()=>{r.status=res.statusCode;r.completedAt=new Date().toISOString();});});
const call=async(action,input={})=>{const r=await fetch(host.url+'/api/notes/'+action,{method:'POST',headers:{'content-type':'application/json','x-rea-token':host.token},body:JSON.stringify(input)}),json=await r.json();assert(r.ok,JSON.stringify(json));return json.result;};
let tree=await call('notebook-create',{title:'Owned Browser Parent',revision:0});const parent=tree.notebook.id;tree=await call('notebook-create',{title:'Owned Browser Child',revision:tree.revision,parentId:parent});const child=tree.notebook.id,note=await call('save',{title:'Owned Browser Note',body:'Owned synthetic browser body.',notebookId:child,tags:['owned-browser']});phase='browser';await save('host.json',{startedAt:new Date().toISOString(),url:host.url+'/#notes',port:host.server.address().port,dataDir,parent,child,noteId:note.id,sourceFiles:source.length,originalExecutions:0,user4311Touched:false});
async function observe(label){const old=phase;phase='observer';const state=await call('get',{id:note.id}),organization=await call('notebook-list');phase=old;await save(label+'.json',{at:new Date().toISOString(),state,organization,requests:structuredClone(requests)});console.log(JSON.stringify({observation:label,requests:requests.length,trashed:Boolean(state.deletedAt),revision:state.revision}));}
async function close(reason){if(closing)return;closing=true;clearTimeout(timer);await observe('before-close');await host.close();for(const r of source){const b=await fs.readFile(path.join(copyRoot,r.path));assert.deepEqual({bytes:b.length,sha256:sha(b)},{bytes:r.bytes,sha256:r.sha256});const original=await fs.readFile(path.resolve(here,r.original));assert.equal(sha(original),r.sha256);}const resolved=path.resolve(dataDir);assert(resolved.startsWith(tempPrefix)&&path.dirname(resolved)===path.resolve(os.tmpdir()));await fs.rm(resolved,{recursive:true,force:true});await save('source-after.json',source);await save('cleanup.json',{at:new Date().toISOString(),reason,hostClosed:true,tempDataRemoved:true,sourceStable:true,browserTabClosureSeparate:true});console.log(JSON.stringify({hostClosed:true,tempDataRemoved:true,sourceStable:true}));process.exit(0);}
const timer=setTimeout(()=>close('10-minute owned host deadline').catch(e=>{console.error(e);process.exit(1);}),600000);const lines=readline.createInterface({input:process.stdin});lines.on('line',line=>{const value=line.trim();if(value==='close')close('explicit owned close').catch(e=>{console.error(e);process.exit(1);});else if(/^observe [a-z0-9-]+$/.test(value))observe(value.slice(8)).catch(e=>console.error(e));});console.log(JSON.stringify({url:host.url+'/#notes',port:host.server.address().port,sourceFiles:source.length,syntheticNoteId:note.id}));
