    },
    {
      "id": "grafana.candidate.8eeec9181f2205e980d7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For data sources that support log types, such as Loki, instead of a single view containing all fields, fields will be displayed grouped by their type: Indexed Labels, Parsed fields, and Structured Metadata.",
      "headingPath": [
        "Logs in Explore",
        "Logs",
        "Log details view",
        "Fields"
      ],
      "source": {
        "path": "docs/sources/visualizations/explore/logs-integration.md",
