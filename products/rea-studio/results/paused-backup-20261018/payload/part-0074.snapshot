    {
      "id": "grafana.candidate.83306e54c0d42ef7c88e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This topic describes what organizations are, and how to create, edit, and delete them.",
      "headingPath": [
        "Manage organizations"
      ],
      "source": {
        "path": "docs/sources/administration/organization-management/index.md",
        "gitBlobSha": "621374d48845d4f1120a80744b4612cb52ab81b8",
