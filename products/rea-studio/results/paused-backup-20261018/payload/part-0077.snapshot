    {
      "id": "grafana.candidate.327740a9bbfa79f0ce4c",
      "syntaxRole": "list-item",
      "sourceText": "- `org_mapping = Engineering:*` to map users from `Engineering` to all existing Grafana organizations.",
      "headingPath": [
