    {
      "id": "grafana.candidate.a1a1951b9461d28f1cc9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set to `false` to prohibit users from being able to sign up or create user accounts. Default is `false`. A Grafana Admin can still create users. For more information about creating a user, refer to [Add a user](../../administration/user-management/server-user-management/#add-a-user).",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[users]`",
        "`allow_sign_up`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 958,
        "lineEnd": 961,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L958-L961"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.87dabbe4cef306b9e459",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set to `false` to prohibit users from creating new organizations. Default is `false`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[users]`",
        "`allow_org_create`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 965,
        "lineEnd": 966,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L965-L966"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.cc737073b9e49ae94555",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set to `true` to automatically add new users to the main organization (ID `1`). When set to `false`, new users automatically cause a new organization to be created for that new user. The organization is created even if the `allow_org_create` setting is set to `false`. Default is `true`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[users]`",
        "`auto_assign_org`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 970,
        "lineEnd": 973,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L970-L973"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.6bbbdb6e6c8142bbc4b9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set this value to automatically add new users to the provided org. This requires `auto_assign_org` to be set to `true`. The organization must already exist. Default is `1`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[users]`",
        "`auto_assign_org_id`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
