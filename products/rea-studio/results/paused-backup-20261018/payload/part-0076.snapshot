    {
      "id": "grafana.candidate.59649db9d6925f513873",
      "syntaxRole": "list-item",
      "sourceText": "- **Line limit** - Defines the upper limit for the number of log lines returned by a query. The default is `1000`.",
      "headingPath": [
        "Loki query editor",
        "Options"
      ],
      "source": {
