    {
      "id": "grafana.candidate.7430f0e1950749937dee",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Minimum wait time in milliseconds for the server lock retry mechanism. Default is `1000` (milliseconds). The server lock retry mechanism is used to prevent multiple Grafana instances from simultaneously refreshing OAuth tokens. This mechanism waits at least this amount of time before retrying to acquire the server lock.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[auth]`",
        "`oauth_refresh_token_server_lock_min_wait_ms`"
      ],
      "source": {
