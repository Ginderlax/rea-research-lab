      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.689c37045cf5472aedd3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Skip TLS certification validation** : When activated, it bypasses TLS certificate verification. Not recommended, unless absolutely necessary for testing. ![Authentication section showing the TLS client certificate options](/media/docs/grafana/data-sources/tempo/tempo-data-source-authentication.png)",
      "headingPath": [],
