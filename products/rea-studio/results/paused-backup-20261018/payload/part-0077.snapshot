    },
    {
      "id": "grafana.candidate.cb6429bd29045a4ef9ed",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you chose to use InfluxDB Cloud, then you should [download and install the InfluxDB Cloud CLI](https://portal.influxdata.com/downloads/). This tool allows you to send command line instructions to your cloud account. For more information, refer to [Influx CLI documentation](https://docs.influxdata.com/influxdb/cloud/write-data/developer-tools/influx-cli/).",
      "headingPath": [
        "Get started with Grafana and InfluxDB",
        "Get InfluxDB",
        "Install other InfluxDB software"
      ],
      "source": {
