    {
      "id": "grafana.candidate.eb565673f4d965a1317f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Enter a comma-separated list of plugin identifiers to identify plugins to load even if they are unsigned. Plugins with modified signatures are never loaded.",
