    {
      "id": "grafana.candidate.5f7cd3429f156c9ca8ea",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Loki log queries return the contents of the log lines. You can query and display log data from Loki via [Explore](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/explore/), and with the [Logs panel](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/panels-visualizations/visualizations/logs/) in dashboards.",
      "headingPath": [
        "Loki query editor",
        "Create a log query"
      ],
