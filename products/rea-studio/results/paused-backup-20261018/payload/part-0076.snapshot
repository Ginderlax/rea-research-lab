    {
      "id": "grafana.candidate.ac214564cec00dec1c17",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For Mimir and Cortex data sources, the Alerting UI supports both viewing and creating data source-managed rules. Prometheus only supports viewing.",
      "headingPath": [
        "Prometheus alerting",
        "View data source-managed rules"
      ],
      "source": {
