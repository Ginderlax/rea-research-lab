import {pathToFileURL} from 'node:url';import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import{createHash}from'node:crypto';
const work=import.meta.dirname,base=path.dirname(work),lab=path.resolve(work,'../outputs/rea-research-lab'),own=path.join(work,'flow-vault-reviewed-installation-next'),sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)});
const globalPrefix='products/rea-studio/results/flow-vault-reviewed-installation-20261013',proofPrefix='products/rea-studio/results/flow-vault-proof-transition-20261013';
const stages=[{name:'flow',folder:'flow-static-link-textarea-publication-plan-next',pin:'7fe69cfdd42a44716e31c07b3a65a2ee29634e105acfdb35865bc4e9beb5d7a4',files:83,rowsFile:'installation-proposals.json',key:'proposals',rows:19,publicPrefix:'products/rea-studio/apps/flow/results/native-link-textarea-followup'}, {name:'vault',folder:'vault-group-edit-installation-plan-next',pin:'08ba0c57de6456c8cb5c508be318703a1c55977dc0c9d7f4bd6b5271f513d99d',files:291,rowsFile:'installation-plan.json',key:'rows',rows:16,publicPrefix:'products/rea-studio/apps/vault/results/group-edit-followup'}, {name:'proof',folder:'flow-vault-proof-transition-next',pin:'1eee491b8e980014c813f9f626219c2bb9e6a0adfcbbd0360ac5ddb4e0247d08',files:22,publicPrefix:proofPrefix}];
function safe(p){assert(typeof p==='string'&&p.length>0&&p.length<4096&&!p.startsWith('/')&&!/[\\:\x00-\x1f\x7f]/.test(p));assert(p.split('/').every(s=>s&&s!=='.'&&s!=='..'&&!['.local','node_modules','artifacts','tooling'].includes(s)));return p;}
async function read(root,p){safe(p);let at=root;for(const s of p.split('/')){at=path.join(at,s);assert(!(await fs.lstat(at)).isSymbolicLink());}const s=await fs.stat(at);assert(s.isFile()&&s.size<=32*1024*1024);const b=await fs.readFile(at);assert.equal(b.length,s.size);return b;}
async function auth(folder,pin,files){safe(folder);const root=path.join(work,folder),b=await read(root,'manifest.json');assert.equal(sha(b),pin);const j=JSON.parse(b);assert.equal(j.inventory.length,files);const names=new Set();for(const r of j.inventory){assert(!names.has(r.path));names.add(r.path);assert.deepEqual(id(await read(root,r.path)),{bytes:r.bytes,sha256:r.sha256});}return{root,bytes:b,manifest:j};}
const authorities=[];for(const s of stages)authorities.push(await auth(s.folder,s.pin,s.files));
const latest=[],maps=[];for(const [i,s]of stages.entries())if(s.rowsFile){const j=JSON.parse(await read(authorities[i].root,s.rowsFile));assert.equal(j[s.key].length,s.rows);for(const r of j[s.key]){const p=r.destination??r.target;safe(p);assert(p.startsWith('products/rea-studio/apps/'+s.name+'/'));const b=await read(authorities[i].root,r.sourcePath??r.source);assert.deepEqual(id(b),r.after);if(r.before)assert.deepEqual(id(await read(lab,p)),r.before);else assert.equal(await fs.stat(path.join(lab,p)).then(()=>true,()=>false),false);latest.push({destination:p,before:r.before,after:r.after,sourceRoot:s.folder,sourcePath:r.sourcePath??r.source});}}
assert.equal(latest.length,35);assert.equal(new Set(latest.map(r=>r.destination)).size,35);assert.equal(latest.filter(r=>r.before).length,9);
const transition=JSON.parse(await read(authorities[2].root,'validation.json'));assert.equal(transition.exactInverse,true);assert.equal(transition.summary.currentInstalledSourcesMandatory,61);const proofRow={destination:transition.candidate.path,before:transition.candidate.before,after:transition.candidate.after,sourceRoot:stages[2].folder,sourcePath:'candidate/'+transition.candidate.path};assert.equal(proofRow.destination,'scripts/editor-vault-proof-migration.mjs');assert.deepEqual(id(await read(lab,proofRow.destination)),proofRow.before);assert.deepEqual(id(await read(authorities[2].root,proofRow.sourcePath)),proofRow.after);
