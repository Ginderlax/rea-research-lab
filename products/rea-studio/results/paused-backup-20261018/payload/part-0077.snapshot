      "sourceText": "Limits the number of rows that Grafana processes from SQL data sources. Default is `1000000`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[dataproxy]`",
        "`row_limit`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
