// Owned bounded synthetic browser host/relay. It imports only private copied Studio.
import fs from 'node:fs/promises';import {appendFileSync} from 'node:fs';import path from 'node:path';import os from 'node:os';import http from 'node:http';import readline from 'node:readline';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';import {pathToFileURL} from 'node:url';
const root=import.meta.dirname,workspace=path.resolve(root,'../..'),hash=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:hash(b)}),save=(p,v)=>fs.writeFile(path.join(root,p),JSON.stringify(v,null,2)+'\n',{flag:'wx'}),say=v=>{const line=JSON.stringify(v);appendFileSync(path.join(root,'host.stdout.txt'),line+'\n');console.log(line);},sources=JSON.parse(await fs.readFile(path.join(root,'source-before.json')));for(const r of sources)assert.deepEqual(id(await fs.readFile(path.join(root,r.clone))),r.cloneIdentity);await save('controller-before.json',id(await fs.readFile(path.join(root,'host-relay.mjs'))));
const prefix=path.resolve(os.tmpdir(),'sketch-layout-browser-'),dataDir=await fs.mkdtemp(prefix),host=await(await import(pathToFileURL(path.join(root,'studio/server.mjs')).href)).start({port:0,dataDir}),actual=[],forwarded=[];let relayPort,closing=false,retainedBytes=0;host.server.prependListener('request',(req,res)=>{assert.ok(actual.length<1024);const row={id:actual.length+1,at:new Date().toISOString(),method:req.method,url:req.url};actual.push(row);res.once('finish',()=>{row.status=res.statusCode;row.completedAt=new Date().toISOString();});});
async function persisted(){const dir=path.join(dataDir,'sketch/records'),rows=[];for(const name of(await fs.readdir(dir)).sort()){assert.ok(name.endsWith('.json'));const b=await fs.readFile(path.join(dir,name));assert.ok(b.length<=4*1024*1024);rows.push({path:'sketch/records/'+name,...id(b),value:JSON.parse(b)});}return rows;}
const hop=new Set(['connection','keep-alive','proxy-authenticate','proxy-authorization','te','trailer','transfer-encoding','upgrade']),relay=http.createServer(async(req,res)=>{try{assert.ok(['127.0.0.1','::1','::ffff:127.0.0.1'].includes(req.socket.remoteAddress));assert.equal(req.headers.host,'127.0.0.1:'+relayPort);if(req.headers.origin)assert.equal(req.headers.origin,'http://127.0.0.1:'+relayPort);assert.ok(req.url.startsWith('/')&&!req.url.startsWith('//'));assert.ok(forwarded.length<512);const chunks=[];let total=0;for await(const b of req){total+=b.length;assert.ok(total<=4*1024*1024);chunks.push(b);}const body=Buffer.concat(chunks),headers={...req.headers,host:new URL(host.url).host};for(const h of hop)delete headers[h];if(headers.origin)headers.origin=host.url;headers['content-length']=body.length;const row={id:forwarded.length+1,at:new Date().toISOString(),method:req.method,url:req.url,body:id(body),transforms:{host:{from:req.headers.host,to:headers.host},origin:req.headers.origin?{from:req.headers.origin,to:headers.origin}:null,hopByHopRemoved:true,contentLength:body.length}};if(req.url.startsWith('/api/sketch/')){row.action=req.url.slice('/api/sketch/'.length);row.input=JSON.parse(body);}forwarded.push(row);
const response=await new Promise((resolve,reject)=>{const up=http.request(new URL(req.url,host.url),{method:req.method,headers,timeout:30000},reply=>{let n=0;const chunks=[];reply.on('data',b=>{n+=b.length;if(n>4*1024*1024)return reply.destroy(new Error('Owned response bound'));chunks.push(b);});reply.on('end',()=>resolve({status:reply.statusCode,headers:reply.headers,body:Buffer.concat(chunks)}));reply.on('error',reject);});up.on('error',reject);up.on('timeout',()=>up.destroy(new Error('Owned upstream30s deadline')));up.end(body);});row.upstreamStatus=response.status;row.upstreamBody=id(response.body);row.completedAt=new Date().toISOString();if(row.action){retainedBytes+=body.length+response.body.length;assert.ok(retainedBytes<=32*1024*1024);row.response=JSON.parse(response.body);}const outHeaders={...response.headers};for(const h of hop)delete outHeaders[h];outHeaders['content-length']=response.body.length;res.writeHead(response.status,outHeaders);res.end(response.body);row.deliveredAt=new Date().toISOString();}catch(e){appendFileSync(path.join(root,'host.stderr.txt'),String(e.stack)+'\n');if(!res.headersSent)res.writeHead(500,{'content-type':'text/plain'});res.end(String(e.message));say({relayError:String(e.message)});}});
await new Promise((resolve,reject)=>{relay.once('error',reject);relay.listen(0,'127.0.0.1',resolve);});relayPort=relay.address().port;await save('host.json',{at:new Date().toISOString(),pid:process.pid,actualHost:host.url,relayOrigin:'http://127.0.0.1:'+relayPort,browserUrl:'http://127.0.0.1:'+relayPort+'/#sketch',dataDir,sourceFiles:sources.length,seedCalls:0,syntheticOnly:true,privateRouteAdapterCount:1,fixtureOnlyRelay:true,headerTransforms:'Relay Host/Origin checked and normalized to owned actual host; methods/paths/bodies/session tokens unchanged; hop headers removed/content-length recalculated.',proxySecurityClaim:false,limits:{campaignMs:1800000,upstreamMs:30000,requestBytes:4194304,responseBytes:4194304,retainedAPIBodyBytes:33554432,forwardedRequests:512,actualRequests:1024},originalGUI:0,benchmarks:0,user4311Touched:false});
async function observe(label){const disk=await persisted();await save('observation-'+label+'.json',{at:new Date().toISOString(),persisted:disk,actual:structuredClone(actual),forwarded:structuredClone(forwarded),retainedAPIBodyBytes:retainedBytes});say({observation:label,actual:actual.length,forwarded:forwarded.length,api:forwarded.filter(r=>r.action).length,diskRecords:disk.length});}
async function close(reason){if(closing)return;closing=true;clearTimeout(timer);await observe('before-close');await new Promise((resolve,reject)=>relay.close(e=>e?reject(e):resolve()));await host.close();for(const r of sources){assert.deepEqual(id(await fs.readFile(path.join(root,r.clone))),r.cloneIdentity);assert.deepEqual(id(await fs.readFile(path.join(workspace,r.source))),r.original);}assert.deepEqual(id(await fs.readFile(path.join(root,'host-relay.mjs'))),JSON.parse(await fs.readFile(path.join(root,'controller-before.json'))));const resolved=path.resolve(dataDir);assert.ok(resolved.startsWith(prefix)&&path.dirname(resolved)===path.resolve(os.tmpdir()));await fs.rm(resolved,{recursive:true,force:true});await save('source-after.json',sources);await save('cleanup.json',{at:new Date().toISOString(),reason,hostClosed:true,relayClosed:true,tempDataRemoved:true,sourceStable:true});say({closed:true,sourceStable:true,tempRemoved:true});process.exit(0);}
const timer=setTimeout(()=>close('owned30-minute deadline').catch(e=>{console.error(e);process.exit(1);}),1800000),lines=readline.createInterface({input:process.stdin});let queue=Promise.resolve();lines.on('line',line=>{queue=queue.then(async()=>{const s=line.trim();if(s==='close')return close('explicit owned close');if(/^observe [a-z0-9-]+$/.test(s))return observe(s.slice(8));throw Error('Unknown owned controller command');}).catch(e=>{appendFileSync(path.join(root,'host.stderr.txt'),String(e.stack)+'\n');console.error(e);});});say({browserUrl:'http://127.0.0.1:'+relayPort+'/#sketch',pid:process.pid,sourceFiles:sources.length});
