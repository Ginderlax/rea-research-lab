    {
      "id": "grafana.candidate.100609a35f3570f82789",
      "syntaxRole": "table-row",
      "sourceText": "| `and`               | Two conditions before and after must be true for the overall condition to be true.                                                                                                                                                                          |",
      "headingPath": [
        "Queries and conditions",
        "Advanced options: Expressions",
        "Recovery threshold",
        "Classic condition (legacy)"
      ],
      "source": {
        "path": "docs/sources/alerting/fundamentals/alert-rules/queries-conditions.md",
