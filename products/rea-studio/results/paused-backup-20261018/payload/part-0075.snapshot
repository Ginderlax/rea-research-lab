    {
      "id": "grafana.candidate.cad79eed82b88fa98b34",
      "syntaxRole": "table-row",
      "sourceText": "| `alert.rules:create` | `folders:*`<br>`folders:uid:*` | Create Grafana alert rules in a folder and its subfolders. Combine this permission with `folders:read` in a scope that includes the folder and `datasources:query` in the scope of data sources the user can query.                               |",
      "headingPath": [
        "Configure RBAC",
        "Permissions",
        "Alert rules"
