// Local backup authentication/copying only. No behavioral or build execution.
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import { createHash } from 'node:crypto';
import { fileURLToPath } from 'node:url';
const work = path.dirname(fileURLToPath(import.meta.url));
const lab = path.resolve(work, '../outputs/rea-research-lab');
const backup = path.join(work, 'cloud-verification-backups/run-38806502120/artifact-12006792125');
const source = path.join(backup, 'readable-evidence');
const prefix = 'products/rea-studio/results/cloud-archive-metadata-failure-20261015';
const target = path.join(lab, prefix);
const commit = '99709926a66a04f23924210aeeb41d1f7254bd46';
const artifactSHA256 = 'e4d3c88ede45030b5efe45f53a1f054658bb4fd7355a7cb157405d17290c40fb';
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const id = bytes => ({ bytes: bytes.length, sha256: sha(bytes) });
function safe(relative) {
  assert(typeof relative === 'string' && relative.length && !/[\\:\x00-\x1f\x7f]/.test(relative) && !relative.startsWith('/'));
  assert(relative.split('/').every(part => part && part !== '.' && part !== '..'));
  return relative;
}
function read(root, relative) {
  safe(relative); let at = root;
  for (const part of relative.split('/')) { at = path.join(at, part); assert(!fs.lstatSync(at).isSymbolicLink()); }
  const stat = fs.statSync(at); assert(stat.isFile() && stat.size < 8 * 1024 * 1024);
  return fs.readFileSync(at);
}
function files(root, relative = '') {
  return fs.readdirSync(path.join(root, relative), { withFileTypes: true }).flatMap(entry => {
    assert(!entry.isSymbolicLink()); const name = relative ? relative + '/' + entry.name : entry.name; safe(name);
    return entry.isDirectory() ? files(root, name) : (assert(entry.isFile()), [name]);
  }).sort();
}
const backupBytes = read(backup, 'local-backup-verification.json'), backupReceipt = JSON.parse(backupBytes);
assert.equal(backupReceipt.schema, 'rea-local-cloud-attempt-backup/v1');
assert.equal(backupReceipt.artifactSHA256, artifactSHA256); assert.equal(backupReceipt.allCRCAndBytesReadable, true);
const archiveBytes = fs.readFileSync(backup + '.zip'); assert.equal(sha(archiveBytes), artifactSHA256); assert.equal(archiveBytes.length, backupReceipt.archiveBytes);
const inventory = files(source), verified = new Map();
for (const row of backupReceipt.files) {
  safe(row.path); assert(!verified.has(row.path)); assert.deepEqual(id(read(source, row.path)), { bytes: row.bytes, sha256: row.sha256 }); verified.set(row.path, row);
}
assert.equal(inventory.length, 372); assert.deepEqual(inventory, [...verified.keys()].sort());
const attempt = JSON.parse(read(source, 'verification/attempt-validation.json'));
assert.equal(attempt.repositoryCommit, commit); assert.equal(attempt.scope, 'archive-aes-experiment'); assert.equal(attempt.status, 'failed');
assert.deepEqual(attempt.summary, { tests: 160, pass: 154, fail: 6, cancelled: 0, skipped: 0, todo: 0, duration_ms: 40047.255 });
assert.equal(attempt.sourceFiles, 776); assert.equal(attempt.sourceSnapshotFiles, 354); assert.equal(attempt.sourceStable, true);
assert.deepEqual(read(source, 'verification/source-before.json'), read(source, 'verification/source-after.json'));
const raw = read(source, 'verification/stdout.txt').toString('utf8');
for (const [key, value] of Object.entries(attempt.summary)) {
  const found = [...raw.matchAll(new RegExp('^# ' + key + ' (\\d+(?:\\.\\d+)?)\\r?$', 'gm'))]; assert.equal(found.length, 1); assert.equal(Number(found[0][1]), value);
}
assert.equal([...raw.matchAll(/^not ok \d+ - /gm)].length, 6);
const workflow = JSON.parse(read(source, 'workflow-attempt.json')), composition = JSON.parse(read(source, 'composition.json'));
assert.equal(workflow.runId, '38806502120'); assert.equal(workflow.sourceCommit, commit);
assert.equal(workflow.composeOutcome, 'success'); assert.equal(workflow.acquisitionOutcome, 'success'); assert.equal(workflow.verificationOutcome, 'failure');
assert.equal(workflow.sourceCheckOutcome, 'success'); assert.equal(workflow.productionInstalled, false);
assert.equal(composition.status, 'composed-unexecuted-experimental-overlay'); assert.equal(composition.baselineGitCommit, commit);
assert.equal(attempt.experimentalOverlay.sha256, sha(read(source, 'composition.json')));
assert.equal(attempt.experimentalOverlay.composedActiveAppMatchesGitBaseline, false);
const omitted = inventory.filter(name => name.startsWith('verification/source/')).map(name => ({ sourcePath: name, bytes: verified.get(name).bytes, sha256: verified.get(name).sha256 }));
assert.equal(omitted.length, 354);
const retained = inventory.filter(name => !name.startsWith('verification/source/')); assert.equal(retained.length, 18);
assert(!fs.existsSync(target), 'Never overwrite an earlier capsule'); fs.mkdirSync(target); fs.mkdirSync(path.join(target, 'payload'));
const records = [], objects = new Set();
const credentialPattern = /\b(?:ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,}|AKIA[0-9A-Z]{16})\b|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----|Authorization:\s*Bearer\s+[A-Za-z0-9._~-]{20,}/i;
function save(sourcePath, bytes) {
  safe(sourcePath); assert(!records.some(row => row.sourcePath === sourcePath));
  assert(!credentialPattern.test(bytes.toString('utf8')), 'Credential pattern detected; public copy refused');
  const digest = sha(bytes), relative = 'payload/' + digest + '.snapshot';
  if (!objects.has(digest)) { fs.writeFileSync(path.join(target, relative), bytes, { flag: 'wx' }); objects.add(digest); }
  assert.deepEqual(id(read(target, relative)), id(bytes)); records.push({ sourcePath, path: relative, ...id(bytes) });
}
for (const name of retained) save(name, read(source, name));
save('local-backup-verification.json', backupBytes);
const jobLog = read(path.join(work, 'cloud-verification-backups/job-116668623517'), 'logs.txt');
assert.equal(jobLog.length, 106187); save('job-log-116668623517.txt', jobLog);
save('preservation-collector.mjs', fs.readFileSync(fileURLToPath(import.meta.url)));
const manifest = {
  schema: 'rea-cloud-archive-metadata-failure-preservation/v1', at: new Date().toISOString(), status: 'failed',
  sourceCommit: commit, runId: 38806502120, runAttempt: 1, runURL: 'https://github.com/Ginderlax/rea-research-lab/actions/runs/38806502120',
  artifactId: 12006792125, artifactSHA256, summary: attempt.summary,
  sourceIdentity: { baselineGitCommit: commit, compositionSHA256: attempt.experimentalOverlay.sha256, composedActiveAppMatchesGitBaseline: false, productionInstalled: false },
  sourceFiles: 776, sourceStableDuringRecordedComposedRun: true, activeSourceSnapshotsInVerifiedLocalBackup: 354,
  publicSourceSnapshotPayloads: 0, omittedSourceSnapshotPayloads: omitted,
  omissionScope: 'Only verification/source/ snapshot payloads are omitted. All354 remain in the complete byte-verified readable local backup; source-before/source-after and source-snapshot-manifest are preserved publicly. All metadata, raw logs and both observation files are retained.',
  completeLocalBackupVerified: true, localBackupFiles: 372, retainedArtifactFiles: retained.length,
  failureScope: 'Six hosted Windows integration/source-metadata failures concern DOS short-path versus long-path aliases. The experimental overlay is not accepted; later fixes need a separate actual run.',
  completedTestReceipt: true, experimentalIntegrationAccepted: false, fullArchiveAcceptance: false,
  records, uniqueInertObjects: objects.size, allCopiesExact: true, allPayloadsInert: true,
  localApplicationExecutions: 0, localOriginalExecutions: 0, localTests: 0, localBuilds: 0,
  historicalReceiptsRebound: false, fullDevelopmentSuiteAcceptance: false, fullParity: false, superiority: false,
};
const bytes = Buffer.from(JSON.stringify(manifest, null, 2) + '\n'); fs.writeFileSync(path.join(target, 'preservation-manifest.json'), bytes, { flag: 'wx' });
const result = { prefix, records: records.length, uniqueObjects: objects.size, omittedSnapshots: omitted.length, manifestSHA256: sha(bytes), summary: attempt.summary, localTests: 0, localBuilds: 0 };
fs.writeFileSync(path.join(work, 'cloud-recovery-20261015/archive-metadata-failure-preservation.json'), JSON.stringify(result, null, 2) + '\n', { flag: 'wx' });
console.log(JSON.stringify(result));
