    {
      "id": "grafana.candidate.37f3fe445a31ff097fbc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The Grafana CLI allows you to install, upgrade, and manage your Grafana plugins using a command line tool. For more information about Grafana CLI plugin commands, refer to [Plugin commands](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/administration/cli/#plugins-commands).",
