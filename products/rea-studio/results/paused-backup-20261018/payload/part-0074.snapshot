    {
      "id": "grafana.candidate.6c5c05b061b46098e0e3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "All plugins are signed under a _signature level_. The signature level determines how the plugin can be distributed.",
      "headingPath": [
        "Plugin signatures",
        "Plugin signature levels"
      ],
