    },
    {
      "id": "grafana.candidate.974893f90f0856677174",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Configure authentication. For a Grafana Cloud-hosted backend, use basic authentication with your Grafana Cloud user ID as the user name and a Cloud Access Policy token as the password. The token's access policy must include the scope required to query the backend.",
      "headingPath": [
        "Data source management",
        "Provisioned data sources",
        "Create an editable copy of a provisioned data source"
      ],
      "source": {
