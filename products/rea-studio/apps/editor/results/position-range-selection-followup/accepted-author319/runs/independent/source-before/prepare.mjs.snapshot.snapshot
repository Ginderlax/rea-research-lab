// New correction epoch; old author145 and independent43 remain immutable.
import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const root=import.meta.dirname,work=path.dirname(root),hash=b=>createHash('sha256').update(b).digest('hex'),identity=b=>({bytes:b.length,sha256:hash(b)});
async function save(p,b){const dest=path.resolve(root,p);assert.ok(dest.startsWith(root+path.sep));await fs.mkdir(path.dirname(dest),{recursive:true});await fs.writeFile(dest,b,{flag:'wx'});}const json=async(p,v)=>save(p,JSON.stringify(v,null,2)+'\n');
const authorities=[{id:'author145',directory:'editor-position-range-selection-next',manifest:'freeze-manifest.json',count:145,sha256:'8e423a7d82ea58c696f9bc3d91f6d3df460c51a2041cbcdcc87d2806c0997ee5'},{id:'independent43',directory:'editor-position-range-selection-independent-review',manifest:'review-manifest.json',count:43,sha256:'978bfd0fc13f4c148d980d7d1221edd2618e716adffd0831d16a08f522459a09'}],records=[];
for(const a of authorities){const folder=path.join(work,a.directory),mb=await fs.readFile(path.join(folder,a.manifest));assert.equal(hash(mb),a.sha256);const m=JSON.parse(mb),rows=Array.isArray(m.inventory)?m.inventory:Object.entries(m.inventory).map(([path,r])=>({path,...r}));assert.equal(rows.length,a.count);const names=[];async function walk(p){for(const e of await fs.readdir(p,{withFileTypes:true})){assert.equal(e.isSymbolicLink(),false);const q=path.join(p,e.name);if(e.isDirectory())await walk(q);else{assert.ok(e.isFile());names.push(path.relative(folder,q).replaceAll('\\','/'));}}}await walk(folder);assert.deepEqual(names.sort(),[...rows.map(r=>r.path),a.manifest].sort());for(const r of[...rows,{path:a.manifest,...identity(mb)}]){assert.ok(!path.isAbsolute(r.path)&&!r.path.split(/[\\/]/).includes('..'));const b=await fs.readFile(path.join(folder,r.path));assert.deepEqual(identity(b),{bytes:r.bytes,sha256:r.sha256});const snapshot='history/'+a.id+'/'+r.path+'.snapshot';await save(snapshot,b);records.push({authority:a.id,sourceRoot:'work/'+a.directory,sourcePath:r.path,snapshot,...identity(b)});}}
assert.equal(records.length,190);await json('history-authentication-before.json',{authorities,records,strictAuthor145AndIndependent43Exact:true,fullPayloadsPreservedAsInertCopies:true,priorFailuresAndFalseInheritance12ClaimRetained:true,priorAuthorHeldOutLabelsRetained:true,localParserAndOriginalNativeBinariesNotCopied:true});
const author=path.join(work,authorities[0].directory),review=path.join(work,authorities[1].directory),source=[...JSON.parse(await fs.readFile(path.join(author,'acquisition.json'))).records.map(r=>r.path),'source/shipped-vscode.d.ts.snapshot','authority/original-acquisition-freeze.json.snapshot','authority/original-acquisition-validation.json.snapshot'];for(const p of['acquisition.json','original-oracle.mjs','packet.mjs',...source])await save(p,await fs.readFile(path.join(author,p)));await save('NOTICE.md',await fs.readFile(path.join(author,'NOTICE.md')));
const transformations=[];async function adapt(from,dest,replacements){const b=await fs.readFile(from);let text=b.toString('utf8');const changes=[];for(const[a,z]of replacements){assert.equal(text.split(a).length-1,1,a);text=text.replace(a,z);changes.push({before:a,after:z});}await save(dest,text);transformations.push({sourcePath:path.relative(path.dirname(work),from).replaceAll('\\','/'),destination:dest,before:identity(b),after:identity(Buffer.from(text)),changes});}
await adapt(path.join(author,'position-range-selection.mjs'),'position-range-selection.mjs',[['  apply(...values){','  apply:function(...values){'],['  call(...values){','  call:function(...values){']]);
await adapt(path.join(author,'compatibility.test.mjs'),'compatibility.test.mjs',[["separately shaped held-out same-line/orientation corpus seed0xb49f0271 matches original","separately shaped author same-line/orientation corpus seed0xb49f0271 matches original"]]);
await adapt(path.join(author,'contracts.mjs'),'contracts.mjs',[['selectionInheritedRangeContractEntries:12','selectionInheritedRangeContractEntries:10,selectionInheritedRangeDistinctNames:9'],['.local/attempt-03/original-comparisons.json','runs/author/original-comparisons.json']]);
await adapt(path.join(review,'differential.test.mjs'),'review-replay/differential.test.mjs',[["../editor-position-range-selection-next/position-range-selection.mjs","../position-range-selection.mjs"]]);await save('review-replay/oracle.mjs',await fs.readFile(path.join(review,'oracle.mjs')));
await adapt(path.join(review,'authority.mjs'),'review-replay/authority.mjs',[["stage=path.join(path.dirname(root),'editor-position-range-selection-next'),discovery=path.join(path.dirname(root),'vscode-extension-api-discovery-next')","stage=path.resolve(root,'../../editor-position-range-selection-next'),discovery=path.resolve(root,'../../vscode-extension-api-discovery-next')"]]);
const corrected=await fs.readFile(path.join(root,'position-range-selection.mjs'));let inverse=corrected.toString();for(const[a,z]of[['  apply(...values){','  apply:function(...values){'],['  call(...values){','  call:function(...values){']])inverse=inverse.replace(z,a);assert.equal(hash(Buffer.from(inverse)),'7ad0b5ebb78ea575ca381551b7f827776523c606d9a481801f0eb34a67e2f1c1');await json('source-transformations.json',{transformations,runtimeOnlyTwoRegularFunctionSubstitutions:true,completePreviousRuntimeReconstructableByInverse:true,otherDocumentedBodiesUnchanged:true,reviewTestOnlyCandidateImportRetargeted:true,reviewOracleExact:true,reviewAuthorityOnlyOwnedRootResolutionRetargeted:true,old145And43Unchanged:true});
const discovery=path.join(work,'vscode-extension-api-discovery-next'),cache=JSON.parse(await fs.readFile(path.join(discovery,'local-only-cache.json'))),parser=cache.records.filter(r=>r.path.startsWith('.local/parser/'));assert.equal(parser.length,4);for(const r of parser)assert.deepEqual(identity(await fs.readFile(path.join(discovery,r.path))),{bytes:r.bytes,sha256:r.sha256});const runtime=identity(await fs.readFile(process.execPath));assert.equal(runtime.sha256,'b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3');await json('execution-controls-before.json',{Node:{path:process.execPath,version:process.version,...runtime},independentOracleParser:{sourceRoot:'work/vscode-extension-api-discovery-next',version:'5.9.3',records:parser,localOnly:true},originalNativeArchiveOrExeCopied:false,originalExecutableWorkbenchHostExecutions:0});console.log(JSON.stringify({preservedPayloads:188,preservedManifests:2,runtime:identity(corrected),sourceTransformationCount:transformations.length,tests:0,StudioWrites:0}));
