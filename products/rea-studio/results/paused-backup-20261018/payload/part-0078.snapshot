    {
      "id": "grafana.candidate.aba6dc7cda95d97303e5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "An unanchored query, such as: `{ span.foo =~ \"bar\" }` is now treated as: `{ span.foo =~ \"^bar$\" }`.",
      "headingPath": [
        "Before you begin",
        "Use autocomplete to write queries",
        "Anchored regular expressions"
      ],
      "source": {
        "path": "docs/sources/shared/datasources/tempo-editor-traceql.md",
