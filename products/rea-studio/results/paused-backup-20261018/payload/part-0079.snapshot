    {
      "id": "grafana.candidate.da73fddcb20b318f118b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "All queries in Explore get copied over to the new panel, the panel type is automatically selected based on queries’ response With multiple queries, it will view the response from the first, non hidden query to determine the visualization type",
      "headingPath": [
        "What's new in Grafana v8.5",
        "OSS",
        "Experimental Explore to Dashboard workflow"
      ],
