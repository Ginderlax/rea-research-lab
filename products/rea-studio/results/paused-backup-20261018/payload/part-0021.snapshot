  const repeatSecond = JSON.parse(repeatInput('publication-recheck.stdout.txt', ${JSON.stringify(fixed['publication-recheck.stdout.txt'])}).toString('utf8').trim().split(/\\r?\\n/).at(-1));
  assert.equal(repeatAttempt.status, 'failed'); assert.equal(repeatAttempt.generatedManifestValidated, false); assert.equal(repeatAttempt.controls.checks, 92);
