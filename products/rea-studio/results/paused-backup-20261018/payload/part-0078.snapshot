    {
      "id": "grafana.candidate.1185691dc59007985e17",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When sharing URLs with filters, remember to encode the URL. In the preceding example, replace the pipes (`|`) with `%7C` and the equality operator (`=`) with `%3D`.",
