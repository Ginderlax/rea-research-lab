      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.1a826869dbbcf9b5ae47",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can use any of the metrics from the previous examples to track short-term changes in the total active series:",
      "headingPath": [
        "Examples of high-cardinality alerts",
        "Detect sudden cardinality growth"
      ],
      "source": {
        "path": "docs/sources/alerting/examples/high-cardinality-alerts.md",
        "gitBlobSha": "74d080fbee5649aeff68af0737b330422dbaac15",
        "sha256": "5f8e34eea0e1b64fd4440879bd75c857145d8cfaff7b5522af83f6edb746746d",
        "lineStart": 160,
        "lineEnd": 160,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/examples/high-cardinality-alerts.md#L160-L160"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
