    {
      "id": "grafana.candidate.bdc252ca99314c0ec82a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Alternatively, set the `url` and `auth` attributes directly in the `provider` block. To view all the supported authentication formats, refer to the [provider authentication documentation](https://registry.terraform.io/providers/grafana/grafana/latest/docs#authentication).",
