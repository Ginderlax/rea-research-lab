    {
      "id": "grafana.candidate.89da1f868673fb9c8ae2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Refer to [Configuration](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-grafana/) for more information on what you can configure in `grafana.ini`.",
