    {
      "id": "grafana.candidate.7e0dae48c1db816cd2db",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The **No map repeating** option prevents the base map tiles from repeating horizontally when you pan across the world. This constrains the view to a single instance of the world map and avoids visual confusion when displaying global datasets. Enabling this option requires the map to reinitialize.",
      "headingPath": [
        "Geomap",
        "Configuration options",
        "Map view options",
        "No map repeating"
      ],
