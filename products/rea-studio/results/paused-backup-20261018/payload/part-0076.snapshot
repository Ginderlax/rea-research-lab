    {
      "id": "grafana.candidate.0ff300c2f77014794bc2",
      "syntaxRole": "table-row",
      "sourceText": "| TLS handshake fails against AWS RDS or RDS Proxy                           | Provide the [Amazon RDS root CA certificate](https://docs.aws.amazon.com/AmazonRDS/latest/UserGuide/UsingWithRDS.SSL.html) under **TLS/SSL Root Certificate** with **With CA Cert** enabled. |",
      "headingPath": [
        "Troubleshoot MySQL data source issues",
