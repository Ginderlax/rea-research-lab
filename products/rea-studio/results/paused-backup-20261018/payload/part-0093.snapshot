    for row in all_entries:assert not row.filename.startswith('/') and '\\' not in row.filename and '..' not in row.filename.split('/')
    entries=[r for r in all_entries if not r.is_dir()];assert len(entries)==85
    for row in entries:
        assert not row.is_dir() and not stat.S_ISLNK(row.external_attr>>16)
        assert not row.filename.startswith('/') and '\\' not in row.filename and '..' not in row.filename.split('/')
        b=archive.read(row);assert len(b)==row.file_size;assert b==roles['artifact/'+row.filename]
        assert not b.startswith((b'MZ',b'\x7fELF')) and not row.filename.lower().endswith(('.exe','.dll','.pdb'))
