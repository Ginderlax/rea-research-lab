    },
    {
      "id": "grafana.candidate.810e8d2d82787b1f6721",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Pause alert rule evaluation to prevent noisy alerting while tuning your alerts. Pausing stops alert rule evaluation and does not create any alert instances. This is different to mute timings, which stop notifications from being delivered, but still allow for alert rule evaluation and the creation of alert instances.",
      "headingPath": [
        "What's new in Grafana v9.4",
        "Alerting",
        "Alerting: alert rules",
        "Pause alert rule evaluation"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-4.md",
        "gitBlobSha": "45ce56665ca4f35f5a04a6213b45a29d1a3ddfc8",
        "sha256": "0149bcb00d079050a094ddb9bace1bde360efead88bd7cff979538dbd3130f77",
        "lineStart": 212,
        "lineEnd": 212,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v9-4.md#L212-L212"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.acfeca019c499a3fc4fa",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When managing large volumes of alerts, use extended alert rule search capabilities to filter folders, evaluation groups, and rules. Additionally, you can filter alert rules by their properties like labels, state, type, and health.",
      "headingPath": [
        "What's new in Grafana v9.4",
        "Alerting",
        "Alerting: alert rules",
        "Improved search for your alert rules"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-4.md",
