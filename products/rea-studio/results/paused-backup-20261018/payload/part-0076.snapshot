    {
      "id": "grafana.candidate.9dce95f961dbef1c7a01",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Query variables query Prometheus to populate dropdown values. When creating a query variable, select a Prometheus data source and choose a query type:",
