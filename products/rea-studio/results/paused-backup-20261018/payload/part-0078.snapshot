    {
      "id": "grafana.candidate.19da567f538af1a1493d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In the **Panel options** section of the panel editor pane, set basic options like panel title and description, as well as panel links. To learn more, refer to [Configure panel options](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/panels-visualizations/configure-panel-options/).",
      "headingPath": [],
