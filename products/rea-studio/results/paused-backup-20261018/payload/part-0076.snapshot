    },
    {
      "id": "grafana.candidate.f53f5b15c2c1d8d6a977",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When exploring data, previously selected tags filter the remaining result set. To select data, use the `seriesByTag` function, which takes tag expressions (`=`, `!=`, `=~`, `!=~`) to filter timeseries.",
      "headingPath": [
        "Graphite query editor",
        "Functions",
        "Select and explore data with tags"
      ],
      "source": {
        "path": "docs/sources/datasources/graphite/query-editor/index.md",
