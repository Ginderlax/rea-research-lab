      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b1d5a5b37b428a8513ef",
      "syntaxRole": "procedural-step",
      "sourceText": "1. The [`X-Grafana-Alerting-Datasource-UID` header](#x-grafana-alerting-datasource-uid) configures the data source that the imported alert rules will query. Use multiple `--extra-headers` flags to include other [optional headers](#optional-headers).",
      "headingPath": [
        "Import data source-managed rules to Grafana-managed rules",
        "Import rules with command-line tools",
        "mimirtool"
      ],
