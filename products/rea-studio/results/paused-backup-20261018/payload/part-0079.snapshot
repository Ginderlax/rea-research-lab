    },
    {
      "id": "grafana.candidate.f3f7570c82b9d773f681",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use [trusted types](https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Content-Security-Policy/trusted-types) to reduce the risk of XSS vulnerabilities, including the sanitization of third party libraries or plugins that have not explicitly performed sanitization.",
      "headingPath": [
        "What’s new in Grafana v10.0",
        "Security",
        "Trusted Types support"
      ],
