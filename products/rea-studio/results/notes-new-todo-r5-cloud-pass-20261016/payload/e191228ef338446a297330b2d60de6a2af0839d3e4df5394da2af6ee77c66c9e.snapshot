 assert proof['productionInstalled']is False and proof['historicalReceiptsRebound']is False and proof['applicationExecutions']+proof['originalExecutions']+proof['browserExecutions']==0 and proof['sourceStable']is True
 assert proof['compositionReceipt']==identity(content('notes-new-todo-composition.json'))and mapping(proof['currentSources'])==mapping(bundle['composedNotesSources'])and proof['sourceAuthentication']==expected_auth and proof['proofReadFiles']==60 and proof['proofReadBytes']==receipt['proofReadBytes']
 collector=content('active-source/scripts/verify-notes-new-todo-cloud.mjs.snapshot');assert identity(collector)==PINS[COLLECTOR];gitbound(COLLECTOR,collector)
