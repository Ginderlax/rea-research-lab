    {
      "id": "grafana.candidate.6468ef90219c26aa2fca",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Disable download of the public key for verifying plugin signature. The default is `false`. If disabled, it uses the hard-coded public key.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[plugins]`",
        "`public_key_retrieval_disabled`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
