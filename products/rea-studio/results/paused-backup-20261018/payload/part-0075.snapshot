    {
      "id": "grafana.candidate.d84e370b3ed2d6491fca",
      "syntaxRole": "list-item",
      "sourceText": "- **Limit the frequency of automated changes**: Frequent automated updates consume the available configuration history. Batch changes where possible so that a single mistake doesn't overwrite every recoverable version.",
      "headingPath": [
        "Configure Alertmanagers",
        "Manage Alertmanager configurations",
        "Configuration history limits"
      ],
      "source": {
        "path": "docs/sources/alerting/set-up/configure-alertmanager/_index.md",
        "gitBlobSha": "dddec7320e4e8ad2f130941954110e0aa18b447a",
        "sha256": "d4b6a9d9cd932cdda982ad32f4d09586e5b039506f45dd5f3c83f99a63484206",
        "lineStart": 167,
        "lineEnd": 167,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/set-up/configure-alertmanager/_index.md#L167-L167"
