    {
      "id": "grafana.candidate.40120c13678ac14877f0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For even more detail about all the changes in this release, refer to the [changelog](https://github.com/grafana/grafana/blob/main/CHANGELOG.md). For the specific steps we recommend when you upgrade to v10.0, check out our [Upgrade Guide](../../upgrade-guide/upgrade-v10.0/).",
      "headingPath": [
        "What’s new in Grafana v10.0"
      ],
