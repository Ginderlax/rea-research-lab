from typing import Any

import numpy as np


class Index:
    def __index__(self) -> int:
        return 0


class SubClass(np.ndarray[tuple[Any, ...], np.dtype[np.float64]]):
    pass


def func(i: int, j: int, **kwargs: Any) -> SubClass:
    return B


i8 = np.int64(1)

