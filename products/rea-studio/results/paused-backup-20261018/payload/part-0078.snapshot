        "lineEnd": 46,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/shared/datasources/tempo-traces-to-profiles.md#L46-L46"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.11b3e4c895b8f330e17e",
      "syntaxRole": "procedural-step",
      "sourceText": "1. **Tracing**: An OpenTelemetry SDK sending trace data to Tempo. Refer to the [OpenTelemetry getting started documentation](https://opentelemetry.io/docs/getting-started/) for setup instructions.",
      "headingPath": [
        "Before you begin"
      ],
      "source": {
        "path": "docs/sources/shared/datasources/tempo-traces-to-profiles.md",
