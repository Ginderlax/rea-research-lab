    {
      "id": "grafana.candidate.6fb50fde9c025cb4d615",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Notification policies provide you with a flexible way of designing how to handle notifications and minimize alert noise.",
      "headingPath": [
        "Notification policies"
      ],
      "source": {
