    {
      "id": "grafana.candidate.e4190ad7d9504196b23d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This section includes instructions for how to view permissions associated with roles, create custom roles, and update and delete roles.",
      "headingPath": [
        "Manage RBAC roles"
      ],
      "source": {
        "path": "docs/sources/administration/roles-and-permissions/access-control/manage-rbac-roles/index.md",
        "gitBlobSha": "ea0a862bb162a4d71c0f3227505ebaba435602be",
