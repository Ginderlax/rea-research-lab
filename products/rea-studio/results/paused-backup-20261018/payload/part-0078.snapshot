    {
      "id": "grafana.candidate.cac5bc0ee15377b2a9f6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To share a dashboard with specific external users, you can send them a link by email. Use this option when you only want to share your dashboard with specific people. When you share dashboards by email, recipients receive a one-time use link that's valid for **one hour**. Once the link is used, the viewer has access to the shared dashboard for **30 days**.",
      "headingPath": [
        "Externally shared dashboards",
