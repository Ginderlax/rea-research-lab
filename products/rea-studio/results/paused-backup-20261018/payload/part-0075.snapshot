    {
      "id": "grafana.candidate.86289194ac272683b2af",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This is the default behavior, used when **Enable Prefix Matching** is off. Grafana returns annotations for any alarm attached to the metric you specify.",
      "headingPath": [
        "Amazon CloudWatch annotations",
        "Create an annotation query",
        "Match alarms by metric"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/annotations/index.md",
