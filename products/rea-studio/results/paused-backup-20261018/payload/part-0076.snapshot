    {
      "id": "grafana.candidate.d08550d04365639645cc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To create advanced queries, switch to **Code mode** by clicking **Code** in the upper right of the editor window. Code mode supports the auto-completion of tables, columns, SQL keywords, standard SQL functions, Grafana template variables, and Grafana macros. Columns cannot be completed before a table has been specified.",
      "headingPath": [
        "MySQL query editor",
        "MySQL Code mode"
      ],
      "source": {
        "path": "docs/sources/datasources/mysql/query-editor/_index.md",
        "gitBlobSha": "337ba0971e35a147687cf26c4fbdfca2d0957e12",
        "sha256": "72419911caa4b30f1d8ca7cd56d58b2003ddcafbcc4e7f730eecabb535398ee3",
        "lineStart": 67,
        "lineEnd": 67,
