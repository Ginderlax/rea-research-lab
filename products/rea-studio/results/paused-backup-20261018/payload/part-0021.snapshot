import hashlib,json,shutil,re
w=Path('C:/Users/evanh/Documents/Codex/2026-10-12/go/work');prior=w/'notes-new-todo-r3-next';stage=w/'notes-new-todo-r4-next'
assert not stage.exists();stage.mkdir();shutil.copytree(prior/'candidate',stage/'candidate')
candidate=stage/'candidate';pin=lambda b:{'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
p=candidate/'products/rea-studio/apps/notes/client.mjs';b=p.read_bytes();start=b.index(b'  async function saveNote() {');end=b.index(b'  save.onclick = () => run(saveNote);',start)
assert b.count(b'  async function saveNote() {')==1
fragment=(w/'notes-new-todo-save-ownership-r4.fragment.txt').read_text().replace('\n','\r\n').encode();p.write_bytes(b[:start]+fragment+b[end:])
p=candidate/'products/rea-studio/apps/notes/new-todo.ui.test.mjs';p.write_bytes(p.read_bytes()+(w/'notes-new-todo-postcommit-refresh-regression-r4.fragment.txt').read_bytes())
contract=json.loads((prior/'source-contract.json').read_bytes())
contract['candidateContract'].append('After actual save commit, a later list-refresh failure is a separate outcome. Its message may publish only while the accepted generation, draft revision and all current field values still match; newer typing keeps its unsaved status and next save uses the committed ID/revision.')
contract['reviewCorrection']={'preservedFutureR3Authority':pin((prior/'change-authority.json').read_bytes()),'finding':'The prior generation-only post-accept refresh catch could replace a newer same-editor unsaved-draft status with a delayed refresh error.','correction':'Separate save failure from committed-save list-refresh failure, and require generation, draft revision and field ownership before any late error or final success publication.','newSourceRegressionGroups':1,'candidateExecuted':False}
encoded=(json.dumps(contract,indent=2)+'\n').encode();(stage/'source-contract.json').write_bytes(encoded);(candidate/'products/rea-studio/experiments/notes-new-todo/contract.json').write_bytes(encoded)
plan=(prior/'IMPLEMENTATION-PLAN.md').read_text().replace('The18 authored groups comprise6 API/state groups,7 simulated-DOM UI groups','The19 authored groups comprise6 API/state groups,8 simulated-DOM UI groups').replace('21 fixed Notes files and110 planned groups','21 fixed Notes files and111 planned groups')
plan+='\nThe separate R4 source correction preserves frozen R3. A peer found that a rejected post-accept list refresh could overwrite newer same-editor typing. The revised save path separates actual persistence failure from refresh failure after commit, and every late publication requires matching generation, draft revision and all field values. One added UI group first verifies the explicit committed-save/refresh-error distinction, then holds an actual post-accept list reply, types a newer body, rejects that reply and requires the unsaved status/body plus the correct next ID/revision save. This is a simulated-DOM API-adapter regression, not a new Chromium result.\n'
(stage/'IMPLEMENTATION-PLAN.md').write_text(plan,encoding='utf-8')
a=json.loads((prior/'change-authority.json').read_bytes());a['candidateRoot']=str(candidate)
for row in a['files']:row['after']=pin((candidate/row['path']).read_bytes())
groups=[]
for row in a['files']:
    if row['path'].endswith('.test.mjs'):groups+=re.findall(r"^test\('([^']+)'",(candidate/row['path']).read_text(),re.M)
assert len(groups)==len(set(groups))==19
a.update(candidateBytes=sum(r['after']['bytes'] for r in a['files']),authoredAdditionalGroups=19,newGroupNames=groups,plannedFutureNotesGroups=111,supersededFutureSourceAuthority=pin((prior/'change-authority.json').read_bytes()))
a['sourceAuthoringNotes'].append('R4 corrects independently found late post-commit list-refresh publication ownership and adds one meaningful held/rejected-refresh UI group. All current active sources and prior frozen stages remain untouched.')
out=stage/'change-authority.json';out.write_bytes((json.dumps(a,indent=2)+'\n').encode())
print(json.dumps({'path':str(out),**pin(out.read_bytes()),'files':len(a['files']),'candidateBytes':a['candidateBytes'],'groups':19,'contract':pin(encoded),'client':pin((candidate/'products/rea-studio/apps/notes/client.mjs').read_bytes()),'uiTests':pin((candidate/'products/rea-studio/apps/notes/new-todo.ui.test.mjs').read_bytes())}))
