    },
    {
      "id": "grafana.candidate.e4a28a7accb7ad491d40",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To group alerts by label, click the **Group by** field and select the labels from the dropdown menu. You can select multiple labels for alert grouping.",
