        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c17b9868010325461bed",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The transformation currently supports linear regression and polynomial regression to the fifth-degree.",
      "headingPath": [
        "What’s new in Grafana v10.3",
        "Dashboards and visualizations",
        "Moving average and trend lines using transformations",
