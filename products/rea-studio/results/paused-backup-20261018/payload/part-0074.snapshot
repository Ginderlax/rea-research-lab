      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c47081576d84e5add598",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can modify basic roles using the configuration file or with the RBAC API. Refer to [Manage RBAC roles](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/administration/roles-and-permissions/access-control/manage-rbac-roles) to learn how.",
      "headingPath": [
        "Role-based access control (RBAC) overview",
        "Available RBAC roles",
        "Basic roles",
        "Modify basic roles"
      ],
      "source": {
        "path": "docs/sources/administration/roles-and-permissions/access-control/_index.md",
