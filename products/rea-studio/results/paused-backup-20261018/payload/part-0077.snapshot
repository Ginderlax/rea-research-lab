    {
      "id": "grafana.candidate.a3e59eb3e182a60aea5a",
      "syntaxRole": "procedural-step",
      "sourceText": "6. Update the `[security]` section of the `grafana.ini` configuration file with the new Encryption Provider key that you created:",
