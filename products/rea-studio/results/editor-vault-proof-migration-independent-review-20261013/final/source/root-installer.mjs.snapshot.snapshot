import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import{createHash}from'node:crypto';
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab'),stage=path.join(work,'editor-vault-proof-migration-next'),own=path.join(work,'root-editor-vault-proof-migration-installation-next'),sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)});
const freezePin='e54e383a182201e6971ac1201ab41a5c20351e4f6dd3f28a35daab8faa6f9ead',copyPin='415621f0f174bb86a7007a56fa7beea93eb01c706eca0b8f4258095bb37ad1f6',livePin='adcd3e63deadf195a02fc537d2fa86bde7195d6db1401b5287f4c36636ad2918';
async function authority(){const b=await fs.readFile(path.join(stage,'freeze-manifest.json'));assert.equal(sha(b),freezePin);const j=JSON.parse(b);assert.equal(j.inventory.length,192);for(const r of j.inventory){assert(!r.path.includes('..')&&!r.path.startsWith('/')&&!r.path.includes('\\'));assert.deepEqual(id(await fs.readFile(path.join(stage,r.path))),{bytes:r.bytes,sha256:r.sha256});}return b;}
const fb=await authority(),cb=await fs.readFile(path.join(stage,'public-copy-list.json')),lb=await fs.readFile(path.join(stage,'live-verifier-copy-list.json'));assert.equal(sha(cb),copyPin);assert.equal(sha(lb),livePin);const copies=JSON.parse(cb),live=JSON.parse(lb);assert.equal(copies.records.length,191);assert.equal(live.records.length,8);
const publicPrefix='products/rea-studio/results/editor-vault-proof-migration-20261013';assert.equal(copies.prefix,publicPrefix);const paths=new Set();for(const r of copies.records){assert(r.publicPath.startsWith(publicPrefix+'/'));assert(r.publicPath.endsWith('.snapshot'));assert(!r.publicPath.includes('..'));assert(!paths.has(r.publicPath));paths.add(r.publicPath);assert.deepEqual(id(await fs.readFile(path.join(stage,r.sourcePath))),{bytes:r.bytes,sha256:r.sha256});}
assert.equal(copies.records.filter(r=>r.publicPath.startsWith(publicPrefix+'/verifier-before/')).length,7);
for(const r of live.records){assert(/^scripts\/[a-z-]+\.mjs$/.test(r.destination));assert(r.sourcePath==='candidate/'+r.destination);assert.deepEqual(id(await fs.readFile(path.join(stage,r.sourcePath))),r.after);if(r.before)assert.deepEqual(id(await fs.readFile(path.join(lab,r.destination))),r.before);else assert.equal(await fs.stat(path.join(lab,r.destination)).then(()=>true,()=>false),false);}
const dev=await fs.readFile(path.join(lab,'products/rea-studio/results/development-validation.json'));assert.equal(sha(dev),'333303c8bd8cd131da3f01e1414b0fba92bc321b2b63f178ab91d138b2bcfa44');
const before=JSON.parse(await fs.readFile(path.join(work,'editor-vault-suite-runs/2026-10-13T05-22-11.249Z/source-before.json')));for(const r of before)assert.deepEqual(id(await fs.readFile(path.join(lab,'products/rea-studio',r.path))),{bytes:r.bytes,sha256:r.sha256});
assert.equal(await fs.stat(own).then(()=>true,()=>false),false);await fs.mkdir(own);await fs.writeFile(path.join(own,'collector.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});const preflight={schema:'rea-root-proof-migration-installation-preflight/v1',at:new Date().toISOString(),sourceOnly:true,strictStageFiles:192,publicSourceCopies:193,livePaths:8,replacements:7,additions:1,unchangedApplicationSources:737,fullBehaviorRunReexecuted:false,productionWrites:0};await fs.writeFile(path.join(own,'preflight.json'),JSON.stringify(preflight,null,2)+'\n',{flag:'wx'});
for(const r of live.records)if(r.before){const p=path.join(own,'before',r.destination+'.snapshot');await fs.mkdir(path.dirname(p),{recursive:true});await fs.writeFile(p,await fs.readFile(path.join(lab,r.destination)),{flag:'wx'});}
assert(process.argv.includes('--install'),'Installation requires explicit root --install after independent review');
const reviewArg=process.argv.indexOf('--review-sha');assert(reviewArg>=0);const reviewPin=process.argv[reviewArg+1];assert(/^[0-9a-f]{64}$/.test(reviewPin));const reviewFolder=path.join(work,'editor-vault-proof-migration-independent-review');const rb=await fs.readFile(path.join(reviewFolder,'manifest.json'));assert.equal(sha(rb),reviewPin);const rm=JSON.parse(rb);assert(Array.isArray(rm.inventory)&&rm.inventory.length>0);for(const r of rm.inventory)assert.deepEqual(id(await fs.readFile(path.join(reviewFolder,r.path))),{bytes:r.bytes,sha256:r.sha256});await fs.writeFile(path.join(own,'independent-review-manifest.json.snapshot'),rb,{flag:'wx'});
await fs.mkdir(path.join(lab,publicPrefix));const publicRows=[];async function save(dest,b,sourcePath){assert(dest.startsWith(publicPrefix+'/')&&!dest.includes('..'));const p=path.join(lab,dest);await fs.mkdir(path.dirname(p),{recursive:true});await fs.writeFile(p,b,{flag:'wx'});publicRows.push({sourcePath,path:path.posix.relative(publicPrefix,dest),...id(b)});}
for(const r of copies.records)await save(r.publicPath,await fs.readFile(path.join(stage,r.sourcePath)),r.sourcePath);
await save(publicPrefix+'/public-copy-list.json.snapshot',cb,'public-copy-list.json');await save(publicPrefix+'/freeze-manifest.json.snapshot',fb,'freeze-manifest.json');assert.equal(publicRows.length,193);
const installed=[];for(const r of live.records){const b=await fs.readFile(path.join(stage,r.sourcePath));assert.deepEqual(id(b),r.after);await fs.writeFile(path.join(lab,r.destination),b,{flag:r.before?'w':'wx'});assert.deepEqual(id(await fs.readFile(path.join(lab,r.destination))),r.after);installed.push(r);}
await authority();for(const r of before)assert.deepEqual(id(await fs.readFile(path.join(lab,'products/rea-studio',r.path))),{bytes:r.bytes,sha256:r.sha256});
const result={schema:'rea-root-reviewed-proof-migration-installation/v1',at:new Date().toISOString(),installed,independentReviewManifestSHA256:reviewPin,stageFreezeSHA256:freezePin,publicCopies:193,applicationSourcesUnchanged:737,sourceOnly:true,newApplicationOriginalBrowserBenchmarkExecutions:0,oldReceiptsRebound:false};
await fs.writeFile(path.join(own,'installation.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});await save(publicPrefix+'/root-installation.json.snapshot',Buffer.from(JSON.stringify(result,null,2)+'\n'),'root-installation.json');await save(publicPrefix+'/root-installation-collector.mjs.snapshot',await fs.readFile(import.meta.filename),'root-installation-collector.mjs');
const mb=Buffer.from(JSON.stringify({schema:'rea-root-proof-migration-preservation/v1',at:new Date().toISOString(),snapshots:publicRows,strictSourcePayloads:192,strictManifestAdditional:1,rootInstallationArtifacts:2,sourceOnly:true,newBehaviorExecutions:0,oldReceiptsRebound:false},null,2)+'\n');await fs.writeFile(path.join(lab,publicPrefix,'preservation-manifest.json'),mb,{flag:'wx'});console.log(JSON.stringify({installed:8,publicSnapshots:publicRows.length,manifestSHA256:sha(mb),applicationSourcesUnchanged:737}));
