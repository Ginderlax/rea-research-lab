  "findings": [
    {
      "priority": "P1",
      "source": "editor-search-path-fix-next/products/rea-studio/apps/editor/client.mjs:126",
      "title": "Late successful save overwrites a newer in-memory draft",
      "observationPath": "runs/typing-1791852772869-0/observation.json",
      "diskCommit": "captured save A\n",
      "typingAfterCommit": "newer unsaved A\n",
      "afterResponse": {
        "dirtyMarker": "a.txt",
        "difference": "Minimal line edits: 0 (0 removed, 0 added)\n  captured save A\n  ",
        "afterTabNavigation": "captured save A\n"
      },
      "mechanism": "Object.assign(item,data) overwrites item.content with captured request text after awaiting API. The textarea still temporarily displays newer text but its document item becomes clean; tab navigation drops the newer text."
    },
    {
      "priority": "P2",
      "source": "editor-search-path-fix-next/products/rea-studio/apps/editor/client.mjs:41,126",
      "title": "Settled save response publishes to a disposed view",
      "successObservationPath": "runs/dispose-1791852772952-5/observation.json",
      "failureObservationPath": "runs/dispose-error-1791852772966-6/observation.json",
      "mechanism": "Successful save updates tabs/status without mounted check; run() publishes the injected held rejection status without mounted check.",
      "failureControlScope": "The success case holds a real completed handle Save. The rejection control injects a synthetic API failure and performs no handle Save or disk commit."
    }
  ],
  "controlResults": {
    "noTyping": "pass: captured content is committed and clean",
    "newDraft": "pass: unrelated new draft remains active and absent on disk",
    "selection": "pass: selected B stays active and its bytes remain unchanged",
