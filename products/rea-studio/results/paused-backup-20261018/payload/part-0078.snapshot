      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.ed712c0aeceeca265ee4",
      "syntaxRole": "list-item",
      "sourceText": "- `to` - Defines the upper limit of the time range, specified in ms, epoch, or relative time.",
      "headingPath": [],
      "source": {
        "path": "docs/sources/shared/dashboards/time-range-URLs.md",
        "gitBlobSha": "a80f5f4087e4d5fa54ea99b0d6d03f1c5d24b75c",
