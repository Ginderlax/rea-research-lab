    {
      "id": "grafana.candidate.a4ef7831f8c5d806da87",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When JWT validation is enabled, Grafana caches the JWKS keys to improve performance. The cache respects the `Cache-Control` header from the JWKS endpoint response. If no cache expiration is specified, keys are cached for 5 minutes by default.",
      "headingPath": [
        "Configure Google OAuth authentication",
        "Configure Google authentication client using the Grafana configuration file",
        "Enable Google OAuth in Grafana",
        "Configure JWT ID token validation"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md",
        "gitBlobSha": "53ca46b6aee0a719a8cbd28a536c33a8fe2e5733",
        "sha256": "a3ff08724962dd5598b98503415b00b745cf0225af5d2b42cdc330ad5f2f46e8",
        "lineStart": 177,
        "lineEnd": 177,
