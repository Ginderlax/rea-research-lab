    {
      "id": "grafana.candidate.be11b344ef2c9002f273",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The inf, infn, nan, and null functions all return a single value of the name. They primarily exist for testing. Example: `null()`.",
