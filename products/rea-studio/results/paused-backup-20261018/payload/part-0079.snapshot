    {
      "id": "grafana.candidate.f64715e9f7fdf99c792e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now navigate from a span in a trace view directly to logs relevant for that span. This feature is available for the Tempo, Jaeger, and Zipkin data sources.",
