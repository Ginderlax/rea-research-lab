    {
      "id": "grafana.candidate.26d50c4263bcfbfcf3b1",
      "syntaxRole": "list-item",
      "sourceText": "- `alertname:foo, team=frontend`, and `alertname:qux, team=backend` are in another group.",
      "headingPath": [
        "Group alert notifications",
        "Group notifications"
      ],
      "source": {
        "path": "docs/sources/alerting/fundamentals/notifications/group-alert-notifications.md",
