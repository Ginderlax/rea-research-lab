"""Source and portable backup identities only; no candidate import or execution."""
import gzip
import hashlib
import json
import subprocess
from pathlib import Path

work = Path(__file__).resolve().parent
repo = work.parent / 'outputs' / 'rea-research-lab'
stage = work / 'archive-aes-properties-fixture-correction-20261016-r3-next'
candidate = stage / 'public-candidate'
prefix = 'products/rea-studio/results/archive-aes-properties-fixture-correction-20261016/'
ident = lambda data: {'bytes': len(data), 'sha256': hashlib.sha256(data).hexdigest()}
pin = lambda row: {key: row[key] for key in ('bytes', 'sha256')}
authority_bytes = (stage / 'copy-authority.json').read_bytes()
assert ident(authority_bytes) == {'bytes': 26463, 'sha256': '9d0be4c0c946abd09852bae70f2b26ad77ba330c2e1ab306260d920982e3982d'}
authority = json.loads(authority_bytes)
assert len(authority['rows']) == authority['files'] == 65
assert len({row['path'] for row in authority['rows']}) == 65
actual_files = {path.relative_to(candidate).as_posix() for path in candidate.rglob('*') if path.is_file()}
assert actual_files == {row['path'] for row in authority['rows']}
total = 0
source_rows = [row for row in authority['rows'] if row['before'] is not None]
assert len(source_rows) == 7
tree_output = subprocess.run(['git', '-C', str(repo), 'ls-tree', '-r', '-z', '--full-tree', authority['baseHead'], '--'] + [row['path'] for row in source_rows], capture_output=True, check=True).stdout
tree = {}
for record in tree_output.split(b'\0'):
    if record:
        fields, name = record.split(b'\t', 1)
        mode, kind, oid = fields.decode().split()
        assert mode in ('100644', '100755') and kind == 'blob'
        tree[name.decode()] = oid
for row in authority['rows']:
    path = candidate / row['path']
    assert not path.is_symlink()
    data = path.read_bytes()
    assert ident(data) == row['after'], row['path']
    total += len(data)
    if row['before'] is not None:
        before = (candidate / (prefix + 'immediate-before/' + row['path'] + '.snapshot')).read_bytes()
        assert ident(before) == row['before']
        assert hashlib.sha1(b'blob ' + str(len(before)).encode() + b'\0' + before).hexdigest() == tree[row['path']]
assert total == authority['bytes'] == 1256524
manifest = json.loads((candidate / (prefix + 'preservation-manifest.json')).read_bytes())
backup = work / 'cloud-verification-backups' / 'run-38905581957'
evidence = backup / 'artifact-12049121547' / 'readable-evidence'
artifact_bytes = (backup / 'artifact-12049121547.zip').read_bytes()
assert ident(artifact_bytes)['sha256'] == manifest['actualFailure']['artifactSHA256'] == '931acaef3880fcea50b5bff9964673798f87c79e3756a88aadd9fe5541fcc271'
roles, retained, raw_total = set(), [], 0
for record in manifest['records']:
    role = record['sourcePath']
    assert role not in roles
    roles.add(role)
    stored = (candidate / (prefix + record['path'])).read_bytes()
    assert ident(stored) == pin(record['storage'])
    assert record['storage']['encoding'] in ('identity', 'gzip')
    raw = gzip.decompress(stored) if record['storage']['encoding'] == 'gzip' else stored
    assert ident(raw) == pin(record)
    raw_total += len(raw)
    if role.startswith('artifact/'):
        original = evidence / role.removeprefix('artifact/')
        retained.append(role.removeprefix('artifact/'))
    elif role.startswith('control-plane/'):
        original = backup / 'control-plane-evidence' / role.removeprefix('control-plane/')
    elif role == 'wrapper/job-116992410806.txt':
        original = work / 'cloud-verification-backups' / 'job-116992410806' / 'logs.txt'
    elif role == 'local/local-backup-verification.json':
        original = backup / 'artifact-12049121547' / 'local-backup-verification.json'
    elif role == 'local/collection-summary.json':
        original = backup / 'collection-summary.json'
    elif role == 'readers/source-authoring-and-preservation.mjs':
        original = work / 'author-archive-aes-properties-fixture-correction-20261016-r3.mjs'
    else:
        assert role in ('readers/unpack-cloud-attempt.py', 'readers/collect-readonly-installed-epoch-1245.mjs')
        original = work / role.removeprefix('readers/')
    assert original.read_bytes() == raw, role
assert len(retained) == 57
verification = json.loads((backup / 'artifact-12049121547' / 'local-backup-verification.json').read_bytes())
assert verification['allCRCAndBytesReadable'] is True and len(verification['files']) == 422
non_source = {row['path'] for row in verification['files'] if not row['path'].startswith('source/')}
assert non_source == set(retained)
omitted = manifest['omittedActiveSourceSnapshotPayloads']
assert len(omitted) == 365
assert {row['sourcePath'] for row in omitted} == {row['path'] for row in verification['files'] if row['path'].startswith('source/')}
for row in omitted:
    assert ident((evidence / row['sourcePath']).read_bytes()) == pin(row)
transition = manifest['declaredCorrection']
assert (repo / transition['historicalAfterImage']).read_bytes() == (candidate / transition['beforeImage']['path']).read_bytes()
bundle = json.loads((repo / 'products/rea-studio/experiments/archive-aes/bundle.json').read_bytes())
