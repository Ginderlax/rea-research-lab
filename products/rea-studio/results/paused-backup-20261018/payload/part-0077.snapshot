    },
    {
      "id": "grafana.candidate.0df396266ab758ea69f3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Force download of the public key for verifying plugin signature on startup. The default is `false`. If disabled, the public key is retrieved every 10 days. Requires `public_key_retrieval_disabled` to be `false` to have any effect.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[plugins]`",
        "`public_key_retrieval_on_startup`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
