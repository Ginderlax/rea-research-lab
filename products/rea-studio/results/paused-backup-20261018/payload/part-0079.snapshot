    },
    {
      "id": "grafana.candidate.66e959e1bd7fd67004ce",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In the upcoming Grafana 8.0 release, Application Insights and Insights Analytics query types within the Azure Monitor data source will be deprecated and be made read-only in favor of querying Application Insights from Metrics and Logs.",
      "headingPath": [
        "What's new in Grafana v7.5",
        "Grafana OSS features",
        "Deprecation notice for some Azure Monitor queries"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-5.md",
        "gitBlobSha": "1f762193f381b785ad3976e03c8d01c40a0022d5",
        "sha256": "16b32d97207c71fd11291c626f8e3a3697a2a6efe831270739f398e87132cc21",
        "lineStart": 84,
        "lineEnd": 84,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v7-5.md#L84-L84"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.e001d9deea5c09a00a9e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana 7.5 includes a deprecation notice for these queries, and some documentation to help users prepare for the upcoming changes.",
      "headingPath": [
        "What's new in Grafana v7.5",
        "Grafana OSS features",
        "Deprecation notice for some Azure Monitor queries"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-5.md",
