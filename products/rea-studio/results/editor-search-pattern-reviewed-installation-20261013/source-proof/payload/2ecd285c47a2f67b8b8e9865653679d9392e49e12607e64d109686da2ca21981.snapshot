    {
      "file": "candidate/products/rea-studio/apps/editor/client.mjs",
      "label": "Insert trusted fixed-normalization + linear offset adapter; no new import/static route",
      "before": "export async function render(root, api) {",
      "idBefore": {
        "bytes": 18504,
        "sha256": "67150d5e5e00296c6835ea995c009649abece81a447420b657b3e81922828981"
      },
      "after": "function textareaSelection(content,start,end,value) {\n  if(typeof content!=='string'||typeof value!=='string'||!Number.isSafeInteger(start)||!Number.isSafeInteger(end)||start<0||end<start||end>content.length)return null;\n  // Native textarea.value folds CRLF and bare CR to LF. Saved revisions and\n  // source offsets still describe the exact raw saved string.\n  if(content.replace(/\\r\\n?/g,'\\n')!==value)return null;\n  const interior=index=>{if(index===0||index===content.length)return false;const a=content.charCodeAt(index-1),b=content.charCodeAt(index);return a===13&&b===10||a>=0xd800&&a<=0xdbff&&b>=0xdc00&&b<=0xdfff;};\n  if(interior(start)||interior(end))return null;\n  let normalizedStart=start,normalizedEnd=end;\n  for(let i=0;i<end;i++)if(content.charCodeAt(i)===13&&content.charCodeAt(i+1)===10){if(i<start)normalizedStart--;normalizedEnd--;i++;}\n  return {start:normalizedStart,end:normalizedEnd};\n}\nexport async function render(root, api) {",
      "idAfter": {
        "bytes": 19416,
        "sha256": "f5ca4e9b65fb4b4d6d78976c1a0bffb871a9d6d66f4b83951794288e006937f1"
      },
      "occurrences": 1
    },
