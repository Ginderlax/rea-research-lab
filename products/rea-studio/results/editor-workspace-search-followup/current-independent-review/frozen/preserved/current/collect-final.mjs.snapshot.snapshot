import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import{createHash}from'node:crypto';import{spawn}from'node:child_process';
const root=import.meta.dirname,sha=b=>createHash('sha256').update(b).digest('hex'),startedAtUtc=new Date().toISOString(),run=path.join(root,'runs',`final-${startedAtUtc.replaceAll(':','-')}`);await fs.mkdir(run,{recursive:true});await fs.writeFile(path.join(run,'collector.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});
async function selected(folder=root,relative='products'){const rows=[];for(const entry of(await fs.readdir(path.join(folder,relative),{withFileTypes:true})).sort((a,b)=>a.name<b.name?-1:1)){const name=`${relative}/${entry.name}`;if(entry.isDirectory())rows.push(...await selected(folder,name));else{assert.ok(entry.isFile());const b=await fs.readFile(path.join(folder,name));rows.push({path:name,bytes:b.length,sha256:sha(b)});}}return rows;}
const before=await selected();for(const name of ['SEARCH.md','original-search-comparison.mjs','preserve-initial-search.mjs']){const b=await fs.readFile(path.join(root,name));before.push({path:name,bytes:b.length,sha256:sha(b)});}const baseline=JSON.parse(await fs.readFile(path.join(root,'baseline.json'),'utf8'));for(const row of baseline.files){const b=await fs.readFile(path.join(root,'../../outputs/rea-research-lab',row.path));assert.equal(sha(b),row.sha256,`Production changed during isolated search development:${row.path}`);}
const node=process.execPath,nodeBytes=await fs.readFile(node);assert.equal(sha(nodeBytes),'b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3');await fs.writeFile(path.join(run,'before.json'),JSON.stringify(before,null,2)+'\n',{flag:'wx'});for(const row of before){const destination=path.join(run,'source',`${row.path}.snapshot`);await fs.mkdir(path.dirname(destination),{recursive:true});await fs.copyFile(path.join(root,row.path),destination,fs.constants.COPYFILE_EXCL);}
const tests=before.filter(row=>row.path.endsWith('.test.mjs')).map(row=>row.path),expectedTests=(await Promise.all(tests.map(file=>fs.readFile(path.join(root,file),'utf8')))).reduce((sum,s)=>sum+[...s.matchAll(/^test\(/gm)].length,0),args=['--test','--test-reporter=tap',...tests];
const result=await new Promise(resolve=>{const child=spawn(node,args,{cwd:root,windowsHide:true,shell:false,stdio:['ignore','pipe','pipe']}),out=[],err=[];let size=0,failure=null;for(const[stream,parts]of[[child.stdout,out],[child.stderr,err]])stream.on('data',b=>{size+=b.length;if(size>4*1024*1024){failure??='4MiB combined-output bound';child.kill('SIGKILL');}else parts.push(b);});const timer=setTimeout(()=>{failure??='180second focused-suite bound';child.kill('SIGKILL');},180000);child.on('error',e=>failure??=e.message);child.on('close',(exitCode,signal)=>{clearTimeout(timer);resolve({exitCode,signal,failure,stdout:Buffer.concat(out),stderr:Buffer.concat(err)});});});
await fs.writeFile(path.join(run,'stdout.txt'),result.stdout,{flag:'wx'});await fs.writeFile(path.join(run,'stderr.txt'),result.stderr,{flag:'wx'});const after=await selected();for(const name of ['SEARCH.md','original-search-comparison.mjs','preserve-initial-search.mjs']){const b=await fs.readFile(path.join(root,name));after.push({path:name,bytes:b.length,sha256:sha(b)});}await fs.writeFile(path.join(run,'after.json'),JSON.stringify(after,null,2)+'\n',{flag:'wx'});const sourceStable=JSON.stringify(before)===JSON.stringify(after),tap=result.stdout.toString(),count=name=>Number(tap.match(new RegExp(`^# ${name} (\\d+)$`,'m'))?.[1]??-1),counts=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(name=>[name,count(name)]));let failure=result.failure;try{assert.equal(result.exitCode,0);assert.equal(result.signal,null);assert.equal(failure,null);assert.ok(sourceStable);assert.equal(counts.tests,expectedTests);assert.equal(counts.pass,expectedTests);for(const name of ['fail','cancelled','skipped','todo'])assert.equal(counts[name],0);assert.equal(sha(await fs.readFile(node)),sha(nodeBytes));}catch(e){failure=e.stack;}
const receipt={schema:'rea-editor-workspace-search-focused-validation/v1',startedAtUtc,completedAtUtc:new Date().toISOString(),run,expectedTests,counts,tests,args,nodeVersion:process.version,nodeSHA256:sha(nodeBytes),sourceFiles:before.length,sourceStable,exitCode:result.exitCode,signal:result.signal,failure,stdoutBytes:result.stdout.length,stdoutSHA256:sha(result.stdout),stderrBytes:result.stderr.length,stderrSHA256:sha(result.stderr),originalGUIExecutions:0,actualDOMTransportGroups:8,actualInProcessSearchHTTPHostInstances:2,actualSearchHTTPRestarts:1,productionUnchanged:true,fullParity:false,universalSuperiority:false};await fs.writeFile(path.join(run,'validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});if(failure){console.error(failure);process.exitCode=1;}else{await fs.writeFile(path.join(root,'focused-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:'PASS',counts,sourceFiles:before.length,run}));}
