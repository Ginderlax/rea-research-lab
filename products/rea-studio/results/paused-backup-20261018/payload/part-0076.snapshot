    {
      "id": "grafana.candidate.40e5f8e6465d255f216d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you set the operator to `=~` or `!=~`, you can add regular expressions to the filter value field.",
      "headingPath": [
        "Google Cloud Monitoring query editor",
        "Query metrics",
        "Apply a filter",
        "Use regular expressions"
      ],
      "source": {
        "path": "docs/sources/datasources/google-cloud-monitoring/query-editor/index.md",
