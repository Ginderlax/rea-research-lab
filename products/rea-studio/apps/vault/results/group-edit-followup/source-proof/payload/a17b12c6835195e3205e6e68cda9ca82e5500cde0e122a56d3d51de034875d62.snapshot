import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import{createHash}from'node:crypto';
const work=import.meta.dirname,prior=path.join(work,'root-vault-group-browser-visible-control'),own=path.join(work,'root-vault-group-edit-browser-review-next'),sha=b=>createHash('sha256').update(b).digest('hex');const mb=await fs.readFile(path.join(prior,'manifest.json'));assert.equal(sha(mb),'3c409a9150a39c9588323fe32b1fa74d0f2d1a095247bda93952cda349aa2582');for(const r of JSON.parse(mb).inventory){const b=await fs.readFile(path.join(prior,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);}await fs.mkdir(own,{recursive:false});const b=await fs.readFile(path.join(prior,'host.mjs'));await fs.writeFile(path.join(own,'host.mjs'),b,{flag:'wx'});await fs.writeFile(path.join(own,'preparation.json'),JSON.stringify({scope:'Fresh browser acceptance of empty native group creation and name/notes editing through exact normal shared host/shell and frozen885. Prior host collector reused byte-exact; its embedded read-only diagnostic references its initial historical preparation, not new product behavior.',priorManifestSHA256:sha(mb),collectorSHA256:sha(b),candidateManifest:'52a88d027dc910c3ef8723e80690aef98dacdc9c98d43902192663ca43799ff4',productionWrites:0,user4311Touched:false},null,2)+'\n',{flag:'wx'});await fs.copyFile(import.meta.filename,path.join(own,'preparation-collector.mjs.snapshot'));console.log(JSON.stringify({own,collectorSHA256:sha(b)}));
