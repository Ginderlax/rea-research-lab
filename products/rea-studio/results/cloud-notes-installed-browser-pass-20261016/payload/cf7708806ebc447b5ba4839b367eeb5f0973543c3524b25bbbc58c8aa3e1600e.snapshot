// Backup-only filing of the actual distinct Notes92 and Notes8 installed jobs.
// No product, verifier, browser, original, test or candidate module is imported.
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import {createHash} from 'node:crypto';
import {gzipSync,gunzipSync} from 'node:zlib';
import {spawnSync} from 'node:child_process';
const work=import.meta.dirname,repository=path.resolve(work,'../outputs/rea-research-lab');
const stage=path.join(work,'cloud-notes-installed-success-20261016-next'),candidate=path.join(stage,'public-candidate');
const run='38917424088',commit='362bda055ac4cf7201b2d6a75a2b30dc6fedb578',runRoot=path.join(work,'cloud-verification-backups/run-'+run);
const id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});
const pin=r=>({bytes:r.bytes,sha256:r.sha256});
const credentials=/\b(?:ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,}|AKIA[0-9A-Z]{16})\b|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----/;
function safe(n){assert(typeof n==='string'&&n&&!/[\\:\x00-\x1f\x7f]/.test(n)&&!n.startsWith('/')&&n.split('/').every(s=>s&&s!=='.'&&s!=='..'));return n;}
function read(base,n){let at=base;for(const p of safe(n).split('/')){at=path.join(at,p);assert(!fs.lstatSync(at).isSymbolicLink());}const s=fs.lstatSync(at);assert(s.isFile()&&s.size<=8*1024*1024);const b=fs.readFileSync(at);assert.equal(b.length,s.size);return b;}
const collectionBytes=read(runRoot,'installed-collection-summary-v2.json'),collection=JSON.parse(collectionBytes);
assert.equal(collection.schema,'rea-installed-Notes-two-job-readonly-collection/v2');assert.equal(collection.runId,run);assert.equal(collection.headSHA,commit);assert.equal(collection.runStatus,'completed');assert.equal(collection.runConclusion,'success');assert.equal(collection.terminalCompleteCollection,true);
assert.equal(collection.jobs.length,2);assert.equal(collection.artifacts.length,2);assert.deepEqual(collection.artifacts.map(r=>r.role).sort(),['browser','finite']);
const journalPath='products/rea-studio/results/notes-todo-installed-20261016/installation-receipt.json',journalBytes=read(repository,journalPath),journal=JSON.parse(journalBytes);
const journalGit=spawnSync('git',['-C',repository,'show',commit+':'+journalPath],{shell:false,windowsHide:true,timeout:30000,maxBuffer:2*1024*1024});assert.equal(journalGit.status,0);assert.deepEqual(journalBytes,journalGit.stdout);
assert.equal(journal.schema,'rea-Notes-actual-reviewed-source-installation/v1');assert.equal(journal.sourceInstallationPerformed,true);assert.equal(journal.sourceTargets,34);assert.equal(journal.applicationTargets,8);assert.equal(journal.actualPreInstallHead,'cc7a5830b1c4e719b1f3ceb5b3aa1abe52c3cae3');assert.equal(journal.hostedInstalledAcceptance,false);assert.equal(journal.historicalReceiptsRewritten,false);
const descriptors=[{role:'finite',job:117028376098,artifact:12052862392,bytes:1765300,sha256:'5798b2b1939b79ba59f3a09366ea4494ee01be49be84f420058ca8b0d627421d',files:449,census:795,snapshots:371,retained:19},
 {role:'browser',job:117028376576,artifact:12052757885,bytes:2093387,sha256:'76a4dd928e2b2e1af9a6b71222a8b44bbd4f0295ab0c3f6e01b246e10c73fbed',files:495,census:384,snapshots:384,retained:52}];
assert(!fs.existsSync(stage));fs.mkdirSync(candidate,{recursive:true});const rows=[],capsules=[];
for(const descriptor of descriptors){
 const {role,job,artifact}=descriptor,prefix='products/rea-studio/results/cloud-notes-installed-'+role+'-pass-20261016',target=path.join(candidate,prefix);
 assert(!fs.existsSync(path.join(repository,prefix)));fs.mkdirSync(path.join(target,'payload'),{recursive:true});
 const a=collection.artifacts.find(r=>r.artifactId===artifact),j=collection.jobs.find(r=>r.jobId===job);assert(a&&j&&a.role===role&&j.role===role);assert.equal(a.recordedContractPassed,true);assert.deepEqual(a.evidenceConsistencyErrors,[]);assert.equal(j.status,'completed');assert.equal(j.conclusion,'success');
 const backup=path.join(runRoot,'artifact-'+artifact+'-reader-v2'),evidence=path.join(backup,'readable-evidence');
 const reportBytes=read(backup,'local-installed-notes-backup-verification.json'),report=JSON.parse(reportBytes);
 assert.equal(report.schema,'rea-local-installed-Notes-two-job-backup/v2');assert.equal(report.runId,run);assert.equal(report.sourceCommit,commit);assert.equal(report.role,role);assert.equal(report.recordedContractPassed,true);assert.equal(report.allCRCAndBytesReadable,true);assert.deepEqual(report.evidenceConsistencyErrors,[]);assert.equal(report.files.length,descriptor.files);assert.equal(report.censusFiles,descriptor.census);assert.equal(report.sourceSnapshotFilesVerified,descriptor.snapshots);assert.equal(report.allEligibleSourceGitBlobsAuthenticated,descriptor.snapshots);
 assert.deepEqual(report.installedSourceAuthentication,{allNotesFiles:32,eligibleNotesSources:30,exactAfterTargets:8,allNotesAndDependenciesGitBlobAuthenticated:true,dependencyFiles:27});
 const zip=read(runRoot,'artifact-'+artifact+'.zip');assert.deepEqual(id(zip),pin(descriptor));
 const files=new Map();for(const r of report.files){safe(r.path);assert(!files.has(r.path));files.set(r.path,r);const bytes=read(evidence,r.path);assert.deepEqual(id(bytes),pin(r));assert(!bytes.subarray(0,2).equals(Buffer.from('MZ')),'Acquired program header cannot enter capsule');assert(!/\.(?:exe|dll|pdb)(?:\.snapshot)?$/i.test(r.path),'Acquired program carrier cannot enter capsule');}
 function artifactBytes(n){const row=files.get(n);assert(row);const b=read(evidence,n);assert.deepEqual(id(b),pin(row));return b;}
 const omit=n=>n.startsWith('installed-source/')||n.startsWith('installed-dependencies/')||n.startsWith(role==='finite'?'verification/source/':'source/');
 const omitted=[...files.values()].filter(r=>omit(r.path)).map(r=>({sourcePath:r.path,...pin(r)})),retained=[...files.keys()].filter(n=>!omit(n));assert.equal(omitted.length,descriptor.snapshots+32+27);assert.equal(retained.length,descriptor.retained);
 const records=[],objects=new Map();let rawRoleBytes=0;
 function save(sourcePath,bytes,origin){safe(sourcePath);assert(!records.some(r=>r.sourcePath===sourcePath));assert(!credentials.test(bytes.toString('utf8')));rawRoleBytes+=bytes.length;assert(rawRoleBytes<=16*1024*1024);let stored=bytes,encoding='identity';if(bytes.length>65536){const gz=gzipSync(bytes,{level:9});if(gz.length<bytes.length*.85){stored=gz;encoding='gzip';assert.deepEqual(gunzipSync(gz),bytes);}}
  const p=id(bytes),suffix=bytes.subarray(0,8).equals(Buffer.from('89504e470d0a1a0a','hex'))?'.png':encoding==='gzip'?'.gz.snapshot':sourcePath.startsWith('portable-artifact/')?'.zip.snapshot':'.snapshot',name='payload/'+p.sha256+suffix,storedPin=id(stored);
  if(!objects.has(name)){fs.writeFileSync(path.join(target,name),stored,{flag:'wx'});objects.set(name,storedPin);}assert.deepEqual(read(target,name),stored);records.push({sourcePath,path:name,...p,storage:{encoding,...storedPin},origin});
 }
 for(const n of retained)save('artifact/'+n,artifactBytes(n),'Exact uploaded non-source-subtree role from this verified installed job');
 save('portable-artifact/complete-github-artifact.zip',zip,'Exact digest-matched complete outer GitHub artifact ZIP and complete inner evidence; every source/native role remains recoverable');
 save('local/local-installed-notes-backup-verification-v2.json',reportBytes,'Complete successful byte-only readback report with all stored files/Git identities and recorded finite/browser gates');
 save('local/installed-collection-summary-v2.json',collectionBytes,'Exact two-job completed API/log/digest binding with separate roles');
 const oldBackup=path.join(runRoot,'artifact-'+artifact);save('readback-history/local-installed-notes-backup-verification-v1.json',read(oldBackup,'local-installed-notes-backup-verification.json'),'Preserved first readback-tool CRLF extraction failure; hosted evidence and product results were unchanged');
 save('readback-history/installed-collection-summary-v1.json',read(runRoot,'installed-collection-summary.json'),'Preserved first complete byte collection, before reader-only CRLF normalization');
 const logBytes=fs.readFileSync(j.rawJobLog.path);assert.deepEqual(id(logBytes),pin(j.rawJobLog));save('wrapper/job-'+job+'.txt',logBytes,'Complete actual GitHub-hosted job wrapper log');
 const controls=fs.readdirSync(runRoot,{withFileTypes:true}).filter(r=>r.isDirectory()&&r.name.startsWith('control-plane-'));assert.equal(controls.length,3);
 for(const directory of controls){assert(!directory.isSymbolicLink());for(const kind of ['run','jobs','artifacts'])save('control-plane-observations/'+directory.name+'/'+kind+'.json',read(runRoot,directory.name+'/'+kind+'.json'),'Complete raw observed GitHub run/job/artifact JSON; all observation versions remain separate roles');}
 for(const r of collection.controlPlane){const b=fs.readFileSync(r.path);assert.deepEqual(id(b),pin(r));save('control-plane-completed/'+r.kind+'.json',b,'The exact completed API objects authenticated by final v2 collector');}
 for(const n of ['collect-installed-notes-38917424088.mjs','unpack-installed-notes-run-38917424088.py','collect-installed-notes-38917424088-v2.mjs','unpack-installed-notes-run-38917424088-v2.py','notes-installed-backup-independent-source-review-38917424088.json','notes-installed-backup-v2-independent-source-review-38917424088.json'])save('readers/'+n,read(work,n),'Exact independent-reviewed read-only collector/backup reader source or its source peer; previous first-read versions remain separate');
 save('readers/preservation-collector.mjs',fs.readFileSync(import.meta.filename),'This exact work-only capsule filing source');save('source-installation-journal.json',journalBytes,'Exact actual34-source installation journal in tested362bda commit; its then-awaiting acceptance wording remains historical');
 const before=JSON.parse(artifactBytes('notes-installed-source-check.json')),after=JSON.parse(artifactBytes('notes-installed-postrun-source-check.json'));assert.deepEqual(before.authentication,after.authentication);assert.equal(before.sourceCommit,commit);assert.equal(after.sourceStable,true);assert.equal(before.authentication.currentSources.length,32);assert.equal(before.authentication.exactTargets.length,8);assert.equal(before.authentication.dependencies.length,27);
 const attempt=JSON.parse(artifactBytes(role==='finite'?'verification/attempt-validation.json':'browser-attempt.json'));assert.equal(attempt.status,'passed');assert.equal(attempt.sourceStable,true);assert.equal(attempt.sourceFiles,descriptor.census);
 if(role==='finite'){assert.deepEqual(attempt.summary,{tests:92,pass:92,fail:0,cancelled:0,skipped:0,todo:0,duration_ms:2200.5597});assert.equal(report.finiteObservations.originalHelperComparisons,20);assert.equal(report.finiteObservations.actualHttpModuleDeliveryVerified,true);}
 else{assert.deepEqual(attempt.summary,{tests:8,passed:8,failed:0,skipped:0,flaky:0,retries:0,exactRealDownloads:2,actualResponseHolds:4,genuineRevisionConflicts:1,originalProcesses:0});assert.equal(report.recordedEightScenarioNotesGatesConsistent,true);assert.equal(report.realHoldsVerified.length,4);assert.equal(report.realDownloadsVerified.length,2);assert.equal(report.pngCRCReadbacks.length,8);assert.equal(report.ownedCleanupRecordsVerified.length,8);assert.equal(report.independentTarReadback.unchangedRawRecords,6);}
 const manifest={schema:'rea-cloud-Notes-installed-'+role+'-pass-preservation/v1',createdAtUtc:new Date().toISOString(),status:'passed-committed-source-contracts',runId:run,runAttempt:1,jobId:job,jobName:j.name,runURL:'https://github.com/Ginderlax/rea-research-lab/actions/runs/'+run,sourceCommit:commit,testedGitCommit:commit,artifactId:artifact,artifactSHA256:descriptor.sha256,artifactArchiveBytes:descriptor.bytes,
 executionEnvironment:'github-hosted',runnerLabel:'windows-2022',node:'v24.16.0',sourceMode:'notes-todo-installed',sourceOverlayTargets:0,collectorSourceInstallationPerformed:false,collectorProductionInstallerReceiptAuthenticated:false,summary:attempt.summary,selectedTestFiles:role==='finite'?attempt.selectedTestFiles:null,
 sourceFiles:descriptor.census,sourceStable:true,allCurrentNotesFiles:32,eligibleNotesSources:30,exactCurrentAfterTargets:8,currentTargets:before.authentication.exactTargets,currentNotesSources:before.authentication.currentSources,all32And8GitAndExactPinsAuthenticated:true,pinnedDependencies:27,allEligibleGitBlobsAuthenticated:descriptor.snapshots,separatelyExecutedSourcePostcheck:'passed',separatelyExecutedBrowserGitPostcheck:role==='browser'?'source-verified':'not-this-scope',
 completeReadableLocalBackupVerified:true,localReadableFiles:descriptor.files,retainedArtifactFiles:retained.length,publicDirectSourceSnapshotAliases:0,completePublicHostedArtifactZipRetained:true,everyUploadedArtifactRoleInsidePublicZip:true,sourceSnapshotsInsideCompleteZip:omitted.length,sourceSnapshotIdentitiesInsideCompleteZip:omitted,
 omissionScope:'Only duplicate direct aliases for installed-source32, installed-dependencies27 and active census snapshots are omitted. Every uploaded source/native byte remains recoverable in the exact complete public outer artifact ZIP and its inner evidence ZIP, as well as the complete verified readable local backup. Every nonsource artifact role, raw API observation, complete job log and reader source is retained separately. No acquired original vendor programs are retained.',
 records,uniquePublicObjects:objects.size,allStoredAndDecodedCopiesExact:true,sourceInstallationJournal:{path:journalPath,...id(journalBytes),exactTestedGitBlob:true,historicalAwaitingAcceptanceStatementRewritten:false},
 currentFinite92Acceptance:role==='finite',currentRealBrowser8Acceptance:role==='browser',authoredNewGroups:role==='finite'?23:null,originalHelperComparisons:role==='finite'?20:0,helperComparisonCountsAddedToGroups:false,originalFullApplicationExecutions:0,originalGuiExecutions:0,actualHttpModuleDelivery:role==='finite'?true:null,
 realSuccessfulResponseHolds:role==='browser'?4:null,actualBrowserDownloads:role==='browser'?2:null,actualPngsAndCompleteOwnedCleanups:role==='browser'?8:null,genuineHostHttp400RevisionConflicts:role==='browser'?1:null,nativeJexReadback:role==='browser'?report.independentTarReadback:null,browserWorkers:role==='browser'?attempt.browserWorkers:null,programmaticDisabledControlProbes:0,
 firstReadbackToolFailurePreserved:true,hostedRerunForReaderCorrection:false,recordedHostedProductFailure:false,historicalExperimental92Or8Rebound:false,historicalSourcePlansRewritten:false,countsAggregatedAcrossJobs:false,fullDevelopmentSuiteAcceptance:false,everyDocumentedFeatureAcceptance:false,securityAcceptance:false,fullParity:false,superiority:false,
 localProductExecutions:0,localOriginalExecutions:0,localTests:0,localBuilds:0,localBrowserExecutions:0,
 acceptanceScope:role==='finite'?'Actual92/92 current Notes groups across the fixed17-file roster on committed362bda sources. All23 new names,20 separately observed released-Joplin helper comparisons and actual HTTP client/module delivery verified. All32 Notes files/eight after pins/27 dependencies,371 active Git snapshots and independent always source postcheck passed. No browser, original full application/GUI/database, full development suite, every-feature, security, parity or superiority acceptance.':'Actual8/8 unchanged real Chromium Notes cases on committed362bda sources. All32 Notes files/eight after pins/27 dependencies,384 active Git snapshots and independent Notes/browser postchecks passed. Four genuine successful-response holds,two raw downloads,eight CRC-checked PNGs/complete cleanups and one actual HTTP400 conflict verified; native JEX tar bytes and resource retained. No source overlay, disabled-control probes or original processes. No browser matrix, full development suite, every-feature, security, parity or superiority acceptance.'};
 const manifestBytes=Buffer.from(JSON.stringify(manifest,null,2)+'\n');fs.writeFileSync(path.join(target,'preservation-manifest.json'),manifestBytes,{flag:'wx'});
 for(const r of records){const stored=read(target,r.path);assert.deepEqual(id(stored),pin(r.storage));assert.deepEqual(id(r.storage.encoding==='gzip'?gunzipSync(stored):stored),pin(r));}
 const publicRows=[{path:prefix+'/preservation-manifest.json',before:null,after:id(manifestBytes)},...[...objects].map(([name,p])=>({path:prefix+'/'+name,before:null,after:p}))];rows.push(...publicRows);capsules.push({role,prefix,manifest:id(manifestBytes),files:publicRows.length,records:records.length,objects:objects.size,retainedArtifactFiles:retained.length,sourceSnapshotsInsideCompleteZip:omitted.length,completeZipRetained:true,rawRoleBytes});
}
assert.deepEqual(read(repository,journalPath),journalBytes);assert(rows.length<=160&&rows.reduce((n,r)=>n+r.after.bytes,0)<=8*1024*1024);
const authority={schema:'rea-installed-Notes-two-job-success-capsule-authority/v1',stage,sourceCommit:commit,runId:run,files:rows.length,bytes:rows.reduce((n,r)=>n+r.after.bytes,0),rows,capsules,sourceOnlyFiling:true,distinctJobScopes:2,allStoredAndDecodedReadbacksExact:true,completeLocalBackupsReadable:true,completePublicHostedArtifactZips:2,all944HostedFilesRecoverableInsidePublicZips:true,all32NotesAnd8AfterPinsAuthenticated:true,firstReadbackToolFailureAndVersionsPreserved:true,historicalReceiptsRebound:false,independentReviewPending:true,activeFilesWritten:0,gitMutations:0,localProductExecutions:0,localOriginalExecutions:0,localTests:0,localBuilds:0,localBrowserExecutions:0,fullParity:false,superiority:false};
const bytes=Buffer.from(JSON.stringify(authority,null,2)+'\n');fs.writeFileSync(path.join(stage,'copy-authority.json'),bytes,{flag:'wx'});console.log(JSON.stringify({authority:id(bytes),files:authority.files,bytes:authority.bytes,capsules}));
