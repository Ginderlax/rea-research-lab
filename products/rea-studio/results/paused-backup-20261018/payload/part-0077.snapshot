    {
      "id": "grafana.candidate.5175ec4ae26ddf34044f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This option is deprecated - use `auto_login` option for specific OAuth provider instead.",
      "headingPath": [
        "Configure Grafana",
