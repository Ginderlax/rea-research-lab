import {readFile,writeFile} from 'node:fs/promises';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const hash=value=>createHash('sha256').update(value).digest('hex'),file=new URL('independent-validation.json',import.meta.url),report=JSON.parse(await readFile(file)),draft=JSON.parse(await readFile(new URL('historical-stage/draft-validation.json',import.meta.url))),raw=await readFile(new URL('historical-stage/formal-test-output.tap.txt',import.meta.url)),oldReader='outputs/rea-research-lab/products/rea-studio/apps/backup/restic.mjs';
assert.equal(hash(raw),draft.rawEvidence.sha256);assert.equal(hash(await readFile(oldReader)),'70bf4a5bfd46041823fa00bd7cdbf880f6c0a9020f67ef9e7a807b4242fbb527');assert.equal(report.summary.pass,5);assert.equal(report.summary.fail+report.summary.skipped+report.summary.cancelled,0);
report.reviewStatus='ready';report.unresolvedConfirmedFindings=[];report.stagedHistoricalEvidence={receiptSha256:report.originalSourceReceiptSha256,rawTestOutputSha256:hash(raw),exactSourceSnapshots:'historical-stage/',allTenFingerprintMatches:true};report.referencedFrozenLegacyWriter={path:oldReader,sha256:'70bf4a5bfd46041823fa00bd7cdbf880f6c0a9020f67ef9e7a807b4242fbb527',authentication:'Expected source hash checked before its first fixture operation and again after the complete independent run.'};report.original.commandCounts=Object.fromEntries([...new Set(report.original.observations.map(value=>value.args[0]))].map(command=>[command,report.original.observations.filter(value=>value.args[0]===command).length]));report.original.successfulExecutions=report.original.observations.filter(value=>value.exitCode===0).length;report.original.expectedRejections=report.original.observations.filter(value=>value.exitCode!==0).length;report.explicitAcceptanceDeviation='Original check --read-data accepts a valid snapshot followed by 17 MiB JSON whitespace; candidate check/restore reject it under the documented 16 MiB decoded metadata subset before output. This is a bounded-reader limitation, not a format-equality match.';report.additionalChecks=['Repeated identical 1 MiB source chunks share IDs, and a 17-byte tail has a distinct ID.','Mode switch preserves existing uncompressed/compressed data records without adding duplicate data blobs.','All eight candidate corruption/metadata cases reject check and restore with no destination created and no app-owned lock left before original execution.','512 KiB or smaller frame windows, disabled checksums, empty blobs/metadata, growing single-byte frames, exact 16 MiB and excess input boundaries.'];report.finalizedAtUtc=new Date().toISOString();await writeFile(file,`${JSON.stringify(report,null,2)}\n`);console.log(JSON.stringify({summary:report.summary,originalCommands:report.original.commandCounts,originalSuccesses:report.original.successfulExecutions,originalExpectedRejections:report.original.expectedRejections,reviewStatus:report.reviewStatus,receiptSha256:hash(await readFile(file))}));
