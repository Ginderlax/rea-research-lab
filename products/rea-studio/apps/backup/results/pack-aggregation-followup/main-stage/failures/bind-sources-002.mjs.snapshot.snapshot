import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
const root=path.dirname(fileURLToPath(import.meta.url)),hash=b=>createHash('sha256').update(b).digest('hex'),provenance=JSON.parse(await fs.readFile(path.join(root,'source-provenance.json'))),bindings=[];
const contracts={'doc/design.rst':['Pack Format','Unpacked Data Format','Indexing','Writing data'], 'internal/repository/pack/pack.go':['func (p *Packer) Add(','func (p *Packer) Finalize(','func makeHeader(','func List(','func parseHeaderEntry('],'internal/repository/packer_manager.go':['func (r *packerManager) Flush(','func (r *packerManager) SaveBlob(','func (r *packerManager) pickPacker('], 'internal/repository/index/index.go':['type packJSON struct','type blobJSON struct','func (idx *Index) generatePackList('], 'internal/repository/repository.go':['const DefaultPackSize','func (r *Repository) saveAndEncrypt(','func (r *Repository) FlushPacks(']};
for(const reference of provenance.references){const bytes=await fs.readFile(path.join(root,reference.path));if(hash(bytes)!==reference.sha256)throw new Error('Reference changed '+reference.path);const lines=bytes.toString('utf8').split('\n');for(const anchor of contracts[reference.originalPath]??[]){const pos=lines.findIndex(line=>line.startsWith(anchor));if(pos<0)throw new Error('Missing contract anchor '+anchor);let end=pos+1;if(anchor.startsWith('func ')||anchor.startsWith('type ')){const tail=lines.slice(pos+1).findIndex(line=>line==='}');if(tail>=0)end=pos+tail+2;}bindings.push({reference:reference.path,originalPath:reference.originalPath,sha256:reference.sha256,url:reference.url,anchor,startLine:pos+1,endLine:end,role:'Source-assisted contract binding; original helper not executed as staged runtime.'});}}
await fs.writeFile(path.join(root,'contract-bindings.json'),JSON.stringify({schema:'rea-restic-pack-contract-bindings/v1',commit:provenance.commit,bindings,policyDifferences:['Original target is based on packer payload size and concurrent pack managers; stage includes header/trailer and sequential admission.','Original streams temporary pack payloads, merges pending packers, and randomizes pack selection; stage owns bounded encrypted payload buffers.','Original index tracks pending IDs and serializes every distinct row; stage tracks pending verified data IDs and actual loaded row count.']},null,2)+'\n');console.log(JSON.stringify({bindings:bindings.length}));
