      "given": "a Grafana-managed alert with a breached condition",
      "when": "evaluate with pending period zero",
      "then": "the alert bypasses Pending and transitions immediately to the resulting Alerting, No Data or Error state",
      "source": {
        "path": "docs/sources/alerting/fundamentals/alert-rule-evaluation/_index.md",
