  documents.push({ ...source(record, 1, lines.length), localPath: record.localPath, bytes: record.bytes, title: metadata.title ?? null, frontmatterProducts: metadata.products, applicability: applicability(metadata.products, [], ''), platform: platform(record.path), scanned: true, bodyLines: lines.length - metadata.end - 1, codeBlockLines: codeLines, headingCount, candidateCount, dependencyCount: includeCount, authoredContractCount: 0, semanticReviewComplete: false, fullFeatureEnumerationComplete: false });
