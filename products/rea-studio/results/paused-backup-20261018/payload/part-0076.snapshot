    {
      "id": "grafana.candidate.064ae029c5a3e0c10c28",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you configure an annotation query, Grafana queries OpenTSDB for the specified metric and retrieves any annotations associated with that metric's time series. The query includes the `globalAnnotations=true` parameter, which allows Grafana to also retrieve global annotations when enabled.",
      "headingPath": [
        "OpenTSDB annotations",
        "How Grafana retrieves annotations"
