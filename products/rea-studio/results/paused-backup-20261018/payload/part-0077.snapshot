    {
      "id": "grafana.candidate.1269483ed169a5d1ffde",
      "syntaxRole": "list-item",
      "sourceText": "- A new stat for the usage stats page -> Usage & Stats page shows the active anonymous devices last 30 days.",
      "headingPath": [
        "Anonymous authentication",
        "Anonymous devices"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/anonymous-auth/index.md",
