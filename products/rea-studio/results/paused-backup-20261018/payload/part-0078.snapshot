    {
      "id": "grafana.candidate.042bbd36da5564cfcab4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use a _custom_ variable for a value that doesn't change, such as a number or a string.",
      "headingPath": [
        "Add variables",
        "Add a custom variable"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/variables/add-template-variables.md",
        "gitBlobSha": "4457b936a9bfd014008fb8f048e6298c3d09adf4",
        "sha256": "4974eb465335c4f545040002170c2cbf56fce6881ca54c1b130c25cf2a89ca17",
