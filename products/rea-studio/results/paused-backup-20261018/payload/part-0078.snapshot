      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.f4094dec5ad1639b341c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To define hard limits of the y-axis, set standard min/max options. For more information, refer to [Configure standard options](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/panels-visualizations/configure-standard-options/#max).",
      "headingPath": [
        "Placement",
        "Scale",
        "Soft min and soft max"
      ],
