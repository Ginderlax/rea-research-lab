import fs from'node:fs';import path from'node:path';import{createHash}from'node:crypto';const own='work/keepass-group-bin-coherence-fix-next',before=fs.readFileSync(own+'/candidate-before/group-ui.test.mjs.snapshot','utf8');let after=before.replace("from'./client.mjs'","from'../products/rea-studio/apps/vault/client.mjs'").replace("from'./server.mjs'","from'../products/rea-studio/apps/vault/server.mjs'").replace("from'./ui-fixture.mjs'","from'../products/rea-studio/apps/vault/ui-fixture.mjs'");fs.mkdirSync(own+'/diagnostics',{recursive:true});fs.writeFileSync(own+'/diagnostics/old-ui-exact.test.mjs',after);const strip=s=>s.replace(/from'[^']+'/g,"from'<path>'");if(strip(before)!==strip(after))throw new Error('Old UI body adapter changed semantics');const sha=b=>createHash('sha256').update(b).digest('hex');fs.writeFileSync(own+'/diagnostics/adapter.json',JSON.stringify({schema:'rea-exact-prior-author-ui-retry-adapter/v1',oldPath:'candidate-before/group-ui.test.mjs.snapshot',beforeSHA256:sha(before),adaptedPath:'diagnostics/old-ui-exact.test.mjs',afterSHA256:sha(after),bodyEquivalent:true,changes:'Three current runtime/helper import paths only; all seven old test bodies/assertions unchanged.',expectedFailure:'Old detached-control retry assertion expects deletion without explicit fresh list/reconfirmation; corrected UI intentionally refuses detached controls.'},null,2)+'\n');
