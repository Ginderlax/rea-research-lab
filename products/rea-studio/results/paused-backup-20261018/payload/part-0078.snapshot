    {
      "id": "grafana.candidate.a56afc1e1f4836ec4793",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can also use the legend to open the color picker by clicking the legend series color icon. Setting color this way automatically creates an override rule that set's a specific color for a specific series.",
      "headingPath": [
