    {
      "id": "grafana.candidate.0d4eadc0156bc14d87d5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In addition to the actions listed above, any HTTP request (`POST`, `PATCH`, `PUT`, and `DELETE`) against the API is recorded with one of the following generic actions.",
      "headingPath": [
        "Audit a Grafana instance",
        "Understand audit logs",
        "Identify recorded actions",
        "Generic actions"
      ],
      "source": {
