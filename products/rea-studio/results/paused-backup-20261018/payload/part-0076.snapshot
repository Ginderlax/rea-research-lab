    {
      "id": "grafana.candidate.ac55b0e9aee9120e22a1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This is expected behavior. The **Both** query type is only available in [Explore](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/explore/). Dashboard panels support only one visualization type, so Grafana limits the options to **Metric** or **Profile**. If a query set to **Both** in Explore is used in a dashboard, Grafana automatically changes it to **Profile**.",
      "headingPath": [
        "Troubleshoot Parca data source issues",
        "Query editor issues",
        "\"Both\" query type is missing"
      ],
      "source": {
