    {
      "id": "grafana.candidate.b2989fd1dea4ce49c849",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In this step you proceed to synchronize the resources selected in the previous step. Optionally, you can check the **Migrate existing resources** box to migrate your unmanaged dashboards to the provisioned folder.",
