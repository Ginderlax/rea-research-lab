import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const root=path.dirname(fileURLToPath(import.meta.url)),workspace=path.resolve(root,'../..'),commit='07f806f999227108933c2e30515b26eecc1fda74',hash=b=>createHash('sha256').update(b).digest('hex');
const save=async(p,b)=>{const filename=path.join(root,p);await fs.mkdir(path.dirname(filename),{recursive:true});await fs.writeFile(filename,b,{flag:'wx'});};
const authority=path.join(workspace,'work/vscode-original-acquisition-record'),proofBytes=await fs.readFile(path.join(authority,'freeze-manifest.json')),proof=JSON.parse(proofBytes);assert.equal(hash(proofBytes),'b592b223568ddc0736f9b6a9509b6eecbf9832b14e361cf31dcbf71878a636ec');
const rows=proof.inventory??proof.files;assert.ok(rows&&typeof rows==='object');for(const[p,r]of Object.entries(rows)){const bytes=await fs.readFile(path.join(authority,p));assert.equal(bytes.length,r.bytes);assert.equal(hash(bytes),r.sha256);}await save('authority/original-acquisition-freeze.json.snapshot',proofBytes);await save('authority/original-acquisition-validation.json.snapshot',await fs.readFile(path.join(authority,'validation.json')));
const discovery=path.join(workspace,'work/vscode-extension-api-discovery-next'),metadata=JSON.parse(await fs.readFile(path.join(discovery,'acquisition.json'))),records=[];
for(const name of ['vscode.d.ts','LICENSE.txt','package.json','commit.json']){const r=metadata.records.find(r=>r.path==='source/'+name+'.snapshot'),bytes=await fs.readFile(path.join(discovery,r.path));assert.equal(bytes.length,r.bytes);assert.equal(hash(bytes),r.sha256);await save('source/'+name+'.snapshot',bytes);records.push({...r,acquisition:'Authenticated existing official pinned-source snapshot'});}
const released='work/original-products/vscode/1.140.0/unpacked/07f806f999/resources/app/out/vscode-dts/vscode.d.ts',shipped=await fs.readFile(path.join(workspace,released));assert.equal(shipped.length,763513);assert.equal(hash(shipped),'b702638b10d57bb5c61dbe79cb3c071a0bee6a8b8b074de0f8a03f333b4b9270');await save('source/shipped-vscode.d.ts.snapshot',shipped);assert.equal(shipped.toString().replaceAll('\r\n','\n'),(await fs.readFile(path.join(root,'source/vscode.d.ts.snapshot'))).toString());
const wanted=['src/vs/workbench/api/common/extHostTypes.ts','src/vs/workbench/api/common/extHostTypes/position.ts','src/vs/workbench/api/common/extHostTypes/range.ts','src/vs/workbench/api/common/extHostTypes/selection.ts','src/vs/workbench/api/common/extHostTypes/es5ClassCompat.ts','src/vs/base/common/errors.ts'];
for(const name of wanted){const url='https://raw.githubusercontent.com/microsoft/vscode/'+commit+'/'+name,response=await fetch(url,{signal:AbortSignal.timeout(30000)});assert.equal(response.status,200,url);assert.equal(response.url,url);const bytes=Buffer.from(await response.arrayBuffer());assert.ok(bytes.length<=512*1024);await save('source/'+name+'.snapshot',bytes);records.push({path:'source/'+name+'.snapshot',url,responseURL:response.url,status:response.status,bytes:bytes.length,sha256:hash(bytes),acquisition:'Direct exact-commit official primary-source fetch'});}
await save('acquisition.json',JSON.stringify({schema:'rea-editor-position-range-selection-acquisition/v1',at:new Date().toISOString(),release:'1.140.0',commit,records,shippedDeclaration:{sourcePath:released,bytes:shipped.length,sha256:hash(shipped),normalizedLfMatchesOfficialExactly:true},priorOriginalAcquisition14Authenticated:true,sourceEvaluationOnlyAuthorized:true,workbenchExecuted:false,originalNativeArchivesCopied:false},null,2)+'\n');console.log(JSON.stringify({records:records.length,shipped:hash(shipped),originalManifestEntries:Object.keys(rows).length}));
