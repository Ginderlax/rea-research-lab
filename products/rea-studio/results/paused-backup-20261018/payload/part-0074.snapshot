    {
      "id": "grafana.candidate.ce725ea712cb3773969d",
      "syntaxRole": "list-item",
      "sourceText": "- **Reducing system load:** Precomputing specific queries in advance can reduce system overload caused by multiple simultaneous queries.",
      "headingPath": [
        "Configure recording rules"
      ],
      "source": {
