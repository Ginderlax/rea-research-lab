    {
      "id": "grafana.candidate.c32bad7c321b83dd0962",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To ensure that the `groups` claim is included in the token, add the `groups` claim to the token configuration either through the Azure Portal UI or by editing the manifest file.",
