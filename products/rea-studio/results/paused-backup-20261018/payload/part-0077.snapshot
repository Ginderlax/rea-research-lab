      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.53ce488c5b151ffd3662",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Options are `file`, `loki`, and `logger`. Use spaces to separate multiple modes, such as `file loki`.",
      "headingPath": [
        "Audit a Grafana instance",
        "Configure audit logging"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/audit-grafana.md",
