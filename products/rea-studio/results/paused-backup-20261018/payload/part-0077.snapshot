    },
    {
      "id": "grafana.candidate.1e1f7836c7584835faea",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The `disableAutoLogin=true` URL parameter allows users to bypass the automatic login feature in scenarios where incorrect configuration changes prevent normal login functionality. This feature is especially helpful when you need to access the login screen to troubleshoot and fix misconfigurations.",
      "headingPath": [
        "Configure authentication",
        "Extended authentication settings",
        "Avoid automatic login"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/_index.md",
        "gitBlobSha": "4eaeb6c9573c12f36370a29ae5cde9ef8903af26",
        "sha256": "c0d14f6586dd5c3329bd35640260ccf0154fa243faff94f744821a626f330ebe",
        "lineStart": 208,
        "lineEnd": 209,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/_index.md#L208-L209"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.a59b9d6d6680b6ba03f3",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Add `disableAutoLogin=true` as a query parameter to your Grafana URL.",
      "headingPath": [
        "Configure authentication",
        "Extended authentication settings",
        "Avoid automatic login",
        "How to use"
      ],
      "source": {
