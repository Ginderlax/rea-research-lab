    {
      "id": "grafana.candidate.b025813b279dd397e7df",
      "syntaxRole": "list-item",
      "sourceText": "- Avoid `SELECT *`: Explicitly select only the columns you expect to exist.",
      "headingPath": [
        "SQL expressions",
        "Known limitations",
        "Schema changes and missing data",
        "Workarounds"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/sql-expressions/index.md",
