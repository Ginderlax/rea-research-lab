    },
    {
      "id": "grafana.candidate.dddad9aab8b2657559fd",
      "syntaxRole": "list-item",
      "sourceText": "- **Opt out of auto-updates:** Set `preinstall_auto_update` to `false` in your [configuration file](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-grafana/).",
      "headingPath": [
