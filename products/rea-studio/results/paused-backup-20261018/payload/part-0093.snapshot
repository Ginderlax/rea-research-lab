import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { readFileSync, writeFileSync, mkdirSync, copyFileSync } from 'node:fs';
import { join } from 'node:path';
const workspace = 'C:/Users/evanh/Documents/Codex/2026-10-12/go';
const lab = join(workspace, 'outputs/rea-research-lab');
const destination = 'products/rea-studio/results/native-backup-review';
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
mkdirSync(join(lab, destination), { recursive: true });
const receipt = JSON.parse(readFileSync(join(workspace, 'work/restic-independent-review-receipt.json'), 'utf8'));
const originals = [
  ['restic-independent-review-receipt.json', '40dc9577c67049347c5b12206c10617b7753a644388f7784025d332ffd5dd89b'],
  ['backup-native-validation.full34.pre-custom.json', 'e40a53ab75eefdf5a57a3cfea16c94114eb998c27131ba58e4b3fa00f86114b7'],
  ['backup-server.pre-custom-timestamp.mjs', 'b33c1842c4ebce2aecc8b4583cfb05c726cda1164a2866683b31fd537c269807'],
  ...Object.entries(receipt.artifacts).map(([name, row]) => [name, row.sha256])
];
const snapshots = originals.map(([name, expected]) => {
  const bytes = readFileSync(join(workspace, 'work', name));
  assert.equal(sha(bytes), expected, `Review artifact changed: ${name}`);
  const path = `${destination}/${name.replace(/\.(mjs|py)$/, '.$1.snapshot')}`;
  copyFileSync(join(workspace, 'work', name), join(lab, path));
  return { originalLocalPath: 'work/' + name, path, bytes: bytes.length, sha256: expected };
});
const reviewedSources = Object.entries(receipt.sourceFingerprints).map(([path, sha256]) => {
  const snapshot = path.endsWith('/server.mjs') ? snapshots.find(row => row.originalLocalPath === 'work/backup-server.pre-custom-timestamp.mjs') : null;
  assert.equal(sha(readFileSync(join(lab, snapshot?.path ?? path))), sha256);
  return { path, sha256, ...(snapshot ? { snapshot_path: snapshot.path } : {}) };
});
const record = {
  schema: 'rea-independent-review-preservation/v1', recordedAt: new Date().toISOString(), snapshots, reviewedSources,
  scope: 'Exact independent review artifacts and historical 34-test receipt. Historical server bytes are preserved; other historical full34 hashes remain attributed to that prior run, with current combined 252-test source identities recorded separately. This manifest does not claim that every historical documentation byte is available or rerun any experiment.',
  fullFeatureParityEstablished: false, universalSuperiorityEstablished: false
};
writeFileSync(join(lab, destination, 'preservation-manifest.json'), JSON.stringify(record, null, 2) + '\n');
writeFileSync(join(lab, destination, 'README.md'), `# Independent encrypted backup review\n\nThese exact synthetic review records preserve a confirmed timestamp defect, its correction, original-program controls and 176 ciphertext/MAC comparisons against a separate cryptographic implementation. The reviewed native code is unchanged in the current checkpoint. The historical server source is preserved because a later correction changed its separate custom-snapshot branch.\n\nThe [preservation manifest](preservation-manifest.json) binds every artifact. The [original review receipt](restic-independent-review-receipt.json) retains its original local artifact names; the manifest maps them to public snapshots. Script snapshots preserve the executed bytes and include machine-local paths; they are evidence rather than a portable installation command. The current whole-suite receipt is [development validation](../development-validation.json).\n\nThis is a targeted correctness review. Cryptographic security, constant-time behavior, full product compatibility and overall superiority remain unproven.\n`);
console.log(JSON.stringify({preservedArtifacts:snapshots.length,reviewedSources:reviewedSources.length}));
