    {
      "id": "grafana.candidate.9131ee2f7d6419c33a2d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If your Grafana instance runs on Grafana Cloud, a `localhost` or private network address refers to Grafana servers rather than your network, so it can't reach a self-hosted Loki. Use [Private data source connect (PDC)](https://grafana.com/docs/grafana-cloud/connect-externally-hosted/private-data-source-connect/) to query Loki on a private network.",
      "headingPath": [
        "Configure the Loki data source",
        "Configure the data source in the UI",
        "Connection"
      ],
      "source": {
        "path": "docs/sources/datasources/loki/configure/index.md",
