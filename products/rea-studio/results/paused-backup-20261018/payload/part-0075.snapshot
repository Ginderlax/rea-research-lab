    },
    {
      "id": "grafana.candidate.86ddf37b3badf2979ee5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Builder mode lets you construct a query from drop-downs and form fields without writing any syntax:",
