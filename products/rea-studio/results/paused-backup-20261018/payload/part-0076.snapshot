    {
      "id": "grafana.candidate.4aac238cd07c5061cad1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can define a stored procedure to return all the data needed to render multiple series (for example, 4) in a graph panel.",
      "headingPath": [
        "Microsoft SQL Server query editor",
        "Use stored procedures",
        "Stored procedure with epoch time format"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/query-editor/index.md",
