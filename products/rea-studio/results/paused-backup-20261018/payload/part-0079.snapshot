    {
      "id": "grafana.candidate.b942390d6b74e5fb9ab9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "More easily create silences directly from the Alert rule list view or detail page.",
      "headingPath": [
        "What’s new in Grafana v11.1",
        "Alerting",
        "Rule-specific silences with permissions"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-1.md",
