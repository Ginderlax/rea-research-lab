    {
      "id": "grafana.candidate.68474456863ccbd8e902",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If a rule does not explicitly specify a target data source for writing (for example, if it was created before Grafana 12.1), Grafana will fall back to the `default_datasource_uid` set in the configuration:",
      "headingPath": [
        "Create Grafana-managed recording rules",
        "Before you begin"
      ],
