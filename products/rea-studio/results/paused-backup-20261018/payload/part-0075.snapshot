        "lineStart": 32,
        "lineEnd": 32,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/monitor-status/alerts-page.md#L32-L32"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.33669470d71cfdf49b62",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "OSS users need to manually configure this. To configure alert state history for OSS, refer to the <a href=\"https://grafana.com/docs/grafana/latest/alerting/set-up/configure-alert-state-history/#configure-loki-and-prometheus-for-alert-state\">configure Loki and Prometheus for alert state</a> documentation.",
      "headingPath": [
        "Alert view",
        "How it works"
      ],
      "source": {
        "path": "docs/sources/alerting/monitor-status/alerts-page.md",
