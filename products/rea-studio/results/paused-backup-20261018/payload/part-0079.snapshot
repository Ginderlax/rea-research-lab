    },
    {
      "id": "grafana.candidate.eec46f93a16e17fd0e89",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We've updated the Metric Selector to be faster and added support for filtering by management zone. We've also added support for Log Queries and querying the Dynatrace audit log.",
      "headingPath": [
        "What's new in Grafana v9.4",
        "Enterprise Datasources",
        "Dynatrace Datasource"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-4.md",
