import fs from 'node:fs/promises';
import path from 'node:path';
import {spawnSync} from 'node:child_process';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
const here=path.dirname(fileURLToPath(import.meta.url)),source=path.join(here,'consolidate-measurements.mjs'),bytes=await fs.readFile(source),sha=value=>createHash('sha256').update(value).digest('hex'),stem='consolidation-attempt-'+Date.now(),startedAt=new Date().toISOString(),child=spawnSync(process.execPath,[source],{encoding:'utf8',timeout:120000,maxBuffer:4*1024*1024,windowsHide:true});await fs.mkdir(path.join(here,'preserved/consolidation-attempts'),{recursive:true});await fs.writeFile(path.join(here,'preserved/consolidation-attempts',stem+'.mjs'),bytes);await fs.writeFile(path.join(here,'results',stem+'.stdout.txt'),child.stdout??'');await fs.writeFile(path.join(here,'results',stem+'.stderr.txt'),child.stderr??'');const receipt={schemaVersion:1,startedAt,completedAt:new Date().toISOString(),sourceSHA256:sha(bytes),sourceSHA256After:sha(await fs.readFile(source)),executedSourceSnapshot:'preserved/consolidation-attempts/'+stem+'.mjs',exitCode:child.status,signal:child.signal,error:child.error?.message,stdout:{path:'results/'+stem+'.stdout.txt',sha256:sha(child.stdout??'')},stderr:{path:'results/'+stem+'.stderr.txt',sha256:sha(child.stderr??'')},scope:'Post-window consolidation only. No timing or memory workloads executed; frozen measurements/sources are not edited.'};await fs.writeFile(path.join(here,'results',stem+'.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify(receipt));if(child.status!==0)process.exitCode=1;
