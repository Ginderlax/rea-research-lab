    {
      "id": "grafana.candidate.5e9f1e6ff71fde342d86",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Trend visualizations support all visual styles and options available in the [time series visualization](ref:time-series-visualization) with these exceptions:",
      "headingPath": [
        "Trend"
      ],
