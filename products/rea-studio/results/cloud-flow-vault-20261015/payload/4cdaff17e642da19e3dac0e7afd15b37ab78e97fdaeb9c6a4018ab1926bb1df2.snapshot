import * as fs from 'node:fs/promises';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { execFile } from 'node:child_process';
import { promisify } from 'node:util';
import assert from 'node:assert/strict';
import { digest } from './oracle.mjs';
const execute = promisify(execFile), app = fileURLToPath(new URL('../',import.meta.url));
async function run(args,timeout = 30000) { return execute(process.execPath,args,{cwd:app,timeout,maxBuffer:4*1024*1024,windowsHide:true}); }
if (process.argv.includes('--refresh-evidence')) for (const script of ['verify-sources.mjs','verify-filters.mjs','verify-comparisons.mjs','verify-transfers.mjs','verify-bounds.mjs']) { await run(['scripts/'+script],300000); console.log(`Refreshed ${script}.`); }
const names = [];
async function walk(prefix = '') { for (const entry of await fs.readdir(path.join(app,prefix),{withFileTypes:true})) { const name = prefix+entry.name; if (entry.isDirectory()) { if (name !== 'results') await walk(name+'/'); } else names.push(name); } }
await walk(); names.sort(); const hashes = {};
for (const name of names) { hashes[name] = digest(await fs.readFile(path.join(app,name))); if (name.endsWith('.mjs')) await run(['--check',name]); }
const testFiles = names.filter(name => !name.includes('/') && name.endsWith('.test.mjs')), testRun = await run(['--test','--test-reporter=tap',...testFiles],60000);
const counts = Object.fromEntries(['tests','pass','fail','skipped','cancelled'].map(key => { const match = new RegExp(`^# ${key} (\\d+)$`,'m').exec(testRun.stdout); assert.ok(match,key+' count missing'); return [key,Number(match[1])]; }));
assert.equal(counts.tests,35); assert.equal(counts.pass,35); assert.equal(counts.fail+counts.skipped+counts.cancelled,0);
const evidence = {};
for (const name of ['filter-verification.json','comparison-verification.json','transfer-verification.json','source-verification.json','bounded-workloads.json']) { const bytes = await fs.readFile(path.join(app,'results',name)); evidence[name] = {sha256:digest(bytes),bytes:bytes.length,data:JSON.parse(bytes)}; }
const filter = evidence['filter-verification.json'].data, comparison = evidence['comparison-verification.json'].data, transfer = evidence['transfer-verification.json'].data, source = evidence['source-verification.json'].data, bounds = evidence['bounded-workloads.json'].data;
for (const item of [filter,comparison,transfer]) { assert.equal(item.failures.length,0); assert.equal(item.originalSHA256,'41eab3e118d264920b62c3327966c5ece0dc4dd715ee617d9e30450d8ead95a4'); assert.equal(item.sourceCommit,'be8d6044eacb843b74d335db0c5fbe09222031fe'); }
assert.equal(filter.moduleSHA256,hashes['native-filters.mjs']); assert.equal(comparison.moduleSHA256,hashes['native-comparison.mjs']); assert.equal(bounds.moduleSHA256,hashes['native.mjs']);
for (const [name,hash] of Object.entries(transfer.moduleHashes)) assert.equal(hash,hashes[name]);
assert.equal(source.manifestSHA256,hashes['native-source-references.json']); assert.equal(source.allPassed,true); assert.equal(bounds.allPassed,true);
assert.equal(filter.records.length,56); assert.equal(comparison.records.length,1400); assert.equal(transfer.records.length,21); assert.equal(source.records.length,15); assert.equal(source.contracts,31);
const inputs = {filters:filter.records.map(({options}) => options),paths:filter.records[0].expected,comparisons:comparison.records.map(({options,filename,input}) => ({options,filename,source:input.source,destination:input.destination})),transfers:transfer.records.map(({input}) => input)};
const outputs = {filters:filter.records.map(({expected,actual,originalError,nativeError}) => ({expected,actual,originalRejected:Boolean(originalError),nativeRejected:Boolean(nativeError)})),comparisons:comparison.records.map(({originalAction,after,input}) => ({originalAction,after,nativeDecision:input.decision})),transfers:transfer.records.map(({output,result}) => ({output,copied:result.copied,timestampsUpdated:result.timestampsUpdated,removed:result.removed,directoriesCreated:result.directoriesCreated,directoriesRemoved:result.directoriesRemoved}))};
const hostDependencies = {};
for (const name of ['../../server.mjs','../../catalog.mjs','../../lib/storage.mjs']) hostDependencies[name] = digest(await fs.readFile(path.join(app,name)));
const receipt = {format:'rea-rclone-native-verification-v1',checkedAt:new Date().toISOString(),platform:process.platform,node:process.version,sourceCommit:filter.sourceCommit,originalVersion:comparison.version,originalZIP_SHA256:comparison.zipSHA256,originalExecutable_SHA256:comparison.originalSHA256,sourceContracts:31,officialSourceFiles:15,priorProjectReconstructionReadOrImported:false,runtimeRunsOriginalOrVendorCode:false,allFixturesSynthetic:true,testRun:{...counts,files:testFiles,stdoutSHA256:digest(testRun.stdout),stderrSHA256:digest(testRun.stderr),exitCode:0},differential:{filterSettings:filter.records.length,filterPaths:filter.files,filterSuccessfulSelections:filter.records.filter(row => !row.originalError).length,filterOriginalNativeRejections:filter.records.filter(row => row.originalError).length,comparisonDecisions:comparison.records.length,comparisonProfiles:comparison.settings,folderDryRunApplyScenarios:transfer.records.length,originalCLIExecutions:filter.originalCLIExecutions+comparison.originalCLIExecutions+transfer.originalCLIExecutions,inputCorpusSHA256:digest(JSON.stringify(inputs)),outputCorpusSHA256:digest(JSON.stringify(outputs)),allPassed:true},boundedWorkloads:bounds.records,comparisonOfSpeedOrResourcesToOriginal:false,scopeLimits:{allOriginalFeaturesEnumerated:false,allGlobOrRE2BehaviorEstablished:false,timestampWritePrecision:'milliseconds, flooring sub-millisecond input',backendPrecision:'fixed 100 ns minimum, not original dynamic probe',atomicFolderTransaction:false,crossProcessFilesystemLock:false,uiBrowserVerification:'parent-owned; pending separately'},sourceFiles:hashes,hostDependenciesAtTest:hostDependencies,evidence:Object.fromEntries(Object.entries(evidence).map(([name,{sha256,bytes}]) => [name,{sha256,bytes}])),fullProductComplete:false,universalSuperiorityEstablished:false};
await fs.writeFile(path.join(app,'results/native-verification.json'),JSON.stringify(receipt,null,2)+'\n'); console.log(JSON.stringify({tests:counts.tests,originalCLIExecutions:receipt.differential.originalCLIExecutions,inputCorpusSHA256:receipt.differential.inputCorpusSHA256,outputCorpusSHA256:receipt.differential.outputCorpusSHA256,receiptSHA256:digest(await fs.readFile(path.join(app,'results/native-verification.json')))}));
