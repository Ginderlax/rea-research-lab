assert git(['rev-parse','c15dd78e05da771449550ac6e657fb77c08e787d^{tree}']).decode().strip()==attempt['gitTree']=='56789196df12698b532841f360e263c4f6098718'
tree={}
for row in git(['ls-tree','-rz',attempt['gitTree']]).split(b'\0'):
    if row:
        meta,name=row.split(b'\t',1);mode,kind,blob=meta.split()
        if kind==b'blob':tree[name.decode()]=blob.decode()
decoded_envelope={}
for r in envelope['rows']:
