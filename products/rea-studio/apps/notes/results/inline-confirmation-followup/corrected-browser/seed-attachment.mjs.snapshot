import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,host=JSON.parse(await fs.readFile(path.join(here,'host.json'))),fixture=JSON.parse(await fs.readFile(path.join(here,'fixture.json'))),data=await fs.readFile(path.join(here,fixture.attachment.path)),sha=b=>createHash('sha256').update(b).digest('hex');assert.equal(sha(data),fixture.attachment.sha256);const calls=[],startedAt=new Date().toISOString(),session=await fetch(host.actualHost+'/api/session');assert.equal(session.status,200);const{token}=await session.json();calls.push({method:'GET',url:'/api/session',status:session.status,sessionTokenPersisted:false});async function call(action,input){const response=await fetch(host.actualHost+'/api/notes/'+action,{method:'POST',headers:{'content-type':'application/json','x-rea-token':token},body:JSON.stringify(input)}),value=await response.json();assert(response.ok,JSON.stringify(value));calls.push({method:'POST',url:'/api/notes/'+action,status:response.status,input,response:value.result});return value.result;}const note=await call('get',{id:host.noteId}),added=await call('attachment-add',{id:note.id,revision:note.revision,filename:'owned-attachment.txt',mime:'text/plain',base64:data.toString('base64')});assert.equal(added.attachment.sha256,fixture.attachment.sha256);assert.equal(added.attachment.bytes,data.length);await fs.writeFile(path.join(here,'attachment-fixture-seed.json'),JSON.stringify({startedAt,completedAt:new Date().toISOString(),scope:'Private synthetic setup API, not a browser upload acceptance',calls,attachment:added.attachment,noteRevision:added.note.revision,programmaticCalls:3,tokenPersisted:false},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({seeded:true,programmaticFixtureCalls:3,attachmentBytes:data.length,revision:added.note.revision}));
