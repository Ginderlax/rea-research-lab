    {
      "id": "grafana.candidate.1fb6d9570694cbe230c7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Configure Grafana with a Jaeger client for distributed tracing.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[tracing.opentelemetry.jaeger]`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
