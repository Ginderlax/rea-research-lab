    },
    {
      "id": "grafana.candidate.242a2007026eeb3bbf9e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can also save the report as a draft at any point during the initial creation process.",
      "headingPath": [
