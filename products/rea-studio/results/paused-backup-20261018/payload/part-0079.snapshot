    },
    {
      "id": "grafana.candidate.147aedd79a04ecdff664",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We've improved the design and functionality of email templates to make template creation much easier and more customizable. The email template framework utilizes MJML to define and compile the final email HTML output. Sprig functions in the email templates provide more customizable template functions.",
      "headingPath": [
        "What's new in Grafana v9.4",
        "Alerting",
        "Alert email templating"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-4.md",
