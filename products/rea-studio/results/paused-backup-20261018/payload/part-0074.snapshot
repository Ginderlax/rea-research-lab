    },
    {
      "id": "grafana.candidate.d18d2f364bbee9da73d3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Each notification policy contains a routing tree with its own name, root policy, and child policies which function similar to the default policy. You can create additional routing trees to organize routing logic by team, service, or domain.",
      "headingPath": [
        "Configure notification policies",
        "Manage multiple notification policies"
      ],
      "source": {
