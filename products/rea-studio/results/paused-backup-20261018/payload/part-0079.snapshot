    {
      "id": "grafana.candidate.36eca10880a508b7982a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Concepts like data sources and dashboard panels are hard to grasp and it can be a struggle to go from Grafana’s “empty state” to a working dashboard that displays data. Our latest advancements streamline the process of selecting the ideal data source in Grafana, prioritizing recent usage, and providing labels and supplementary descriptions.",
      "headingPath": [
        "What’s new in Grafana v10.0",
        "Dashboards and visualizations",
        "Select data sources more easily"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-0.md",
        "gitBlobSha": "744b2d1230211f70aa6158231d9505e732ac0315",
        "sha256": "dd311853975cca7ef6ad474588f832614dd9c445856343920d238a1ddf183739",
        "lineStart": 149,
        "lineEnd": 149,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-0.md#L149-L149"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.e1523429e7c51333886d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "With this flow, selecting a data source has been greatly simplified, providing a clear overview of available data sources and allowing you to quickly connect to a new one when needed.",
      "headingPath": [
        "What’s new in Grafana v10.0",
        "Dashboards and visualizations",
        "Select data sources more easily"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-0.md",
        "gitBlobSha": "744b2d1230211f70aa6158231d9505e732ac0315",
        "sha256": "dd311853975cca7ef6ad474588f832614dd9c445856343920d238a1ddf183739",
        "lineStart": 151,
        "lineEnd": 151,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-0.md#L151-L151"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
