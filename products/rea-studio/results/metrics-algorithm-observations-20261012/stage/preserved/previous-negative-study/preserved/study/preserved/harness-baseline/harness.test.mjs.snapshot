import test from 'node:test';
import assert from 'node:assert/strict';
import {spawnSync} from 'node:child_process';
import path from 'node:path';
import fs from 'node:fs/promises';
import {canonical} from './canonical.mjs';
import {here} from './authenticate-original.mjs';
test('expected-output transport distinguishes IEEE values, undefined keys and array holes',()=>{assert.notEqual(canonical(-0),canonical(0));assert.notEqual(canonical(NaN),canonical(null));assert.notEqual(canonical(Infinity),canonical(-Infinity));assert.notEqual(canonical({value:undefined}),canonical({}));assert.notEqual(canonical(Array(2)),canonical([undefined,undefined]));assert.equal(canonical(NaN),canonical(Number.NaN));});
test('expected-output transport distinguishes cache identity and nested shallow-copy aliases',()=>{const array=[3.5],result={allValues:array};assert.notEqual(canonical({result,cache:result}),canonical({result,cache:{allValues:array}}));assert.notEqual(canonical({result,cache:{allValues:array}}),canonical({result,cache:{allValues:[3.5]}}));});
test('direct measurement and controllers reject stale, non-ISO and future quiet authorization before any workload',()=>{for(const variant of ['standard','percentile'])for(const timestamp of ['1999-01-01T00:00:00Z','September 1, 2001','2099-01-01T00:00:00Z'])for(const args of [[path.join(here,'memory-worker.mjs'),'measure','original','smallStandard',timestamp,variant],[path.join(here,'memory-runner.mjs'),'--quiet-confirmed',timestamp,variant],[path.join(here,'timing-runner.mjs'),'--quiet-confirmed',timestamp,variant]]){const child=spawnSync(process.execPath,args,{encoding:'utf8',timeout:10000,windowsHide:true});assert.notEqual(child.status,0);assert.equal(child.stdout,'');assert.match(child.stderr,/quiet timestamp|quiet.*preflight/);}});
test('unknown candidate manifests reject before loading or starting a worker',()=>{for(const args of [[path.join(here,'memory-worker.mjs'),'check-only','original','all-five','unused','../other'],[path.join(here,'memory-runner.mjs'),'--check-only','unused','../other'],[path.join(here,'timing-runner.mjs'),'--check-only','unused','../other']]){const child=spawnSync(process.execPath,args,{encoding:'utf8',timeout:10000,windowsHide:true});assert.notEqual(child.status,0);assert.equal(child.stdout,'');assert.match(child.stderr,/Unexpected candidate manifest/);}});
test('owned-PID observer source parses without running a measured process',async()=>{const filename=path.join(here,'watch-owned-process.ps1');assert.ok((await fs.readFile(filename,'utf8')).includes('$OwnedProcessId'));const child=spawnSync('powershell.exe',['-NoProfile','-NonInteractive','-File',path.join(here,'parse-observer.ps1'),'-SourceFile',filename],{encoding:'utf8',timeout:10000,windowsHide:true});assert.equal(child.status,0,child.stderr);});
