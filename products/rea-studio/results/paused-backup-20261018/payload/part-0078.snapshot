    {
      "id": "grafana.candidate.74568a258a787491c9e2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The plus operator enables you to step forward in time, relative to now. For example, you can use this feature to look at predicted data in the future.",
      "headingPath": [
        "Use dashboards",
        "Set dashboard time range",
        "Time units and relative ranges"
