    {
      "id": "grafana.candidate.1be091a0a539d25943cf",
      "syntaxRole": "list-item",
      "sourceText": "- Added an alert at the top of a plugin's page in the plugins catalog when browsing Angular plugins.",
      "headingPath": [
        "What’s new in Grafana v10.1",
        "Plugins",
        "Angular deprecation changes",
        "UI changes"
      ],
      "source": {
