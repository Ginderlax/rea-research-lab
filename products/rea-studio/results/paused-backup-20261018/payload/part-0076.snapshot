    {
      "id": "grafana.candidate.5394f662e76d5292b833",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can change or customize the name of a Table panel column by using the SQL keyword `AS` syntax.",
      "headingPath": [
        "PostgreSQL query editor",
        "Table queries"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/query-editor/_index.md",
        "gitBlobSha": "da418c753c9813f78e1d4eed64e0946e46a50b3e",
