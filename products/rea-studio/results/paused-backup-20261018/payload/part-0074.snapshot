    {
      "id": "grafana.candidate.43304301b2afd352feeb",
      "syntaxRole": "list-item",
      "sourceText": "- You cannot use a service account to modify basic roles via the RBAC API. To update basic roles, you must be a Grafana administrator and use basic authentication with the request.",
      "headingPath": [
        "Role-based access control (RBAC) overview",
        "Available RBAC roles",
