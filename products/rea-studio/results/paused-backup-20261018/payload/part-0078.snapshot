    {
      "id": "grafana.candidate.0ec4e20a2fe4aeb2e8e2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When the CPU usage exceeds the defined threshold, an annotation should appear on the graph to mark the event. Similarly, when the alert is resolved, another annotation is added to indicate the moment it returned to normal.",
      "headingPath": [
        "Before you begin",
        "Create an alert rule for CPU usage",
        "Configure notification message"
      ],
      "source": {
        "path": "docs/sources/tutorials/alerting-get-started-pt6/index.md",
