    {
      "id": "grafana.candidate.ed6118b8d5551d5f1fc7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you wanted to track the progress of something during business hours, you could set a time range that covers the current day, but starting at 8am, like so:",
      "headingPath": [
        "Use dashboards",
        "Set dashboard time range",
        "Common time range controls",
        "Semi-relative time range"
      ],
      "source": {
