    {
      "id": "grafana.candidate.2aab8c2a5b2814bbd68a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A longstanding feature request for the table visualization is to allow wrapping of text within cells. In Grafana 11.1 we've added this capability! By default, the column with the longest text is selected for wrapping. You can also configure wrapping manually using field overrides.",
      "headingPath": [
        "What’s new in Grafana v11.1",
        "Dashboards and visualizations",
        "Visualization ease of use improvements",
        "Table cell text wrapping"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-1.md",
