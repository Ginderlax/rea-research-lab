    {
      "id": "grafana.candidate.67b93348d50447058c0f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you still connect the Grafana Elasticsearch data source to a domain that requires AWS Signature Version 4 (AWS SigV4), for example a legacy Amazon Elasticsearch Service domain or another SigV4-protected OpenSearch-compatible endpoint, you must sign all requests with SigV4.",
      "headingPath": [
        "Configure the Elasticsearch data source",
        "Authentication",
        "Amazon OpenSearch Service and SigV4"
      ],
      "source": {
        "path": "docs/sources/datasources/elasticsearch/configure/index.md",
        "gitBlobSha": "f4a2782f95e557a2cf97b146fb788a967b4f765e",
