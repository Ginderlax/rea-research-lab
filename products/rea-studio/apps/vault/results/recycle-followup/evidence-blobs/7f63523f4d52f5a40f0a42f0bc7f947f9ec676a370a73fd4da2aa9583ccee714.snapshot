import {randomUUID} from 'node:crypto';
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
const app=new URL('../products/rea-studio/apps/vault/',import.meta.url);
export const {render}=await import(new URL('client.mjs',app));
const {handle,dispose}=await import(new URL('server.mjs',app));
export class Element{constructor(tag){this.tagName=tag;this.children=[];this.listeners=new Map();this.value='';this.checked=false;this.ownText='';this.parentElement=null;this.disabled=false;}set textContent(value){this.ownText=String(value);for(const child of this.children)child.parentElement=null;this.children=[];}get textContent(){return this.ownText+this.children.map(child=>child.textContent).join('');}append(...items){for(const child of items){if(child.parentElement)child.parentElement.children=child.parentElement.children.filter(value=>value!==child);child.parentElement=this;this.children.push(child);}}replaceChildren(...items){for(const child of this.children)child.parentElement=null;this.children=[];this.ownText='';this.append(...items);}addEventListener(name,callback){this.listeners.set(name,callback);}async click(){if(!this.disabled)return this.listeners.get('click')?.();}}
export const descendants=root=>[root,...root.children.flatMap(descendants)];
export function button(root,label){const result=descendants(root).find(n=>n.tagName==='button'&&n.textContent===label);assert.ok(result,'Expected button '+label);return result;}
export function field(root,label){const result=descendants(root).find(n=>n.tagName==='label'&&n.ownText===label);assert.ok(result,'Expected field '+label);return result.children[0];}
export function openEntry(root,title){const row=descendants(root).find(n=>n.tagName==='section'&&n.children.some(c=>c.tagName==='strong'&&c.textContent===title));assert.ok(row,'Expected active row '+title);return button(row,'Open entry').click();}
export function deferred(){let resolve;const promise=new Promise(r=>resolve=r);return{resolve,promise};}
export async function fixture(t,name,wrap){const workspace={root:'independent-recycle-'+randomUUID()},store={value:null,get:async()=>structuredClone(store.value),set:async(k,v)=>{store.value=structuredClone(v);}},call=(action,input={})=>handle({action,input,workspace,store}),requests=[],observe={name};await call('create',{password:'owned synthetic recycle master'});const A=(await call('save',{title:'A',group:'Previous',password:'A-owned-secret',notes:'A notes'})).id,B=(await call('save',{title:'B',group:'Other',password:'B-owned-secret',notes:'B notes'})).id;const previous=globalThis.document;globalThis.document={createElement:tag=>new Element(tag)};const root=new Element('main'),cleanup=await render(root,async(action,input)=>{requests.push({action,input:structuredClone(input)});return wrap?wrap(action,input,()=>call(action,input)):call(action,input);});t.after(async()=>{cleanup();dispose(workspace);globalThis.document=previous;await fs.mkdir(new URL('observations/',import.meta.url),{recursive:true});await fs.writeFile(new URL('observations/'+name+'.json',import.meta.url),JSON.stringify({observe,requests,scope:'Actual frozen client/server with owned DOM model and deterministic held transport; no actual HTTP/GUI loss claim.'},null,2)+'\n');});return{root,A,B,call,cleanup,requests,observe,store};}
export async function trashA(root){await openEntry(root,'A');field(root,'Confirm entry deletion').checked=true;await button(root,'Delete entry').click();await button(root,'Show recycle bin').click();}
