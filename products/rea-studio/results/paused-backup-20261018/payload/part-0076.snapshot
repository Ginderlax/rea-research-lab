    },
    {
      "id": "grafana.candidate.c884f8fc6e9c28911f2f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can also override this setting in a dashboard panel under its data source options.",
      "headingPath": [
        "Configure the Microsoft SQL Server data source",
        "Configure the data source in the UI",
        "Min time interval"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/configure/index.md",
        "gitBlobSha": "468ac6d022bd91271e046308509eabab23316d3c",
