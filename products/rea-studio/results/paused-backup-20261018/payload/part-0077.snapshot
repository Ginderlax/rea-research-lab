    {
      "id": "grafana.candidate.f5eb596eaa89def376fa",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set the policy template that's used to add the `Content-Security-Policy-Report-Only` header to your requests. `$NONCE` in the template includes a random nonce.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
