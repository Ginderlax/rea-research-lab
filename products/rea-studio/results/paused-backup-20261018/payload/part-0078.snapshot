    {
      "id": "grafana.candidate.642f648cabc752e6e480",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use the highlight to focus on spans that drive end‑to‑end latency. Spans outside the critical path do not increase the trace duration.",
      "headingPath": [
        "Traces in Explore",
        "Trace view",
        "Timeline"
      ],
      "source": {
        "path": "docs/sources/visualizations/explore/trace-integration.md",
