    {
      "id": "grafana.candidate.a7492b5cc6818d712f28",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can select from a list of metric and resource labels for a metric in the Group By drop-down. You can then include them in the legend key using alias patterns.",
      "headingPath": [
        "Google Cloud Monitoring query editor",
        "Query metrics",
        "Set alias patterns",
        "Alias pattern examples"
      ],
      "source": {
        "path": "docs/sources/datasources/google-cloud-monitoring/query-editor/index.md",
        "gitBlobSha": "35f2bbc8926a6d131f4d3cbcb6a6184dabccd704",
        "sha256": "5bd24c0a5753f11d9c5d6296eadff38bbc9734793a5e4cc55da2cb6fe1d87ef1",
        "lineStart": 177,
        "lineEnd": 178,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/google-cloud-monitoring/query-editor/index.md#L177-L178"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
