    {
      "id": "grafana.candidate.690e0fb66d7652c340bc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When enabled, Grafana automatically forwards the workload-identity environment variables injected by the AKS `azure-workload-identity` webhook (`AZURE_TENANT_ID`, `AZURE_CLIENT_ID`, `AZURE_FEDERATED_TOKEN_FILE`, `AZURE_AUTHORITY_HOST`) to the Grafana-owned Azure plugins listed in [`forward_settings_to_plugins`](#forward_settings_to_plugins). This is required for the Azure SDK inside the plugin process to perform federated token exchange.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[azure]`",
        "`workload_identity_enabled`"
      ],
