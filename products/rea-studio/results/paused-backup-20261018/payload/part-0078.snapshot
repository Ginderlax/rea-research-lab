    {
      "id": "grafana.candidate.ded2b6ed2d56e10de3ce",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Being able to combine data from multiple data sources in one graph allows you to correlate information from both Prometheus and Loki.",
