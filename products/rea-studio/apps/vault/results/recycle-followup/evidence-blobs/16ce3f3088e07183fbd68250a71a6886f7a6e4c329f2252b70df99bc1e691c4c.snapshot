import fs from'node:fs/promises';import path from'node:path';import{createHash}from'node:crypto';import{spawn}from'node:child_process';import assert from'node:assert/strict';
const root=import.meta.dirname,sha=b=>createHash('sha256').update(b).digest('hex'),app='products/rea-studio/apps/vault/',names=['client.mjs','server.mjs','history.mjs','kdbx.mjs','xml.mjs','recycle.mjs','recycle-harness.mjs','recycle-oracle.ps1','recycle-original.test.mjs'],source=[...names.map(n=>app+n),'record-original.mjs'];
const run=path.join(root,'runs','original-'+new Date().toISOString().replaceAll(':','-'));await fs.mkdir(run,{recursive:true});const bind=async n=>{const b=await fs.readFile(path.join(root,n));return{path:n,bytes:b.length,sha256:sha(b)}};const before=await Promise.all(source.map(bind));for(const e of before){const dest=path.join(run,'sources',e.path+'.snapshot');await fs.mkdir(path.dirname(dest),{recursive:true});await fs.writeFile(dest,await fs.readFile(path.join(root,e.path)));}await fs.writeFile(path.join(run,'source-before.json'),JSON.stringify(before,null,2)+'\n');
const env={...process.env};delete env.NODE_TEST_CONTEXT;const p=spawn(process.execPath,['--test','--test-reporter=tap',app+'recycle-original.test.mjs'],{cwd:root,env,windowsHide:true,stdio:['ignore','pipe','pipe']}),stdout=[],stderr=[];let bytes=0,problem;const timer=setTimeout(()=>{problem='Original corpus180-second deadline';p.kill()},180000);for(const[name,stream]of[['stdout',p.stdout],['stderr',p.stderr]])stream.on('data',b=>{bytes+=b.length;if(bytes>8*1024*1024){problem='Recorder combined capture exceeds8MiB';p.kill()}else(name==='stdout'?stdout:stderr).push(b)});p.once('error',e=>problem=e.message);const code=await new Promise(r=>p.once('close',r));clearTimeout(timer);const out=Buffer.concat(stdout);await fs.writeFile(path.join(run,'stdout.txt'),out);await fs.writeFile(path.join(run,'stderr.txt'),Buffer.concat(stderr));const after=await Promise.all(source.map(bind));const txt=out.toString(),number=n=>Number(new RegExp('^# '+n+' (\\d+)$','m').exec(txt)?.[1]??NaN);let details;try{const b=await fs.readFile(path.join(root,'.local/original-comparisons.json'));assert(b.length<=8*1024*1024);details=JSON.parse(b);await fs.writeFile(path.join(run,'original-observations.json'),b);}catch(e){problem??='Missing original detailed observations: '+e.message;}const receipt={schema:'rea-keepass-recycle-original-corpus/v1',completed:new Date().toISOString(),code,problem:problem??null,sourceBefore:before,sourceAfter:after,sourceStable:JSON.stringify(before)===JSON.stringify(after),tests:number('tests'),pass:number('pass'),fail:number('fail'),skipped:number('skipped'),cancelled:number('cancelled'),assemblyLoads:details?.assemblyLoads??0,originalGUI:0,scope:details?.scope,originalCalls:details?.actualOriginalCalls??[]};await fs.writeFile(path.join(run,'validation.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({run,...receipt,sourceBefore:undefined,sourceAfter:undefined,originalCalls:undefined}));assert(receipt.sourceStable);assert.equal(code,0);assert(!problem);assert.equal(receipt.tests,4);assert.equal(receipt.pass,4);
