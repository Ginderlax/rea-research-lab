      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.f3823e6d271876c83c02",
      "syntaxRole": "table-row",
      "sourceText": "| Name                    | Upload from disk                                           | Reference from cloud storage                             |",
