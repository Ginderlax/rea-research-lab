    {
      "id": "grafana.candidate.1cefb480542d4812b3b5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Cause:** In older Grafana versions, the SQL comment-stripping parser didn't correctly handle `--` inside single-quoted strings. A query like `WHERE name = 'value--suffix'` would be truncated at the `--`, causing the rest of the query to be silently dropped. This also affected strings with consecutive hyphens (for example, `'10YDE-VE-------2'` would be truncated to `'10YDE-VE`).",
      "headingPath": [
        "Troubleshoot PostgreSQL data source issues",
        "Query errors",
        "Query truncated by double-dash in string literals"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/troubleshooting/index.md",
        "gitBlobSha": "9e7c47bbc73ee4cbaf10551ba67b0d3574dd4690",
        "sha256": "50dbbd3a22180c1579b10bdecbe6b70c677128202f8e45231104a07fac3a52e0",
        "lineStart": 233,
        "lineEnd": 233,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/troubleshooting/index.md#L233-L233"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c720649ac1fac19559f2",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Upgrade to a Grafana release that includes the fix (13.1+, 13.0.2+, or one of the 12.x patch releases listed above).",
