 const secretLike=[];for(const match of text.matchAll(/"(password|localPassword|masterPassword|fixtureMaster|secret|token|authorization)"\s*:\s*"((?:[^"\\]|\\.)*)"/gi)){let value;try{value=JSON.parse('"'+match[2]+'"');}catch{continue;}secretLike.push({key:match[1],valueSha256:hash(value),characters:value.length,syntheticLabel:/owned|synthetic|stage|test|only-|master|correct horse/i.test(value)});}const localPathMentions=(text.match(/(?:C:[\\/]+Users[\\/]+evanh|C:\\\\Users\\\\evanh)/gi)??[]).length,emails=[...new Set(text.match(/[a-zA-Z0-9_.+-]+@[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}/g)??[])];for(const email of emails)emailPatterns.set(email,(emailPatterns.get(email)||0)+1);
