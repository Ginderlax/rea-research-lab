    {
      "id": "grafana.candidate.b84b1a3a346f743de92d",
      "syntaxRole": "list-item",
      "sourceText": "- You can drag transformations to reorder them. Remember that transformations are processed in the order they are listed in the UI, so think before you move something!",
      "headingPath": [
        "What's new in Grafana v7.2",
        "New transformations and enhancements"
      ],
