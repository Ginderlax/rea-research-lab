    {
      "id": "grafana.candidate.3819d37367ad980bbb7c",
      "syntaxRole": "list-item",
      "sourceText": "- The Google OAuth client requests the `https://www.googleapis.com/auth/monitoring.read` scope on top of the default `openid email profile` scopes. Without this scope, the user's token is rejected by the Cloud Monitoring API with a `403` response.",
      "headingPath": [
        "Google authentication",
        "Use Forward OAuth Identity",
        "Prerequisites for Forward OAuth Identity"
      ],
      "source": {
        "path": "docs/sources/datasources/google-cloud-monitoring/google-authentication/index.md",
