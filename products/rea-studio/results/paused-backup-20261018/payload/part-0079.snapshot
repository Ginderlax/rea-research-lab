    },
    {
      "id": "grafana.candidate.c8a907433d31dc01e79b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In this example, that means only the last row of data, row C, is displayed in the gauges and the minimum and maximum values are 1 and 15. The value 1 is displayed because it's in the last row, while 15 is not.",
      "headingPath": [
        "Gauge",
        "Supported data formats",
        "Example - Multiple rows and values"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/gauge/index.md",
