    {
      "id": "grafana.candidate.b40cdbad5eb5255e1fc3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can use managed identity to configure SQL Server in Grafana if you host Grafana in Azure (such as an App Service or with Azure Virtual Machines) and have managed identity enabled on your VM. This lets you securely authenticate data sources without manually configuring credentials. For details on Azure managed identities, refer to the [Azure documentation](https://docs.microsoft.com/en-us/azure/active-directory/managed-identities-azure-resources/overview).",
      "headingPath": [
        "Configure the Microsoft SQL Server data source",
        "Configure the data source in the UI",
        "Azure Entra ID (formerly Azure AD) Authentication",
        "Managed Identity"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/configure/index.md",
        "gitBlobSha": "468ac6d022bd91271e046308509eabab23316d3c",
        "sha256": "78f3473345c7acf1680b5e482fdc29c61c6d73576e857090bae5239629ed0887",
        "lineStart": 352,
        "lineEnd": 354,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/mssql/configure/index.md#L352-L354"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
