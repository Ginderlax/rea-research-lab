    {
      "id": "grafana.candidate.9616b92c4cd8dbc1de9a",
      "syntaxRole": "list-item",
      "sourceText": "- **Improved navigation**: You can highlight a symbol or enable sandwich view for a symbol from the table. Also, a new status bar on top of the flame graph displays which views are enabled.",
      "headingPath": [
        "What’s new in Grafana v10.1",
        "Dashboards and visualizations",
        "Flame graph improvements"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-1.md",
