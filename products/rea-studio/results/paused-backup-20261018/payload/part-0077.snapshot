    {
      "id": "grafana.candidate.9e71b63293b3b1a3a482",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Comma-separated list of targets that a repository can control. `folder` by default. Use `folder` if you want the repository to only control a folder within the Grafana instance. Use `instance` if you want the repository to control the whole Grafana instance.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
