import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),source=path.resolve(here,'../metrics-algorithm-measurement-next'),previous=path.resolve(here,'../metrics-selector-measurement-review-next'),algorithm=path.resolve(here,'../metrics-selector-algorithm-next'),sha=bytes=>createHash('sha256').update(bytes).digest('hex'),fp=async file=>{const bytes=await fs.readFile(file);return {bytes:bytes.length,sha256:sha(bytes)};};
const safe=(base,name)=>{assert.equal(typeof name,'string');const file=path.resolve(base,name),relative=path.relative(base,file);assert.ok(relative&&!path.isAbsolute(relative)&&relative!=='..'&&!relative.startsWith('..'+path.sep));return file;};
async function inventory(base,dir=base){const result={};for(const row of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const file=path.join(dir,row.name),relative=path.relative(base,file).replaceAll('\\','/');assert.ok(!row.isSymbolicLink());if(row.isDirectory())Object.assign(result,await inventory(base,file));else {assert.ok(row.isFile());result[relative]=await fp(file);}}return result;}
async function copy(base,name,prefix,record){const destination=safe(here,prefix+'/'+name);await fs.mkdir(path.dirname(destination),{recursive:true});const data=await fs.readFile(safe(base,name));assert.deepEqual({bytes:data.length,sha256:sha(data)},record);await fs.writeFile(destination,data,{flag:'wx'});assert.deepEqual(await fp(destination),record);return {path:prefix+'/'+name,sourcePath:name,...record};}
const summary=JSON.parse(await fs.readFile(path.join(here,'recomputed-summary.json'))),readiness=JSON.parse(await fs.readFile(path.join(source,'readiness-validation.json'))),before=await inventory(source);assert.equal(Object.keys(before).length,1006);
for(const [name,record]of Object.entries(readiness.inventory))assert.deepEqual(before[name],record);for(const [name,record]of Object.entries(summary.rawBindings))assert.deepEqual(before[name],record);
assert.deepEqual(new Set(Object.keys(before)),new Set([...Object.keys(readiness.inventory),'readiness-validation.json','freeze-manifest.json',...Object.keys(summary.rawBindings)]));
const copies=[];for(const [name,record]of Object.entries(before))copies.push(await copy(source,name,'preserved/study',record));assert.deepEqual(await inventory(source),before);
const previousManifest=JSON.parse(await fs.readFile(path.join(previous,'freeze-manifest.json')));assert.equal((await fp(path.join(previous,'freeze-manifest.json'))).sha256,'3d23bbf39d41151f0edf341717d7f4fdf29f3acbd0b72d5f39d898a969a34349');assert.equal(previousManifest.entries.length,1042);assert.equal(previousManifest.receiptSHA256,'2226c0d8257df6db57616e6ace33cf91a9617154800553f01a0375c118260208');
const priorBefore=await inventory(previous),previousCopies=[];assert.equal(Object.keys(priorBefore).length,1043);for(const row of previousManifest.entries)assert.deepEqual(priorBefore[row.path],{bytes:row.bytes,sha256:row.sha256});
for(const [name,record]of Object.entries(priorBefore))previousCopies.push(await copy(previous,name,'preserved/previous-negative-study',record));assert.deepEqual(await inventory(previous),priorBefore);
const algorithmManifest=JSON.parse(await fs.readFile(path.join(algorithm,'freeze-manifest.json')));assert.equal((await fp(path.join(algorithm,'freeze-manifest.json'))).sha256,'4ba611ee5cf9d9c1e8e6a8b210dae381f17e1e7f75820700c519067201c221dd');assert.equal(Object.keys(algorithmManifest.inventory).length,88);
for(const [name,record]of Object.entries(algorithmManifest.inventory))assert.deepEqual(await fp(safe(algorithm,name)),record);
const priorFailureCopies=[];for(const id of ['1791845208669','1791845248697'])for(const name of ['results/freeze-attempt-'+id+'.json','results/freeze-attempt-'+id+'.stdout.txt','results/freeze-attempt-'+id+'.stderr.txt','preserved/freeze-attempt-'+id+'.source.mjs']){assert.ok(algorithmManifest.inventory[name]);priorFailureCopies.push(await copy(algorithm,name,'preserved/algorithm-preparation-failures',algorithmManifest.inventory[name]));}
for(const [name,record]of Object.entries(algorithmManifest.inventory))assert.deepEqual(await fp(safe(algorithm,name)),record);
const proofRoot=path.resolve(here,'../metrics-algorithm-readiness-independent-review'),proofReceipt=await fp(path.join(proofRoot,'review-validation.json'));assert.equal(proofReceipt.sha256,'842ce4b92c211844c5ddc090a6ea7d173665a0eda628db6e019fe7ca6ca50e86');
const proofs=[];for(const name of ['review-validation.json','authenticate.mjs'])proofs.push(await copy(proofRoot,name,'preserved/independent-readiness-review',await fp(path.join(proofRoot,name))));
assert.equal((await fp(path.join(here,'preserved/study/preserved/root-independent-review.json'))).sha256,'902f7d0e96a3642ed51419824dd23c1cb75420d65c79a353e58fd03c4398e6cb');
assert.deepEqual(await fp(path.join(proofRoot,'review-validation.json')),proofReceipt);
const output={schema:'rea-metrics-algorithm-measured-study-preservation/v1',preparedAt:new Date().toISOString(),sourceStage:'../metrics-algorithm-measurement-next',sourceInventory:before,sourceFiles:1006,sourceBeforeAfterStable:true,preservedFiles:copies.length,preservedBytes:copies.reduce((sum,row)=>sum+row.bytes,0),copies,previousNegativeStudy:{source:'../metrics-selector-measurement-review-next',inventoryFiles:1042,totalIncludingSelfExcludedManifest:1043,manifestSHA256:'3d23bbf39d41151f0edf341717d7f4fdf29f3acbd0b72d5f39d898a969a34349',receiptSHA256:previousManifest.receiptSHA256,sourceBeforeAfterStable:true,copies:previousCopies},algorithmPreparationFailures:{authenticatedCandidateInventoryFiles:88,sourceBeforeAfterStable:true,copies:priorFailureCopies,scope:'Two metadata-row format failures, not reducer compatibility failures; original tool errors followed by captured unchanged-source replays.'},independentReadinessProof:{receiptSHA256:proofReceipt.sha256,copies:proofs,noSeparateRawStdoutFileAvailable:true},rootAlgorithmProof:{receiptSHA256:'902f7d0e96a3642ed51419824dd23c1cb75420d65c79a353e58fd03c4398e6cb',path:'preserved/study/preserved/root-independent-review.json',stdoutPath:'preserved/study/preserved/root-independent-review.stdout.txt'},publicationExcludedArchives:readiness.publicationExcludedLocalOriginalArchives,inventoryExclusions:['original external binary archives and Node executable are authenticated but never copied into this stage'],sourceOnlyPreservationOfRejectedStudy:true,productionCandidateProposalPrepared:false,originalLibrarySourcesAreEvidenceOnly:true,sourceOrMeasurementsChanged:false};
await fs.writeFile(path.join(here,'study-preservation.json'),JSON.stringify(output,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({files:1006,preservedFiles:copies.length,preservedBytes:output.preservedBytes,previousNegativeFiles:1043,algorithmFailureFiles:priorFailureCopies.length,proofFiles:proofs.length,sourceStable:true}));
