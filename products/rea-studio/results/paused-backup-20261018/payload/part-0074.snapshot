    {
      "id": "grafana.candidate.9e6345ab10e701b93759",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This documentation provides an overview of the functions and operators of the Go template language that are available for both notification and alert rule templates.",
      "headingPath": [
        "Alerting template language"
      ],
      "source": {
        "path": "docs/sources/alerting/alerting-rules/templates/language.md",
        "gitBlobSha": "702c5f51bce24380913629947d22740ad30a4f84",
        "sha256": "8c9b985ed7518f7d72061c102a01c5ca9cc3017ac1f8fd970fbde652f259e524",
        "lineStart": 50,
        "lineEnd": 50,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/alerting-rules/templates/language.md#L50-L50"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
