        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/loki/query-editor/index.md#L223-L223"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
