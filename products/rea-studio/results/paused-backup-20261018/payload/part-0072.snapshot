import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';
import {createRequire} from 'node:module';
const require=createRequire(path.resolve('outputs/rea-backup-2026-10-12/runtime/package.json'));
const {parse}=require('@babel/parser');
const root=path.resolve('outputs/rea-research-lab/projects/04-excalidraw');
const prod=path.join(root,'artifacts/package/dist/prod');
const sha=s=>crypto.createHash('sha256').update(s).digest('hex');
function find(file,name){
 const txt=fs.readFileSync(file,'utf8'),ast=parse(txt,{sourceType:'module'});
 const ex=ast.program.body.filter(n=>n.type==='ExportNamedDeclaration').flatMap(n=>n.specifiers??[]).find(n=>n.exported.name===name);
 const local=ex?.local.name??name;
 for(const n of ast.program.body){
  if(n.type==='ImportDeclaration'){
   const i=n.specifiers.find(i=>i.local.name===local);
   if(i)return find(path.resolve(path.dirname(file),n.source.value),i.imported.name);
  }
  if(n.type==='VariableDeclaration')for(const d of n.declarations)if(d.id.name===local){return {file,local,text:txt.slice(d.start,d.end),start:d.start,end:d.end,byteStart:Buffer.byteLength(txt.slice(0,d.start)),byteEnd:Buffer.byteLength(txt.slice(0,d.end)),fileSha256:sha(fs.readFileSync(file)),sliceSha256:sha(txt.slice(d.start,d.end))};}
  if(n.type==='FunctionDeclaration'&&n.id.name===local)return {file,local,text:txt.slice(n.start,n.end),start:n.start,end:n.end,byteStart:Buffer.byteLength(txt.slice(0,n.start)),byteEnd:Buffer.byteLength(txt.slice(0,n.end)),fileSha256:sha(fs.readFileSync(file)),sliceSha256:sha(txt.slice(n.start,n.end)),isFunction:true};
 }
 throw Error('Missing '+local+' in '+file);
}
