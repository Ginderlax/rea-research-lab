        "lineStart": 72,
        "lineEnd": 72,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/query-editor/_index.md#L72-L72"
      },
      "applicability": {
