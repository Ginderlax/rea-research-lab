    {
      "id": "grafana.candidate.0e3766a0cd60ea706e93",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Serve Grafana from sub-path specified in `root_url` setting. By default it is set to `false` for compatibility reasons.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[server]`",
        "`serve_from_sub_path`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
