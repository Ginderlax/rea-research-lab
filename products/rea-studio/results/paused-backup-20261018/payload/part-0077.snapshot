    {
      "id": "grafana.candidate.e5c69f3333d1063f9372",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Instruct how headless browser instances are created. Default is `default` and creates a new browser instance on each request.",
      "headingPath": [
