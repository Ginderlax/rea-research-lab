        "lineStart": 43,
        "lineEnd": 43,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/panels-visualizations/visualizations/trend/index.md#L43-L43"
      },
      "applicability": {
