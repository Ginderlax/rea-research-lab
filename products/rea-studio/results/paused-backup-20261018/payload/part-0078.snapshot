    {
      "id": "grafana.candidate.9deafacc032ae59d30bd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "It should return alert instances from log lines with a status code that is not 200 (OK), and that has met the alert condition. The condition for the alert rule to fire is any occurrence that goes over the threshold of `0`. Since the Loki query has returned more than zero alert instances, the alert rule is `Firing`.",
      "headingPath": [
        "How to create alert rules with log data",
        "Create an alert rule",
        "Define query and alert condition"
      ],
      "source": {
