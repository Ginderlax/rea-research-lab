    {
      "id": "grafana.candidate.dd0fdbac4a3907d1f853",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We're excited to announce the new **Transpose** transformation, which allows you to pivot the data frame, converting rows into columns and columns into rows. This feature is particularly useful for data sources that don't support pivot queries, enabling more flexible and insightful data visualizations.",
      "headingPath": [
        "What’s new in Grafana v11.2",
        "Dashboards and visualizations",
        "Transformation updates"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-2.md",
