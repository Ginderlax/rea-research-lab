        "sha256": "c47f46f800915574767d871cfb0f709a00ffbc347d85e18000de024ef2f140d4",
        "lineStart": 254,
        "lineEnd": 254,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/dashboards/build-dashboards/create-dashboard/dashboard-groupings.md#L254-L254"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b51ef1e4bf56dcfda27f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you hide the header of a row, you can't collapse the row.",
      "headingPath": [
        "Dashboard panel groupings",
        "Place panels outside of groupings with headerless rows"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/build-dashboards/create-dashboard/dashboard-groupings.md",
