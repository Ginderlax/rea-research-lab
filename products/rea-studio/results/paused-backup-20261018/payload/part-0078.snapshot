    {
      "id": "grafana.candidate.99b5fdca4637eabd049a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The screenshots of the panel query editor on this page show the new query editing experience, currently in public preview. For information about the classic, generally available query editor, refer to the [Grafana v13.0 documentation](https://grafana.com/docs/grafana/v13.0/visualizations/panels-visualizations/query-transform-data/).",
