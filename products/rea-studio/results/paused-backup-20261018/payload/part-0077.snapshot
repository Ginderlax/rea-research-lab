    {
      "id": "grafana.candidate.3aab7f8b65c659c482f8",
      "syntaxRole": "table-row",
      "sourceText": "| `jwk_set_url`            | No       | Yes                | URL of the JSON Web Key Set (JWKS) endpoint used to verify JWT ID token signatures. Required when ID token validation is enabled. For Okta, use `https://<tenant-id>.okta.com/oauth2/v1/keys`.                                                                                                                                                                                                                                                                                                                      |                               |",
      "headingPath": [
        "Configure Okta OIDC authentication",
        "Configuration options"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/okta/index.md",
