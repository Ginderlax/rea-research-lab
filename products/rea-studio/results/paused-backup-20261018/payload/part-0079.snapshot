        "sha256": "6f07cb510f8b0da003b838c600c8c34236d365c4cc7688913f7fe726f50a0fd7",
        "lineStart": 192,
        "lineEnd": 192,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v8-0.md#L192-L192"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
