import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{fileURLToPath}from'node:url';
const own=path.dirname(fileURLToPath(import.meta.url)),workspace=path.resolve(own,'../..'),lab=path.join(workspace,'outputs/rea-research-lab'),studio=path.join(lab,'products/rea-studio'),run=path.join(workspace,'work/editor-vault-suite-runs/2026-10-13T05-22-11.249Z'),sha=b=>createHash('sha256').update(b).digest('hex');
const inputs=[],start=new Date().toISOString();async function read(file){const b=await fs.readFile(file);inputs.push({path:path.relative(workspace,file).replaceAll('\\','/'),absolutePath:file,bytes:b.length,sha256:sha(b)});return b;}async function json(file){return JSON.parse(await read(file));}async function preserve(file,name){const b=await read(file),dest=path.join(own,'authority',name+'.snapshot');await fs.mkdir(path.dirname(dest),{recursive:true});await fs.writeFile(dest,b,{flag:'wx'});return b;}
await fs.mkdir(path.join(own,'authority'),{recursive:true});const liveValidation=path.join(studio,'results/development-validation.json'),vBytes=await preserve(liveValidation,'development-validation.json');assert.equal(vBytes.length,137063);assert.equal(sha(vBytes),'333303c8bd8cd131da3f01e1414b0fba92bc321b2b63f178ab91d138b2bcfa44');const validation=JSON.parse(vBytes),before=JSON.parse(await preserve(path.join(run,'source-before.json'),'source-before.json')),after=JSON.parse(await preserve(path.join(run,'source-after.json'),'source-after.json')),attempt=JSON.parse(await preserve(path.join(run,'attempt-validation.json'),'attempt-validation.json'));await preserve(path.join(run,'runner.mjs.snapshot'),'runner.mjs');const stdout=(await preserve(path.join(run,'stdout.txt'),'stdout.txt')).toString(),stderr=await preserve(path.join(run,'stderr.txt'),'stderr.txt');assert.equal(stderr.length,0);assert.deepEqual(before,after);assert.equal(before.length,737);assert.equal(attempt.sourceStable,true);assert.equal(attempt.exitCode,0);assert.equal(attempt.failure,null);assert.equal(attempt.signal,null);
const summary=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo','duration_ms'].map(k=>{const matches=[...stdout.matchAll(new RegExp('^# '+k+' ([\\d.]+)$','gm'))];assert.equal(matches.length,1);return [k,Number(matches[0][1])];}));assert.deepEqual(summary,validation.summary);assert.deepEqual(summary,attempt.summary);assert.equal(summary.tests,937);assert.equal(summary.pass,937);assert.equal(summary.fail+summary.skipped+summary.cancelled+summary.todo,0);assert.equal(validation.source_bytes_stable_across_run,true);assert.equal(validation.full_feature_parity_established,false);assert.equal(validation.universal_superiority_established,false);assert.deepEqual(validation.source_files,before.map(({path,sha256})=>({path,sha256})));
for(const row of before){assert(!path.isAbsolute(row.path)&&!row.path.split('/').includes('..'));const saved=await read(path.join(run,'source',row.path+'.snapshot')),current=await read(path.join(studio,row.path));assert.equal(saved.length,row.bytes);assert.equal(sha(saved),row.sha256);assert(current.equals(saved));}
const discovered=before.filter(x=>x.path.endsWith('.test.mjs')&&!x.path.split('/').includes('results')).map(x=>x.path);assert.deepEqual(validation.test_files,discovered);assert(discovered.includes('apps/vault/group-original.test.mjs'));assert(!discovered.some(x=>x.includes('results/')||x.includes('work/')));
const installationPath=path.join(workspace,'work/editor-vault-reviewed-installation-next/installation.json'),installation=JSON.parse(await preserve(installationPath,'installation.json'));assert.equal(installation.proposals.length,30);assert.equal(installation.oldReceiptsRebound,false);assert.equal(installation.exactSourcesBeforeAfter,true);for(const row of installation.proposals){const b=await read(path.join(lab,row.destination));assert.equal(b.length,row.after.bytes);assert.equal(sha(b),row.after.sha256);if(/\.(?:mjs|ps1)$/.test(row.destination)){const liveRow=before.find(x=>'products/rea-studio/'+x.path===row.destination);assert(liveRow);assert.equal(liveRow.sha256,row.after.sha256);}}
const selected=['apps/editor/client.mjs','apps/editor/server.mjs','apps/editor/search-pattern.mjs','apps/editor/workspace-search.mjs','apps/editor/textarea-navigation.ui.test.mjs','apps/vault/client.mjs','apps/vault/server.mjs','apps/vault/recycle.mjs','apps/vault/group-original.test.mjs','apps/vault/group-oracle.ps1','apps/vault/group-fixture.mjs','scripts/verify-development.mjs','server.mjs'];for(const file of selected)await preserve(path.join(studio,file),'current-source/'+file);
const groupSource=(await fs.readFile(path.join(studio,'apps/vault/group-original.test.mjs'))).toString(),groups=[...groupSource.matchAll(/^test\('([^']+)'/gm)].map(x=>x[1]);assert.equal(groups.length,7);const groupTAP=[];for(const name of groups){const hits=[...stdout.matchAll(/^ok (\d+) - (.*)$/gm)].filter(x=>x[2]===name);assert.equal(hits.length,1);groupTAP.push({testNumber:Number(hits[0][1]),name});}assert.deepEqual(groupTAP.map(x=>x.testNumber),[797,798,799,800,801,802,803]);
const observationsPath='C:/Users/evanh/AppData/Local/Temp/rea-group-original-observations-26968/group-original.json',obsStat=await fs.stat(observationsPath);assert(obsStat.mtimeMs>=Date.parse(attempt.startedAtUtc)&&obsStat.mtimeMs<=Date.parse(attempt.completedAtUtc));const observations=JSON.parse(await preserve(observationsPath,'group-original-actual-observations.json'));assert.equal(observations.length,15);let assemblyLoads=0;const calls={};for(const [index,row]of observations.entries()){assert.equal(row.exit.code,0);assert.equal(row.exit.signal,null);assert.equal(row.problem,null);const actual=(row.raw.stderr.match(/REA_GROUP_ASSEMBLY_LOADED_2_61_1/g)||[]).length;assert.equal(actual,1);assert.equal(row.assemblyLoads,actual);const value=JSON.parse(row.raw.stdout.trim());assert.deepEqual(value,row.value);assert.equal(value.release,'2.61.1');assert.equal(value.calls.assemblyLoads,1);assert.equal(value.calls.originalGUI,0);assert.equal(value.calls.originalProgram,0);assert.equal(row.config.password,'synthetic fixture password; value omitted');assemblyLoads+=actual;for(const[k,v]of Object.entries(value.calls))calls[k]=(calls[k]??0)+v;}assert.equal(assemblyLoads,15);assert.equal(calls.openDatabase,18);const oracle=await read(path.join(lab,'projects/07-keepass/artifacts/portable/KeePass.exe'));assert.equal(sha(oracle),'04d29636c393f0c1fc99ff739295494be3adefded93271e44591e8e300225a5a');
const originalMarkers=[];for(const line of stdout.split(/\r?\n/)){const match=/^# (REA_KEEPASS_HISTORY_ORIGINAL|REA_KEEPASS_HISTORY_HTTP|REA_KEEPASS_HISTORY_UNKNOWN|REA_RECYCLE_ORIGINAL|REA_RECYCLE_HTTP) (\{.*\})$/.exec(line);if(!match)continue;const value=JSON.parse(match[2]);let evidence=null;if(value.detail){const detail=path.resolve(value.detail),b=await read(detail);evidence={path:detail,bytes:b.length,sha256:sha(b)};await fs.writeFile(path.join(own,'authority',match[1]+'.json.snapshot'),b,{flag:'wx'});}originalMarkers.push({marker:match[1],value,evidence});}assert.equal(originalMarkers.length,5);assert.equal(originalMarkers.find(x=>x.marker==='REA_KEEPASS_HISTORY_ORIGINAL').value.originalProcessExecutions,14);assert.equal(originalMarkers.find(x=>x.marker==='REA_KEEPASS_HISTORY_HTTP').value.originalProcessExecutions,1);assert.equal(originalMarkers.find(x=>x.marker==='REA_KEEPASS_HISTORY_UNKNOWN').value.originalProcessExecutions,9);assert.equal(originalMarkers.find(x=>x.marker==='REA_RECYCLE_ORIGINAL').value.assemblyLoads,14);
const inputMap=new Map();for(const row of inputs){const old=inputMap.get(row.absolutePath);if(old)assert.equal(old.sha256,row.sha256);else inputMap.set(row.absolutePath,row);}const afterInputs=[];for(const row of inputMap.values()){const b=await fs.readFile(row.absolutePath);assert.equal(b.length,row.bytes);assert.equal(sha(b),row.sha256);afterInputs.push({...row,unchanged:true});}const auditAt=new Date().toISOString();await fs.writeFile(path.join(own,'input-authentication.json'),JSON.stringify({schema:'rea-editor-vault-suite-input-authentication/v1',startedAt:start,endedAt:auditAt,inputs:afterInputs.map(({absolutePath,...row})=>row),allUnchanged:true},null,2)+'\n');
const report={schema:'rea-editor-vault-suite-independent-review/v1',startedAt:start,completedAt:auditAt,readOnly:true,newAppTests:0,newOriginalExecutions:0,newBrowserExecutions:0,benchmarks:0,productionWrites:0,runDirectory:path.relative(workspace,run).replaceAll('\\','/'),validation:{path:'outputs/rea-research-lab/products/rea-studio/results/development-validation.json',bytes:vBytes.length,sha256:sha(vBytes)},summary,source:{beforeAndAfter737Exact:true,current737AndInertSnapshotsExact:true,uniqueRequiredTestFiles:discovered.length,resultsTestsNotExecuted:true,privateDotLocalNotCaptured:true,readmeMarkdownNotInSuiteSourceCensus:true},installation:{proposalFiles:30,editor:installation.proposals.filter(x=>x.role==='editor').length,vault:installation.proposals.filter(x=>x.role==='vault').length,allCurrentAfterHashesExact:true,rootInstallationReceiptSHA256:sha(await fs.readFile(installationPath)),editorClient:before.find(x=>x.path==='apps/editor/client.mjs'),vaultClient:before.find(x=>x.path==='apps/vault/client.mjs'),vaultServer:before.find(x=>x.path==='apps/vault/server.mjs'),vaultRecycle:before.find(x=>x.path==='apps/vault/recycle.mjs')},groupOriginal:{requiredTestSelected:true,actualPassedGroups:groupTAP,actualManagedChildren:observations.length,actualAssemblyLoadStderrMarkers:assemblyLoads,actualOpenDatabase:calls.openDatabase,aggregateCallCounters:calls,observationPath:observationsPath,observationMtime:obsStat.mtime.toISOString(),observationsWithinRunTime:true,observationSHA256:sha(await fs.readFile(observationsPath)),binarySHA256:sha(oracle),originalGUI:0,originalFullProgram:0,scope:'Actual released managed library/private helpers, source-composed MainForm commands, synthetic clock/UUID adapters. Not original GUI/full application.'},requiredOriginalMarkers:originalMarkers,overlapPolicy:{group15CurrentSeparateFromHistorical777Group15:true,activeListCorrection343OriginalRerunZeroHistoricalOnly:true,historyCurrent14Plus1Plus9SeparateFromPriorHistory24:true,entryRecycleCurrent14SeparateFromPriorRecycle14:true,baselineVaultIntegrationOriginalChecksNotAddedToThesePartialMarkerCounts:true,newFlowStage57NotInstalledOrCountedIn937:true,noSummedAllVaultOriginalTotalClaim:true},findings:[],preparationDiagnostics:[{kind:'read-only optional metadata lookup',error:'ENOENT for guessed work/editor-pattern-root-installation-plan-next/validation.json; actual file inventory identified installation-plan.json. No app/original/test execution or input mutation.'}],limits:['No new behavioral execution; authenticates existing run/evidence.','One current group observation directory is tied by timestamp, selected test source and complete sequential fixture records; raw assembly markers validate actual loads.','Suite source list excludes Markdown and private generated outputs. Installation Markdown separately hashes exact current proposed bytes.','Historical focused tests/corpora overlap current execution; counts remain separate epochs, not additive coverage or full compatibility.'],fullParity:false,universalSuperiority:false,finiteAccepted:true};await fs.writeFile(path.join(own,'review-validation.json'),JSON.stringify(report,null,2)+'\n');await fs.writeFile(path.join(own,'README.md'),`# Read-only combined Editor/Vault suite authentication\n\n937/937 current tests, zero failures/skips/cancellation/todo;737 captured sources match before/after/current and exact inert root snapshots.30 installed proposal bytes are exact (Editor14/Vault16), including Markdown separately outside the suite's source extension filter.\n\nNew group-original.test.mjs is selected and seven TAP groups797–803 passed. Its current private observation file contains15 actual exit0 managed child records,15 exact stderr assembly-load markers and18 database opens, recorded during this run. This confirms executions rather than merely summing source declarations. Source-composed synthetic group command orchestration is distinct from original GUI/full-program execution, both zero. Historical777 group's15, current history24 and entry-recycle14 remain separate overlapping epochs. No all-Vault original total is inferred.\n\nNo new tests, application/original/browser executions, benchmarks or production writes. One read-only optional metadata filename lookup failed; preserved in the receipt as a preparation diagnostic. No blocking accounting/source finding.\n`);
async function inventory(dir,prefix=''){const rows=[];for(const e of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){if(!prefix&&['manifest.json','freeze.json'].includes(e.name))continue;const p=prefix?prefix+'/'+e.name:e.name;if(e.isDirectory())rows.push(...await inventory(path.join(dir,e.name),p));else{const b=await fs.readFile(path.join(dir,e.name));assert(!(b[0]===0x4d&&b[1]===0x5a));assert(!(b[0]===0x50&&b[1]===0x4b));assert(!/\.(exe|dll|zip|7z|tgz|tar|gz)$/i.test(p));rows.push({path:p,bytes:b.length,sha256:sha(b)});}}return rows;}const inventoryRows=await inventory(own);await fs.writeFile(path.join(own,'manifest.json'),JSON.stringify({schema:'rea-editor-vault-suite-independent-review-manifest/v1',files:inventoryRows.length,inventory:inventoryRows},null,2)+'\n');const m=await fs.readFile(path.join(own,'manifest.json')),r=await fs.readFile(path.join(own,'review-validation.json'));await fs.writeFile(path.join(own,'freeze.json'),JSON.stringify({schema:'rea-editor-vault-suite-independent-review-freeze/v1',files:inventoryRows.length,receipt:{path:'review-validation.json',bytes:r.length,sha256:sha(r)},manifest:{path:'manifest.json',bytes:m.length,sha256:sha(m)},readOnly:true},null,2)+'\n');console.log(JSON.stringify({finiteAccepted:true,tests:summary.tests,source737Exact:true,managedLoads:assemblyLoads,openDatabase:calls.openDatabase,calls,files:inventoryRows.length,receiptSHA256:sha(r),manifestSHA256:sha(m),testFiles:discovered.length}));
