    {
      "id": "grafana.candidate.5f053b69547791a31801",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The format is `<IP>` or `<DOMAIN>:<PORT>` separated by spaces. PostgreSQL, MySQL, and MSSQL data sources don't use the proxy and are not affected by this setting.",
      "headingPath": [
