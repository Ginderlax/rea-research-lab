    {
      "id": "grafana.candidate.c92d902660c0b15bd089",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Toggle the switch to include experimental element types in the available selections, including **Button**, **Wind Turbine**, **Drone Top**, **Drone Front**, and **Drone Side**. This option is on by default.",
      "headingPath": [
