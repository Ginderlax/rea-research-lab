    {
      "id": "grafana.candidate.02ca91e299b84bb874d0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you set the operator to `=` or `!=`, you can add wildcards to the filter value field.",
      "headingPath": [
        "Google Cloud Monitoring query editor",
        "Query metrics",
        "Apply a filter",
        "Use simple wildcards"
      ],
      "source": {
        "path": "docs/sources/datasources/google-cloud-monitoring/query-editor/index.md",
