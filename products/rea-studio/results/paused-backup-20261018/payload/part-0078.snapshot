    {
      "id": "grafana.candidate.a342aeccb4eeb2e1c119",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This section provides information about best practices for intermediate Grafana administrators and users about how to build and maintain Grafana dashboards.",
      "headingPath": [
        "Grafana dashboard best practices"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/build-dashboards/best-practices/index.md",
        "gitBlobSha": "df7f3f2e648b64895f6be11261c30021f9746e4f",
        "sha256": "5e3970ef4ca56f2803e0ad76022064bdfd847fcb3a9500b474f6ec96d7c2dbde",
        "lineStart": 74,
        "lineEnd": 74,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/dashboards/build-dashboards/best-practices/index.md#L74-L74"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
