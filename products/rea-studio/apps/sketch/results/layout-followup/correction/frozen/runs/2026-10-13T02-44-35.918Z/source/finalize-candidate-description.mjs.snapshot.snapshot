import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';
const root=import.meta.dirname,p=path.join(root,'products/rea-studio/apps/sketch/README.md');let text=fs.readFileSync(p,'utf8');text=text.replace('rotation, snapping, alignment/distribution, layer/order controls','rotation, snapping, layer/order controls');text+='\n## Alignment and distribution\n\nSix selection actions align left/center/right or top/middle/bottom. Horizontal and vertical distribution arrange separate shapes or outer groups, retaining their internal offsets. Shift selection expands a selected outer group to its editable members. Ctrl/Cmd+Shift+arrow aligns to the corresponding edge; Alt+H/V distributes horizontally/vertically. Changed arrangements create one undo checkpoint, retain selection, and survive save/reopen and native geometry export. A single group or already arranged selection creates no undo checkpoint. Actions refuse an active drawing gesture. Signed line endpoints and freehand point bounds remain intact. Native groups with preserved non-editable members and containers with external bindings refuse layout because those dependencies cannot yet be maintained. Candidate coordinates retain the existing finite editor bounds.\n\nThese actions are source-assisted from the pinned Excalidraw0.18.1 source. Original helper verification is scoped to unrotated, unbound fixtures and does not execute the original renderer, workbench, frame membership or full binding engine. Full native layout, rotation, text metrics and original GUI comparison remain open.\n';fs.writeFileSync(p,text);
const t=path.join(root,'layout.test.mjs');let source=fs.readFileSync(t,'utf8');for(const [from,to] of [["function compare(original,input,op){","function compare(original,input,op,packets){"],["assert.deepEqual(positions(actual),input.shapes.map(s=>byId.get(s.id)));return actual;","const expected=input.shapes.map(s=>byId.get(s.id)),current=positions(actual),signed=rows=>rows.map(r=>({id:r.id,xNegativeZero:Object.is(r.x,-0),yNegativeZero:Object.is(r.y,-0)}));packets.push({operation:op,input:structuredClone(input),expected,current,expectedSignedZeros:signed(expected),currentSignedZeros:signed(current)});assert.deepEqual(current,expected);return actual;"],["let seed=0x53a821de,paired=0;","const packets=[];let seed=0x53a821de,paired=0;"],["compare(original,fixture,op);paired++;","compare(original,fixture,op,packets);paired++;"],["ownedMutationAndUnboundBindingAdapters:true,","exactOriginalMutationHelpersExecuted:true,ownedTimestampRandomSceneAndUnboundBindingAdapters:true,packets,"]]){assert.equal(source.split(from).length,2,from);source=source.replace(from,()=>to);}fs.writeFileSync(t,source);
fs.writeFileSync(path.join(root,'candidate-correction.json'),JSON.stringify({schema:'rea-sketch-layout-negative-zero-correction/v1',negativeRuns:['runs/2026-10-13T02-22-48.276Z','runs/2026-10-13T02-25-05.233Z'],firstRun:'27/28; owned unconditional mutation adapter incorrectly converted a preserved negative zero during alignment. Original helper bodies are now used instead.',secondRun:'27/28; exact original newElementWith copies both x/y updates when distribution changes either coordinate, converting negative zero on the other axis. Candidate initially changed only selected axis.',runtimeCorrection:'Alignment applies only numerically different coordinate values, matching mutateElement equality guards. Distribution copies both x/y arithmetic results only if the selected coordinate changes, matching newElementWith conditional copy. No JSON or numeric assertion normalization.',exactNegativeRawAndSourcesPreserved:true,originalBodiesEdited:false,fullOriginalBindingOrRendererClaim:false},null,2)+'\n',{flag:'wx'});
