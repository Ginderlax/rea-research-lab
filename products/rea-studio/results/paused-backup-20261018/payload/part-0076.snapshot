    },
    {
      "id": "grafana.candidate.22dceccbec4efbddf29f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Regular expression searches can be slow on high-cardinality tags, so try to use other tags to reduce the scope first. To help reduce the results, start by filtering on a particular name or namespace.",
      "headingPath": [
        "Graphite query editor",
        "Functions",
        "Select and explore data with tags"
      ],
      "source": {
        "path": "docs/sources/datasources/graphite/query-editor/index.md",
