    {
      "id": "grafana.candidate.f6711feff82eee87b40b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The timeout duration of an HTTP request or gRPC call to Loki. The default is `3s`.",
      "headingPath": [
        "Configure Grafana Enterprise",
        "[auditing.logs.loki]",
        "timeout"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md",
