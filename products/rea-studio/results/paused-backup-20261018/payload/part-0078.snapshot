    {
      "id": "grafana.candidate.6ecb53efa20cbb583a26",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Explore consists of a toolbar, outline, query editor, the ability to add multiple queries, a query history and a query inspector.",
      "headingPath": [
        "Get started with Explore",
        "Explore elements"
      ],
      "source": {
        "path": "docs/sources/visualizations/explore/get-started-with-explore.md",
