    {
      "id": "grafana.candidate.e8f7e29d0a2fb8c7bd15",
      "syntaxRole": "list-item",
      "sourceText": "- **Generate panel and dashboard titles and descriptions** - You can now generate a title and description for your panel or dashboard based on the data you've added to it. This is useful when you want to quickly visualize your data and don't want to spend time coming up with a title or description.",
      "headingPath": [
        "What’s new in Grafana v10.2",
        "Dashboards and visualizations",
        "Use AI to generate titles, descriptions, and change summaries"
      ],
      "source": {
