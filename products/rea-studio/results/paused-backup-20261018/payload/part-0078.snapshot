    },
    {
      "id": "grafana.candidate.9c994dbfcee906fb3dea",
      "syntaxRole": "list-item",
      "sourceText": "- `name` is what users will see in the list of plugins. If you're creating a data source, this is typically the name of the database it connects to, such as Prometheus, PostgreSQL, or Stackdriver.",
      "headingPath": [
