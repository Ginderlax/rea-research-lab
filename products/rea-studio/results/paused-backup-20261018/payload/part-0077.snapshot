    {
      "id": "grafana.candidate.338be63ed2c82044601f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Image rendering:** run the image renderer as a separate process or container. Each renderer worker uses approximately 1 GB of memory; size your renderer host accordingly. Refer to [Set up image rendering](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/setup-grafana/image-rendering/).",
      "headingPath": [
        "Install Grafana",
        "Hardware recommendations",
        "Deployment tiers",
        "Medium"
      ],
      "source": {
