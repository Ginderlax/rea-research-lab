def content(name):
 p=safe(evidence,name);assert p.is_file()and p.stat().st_size<=8*1024*1024;return p.read_bytes()
def load(name):return json.loads(content(name).decode('utf-8-sig'))
def png(data):
 assert data[:8]==bytes.fromhex('89504e470d0a1a0a');at=8;dimensions=None;ended=False
 while at+12<=len(data):
  size=int.from_bytes(data[at:at+4],'big');kind=data[at+4:at+8];end=at+size+12;assert end<=len(data);payload=data[at+8:at+8+size];assert(zlib.crc32(kind+payload)&0xffffffff)==int.from_bytes(data[at+8+size:end],'big')
  if kind==b'IHDR':assert at==8 and size==13;dimensions=struct.unpack('>II',payload[:8])
  at=end
  if kind==b'IEND':assert size==0 and at==len(data);ended=True;break
 assert ended and dimensions==(1440,1100)
