    },
    {
      "id": "grafana.candidate.784cec027a1880d2621e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "There are two types of queries you can create with the Elasticsearch query builder. Each type is explained in detail below.",
      "headingPath": [
        "Elasticsearch query editor",
        "Select a query type"
      ],
      "source": {
        "path": "docs/sources/datasources/elasticsearch/query-editor/index.md",
        "gitBlobSha": "d0f25c1cab3b4fcd5e05cce9a8f8cfccaf17ea0b",
