    {
      "id": "grafana.candidate.18375eb6847787589e62",
      "syntaxRole": "table-row",
      "sourceText": "| `validate_id_token`      | No       | Yes                | If enabled, Grafana will validate the JWT signature of ID tokens using the JWKS endpoint. This enhances security by ensuring tokens are authentic and have not been tampered with.                                                                                                                                                                                                                                                                                                                                  | `false`                       |",
      "headingPath": [
        "Configure Okta OIDC authentication",
        "Configuration options"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/okta/index.md",
        "gitBlobSha": "4de8751f865ff55ac58451811f4eafc681a66671",
        "sha256": "fe422737ef152e83e92f9b6cbc00fc7578d6b44c697ed6a6486447f716916c6d",
        "lineStart": 315,
        "lineEnd": 315,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/okta/index.md#L315-L315"
