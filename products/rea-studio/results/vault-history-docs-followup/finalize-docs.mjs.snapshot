import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import{createHash}from'node:crypto';
const root=import.meta.dirname,work=path.dirname(root),sha=b=>createHash('sha256').update(b).digest('hex'),read=n=>fs.readFile(path.join(root,n)),bind=async n=>{const b=await read(n);return{path:n,bytes:b.length,sha256:sha(b)}};
const contractBytes=await read('next-contracts.json'),contracts=JSON.parse(contractBytes),before=contracts.contracts.filter(e=>['KPS2611-RECYCLE-ENTRY-OWNERSHIP','KPS2611-RECYCLE-PREVIOUS-PARENT-GUARD'].includes(e.id));
await fs.mkdir(path.join(root,'attempts/citation-span-refinement'),{recursive:true});await fs.writeFile(path.join(root,'attempts/citation-span-refinement/next-contracts.initial.json.snapshot'),contractBytes,{flag:'wx'});
for(const e of before){const b=await read('.local/pinned-source/'+e.source),lines=b.toString('utf8').split(/(?<=\n)/);e.lineEnd=e.id==='KPS2611-RECYCLE-ENTRY-OWNERSHIP'?1354:6914;const raw=Buffer.from(lines.slice(e.lineStart-1,e.lineEnd).join('')),context=Buffer.from(lines.slice(Math.max(0,e.lineStart-4),Math.min(lines.length,e.lineEnd+3)).join(''));e.utf8ByteLength=raw.length;e.rawSpanSha256=sha(raw);e.contextSha256=sha(context);if(e.id.endsWith('OWNERSHIP'))assert(raw.toString().includes('pe.LocationChanged = DateTime.UtcNow'));else assert(raw.toString().includes('if(pgPrev == pgParent) return null;'));}
await fs.writeFile(path.join(root,'next-contracts.json'),JSON.stringify(contracts,null,2)+'\n');await fs.writeFile(path.join(root,'attempts/citation-span-refinement/refinement.json'),JSON.stringify({reason:'Extend two source spans to include the actual ownership/location assignments and complete same-parent guard; meanings unchanged.',originalExecutions:0,runtimeTests:0,initialRecordSha256:sha(contractBytes)},null,2)+'\n',{flag:'wx'});
for(const n of ['README.proposal.md','README-delta.json']){let t=(await read(n)).toString('utf8');const replacements=[['passed41','passed 41'],['replayed11','replayed 11'],['passed11','passed 11'],['made24','made 24'],['counts0','counts 0'],['compatibility18','compatibility18'],['original1454','original 1454'],['to1442','to 1442'],['and12','and 12'],['sourceZIP','source ZIP'],['contains1656','contains 1656'],['final82','final 82']];for(const[a,b]of replacements)t=t.replaceAll(a,b);await fs.writeFile(path.join(root,n),t);}
const bindings=[];for(const e of contracts.contracts){const b=await read('.local/pinned-source/'+e.source);assert.equal(sha(b),e.sourceSha256);assert.equal(sha(b.subarray(e.utf8ByteOffset,e.utf8ByteOffset+e.utf8ByteLength)),e.rawSpanSha256);bindings.push({id:e.id,valid:true});}
const bundle=path.join(work,'keepass-history-production-integration-bundle-ready'),adapter=path.join(work,'keepass-history-production-adapter'),review=path.join(work,'keepass-history-draft-independent-review');
const bindExternal=async(dir,n)=>{const b=await fs.readFile(path.join(dir,n));return{path:path.relative(work,path.join(dir,n)).replaceAll('\\','/'),bytes:b.length,sha256:sha(b)}};
const external=[await bindExternal(bundle,'integration-validation.json'),await bindExternal(bundle,'integration-manifest.json'),await bindExternal(adapter,'adapter-validation.json'),await bindExternal(review,'review-validation.json'),await bindExternal(review,'review-manifest.json'),await bindExternal(work,'keepass-history-draft-fix-next/draft-validation.final.json'),await bindExternal(work,'keepass-manual-requirements-next/supplement/manual-contracts.json'),await bindExternal(work,'keepass-manual-requirements-next/topic-census.json')];
assert.equal(external[0].sha256,'68d8ff9eefa9b56ecbb86b5d1fd74cd33861cd2bc82aa3713a0c098d63f642ab');assert.equal(external[1].sha256,'5a27d0e6e4c3772ef79bd46cc6b748e86775f3424719c6db4c690c670ae90758');assert.equal(external[2].sha256,'333489f32316708416e751fc53db2853f926619907038f6ed552ae0ecf8453e5');assert.equal(external[3].sha256,'5f529c2497a237f8af210c28df117d836f17ba65f42e909dc302bd39576434d0');
// Resolve app-relative local document links against the frozen proposed layout.
const links=[];for(const n of ['README.proposal.md','HISTORY.md']){const t=(await read(n)).toString('utf8');for(const m of t.matchAll(/\]\(([^)]+)\)/g)){const ref=m[1];if(/^https?:/.test(ref))continue;const local=ref==='HISTORY.md'?path.join(root,'HISTORY.md'):path.resolve(bundle,'products/rea-studio/apps/vault',ref);if(ref.startsWith('../../requirements/')){assert(ref==='../../requirements/keepass-manual-supplement/README.md');const p=path.join(work,'keepass-manual-requirements-next/supplement/README.md');await fs.access(p);}else await fs.access(local);links.push({document:n,reference:ref,exists:true});}}
const receipt={schema:'rea-vault-history-docs-and-next-feature-source-only/v1',completed:new Date().toISOString(),proposalOnly:true,productionEdited:false,frozenInputsChanged:false,originalExecutions:0,runtimeTests:0,browserExecutions:0,newMeasurements:0,proposedProductionDocs:['README.proposal.md','HISTORY.md'],readmeBaselineSha256:'f1d508dddf2fd2a1772a5abdaa99db9cfe2654ff2dbd1bb17cdf4369851a75cf',readmeDelta:await bind('README-delta.json'),sourceFiles:10,sourceContracts:9,sourceSpanChecks:bindings,localLinkChecks:links,externalBindings:external,nextFeature:'Source-assisted bounded entry-only recycle bin/recovery/permanent deletion with UUID ancestry and native tombstones; acceptance unexecuted.',manualAlternative:'KPM2611-HISTORY-DELETE-SPECIFIC citation authenticated; original pending-dialog Save/Cancel distinction retained.',manualLedgerUnchanged:true,fullParity:false,securityParity:false,superiority:false,nonbehavioralDiagnostics:['Earlier source search used two missing paths; corrected to known pinned census/Studio registry paths, no runtime effect.','Two incomplete source citation ends refined and initial next-contracts record retained.'],candidateSourceUnchanged:true};
await fs.writeFile(path.join(root,'docs-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});const files=[];async function walk(rel=''){for(const e of await fs.readdir(path.join(root,rel),{withFileTypes:true})){const n=rel?rel+'/'+e.name:e.name;if(e.isDirectory())await walk(n);else{assert(e.isFile());files.push(await bind(n));}}}await walk();files.sort((a,b)=>a.path.localeCompare(b.path,'en'));await fs.writeFile(path.join(root,'docs-manifest.json'),JSON.stringify({schema:'rea-vault-docs-next-strict-manifest/v1',count:files.length,files,strictInventory:true,metadataExclusions:['docs-manifest.json','docs-freeze.json'],localOnlyDirectories:['.local/pinned-source'],publicProposalFiles:['README.proposal.md','HISTORY.md','README-delta.json','NOTES.md','next-contracts.json','source-study.json','docs-validation.json']},null,2)+'\n',{flag:'wx'});const freeze={schema:'rea-vault-docs-next-freeze/v1',frozenAt:new Date().toISOString(),count:files.length,receipt:await bind('docs-validation.json'),manifest:await bind('docs-manifest.json'),productionEdited:false,allStageFilesFrozen:true};await fs.writeFile(path.join(root,'docs-freeze.json'),JSON.stringify(freeze,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(freeze));
