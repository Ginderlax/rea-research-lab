import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,workspace=path.resolve(here,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),aliases=JSON.parse(await fs.readFile(path.join(here,'public-alias-copy-list.json'))),live=JSON.parse(await fs.readFile(path.join(here,'live-install-copy-list.json'))),baseline=JSON.parse(await fs.readFile(path.join(here,'external-baseline14.json'))),binding=JSON.parse(await fs.readFile(path.join(here,'requirements-binding.json'))),census=JSON.parse(await fs.readFile(path.join(here,'proposed-test-census.json')));for(const r of aliases.records){const b=await fs.readFile(path.join(workspace,r.source));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256,r.source);assert(r.destination.endsWith('.snapshot'));assert(!r.destination.includes('/.local/'));}for(const r of live.records){const b=await fs.readFile(path.join(workspace,r.source));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);if(r.mode==='replace'){const old=await fs.readFile(path.join(repo,r.destination));assert.equal(sha(old),r.prior.sha256);}else{await assert.rejects(fs.access(path.join(repo,r.destination)));}}for(const r of baseline.rows){const b=await fs.readFile(path.join(repo,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256,r.path);}const registryObservations=[],sources=[],caps=[];for(const r of binding.registries){const b=await fs.readFile(path.join(repo,r.path)),j=JSON.parse(b),name=path.basename(r.path);registryObservations.push({path:r.path,bytes:b.length,sha256:sha(b),matchesPreparation:sha(b)===r.sha256});for(const s of j.sources)sources.push({registry:name,id:s.id,sha256:s.sha256});const rows=name==='workspace-products.json'?j.capabilities:name==='visual-products.json'?j.baselineProducts.flatMap(p=>p.requirements):j.products.flatMap(p=>p.capabilities);for(const c of rows)caps.push({registry:name,id:c.id});}assert.deepEqual(sources,binding.originalSources);assert.deepEqual(caps,binding.originalCapabilityIds);const receipt={schema:'rea-sketch-layout-source-publication-plan/v1',at:new Date().toISOString(),sourceOnly:true,publicAliasMap:{path:'public-alias-copy-list.json',sha256:sha(await fs.readFile(path.join(here,'public-alias-copy-list.json'))),aliases:661,epochs:aliases.epochs},liveMap:{path:'live-install-copy-list.json',sha256:sha(await fs.readFile(path.join(here,'live-install-copy-list.json'))),files:8,replace:2,add:6,sharedHostFiles:0},selectedOfficialMITFiles:8,payloadScan:{path:'payload-scan.json',sha256:sha(await fs.readFile(path.join(here,'payload-scan.json'))),nativeArchiveOrExecutableHeaders:0,archiveExecutablePaths:0,credentialMarkers:0,personalDataCertification:false,authorFilesystemProvenanceRetained:true},baseline14BeforeAfter:true,requirements:{sourceIDsSHA159Exact:true,capabilityIDs232Exact:true,registryObservations,registriesModified:false},syntaxChecks:7,testsExecuted:0,originalHelpersExecuted:0,benchmarks:0,browser:0,hosts:0,productionEdits:0,priorFrozenEpochsUnchanged:true,proposedNewTestGroups:census.newGroups,prospectiveFocused30:census.focusedAuthorSelection,prospectiveExpanded39:census.expandedSketchSelection,independentFresh78NotInstalledOrRecounted:true,ownedPreparationFailure:1,actualInstalledAcceptance:false,actualCurrentBrowserAcceptance:false,fullParity:false,superiority:false};await fs.writeFile(path.join(here,'plan-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});async function walk(d,p=''){const out=[];for(const e of await fs.readdir(d,{withFileTypes:true})){assert(!e.isSymbolicLink());if(e.isDirectory())out.push(...await walk(path.join(d,e.name),p+e.name+'/'));else out.push(p+e.name);}return out;}const inventory=[];for(const p of(await walk(here)).sort()){assert.notEqual(p,'plan-manifest.json');const b=await fs.readFile(path.join(here,p));inventory.push({path:p,bytes:b.length,sha256:sha(b)});}const m={schema:'rea-sketch-layout-source-publication-plan-freeze/v1',files:inventory.length,totalBytes:inventory.reduce((n,r)=>n+r.bytes,0),inventory},b=Buffer.from(JSON.stringify(m,null,2)+'\n');await fs.writeFile(path.join(here,'plan-manifest.json'),b,{flag:'wx'});console.log(JSON.stringify({files:m.files,manifestSHA256:sha(b),receiptSHA256:sha(await fs.readFile(path.join(here,'plan-validation.json'))),publicAliases:661,liveFiles:8,sourceOnly:true}));
