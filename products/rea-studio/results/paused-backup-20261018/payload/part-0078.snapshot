    },
    {
      "id": "grafana.candidate.0d3b1c59cf948b147cf3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The `dashboardPreviews` feature flag is no longer available and can be safely removed from the Grafana server configuration.",
      "headingPath": [
        "Upgrade to Grafana v10.0",
        "Technical notes",
        "Dashboard previews removal"
      ],
      "source": {
        "path": "docs/sources/upgrade-guide/upgrade-v10.0/index.md",
        "gitBlobSha": "dd17de6d803d293f6310407d7596f0488e510810",
