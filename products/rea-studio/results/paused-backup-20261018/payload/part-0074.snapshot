    },
    {
      "id": "grafana.candidate.c32283cf19ae6c4ce1fc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you save a provisioned dashboard in the UI and remove the provisioning source, Grafana deletes the dashboard in the database unless you have set the option `disableDeletion` to `true`.",
      "headingPath": [
        "Provision Grafana",
        "Dashboards",
        "Example dashboard configuration file",
        "Make changes to a provisioned dashboard"
      ],
      "source": {
