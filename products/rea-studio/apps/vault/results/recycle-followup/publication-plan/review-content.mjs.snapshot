import fs from 'node:fs/promises';import path from 'node:path';import{fileURLToPath}from'node:url';import{createHash}from'node:crypto';
const root=fileURLToPath(new URL('./',import.meta.url)),hash=b=>createHash('sha256').update(b).digest('hex'),map=JSON.parse(await fs.readFile(path.join(root,'selected-file-map.json'))),scan=JSON.parse(await fs.readFile(path.join(root,'content-scan.json'))),sourceRows=map.payload.filter(r=>/\.(?:mjs|ps1)(?:\.snapshot)*$/.test(r.sourcePath)),sources=await Promise.all(sourceRows.map(async r=>({...r,text:await fs.readFile(r.sourceAbsolute,'utf8')}))),values=new Map();
for(const r of map.payload){const scanned=scan.rows.find(s=>s.sha256===r.sha256);if(!scanned.credentialLexicalMatches.length)continue;const text=await fs.readFile(r.sourceAbsolute,'utf8');for(const match of text.matchAll(/"(password|localPassword|masterPassword|fixtureMaster|secret|token|authorization)"\s*:\s*"((?:[^"\\]|\\.)*)"/gi)){let value;try{value=JSON.parse('"'+match[2]+'"');}catch{continue;}const digest=hash(value);if(values.has(digest))continue;const origin=sources.filter(s=>value.length>=8&&s.text.includes(value));values.set(digest,{valueSha256:digest,characters:value.length,key:match[1],classification:value.length===0?'Empty clear-state assertion':origin.length?'Owned fixture value appears in authenticated test/helper source':/owned|synthetic|stage|test|only-|master/i.test(value)?'Explicit owned synthetic fixture label':'Unresolved lexical match requires review',sourceBindings:origin.slice(0,6).map(s=>({epoch:s.epoch,path:s.sourcePath,sha256:s.sha256})),occurrence:r.epoch+':'+r.sourcePath});}}
const report={schema:'rea-lexical-fixture-classification/v1',at:new Date().toISOString(),matches:[...values.values()],unresolved:[...values.values()].filter(r=>r.classification.startsWith('Unresolved')),localWindowsUsernameMetadata:{uniquePayloadFiles:scan.rows.filter(r=>r.localWindowsUsernamePathMentions).length,username:'evanh',classification:'Original paths and owned temporary process provenance; not a no-personal-data claim. Exact evidence remains unredacted; current prose can use repository-relative labels.'},email:{candidates:scan.emailCandidates,classification:'Only observed email-like value is released KeePass source copyright contact; source license attribution remains exact.'},nativePayload:{excluded:map.excludedNativeCarriers.map(r=>({epoch:r.epoch,path:r.sourcePath,bytes:r.bytes,sha256:r.sha256})),publicNativeHeaders:0,publicEmbeddedNativeBase64:0,exactOriginalExeSourceZipMatches:0},limit:'Finite literal/header scan and source-origin review; not proof of all secret or personal-data absence.'};await fs.writeFile(path.join(root,'content-classification.json'),JSON.stringify(report,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({uniqueCredentialLikeValues:values.size,unresolved:report.unresolved,localPathMetadataFiles:report.localWindowsUsernameMetadata.uniquePayloadFiles}));
