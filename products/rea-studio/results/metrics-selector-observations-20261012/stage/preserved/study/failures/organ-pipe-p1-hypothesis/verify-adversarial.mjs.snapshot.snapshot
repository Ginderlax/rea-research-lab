import fs from 'node:fs/promises';import path from 'node:path';import {pathToFileURL} from 'node:url';import {createRequire} from 'node:module';import {Session} from 'node:inspector';import assert from 'node:assert/strict';import {here,sha,authenticateOriginal} from './authenticate-original.mjs';import {canonical,packet} from './canonical.mjs';
const authority=await authenticateOriginal(),original=createRequire(authority.entry)(authority.entry),baseline=await import(pathToFileURL(path.join(here,'candidate-baseline.mjs')).href),candidate=await import(pathToFileURL(path.join(here,'candidate-module-control.mjs')).href),helperURL=pathToFileURL(path.join(here,'selector-control.mjs')).href,helperSource=await fs.readFile(path.join(here,'selector-control.mjs'),'utf8'),session=new Session();session.connect();const post=(method,params={})=>new Promise((resolve,reject)=>session.post(method,params,(error,result)=>error?reject(error):resolve(result)));
const n=25000,cases=[['organ-pipe',Array.from({length:n},(_,i)=>i<n/2?i+.125:n-i+.125)],['alternating-ends',Array.from({length:n},(_,i)=>i%2?n-Math.floor(i/2):Math.floor(i/2))],['repeated-bands',Array.from({length:n},(_,i)=>Math.floor(i/17)%113)],['prime-lattice',Array.from({length:n},(_,i)=>(i*8191)%32749+.0625)],['chunk-zippers',Array.from({length:n},(_,i)=>Math.floor(i/257)%2?257-i%257:i%257)],['tail-heavy-steps',Array.from({length:n},(_,i)=>i<n*.95?Math.floor(i/499):1e6+(i%13)*.125)]],records=[],marker=helperSource.indexOf('return selectionUnavailable;',helperSource.indexOf('if (++work > budget)'));
await post('Profiler.enable');await post('Profiler.startPreciseCoverage',{callCount:true,detailed:true});
for(const[label,values]of cases)for(const id of ['p1','p5','p25','p50','p75','p95','p99']){
 const field=()=>({name:'synthetic-workcap',type:'number',config:{nullValueMode:'connected'},values:values.slice(),state:{calcs:{unrelated:'kept'}}}),expectedField=field(),expected=original.reduceField({field:expectedField,reducers:[id]});
 const baseField=field(),base=baseline.reduceField({field:baseField,reducers:[id]});assert.equal(canonical(packet(baseField,base)),canonical(packet(expectedField,expected)));
 const actualField=field(),actual=candidate.reduceField({field:actualField,reducers:[id]});assert.equal(canonical(packet(actualField,actual)),canonical(packet(expectedField,expected)));assert.equal(canonical(actualField.values),canonical(values));
 const coverage=await post('Profiler.takePreciseCoverage'),entry=coverage.result.find(row=>row.url===helperURL),selector=entry?.functions.find(row=>row.functionName==='selectFinitePercentile'),ranges=selector?.ranges.filter(range=>range.startOffset<=marker&&range.endOffset>marker).sort((a,b)=>(a.endOffset-a.startOffset)-(b.endOffset-b.startOffset))??[];
 records.push({label,id,samples:n,inputSHA256:sha(canonical(values)),exactBaselineAndCandidate:true,fallbackExecutionCount:ranges[0]?.count??0});
}
await post('Profiler.stopPreciseCoverage');session.disconnect();
const planned=records.find(item=>item.label==='organ-pipe'&&item.id==='p1'),receipt={schemaVersion:1,checkedAt:new Date().toISOString(),status:'passed',records,originalSelections:42,implementationComparisons:84,fallbackExecutions:records.reduce((sum,item)=>sum+item.fallbackExecutionCount,0),plannedAdversarialWorkload:planned,bothCandidateModuleSources:{entry:sha(await fs.readFile(path.join(here,'candidate-module-control.mjs'))),helper:sha(helperSource)},coverageOnlyNotPerformanceProfile:true,timingMeasurementRun:false,memoryMeasurementRun:false};
await fs.writeFile(path.join(here,'results/adversarial-readiness.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});assert.ok(planned.fallbackExecutionCount>0,'Fixed organ-pipe/p1 workload must exercise work-cap fallback');console.log(JSON.stringify({originalSelections:42,implementationComparisons:84,fallbackExecutions:receipt.fallbackExecutions,planned}));
