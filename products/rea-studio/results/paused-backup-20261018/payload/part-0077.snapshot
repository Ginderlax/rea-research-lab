    {
      "id": "grafana.candidate.f29161d20875961a31d9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Options are `s3`, `webdav`, `gcs`, `azure_blob`, `local`). If left empty, then Grafana ignores the upload action.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[external_image_storage]`",
        "`provider`"
      ],
      "source": {
