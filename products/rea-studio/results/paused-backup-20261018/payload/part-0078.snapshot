        "products": []
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.78e5b596f4bb47ba3085",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "`with` is similar to `if` statements, but unlike `if`, it updates dot(`.`) to refer to the value of the expression in `with`:",
      "headingPath": [
        "If",
        "With"
      ],
      "source": {
        "path": "docs/sources/shared/alerts/template-language.md",
