    },
    {
      "id": "grafana.candidate.bd58d1e63a5fa02081d8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The `GET /api/alertmanager/grafana/api/v2/status` endpoint previously required the legacy `alert.notifications:read` permission. It now requires a dedicated `alert.notifications.system-status:read` permission. This new permission is included in the `fixed:alerting.notifications:writer` role, which is granted to Admin users by default.",
      "headingPath": [
        "Upgrade to Grafana v13.0",
        "Technical notes",
        "Alertmanager status endpoint requires a new permission",
        "Description"
      ],
      "source": {
        "path": "docs/sources/upgrade-guide/upgrade-v13.0/index.md",
        "gitBlobSha": "f45eec63216c452b0eebba76d1eb812e54001903",
        "sha256": "471090ddf07331c874d83707d16041b15600bd3e6b1842af09268a9b6a6ffc40",
        "lineStart": 187,
        "lineEnd": 187,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/upgrade-guide/upgrade-v13.0/index.md#L187-L187"
      },
      "applicability": {
        "status": "unresolved-no-explicit-oss-products-label",
        "products": []
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.f12467a58f58b73139b8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you have custom roles that need access to this endpoint, add the `alert.notifications.system-status:read` action to those roles. Admin users are unaffected as they receive this permission automatically through the built-in alerting notifications writer role.",
      "headingPath": [
        "Upgrade to Grafana v13.0",
        "Technical notes",
        "Alertmanager status endpoint requires a new permission",
        "Migration"
      ],
      "source": {
        "path": "docs/sources/upgrade-guide/upgrade-v13.0/index.md",
