    },
    {
      "id": "grafana.candidate.f5e8596ed0d95879b355",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You _must_ use the Kubernetes resource format to provision dashboards v2 / dynamic dashboards.",
      "headingPath": [
        "Provision Grafana",
        "Dashboards",
        "Example dashboard configuration file"
      ],
      "source": {
