    {
      "id": "grafana.candidate.8d07442f98ac4aa8f339",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, Grafana logs whenever it discovers a plugin:",
      "headingPath": [],
      "source": {
        "path": "docs/sources/shared/tutorials/create-plugin.md",
        "gitBlobSha": "799f9afa0d34ff930ab478313e97ce89616d94a0",
        "sha256": "714b2dd37f253c740f8d75318a0d6b148933cd6def01873c6be301600fa8b5c3",
