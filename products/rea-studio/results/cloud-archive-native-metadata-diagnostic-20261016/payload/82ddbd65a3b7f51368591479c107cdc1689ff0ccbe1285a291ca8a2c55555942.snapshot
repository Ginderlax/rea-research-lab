REQUIRED_TEST_NAMES=[
 'archive HTTP file creation, ZIP validation and extraction persist through host restarts',
 'stored and deflated ZIP files preserve binary, UTF-8, empty files and directories',
 'ZIP parser validates CRC and headers and refuses traversal, duplicate paths, and oversized expansion',
 'malicious archive cannot create files outside workspace and unconfirmed extraction does not write',
 'Windows .NET independently reads generated ZIP and our parser reads independently created ZIP']
sha=lambda data:hashlib.sha256(data).hexdigest()
identity=lambda data:{'bytes':len(data),'sha256':sha(data)}
def require(value,label):
 if not value: raise AssertionError(label)
def iso(value):
 require(isinstance(value,str) and re.fullmatch(r'\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{3}Z',value),'Exact UTC millisecond time')
 return datetime.datetime.fromisoformat(value.replace('Z','+00:00'))
def safe(name):
 require(isinstance(name,str) and name and not re.search(r'[\\:\x00-\x1f\x7f]',name) and not name.startswith('/'),'Safe portable member')
 parts=name.rstrip('/').split('/')
 require(all(part and part not in ('.','..') for part in parts),'Safe portable components')
 return name
def json_bytes(data): return json.loads(data.decode('utf-8-sig'))
require(len(sys.argv)==5,'Reader arguments: ZIP SHA256 control-folder artifact-ID')
source=Path(sys.argv[1]).resolve();expected=sys.argv[2];control=Path(sys.argv[3]).resolve();artifact_id=sys.argv[4]
base=Path(__file__).resolve().parent/'cloud-verification-backups'
require(source.is_relative_to(base.resolve()) and source.is_file(),'Owned artifact backup')
require(control.is_relative_to(base.resolve()) and control.is_dir(),'Owned raw API backup')
require(re.fullmatch(r'[0-9a-f]{64}',expected) and artifact_id.isdigit(),'Artifact identity syntax')
raw=source.read_bytes();require(len(raw)<=8*1024*1024 and sha(raw)==expected,'Actual outer ZIP identity/bound')
folder=source.parent/(source.stem+'-native-diagnostic-reader-r3-v1');folder.mkdir(exist_ok=False)
def unpack(data,destination):
 destination.mkdir(parents=True,exist_ok=False);records=[];seen=set();folded=set()
 with zipfile.ZipFile(io.BytesIO(data)) as archive:
  entries=archive.infolist();require(len(entries)<=96,'Fixed ZIP member bound')
  require(sum(e.file_size for e in entries)<=16*1024*1024,'Fixed raw-byte bound')
  for entry in entries:
   name=safe(entry.filename);require(name not in seen and name.casefold() not in folded,'Unique case-independent ZIP names');seen.add(name);folded.add(name.casefold())
   require(not entry.flag_bits&1 and not stat.S_ISLNK(entry.external_attr>>16),'No encrypted or symbolic members')
   require(entry.file_size<=8*1024*1024,'Fixed individual-byte bound')
   target=(destination/name).resolve();require(target.is_relative_to(destination.resolve()),'Owned extraction target')
   if entry.is_dir(): target.mkdir(parents=True,exist_ok=True);continue
   data=archive.read(entry);require(len(data)==entry.file_size,'Complete CRC-checked member bytes')
   target.parent.mkdir(parents=True,exist_ok=True)
   with target.open('xb') as stream: stream.write(data)
   require(target.read_bytes()==data,'Readable exact backup')
   records.append({'path':name,**identity(data)})
 return records
outer=folder/'downloaded-contents';outer_rows=unpack(raw,outer)
require(len(outer_rows)==1 and outer_rows[0]['path'].endswith('.zip'),'Exactly one uploaded portable ZIP')
inner=(outer/outer_rows[0]['path']).read_bytes();require(len(inner)<=8*1024*1024,'Inner ZIP bound')
evidence=folder/'readable-evidence';files=unpack(inner,evidence)
members={row['path']:row for row in files}
result={'schema':'rea-local-native-metadata-diagnostic-backup/v1','runId':RUN,'jobId':JOB,'headSHA':HEAD,'artifactId':artifact_id,
 'artifact':str(source),'artifactIdentity':identity(raw),'portableEvidenceArchive':str(outer/outer_rows[0]['path']),'portableEvidenceArchiveIdentity':identity(inner),
 'readableEvidence':str(evidence),'files':files,'allCRCAndBytesReadable':True,'rawBytesPreservedBeforeQualification':True,
 'qualification':{},'auditErrors':[],'diagnosticFiveChecksAccepted':False,'nativeObservationsQualified':False,'completeTwoWorkerObservations':False,
 'localCandidateExecutions':0,'localProductExecutions':0,'localTests':0,'localBuilds':0,'localSyntaxChecks':0,
 'historicalD24CauseProven':False,'fullSuiteAcceptance':False,'fullParity':False,'superiority':False,
 'scope':'Readable retained observations of this instrumented diagnostic only; failed checks remain failed and never identify a historical unobserved error.'}
def read(name):
 safe(name);require(name in members,'Required uploaded role: '+name);data=(evidence/name).read_bytes();require(identity(data)=={k:members[name][k] for k in ('bytes','sha256')},'Member identity readback');return data
def stage(name,operation):
 try:
  value=operation();result['qualification'][name]={'valid':True,'value':value};return value
 except Exception as error:
  result['qualification'][name]={'valid':False,'errorType':type(error).__name__,'error':str(error)}
  result['auditErrors'].append({'stage':name,'errorType':type(error).__name__,'error':str(error)})
  return None
def api_qualification():
 values={name:json_bytes((control/(name+'.json')).read_bytes()) for name in ('run','jobs','artifacts','commit','tree')}
 run=values['run'];require(str(run['id'])==RUN and str(run['run_attempt'])==ATTEMPT,'Exact actual API run/attempt')
 require(run['head_sha']==HEAD and run['head_branch']=='codex/rea-cloud-recovery-20261015' and run['path']==WORKFLOW,'Exact actual workflow/head/branch')
 require(run['event'] in ('push','workflow_dispatch') and run['status']=='completed','Supported completed diagnostic event')
 require(run['repository']['full_name']==REPOSITORY,'Exact actual repository')
 require(run['conclusion'] in ('success','failure','cancelled','timed_out'),'Honest terminal diagnostic conclusion')
 jobs=values['jobs'];require(jobs['total_count']==1 and len(jobs['jobs'])==1,'Exactly one diagnostic job')
 job=jobs['jobs'][0];require(str(job['id'])==JOB and str(job['run_id'])==RUN and job['head_sha']==HEAD,'Exact actual API job')
 require(job['name']==JOB_NAME and job['status']=='completed' and job['runner_group_name']=='GitHub Actions' and 'windows-2022' in job['labels'],'Verified hosted Windows job')
 require(job['conclusion'] in ('success','failure','cancelled','timed_out'),'Honest terminal job conclusion')
 artifacts=values['artifacts'];require(artifacts['total_count']==1 and len(artifacts['artifacts'])==1,'Exactly one actual artifact')
 artifact=artifacts['artifacts'][0]
 require(str(artifact['id'])==artifact_id and artifact['name']=='archive-native-diagnostic-'+RUN+'-'+ATTEMPT,'Exact diagnostic artifact ID/name')
 require(not artifact['expired'] and artifact['digest']=='sha256:'+expected and artifact['size_in_bytes']==len(raw),'Actual artifact digest/size')
 require(str(artifact['workflow_run']['id'])==RUN and artifact['workflow_run']['head_sha']==HEAD,'Artifact-to-run source binding')
 require(values['commit']['sha']==HEAD and values['tree']['sha']==values['commit']['tree']['sha'] and values['tree']['truncated'] is False,'Exact complete committed tree')
 require(len(values['tree']['tree'])<=100000,'Bounded actual tree')
 return {'runConclusion':run['conclusion'],'jobConclusion':job['conclusion'],'event':run['event'],'tree':values['tree']['sha']}
api=stage('actualApiAndArtifact',api_qualification)
def source_qualification():
 require(api is not None,'Actual API/source binding required')
 tree=json_bytes((control/'tree.json').read_bytes());blobs={row['path']:row for row in tree['tree'] if row['type']=='blob'}
 require(len(blobs)==sum(row['type']=='blob' for row in tree['tree']),'Unique actual Git blob paths')
 expected_rows=FIXED_SOURCE_ROWS;require(len(expected_rows)==70 and len({r['path'] for r in expected_rows})==70,'Exact67+3 source table')
 require(len([r for r in expected_rows if r['path'].startswith('products/rea-studio/apps/archive/')])==64,'Exact64 current Archive census')
 actual_archive=sorted(p for p in blobs if p.startswith('products/rea-studio/apps/archive/') and not any(x in ('results','node_modules','.local') for x in p.split('/')))
 require(actual_archive==sorted(r['path'] for r in expected_rows if r['path'].startswith('products/rea-studio/apps/archive/')),'Exact tracked Archive closure')
 for row in expected_rows:
  name=row['path'];data=read('source/'+safe(name)+'.snapshot');require(identity(data)=={k:row[k] for k in ('bytes','sha256')},'Fixed captured source '+name)
  require(name in blobs and blobs[name]['mode']=='100644' and blobs[name].get('size')==len(data),'Regular actual Git source '+name)
  require(hashlib.sha1(b'blob '+str(len(data)).encode()+b'\0'+data).hexdigest()==blobs[name]['sha'],'Captured actual Git blob '+name)
 before_raw=read('source-before.json');before=json_bytes(before_raw);after=json_bytes(read('source-after.json'))
 execution={'GITHUB_SHA':HEAD,'GITHUB_RUN_ID':RUN,'GITHUB_RUN_ATTEMPT':ATTEMPT,'GITHUB_JOB':JOB_NAME,'GITHUB_REPOSITORY':REPOSITORY,'RUNNER_ENVIRONMENT':'github-hosted','RUNNER_OS':'Windows','RUNNER_ARCH':'X64'}
 require(before['schema']=='rea-archive-native-diagnostic-source/v1' and before['status']=='verified-unexecuted','Source-before unexecuted schema')
 require(after['schema']=='rea-archive-native-diagnostic-postcheck/v1' and after['status']=='source-verified','Independent source-after schema')
 total=sum(row['bytes'] for row in expected_rows);require(total<=16*1024*1024,'Aggregate fixed source bound')
 for item in (before,after):
  require(item['execution']==execution and item['sourceCommit']==HEAD,'Exact same-attempt source proof')
  require(item['rows']==expected_rows and item['sourceFiles']==70 and item['sourceBytes']==total,'Exact70 source proof rows')
  require(item['allGitBlobsAuthenticated'] is True and item['sourceOverlay'] is False and item['productExecutions']==0 and item['originalExecutions']==0,'No source overlays or phase execution')
 require(after['beforeReceipt']==identity(before_raw) and after['sourceStable'] is True,'Separate postcheck binds exact before receipt')
 return {'sourceFiles':70,'fixedArchiveSources':64,'fixedHostSources':3,'toolingSources':3,'sourceBytes':total,'actualGitBlobsVerified':70,'sourceOverlay':False,'sourceStable':True}
sources=stage('exactCommittedSourceAndIndependentPostcheck',source_qualification)
def trace_qualification():
 require(sources is not None,'Authenticated committed source required for qualified observations')
 source_text=read('source/products/rea-studio/apps/archive/source-metadata.mjs.snapshot').decode().replace('\r\n','\n').replace('\r','\n')
 marker='export const WINDOWS_METADATA_SCRIPT = String.raw`';require(source_text.count(marker)==1,'Single original native script')
 start=source_text.index(marker)+len(marker);end=source_text.index('\n`;',start);script=source_text[start:end+1].encode('utf-16le');script_sha=sha(script)
 require(script_sha=='76e3ac8e0aeb8b1fa42fbc84ec6956e2e2d044502f5de5e5552e8538f5f4b615','Independent exact original UTF16 script pin')
 names=sorted(name for name in members if name.startswith('trace/'))
 require(len(names)<=8,'Bounded worker trace count');all_rows=[];pids=set();test_files=[];qualified=[]
 for name in names:
  match=re.fullmatch(r'trace/native-events-([1-9]\d*)\.jsonl',name);require(match is not None,'Exact worker trace path')
  raw_trace=read(name);require(len(raw_trace)<=128*1024 and raw_trace.endswith(b'\n'),'Bounded complete JSONL trace')
  rows=[json.loads(line) for line in raw_trace.decode().splitlines()];require(0<len(rows)<=64,'Bounded nonempty worker records')
  pid=int(match.group(1));require(pid not in pids,'Distinct worker PIDs');pids.add(pid);worker_test=None
  for index,row in enumerate(rows):
   require(set(row)=={'schema','runId','runAttempt','sourceCommit','processId','sequence','testFile','scriptSHA256','timeoutMs','maxBuffer','elapsedMs','childPid','callbackObserved','error','stdoutBytes','stderrBytes','inputRecorded','outputContentsRecorded','argumentsModified','limitsModified','retried'},'Exact non-content native observation fields')
   require(row['schema']=='rea-archive-native-exec-observation/v1' and row['runId']==RUN and row['runAttempt']==ATTEMPT and row['sourceCommit']==HEAD,'Same-attempt native observation')
   require(row['processId']==pid and row['sequence']==index+1,'Owned PID and consecutive worker call sequence')
   require(row['testFile'] in ('app.integration.test.mjs','app.test.mjs') and (worker_test is None or worker_test==row['testFile']),'Exact single original worker')
   worker_test=row['testFile'];require(row['scriptSHA256']==script_sha and row['timeoutMs']==15000 and row['maxBuffer']==64*1024*1024,'Exact original script and options')
   require(type(row['elapsedMs']) in (int,float) and math.isfinite(row['elapsedMs']) and 0<=row['elapsedMs']<=300000,'Bounded observed call duration')
   require(row['childPid'] is None or type(row['childPid']) is int and row['childPid']>0,'Observed child PID or failed-spawn null')
   require(row['callbackObserved'] is True and all(row[k] is False for k in ('inputRecorded','outputContentsRecorded','argumentsModified','limitsModified','retried')),'Transparent no-content observation')
   require(all(type(row[k]) is int and 0<=row[k]<=64*1024*1024 for k in ('stdoutBytes','stderrBytes')),'Bounded output byte observations')
   error=row['error']
   if error is not None:
    require(set(error)=={'name','code','killed','signal'} and isinstance(error['name'],str) and len(error['name'])<=128 and type(error['killed']) is bool,'Bounded sanitized error fields')
    require(error['code'] is None or type(error['code']) is int or isinstance(error['code'],str) and len(error['code'])<=128 and not re.search(r'[\x00-\x1f]',error['code']),'Sanitized error code')
    require(error['signal'] is None or isinstance(error['signal'],str) and re.fullmatch(r'[A-Z0-9_-]{1,64}',error['signal']),'Sanitized error signal')
  test_files.append(worker_test);all_rows.extend(rows);qualified.append({'path':name,**identity(raw_trace),'rows':rows})
 complete=len(names)==2 and sorted(test_files)==['app.integration.test.mjs','app.test.mjs']
 result['nativeObservationsQualified']=bool(all_rows);result['completeTwoWorkerObservations']=complete
 result['qualifiedNativeObservations']=qualified
 return {'traceFiles':len(names),'observedCalls':len(all_rows),'completeTwoOriginalWorkers':complete,'scriptSHA256':script_sha,'nativeErrorsObserved':sum(r['error'] is not None for r in all_rows),'observationsProveHistoricalD24Cause':False}
traces=stage('nativeObservationSourceAndSchema',trace_qualification)
def attempt_qualification():
 require(api is not None and sources is not None and traces is not None,'Actual APIs, sources, postcheck and native observations required')
 require(result['completeTwoWorkerObservations'],'Exactly two original workers required for complete diagnostic qualification')
 attempt=json_bytes(read('diagnostic-attempt.json'));workflow=json_bytes(read('workflow-attempt.json'))
 require(attempt['schema']=='rea-archive-native-metadata-diagnostic/v1' and attempt['status'] in ('passed-five-instrumented-checks','failed'),'Honest distinct diagnostic status')
 before=json_bytes(read('source-before.json'));require(attempt['execution']==before['execution'] and attempt['sourceCommit']==HEAD and attempt['sourceBefore']==identity(read('source-before.json')),'Exact attempt/source-before binding')
 start=iso(attempt['startedAtUtc']);end=iso(attempt['completedAtUtc']);require(start<=end,'Ordered diagnostic phase clocks')
 jobs=json_bytes((control/'jobs.json').read_bytes());job=jobs['jobs'][0]
 job_start=datetime.datetime.fromisoformat(job['started_at'].replace('Z','+00:00'));job_end=datetime.datetime.fromisoformat(job['completed_at'].replace('Z','+00:00'))
 require(job_start<=start<=end<=job_end,'Diagnostic clocks inside actual hosted job bounds')
 require(all(row['elapsedMs']<=(end-start).total_seconds()*1000+1 for item in result['qualifiedNativeObservations'] for row in item['rows']),'Observed calls inside diagnostic duration')
 require(attempt['stdout']==identity(read('stdout.txt')) and attempt['stderr']==identity(read('stderr.txt')),'Exact raw command streams')
 command=attempt['command'];require(command['deadlineMs']==300000 and command['inheritedNodeOptions'] is False and command['hook']=='scripts/archive-native-metadata-trace.mjs' and command['cwd']=='products/rea-studio','Unchanged diagnostic command boundaries')
 require(ntpath.isabs(command['executable']) and ntpath.basename(command['executable']).lower()=='node.exe','Actual Node command')
 args=command['args'];require(len(args)==5 and args[:3]==['--test','--test-concurrency=1','--test-reporter=tap'],'Exact test runner options')
 expected_suffixes=['products\\rea-studio\\apps\\archive\\app.integration.test.mjs','products\\rea-studio\\apps\\archive\\app.test.mjs']
 prefixes=[]
 for value,suffix in zip(args[3:],expected_suffixes):
  require(ntpath.isabs(value) and ntpath.normpath(value).endswith('\\'+suffix),'Exact unchanged selected original test path');prefixes.append(ntpath.normpath(value)[:-len(suffix)])
 require(prefixes[0]==prefixes[1],'Both tests use the same actual checkout')
 text=read('stdout.txt').decode('utf-8');summary={}
 for key in ('tests','pass','fail','cancelled','skipped','todo'):
  values=re.findall(r'^# '+key+r'\s+(\d+)\s*\r?$',text,re.M);require(len(values)==1,'Exactly one raw TAP '+key);summary[key]=int(values[0])
 require(summary==attempt['summary'] and summary['tests']==5 and summary['pass']+summary['fail']==5 and all(summary[k]==0 for k in ('cancelled','skipped','todo')),'Exact five unchanged TAP groups with no skips')
 names=re.findall(r'^# Subtest: (.+)\r?$',text,re.M);require([n.rstrip('\r') for n in names]==REQUIRED_TEST_NAMES,'All five original raw TAP names')
 result_lines=re.findall(r'^(not ok|ok) (\d+) - (.+)\r?$',text,re.M);require(len(result_lines)==5 and [int(row[1]) for row in result_lines]==list(range(1,6)) and [row[2].rstrip('\r') for row in result_lines]==REQUIRED_TEST_NAMES,'Five exact raw result rows')
 require(sum(row[0]=='ok' for row in result_lines)==summary['pass'] and sum(row[0]=='not ok' for row in result_lines)==summary['fail'],'Raw pass/fail rows match summary')
 require(len(attempt['traces'])==2 and len({row['path'] for row in attempt['traces']})==2 and {row['path']:row for row in attempt['traces']}=={row['path']:row for row in result['qualifiedNativeObservations']} and attempt['traceComplete'] is True,'Attempt binds both raw worker traces without rewriting; file enumeration order is immaterial')
 for field,value in {'applicationSourceChanged':False,'originalDeadlineMs':15000,'instrumentedDependencyObserver':True,'productAssertionsChanged':False,'retried':False,'historicalD24CauseProven':False,'fullSuiteAcceptance':False,'fullParity':False,'superiority':False}.items(): require(attempt[field]==value,'Exact diagnostic qualification '+field)
 require(workflow['schema']=='rea-archive-native-diagnostic-workflow/v1' and workflow['sourceCommit']==HEAD and workflow['runId']==RUN and workflow['runAttempt']==ATTEMPT,'Exact workflow attempt identity')
 require(workflow['checkout']=='success' and workflow['before']=='success' and workflow['after']=='success','Independent workflow source phases passed')
 require(workflow['applicationSourcesChanged'] is False and workflow['originalMetadataDeadlineMs']==15000 and workflow['diagnosticOnly'] is True and workflow['historicalD24CauseProven'] is False,'Workflow diagnostic-only scope')
 expected_members={'source/'+row['path']+'.snapshot' for row in FIXED_SOURCE_ROWS}|{'source-before.json','source-after.json','stdout.txt','stderr.txt','diagnostic-attempt.json','workflow-attempt.json'}|{row['path'] for row in result['qualifiedNativeObservations']}
 require(set(members)==expected_members and len(members)==78,'Complete exact70+8 diagnostic roles, no substituted or unbound roles')
 passed=summary['pass']==5 and summary['fail']==0 and attempt['exitCode']==0 and attempt['signal'] is None and attempt['error'] is None
 require((attempt['status']=='passed-five-instrumented-checks')==passed,'Honest recorded product outcome')
 require(workflow['execute']==('success' if passed else 'failure'),'Workflow execution outcome matches raw checks')
 accepted=passed and api['runConclusion']=='success' and api['jobConclusion']=='success'
 result['diagnosticFiveChecksAccepted']=accepted
 return {'status':attempt['status'],'summary':summary,'exitCode':attempt['exitCode'],'workflowExecute':workflow['execute'],'actualRunConclusion':api['runConclusion'],'actualJobConclusion':api['jobConclusion'],'fiveChecksAccepted':accepted,'nativeObservationsRemainSeparate':True}
stage('fiveChecksAndCompleteAttempt',attempt_qualification)
report=folder/'local-native-diagnostic-backup-verification.json'
with report.open('x',encoding='utf-8',newline='') as stream: stream.write(json.dumps(result,indent=2,ensure_ascii=False)+'\n')
require(json.loads(report.read_text(encoding='utf-8'))==result,'Readable final backup report')
print(json.dumps({key:value for key,value in result.items() if key not in ('files','qualifiedNativeObservations')},ensure_ascii=False))
