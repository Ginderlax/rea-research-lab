    {
      "id": "grafana.candidate.545d45e80bc7406b768a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Explore Metrics is a query-less experience for browsing Prometheus-compatible metrics. Search for or filter to find a metric. Quickly find related metrics - all in just a few clicks. You do not need to learn PromQL! With Explore Metrics, you can:",
      "headingPath": [
        "What’s new in Grafana v11.0",
