    {
      "id": "grafana.candidate.656e3144f42a52d908d1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Follow these best practices when using PostgreSQL for alerting:",
      "headingPath": [
        "PostgreSQL alerting",
        "Best practices"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/alerting/index.md",
