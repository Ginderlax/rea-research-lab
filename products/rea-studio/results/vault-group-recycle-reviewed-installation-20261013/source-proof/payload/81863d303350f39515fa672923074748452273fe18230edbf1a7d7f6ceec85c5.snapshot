import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import {spawn} from 'node:child_process';
import {importKdbx,materializeKdbxDocument} from './host/apps/vault/kdbx.mjs';
import {one,nodes,text} from './host/apps/vault/xml.mjs';

const activeHosts=new Map(),observations=[],own=import.meta.dirname,master='Root owned synthetic vault group master';
test.after(async()=>fs.writeFile(path.join(own,'observations.json'),JSON.stringify({scope:'Fresh synthetic HTTP cases through an exact materialization of the shared host and frozen777 vault backend; no browser or original executable.',observations},null,2)+'\n'));
async function directory(t){const dir=await fs.mkdtemp(path.join(os.tmpdir(),'rea-root-group-http-'));t.after(async()=>{for(const h of activeHosts.get(dir)??[])await h.close();assert.equal(path.dirname(dir),path.resolve(os.tmpdir()));assert(path.basename(dir).startsWith('rea-root-group-http-'));await fs.rm(dir,{recursive:true,force:true});observations.push({event:'owned-data-removed',directory:dir});});return dir;}
async function host(dir){
  const env={...process.env};delete env.NODE_TEST_CONTEXT;
  const child=spawn(process.execPath,[path.join(own,'host-runner.mjs'),dir],{env,windowsHide:true,stdio:['ignore','pipe','pipe','ipc']}),chunks={stdout:[],stderr:[]};let length=0,problem=null;
  const exit=new Promise((resolve,reject)=>{child.once('error',reject);child.once('exit',(code,signal)=>resolve({code,signal}));});
  const deadline=setTimeout(()=>{problem='Owned host 55-second deadline';child.kill();},55000);
  for(const name of Object.keys(chunks))child[name].on('data',b=>{length+=b.length;if(length>1024*1024){problem='Owned host log bound exceeded';child.kill();}else chunks[name].push(b);});
  const ready=await Promise.race([new Promise(resolve=>child.once('message',resolve)),exit.then(e=>{throw new Error('Host ended before readiness '+JSON.stringify(e));})]);
  observations.push({event:'host',pid:child.pid,url:ready.url});let closed=false;
  const value={...ready,async close(){if(closed)return;closed=true;child.send('close');const timeout=setTimeout(()=>{problem='Owned host cleanup deadline';child.kill();},5000);const ended=await exit;clearTimeout(timeout);clearTimeout(deadline);observations.push({event:'host-close',pid:child.pid,...ended,problem,stdout:Buffer.concat(chunks.stdout).toString(),stderr:Buffer.concat(chunks.stderr).toString()});assert.equal(problem,null);assert.equal(ended.code,0);},async api(action,input={},expected=200){const response=await fetch(ready.url+'/api/vault/'+action,{method:'POST',headers:{'content-type':'application/json','x-rea-token':ready.token},body:JSON.stringify(input),signal:AbortSignal.timeout(10000)}),result=await response.json();observations.push({event:'http',action,status:response.status});assert.equal(response.status,expected,action+' '+JSON.stringify(result));return expected===200?result.result:result;}};const owned=activeHosts.get(dir)??[];owned.push(value);activeHosts.set(dir,owned);return value;
}
async function group(h,name,bin=false){const value=(await h.api('recycleGroupList',{bin})).groups.find(g=>g.name===name);assert(value,'Missing '+name);return value;}
async function disk(dir){return fs.readFile(path.join(dir,'vault/records/vault.database.json'));}

test('real HTTP recursive group recycle/restore/purge preserves history across four fresh host starts',async t=>{
  const dir=await directory(t);let h=await host(dir);t.after(()=>h.close());await h.api('create',{password:master});
  const a=(await h.api('save',{title:'Owned α A',group:'Parent/Selected',password:'Owned earlier A',notes:'Owned private A notes'})).id;
  await h.api('save',{id:a,title:'Owned α A',group:'Parent/Selected',password:'Owned current A',notes:'Owned private A notes'});
  const b=(await h.api('save',{title:'Owned B',group:'Parent/Selected/Deep',password:'Owned current B'})).id,c=(await h.api('save',{title:'Owned C',group:'Other',password:'Owned current C'})).id;
  const selected=await group(h,'Selected'),deep=await group(h,'Deep');assert.equal(selected.groupCount,2);assert.equal(selected.entryCount,2);
  const preview=await h.api('recycleGroupRead',{id:selected.id,revision:selected.recycleRevision});assert.deepEqual(preview.group.entries.map(e=>e.id).sort(),[a,b].sort());for(const secret of ['Owned earlier A','Owned current A','Owned current B','Owned private A notes'])assert(!JSON.stringify(preview).includes(secret));
  const before=await disk(dir);await h.api('recycleGroupDelete',{id:selected.id,revision:selected.recycleRevision,confirm:false},400);await h.api('recycleGroupDelete',{id:selected.id,revision:'0'.repeat(64),confirm:true},400);const root=(await h.api('recycleGroupList')).groups.find(g=>g.parentId===null);assert(root);await h.api('recycleGroupDelete',{id:root.id,revision:root.recycleRevision,confirm:true},400);assert.deepEqual(await disk(dir),before);
  const recycled=await h.api('recycleGroupDelete',{id:selected.id,revision:selected.recycleRevision,confirm:true});assert.equal(recycled.recycled,true);assert.deepEqual(recycled.affectedEntryIds.sort(),[a,b].sort());assert.deepEqual((await h.api('list')).entries.map(e=>e.id),[c]);await h.api('read',{id:a},400);await h.api('historyList',{id:a},400);await h.close();
  h=await host(dir);assert.equal((await h.api('status')).locked,true);await h.api('recycleGroupList',{bin:true},400);await h.api('unlock',{password:master});const bin=await group(h,'Selected',true);assert.equal(bin.id,selected.id);assert.equal(bin.canRestorePreviousGroup,true);const restored=await h.api('recycleGroupRestore',{id:bin.id,revision:bin.recycleRevision,confirm:true});assert.equal(restored.restored,true);assert.equal((await h.api('read',{id:a})).entry.password,'Owned current A');assert.equal((await h.api('historyList',{id:a})).revisions.length,1);assert.deepEqual((await h.api('list')).entries.map(e=>e.id).sort(),[a,b,c].sort());await h.close();
  h=await host(dir);await h.api('unlock',{password:master});assert.equal((await h.api('historyList',{id:a})).revisions.length,1);const active=await group(h,'Selected'),purged=await h.api('recycleGroupDelete',{id:active.id,revision:active.recycleRevision,confirm:true,permanent:true});assert.equal(purged.permanent,true);assert.equal(purged.groupCount,2);assert.equal(purged.entryCount,2);const afterPurge=await disk(dir);await h.api('recycleGroupDelete',{id:active.id,revision:active.recycleRevision,confirm:true,permanent:true},400);assert.deepEqual(await disk(dir),afterPurge);await h.close();
  h=await host(dir);await h.api('unlock',{password:master});assert.deepEqual((await h.api('list')).entries.map(e=>e.id),[c]);assert.equal((await h.api('recycleList')).entries.length,0);assert(!(await h.api('recycleGroupList',{bin:true})).groups.some(g=>g.id===selected.id));
  const exported=await h.api('exportKdbx',{password:master,options:{kdf:'aes',rounds:100,version:'4.1'}}),native=await importKdbx(Buffer.from(exported.fileBase64,'base64'),{password:master}),xml=materializeKdbxDocument(native),tombstones=nodes(one(one(xml,'Root'),'DeletedObjects'),'DeletedObject').map(row=>Buffer.from(text(one(row,'UUID')),'base64').toString('hex'));
  assert.deepEqual(tombstones,[a,b,deep.id,selected.id].map(id=>id.replaceAll('-','')));assert.deepEqual(native.entries.map(e=>e.id),[c]);const encrypted=(await disk(dir)).toString();for(const secret of ['Owned earlier A','Owned current A','Owned current B','Owned current C','Owned private A notes',master])assert(!encrypted.includes(secret));observations.push({event:'assertions',hostStarts:4,historyPreserved:true,restoredUUIDs:[a,b],tombstoneOrder:tombstones,encryptedSecretsAbsent:true});
});

test('real shared host refuses tokenless group requests and keeps vault backend modules private',async t=>{
  const dir=await directory(t),h=await host(dir);t.after(()=>h.close());const denied=await fetch(h.url+'/api/vault/recycleGroupList',{method:'POST',headers:{'content-type':'application/json'},body:'{}'});await denied.arrayBuffer();assert.equal(denied.status,403);observations.push({event:'tokenless-http',status:denied.status});
  for(const url of ['/apps/vault/server.mjs','/apps/vault/recycle.mjs','/apps/vault/group-fixture.mjs','/apps/vault/group-oracle.ps1']){const response=await fetch(h.url+url);await response.arrayBuffer();assert.equal(response.status,404,url);observations.push({event:'private-route',url,status:response.status});}
});
