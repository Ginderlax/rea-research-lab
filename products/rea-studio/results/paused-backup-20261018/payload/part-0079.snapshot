    {
      "id": "grafana.candidate.a97fd89725925de8f3a9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Custom branding (previously referred to as whitelabeling) lets you customize parts of Grafana's UI. You can add links to the footer to your internal documentation, guides, or support, and you can update Grafana's sign-in page, logo, and other graphic elements to reflect your team or company identity.",
      "headingPath": [
        "What's new in Grafana v9.1",
        "Grafana Enterprise",
        "Sharing and customization",
        "(Beta) Configure custom branding in Grafana's UI"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-1.md",
