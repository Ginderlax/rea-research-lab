import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';
const own=path.dirname(fileURLToPath(import.meta.url)),old=path.resolve(own,'../keepass-history-independent-review'),stage=path.resolve(own,'../keepass-history-selection-fix-next'),sha=b=>createHash('sha256').update(b).digest('hex'),expected={receipt:'03ab5a44043d808181cee2f69ed6fc50fa839eb0c2e1c3ca18c1e90a08bbe055',manifest:'d6c09b4a6e4d45b3729ad8c8692b2352686e8e7e88e5ad791905fbb26b8b52de'};
const receiptBytes=await fs.readFile(path.join(stage,'selection-validation.final.json')),manifestBytes=await fs.readFile(path.join(stage,'selection-preservation-manifest.json'));if(sha(receiptBytes)!==expected.receipt||sha(manifestBytes)!==expected.manifest)throw new Error('Correction freeze identity mismatch.');const manifest=JSON.parse(manifestBytes);for(const row of manifest.files){const resolved=path.resolve(stage,row.path);if(!resolved.startsWith(stage+path.sep))throw new Error('Bad stage path.');const bytes=await fs.readFile(resolved);if(bytes.length!==row.bytes||sha(bytes)!==row.sha256)throw new Error('Correction stage mutated: '+row.path);}
const oldManifestBytes=await fs.readFile(path.join(old,'review-manifest.json')),oldManifest=JSON.parse(oldManifestBytes);if(sha(oldManifestBytes)!=='659a694609e032da24f51b625d9f6528b0d9a5c3e558c9bc0d9fe7a0cf6f35d1')throw new Error('Old review manifest changed.');for(const row of oldManifest.files)if(sha(await fs.readFile(path.join(old,row.path)))!==row.sha256)throw new Error('Old review artifact changed: '+row.path);
const adapters=[];for(const name of ['restore-selection.test.mjs','selection-boundaries.test.mjs','ui-fixture.mjs','run-selection-boundaries.mjs']){const source=await fs.readFile(path.join(old,name),'utf8'),adapted=name==='restore-selection.test.mjs'?source.replaceAll("../keepass-history-next/","../keepass-history-selection-fix-next/"):name==='ui-fixture.mjs'||name==='run-selection-boundaries.mjs'?source.replaceAll("../keepass-history-next","../keepass-history-selection-fix-next"):source;await fs.writeFile(path.join(own,name),adapted,{flag:'wx'});adapters.push({path:name,oldSha256:sha(source),adaptedSha256:sha(adapted),testBodyUnchanged:true,changes:name==='restore-selection.test.mjs'?'Two runtime import paths changed only':name==='ui-fixture.mjs'||name==='run-selection-boundaries.mjs'?'Default candidate directory changed only':'Exact unchanged source bytes'});}
const snapshotNames=['client.mjs','history.mjs','server.mjs','kdbx.mjs','xml.mjs','README.md','SELECTION-CORRECTION.md','selection-validation.final.json','selection-preservation-manifest.json','selection-freeze.json'];const candidate=[];for(const name of snapshotNames){const bytes=await fs.readFile(path.join(stage,name));await fs.mkdir(path.join(own,'candidate-baseline'),{recursive:true});await fs.writeFile(path.join(own,'candidate-baseline',name+'.snapshot'),bytes,{flag:'wx'});candidate.push({path:name,bytes:bytes.length,sha256:sha(bytes)});}await fs.writeFile(path.join(own,'baseline-validation.json'),JSON.stringify({schema:'rea-independent-keepass-selection-fixed-baseline/v1',createdAt:new Date().toISOString(),all546StageArtifactsAuthenticated:manifest.files.length===546,authorReceipt:expected.receipt,authorManifest:expected.manifest,originalIndependentReviewArtifactsUnchanged:oldManifest.files.length,candidate,adapters},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({authenticated:manifest.files.length,oldReviewUnchanged:oldManifest.files.length,client:candidate[0],adapters}));
