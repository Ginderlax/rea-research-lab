          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.aa20978e75b28ffb1c24",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This variable is the `$__rate_interval` variable in milliseconds, not a time-interval-formatted string. For example, if the `$__rate_interval` is `20m` then the `$__rate_interval_ms` is `1200000`.",
      "headingPath": [
        "Global variables",
        "`$__rate_interval_ms`"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/variables/global-variables.md",
