import fs from 'node:fs/promises';
import path from 'node:path';
import assert from 'node:assert/strict';
import {spawnSync} from 'node:child_process';
import {here,sha} from './authenticate-original.mjs';
const names=['check-harnesses.mjs','harness.test.mjs','memory-runner.mjs','memory-worker.mjs','timing-runner.mjs','benchmark.mjs','benchmark-worker.mjs','canonical.mjs','authenticate-original.mjs','watch-owned-process.ps1','parse-observer.ps1','memory-preflight.standard.json','memory-preflight.percentile.json','candidate-invariant-dispatch.mjs','candidate-percentile-isolated.mjs','candidate-baseline.mjs'],before={},steps=[];for(const name of names)before[name]=sha(await fs.readFile(path.join(here,name)));
const tasks=[{name:'harness-tests',args:['--test',path.join(here,'harness.test.mjs')],tests:5},...['standard','percentile'].flatMap(variant=>[{name:'memory-checks-'+variant,args:[path.join(here,'memory-runner.mjs'),'--check-only','unused',variant]},{name:'timing-readiness-'+variant,args:[path.join(here,'timing-runner.mjs'),'--check-only','unused',variant]}])];
for(const task of tasks){const startedAt=new Date().toISOString(),child=spawnSync(process.execPath,task.args,{encoding:'utf8',timeout:60000,maxBuffer:4*1024*1024,windowsHide:true}),stdout=child.stdout??'',stderr=child.stderr??'',stem='final-'+task.name+'-'+Date.now();await fs.writeFile(path.join(here,'results',stem+'.stdout.txt'),stdout);await fs.writeFile(path.join(here,'results',stem+'.stderr.txt'),stderr);steps.push({name:task.name,startedAt,completedAt:new Date().toISOString(),exitCode:child.status,signal:child.signal,error:child.error?.message,tests:task.tests,stdout:{path:'results/'+stem+'.stdout.txt',sha256:sha(stdout)},stderr:{path:'results/'+stem+'.stderr.txt',sha256:sha(stderr)}});console.log(JSON.stringify(steps.at(-1)));if(child.status!==0)break;}
const after={};for(const name of names)after[name]=sha(await fs.readFile(path.join(here,name)));assert.deepEqual(before,after);const receipt={schemaVersion:1,checkedAt:new Date().toISOString(),status:steps.length===tasks.length&&steps.every(step=>step.exitCode===0)?'passed':'failed',sourceHashesBefore:before,sourceHashesAfter:after,steps,timingMeasurementRun:false,memoryMeasurementRun:false,scope:'Guards/canonical serialization and fresh single-module fixture correctness only. No warmups, transient/retention workloads or memory snapshots/observer execution.',measurementBranchExecutionTested:false};await fs.writeFile(path.join(here,'results/final-harness-checks.json'),JSON.stringify(receipt,null,2)+'\n');if(receipt.status!=='passed')process.exitCode=1;
