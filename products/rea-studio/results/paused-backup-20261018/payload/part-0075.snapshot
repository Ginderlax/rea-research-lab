    },
    {
      "id": "grafana.candidate.a53208270d5288d681b6",
      "syntaxRole": "procedural-step",
      "sourceText": "1. When the forecast is expected to breach a threshold at any point in the future.",
      "headingPath": [
        "Alerting on forecasts",
        "Seasonal forecast with Grafana Cloud Machine Learning"
      ],
      "source": {
        "path": "docs/sources/alerting/guides/alerting-on-forecasts.md",
