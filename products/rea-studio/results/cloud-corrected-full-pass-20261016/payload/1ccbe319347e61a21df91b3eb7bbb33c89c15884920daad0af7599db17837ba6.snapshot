assert.equal(correction.schema,'rea-archive-aes-single-test-source-correction/v1');assert.equal(correction.currentTarget,'products/rea-studio/apps/archive/sevenzip-aes-bounds.test.mjs');assert.deepEqual(correction.after,{bytes:5255,sha256:'1bdeed45439ab2094c55973d0790866991ed3f81ab5eca505d01977dee84b303'});assert.equal(correction.historicalFiniteBoundsContentIsPredecessor,true);assert.equal(correction.freshFiniteIncludesCorrectedBoundsGroups,3);assert.equal(correction.targeted3OverlapFiniteSelection,true);
