          "oss",
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.adb407159bb9d7c8c382",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Because folderless sync doesn't create a wrapper folder, several folderless repositories can sync to the top level at the same time. Each repository manages only the resources it provisions:",
