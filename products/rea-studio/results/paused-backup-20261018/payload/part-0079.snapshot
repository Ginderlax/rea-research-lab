    {
      "id": "grafana.candidate.5f547d494cfaf1768e29",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Streaming is available for both the **Search** and **TraceQL** query types, and you'll get immediate visibility of incoming traces on the results table. This smooth integration makes data exploration a breeze and speeds up decision-making.",
      "headingPath": [
        "What’s new in Grafana v10.1",
        "Data sources",
        "TraceQL response streaming in Tempo"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-1.md",
        "gitBlobSha": "1cce8d3829f244debae74e6d7e86f19383fbe67b",
        "sha256": "40a1d463d9e4ed934cc589acc91dd3389003b006f1e2c5413c162996faf92d1a",
        "lineStart": 179,
        "lineEnd": 179,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-1.md#L179-L179"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.82ec6f822b35c924cc78",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The **Search** query type was replaced with a new editor powered by TraceQL. This new editor allows you to use the same query language for both Search and TraceQL queries. This change also brings a new UI that makes it easier to write queries and explore your data while using the powerful features offered by TraceQL.",
      "headingPath": [
        "What’s new in Grafana v10.1",
        "Data sources",
        "Tempo Search powered by TraceQL"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-1.md",
