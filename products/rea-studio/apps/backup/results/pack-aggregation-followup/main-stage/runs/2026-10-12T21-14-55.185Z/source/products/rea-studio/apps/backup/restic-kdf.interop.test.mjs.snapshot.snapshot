import test from 'node:test';
import assert from 'node:assert/strict';
import * as fs from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import { execFile } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import { promisify } from 'node:util';
import { createWorkspace } from '../../lib/storage.mjs';
import { handleNative } from './restic.mjs';
import { hash } from './restic-crypto.mjs';
const exec = promisify(execFile);
const artifact = fileURLToPath(new URL('../../../../projects/09-restic/artifacts/',import.meta.url));
const password = 'synthetic-new-writer-KDF-test-only';
for (const version of [1,2]) test(`calibrated writer v${version} key and snapshot open in the authenticated original`,async t => {
  const root = await fs.mkdtemp(path.join(os.tmpdir(),'rea-kdf-next-'));
  t.after(async() => { assert.equal(path.dirname(root),path.resolve(os.tmpdir())); assert.ok(path.basename(root).startsWith('rea-kdf-next-')); await fs.rm(root,{recursive:true,force:true}); });
  const executableBytes = await fs.readFile(path.join(artifact,'unpacked/restic_0.19.1_windows_amd64.exe'));
  assert.equal(hash(executableBytes),'b0dd1fd21eea5d8fe1325f55f7118213c21f36de8a261e04c0624a5ab9fd7830');
  assert.equal(hash(await fs.readFile(path.join(artifact,'restic_0.19.1_windows_amd64.zip'))),'da948ad707ed690426473aaba2046cd61f8f90f6f0e7dab6be0d5796531de67d');
  const executable = path.join(root,'original.exe'); await fs.writeFile(executable,executableBytes,{flag:'wx'});
  const workspace = await createWorkspace(path.join(root,'workspace'));
  const input = {repository:'native',password};
  const initialized = await handleNative({action:'nativeInit',input:{...input,version},workspace});
  assert.ok(initialized.passwordDerivation.p >= 13); assert.ok(initialized.passwordDerivation.p <= 32);
  assert.equal(initialized.passwordDerivation.N,32768); assert.equal(initialized.passwordDerivation.r,8);
  const keyNames = await fs.readdir(workspace.resolve('native/keys'));
  const keyDocument = JSON.parse(await fs.readFile(workspace.resolve(`native/keys/${keyNames[0]}`),'utf8'));
  assert.equal(keyDocument.p,initialized.passwordDerivation.p);
  assert.ok(!JSON.stringify(keyDocument).includes(password));
  await fs.mkdir(workspace.resolve('source')); const bytes = Buffer.from('Stronger-work native writer fixture — λ\n'); await fs.writeFile(workspace.resolve('source/hello.txt'),bytes);
  const captured = await handleNative({action:'nativeSnapshot',input:{...input,source:'source'},workspace});
  const options = {env:{...process.env,RESTIC_PASSWORD:password,RESTIC_REPOSITORY:'',RESTIC_PASSWORD_FILE:'',RESTIC_PASSWORD_COMMAND:''},timeout:60000,windowsHide:true};
  const original = (...args) => exec(executable,['--no-cache','-r',workspace.resolve('native'),...args],options);
  assert.match((await original('version')).stdout,/^restic 0\.19\.1 compiled with go1\.26\.4 on windows\/amd64/);
  await original('check','--read-data');
  const restored = path.join(root,'original-restored'); await original('restore',captured.id,'--target',restored);
  assert.deepEqual(await fs.readFile(path.join(restored,'source/hello.txt')),bytes);
  const candidate = await handleNative({action:'nativeCheck',input:{...input,id:captured.id},workspace}); assert.equal(candidate.verified,true);
  t.diagnostic(JSON.stringify(initialized.passwordDerivation));
});
