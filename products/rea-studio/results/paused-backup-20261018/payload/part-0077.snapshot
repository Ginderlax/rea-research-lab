    {
      "id": "grafana.candidate.cae96175354982036db6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set to `false` to disable AWS authentication from using an assumed role with temporary security credentials. For details about assume roles, refer to the AWS API reference documentation about the [AssumeRole](https://docs.aws.amazon.com/STS/latest/APIReference/API_AssumeRole.html) operation.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[aws]`",
        "`assume_role_enabled`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
