    {
      "id": "grafana.candidate.7fea7f8d1bbb109412a2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Variables in `text/template` must be created within the template. For example, you can create a variable with the current value of dot (`.`) and assign a string or another object to the variable like this:",
      "headingPath": [
        "If",
        "Variables"
      ],
      "source": {
        "path": "docs/sources/shared/alerts/template-language.md",
