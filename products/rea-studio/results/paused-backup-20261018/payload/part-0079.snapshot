        "sha256": "0e1c94c3c83b280306b5bf6a8543bb3a2707c17132691f3d48d3818f08b029c7",
        "lineStart": 89,
        "lineEnd": 89,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-3.md#L89-L89"
      },
      "applicability": {
