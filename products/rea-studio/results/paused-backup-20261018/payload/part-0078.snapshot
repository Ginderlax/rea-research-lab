        "lineStart": 31,
        "lineEnd": 31,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/shared/alerts/template-language.md#L31-L31"
      },
      "applicability": {
        "status": "unresolved-no-explicit-oss-products-label",
        "products": []
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
