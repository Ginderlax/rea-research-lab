    {
      "id": "grafana.candidate.99a7a1d47dc23fd35228",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "With team sync, you can easily add users to teams by utilizing their Google groups. To set up team sync for Google OAuth, refer to the following example.",
