].map(o=>({...o,expectedSelected:'needle',correctSelection:o.selected==='needle',evidence:'Actual Chrome CUA read-only textarea DOM read plus visible selection observer; manually transcribed exact returned fields.'}));for(const o of observations){assert.equal(o.value.slice(o.start,o.end),o.selected);assert.equal(o.correctSelection,false);}await save(browser+'/native-DOM-observations.json',json({schema:'rea-editor-native-textarea-selection-counterexamples/v1',ownedBrowser:'Chrome',browserId:'2',ownedTabId:'1647945755',ownedPort:50583,successfulBrowserCampaigns:1,observations,expectedDOMStarts:[8,27],syntheticOnly:true,candidateSourceStable:true,productionControlSourceStable:true,fullSharedStudioHost:false,gitStatusStubbed:true}));
await save(browser+'/browser-tool-attempts.json',json({schema:'rea-editor-pattern-owned-browser-tool-attempts/v1',attempts:[{browser:'iab',url:'http://127.0.0.1:50583/candidate',error:'Browser is not available: iab',tabCreated:false},{browser:'chrome',ownedTabId:'1647945755',opened:true,closeResolved:true}],driverFailure:{method:'write_stdin',session:85556,message:'write_stdin failed: stdin is closed for this session; rerun exec_command with tty=true to keep stdin open',applicationDefect:false},screenshot:{tool:'getScreenshot',candidateRegexFailure:true,conversationToolImageRetained:true,localScreenshotBytesPreserved:false},nativeSelectionServerWireLogs:{persisted:false,reason:'Bridge kept calls/captures in memory for graceful stop; exec stdin was unavailable and owned process required verified forced cleanup. DOM tool and visible observer records remain independent observed evidence.'}}));
const cleanup=JSON.parse((await fs.readFile(path.join(here,browser,'forced-cleanup.json'))).toString().replace(/^\ufeff/,''));assert.equal(cleanup.processExitObserved,true);assert.equal(cleanup.ownedTemporaryDirectoryRemoved,true);assert.equal(cleanup.browserTabCloseResolved,true);assert.equal(cleanup.user4311Touched,false);
const original='runs/original-2026-10-13T04-15-05-998Z',cases=JSON.parse(await fs.readFile(path.join(here,original,'cases-before.json'))),validation=JSON.parse(await fs.readFile(path.join(here,original,'validation.json'))),boundaries=[];for(const c of cases){const b=await fs.readFile(path.join(here,original,'original',c.id+'.stdout.txt'));let count=0;for(const line of b.toString().split('\n').filter(Boolean)){const j=JSON.parse(line);if(j.type!=='match')continue;const bytes=Buffer.from(c.content);for(const hit of j.data.submatches){for(const offset of[j.data.absolute_offset+hit.start,j.data.absolute_offset+hit.end]){new TextDecoder('utf-8',{fatal:true,ignoreBOM:true}).decode(bytes.subarray(0,offset));count++;}}}boundaries.push({case:c.id,decodedPrefixes:count,allValidUTF8ScalarByteBoundaries:true});}await save(original+'/prefix-UTF8-boundary-audit.json',json({sourceOnly:true,newOriginalCalls:0,allValid:true,boundaries}));assert.equal(validation.candidateGroups,8);assert.equal(validation.exactGroups,6);assert.deepEqual(validation.unequalGroups,['bare-CR-vs-CRLF-final-anchor','adjacent-empty-with-astral']);assert.equal(validation.originalEngineCommands,10);assert.equal(validation.error,null);
const fresh='runs/fresh-2026-10-13T04-10-26-540Z',freshValidation=JSON.parse(await fs.readFile(path.join(here,fresh,'validation.json')));assert.equal(freshValidation.accepted,true);assert.equal(freshValidation.summary.tests,16);assert.equal(freshValidation.summary.pass,16);
const finding={id:'EDITOR.SEARCH.TEXTAREA.CRLF.NAVIGATION',priority:'P2',confirmed:true,classification:'Pre-existing literal navigation issue retained in candidate and new regex path, confirmed against unchanged current production client.',source:oldSources.filter(r=>r.name.includes('client')||r.name.includes('search')||r.name.includes('server')),cause:'Client supplies saved-content absolute UTF-16 offsets to native textarea after the textarea value setter normalizes CRLF to LF. Every preceding collapsed CRLF shifts the visible position, including after preceding astral characters.',reproduction:{content:'😀 lead\r\nneedle here\r\nsecond needle\r\n',query:'needle',candidateLiteralSelection:['eedle ','edle\n'],candidateRegexSelection:'eedle ',productionLiteralSelection:['eedle ','edle\n'],expected:'needle'},sourceGraphUnchanged:true,correctionEpochPending:true,author573MustRemainFrozen:true};await save('finding.json',json(finding));
await save('review-validation.json',json({schema:'rea-editor-pattern-independent-review/v1',sourceStable:true,authorManifestSHA256:id(manifestBytes).sha256,authorPayloads:573,currentNamedCandidateSources:39,sourceCoreAcceptance:true,freshGroups:16,freshPass:16,freshFail:0,freshSkip:0,realCandidateCoreGroups:10,controlledExactSessionFaultGroups:2,DOMModelGroups:4,nativeBrowserSelectionChecks:5,nativeBrowserCorrectSelections:0,nativeBrowserConfirmedFailureFamilies:1,nativeBrowserAcceptance:false,finiteAcceptance:false,confirmedFindings:[finding.id],originalCohortGroups:8,originalExactGroups:6,originalExactPositions:validation.exactOriginalPositions,originalUnequalGroups:validation.unequalGroups,originalEngineCommands:10,originalVersionCommands:1,originalSearchCommands:9,originalErrorPresenceOnlyComparisons:1,originalExactErrorTextComparisons:0,originalSourceHelperCalls:0,originalConversionCalls:0,originalWorkBench:0,originalExtensionHost:0,originalGUI:0,ownedCandidateBrowserCampaigns:1,ownedBoundedHTTPBridges:1,sharedStudioHostUsed:false,gitStatusStubbed:true,nativeAPIServerWireLogsDurable:false,actualDOMToolRecordsRetained:true,localScreenshotPreserved:false,toolScreenshotInConversation:true,IABUnavailableAttempts:1,closedStdinDriverFailures:1,ownedHostForcedCleanup:true,ownedHostProcessExitObserved:true,ownedTabCloseResolved:true,ownedTempGone:true,benchmarkCommands:0,productionWrites:0,authorStageWrites:0,fullProductParity:false,securityEquivalence:false,superiority:false}));
await save('README.md',Buffer.from('Independent read-only review of exact573 work/editor-search-pattern-next. Source-only initial12 captured before freeze; own fresh16 groups passed with full573/39 and own source stability. Ten groups exercise real candidate core, two use exact candidate session source with explicitly substituted owned startup/error workers, four are DOM-model-only. Their pass is separate from actual browser acceptance.\n\nEight genuinely selected synthetic one-file engine groups execute authenticated shipped rg only as an independent oracle: six groups exact; bare-CR anchoring and adjacent-empty differences retained unequal and already documented. Ten engine commands comprise one version, eight selected searches and one malformed error-presence case; source-helper/conversion calls0, original workbench/extension-host/GUI0. Prefix UTF8 decoding is audited; exact error-text parity is not claimed. These are limited engine arguments, not complete original search-service acceptance.\n\nA real owned Chrome test confirms P2 CRLF navigation failure in both frozen candidate and unchanged production controls. Three candidate selections (two literal positions plus regex) and two production selections highlight eedle /edle\\n instead of needle after preceding CRLF and astral characters. Five observed selection failures form one pre-existing defect family. Actual client modules and list/read/search/save handlers run through a bounded owned loopback bridge; gitStatus is stubbed and sharedStudioHost=false. CUA native DOM reads and the visible selection observer provide the actual evidence. The model fixture did not normalize textarea.value, so16 model/core passes do not imply browser correctness.\n\nIAB creation was unavailable. Owned Chrome tab close resolved. A recorder control failure found exec stdin closed; only the verified owned Node50583 process was stopped, and its exact owned synthetic temporary directory was removed. Graceful bridge receipt and in-memory API/capture wire logs were not persisted. Actual DOM tool fields are transcribed with explicit origin; screenshot exists only in conversation tool output, no local screenshot byte identity is claimed. After external cleanup all source identities and573 inventory remain exact. These driver limits are separate from the confirmed application failure. Old573 and production were not edited. Correction must be a separate epoch. No user4311, accounts, benchmark/full-suite or original GUI activity. Finite acceptance=false until correction retest; full parity/security/superiority remain unproven.\n'));
const inventory={};let bytes=0;for(const p of await tree(here)){const b=await fs.readFile(path.join(here,p));inventory[p]=id(b);bytes+=b.length;}const freeze=json({schema:'rea-editor-pattern-independent-review-strict-freeze/v1',strict:true,selfExcluded:true,files:Object.keys(inventory).length,bytes,receiptSHA256:inventory['review-validation.json'].sha256,inventory});await save('review-manifest.json',freeze);process.stdout.write(JSON.stringify({files:Object.keys(inventory).length,receipt:inventory['review-validation.json'],manifest:id(freeze),finding:inventory['finding.json']})+'\n');
