    {
      "id": "grafana.candidate.9e2018efc025873a108c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Previously this was only possible when adding a new metric without selecting a field, because once selected, the field could not have been removed.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Grafana OSS features",
        "Data source updates",
        "Elasticsearch data source",
        "Allow omitting field for metrics that support inline scripts"
      ],
      "source": {
