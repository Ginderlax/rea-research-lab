    },
    {
      "id": "grafana.candidate.91fd5a37cc56be6bbf06",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Returns a list of all library elements the authenticated user has permission to view. Use the `perPage` query parameter to control the maximum number of library elements returned; the default limit is 100. You can also use the `page` query parameter to fetch library elements from any page other than the first one.",
      "headingPath": [
        "Library Element API",
        "Get all library elements"
      ],
