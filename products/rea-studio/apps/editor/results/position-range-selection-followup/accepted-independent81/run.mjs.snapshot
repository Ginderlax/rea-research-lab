import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{spawn}from'node:child_process';const here=import.meta.dirname,repo=path.resolve(here,'../../outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex');async function tree(d,p=''){const out=[];for(const e of await fs.readdir(d,{withFileTypes:true})){assert(!e.isSymbolicLink());if(e.isDirectory())out.push(...await tree(path.join(d,e.name),p+e.name+'/'));else out.push(p+e.name);}return out;}
export async function authenticate(){const scopes=[['editor-position-range-selection-fix-next','freeze-manifest.json','77ae818b4539341ab6f2f0126efaf8974117136f207747450d821df7c09baa1d',319],['editor-position-range-selection-next','freeze-manifest.json','8e423a7d82ea58c696f9bc3d91f6d3df460c51a2041cbcdcc87d2806c0997ee5',145],['editor-position-range-selection-independent-review','review-manifest.json','978bfd0fc13f4c148d980d7d1221edd2618e716adffd0831d16a08f522459a09',43]],records=[];for(const[d,n,pin,count]of scopes){const root=path.resolve(here,'..',d),mb=await fs.readFile(path.join(root,n));assert.equal(sha(mb),pin);const m=JSON.parse(mb),rows=Array.isArray(m.inventory)?m.inventory:Object.entries(m.inventory).map(([path,r])=>({path,...r}));assert.equal(rows.length,count);for(const r of rows){const b=await fs.readFile(path.join(root,r.path));assert.equal(b.length,r.bytes,r.path);assert.equal(sha(b),r.sha256,r.path);}assert.deepEqual((await tree(root)).sort(),[...rows.map(r=>r.path),n].sort());records.push({path:'work/'+d,files:rows.length,manifestSHA256:sha(mb)});}const current=JSON.parse(await fs.readFile(path.join(here,'current-before.json')));for(const r of current){const b=await fs.readFile(path.join(repo,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256,r.path);}return{at:new Date().toISOString(),scopes:records,current31:current,node:{path:process.execPath,version:process.version,sha256:sha(await fs.readFile(process.execPath))}};}
if(process.argv[1]===import.meta.filename){const directory=path.join(here,'runs',new Date().toISOString().replace(/:/g,'-'));await fs.mkdir(directory,{recursive:true});const before=await authenticate(),source=[];for(const p of['fresh.test.mjs','oracle.mjs','authority.mjs','run.mjs','prepare.mjs','prepare-strict-oracle.mjs']){const b=await fs.readFile(path.join(here,p));await fs.mkdir(path.join(directory,'source'),{recursive:true});await fs.writeFile(path.join(directory,'source',p+'.snapshot'),b,{flag:'wx'});source.push({path:p,bytes:b.length,sha256:sha(b)});}await fs.writeFile(path.join(directory,'before.json'),JSON.stringify({before,source},null,2)+'\n');const child=spawn(process.execPath,['--max-old-space-size=256','--test','--test-isolation=none','--test-reporter=tap','fresh.test.mjs'],{cwd:here,env:{...process.env,EDITOR_API_REVIEW_OUTPUT:directory},stdio:['ignore','pipe','pipe']}),stdout=[],stderr=[],bytes={stdout:0,stderr:0};let limit=null;for(const[k,stream,cap]of[['stdout',child.stdout,4*1024*1024],['stderr',child.stderr,2*1024*1024]])stream.on('data',b=>{bytes[k]+=b.length;(k==='stdout'?stdout:stderr).push(b);if(bytes[k]>cap){limit=k+' cap';child.kill();}});const timer=setTimeout(()=>{limit='60-second child deadline';child.kill();},60000),status=await new Promise((resolve,reject)=>{child.once('error',reject);child.once('close',(code,signal)=>resolve({code,signal}));});clearTimeout(timer);await fs.writeFile(path.join(directory,'stdout.txt'),Buffer.concat(stdout));await fs.writeFile(path.join(directory,'stderr.txt'),Buffer.concat(stderr));const after=await authenticate();for(const r of source)assert.equal(sha(await fs.readFile(path.join(here,r.path))),r.sha256);const record={schema:'rea-editor-api-fresh-independent-run/v1',before,after,source,status,limit,bytes,bounds:{oldSpaceMiB:256,childDeadlineMs:60000,stdoutMiB:4,stderrMiB:2,VMUnitDeadlineMs:1000,hardRSSWatchdog:false},sourceStable:true,originalGUI:0,benchmarks:0};await fs.writeFile(path.join(directory,'run.json'),JSON.stringify(record,null,2)+'\n');console.log(JSON.stringify({directory:path.relative(here,directory),status,limit,sourceStable:true}));process.exitCode=status.code??1;}
