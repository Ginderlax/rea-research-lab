import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
const root=path.join(import.meta.dirname,'editor-search-path-fix-next'),old=path.join(import.meta.dirname,'editor-search-fix-next'),sha=b=>createHash('sha256').update(b).digest('hex');
const focused=JSON.parse(await fs.readFile(path.join(root,'focused-validation.json'),'utf8'));assert.deepEqual(focused.counts,{tests:42,pass:42,fail:0,cancelled:0,skipped:0,todo:0});assert.equal(focused.sourceStable,true);
const before=JSON.parse(await fs.readFile(path.join(focused.run,'before.json'),'utf8'));for(const row of before){const b=await fs.readFile(path.join(root,row.path));assert.equal(sha(b),row.sha256);assert.equal(b.length,row.bytes);}
const originals=(await fs.readdir(path.join(root,'runs'))).filter(n=>n.startsWith('original-'));assert.equal(originals.length,1);const originalPath=`runs/${originals[0]}/validation.json`,original=JSON.parse(await fs.readFile(path.join(root,originalPath),'utf8'));assert.equal(original.failure,null);assert.equal(original.inputGroups,20);assert.equal(original.matchedPositionComparisons,465);assert.equal(original.boundedOriginalEngineInvocations,21);
const priorBytes=await fs.readFile(path.join(old,'freeze-manifest.json'));assert.equal(sha(priorBytes),'b858a4cf15312f962bf0ac5ba2fd6b6c17466248ff1394c727a49ee0e665e9ef');const prior=JSON.parse(priorBytes);for(const[name,row]of Object.entries(prior.inventory)){const b=await fs.readFile(path.join(old,name));assert.equal(b.length,row.bytes);assert.equal(sha(b),row.sha256);}
const changes=[];for(const row of before.filter(r=>r.path.startsWith('products/'))){const previous=prior.inventory[row.path];if(!previous||row.sha256!==previous.sha256)changes.push({path:row.path,beforeSHA256:previous?.sha256??null,afterSHA256:row.sha256});}
assert.deepEqual(changes.map(r=>r.path).sort(),['products/rea-studio/apps/editor/file-path.mjs','products/rea-studio/apps/editor/server.mjs','products/rea-studio/apps/editor/workspace-search-path.test.mjs','products/rea-studio/apps/editor/workspace-search.mjs'].sort());
await fs.writeFile(path.join(root,'freeze-collector.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});
const receipt={schema:'rea-editor-search-path-correction-freeze/v1',frozenAtUtc:new Date().toISOString(),status:'frozen correction awaiting independent review; unaccepted',priorStageReference:JSON.parse(await fs.readFile(path.join(root,'prior-stage-reference.json'),'utf8')),focusedReceipt:{path:'focused-validation.json',sha256:sha(await fs.readFile(path.join(root,'focused-validation.json'))),counts:focused.counts,sourceFiles:focused.sourceFiles},originalReceipt:{path:originalPath,sha256:sha(await fs.readFile(path.join(root,originalPath))),inputGroups:20,matchedPositionComparisons:465,boundedEngineInvocations:21,replayedCorpus:true,heldOut:false},changes,currentSources:before,confirmedPriorFinding:'The1096-character search result exceeded the read API1024-character contract.',correction:'Shared unchanged read/save path validation now governs search traversal. Rejected paths are skipped with an explicit incomplete-coverage reason.',candidateAccepted:false,candidateIntegrated:false,productionUnchanged:true,actualBrowserSessions:0,originalWorkBenchOrGUIExecutions:0,fullParity:false,universalSuperiority:false};
await fs.writeFile(path.join(root,'validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
const inventory={};async function walk(relative=''){for(const entry of(await fs.readdir(path.join(root,relative),{withFileTypes:true})).sort((a,b)=>a.name<b.name?-1:1)){const name=relative?`${relative}/${entry.name}`:entry.name;if(entry.isDirectory())await walk(name);else{assert.ok(entry.isFile());assert.notEqual(name,'freeze-manifest.json');const b=await fs.readFile(path.join(root,name));inventory[name]={bytes:b.length,sha256:sha(b)};}}}await walk();
const manifest={schema:'rea-editor-search-path-correction-preservation/v1',frozenAtUtc:new Date().toISOString(),files:Object.keys(inventory).length,aggregateBytes:Object.values(inventory).reduce((s,r)=>s+r.bytes,0),receiptSHA256:sha(await fs.readFile(path.join(root,'validation.json'))),inventory};const mb=Buffer.from(JSON.stringify(manifest,null,2)+'\n');await fs.writeFile(path.join(root,'freeze-manifest.json'),mb,{flag:'wx'});console.log(JSON.stringify({status:'FROZEN_UNACCEPTED',files:manifest.files,bytes:manifest.aggregateBytes,receiptSHA256:manifest.receiptSHA256,manifestSHA256:sha(mb)}));
