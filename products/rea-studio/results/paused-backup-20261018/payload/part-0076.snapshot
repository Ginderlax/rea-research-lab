    {
      "id": "grafana.candidate.5d7092b0daffa3c5e1dc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This default suits the regular expression match operator `=~`, but it can produce unexpected results when a custom or static value contains characters that Grafana escapes, or when you insert a value into a context that isn't a regular expression. To control the formatting, use a [format option](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/dashboards/variables/variable-syntax/#advanced-variable-format-options) in the variable syntax:",
      "headingPath": [
        "Loki template variables",
        "Format variable values"
      ],
      "source": {
