import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import{createHash}from'node:crypto';
const work=import.meta.dirname,own=path.join(work,'root-vault-group-edit-http-review-next'),prior=path.join(work,'root-vault-group-http-review-v2'),sha=b=>createHash('sha256').update(b).digest('hex');
await fs.mkdir(own,{recursive:false});const mb=await fs.readFile(path.join(prior,'manifest.json'));assert.equal(sha(mb),'066973a3d224e355cb3bb9e6fc854b7057540fb81ba797240015035e3a3512db');for(const r of JSON.parse(mb).inventory){const b=await fs.readFile(path.join(prior,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);}
const oldTest=(await fs.readFile(path.join(prior,'http.test.mjs'))).toString(),marker="test('real HTTP recursive group recycle/restore/purge preserves history across four fresh host starts'";assert.equal(oldTest.split(marker).length,2);let helper=oldTest.slice(0,oldTest.indexOf(marker)).replaceAll('rea-root-group-http-','rea-root-group-edit-http-').replace('frozen777 vault backend','frozen885 group editor backend');
const fresh=String.raw`
test('shared HTTP empty native group survives encrypted disk and KDBX export with literal name and notes',async t=>{
 const dir=await directory(t);let h=await host(dir);t.after(()=>h.close());await h.api('create',{password:master});const root=(await h.api('recycleGroupList')).groups.find(g=>g.parentId===null);assert(root);
 const name='  Empty / α 😀  ',notes='  line one\r\nline two 😀 & <xml>  '.replaceAll('\\r','\r').replaceAll('\\n','\n');const made=await h.api('groupCreate',{id:root.id,revision:root.recycleRevision,name,notes});assert.equal(made.created,true);assert.equal(made.parentId,root.id);assert.notEqual(made.id,root.id);const created=(await h.api('recycleGroupList')).groups.find(g=>g.id===made.id);assert(created);assert.equal(created.name,name);assert.equal(created.entryCount,0);assert.equal(created.groupCount,1);assert.equal((await h.api('recycleGroupRead',{id:created.id,revision:created.recycleRevision})).group.notes,notes);const encrypted=(await disk(dir)).toString();for(const secret of[name,notes,master])assert(!encrypted.includes(secret));await h.close();
 h=await host(dir);await h.api('unlock',{password:master});const reopened=(await h.api('recycleGroupList')).groups.find(g=>g.id===made.id);assert(reopened);assert.equal(reopened.name,name);assert.equal((await h.api('recycleGroupRead',{id:reopened.id,revision:reopened.recycleRevision})).group.notes,notes);assert.deepEqual((await h.api('list')).entries,[]);
 const exported=await h.api('exportKdbx',{password:master,options:{kdf:'aes',rounds:100,version:'4.1'}}),native=await importKdbx(Buffer.from(exported.fileBase64,'base64'),{password:master}),xml=materializeKdbxDocument(native),queue=[one(one(xml,'Root'),'Group')];let found;while(queue.length){const g=queue.shift();if(Buffer.from(text(one(g,'UUID')),'base64').toString('hex')===made.id.replaceAll('-',''))found=g;queue.push(...nodes(g,'Group'));}assert(found);assert.equal(text(one(found,'Name')),name);assert.equal(text(one(found,'Notes')),notes);assert.equal(text(one(found,'IconID')),'48');assert.equal(text(one(found,'EnableSearching')),'null');assert.equal(native.entries.length,0);observations.push({event:'empty-group-native-roundtrip',uuid:made.id,nameAndNotesExact:true,encryptedSecretsAbsent:true,actualKDBXImport:true,originalProgram:false});
});

test('shared HTTP rename changes descendant paths while preserving native entry identity and history',async t=>{
 const dir=await directory(t),h=await host(dir);t.after(()=>h.close());await h.api('create',{password:master});const entry=(await h.api('save',{title:'History entry',group:'Original/Child',password:'Synthetic older'})).id;await h.api('save',{id:entry,title:'History entry',group:'Original/Child',password:'Synthetic newer'});const parent=await group(h,'Original'),child=await group(h,'Child');const beforeHistory=(await h.api('historyList',{id:entry})).revisions;assert.equal(beforeHistory.length,1);const saved=await h.api('groupSave',{id:parent.id,revision:parent.recycleRevision,name:'Renamed / Parent',notes:'Group notes 🦉'});assert.equal(saved.saved,true);assert.equal(saved.id,parent.id);const renamed=(await h.api('recycleGroupList')).groups.find(g=>g.id===parent.id);assert.equal(renamed.name,'Renamed / Parent');const stillChild=(await h.api('recycleGroupList')).groups.find(g=>g.id===child.id);assert.equal(stillChild.parentId,parent.id);const got=(await h.api('read',{id:entry})).entry;assert.equal(got.id,entry);assert.equal(got.password,'Synthetic newer');assert(got.group.includes('Renamed / Parent'));assert.deepEqual((await h.api('historyList',{id:entry})).revisions,beforeHistory);const root=(await h.api('recycleGroupList')).groups.find(g=>g.parentId===null);const rootSaved=await h.api('groupSave',{id:root.id,revision:root.recycleRevision,name:'Edited root',notes:'Root note'});assert.equal(rootSaved.saved,true);assert.equal((await h.api('recycleGroupList')).groups.find(g=>g.id===root.id).name,'Edited root');const preview=await h.api('recycleGroupRead',{id:renamed.id,revision:(await h.api('recycleGroupList')).groups.find(g=>g.id===renamed.id).recycleRevision});assert(!JSON.stringify(preview).includes('Synthetic newer'));observations.push({event:'rename-descendants-history',nativeEntryIdentityRetained:true,historySnapshotExact:true,rootEditAccepted:true,groupPreviewExcludesEntryPassword:true});
});

test('shared HTTP stale, unsupported and recycled-group detail writes leave durable encrypted bytes unchanged',async t=>{
 const dir=await directory(t),h=await host(dir);t.after(()=>h.close());await h.api('create',{password:master});const root=(await h.api('recycleGroupList')).groups.find(g=>g.parentId===null);const first=await h.api('groupCreate',{id:root.id,revision:root.recycleRevision,name:'First',notes:''});const unchanged=await disk(dir);await h.api('groupCreate',{id:root.id,revision:root.recycleRevision,name:'Stale sibling',notes:''},400);assert.deepEqual(await disk(dir),unchanged);let selected=(await h.api('recycleGroupList')).groups.find(g=>g.id===first.id);for(const input of[{id:selected.id,revision:selected.recycleRevision,name:'Changed',notes:'',icon:1},{id:selected.id,revision:selected.recycleRevision,name:'Too long',notes:'x'.repeat(100001)},{id:selected.id,revision:selected.recycleRevision,name:'bad\u0000name'.replace('\\u0000','\u0000'),notes:''}]){await h.api('groupSave',input,400);assert.deepEqual(await disk(dir),unchanged);}await h.api('recycleGroupDelete',{id:selected.id,revision:selected.recycleRevision,confirm:true});selected=(await h.api('recycleGroupList',{bin:true})).groups.find(g=>g.id===first.id);const afterRecycle=await disk(dir);await h.api('groupSave',{id:selected.id,revision:selected.recycleRevision,name:'Bin rename',notes:''},400);await h.api('groupCreate',{id:selected.id,revision:selected.recycleRevision,name:'Bin child',notes:''},400);assert.deepEqual(await disk(dir),afterRecycle);const denied=await fetch(h.url+'/api/vault/groupSave',{method:'POST',headers:{'content-type':'application/json'},body:'{}'});await denied.arrayBuffer();assert.equal(denied.status,403);assert.deepEqual(await disk(dir),afterRecycle);observations.push({event:'refusal-unchanged-disk',staleMAC:true,unknownSetting:true,oversizedNotes:true,XMLInvalidName:true,recycledEditAndCreate:true,tokenless403:true});
});
`;
await fs.writeFile(path.join(own,'http.test.mjs'),helper+fresh,{flag:'wx'});await fs.copyFile(path.join(prior,'host-runner.mjs'),path.join(own,'host-runner.mjs'));const oldRun=(await fs.readFile(path.join(prior,'run.mjs'))).toString();let run=oldRun;const replacements=[['work/keepass-group-recycle-next','work/vault-group-edit-next'],['048fc56fded29bb89cf43830919c4b717a82d055e531644028b85ef07917e28d','52a88d027dc910c3ef8723e80690aef98dacdc9c98d43902192663ca43799ff4'],['rea-keepass-group-strict-preservation/v1','rea-vault-group-edit-strict-preservation/v1'],['m.inventory.length,777','m.inventory.length,885'],["'frozen777'","'frozen885'"],['rea-root-vault-group-http-review/v1','rea-root-vault-group-edit-http-review/v1'],['counts.tests,2','counts.tests,3'],['counts.pass,2','counts.pass,3']];for(const[a,b]of replacements){assert(run.includes(a),a);run=run.replaceAll(a,b);}await fs.writeFile(path.join(own,'run.mjs'),run,{flag:'wx'});await fs.mkdir(path.join(own,'before'),{recursive:false});await fs.writeFile(path.join(own,'before/http.test.mjs.snapshot'),oldTest,{flag:'wx'});await fs.writeFile(path.join(own,'before/run.mjs.snapshot'),oldRun,{flag:'wx'});await fs.writeFile(path.join(own,'preparation.json'),JSON.stringify({scope:'Three new shared-host HTTP case bodies; exact prior owned harness before-image and explicit scope/path/count adapters. No browser/original execution.',priorManifestSHA256:sha(mb),helperPrefixBytes:Buffer.byteLength(helper),runnerReplacements:replacements,productionWrites:0},null,2)+'\n',{flag:'wx'});await fs.copyFile(import.meta.filename,path.join(own,'preparation-collector.mjs.snapshot'));console.log(JSON.stringify({own,preparedCases:3,productionWrites:0}));
