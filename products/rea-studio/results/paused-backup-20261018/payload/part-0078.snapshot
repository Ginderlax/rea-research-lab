    {
      "id": "grafana.candidate.2f15fd63677412f94d92",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In most cases, yes. Building effective dashboards requires understanding how to query your data source so you can retrieve the information you want to visualize. Grafana provides visualization and editing tools, but the query syntax depends on the data source you're using.",
      "headingPath": [
        "Create dashboards",
        "Frequently asked questions"
      ],
