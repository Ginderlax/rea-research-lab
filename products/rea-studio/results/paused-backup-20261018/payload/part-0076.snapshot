    {
      "id": "grafana.candidate.a0dcecd72b841d73d39b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can define and configure the data source in YAML files as part of the Grafana provisioning system. For more information about provisioning, and for available configuration options, refer to [Provision Grafana](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/administration/provisioning/).",
      "headingPath": [
        "Configure the Microsoft SQL Server data source",
        "Configure the data source in the UI",
        "Provision the data source"
      ],
      "source": {
