    {
      "id": "grafana.candidate.5c4ba56aec6061d2b732",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "After you add an annotation, they are still visible. This is due to the built-in annotation query that exists on all dashboards. This annotation query fetches all annotation events that originate from the current dashboard, which are stored in Grafana, and show them on the panel where they were created. This includes alert state history annotations.",
      "headingPath": [
        "Annotate visualizations",
        "Built-in query"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/build-dashboards/annotate-visualizations/index.md",
        "gitBlobSha": "cb65749cc65b459f6446f1e69dca5f37680bfc36",
