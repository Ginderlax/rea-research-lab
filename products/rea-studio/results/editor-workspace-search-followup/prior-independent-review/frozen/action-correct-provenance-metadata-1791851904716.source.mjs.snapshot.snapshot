import fs from 'node:fs/promises';import {createReadStream} from 'node:fs';import path from 'node:path';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const here=import.meta.dirname,sha=bytes=>createHash('sha256').update(bytes).digest('hex'),bytes=await fs.readFile(path.join(here,'provenance-validation.json')),prior=JSON.parse(bytes);await fs.writeFile(path.join(here,'provenance-validation.first.json.snapshot'),bytes,{flag:'wx'});const acquisition=JSON.parse(await fs.readFile(path.join(here,'preserved/provenance/acquisition.json.snapshot.snapshot'))),publisher=JSON.parse(await fs.readFile(path.join(here,'preserved/provenance/microsoft-update-metadata.json.snapshot.snapshot'))),relative=prior.engine.path;assert.ok(!path.isAbsolute(relative)&&!relative.split(/[\\/]/).includes('..'));const absolute=path.join(path.dirname(acquisition.archive),'unpacked',relative),engineBytes=await fs.readFile(absolute);assert.equal(sha(engineBytes),prior.engine.sha256);const hash=createHash('sha1');for await(const part of createReadStream(acquisition.archive))hash.update(part);const sha1=hash.digest('hex');assert.equal(sha1,publisher.hash);assert.equal(sha1,acquisition.sha1);prior.metadataCorrection={priorExactReceiptSHA256:sha(bytes),reason:'Object spread carried the authenticated ledger relative path over the intended absolute path; identity bytes were already authenticated. Original failed collector preparation used this relative path as cwd-relative. No original engine child ran in that failed preparation.'};prior.engine={...prior.engine,path:absolute,relativePath:relative};prior.archiveSHA1NowAuthenticated=sha1;prior.fullExtractedTreeFreshAuthenticationPasses=1;prior.all3246FreshBeforeAfterPasses=false;prior.checkedAt=new Date().toISOString();await fs.writeFile(path.join(here,'provenance-validation.corrected.json'),JSON.stringify(prior,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:'corrected metadata; old receipt exact retained',sha256:sha(await fs.readFile(path.join(here,'provenance-validation.corrected.json'))),freshArchiveSHA1:sha1,engine:absolute}));
