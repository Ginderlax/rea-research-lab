    },
    {
      "id": "grafana.candidate.df66c3590ba081c52489",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To try it out, enable the ‘traceToProfiles’ feature toggle. To enable it in your Grafana Cloud stack, contact Grafana Support.",
      "headingPath": [
        "What’s new in Grafana v10.3",
        "Profiles",
        "FlameGraph: Collapsing similar items in the graph\\*"
      ],
      "source": {
