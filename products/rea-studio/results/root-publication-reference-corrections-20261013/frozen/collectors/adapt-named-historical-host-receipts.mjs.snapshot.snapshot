import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
const base=path.resolve(import.meta.dirname,'..'),lab=path.join(base,'outputs/rea-research-lab'),owned=path.join(base,'work/root-named-historical-host-transition-next'),target=path.join(lab,'scripts/verify-records.mjs');
const sha=b=>createHash('sha256').update(b).digest('hex');
fs.mkdirSync(owned,{recursive:true});
const before=fs.readFileSync(target);assert.equal(sha(before),'4bf3eed7cc7829005d24179f402dab7152bea989a2fc5d9b841ef9eed0a728e6');
fs.writeFileSync(path.join(owned,'verify-records.before.mjs.snapshot'),before,{flag:'wx'});
for(const n of ['stdout','stderr'])fs.copyFileSync(path.join(base,`work/notes-layout-value-api-records.${n}.txt`),path.join(owned,`failed-publication-check.${n}.txt`),fs.constants.COPYFILE_EXCL);
const changes=[
 ["function backup64SourceFingerprint(entry){if(entry.path!=='products/rea-studio/server.mjs')return currentPublicFingerprint(entry,'Current64 aggregate Backup source');", "function namedHistoricalHostFingerprint(entry,label){if(entry.path!=='products/rea-studio/server.mjs')return currentPublicFingerprint(entry,label);"],
 ["assert.equal(entry.bytes,7741);assert.equal(entry.sha256,'807a", "if(entry.bytes!==undefined)assert.equal(entry.bytes,7741);assert.equal(entry.sha256,'807a"],
 ["assert.deepEqual(transition.before,{bytes:entry.bytes,sha256:entry.sha256});", "assert.deepEqual(transition.before,{bytes:7741,sha256:entry.sha256});"],
 ["assert.equal(r.bytes,entry.bytes);assert.equal(r.sha256,entry.sha256);const old=readFileSync(join(root,r.snapshotPath));assert.equal(old.length,entry.bytes);", "assert.equal(r.bytes,7741);assert.equal(r.sha256,entry.sha256);const old=readFileSync(join(root,r.snapshotPath));assert.equal(old.length,7741);"],
 ["backup64SourceFingerprint({...e,path:'products/rea-studio/'+e.path});", "namedHistoricalHostFingerprint({...e,path:'products/rea-studio/'+e.path},'Backup64 nonhost current source');"],
 ["currentPublicFingerprint(e,'Current recovery browser source');", "namedHistoricalHostFingerprint(e,'Automation recovery browser nonhost current source');"],
 ["currentFingerprint({path:relative(root,target).replaceAll('\\\\','/'),sha256}, 'WebDAV host');", "namedHistoricalHostFingerprint({path:relative(root,target).replaceAll('\\\\','/'),sha256}, 'WebDAV nonhost current source');"],
 ["for(const e of [...automationRecovery.implementationFingerprints,...automationRecovery.artifacts])currentFingerprint({...e,path:'products/rea-studio/'+e.path},'Current Automation recovery evidence');", "for(const e of automationRecovery.implementationFingerprints)namedHistoricalHostFingerprint({...e,path:'products/rea-studio/'+e.path},'Automation recovery nonhost current source');for(const e of automationRecovery.artifacts)currentFingerprint({...e,path:'products/rea-studio/'+e.path},'Current Automation recovery artifact');"],
 ["  followup_evidence: followupEvidence,", "  followup_evidence: followupEvidence,\n  named_historical_shared_host_receipts: { backup64: { current_nonhost_rows:41, historical_host_rows:1 }, automation_recovery_browser: { current_nonhost_rows:40, historical_host_rows:1 }, automation_recovery: { current_nonhost_rows:42, historical_host_rows:1 }, webdav_host_dependencies: { current_nonhost_rows:2, historical_host_rows:1 }, historical_host_sha256:'807a473ec0334f60dfd58f2df8901c722f1bd4eb1d64c62d9ba1ea65c2b6b55f', current_host_sha256:'85fe09b1b52a1d91e9d09c85d99c6e768ac4b793f5d7694a1760a4c0560a0a94', prior_receipts_rebound:false, original_behavior_rerun:false, current_host_still_required:true },"],
];
let source=before.toString();for(const[a,b]of changes){assert.equal(source.split(a).length,2,`Expected exactly one transform: ${a}`);source=source.replace(a,b);}
let inverse=source;for(const[a,b]of [...changes].reverse()){assert.equal(inverse.split(b).length,2);inverse=inverse.replace(b,a);}assert.ok(Buffer.from(inverse).equals(before));
const after=Buffer.from(source);fs.writeFileSync(target,after);fs.writeFileSync(path.join(owned,'verify-records.after.mjs.snapshot'),after,{flag:'wx'});
const record={schema:'rea-named-historical-host-transition/v1',at:new Date().toISOString(),before:{bytes:before.length,sha256:sha(before)},after:{bytes:after.length,sha256:sha(after)},changes:changes.map(([before,after])=>({before,after})),inverseExact:true,namedReceipts:['backup64','automation-recovery-browser','automation-recovery','webdav-host-dependencies'],oldHostRowsPerReceipt:1,allOtherRowsStrictCurrent:true,exactOld3baAndNew99ByteHostTransitionRequired:true,originalReceiptsRebound:false,appWrites:0,behaviorTestsRerun:0};
fs.writeFileSync(path.join(owned,'transformation.json'),JSON.stringify(record,null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({after:record.after,changes:changes.length,namedReceipts:record.namedReceipts,appWrites:0}));
