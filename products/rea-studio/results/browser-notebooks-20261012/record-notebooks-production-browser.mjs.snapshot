import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import {createHash} from 'node:crypto';
const work=import.meta.dirname,studio=path.resolve(work,'../outputs/rea-research-lab/products/rea-studio'),owned=path.join(work,'notes-notebooks-production-browser'),destination=path.join(studio,'results/browser-notebooks-20261012'),sha=b=>createHash('sha256').update(b).digest('hex'),before=JSON.parse(await fs.readFile(path.join(owned,'source-before.json')));assert.equal(before.length,19);const after=[];for(const e of before){const b=await fs.readFile(path.join(studio,e.path));after.push({path:e.path,bytes:b.length,sha256:sha(b)});}assert.deepEqual(after,before);
const stateBytes=await fs.readFile(path.join(owned,'synthetic-data/notes/records/notes-state-v2.json')),state=JSON.parse(stateBytes),note=Object.values(state.notes)[0],parentID='9ebfe19c833d647e61cda6944096b79b',childID='e08a1c0cc03d599ad94c0d8b6d8ba305';assert.equal(Object.keys(state.notes).length,1);assert.equal(Object.keys(state.records).length,2);assert.equal(state.records[parentID].title,'Renamed parent');assert.equal(state.records[childID].title,'Child research notebook');for(const folder of Object.values(state.records))assert.equal(folder.props.parent_id,'');assert.equal(note.id,'884f9362-7d9f-4c29-849f-02ececdea7c0');assert.equal(note.notebookId,parentID);assert.equal(note.revision,4);assert.equal(note.history.length,3);assert.equal(note.body,'Uncommitted browser draft stays visible.');assert.equal(note.history[0].notebookId,childID);assert.equal(note.history[1].notebook,'Root lab notebook / Child research notebook');assert.equal(note.history[2].notebook,'Renamed parent / Child research notebook');assert.equal(state.organization.revision,5);
const ax=await fs.readFile(path.join(owned,'final-browser-state.full.txt'),'utf8');for(const value of ['Child research notebook (0 notes)','Renamed parent (1 notes)','Opened revision 4.','Restore revision 3','Uncommitted browser draft stays visible.'])assert.ok(ax.includes(value));const jpeg=await fs.readFile(path.join(owned,'final-notes.jpg'));assert.equal(jpeg[0],255);assert.equal(jpeg[1],216);
await fs.mkdir(destination,{recursive:true});const snapshots=[];async function save(name,b){const p=path.join(destination,name);await fs.mkdir(path.dirname(p),{recursive:true});await fs.writeFile(p,b,{flag:'wx'});snapshots.push({path:name,bytes:b.length,sha256:sha(b)});}
for(const e of before)await save('source/'+e.path+'.snapshot',await fs.readFile(path.join(studio,e.path)));await save('source-before.json',Buffer.from(JSON.stringify(before,null,2)+'\n'));await save('source-after.json',Buffer.from(JSON.stringify(after,null,2)+'\n'));for(const name of ['final-browser-state.txt','final-browser-state.full.txt','final-notes.jpg','host.json'])await save(name,await fs.readFile(path.join(owned,name)));await save('synthetic-notes-state.json',stateBytes);await save('record-notebooks-production-browser.mjs.snapshot',await fs.readFile(import.meta.filename));
const checks=['Create an identified root notebook','Create an identified nested child notebook','Save a note in the child','Refuse organization change while preserving an unsaved note draft','Save that retained draft','Rename parent while retaining note/folder IDs and saved history','Reject moving a notebook below its own descendant','Move the saved note to the parent','Reparent the empty child to top level with stable ID','Filter child and parent by identity and observe0/1 notes','Reload and reopen exact saved revision4, content and three historical versions'].map(name=>({name,passed:true,method:'Human-agent observed actual browser UI; final saved state asserted separately.'}));
const receipt={schema:'rea-notebook-production-browser-validation/v1',checkedAtUtc:new Date().toISOString(),summary:{checks:11,passed:11,failed:0},checks,sourceFingerprints:before,sourceBytesStable:true,host:(await fs.readFile(path.join(owned,'host.json'),'utf8')&&JSON.parse(await fs.readFile(path.join(owned,'host.json'),'utf8'))),actualBrowser:true,syntheticOnly:true,hostRestartPerformed:false,browserReloadPerformed:true,finalStateAssertionsPassed:true,finalScreenshotVisuallyInspected:true,intermediateUIStatesRetainedAsLocalFiles:false,intermediateUIEvidence:'Tool-observed operations in the current chat; final diff/full accessibility state and screenshot are preserved locally.',fullProductParity:false,comparativeUsabilityStudyPerformed:false,universalSuperiority:false};const receiptBytes=Buffer.from(JSON.stringify(receipt,null,2)+'\n');await save('validation.json',receiptBytes);const manifestBytes=Buffer.from(JSON.stringify({schema:'rea-notebook-browser-preservation/v1',snapshots,receiptSHA256:sha(receiptBytes),sourceStable:true,syntheticOnly:true,fullProductParity:false,universalSuperiority:false},null,2)+'\n');await fs.writeFile(path.join(destination,'preservation-manifest.json'),manifestBytes,{flag:'wx'});console.log(JSON.stringify({checks:11,sourceFiles:19,snapshots:snapshots.length,manifestSHA256:sha(manifestBytes),receiptSHA256:sha(receiptBytes),actualBrowser:true,hostRestartPerformed:false}));
