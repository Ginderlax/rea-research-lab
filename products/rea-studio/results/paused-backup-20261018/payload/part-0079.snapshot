    {
      "id": "grafana.candidate.47ececad851562d19ca5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A new layout option is available when rendering reports: the grid layout. With this option, your report uses the panel layout from your dashboard, so that what you see is what you get. Learn more about the [grid layout](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/visualizations/dashboards/create-reports/#5-attachments) in the documentation.",
      "headingPath": [
        "What's new in Grafana v7.2",
        "Grafana Enterprise features",
        "Report and export dashboards in grid layout"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-2.md",
        "gitBlobSha": "b14fe6b9f0ce989975bd191eded6a4b1402c46e6",
