const root=path.dirname(fileURLToPath(import.meta.url)),hash=bytes=>createHash('sha256').update(bytes).digest('hex'),main=path.resolve(root,'../restic-pack-aggregation-next'),relative=process.argv[2];
if(!relative||!/^runs\/adapted-[^/]+$/.test(relative))throw new Error('Provide the exact completed full adapted run path.');
const read=async name=>JSON.parse(await fs.readFile(path.join(root,name))),run=await read(relative+'/validation.json'),baseline=await read('baseline.json');
if(run.exitCode!==0||run.counts.tests!==33||run.counts.pass!==33||run.counts.fail||run.counts.skipped||!run.sourceStable||!run.originalSourceStable)throw new Error('Require a stable complete 33/33 adapted run.');
for(const row of run.sourceFingerprints){const bytes=await fs.readFile(path.join(root,row.path));if(bytes.length!==row.bytes||hash(bytes)!==row.sha256)throw new Error('Executed source changed: '+row.path);}
for(const row of baseline.sources){const bytes=await fs.readFile(row.source);if(bytes.length!==row.bytes||hash(bytes)!==row.sha256)throw new Error('Copied source origin changed since final run: '+row.path);}
const mainReceipt=await fs.readFile(path.join(main,'stage-validation.json')),mainManifestBytes=await fs.readFile(path.join(main,'freeze-manifest.json')),mainManifest=JSON.parse(mainManifestBytes);
if(hash(mainReceipt)!==baseline.frozenStageReceiptSha256||hash(mainManifestBytes)!==baseline.frozenStageManifestSha256)throw new Error('Main frozen receipt/manifest changed.');
const entries=mainManifest.entries??mainManifest.files;if(!Array.isArray(entries)||entries.length!==250)throw new Error('Expected main 250-entry preservation manifest.');
for(const row of entries){const bytes=await fs.readFile(path.join(main,row.path));if(bytes.length!==row.bytes||hash(bytes)!==row.sha256)throw new Error('Main stage artifact changed: '+row.path);}
const helper='products/rea-studio/apps/backup/native-policy-assertions.mjs',helperHash='2cad61b73ec5542f16e7ce01ac76a80864b78ef64750018262ea36975a8e7169';for(const name of [helper,'root-adapter-baseline/native-policy-assertions.mjs.snapshot'])if(hash(await fs.readFile(path.join(root,name)))!==helperHash)throw new Error('Root helper exact identity changed.');
const prior=[];for(const dir of await fs.readdir(path.join(root,'runs'),{withFileTypes:true})){if(!dir.isDirectory())continue;const file='runs/'+dir.name+'/validation.json',bytes=await fs.readFile(path.join(root,file)),record=JSON.parse(bytes);prior.push({path:file,sha256:hash(bytes),mode:record.mode,counts:record.counts,exitCode:record.exitCode,sourceStable:record.sourceStable,originalSourceStable:record.originalSourceStable,accounting:record.mode==='mutation-focused'?'Three substantive mutation cases and one empty filtered host-file harness pass':null});}prior.sort((a,b)=>a.path.localeCompare(b.path));
const raw=await fs.readFile(path.join(root,relative,'stdout.txt'),'utf8'),markers=raw.split(/\r?\n/).filter(line=>line.startsWith('{')).flatMap(line=>{try{return[JSON.parse(line)];}catch{return[];}}),host=markers.find(row=>row.nativePackHostObservation)?.nativePackHostObservation;if(!host||host.commands.length!==2||!host.restartPersistence||!host.exactDataPackAndRowDedup||!host.originalRestoreBytes)throw new Error('Required actual private-host/original observations missing.');
const receipt={schema:'rea-restic-pack-production-adapter-validation/v1',createdAt:new Date().toISOString(),status:'frozen staged candidate only',mainStage:{receiptPath:'../restic-pack-aggregation-next/stage-validation.json',receiptSha256:hash(mainReceipt),manifestSha256:hash(mainManifestBytes),authenticatedArtifacts:entries.length,unchanged:true},baseline:{path:'baseline.json',sha256:hash(await fs.readFile(path.join(root,'baseline.json'))),sources:baseline.sources.length,unchangedSourceOrigins:run.originalSourceStable},finalRun:{path:relative+'/validation.json',sha256:hash(await fs.readFile(path.join(root,relative,'validation.json'))),counts:run.counts,executedSourceStable:run.sourceStable,sourceFingerprints:run.sourceFingerprints},evidenceConstruction:{sourceFingerprints:await Promise.all(['README.md','freeze.mjs'].map(async name=>{const bytes=await fs.readFile(path.join(root,name));return{path:name,bytes:bytes.length,sha256:hash(bytes)};})),scope:'Documentation and post-run authenticated evidence collector, separate from executed behavioral source fingerprints; these do not alter test or runtime behavior.'},rootAdapterHelper:{path:helper,sha256:helperHash,snapshot:'root-adapter-baseline/native-policy-assertions.mjs.snapshot',exportsForCurrentProduction:['verifyStructure','verifyUnchanged'],batchSpecificExportOnlyForCandidate:'verifyBatch'},transform:{path:'adapter-diff.json',sha256:hash(await fs.readFile(path.join(root,'adapter-diff.json'))),originalTestPreserved:true,initialFailureCount:3,initialPassCount:27,initialTestCount:30,postFailurePolicyAndFixtureAdjustmentsExplicit:true,runtimeSourceChanges:0},runs:prior,observations:markers,independentOriginalScope:{release:'restic 0.19.1 windows amd64',zipSha256:'da948ad707ed690426473aaba2046cd61f8f90f6f0e7dab6be0d5796531de67d',exeSha256:'b0dd1fd21eea5d8fe1325f55f7118213c21f36de8a261e04c0624a5ab9fd7830',newHostCommands:host.commands.length,existingNativeCorpus:'Executed unchanged; commands are not relabeled as new algorithm cases or an exact count of source-helper comparisons.'},limits:['Finite staged correctness and real CLI interoperability only','No full-product/security/performance parity claim','Cooperative deadlines do not preempt synchronous work or blocked I/O','Filesystem capture is not an atomic snapshot','Main stage 66-pass receipt and all 250 retained artifacts unchanged','Production implementation, shared metadata and published results were not edited']};
await fs.writeFile(path.join(root,'adapter-validation.json'),JSON.stringify(receipt,null,2)+'\n');
async function walk(directory,prefix=''){const rows=[];for(const e of await fs.readdir(directory,{withFileTypes:true})){const name=prefix?prefix+'/'+e.name:e.name;if(name==='projects'||name==='.local'||name==='freeze-manifest.json')continue;if(e.isDirectory())rows.push(...await walk(path.join(directory,e.name),name));else{const bytes=await fs.readFile(path.join(directory,e.name));rows.push({path:name,bytes:bytes.length,sha256:hash(bytes)});}}return rows;}
const files=(await walk(root)).sort((a,b)=>a.path.localeCompare(b.path));await fs.writeFile(path.join(root,'freeze-manifest.json'),JSON.stringify({schema:'rea-restic-pack-native-adapter-preservation/v1',createdAt:new Date().toISOString(),excluded:['projects: local authenticated original executable/archive only','.local: owned scratch','freeze-manifest.json: self'],entries:files},null,2)+'\n');console.log(JSON.stringify({receiptSha256:hash(await fs.readFile(path.join(root,'adapter-validation.json'))),manifestSha256:hash(await fs.readFile(path.join(root,'freeze-manifest.json'))),artifacts:files.length,counts:run.counts,mainAuthenticatedUnchanged:entries.length,helperSha256:helperHash}));
