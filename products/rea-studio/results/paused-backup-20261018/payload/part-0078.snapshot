      },
      "applicability": {
        "status": "unresolved-no-explicit-oss-products-label",
        "products": []
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.2827f2f3829e979c9c02",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This naming convention should make it easier to identify security updates and the Grafana version they're based on, allowing for a better understanding of the importance and urgency of each release.",
      "headingPath": [
        "Strategies for upgrading your self-managed Grafana instance",
        "Grafana security releases: improved version naming convention"
      ],
      "source": {
        "path": "docs/sources/upgrade-guide/when-to-upgrade/index.md",
