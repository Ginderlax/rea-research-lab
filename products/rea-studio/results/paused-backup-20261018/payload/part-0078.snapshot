    {
      "id": "grafana.candidate.caa07ebdf0fb426a96f4",
      "syntaxRole": "list-item",
      "sourceText": "- **View dashboard**: links to the dashboard that contains the alerting panel",
      "headingPath": [
        "Before you begin",
