    },
    {
      "id": "grafana.candidate.3a1e26c7171a8dd36bb5",
      "syntaxRole": "list-item",
      "sourceText": "- **Query overlap window** - Specify a duration (for example, `10m`, `120s`, or `0s`). The default is `10m`. This buffer is added to each incremental request to account for delayed data ingestion.",
      "headingPath": [
        "Configure the Prometheus data source",
        "Configuration options",
        "Performance"
      ],
