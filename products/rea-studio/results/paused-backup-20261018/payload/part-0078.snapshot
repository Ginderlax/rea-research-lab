      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.86aa105614e7144a1372",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In addition, you can add query builder blocks, view the query history, and use the **Inspector** to see details.",
      "headingPath": [
