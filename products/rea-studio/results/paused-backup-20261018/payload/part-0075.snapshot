    },
    {
      "id": "grafana.candidate.695c0c0ed20240316f00",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana supports a wide range of contact points with varied support for images in notifications. The table below shows the list of all contact points supported in Grafana and their support for uploading screenshots to the receiving service and referencing screenshots that have been uploaded to a cloud storage service.",
      "headingPath": [
        "Use images in notifications",
        "Supported contact points"
      ],
      "source": {
        "path": "docs/sources/alerting/configure-notifications/template-notifications/images-in-notifications.md",
