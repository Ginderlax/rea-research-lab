    {
      "id": "grafana.candidate.f0d0b99f5563db59b919",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Optional. If tracking with RudderStack is enabled, you can provide a custom URL to load the RudderStack SDK.",
      "headingPath": [
