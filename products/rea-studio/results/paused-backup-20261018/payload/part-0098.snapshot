// Verification-only synthetic fixture. Never imported by the application.
import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import readline from 'node:readline';
import {fixtureServer} from '../../outputs/rea-research-lab/products/rea-studio/apps/sync/scripts/webdav-fixture.mjs';

const workRoot=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..');
const runDir=path.join(workRoot,'.local',`webdav-browser-${process.pid}`),remoteDir=path.join(runDir,'remote');
const auth={username:'rea-browser',password:'synthetic-only-webdav'};
const seed={'out/replace.txt':'old','out/extra.txt':'remove','out/excluded.tmp':'keep'};
await fs.mkdir(remoteDir,{recursive:true});
const fixture=await fixtureServer({seed,auth});
let knownFiles=new Set(),chain=Promise.resolve(),closed=false;
function mirror(){chain=chain.then(async()=>{
  const currentFiles=new Set();
  for(const [name,item]of fixture.entries){
    const target=path.resolve(remoteDir,...name.split('/'));
    if(target!==remoteDir&&!target.startsWith(remoteDir+path.sep))throw Error('Fixture mirror escaped its private root.');
    if(item.bytes===null){await fs.mkdir(target,{recursive:true});continue;}
    currentFiles.add(target);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,item.bytes);
  }
  for(const old of knownFiles)if(!currentFiles.has(old))await fs.unlink(old).catch(error=>{if(error.code!=='ENOENT')throw error;});
  knownFiles=currentFiles;
  await fs.writeFile(path.join(runDir,'state.json'),JSON.stringify({endpoint:fixture.endpoint,snapshot:fixture.snapshot(),requests:fixture.requests},null,2)+'\n');
});return chain;}
await mirror();
await fs.writeFile(path.join(runDir,'fixture.json'),JSON.stringify({endpoint:fixture.endpoint,remoteDir,auth,purpose:'Private synthetic WebDAV browser verification only; no real account.'},null,2)+'\n');
process.stdout.write(JSON.stringify({endpoint:fixture.endpoint,runDir,remoteDir,auth,commands:['snapshot','reset','stop']})+'\n');
const timer=setInterval(()=>{if(!closed)void mirror().catch(error=>{process.stderr.write(error.message+'\n');});},250);
const input=readline.createInterface({input:process.stdin});
async function close(){if(closed)return;closed=true;clearInterval(timer);input.close();await chain;await fixture.close();process.stdout.write(JSON.stringify({closed:true,runDir})+'\n');}
input.on('line',line=>{if(line==='snapshot')void mirror().then(()=>process.stdout.write(JSON.stringify({saved:true,runDir})+'\n'));else if(line==='reset'){fixture.reset(seed);void mirror().then(()=>process.stdout.write(JSON.stringify({reset:true,runDir})+'\n'));}else if(line==='stop')void close();});
process.on('SIGINT',()=>void close());process.on('SIGTERM',()=>void close());
