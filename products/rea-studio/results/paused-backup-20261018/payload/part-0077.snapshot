    {
      "id": "grafana.candidate.0a6744623cba0321015d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana provides many ways to authenticate users. Refer to the Grafana [Authentication overview](../configure-access/configure-authentication/) and other authentication documentation for detailed instructions on how to set up and configure authentication.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[auth]`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
