    {
      "id": "grafana.candidate.fbd68d755db6f997b489",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can't autocomplete columns until you've specified a table.",
      "headingPath": [
        "Microsoft SQL Server query editor",
        "Code mode",
        "Use autocompletion"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/query-editor/index.md",
