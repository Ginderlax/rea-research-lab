 const stage=join(work,folder),manifestBytes=readFileSync(join(stage,'freeze-manifest.json'));assert.equal(sha(manifestBytes),expected);const manifest=JSON.parse(manifestBytes);assert.equal(manifest.entries.length,count);
 for(const e of manifest.entries){safe(e.path);assert.ok(!/(^|\/)(projects|\.local|node_modules)(\/|$)|\.(exe|dll|zip|tgz|bundle|tar|7z)$/i.test(e.path),`Excluded binary/runtime source ${e.path}`);const bytes=readFileSync(join(stage,e.path));assert.equal(bytes.length,e.bytes);assert.equal(sha(bytes),e.sha256);retain(area,e.path,bytes);}retain(area,'freeze-manifest.json',manifestBytes);
}
