    },
    {
      "id": "grafana.candidate.e388051fdec7d1dd7562",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We’ve made a number of small improvements to the way tooltips work in Grafana. To try out the new tooltips, enable the `newVizTooltips` [feature toggle](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-grafana/feature-toggles/).",
      "headingPath": [
        "What’s new in Grafana v10.4",
        "Dashboards and visualizations",
        "Tooltip improvements"
      ],
      "source": {
