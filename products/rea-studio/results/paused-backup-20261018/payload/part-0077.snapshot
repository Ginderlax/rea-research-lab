    {
      "id": "grafana.candidate.745f06edeb97d3753656",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana can capture its own distributed traces to a local file in OpenTelemetry Protocol (OTLP) JSON format, without running a collector or a tracing backend. Capturing stops when the file reaches the size limit or the capture duration elapses, whichever comes first. Use this exporter for support: turn it on, reproduce an issue, then collect and share the file.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[tracing.opentelemetry.file]`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 2503,
        "lineEnd": 2505,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L2503-L2505"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.e03934bbeab6b502b887",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The path to the capture file, for example, `/var/lib/grafana/traces/capture.json`. Setting this option turns on the file exporter. The parent directory must already exist and be writable by Grafana. Default value is empty, which turns off the exporter.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[tracing.opentelemetry.file]`",
        "`path`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 2509,
        "lineEnd": 2509,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L2509-L2509"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.a40baa1f42d6b56d3e31",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The maximum size of the capture file, in bytes. Default value is `104857600` (100 MiB). The value must be greater than `0`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[tracing.opentelemetry.file]`",
        "`max_file_size_bytes`"
      ],
      "source": {
