    {
      "id": "grafana.candidate.1c9f038be64d1f5e8f4a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Note: in order to determine that there is a profile for a given span and render the 'Profiles for this span' button or the embedded flame graph in the span details, the 'pyroscope.profile.id' key-value pair must exist in your span tags.",
