   expect(origin['path'] in authorities,'Bound origin authority');matches=[r for r in authorities[origin['path']]['files'] if r['path']==target];expect(len(matches)==1 and matches[0]['after']==after_map[target]['after'],'Exact origin after pin '+target)
 checks['fiveInputAuthoritiesThreePeersAuthorAnd25OriginsExact']=True
 stage='all-before32-protected-and-actualGit-blobs'
