    {
      "id": "grafana.candidate.295e1eb58f51173642df",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Alternatively, you can use a custom annotation to set the dashboard URL and build the full URL using the `from` and `to` query parameters derived from `{{.Alert.StartsAt}}` and `{{.Alert.EndsAt}}`.",
      "headingPath": [
        "Notification template examples",
        "Print a link to a dashboard with time range"
      ],
      "source": {
        "path": "docs/sources/alerting/configure-notifications/template-notifications/examples.md",
        "gitBlobSha": "f44ada3c4bf2cbd8bb3541714231e6d910f8e923",
        "sha256": "2e6cc529503bea16404932fec29b5fea613b7e5454ac177a89d97904a07e417f",
        "lineStart": 498,
        "lineEnd": 498,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/configure-notifications/template-notifications/examples.md#L498-L498"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.a8fb2624ffd1ff64fbe9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To use this template, define a custom annotation named `MyDashboardURL` that contains the base dashboard URL without `from` and `to` parameters. For example: `http://localhost:3000/d/uiyahbsdaubsd`.",
      "headingPath": [
        "Notification template examples",
        "Print a link to a dashboard with time range"
      ],
      "source": {
        "path": "docs/sources/alerting/configure-notifications/template-notifications/examples.md",
        "gitBlobSha": "f44ada3c4bf2cbd8bb3541714231e6d910f8e923",
        "sha256": "2e6cc529503bea16404932fec29b5fea613b7e5454ac177a89d97904a07e417f",
        "lineStart": 520,
        "lineEnd": 520,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/configure-notifications/template-notifications/examples.md#L520-L520"
      },
      "applicability": {
