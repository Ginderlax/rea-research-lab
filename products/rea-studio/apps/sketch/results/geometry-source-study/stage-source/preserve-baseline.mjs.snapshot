import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
const root=fileURLToPath(new URL('./',import.meta.url)),production=path.resolve(root,'../../outputs/rea-research-lab/products/rea-studio'),hash=bytes=>createHash('sha256').update(bytes).digest('hex'),files=[];
async function copy(folder,prefix){for(const item of await fs.readdir(folder,{withFileTypes:true})){const name=prefix+item.name;if(item.isDirectory())await copy(path.join(folder,item.name),name+'/');else{const bytes=await fs.readFile(path.join(folder,item.name));for(const target of ['production-baseline/','']){const output=path.join(root,target,name);await fs.mkdir(path.dirname(output),{recursive:true});await fs.writeFile(output,bytes);}files.push({path:name,bytes:bytes.length,sha256:hash(bytes)});}}}await copy(path.join(production,'apps/sketch'),'apps/sketch/');
const storage=await fs.readFile(path.join(production,'lib/storage.mjs'));for(const target of ['production-baseline/','']){await fs.mkdir(path.join(root,target,'lib'),{recursive:true});await fs.writeFile(path.join(root,target,'lib/storage.mjs'),storage);}files.push({path:'lib/storage.mjs',bytes:storage.length,sha256:hash(storage)});
const report={schema:'rea-sketch-geometry-production-baseline/v1',capturedAtUtc:new Date().toISOString(),productionRoot:production,files:files.sort((a,b)=>a.path.localeCompare(b.path)),scope:'Exact current Sketch application and real disk-store dependency preserved before isolated staged edits. Production and prior stages/history not changed.'};await fs.writeFile(path.join(root,'production-baseline-manifest.json'),JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({files:files.length,manifestSha256:hash(await fs.readFile(path.join(root,'production-baseline-manifest.json')))}));
