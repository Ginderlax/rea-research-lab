    },
    {
      "id": "grafana.candidate.e41ca6350511732c7ad9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Self-managed Grafana users have control over when they upgrade to a new version of Grafana. To help you make an informed decision about whether it’s time to upgrade, it’s important that you understand the level of support provided for your current version.",
      "headingPath": [
        "Strategies for upgrading your self-managed Grafana instance",
        "What to know about version support"
      ],
      "source": {
        "path": "docs/sources/upgrade-guide/when-to-upgrade/index.md",
