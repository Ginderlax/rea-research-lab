import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs/promises';import path from'node:path';import{render}from'./client.mjs';import{handle,dispose}from'./server.mjs';import{createWorkspace}from'../../lib/storage.mjs';
// Model the native textarea value setter, not saved-file string identity.
// This normalization is independently observed in the retained Chrome proof.
class Element{constructor(tag){this.tagName=tag;this.children=[];this.attributes={};this._value='';this.textContent='';this.disabled=false;this.checked=false;this.style={};this.selectionStart=this.selectionEnd=0;this.selectionCalls=[];}get value(){return this._value;}set value(v){const value=this.tagName==='textarea'?String(v).replace(/\r\n?/g,'\n'):String(v);if(value!==this._value){this._value=value;if(this.tagName==='textarea')this.selectionStart=this.selectionEnd=value.length;}}append(...n){this.children.push(...n);}prepend(...n){this.children.unshift(...n);}replaceChildren(...n){this.children=[...n];}insertBefore(n,b){const at=this.children.indexOf(b);this.children.splice(at<0?this.children.length:at,0,n);}setAttribute(n,v){this.attributes[n]=v;}focus(){this.focused=true;}setSelectionRange(a,b){const end=Math.max(0,Math.min(this.value.length,b)),start=Math.min(end,Math.max(0,Math.min(this.value.length,a)));this.selectionStart=start;this.selectionEnd=end;this.selectionCalls.push({start,end,selected:this.value.slice(start,end)});}}
const all=n=>[n,...n.children.flatMap(all)],field=(r,l)=>all(r).find(n=>n.attributes['aria-label']===l),button=(r,l)=>all(r).find(n=>n.tagName==='button'&&n.textContent===l),deferred=()=>{let resolve;const promise=new Promise(r=>resolve=r);return{resolve,promise};},base=path.resolve(import.meta.dirname,'../../../../../.local/textarea-navigation');
async function fixture(t,content,wrapper){await fs.mkdir(base,{recursive:true});const folder=await fs.mkdtemp(path.join(base,'owned-')),workspace=await createWorkspace(folder);await fs.writeFile(workspace.resolve('a.txt'),content);await fs.writeFile(workspace.resolve('b.txt'),'B saved needle\n');const old={document:globalThis.document,window:globalThis.window};globalThis.document={createElement:n=>new Element(n)};globalThis.window={confirm:()=>true};const root=new Element('main'),calls=[],real=async(a,i)=>a==='gitStatus'?{initialized:false}:handle({action:a,input:i,workspace}),api=async(a,i)=>{calls.push({action:a,input:structuredClone(i)});return wrapper?wrapper(a,i,()=>real(a,i)):real(a,i);},cleanup=await render(root,api);t.after(async()=>{cleanup();await dispose(workspace);globalThis.document=old.document;globalThis.window=old.window;assert.equal(path.dirname(folder),base);await fs.rm(folder,{recursive:true,force:true});});return{root,workspace,calls,cleanup,editor:field(root,'File contents')};}
async function search(f,query,useRegex=false){field(f.root,'Find in saved files').value=query;field(f.root,'Regular expression in workspace search').checked=useRegex;await button(f.root,'Search saved files').onclick();}
const results=f=>all(field(f.root,'Workspace search results')).filter(n=>n.tagName==='button'&&n.textContent.startsWith('a.txt:'));
const inputs=[['LF','😀 lead\nneedle here\nsecond needle\n'],['CRLF','😀 lead\r\nneedle here\r\nsecond needle\r\n'],['bare CR','😀 lead\rneedle here\rsecond needle\r'],['mixed','😀 lead\r\nneedle\rnext needle\n🧪needle\r\n'],['same line','🧪abc needle 🧪needle éneedle éneedle\n']];
for(const[label,content]of inputs)for(const mode of['literal','regex'])test(`${label} ${mode} navigation maps every source match to native normalized textarea`,async t=>{
 const f=await fixture(t,content);await search(f,mode==='literal'?'needle':'n(?:ee)dle',mode==='regex');const rows=results(f),expectedText=content.replace(/\r\n?/g,'\n'),expected=[];let next=0;while((next=expectedText.indexOf('needle',next))>=0){expected.push({start:next,end:next+6});next+=6;}assert.equal(rows.length,expected.length);for(let i=0;i<rows.length;i++){await rows[i].onclick();assert.equal(f.editor.value,expectedText);assert.equal(f.editor.selectionStart,expected[i].start);assert.equal(f.editor.selectionEnd,expected[i].end);assert.equal(f.editor.value.slice(f.editor.selectionStart,f.editor.selectionEnd),'needle');assert.equal(await fs.readFile(f.workspace.resolve('a.txt'),'utf8'),content);}console.log(JSON.stringify({editorTextareaNavigationObservations:{case:label,mode,expected,actual:f.editor.selectionCalls,diskUnchanged:true,savedSourceRetainsRawEndings:true,nativeBrowser:false}}));
});
test('astral match and zero-length lookahead select complete Unicode scalar or exact empty endpoint',async t=>{
 const content='head\r\n🧪needle\r\n🧪needle\n',f=await fixture(t,content);await search(f,'🧪needle',true);for(const row of results(f)){await row.onclick();assert.equal(f.editor.value.slice(f.editor.selectionStart,f.editor.selectionEnd),'🧪needle');assert.equal(f.editor.selectionEnd-f.editor.selectionStart,8);}await search(f,'(?=needle)',true);const expected=[f.editor.value.indexOf('needle'),f.editor.value.lastIndexOf('needle')];const rows=results(f);for(let i=0;i<rows.length;i++){await rows[i].onclick();assert.equal(f.editor.selectionStart,expected[i]);assert.equal(f.editor.selectionEnd,expected[i]);}
});
for(const [start,end]of[[-1,1],[NaN,1],[5,2],[0,1000],[2,3]])test(`malformed or CRLF-interior source interval ${String(start)}:${end} is refused`,async t=>{
 const f=await fixture(t,'a\r\nneedle\n',async(a,i,real)=>{const d=await real();if(a==='search')d.matches=d.matches.map(m=>({...m,start,end}));return d;});await search(f,'needle');await results(f)[0].onclick();assert.equal(f.editor.selectionCalls.length,0);assert.ok(all(f.root).some(n=>n.attributes.role==='status'&&/text shown|positions/.test(n.textContent)));assert.equal(await fs.readFile(f.workspace.resolve('a.txt'),'utf8'),'a\r\nneedle\n');
});
test('shown-text mismatch without input cannot apply a stale source interval',async t=>{
 const f=await fixture(t,'head\r\nneedle\r\n');await button(f.root,'a.txt').onclick();await search(f,'needle');f.editor.value='mismatching shown text';await results(f)[0].onclick();assert.equal(f.editor.selectionCalls.length,0);assert.equal(f.editor.value,'head\nneedle\n');
});
test('dirty normalized draft and changed disk revision retain content and refuse source selection',async t=>{
 const f=await fixture(t,'head\r\nneedle\r\n');await search(f,'needle');await results(f)[0].onclick();const count=f.editor.selectionCalls.length;f.editor.value='newer needle draft\n';f.editor.oninput();await results(f)[0].onclick();assert.equal(f.editor.value,'newer needle draft\n');assert.equal(f.editor.selectionCalls.length,count);const fresh=await fixture(t,'head\r\nneedle\r\n');await search(fresh,'needle');await fs.writeFile(fresh.workspace.resolve('a.txt'),'external needle\r\n');await results(fresh)[0].onclick();assert.equal(fresh.editor.value,'external needle\n');assert.equal(fresh.editor.selectionCalls.length,0);
});
test('accepted clean Close invalidates held normalized result read; normal later navigation succeeds',async t=>{
 const arrived=deferred(),release=deferred();let hold=true;const f=await fixture(t,'head\r\nneedle\r\n',async(a,i,real)=>{const d=await real();if(a==='read'&&i.path==='a.txt'&&hold){arrived.resolve();await release.promise;}return d;});await button(f.root,'b.txt').onclick();await search(f,'needle',true);const pending=results(f)[0].onclick();await arrived.promise;button(f.root,'Close tab').onclick();release.resolve();await pending;assert.equal(f.editor.value,'');assert.equal(f.editor.selectionCalls.length,0);hold=false;await results(f)[0].onclick();assert.equal(f.editor.value.slice(f.editor.selectionStart,f.editor.selectionEnd),'needle');
});
test('cancelled dirty Close retains draft while held read options and disposed view reject publication',async t=>{
 const arrived=deferred(),release=deferred(),f=await fixture(t,'head\r\nneedle\r\n',async(a,i,real)=>{const d=await real();if(a==='read'&&i.path==='a.txt'){arrived.resolve();await release.promise;}return d;});await button(f.root,'b.txt').onclick();f.editor.value='dirty B needle';f.editor.oninput();await search(f,'needle',true);const pending=results(f)[0].onclick();await arrived.promise;globalThis.window.confirm=()=>false;button(f.root,'Close tab').onclick();assert.equal(f.editor.value,'dirty B needle');field(f.root,'Whole word in workspace search').checked=true;field(f.root,'Whole word in workspace search').onchange();f.cleanup();release.resolve();await pending;assert.equal(f.editor.value,'dirty B needle');assert.equal(f.editor.selectionCalls.length,0);assert.equal(field(f.root,'Workspace search results').children.length,0);
});
test('held real Save retains raw committed revision while newer normalized draft survives and retries',async t=>{
 const content='head\r\nneedle\r\n',arrived=deferred(),release=deferred();let hold=true;const f=await fixture(t,content,async(a,i,real)=>{const d=await real();if(a==='save'&&hold){arrived.resolve();await release.promise;}return d;});await button(f.root,'a.txt').onclick();const pending=button(f.root,'Save file').onclick();await arrived.promise;assert.equal(await fs.readFile(f.workspace.resolve('a.txt'),'utf8'),content);f.editor.value='newer needle draft\n';f.editor.oninput();await search(f,'needle',true);await results(f)[0].onclick();assert.equal(f.editor.value,'newer needle draft\n');assert.equal(f.editor.selectionCalls.length,0);release.resolve();await pending;assert.equal(f.editor.value,'newer needle draft\n');hold=false;await button(f.root,'Save file').onclick();assert.equal(await fs.readFile(f.workspace.resolve('a.txt'),'utf8'),'newer needle draft\n');await search(f,'needle',true);await results(f)[0].onclick();assert.equal(f.editor.value.slice(f.editor.selectionStart,f.editor.selectionEnd),'needle');
});
test('a malformed endpoint inside an astral pair is refused without source or draft mutation',async t=>{
 const f=await fixture(t,'🧪needle\r\n',async(a,i,real)=>{const d=await real();if(a==='search')d.matches=d.matches.map(m=>({...m,start:1,end:8}));return d;});await search(f,'needle');await results(f)[0].onclick();assert.equal(f.editor.value,'🧪needle\n');assert.equal(f.editor.selectionCalls.length,0);assert.equal(await fs.readFile(f.workspace.resolve('a.txt'),'utf8'),'🧪needle\r\n');
});
