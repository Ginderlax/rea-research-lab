    {
      "id": "grafana.candidate.80d435f807dcc63c3fd0",
      "syntaxRole": "table-row",
      "sourceText": "| `$__timeGroup(dateColumn,'5m', previous)` | Same as `$__timeGroup(dateColumn,'5m', 0)` but uses the previous value in the series as the fill value. If no previous value exists, it uses `NULL`. Fill only applies to time series queries.                |",
      "headingPath": [
        "PostgreSQL query editor",
        "Macros",
        "Time-series macros"
      ],
      "source": {
