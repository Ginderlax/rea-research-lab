    },
    {
      "label": "Await the final list while the group form remains current, then check both current generation and signature",
      "before": "if(signature()!==submittedSignature){const fresh=await api('recycleGroupList',{bin:false});if(!operationCurrent())return;const saved=fresh.groups.find(g=>g.id===result.id);",
      "after": "const fresh=await api('recycleGroupList',{bin:false});if(!operationCurrent())return;\n              if(signature()!==submittedSignature){const saved=fresh.groups.find(g=>g.id===result.id);",
      "beforeIdentity": {
        "bytes": 29829,
        "sha256": "4ed927469b180940f7313274d87a593360e96c38ce0de212f7cfaae271785190"
      },
