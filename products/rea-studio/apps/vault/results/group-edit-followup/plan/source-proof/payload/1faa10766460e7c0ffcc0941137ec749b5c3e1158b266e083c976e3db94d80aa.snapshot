import assert from 'node:assert/strict';import {readFileSync,readdirSync,lstatSync} from 'node:fs';import {resolve} from 'node:path';import {createHash} from 'node:crypto';
const work=resolve(import.meta.dirname,'..'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});
export const authorities=[['corrected137','vault-group-edit-late-draft-fix-next','manifest.json','289208dda19cada4aad11b38827414af77faa897b344d40ce71ff6ccec8013d3',137],['author885','vault-group-edit-next','manifest.json','52a88d027dc910c3ef8723e80690aef98dacdc9c98d43902192663ca43799ff4',885],['negative78','vault-group-edit-independent-review','review-manifest.json','65dbe05edf39e3625833f828fcad760b577d6fb0f3c4b6d8826379b6b1dbbc93',78],['historicalHTTP21','root-vault-group-edit-http-review-next','manifest.json','83680e5b27eafdd04abaa84d3789bf7e33a1cc01cb0a72f59b567435f760afbd',21],['historicalBrowser21','root-vault-group-edit-browser-review-next','manifest.json','3dc5b7d9bebe9419477c7fe38235afc8c14705c83099e2dc889c161587da18cd',21]];
function walk(root,p='',out=[]){assert(p.split('/').length<45);for(const d of readdirSync(resolve(root,p),{withFileTypes:true})){assert(!d.isSymbolicLink());const n=p?p+'/'+d.name:d.name;if(d.isDirectory())walk(root,n,out);else{assert(d.isFile());out.push(n);assert(out.length<2500);}}return out;}
export function authenticate(){const result=[];for(const [name,folder,file,pin,count]of authorities){const root=resolve(work,folder),b=readFileSync(resolve(root,file));assert.equal(id(b).sha256,pin);const m=JSON.parse(b);assert(Array.isArray(m.inventory)&&m.inventory.length===count);const names=new Set(m.inventory.map(r=>r.path));assert.equal(names.size,count);const extras=walk(root).filter(p=>!names.has(p)&&p!==file&&p!=='freeze.json');assert(extras.every(p=>p.split('/').includes('.local')&&m.excluded?.includes('.local/**')),'Unlisted authority files');let total=0;for(const r of m.inventory){assert(!r.path.startsWith('/')&&!/[\\:\x00-\x1f]/.test(r.path)&&r.path.split('/').every(s=>s&&s!=='.'&&s!=='..'));const at=resolve(root,r.path),stat=lstatSync(at);assert(stat.isFile()&&!stat.isSymbolicLink()&&stat.size<=32*1024*1024);const raw=readFileSync(at);total+=raw.length;assert(total<=128*1024*1024);assert.deepEqual(id(raw),{bytes:r.bytes,sha256:r.sha256},name+' '+r.path);}result.push({name,folder,file,manifest:id(b),payloads:count,fullListedInventoryExact:true,declaredLocalExtras:extras.map(path=>({path,...id(readFileSync(resolve(root,path)))})),selfFreeze:walk(root).includes('freeze.json')?id(readFileSync(resolve(root,'freeze.json'))):null});}return result;}
