    {
      "id": "grafana.candidate.faabdcc940dcacc3b878",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Recording rules allow you to periodically pre-compute frequently used or computationally expensive queries, saving the results as a new time series metric.",
      "headingPath": [
        "Configure recording rules"
      ],
      "source": {
