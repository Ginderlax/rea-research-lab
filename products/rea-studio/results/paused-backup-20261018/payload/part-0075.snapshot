    },
    {
      "id": "grafana.candidate.acc8068f69fa024c2d61",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Note that Pure Git, GitLab and Bitbucket are supported in Grafana v12.4.x or later only. Refer to [Enable Git providers](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/as-code/observability-as-code/git-sync/git-sync-setup/set-up-before#enable-git-providers) to set them up.",
      "headingPath": [
        "Usage and performance limitations",
        "Compatible Git providers"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/git-sync/usage-limits.md",
        "gitBlobSha": "259bfe6ffcef787e176c67fcf3b490f8ca9e966e",
        "sha256": "0cc8f7958ef6206b1f6ae32efdb03081375fab9f7c98f50e4b61847ff95c95ac",
        "lineStart": 145,
        "lineEnd": 145,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/as-code/observability-as-code/git-sync/usage-limits.md#L145-L145"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss",
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.acdc5c3e7430a5202349",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Pure Git only supports **Smart HTTP protocol v2**. Earlier protocol versions (v1, v0) and SSH transport are not supported.",
      "headingPath": [
        "Usage and performance limitations",
        "Compatible Git providers",
        "The Pure Git repository type"
      ],
      "source": {
