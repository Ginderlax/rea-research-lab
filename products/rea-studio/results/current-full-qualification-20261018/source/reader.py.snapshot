inner=read(folder/'downloaded-contents'/outer_files[0]['path'],MAX_ARCHIVE);assert len(inner)<=15*1024*1024,'Unchanged portable inner ZIP limit'
files=unpack(inner,folder/'readable-evidence');evidence=folder/'readable-evidence';by_name=rows_map(files)
report={'schema':'rea-current-698d-full-superset-portable-backup/v1','runId':RUN,'jobId':JOB,'artifactId':ARTIFACT,'branchHead':HEAD,'artifact':pin(outer),'innerArchive':pin(inner),'allCRCAndBytesReadable':True,'readableEvidence':str(evidence),'files':files,'fileCountObserved':len(files),'fixedProposal':FROZEN,'qualificationStage':'readable-backup-complete','recordedContractPassed':False,'qualificationErrors':[],'productExecutions':0,'originalExecutions':0,'tests':0,'builds':0,'syntaxChecks':0,'activeSourceWrites':0,'fullParity':False,'superiority':False,'historicalD24Cause':'unresolved; a later full pass cannot diagnose historical redacted failures','acceptanceScope':'This is a readback of separately hosted current implemented checks on one exact source epoch. Full original-product feature parity, universal superiority, performance, security and real-browser acceptance are not established here.'}
