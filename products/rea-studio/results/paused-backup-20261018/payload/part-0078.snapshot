    },
    {
      "id": "grafana.candidate.ee969d7e7fa6bf7b2dad",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A _template_ is any query that contains a variable. Queries with text that starts with `$` are templates. For example, if you administer a dashboard that monitors several servers, it can have panels that use a template query like this one:",
      "headingPath": [
        "Variables",
        "Template variables"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/variables/_index.md",
        "gitBlobSha": "0771de76715ca4fb8930580bfcc5e3337f1634b9",
        "sha256": "b5119c058e565b1cd9b7f71bad043dd74f0290e0c7f4d5363a8ecd935284e1ed",
        "lineStart": 83,
        "lineEnd": 85,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/dashboards/variables/_index.md#L83-L85"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
