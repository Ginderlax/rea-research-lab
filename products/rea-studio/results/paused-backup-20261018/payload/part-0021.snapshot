   'historicalInstalled32AndExperimental36ReceiptsRebound':False,
   'frozenApplicationREADMEStatus':'historical experimental proposal wording; current source transition qualifies installation status',
   'fullFeatureParity':False,'superiority':False
  }
  s=json.dumps(value,indent=2)+'\n'
 after=s.replace('\n','\r\n').encode()
 write(p,after);files.append({'path':p,'before':pin(before),'after':pin(after),'copyOnlyAfterActualSourceInstallation':True})
 bp=prefix+'index-before/'+p+'.snapshot';write(bp,before);files.append({'path':bp,'before':None,'after':pin(before),'historicalBeforeImage':True})
