 function docs(n){const nodes=n.jsDoc??[],result=[];for(const d of nodes){const links=[],tags=[];function visit(x){if([ts.SyntaxKind.JSDocLink,ts.SyntaxKind.JSDocLinkCode,ts.SyntaxKind.JSDocLinkPlain].includes(x.kind))links.push({kind:ts.SyntaxKind[x.kind],target:x.name?.getText(sf)??null,text:x.text??null,span:span(x.getStart(sf),x.end)});if(x.tagName)tags.push({name:x.tagName.text,span:span(x.getStart(sf),x.end)});ts.forEachChild(x,visit);}visit(d);result.push({span:span(d.pos,d.end),tags,links});}return result;}
