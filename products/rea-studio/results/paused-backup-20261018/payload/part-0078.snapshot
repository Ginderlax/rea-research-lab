    {
      "id": "grafana.candidate.a68d7eb72b660bc87705",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can use the following operations in expressions: math, reduce, and resample.",
      "headingPath": [
        "Write expression queries",
        "About expressions",
        "Operations"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/expression-queries/index.md",
