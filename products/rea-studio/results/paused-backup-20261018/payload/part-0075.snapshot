    {
      "id": "grafana.candidate.b3f723c5d3401598dcd1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This `GRAFANA_ALERTS` metric is compatible with the `ALERTS` metric used by Prometheus Alerting and includes two additional labels:",
