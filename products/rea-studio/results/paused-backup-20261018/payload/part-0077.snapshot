    {
      "id": "grafana.candidate.d15baf53ec0c2729cd56",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Time to wait for an instance to send a notification via the Alertmanager. In HA, each Grafana instance is assigned a position (for example, `0`, `1`). We then multiply this position with the timeout to indicate how long should each instance wait before sending the notification to take into account replication lag. The default value is `15s`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[unified_alerting]`",
        "`ha_peer_timeout`"
      ],
      "source": {
