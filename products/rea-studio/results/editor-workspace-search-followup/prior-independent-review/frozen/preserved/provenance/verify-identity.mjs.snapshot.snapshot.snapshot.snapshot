import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import {createHash} from 'node:crypto';
import {spawn} from 'node:child_process';
const root=path.join(import.meta.dirname,'original-products/vscode/1.140.0'),source=path.join(root,'unpacked'),app=path.join(source,'07f806f999/resources/app'),sha=b=>createHash('sha256').update(b).digest('hex'),exe=path.join(source,'Code.exe'),cli=path.join(app,'out/cli.js');
const launcherBytes=await fs.readFile(path.join(source,'bin/code.cmd'));assert.ok(launcherBytes.toString().includes('07f806f999\\resources\\app\\out\\cli.js'));const packageBytes=await fs.readFile(path.join(app,'package.json')),productBytes=await fs.readFile(path.join(app,'product.json')),packageJSON=JSON.parse(packageBytes),product=JSON.parse(productBytes),signature=JSON.parse((await fs.readFile(path.join(root,'extraction.json'),'utf8')).replace(/^\uFEFF/,''));assert.equal(packageJSON.version,'1.140.0');assert.equal(product.commit,'07f806f999227108933c2e30515b26eecc1fda74');assert.equal(signature.signatureStatus,'Valid');assert.match(signature.signerSubject,/Microsoft Corporation/);const executableBytes=await fs.readFile(exe);assert.equal(sha(executableBytes),'96851792952c34ead53462ad36d973356af2e737b5ed4e433e23c4647e0d6318');const cliBefore=await fs.readFile(cli);
