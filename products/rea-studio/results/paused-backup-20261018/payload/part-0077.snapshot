    {
      "id": "grafana.candidate.7dcb8dc412041f3e1569",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Available to Grafana administrators only, enables installing, uninstalling, and updating plugins directly from the Grafana UI. Set to `true` by default. Setting it to `false` hides the controls.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[plugins]`",
        "`plugin_admin_enabled`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
