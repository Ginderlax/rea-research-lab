import fs from 'node:fs/promises';import path from 'node:path';import os from 'node:os';import assert from 'node:assert/strict';import {createHash,randomBytes,timingSafeEqual} from 'node:crypto';import {createServer} from 'node:http';import {pathToFileURL} from 'node:url';
const own=import.meta.dirname,workspace=path.resolve(own,'../..'),work=path.join(workspace,'work'),lab=path.join(workspace,'outputs/rea-research-lab'),candidate=path.resolve(process.argv[2]),expected=process.argv[3],sha=b=>createHash('sha256').update(b).digest('hex');
assert(candidate.startsWith(work+path.sep));assert(/^[0-9a-f]{64}$/.test(expected));
async function verify(){const b=await fs.readFile(path.join(candidate,'manifest.json'));assert.equal(sha(b),expected);const m=JSON.parse(b);assert(Array.isArray(m.inventory));for(const row of m.inventory){const bytes=await fs.readFile(path.join(candidate,row.path));assert.equal(bytes.length,row.bytes,row.path);assert.equal(sha(bytes),row.sha256,row.path);}return {manifestSha256:sha(b),records:m.inventory.length};}
const before=await verify(),sources=[];for(const [origin,base,name] of [...['server.mjs','catalog.mjs','lib/storage.mjs','public/index.html','public/studio.mjs','public/style.css'].map(n=>['public-f0b4746e',lab,n]),...['client','server','recycle','history','kdbx','xml'].map(n=>['reviewed-candidate',candidate,'apps/vault/'+n+'.mjs'])]){const source=path.join(base,'products/rea-studio',name),b=await fs.readFile(source),target=path.join(own,'host',name);if(name==='server.mjs')assert.equal(sha(b),'85fe09b1b52a1d91e9d09c85d99c6e768ac4b793f5d7694a1760a4c0560a0a94');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b,{flag:'wx'});sources.push({origin,source:path.relative(workspace,source).replaceAll('\\','/'),materialized:path.relative(own,target).replaceAll('\\','/'),bytes:b.length,sha256:sha(b)});}
const collector=await fs.readFile(import.meta.filename);sources.push({origin:'owned-browser-collector',source:path.relative(workspace,import.meta.filename).replaceAll('\\','/'),materialized:'host.mjs',bytes:collector.length,sha256:sha(collector)});const runtime=await fs.readFile(process.execPath);assert.equal(sha(runtime),'b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3');await fs.writeFile(path.join(own,'source-before.json'),JSON.stringify(sources,null,2)+'\n',{flag:'wx'});
const dataDir=await fs.mkdtemp(path.join(os.tmpdir(),'rea-root-vault-browser-')),wire=[],startedAt=new Date().toISOString(),{start}=await import(pathToFileURL(path.join(own,'host/server.mjs')).href),host=await start({port:0,dataDir});host.server.on('request',(req,res)=>res.once('finish',()=>{wire.push({at:new Date().toISOString(),method:req.method,url:req.url,status:res.statusCode});}));
async function api(action,input={}){const response=await fetch(host.url+'/api/vault/'+action,{method:'POST',headers:{'content-type':'application/json','x-rea-token':host.token},body:JSON.stringify(input),signal:AbortSignal.timeout(10000)}),value=await response.json();assert.equal(response.status,200,action+' '+JSON.stringify(value));return value.result;}
const master='Root owned browser vault master';await api('create',{password:master});await api('save',{title:'Browser synthetic A',group:'Parent/Selected',password:'Browser synthetic descendant A'});await api('save',{title:'Browser synthetic B',group:'Parent/Selected/Deep',password:'Browser synthetic descendant B'});await api('save',{title:'Browser synthetic C',group:'Other',password:'Browser synthetic unaffected C'});
const controlToken=randomBytes(32).toString('hex');let closing=false,controlPort;
async function close(reason){if(closing)return;closing=true;clearTimeout(deadline);const finalState={active:(await api('list')).entries.map(e=>({id:e.id,title:e.title})),binCount:(await api('recycleList')).entries.length};const record=await fs.readFile(path.join(dataDir,'vault/records/vault.database.json'),'utf8');for(const secret of [master,'Browser synthetic descendant A','Browser synthetic descendant B','Browser synthetic unaffected C'])assert(!record.includes(secret));await host.close();await new Promise(resolve=>control.close(resolve));const after=await verify();for(const row of sources){const b=await fs.readFile(path.join(workspace,row.source)),copy=await fs.readFile(path.join(own,row.materialized));assert.equal(b.length,row.bytes);assert.equal(sha(b),row.sha256);assert.deepEqual(copy,b);}await fs.writeFile(path.join(own,'source-after.json'),JSON.stringify(sources,null,2)+'\n',{flag:'wx'});assert.equal(path.dirname(dataDir),path.resolve(os.tmpdir()));assert(path.basename(dataDir).startsWith('rea-root-vault-browser-'));await fs.rm(dataDir,{recursive:true,force:true});await fs.rm(path.join(own,'.local/private-control.json'));
  await fs.writeFile(path.join(own,'wire.json'),JSON.stringify({wire,scope:'Normal shared Studio host request finish events; no body/token capture and no routing or handler substitution.'},null,2)+'\n',{flag:'wx'});const validation={schema:'rea-root-vault-normal-browser-host/v1',startedAt,endedAt:new Date().toISOString(),before,after,sources:13,sourceStable:true,runtime:{version:process.version,sha256:sha(runtime)},reason,finalState,encryptedSecretsAbsent:true,ownedHostClosed:true,ownedDataRemoved:true,scope:{sharedHostExact:true,shellExact:true,candidateVaultExact:true,transportBridge:false,handlerSubstitutions:0,originalExecutions:0,productionWrites:0,fullParity:false,universalSuperiority:false,UIEvidence:'Separate owned browser observations; this host receipt alone does not assert GUI acceptance.'},diagnostics:[{kind:'read-only preparation path guess',detail:'A preliminary read requested public/app.mjs after the inventory identified public/studio.mjs; nonexistent-path read failed, then actual studio.mjs was read. No product failure/source mutation.'}]};await fs.writeFile(path.join(own,'validation.json'),JSON.stringify(validation,null,2)+'\n',{flag:'wx'});
  async function inventory(dir,prefix=''){const rows=[];for(const ent of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const rel=prefix+ent.name;if(rel==='.local')continue;if(ent.isDirectory())rows.push(...await inventory(path.join(dir,ent.name),rel+'/'));else{assert(ent.isFile());if(rel==='manifest.json')continue;const b=await fs.readFile(path.join(dir,ent.name));rows.push({path:rel,bytes:b.length,sha256:sha(b)});}}return rows;}const rows=await inventory(own),manifest=Buffer.from(JSON.stringify({schema:'rea-strict-work-review/v1',files:rows.length,excludedPrivate:['.local/private-control.json'],inventory:rows},null,2)+'\n');await fs.writeFile(path.join(own,'manifest.json'),manifest,{flag:'wx'});console.log(JSON.stringify({closed:true,files:rows.length,manifestSha256:sha(manifest)}));}
const control=createServer((req,res)=>{const supplied=Buffer.from(String(req.headers['x-owned-control']??'')),wanted=Buffer.from(controlToken);if(req.headers.host!==`127.0.0.1:${controlPort}`||req.socket.remoteAddress!=='127.0.0.1'||supplied.length!==wanted.length||!timingSafeEqual(supplied,wanted)||req.method!=='POST'||req.url!=='/close'){res.writeHead(403);res.end();return;}res.writeHead(200,{'content-type':'application/json'});res.end('{"closing":true}');void close('Explicit owned browser review shutdown').catch(e=>{console.error(e);process.exitCode=1;});});await new Promise(resolve=>control.listen(0,'127.0.0.1',resolve));controlPort=control.address().port;await fs.mkdir(path.join(own,'.local'));await fs.writeFile(path.join(own,'.local/private-control.json'),JSON.stringify({url:`http://127.0.0.1:${controlPort}/close`,token:controlToken,hostURL:host.url,pid:process.pid,dataDir})+'\n',{flag:'wx'});const deadline=setTimeout(()=>void close('Owned fifteen-minute host deadline').catch(e=>{console.error(e);process.exitCode=1;}),15*60*1000);console.log(JSON.stringify({url:host.url+'/#vault',ownedPID:process.pid,sharedHostExact:true,sourceRoster:13,privateControlMetadata:true}));
