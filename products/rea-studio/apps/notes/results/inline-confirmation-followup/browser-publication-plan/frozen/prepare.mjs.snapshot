const previousMap=JSON.parse(await readBounded(oldRoot,'public-preservation-map.json')),previousExcluded=JSON.parse(await readBounded(oldRoot,'local-exclusions.json')),oldValidation=JSON.parse(await readBounded(oldRoot,'validation.json'));assert.equal(previousMap.payload.length,569);assert.equal(previousExcluded.excluded.length,9);assert.equal(oldValidation.acceptance.correctedClientActualBrowser,false);const reviewRoot=path.join(workspace,'work',browser.directory),vb=await readBounded(reviewRoot,'validation.json');assert.equal(hash(vb),'5d284a148316c6bac3a30999bf5fa8fe61f0c32e369e2430ab8238d083f1c8bc');const v=JSON.parse(vb);assert.equal(v.finiteBrowserAcceptance,true);assert.equal(v.semanticGroups,8);assert.equal(v.sourceFiles,12);assert.equal(v.sourceStable,true);assert.equal(v.clientSHA256,'90886819feef847847fcae8c442e0a401a1146a7a4aa1fd862a54b5e01f41da9');assert.equal(v.cancellationAddedRequests,0);assert.equal(v.browserCampaigns,1);assert.equal(v.productionWrites,0);assert.equal(v.frozenPriorEvidenceModified,false);assert.equal(v.hostClosed&&v.relayClosed&&v.tabCloseResolved&&v.tempDataRemoved,true);assert.equal(v.attachment.browserUploadAcceptance,false);assert.equal(v.attachment.permissionChanged,false);assert.equal(v.attachment.browserDownloadedFileVerified,true);assert.equal(v.attachment.downloadEventBridgeTimedOut,true);assert.equal(v.attachment.bytes,63);assert.equal(v.attachment.sha256,'055503b5030e894c9ceaf9b0cd8feb8039569526fe720dc937442be4a82867f3');await save('authority/browser-validation.json.snapshot',vb);await save('authority/browser-manifest.json.snapshot',await readBounded(reviewRoot,'freeze-manifest.json'));await save('authority/prior-plan-manifest.json.snapshot',await readBounded(oldRoot,'freeze-manifest.json'));await save('authority/prior-plan-validation.json.snapshot',await readBounded(oldRoot,'validation.json'));await save('authority/prior-proof-module.mjs.snapshot',await readBounded(oldRoot,'notes-inline-provenance.mjs',{bytes:7087,sha256:'b4862a18bbf62abff0dd444607dc8ec019db9c7e2e69631f390525e31ab538d1'}));
const payload=[...previousMap.payload],excluded=[...previousExcluded.excluded];for(const a of[old,actual])for(const r of[...a.rows,{path:a.manifest,...a.manifestIdentity}]){const b=await readBounded(path.join(workspace,'work',a.directory),r.path,r),row={epoch:a.id,sourceRoot:'work/'+a.directory,sourcePath:r.path,...identity(b)};if(a.id==='corrected-browser'&&['owned-attachment.txt','downloaded-attachment.txt'].includes(r.path)){assert.equal(r.bytes,63);assert.equal(r.sha256,v.attachment.sha256);excluded.push({...row,publishable:false,kind:'owned-generated-attachment-fixture',localRetained:true,reason:'Synthetic file carrier and browser downloaded copy retained locally; exact63-byte SHA/reproduction source and successful byte verification preserved publicly.'});continue;}const c=classify(b,a.id==='corrected-browser'?'browser/'+r.path:r.path);assert.equal(c.publishable,true);payload.push({...row,publicPath:publicPath(a.id,r.path),inertExact:true,...c});}
assert.equal(payload.length,818);assert.equal(excluded.length,11);assert.equal(new Set(payload.map(r=>r.publicPath)).size,payload.length);for(const r of payload){safeRelative(r.publicPath,true);await readBounded(path.join(workspace,r.sourceRoot),r.sourcePath,r);}await json('public-preservation-map.json',{schema:'rea-notes-inline-browser-final-public-map/v1',historicalFourEpochsPreservedExactly:true,previousSourceOnlyPlan162PreservedAsHistorical:true,browser87PreservedSeparately:true,epochs:[...previousMap.epochs,{...old,rows:undefined},{...actual,rows:undefined}],payload,publicPathRecords:818,uniqueByteObjects:new Set(payload.map(r=>r.sha256)).size,inputPathRecords:829,wholeTreePublic:false,publicCopiesPerformed:0});await json('local-exclusions.json',{schema:'rea-notes-inline-browser-final-exclusions/v1',excluded,files:11,syntheticJexCopies:9,generatedAttachmentCopies:2,excludedBytes:87552+126,allExclusionsAuthenticated:true,originalNativeExecutablesCopied:false});
