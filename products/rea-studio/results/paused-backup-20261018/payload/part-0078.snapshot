    {
      "id": "grafana.candidate.211c475c9424d953c098",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Some applications publish data intermittently; for example, they only post a metric when an event occurs. By default, Grafana graphs connect lines between the data points, but this can be deceptive.",
      "headingPath": [
        "Troubleshoot dashboards",
        "Handling or rendering null data is wrong or confusing"
      ],
