// New immutable addendum to the already frozen162 proposal; source-only.
import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {EPOCHS,PUBLIC_PREFIX,hash,identity,readBounded,authenticateEpoch,manifestRows,classify,publicPath,safeRelative} from '../notes-inline-publication-plan-next/notes-inline-provenance.mjs';
const root=import.meta.dirname,workspace=path.resolve(root,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),oldRoot=path.join(workspace,'work/notes-inline-publication-plan-next');
async function save(p,b){const dest=path.resolve(root,p);assert.ok(dest.startsWith(root+path.sep));await fs.mkdir(path.dirname(dest),{recursive:true});await fs.writeFile(dest,b,{flag:'wx'});}const json=async(p,j)=>save(p,JSON.stringify(j,null,2)+'\n');
const prior={id:'prior-source-only-plan',directory:'notes-inline-publication-plan-next',manifest:'freeze-manifest.json',schema:'rea-notes-inline-publication-plan-freeze/v1',count:162,sha256:'ab0bccd1aaf43da7b932193a0991531659b2e5017b72c28933b37bcc7ddcf3ae'},browser={id:'corrected-browser',directory:'notes-inline-cancel-no-read-browser-next',manifest:'freeze-manifest.json',schema:'rea-notes-corrected-inline-browser-strict-freeze/v1',count:87,sha256:'402425b29671175caecf368661b21987205087d5fdef3025c06323f94029acfb'};
