        if p in proof: assert proof[p]==expected
        proof[p]=expected
        members.setdefault(p,[]).append(group)
assert len(proof)==60
for p,pin in proof.items():
    # Current app targets are prospective after images and not installed.
    target=next((r for r in bundle['transitions'] if r['path']==p),None)
