    },
    {
      "id": "grafana.candidate.833489fb9d084c327147",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "With Trace to Logs, you can view relevant logs for a trace or span with one click. You can now link to Splunk logs from your tracing datasource. In your tracing datasource, configure Trace to Logs by selecting the Splunk datasource and relevant query options like tags to include in the query.",
      "headingPath": [
        "What's new in Grafana v8.5",
        "OSS",
        "Observability",
        "Trace to Logs for Splunk"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-5.md",
