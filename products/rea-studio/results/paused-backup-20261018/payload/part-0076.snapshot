        "lineStart": 24,
        "lineEnd": 25,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/tempo/configure-tempo-data-source/configure-trace-to-metrics.md#L24-L25"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.89fcabc40dbff49d2129",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Trace to metrics works with any Prometheus-compatible data source and doesn't require the Tempo metrics generator. The metrics generator creates _new_ metrics from trace data; trace to metrics links to metrics that _already exist_ in your metrics data source.",
      "headingPath": [
        "Configure trace to metrics correlation"
      ],
      "source": {
