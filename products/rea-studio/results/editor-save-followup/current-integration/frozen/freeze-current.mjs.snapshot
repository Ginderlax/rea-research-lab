import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const here=import.meta.dirname,workspace=path.resolve(here,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),hash=b=>createHash('sha256').update(b).digest('hex'),ident=async p=>{const b=await fs.readFile(p);return{bytes:b.length,sha256:hash(b)}},write=async(n,x)=>fs.writeFile(path.join(here,n),JSON.stringify(x,null,2)+'\n',{flag:'wx'}),validation=JSON.parse(await fs.readFile(path.join(here,'validation.json')));assert.deepEqual(validation.counts,{tests:78,pass:78,fail:0,cancelled:0,skipped:0,todo:0});for(const r of validation.currentSources)assert.deepEqual(await ident(path.join(repo,r.path)),{bytes:r.bytes,sha256:r.sha256});const verifierPath='products/rea-studio/scripts/verify-editor-save-followup.mjs',vb=await fs.readFile(path.join(repo,verifierPath));await fs.writeFile(path.join(here,'verify-editor-save-followup.mjs.snapshot'),vb,{flag:'wx'});await write('verifier-provenance.json',{schema:'rea-editor-save-current-verifier-source/v1',path:verifierPath,bytes:vb.length,sha256:hash(vb),createdAfterBehavioralRun:true,tested31SourceSetNotRebound:true,publicCurrentRoot:'products/rea-studio/results/editor-save-followup/current-integration/frozen/',verificationPendingPublicPreservation:true});
async function walk(base,prefix=''){const rows=[];for(const e of await fs.readdir(base,{withFileTypes:true})){assert(!e.isSymbolicLink());if(e.isDirectory())rows.push(...await walk(path.join(base,e.name),prefix+e.name+'/'));else rows.push(prefix+e.name);}return rows.sort();}const inventory={};for(const rel of await walk(here))if(rel!=='freeze-manifest.json')inventory[rel]=await ident(path.join(here,rel));await write('freeze-manifest.json',{schema:'rea-editor-save-current-integration-freeze/v1',at:new Date().toISOString(),files:Object.keys(inventory).length,receiptSHA256:(await ident(path.join(here,'validation.json'))).sha256,sourceFiles31:true,testFiles15:true,tests78:true,inventory});console.log(JSON.stringify({receipt:await ident(path.join(here,'validation.json')),manifest:await ident(path.join(here,'freeze-manifest.json')),files:Object.keys(inventory).length,verifier:{path:verifierPath,bytes:vb.length,sha256:hash(vb)},sourceStable:true,childrenHostsClosed:true}));
