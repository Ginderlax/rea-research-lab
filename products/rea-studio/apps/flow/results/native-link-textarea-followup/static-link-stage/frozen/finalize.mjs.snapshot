import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import{createHash}from'node:crypto';import{fileURLToPath}from'node:url';
const own=path.dirname(fileURLToPath(import.meta.url)),lab=path.resolve(own,'../../outputs/rea-research-lab'),candidate=path.join(own,'candidate'),appPrefix='products/rea-studio/apps/flow/',sha=b=>createHash('sha256').update(b).digest('hex');
async function readJSON(relative){return JSON.parse(await fs.readFile(path.join(own,relative),'utf8'));}async function fingerprint(file){const bytes=await fs.readFile(file);return {bytes:bytes.length,sha256:sha(bytes)};}
const final=await readJSON('runs/final-focus/run.json');assert.equal(final.exit.code,0);assert.equal(final.sourceStable,true);assert.deepEqual(final.before,final.after);assert.equal(final.before.length,27);const stdout=await fs.readFile(path.join(own,'runs/final-focus/stdout.txt'),'utf8');for(const [label,count]of Object.entries({tests:57,pass:57,fail:0,cancelled:0,skipped:0,todo:0}))assert.match(stdout,new RegExp('ℹ '+label+' '+count+'(?:\\r?\\n|$)'));for(const row of final.after)assert.deepEqual(await fingerprint(path.join(candidate,row.path)),{bytes:row.bytes,sha256:row.sha256});
const provenance=await readJSON('source-provenance.json');for(const row of provenance.productionBaseline){assert.deepEqual(await fingerprint(path.join(lab,row.path)),{bytes:row.bytes,sha256:row.sha256});assert((await fs.readFile(path.join(lab,row.path))).equals(await fs.readFile(path.join(own,'before',row.path.replace('products/rea-studio/','')+'.snapshot'))));}for(const row of provenance.officialSources)assert.deepEqual(await fingerprint(path.join(own,row.snapshot)),{bytes:row.bytes,sha256:row.sha256});for(const row of provenance.verificationAuxiliary){assert.deepEqual(await fingerprint(path.join(own,row.snapshot)),{bytes:row.bytes,sha256:row.sha256});assert.deepEqual(await fingerprint(path.join(lab,'.local/flow-original',row.cachePath)),{bytes:row.bytes,sha256:row.sha256});}
const runtime=await readJSON('runs/final-focus/observations/link-runtime-journal.json'),original=await readJSON('runs/final-focus/observations/link-original.json'),http=await readJSON('runs/final-focus/observations/link-http.json');assert.equal(original.observations.filter(x=>x.kind==='released-compiler').length,9);assert.equal(original.observations.filter(x=>x.kind==='released-handler').length,7);assert.equal(runtime.observations.filter(x=>x.kind==='released-full-runtime').length,8);assert.deepEqual(runtime.observations.at(-1),{kind:'cleanup',helperHostStopped:true,tempRemoved:true,originalCases:8});assert.equal(http.observations.length,3);assert.equal(http.observations.reduce((sum,x)=>sum+x.hostStarts,0),5);assert(http.observations.every(x=>x.hostClosed&&x.tempRemoved));
const runNames=(await fs.readdir(path.join(own,'runs'),{withFileTypes:true})).filter(x=>x.isDirectory()).map(x=>x.name).sort();const runs=[];const classification={
 'link-core-v1-exact-replay':'Owned negative fixture targeted a non-LinkIn configured target, so earlier correct role refusal differed from expected unsupported-node wording. Changed fixture only to unsupported node after valid Link In; runtime unchanged.',
 'original-v1':'Original-host/tooling failure: Node24 native InternalCallbackScope assertion. Compiler/handler groups completed; exact full-runtime case count unavailable, never inferred.',
 'original-v2':'Owned child adapter syntax failure: extraction removed a required final brace. No original full-runtime execution in worker.',
 'original-v3':'Owned fixture public-init settings disabled httpAdminRoot, leaving released helper comms settings uninitialized. Original startup failed; no candidate mismatch.',
 'original-v4':'Owned fixture disabled editor initialization, also leaving helper comms uninitialized. Original startup failed; no candidate mismatch.',
 'http-v1':'Owned HTTP collector incorrectly assumed unwrapped result; shared host returns {result}. Three assertions failed before meaningful semantics, all three hosts closed and temps removed. Corrected collector envelope only.',
 'ui-v2-pointer-negative':'Two confirmed native-interface gaps: already-started SVG pointer completion changed JSON while link operation busy; detached completion attempted parsing scrubbed empty JSON. Candidate pointer guards corrected; ten bodies unchanged in passing replay.'
};for(const name of runNames){const run=await readJSON('runs/'+name+'/run.json');assert.equal(run.sourceStable,true);const text=await fs.readFile(path.join(own,'runs',name,'stdout.txt'),'utf8');const counts={};for(const label of['tests','pass','fail','cancelled','skipped','todo']){const match=new RegExp('ℹ '+label+' (\\d+)').exec(text);counts[label]=match?Number(match[1]):null;}runs.push({name,receipt:'runs/'+name+'/run.json',receiptFingerprint:await fingerprint(path.join(own,'runs',name,'run.json')),counts,exit:run.exit,sourceFiles:run.before.length,classification:classification[name]??'Passing finite campaign; exact scope/test selection retained in its source-bound run record.'});}
await fs.writeFile(path.join(own,'failure-ledger.json'),JSON.stringify({schema:'rea-flow-link-failure-ledger/v1',runs,preparation:[{path:'preserved-original-v1/transformation.json',scope:'Exact initial child-generator record, including the worker version with syntax error. Current accepted worker is separately fingerprinted by final run.'},{path:'preparation-failures/provenance-v1/prepare-provenance.mjs.snapshot',scope:'Own read-only temp-parent audit asserted Windows forward-slash string against backslash normalized parent. Changed to path.resolve before parent comparison; retained exact failed collector source. Ten verification-source copies already existed and were subsequently byte-verified, never overwritten.'},{scope:'First attempted runtime read omitted candidate prefix; failed read only. Initial-authority-check.json preserves diagnostic.'},{scope:'Recursive removal of original fatal-attempt owned empty temp directory was rejected by automatic approval review: blocked by policy. No removal occurred; three empty directories remain explicitly pending in provenance.'}],originalCrashNotCandidateMismatch:true,thresholdAdjustments:[],benchmarks:0},null,2)+'\n');
const modified=final.after.filter(row=>row.path.startsWith(appPrefix)&&provenance.productionBaseline.some(b=>b.path===row.path&&b.sha256!==row.sha256));const added=final.after.filter(row=>row.path.startsWith(appPrefix)&&!provenance.productionBaseline.some(b=>b.path===row.path));assert.equal(modified.length,5);assert.equal(added.length,9);await fs.mkdir(path.join(own,'proposed-live'),{recursive:true});
const originalTestPath=appPrefix+'link-original.test.mjs',originalTest=await fs.readFile(path.join(candidate,originalTestPath),'utf8');const edits=[{before:'cache=process.env.FLOW_ORIGINAL_CACHE;',after:"cache=process.env.FLOW_ORIGINAL_CACHE??path.resolve(here,'../../../../.local/flow-original');"},{before:'const env={...process.env,FLOW_LINK_OBSERVATIONS:out};',after:'const env={...process.env,FLOW_LINK_OBSERVATIONS:out,FLOW_ORIGINAL_CACHE:cache};'}];let adapted=originalTest;for(const edit of edits){assert.equal(adapted.split(edit.before).length-1,1);adapted=adapted.replace(edit.before,edit.after);}let inverse=adapted;for(const edit of [...edits].reverse())inverse=inverse.replace(edit.after,edit.before);assert.equal(inverse,originalTest);await fs.writeFile(path.join(own,'proposed-live/link-original.test.mjs'),adapted);await fs.writeFile(path.join(own,'proposed-live/adapter.json'),JSON.stringify({schema:'rea-flow-link-installed-cache-path-adapter/v1',source:originalTestPath,sourceFingerprint:await fingerprint(path.join(candidate,originalTestPath)),proposal:'proposed-live/link-original.test.mjs',proposalFingerprint:await fingerprint(path.join(own,'proposed-live/link-original.test.mjs')),edits,inverseExact:true,scope:'Only default original cache path and explicit child cache environment forwarding. Assertions, fixture algorithms, counters and outputs unchanged. Source-only proposal, not executed in current campaign.'},null,2)+'\n');
const proposals=[];for(const row of [...modified,...added].sort((a,b)=>a.path.localeCompare(b.path))){const baseline=provenance.productionBaseline.find(b=>b.path===row.path);proposals.push({target:row.path,operation:baseline?'REPLACE':'ADD',before:baseline?{bytes:baseline.bytes,sha256:baseline.sha256}:{absent:true},source:row.path===originalTestPath?'proposed-live/link-original.test.mjs':'candidate/'+row.path,after:row.path===originalTestPath?await fingerprint(path.join(own,'proposed-live/link-original.test.mjs')):{bytes:row.bytes,sha256:row.sha256},scope:row.path===originalTestPath?'Documented source-only current-layout cache adapter; requires root installed focused run.':'Exact staged bytes; root must adjust any staging-only documentation/public preservation links in a separate disclosed proposal epoch before installation.'});}await fs.writeFile(path.join(own,'installation-proposal.json'),JSON.stringify({schema:'rea-flow-static-link-installation-proposal/v1',productionChanged:false,productionBaselineFiles:18,proposals,sharedHostChanges:0,globalRequirementsChanges:0,productionAcceptance:false,browserAcceptance:false,originalHistorical51Runtime828ScalarRerun:false},null,2)+'\n');
await fs.writeFile(path.join(own,'README.md'),`# Frozen Flow static-link work stage\n\nCandidate-only source-assisted Link In/Link Out implementation against released Node-RED5.0.8. No production/repo/public changes. Read candidate docs NATIVE-LINKS.md and LINK-SOURCE-NOTICE.md for exact contracts and limits.\n\nFinal focused selector57/57, zero fail/skip/cancel/todo, source27 stable.33 existing +24 new runner cases. Original comparison groups contain9 compiler fixtures,7 handler cases,8 full test-helper flows,1 plain child and1 ephemeral original host. Original editor/GUI0, benchmark0. New real HTTP3 cases use5 actual shared-host starts/two restarts; the existing nativeHTTP baseline case separately uses2 starts. DOM10 cases are model-only, browser0.\n\nFive existing app source/doc replacements plus9 additions are proposed; one original-test current-layout cache-path adapter is unexecuted and inverse-verified. Shared host85fe remains exact, no new route is required. All18 current production baseline and8 publisher-selected source files remain exact;10 auxiliary original verification files are frozen separately. Old51/828 corpus and old native-original.test.mjs are preserved but not executed by this campaign.\n\nAll failed attempts and exact sources/raw remain under runs/. failure-ledger.json distinguishes own fixture/collector errors, two actual SVG pointer defects fixed with unchanged test bodies, and original Node24 startup tooling failure. Three owned empty directories from original fatal attempts remain pending because automatic approval review rejected recursive cleanup. No original hosts/processes remain active. Accepted final original/HTTP hosts closed and synthetic data removed normally.\n\nInstallation, independent review and actual browser acceptance remain pending. No exhaustive compatibility or universal superiority claim.\n`);
const receipt={schema:'rea-flow-static-link-stage-validation/v1',at:new Date().toISOString(),candidateOnly:true,productionChanged:false,sourceBoundRun:{path:'runs/final-focus/run.json',...await fingerprint(path.join(own,'runs/final-focus/run.json')),tests:57,pass:57,fail:0,skipped:0,cancelled:0,todo:0,sourceFiles:27,sourceStable:true},candidateSources:final.after,productionBaseline18Unchanged:true,officialSelected8Unchanged:true,auxiliaryVerification10Unchanged:true,originalFinite:{compilerFixtures:9,handlerCases:7,fullRuntimeFlows:8,plainChildProcesses:1,ephemeralHosts:1,normalCleanup:true,richDeepEquality:true,suppliedMessageIdPreserved:true,originalEditor:0,originalGUI:0,benchmarks:0},newHTTP:{runnerCases:3,hostStarts:5,restarts:2,calls:http.observations.reduce((sum,x)=>sum+x.calls.length,0),normalCleanup:true},baselineHTTP:{existingNativeRunnerCase:1,hostStarts:2,notCountedAsNewHTTP:true},DOMModel:{runnerCases:10,browser:0,heldRealHandleCommit:true,pointerFailureBodiesUnchanged:true},sourceProvenance:{path:'source-provenance.json',...await fingerprint(path.join(own,'source-provenance.json'))},failureLedger:{path:'failure-ledger.json',...await fingerprint(path.join(own,'failure-ledger.json'))},installationProposal:{path:'installation-proposal.json',...await fingerprint(path.join(own,'installation-proposal.json')),replacements:5,additions:9,sharedHost:0,sourceOnlyAdapter:true},historicalCorpus:{runtime51:51,scalar828:828,reexecuted:false,receiptsRebound:false},limits:{nodes:500,idCharacters:80,nativeJSONBytes:4194304,physicalWireDeclarations:2000,staticLinkDeclarations:2000,deliveries:5000,cooperativeDeadlineMs:10000,queueAndDebugBytes:6291456,memoryIsolation:false,blockedIOPreemption:false},excludedCapabilities:['Link Call/return','External event bus','Subflows','Scheduled inject execution','Full original editor/runtime'],orphanCleanupPending:provenance.orphanTemporaryDirectories,productionAcceptance:false,independentAcceptance:false,browserAcceptance:false,fullFeatureParity:false,universalSuperiority:false};await fs.writeFile(path.join(own,'validation.json'),JSON.stringify(receipt,null,2)+'\n');
async function inventory(directory,prefix=''){const rows=[];for(const entry of(await fs.readdir(directory,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){if(entry.name==='.local'||!prefix&&['manifest.json','freeze.json'].includes(entry.name))continue;const relative=prefix?prefix+'/'+entry.name:entry.name;if(entry.isDirectory())rows.push(...await inventory(path.join(directory,entry.name),relative));else{const bytes=await fs.readFile(path.join(directory,entry.name));assert(!relative.split('/').includes('.local'));assert(!/\.(?:exe|dll|zip|7z|tgz|gz|tar)$/i.test(relative));assert(!(bytes[0]===0x4d&&bytes[1]===0x5a));assert(!(bytes[0]===0x50&&bytes[1]===0x4b));assert(!(bytes[0]===0x1f&&bytes[1]===0x8b));new TextDecoder('utf8',{fatal:true}).decode(bytes);rows.push({path:relative,bytes:bytes.length,sha256:sha(bytes)});}}return rows;}
const files=await inventory(own);await fs.writeFile(path.join(own,'manifest.json'),JSON.stringify({schema:'rea-flow-static-link-preservation-manifest/v1',files:files.length,inventory:files,exclusions:['.local compressed carriers and installed dependencies','manifest.json self','freeze.json self-binding'],scan:{allSelectedUTF8:true,noMZ_PK_GZIPHeaders:true,noNativeArchiveExtensions:true,noDotLocalPaths:true}},null,2)+'\n');await fs.writeFile(path.join(own,'freeze.json'),JSON.stringify({schema:'rea-flow-static-link-freeze/v1',at:new Date().toISOString(),receipt:{path:'validation.json',...await fingerprint(path.join(own,'validation.json'))},manifest:{path:'manifest.json',...await fingerprint(path.join(own,'manifest.json'))},files:files.length,productionChanged:false,sourceFrozen:true},null,2)+'\n');console.log(JSON.stringify({files:files.length,receipt:await fingerprint(path.join(own,'validation.json')),manifest:await fingerprint(path.join(own,'manifest.json')),candidate:final.after.filter(x=>x.path.endsWith('/native.mjs')||x.path.endsWith('/native-link.mjs')||x.path.endsWith('/client.mjs')||x.path.endsWith('/server.mjs'))}));
