    {
      "id": "grafana.candidate.88158da5e4c6e54cdc3c",
      "syntaxRole": "table-row",
      "sourceText": "| `grafana_alertmanager_cluster_messages_publish_failures_total{msg_type=\"update\",reason=\"buffer_overflow\"}` | Number of state sync messages dropped due to a full message queue. A non-zero value indicates message loss. These metrics are shared across all HA state channels (alerts, silences, notification log), not only alert broadcasts. |",
      "headingPath": [
        "Configure high availability",
        "Single-node evaluation mode",
        "Monitor single-node evaluation mode"
      ],
      "source": {
