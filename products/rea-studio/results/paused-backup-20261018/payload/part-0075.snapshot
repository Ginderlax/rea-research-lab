    {
      "id": "grafana.candidate.1028f71c733447f8615a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The entire feature has been removed from Grafana. For users who enabled the `dashboardPreviews` feature flag, Grafana will continue to work as-is but without dashboard previews. We recommend you remove the `dashboardPreviews` feature flag from your Grafana configuration.",
      "headingPath": [
        "Breaking changes in Grafana v10.0",
        "General breaking changes",
        "The experimental \"dashboard previews\" feature is removed",
        "Migration path"
      ],
      "source": {
        "path": "docs/sources/breaking-changes/breaking-changes-v10-0.md",
