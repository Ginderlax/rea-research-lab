        "lineEnd": 156,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/explore/trace-integration.md#L155-L156"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.0ead7978e22a7bc99d25",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Using Trace to profiles, you can use Grafana’s ability to correlate different signals by adding the functionality to link between traces and profiles.",
      "headingPath": [
        "Traces in Explore",
        "Trace view",
        "Trace to profiles"
      ],
      "source": {
        "path": "docs/sources/visualizations/explore/trace-integration.md",
