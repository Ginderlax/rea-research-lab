    {
      "id": "grafana.candidate.4825f9767d0206eff508",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now visualize gauges in vertical and horizontal orientations with overflow. This resolves an issue where the design would break when the number of gauges exceeded the available space.",
