    {
      "id": "grafana.candidate.11adfb41d73f0013090a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For example, a contact point could contain a PagerDuty integration; an email and Slack integration; or a PagerDuty integration, a Slack integration, and two email integrations. You can also configure a contact point with no integrations; in which case no notifications are sent.",
      "headingPath": [
        "Contact points"
      ],
      "source": {
        "path": "docs/sources/alerting/fundamentals/notifications/contact-points.md",
        "gitBlobSha": "ea2d5aa183da0a3bde6bf1e1aeb5a0b176617493",
        "sha256": "035645dd9c2e1f12adcbfc739afcca9258a237da8b036f9ea07083d046e5e3cb",
        "lineStart": 65,
        "lineEnd": 65,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/fundamentals/notifications/contact-points.md#L65-L65"
      },
      "applicability": {
