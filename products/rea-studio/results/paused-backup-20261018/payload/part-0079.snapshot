      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.fbab7ca60fe69ee57287",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We recommend that you only use one dataset in a bar chart because using multiple datasets can result in unexpected behavior.",
      "headingPath": [
        "Bar chart",
        "Supported data formats",
        "Example 2"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/bar-chart/index.md",
