    },
    {
      "id": "grafana.candidate.2f18d027ed97a1d6bad0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can specify these CloudWatch data source queries in the Variable edit view's **Query type** field. Use them to fill a variable's options list with values like `regions`, `namespaces`, `metric names`, and `dimension keys/values`.",
      "headingPath": [
        "CloudWatch template variables",
        "Use query variables"
      ],
      "source": {
