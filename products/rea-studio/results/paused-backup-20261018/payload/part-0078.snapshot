        "lineStart": 166,
        "lineEnd": 166,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/upgrade-guide/when-to-upgrade/index.md#L166-L166"
      },
      "applicability": {
