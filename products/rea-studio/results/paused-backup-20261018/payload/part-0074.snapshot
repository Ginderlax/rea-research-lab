    },
    {
      "id": "grafana.candidate.6dbcb2bd3b5a8116f6af",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Silences are assigned to a [specific Alertmanager](ref:alertmanager-architecture) and only suppress notifications for alerts managed by that Alertmanager.",
