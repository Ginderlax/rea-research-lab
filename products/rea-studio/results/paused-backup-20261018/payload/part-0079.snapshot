    {
      "id": "grafana.candidate.cccde9c50420bbb5f0b4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We've updated several visualizations so that now you can add actions to them. The panel configuration now includes a **Data links and actions** section where you can add actions that can each be configured to call an API endpoint.",
      "headingPath": [
        "What’s new in Grafana v11.3",
        "Additional dashboard and visualization improvements",
        "Actions for visualizations"
      ],
