          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.8a64de7550bebcf3d409",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We've added support for many new query types, including: Audit events, Users, Merge request approvals, Field tags, Environments, and Pipelines.",
      "headingPath": [
        "What's new in Grafana v9.4",
        "Enterprise Datasources",
        "GitLab Datasource"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-4.md",
