          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.e3f8083337cec8f4cadc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "After every successful build of the main branch, two tags, `grafana/grafana:main` and `grafana/grafana:main-ubuntu`, are updated. Additionally, two new tags are created: `grafana/grafana-dev:<version>` and `grafana/grafana-dev:<version>-ubuntu`, where `version` is a prerelease version of Grafana. For example, if `1234` is the GitHub Run ID of the build, `12.2.0-1234`. These tags provide access to the most recent Grafana main builds. For more information, refer to [`grafana/grafana-dev`](https://hub.docker.com/r/grafana/grafana-dev/tags).",
      "headingPath": [
        "Configure a Grafana Docker image",
        "Run the Grafana main branch"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-docker.md",
        "gitBlobSha": "d91b83cf21311b97e3e286b7c1efc686959b4b9f",
        "sha256": "c76f5bf33aa9948420698d8a2f35a8495645f0e19c57f16743f2e31ec133f9a7",
        "lineStart": 108,
        "lineEnd": 108,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-docker.md#L108-L108"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.cb14de407cc3640f16dc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To ensure stability and consistency, we strongly recommend using the `grafana/grafana-dev:<version>` tag when running the Grafana main branch in a production environment. This tag ensures that you are using a specific version of Grafana instead of the most recent commit, which could potentially introduce bugs or issues. It also avoids polluting the tag namespace for the main Grafana images with thousands of pre-release tags.",
      "headingPath": [
        "Configure a Grafana Docker image",
        "Run the Grafana main branch"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-docker.md",
        "gitBlobSha": "d91b83cf21311b97e3e286b7c1efc686959b4b9f",
        "sha256": "c76f5bf33aa9948420698d8a2f35a8495645f0e19c57f16743f2e31ec133f9a7",
        "lineStart": 110,
        "lineEnd": 110,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-docker.md#L110-L110"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.ab37567e4c71de2a1573",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana comes with default configuration parameters that remain the same among versions regardless of the operating system or the environment (for example, virtual machine, Docker, Kubernetes, etc.). You can refer to the [Configure Grafana](../configure-grafana/) documentation to view all the default configuration settings.",
      "headingPath": [
        "Configure a Grafana Docker image",
        "Default paths"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-docker.md",
        "gitBlobSha": "d91b83cf21311b97e3e286b7c1efc686959b4b9f",
        "sha256": "c76f5bf33aa9948420698d8a2f35a8495645f0e19c57f16743f2e31ec133f9a7",
        "lineStart": 116,
        "lineEnd": 116,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-docker.md#L116-L116"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
