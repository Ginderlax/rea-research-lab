import fs from 'node:fs/promises';
import path from 'node:path';
import {pathToFileURL} from 'node:url';
import {createRequire} from 'node:module';
import {Session} from 'node:inspector';
import assert from 'node:assert/strict';
import {here,sha,authenticateOriginal} from './authenticate-original.mjs';
import {canonical,packet} from './canonical.mjs';
const authority=await authenticateOriginal(),original=createRequire(authority.entry)(authority.entry),candidateURL=pathToFileURL(path.join(here,'candidate-module-control.mjs')).href,helperURL=pathToFileURL(path.join(here,'selector-control.mjs')).href,native=await import(candidateURL),helperSource=await fs.readFile(path.join(here,'selector-control.mjs'),'utf8'),session=new Session();session.connect();const post=(method,params={})=>new Promise((resolve,reject)=>session.post(method,params,(error,result)=>error?reject(error):resolve(result)));
await post('Profiler.enable');await post('Profiler.startPreciseCoverage',{callCount:true,detailed:true});
const n=25000,cases=[['organ-pipe',Array.from({length:n},(_,i)=>i<n/2?i+.125:n-i+.125)],['alternating-ends',Array.from({length:n},(_,i)=>i%2?n-Math.floor(i/2):Math.floor(i/2))],['repeated-bands',Array.from({length:n},(_,i)=>Math.floor(i/17)%113)],['prime-lattice',Array.from({length:n},(_,i)=>(i*8191)%32749+.0625)],['chunk-zippers',Array.from({length:n},(_,i)=>Math.floor(i/257)%2?257-i%257:i%257)],['tail-heavy-steps',Array.from({length:n},(_,i)=>i<n*.95?Math.floor(i/499):1e6+(i%13)*.125)]];
let comparisons=0;for(const [label,values]of cases)for(const id of ['p1','p5','p25','p50','p75','p95','p99']){const field=()=>({name:'synthetic-workcap',type:'number',config:{nullValueMode:'connected'},values:values.slice(),state:{calcs:{unrelated:'kept'}}}),expectedField=field(),actualField=field(),expected=original.reduceField({field:expectedField,reducers:[id]}),actual=native.reduceField({field:actualField,reducers:[id]});assert.deepEqual(actual,expected,label+':'+id);assert.deepEqual(actualField.state,expectedField.state);assert.equal(canonical(packet(actualField,actual)),canonical(packet(expectedField,expected)));assert.equal(canonical(actualField.values),canonical(values));comparisons++;}
const {result}=await post('Profiler.takePreciseCoverage');await post('Profiler.stopPreciseCoverage');session.disconnect();const helper=result.find(row=>row.url===helperURL),selector=helper?.functions.find(row=>row.functionName==='selectFinitePercentile'),marker=helperSource.indexOf('return selectionUnavailable;',helperSource.indexOf('if (++work > budget)')),containing=selector?.ranges.filter(range=>range.startOffset<=marker&&range.endOffset>marker).sort((a,b)=>(a.endOffset-a.startOffset)-(b.endOffset-b.startOffset))??[],guardCount=containing[0]?.count??0;assert.ok(marker>=0&&guardCount>0,'Adversarial correctness corpus must execute the unchanged work-cap fallback.');
const receipt={schemaVersion:1,checkedAt:new Date().toISOString(),status:'passed',authority,entrySHA256:sha(await fs.readFile(path.join(here,'candidate-module-control.mjs'))),helperSHA256:sha(helperSource),scriptSHA256:sha(await fs.readFile(path.join(here,'verify-work-cap.mjs'))),cases:cases.map(([label,values])=>({label,samples:values.length})),comparisons,inputResultStateAndCacheAliasExact:true,selectionFunctionCoverage:selector,boundedFallbackMarker:marker,boundedFallbackContainingRanges:containing,boundedFallbackExecutionCount:guardCount,budgetMultiplierUnchanged:8,sourceCoverageIsSupplementaryNotOutputOracle:true,scope:'Six 25000-sample adversarial arrangements, including three new shapes, seven percentile ranks each; independently executed released original. Exact helper-module V8 coverage proves bounded fallback executions without modifying measured source.',timingMeasurementRun:false,memoryMeasurementRun:false,fullProductComplete:false,universalSuperiorityEstablished:false};await fs.writeFile(path.join(here,'results/work-cap.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({status:'passed',comparisons,guardCount,helperSHA256:receipt.helperSHA256}));
