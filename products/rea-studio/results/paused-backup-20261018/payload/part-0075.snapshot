    },
    {
      "id": "grafana.candidate.df05cd4c38eeb5f49395",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The previous sections explain how to [configure alert rules](ref:configure-alert-rules) and [configure notifications](ref:configure-notifications) to generate alerts and send their notifications.",
      "headingPath": [
        "Monitor alerts"
      ],
      "source": {
        "path": "docs/sources/alerting/monitor-status/_index.md",
        "gitBlobSha": "f8c0e147d45a78a4e20fb96557c280e1ade12b55",
