import test from 'node:test';import assert from 'node:assert/strict';import{fixture,linkScene}from'./link-ui-fixture.mjs';import{handle}from'./server.mjs';
test('native UI draws compiled virtual edge and suppresses overwritten physical Link Out wires',async()=>{const f=await fixture();try{await f.load();const paths=f.section.walk().filter(n=>n.tagName==='path');assert.equal(paths.filter(n=>n.getAttribute('stroke-dasharray')==='6 4').length,1);assert.equal(paths.find(n=>n.getAttribute('stroke-dasharray')).getAttribute('aria-label'),'Static link out to in');assert.equal(paths.length,3);assert.equal(f.field('Static Link Out source').value,'out');assert.equal(f.field('Static Link In destination').value,'in');}finally{await f.close();}});
test('disconnect removes incoming and outgoing references; connect recreates both while retaining opaque native metadata',async()=>{const f=await fixture();try{await f.load();await f.button('Disconnect static link').click();let doc=JSON.parse(f.field('Native Node-RED flow JSON').value);assert.deepEqual(doc.flows[2].links,[]);assert.deepEqual(doc.flows[3].links,[]);assert.deepEqual(doc.flows[2].wires,[['ignored']]);assert.equal(f.section.walk().filter(n=>n.getAttribute('stroke-dasharray')).length,0);await f.button('Connect static link').click();doc=JSON.parse(f.field('Native Node-RED flow JSON').value);assert.deepEqual(doc.flows[2].links,['in']);assert.deepEqual(doc.flows[3].links,['out']);assert.equal(doc.flows[2].custom,'retained');assert.deepEqual(doc.vendor,{preserved:['yes',7]});await f.button('Connect static link').click();assert.deepEqual(JSON.parse(f.field('Native Node-RED flow JSON').value).flows[2].links,['in']);}finally{await f.close();}});
test('missing outgoing links retain physical wires after incoming-only disconnect',async()=>{const scene=linkScene();delete scene.flows[2].links;scene.flows[2].wires=[['in']];const f=await fixture({scene});try{await f.load();assert.equal(f.section.walk().filter(n=>n.getAttribute('stroke-dasharray')).length,0);await f.button('Disconnect static link').click();const doc=JSON.parse(f.field('Native Node-RED flow JSON').value);assert.equal(Object.hasOwn(doc.flows[2],'links'),false);assert.deepEqual(doc.flows[2].wires,[['in']]);assert.deepEqual(doc.flows[3].links,[]);}finally{await f.close();}});
test('invalid Link Out mode is refused without changing native document',async()=>{const scene=linkScene();scene.flows[2].mode='return';const f=await fixture({scene});try{await f.load();const before=f.field('Native Node-RED flow JSON').value;await f.button('Connect static link').click();assert.equal(f.field('Native Node-RED flow JSON').value,before);assert.match(f.section.textContent,/Only static Link Out/);}finally{await f.close();}});
test('held actual link validation disables duplicate actions and guards newer programmatic draft',async()=>{let enabled=false;const f=await fixture({hold:a=>enabled&&a==='native-validate'});try{await f.load();enabled=true;const pending=f.button('Disconnect static link').click();await f.held;const beforeCount=f.calls.length;assert.equal(f.button('Disconnect static link').disabled,true);await f.button('Connect static link').click();assert.equal(f.calls.length,beforeCount);const changed=JSON.stringify({...linkScene(),vendor:{newDraft:true}});f.field('Native Node-RED flow JSON').value=changed;f.release();await pending;assert.equal(f.field('Native Node-RED flow JSON').value,changed);}finally{await f.close();}});
test('closing native view suppresses held validation publication and scrubs detached controls',async()=>{let enabled=false;const f=await fixture({hold:a=>enabled&&a==='native-validate'});try{await f.load();enabled=true;const field=f.field('Native Node-RED flow JSON'),pending=f.button('Disconnect static link').click();await f.held;f.dispose();assert.equal(field.value,'');assert.equal(f.section.children.length,0);f.release();await pending;assert.equal(field.value,'');assert.equal(f.section.children.length,0);}finally{await f.close();}});
test('held actual saved draft commits once and closing suppresses local publication',async()=>{let enabled=false;const f=await fixture({hold:a=>enabled&&a==='native-save'});try{await f.load();const scene=linkScene();scene.vendor.changed='persisted';const raw=JSON.stringify(scene,null,2);f.field('Native Node-RED flow JSON').value=raw;enabled=true;const pending=f.button('Save native draft').click();await f.held;assert.equal((await handle({action:'native-export',input:{id:f.saved.flow.id},store:f.store})).text,raw);assert.equal(f.button('Save native draft').disabled,true);f.dispose();f.release();await pending;assert.equal(f.section.children.length,0);assert.equal(f.calls.filter(c=>c.action==='native-save').length,1);}finally{await f.close();}});
test('draft link edit leaves saved deployment unchanged until Save and Deploy',async()=>{const f=await fixture();try{await f.load();await f.button('Deploy native flow').click();const before=(await handle({action:'native-inject',input:{id:f.saved.flow.id,messages:[{payload:'old',_msgid:'fixed'}]},store:f.store})).run;assert.deepEqual(before.debug.map(x=>x.node),['debug']);await f.button('Disconnect static link').click();await f.button('Save native draft').click();const old=(await handle({action:'native-inject',input:{id:f.saved.flow.id,messages:[{payload:'still-old',_msgid:'fixed'}]},store:f.store})).run;assert.deepEqual(old.debug.map(x=>x.node),['debug']);await f.button('Deploy native flow').click();const next=(await handle({action:'native-inject',input:{id:f.saved.flow.id,messages:[{payload:'new',_msgid:'fixed'}]},store:f.store})).run;assert.equal(next.debug.length,0);}finally{await f.close();}});
