    {
      "id": "grafana.candidate.40b2a7ea238edb42515d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you have created dashboards with template variables, then you can choose which values are selected when rendering a report. This makes it easier to tailor reports to their audience or generate multiple reports from the same dashboard.",
      "headingPath": [
        "What's new in Grafana v7.5",
        "Enterprise features",
        "Use template variable in reports"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-5.md",
