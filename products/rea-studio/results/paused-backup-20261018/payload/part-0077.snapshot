    {
      "id": "grafana.candidate.b94254bade15364cfa7b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you don't want Entra ID authentication to sync user roles and organization membership and prevent the sync of org roles from Entra ID, set `skip_org_role_sync` to `true`. Use this if you want to manage the organization roles for your users from within Grafana or that your organization roles are synced from another provider. See [Configure Grafana](../../../configure-grafana/#authazuread) for more details.",
      "headingPath": [
        "Configure Microsoft Entra ID OAuth authentication",
        "Skip organization role sync"
      ],
      "source": {
