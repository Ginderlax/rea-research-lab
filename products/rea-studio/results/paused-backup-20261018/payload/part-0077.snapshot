    {
      "id": "grafana.candidate.b783d6fd6360fdd5193c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When `rendering_mode = clustered`, you can instruct how many browsers or incognito pages can execute concurrently. Default is `browser` and clusters using browser instances.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[plugin.grafana-image-renderer]`",
