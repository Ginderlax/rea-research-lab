import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{gunzipSync}from'node:zlib';
const base=path.resolve(import.meta.dirname,'..'),lab=path.join(base,'outputs/rea-research-lab'),owned=path.join(base,'work/flow-native-link-next'),studio=path.join(lab,'products/rea-studio'),sha=b=>createHash('sha256').update(b).digest('hex');
assert.equal(fs.existsSync(owned),false);fs.mkdirSync(owned,{recursive:true});function save(n,b){const p=path.join(owned,n);fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,b,{flag:'wx'});}
const lockBytes=fs.readFileSync(path.join(studio,'apps/flow/fixtures/oracle/package-lock.json')),lock=JSON.parse(lockBytes);save('authority/package-lock.json.snapshot',lockBytes);
const packageSpecs=[['@node-red/nodes',['LICENSE','package.json','core/common/60-link.js','core/common/60-link.html','locales/en-US/common/60-link.html']],['@node-red/runtime',['LICENSE','package.json','lib/flows/util.js']]];
function selectedTar(bytes,wanted){const selected=new Map(),text=(h,a,b)=>h.subarray(a,b).toString('utf8').replace(/\0.*$/s,'');let offset=0;while(offset+512<=bytes.length){const h=bytes.subarray(offset,offset+512);if(h.every(x=>x===0))break;const sizeText=text(h,124,136).trim();assert.match(sizeText,/^[0-7]+$/);const size=parseInt(sizeText,8);assert.ok(Number.isSafeInteger(size)&&size>=0&&size<=32*1024*1024);const expected=parseInt(text(h,148,156).trim(),8);let actual=0;for(let i=0;i<512;i++)actual+=i>=148&&i<156?32:h[i];assert.equal(actual,expected);assert.ok(offset+512+size<=bytes.length);const name=(text(h,345,500)?text(h,345,500)+'/':'')+text(h,0,100),type=String.fromCharCode(h[156]||48);if(wanted.includes(name)){assert.ok(type==='0','Selected official source must be a regular file');assert.ok(!selected.has(name));selected.set(name,Buffer.from(bytes.subarray(offset+512,offset+512+size)));}offset+=512+Math.ceil(size/512)*512;}assert.deepEqual([...selected.keys()].sort(),[...wanted].sort());return selected;}
const acquisition=[];for(const[name,names]of packageSpecs){const record=lock.packages['node_modules/'+name];assert.equal(record.version,'5.0.8');assert.match(record.integrity,/^sha512-/);const url=new URL(record.resolved);assert.equal(url.origin,'https://registry.npmjs.org');assert.ok(url.pathname.endsWith('-5.0.8.tgz'));const response=await fetch(url,{signal:AbortSignal.timeout(30000)});assert.equal(response.status,200);const archive=Buffer.from(await response.arrayBuffer());assert.ok(archive.length<=32*1024*1024);assert.equal('sha512-'+createHash('sha512').update(archive).digest('base64'),record.integrity);const stem=name.replace('@','').replace('/','-');save('.local/carriers/'+stem+'-5.0.8.tgz',archive);const selected=selectedTar(gunzipSync(archive,{maxOutputLength:128*1024*1024}),names.map(n=>'package/'+n));const sources=[];for(const n of names){const b=selected.get('package/'+n),installed=fs.readFileSync(path.join(lab,'.local/flow-original/node_modules',name,n));assert.ok(b.equals(installed),'Installed original source must equal official locked archive');const destination='official-source/'+stem+'/'+n+'.snapshot';save(destination,b);sources.push({path:n,snapshot:destination,bytes:b.length,sha256:sha(b),installedCacheExact:true});}acquisition.push({name,version:'5.0.8',url:url.href,integrity:record.integrity,archiveBytes:archive.length,archiveSHA256:sha(archive),archivePublic:false,sources});}
const sourceRows=[];function inventory(dir,rel=''){return fs.readdirSync(path.join(dir,rel),{withFileTypes:true}).flatMap(e=>{assert.ok(!e.isSymbolicLink());const n=rel?rel+'/'+e.name:e.name;if(e.isDirectory())return ['results','.local','node_modules'].includes(e.name)?[]:inventory(dir,n);return[n];}).sort();}for(const n of inventory(path.join(studio,'apps/flow'))){const relative='apps/flow/'+n,b=fs.readFileSync(path.join(studio,relative));save('candidate/products/rea-studio/'+relative,b);save('before/'+relative+'.snapshot',b);sourceRows.push({path:'products/rea-studio/'+relative,bytes:b.length,sha256:sha(b)});}for(const n of ['server.mjs','catalog.mjs','lib/storage.mjs','lib/http.mjs','package.json']){if(!fs.existsSync(path.join(studio,n)))continue;const b=fs.readFileSync(path.join(studio,n));save('candidate/products/rea-studio/'+n,b);save('before/'+n+'.snapshot',b);sourceRows.push({path:'products/rea-studio/'+n,bytes:b.length,sha256:sha(b)});}
save('source-before.json',Buffer.from(JSON.stringify(sourceRows,null,2)+'\n'));save('acquisition.json',Buffer.from(JSON.stringify({schema:'rea-node-red-link-authority-acquisition/v1',at:new Date().toISOString(),lock:{bytes:lockBytes.length,sha256:sha(lockBytes)},packages:acquisition,officialSourceUnits:8,originalExecutions:0,appWrites:0,fullParity:false,universalSuperiority:false},null,2)+'\n'));save('preparation-collector.mjs.snapshot',fs.readFileSync(import.meta.filename));console.log(JSON.stringify({ownedStage:owned,baselineFiles:sourceRows.length,officialSourceUnits:8,lockedPackages:2,cacheEqualsOfficialArchive:true,appWrites:0,originalExecutions:0}));
