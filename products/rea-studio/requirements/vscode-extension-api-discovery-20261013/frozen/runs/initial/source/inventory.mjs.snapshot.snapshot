  else if(ts.isPropertyDeclaration(n)||ts.isPropertySignature(n))next=add(n,'property',ctx,nodeName(n,'<property>'));
  else if(ts.isConstructorDeclaration(n))next=add(n,'constructor',ctx,'constructor');
  else if(ts.isGetAccessorDeclaration(n)||ts.isSetAccessorDeclaration(n))next=add(n,ts.isGetAccessorDeclaration(n)?'get-accessor':'set-accessor',ctx,nodeName(n,'<accessor>'));
  else if(ts.isEnumMember(n))next=add(n,'enum-member',ctx,nodeName(n,'<enum-member>'));
  else if(ts.isCallSignatureDeclaration(n)||ts.isConstructSignatureDeclaration(n)||ts.isIndexSignatureDeclaration(n))next=add(n,ts.isCallSignatureDeclaration(n)?'call-signature':ts.isConstructSignatureDeclaration(n)?'construct-signature':'index-signature',ctx,ts.isCallSignatureDeclaration(n)?'<call>':ts.isConstructSignatureDeclaration(n)?'<new>':'<index>');
  else if(ts.isTypeLiteralNode(n)){const owner=ctx;next={...ctx,qualified:ctx.qualified+'.<type-literal@'+n.getStart(sf)+'>',id:'inline-type:'+n.getStart(sf)};auxiliary.push({id:next.id,kind:'type-literal',parentID:owner.id,qualifiedName:next.qualified,span:span(n.getStart(sf),n.end),scope:'Inline public structural type, not an additional named API.'});}
  else if(ts.isFunctionTypeNode(n)||ts.isConstructorTypeNode(n)){const kind=ts.isFunctionTypeNode(n)?'function-type-signature':'constructor-type-signature';next=add(n,kind,ctx,'<'+kind+'@'+n.getStart(sf)+'>',n,'inline-signature');}
  else if(ts.isMappedTypeNode(n)){auxiliary.push({kind:'mapped-type',parentID:ctx.id,span:span(n.getStart(sf),n.end),scope:'Retained structural span; not expanded into concrete properties.'});}
  else {handled=false;if(ts.isImportDeclaration(n)||ts.isImportEqualsDeclaration(n)||ts.isExportDeclaration(n)||ts.isExportAssignment(n)||ts.isNamespaceExportDeclaration(n))unsupported.push({kind:sk,parentID:ctx.id,span:span(n.getStart(sf),n.end),reason:'Import/re-export binding not resolved by this finite syntax collector.'});}
  // Parameter and type-parameter syntax is retained on its direct owner; its
