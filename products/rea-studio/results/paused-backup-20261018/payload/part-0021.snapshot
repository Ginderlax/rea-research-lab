block=server[start:end]
block=once(block,"  if (action === 'save') return exclusive(async () => {", "  if (action === 'save') {\r\n    const request=Object.freeze({...input,tags:Array.isArray(input.tags)?Object.freeze([...input.tags]):input.tags});\r\n    if(request.newTodo!==undefined&&typeof request.newTodo!=='boolean')throw new Error('New to-do creation must use an explicit Boolean flag.');\r\n    return exclusive(async () => {")
block=block.replace('input.','request.')
# The declaration snapshots caller input before waiting; it must still read input.
block=once(block,'const request=Object.freeze({...input,tags:Array.isArray(request.tags)?Object.freeze([...request.tags]):request.tags});','const request=Object.freeze({...input,tags:Array.isArray(input.tags)?Object.freeze([...input.tags]):input.tags});')
