    {
      "id": "grafana.candidate.5450919a6e7a065d835e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you want to track Grafana usage via RudderStack specify _your_ RudderStack Write Key here. The `rudderstack_data_plane_url` must also be provided for this feature to be enabled. By default this feature is disabled.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[analytics]`",
        "`rudderstack_write_key`"
      ],
      "source": {
