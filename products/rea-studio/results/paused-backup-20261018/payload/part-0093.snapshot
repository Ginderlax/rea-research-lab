const notice=`# Metrics dispatch trials: preserved evidence\n\nThese exact finite component trials are unaccepted. Neither candidate changed production. The [measurement narrative](stage/MEASUREMENT-REVIEW.md.snapshot), [raw summary](stage/measurement-review.json), [timing table](stage/results/timing-summary.csv) and [memory table](stage/results/memory-summary.csv) retain regressions, ranges and negative deltas. The source-bound timing and memory figures are under stage/results/.\n\nThe frozen local inventory contains 1,069 files. This public preservation contains 1,067 exact mapped files, its unchanged validation receipt and three license texts. Two authenticated registry archives remain locally preserved and are explicitly excluded here. Selected unchanged released @grafana/data@13.2.3 verification sources retain Apache-2.0; the actual lodash4.17.23 source retains its MIT license. Separately pinned Grafana repository documentation retains the root AGPL license. These references are inert snapshots and do not enter the application runtime. The collection's existing license scope continues to apply.\n\nAll 420 measurement children passed and 852,516 memory output/cache checks passed. The standard p95 median regressed 1.42% against baseline; percentile all-99/all-124 medians regressed 10.22%/4.45%. Several control ranges overlap. Original bulk-percentile gains already belong to the baseline. Retained-minus-released p95 heap medians were identical for baseline and percentile candidate, so lower result-object footprint is unproven. Background Windows activity was uncontrolled, and memory sequences exceeded provisional estimates. No statistical significance, full-product result, full parity or universal superiority is established.\n`;
writeFileSync(join(destination,'README.md'),notice,{flag:'wx'});
writeFileSync(join(destination,'preservation-manifest.json'),JSON.stringify({schema:'rea-metrics-dispatch-measurement-preservation/v1',createdAtUtc:new Date().toISOString(),frozenLocalReceiptSha256:sha(receiptBytes),frozenInventoryFiles:1069,preservedMeasuredFiles:1067,snapshots,excludedLocalArchives:excluded,productionImplementation:{path:'products/rea-studio/apps/metrics/native-calculations.mjs',sha256:'9269cf8c32be9bf2c075b67019e82e41272d9495f0321fefc17b2c5695a91371'},selectedForIntegration:null,productionChanged:false,fullProductComplete:false,universalSuperiority:false,scope:'Exact source/log/figure preservation of two unaccepted component candidates, including failures and limits; public paths remap the selected lodash source and make all code snapshots inert. Original archives remain local.'},null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({snapshots:snapshots.length,excludedLocalArchives:excluded.length,manifestSha256:sha(readFileSync(join(destination,'preservation-manifest.json')))}));
