    },
    {
      "id": "grafana.candidate.1c2cbb7167faecf31e44",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now use Cisco Webex Teams as a contact point, to send alerts to a Webex Teams space.",
      "headingPath": [
        "What's new in Grafana v9.3",
        "Alerting",
        "Support for Webex Teams"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-3.md",
