      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.8b03167359167b7e9085",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana Enterprise includes integrations with more ways to authenticate your users and enhanced authentication capabilities.",
      "headingPath": [
        "Grafana Enterprise",
        "Authentication"
      ],
      "source": {
