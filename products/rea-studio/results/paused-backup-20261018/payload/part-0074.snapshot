    {
      "id": "grafana.candidate.9127a5787c166c7ada2d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If a user belongs to several organizations, then that user is counted once as a user in the highest organization role they are assigned, regardless of how many organizations the user belongs to.",
