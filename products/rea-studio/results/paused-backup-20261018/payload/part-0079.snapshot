    {
      "id": "grafana.candidate.d09048818e9374c746a3",
      "syntaxRole": "table-row",
      "sourceText": "| Style Rules | Apply styles based on feature properties <ul><li>**Rule** - allows you to select a _feature_, _condition_, and _value_ from the GeoJSON file in order to define a rule. The trash bin icon can be used to delete the current rule.</li><li>**Color** - configures the color of the style for the current rule</li><li>**Opacity** - configures the transparency level for the current rule</li> |",
      "headingPath": [
        "Geomap",
        "Configuration options",
        "Map layers options",
        "GeoJSON layer"
      ],
