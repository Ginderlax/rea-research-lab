    {
      "id": "grafana.candidate.2fa24cff2cbccba9d3c2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana can resolve the user's email address from the OAuth2 ID token, the user information retrieved from the OAuth2 UserInfo endpoint, the OAuth2 access token, or the OAuth2 `/emails` endpoint. Grafana looks at these sources in the order listed until an email address is found. If no email is found, then the email address of the user is set to an empty string.",
      "headingPath": [
        "Configure Generic OAuth authentication",
        "Configure generic OAuth authentication client using the Grafana configuration file",
        "Configure email address"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/generic-oauth/index.md",
        "gitBlobSha": "996494cdc76551860001d5497ab4650b4563badf",
        "sha256": "93bacfb30c084c7dd0e225675e875cd091c4a0ef7a5053c330ccb6c9cd367d87",
