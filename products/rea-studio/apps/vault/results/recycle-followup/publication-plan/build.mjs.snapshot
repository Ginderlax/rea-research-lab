async function ident(p){const b=await fs.readFile(p);return{bytes:b.length,sha256:hash(b)};}
async function inventory(dir,prefix='',excluded=new Set(),skipLocal=false){let rows=[];for(const e of await fs.readdir(dir,{withFileTypes:true})){assert.equal(e.isSymbolicLink(),false);const rel=prefix+e.name;if(e.isDirectory()){if(!(skipLocal&&rel==='.local'))rows.push(...await inventory(path.join(dir,e.name),rel+'/',excluded,skipLocal));}else if(!excluded.has(rel))rows.push(rel);}return rows.sort();}
const payload=[];async function authenticate(e){const dir=path.join(workspace,e.folder),m=await fs.readFile(path.join(dir,e.manifestName)),r=await fs.readFile(path.join(dir,e.receiptName));assert.equal(hash(m),e.manifestSha);assert.equal(hash(r),e.receiptSha);const manifest=JSON.parse(m),rows=manifest.files??manifest.records;assert.equal(rows.length,e.count);assert.deepEqual(await inventory(dir,'',new Set([e.manifestName,e.freezeName]),e.skipLocal),rows.map(r=>r.path).sort());for(const row of rows){assert.ok(!path.isAbsolute(row.path)&&!row.path.split('/').includes('..'));assert.deepEqual(await ident(path.join(dir,row.path)),{bytes:row.bytes,sha256:row.sha256});}return{...e,receipt:{bytes:r.length,sha256:hash(r)},manifest:{bytes:m.length,sha256:hash(m)},freeze:await ident(path.join(dir,e.freezeName)),rows};}
const before=[];for(const e of epochs){const auth=await authenticate(e);before.push(auth);for(const row of [...auth.rows,...[e.manifestName,e.freezeName].map(name=>({path:name,...(name===e.manifestName?auth.manifest:auth.freeze)}))])payload.push({epoch:e.id,sourceRoot:e.folder,sourcePath:row.path,sourceAbsolute:path.join(workspace,e.folder,row.path),bytes:row.bytes,sha256:row.sha256});}
const magic=[['MZ',Buffer.from('4d5a','hex')],['ZIP',Buffer.from('504b0304','hex')],['ZIP-empty',Buffer.from('504b0506','hex')],['GZIP',Buffer.from('1f8b','hex')],['7Z',Buffer.from('377abcaf271c','hex')],['RAR',Buffer.from('526172211a07','hex')],['XZ',Buffer.from('fd377a585a00','hex')],['ZSTD',Buffer.from('28b52ffd','hex')],['KDBX',Buffer.from('03d9a29a67fb4bb5','hex')]],unique=new Map(),contentRows=[],emailPatterns=new Map();
