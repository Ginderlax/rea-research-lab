    {
      "id": "grafana.candidate.794f5d954881938880c7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When a user logs in using an OAuth2 provider, Grafana verifies that the access token has not expired. When an access token expires, Grafana uses the provided refresh token (if any exists) to obtain a new access token.",
      "headingPath": [
        "Configure Generic OAuth authentication",
        "Configure generic OAuth authentication client using the Grafana configuration file",
        "Configure a refresh token"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/generic-oauth/index.md",
        "gitBlobSha": "996494cdc76551860001d5497ab4650b4563badf",
        "sha256": "93bacfb30c084c7dd0e225675e875cd091c4a0ef7a5053c330ccb6c9cd367d87",
        "lineStart": 205,
        "lineEnd": 205,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/generic-oauth/index.md#L205-L205"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.cb19519f6f9bd8b68b59",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana uses a refresh token to obtain a new access token without requiring the user to log in again. If a refresh token doesn't exist, Grafana logs the user out of the system after the access token has expired.",
      "headingPath": [
        "Configure Generic OAuth authentication",
        "Configure generic OAuth authentication client using the Grafana configuration file",
        "Configure a refresh token"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/generic-oauth/index.md",
        "gitBlobSha": "996494cdc76551860001d5497ab4650b4563badf",
