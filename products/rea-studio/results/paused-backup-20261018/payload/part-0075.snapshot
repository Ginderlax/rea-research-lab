    },
    {
      "id": "grafana.candidate.277b89187b1fe66e0e8b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Notification history stores Alertmanager notification logs in Loki. In Grafana OSS and Grafana Enterprise, configure the connection to Loki in the `[unified_alerting.notification_history]` section of your Grafana configuration file:",
      "headingPath": [
        "View notification history",
        "Before you begin"
      ],
