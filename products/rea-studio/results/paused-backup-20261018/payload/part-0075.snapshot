    {
      "id": "grafana.candidate.53b24596b824677936f5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For details on how to configure grouping and routing, refer to [handling notifications](ref:notifications) and [`No Data` and `Error` alerts](ref:no-data-and-error-alerts) documentation.",
      "headingPath": [
        "Handle connectivity errors in alerts",
        "Handle query errors in Grafana Alerting",
        "Reduce redundant error notifications"
      ],
      "source": {
        "path": "docs/sources/alerting/guides/connectivity-errors.md",
        "gitBlobSha": "ac013ad7e78eb6f989a82991e5d246600a3e436d",
        "sha256": "a3943a943a9907ac7c1b3b13ba6b8f1519bbda6b9a19cf01591f2ade20d35b63",
        "lineStart": 218,
        "lineEnd": 218,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/guides/connectivity-errors.md#L218-L218"
      },
