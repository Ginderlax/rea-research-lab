    {
      "id": "grafana.candidate.d74151a6720ef0195ce9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can use the Kubernetes `--dry-run` command to send requests to modifying endpoints and determine if the request would have succeeded.",
      "headingPath": [
        "Deploy Grafana on Kubernetes",
        "Troubleshooting",
        "Using the --dry-run command"
      ],
      "source": {
