    {
      "id": "grafana.candidate.3be1e34ab93c9e2c687b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Starting with Grafana v13.2, the Zipkin data source is a standalone plugin, preinstalled in both Grafana OSS and Enterprise. This enables more frequent updates independent of Grafana releases. Grafana automatically checks the plugin catalog and installs the latest version on each server restart.",
      "headingPath": [
        "Zipkin data source",
        "Plugin updates"
      ],
      "source": {
        "path": "docs/sources/datasources/zipkin/_index.md",
