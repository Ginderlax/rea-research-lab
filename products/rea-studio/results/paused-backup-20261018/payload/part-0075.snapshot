    {
      "id": "grafana.candidate.0b4baa9df1c59cfa056b",
      "syntaxRole": "list-item",
      "sourceText": "- _`<EXTERNAL_ID>`_ is the external ID that your IAM role's trust policy requires.",
      "headingPath": [
        "Use Terraform to provision secure values",
        "Provision a keeper",
        "Define a keeper"
      ],
      "source": {
        "path": "docs/sources/as-code/infrastructure-as-code/terraform/terraform-secrets-management.md",
        "gitBlobSha": "52977e9c09c75dbafbdbbdb7ab05a511e921e281",
        "sha256": "408746cac5de95be048c327c72a92ce56e80f5a9bcb4614d2ab66a4dc946630b",
        "lineStart": 463,
        "lineEnd": 463,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/as-code/infrastructure-as-code/terraform/terraform-secrets-management.md#L463-L463"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
