    {
      "id": "grafana.candidate.5cc69e1f99fa16e14bca",
      "syntaxRole": "list-item",
      "sourceText": "- **Logs**: Control access to log lines using LogQL queries with labels such as `namespace` or `cluster`.",
      "headingPath": [
        "Label Based Access Control (LBAC) for data sources",
        "Logs, metrics, and traces filtering with LBAC"
      ],
      "source": {
