    },
    {
      "id": "grafana.candidate.5c0b34f6aae6e3ec73eb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you want to show one gauge per cell you can change the **Show** setting from **Calculate** to **All values** and each bar is labeled by concatenating the text column with each value's column name.",
      "headingPath": [
        "Bar gauge",
        "Supported data formats",
        "Example 3"
      ],
