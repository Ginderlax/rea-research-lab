import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import {createHash} from 'node:crypto';
const root=import.meta.dirname,work=path.dirname(root),bundle=path.join(work,'keepass-history-production-integration-bundle-ready'),sha=b=>createHash('sha256').update(b).digest('hex');
const read=(dir,n)=>fs.readFile(path.join(dir,n)),json=async(dir,n)=>JSON.parse(await read(dir,n));
const app='products/rea-studio/apps/vault/';
const source=await read(bundle,app+'README.md');assert.equal(sha(source),'f1d508dddf2fd2a1772a5abdaa99db9cfe2654ff2dbd1bb17cdf4369851a75cf');
await fs.writeFile(path.join(root,'README.baseline.md.snapshot'),source,{flag:'wx'});
const proposed=await fs.readFile(path.join(root,'README.md'),'utf8');
const history=['# REA Vault entry history — scoped behavior and evidence\n','This public-facing proposal describes the accepted finite history slice. Complete KeePass product/manual parity remains open. Production full-suite evidence is a separate root-owned campaign.\n',proposed.slice(proposed.indexOf('## Entry history'),proposed.indexOf('## Storage and secrets')),proposed.slice(proposed.indexOf('## Recorded validation'),proposed.indexOf('## Remaining product coverage')),'## Open history and product contracts\n\nSelected-history deletion, history comparison, limit-settings editing, age-based maintenance, the original dialog/event behavior and full group-move semantics remain open. Preserving imported metadata does not implement every corresponding workflow. The separate199 manual supplement and existing159-source/232-capability registry are preserved finite discovery records; full manual/product acceptance is still required.\n'].join('\n');
await fs.writeFile(path.join(root,'HISTORY.md'),history,{flag:'wx'});
const delta=[
{from:'expiration/history/recycle-bin workflows;',to:'expiration workflows; history comparison/deletion/settings/age cleanup and recycle-bin recovery;'},
{from:'Imported groups, attachments, history, custom data and auto-type settings are preserved for export, while their corresponding KeePass workflows are not implemented.',to:'Imported groups, attachments, custom data and auto-type settings are preserved for export. Selected native history editing/restoration is described below; the other corresponding KeePass workflows remain open.'},
{from:"The server/client code is an original Node.js/DOM implementation using standard-library cryptographic primitives. It imports no upstream implementation or prior lab reconstruction.",to:'The server/client use native Node.js/DOM code and standard-library cryptographic primitives. The bounded history slice is source-assisted and retains GPL-2.0-or-later attribution to KeePass2.61.1; production execution imports no upstream runtime or prior lab reconstruction.'}
];
let updated=source.toString('utf8');for(const e of delta){assert.equal(updated.split(e.from).length,2,e.from);updated=updated.replace(e.from,e.to);}
const start=updated.indexOf('## Entry history and safe editor publication');assert(start>=0);
const old=updated.slice(start),replacement=`## Entry history and safe editor publication\n\nChanged content creates an encrypted previous version; a no-op save updates access without a new revision. Explicit history previews start masked. Confirmed restoration backs up the current entry, restores represented fields/metadata and preserves its identity, placement and maintained history. Restore refuses unsaved editor changes before an effect. Drafts entered during pending Save/Restore and newer selections survive late responses. View cleanup cancels its timer and blocks disposed publications. Imported count/size limits apply within the documented local bounds.\n\n[HISTORY.md](HISTORY.md) describes the exact supported fields, pruning/deviation bounds, fixture prerequisites, source/licensing citations and remaining manual/product gaps. The source-bound current-layout adapter passed41 focused groups and separately replayed11 author-run probes. The accepted independent review separately passed11 probes and actual private-browser held-response/restore/restart checks. The focused original campaign made24 authenticated assembly loads; its edit ordering was partly source-composed, with original GUI and original Touch execution counts0. These campaigns remain separate. Historical compatibility18 retains its original sources.\n\nThe [current preservation manifest](results/history-followup/preservation-manifest.json) maps the original1454 stage to1442 public inert snapshots and12 local-only sourceZIP payloads (four named and eight acquisition copies). The bundle contains1656 total public evidence files, including the final82-artifact independent review and historical failures. Public .local directory segments are mapped to private-study-records; original paths/hashes remain recorded. No original EXE/DLL/sourceZIP bytes are embedded publicly. See the [source-assisted license notice](results/history-followup/NOTICE.md) and exact released licenses linked there. Full parity, original-grade security and superiority remain unestablished.\n`;
updated=updated.slice(0,start)+replacement;delta.push({from:old,to:replacement});
await fs.writeFile(path.join(root,'README.proposal.md'),updated,{flag:'wx'});
await fs.writeFile(path.join(root,'README-delta.json'),JSON.stringify({schema:'rea-vault-history-readme-doc-only-delta/v1',baseline:{path:app+'README.md',bytes:source.length,sha256:sha(source)},changes:delta,newHistoryFile:'HISTORY.md',runtimeChanges:0,oldEvidenceChanged:false,proposalOnly:true},null,2)+'\n',{flag:'wx'});

const study=await json(root,'source-study.json'),contracts=[];
async function span(id,file,from,to,meaning){const b=await read(root,'.local/pinned-source/'+file),lines=b.toString('utf8').split(/(?<=\n)/),offset=Buffer.byteLength(lines.slice(0,from-1).join('')),raw=Buffer.from(lines.slice(from-1,to).join('')),context=Buffer.from(lines.slice(Math.max(0,from-4),Math.min(lines.length,to+3)).join(''));assert(from>=1&&to<=lines.length&&raw.length>0);contracts.push({id,source:file,sourceBytes:b.length,sourceSha256:sha(b),lineStart:from,lineEnd:to,utf8ByteOffset:offset,utf8ByteLength:raw.length,rawSpanSha256:sha(raw),contextSha256:sha(context),meaning,evidenceStrength:'Authenticated exact released source only; future original helper/runtime acceptance pending.',originalExecutions:0});}
await span('KPS2611-RECYCLE-CREATE','KeePass/Forms/MainForm_Functions.cs',5044,5069,'Create a missing root-child bin with trash icon, no searching/Auto-Type; root cannot serve as bin.');
await span('KPS2611-RECYCLE-ENTRY-CLASSIFY','KeePass/Forms/MainForm_Functions.cs',5071,5095,'Classify permanence using bin enablement, explicit Shift and UUID/ancestry membership.');
await span('KPS2611-RECYCLE-ENTRY-MUTATE','KeePass/Forms/MainForm_Functions.cs',5161,5190,'Remove from parent; permanent deletion adds tombstone; recycle adds entry to bin with location/previous parent and Touch(false).');
await span('KPS2611-RECYCLE-PREVIOUS-PARENT-GUARD','KeePass/Forms/MainForm_Functions.cs',6894,6911,'Reject zero, absent or same previous parent and entries without a current parent.');
await span('KPS2611-RECYCLE-RESTORE-MOVE','KeePass/Forms/MainForm_Functions.cs',7021,7046,'Move selected entry to valid previous parent with location tracking and update previous-parent UUID; no Touch call on this path.');
await span('KPS2611-RECYCLE-ENTRY-OWNERSHIP','KeePassLib/PwGroup.cs',1334,1348,'AddEntry with ownership updates parent; optional location change uses current UTC time.');
await span('KPS2611-RECYCLE-ENTRY-TOUCH','KeePassLib/PwEntry.cs',536,561,'Touch updates last access/usage, conditionally modification, raises event and optionally touches parents.');
await span('KPS2611-RECYCLE-EMPTY-FUTURE','KeePassLib/PwGroup.cs',1367,1387,'Recursive DeleteAllObjects clears contents and adds tombstones; deferred outside first entry-only proposal.');
await span('KPS2611-HISTORY-DELETE-ALTERNATIVE','KeePass/Forms/PwEntryForm.cs',1465,1478,'Delete only selected historic items from editable dialog list; durable Save/Cancel requires separate contract.');
const ledgerPath='keepass-manual-requirements-next/supplement/manual-contracts.json',ledgerBytes=await read(work,ledgerPath),ledger=JSON.parse(ledgerBytes),manualPath='keepass-manual-requirements-next/source/manual/help/v2/entry.html',manualBytes=await read(work,manualPath),record=ledger.requirements.find(e=>e.id==='KPM2611-HISTORY-DELETE-SPECIFIC');assert(record);for(const c of record.citations){assert.equal(sha(manualBytes),c.topicSha256);assert.equal(sha(manualBytes.subarray(c.utf8ByteOffset,c.utf8ByteOffset+c.utf8ByteLength)),c.rawSpanSha256);}
await fs.writeFile(path.join(root,'next-contracts.json'),JSON.stringify({schema:'rea-keepass-next-source-contracts/v1',sourceArchive:study.originalArchive,contracts,manualAlternative:{id:record.id,requirement:record.requirement,citations:record.citations,ledgerSha256:sha(ledgerBytes)},manualRecycleCoverage:'Prior finite45-topic shipped manual text search found no recycle match; original source provides the proposed contract. No existing KPM ID assigned.',sourceOnly:true,implemented:false,originalExecutions:0,candidateAcceptanceExecutions:0},null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({docs:['README.md','README.proposal.md','HISTORY.md','README-delta.json','NOTES.md'],sourceContracts:contracts.length,manualRecordVerified:record.id,productionEdited:false,originalExecutions:0,runtimeTests:0}));
