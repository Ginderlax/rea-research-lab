import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { readFileSync, writeFileSync, copyFileSync, mkdirSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
const workspace = 'C:/Users/evanh/Documents/Codex/2026-10-12/go';
const lab = join(workspace, 'outputs/rea-research-lab'), product = join(lab, 'products/rea-studio');
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const read = path => JSON.parse(readFileSync(path, 'utf8'));
const save = (path, value) => writeFileSync(path, JSON.stringify(value, null, 2) + '\n');
const identity = path => { const bytes = readFileSync(join(lab, path)); return { path, bytes: bytes.length, sha256: sha(bytes) }; };
const flow = read(join(workspace, 'work/native-flow-browser-checks.json'));
const metrics = read(join(workspace, 'work/native-metrics-browser-checks.json'));
const backup = read(join(workspace, 'work/native-backup-browser-checks.json'));
const flowFixture = readFileSync(join(product, 'apps/flow/fixtures/native-demo.json'));
assert.ok(flowFixture.equals(readFileSync(flow.downloads.unchanged)), 'Native flow unchanged download differs');
const expectedFlow = JSON.parse(flowFixture.toString()); expectedFlow[1].id = 'inject.current'; expectedFlow[1].name = 'Temperature 10'; expectedFlow[1].props[0].v = '10';
assert.deepEqual(read(flow.downloads.edited), expectedFlow, 'Native flow edited JSON contains unexpected edits');
const metricFixture = readFileSync(join(product, 'apps/metrics/fixtures/native-stat-dashboard.json'));
assert.ok(metricFixture.equals(readFileSync(metrics.downloads.unchanged)), 'Grafana unchanged download differs');
const expectedMetric = JSON.parse(metricFixture.toString()); expectedMetric.panels[0].options.reduceOptions.calcs = ['mean', 'p50'];
assert.deepEqual(read(metrics.downloads.edited), expectedMetric, 'Grafana edited export changes unsupported fields');
const backupWorkspace = join(lab, '.local/rea-studio-native-core-demo/backup/workspace');
const backupSource = readFileSync(join(backupWorkspace, 'backup/source/hello.txt'));
assert.ok(backupSource.equals(readFileSync(join(backupWorkspace, 'backup/native-browser-restored/source/hello.txt'))), 'Restic browser restore differs');
assert.ok(backup.checks.every(check => check.passwordCleared === true), 'Browser password field was not cleared');
const recordFiles = readdirSync(join(lab, '.local/rea-studio-native-core-demo/backup/records'));
for (const name of recordFiles) assert.ok(!readFileSync(join(lab, '.local/rea-studio-native-core-demo/backup/records', name)).includes(Buffer.from('synthetic-browser-fixture-password')), 'Request password retained in records');
const screenshots = [];
