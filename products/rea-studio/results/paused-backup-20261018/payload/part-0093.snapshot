  }
  function mayDiscard() { return !dirty || window.confirm('Discard this unsaved draft?'); }
  async function refresh() {
    const generation=++refreshGeneration,response = await api('list', { search: search.value, tag: tag.value, notebookId: notebookFilter.value, trash: trash.checked, todoFilter: todoFilter.value });
    if(!mounted||generation!==refreshGeneration)return;
    const nextOrganization=await api('notebook-list');if(!mounted||generation!==refreshGeneration)return;organizationState=nextOrganization;
    const chosenDraft=notebook.options.length?notebook.value:(current?.notebookId??'__default__'),chosenManaged=organizationChoice.value,chosenParent=organizationParent.value,chosenDestination=noteDestination.value;
    function choices(control,first,value,manage=false){control.replaceChildren(Object.assign(el('option',first),{value}));for(const row of organizationState.notebooks){const option=Object.assign(el('option',`${'  '.repeat(Math.max(0,row.depth-1))}${row.path} Â· ${row.id.slice(0,6)}`),{value:row.id});option.textContent+=(row.trashed?' Â· trash':'');option.disabled=manage?!(row.editable||row.restoreEligible):!row.editable;control.append(option);}}
    choices(notebook,'Notes (created when saved)','__default__');notebook.insertBefore(Object.assign(el('option','Unfiled'),{value:''}),notebook.children[1]??null);notebook.value=chosenDraft;choices(organizationChoice,'Choose a notebook','',true);organizationChoice.value=chosenManaged;choices(organizationParent,'Top level','');organizationParent.value=chosenParent;choices(noteDestination,'Unfiled','');noteDestination.value=chosenDestination;organizationRows.replaceChildren();for(const row of organizationState.notebooks)organizationRows.append(el('p',`${'â€” '.repeat(Math.max(0,row.depth-1))}${row.title} (${row.notes} notes)${row.trashed?' Â· trash':row.editable?'':' Â· retained shared metadata'}`));
    const oldTag = tag.value, oldNotebook = notebookFilter.value; tag.replaceChildren(Object.assign(el('option', 'All tags'), { value: '' })); notebookFilter.replaceChildren(Object.assign(el('option', 'All notebooks'), { value: '' }));
    for (const value of response.tags) tag.append(Object.assign(el('option', value), { value })); for (const row of organizationState.notebooks) notebookFilter.append(Object.assign(el('option',row.path+' Â· '+row.id.slice(0,6)),{value:row.id})); tag.value = oldTag; notebookFilter.value = oldNotebook;
    list.replaceChildren(el('h3', `${response.total} notes`));
    if (!response.notes.length) list.append(el('p', 'No matching notes.', 'muted'));
    for (const note of response.notes) { const button = el('button', `${note.title} Â· ${note.notebook} Â· ${note.tags.join(', ')}`, 'button'), snippet = el('p', (note.todo?.isTodo ? (note.todo.completed ? '[Completed to-do] ' : '[Open to-do] ') : '') + note.preview, 'muted'); button.onclick = () => run(async () => { if (!mayDiscard()) return; accept(await api('get', { id: note.id })); status.textContent = `Opened revision ${current.revision}.`; }); list.append(button, snippet); }
  }
  searchButton.onclick = () => run(refresh); search.onkeydown = event => { if (event.key === 'Enter') run(refresh); }; tag.onchange = notebookFilter.onchange = trash.onchange = todoFilter.onchange = () => run(refresh);
  function newDraft(isTodo) {
    if (!mounted || organizationBusy || !mayDiscard()) return;
    accept(null, isTodo); title.focus(); status.textContent = isTodo ? 'New to-do draft. Save to create it.' : 'New note draft.';
  }
  newButton.onclick = () => newDraft(false);
  newTodoButton.onclick = () => newDraft(true);
  async function saveNote() {
    if (!mounted || saveBusy) return;
    const generation=editorGeneration,revision=draftRevision,values=[title.value,notebook.value,tags.value,body.value],cleanTags = current && tags.value === current.tags.join(', ') ? current.tags : tags.value.split(',').map(value => value.trim()).filter(Boolean);
    const request={ id: current?.id, revision: current?.revision ?? 0, title: values[0], body: values[3], ...(values[1]==='__default__'?{notebook:'Notes'}:{notebookId:values[1]}), tags: cleanTags, ...(!current && draftIsTodo ? {newTodo:true} : {}) };
    let ownedGeneration=generation;saveBusy=true;save.disabled=true;refreshTodo();
    try {
      const note = await api('save', request);
      if(!mounted||generation!==editorGeneration)return;
      if(revision!==draftRevision||values.some((value,index)=>value!==[title.value,notebook.value,tags.value,body.value][index])){
        current=note;draftIsTodo=false;dirty=true;refreshTodo(true);status.textContent=`Saved revision ${note.revision}. Your newer draft is retained.`;return;
      }
      accept(note);const publishedGeneration=editorGeneration;ownedGeneration=publishedGeneration;await refresh();
      if(mounted&&publishedGeneration===editorGeneration&&revision===draftRevision)status.textContent = `Saved revision ${note.revision}.`;
    } catch(error) {
      if(mounted&&ownedGeneration===editorGeneration)status.textContent=error.message;
    } finally {
      saveBusy=false;if(mounted){save.disabled=Boolean(current?.deletedAt);refreshTodo();}
    }
  }
  save.onclick = () => run(saveNote);
  organizationChoice.onchange=()=>{const row=organizationState.notebooks.find(row=>row.id===organizationChoice.value);organizationName.value=row?.title??'';organizationParent.value=row?.parentId??'';};
  async function organize(operation){if(!mounted||organizationBusy)return;if(dirty)throw new Error('Save your draft before changing notebook organization.');const controls=[...organizationControls,...todoControls,todoFilter,title,notebook,tags,body,save,search,tag,notebookFilter,trash,searchButton,newButton,newTodoButton,remove,restore,attachmentUpload,upload],previous=controls.map(control=>control.disabled);organizationBusy=true;organization.setAttribute('aria-busy','true');for(const control of controls)control.disabled=true;let cancelled=false;try{const result=await operation();cancelled=result===false;if(!mounted||cancelled)return;if(current)accept(await api('get',{id:current.id}));if(mounted)await refresh();}finally{organizationBusy=false;if(mounted){organization.setAttribute('aria-busy','false');controls.forEach((control,index)=>control.disabled=previous[index]);save.disabled=Boolean(current?.deletedAt);moveNote.disabled=!current||Boolean(current.deletedAt);if(current&&!cancelled)accept(current);refreshTodo();}clearConfirmation();}}
  createNotebook.onclick=()=>run(()=>organize(async()=>{const result=await api('notebook-create',{revision:organizationState.revision,title:organizationName.value,parentId:organizationParent.value});organizationChoice.append(Object.assign(el('option',result.notebook.path),{value:result.notebook.id}));organizationChoice.value=result.notebook.id;status.textContent='Notebook created.';}));
  renameNotebook.onclick=()=>run(()=>organize(async()=>{await api('notebook-rename',{revision:organizationState.revision,id:organizationChoice.value,title:organizationName.value});status.textContent='Notebook renamed; note identities are preserved.';}));
  moveNotebook.onclick=()=>run(()=>organize(async()=>{await api('notebook-move',{revision:organizationState.revision,id:organizationChoice.value,parentId:organizationParent.value});status.textContent='Notebook moved with its descendants.';}));
  trashNotebook.onclick=()=>run(()=>organize(async()=>{const row=organizationState.notebooks.find(row=>row.id===organizationChoice.value);if(!row?.trashEligible)throw new Error('Choose an active local notebook.');const id=row.id,revision=organizationState.revision;if(!await confirmNotebook({heading:'Move notebook to trash?',scope:`Move â€œ${row.path}â€ and all its subnotebooks and regular notes to trash? Attachments remain stored. You can restore this notebook.`,submitLabel:'Confirm move to trash',pendingLabel:'Moving the notebook and its descendants to trashâ€¦',trigger:trashNotebook}))return false;if(!mounted)return false;await api('notebook-trash',{id,revision,confirmed:true});if(mounted)status.textContent='Notebook and descendants moved to trash.';}));
  restoreNotebook.onclick=()=>run(()=>organize(async()=>{const row=organizationState.notebooks.find(row=>row.id===organizationChoice.value);if(!row?.restoreEligible)throw new Error('Choose a trashed local notebook.');const id=row.id,revision=organizationState.revision;if(!await confirmNotebook({heading:'Restore notebook?',scope:`Restore â€œ${row.path}â€, its trashed subnotebooks and notes, including notes trashed separately? If its parent remains in trash, this notebook becomes top level.`,submitLabel:'Confirm restore notebook',pendingLabel:'Restoring the notebook and its contentsâ€¦',trigger:restoreNotebook}))return false;if(!mounted)return false;await api('notebook-restore',{id,revision,confirmed:true});if(mounted)status.textContent='Notebook restored with its contents.';}));
