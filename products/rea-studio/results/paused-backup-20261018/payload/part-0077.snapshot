    {
      "id": "grafana.candidate.6b680599d61d305f5f75",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For SQL data sources (MySql, Postgres, MSSQL) you can override the default allowed number of idle connections (default: 100). The value configured in data source settings is preferred over the default value.",
