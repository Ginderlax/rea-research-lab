    },
    {
      "id": "grafana.candidate.c2725c380b1642739543",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Branch protection rules at your Git provider enforce how changes are made to specific branches. When enabled on the branch that Git Sync targets, these rules require Git Sync to create pull requests instead of pushing commits directly.",
      "headingPath": [
        "Configure Git repository protection",
        "Protect your branch"
      ],
      "source": {
