    {
      "id": "grafana.candidate.2df079dadaae593d46fa",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This transformation enables panel config (Threshold, Min, Max, etc.) to be derived from query results. For more information, refer to [Config from query results](../../panels-visualizations/query-transform-data/transform-data/#config-from-query-results).",
      "headingPath": [
        "What's new in Grafana v8.1",
        "Annotation panel",
        "Transformations improvements",
        "Config from query (Beta)"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-1.md",
