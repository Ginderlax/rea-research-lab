  assert.equal(verification.artifactSHA256, descriptor.digest); assert.equal(verification.archiveBytes, descriptor.archiveBytes); assert.equal(verification.files.length, descriptor.readableFiles); assert.equal(verification.allCRCAndBytesReadable, true); assert.equal(verification.recordedContractPassed, true); assert.deepEqual(verification.evidenceConsistencyErrors, []);
  assert.equal(verification.all62CurrentGitBlobsIndependentlyVerified, true); assert.equal(verification.all21CurrentPinsVerified, true); assert.equal(verification.sourceSnapshotFilesVerified, descriptor.snapshots); assert.equal(verification.eligibleGitBlobsIndependentlyAuthenticated, descriptor.snapshots);
  if (role === 'finite') { assert.equal(verification.finite161RecordedPass, true); assert.equal(verification.overlappingTargeted3RecordedPass, true); assert.equal(verification.targeted3AlreadyWithinFinite161, true); assert.equal(verification.targetedAndFiniteCountsAggregated, false); }
  const zip = fs.readFileSync(backup + '.zip'); assert.deepEqual(identity(zip), { bytes: descriptor.archiveBytes, sha256: descriptor.digest });
  const files = new Map(verification.files.map(row => [safe(row.path), row])); assert.equal(files.size, verification.files.length);
  const omit = name => name.startsWith('installed-source/') || name.startsWith(role === 'finite' ? 'verification/source/' : 'source/');
  const omitted = [...files.values()].filter(row => omit(row.path)).map(row => ({ sourcePath: row.path, bytes: row.bytes, sha256: row.sha256 }));
  assert.equal(omitted.length, descriptor.snapshots + 84);
  const retained = [...files.keys()].filter(name => !omit(name)); assert.equal(retained.length, role === 'finite' ? 21 : 44);
  function artifactBytes(name) { const bytes = read(evidence, name), row = files.get(name); assert(row); assert.deepEqual(identity(bytes), { bytes: row.bytes, sha256: row.sha256 }); return bytes; }
  const records = [], objects = new Map(); let rawBytes = 0;
  function save(sourcePath, bytes, origin) {
    safe(sourcePath); assert(!records.some(row => row.sourcePath === sourcePath)); assert(!credentials.test(bytes.toString('utf8'))); rawBytes += bytes.length; assert(rawBytes <= 16 * 1024 * 1024);
    let stored = bytes, encoding = 'identity'; if (bytes.length > 65536) { const compressed = gzipSync(bytes, { level: 9 }); if (compressed.length < bytes.length * .85) { stored = compressed; encoding = 'gzip'; assert.deepEqual(gunzipSync(stored), bytes); } }
    const pin = identity(bytes), suffix = bytes.subarray(0, 8).equals(Buffer.from('89504e470d0a1a0a', 'hex')) ? '.png' : encoding === 'gzip' ? '.gz.snapshot' : sourcePath.startsWith('portable-artifact/') ? '.zip.snapshot' : '.snapshot';
    const relative = 'payload/' + pin.sha256 + suffix, storedPin = identity(stored);
    if (!objects.has(relative)) { fs.writeFileSync(path.join(target, relative), stored, { flag: 'wx' }); objects.set(relative, storedPin); }
    assert.deepEqual(read(target, relative), stored); records.push({ sourcePath, path: relative, ...pin, storage: { encoding, ...storedPin }, origin });
  }
  for (const name of retained) save('artifact/' + name, artifactBytes(name), 'Exact non-source-subtree bytes from this role-specific verified hosted artifact');
  save('portable-artifact/complete-github-artifact.zip', zip, 'Exact digest-matched complete outer GitHub artifact ZIP, including its complete readable inner evidence ZIP and every source snapshot; no acquired original vendor programs');
  save('local/local-installed-archive-backup-verification.json', verificationBytes, 'Complete outer/inner ZIP CRC/readability and current source/recorded-contract reader receipt');
  save('local/installed-collection-summary.json', collectionBytes, 'Explicit two-job read-only run/job/artifact binding; scopes remain separate');
  save('local/native-artifacts-and-original-observation-readback.json', nativeBytes, 'Native8 byte/CRC readbacks, one worker observation and retained original comparison-record checks');
  const logBytes = fs.readFileSync(jobMetadata.rawJobLog.path); assert.deepEqual(identity(logBytes), { bytes: jobMetadata.rawJobLog.bytes, sha256: jobMetadata.rawJobLog.sha256 }); save('wrapper/job-' + job + '.txt', logBytes, 'Exact actual hosted job wrapper log');
  for (const row of collection.controlPlane) { const bytes = fs.readFileSync(row.path); assert.deepEqual(identity(bytes), { bytes: row.bytes, sha256: row.sha256 }); save('control-plane/' + row.kind + '.json', bytes, 'Raw authenticated GitHub API response containing both explicit job identities'); }
  for (const name of ['collect-installed-archive-38911241646.mjs', 'unpack-installed-archive-run-38911241646.py', 'verify-installed-archive-native-run-38911241646.py']) save('readers/' + name, read(work, name), 'Exact read-only orchestration/backup reader source; no product execution');
