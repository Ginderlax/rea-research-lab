import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';const here=import.meta.dirname,sha=b=>createHash('sha256').update(b).digest('hex'),inventory={};async function walk(base,prefix=''){for(const e of(await fs.readdir(base,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){assert(!e.isSymbolicLink());const rel=prefix+e.name;if(e.isDirectory())await walk(path.join(base,e.name),rel+'/');else{assert.notEqual(rel,'freeze-manifest.json');const b=await fs.readFile(path.join(base,e.name));inventory[rel]={bytes:b.length,sha256:sha(b)};}}}await walk(here);const rb=await fs.readFile(path.join(here,'validation.json')),m={schema:'rea-editor-current-search-save-browser-freeze/v1',at:new Date().toISOString(),files:Object.keys(inventory).length,totalBytes:Object.values(inventory).reduce((n,r)=>n+r.bytes,0),receiptSHA256:sha(rb),inventory,selfExcluded:true,strict:true};const b=Buffer.from(JSON.stringify(m,null,2)+'\n');await fs.writeFile(path.join(here,'freeze-manifest.json'),b,{flag:'wx'});for(const[p,r]of Object.entries(inventory)){const current=await fs.readFile(path.join(here,p));assert.deepEqual({bytes:current.length,sha256:sha(current)},r);}console.log(JSON.stringify({files:m.files,receiptSHA256:m.receiptSHA256,manifestSHA256:sha(b)}));
