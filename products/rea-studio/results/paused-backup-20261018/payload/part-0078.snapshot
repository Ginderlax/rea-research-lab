    {
      "id": "grafana.candidate.5243c1ee8692807aa6f2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "What story are you trying to tell with your dashboard? Try to create a logical progression of data, such as large to small or general to specific. What is the goal for this dashboard? (Hint: If the dashboard doesn't have a goal, then ask yourself if you really need the dashboard.)",
      "headingPath": [
        "Grafana dashboard best practices",
        "Best practices for creating dashboards",
        "Before you begin",
        "A dashboard should tell a story or answer a question"
      ],
