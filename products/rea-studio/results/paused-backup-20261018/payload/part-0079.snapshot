    {
      "id": "grafana.candidate.5eb154a170a4b5f23835",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We've updated data links so that you can add them to almost all elements or element properties that are tied to data. Previously, you could only add data links to text elements or elements that used the `TextConfig` object. This update removes that limitation.",
      "headingPath": [
        "What’s new in Grafana v11.0",
        "Dashboards and visualizations",
        "Improvements to the canvas visualization",
        "Universal data link support"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-0.md",
        "gitBlobSha": "718032fb1fcee4d964da6aa4e9da332a64bf509a",
        "sha256": "4ac4a4d84503349934037643cc351a7722532a4c4189aab283838810ba2f6731",
        "lineStart": 195,
        "lineEnd": 195,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-0.md#L195-L195"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.1bf8ef76e9dd30f87b2f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "With the newly added **Infinite panning** editor option, you can now view and navigate very large canvases. This option is displayed when the **Pan and zoom** switch is enabled.",
      "headingPath": [
        "What’s new in Grafana v11.0",
        "Dashboards and visualizations",
        "Infinite panning for the canvas visualization"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-0.md",
        "gitBlobSha": "718032fb1fcee4d964da6aa4e9da332a64bf509a",
        "sha256": "4ac4a4d84503349934037643cc351a7722532a4c4189aab283838810ba2f6731",
        "lineStart": 211,
        "lineEnd": 211,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-0.md#L211-L211"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.d342382a2c94294044c3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To try out this feature, you must first enable the `canvasPanelPanZoom` feature toggle.",
      "headingPath": [
        "What’s new in Grafana v11.0",
        "Dashboards and visualizations",
        "Infinite panning for the canvas visualization"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-0.md",
        "gitBlobSha": "718032fb1fcee4d964da6aa4e9da332a64bf509a",
        "sha256": "4ac4a4d84503349934037643cc351a7722532a4c4189aab283838810ba2f6731",
        "lineStart": 213,
        "lineEnd": 213,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-0.md#L213-L213"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
