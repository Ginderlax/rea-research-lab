    {
      "id": "grafana.candidate.a5809d6bea519a20fbd7",
      "syntaxRole": "table-row",
      "sourceText": "| Size | Configures the line width of the edges. The default is `Fixed size`, which makes all edge line widths the same regardless of the data; however, there is also an option to size the edges based on data corresponding to a selected field. `Min` and `Max` eges sizes have to be set such that the edges can scale within this range. |",
      "headingPath": [
        "Geomap",
        "Configuration options",
        "Map layers options",
        "Network layer",
        "Edge styles options"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/geomap/index.md",
