import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import {spawn} from 'node:child_process';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),sha=data=>createHash('sha256').update(data).digest('hex'),candidate=path.join(here,'candidate-wrapper.mjs'),names=['candidate-wrapper.mjs','selector-algorithm.mjs','candidate-baseline.mjs','authenticate-original.mjs','canonical.mjs','verify-candidate.mjs','verify-heldout-selection.mjs','verify-standard-heldout.mjs','verify-wrapper.mjs'],bound=async()=>Object.fromEntries(await Promise.all(names.map(async n=>[n,sha(await fs.readFile(path.join(here,n)))]))),before=await bound(),records=[],startedAt=new Date().toISOString(),id=Date.now();
for(const [name,args]of [['verify-wrapper.mjs',[]],['verify-candidate.mjs',[candidate,path.join(here,'results/candidate-wrapper.json')]],['verify-heldout-selection.mjs',[candidate]],['verify-standard-heldout.mjs',[candidate]]]){const source=await fs.readFile(path.join(here,name)),stem='correctness-'+id+'-'+name;await fs.writeFile(path.join(here,'results',stem+'.source.mjs.snapshot'),source,{flag:'wx'});console.log(JSON.stringify({starting:name,correctnessOnly:true}));const child=spawn(process.execPath,[path.join(here,name),...args],{windowsHide:true,stdio:['ignore','pipe','pipe']}),out=[],err=[];let bytes=0,killed=false;const timer=setTimeout(()=>{killed=true;child.kill();},180000);for(const [stream,parts]of [[child.stdout,out],[child.stderr,err]])stream.on('data',data=>{bytes+=data.length;if(bytes>4*1024*1024){killed=true;child.kill();}else parts.push(data);});const result=await new Promise(resolve=>{child.on('error',error=>resolve({exitCode:null,error:error.message}));child.on('close',(exitCode,signal)=>resolve({exitCode,signal}));});clearTimeout(timer);const stdout=Buffer.concat(out),stderr=Buffer.concat(err);for(const [suffix,data]of [['stdout.txt',stdout],['stderr.txt',stderr]])await fs.writeFile(path.join(here,'results',stem+'.'+suffix),data,{flag:'wx'});records.push({source:name,sourceSHA256:sha(source),...result,killed,stdoutPath:'results/'+stem+'.stdout.txt',stdoutSHA256:sha(stdout),stderrPath:'results/'+stem+'.stderr.txt',stderrSHA256:sha(stderr)});await fs.writeFile(path.join(here,'results/correctness-'+id+'.partial.json'),JSON.stringify({startedAt,records},null,2)+'\n');console.log(JSON.stringify({finished:name,...result,stdout:stdout.toString(),stderr:stderr.toString()}));if(result.exitCode!==0)break;}
const after=await bound();assert.deepEqual(after,before);const receipt={schema:'rea-metrics-wrapper-correctness-execution/v1',startedAt,completedAt:new Date().toISOString(),status:records.length===4&&records.every(r=>r.exitCode===0)?'passed':'failed',records,sourceHashesBefore:before,sourceHashesAfter:after,limits:{childDeadlineMilliseconds:180000,capturedOutputBytes:4*1024*1024,sequentialChildren:true},timingComparativeStudyRun:false,memoryMeasurementRun:false,profileRun:false};await fs.writeFile(path.join(here,'results/correctness-'+id+'.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:receipt.status,records:records.length,measurementRun:false}));if(receipt.status!=='passed')process.exitCode=1;
