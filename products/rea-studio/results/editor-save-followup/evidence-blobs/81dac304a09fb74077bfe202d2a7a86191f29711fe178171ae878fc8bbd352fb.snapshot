import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{spawnSync}from'node:child_process';
const here=import.meta.dirname,work=path.resolve(here,'..'),hash=b=>createHash('sha256').update(b).digest('hex'),ident=async p=>{const b=await fs.readFile(p);return{bytes:b.length,sha256:hash(b)}},stage=path.join(work,'editor-save-fix-next'),expected=process.env.EDITOR_SAVE_FIXED_MANIFEST_SHA256,receiptExpected=process.env.EDITOR_SAVE_FIXED_RECEIPT_SHA256;
assert(expected&&/^[a-f0-9]{64}$/.test(expected),'Explicit final frozen manifest required');assert(receiptExpected&&/^[a-f0-9]{64}$/.test(receiptExpected),'Explicit final frozen receipt required');
const mb=await fs.readFile(path.join(stage,'freeze-manifest.json')),manifest=JSON.parse(mb);assert.equal(hash(mb),expected);const receiptName=Object.keys(manifest.inventory).find(n=>n==='validation.json')??'review-validation.json';assert.equal((await ident(path.join(stage,receiptName))).sha256,receiptExpected);
async function walk(base,prefix=''){const rows=[];for(const e of await fs.readdir(base,{withFileTypes:true})){assert(!e.isSymbolicLink());if(e.isDirectory())rows.push(...await walk(path.join(base,e.name),prefix+e.name+'/'));else rows.push(prefix+e.name);}return rows.sort();}
async function authenticate(folder,mname,expectedSha){const base=path.join(work,folder),b=await fs.readFile(path.join(base,mname));assert.equal(hash(b),expectedSha);const m=JSON.parse(b);assert.deepEqual((await walk(base)).filter(p=>p!==mname),Object.keys(m.inventory).sort());for(const[rel,r]of Object.entries(m.inventory))assert.deepEqual(await ident(path.join(base,rel)),r);return{folder,manifest:{path:mname,bytes:b.length,sha256:hash(b)},files:Object.keys(m.inventory).length,allExact:true};}
const epochs=[['editor-search-path-fix-next','freeze-manifest.json','d071d370be094646a4738de79adadca9c28d794de53dfb940604f5d52d056edf'],['editor-save-independent-review','freeze-manifest.json','0fba64bafa48e5235635951f50b17e22d6767e43d8e62836faf1f35d7e6b69fa'],['editor-save-revision-independent-review','freeze-manifest.json','b1c3146a795e766f00b5d36dd9237ebb883a866a5d03678a4022254060b6e4c9'],['editor-save-fix-next','freeze-manifest.json',expected]];
const before=[];for(const e of epochs)before.push(await authenticate(...e));const testFiles=['held-save-retargeted.test.mjs','queued-revision-retargeted.test.mjs','adjacent-save.test.mjs'],probeFiles=[...testFiles,'held-save-fixture.mjs'],probes=[];for(const name of probeFiles)probes.push({path:name,...await ident(path.join(here,name))});
await fs.mkdir(path.join(here,'candidate-sources'),{recursive:true});const selected=[];for(const name of['client.mjs','server.mjs']){const source='products/rea-studio/apps/editor/'+name,b=await fs.readFile(path.join(stage,source)),destination='candidate-sources/'+name+'.snapshot';await fs.writeFile(path.join(here,destination),b,{flag:'wx'});selected.push({source,preserved:destination,bytes:b.length,sha256:hash(b)});}
const started=new Date().toISOString(),child=spawnSync(process.execPath,['--test','--test-concurrency=1','--test-reporter=tap',...testFiles.map(n=>path.join(here,n))],{encoding:'utf8',windowsHide:true,timeout:60000,maxBuffer:2*1024*1024}),stdout=child.stdout??'',stderr=child.stderr??'';await fs.writeFile(path.join(here,'tests.stdout.txt'),stdout,{flag:'wx'});await fs.writeFile(path.join(here,'tests.stderr.txt'),stderr,{flag:'wx'});const counts=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(k=>[k,Number(stdout.match(new RegExp('^# '+k+' (\\d+)$','m'))?.[1])]));const after=[];for(const e of epochs)after.push(await authenticate(...e));assert.deepEqual(before,after);for(const r of probes)assert.deepEqual(await ident(path.join(here,r.path)),{bytes:r.bytes,sha256:r.sha256});const result={schema:'rea-editor-save-correction-independent-run/v1',startedAt:started,finishedAt:new Date().toISOString(),epochsBefore:before,epochsAfter:after,allStageSourcesStable:true,candidateReceipt:{path:receiptName,...await ident(path.join(stage,receiptName))},candidateSourceSnapshots:selected,probes,counts,exitCode:child.status,signal:child.signal,error:child.error?.message??null,stdout:{path:'tests.stdout.txt',...await ident(path.join(here,'tests.stdout.txt'))},stderr:{path:'tests.stderr.txt',...await ident(path.join(here,'tests.stderr.txt'))},scope:'7 exact original held-save bodies;3 exact direct queued revision bodies;4 fresh close/reopen/revision/keyboard/other-document boundaries. Actual client/Save handler and owned synthetic filesystem; successful holds occur after real Save commits. Synthetic error control has no commit. No original engine/browser/benchmarks.',productionModified:false,originalExecutions:0,browserExecutions:0,benchmarks:0,acceptedFiniteCases:child.status===0&&counts.tests===14&&counts.pass===14&&counts.fail===0&&counts.skipped===0};await fs.writeFile(path.join(here,'run-validation.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({counts,sourceStable:true,candidateSources:selected,acceptedFiniteCases:result.acceptedFiniteCases}));
