    {
      "id": "grafana.candidate.d2ecad98c50fb62012e4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Optional URL to send to users in notifications. If the string contains the sequence `{{file}}`, it is replaced with the uploaded filename. Otherwise, the filename is appended to the path part of the URL, leaving any query string unchanged.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[external_image_storage.webdav]`",
        "`public_url`"
      ],
      "source": {
