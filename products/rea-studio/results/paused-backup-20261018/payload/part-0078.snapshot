    },
    {
      "id": "grafana.candidate.56f844e8e899f751f095",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To learn more about how to query by TraceQL, refer to the [TraceQL documentation](https://grafana.com/docs/tempo/latest/traceql/).",
