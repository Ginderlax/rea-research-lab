import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import {spawn} from 'node:child_process';
const root=path.dirname(fileURLToPath(import.meta.url)),hash=b=>createHash('sha256').update(b).digest('hex'),mode=process.argv[2];if(!['initial','adapted'].includes(mode))throw new Error('Use initial/adapted run label');
const baseline=JSON.parse(await fs.readFile(path.join(root,'baseline.json'))),run=path.join(root,'runs',mode+'-'+new Date().toISOString().replaceAll(':','-'));await fs.mkdir(run,{recursive:true});
async function fingerprint(){const files=[];for(const row of baseline.sources){const bytes=await fs.readFile(path.join(root,row.path));files.push({path:row.path,bytes:bytes.length,sha256:hash(bytes)});}for(const relative of ['run.mjs','prepare.mjs',...(mode==='adapted'?['adapt.mjs']:[])]){const bytes=await fs.readFile(path.join(root,relative));files.push({path:relative,bytes:bytes.length,sha256:hash(bytes)});}return files;}
const before=await fingerprint();for(const row of before){const target=path.join(run,'source',row.path+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,await fs.readFile(path.join(root,row.path)));}
const stdout=await fs.open(path.join(run,'stdout.txt'),'wx'),stderr=await fs.open(path.join(run,'stderr.txt'),'wx'),child=spawn(process.execPath,['--test','--test-concurrency=1','products/rea-studio/apps/backup/native.test.mjs'],{cwd:root,windowsHide:true,stdio:['ignore','pipe','pipe']});let output='',errors='';child.stdout.on('data',chunk=>{output+=chunk.toString();stdout.write(chunk);});child.stderr.on('data',chunk=>{errors+=chunk.toString();stderr.write(chunk);});const exitCode=await new Promise((resolve,reject)=>{child.once('error',reject);child.once('close',resolve);});await stdout.close();await stderr.close();
const after=await fingerprint(),stable=JSON.stringify(before)===JSON.stringify(after),counts=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(name=>[name,Number(new RegExp(`(?:ℹ|#) ${name} (\\d+)`).exec(output)?.[1]??-1)])),sourceOriginalStable=(await Promise.all(baseline.sources.map(async row=>hash(await fs.readFile(row.source))===row.sha256))).every(Boolean);
const result={schema:'rea-restic-native-policy-adapter-run/v1',mode,exitCode,counts,sourceStable:stable,originalSourceStable:sourceOriginalStable,sourceFingerprints:before,expectedPolicyFailure:mode==='initial',sharedHost:'Exact production server/catalog in private clone, dynamically assigned port, own temp repositories/data only.',errors};await fs.writeFile(path.join(run,'validation.json'),JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify({run:path.relative(root,run).replaceAll('\\','/'),mode,exitCode,counts,sourceStable:stable,originalSourceStable:sourceOriginalStable}));if(!stable||!sourceOriginalStable||(mode==='adapted'&&(exitCode!==0||counts.fail!==0)))process.exitCode=1;
