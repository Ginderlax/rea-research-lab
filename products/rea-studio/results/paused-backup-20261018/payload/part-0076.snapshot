    {
      "id": "grafana.candidate.fb4bd331de63cecfa2bb",
      "syntaxRole": "list-item",
      "sourceText": "- To run the query, click the **Run query** button or use the keyboard shortcut **<key>Ctrl</key>/<key>Cmd</key> + <key>Enter</key>/<key>Return</key>**.",
      "headingPath": [
        "Microsoft SQL Server query editor",
        "Code mode",
        "Code mode toolbar features"
