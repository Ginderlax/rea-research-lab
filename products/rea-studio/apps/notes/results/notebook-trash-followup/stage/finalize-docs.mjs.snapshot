import fs from 'node:fs/promises';
const root=new URL('./',import.meta.url),file=new URL('products/rea-studio/apps/notes/README.md',root);
let text=await fs.readFile(file,'utf8');text=text.replace('Shared or trashed notebook organization, the reserved conflict notebook, notebook deletion/trash and sharing/synchronization are outside this subset.','This prospective stage adds confirmed notebook trash and restore for local unshared valid trees. A cascade preserves native IDs, tag/resource links and binary bytes and commits through one state record. Notebook restore also restores independently trashed notes in restored folders. A trashed parent remains in trash; restoring its child detaches that child to top level. Folder trash updates user and system times; note trash and all restoration preserve user times. Trashed notebooks are selectable for restoration, while rename/move still refuse them. Shared organization, the reserved conflict notebook, permanent deletion, empty trash, purge, optional restore targets and sharing/synchronization remain outside this subset.');text+='\nThis stage is not production. Its [scope](../../../../README.md) and [source contracts](../../../../SOURCE-CONTRACTS.md) bind the additional Desktop 3.6.14 study. Original code remains test-only; the finite runtime is source-assisted and has no full notebook parity claim. The new exact helper comparisons use memory adapters and a fixed clock, not the original application/database/GUI.\n';await fs.writeFile(file,text);
const docs=new URL('README.md',root);text=await fs.readFile(docs,'utf8');text=text.replace('Generated `.local` observations are copied into each run by the collector and excluded from the frozen artifact set.','Generated `.local` observations are copied by the final collector into the final run and excluded from the frozen artifact set. Earlier raw runs preserve stdout/source snapshots, not later reconstructed detailed observations.');await fs.writeFile(docs,text);
