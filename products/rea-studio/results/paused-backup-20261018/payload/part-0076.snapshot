    {
      "id": "grafana.candidate.43db703d460376220c42",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you are running a self-managed Grafana instance or need to configure an additional Pyroscope data source pointing to Grafana Cloud Profiles, you can find the Pyroscope URL under the **Manage your stack** section for your organization.",
      "headingPath": [
        "Configure the Pyroscope data source",
        "Add or modify a data source",
        "Connection URL"
      ],
      "source": {
        "path": "docs/sources/datasources/pyroscope/configure/index.md",
        "gitBlobSha": "efbdd0eb333871752daff6cb450c348478e4be2d",
        "sha256": "f8e360d9ee970e3e093745fac5826e4cd47aea4aeb6ed5992e5a9cbdb4a193b9",
        "lineStart": 76,
        "lineEnd": 76,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/pyroscope/configure/index.md#L76-L76"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
