        "sha256": "a3943a943a9907ac7c1b3b13ba6b8f1519bbda6b9a19cf01591f2ade20d35b63",
        "lineStart": 208,
        "lineEnd": 208,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/guides/connectivity-errors.md#L208-L208"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.6c6f93ba67e0b992cd26",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When using the default behavior, a single connectivity error will likely trigger multiple `DatasourceError` alerts.",
      "headingPath": [
        "Handle connectivity errors in alerts",
        "Handle query errors in Grafana Alerting",
        "Reduce redundant error notifications"
      ],
      "source": {
        "path": "docs/sources/alerting/guides/connectivity-errors.md",
