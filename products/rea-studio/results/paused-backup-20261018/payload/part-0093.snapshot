      medians[implementation]=median(values);assert.equal(medians[implementation],summary[implementation+'Milliseconds']);
      assert.deepEqual({min:Math.min(...values),max:Math.max(...values)},summary.ranges[implementation]);
    }
    const input=records[0].inputSha256,output=records[0].outputSha256;
    for(const record of records){assert.equal(record.exactOutputEqual,true);assert.equal(record.actualDependencyBytesVerified,true);assert.equal(record.inputSha256,input);assert.equal(record.outputSha256,output);assert.equal(record.candidateSha256,candidateHash);assert.equal(record.baselineSha256,preservation.productionSHA256);assert.equal(record.originalArchiveSha256,'954a03a68fa122ebe74c0c318dc801e434c17294c5374ef593cf491f73c81c41');}
    cases.push({...summary,inputSHA256:input,expectedOutputSHA256:output,candidateVsBaselinePercent:(medians.candidate/medians.baseline-1)*100,candidateVsOriginalPercent:(medians.candidate/medians.original-1)*100});
  }
  const stem=candidateName.slice(0,-4),evidence={};
  for(const suffix of ['.json','-selection-heldout.json','-budget.json']){
    const evidencePath='results/'+stem+suffix,value=await read(evidencePath);
    assert.equal(value.implementationSha256??value.sourceSHA256,candidateHash);assert.ok(value.checkedAt<interval.start);
    if(suffix==='.json'){assert.equal(value.status,'passed');assert.equal(value.comparisons,2910751);assert.equal(value.standardHelperComparisons,14240);assert.equal(value.cacheComparisons,48240);assert.equal(value.failures.length,0);}
    if(suffix==='-selection-heldout.json'){assert.equal(value.failureCount,0);assert.equal(value.comparisons,3888);assert.equal(value.registryComparisons,864);}
    if(suffix==='-budget.json'){assert.equal(value.comparisons,18);assert.equal(value.outputAndInputAndStateExact,true);assert.equal(value.boundedFallbackExecutionCount,5);}
    evidence[evidencePath]={sha256:await fingerprint(evidencePath),checkedAt:value.checkedAt};
  }
  timingReceipts.push({path:receiptPath,sha256:await fingerprint(receiptPath),classification:confounded?'exploratory-confounded':'formal-quiet',interval,candidate:candidateName,candidateSHA256:candidateHash,executedSourceSnapshots,semanticEvidence:evidence,all105RecordsAndMediansVerified:true,cases,selectedForIntegration:false});
}
