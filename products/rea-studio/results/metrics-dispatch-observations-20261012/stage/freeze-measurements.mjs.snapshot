import fs from 'node:fs/promises';
import {createReadStream} from 'node:fs';
import path from 'node:path';
import {createHash} from 'node:crypto';
import {fileURLToPath} from 'node:url';
import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),sha=bytes=>createHash('sha256').update(bytes).digest('hex'),read=async name=>JSON.parse(await fs.readFile(path.join(here,name))),getSHA=async name=>sha(await fs.readFile(path.join(here,name))),freeze=await read('dispatch-validation.json'),review=await read('measurement-review.json');assert.equal(await getSHA('dispatch-validation.json'),'6ef6d6ef1f79159391469df09b527485fecb62b9284b11da9a6ff888832525e3');assert.equal(await getSHA('measurement-review.json'),'e6bbe2b3f6d4c55ad7eadc4fe466d83de42b367fb7c993c1539d8691a16e7e3c');
async function checkInventory(root,inventory){for(const [name,row]of Object.entries(inventory)){const bytes=await fs.readFile(path.join(root,name));assert.equal(bytes.length,row.bytes);assert.equal(sha(bytes),row.sha256,name);}return Object.keys(inventory).length;}
assert.equal(await checkInventory(here,freeze.inventory),167);const previous=path.resolve(here,'../metrics-standard-next'),plans=path.resolve(here,'../metrics-standard-next-next');const old=JSON.parse(await fs.readFile(path.join(previous,'optimization-stage.json'))),plan=JSON.parse(await fs.readFile(path.join(plans,'plan-validation.json'))),oldCount=await checkInventory(previous,old.inventory),planCount=await checkInventory(plans,plan.inventory);assert.equal(sha(await fs.readFile(path.join(previous,'optimization-stage.json'))),freeze.previousStage.sha256);assert.equal(sha(await fs.readFile(path.join(plans,'plan-validation.json'))),freeze.frozenPlans.sha256);
const lab=path.resolve(here,'../../outputs/rea-research-lab'),app=path.join(lab,'products/rea-studio/apps/metrics');assert.equal(sha(await fs.readFile(path.join(app,'native-calculations.mjs'))),freeze.productionSourceSHA256);assert.equal(sha(await fs.readFile(path.join(app,'results/native-calculations-verification.json'))),freeze.productionVerificationSHA256);for(const row of Object.values(review.sourceSnapshots))assert.equal(sha(await fs.readFile(row.originalPath)),row.sha256);
const runtimeHash=createHash('sha256');for await(const chunk of createReadStream(process.execPath))runtimeHash.update(chunk);assert.equal(runtimeHash.digest('hex'),review.runtime.executableSHA256);assert.equal(process.version,review.runtime.version);
let rawLogs=0;for(const variant of ['standard','percentile']){const timing=review.timing[variant],memory=review.memory[variant];assert.equal(await getSHA(timing.receipt.path),timing.receipt.sha256);assert.equal(await getSHA(timing.raw.path),timing.raw.sha256);assert.equal(await getSHA(memory.receipt.path),memory.receipt.sha256);for(const row of memory.rawLogs){assert.equal(await getSHA(row.path),row.sha256);rawLogs++;}assert.equal(memory.failedTrials,0);assert.equal(memory.censoredLimitHitTrials,0);}assert.equal(rawLogs,840);
const arithmetic=await read('results/summary-arithmetic-validation.json'),figures=await read('results/figures-validation.json');assert.equal(arithmetic.status,'passed');assert.equal(arithmetic.summaryGroupsIndependentlyRecomputed,5790);assert.equal(arithmetic.measurementReviewSHA256,await getSHA('measurement-review.json'));assert.equal(arithmetic.checkerSourceSHA256,await getSHA('check-measurement-summary.py'));assert.equal(arithmetic.figuresSHA256,await getSHA('results/figures-validation.json'));assert.equal(figures.source.sha256,await getSHA('plot-measurements.py'));assert.equal(figures.input.sha256,await getSHA('measurement-review.json'));for(const row of figures.outputs)assert.equal(await getSHA(row.path),row.sha256);
const proofNames=['dispatch-validation.json','measurement-review.json','MEASUREMENT-REVIEW.md','results/summary-arithmetic-validation.json','results/figures-validation.json','results/timing-summary.csv','results/memory-summary.csv','results/quiet-window-close.json'],proofs={};for(const name of proofNames)proofs[name]={sha256:await getSHA(name)};
const inventory={},excluded=['.plot-libs/** (isolated post-window rendering libraries; package versions and renderer/runtime fingerprints are bound in figures-validation.json)'];async function walk(directory){for(const item of await fs.readdir(directory,{withFileTypes:true})){const filename=path.join(directory,item.name);if(item.isDirectory()){if(item.name!=='.plot-libs')await walk(filename);}else{const name=path.relative(here,filename).split(path.sep).join('/');if(name==='measurement-validation.json')continue;const bytes=await fs.readFile(filename);inventory[name]={bytes:bytes.length,sha256:sha(bytes)};}}}await walk(here);
const receipt={schemaVersion:1,checkedAt:new Date().toISOString(),scope:'Frozen post-window source-bound consolidation of separate standard and percentile trials. No new reducer workloads, source/threshold edits, integration or publication.',proofs,inventory,inventoryExclusions:excluded,oldReadinessInventoryFilesVerifiedUnchanged:167,previousOptimizationInventoryFilesVerifiedUnchanged:oldCount,previousPlanInventoryFilesVerifiedUnchanged:planCount,productionSourceVerifiedUnchanged:true,productionVerificationVerifiedUnchanged:true,exactMeasurementSourceSnapshots:Object.keys(review.sourceSnapshots).length,originalArchivesAndActualRuntimeSourcesPreserved:true,exactNodeExecutableVerified:true,rawMemoryLogsVerified:rawLogs,timingTrials:2,isolatedMemoryTrials:2,timingChildren:210,isolatedMemoryChildren:210,outputCacheChecks:852516,measurementFailures:0,censoredLimitHitTrials:0,summaryGroupsIndependentlyRecomputed:5790,negativePairedSampleDeltas:arithmetic.negativePairedSampleDeltasPreserved,figuresVerified:6,figuresVisuallyInspected:true,quietWindowClosed:true,quietWindow:review.quietWindow.coordinatorQuietInterval,machineLevelIsolationEstablished:false,rootOtherAgentQuietAcknowledgmentsAreCoordinatorProvided:true,actualDurationExceededProvisionalMemoryEstimates:true,postWindowConsolidationFailure:{sourceSHA256:'40da08159d91d6fc23c5fc6e4836908bc70400387f7d55685b915099b981a9cf',receipt:'results/consolidation-attempt-1791837710944.json',correctedSourceSHA256:'a37c33b3c27aa00f938bce8f58c90aa9458bf4fb348451adfd9e917f7cf5896e',passingReceipt:'results/consolidation-attempt-1791837721347.json',measurementTrialsAffected:false,scope:'Initial newly written summarizer used small-workload checkpoint names for all cases; exact failed source/logs retained. Only unfrozen post-window summarizer changed.'},prospectiveOptimizationOnly:true,newTimingOrMemoryWorkloadsRunDuringConsolidation:false,selectedForIntegration:null,productionChanged:false,allDocumentedFeaturesEnumerated:false,fullProductComplete:false,universalSuperiorityEstablished:false};
const output=JSON.stringify(receipt,null,2)+'\n';try{await fs.access(path.join(here,'measurement-validation.json'));throw Error('Consolidation already frozen; retain and use a new review stage.');}catch(error){if(error.code!=='ENOENT')throw error;}await fs.writeFile(path.join(here,'measurement-validation.json'),output);console.log(JSON.stringify({receipt:path.join(here,'measurement-validation.json'),sha256:sha(output),inventoryFiles:Object.keys(inventory).length,proofs,sourceSnapshots:receipt.exactMeasurementSourceSnapshots,rawMemoryLogs:rawLogs,oldCount,planCount}));
