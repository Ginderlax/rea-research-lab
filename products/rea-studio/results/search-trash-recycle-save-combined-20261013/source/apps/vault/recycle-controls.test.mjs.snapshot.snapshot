import test from 'node:test';import assert from 'node:assert/strict';
import {fixture,trashA,button,field,descendants,deferred} from './recycle-boundary-fixture.mjs';
for(const operation of ['restore','purge'])test('normal '+operation+' retains the current bin and refreshes active/bin results',async t=>{const f=await fixture(t,'normal-'+operation);await trashA(f.root);field(f.root,operation==='restore'?'Confirm restoring this entry to its previous group':'Confirm permanent deletion of this recycled entry').checked=true;const before=f.requests.filter(r=>r.action==='recycleList').length;await button(f.root,operation==='restore'?'Restore recycled entry':'Permanently delete recycled entry').click();assert.equal(f.requests.filter(r=>r.action==='recycleList').length,before+1);assert.ok(button(f.root,'Close recycle bin'));assert.equal((await f.call('recycleList')).entries.length,0);assert.equal((await f.call('list')).entries.length,operation==='restore'?2:1);f.observe.normalBinRefresh=true;});
test('same-bin stale revision refuses preview until a fresh bin list supplies its current token',async t=>{let armed=false;const entered=deferred(),release=deferred();t.after(()=>release.resolve());const f=await fixture(t,'stale-token-preview-control',async(action,input,real)=>{const value=await real();if(action==='list'&&armed){armed=false;entered.resolve();await release.promise;}return value;});await trashA(f.root);const b=(await f.call('read',{id:f.B})).entry;await f.call('recycleDelete',{id:f.B,revision:b.recycleRevision,confirm:true});await button(f.root,'Show recycle bin').click();const row=title=>descendants(f.root).find(n=>n.tagName==='section'&&n.children.some(c=>c.tagName==='strong'&&c.textContent===title)&&descendants(n).some(c=>c.tagName==='button'&&c.textContent==='Preview recycled entry'));field(row('A'),'Confirm restoring this entry to its previous group').checked=true;armed=true;const pending=button(row('A'),'Restore recycled entry').click();await entered.promise;await button(row('B'),'Preview recycled entry').click();f.observe.stalePreviewStatus=descendants(f.root).find(n=>n.className==='status')?.textContent;assert.match(f.observe.stalePreviewStatus,/Recycle selection changed/);assert.equal(descendants(f.root).some(n=>n.ownText==='Recycled password'),false);release.resolve();await pending;await button(row('B'),'Preview recycled entry').click();assert.equal(field(f.root,'Recycled password').value,'B-owned-secret');f.observe.freshTokenPreviewPassed=true;});
test('closing then explicitly reopening during held mutation preserves the newer bin without another old refresh',async t=>{const entered=deferred(),release=deferred();t.after(()=>release.resolve());const f=await fixture(t,'close-reopen-held-mutation',async(action,input,real)=>{const value=await real();if(action==='recycleRestore'){entered.resolve();await release.promise;}return value;});await trashA(f.root);field(f.root,'Confirm restoring this entry to its previous group').checked=true;const pending=button(f.root,'Restore recycled entry').click();await entered.promise;await button(f.root,'Close recycle bin').click();await button(f.root,'Show recycle bin').click();const requests=f.requests.filter(r=>r.action==='recycleList').length;release.resolve();await pending;assert.ok(button(f.root,'Close recycle bin'));assert.equal(f.requests.filter(r=>r.action==='recycleList').length,requests);assert.equal((await f.call('list')).entries.length,2);f.observe.newerExplicitReopenRetained=true;});
