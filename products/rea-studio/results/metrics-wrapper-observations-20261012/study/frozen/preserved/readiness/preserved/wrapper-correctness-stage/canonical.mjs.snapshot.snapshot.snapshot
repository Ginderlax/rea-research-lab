/** Test transport only. Graph references preserve result/cache shallow-copy aliases. */
export function canonical(value){const seen=new Map();let next=0;function visit(item){if(item===undefined)return ['undefined'];if(item===null)return ['null'];if(typeof item==='number')return ['number',Object.is(item,-0)?'-0':String(item)];if(typeof item==='boolean'||typeof item==='string')return [typeof item,item];if(typeof item!=='object')throw Error('Unsupported canonical sample type.');if(seen.has(item))return ['reference',seen.get(item)];const id=next++;seen.set(item,id);if(!Array.isArray(item)&&Object.getPrototypeOf(item)!==Object.prototype)throw Error('Only ordinary result objects are accepted.');return [Array.isArray(item)?'array':'object',id,...(Array.isArray(item)?[item.length]:[]),Object.keys(item).map(key=>[key,visit(item[key])])];}return JSON.stringify(visit(value));}
export function aliases(field,result){return {returnedEqualsCache:result===field.state.calcs,...('allValues'in result?{allValuesEqualsCache:result.allValues===field.state.calcs.allValues,allValuesEqualsInput:result.allValues===field.values}:{}),...('uniqueValues'in result?{uniqueValuesEqualsCache:result.uniqueValues===field.state.calcs.uniqueValues,uniqueValuesEqualsInput:result.uniqueValues===field.values}:{})};}
export function packet(field,result){return {result,state:field.state,aliases:aliases(field,result)};}
export function valuesFor(n){return Array.from({length:n},(_,index)=>index%23===0?null:((index*7879)%7919)-3959.25);}
export function metadataFor(native){return native.fieldReducers.list().map(({reduce,...row})=>Object.fromEntries(Object.entries(row).sort(([a],[b])=>a<b?-1:a>b?1:0)));}
