    {
      "id": "grafana.candidate.a2c9b832b8001cc11dc1",
      "syntaxRole": "list-item",
      "sourceText": "- **Add self-signed certificate** - Check the box to authenticate with a CA certificate. Follow the instructions of the CA (Certificate Authority) to download the certificate file. Required for verifying self-signed TLS certificates.",
      "headingPath": [
        "Configure the Elasticsearch data source",
        "Authentication",
        "TLS settings"
      ],
      "source": {
