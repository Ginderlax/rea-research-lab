    {
      "id": "grafana.candidate.7d6aef7ce771e4a775ed",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Annotations are saved in the Grafana database (sqlite, mysql or postgres). Annotations can be organization annotations that can be shown on any dashboard by configuring an annotation data source - they are filtered by tags. Or they can be tied to a panel on a dashboard and are then only shown on that panel.",
      "headingPath": [
        "Annotations API"
      ],
      "source": {
        "path": "docs/sources/developer-resources/api-reference/http-api/api-legacy/annotations.md",
        "gitBlobSha": "1b82ce8870218611ea1e15b66420bc4a406201fe",
