import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{authenticate}from'./source-auth.mjs';
const here=import.meta.dirname,stage=path.resolve(here,'../vault-group-edit-next'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),json=v=>Buffer.from(JSON.stringify(v,null,2)+'\n');async function save(p,b){await fs.mkdir(path.dirname(path.join(here,p)),{recursive:true});await fs.writeFile(path.join(here,p),b,{flag:'wx'});}
const before=JSON.parse(await fs.readFile(path.join(here,'authority-before.json'))),after=await authenticate();assert.deepEqual(after,before);await save('authority-after.json',json(after));
const study=JSON.parse(await fs.readFile(path.join(stage,'source-study.json')));assert.equal(study.sources.length,17);assert.equal(study.license,'GPL-2.0-or-later');for(const r of study.sources){const b=await fs.readFile(path.join(stage,r.path));assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});await save('source-study/'+r.path,b);}await save('source-study.json.snapshot',await fs.readFile(path.join(stage,'source-study.json')));
const native=[];for(const[p,marker,count]of[['runs/candidate-final-v2/observations/group-edit-original.json','REA_GROUP_EDIT_ASSEMBLY_LOADED_2_61_1',7],['runs/candidate-final-v2/observations/prior-original/group-original.json','REA_GROUP_ASSEMBLY_LOADED_2_61_1',15]]){const b=await fs.readFile(path.join(stage,p)),rows=JSON.parse(b);assert.equal(rows.length,count);let markers=0;for(const r of rows){assert.equal(r.exit.code,0);const m=(r.raw.stderr.match(new RegExp(marker,'g'))??[]).length;assert.equal(m,1);assert.equal(r.assemblyLoads,1);assert.equal(r.value.calls.assemblyLoads,1);assert.equal(r.value.calls.originalGUI,0);assert.equal(r.value.calls.originalProgram,0);markers+=m;}native.push({path:p,...id(b),rows:count,rawMarkers:markers,historicalAuthorExecutions:true,newReviewerExecutions:0});await save('original-history/'+path.basename(path.dirname(p))+'-'+path.basename(p)+'.snapshot',b);}
const v=JSON.parse(await fs.readFile(path.join(stage,'validation.json')));assert.equal(v.actualManagedOriginal.totalAssemblyLoads,22);await save('author-validation.json.snapshot',await fs.readFile(path.join(stage,'validation.json')));for(const n of['group-edit-oracle.ps1','group-oracle.ps1'])await save('original-history/'+n+'.snapshot',await fs.readFile(path.join(stage,'products/rea-studio/apps/vault',n)));
const first=JSON.parse(await fs.readFile(path.join(here,'runs/fresh-2026-10-13T05-30-37-242Z/validation.json'))),second=JSON.parse(await fs.readFile(path.join(here,'runs/fresh-2026-10-13T05-35-01-574Z/validation.json')));assert.deepEqual(first.counts,{tests:6,pass:4,fail:2,skipped:0,cancelled:0,todo:0});assert.deepEqual(second.counts,{tests:5,pass:5,fail:0,skipped:0,cancelled:0,todo:0});assert(first.sourceStable&&second.sourceStable);const bodies=id(await fs.readFile(path.join(here,'draft-boundaries.test.mjs'))),helper=id(await fs.readFile(path.join(here,'ui-fixture.mjs')));assert.equal(bodies.sha256,'2809eaf383607f8322648f9232cf905fa7298a00e9a5d3e731f53d9f3a71dc3f');assert.equal(helper.sha256,'58301a1dee9995966fc24a221d7f1c69c4968e002dd1b55afd3ef5f3cc6ae0be');
await save('finding.json',json({schema:'rea-vault-group-edit-independent-finding/v1',id:'VAULT.GROUP.EDITOR.LATE-LIST.DRAFT-LOSS',priority:'P1',confirmed:true,candidateClient:{bytes:29809,sha256:'d706e9a91f784d6ba6473f542a221749186caade8523d318580eef1d263d7a4f'},boundary:'Successful Create or Save finishes its write and active list, then awaits final recycleGroupList. Fields remain writable; newer name/notes input during that final response hold is erased by groupList replacing the form.',reproductions:2,controlsPass:9,evidenceRun:'runs/fresh-2026-10-13T05-30-37-242Z',exactTest:bodies,exactFixture:helper,DOMModel:true,actualCandidateClientServer:true,nativeBrowser:false,originalExecutions:0,productionWrites:0,candidateWrites:0,sourceStable:true}));
await save('review-validation.json',json({schema:'rea-vault-group-edit-independent-review/v1',at:new Date().toISOString(),sourceStable:true,authorities:after.map(r=>({name:r.name,folder:r.folder,manifest:r.manifest,payloads:r.payloads,declaredLocalExtras:r.declaredLocalExtras.length})),freshGroups:11,pass:9,fail:2,skip:0,cancelled:0,confirmedFindings:['VAULT.GROUP.EDITOR.LATE-LIST.DRAFT-LOSS'],finiteAcceptance:false,realCandidateClientServer:true,DOMModel:true,canonicalNativeFixtureReusedWithProvenance:true,authorTestBodiesNotReadBeforeCaseDesign:true,ownedStoreFailureAndTransportHolds:true,originalSourceLicenseFiles:17,originalGPLLicenseRetained:true,historicalAuthorManagedLoads:native,historicalTotalLoads:22,newIndependentOriginalLoads:0,rootHTTP3AndBrowser8HistoricalNotReplayed:true,browserExecutions:0,hostsStarted:0,fullSuiteExecutions:0,benchmarkCommands:0,productionWrites:0,candidateWrites:0,ownedChildrenExited:true,ownedTempsGone:true,priorStagesUnchanged:true,fullProductParity:false,securityEquivalence:false,universalSuperiority:false,collectorMistakes:[{kind:'source-only filename guess',path:'products/rea-studio/apps/vault/group-edit.mjs',result:'Absent: primitives reside in recycle.mjs; no implementation failure.'},{kind:'hash display formatting',result:'First PowerShell table omitted hash column; second JSON output retained exact hashes. No input mutation.'}]}));
async function tree(dir,prefix=''){const a=[];for(const e of await fs.readdir(dir,{withFileTypes:true})){assert(!e.isSymbolicLink());const p=prefix+e.name;if(e.isDirectory())a.push(...await tree(path.join(dir,e.name),p+'/'));else a.push(p);}return a;}const inventory=[];for(const p of(await tree(here)).sort())inventory.push({path:p,...id(await fs.readFile(path.join(here,p)))});await save('review-manifest.json',json({schema:'rea-vault-group-edit-independent-strict-freeze/v1',files:inventory.length,inventory}));process.stdout.write(JSON.stringify({payloads:inventory.length,manifest:id(await fs.readFile(path.join(here,'review-manifest.json'))),receipt:id(await fs.readFile(path.join(here,'review-validation.json'))),finding:id(await fs.readFile(path.join(here,'finding.json'))),pass:9,fail:2,sourceStable:true})+'\n');
