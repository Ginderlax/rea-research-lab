          "oss",
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.97d41f759907d9dc77d6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "[Notification policies](https://grafana.com/docs/grafana/latest/alerting/fundamentals/notifications/notification-policies/) route alerts to different communication channels, reducing alert noise and providing control over when and how alerts are sent. For example, you might use notification policies to ensure that critical alerts about server downtime are sent immediately to the on-call engineer. Another use case could be routing performance alerts to the development team for review and action.",
      "headingPath": [
        "Set up the Grafana stack",
        "Notification policies"
      ],
      "source": {
        "path": "docs/sources/tutorials/alerting-get-started-pt2/index.md",
