    {
      "id": "grafana.candidate.d7cd50b4d8775d214a15",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can disable or hide one or more transformations by clicking on the eye icon on the top right side of the transformation row. This disables the applied actions of that specific transformation and can help to identify issues when you change several transformations one after another.",
      "headingPath": [
        "Transform data",
        "Disable a transformation"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/transform-data/index.md",
        "gitBlobSha": "9cd072609170b1783ea50740845dd11e18b0fede",
