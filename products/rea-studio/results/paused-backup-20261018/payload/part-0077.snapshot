    {
      "id": "grafana.candidate.9911471085dc1678a078",
      "syntaxRole": "table-row",
      "sourceText": "| `use_refresh_token`      | No       | Yes                | Set to `true` to use refresh token and check access token expiration.                                                                                                                                                                                                                                                                                                                                                                                                                                               | `false`                       |",
      "headingPath": [
        "Configure Okta OIDC authentication",
        "Configuration options"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/okta/index.md",
