for(const name of ['04-excalidraw','05-joplin','06-node-red']){
 const root=path.join(projects,name),reportPath=path.join(root,'REPORT.md');
 let report=fs.readFileSync(reportPath,'utf8');
 report=report.replace('# Node RED Switch routing reconstruction','# Node-RED Switch routing reconstruction');
 report=report.replace('## Release identity and selected artifacts','These operational hypotheses describe the recorded engineering comparison. They were not preregistered, and no blinded independent author team was used.\n\n## Release identity and selected artifacts');
 fs.writeFileSync(reportPath,report);
 const study=JSON.parse(fs.readFileSync(path.join(root,'study.json'),'utf8')),result=JSON.parse(fs.readFileSync(path.join(root,'test-results.json'),'utf8'));
