    },
    {
      "id": "grafana.candidate.96b92032b53d7db06337",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A string that prefixes all Redis keys. This value must be set if using a shared database in Redis. If `prefix` is empty, then one will not be used.",
      "headingPath": [
        "Configure Grafana Enterprise",
        "[caching.redis]",
