    {
      "id": "grafana.candidate.8e3dbb343ad9361b63bd",
      "syntaxRole": "list-item",
      "sourceText": "- Built-in features like dashboard change notifications will only be broadcasted to users connected to the same Grafana server process instance.",
      "headingPath": [
