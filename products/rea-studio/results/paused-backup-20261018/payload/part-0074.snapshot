    },
    {
      "id": "grafana.candidate.42db9d5cfcd41dd4c723",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For a tutorial on working with Teams, refer to [Create users and teams](https://grafana.com/tutorials/create-users-and-teams/).",
      "headingPath": [
        "Configure Grafana Teams"
      ],
      "source": {
