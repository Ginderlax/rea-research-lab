    {
      "id": "grafana.candidate.0f84d9b4c408ef5b2095",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you hover your cursor over a visualization, Grafana can display tooltips that contain more information about a data point, like the exact time of a result. You can customize tooltips to control how many series they include and the order of those values. You can also copy the content from tooltips to use elsewhere. Learn more about configuring tooltips in [Tooltip options](#tooltip-options).",
      "headingPath": [
        "Configure tooltips"
      ],
