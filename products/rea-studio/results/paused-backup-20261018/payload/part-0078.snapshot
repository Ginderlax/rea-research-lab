    {
      "id": "grafana.candidate.565c3e13298e8f876650",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Recording rules allow you to pre-compute frequently used or computationally expensive queries and save the results as a new time series metric. The same alert rule provisioning endpoints support creating recording rules by including the `record` field instead of alert-specific fields like `condition`, `noDataState`, or `execErrState`.",
      "headingPath": [
        "Grafana-managed endpoints",
        "Alert rules",
        "Example Response:",
        "Recording rules"
      ],
      "source": {
        "path": "docs/sources/shared/alerts/alerting_provisioning.md",
        "gitBlobSha": "aa2d47b881f09b496f3b438a9487a05b56c65ff4",
        "sha256": "3b548e3122c7859f6f6838cf99ef98b72faf15a00837f7eb7cc4ded8eef49dfb",
        "lineStart": 225,
        "lineEnd": 225,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/shared/alerts/alerting_provisioning.md#L225-L225"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.0e55fe4018b8717b1549",
      "syntaxRole": "list-item",
      "sourceText": "- The `metric` field must be a valid Prometheus metric name and contain no whitespace.",
      "headingPath": [
        "Grafana-managed endpoints",
        "Alert rules",
        "Example Response:",
        "Recording rules"
      ],
      "source": {
        "path": "docs/sources/shared/alerts/alerting_provisioning.md",
        "gitBlobSha": "aa2d47b881f09b496f3b438a9487a05b56c65ff4",
        "sha256": "3b548e3122c7859f6f6838cf99ef98b72faf15a00837f7eb7cc4ded8eef49dfb",
        "lineStart": 317,
        "lineEnd": 317,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/shared/alerts/alerting_provisioning.md#L317-L317"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
