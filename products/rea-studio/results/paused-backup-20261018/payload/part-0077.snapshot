    {
      "id": "grafana.candidate.169caed2945de0e15b0b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana supports three ways of specifying the IdP metadata.",
      "headingPath": [
        "SAML authentication in Grafana",
        "Identity provider (IdP) registration",
        "IdP metadata"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/_index.md",
        "gitBlobSha": "0404f252186b683cd8a612ddaa68e1834993fdf3",
        "sha256": "2afa4049b36a250abb3e57bac54b2c765fb533f7863199ae4c2812735fe3dc61",
        "lineStart": 87,
        "lineEnd": 87,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/saml/_index.md#L87-L87"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
