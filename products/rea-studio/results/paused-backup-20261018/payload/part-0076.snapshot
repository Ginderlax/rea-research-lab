    {
      "id": "grafana.candidate.972fb73f940e384e20ce",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Alert queries cannot contain template variables. Grafana evaluates alert rules on the backend without dashboard context, so variables like `$hostname` or `$environment` won't be resolved.",
      "headingPath": [
        "MySQL alerting",
        "Limitations",
        "Template variables not supported"
      ],
      "source": {
        "path": "docs/sources/datasources/mysql/alerting/index.md",
