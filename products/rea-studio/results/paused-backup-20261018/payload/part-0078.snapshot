    {
      "id": "grafana.candidate.4578729c3c75a8011871",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A panel snapshot shares an interactive panel publicly while removing sensitive data such as queries and panel links, leaving only visible metrics and series names. Anyone with the link can access the snapshot.",
      "headingPath": [
        "Share dashboards and panels",
        "Share panels",
        "Share a snapshot"
      ],
      "source": {
