import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const here=fileURLToPath(new URL('./',import.meta.url)),repo=path.resolve(here,'../../outputs/rea-research-lab'),digest=bytes=>createHash('sha256').update(bytes).digest('hex');
const runBytes=await fs.readFile(path.join(here,'results/run-validation.json'));
assert.equal(digest(runBytes),'4c21f5715535557f652265c57c0e7fd295bb0bbadc225940f1a52910e1366769');
const run=JSON.parse(runBytes),before=JSON.parse(await fs.readFile(path.join(here,'source-before.json'))),after=JSON.parse(await fs.readFile(path.join(here,'source-after.json')));
assert.deepEqual(before,after);assert.deepEqual(run.sourceIdentities,before);assert.ok(Object.values(run.checks).every(Boolean));
for(const item of before){const bytes=await fs.readFile(path.join(repo,item.path));assert.equal(bytes.length,item.bytes,item.path);assert.equal(digest(bytes),item.sha256,item.path);}
assert.equal(digest(await fs.readFile(path.join(here,'review.mjs'))),run.reviewerSourceSHA256);
const inventory={};
async function walk(folder,prefix=''){for(const item of await fs.readdir(folder,{withFileTypes:true})){const relative=prefix+item.name;if(item.isDirectory())await walk(path.join(folder,item.name),relative+'/');else{assert.notEqual(relative,'review-validation.json','Already frozen');const bytes=await fs.readFile(path.join(folder,item.name));inventory[relative]={bytes:bytes.length,sha256:digest(bytes)};}}}
await walk(here);
const receipt={schema:'rea-sketch-collector-independent-review/v1',frozenAtUtc:new Date().toISOString(),summary:run.summary,runInterval:{start:run.runStartedAtUtc,end:run.runCompletedAtUtc},runtime:run.runtime,runReceipt:{path:'results/run-validation.json',sha256:digest(runBytes)},sourceIdentityCount:before.length,productionSourcesVerifiedUnchanged:true,stageSnapshotsVerified:54,adapterSnapshotsVerified:27,currentIntegrationReceiptSHA256:'9f2af4ee3ffa9fc3ddd5fd5b2467e2e222725f02e39e0b165427e235f954191d',historicalGeometryReceiptSHA256:'728f28d2aa5d7ebf1155db9a553f60d67029df46ddb512c15135ddf431333a91',historicalCollectorSHA256:'cf044f4be673201b19247cb9bc9d31c86d713aef70d51fdb6c3508332a49621d',recordedChildExecutions:14,allRecordedOwnedRootAndDescendantPidsAbsent:run.checks.allRecordedOwnedPidsDead,failedIndependentRuns:0,newReproducedDefects:0,staticBoundaryFindings:[{helperLines:[13,35],description:'Exited root prevents descendant cleanup; confirmed flag does not establish descendant absence',alreadyDisclosed:true,executedReproduction:false},{helperLines:[46,58,62],description:'Fingerprint/diagnostic filesystem I/O lacks wall-clock deadlines; endpoint hashes and exclusive sequential writes are not continuous/atomic guarantees',alreadyDisclosed:true,executedReproduction:false},{collectorLines:[18,19,20],description:'Bootstrap, inventories and trusted in-process legacy oracle are outside child deadline',alreadyDisclosed:true,executedReproduction:false}],geometry28Executed:false,originalExcalidrawHelpersExecuted:false,productionCollectorExecuted:false,productionChanged:false,historicalEvidenceRebound:false,performanceMeasured:false,machineIsolationEstablished:false,universalSecurityEstablished:false,fullFeatureParity:false,scope:'Exact CURRENT production17 synthetic tests plus static review; owned private work/temp artifacts only, no geometry rerun or publication.',inventory};
await fs.writeFile(path.join(here,'review-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({receipt:'review-validation.json',sha256:digest(await fs.readFile(path.join(here,'review-validation.json'))),inventoryFiles:Object.keys(inventory).length,summary:run.summary,sourceIdentityCount:before.length}));
