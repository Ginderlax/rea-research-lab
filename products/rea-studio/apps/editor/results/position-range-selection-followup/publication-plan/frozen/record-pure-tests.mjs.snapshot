// Bounded correctness recorder for the proposed pure regressions; no original imports.
import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import {spawn}from'node:child_process';import{createHash}from'node:crypto';
const root=import.meta.dirname,run=path.join(root,'runs/final-pure13'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});await fs.mkdir(run,{recursive:true});
const live=JSON.parse(await fs.readFile(path.join(root,'live-copy-list.json'))).proposals,files=['record-pure-tests.mjs','prepare.mjs','pure-regression-scope.json',...live.map(r=>r.proposalPath)];const before=[];for(const p of files){const b=await fs.readFile(path.join(root,p));before.push({path:p,...id(b)});const d=path.join(run,'source-before',p+'.snapshot');await fs.mkdir(path.dirname(d),{recursive:true});await fs.writeFile(d,b,{flag:'wx'});}await fs.writeFile(path.join(run,'source-before.json'),JSON.stringify(before,null,2)+'\n',{flag:'wx'});
const runtime=live.find(r=>r.runtime);assert.equal(runtime.after.sha256,'9f5d89b260e88fc1c2197d23a9c2b0ca25fcff688c5eba839471c7a4fe499aa8');const source=(await fs.readFile(path.join(root,'proposed/products/rea-studio/apps/editor/position-range-selection.test.mjs'))).toString();assert.ok(!/node:fs|node:vm|typescript|original-oracle|process\.env|writeFile/.test(source));const node=await fs.readFile(process.execPath),nodeIdentity=id(node);assert.equal(nodeIdentity.sha256,'b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3');
const args=['--max-old-space-size=128','--test','--test-reporter=tap',path.join(root,'proposed/products/rea-studio/apps/editor/position-range-selection.test.mjs')],env={...process.env};delete env.NODE_TEST_CONTEXT;delete env.NODE_OPTIONS;let stdout=[],stderr=[],out=0,err=0,limit=null;const started=new Date().toISOString();
const child=spawn(process.execPath,args,{cwd:root,env,windowsHide:true,stdio:['ignore','pipe','pipe']});const stop=reason=>{limit??=reason;child.kill();};const timer=setTimeout(()=>stop('child-deadline30s'),30000);child.stdout.on('data',b=>{out+=b.length;if(out<=1024*1024)stdout.push(b);else stop('stdout1MiB');});child.stderr.on('data',b=>{err+=b.length;if(err<=1024*1024)stderr.push(b);else stop('stderr1MiB');});let spawnError=null;const result=await new Promise(resolve=>{child.on('error',e=>{spawnError=String(e);});child.on('close',(code,signal)=>resolve({code,signal}));});clearTimeout(timer);const ob=Buffer.concat(stdout),eb=Buffer.concat(stderr);await fs.writeFile(path.join(run,'stdout.txt'),ob,{flag:'wx'});await fs.writeFile(path.join(run,'stderr.txt'),eb,{flag:'wx'});
const after=[];for(const p of files){const b=await fs.readFile(path.join(root,p)),r={path:p,...id(b)};assert.deepEqual(r,before.find(r=>r.path===p));after.push(r);}await fs.writeFile(path.join(run,'source-after.json'),JSON.stringify(after,null,2)+'\n',{flag:'wx'});const tap=ob.toString(),summary={tests:Number(tap.match(/^# tests (\d+)$/m)?.[1]),pass:Number(tap.match(/^# pass (\d+)$/m)?.[1]),fail:Number(tap.match(/^# fail (\d+)$/m)?.[1]),skipped:Number(tap.match(/^# skipped (\d+)$/m)?.[1])};const receipt={schema:'rea-editor-pure-value-api-regression-record/v1',started,finished:new Date().toISOString(),node:nodeIdentity,nodeVersion:process.version,argv:args,pid:child.pid,...result,spawnError,limit,bounds:{childDeadlineMs:30000,stdoutMaxBytes:1048576,stderrMaxBytes:1048576,oldSpaceMiB:128,hardRSSClaim:false,descendantRaceFreeClaim:false},summary,stdout:id(ob),stderr:id(eb),sources:before,sourceStable:true,applicationCandidateGroups:13,originalLibraryEvaluations:0,originalProgramExecutions:0,originalGUI:0,hosts:0,browser:0,benchmarks:0,performanceClaims:false,scriptOutputWritesOnlyOwnedRecorder:true,normalTestsWriteSourceResults:false};await fs.writeFile(path.join(run,'validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});assert.equal(result.code,0);assert.equal(result.signal,null);assert.equal(spawnError,null);assert.equal(limit,null);assert.deepEqual(summary,{tests:13,pass:13,fail:0,skipped:0});console.log(JSON.stringify({summary,sourceStable:true,originalEvaluations:0,node:nodeIdentity,receipt:id(await fs.readFile(path.join(run,'validation.json')))}));
