        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.96dd002323e6bf3a057a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you use **Aggregate by**, the selections you make determine how the information is reported in the Table. Every combination that matches selections in your data is listed in the table. Each aggregate value, for example `intrinsic`:`name`, has a corresponding column in the results table.",
      "headingPath": [
        "Write TraceQL queries using Search",
        "Define filters",
        "Optional: Use Aggregate by",
        "Use Aggregate by"
      ],
