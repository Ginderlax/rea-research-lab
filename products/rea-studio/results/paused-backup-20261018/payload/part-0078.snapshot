    },
    {
      "id": "grafana.candidate.53d4d0b44749b2089eca",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Library panels can be reused in different dashboards throughout Grafana. When you create a library panel, the panel on the source dashboard is converted to a library panel as well. You need to save the original dashboard once a panel is converted.",
      "headingPath": [
        "Manage library panels",
        "Create a library panel"
      ],
