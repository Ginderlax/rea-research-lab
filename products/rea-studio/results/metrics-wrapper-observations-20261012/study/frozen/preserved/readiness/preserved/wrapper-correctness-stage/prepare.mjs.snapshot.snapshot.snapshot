import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),prior=path.resolve(here,'../metrics-selector-algorithm-next'),measured=path.resolve(here,'../metrics-algorithm-measurement-next'),sha=data=>createHash('sha256').update(data).digest('hex'),fp=async file=>{const bytes=await fs.readFile(file);return {bytes:bytes.length,sha256:sha(bytes)};};
await fs.mkdir(path.join(here,'preserved'),{recursive:true});await fs.mkdir(path.join(here,'results'),{recursive:true});const copies=[];
async function copy(root,name,target=name){const data=await fs.readFile(path.join(root,name)),dest=path.join(here,target);await fs.mkdir(path.dirname(dest),{recursive:true});await fs.writeFile(dest,data,{flag:'wx'});copies.push({sourceRoot:root,sourcePath:name,path:target,bytes:data.length,sha256:sha(data)});}
const production=path.resolve(here,'../../outputs/rea-research-lab/products/rea-studio/apps/metrics/native-calculations.mjs'),baseline=await fs.readFile(production,'utf8');assert.equal(sha(baseline),'9269cf8c32be9bf2c075b67019e82e41272d9495f0321fefc17b2c5695a91371');
await fs.writeFile(path.join(here,'candidate-baseline.mjs'),baseline,{flag:'wx'});
const importLine="import { singlePercentile } from './selector-algorithm.mjs';\n",needle="  if (/^p\\d+$/.test(id)) {\n",insertion="    if (!shared) return singlePercentile(id, field, ignore, zero);\n";assert.equal(baseline.split(needle).length,2);
const candidate=importLine+baseline.replace(needle,needle+insertion);assert.equal(candidate.slice(importLine.length).replace(insertion,''),baseline);await fs.writeFile(path.join(here,'candidate-wrapper.mjs'),candidate,{flag:'wx'});
for(const name of ['selector-algorithm.mjs','authenticate-original.mjs','canonical.mjs','verify-candidate.mjs','verify-heldout-selection.mjs','verify-standard-heldout.mjs','run-validation.mjs'])await copy(prior,name);
assert.equal((await fp(path.join(here,'selector-algorithm.mjs'))).sha256,'de334c498bb286c640661d8a3df05794fb66ebb02a3629231f18dbcb3c9bd58c');
for(const [root,name,target]of [[prior,'preserved/sources.json','preserved/sources.json'],[prior,'candidate-contract.json','preserved/prior-algorithm-contract.json'],[prior,'stage-validation.json','preserved/prior-algorithm-validation.json'],[prior,'freeze-manifest.json','preserved/prior-algorithm-freeze.json'],[measured,'candidate-algorithm.mjs','preserved/measured-candidate-algorithm.mjs'],[measured,'selector-algorithm.mjs','preserved/measured-selector-algorithm.mjs'],[measured,'timing-worker.mjs','preserved/measured-timing-worker.mjs'],[measured,'benchmark.mjs','preserved/measured-benchmark.mjs'],[measured,'workloads.mjs','workloads.mjs'],[measured,'memory-preflight.control.json','preserved/measured-manifest.json'],[measured,'original-provenance.json','preserved/original-provenance.json'],[path.resolve(here,'../metrics-algorithm-measurement-review-next'),'recomputed-summary.json','preserved/latest-summary.json'],[path.resolve(here,'../metrics-selector-measurement-review-next'),'recomputed-summary.json','preserved/previous-summary.json']])await copy(root,name,target);
for(const fixture of Object.values(JSON.parse(await fs.readFile(path.join(measured,'memory-preflight.control.json'))).expectedFiles)){await copy(measured,fixture.inputPath);await copy(measured,fixture.path);}
const slice=(text,start,end)=>text.slice(text.indexOf(start),text.indexOf(end,text.indexOf(start))),bodyBindings={};for(const [label,start,end]of [['standard','export function doStandardCalcs','function special('],['registry','const specialIds =','/** Matches fixed released'],['wrapper','export function reduceField(','/** Lossless JSON transport'],['transport','export function encodeCalculation','END']]){const get=text=>end==='END'?text.slice(text.indexOf(start)):slice(text,start,end);assert.equal(get(candidate),get(baseline));bodyBindings[label]={byteIdenticalToProduction:true,sha256:sha(get(baseline)),bytes:Buffer.byteLength(get(baseline))};}
const measuredEntry=await fs.readFile(path.join(measured,'candidate-algorithm.mjs'),'utf8'),measuredWrapper=slice(measuredEntry,'export function reduceField(','/** Lossless JSON transport');assert.notEqual(measuredWrapper,slice(baseline,'export function reduceField(','/** Lossless JSON transport'));
const receipt={schema:'rea-metrics-wrapper-prospect-preparation/v1',createdAt:new Date().toISOString(),production:{path:production,...await fp(production)},candidate:{entry:'candidate-wrapper.mjs',...await fp(path.join(here,'candidate-wrapper.mjs')),helper:'selector-algorithm.mjs',helperSHA256:(await fp(path.join(here,'selector-algorithm.mjs'))).sha256},changes:{import:importLine.trim(),onlySpecialBodyInsertion:insertion.trim(),inverseSubstitutionReconstructsExactBaseline:true,sharedAbsentOnly:true},bodyBindings,latestMeasuredWrapperNotByteIdenticalToProduction:true,latestArithmeticAndCollectionSemanticsPreservedAsHistoricalClaim:true,copies,selectionAlgorithmChanged:false,stageSelected:false,performanceMeasured:false,profileRun:false,productionChanged:false};await fs.writeFile(path.join(here,'preparation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:'prepared',candidateSHA256:receipt.candidate.sha256,helperSHA256:receipt.candidate.helperSHA256,baselineBodiesExact:Object.keys(bodyBindings),performanceMeasured:false}));
