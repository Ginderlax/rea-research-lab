    },
    {
      "id": "grafana.candidate.dc87896d19b10e3b45ef",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The randomization factor for exponential backoff retries. Default is `0.1`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[unified_alerting]`",
        "`randomization_factor`"
      ],
      "source": {
