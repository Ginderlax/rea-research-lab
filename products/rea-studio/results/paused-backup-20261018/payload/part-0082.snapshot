 { id: 'grafana-gap-rendered-includes', status: 'open', detail: 'Shared Markdown exists within this corpus, but Hugo shortcode expansion, inherited frontmatter, same-file shared blocks, refs resolution and exact rendered document structure have not been reproduced.' },
 { id: 'grafana-gap-external', status: 'open', detail: 'External plugin documentation, linked tutorials, rolling Grafana Cloud docs, SDK/API-generated content, configuration source defaults and external query-language specifications are not exhaustively pinned by this 772-file corpus.' },
 { id: 'grafana-gap-visual-code', status: 'open', detail: 'Screenshots, videos, play.grafana.org demos and arbitrary code-block examples are retained/referenced, but their extra feature details have not been extracted. The lexical scanner excludes code fences except selected formatting examples.' },
 { id: 'grafana-gap-acceptance', status: 'open', detail: 'No contract in this inventory has been executed against a complete original Grafana instance. Local Metrics support and previous component evidence are not used to mark source requirements complete.' },
 { id: 'grafana-gap-atomicity', status: 'open', detail: 'The authored contracts are bounded direct source behaviors/examples. Full input domains, error paths, limits, settings interactions, persistence/restart, accessibility and permission matrices remain to be normalized. Candidate counts are not feature counts.' },
];
const reviewQueue = documents.filter(document => document.applicability.status !== 'excluded-by-explicit-document-products').map(document => ({ path: document.path, sha256: document.sha256, documentScope: document.applicability.status, candidateStatements: document.candidateCount, existingAuthoredContracts: document.authoredContractCount, nextStatus: 'full-semantic-review-and-edition-resolution-pending' }));
