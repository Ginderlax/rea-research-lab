import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const root=process.cwd(),stage=path.join(root,'work/root-notes-sketch-implementation-references-next'),own=path.join(root,'work/root-notes-sketch-implementation-references-independent-review');fs.mkdirSync(own,{recursive:true});const sha=b=>createHash('sha256').update(b).digest('hex'),t=JSON.parse(fs.readFileSync(path.join(stage,'transformation.json'))),epochs=[];let total=0;for(const e of t.changes){const name=path.basename(e.path),before=fs.readFileSync(path.join(stage,name+'.before.snapshot')),after=fs.readFileSync(path.join(stage,name+'.after.snapshot'));for(const[b,r]of[[before,e.before],[after,e.after]]){assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256)}assert.ok(after.equals(fs.readFileSync(path.join(root,'outputs/rea-research-lab',e.path))));let text=after.toString();for(const row of e.rows){const omit=x=>Object.fromEntries(Object.entries(x).filter(([k])=>!['sha256','bytes'].includes(k)));assert.deepEqual(omit(row.before),omit(row.after));const live=fs.readFileSync(path.join(root,'outputs/rea-research-lab',row.path));assert.equal(live.length,row.after.bytes);assert.equal(sha(live),row.after.sha256);const matches=[];function find(value,where=[]){if(value&&typeof value==='object'){if(JSON.stringify(value)===JSON.stringify(row.after))matches.push(where);for(const[k,v]of Object.entries(value))find(v,[...where,k])}}const a=JSON.parse(text);find(a);assert.equal(matches.length,1);let obj=a;for(const k of matches[0].slice(0,-1))obj=obj[k];obj[matches[0].at(-1)]={...row.before};const spaces=/\n([ ]+)\"/.exec(text)?.[1].length??2;const reconstructed=JSON.stringify(a,null,spaces)+(text.endsWith('\n')?'\n':'');text=reconstructed;total++}assert.ok(Buffer.from(text).equals(before));epochs.push({path:e.path,before:e.before,after:e.after,rows:e.rows.length,inverseExact:true})}assert.equal(total,8);const result={schema:'rea-implementation-reference-independent-source-review/v1',at:new Date().toISOString(),epochs,changedRows:8,onlyBytesSHAFieldsChanged:true,liveNamedFilesMatch:true,allOtherJSONBytesReconstructExactly:true,sourceIDsCapabilityObjectsAndParityGatesUnchangedByTheseTransforms:true,noBehaviorExecutions:true,noRepoWrites:true,noBlockingSourceFlawFound:true};const b=Buffer.from(JSON.stringify(result,null,2)+'\n');fs.writeFileSync(path.join(own,'review-validation.json'),b);const mb=Buffer.from(JSON.stringify({schema:'rea-strict-independent-review/v1',inventory:[{path:'review-validation.json',bytes:b.length,sha256:sha(b)}]},null,2)+'\n');fs.writeFileSync(path.join(own,'review-manifest.json'),mb);console.log(JSON.stringify({receipt:sha(b),manifest:sha(mb),rows:total,inverse:true}));
