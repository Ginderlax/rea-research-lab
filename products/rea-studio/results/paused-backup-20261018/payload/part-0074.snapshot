    {
      "id": "grafana.candidate.d8ea2f39ac86999722c4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "There is no maximum duration for a silence. You can create a silence for any length of time. However, administrators can configure the following limits:",
