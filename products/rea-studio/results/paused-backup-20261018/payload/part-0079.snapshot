    {
      "id": "grafana.candidate.4441143dadecb8b38306",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We've made enhancements to Grafana's log context feature, resulting in a more seamless and consistent user experience. With the updated user interface, you can expect the same level of functionality and usability in log context as you would in any other logs panel.",
      "headingPath": [
        "What’s new in Grafana v10.0",
        "Dashboards and visualizations",
        "Redesigned and improved log context"
      ],
      "source": {
