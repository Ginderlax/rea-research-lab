    {
      "id": "grafana.candidate.2c0573c63d90144c32fc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Configures for how long alert annotations are stored. Default is 0, which keeps them forever. This setting should be expressed as an duration. Ex 6h (hours), 10d (days), 2w (weeks), 1M (month).",
