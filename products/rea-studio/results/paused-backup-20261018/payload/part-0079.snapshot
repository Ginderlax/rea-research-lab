    {
      "id": "grafana.candidate.266033fede765cea0bf6",
      "syntaxRole": "table-row",
      "sourceText": "| Color | Configures the color of the edges. The default `Fixed color` sets all edges to a specific color. There is also an option to have conditional colors depending on the selected field data point values and the color scheme set in the `Standard options` section. |",
      "headingPath": [
        "Geomap",
        "Configuration options",
        "Map layers options",
        "Network layer",
        "Edge styles options"
      ],
