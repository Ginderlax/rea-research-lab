    {
      "id": "grafana.candidate.121d7f8406035ea89180",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The following issues occur when using template variables with InfluxDB queries.",
      "headingPath": [
        "Troubleshoot InfluxDB data source issues",
        "Template variable errors"
      ],
      "source": {
        "path": "docs/sources/datasources/influxdb/troubleshooting/index.md",
