import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{pathToFileURL}from'node:url';import{spawnSync}from'node:child_process';const here=import.meta.dirname,repo=path.resolve(here,'../../outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),proposal=await fs.readFile(path.join(here,'proposed/verify-followup-records.mjs'));assert.equal(sha(proposal),'4f069fd26951fb74653f9cb52d5531aa98b5d638a5b85737eb3191b3bd5d5780');const before=JSON.parse(await fs.readFile(path.join(here,'source-before.json')));for(const r of before.rows)assert.equal(sha(await fs.readFile(path.join(repo,r.path))),r.sha256);let adapter=proposal.toString();const changes=[];for(const f of['verify-notes-vault-followups.mjs','verify-notes-inline-followups.mjs']){const a="from './"+f+"'",b='from '+JSON.stringify(pathToFileURL(path.join(repo,'scripts',f)).href);assert.equal(adapter.split(a).length,2);adapter=adapter.replace(a,b);changes.push({before:a,after:b});const old=await fs.readFile(path.join(here,'before',f+'.snapshot'));assert.equal(sha(await fs.readFile(path.join(repo,'scripts',f))),sha(old));}const a="verifyFollowupRecords(resolve(import.meta.dirname,'..'))",b='verifyFollowupRecords('+JSON.stringify(repo)+')';assert.equal(adapter.split(a).length,2);adapter=adapter.replace(a,b);changes.push({before:a,after:b});await fs.mkdir(path.join(here,'execution-adapter'),{recursive:true});await fs.writeFile(path.join(here,'execution-adapter/verify-followup-records.mjs'),adapter,{flag:'wx'});await fs.writeFile(path.join(here,'execution-adapter/transformations.json'),JSON.stringify({proposalSHA256:sha(proposal),executedSHA256:sha(adapter),changes,onlyMetadataDependencyAndExplicitRootAdapters:true,sourceSemanticsEdited:false},null,2)+'\n',{flag:'wx'});const check=spawnSync(process.execPath,['--check',path.join(here,'execution-adapter/verify-followup-records.mjs')],{encoding:'utf8',windowsHide:true});assert.equal(check.status,0,check.stderr);const started=new Date().toISOString(),r=spawnSync(process.execPath,[path.join(here,'execution-adapter/verify-followup-records.mjs'),'--standalone'],{cwd:repo,encoding:'utf8',windowsHide:true,timeout:60000,maxBuffer:4*1024*1024});await fs.writeFile(path.join(here,'observations/proposal-standalone.stdout.txt'),r.stdout??'',{flag:'wx'});await fs.writeFile(path.join(here,'observations/proposal-standalone.stderr.txt'),r.stderr??'',{flag:'wx'});for(const s of before.rows)assert.equal(sha(await fs.readFile(path.join(repo,s.path))),s.sha256);await fs.writeFile(path.join(here,'observations/proposal-standalone.json'),JSON.stringify({started,ended:new Date().toISOString(),exitCode:r.status,signal:r.signal,spawnError:r.error?{name:r.error.name,message:r.error.message}:null,sourceStable:true,executedSHA256:sha(adapter),proposalSHA256:sha(proposal),sourceOnlyVerification:true,behavioralTestsExecuted:0,originalExecutions:0,browser:0,hosts:0,benchmarks:0},null,2)+'\n',{flag:'wx'});assert.equal(r.status,0,r.stderr);const result=JSON.parse(r.stdout);assert.equal(result.editorHostTransition.addedStaticMapLineBytes,99);assert.equal(result.editorHostTransition.onlyEditorSaveLiveMismatch,true);assert.equal(result.editorVerification.liveSourceMatch,false);assert.equal(result.editorVerification.liveMismatches.length,1);console.log(JSON.stringify({exitCode:r.status,sourceStable:true,transition:result.editorHostTransition,child:result.editorVerification}));
