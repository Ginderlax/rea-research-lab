// Prospective source-only proof utility. It never imports application/original code.
import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
export const hash=b=>createHash('sha256').update(b).digest('hex');
export const EPOCHS=Object.freeze([
 {id:'author-inline',directory:'notes-inline-confirmation-next',manifest:'freeze-manifest.json',schema:'rea-notes-inline-confirmation-freeze/v1',count:214,sha256:'347ff80e93076df92144915e16257f92ff7910a78ea175be840b8d3fd829dc16'},
 {id:'independent-negative',directory:'notes-inline-confirmation-independent-review',manifest:'review-manifest.json',schema:'rea-notes-inline-confirmation-independent-freeze/v1',count:74,sha256:'bb46812480086025a87028ac8dddc102e6548fc9bd57410fa10de67a28ce3322'},
 {id:'author-cancel-correction',directory:'notes-inline-cancel-no-read-next',manifest:'freeze-manifest.json',schema:'rea-notes-inline-cancel-correction-strict-input-manifest/v1',count:229,sha256:'5fcb71d9abddbbc6d0077da9cbbe0808b7be5ff4d66ce94a747f311ab6a3d7bb'},
 {id:'independent-cancel-acceptance',directory:'notes-inline-cancel-no-read-independent-review',manifest:'review-manifest.json',schema:'rea-notes-inline-cancel-no-read-independent-freeze/v1',count:49,sha256:'dc5263f7197b2004f839ff53a9e2fceb96c265ae85002f9f9f2151fd38235198'}
]);
export const PUBLIC_PREFIX='products/rea-studio/apps/notes/results/inline-confirmation-followup/';
export function safeRelative(p,publicPath=false){assert.equal(typeof p,'string');assert.ok(p.length>0&&p.length<=4096&&!/[\\:\x00-\x1f]/.test(p)&&!p.startsWith('/'));assert.ok(p.split('/').every(s=>s&&s!=='.'&&s!=='..'));if(publicPath)assert.ok(!p.split('/').some(s=>['.local','work','artifacts','tooling','node_modules'].includes(s)));return p;}
export function identity(b){assert.ok(Buffer.isBuffer(b)&&b.length<=32*1024*1024);return{bytes:b.length,sha256:hash(b)};}
export function same(a,b){assert.ok(Number.isSafeInteger(b.bytes)&&b.bytes>=0&&b.bytes<=32*1024*1024);assert.match(b.sha256,/^[0-9a-f]{64}$/);assert.deepEqual(a,{bytes:b.bytes,sha256:b.sha256});}
export async function readBounded(root,rel,expected){safeRelative(rel);const base=await fs.realpath(root);let current=base;for(const segment of rel.split('/')){current=path.join(current,segment);assert.equal((await fs.lstat(current)).isSymbolicLink(),false,'Symlink/reparse path');}const actual=await fs.realpath(current),r=path.relative(base,actual);assert.ok(r&&!r.startsWith('..'+path.sep)&&r!=='..'&&!path.isAbsolute(r));const s=await fs.stat(current);assert.ok(s.isFile()&&s.size<=32*1024*1024);const b=await fs.readFile(current);assert.equal(b.length,s.size);if(expected)same(identity(b),expected);return b;}
export function manifestRows(m){let rows;if(Array.isArray(m.records))rows=m.records;else{assert.ok(m.inventory&&typeof m.inventory==='object'&&!Array.isArray(m.inventory));rows=Object.entries(m.inventory).map(([p,r])=>({path:p,...r}));}assert.ok(rows.length<=1000);const seen=new Set();for(const r of rows){safeRelative(r.path);same({bytes:r.bytes,sha256:r.sha256},r);assert.ok(!seen.has(r.path));seen.add(r.path);}return rows;}
async function walk(root,rel='',all=[]){assert.ok(rel.split('/').length<=40&&all.length<=1000);for(const e of await fs.readdir(path.join(root,rel),{withFileTypes:true})){const p=(rel?rel+'/':'')+e.name;safeRelative(p);assert.equal(e.isSymbolicLink(),false);if(e.isDirectory())await walk(root,p,all);else{assert.ok(e.isFile());all.push(p);}}return all;}
export async function authenticateEpoch(workspace,e){const root=path.join(workspace,'work',e.directory),mb=await readBounded(root,e.manifest),m=JSON.parse(mb);assert.equal(hash(mb),e.sha256);assert.equal(m.schema,e.schema);const rows=manifestRows(m);assert.equal(rows.length,e.count);if(m.files!==undefined)assert.equal(m.files,e.count);assert.deepEqual((await walk(root)).sort(),[...rows.map(r=>r.path),e.manifest].sort());let total=0;for(const r of rows){const b=await readBounded(root,r.path,r);total+=b.length;assert.ok(total<=64*1024*1024);}return{id:e.id,directory:e.directory,manifest:e.manifest,manifestIdentity:identity(mb),schema:m.schema,payloadFiles:rows.length,payloadBytes:total,rows};}
const segmentNames={'.local':'private-study-records',work:'workspace-records',artifacts:'source-material',tooling:'verification-tool-source',node_modules:'dependency-source'};
export function publicPath(epoch,sourcePath){safeRelative(epoch);safeRelative(sourcePath);const result=PUBLIC_PREFIX+epoch+'/'+sourcePath.split('/').map(s=>segmentNames[s]??s).join('/')+'.snapshot';return safeRelative(result,true);}
export function carrier(b){const headers=[['MZ','4d5a'],['ELF','7f454c46'],['ZIP','504b0304'],['ZIP','504b0506'],['ZIP','504b0708'],['GZIP','1f8b'],['7z','377abcaf271c'],['XZ','fd377a585a00'],['Zstandard','28b52ffd'],['KDBX','03d9a29a67fb4bb5']];for(const[n,h]of headers)if(b.subarray(0,h.length/2).toString('hex')===h)return n;if(b.subarray(257,262).toString()==='ustar')return'TAR';return null;}
export function classify(b,p){let kind=carrier(b);if(kind)return{publishable:false,kind,reason:'Native executable/library/database/archive bytes retained locally with exact per-path identity'};if(b.subarray(0,8).toString('hex')==='89504e470d0a1a0a'){assert.match(p,/^browser\/.+\.png$/);return{publishable:true,kind:'owned-review-browser-PNG',qualification:'Historical exact author214 browser evidence only; not corrected-client browser acceptance'};}assert.equal(b.toString('utf8').includes('\uFFFD'),false,'Unexpected non-UTF8 source/observation carrier');return{publishable:true,kind:'source-or-observation-UTF8'};}
export function exactImportAdapter(text,replacements){let adapted=text;const counts=[];for(const[from,to]of replacements){assert.ok(from!==to);let count=0;adapted=adapted.split('\n').map(l=>{if(!l.includes(from))return l;assert.match(l,/^import\s/,'Only complete import lines may be adapted');count+=l.split(from).length-1;return l.split(from).join(to);}).join('\n');assert.ok(count>0);counts.push({from,to,occurrences:count});}return{adapted,counts};}
export function assertHistoricalReplacementMap(installation,proposals){assert.equal(installation.installed.length,34);const wanted=new Map(proposals.map(p=>[p.destination,p])),mapped=installation.installed.map(r=>({destination:r.destination,historicalAfter:r.after,currentExpected:wanted.get(r.destination)?.after??r.after,mode:wanted.has(r.destination)?'explicit-later-replacement':'retain-historical-installed-bytes'}));assert.equal(mapped.filter(r=>r.mode==='explicit-later-replacement').length,6);assert.equal(mapped.filter(r=>r.mode==='retain-historical-installed-bytes').length,28);assert.equal(mapped.find(r=>r.destination.endsWith('/notes/client.mjs')).historicalAfter.sha256,'c57fe2ee532fa9ce8c8afeaa1e777428fc74ce30bebc5c4e76782169ee602d87');return mapped;}
