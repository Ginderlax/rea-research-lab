function captureTooling(proof){for(const row of proof.paths)writeBytes('tooling-source/'+row.path+'.snapshot',committed(row.path,row));}
let installation,before,child=null,stopActive=null,interrupted=null;
const stopHandlers=new Map(['SIGINT','SIGTERM'].map(signal=>[signal,()=>{interrupted=signal;stopActive?.('collector-'+signal);} ]));for(const[signal,handler]of stopHandlers)process.on(signal,handler);
const quietPipe=()=>{};for(const stream of[process.stdout,process.stderr])stream.on('error',quietPipe);
async function run(arguments_,milliseconds,label,environment={}){
 const outFd=fs.openSync(path.join(evidence,role+'-stdout.txt'),'wx'),errFd=fs.openSync(path.join(evidence,role+'-stderr.txt'),'wx'),eventsFd=fs.openSync(path.join(evidence,role+'-events.jsonl'),'wx');
 const result={label,command:[process.execPath,...arguments_],startedAtUtc:new Date().toISOString(),exitCode:null,signal:null,closeObserved:false,spawnError:null,stopReason:null,stdoutBytes:0,stderrBytes:0,droppedOutputBytes:0};record.children.push(result);
 let sequence=0,deadline,forced,progress;
 const event=(kind,value={})=>fs.writeSync(eventsFd,JSON.stringify({sequence:++sequence,atUtc:new Date().toISOString(),kind,...value})+'\n');
 try{
  const outcome=await new Promise(resolve=>{let finished=false;const finish=(code,signal,closed)=>{if(finished)return;finished=true;clearTimeout(deadline);clearTimeout(forced);clearInterval(progress);resolve({code,signal,closed});};
   stopActive=reason=>{if(result.stopReason)return;result.stopReason=reason;event('stop-requested',{reason,pid:child?.pid??null});if(child?.pid&&child.exitCode===null){const killed=spawnSync('taskkill',['/PID',String(child.pid),'/T','/F'],{shell:false,windowsHide:true,timeout:10000,stdio:'ignore'});if(killed.status!==0)child.kill('SIGKILL');}forced=setTimeout(()=>{child?.stdout?.destroy();child?.stderr?.destroy();finish(null,null,false);},5000);};
   const env={...process.env,...environment};delete env.NODE_TEST_CONTEXT;child=spawn(process.execPath,arguments_,{cwd:role==='finite'?studio:tools,env,shell:false,windowsHide:true,stdio:['ignore','pipe','pipe']});result.pid=child.pid??null;event('child-started',{pid:result.pid});
   for(const[kind,stream,fd,consoleStream,cap]of[['stdout',child.stdout,outFd,process.stdout,16*1024*1024],['stderr',child.stderr,errFd,process.stderr,4*1024*1024]]){stream.on('data',bytes=>{const key=kind+'Bytes',take=Math.min(bytes.length,Math.max(0,cap-result[key]));if(take){fs.writeSync(fd,bytes.subarray(0,take));consoleStream.write(bytes.subarray(0,take));result[key]+=take;}result.droppedOutputBytes+=bytes.length-take;if(bytes.length>take)stopActive('output-bound');});stream.on('error',error=>{event('pipe-error',{kind,message:error.message});stopActive('pipe-error');});}
   child.on('error',error=>{result.spawnError={name:error.name,message:error.message,code:error.code??null};event('spawn-error',result.spawnError);});child.on('close',(code,signal)=>finish(code,signal,true));deadline=setTimeout(()=>stopActive('deadline'),milliseconds);progress=setInterval(()=>{event('progress',{pid:result.pid,stdoutBytes:result.stdoutBytes,stderrBytes:result.stderrBytes});for(const fd of[outFd,errFd,eventsFd])fs.fsyncSync(fd);},10000);
  });Object.assign(result,{exitCode:outcome.code,signal:outcome.signal,closeObserved:outcome.closed,completedAtUtc:new Date().toISOString()});event('child-closed',result);
 }finally{stopActive=null;child=null;clearTimeout(deadline);clearTimeout(forced);clearInterval(progress);for(const fd of[outFd,errFd,eventsFd]){fs.fsyncSync(fd);fs.closeSync(fd);}}
 assert.equal(interrupted,null);assert.equal(result.exitCode,0);assert.equal(result.signal,null);assert.equal(result.closeObserved,true);assert.equal(result.spawnError,null);assert.equal(result.stopReason,null);assert.equal(result.droppedOutputBytes,0);return result;
}
