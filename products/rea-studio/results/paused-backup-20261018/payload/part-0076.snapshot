    {
      "id": "grafana.candidate.a35d898ba515cdce5605",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When **Multi-value** or **Include All** is enabled for the variable, the value becomes a regular expression pattern, such as `value1|value2`. Use the `=~` operator instead of `=` in your label selector:",
      "headingPath": [
