import fs from 'node:fs/promises';
import {createReadStream} from 'node:fs';
import path from 'node:path';
import {createHash} from 'node:crypto';
import {createRequire} from 'node:module';
import assert from 'node:assert/strict';
import {authenticateOriginal,here,sha} from './authenticate-original.mjs';
import {canonical,packet,valuesFor,metadataFor} from './canonical.mjs';
const authority=await authenticateOriginal(),require=createRequire(authority.entry),original=require(authority.entry),baseline=path.join(here,'candidate-baseline.mjs');
const variants={standard:{candidate:'candidate-invariant-dispatch.mjs',fullReceipt:'results/candidate-invariant-dispatch.json',provenance:'Current-stage full exact original replay.'},percentile:{candidate:'candidate-percentile-isolated.mjs',fullReceipt:'preserved/percentile/results/candidate-isolated.json',provenance:'Exact source-identical copy; unchanged historical full original receipt retains its executed earlier-stage path.'}};
for(const spec of Object.values(variants)){const full=JSON.parse(await fs.readFile(path.join(here,spec.fullReceipt)));assert.equal(full.status,'passed');assert.equal(full.implementationSha256,sha(await fs.readFile(path.join(here,spec.candidate))));}
const all=Object.keys(original.ReducerID),percentiles=all.filter(id=>/^p\d+$/.test(id)),cases={smallStandard:{n:100,reducers:['mean','min','max','sum','delta'],warmup:20000,transient:100000,retained:10000},largeStandard:{n:25000,reducers:['mean','min','max','sum','delta'],warmup:500,transient:2000,retained:10000},singlePercentile:{n:25000,reducers:['p95'],warmup:100,transient:200,retained:256},allPercentiles:{n:25000,reducers:percentiles,warmup:2,transient:16,retained:16},allCalculations:{n:25000,reducers:all,warmup:2,transient:16,retained:16}};
await fs.mkdir(path.join(here,'fixtures'),{recursive:true});const expectedFiles={};
for(const [name,spec]of Object.entries(cases)){const field={name:'synthetic',type:'number',config:{nullValueMode:'connected'},values:valuesFor(spec.n),state:{}},result=original.reduceField({field,reducers:spec.reducers}),expected=canonical(packet(field,result)),expectedPath='fixtures/'+name+'.expected.json';assert.ok(Buffer.byteLength(expected)<8*1024*1024);await fs.writeFile(path.join(here,expectedPath),expected+'\n');expectedFiles[name]={path:expectedPath,bytes:Buffer.byteLength(expected+'\n'),sha256:sha(expected+'\n'),canonicalOutputSHA256:sha(expected),inputSHA256:sha(canonical(field.values)),spec};}
const runtimeHash=createHash('sha256');for await(const chunk of createReadStream(process.execPath))runtimeHash.update(chunk);
const baselineBytes=await fs.readFile(baseline);assert.equal(sha(baselineBytes),'9269cf8c32be9bf2c075b67019e82e41272d9495f0321fefc17b2c5695a91371');
const common={schemaVersion:2,checkedAt:new Date().toISOString(),scope:'Original-only unmeasured correctness/expected-output preflight. Five original fresh calculations shared across two separate candidate manifests. No measured worker or memory workload runs here.',authority,runtime:{execPath:process.execPath,executableSHA256:runtimeHash.digest('hex'),version:process.version,versions:process.versions,platform:process.platform,arch:process.arch},expectedMetadataSHA256:sha(canonical(metadataFor(original))),expectedFiles,limits:{samplesPerWorkloadAndImplementation:7,childWallSeconds:120,childOldSpaceMiB:256,childRSSMiB:512,stdoutBytes:4*1024*1024},expectedCounts:{originalFreshCalculationCallsForBothManifests:5,measuredWarmupCalls:0,measuredTransientCalls:0,measuredRetentionCalls:0},canonicalSourceSHA256:sha(await fs.readFile(path.join(here,'canonical.mjs'))),originalOnlyCJSModules:Object.keys(require.cache).filter(name=>name.startsWith(path.dirname(authority.entry).split(path.sep+'package'+path.sep)[0])),memoryMeasurementRun:false,performanceEstablished:false,fullProductComplete:false,universalSuperiorityEstablished:false};
for(const [variant,spec]of Object.entries(variants)){const candidate=path.join(here,spec.candidate),manifest={...common,variant,implementations:{original:authority,baseline:{entry:baseline,format:'esm',files:{[baseline]:sha(baselineBytes)}},candidate:{entry:candidate,format:'esm',files:{[candidate]:sha(await fs.readFile(candidate))}}},fullSemanticReceipt:spec.fullReceipt,fullSemanticReceiptSHA256:sha(await fs.readFile(path.join(here,spec.fullReceipt))),candidateProvenance:spec.provenance},output=JSON.stringify(manifest,null,2)+'\n',filename='memory-preflight.'+variant+'.json';await fs.writeFile(path.join(here,filename),output);console.log(JSON.stringify({manifest:path.join(here,filename),sha256:sha(output),variant,originalFreshCalculationsForBothManifests:5,otherReducerImplementationsLoaded:0,memoryWorkloadsRun:false,expectedFiles:Object.keys(expectedFiles).length}));}
