    },
    {
      "id": "grafana.candidate.326d6f53e1aed3f219ec",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now use the resume and pause report functionality to activate draft reports that have all the required fields filled in.",
      "headingPath": [
        "What’s new in Grafana v10.1",
        "Dashboards and visualizations",
        "Activate draft reports"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-1.md",
