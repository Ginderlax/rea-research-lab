    },
    {
      "id": "grafana.candidate.7dd1b225bf4844f0281e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When an alert fails to fire, see when something is wrong with your contact point(s) and the reason for the error. The Receivers API contains information on the error, including a time stamp, duration of the attempt, and the error. You can also view the errors for each contact point in the UI.",
      "headingPath": [
        "What's new in Grafana v9.3",
        "Alerting",
        "View notification errors"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-3.md",
