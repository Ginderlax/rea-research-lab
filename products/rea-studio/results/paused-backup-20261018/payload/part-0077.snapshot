    },
    {
      "id": "grafana.candidate.43d5e54f3b5b7f4e0ed1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The default is `25`.",
      "headingPath": [
        "Configure Grafana Enterprise",
        "[caching.memory]",
        "max_size_mb"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md",
        "gitBlobSha": "51174e643296aefdf7f2a277d5fe604eeb1d2300",
