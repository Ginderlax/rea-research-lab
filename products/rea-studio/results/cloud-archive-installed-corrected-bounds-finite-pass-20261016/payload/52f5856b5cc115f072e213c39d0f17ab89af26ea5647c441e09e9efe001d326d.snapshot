for (const target of bundle.finalTargets) { const row = journal.files.find(row => row.path === target.target); assert(row); assert.deepEqual(row.after, target.after); assert.deepEqual(row.before, target.before); assert.equal(row.actualReadbackVerified, true); assert.equal(row.recoverableAfterAlias, target.source); }
const correctionPath = 'products/rea-studio/results/archive-aes-properties-fixture-correction-20261016/source-transition.json';
