    {
      "id": "grafana.candidate.61a9c79a4e8e753574cf",
      "syntaxRole": "list-item",
      "sourceText": "- Don’t alert on every instance by default. In dynamic environments, it’s better to aggregate and alert on symptoms — unless a missing individual instance directly impacts users.",
