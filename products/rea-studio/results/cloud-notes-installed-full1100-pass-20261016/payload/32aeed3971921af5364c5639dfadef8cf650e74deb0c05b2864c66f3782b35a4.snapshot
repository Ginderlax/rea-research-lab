import assert from 'node:assert/strict';import{spawnSync}from'node:child_process';import fs from'node:fs/promises';import path from'node:path';
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab'),repo='/repos/Ginderlax/rea-research-lab',env={...process.env,GIT_TERMINAL_PROMPT:'0',GCM_INTERACTIVE:'Never'};
const credential=spawnSync('git',['credential','fill'],{cwd:lab,env,input:'protocol=https\nhost=github.com\n\n',encoding:'utf8',windowsHide:true,timeout:20000});assert.equal(credential.status,0,'Saved GitHub authentication unavailable');const fields=Object.fromEntries(credential.stdout.split('\n').filter(s=>s.includes('=')).map(s=>{const i=s.indexOf('=');return[s.slice(0,i),s.slice(i+1)];}));assert(fields.password,'Saved authentication unavailable');const headers={Accept:'application/vnd.github+json','User-Agent':'REA-cloud-verification','X-GitHub-Api-Version':'2022-11-28',Authorization:'Bearer '+fields.password};
async function request(p,method='GET',body){assert(p.startsWith(repo+'/')||p==='/user');const response=await fetch('https://api.github.com'+p,{method,headers,body:body?JSON.stringify(body):undefined,signal:AbortSignal.timeout(60000)});if(!response.ok){let message='';try{message=(await response.json()).message??'';}catch{}throw new Error('GitHub '+response.status+' '+p.split('?')[0]+' '+message);}return response;}
const action=process.argv[2]??'health';
if(action==='health'){const a=await request('/user'),user=await a.json();assert.equal(user.login.toLowerCase(),'ginderlax');const permissions=await request(repo+'/actions/permissions').then(r=>r.json());const workflows=await request(repo+'/actions/workflows').then(r=>r.json());console.log(JSON.stringify({authenticatedUser:user.login,oauthScopes:a.headers.get('x-oauth-scopes'),actions:permissions,workflowCount:workflows.total_count,workflows:workflows.workflows?.map(w=>({id:w.id,name:w.name,path:w.path,state:w.state}))}));}
else if(action==='runs'){const branch=process.argv[3]??'codex/rea-cloud-recovery-20261015';assert(/^[a-zA-Z0-9_./-]+$/.test(branch));const j=await request(repo+'/actions/runs?branch='+encodeURIComponent(branch)+'&per_page=10').then(r=>r.json());console.log(JSON.stringify({total:j.total_count,runs:j.workflow_runs?.map(r=>({id:r.id,attempt:r.run_attempt,status:r.status,conclusion:r.conclusion,headSHA:r.head_sha,url:r.html_url,workflow:r.name,created:r.created_at,updated:r.updated_at}))}));}
else if(action==='active-runs'){const branch='codex/rea-cloud-recovery-20261015';const j=await request(repo+'/actions/runs?branch='+encodeURIComponent(branch)+'&per_page=100').then(r=>r.json());console.log(JSON.stringify({total:j.total_count,runs:j.workflow_runs?.filter(r=>r.status!=='completed'||r.path==='.github/workflows/development-cloud.yml').map(r=>({id:r.id,attempt:r.run_attempt,status:r.status,conclusion:r.conclusion,headSHA:r.head_sha,url:r.html_url,workflow:r.name,path:r.path,created:r.created_at,updated:r.updated_at}))}));}
else if(action==='jobs'){const run=process.argv[3];assert(/^\d+$/.test(run));const j=await request(repo+'/actions/runs/'+run+'/jobs').then(r=>r.json());console.log(JSON.stringify({total:j.total_count,jobs:j.jobs?.map(j=>({id:j.id,name:j.name,status:j.status,conclusion:j.conclusion,startedAt:j.started_at,completedAt:j.completed_at,runnerName:j.runner_name,runnerGroup:j.runner_group_name,labels:j.labels,steps:j.steps?.map(s=>({name:s.name,status:s.status,conclusion:s.conclusion,startedAt:s.started_at,completedAt:s.completed_at}))}))}));}
else if(action==='artifacts'){const run=process.argv[3];assert(/^\d+$/.test(run));const j=await request(repo+'/actions/runs/'+run+'/artifacts').then(r=>r.json());console.log(JSON.stringify({total:j.total_count,artifacts:j.artifacts?.map(a=>({id:a.id,name:a.name,bytes:a.size_in_bytes,digest:a.digest,expired:a.expired,created:a.created_at,expires:a.expires_at}))}));}
else if(action==='download'){const artifact=process.argv[3],run=process.argv[4];assert(/^\d+$/.test(artifact)&&/^\d+$/.test(run));const r=await request(repo+'/actions/artifacts/'+artifact+'/zip');const length=Number(r.headers.get('content-length'));assert(!length||length<=32*1024*1024);const chunks=[];let bytes=0;for await(const chunk of r.body){bytes+=chunk.length;assert(bytes<=32*1024*1024);chunks.push(chunk);}const folder=path.join(work,'cloud-verification-backups','run-'+run);await fs.mkdir(folder,{recursive:true});const file=path.join(folder,'artifact-'+artifact+'.zip');await fs.writeFile(file,Buffer.concat(chunks),{flag:'wx'});console.log(JSON.stringify({downloaded:true,file,bytes,run,artifact,portableArchive:true,contentsVerificationPending:true}));}
else if(action==='logs'){const job=process.argv[3];assert(/^\d+$/.test(job));const r=await request(repo+'/actions/jobs/'+job+'/logs'),b=Buffer.from(await r.arrayBuffer());assert(b.length<=20*1024*1024);const folder=path.join(work,'cloud-verification-backups','job-'+job);await fs.mkdir(folder,{recursive:true});const f=path.join(folder,'logs.txt');await fs.writeFile(f,b,{flag:'wx'});console.log(JSON.stringify({file:f,bytes:b.length,tail:b.toString().split(/\r?\n/).slice(-45).join('\n')}));}
else if(action==='draft-pr'){
 const specification=JSON.parse(await fs.readFile(path.join(work,'cloud-recovery-20261015','draft-pr.json'),'utf8'));
 assert.equal(specification.head,'codex/rea-cloud-recovery-20261015');assert.equal(specification.base,'main');assert.equal(specification.draft,true);
 const existing=await request(repo+'/pulls?state=open&head=Ginderlax%3A'+encodeURIComponent(specification.head)).then(r=>r.json());
 assert(existing.length<=1);const pr=existing[0]??await request(repo+'/pulls','POST',specification).then(r=>r.json());
 assert.equal(pr.head.ref,specification.head);assert.equal(pr.base.ref,'main');assert.equal(pr.draft,true);
 const receipt={url:pr.html_url,number:pr.number,draft:pr.draft,head:pr.head.sha,base:pr.base.ref,created:!existing.length};
 await fs.writeFile(path.join(work,'cloud-recovery-20261015','draft-pr-publication.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(receipt));
}
else if(action==='update-draft-pr'){
 const specification=JSON.parse(await fs.readFile(path.join(work,'cloud-recovery-20261015','draft-pr.json'),'utf8'));
 const current=await request(repo+'/pulls/1').then(r=>r.json());assert.equal(current.draft,true);assert.equal(current.head.ref,'codex/rea-cloud-recovery-20261015');assert.equal(current.base.ref,'main');
 const pr=await request(repo+'/pulls/1','PATCH',{title:specification.title,body:specification.body}).then(r=>r.json());
 console.log(JSON.stringify({updated:true,url:pr.html_url,draft:pr.draft,head:pr.head.sha}));
}
else if(action==='annotations'){
 const run=process.argv[3];assert(/^\d+$/.test(run));const value=await request(repo+'/actions/runs/'+run).then(r=>r.json());
 const checks=await request(repo+'/check-suites/'+value.check_suite_id+'/check-runs?per_page=100').then(r=>r.json());
 const annotations=[];for(const row of checks.check_runs??[]){if(!row.output?.annotations_count)continue;const items=await request(repo+'/check-runs/'+row.id+'/annotations?per_page=100').then(r=>r.json());annotations.push({check:row.name,conclusion:row.conclusion,items});}
 console.log(JSON.stringify({run:value.id,status:value.status,conclusion:value.conclusion,checkSuite:value.check_suite_id,checks:(checks.check_runs??[]).map(row=>({id:row.id,name:row.name,status:row.status,conclusion:row.conclusion,title:row.output?.title,summary:row.output?.summary,annotations:row.output?.annotations_count})),annotations}));
}
else if(action==='cancel-stale-development'){
 const runId='38814582190',expectedHead='dc0fce2b6c7a0701180c132029794f7a76c2303a';
 assert.equal(process.argv[3],runId);
 const run=await request(repo+'/actions/runs/'+runId).then(r=>r.json());
 assert.equal(run.head_sha,expectedHead);assert.equal(run.path,'.github/workflows/development-cloud.yml');
 assert.equal(run.head_branch,'codex/rea-cloud-recovery-20261015');assert.equal(run.status,'in_progress');
 const result=await request(repo+'/actions/runs/'+runId+'/cancel','POST');assert.equal(result.status,202);
 const receipt={schema:'rea-obsolete-owned-validation-cancel-request/v1',at:new Date().toISOString(),runId,expectedHead,statusBefore:run.status,cancelRequested:true,terminalStatusClaimed:false,productionServicesStopped:0,
 reason:'Release the queue held by this obsolete pre-Windows-correction repeat; two completed failed full-run epochs are already preserved, and the corrected committed revision requires its own fresh full run. No pass/fail count is inferred for this interrupted run.'};
 await fs.writeFile(path.join(work,'cloud-recovery-20261015','stale-development-cancel-request-'+runId+'.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(receipt));
}
else if(action==='dispatch'){
 const workflow=process.argv[3],ref=process.argv[4]??'codex/rea-cloud-recovery-20261015';
 assert(['proof-delivery-audit-cloud.yml','vault-empty-bin-cloud.yml'].includes(workflow));
 assert.equal(ref,'codex/rea-cloud-recovery-20261015');
 const branch=await request(repo+'/branches/'+encodeURIComponent(ref)).then(r=>r.json());assert.equal(branch.name,ref);assert(/^[0-9a-f]{40}$/.test(branch.commit.sha));
 const result=await request(repo+'/actions/workflows/'+workflow+'/dispatches','POST',{ref});assert.equal(result.status,204);
 const receipt={schema:'rea-authorized-hosted-workflow-dispatch/v1',at:new Date().toISOString(),workflow,ref,remoteHeadAtDispatch:branch.commit.sha,requested:true,runCompletionClaimed:false};
 const filename=path.join(work,'cloud-recovery-20261015','dispatch-'+workflow.replace('.yml','')+'-'+Date.now()+'.json');await fs.writeFile(filename,JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(receipt));
}
else throw new Error('Unknown orchestration action');
