    },
    {
      "id": "grafana.candidate.5d65c2eec1452edc0d74",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For our plugins that do not return time series, it might be useful to plot historical data. For example, you might want to query ServiceNow to see a history of request response times but it can only return current point-in-time metrics.",
      "headingPath": [
        "Recorded queries (deprecated)"
      ],
