import fs from 'node:fs/promises';
import path from 'node:path';
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
const work=import.meta.dirname,workspace=path.dirname(work),lab=path.join(workspace,'outputs/rea-research-lab'),own=path.join(work,'editor-pattern-root-installation-plan-next'),prefix='products/rea-studio/results/editor-search-pattern-reviewed-installation-20261013/source-proof',sha=b=>createHash('sha256').update(b).digest('hex');
await fs.mkdir(own,{recursive:false});
function safe(p){assert(typeof p==='string'&&p&&!path.isAbsolute(p)&&!/[\\:\x00-\x1f]/.test(p)&&p.split('/').every(s=>s&&s!=='.'&&s!=='..'));}
const inputs=[],records=[],payloads=new Map();
async function bytes(root,p,expected){safe(p);const b=await fs.readFile(path.join(root,p));if(expected){assert.equal(b.length,expected.bytes,p);assert.equal(sha(b),expected.sha256,p);}inputs.push({root,p,bytes:b.length,sha256:sha(b)});return b;}
async function retain(epoch,root,p,expected,publicPath){const b=await bytes(root,p,expected);assert(b.length<=32*1024*1024);assert(Buffer.from(b.toString()).equals(b),p+' nonUTF8');for(const h of ['4d5a','7f454c46','504b0304','1f8b','377abcaf271c','03d9a29a','28b52ffd'])assert(!b.subarray(0,8).toString('hex').startsWith(h),p+' carrier');const id=sha(b),target=publicPath??prefix+'/payload/'+id+'.snapshot';safe(target);if(!payloads.has(target)){const rel=target.slice(prefix.length+1);assert(target.startsWith(prefix+'/'));await fs.mkdir(path.dirname(path.join(own,'source-proof',rel)),{recursive:true});await fs.writeFile(path.join(own,'source-proof',rel),b,{flag:'wx'});payloads.set(target,{path:target,bytes:b.length,sha256:id});}else assert.equal(payloads.get(target).sha256,id);records.push({epoch,sourceRoot:path.relative(workspace,root).replaceAll('\\','/'),sourcePath:p,publicPath:target,bytes:b.length,sha256:id});}
const old=path.join(work,'editor-search-pattern-publication-plan'),oldManifest=await bytes(old,'freeze-manifest.json');assert.equal(sha(oldManifest),'480b15c9c47c095b70d972b550312ead3e075efe62bd8c502a008bbde9dfb3fb');
const oldMap=JSON.parse(await bytes(old,'public-preservation-map.json'));assert.equal(oldMap.length,492);
for(const r of oldMap)await retain(r.epoch,path.join(workspace,r.sourceRoot),r.sourcePath,r,r.publicPath);
assert.equal(payloads.size,223);const epochs=[{epoch:'initial-selected573',frozenPayloads:573,selectedAliases:492,publicPayloads:223,excludedGeneratedFixtureRows:82,wholeEpochPublic:false}];
const specs=[['old-plan44','editor-search-pattern-publication-plan','freeze-manifest.json','480b15c9c47c095b70d972b550312ead3e075efe62bd8c502a008bbde9dfb3fb',44],['negative141','editor-search-pattern-independent-review','review-manifest.json','76c89a780e5c8e2a7774d925073b500a1e8a5f5c164c86a6e4e71b809717db31',141],['corrected852','editor-search-pattern-textarea-fix-next','freeze-manifest.json','0b4297c0d1d498ed614f6d98b8850fd05520594f850e7448c82e9652b9653f17',852],['independent127','editor-search-pattern-textarea-correction-independent-review','review-manifest.json','9b477f47294669cece711f5c0aa323056bec44ed1fc08ff1539d87c836108646',127]];
for(const[epoch,name,manifest,pin,count]of specs){const root=path.join(work,name),b=await bytes(root,manifest);assert.equal(sha(b),pin);const m=JSON.parse(b),raw=m.inventory,rows=Array.isArray(raw)?raw:Object.entries(raw).map(([path,r])=>({path,...r}));assert.equal(rows.length,count);for(const r of rows)await retain(epoch,root,r.path,r);await retain(epoch,root,manifest,{bytes:b.length,sha256:pin});epochs.push({epoch,originalDirectory:'work/'+name,manifest,manifestSHA256:pin,frozenPayloads:count,wholeFrozenInventoryPublic:true});}
const proof={schema:'rea-editor-pattern-root-source-preservation/v1',at:new Date().toISOString(),epochs,records,payloads:[...payloads.values()].sort((a,b)=>a.path.localeCompare(b.path)),sourceAliases:records.length,publicPayloads:payloads.size,initial492Map223Payloads82ExclusionsHistorical:true,exactUTF8InertCopies:true,originalExecutableBytesPublic:0,historicalReceiptsRebound:false,fullProductParity:false,universalSuperiority:false};
await fs.writeFile(path.join(own,'source-proof/preservation-manifest.json'),JSON.stringify(proof,null,2)+'\n',{flag:'wx'});
const corrected=path.join(work,'editor-search-pattern-textarea-fix-next'),rows=JSON.parse(await bytes(corrected,'combined-live14-proposal.json'));assert.equal(rows.length,14);const docOverlays=[];
const edits={
 'SEARCH-PATTERNS.md':[['This work-only candidate adds boolean','Saved-file search provides boolean']],
 'TEXTAREA-COORDINATES.md':[['Actual corrected browser and independent acceptance require a separate campaign.','An independent Chrome campaign accepted26 native selections: nine literal and17 regex selections across LF, CRLF, bare CR and mixed endings, including eight astral endpoints. Two real delayed-response publication controls passed. The previous16 source/model cases were replayed unchanged except for imports and collector paths and are not new case groups. Native dirty-close Cancel remains incomplete because browser focus controls failed; a Save-specific browser campaign was not executed. The owned test host exited normally and removed its temporary data, while tab closure remains unconfirmed. These are finite checks; full host/workbench acceptance and comparative benchmarks remain open.'],['Production/public code and old573+plan44+review141 are unchanged by this author.','The initial573, plan44 and negative141 epochs remain immutable historical evidence. The source map also preserves the corrected852 and independent127 epochs.']],
 'search-pattern.NOTICE.md':[]
};
for(const[name,replacements]of Object.entries(edits)){const row=rows.find(r=>r.livePath.endsWith('/'+name));assert(row);const before=await bytes(corrected,row.sourcePath,row.after);let text=before.toString();for(const[a,b]of replacements){assert.equal(text.split(a).length,2);text=text.replace(a,b);}text+='\nExact upstream source/license files and failed/corrected study epochs are mapped by the [immutable search evidence manifest](../../results/editor-search-pattern-reviewed-installation-20261013/source-proof/preservation-manifest.json).\n';const after=Buffer.from(text),source='documentation-proposal/'+name;await fs.mkdir(path.dirname(path.join(own,source)),{recursive:true});await fs.writeFile(path.join(own,source),after,{flag:'wx'});await fs.mkdir(path.join(own,'before-documents'),{recursive:true});await fs.writeFile(path.join(own,'before-documents',name+'.snapshot'),before,{flag:'wx'});docOverlays.push({target:row.livePath,before:{bytes:before.length,sha256:sha(before)},after:{bytes:after.length,sha256:sha(after)},replacements,appendedPublicEvidenceLink:true});row.sourceRoot='this-plan';row.sourcePath=source;row.after={bytes:after.length,sha256:sha(after)};row.explicitDocumentationOverlay=true;}
for(const r of rows){const sourceRoot=r.sourceRoot==='this-plan'?own:path.join(workspace,r.sourceRoot);await bytes(sourceRoot,r.sourcePath,r.after);if(r.before)await bytes(lab,r.livePath,r.before);else await assert.rejects(fs.access(path.join(lab,r.livePath)),e=>e.code==='ENOENT');}
const plan={schema:'rea-editor-pattern-root-installation-plan/v1',at:new Date().toISOString(),productionEpoch:'f0b4746eae49b2a83694de1a0a28fee63e004257',rows,documentationOverlay:docOverlays,publicSourcePrefix:prefix,publicSourceMap:{path:prefix+'/preservation-manifest.json',bytes:(await fs.stat(path.join(own,'source-proof/preservation-manifest.json'))).size,sha256:sha(await fs.readFile(path.join(own,'source-proof/preservation-manifest.json')))},existing:4,additions:10,sourceOnly:true,productionWrites:0,installedBehaviorExecuted:false,nativeSelectionAccepted26:true,nativeDirtyCloseCancelAccepted:false,saveSpecificNativeCampaignExecuted:false,wholeHostAcceptance:false,allParityAndSuperiorityGates:false};await fs.writeFile(path.join(own,'installation-plan.json'),JSON.stringify(plan,null,2)+'\n',{flag:'wx'});await fs.copyFile(import.meta.filename,path.join(own,'collector.mjs.snapshot'));
for(const r of inputs){const b=await fs.readFile(path.join(r.root,r.p));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);}
async function walk(dir,p=''){const out=[];for(const e of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const rel=p+e.name;assert(!e.isSymbolicLink());if(e.isDirectory())out.push(...await walk(path.join(dir,e.name),rel+'/'));else{const b=await fs.readFile(path.join(dir,e.name));out.push({path:rel,bytes:b.length,sha256:sha(b)});}}return out;}
const inventory=await walk(own),m=Buffer.from(JSON.stringify({schema:'rea-strict-work-review/v1',files:inventory.length,inventory},null,2)+'\n');await fs.writeFile(path.join(own,'manifest.json'),m,{flag:'wx'});console.log(JSON.stringify({files:inventory.length,manifestSHA256:sha(m),aliases:records.length,payloads:payloads.size,rows:rows.length,productionWrites:0}));
