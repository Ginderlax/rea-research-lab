    {
      "id": "grafana.candidate.9f501b5a71c8757e0811",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Used as the default time zone for user preferences. Can be either `browser` for the browser local time zone or a time zone name from the IANA Time Zone database, such as `UTC` or `Europe/Amsterdam`.",
      "headingPath": [
        "Configure Grafana",
