    {
      "id": "grafana.candidate.3fa85e542ba6c4ebc123",
      "syntaxRole": "procedural-step",
      "sourceText": "3. The production instance syncing `main` updates automatically.",
      "headingPath": [
        "Testing sandboxes with Git Sync",
        "Promote a sandbox to main",
        "Option 3: Promote through a separate instance or path"
      ],
      "source": {
