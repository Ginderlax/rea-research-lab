      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.0db95fb61282fe2bb940",
      "syntaxRole": "table-row",
      "sourceText": "| `$__timeFilter(<column>)`     | A time range filter applied to the specified column. Expands to `<column> >= $__timeFrom AND <column> <= $__timeTo`.                                                                                |",
      "headingPath": [
        "InfluxDB query editor",
        "SQL query editor",
        "Macros"
      ],
      "source": {
        "path": "docs/sources/datasources/influxdb/query-editor/index.md",
        "gitBlobSha": "7a8d334025a46bda1f449a23dd9329b013ede772",
        "sha256": "be6cf3ca29657e90dbf63cbcf347d7c4de22c3067a88eee5098651919ccd8640",
        "lineStart": 164,
        "lineEnd": 164,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/influxdb/query-editor/index.md#L164-L164"
      },
      "applicability": {
