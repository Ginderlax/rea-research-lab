    {
      "id": "grafana.candidate.e9c99cc5e5a6954baab6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This allows access to all current and future plugins, including ones your users may not need or have licensed, such as IRM, Machine Learning, or Synthetics.",
      "headingPath": [
