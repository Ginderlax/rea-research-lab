$taskTools=Join-Path -Path $taskWork -ChildPath 'archive-installed-acceptance-next/change-authority.json'
if((Pin $taskProof).sha256 -cne 'ebb4083041b6ad87dd820a4095d00b30e952df6ea2a52183740e1575c1277ed8'){throw 'Proof authority changed'}
if((Pin $taskTools).sha256 -cne 'cbef66d04d25587b9a36cc36999b4760db7c0359722da913d32e817d5fb97452'){throw 'Tooling authority changed'}
if($ToolPeerSHA -cnotmatch '^[0-9a-f]{64}$' -or (Pin $ToolPeerPath).sha256 -cne $ToolPeerSHA){throw 'Tool peer identity changed'}
$taskProofPeer=Join-Path -Path $taskWork -ChildPath 'archive22-clock-independent-source-review-1245.json'
if((Pin $taskProofPeer).sha256 -cne '7b864a2297a1e9b7b8ddc4995716c7abb1c73017a41dc1404cb03bb70fe1301e'){throw 'Proof peer changed'}
$taskBundlePath='products/rea-studio/experiments/archive-aes/bundle.json'
$taskBundleFile=Join-Path -Path $taskRepo -ChildPath $taskBundlePath
Match (Pin $taskBundleFile) @{bytes=80331;sha256='ed6d16f52f9209ac144f1f08d395c3e86e4c124c73a3a18a488654506ff155bb'}
$taskBundle=Get-Content -LiteralPath $taskBundleFile -Raw|ConvertFrom-Json
if($taskBundle.finalTargets.Count -ne 21 -or @($taskBundle.finalTargets|Where-Object {$null -ne $_.before}).Count -ne 6){throw 'Unexpected Archive target map'}
$taskPlans=@()
foreach($r in $taskBundle.finalTargets){$taskPlans+=@{path=$r.target;source=(Join-Path -Path $taskRepo -ChildPath $r.source);before=$r.before;after=$r.after;origin='reviewed immutable Archive bundle';sourceAlias=$r.source}}
foreach($spec in @(@{file=$taskProof;stage='archive-aes-production-proof-after-windows-next';count=22},@{file=$taskTools;stage='archive-installed-acceptance-next';count=7})){
 $a=Get-Content -LiteralPath $spec.file -Raw|ConvertFrom-Json
 if($a.files.Count -ne $spec.count){throw 'Unexpected tooling source inventory'}
 foreach($r in $a.files){$taskPlans+=@{path=$r.path;source=(Join-Path -Path $taskWork -ChildPath ($spec.stage+'/candidate/'+$r.path));before=$r.before;after=$r.after;origin=$spec.stage;sourceAlias=$null}}
}
if($taskPlans.Count -ne 50 -or @($taskPlans.path|Sort-Object -Unique).Count -ne 50){throw 'Source paths overlap'}
$taskJournalPath='products/rea-studio/results/archive-aes-installed-20261016/installation-receipt.json'
$taskJournal=Join-Path -Path $taskRepo -ChildPath $taskJournalPath
if(Test-Path -LiteralPath $taskJournal){throw 'Public installation journal already exists'}
foreach($r in $taskPlans){Safe $r.path;Match (Pin $r.source) $r.after;$target=Join-Path -Path $taskRepo -ChildPath $r.path;if($null -ne $r.before){Match (Pin $target) $r.before}elseif(Test-Path -LiteralPath $target){throw 'New source target exists'}}
$taskHead=(git -C $taskRepo rev-parse HEAD).Trim();if($LASTEXITCODE -ne 0 -or $taskHead -cne 'be96291e2a3de33a098e9950c3c6a7532de819a9'){throw 'Unexpected installation base'}
$taskTag='rea-archive-before-install-20261016'
git -C $taskRepo show-ref --verify --quiet ('refs/tags/'+$taskTag)
if($LASTEXITCODE -eq 0){throw 'Preserve existing pre-install tag'}
if($LASTEXITCODE -ne 1){throw 'Pre-install tag lookup failed'}
git -C $taskRepo tag -a $taskTag -m 'Preserve the pre-installation Archive experiment source epoch' $taskHead
if($LASTEXITCODE -ne 0){throw 'Tag creation failed'}
git -C $taskRepo push origin ('refs/tags/'+$taskTag)
if($LASTEXITCODE -ne 0){throw 'Pre-installation tag publication failed'}
New-Item -ItemType Directory -Path $taskReceipt|Out-Null
$taskStarted=[DateTime]::UtcNow.ToString('o');$taskCopied=@()
$taskRecord=[ordered]@{schema='rea-archive-actual-source-installation/v1';status='running';startedAtUtc=$taskStarted;actor='root agent under Evan authorization';baselineCommit=$taskHead;preservedPreInstallationTag=$taskTag;sourceBundle=@{path=$taskBundlePath;identity=(Pin $taskBundleFile)};applicationSourceTargets=21;applicationReplacementTargets=6;applicationAdditions=15;proofAndAcceptanceTargets=29;files=$taskCopied;localProductExecutions=0;localOriginalExecutions=0;localTests=0;localBuilds=0;localSyntaxChecks=0;historicalReceiptsRewritten=$false;sourceFilesInstalled=$false;freshHostedInstalledAcceptance=$false;productionIntegrationAccepted=$false;fullProductParity=$false;superiority=$false}
function Save-Journal{$taskRecord.files=$taskCopied;$taskRecord|ConvertTo-Json -Depth 18|Set-Content -LiteralPath (Join-Path -Path $taskReceipt -ChildPath 'installation-receipt.json') -Encoding utf8}
Save-Journal
try{
 foreach($r in $taskPlans){
  $target=Join-Path -Path $taskRepo -ChildPath $r.path;$before=$null
  if($null -ne $r.before){$before=Pin $target;Match $before $r.before;$saved=Join-Path -Path $taskReceipt -ChildPath ('before/'+$r.path+'.snapshot');New-Item -ItemType Directory -Path ([IO.Path]::GetDirectoryName($saved)) -Force|Out-Null;[IO.File]::Copy($target,$saved,$false);Match (Pin $saved) $r.before}
  New-Item -ItemType Directory -Path ([IO.Path]::GetDirectoryName($target)) -Force|Out-Null
  [IO.File]::Copy($r.source,$target,($null -ne $r.before));$after=Pin $target;Match $after $r.after
  $taskCopied+=@{path=$r.path;before=$before;after=$after;sourceOrigin=$r.origin;recoverableAfterAlias=$r.sourceAlias;actualReadbackVerified=$true};Save-Journal
 }
 foreach($r in $taskCopied){Match (Pin (Join-Path -Path $taskRepo -ChildPath $r.path)) $r.after}
 $taskRecord.status='installed-source-unexecuted-awaiting-hosted-acceptance';$taskRecord.sourceFilesInstalled=$true;$taskRecord.completedAtUtc=[DateTime]::UtcNow.ToString('o')
 $taskRecord.sourceAuthorities=@(@{identity=(Pin $taskProof);source='archive22 reviewed clock integration'},@{identity=(Pin $taskTools);source='installed acceptance tooling R2'})
 $taskRecord.independentReviews=@(@{identity=(Pin $taskProofPeer);encoding='base64-exact-utf8-file';content=[Convert]::ToBase64String([IO.File]::ReadAllBytes($taskProofPeer))},@{identity=(Pin $ToolPeerPath);encoding='base64-exact-utf8-file';content=[Convert]::ToBase64String([IO.File]::ReadAllBytes($ToolPeerPath))})
 $taskRecord.rootReview='Runtime AES/source-metadata modules and runtime diffs, full installed helper/workflow/README and collector deltas inspected. Exact proof epoch and156 planned controls preserve historical receipts. This records file installation only; actual installed finite/browser/full checks remain mandatory.'
 Save-Journal
 New-Item -ItemType Directory -Path ([IO.Path]::GetDirectoryName($taskJournal)) -Force|Out-Null
 [IO.File]::Copy((Join-Path -Path $taskReceipt -ChildPath 'installation-receipt.json'),$taskJournal,$false)
 Match (Pin $taskJournal) (Pin (Join-Path -Path $taskReceipt -ChildPath 'installation-receipt.json'))
}catch{$taskRecord.status='failed-source-installation';$taskRecord.failure=$_.Exception.Message;$taskRecord.completedAtUtc=[DateTime]::UtcNow.ToString('o');Save-Journal;throw}
$taskExtra=@(Get-Content -LiteralPath (Join-Path -Path $taskWork -ChildPath 'cloud-recovery-20261015/notes92-evidence.paths'))+@(Get-Content -LiteralPath (Join-Path -Path $taskWork -ChildPath 'cloud-recovery-20261015/vault233-evidence.paths'))+@('CLOUD-VERIFICATION.md',$taskJournalPath)
$taskPaths=@(@($taskPlans.path)+$taskExtra|Sort-Object -Unique)
if($taskPaths.Count -ne 157){throw 'Unexpected full staged source inventory'}
$taskList=Join-Path -Path $taskReceipt -ChildPath 'staged.paths';[IO.File]::WriteAllLines($taskList,[string[]]$taskPaths,(New-Object Text.UTF8Encoding -ArgumentList $false))
git -C $taskRepo --literal-pathspecs add --pathspec-from-file=$taskList
if($LASTEXITCODE -ne 0){throw 'Exact source staging failed'}
$taskActual=@(git -C $taskRepo diff --cached --name-only)
if($taskActual.Count -ne 157 -or @($taskActual|Where-Object {$_ -notin $taskPaths}).Count){throw 'Unexpected staged source files'}
$taskHygienePaths=@($taskPlans.path|Where-Object {$_.EndsWith('.mjs') -or $_.EndsWith('.yml')})+@('CLOUD-VERIFICATION.md')
git -C $taskRepo -c core.whitespace=trailing-space,space-before-tab,cr-at-eol diff --cached --check -- $taskHygienePaths
if($LASTEXITCODE -ne 0){throw 'Authored source whitespace issue'}
