        "lineStart": 124,
        "lineEnd": 124,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/guides/when-slos-reduce-alert-noise.md#L124-L124"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
