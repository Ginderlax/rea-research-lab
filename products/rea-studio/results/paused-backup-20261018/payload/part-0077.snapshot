    {
      "id": "grafana.candidate.1d7901651558817a2e8e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you plan to use directories on your host for the database or configuration when running Grafana in Docker, you must start the container with a user with permission to access and write to the directory you map.",
