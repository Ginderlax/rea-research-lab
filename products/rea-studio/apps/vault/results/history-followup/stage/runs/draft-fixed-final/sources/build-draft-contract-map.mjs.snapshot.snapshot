import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
const root=import.meta.dirname,sha=b=>createHash('sha256').update(b).digest('hex'),file='KeePass/Forms/PwEntryForm.cs',bytes=await fs.readFile(path.join(root,'source',file)),census=JSON.parse(await fs.readFile(path.join(root,'source-census.final.json'))),expected=census.selectedFiles.find(f=>f.path===file);assert.ok(expected);assert.equal(sha(bytes),expected.sha256);const lines=bytes.toString('utf8').split('\n');const contracts=[{id:'vault.history.restore.refuse-dirty.enabled',startLine:1070,endLine:1071,meaning:'The released dialog disables Restore when its edited entry differs from its initial entry.'},{id:'vault.history.restore.refuse-dirty.handler',startLine:1485,endLine:1491,meaning:'The released restore handler rechecks and refuses modified entry contents before its restore effect.'},{id:'vault.history.restore.refuse-dirty.comparison',startLine:2139,endLine:2145,meaning:'The released modification check saves current dialog fields into a clone and compares against the initial entry.'}].map(c=>{const span=lines.slice(c.startLine-1,c.endLine).join('\n');assert.ok(span.includes(c.id.endsWith('comparison')?'EqualsEntry':'HasModifiedEntryEx'));return{...c,source:file,sourceBytes:bytes.length,sourceSha256:sha(bytes),spanUtf8Bytes:Buffer.byteLength(span),spanSha256:sha(span),evidence:'Authenticated exact original source; original GUI guard not executed.'};});await fs.writeFile(path.join(root,'draft-contract-map.json'),JSON.stringify({schema:'rea-keepass-draft-guard-contract-map/v1',release:'2.61.1',archiveSha256:census.archiveSha256,sourceAssisted:true,contracts,extendedCandidatePolicy:'Seven current editable values, input revisions and request generations guard asynchronous Save/Restore publication. This models candidate transport behavior, not execution of original dialog concurrency.',originalGUIExecutions:0},null,2)+'\n');
