    },
    {
      "id": "grafana.candidate.d99843e2f59caf8ba89a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The CloudWatch plugin enables you to monitor and troubleshoot applications across multiple regional accounts. Using cross-account observability, you can seamlessly search, visualize and analyze metrics and logs without worrying about account boundaries.",
      "headingPath": [
        "Amazon CloudWatch data source",
        "Cross-account observability"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/_index.md",
        "gitBlobSha": "4070ab100d9ddd86a3cb83208e426f7d3a1510cb",
        "sha256": "df4d5cdcee4015e9df11b61a9fa9e2534583e7cdae600b1edf072c475a1e63d1",
