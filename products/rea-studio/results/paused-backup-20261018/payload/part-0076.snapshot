    {
      "id": "grafana.candidate.2d6c1cf757eb90823a90",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When an ES|QL query does not include a time filter, Grafana automatically adds a time range filter based on the dashboard or Explore time picker.",
      "headingPath": [
        "Elasticsearch query editor",
        "ES|QL query editor"
      ],
