    {
      "id": "grafana.candidate.08be13d5160685751e8b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Custom install/learn more URL for enterprise plugins. Defaults to https://grafana.com/grafana/plugins/.",
