      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.bbc8c9a37afc8760821e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Introducing a major performance improvement for the PDF export feature.",
      "headingPath": [
        "What’s new in Grafana v11.0",
        "Reporting",
        "PDF export improvements"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-0.md",
        "gitBlobSha": "718032fb1fcee4d964da6aa4e9da332a64bf509a",
        "sha256": "4ac4a4d84503349934037643cc351a7722532a4c4189aab283838810ba2f6731",
        "lineStart": 265,
        "lineEnd": 265,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-0.md#L265-L265"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.afceb6091d3a8ac98175",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Are you tired of waiting for your PDF to be generated or your report to be sent? We're working on a major update of the dashboard-to-PDF feature to make it faster for large dashboards. The generation time will no longer be proportional to the number of panels in your dashboard. As an example, an SLO dashboard containing around 200 panels has gone from taking more than seven minutes to be generated to only eleven seconds.",
      "headingPath": [
        "What’s new in Grafana v11.0",
        "Reporting",
        "PDF export improvements"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-0.md",
        "gitBlobSha": "718032fb1fcee4d964da6aa4e9da332a64bf509a",
        "sha256": "4ac4a4d84503349934037643cc351a7722532a4c4189aab283838810ba2f6731",
        "lineStart": 267,
        "lineEnd": 267,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-0.md#L267-L267"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.0dca0bbb07a986d848d4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This update also fixes all [caveats](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/dashboards/create-reports/#caveats) related to rendering a report with panels or rows set to repeat by a variable, like rendering repeating panels inside collapsed rows.",
      "headingPath": [
        "What’s new in Grafana v11.0",
        "Reporting",
        "PDF export improvements"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-0.md",
        "gitBlobSha": "718032fb1fcee4d964da6aa4e9da332a64bf509a",
        "sha256": "4ac4a4d84503349934037643cc351a7722532a4c4189aab283838810ba2f6731",
        "lineStart": 269,
        "lineEnd": 269,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-0.md#L269-L269"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.3faa40df7c94eaf9b744",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To try out this update, enable the `newPDFRendering` [feature toggle](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-grafana/feature-toggles/).",
      "headingPath": [
        "What’s new in Grafana v11.0",
        "Reporting",
        "PDF export improvements"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-0.md",
