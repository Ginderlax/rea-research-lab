    },
    {
      "id": "grafana.candidate.3df51d83d15250e47912",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To create a time series query, set the **Format** option in the query editor to **Time series**. The query must include a column named `time`, which should contain either an SQL `datetime` value or a numeric value representing Unix epoch time in seconds. The result set must be sorted by the `time` column for panels to visualize the data correctly.",
      "headingPath": [
        "Microsoft SQL Server query editor",
        "Time series queries"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/query-editor/index.md",
        "gitBlobSha": "bbb58af24aced7414605130f50521c1a8bc6ca8c",
        "sha256": "9f485e1051e44b457c0808272de96a8616d75e95d5fb6d630bec71d225529f99",
        "lineStart": 208,
        "lineEnd": 208,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/mssql/query-editor/index.md#L208-L208"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.e0fd1eea49662e52dd71",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A time series query returns results in [wide data frame format](https://grafana.com/developers/plugin-tools/key-concepts/data-frames#wide-format).",
      "headingPath": [
        "Microsoft SQL Server query editor",
        "Time series queries"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/query-editor/index.md",
