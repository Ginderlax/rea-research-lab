    {
      "id": "grafana.candidate.61e8e7f7c1ce5d72b028",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This visualization needs a specific shape of the data to be returned from the data source to correctly display it.",
      "headingPath": [
        "Node graph",
        "Data API"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/node-graph/index.md",
        "gitBlobSha": "7c586f93fdc1eaff30c91e430394f51a121e7775",
        "sha256": "f0da5170934666563792a7b39628b17cd29c47bc87bd6f21ff69e7d6bdebf1a4",
        "lineStart": 218,
        "lineEnd": 218,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/panels-visualizations/visualizations/node-graph/index.md#L218-L218"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
