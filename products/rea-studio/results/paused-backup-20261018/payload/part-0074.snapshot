    },
    {
      "id": "grafana.candidate.f289121d5e775be33a9f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Create a custom RBAC role when basic roles and fixed roles do not meet your permissions requirements. For a list of the actions and scopes you can customize a role with, refer to [Grafana RBAC permission actions and scopes](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/administration/roles-and-permissions/access-control/custom-role-actions-scopes/).",
      "headingPath": [
