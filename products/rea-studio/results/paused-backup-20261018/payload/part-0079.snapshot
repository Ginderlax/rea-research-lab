        "products": [
          "cloud",
          "enterprise",
          "oss"
        ],
        "restriction": "What's new in Grafana v7.2 > Grafana Enterprise features > Report and export dashboards in grid layout"
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.6883f9f430e31be7bb4f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The grid layout is also available for the [Export dashboard as PDF](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/visualizations/dashboards/share-dashboards-panels/#export-a-dashboard-as-pdf) feature.",
      "headingPath": [
