import fs from 'node:fs/promises';import path from 'node:path';import os from 'node:os';import assert from 'node:assert/strict';import http from 'node:http';import readline from 'node:readline';import {createHash} from 'node:crypto';import {pathToFileURL} from 'node:url';
const here=import.meta.dirname,workspace=path.resolve(here,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),studio=path.join(repo,'products/rea-studio'),clone=path.join(here,'studio'),sha=b=>createHash('sha256').update(b).digest('hex'),fp=async p=>{const b=await fs.readFile(p);return{bytes:b.length,sha256:sha(b)}},save=(n,v)=>fs.writeFile(path.join(here,n),JSON.stringify(v,null,2)+'\n',{flag:'wx'});
const proof=path.join(workspace,'work/editor-save-focused-integration-next'),pb=await fs.readFile(path.join(proof,'validation.json'));assert.equal(sha(pb),'f4edee0afc7d40a169576ae9b87fe9d4c9227a1ea355ef19c80fa273b26eee25');const current=JSON.parse(pb);assert.equal(current.currentSources.length,31);assert.equal(current.counts.pass,78);assert.equal((await fp(path.join(proof,'freeze-manifest.json'))).sha256,'b45f1b6b4c5acfc918bc1fd13a4ca6c0886b7e0b1a04c87c986aa0d74646bc73');const sources=[];
for(const r of current.currentSources){assert(r.path.startsWith('products/rea-studio/'));const rel=r.path.slice('products/rea-studio/'.length),b=await fs.readFile(path.join(repo,r.path));assert.deepEqual({bytes:b.length,sha256:sha(b)},{bytes:r.bytes,sha256:r.sha256});const target=path.join(clone,rel);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b,{flag:'wx'});sources.push({...r,clone:'studio/'+rel});}await save('source-before.json',sources);await save('controller-before.json',await fp(path.join(here,'host-relay.mjs')));
const prefix=path.resolve(os.tmpdir(),'editor-browser-review-'),dataDir=await fs.mkdtemp(prefix),instance=await(await import(pathToFileURL(path.join(clone,'server.mjs')).href)).start({port:0,dataDir});const actual=[];let phase='seed';instance.server.prependListener('request',(req,res)=>{const r={at:new Date().toISOString(),phase,method:req.method,url:req.url};actual.push(r);res.once('finish',()=>{r.status=res.statusCode;r.completedAt=new Date().toISOString();});});
const actualCall=async(action,input={})=>{const response=await fetch(instance.url+'/api/editor/'+action,{method:'POST',headers:{'content-type':'application/json','x-rea-token':instance.token},body:JSON.stringify(input)}),value=await response.json();assert(response.ok,JSON.stringify(value));return value.result;};
const initial={'owned-a.txt':'Alpha needle first\nAlpha needle second\n','owned-b.txt':'Beta needle target\n'};for(const[p,content]of Object.entries(initial))await actualCall('save',{path:p,content,revision:null});phase='browser';
let relayPort,arm=null,held=null,closing=false;const forwarded=[],holdRecords=[],hop=new Set(['connection','keep-alive','proxy-authenticate','proxy-authorization','te','trailer','transfer-encoding','upgrade']);
const relay=http.createServer(async(req,res)=>{try{assert(['127.0.0.1', '::ffff:127.0.0.1','::1'].includes(req.socket.remoteAddress));assert.equal(req.headers.host,'127.0.0.1:'+relayPort);assert(req.url.startsWith('/')&&!req.url.startsWith('//'));const expectedOrigin='http://127.0.0.1:'+relayPort;if(req.headers.origin)assert.equal(req.headers.origin,expectedOrigin);const parts=[];let total=0;for await(const part of req){total+=part.length;assert(total<=4*1024*1024);parts.push(part);}const body=Buffer.concat(parts),headers={...req.headers,host:new URL(instance.url).host};for(const key of hop)delete headers[key];if(headers.origin)headers.origin=instance.url;headers['content-length']=body.length;const row={id:forwarded.length+1,at:new Date().toISOString(),method:req.method,url:req.url,bodyBytes:body.length,bodySHA256:sha(body),transforms:{host:{from:req.headers.host,to:headers.host},origin:req.headers.origin?{from:req.headers.origin,to:headers.origin}:null,hopByHopRemoved:true,contentLength:body.length}};if(req.url==='/api/editor/save')row.savedRequest=JSON.parse(body);forwarded.push(row);
 const response=await new Promise((resolve,reject)=>{const upstream=http.request(new URL(req.url,instance.url),{method:req.method,headers,timeout:30000},reply=>{const chunks=[];let bytes=0;reply.on('data',chunk=>{bytes+=chunk.length;if(bytes>4*1024*1024){reply.destroy(new Error('Owned relay response retention bound'));return;}chunks.push(chunk)});reply.on('end',()=>resolve({status:reply.statusCode,headers:reply.headers,body:Buffer.concat(chunks)}));reply.on('error',reject);});upstream.on('error',reject);upstream.on('timeout',()=>upstream.destroy(new Error('Owned relay upstream deadline')));upstream.end(body);});row.upstreamStatus=response.status;row.upstreamBodyBytes=response.body.length;row.upstreamBodySHA256=sha(response.body);row.upstreamCompletedAt=new Date().toISOString();const deliver=()=>{if(res.destroyed)return;const out={...response.headers};for(const key of hop)delete out[key];out['content-length']=response.body.length;res.writeHead(response.status,out);res.end(response.body);row.deliveredAt=new Date().toISOString();};
 if(arm&&req.method==='POST'&&req.url==='/api/editor/save'&&response.status===200){assert.equal(held,null);const value=JSON.parse(response.body).result,name=path.resolve(dataDir,'editor/workspace',value.path),base=path.resolve(dataDir,'editor/workspace');assert(name.startsWith(base+path.sep));const disk=await fs.readFile(name);assert.equal(sha(disk),value.revision);assert.equal(disk.toString('utf8'),value.content);const record={label:arm,at:new Date().toISOString(),forwardedId:row.id,status:response.status,path:value.path,disk:{bytes:disk.length,sha256:sha(disk),content:disk.toString('utf8')},response:{content:value.content,revision:value.revision,bytes:value.bytes},committedBeforeHold:true};holdRecords.push(record);await save('held-'+arm+'.json',record);held={label:arm,deliver,record};arm=null;console.log(JSON.stringify({held:held.label,path:value.path,committed:true,forwardedId:row.id}));}else deliver();
}catch(e){if(!res.headersSent)res.writeHead(500,{'content-type':'text/plain'});res.end(String(e.message));console.error('Owned relay error: '+e.message);}});
await new Promise((yes,no)=>{relay.once('error',no);relay.listen(0,'127.0.0.1',yes)});relayPort=relay.address().port;await save('host.json',{at:new Date().toISOString(),pid:process.pid,actualHost:instance.url,relayOrigin:'http://127.0.0.1:'+relayPort,browserUrl:'http://127.0.0.1:'+relayPort+'/#editor',dataDir,initial,sourceFiles:31,fixtureOnlyRelay:true,proxySecurityClaim:false,headerTransforms:'Exact Host rewritten to actual host. Present Origin accepted only from relay origin and rewritten to actual host. Request body/method/path/token forwarded unchanged; hop-by-hop headers removed; content-length recomputed.',sourceProof:current.raw.stdout.sha256,originalGUI:0,benchmarks:0,user4311Touched:false});
async function observe(label){const files={};for(const name of Object.keys(initial)){const b=await fs.readFile(path.join(dataDir,'editor/workspace',name));files[name]={bytes:b.length,sha256:sha(b),content:b.toString('utf8')};}await save('observation-'+label+'.json',{at:new Date().toISOString(),files,actualCalls:structuredClone(actual),forwarded:structuredClone(forwarded),holdRecords:structuredClone(holdRecords),held:held?.label??null,armed:arm});console.log(JSON.stringify({observation:label,actualCalls:actual.length,forwarded:forwarded.length,held:held?.label??null,saveRequests:forwarded.filter(r=>r.url==='/api/editor/save').length}));}
async function close(reason){if(closing)return;closing=true;clearTimeout(timer);if(held){held.deliver();held.record.releasedAt=new Date().toISOString();held=null;}await observe('before-close');await new Promise((resolve,reject)=>relay.close(e=>e?reject(e):resolve()));await instance.close();for(const r of sources){assert.deepEqual(await fp(path.join(repo,r.path)),{bytes:r.bytes,sha256:r.sha256});assert.deepEqual(await fp(path.join(here,r.clone)),{bytes:r.bytes,sha256:r.sha256});}assert.deepEqual(await fp(path.join(here,'host-relay.mjs')),JSON.parse(await fs.readFile(path.join(here,'controller-before.json'))));const resolved=path.resolve(dataDir);assert(resolved.startsWith(prefix)&&path.dirname(resolved)===path.resolve(os.tmpdir()));await fs.rm(resolved,{recursive:true,force:true});await save('source-after.json',sources);await save('cleanup.json',{at:new Date().toISOString(),reason,actualHostClosed:true,relayClosed:true,tempDataRemoved:true,source31AndControllerStable:true});console.log(JSON.stringify({closed:true,tempRemoved:true,source31Stable:true}));process.exit(0);}
const timer=setTimeout(()=>close('15-minute campaign deadline').catch(e=>{console.error(e);process.exit(1);}),900000),rl=readline.createInterface({input:process.stdin});rl.on('line',line=>{const value=line.trim();if(value==='close')close('explicit owned close').catch(e=>{console.error(e);process.exit(1);});else if(/^arm [a-z0-9-]+$/.test(value)){assert.equal(held,null);assert.equal(arm,null);arm=value.slice(4);console.log(JSON.stringify({armed:arm}));}else if(/^release [a-z0-9-]+$/.test(value)){assert.equal(held?.label,value.slice(8));held.deliver();held.record.releasedAt=new Date().toISOString();console.log(JSON.stringify({released:held.label}));held=null;}else if(/^observe [a-z0-9-]+$/.test(value))observe(value.slice(8)).catch(e=>console.error(e));});console.log(JSON.stringify({browserUrl:'http://127.0.0.1:'+relayPort+'/#editor',actualHost:instance.url,pid:process.pid,source31:true,syntheticOnly:true}));
