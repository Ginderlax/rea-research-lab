function add(entry){const path=posix.normalize(entry.path);assert.ok(path.startsWith(product)&&!path.split('/').includes('..'));const bytes=readFileSync(join(root,path));assert.equal(sha(bytes),entry.sha256,`Snapshot source mismatch: ${path}`);if(sources.has(path))assert.equal(sources.get(path).sha256,entry.sha256);sources.set(path,{path,bytes:bytes.length,sha256:entry.sha256});}
