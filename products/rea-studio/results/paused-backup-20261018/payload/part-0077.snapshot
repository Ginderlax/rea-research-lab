    {
      "id": "grafana.candidate.23c54fdbf02f30f0beea",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Sign up for [https://grafana.com/](/auth/sign-up/create-user). Grafana gives you a Prometheus instance out of the box.",
      "headingPath": [
        "Get started with Grafana and Prometheus",
        "Configure Prometheus for Grafana"
      ],
      "source": {
        "path": "docs/sources/fundamentals/getting-started/first-dashboards/get-started-grafana-prometheus.md",
