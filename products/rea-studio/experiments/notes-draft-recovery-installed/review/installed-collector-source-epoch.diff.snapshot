+  for (const flag of ['historicalReceiptsRebound', 'originalAutosaveComparison', 'fullParity', 'superiority']) assert.equal(declaration[flag], false);
+  return { declaration, receipt: { path: declarationPath, ...identity(raw) }, currentNotesFiles: 41, acceptedExperimentalNotesPreservedExceptDeclaredReadme: true, allNotesGitBlobsAuthenticated: true };
