    {
      "id": "grafana.candidate.c16ccff4621bd8ce68c1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This setting applies to `sqlite` only and controls the number of times the system retries a transaction when the database is locked. The default value is `5`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[database]`",
        "`transaction_retries`"
