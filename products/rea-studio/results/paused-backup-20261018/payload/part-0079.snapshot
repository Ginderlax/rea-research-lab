      "id": "grafana.candidate.3b62aeea7417efe27762",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Only dashboards from the selected folder are included in search results and displayed in the dashboard list. To include all dashboards in search results, select the top-level **Dashboards** folder. This option is only applied when the **Search** switch is toggled on.",
      "headingPath": [
