import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const here=import.meta.dirname,work=path.resolve(here,'..'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),json=v=>Buffer.from(JSON.stringify(v,null,2)+'\n');
async function save(p,b){await fs.mkdir(path.dirname(path.join(here,p)),{recursive:true});await fs.writeFile(path.join(here,p),b,{flag:'wx'});}
async function all(root,prefix=''){const names=[];for(const e of await fs.readdir(root,{withFileTypes:true})){assert(!e.isSymbolicLink());const p=prefix+e.name;if(e.isDirectory())names.push(...await all(path.join(root,e.name),p+'/'));else{assert(e.isFile());names.push(p);}}return names;}
async function authority(name,file,sha,count){const root=path.join(work,name),raw=await fs.readFile(path.join(root,file));assert.equal(id(raw).sha256,sha);const m=JSON.parse(raw),rows=Array.isArray(m.inventory)?m.inventory:Object.entries(m.inventory).map(([p,r])=>({path:p,...r}));assert.equal(rows.length,count);assert.deepEqual((await all(root)).sort(),[...rows.map(r=>r.path),file].sort());for(const r of rows)assert.deepEqual(id(await fs.readFile(path.join(root,r.path))),{bytes:r.bytes,sha256:r.sha256},r.path);return{name,manifest:{path:file,...id(raw)},schema:m.schema,payloads:rows.length};}
const authorities=await Promise.all([
authority('editor-search-pattern-textarea-fix-next','freeze-manifest.json','0b4297c0d1d498ed614f6d98b8850fd05520594f850e7448c82e9652b9653f17',852),
authority('editor-search-pattern-next','freeze-manifest.json','7f975ae3f7a0827f5b9ade231bd121c5b4028f17d88758455fd680962ff0f878',573),
authority('editor-search-pattern-independent-review','review-manifest.json','76c89a780e5c8e2a7774d925073b500a1e8a5f5c164c86a6e4e71b809717db31',141)]);
const browser='runs/browser-2026-10-13T04-52-43-929Z',replay='runs/fresh-2026-10-13T05-00-46-631Z';
const host=JSON.parse(await fs.readFile(path.join(here,browser,'host-validation.json'))),r=JSON.parse(await fs.readFile(path.join(here,replay,'validation.json')));assert(host.sourceStable&&host.closed&&host.tempGone&&host.durableWireLogs);assert(r.accepted&&r.summary.tests===16&&r.summary.pass===16);
const before=JSON.parse(await fs.readFile(path.join(here,browser,'source-before.json'))),after=JSON.parse(await fs.readFile(path.join(here,browser,'source-after.json')));assert.deepEqual(before,after);
const readLines=async(file)=>(await fs.readFile(path.join(here,browser,file),'utf8')).trim().split('\n').map(line=>JSON.parse(line));
const captures=await readLines('native-selections.jsonl'),calls=await readLines('api-calls.jsonl'),controls=await readLines('control-events.jsonl');assert.equal(captures.length,57);assert.equal(calls.length,16);
const fixtures=JSON.parse(await fs.readFile(path.join(here,browser,'synthetic-fixtures.json'))),lookup=new Map(fixtures.map(f=>[f.name,f.content]));
const literal=[['bare-cr.txt',1,9,8],['bare-cr.txt',1,32,31],['crlf.txt',2,1,8],['crlf.txt',3,11,31],['lf.txt',2,1,8],['lf.txt',3,11,31],['mixed.txt',2,1,8],['mixed.txt',2,24,31],['mixed.txt',3,6,43]];
const astral=[['bare-cr.txt',1,1,0],['bare-cr.txt',1,24,23],['crlf.txt',1,1,0],['crlf.txt',3,3,23],['lf.txt',1,1,0],['lf.txt',3,3,23],['mixed.txt',1,1,0],['mixed.txt',2,16,23]];
const selectionRows=[];
for(const[mode,cases]of[['literal',literal.map(v=>[...v,'needle'])],['regex',[...literal.map(v=>[...v,'needle']),...astral.map(v=>[...v,'😀'])]]]){
 for(const[file,line,column,start,selected]of cases){const label=`${file}:${line}:${column}`,status=`Opened ${file}, line${line}, column${column}.`,count=mode==='literal'?11:20,expectedValue=lookup.get(file).replace(/\r\n?/g,'\n');const found=captures.find(c=>c.variant==='candidate'&&c.status[0].startsWith(`${count} matches `)&&c.status.includes(status)&&c.value===expectedValue&&c.selected===selected&&c.selectionStart===start&&c.selectionEnd===start+selected.length&&!c.disabled);assert(found,mode+' '+label);selectionRows.push({mode,label,expectedSelected:selected,expectedStart:start,expectedEnd:start+selected.length,capture:found,pass:true});}
}
assert.equal(selectionRows.length,26);await save('native-selection-validation.json',json({schema:'rea-editor-textarea-correction-independent-native-selections/v1',source:'Exact durable native observer captures plus independently declared synthetic fixture expectations',rows:selectionRows,pass:26,fail:0,literal:9,regex:17,astral:8,authorModelResultsAggregated:false}));
const boundaries=JSON.parse(await fs.readFile(path.join(here,'boundary-observations.json')));assert.equal(boundaries.rows.length,2);assert(boundaries.rows.every(row=>row.pass));assert(captures.some(c=>c.status[0].startsWith('Search options changed.')));assert(captures.some(c=>c.value===''&&c.disabled&&c.status[0].startsWith('11 matches ')));assert(calls.some(c=>c.action==='search'&&c.responseHeld));assert.equal(calls.filter(c=>c.action==='read'&&c.responseHeld).length,2);assert(controls.some(c=>c.event==='release'&&c.action==='search'));assert(controls.some(c=>c.event==='release'&&c.action==='read'));
assert.equal(calls.filter(c=>c.action==='save').length,0);
const node=id(await fs.readFile(process.execPath));assert.equal(node.sha256,'b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3');
await save('final-authority.json',json({at:new Date().toISOString(),authorities,node,nodeVersion:process.version,browserSource11Stable:true,replayCandidate41Stable:true}));
await save('review-validation.json',json({schema:'rea-editor-textarea-correction-independent-review/v1',at:new Date().toISOString(),status:'frozen-finite-navigation-acceptance-with-native-dialog-limit',sourceStable:true,authorities,correctedClient:before.find(row=>row.name==='candidate-client'),runtimeClientSubstitutions:2,backendSevenExact:true,saveAndGenerationBodiesExactByInverse:true,independentlyObservedNativeSelections:26,nativeSelectionPass:26,nativeSelectionFail:0,nativeSelectionScope:{literal:9,regex:17,astral:8,lineEndings:['LF','CRLF','bareCR','mixed']},actualResponseBoundaryControls:2,actualResponseBoundaryPass:2,oldIndependentGroupsReplayed:16,replayPass:16,replayFail:0,replaySkip:0,newIndependentLocalGroups:0,authorModel22And26CountsNotAggregated:true,nativeCorrectionNavigationAccepted:true,confirmedCorrectedApplicationDefects:[],nativeDirtyCloseConfirmObserved:true,nativeDirtyCloseCancelAccepted:false,nativeDirtyCloseHeldReadAccepted:false,nativeSaveSpecificCampaignExecuted:false,allRequestedNativeCampaignsComplete:false,nativeBrowserToolFailures:4,ownedTabClosureConfirmed:false,ephemeralCleanupCountedAsVerified:false,ownedHostGracefulExit0Observed:true,ownedHostStopped:true,ownedTempGone:true,durableWireLogs:true,nativeObserverEntries:captures.length,actualServerRequests:calls.length,actualServerRequestBreakdown:Object.fromEntries([...new Set(calls.map(c=>c.action))].map(action=>[action,calls.filter(c=>c.action===action).length])),sharedStudioHostUsed:false,gitStatusStubbed:true,sessionTokenPersisted:false,originalExecutions:0,originalWorkbench:0,originalGUI:0,originalUnequalGroupsNotRerunOrPromoted:true,benchmarkCommands:0,productionWrites:0,candidateWrites:0,oldFrozen573And141Unchanged:true,fullProductParity:false,securityEquivalence:false,superiority:false,localScreenshotPreserved:false}));
const inventory={};for(const file of(await all(here)).sort()){assert(!['review-manifest.json'].includes(file));inventory[file]=id(await fs.readFile(path.join(here,file)));}await save('review-manifest.json',json({schema:'rea-editor-textarea-correction-independent-review-strict-freeze/v1',inventory}));const manifest=id(await fs.readFile(path.join(here,'review-manifest.json'))),receipt=id(await fs.readFile(path.join(here,'review-validation.json')));process.stdout.write(JSON.stringify({payloads:Object.keys(inventory).length,manifest,receipt,nativeSelections26Accepted:true,controls2Passed:true,replays16Passed:true,nativeCancelIncomplete:true,ownedTabClosureUnconfirmed:true})+'\n');
