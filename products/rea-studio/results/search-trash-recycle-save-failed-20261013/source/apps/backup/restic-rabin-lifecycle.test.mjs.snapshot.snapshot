import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import {syncBuiltinESMExports} from 'node:module';
import path from 'node:path';
import os from 'node:os';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import {captureRabinFile} from './capture-rabin-file.mjs';
import {handleNative} from './restic.mjs';
import {createWorkspace} from '../../lib/storage.mjs';

const root=await fs.mkdtemp(path.join(os.tmpdir(),'rea-rabin-lifecycle-')),hash=bytes=>createHash('sha256').update(bytes).digest('hex'),sourceUrls=['restic.mjs','capture-rabin-file.mjs','rabin.mjs','restic-compression.mjs','restic-crypto.mjs','restic-kdf-policy.mjs','../../lib/storage.mjs'].map(name=>({name,url:new URL(name,import.meta.url)})),manifest={sourceFingerprints:await Promise.all(sourceUrls.map(async e=>({path:e.name,sha256:hash(await fs.readFile(e.url))}))) },password='only-own-fixed-rabin-review-fixtures',original={open:fs.open,lstat:fs.lstat,link:fs.link,unlink:fs.unlink},realNow=Date.now,observations=[];
async function stable(){for(const e of sourceUrls)assert.equal(hash(await fs.readFile(e.url)),manifest.sourceFingerprints.find(r=>r.path===e.name).sha256);}
await stable();const template=await fs.mkdtemp(path.join(root,'template-')),templateWorkspace=await createWorkspace(path.join(template,'workspace'));await handleNative({action:'nativeInit',input:{repository:'repository',password,version:2},workspace:templateWorkspace});

async function fixture(name,{initialize=true}={}){const folder=await fs.mkdtemp(path.join(root,`fixture-${name}-`)),workspace=await createWorkspace(path.join(folder,'workspace'));if(initialize)await fs.cp(templateWorkspace.resolve('repository'),workspace.resolve('repository'),{recursive:true});await fs.mkdir(workspace.resolve('source'));const filename=workspace.resolve('source/ordinary.txt');await fs.writeFile(filename,'ordinary synthetic source');return{folder,workspace,filename,api:(action,input={})=>handleNative({action,input:{repository:'repository',password,...input},workspace})};}
function inject(f,policy={}){
 const events=[],handles=new Map(),resolve=f.workspace.resolve.bind(f.workspace);let target=null,offset=0;
 const owns=filename=>typeof filename==='string'&&(filename===f.workspace.root||filename.startsWith(f.workspace.root+path.sep));
 f.workspace.resolve=(relative='')=>{const resolved=resolve(relative);if(/^repository\/(?:config|(?:keys|locks|data|index|snapshots)\/.+)$/.test(relative))target=relative;policy.resolve?.({relative,resolved,events,setOffset:value=>{offset=value;}});return resolved;};
 Date.now=()=>realNow()+offset;
 fs.open=async(filename,...args)=>{if(owns(filename))await policy.beforeOpen?.({filename,args,target});const handle=await original.open(filename,...args);if(!owns(filename))return handle;const row={filename,args,target,closeAttempts:0,closeSuccesses:0,writeAttempts:0,syncAttempts:0};handles.set(filename,row);events.push({event:'open',...row});const write=handle.writeFile.bind(handle),sync=handle.sync.bind(handle),close=handle.close.bind(handle);
  handle.writeFile=async(...args)=>{row.writeAttempts++;await policy.write?.(row);return write(...args);};handle.sync=async(...args)=>{row.syncAttempts++;await policy.sync?.(row);return sync(...args);};handle.close=async(...args)=>{row.closeAttempts++;const result=await close(...args);row.closeSuccesses++;await policy.close?.(row);return result;};await policy.opened?.({row,handle});return handle;};
 fs.lstat=async(filename,...args)=>{const result=await original.lstat(filename,...args);if(owns(filename))await policy.stat?.({filename,args,result});return result;};
 fs.link=async(source,destination)=>{if(owns(destination))await policy.beforeLink?.({source,destination,events,setOffset:value=>{offset=value;}});const result=await original.link(source,destination);if(owns(destination)){events.push({event:'link',source,destination});await policy.afterLink?.({source,destination,events,setOffset:value=>{offset=value;}});}return result;};
 fs.unlink=async filename=>{if(owns(filename)){events.push({event:'unlink-attempt',filename});await policy.unlink?.({filename,row:handles.get(filename),events});}const result=await original.unlink(filename);if(owns(filename))events.push({event:'unlink-success',filename});return result;};syncBuiltinESMExports();
 return{events,handles,restore(){Date.now=realNow;f.workspace.resolve=resolve;Object.assign(fs,original);syncBuiltinESMExports();}};
}
async function state(f){const directory=async name=>{try{return await fs.readdir(f.workspace.resolve('repository/'+name));}catch(error){if(error.code==='ENOENT')return[];throw error;}};return{snapshots:await directory('snapshots'),indexes:await directory('index'),locks:await directory('locks'),temporary:await directory('tmp')};}
async function run(name,f,policy,operation,check){const hooks=inject(f,policy);let result,error;try{result=await operation();}catch(value){error=value;}finally{hooks.restore();}const actual=await state(f),record={name,fixture:f.folder,result:result??null,error:error?{name:error.name,message:error.message,code:error.code??null,cleanupWarnings:error.cleanupWarnings??null}:null,state:actual,handles:[...hooks.handles.values()],events:hooks.events};observations.push(record);await check({result,error,actual,hooks,record});await stable();}
const error=(message,code='EIO')=>Object.assign(new Error(message),{code});
const hasTarget=(row,prefix)=>row?.target?.startsWith('repository/'+prefix);

for(const boundary of ['pre-sink','final'])for(const trigger of ['resolver','named-stat'])test(`capture rejects ${trigger} cancellation at ${boundary} boundary`,async()=>{
 const f=await fixture(`abort-${boundary}-${trigger}`),controller=new AbortController();let resolutions=0,stats=0,sinks=0;const n=boundary==='pre-sink'?3:5;
 await run(`capture-abort-${boundary}-${trigger}`,f,{stat:({filename})=>{if(filename===f.filename&&++stats===n&&trigger==='named-stat')controller.abort(new Error('synthetic boundary abort'));}},()=>captureRabinFile({filename:f.filename,polynomial:'3da3358b4dc173',signal:controller.signal,resolveFilename(){if(++resolutions===(boundary==='pre-sink'?4:6)&&trigger==='resolver')controller.abort(new Error('synthetic boundary abort'));return f.filename;},saveChunk(bytes){sinks++;return hash(bytes);}}),({error,hooks,record})=>{assert.match(error?.message??'',/synthetic boundary abort/);assert.equal(sinks,boundary==='pre-sink'?0:1);assert.equal(hooks.handles.get(f.filename).closeSuccesses,1);record.sinkCalls=sinks;record.resolutions=resolutions;record.stats=stats;});
});
test('capture cancellation after successful open still closes the source handle',async()=>{const f=await fixture('abort-open'),controller=new AbortController();let sinks=0;await run('capture-abort-after-open',f,{opened:({row})=>{if(row.filename===f.filename)controller.abort(new Error('synthetic open abort'));}},()=>captureRabinFile({filename:f.filename,polynomial:'3da3358b4dc173',signal:controller.signal,saveChunk(bytes){sinks++;return hash(bytes);}}),({error,hooks})=>{assert.match(error?.message??'',/synthetic open abort/);assert.equal(sinks,0);assert.equal(hooks.handles.get(f.filename).closeSuccesses,1);});});

test('deadline immediately before snapshot link rejects without a snapshot or temporary file',async()=>{const f=await fixture('before-link');let resolutions=0;await run('snapshot-deadline-before-link',f,{resolve:({relative,setOffset})=>{if(/^repository\/snapshots\/[a-f0-9]{64}$/.test(relative)&&++resolutions===2)setOffset(120001);}},()=>f.api('nativeSnapshot',{source:'source',compression:'off'}),({error,actual,hooks})=>{assert.match(error?.message??'',/exceeded two minutes/);assert.equal(actual.snapshots.length,0);assert.equal(actual.temporary.length,0);assert.equal(actual.locks.length,0);assert.equal(hooks.events.filter(row=>row.event==='link'&&row.destination.includes(path.sep+'snapshots'+path.sep)).length,0);});});
test('deadline after successful snapshot link retains committed success and cleans temp/own lock',async()=>{const f=await fixture('after-link');await run('snapshot-deadline-after-link',f,{afterLink:({destination,setOffset})=>{if(destination.includes(path.sep+'snapshots'+path.sep))setOffset(120001);}},()=>f.api('nativeSnapshot',{source:'source',compression:'off'}),({result,error,actual})=>{assert.equal(error,undefined);assert.deepEqual(actual.snapshots,[result.id]);assert.equal(actual.temporary.length,0);assert.equal(actual.locks.length,0);assert.equal(result.cleanupWarnings,undefined);});});

for(const phase of ['write','sync'])test(`data-pack ${phase} failure preserves primary cause and cleans the owned temp`,async()=>{const f=await fixture(`pack-${phase}`),primary=error(`synthetic ${phase} failure`);await run(`pack-${phase}-failure`,f,{[phase]:row=>{if(hasTarget(row,'data/'))throw primary;}},()=>f.api('nativeSnapshot',{source:'source',compression:'off'}),({error,actual,hooks})=>{assert.equal(error,primary);assert.equal(actual.snapshots.length,0);assert.equal(actual.indexes.length,0);assert.equal(actual.temporary.length,0);assert.equal(actual.locks.length,0);assert.ok([...hooks.handles.values()].filter(row=>hasTarget(row,'data/')).every(row=>row.closeSuccesses===1));});});
test('write plus temporary-unlink failure preserves both primary cause and cleanup warning',async()=>{const f=await fixture('primary-cleanup'),primary=error('synthetic primary write failure');await run('primary-plus-temp-cleanup-error',f,{write:row=>{if(hasTarget(row,'data/'))throw primary;},unlink:({row})=>{if(hasTarget(row,'data/'))throw error('synthetic temp cleanup failure','EACCES');}},()=>f.api('nativeSnapshot',{source:'source',compression:'off'}),({error,actual})=>{assert.equal(error,primary);assert.match(error.message,/primary write failure/);assert.match(error.message,/temp cleanup failure/);assert.equal(error.cleanupWarnings[0].scope,'temporary-object');assert.equal(error.cleanupWarnings[0].committedObject,null);assert.equal(actual.temporary.length,1);assert.equal(actual.snapshots.length,0);assert.equal(actual.locks.length,0);});});
test('write plus close failure preserves primary cause and exposes the secondary handle error',async()=>{const f=await fixture('primary-close'),primary=error('synthetic primary write failure');await run('primary-plus-close-error',f,{write:row=>{if(hasTarget(row,'data/'))throw primary;},close:row=>{if(hasTarget(row,'data/'))throw error('synthetic close callback failure');}},()=>f.api('nativeSnapshot',{source:'source',compression:'off'}),({error,actual,hooks})=>{assert.equal(error,primary);assert.equal(error.cleanupWarnings[0].scope,'temporary-handle');assert.match(error.message,/close callback failure/);assert.equal(actual.temporary.length,0);assert.ok([...hooks.handles.values()].some(row=>hasTarget(row,'data/')&&row.closeSuccesses===1));});});

test('committed snapshot temp cleanup failure returns its ID and an observable warning',async()=>{const f=await fixture('committed-cleanup');await run('committed-snapshot-cleanup-warning',f,{unlink:({row})=>{if(hasTarget(row,'snapshots/'))throw error('synthetic snapshot temp cleanup failure','EACCES');}},()=>f.api('nativeSnapshot',{source:'source',compression:'off'}),({result,error,actual})=>{assert.equal(error,undefined);assert.deepEqual(actual.snapshots,[result.id]);assert.equal(actual.temporary.length,1);assert.equal(actual.locks.length,0);assert.equal(result.cleanupWarnings[0].scope,'temporary-object');assert.equal(result.cleanupWarnings[0].committedObject,`snapshots/${result.id}`);});});
test('successful snapshot with failed own-lock removal retains result and exact remaining lock',async()=>{const f=await fixture('own-lock-success');await run('own-lock-release-failure-after-success',f,{unlink:({filename})=>{if(filename.includes(path.sep+'locks'+path.sep))throw error('synthetic own-lock removal failure','EACCES');}},()=>f.api('nativeSnapshot',{source:'source',compression:'off'}),({result,error,actual})=>{assert.equal(error,undefined);assert.deepEqual(actual.snapshots,[result.id]);assert.deepEqual(actual.locks,[result.remainingOwnLock]);assert.equal(result.cleanupWarnings[0].lockID,result.remainingOwnLock);assert.equal(result.cleanupWarnings[0].scope,'own-lock');});});
test('primary operation failure with failed own-lock removal preserves both causes and exact lock',async()=>{const f=await fixture('own-lock-failure');await run('own-lock-release-failure-after-primary',f,{unlink:({filename})=>{if(filename.includes(path.sep+'locks'+path.sep))throw error('synthetic own-lock removal failure','EACCES');}},()=>f.api('nativeSnapshot',{source:'absent',compression:'off'}),({error,actual})=>{assert.equal(error.code,'ENOENT');assert.match(error.message,/no such file or directory/);assert.match(error.message,/own-lock removal failure/);assert.equal(error.cleanupWarnings[0].scope,'own-lock');assert.deepEqual(actual.locks,[error.cleanupWarnings[0].lockID]);assert.equal(actual.snapshots.length,0);});});
test('already-missing own lock is an observable warning without a remaining lock',async()=>{const f=await fixture('own-lock-missing');await run('own-lock-already-missing',f,{unlink:async({filename})=>{if(filename.includes(path.sep+'locks'+path.sep)){await original.unlink(filename);throw error('synthetic own lock already missing','ENOENT');}}},()=>f.api('nativeInfo'),({result,error,actual})=>{assert.equal(error,undefined);assert.equal(actual.locks.length,0);assert.equal(result.remainingOwnLock,undefined);assert.equal(result.cleanupWarnings[0].scope,'own-lock');assert.match(result.cleanupWarnings[0].message,/already missing/);});});

for(const phase of ['write','sync'])test(`initializer key ${phase} failure closes handle and cleans temp`,async()=>{const f=await fixture(`initializer-${phase}`,{initialize:false}),primary=error(`synthetic initializer ${phase} failure`);await run(`initializer-${phase}-failure`,f,{[phase]:row=>{if(hasTarget(row,'keys/'))throw primary;}},()=>f.api('nativeInit',{version:2}),({error,actual,hooks})=>{assert.equal(error,primary);assert.equal(actual.temporary.length,0);assert.equal(actual.locks.length,0);assert.ok([...hooks.handles.values()].some(row=>hasTarget(row,'keys/')&&row.closeSuccesses===1));});});
test('initializer committed key cleanup warning is observable on nativeInit result',async()=>{const f=await fixture('initializer-warning',{initialize:false});await run('initializer-committed-key-cleanup-warning',f,{unlink:({row})=>{if(hasTarget(row,'keys/'))throw error('synthetic initializer temp cleanup failure','EACCES');}},()=>f.api('nativeInit',{version:2}),({result,error,actual})=>{assert.equal(error,undefined);assert.equal(result.version,2);assert.equal(actual.temporary.length,1);assert.equal(result.cleanupWarnings[0].committedObject,`keys/${result.keyID}`);});});
test('lock writer committed temp cleanup warning is observable after ordinary own-lock release',async()=>{const f=await fixture('lock-writer-warning');await run('lock-writer-committed-temp-cleanup-warning',f,{unlink:({row})=>{if(hasTarget(row,'locks/'))throw error('synthetic lock temp cleanup failure','EACCES');}},()=>f.api('nativeInfo'),({result,error,actual})=>{assert.equal(error,undefined);assert.equal(actual.temporary.length,1);assert.equal(actual.locks.length,0);assert.equal(result.cleanupWarnings[0].scope,'temporary-object');assert.match(result.cleanupWarnings[0].committedObject,/^locks\/[a-f0-9]{64}$/);});});
test('failed exclusive temp open does not delete a pre-existing file owned by someone else',async()=>{const f=await fixture('exclusive-open');await run('exclusive-open-eexist-no-delete',f,{beforeOpen:async({filename,args})=>{if(args[0]==='wx'&&filename.endsWith('.pending')){await fs.writeFile(filename,'synthetic pre-existing temp');throw error('synthetic exclusive-open collision','EEXIST');}}},()=>f.api('nativeInfo'),({error,actual,hooks})=>{assert.equal(error.code,'EEXIST');assert.equal(actual.temporary.length,1);assert.equal(actual.locks.length,0);assert.equal(hooks.events.filter(row=>row.event==='unlink-attempt'&&row.filename.endsWith('.pending')).length,0);});});

test.after(async()=>{await stable();console.log(JSON.stringify({rabinLifecycleObservations:{schema:'rea-rabin-production-lifecycle/v1',sourceFingerprints:manifest.sourceFingerprints,observations,sourceBytesStableAcrossRun:true,scope:'Finite owned fixtures and child-only fault injection against actual production modules.'}}));assert.equal(path.dirname(root),path.resolve(os.tmpdir()));assert.ok(path.basename(root).startsWith('rea-rabin-lifecycle-'));await fs.rm(root,{recursive:true,force:true});});
