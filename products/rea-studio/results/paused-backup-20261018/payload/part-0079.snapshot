    },
    {
      "id": "grafana.candidate.611754a08d22c7e2e3d2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana v7.1 adds support for provisioning of app plugins. This allows app plugins to be configured and enabled/disabled using configuration files. For more information about provisioning of app, refer to [provisioning plugin](../../administration/provisioning/#plugins).",
      "headingPath": [
        "What's new in Grafana v7.1",
        "Provisioning of apps"
      ],
