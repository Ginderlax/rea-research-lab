    {
      "id": "grafana.candidate.ead95ab6bb5589a1e0b4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Update the service accounts's role assignments to match the provided set of UIDs. This will remove any assigned roles that aren't in the request and add roles that are in the set but are not already assigned to the service account.",
      "headingPath": [
        "RBAC API",
        "Remove a service account role assignment",
        "Set service account role assignments"
      ],
      "source": {
        "path": "docs/sources/developer-resources/api-reference/http-api/api-legacy/access_control.md",
        "gitBlobSha": "23f0a00b4604f17d0d6f250151ed515d15a0bee6",
        "sha256": "b78e3ec44aac5ef862c3e46b43996f6c4c94be996bbaa59847c52201964c8c3f",
        "lineStart": 1099,
        "lineEnd": 1101,
