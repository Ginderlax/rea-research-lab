import assert from 'node:assert/strict';import{readFileSync,writeFileSync}from'node:fs';import{join,resolve}from'node:path';import{createHash}from'node:crypto';import{spawnSync}from'node:child_process';
const lab=resolve(import.meta.dirname,'../outputs/rea-research-lab'),env={...process.env,GIT_TERMINAL_PROMPT:'0',GCM_INTERACTIVE:'Never'};
function git(args){const r=spawnSync('git',args,{cwd:lab,env,encoding:'utf8',timeout:120000,maxBuffer:16*1024*1024,windowsHide:true});assert.equal(r.status,0,r.stderr);return r.stdout;}
assert.equal(git(['remote','get-url','origin']).trim(),'https://github.com/Ginderlax/rea-research-lab.git');assert.equal(git(['branch','--show-current']).trim(),'main');
const allowed=/^(?:products\/rea-studio\/|README\.md$|scripts\/(?:verify-records|verify-followup-records|verify-notes-vault-followups|verify-editor-save-followup|verify-notes-inline-followups|verify-editor-value-api-followups|verify-notes-layout-value-api-checkpoint|editor-vault-proof-migration)\.mjs$|PUBLICATION-MANIFEST\.json$|VALIDATION\.json$)/;
const changes=git(['status','--porcelain=v1','--untracked-files=all','-z']).split('\0').filter(Boolean);for(const entry of changes){const name=entry.slice(3);assert(!entry.startsWith('R')&&!entry.startsWith('C'),'Unexpected rename/copy status');assert(allowed.test(name),'Unexpected publication change: '+name);}
git(['add','--all']);
const entries=git(['ls-files','--stage','-z']).split('\0').filter(Boolean).map(entry=>{const i=entry.indexOf('\t'),meta=entry.slice(0,i).split(' ');assert.equal(meta[2],'0');return{path:entry.slice(i+1),gitSHA:meta[1]};});
const objectFormat=git(['rev-parse','--show-object-format']).trim(),excluded=/(^|\/)(artifacts|node_modules|tooling|__pycache__|\.local|work)(\/|$)|\.(exe|dll|zip|tgz|bundle|tar|7z|pyc)$/i;
const rows=[];for(const entry of entries.sort((a,b)=>a.path.localeCompare(b.path))){if(['PUBLICATION-MANIFEST.json','VALIDATION.json'].includes(entry.path))continue;assert(!excluded.test(entry.path),'Excluded distributable: '+entry.path);const b=readFileSync(join(lab,entry.path)),digest=createHash(objectFormat).update('blob '+b.length+'\0').update(b).digest('hex');assert.equal(digest,entry.gitSHA,'Staged bytes differ: '+entry.path);rows.push({path:entry.path,bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});}
const old=JSON.parse(readFileSync(join(lab,'PUBLICATION-MANIFEST.json')));assert.equal(old.schema,'rea-publication-manifest/v1');const next={...old,files:rows};writeFileSync(join(lab,'PUBLICATION-MANIFEST.json'),JSON.stringify(next,null,2));git(['add','PUBLICATION-MANIFEST.json']);console.log(JSON.stringify({payloadFiles:rows.length,payloadBytes:rows.reduce((s,r)=>s+r.bytes,0),stagedFiles:entries.length,publicMetadataPreserved:true,published:false}));
