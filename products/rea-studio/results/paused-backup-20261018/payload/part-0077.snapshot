    {
      "id": "grafana.candidate.e41de7503f69d1b2c13b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can use `*` as the SAML Organization if you want all your users to be in some Grafana organizations with a default role:",
      "headingPath": [
        "Configure organization mapping for SAML"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/configure-saml-org-mapping/_index.md",
