// Final source-only all-record reauthentication, separate from successful preparation.
import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';import {applyQualificationOverrides} from './qualification-override.mjs';
const root=import.meta.dirname,workspace=path.resolve(root,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),hash=b=>createHash('sha256').update(b).digest('hex');const proofPath=path.resolve(root,'../notes-inline-publication-plan-next/notes-inline-provenance.mjs');assert.equal(hash(await fs.readFile(proofPath)),'b4862a18bbf62abff0dd444607dc8ec019db9c7e2e69631f390525e31ab538d1');const{authenticateEpoch,readBounded}=await import(proofPath);const before=JSON.parse(await fs.readFile(path.join(root,'authentication-before.json')));for(const e of before.epochs)assert.deepEqual(await authenticateEpoch(workspace,{id:e.id,directory:e.directory,manifest:e.manifest,schema:e.schema,count:e.payloadFiles,sha256:e.manifestIdentity.sha256}),e);
const observed=JSON.parse(await fs.readFile(path.join(root,'all829-source-map-records-authenticated.json')));assert.equal(observed.rows.length,829);for(const r of observed.rows)await readBounded(path.join(workspace,r.sourceRoot),r.sourcePath,r);const bindings=JSON.parse(await fs.readFile(path.join(root,'current-before-image-bindings.json')));for(const r of bindings.installed34)await readBounded(repo,r.path,r);for(const r of bindings.requirementsUnchangedReference.registries)await readBounded(repo,r.path,r);const base=await fs.readFile(path.join(root,'authority/prior-map.json.snapshot')),override=JSON.parse(await fs.readFile(path.join(root,'qualification-overrides.json'))),corrected=JSON.parse(await fs.readFile(path.join(root,'public-preservation-map.corrected.json')));assert.deepEqual(applyQualificationOverrides(base,override),corrected);assert.deepEqual(await readBounded(path.resolve(root,'../notes-inline-publication-plan-browser-next'),'public-preservation-map.json'),base);
const receipt={schema:'rea-notes-qualification-final-all-record-proof/v1',at:new Date().toISOString(),wholeClosedEpochPayloads832AndManifests7Exact:true,all829MapSourceRecordsAuthenticatedAgainAfterPreparation:true,unchangedMapRows806Exact:true,twelveQualificationOnlyReconstructionExact:true,currentInstalledBeforeImages34Exact:true,requirementsCurrentByteIdentitiesExact:true,allPriorFrozenStagesUnmodified:true,sourceOnly:true,productTests:0,originalExecutions:0,newBrowserExecutions:0,StudioWrites:0};await fs.writeFile(path.join(root,'final-proof-authentication.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(receipt));
