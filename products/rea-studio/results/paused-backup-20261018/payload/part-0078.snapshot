    {
      "id": "grafana.candidate.09fe127d1291c7950d45",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You just made your first _PromQL_ query! [PromQL](https://prometheus.io/docs/prometheus/latest/querying/basics/) is a powerful query language that lets you select and aggregate time series data stored in Prometheus.",
      "headingPath": [
        "Introduction",
        "Explore your metrics"
      ],
