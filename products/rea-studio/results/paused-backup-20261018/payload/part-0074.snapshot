    {
      "id": "grafana.candidate.e9987b44423b256b62b0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We recommend you only add `query` permissions for teams that should use the data source and only `Admin` have `Admin` permissions.",
      "headingPath": [
