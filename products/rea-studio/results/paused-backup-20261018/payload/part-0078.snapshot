    {
      "id": "grafana.candidate.1d6d021a2a9c0ab987c8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You cannot create independent, reusable templates for labels and annotations as you can with notification templates. In alert rule templates, you need to write each template inline within the label or annotation field.",
