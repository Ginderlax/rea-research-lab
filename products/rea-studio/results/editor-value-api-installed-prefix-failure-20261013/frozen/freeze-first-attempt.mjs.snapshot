const fixed=path.resolve(here,'../editor-api-installed-focused-final-next');await fs.mkdir(fixed,{recursive:true});let source=(await fs.readFile(path.join(here,'run.mjs'))).toString();const before="(name==='base'?'publication-plan':'documentation-proposal-override')",after="(name==='base'?'publication-plan':'guide-proposal')";assert.equal(source.split(before).length-1,1);source=source.replace(before,after);await fs.writeFile(path.join(fixed,'run.mjs'),source,{flag:'wx'});await fs.writeFile(path.join(fixed,'collector-prefix-adapter.json'),JSON.stringify({schema:'rea-editor-installed-focus-exact-prefix-adapter/v1',failedStage:'work/editor-api-installed-focused-next',failedManifest:id(manifest),failedFiles:Object.keys(inventory).length,collectorBefore:inventory['run.mjs'],collectorAfter:id(Buffer.from(source)),changes:[{before,after,occurrences:1}],sourceAndRuntimeBytesChanged:0,explicitRootAccepted:true},null,2)+'\n',{flag:'wx'});process.stdout.write(JSON.stringify({failedFiles:Object.keys(inventory).length,failedManifest:id(manifest),finalCollector:id(Buffer.from(source))})+'\n');
