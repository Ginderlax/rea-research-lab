      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c62db8bbac089344caa3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use this transformation to pivot the data frame, converting rows into columns and columns into rows. This transformation is particularly useful when you want to switch the orientation of your data to better suit your visualization needs. If you have multiple types, it will default to string type. You can select how empty cells should be represented.",
      "headingPath": [
        "Transform data",
        "Transformation functions",
        "Transpose"
      ],
      "source": {
