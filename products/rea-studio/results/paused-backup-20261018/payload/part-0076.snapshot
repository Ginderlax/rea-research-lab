    {
      "id": "grafana.candidate.fe6f99ea0871ab75bbdb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In addition to the macros listed, the following Grafana [interval variables](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/dashboards/variables/add-template-variables/#__interval) are replaced before query execution:",
