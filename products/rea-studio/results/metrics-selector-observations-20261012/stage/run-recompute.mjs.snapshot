import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import {spawnSync} from 'node:child_process';
const here=path.dirname(fileURLToPath(import.meta.url)),sha=bytes=>createHash('sha256').update(bytes).digest('hex'),source=await fs.readFile(path.join(here,'recompute.mjs')),stem='recompute-attempt-'+Date.now(),startedAt=new Date().toISOString();
const child=spawnSync(process.execPath,[path.join(here,'recompute.mjs')],{cwd:here,windowsHide:true,encoding:'utf8',timeout:120000,maxBuffer:1024*1024});
for(const [suffix,bytes]of [['.source.mjs.snapshot',source],['.stdout.txt',child.stdout??''],['.stderr.txt',child.stderr??'']])await fs.writeFile(path.join(here,stem+suffix),bytes,{flag:'wx'});
const after=await fs.readFile(path.join(here,'recompute.mjs')),receipt={startedAt,finishedAt:new Date().toISOString(),exitCode:child.status,signal:child.signal,error:child.error?.message??null,sourceBeforeSHA256:sha(source),sourceAfterSHA256:sha(after),sourceStable:source.equals(after),stdoutSHA256:sha(child.stdout??''),stderrSHA256:sha(child.stderr??''),scope:'Consolidation/authentication arithmetic only; no reducer/timing/memory workload execution.'};
await fs.writeFile(path.join(here,stem+'.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({attempt:stem,...receipt,stdout:child.stdout,stderr:child.stderr}));if(child.status!==0||!receipt.sourceStable)process.exitCode=1;
