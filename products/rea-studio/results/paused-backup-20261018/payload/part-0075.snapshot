      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c1db2480bbc41c7371cf",
      "syntaxRole": "list-item",
      "sourceText": "- **[Group wait](#group-wait)**: the time to wait before sending the first notification for a new group of alerts.",
      "headingPath": [
        "Group alert notifications",
        "Timing options"
      ],
      "source": {
        "path": "docs/sources/alerting/fundamentals/notifications/group-alert-notifications.md",
