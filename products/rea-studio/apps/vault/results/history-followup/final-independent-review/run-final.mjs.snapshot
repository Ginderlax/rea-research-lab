import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import {spawn} from 'node:child_process';
const own=path.dirname(fileURLToPath(import.meta.url)),stage=path.resolve(own,'../keepass-history-draft-fix-next'),sha=b=>createHash('sha256').update(b).digest('hex'),names=['history.mjs','server.mjs','client.mjs','kdbx.mjs','xml.mjs'];async function fingerprint(){return Promise.all(names.map(async name=>({path:name,sha256:sha(await fs.readFile(path.join(stage,name)))})));}
const before=await fingerprint(),output=path.join(own,'runs/final-independent');await fs.mkdir(output,{recursive:true});const tests=['restore-selection.test.mjs','selection-boundaries.test.mjs','same-editor-draft.test.mjs','preexisting-draft.test.mjs','timer/idle-view.test.mjs'];const child=spawn(process.execPath,['--test','--test-concurrency=1',...tests.map(name=>path.join(own,name))],{cwd:own,windowsHide:true,env:{...process.env,VAULT_REVIEW_STAGE:stage,VAULT_REVIEW_OUTPUT:path.join(own,'observations')},stdio:['ignore','pipe','pipe']});let stdout='',stderr='';child.stdout.on('data',p=>stdout+=p);child.stderr.on('data',p=>stderr+=p);const timer=setTimeout(()=>child.kill(),20000);const exitCode=await new Promise((resolve,reject)=>{child.once('error',reject);child.once('close',resolve);});clearTimeout(timer);await fs.writeFile(path.join(output,'stdout.txt'),stdout);await fs.writeFile(path.join(output,'stderr.txt'),stderr);const after=await fingerprint(),counts=Object.fromEntries(['tests','pass','fail','skipped','cancelled'].map(name=>[name,Number(new RegExp(`(?:ℹ|#) ${name} (\\d+)`).exec(stdout)?.[1]??-1)]));const receipt={schema:'rea-independent-keepass-draft-lifecycle-final-run/v1',createdAt:new Date().toISOString(),exitCode,counts,sourceStable:JSON.stringify(before)===JSON.stringify(after),sourceFingerprints:before,inputs:await Promise.all([...tests,'ui-fixture.mjs','timer/ui-fixture.mjs','run-final.mjs'].map(async name=>({path:name,sha256:sha(await fs.readFile(path.join(own,name)))}))),scope:'Seven initial safety/control bodies, two same-editor pending-draft bodies and dirty-before-restore body unchanged; only two wrong-entry runtime import paths adapted. Timer body unchanged with separate helper capturing the shared-host cleanup return. Actual frozen client/server, owned synthetic DOM/held transport/logical timer fixtures; no HTTP loss or original GUI claim.'};await fs.writeFile(path.join(output,'validation.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify(receipt));if(exitCode||counts.tests!==11||counts.pass!==11||!receipt.sourceStable)process.exitCode=1;
