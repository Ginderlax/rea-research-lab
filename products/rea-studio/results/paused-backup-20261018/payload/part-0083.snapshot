import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {readFileSync,writeFileSync,mkdirSync,copyFileSync} from 'node:fs';
import {join,dirname} from 'node:path';
const workspace='C:/Users/evanh/Documents/Codex/2026-10-12/go',lab=join(workspace,'outputs/rea-research-lab'),app=join(lab,'products/rea-studio/apps/backup');
const stage=join(workspace,'work/backup-compression-next'),review=join(workspace,'work/backup-compression-review');
const destination='products/rea-studio/apps/backup/results/compression-source-study';
const digest=b=>createHash('sha256').update(b).digest('hex');
const stageReceipt=JSON.parse(readFileSync(join(stage,'draft-validation.json'))),reviewReceipt=JSON.parse(readFileSync(join(review,'independent-validation.json')));
assert.equal(digest(readFileSync(join(review,'independent-validation.json'))),'82fa9cf9e2c28c755a2b5b79cf4ce77f48dcbc5e45aea8ba2d9948603647eabe');
assert.equal(digest(readFileSync(join(app,'restic.mjs'))),'70bf4a5bfd46041823fa00bd7cdbf880f6c0a9020f67ef9e7a807b4242fbb527');
const snapshots=[];
function preserve(base,path,group,expected){const bytes=readFileSync(join(base,path));if(expected)assert.equal(digest(bytes),expected,path);const publicPath=destination+'/'+group+'/'+path.replace(/\.(mjs|js|zip)$/i,'.$1.snapshot');mkdirSync(dirname(join(lab,publicPath)),{recursive:true});copyFileSync(join(base,path),join(lab,publicPath));snapshots.push({group,originalPath:path,path:publicPath,bytes:bytes.length,sha256:digest(bytes)});}
for(const entry of stageReceipt.fingerprints)preserve(stage,entry.path,'stage',entry.sha256);
for(const path of ['draft-validation.json','formal-test-output.tap.txt'])preserve(stage,path,'stage');
for(const path of ['independent-validation.json','independent.stdout.txt','independent.stderr.txt','original-observations.json','independent.test.mjs','run-review.mjs','finalize-review.mjs'])preserve(review,path,'review');
