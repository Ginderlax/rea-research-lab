    {
      "id": "grafana.candidate.4c00133d03f88158848e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you configure multiple rules for a team, each rule is evaluated separately. Query results include lines that match any of the rules.",
