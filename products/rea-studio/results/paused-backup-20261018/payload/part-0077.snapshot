    {
      "id": "grafana.candidate.9a51c7e50b3f74457544",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set to `true` if you want to enable external management of plugins. Default is `false`. This is only applicable to Grafana Cloud users.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[plugins]`",
        "`plugin_admin_external_manage_enabled`"
