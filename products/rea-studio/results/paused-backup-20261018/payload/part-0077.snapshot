    {
      "id": "grafana.candidate.ff8fe8f745217ec375af",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To troubleshoot and get more log information, enable SAML debug logging in the configuration file. Refer to [Configuration](/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-grafana/#filters) for more information.",
      "headingPath": [
        "Troubleshooting",
        "Troubleshoot SAML authentication in Grafana"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/troubleshoot-saml/_index.md",
        "gitBlobSha": "b06ceea154d5e4830b95b8a5a8f4b7d9f1d44a2f",
        "sha256": "799d46671255ea5bf81504ed3152d1a9e163e69ee079e7a81728df8b374381b8",
        "lineStart": 21,
        "lineEnd": 21,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/saml/troubleshoot-saml/_index.md#L21-L21"
      },
