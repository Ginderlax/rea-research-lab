    {
      "id": "grafana.candidate.27a0a9b4e44f210d0fbc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In bar charts, you can apply filters directly from the visualization. Filters are available when the x-axis field is filterable and the data source supports dashboard drilldown filters, such as Prometheus or Loki.",
      "headingPath": [
        "Bar chart",
        "Apply filters from the bar chart"
      ],
