import fs from 'node:fs/promises';
import path from 'node:path';
import assert from 'node:assert/strict';
import {spawnSync} from 'node:child_process';
import {here,sha,authenticateOriginal} from './authenticate-original.mjs';
const [mode,quietFrom,variant='standard']=process.argv.slice(2);assert.ok(['--check-only','--quiet-confirmed'].includes(mode));assert.ok(['standard','percentile'].includes(variant),'Unexpected candidate manifest.');
const manifestName='memory-preflight.'+variant+'.json',manifestBytes=await fs.readFile(path.join(here,manifestName)),manifest=JSON.parse(manifestBytes);
if(mode==='--quiet-confirmed')assert.ok(/^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{3})?Z$/.test(quietFrom)&&Date.parse(quietFrom)>Date.parse(manifest.checkedAt)&&Date.parse(quietFrom)<=Date.now(),'New coordinator quiet timestamp must follow this preflight.');
const candidate=path.basename(manifest.implementations.candidate.entry),boundNames=['timing-runner.mjs','benchmark.mjs','benchmark-worker.mjs','candidate-baseline.mjs',candidate,'authenticate-original.mjs'],before={};for(const name of boundNames)before[name]=sha(await fs.readFile(path.join(here,name)));
assert.equal(before['benchmark.mjs'],'21614846781e3bf309adbf9a429d741180d80e53675c2a8e29272c7e4bce72eb');assert.equal(before['benchmark-worker.mjs'],'96083400915fb452fb93ed23032d215c00f229f8456938d83fc69c9648954ffe');
const checks=JSON.parse(await fs.readFile(path.join(here,'results/memory-harness-checks.'+variant+'.json')));assert.equal(checks.status,'passed');assert.equal(checks.measurementRun,false);assert.equal(checks.manifestSHA256,sha(manifestBytes));assert.equal(checks.samples.length,3);for(const sample of checks.samples){assert.equal(sample.result.comparisons,5);assert.equal(sample.result.loadedReducerImplementations,1);assert.equal(sample.result.measurementRun,false);}
const fullBytes=await fs.readFile(path.join(here,manifest.fullSemanticReceipt)),full=JSON.parse(fullBytes);assert.equal(sha(fullBytes),manifest.fullSemanticReceiptSHA256);assert.equal(full.status,'passed');assert.equal(full.implementationSha256,before[candidate]);assert.equal(full.comparisons,2910751);assert.equal(full.standardHelperComparisons,14240);assert.equal(full.cacheComparisons,48240);
assert.equal(before[candidate],Object.values(manifest.implementations.candidate.files)[0]);assert.equal(before['candidate-baseline.mjs'],Object.values(manifest.implementations.baseline.files)[0]);const authority=await authenticateOriginal();assert.deepEqual(authority.files,manifest.authority.files);assert.equal(authority.archiveSHA256,manifest.authority.archiveSHA256);
let stdout='',stderr='',outcome={status:0},timingOutput,startedAt=new Date().toISOString();
if(mode==='--quiet-confirmed'){outcome=spawnSync(process.execPath,[path.join(here,'benchmark.mjs'),'--quiet-confirmed',candidate,quietFrom],{encoding:'utf8',timeout:300000,maxBuffer:4*1024*1024,windowsHide:true});stdout=outcome.stdout??'';stderr=outcome.stderr??'';if(outcome.status===0){const result=JSON.parse(stdout);timingOutput={path:result.output,sha256:sha(await fs.readFile(result.output))};}}
const after={};for(const name of boundNames)after[name]=sha(await fs.readFile(path.join(here,name)));assert.deepEqual(after,before);assert.equal(sha(await fs.readFile(path.join(here,manifestName))),sha(manifestBytes));for(const [name,hash]of Object.entries(authority.files))assert.equal(sha(await fs.readFile(name)),hash);
const stem='timing-'+(mode==='--check-only'?'readiness':'attempt')+'-'+variant+'-'+Date.now();await fs.writeFile(path.join(here,'results',stem+'.stdout.txt'),stdout);await fs.writeFile(path.join(here,'results',stem+'.stderr.txt'),stderr);const receipt={schemaVersion:1,checkedAt:new Date().toISOString(),interval:{start:startedAt,end:new Date().toISOString()},mode,variant,status:outcome.status===0?'passed':'failed',exitCode:outcome.status,signal:outcome.signal,error:outcome.error?.message,sourceHashesBefore:before,sourceHashesAfter:after,manifestSHA256:sha(manifestBytes),originalAuthority:authority,timingOutput,stdoutSHA256:sha(stdout),stderrSHA256:sha(stderr),quietFrom:mode==='--quiet-confirmed'?quietFrom:undefined,timingMeasurementRun:mode==='--quiet-confirmed',loadedAllThreeForTimingCorrectnessChecks:mode==='--quiet-confirmed',isolatedMemoryEstablished:false,fullProductComplete:false,universalSuperiorityEstablished:false};const filename=mode==='--check-only'?'timing-readiness.'+variant+'.json':stem+'.json';await fs.writeFile(path.join(here,'results',filename),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({receipt:filename,status:receipt.status,timingMeasurementRun:receipt.timingMeasurementRun,variant}));if(outcome.status!==0)process.exitCode=1;
