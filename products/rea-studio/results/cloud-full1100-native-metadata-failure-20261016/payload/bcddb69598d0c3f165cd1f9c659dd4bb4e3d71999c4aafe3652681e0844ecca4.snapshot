import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import {spawnSync} from 'node:child_process';
import {createHash} from 'node:crypto';
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab');
const run=process.argv[2],reader=process.argv[4]??'none';let expectedJob=process.argv[3];
assert(['38824829652','38824829904','38824829929','38824835014','38824834990','38824834967','38824835008','38824834964','38824834985','38826463509','38826463567','38826470332','38826470331','38826463539','38826470337','38826470338','38826470348','38826470376','38828050485','38828050456','38828050454','38828050473','38828050461','38828050460','38828044782','38903252563','38903745255','38903745166','38903745664','38903745245','38903745096','38903745075','38903738181','38903258061','38903258223','38903258144','38903258032','38903258022','38903258107','38905581634','38905581957','38905581818','38905581840','38905581709','38905573339','38907053651','38907054140','38907053817','38907053566','38907053655','38907042178','38907306502','38907306675','38907306490','38907306445','38907306659','38908773029','38908773120','38908773135','38908772822','38908772777','38911251888','38911252546','38911251837','38911252713','38911251916','38911241479','38915607121','38915607183','38915607071','38915606895','38915606957','38916254254','38916254271','38916254287','38916254393','38916254220','38917432854','38917433182','38917432972','38917432800','38917433080','38917424068','38920820160','38920820376','38920820364','38920820155','38920820245','38920807206','38922041634','38922041440','38922041468','38922041638','38922041424','38923831870','38923831964','38923831950','38923831898','38923831833','38924848539','38924848528','38924848449','38924848462','38924848444','38926225441','38926225413','38926225516','38926225528','38926225406','38930461083','38930461121','38930461098','38930461270','38930461085','38932318654','38932318510','38932318768','38932318570','38932318682'].includes(run));assert(expectedJob==='auto'||/^\d+$/.test(expectedJob));assert(['audit','full','publication','browser','archive-browser','none'].includes(reader));
const hash=b=>createHash('sha256').update(b).digest('hex');
async function exists(p){try{await fs.access(p);return true;}catch(e){if(e.code==='ENOENT')return false;throw e;}}
const credential=spawnSync('git',['credential','fill'],{cwd:lab,env:{...process.env,GIT_TERMINAL_PROMPT:'0',GCM_INTERACTIVE:'Never'},input:'protocol=https\nhost=github.com\n\n',encoding:'utf8',windowsHide:true,timeout:20000});assert.equal(credential.status,0,'Saved authentication unavailable');const fields=Object.fromEntries(credential.stdout.split('\n').filter(x=>x.includes('=')).map(x=>{const i=x.indexOf('=');return[x.slice(0,i),x.slice(i+1)];}));assert(fields.password);
const headers={Accept:'application/vnd.github+json','User-Agent':'REA-cloud-verification','X-GitHub-Api-Version':'2022-11-28',Authorization:'Bearer '+fields.password};
const folder=path.join(work,'cloud-verification-backups','run-'+run);let control=path.join(folder,'control-plane-evidence');
if(await exists(path.join(control,'run.json'))){const prior=JSON.parse(await fs.readFile(path.join(control,'run.json'),'utf8'));if(prior.status!=='completed')control=path.join(folder,'control-plane-evidence-observation-'+new Date().toISOString().replace(/[:.]/g,'-'));}
await fs.mkdir(control,{recursive:true});
const records=await Promise.all(['run','jobs','artifacts'].map(async kind=>{const target=path.join(control,kind+'.json');let bytes;if(await exists(target))bytes=await fs.readFile(target);else{const endpoint='https://api.github.com/repos/Ginderlax/rea-research-lab/actions/runs/'+run+(kind==='run'?'':'/'+kind);const response=await fetch(endpoint,{headers,signal:AbortSignal.timeout(60000)});assert.equal(response.status,200);bytes=Buffer.from(await response.arrayBuffer());assert(bytes.length<=512*1024);JSON.parse(bytes);await fs.writeFile(target,bytes,{flag:'wx'});}return{kind,path:target,bytes:bytes.length,sha256:hash(bytes),value:JSON.parse(bytes)};}));
const [actual,jobs,artifacts]=records.map(x=>x.value);assert.equal(String(actual.id),run);assert.equal(actual.head_branch,'codex/rea-cloud-recovery-20261015');if(["38932318654","38932318510","38932318768","38932318570","38932318682"].includes(run))assert.equal(actual.head_sha,'d24db80660e2af640882ad48c01174b27ffcda51');if(["38930461083","38930461121","38930461098","38930461270","38930461085"].includes(run))assert.equal(actual.head_sha,'89e00f66c2249a50c701404accede7565094304e');if(["38926225441","38926225413","38926225516","38926225528","38926225406"].includes(run))assert.equal(actual.head_sha,'b635c33d971768682360e2c518b9b2bb0840985b');if(["38924848539","38924848528","38924848449","38924848462","38924848444"].includes(run))assert.equal(actual.head_sha,'a1fa90ca8b1b84282a8ce13a1278bea3b43e2928');if(["38923831870","38923831964","38923831950","38923831898","38923831833"].includes(run))assert.equal(actual.head_sha,'d8c80d1d2380409d50f006556a697d0e12e4d14d');if(["38922041634","38922041440","38922041468","38922041638","38922041424"].includes(run))assert.equal(actual.head_sha,'25b54d733ad6fd59a0b0d2a28fad3d6fa014700a');if(["38920820160","38920820376","38920820364","38920820155","38920820245","38920807206"].includes(run))assert.equal(actual.head_sha,'c15dd78e05da771449550ac6e657fb77c08e787d');if(["38917432854","38917433182","38917432972","38917432800","38917433080","38917424068"].includes(run))assert.equal(actual.head_sha,'362bda055ac4cf7201b2d6a75a2b30dc6fedb578');if(["38916254254","38916254271","38916254287","38916254393","38916254220"].includes(run))assert.equal(actual.head_sha,'cc7a5830b1c4e719b1f3ceb5b3aa1abe52c3cae3');if(["38915607121","38915607183","38915607071","38915606895","38915606957"].includes(run))assert.equal(actual.head_sha,'d25e9c339aaf6d62f1a7841eef208bb488bfdd78');if(["38911251888","38911252546","38911251837","38911252713","38911251916","38911241479"].includes(run))assert.equal(actual.head_sha,'016ecd175c0700d1a94d5219af6719989a4a6e45');if(expectedJob==='auto'){assert.equal(jobs.jobs.length,1);expectedJob=String(jobs.jobs[0].id);}const job=jobs.jobs.find(j=>String(j.id)===expectedJob);assert(job);assert(job.labels.includes('windows-2022'));assert.equal(job.runner_group_name,'GitHub Actions');
const summary={schema:'rea-readonly-completed-run-collection/v1',collectedAt:new Date().toISOString(),runId:run,jobId:expectedJob,headSHA:actual.head_sha,runStatus:actual.status,runConclusion:actual.conclusion,jobConclusion:job.conclusion,metadata:records.map(({value,...r})=>r),artifacts:[],localProductExecutions:0,localTests:0,localBuilds:0};
if(actual.status!=='completed'){console.log(JSON.stringify({...summary,collectionState:'Nonterminal snapshot; no artifact completion claimed.'}));}else{
function helper(...args){const result=spawnSync(process.execPath,[path.join(work,'rea-cloud-github.mjs'),...args],{encoding:'utf8',windowsHide:true,timeout:180000,maxBuffer:3*1024*1024});assert.equal(result.status,0,result.stderr);return JSON.parse(result.stdout);}
const log=path.join(work,'cloud-verification-backups','job-'+expectedJob,'logs.txt');if(!await exists(log))helper('logs',expectedJob);const logBytes=await fs.readFile(log);summary.rawJobLog={path:log,bytes:logBytes.length,sha256:hash(logBytes)};
for(const artifact of artifacts.artifacts){const digest=artifact.digest?.replace(/^sha256:/,'');assert(/^[0-9a-f]{64}$/.test(digest));assert.equal(artifact.expired,false);const zip=path.join(folder,'artifact-'+artifact.id+'.zip');if(!await exists(zip))helper('download',String(artifact.id),run);const raw=await fs.readFile(zip);assert.equal(raw.length,artifact.size_in_bytes);assert.equal(hash(raw),digest);
 const verificationFile=path.join(folder,'artifact-'+artifact.id,reader==='archive-browser'?'local-archive-browser-backup-verification.json':reader==='browser'?'local-browser-backup-verification.json':'local-backup-verification.json');
 if(reader!=='none'&&!await exists(verificationFile)){const selected=reader==='publication'?(['38920820160','38922041634','38923831870','38924848539','38926225441','38930461083','38932318654'].includes(run)?'unpack-publication-notes208-string-corrected-attempt.py':run==='38917432854'?'unpack-publication-notes208-attempt.py':'unpack-publication-attempt.py'):reader==='archive-browser'?'unpack-archive-browser-cloud-attempt.py':reader==='browser'?'unpack-browser-cloud-attempt.py':'unpack-cloud-attempt.py';const args=reader==='audit'?[path.join(work,'unpack-proof-delivery-audit.py'),zip,digest,run,actual.head_sha]:[path.join(work,selected),zip,digest];const result=spawnSync('C:/Users/evanh/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/python.exe',args,{encoding:'utf8',windowsHide:true,timeout:120000,maxBuffer:4*1024*1024});assert.equal(result.status,0,result.stderr);}
 const row={artifactId:artifact.id,bytes:raw.length,sha256:digest,path:zip,readabilityVerified:reader!=='none'};if(reader!=='none'){const v=JSON.parse(await fs.readFile(verificationFile,'utf8'));assert.equal(v.allCRCAndBytesReadable,true);row.localBackupVerification=verificationFile;row.readableFileCount=v.files.length;row.audit=v.audit;row.attempts=v.attempts;row.attempt=v.attempt;row.controls=v.controls;}summary.artifacts.push(row);
}
const summaryFile=path.join(folder,reader==='none'?'collection-download-summary.json':'collection-summary.json');if(!await exists(summaryFile))await fs.writeFile(summaryFile,JSON.stringify(summary,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(summary));

}
