import fs from 'node:fs/promises';
import path from 'node:path';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const root=import.meta.dirname, sha=bytes=>createHash('sha256').update(bytes).digest('hex');
const fp=async file=>{const bytes=await fs.readFile(file);return{bytes:bytes.length,sha256:sha(bytes)};};
const load=async name=>JSON.parse(await fs.readFile(path.join(root,name)));
const held=await load('held-review-validation.json'),provenance=await load('provenance-validation.corrected.json'),original=await load('fresh-original-validation.json');
const bindings=[];
for(const [name,expected,count] of [['editor-search-next','44e8efd72f09c7cc5caa598f43dbe099dd73982477249ecfed2fddfb2a26a7a6',140],['editor-search-fix-next','b858a4cf15312f962bf0ac5ba2fd6b6c17466248ff1394c727a49ee0e665e9ef',124],['vscode-original-acquisition-record','b592b223568ddc0736f9b6a9509b6eecbf9832b14e361cf31dcbf71878a636ec',14]]){
  const folder=path.resolve(root,'../'+name),bytes=await fs.readFile(path.join(folder,'freeze-manifest.json'));assert.equal(sha(bytes),expected);const manifest=JSON.parse(bytes);assert.equal(Object.keys(manifest.inventory).length,count);
  const rows=Array.isArray(manifest.inventory)?manifest.inventory.map(({path,...row})=>[path,row]):Object.entries(manifest.inventory);
  for(const [name,row] of rows)assert.deepEqual(await fp(path.join(folder,name)),row);
  bindings.push({stage:name,files:count,manifestSHA256:expected,authenticatedAfter:true});
}
for(const row of [...provenance.snapshots,...held.fixedSnapshots])assert.deepEqual(await fp(path.join(root,row.path)),{bytes:row.bytes,sha256:row.sha256});
for(const row of held.results){assert.deepEqual(await fp(path.join(root,row.name)),row.source);for(const kind of ['stdout','stderr'])assert.deepEqual(await fp(path.join(root,row[kind].path)),{bytes:row[kind].bytes,sha256:row[kind].sha256});}
const longPath='runs/long-path-1791851686930-0/observation.json',long=await load(longPath);assert.equal(long.pathLength,1096);assert.equal(long.read.accepted,false);
const actions=[];for(const name of (await fs.readdir(root)).filter(name=>/^action-.*\.json$/.test(name)).sort()){const record=await load(name);actions.push({path:name,...await fp(path.join(root,name)),record});}
const receipt={schema:'rea-independent-editor-search-review/v1',checkedAt:new Date().toISOString(),status:'completed with two concrete candidate defects and retained collector failures',acceptance:false,productionChanged:false,bindings,exactInertSnapshots:281,
  sourceBoundTests:held.results.map(({name,source,stdout,stderr,counts,exitCode,signal,start,end})=>({name,source,stdout,stderr,counts,exitCode,signal,start,end})),
  freshTestCounts:{tests:14,pass:11,fail:3,cancelled:0,skipped:0},exploratoryOldReplay:{tests:5,pass:3,fail:2,includedInFreshCounts:false},
  findings:[{priority:'P1',epoch:'old140 only; resolved by fixed124 in five-case exact replay',title:'Search-result read publishes a stale file after the query or options change',test:'held-search.test.mjs',oldCounts:{pass:3,fail:2},fixedExactReplay:'held-fixed.test.mjs',fixedCounts:{pass:5,fail:0},source:'editor-search-next/products/rea-studio/apps/editor/client.mjs:90-108',limits:'Finite element model using actual client module and real read/search handlers; actual browser false.'},{priority:'P2',epoch:'fixed124',title:'Search emits a 1096-unit path that Editor read refuses at its 1024-unit boundary',test:'fresh-core.test.mjs:5',observation:{path:longPath,...await fp(path.join(root,longPath))},pathLength:1096,searchMatches:1,searchTruncated:false,readError:long.read.error,source:'editor-search-fix-next/products/rea-studio/apps/editor/server.mjs:16-18',sharedWorkspaceSource:'editor-search-fix-next/products/rea-studio/lib/storage.mjs:18',pendingSeparateCorrection:'editor-search-path-fix-next; not exercised or accepted by this receipt'}],
  controls:['Later explicit file selection supersedes held read','Later new draft supersedes held read and creates no disk file','Disposal supersedes held read','BOM/astral UTF-16 positions and original saved-byte revision','Exact 32768-byte query accepted, overflow and null mode refused','10001 ignored entries stop traversal without text reads'],
  provenance:{receipt:{path:'provenance-validation.corrected.json',...await fp(path.join(root,'provenance-validation.corrected.json'))},originalReceiptSHA256:'6e93be73c9fdc10d011272fbbd6a2c5219c01efda0ff614e201b59f821bf028d',extractedFilesAuthenticatedNow:3246,extractedBytes:1044655528,freshExtractedTreePasses:1,freshBeforeAfterAllExtractedFiles:false,historicalBeforeAfterLedgersBound:true,archive:provenance.archive,archiveSHA1:provenance.archiveSHA1NowAuthenticated,engine:provenance.engine,historicalSignatureBound:true,freshOSSignatureCheck:false,archiveOrBinaryCopied:false},
  freshBundledEngineAttempt:{receipt:{path:'fresh-original-validation.json',...await fp(path.join(root,'fresh-original-validation.json'))},groupsPrepared:12,groupsCompleted:original.completedGroups,positionsVerified:original.observedPositions,actualInvocations:original.actualBoundedOriginalEngineInvocations,status:original.status,failure:original.failure,interpretation:'Own offset mapper decoded original raw file prefixes although bundled ripgrep strips the leading BOM before reporting byte offsets. This is a retained collector failure, not a candidate semantic mismatch or passed oracle comparison.'},
  retainedFailures:{authenticationPreparation:'First source capture used an incorrect Code.exe archive prefix; exact failed action source/logs retained before successful correction.',metadataPreparation:'Authenticated relative engine ledger path overwrote intended absolute metadata path; exact successful first receipt and failed zero-child preparation retained. Corrected receipt appended.',freshBundledMapper:'Version and first query children completed; mapper failed before any complete fresh group.',finalizationPreparation:'Own finalizer initially assumed the acquisition inventory used an object rather than its actual array. It failed twice before writing a receipt; one exact captured replay/source/log is retained and the preceding direct invocation is disclosed in finalization-preparation-note.json. Corrected finalizer accepts both manifest shapes.',intentionalCandidateFailures:'Two old140 generation cases and fixed124 long-path navigation case retained as failures.'},
  actions,rawObservationsRetained:true,newTimingMemoryOrProfilerRuns:0,actualBrowserExecution:false,originalWorkbenchOrGUIExecutions:0,universalCompatibility:false,fullProductParity:false,sourceStable:true,
  publicationBoundary:'This private complete review includes 10001 synthetic empty ignored-entry files and their exact path inventory. Native executable and original ZIP remain local only with identities; no binaries or archives were copied. A later source-only public subset must declare any synthetic fixture exclusions without changing this frozen record.'};
await fs.writeFile(path.join(root,'review-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
await fs.writeFile(path.join(root,'README.md'),`# Independent Editor saved-file search review\n\nCompleted with finite findings; acceptance remains false. No production files changed.\n\nThe source-bound old140 replay has 3 passes and 2 failures. The exact same five test bodies, with only import paths changed, pass on fixed124. Four new core cases have 3 passes and one failure: a saved 1,096 UTF-16-unit path is returned by search but rejected by the Editor read contract at 1,024 units. Its observation is \`${longPath}\`. The later path-fix126 stage is a separate epoch and is not accepted by this record. These are actual client/server modules in a finite element model, not browser or complete workbench tests.\n\nAll 140 and 124 frozen files and the 14-file acquired VS Code provenance were authenticated; 281 exact inert snapshots are retained. The acquired original ZIP SHA-256 and publisher SHA-1, all 3,246 extracted files in one fresh pass, the exact historical before/after ledgers, released bundled ripgrep bytes and historical publisher signature observation are bound. This is acquisition and engine provenance, not full Editor/workbench parity. The OS signature was not freshly revalidated and all extracted files were not independently rehashed twice.\n\nThe optional new bundled-engine collector invoked version plus the first query, then its own leading-BOM offset mapper failed. Zero completed fresh query groups are claimed. Both preparation mistakes and their exact failed source/logs, successful corrected provenance metadata, the mapper failure, and the intentional candidate failures remain retained. There were no measurements or profiler runs.\n\nThe strict whole-stage manifest includes private synthetic entry-budget fixtures, including 10,001 empty files. Originals remain local; no original executable or ZIP was copied. Any later public subset must bind exclusions explicitly.\n`,{flag:'wx'});
console.log(JSON.stringify({receipt:await fp(path.join(root,'review-validation.json')),bindings,counts:receipt.freshTestCounts}));
