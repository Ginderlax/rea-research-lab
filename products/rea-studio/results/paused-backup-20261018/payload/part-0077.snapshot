    {
      "id": "grafana.candidate.3b863b62ae8a9a1ba175",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To limit access to authenticated users that are members of one or more groups, set `allowed_groups` to a comma or space separated list of groups.",
      "headingPath": [
