        ],
        "restriction": "Alerting on forecasts > Seasonal forecast with Grafana Cloud Machine Learning > Alert when the actual state is outside the forecast > Alert only on unexpectedly high values"
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
