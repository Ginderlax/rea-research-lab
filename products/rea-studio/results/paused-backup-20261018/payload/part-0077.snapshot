        "lineStart": 87,
        "lineEnd": 87,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/configure-custom-branding/index.md#L87-L87"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.142d2c4ebf2f025ed725",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The `grafana.ini` file includes Grafana Enterprise custom branding. As with all configuration options, you can use environment variables to set custom branding.",
      "headingPath": [
        "Configure custom branding"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/configure-custom-branding/index.md",
        "gitBlobSha": "626068ce514684ffda01cbb550ec0d7bfca40775",
