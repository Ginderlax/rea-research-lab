 for key,value in details.items(): need(envelope[key]==value and declared[key]==value,'Exact envelope detail '+key)
 rows={};logical_folded=set();physical_folded=set();total=0;output=folder/(filename.split('.')[0]+'-readable');output.mkdir(exist_ok=False)
 for row in envelope['rows']:
  required={'path','bytes','sha256','base64'}|({'readPath','group','sourceEpoch','historicalView'} if groups else set());need(set(row)==required,'Exact source row fields')
  name=safe(row['path']);need(name in expected_sources and name.casefold() not in logical_folded,'Exact distinct logical source');logical_folded.add(name.casefold())
  expected_pin=expected_sources[name];expected_pin={'bytes':expected_pin[0],'sha256':expected_pin[1]} if isinstance(expected_pin,list) else expected_pin
  need(type(row['bytes']) is int and 0<=row['bytes']<=256*1024 and re.fullmatch(r'[0-9a-f]{64}',row['sha256']) and {k:row[k] for k in ('bytes','sha256')}==expected_pin,'Fixed source byte/SHA256 pin')
  need(isinstance(row['base64'],str) and len(row['base64'])<=4*((256*1024+2)//3),'Bounded base64')
  content=base64.b64decode(row['base64'],validate=True);need(base64.b64encode(content).decode()==row['base64'] and identity(content)==expected_pin,'Canonical base64 and exact decoded identity')
  read_path=name
