    },
    {
      "id": "grafana.candidate.e21e7e425e882529c856",
      "syntaxRole": "list-item",
      "sourceText": "- You don't pass a keeper name. Grafana stores the value in whichever keeper is the active keeper for your namespace, which is the system keeper by default.",
      "headingPath": [
        "Use Terraform to provision secure values",
        "Define a secure value"
      ],
      "source": {
        "path": "docs/sources/as-code/infrastructure-as-code/terraform/terraform-secrets-management.md",
