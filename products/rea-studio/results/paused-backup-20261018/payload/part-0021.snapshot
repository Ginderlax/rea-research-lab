    assert pin(read('products/rea-studio/experiments/notes-todo/' + row['after']['sourcePath'])) == after
    transitions.append({'path': row['target'], 'before': before, 'after': after,
        'beforeImage': None if before is None else 'products/rea-studio/experiments/notes-todo/' + row['before']['sourcePath'],
        'afterImage': 'products/rea-studio/experiments/notes-todo/' + row['after']['sourcePath']})
assert len(transitions) == 8 and sum(row['before'] is not None for row in transitions) == 3
requirements = {}
