import fs from 'node:fs/promises';
import {createHash} from 'node:crypto';
import {execFile} from 'node:child_process';
import {promisify} from 'node:util';
import {fileURLToPath} from 'node:url';
const execute=promisify(execFile),root=fileURLToPath(new URL('.',import.meta.url)),digest=bytes=>createHash('sha256').update(bytes).digest('hex'),sources=['dav-xml.mjs','webdav.mjs','dav-transfer.mjs','dav-comparison.mjs','dav-input.mjs','dav-actions.mjs','native-filters.mjs','fixture-server.mjs','client-webdav-snippet.mjs','webdav.test.mjs','http.test.mjs','oracle-basic.mjs','oracle-transfer.mjs','resource-probes.mjs','validate.mjs','README.md'];
const fingerprints=async()=>Object.fromEntries(await Promise.all(sources.map(async file=>[file,digest(await fs.readFile(new URL(file,import.meta.url)))]))),before=await fingerprints(),checkedAt=new Date().toISOString(),steps=[];
for(const args of [['--test','--test-reporter=tap','webdav.test.mjs','http.test.mjs'],['oracle-basic.mjs'],['oracle-transfer.mjs'],['resource-probes.mjs']]) {const started=Date.now(),result=await execute(process.execPath,args,{cwd:root,windowsHide:true,timeout:120000,maxBuffer:4*1024*1024});steps.push({args,milliseconds:Date.now()-started,exitCode:0,stdoutSHA256:digest(Buffer.from(result.stdout)),stderrSHA256:digest(Buffer.from(result.stderr)),...(args[0]==='--test'?{tests:Number(/^# tests (\d+)$/m.exec(result.stdout)?.[1]),passed:Number(/^# pass (\d+)$/m.exec(result.stdout)?.[1]),failed:Number(/^# fail (\d+)$/m.exec(result.stdout)?.[1]),skipped:Number(/^# skipped (\d+)$/m.exec(result.stdout)?.[1])}:{})});await fs.writeFile(new URL('validation-progress.json',import.meta.url),JSON.stringify({checkedAt,steps},null,2)+'\n');console.log(JSON.stringify(steps.at(-1)));}
const after=await fingerprints();if(JSON.stringify(before)!==JSON.stringify(after))throw Error('Draft source changed during validation.');const receipts={};for(const file of ['primitive-oracle-receipt.json','transfer-oracle-receipt.json','resource-receipt.json','webdav-source-references.json']){const bytes=await fs.readFile(new URL(file,import.meta.url));receipts[file]={sha256:digest(bytes),bytes:bytes.length};const value=JSON.parse(bytes);if(value.sourceSHA256)for(const [source,sha256]of Object.entries(value.sourceSHA256))if(after[source]!==sha256)throw Error('Receipt source drift '+source);}
const focused=steps[0];if(focused.failed!==0 || focused.skipped!==0 || focused.tests!==focused.passed)throw Error('Focused verification incomplete.');
const value={schemaVersion:1,checkedAt,completedAt:new Date().toISOString(),scope:'Isolated work/sync-webdav-next draft only; frozen apps/sync and shared files unchanged. Generic one-direction WebDAV subset; browser rendering pending root ownership.',sources:after,focusedTests:{tests:focused.tests,passed:focused.passed,failed:focused.failed,skipped:focused.skipped},oracle:{primitiveScenarios:4,comparisonProfiles:128,comparisonDecisions:1408,heldOutFilteredTransferFolders:8,authenticatedOriginalExecutions:274},receipts,steps,performanceBoundary:'Native-only resource observations include same-process fixture server; no original-vs-native speed/RSS superiority comparison.',allDocumentedFeaturesEnumerated:false,fullProductComplete:false,universalSuperiorityEstablished:false};await fs.writeFile(new URL('native-webdav-validation.json',import.meta.url),JSON.stringify(value,null,2)+'\n');console.log(JSON.stringify({receipt:'native-webdav-validation.json',sha256:digest(Buffer.from(JSON.stringify(value,null,2)+'\n')),focusedTests:value.focusedTests,oracle:value.oracle}));
