import assert from 'node:assert/strict';import {readFileSync,writeFileSync,mkdirSync} from 'node:fs';import {resolve} from 'node:path';import {createHash} from 'node:crypto';import {authenticate} from './auth.mjs';
const here=import.meta.dirname,work=resolve(here,'..'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),before=authenticate();writeFileSync(resolve(here,'authority-before.json'),JSON.stringify(before,null,2)+'\n',{flag:'wx'});mkdirSync(resolve(here,'authority'),{recursive:true});for(const r of before)writeFileSync(resolve(here,'authority',r.name+'-'+r.file+'.snapshot'),readFileSync(resolve(work,r.folder,r.file)),{flag:'wx'});
const source=resolve(work,'vault-group-edit-independent-review'),changes=[];for(const name of ['draft-boundaries.test.mjs','adjacent.test.mjs']){const b=readFileSync(resolve(source,name));writeFileSync(resolve(here,name),b,{flag:'wx'});changes.push({path:name,before:id(b),after:id(b),substitutions:0,caseBodiesByteIdentical:true});}
let fixture=readFileSync(resolve(source,'ui-fixture.mjs'),'utf8');const oldFixture=Buffer.from(fixture);for(const name of ['client.mjs','server.mjs','kdbx.mjs','group-fixture.mjs']){const old="'../vault-group-edit-next/products/rea-studio/apps/vault/"+name+"'",after="'../vault-group-edit-late-draft-fix-next/products/rea-studio/apps/vault/"+name+"'";assert.equal(fixture.split(old).length-1,1);fixture=fixture.replace(old,after);changes.push({path:'ui-fixture.mjs',before:old,after,occurrences:1,scope:'Runtime source-path-only adapter'});}writeFileSync(resolve(here,'ui-fixture.mjs'),fixture,{flag:'wx'});writeFileSync(resolve(here,'fixture-before.mjs.snapshot'),oldFixture,{flag:'wx'});
const corrected=resolve(work,'vault-group-edit-late-draft-fix-next'),deltas=JSON.parse(readFileSync(resolve(corrected,'client-deltas.json')));let client=readFileSync(resolve(corrected,'products/rea-studio/apps/vault/client.mjs'),'utf8');assert.equal(id(Buffer.from(client)).sha256,'29f99c9132286e93ffdcc26105daa9d4209591b4aedad438cc6830841f227908');for(const r of deltas.deltas.slice().reverse()){assert.equal(client.split(r.after).length-1,1);client=client.replace(r.after,r.before);}assert.deepEqual(Buffer.from(client),readFileSync(resolve(work,'vault-group-edit-next/products/rea-studio/apps/vault/client.mjs')));
writeFileSync(resolve(here,'adapter.json'),JSON.stringify({schema:'rea-vault-correction-independent-import-only-adapter/v1',initialCaseBodies11Unchanged:true,fixtureBefore:id(oldFixture),fixtureAfter:id(Buffer.from(fixture)),changes,sourceCorrectionFourSubstitutionsInverseExact:true},null,2)+'\n',{flag:'wx'});for(const name of ['client.mjs','server.mjs','recycle.mjs','history.mjs','kdbx.mjs','xml.mjs','group-fixture.mjs']){mkdirSync(resolve(here,'candidate-source'),{recursive:true});writeFileSync(resolve(here,'candidate-source',name+'.snapshot'),readFileSync(resolve(corrected,'products/rea-studio/apps/vault',name)),{flag:'wx'});}console.log(JSON.stringify({authenticated:before.map(r=>({name:r.name,payloads:r.payloads})),initialBodies11Identical:true,fixturePathSubstitutions:4,inverseExact:true,newOriginalCalls:0}));
