// Work-only source/publication proposal. Imports no app/original/parser implementation.
import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash}from'node:crypto';
const root=import.meta.dirname,workspace=path.resolve(root,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),prefix='products/rea-studio/apps/editor/results/position-range-selection-followup/';
const names={'.local':'private-study-records',work:'workspace-records',node_modules:'dependency-source',artifacts:'source-material',tooling:'verification-tool-source'},identity=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});
const seen=new Map();let readBytes=0;
function safe(p,pub=false){assert.ok(typeof p==='string'&&p.length&&p.length<=4096&&!/[\\:\x00-\x1f\x7f]/.test(p)&&!p.startsWith('/'));for(const s of p.split('/')){assert.ok(s&&s!=='.'&&s!=='..');if(pub)assert.ok(!Object.hasOwn(names,s));}return p;}
async function read(base,p,e){safe(p);let current=await fs.realpath(base);const actualBase=current;for(const s of p.split('/')){current=path.join(current,s);assert.equal((await fs.lstat(current)).isSymbolicLink(),false);}const relative=path.relative(actualBase,await fs.realpath(current));assert.ok(relative&&!relative.startsWith('..')&&!path.isAbsolute(relative));const stat=await fs.stat(current);assert.ok(stat.isFile()&&stat.size<=32*1024*1024);const b=await fs.readFile(current),id=identity(b);assert.equal(b.length,stat.size);if(e)assert.deepEqual(id,{bytes:e.bytes,sha256:e.sha256});seen.set(current,id);readBytes+=b.length;assert.ok(readBytes<=512*1024*1024);return b;}
async function save(p,b){safe(p);const d=path.join(root,p);await fs.mkdir(path.dirname(d),{recursive:true});await fs.writeFile(d,Buffer.isBuffer(b)||typeof b==='string'?b:JSON.stringify(b,null,2)+'\n',{flag:'wx'});}
async function walk(base,p='',depth=0){assert.ok(depth<=40);const out=[];for(const e of await fs.readdir(path.join(base,p),{withFileTypes:true})){const n=p+e.name;safe(n);assert.equal(e.isSymbolicLink(),false);if(e.isDirectory())out.push(...await walk(base,n+'/',depth+1));else{assert.ok(e.isFile());out.push(n);}assert.ok(out.length<=1500);}return out;}
function rows(j){return Array.isArray(j.inventory)?j.inventory:Array.isArray(j.records)?j.records:Object.entries(j.inventory).map(([path,r])=>({path,...r}));}
const specs=[
 {id:'accepted-author319',directory:'editor-position-range-selection-fix-next',manifest:'freeze-manifest.json',count:319,sha256:'77ae818b4539341ab6f2f0126efaf8974117136f207747450d821df7c09baa1d'},
 {id:'accepted-independent81',directory:'editor-position-range-selection-correction-independent-review',manifest:'review-manifest.json',count:81,sha256:'7eb5f10cca861c1ac31b2e6362df8c33d49a1c02f6f0f59c38cd7549cb2aba27'},
];
const authentication=[],payload=[],classification=[];
for(const spec of specs){const base=path.join(workspace,'work',spec.directory),mb=await read(base,spec.manifest);assert.equal(identity(mb).sha256,spec.sha256);const j=JSON.parse(mb),rs=rows(j);assert.equal(rs.length,spec.count);assert.equal(j.files,spec.count);assert.equal(new Set(rs.map(r=>r.path)).size,rs.length);assert.deepEqual((await walk(base)).sort(),[...rs.map(r=>r.path),spec.manifest].sort());let total=0;for(const r of [...rs,{path:spec.manifest,...identity(mb)}]){const b=await read(base,r.path,r),h=b.subarray(0,8).toString('hex');assert.ok(!['4d5a','7f454c46','504b0304','504b0506','504b0708','1f8b','377abcaf271c','fd377a585a00','28b52ffd','03d9a29a'].some(m=>h.startsWith(m)),r.path+' executable/archive signature');assert.notEqual(b.subarray(257,262).toString(),'ustar',r.path+' TAR');new TextDecoder('utf-8',{fatal:true}).decode(b);const publicPath=safe(prefix+spec.id+'/'+r.path.split('/').map(s=>names[s]??s).join('/')+'.snapshot',true),row={epoch:spec.id,sourceRoot:'work/'+spec.directory,sourcePath:r.path,...identity(b),publicPath,inertExact:true,publishable:true};payload.push(row);classification.push({...row,kind:'strict-UTF8-source-or-observation',leadingNativeCarrier:false});if(r.path!==spec.manifest)total+=b.length;}
 assert.equal(total,j.bytes??j.totalBytes);authentication.push({...spec,manifestIdentity:identity(mb),schema:j.schema,payloadBytes:total});await save('authority/'+spec.id+'/'+spec.manifest+'.snapshot',mb);
}
assert.equal(payload.length,402);assert.equal(new Set(payload.map(r=>r.publicPath)).size,402);await save('authentication-before.json',{epochs:authentication,records:payload,originalExecutions:0});
const candidate=path.join(workspace,'work/editor-position-range-selection-fix-next');
// The new319 already preserves every old145/43 payload plus each exact old manifest.
const embedded=[];for(const [id,directory,manifest,count,digest]of [['author145','editor-position-range-selection-next','freeze-manifest.json',145,'8e423a7d82ea58c696f9bc3d91f6d3df460c51a2041cbcdcc87d2806c0997ee5'],['independent43','editor-position-range-selection-independent-review','review-manifest.json',43,'978bfd0fc13f4c148d980d7d1221edd2618e716adffd0831d16a08f522459a09']]){const base=path.join(workspace,'work',directory),mb=await read(base,manifest);assert.equal(identity(mb).sha256,digest);const rs=rows(JSON.parse(mb));assert.equal(rs.length,count);assert.deepEqual((await walk(base)).sort(),[...rs.map(r=>r.path),manifest].sort());for(const r of [...rs,{path:manifest,...identity(mb)}]){await read(base,r.path,r);const copied='history/'+id+'/'+r.path+'.snapshot';await read(candidate,copied,r);const alias=payload.find(p=>p.epoch==='accepted-author319'&&p.sourcePath===copied);assert.ok(alias);embedded.push({historicalEpoch:id,historicalSourceRoot:'work/'+directory,historicalSourcePath:r.path,...identity(await read(candidate,copied,r)),preservedSourcePath:copied,publicPath:alias.publicPath});}}
assert.equal(embedded.length,190);await save('embedded-historical145-43-map.json',{payloads:188,manifests:2,rows:embedded,oldFalseInherited12ClaimRetained:true,oldAuthorHeldOutLabelsRetained:true,oldSixHelperFailuresRetained:true});
const acquisition=JSON.parse(await read(candidate,'acquisition.json'));const officialSix=acquisition.records.filter(r=>r.path.startsWith('source/src/'));assert.equal(officialSix.length,6);for(const r of acquisition.records)await read(candidate,r.path,r);const license=acquisition.records.find(r=>r.path==='source/LICENSE.txt.snapshot'),licenseBytes=await read(candidate,license.path,license);assert.match(licenseBytes.toString(),/MIT License/);assert.match(licenseBytes.toString(),/Microsoft Corporation/);for(const r of officialSix)assert.match((await read(candidate,r.path,r)).toString(),/Copyright.*Microsoft Corporation/);
const ledger=JSON.parse(await read(candidate,'contracts.json'));assert.equal(ledger.contracts.length,30);assert.equal(ledger.nestedOptionFields,6);assert.equal(ledger.selectionInheritedRangeContractEntries,10);assert.equal(ledger.selectionInheritedRangeDistinctNames,9);
await save('source-and-license-provenance.json',{release:acquisition.release,commit:acquisition.commit,license:'MIT',officialSourceRecords:officialSix,allAcquisitionRecords:acquisition.records,fullLicense:license,notice:{path:'NOTICE.md',...identity(await read(candidate,'NOTICE.md'))},publicLicensePath:payload.find(r=>r.epoch==='accepted-author319'&&r.sourcePath===license.path).publicPath,applicationVendorImports:0,originalLibraryUsedOnlyInPreservedVerification:true,shippedDeclaration:acquisition.shippedDeclaration,parserPackageInstallDependency:false,fullProductParity:false});
const review=JSON.parse(await read(path.join(workspace,'work/editor-position-range-selection-correction-independent-review'),'review-validation.json'));assert.equal(review.finiteAcceptance,true);assert.equal(review.sourceStable,true);assert.deepEqual(review.confirmedNewCandidateFaults,[]);
const app='products/rea-studio/apps/editor/',baseline=[];for(const p of (await walk(path.join(repo,app))).filter(p=>!p.startsWith('results/'))){const b=await read(repo,app+p);baseline.push({path:app+p,...identity(b)});}assert.equal(baseline.length,24);await save('current-editor24-before.json',baseline);
const originalReadme=await read(repo,app+'README.md');assert.equal(identity(originalReadme).sha256,'954fe5be0e897e334bc32085875392a5359f8a3b8be9745cc1ab3380f07569e9');await save('before-images/'+app+'README.md.snapshot',originalReadme);
const note=`This developer-consumable value-class module is newly written, source-assisted code for VS Code 1.140.0 commit07f806f999227108933c2e30515b26eecc1fda74. It imports no Microsoft, original-oracle or parser runtime. The finite source contract and six authoritative source files are preserved as inert evidence under results/position-range-selection-followup/accepted-author319/source/ with exact original Microsoft notices. Preserve this full MIT notice with redistributed source or derivative compatibility material. This is not a clean-room, complete extension API or full editor parity claim.\n\n`+licenseBytes.toString();await save('proposed/'+app+'position-range-selection.NOTICE.md',note);
const addition=`\n\n## Finite Position, Range and Selection value API\n\nThe ES module [position-range-selection.mjs](position-range-selection.mjs) exports source-assisted `Position`, `Range` and `Selection` value classes. This is a developer-consumable foundation; the current Editor interface does not bind its document cursor, selection or extension lifecycle to these classes. For example, import `{ Position, Range, Selection }` from this module in Node, create positions with `new Position(0, 3)`, and construct an ordered `new Range(start, end)` or directional `new Selection(anchor, active)`. No original/vendor/parser runtime is imported.\n\nThe exact finite declaration scope is **30 direct entries** (Position13, Range12, Selection5), including overloads, plus **six nested optional fields**. Selection additionally inherits **ten nonconstructor Range declaration entries across nine names**; Range constructors are excluded and Selection owns its own two constructor forms. This census is complete only for these three selected classes, not the whole VS Code API, workbench or every documented editor feature. Public accessor assignment is readonly; this is not deep object freezing or a document-bound validation guarantee. The source-supported constructor behavior is retained rather than imposing document limits.\n\nThe normal pure [regression test](position-range-selection.test.mjs) has thirteen groups covering the selected direct declarations/options, ordering and inclusive ranges, overlap/touching/disjoint behavior, identity aliases, directional selection, inherited return types, readonly accessors and six constructible call/apply compatibility helpers. Those extra helpers are outside the30-entry denominator. Run `node --test products/rea-studio/apps/editor/position-range-selection.test.mjs` from the repository root. It needs only Node and this new module, writes no source/result files, uses no original oracle and has no machine-specific compiler/cache dependency. These are production regressions authored from declared contracts, not a newly independent original differential campaign.\n\nSource binding is [VS Code1.140.0 commit07f806f999227108933c2e30515b26eecc1fda74](https://github.com/microsoft/vscode/tree/07f806f999227108933c2e30515b26eecc1fda74). The [retained original license](results/position-range-selection-followup/accepted-author319/source/LICENSE.txt.snapshot.snapshot), exact six source files and [study notice](results/position-range-selection-followup/accepted-author319/NOTICE.md.snapshot) preserve Microsoft MIT notices. See the accompanying [redistribution notice](position-range-selection.NOTICE.md). No clean-room or independent licensing opinion is implied.\n\nThe [accepted319 correction](results/position-range-selection-followup/accepted-author319/validation.json.snapshot) preserves the complete historical145 author/43 negative epochs and their raw failures. Its22 groups are nine author plus thirteen exact reviewer replays. The author oracle evaluates five pinned TypeScript library units in six VM evaluations through Node stripping; the older independent-shaped replay separately compiles ten units in twelve evaluations, with179 exact semantic pairs and nine raw readonly receiver-label controls kept separate. These are source-composed class libraries, not the shipped extension-host/workbench. The240 separately shaped author cases use the common packet harness and are not relabeled as held-out independence.\n\nThe [fresh independent81 review](results/position-range-selection-followup/accepted-independent81/review-validation.json.snapshot) adds nine groups with58 semantic differential pairs:38 exact encoded/library-error pairs and20 engine rejection-type comparisons preserving raw errors. Six descriptor controls compare the prior nonstrict composed script, explicit strict composition and candidate. The released sources are ES modules; the review restores strictness after removing module syntax. Script-oracle `caller`/`arguments` differences remain recorded as composition differences, without suppressing original errors or claiming candidate failures. Both compositions together evaluate ten source units in twelve VM evaluations. These counts remain separate from replay22 and the new pure13 regressions. This integration plan reexecutes no original library code.\n\nComplete extension APIs/host lifecycle, current document/cursor binding, arbitrary hostile objects/proxies/cycles, universal engine error text/prototype/function-source equivalence, accessibility/client/native packaging and full Editor parity remain open. Original native executable, original GUI, workbench and extension-host executions are zero for these campaigns. No performance, memory or superiority conclusion follows from this finite value API.\n`;
await save('proposed/'+app+'README.md',Buffer.concat([originalReadme,Buffer.from(addition)]));
const live=[];for(const name of ['position-range-selection.mjs','position-range-selection.test.mjs','position-range-selection.NOTICE.md','README.md']){const destination=app+name,b=await read(root,'proposed/'+destination);const before=baseline.find(r=>r.path===destination);if(!before)await assert.rejects(fs.access(path.join(repo,destination)),{code:'ENOENT'});live.push({destination,proposalPath:'proposed/'+destination,after:identity(b),before:before?{bytes:before.bytes,sha256:before.sha256}:null,action:before?'replace-exact':'add-exact',runtime:name==='position-range-selection.mjs',importsOriginal:false,sourceRoot:'work/editor-value-api-publication-plan-next'});}
assert.equal(live.length,4);assert.equal(live.filter(r=>r.before).length,1);assert.equal(live.filter(r=>!r.before).length,3);assert.equal(live.find(r=>r.runtime).after.sha256,'9f5d89b260e88fc1c2197d23a9c2b0ca25fcff688c5eba839471c7a4fe499aa8');await save('live-copy-list.json',{schema:'rea-editor-value-api-production-proposal/v1',proposals:live,files:4,newPaths:3,replacements:1,sourceSemanticsChanges:0,clientBinding:false,hostRoutesProposed:0,productionWrites:0});
const testGroups=[
 ['Position constructor, readonly coordinates and explicit negative failures',['Position.line.1','Position.character.2','Position.constructor.3']],
 ['Position ordering, equality and compareTo agree at equal and adjacent coordinates',['Position.isBefore.4','Position.isBeforeOrEqual.5','Position.isAfter.6','Position.isAfterOrEqual.7','Position.isEqual.8','Position.compareTo.9']],
 ['Position translate overloads and both optional deltas retain unchanged identity',['Position.translate.10','Position.translate.11']],
 ['Position with overloads and both optional coordinates create only changed values',['Position.with.12','Position.with.13']],
 ['Range constructor overloads order endpoints, expose readonly bounds and empty/single-line state',['Range.start.1','Range.end.2','Range.constructor.3','Range.constructor.4','Range.isEmpty.5','Range.isSingleLine.6']],
 ['Range contains has inclusive point endpoints, nested ranges and complete-range equality',['Range.contains.7','Range.isEqual.8']],
 ['Range intersection handles disjoint, touching, nested and partial overlap without mutation',['Range.intersection.9']],
 ['Range union reuses containing ranges and expands disjoint bounds',['Range.union.10']],
 ['Range with overloads and both optional endpoints preserve alias identity when unchanged',['Range.with.11','Range.with.12']],
 ['Selection constructor overloads preserve directional anchor/active and ordered range',['Selection.anchor.1','Selection.active.2','Selection.constructor.3','Selection.constructor.4','Selection.isReversed.5']],
 ['Selection inherits ten nonconstructor Range declaration entries across nine names',[]],
 ['Six released compatibility call/apply helpers construct new objects and preserve supplied receivers',[]],
 ['Value objects serialize without document binding and tolerate source-supported noninteger numbers',[]],
];
assert.deepEqual(testGroups.flatMap(r=>r[1]).sort(),ledger.contracts.map(c=>c.id).sort());const testText=(await read(root,'proposed/'+app+'position-range-selection.test.mjs')).toString();for(const [name]of testGroups)assert.ok(testText.includes("test('"+name+"'"));
await save('pure-regression-scope.json',{schema:'rea-editor-value-api-finite-regression-census/v1',groups:testGroups.map(([name,directDeclarationIDs])=>({name,directDeclarationIDs})),directDeclarationEntries:30,nestedOptionalFields:ledger.contracts.flatMap(c=>c.nestedOptionFields.map(field=>({id:c.id,field}))),selectionInheritedDeclarations:ledger.contracts.filter(c=>c.class==='Range'&&c.member!=='constructor').map(c=>({id:c.id,member:c.member})),selectionInheritedEntryCount:10,selectionInheritedDistinctNames:9,extraCompatibilityHelpers:['Position.call','Position.apply','Range.call','Range.apply','Selection.call','Selection.apply'],freshIndependenceClaim:false,originalCalls:0,semanticExhaustiveness:false,wholeVSCodeAPIs:false});
