    },
    {
      "id": "grafana.candidate.0c3de862cee4d9349fd2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For more details, please see the example in [Use variables and transformations in a correlation](../use-variables-and-transformations/) for more details.",
