// File an already verified failed hosted browser backup; never execute browser or app code.
import assert from'node:assert/strict';import fs from'node:fs';import path from'node:path';import{createHash}from'node:crypto';import{gzipSync,gunzipSync}from'node:zlib';
const work=import.meta.dirname,prefix='products/rea-studio/results/cloud-flow-vault-browser-failed-20261015',stage=path.join(work,'cloud-flow-vault-browser-failure-630-public-next'),publicRoot=path.join(stage,'public-candidate'),target=path.join(publicRoot,prefix);
const run='38824834990',job='116729744122',artifact='12015126323',artifactSHA='67cd0ef7e7e6e26430c3609633b104a7e7da3933fc8091c4cf9b6e26c3ac0cfe';
const runFolder=path.join(work,'cloud-verification-backups','run-'+run),backup=path.join(runFolder,'artifact-'+artifact),source=path.join(backup,'readable-evidence'),hash=b=>createHash('sha256').update(b).digest('hex'),identity=b=>({bytes:b.length,sha256:hash(b)});
function safe(s){assert(typeof s==='string'&&s&&!/[\\:\x00-\x1f\x7f]/.test(s)&&!s.startsWith('/')&&s.split('/').every(p=>p&&p!=='.'&&p!=='..'));return s;}
function read(root,name){safe(name);let filename=root;for(const part of name.split('/')){filename=path.join(filename,part);assert(!fs.lstatSync(filename).isSymbolicLink());}const stat=fs.lstatSync(filename);assert(stat.isFile()&&stat.size<=12*1024*1024);const bytes=fs.readFileSync(filename);assert.equal(bytes.length,stat.size);return bytes;}
const verifiedBytes=read(backup,'local-browser-backup-verification.json'),verified=JSON.parse(verifiedBytes);assert.equal(verified.artifactSHA256,artifactSHA);assert.equal(verified.allCRCAndBytesReadable,true);assert.equal(verified.sourceSnapshotFilesVerified,330);
const entries=new Map(verified.files.map(row=>[safe(row.path),row]));assert.equal(entries.size,367);
function evidence(name){const bytes=read(source,name),row=entries.get(name);assert(row);assert.deepEqual(identity(bytes),{bytes:row.bytes,sha256:row.sha256});return bytes;}
const attempt=JSON.parse(evidence('browser-attempt.json')),report=JSON.parse(evidence('playwright-results.json'));assert.equal(attempt.status,'failed');assert.equal(attempt.sourceCommit,'7fc5cb67cc5fec5042fc5e145d658f64aa5a6d64');assert.equal(attempt.sourceStable,true);assert.equal(attempt.sourceFiles,330);
assert.deepEqual({passed:report.stats.expected,failed:report.stats.unexpected,didNotRun:report.stats.skipped,flaky:report.stats.flaky},{passed:6,failed:2,didNotRun:4,flaky:0});
const retained=[...entries.keys()].filter(name=>!name.startsWith('source/')),omitted=[...entries.values()].filter(row=>row.path.startsWith('source/')).map(row=>({sourcePath:row.path,bytes:row.bytes,sha256:row.sha256}));assert.equal(omitted.length,330);assert.equal(retained.length,37);
const cases=retained.filter(name=>/^case-.*\.json$/.test(name)).map(name=>JSON.parse(evidence(name)));assert.equal(cases.length,7);const failed=cases.find(row=>row.title==='Flow disposal scrubs detached native controls during actual validation');assert(failed);assert.equal(failed.statusAtFixtureClose,'passed');assert.equal(failed.serverCloseObserved,false);assert.deepEqual(failed.errors,[]);
const downloads=retained.filter(name=>name.startsWith('downloads/'));assert.equal(downloads.length,3);
const mediaBytes=read(backup,'local-failed-media-verification.json'),media=JSON.parse(mediaBytes);assert.equal(media.traces.length,2);assert.equal(media.screenshots.length,8);assert(media.traces.every(row=>row.externalNetworkObserved===false&&row.externalCredentialPatternFound===false));
assert(!fs.existsSync(stage));fs.mkdirSync(path.join(target,'payload'),{recursive:true});const records=[],objects=new Map();
const credentials=/\b(?:ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,}|AKIA[0-9A-Z]{16})\b|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----/;
function save(role,raw){safe(role);assert(!records.some(row=>row.sourcePath===role));assert(!credentials.test(raw.toString('utf8')));const original=identity(raw),png=raw.subarray(0,8).equals(Buffer.from('89504e470d0a1a0a','hex')),zip=raw.subarray(0,4).equals(Buffer.from('504b0304','hex'));let bytes=raw,encoding='identity';if(!png&&!zip&&raw.length>65536){const gz=gzipSync(raw,{level:9});if(gz.length<raw.length*.85){assert.deepEqual(gunzipSync(gz),raw);bytes=gz;encoding='gzip';}}const name='payload/'+original.sha256+(png?'.png':zip?'.zip.snapshot':encoding==='gzip'?'.gz.snapshot':'.snapshot'),stored=identity(bytes);if(!objects.has(name)){fs.writeFileSync(path.join(target,name),bytes,{flag:'wx'});assert.deepEqual(read(target,name),bytes);objects.set(name,stored);}records.push({sourcePath:role,path:name,...original,storage:{encoding,...stored},nativePNG:png,exactRecordedTraceZIP:role.endsWith('/trace.zip')});}
for(const name of retained)save('artifact/'+name,evidence(name));
save('local/local-browser-backup-verification.json',verifiedBytes);save('local/local-failed-media-verification.json',mediaBytes);save('local/collection-summary.json',read(runFolder,'collection-summary.json'));save('wrapper/job-'+job+'.txt',read(path.join(work,'cloud-verification-backups','job-'+job),'logs.txt'));
for(const kind of ['run','jobs','artifacts'])save('control-plane/'+kind+'.json',read(runFolder,'control-plane-evidence/'+kind+'.json'));
for(const filename of ['unpack-browser-cloud-attempt.py','verify-flow-vault-failed-media-backup.py','collect-readonly-run-2336.mjs'])save('readers/'+filename,read(work,filename));save('readers/public-preservation-collector.mjs',fs.readFileSync(import.meta.filename));
const manifest={schema:'rea-cloud-flow-vault-browser-failure-preservation/v1',createdAt:new Date().toISOString(),status:'failed',sourceCommit:attempt.sourceCommit,headSHA:'63014920a81d3d28108bdbde35731774a332462b',testedReference:'refs/pull/1/merge',runId:run,runAttempt:1,runURL:'https://github.com/Ginderlax/rea-research-lab/actions/runs/'+run,jobId:job,artifactId:artifact,artifactSHA256:artifactSHA,artifactBytes:verified.archiveBytes,summary:{selected:12,passed:6,failed:2,didNotRun:4,flaky:0,retries:0},sourceFiles:330,sourceStable:true,sourceCaptureComplete:true,sourceSnapshotFiles:330,actualRecordedRealDownloads:3,downloadScope:'Three raw UTF8 Flow downloads from the first three passing scenarios are preserved exactly; this does not establish complete campaign acceptance.',recordedCaseObservations:7,failedCaseBodyStatusAtFixtureClose:'passed',failedCaseServerCloseObserved:false,failedCaseUnexpectedErrors:[],firstFailure:'Owned server close deadline exceeded after the Flow disposal scenario body completed; the existing5s bound failed.',secondFailure:'The next Playwright worker collides with canonical wx browser-observation.json in beforeAll; four later scenarios do not run.',causalLimit:'The receipt cannot distinguish server.close callback, tracked inFlight requests or module disposal as the hanging host-close substage. A socket/keep-alive explanation remains a hypothesis. No implementation cause is asserted.',originalProductExecutions:0,tracePrivacyScope:'Exact recorded traces contain only the owned synthetic test context, including ephemeral loopback test token headers. Two trace ZIPs/35 inner entries passed readability and credential-pattern checks; observed network origins are loopback only. This is qualified selected-media inspection, not universal data classification.',completeLocalBackupVerified:true,localReadableFiles:367,retainedArtifactFiles:37,publicSourceSnapshotPayloads:0,omittedSourceSnapshotPayloads:omitted,omissionScope:'Only artifact source/ payload contents are omitted publicly with all330 identities retained. Complete readable source copies remain in the verified local backup. Every other uploaded artifact file, raw trace, screenshot, report, output and actual download remains recoverable exactly. Gzip affects storage only and records both raw and stored hashes.',records,uniquePublicObjects:objects.size,storedPayloadBytes:[...objects.values()].reduce((sum,row)=>sum+row.bytes,0),allCopiesExact:true,historicalReceiptsRebound:false,localProductExecutions:0,localBrowserExecutions:0,localTests:0,localBuilds:0,browserAcceptance:false,productionInstallationClaimed:false,fullFeatureParity:false,superiority:false};
fs.writeFileSync(path.join(target,'preservation-manifest.json'),JSON.stringify(manifest,null,2)+'\n',{flag:'wx'});
const readme='# Failed Flow and Vault browser campaign\n\nRun38824834990 selected12 scenarios:6passed,2failed and4didnotrun. The Flow disposal body completed, but fixture teardown could not close the owned host within5s. Its successor worker then collided with the canonical browser-observation file. The receipt does not establish which host-close substage hung or prove a keep-alive cause.\n\nAll37 uploaded non-source files remain recoverable here, including exact trace ZIPs, native PNGs and3 raw Flow downloads. All330 source snapshots remain in the verified readable local backup; their byte identities remain in this manifest. Selected trace inspection found loopback network origins only; exact traces retain owned ephemeral synthetic test token headers. No external credential patterns were found in those35 trace entries.\n\nFor storage.encoding=identity, read the payload directly. For storage.encoding=gzip, decompress it and verify the result against the top-level bytes/sha256, and verify the stored object against storage.bytes/sha256. No failed receipt is rewritten, no product source is changed and no complete browser acceptance is claimed.\n';fs.writeFileSync(path.join(target,'README.md'),readme,{flag:'wx'});
const rows=[];function inventory(dir){for(const item of fs.readdirSync(dir,{withFileTypes:true})){const filename=path.join(dir,item.name);assert(!item.isSymbolicLink());if(item.isDirectory())inventory(filename);else rows.push({path:path.relative(publicRoot,filename).replaceAll('\\','/'),...identity(fs.readFileSync(filename))});}}inventory(publicRoot);const bytes=rows.reduce((sum,row)=>sum+row.bytes,0);assert(bytes<=3*1024*1024);
const authority={schema:'rea-work-only-failed-browser-public-copy-authority/v1',at:new Date().toISOString(),publicCandidate:publicRoot,prefix,files:rows.length,bytes,rows,originalFourCapsulesChanged:false,activeRepositoryChanged:false,localProductExecutions:0,localTests:0,localBuilds:0};fs.writeFileSync(path.join(stage,'copy-authority.json'),JSON.stringify(authority,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({stage,files:rows.length,bytes,prefix,records:records.length,objects:objects.size,manifest:identity(fs.readFileSync(path.join(target,'preservation-manifest.json'))),copyAuthority:identity(fs.readFileSync(path.join(stage,'copy-authority.json'))),activeRepositoryChanged:false,localProductExecutions:0}));
