print(json.dumps(result))
"""Source/identity review only; does not parse JS, import candidates or run products."""
from pathlib import Path
import hashlib, json, re, subprocess, sys
BASE=Path(__file__).resolve().parent.parent
WORK=BASE/'work'
LAB=BASE/'outputs/rea-research-lab'
stage=WORK/(sys.argv[1] if len(sys.argv)>1 else 'notes-installed-tooling-phase3-r4-next')
candidate=stage/'candidate'
phase12=WORK/'notes-installed-source-proof-phase12-next'
def read(p):
    assert p.is_file() and not p.is_symlink(),str(p)
    return p.read_bytes()
def identity(b): return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def pin(b,r): assert identity(b)=={'bytes':r['bytes'],'sha256':r['sha256']},r
def load(p): return json.loads(read(p))
def git(args): return subprocess.run(['git','-C',str(LAB),*args],capture_output=True,check=True).stdout
def code(p): return read(p).decode().replace('\r\n','\n')
def literal(text,name):
    match=re.search(r'^const '+re.escape(name)+r'\s*=\s*([\[{].*?)\s*;\s*$',text,re.M|re.S)
    assert match,name
    return json.loads(match[1])
authority=load(stage/'change-authority.json')
assert authority['baseCommit']=='016ecd175c0700d1a94d5219af6719989a4a6e45'
pin(read(phase12/'change-authority.json'),authority['phase12Authority'])
rows=authority['files']; assert len(rows)==34 and len({r['path'] for r in rows})==34
assert len([p for p in candidate.rglob('*') if p.is_file()])==34
assert sum(r['after']['bytes'] for r in rows)==authority['candidateBytes']
tree=git(['ls-tree','-rz',authority['baseCommit']]).split(b'\0')
baseline={}
for entry in tree:
    if not entry:continue
    meta,p=entry.split(b'\t',1);mode,kind,blob=meta.split()
    if kind==b'blob':baseline[p.decode()]=blob.decode()
for row in rows:
    pin(read(candidate/row['path']),row['after'])
    if row['before'] is None: assert row['path'] not in baseline,row['path']
    else:pin(git(['show',authority['baseCommit']+':'+row['path']]),row['before'])
prior=load(phase12/'change-authority.json')
changes={r['path']:r for r in rows}
unchanged=[]
for row in prior['files']:
    name=row['path']
    if name not in ('scripts/verify-cloud-publication.mjs','scripts/publication-integrity-controls.mjs'):
        assert read(candidate/name)==read(phase12/'candidate'/name),name
        unchanged.append(name)
assert len(unchanged)==19
prefix='products/rea-studio/results/notes-todo-source-transition-20261016/'
for name in ('verify-cloud-publication.mjs','publication-integrity-controls.mjs'):
    assert read(candidate/(prefix+'verifier-before/phase12-'+name+'.snapshot'))==read(phase12/'candidate/scripts'/name)
assert read(candidate/(prefix+'phase12-authority.json.snapshot'))==read(phase12/'change-authority.json')

helper=code(candidate/'products/rea-studio/scripts/verify-notes-installed-cloud.mjs')
notes=literal(helper,'NOTES')
assert len(notes)==32 and len({r['path'] for r in notes})==32
expected={p[len('products/rea-studio/'):]:blob for p,blob in baseline.items() if p.startswith('products/rea-studio/apps/notes/') and '/results/' not in p}
for p in changes:
    if p.startswith('products/rea-studio/apps/notes/') and '/results/' not in p:expected[p[len('products/rea-studio/'):]]=None
assert set(expected)=={r['path'] for r in notes}
for row in notes:
    name='products/rea-studio/'+row['path']
    b=read(candidate/name) if name in changes else git(['show',authority['baseCommit']+':'+name])
    pin(b,row)
tests=sorted('products/rea-studio/'+r['path'] for r in notes if r['path'].endswith('.test.mjs'))
bundle=load(LAB/'products/rea-studio/experiments/notes-todo/bundle.json')
assert len(tests)==17 and tests==sorted(bundle['tests'])
assert len(bundle['authoredNewGroupNames'])==23 and bundle['originalHelperComparisons']==20
for row in bundle['transitions']:
    assert changes[row['target']]['after']==row['after']
assert len(bundle['transitions'])==8

def funcs(text):
    matches=list(re.finditer(r'^(?:async )?function ([A-Za-z0-9_]+)\(',text,re.M))
    return {m.group(1):text[m.start():matches[i+1].start() if i+1<len(matches) else len(text)] for i,m in enumerate(matches)}
before=code(candidate/(prefix+'verifier-before/verify-cloud.mjs.snapshot'))
after=code(candidate/'products/rea-studio/scripts/verify-cloud.mjs')
oldf,newf=funcs(before),funcs(after)
stable_functions=[]
for name in oldf:
    if name in ('selectTests','verifyGitBaselineActiveSources'):continue
    # Final pre-main function now contains the new local installed-state variable.
    if name=='verifyGitBaselineActiveSources':continue
    assert oldf[name]==newf[name],name
    stable_functions.append(name)
assert 'record.notesInstalled' in newf['verifyGitBaselineActiveSources']
provenance=re.search(r'const provenance = ([^;]+);',newf['verifyGitBaselineActiveSources']).group(1)
