    {
      "id": "grafana.candidate.dfdb315260c563bcc580",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This page provides a comprehensive guide to configuring SAML authentication in Grafana. You'll find detailed configuration examples, available settings, and their descriptions to help you set up and customize SAML authentication for your Grafana instance.",
      "headingPath": [
        "SAML configuration options"
