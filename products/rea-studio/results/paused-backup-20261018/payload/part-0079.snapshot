    {
      "id": "grafana.candidate.0b8538f1d6d77f5ede49",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Welcome to Grafana 11.5! Read on to learn about new sharing, reporting, and export options, cross-cluster search for Elasticsearch, PDC support for several new data sources, and more. The Grafana Cloud Migration Assistant is in public preview and now supports all plugins and Grafana Alerts, in addition to dashboards, folders, and data sources. We've also made it more secure to run third-party apps and data sources, and improved user session handling for OAuth 2.0 and SAML.",
      "headingPath": [
        "What’s new in Grafana v11.5"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-5.md",
        "gitBlobSha": "9e6683a89f9815739d950c46a162aafe0a26372f",
        "sha256": "d6a233f3734c3f38cfd01b82375f9a29110232addebe8f19b49abec0d0070fbe",
