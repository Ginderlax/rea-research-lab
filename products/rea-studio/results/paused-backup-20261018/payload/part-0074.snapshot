      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.0be53891de2fa61ff544",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The `$` and `.` symbols are used to reference variables and their properties. You can reference variables directly in your alert rule definitions using the `$` symbol followed by the variable name. Similarly, you can access properties of variables using the dot (`.`) notation in alert rule templates.",
      "headingPath": [
        "Annotation and label template reference",
        "Variables"
      ],
      "source": {
        "path": "docs/sources/alerting/alerting-rules/templates/reference.md",
