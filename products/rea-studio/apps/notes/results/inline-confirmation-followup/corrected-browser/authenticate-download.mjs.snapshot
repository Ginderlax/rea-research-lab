import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,source='C:/Users/evanh/Downloads/owned-attachment.txt',fixture=JSON.parse(await fs.readFile(path.join(here,'fixture.json'))),observed=JSON.parse(await fs.readFile(path.join(here,'observation-after-download-attempt.json'))),response=observed.forwarded.find(r=>r.action==='attachment-get'),stat=await fs.stat(source),bytes=await fs.readFile(source),sha=createHash('sha256').update(bytes).digest('hex');assert(response);assert.equal(sha,fixture.attachment.sha256);assert.equal(bytes.length,fixture.attachment.bytes);assert.equal(Buffer.from(response.response.result.base64,'base64').compare(bytes),0);assert(stat.birthtimeMs>=Date.parse(response.at)-2000);await fs.writeFile(path.join(here,'downloaded-attachment.txt'),bytes,{flag:'wx'});await fs.writeFile(path.join(here,'attachment-roundtrip.json'),JSON.stringify({at:new Date().toISOString(),source,createdAt:stat.birthtime.toISOString(),lastWrite:stat.mtime.toISOString(),bytes:bytes.length,sha256:sha,actualBrowserAttachmentGet:response.id,ownedSyntheticBytesMatch:true,downloadEventBridgeTimedOut:true,browserDownloadedFileVerified:true,browserUploadBlocked:true,sourceInitiallyAbsentNotObserved:true,downloadRetainedInEvidence:true},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({downloadedBytes:bytes.length,sha256:sha,browserGET:response.id}));
