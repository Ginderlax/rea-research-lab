    {
      "id": "grafana.candidate.390f91b74a9c0091729e",
      "syntaxRole": "list-item",
      "sourceText": "- **Organization permissions** to manage access to dashboards, alerts, plugins, teams, playlists, and other resources for an entire organization. The available roles are Viewer, Editor, and Admin.",
