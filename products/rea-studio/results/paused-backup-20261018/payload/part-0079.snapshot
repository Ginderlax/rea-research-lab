    },
    {
      "id": "grafana.candidate.25b03791c1093a1ce7b9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "[Documentation](https://grafana.com/docs/grafana/v10.4/alerting/set-up/migrating-alerts/#upgrade-with-preview-recommended)",
      "headingPath": [
        "What’s new in Grafana v10.4",
        "Alerting",
        "Grafana Alerting upgrade with rule preview"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-4.md",
