      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.e9de7933d9a32383ce4f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The `profilesExemplars` feature is generally available and enabled by default.",
      "headingPath": [
        "Query profile data",
        "Pyroscope query editor",
        "Query options",
        "Exemplars"
      ],
      "source": {
        "path": "docs/sources/datasources/pyroscope/query-editor/index.md",
