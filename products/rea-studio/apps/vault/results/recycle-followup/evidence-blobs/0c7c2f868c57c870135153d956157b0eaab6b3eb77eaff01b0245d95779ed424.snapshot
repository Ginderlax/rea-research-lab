import test from 'node:test';import assert from 'node:assert/strict';
import {fixture,trashA,button,field,descendants,deferred} from './ui-helper.mjs';
test('post-restore active-list refresh preserves a newer preview within the existing bin generation',async t=>{
 let armed=false;const entered=deferred(),release=deferred();t.after(()=>release.resolve());const f=await fixture(t,'same-bin-generation-new-preview',async(action,input,real)=>{const value=await real();if(action==='list'&&armed){armed=false;entered.resolve();await release.promise;}return value;});
 await trashA(f.root);const b=(await f.call('read',{id:f.B})).entry;await f.call('recycleDelete',{id:f.B,revision:b.recycleRevision,confirm:true});await button(f.root,'Show recycle bin').click();
 const row=title=>descendants(f.root).find(n=>n.tagName==='section'&&n.children.some(c=>c.tagName==='strong'&&c.textContent===title));field(row('A'),'Confirm restoring this entry to its previous group').checked=true;armed=true;const pending=button(row('A'),'Restore recycled entry').click();await entered.promise;
 await button(row('B'),'Preview recycled entry').click();f.observe.before=field(f.root,'Recycled password').value;assert.equal(f.observe.before,'B-owned-secret');release.resolve();await pending;f.observe.after=descendants(f.root).find(n=>n.tagName==='label'&&n.ownText==='Recycled password')?.children[0]?.value??null;
 assert.equal(f.observe.after,'B-owned-secret','A newer preview in the same bin must survive the older restore refresh.');
});
