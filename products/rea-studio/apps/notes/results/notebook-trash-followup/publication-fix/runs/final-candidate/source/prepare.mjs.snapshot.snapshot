import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const root=fileURLToPath(new URL('./',import.meta.url)),old=fileURLToPath(new URL('../notes-trash-next/',import.meta.url)),review=fileURLToPath(new URL('../notes-trash-independent-review/',import.meta.url)),hash=b=>createHash('sha256').update(b).digest('hex');
async function authenticate(dir,manifestName,expected){const bytes=await fs.readFile(path.join(dir,manifestName));assert.equal(hash(bytes),expected);const manifest=JSON.parse(bytes),rows=manifest.files??manifest.records;for(const r of rows){const b=await fs.readFile(path.join(dir,r.path));assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256,r.path);}return rows;}
const prior=await authenticate(old,'preservation-manifest.json','aaa0b6f1f3fcf3b642e6cf23aec76b7596006cb39d49b073bac55b6af2af563b'),independent=await authenticate(review,'review-manifest.json','d6e485d9168f548709c69a30cd04e5fcc065cc6348892d3326606c34f0dff18f');assert.equal(prior.length,325);assert.equal(independent.length,37);
const records=[];for(const row of prior.filter(r=>r.path.startsWith('products/')||r.path.startsWith('original/')||['prior-source-provenance.json','trash-source-provenance.json','license-and-special-id-provenance.json','SOURCE-CONTRACTS.md'].includes(r.path))){const target=path.join(root,row.path);await fs.mkdir(path.dirname(target),{recursive:true});await fs.copyFile(path.join(old,row.path),target,fs.constants.COPYFILE_EXCL);records.push({...row,sourceStage:'work/notes-trash-next'});}
await fs.mkdir(path.join(root,'regression'),{recursive:true});const adapters=[];for(const name of ['review.test.mjs','ui-fixture.mjs']){const bytes=await fs.readFile(path.join(review,name));await fs.writeFile(path.join(root,'regression',name+'.snapshot'),bytes,{flag:'wx'});let text=bytes.toString().replaceAll("../notes-trash-next/products/rea-studio/apps/notes/","../products/rea-studio/apps/notes/");assert.equal(text.includes('../notes-trash-next/'),false);await fs.writeFile(path.join(root,'regression',name),text,{flag:'wx'});adapters.push({original:name,originalSha256:hash(bytes),adaptedSha256:hash(text),transformation:'Only stage import prefixes ../notes-trash-next/products → ../products; test bodies unchanged.'});}
for(const name of ['trash-validation.final.json','freeze.json','preservation-manifest.json']){const b=await fs.readFile(path.join(old,name));records.push({path:name,bytes:b.length,sha256:hash(b),referenceOnly:true});}for(const name of ['review-validation.json','review-manifest.json','freeze.json']){const b=await fs.readFile(path.join(review,name));records.push({path:name,bytes:b.length,sha256:hash(b),sourceStage:'work/notes-trash-independent-review',referenceOnly:true});}
await fs.writeFile(path.join(root,'baseline-reference.json'),JSON.stringify({schema:'rea-notes-fix-reference-baseline/v1',at:new Date().toISOString(),oldStage:'work/notes-trash-next',oldArtifacts:325,reviewStage:'work/notes-trash-independent-review',reviewArtifacts:37,records,adapters,priorHistoricalEvidenceRecopied:false,productionModified:false},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({authenticatedPrior:325,authenticatedReview:37,copied:records.filter(r=>!r.referenceOnly).length,bodyAdapters:adapters}));
