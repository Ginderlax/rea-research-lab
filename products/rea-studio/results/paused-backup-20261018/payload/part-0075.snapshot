    {
      "id": "grafana.candidate.19b592b57a366bef8db6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A potential drawback of splitting queries is that each query runs separately. This increases backend load and can affect query performance, especially in environments with a large number of active alerts.",
      "headingPath": [
        "Examples of trace-based alerts",
        "Alerting on span metrics",
        "Enable traffic guardrails"
      ],
      "source": {
