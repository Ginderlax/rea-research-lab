    },
    {
      "id": "grafana.candidate.2926813ec4196372085a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Before we get started, you need to download and install the [Raspberry Pi Imager](https://www.raspberrypi.org/software/).",
      "headingPath": [
        "Introduction",
        "Set up your Raspberry Pi",
        "Download and install Raspberry Pi Imager"
      ],
