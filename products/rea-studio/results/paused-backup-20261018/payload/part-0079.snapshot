    },
    {
      "id": "grafana.candidate.e26beff438e9d4da4e41",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A flame graph takes advantage of the hierarchical nature of profiling data. It condenses data into a format that allows you to easily see which code paths are consuming the most system resources, such as CPU time, allocated objects, or space when measuring memory. Each block in the flame graph represents a function call in a stack and its width represents its value.",
      "headingPath": [
        "Flame graph",
        "Flame graph mode"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/flame-graph/index.md",
        "gitBlobSha": "516216a41ec14dd068113d17d449c7e5418063df",
        "sha256": "156d31d59646a5ae88a2b1b202ef874ef58269b49f2ceee6cc7f0456887db115",
        "lineStart": 88,
        "lineEnd": 88,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/panels-visualizations/visualizations/flame-graph/index.md#L88-L88"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.06aced7fdc2be6cda1a8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grayed-out sections are a set of functions that represent a relatively small value and they are collapsed together into one section for performance reasons.",
      "headingPath": [
        "Flame graph",
        "Flame graph mode"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/flame-graph/index.md",
        "gitBlobSha": "516216a41ec14dd068113d17d449c7e5418063df",
        "sha256": "156d31d59646a5ae88a2b1b202ef874ef58269b49f2ceee6cc7f0456887db115",
        "lineStart": 90,
        "lineEnd": 90,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/panels-visualizations/visualizations/flame-graph/index.md#L90-L90"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.220017457bf8f24c7ae6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can hover over a specific function to view a tooltip that shows you additional data about that function, like the function's value, percentage of total value, and the number of samples with that function.",
      "headingPath": [
        "Flame graph",
        "Flame graph mode"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/flame-graph/index.md",
