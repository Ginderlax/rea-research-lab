import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';import {stripTypeScriptTypes} from 'node:module';import {runInNewContext} from 'node:vm';
const root=import.meta.dirname,hash=b=>createHash('sha256').update(b).digest('hex');
export function prepareOracleSources(){
 const provenancePath=path.join(root,'results/layout-followup/correction/frozen/source-provenance.json.snapshot'),provenanceBytes=fs.readFileSync(provenancePath);assert.equal(hash(provenanceBytes),'69c3ca5c3707c1e7204e6497a0df33559dbc2ab54f66595e1b0de461c5ee168c','Pinned original layout provenance');assert.equal(hash(fs.readFileSync(process.execPath)),'b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3','Pinned Node layout oracle runtime');const provenance=JSON.parse(provenanceBytes),sourceRows=[],parts=[];assert.equal(provenance.release,'@excalidraw/excalidraw 0.18.1');assert.equal(provenance.commit,'a2ec2889babf7d2295469c6d90ebe77fae57df84');assert.equal(provenance.fetched.length,8);
 for(const [name,start,next] of [['align.ts',null,null],['distribute.ts',null,null],['groups.ts','export const getMaximumGroups =','export const getNonDeletedGroupIds ='],['element/bounds.ts','export const getCommonBounds =','export const getDraggedElementsBounds ='],['element/bounds.ts','export const getCommonBoundingBox =','export const getVisibleSceneBounds ='],['element/mutateElement.ts','export const mutateElement =','export const newElementWith ='],['element/mutateElement.ts','export const newElementWith =','export const bumpVersion =']]){
  const filename='original/packages/excalidraw/'+name+'.snapshot',b=fs.readFileSync(path.join(root,'results/layout-followup/correction/frozen',filename+'.snapshot')),r=provenance.fetched.find(r=>r.path===filename);assert.ok(r,'Pinned original source row');assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);const whole=b.toString('utf8'),begin=start?whole.indexOf(start):0,end=next?whole.indexOf(next,begin):whole.length;assert.ok(begin>=0&&end>begin);const exact=whole.slice(begin,end),withoutImports=exact.replace(/^import[\s\S]*?;\r?\n/gm,''),compiled=stripTypeScriptTypes(withoutImports,{mode:'strip',sourceUrl:'rea-original/'+name}).replace(/^export /gm,'');parts.push(compiled);sourceRows.push({path:'results/layout-followup/correction/frozen/'+filename+'.snapshot',originalPath:filename,sourceSHA256:r.sha256,characterStart:begin,characterEnd:end,exactSliceSHA256:hash(Buffer.from(exact)),strippedSHA256:hash(Buffer.from(compiled)),importsRemoved:true,typeScriptSyntaxStripped:true,originalBodiesEdited:false});
 }
 return {sourceRows,code:parts.join('\n')+'\n({alignElements,distributeElements})'};
}
export function loadLayoutOracle(){
 const source=prepareOracleSources(),calls={align:0,distribute:0,bindingNoOpAdapter:0,unboundTextAdapter:0,boundsAdapter:0,elbowPredicateAdapter:0,timestampAdapter:0,randomAdapter:0,sceneLookupAdapter:0};
 const unreachable=()=>{throw new Error('Unexpected fixture-dependent original branch');};const adapters={Scene:{getScene:()=>{calls.sceneLookupAdapter++;return undefined;}},ShapeCache:{delete:unreachable},isElbowArrow:e=>{calls.elbowPredicateAdapter++;assert.notEqual(e.elbowed,true);return false;},getSizeFromPoints:unreachable,toBrandedType:unreachable,updateElbowArrowPoints:unreachable,getUpdatedTimestamp:()=>{calls.timestampAdapter++;return 123;},randomInteger:()=>{calls.randomAdapter++;return 42;},arrayToMap:elements=>new Map(elements.map(e=>[e.id,e])),getBoundTextElement:()=>{calls.unboundTextAdapter++;return null;},getElementBounds:e=>{calls.boundsAdapter++;if(e.angle!==0)throw new Error('Oracle geometry adapter supports unrotated fixtures only');if(e.points){const xs=e.points.map(p=>e.x+p[0]),ys=e.points.map(p=>e.y+p[1]);return [Math.min(...xs),Math.min(...ys),Math.max(...xs),Math.max(...ys)];}return [Math.min(e.x,e.x+e.width),Math.min(e.y,e.y+e.height),Math.max(e.x,e.x+e.width),Math.max(e.y,e.y+e.height)];},updateBoundElements:()=>{calls.bindingNoOpAdapter++;}};
 const original=runInNewContext(source.code,adapters,{timeout:2000}),oracle={};for(const [name,key] of [['alignElements','align'],['distributeElements','distribute']])oracle[name]=(...args)=>{calls[key]++;return original[name](...args);};return {oracle,calls,source:source.sourceRows,vmEvaluations:1,geometryAdapterIsOwned:true,fullOriginalBindingNotExecuted:true,exactOriginalMutationHelpersExecuted:true};
}
