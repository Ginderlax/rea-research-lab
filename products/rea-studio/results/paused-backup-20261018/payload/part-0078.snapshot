    {
      "id": "grafana.candidate.6d7c939710894fe6c76f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Since the policy tree is a single resource, provisioning it will overwrite all policies in the notification policy tree. However, it does not affect internal policies created when alert rules directly select a contact point.",
      "headingPath": [],
      "source": {
        "path": "docs/sources/shared/alerts/warning-provisioning-tree.md",
