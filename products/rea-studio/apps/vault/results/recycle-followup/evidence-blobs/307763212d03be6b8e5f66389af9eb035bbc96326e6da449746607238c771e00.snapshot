import fs from 'node:fs/promises';import os from 'node:os';import path from 'node:path';import{createHash,randomUUID}from'node:crypto';import{spawn}from'node:child_process';
export const here=import.meta.dirname,password='Synthetic-recycle-original-master',observations=[];
const work=path.resolve(here,'../../../..');
export const originalExe=process.env.REA_KEEPASS_EXE??path.resolve(here,'../../../../../..','outputs/rea-research-lab/projects/07-keepass/artifacts/portable/KeePass.exe');
export const expected='04d29636c393f0c1fc99ff739295494be3adefded93271e44591e8e300225a5a';
const sha=b=>createHash('sha256').update(b).digest('hex');
export async function temp(t){const directory=await fs.mkdtemp(path.join(os.tmpdir(),'rea-recycle-'));t.after(async()=>{if(path.dirname(directory)!==path.resolve(os.tmpdir())||!path.basename(directory).startsWith('rea-recycle-'))throw new Error('Unsafe fixture cleanup');await fs.rm(directory,{recursive:true,force:true});});return directory;}
export async function original(directory,config){if(sha(await fs.readFile(originalExe))!==expected)throw new Error('Original release mismatch before process.');const cfg=path.join(directory,'config-'+randomUUID()+'.json'),helper=path.join(here,'recycle-oracle.ps1'),helperSha=sha(await fs.readFile(helper));await fs.writeFile(cfg,JSON.stringify({oracle:originalExe,password,...config}));
 const env={...process.env};delete env.NODE_TEST_CONTEXT;const p=spawn('powershell.exe',['-NoProfile','-NonInteractive','-File',helper,'-Config',cfg],{windowsHide:true,env,stdio:['ignore','pipe','pipe']}),chunks={stdout:[],stderr:[]},sizes={stdout:0,stderr:0};let problem;const stop=s=>{problem??=s;p.kill();},timer=setTimeout(()=>stop('Original child30-second deadline'),30000);
 for(const name of['stdout','stderr'])p[name].on('data',b=>{sizes[name]+=b.length;if(sizes[name]>1024*1024)stop('Original capture exceeds1MiB');else chunks[name].push(b)});
 p.once('error',e=>problem??=e.message);const code=await new Promise(r=>p.once('close',r));clearTimeout(timer);const stdout=Buffer.concat(chunks.stdout).toString('utf8'),stderr=Buffer.concat(chunks.stderr).toString('utf8');let value;try{if(code===0&&!problem)value=JSON.parse(stdout)}catch(e){problem=e.message}const record={config,code,problem:problem??null,stdout,stderr,sizes,helperSha256:helperSha,releaseSha256:expected,value};observations.push(record);await fs.mkdir(path.join(work,'.local/recycle-observations'),{recursive:true});await fs.writeFile(path.join(work,'.local/recycle-observations',randomUUID()+'.json'),JSON.stringify(record,null,2)+'\n');if(code!==0||problem)throw new Error(problem??stderr);return value;
}
