      "path": "native-server.mjs",
      "sha256": "ee907ce6602484dba8b2fd2992bf249ab65bdef60ea2f2a79f9f48e57381336f",
      "bytes": 8827,
      "sourceSnapshot": "import {randomUUID} from 'node:crypto';\nimport {importWorkflow,preflight,createExecution,advanceExecution,validateExecution,NativeError,redact,bounded,LIMITS} from './native.mjs';\nconst sessions=new WeakMap(),live=new Set(),index='automation.native.index',jobs='automation.native.jobs';\nfunction id(value){if(typeof value!=='string'||!/^[A-Za-z0-9_-]{1,80}$/.test(value))throw new Error('Invalid native identifier');return value;}\nfunction publicRun(run){const{workflow,pending,activeNode,...result}=run;delete result.activeMs;const clean=redact(result);try{bounded(clean,LIMITS.executionBytes,{undefinedValues:true});}catch{clean.outputs={};clean.outputsLimited=true;}return clean;}\nfunction queue(state,operation){const next=state.queue.catch(()=>{}).then(operation);state.queue=next;return next;}\nasync function persist(state,run){bounded(run,LIMITS.executionBytes,{undefinedValues:true});await queue(state,async()=>{let stored=run;if(['completed','failed','cancelled','interrupted'].includes(run.status)){const visible=publicRun(run);stored={...run,outputs:visible.outputs,trace:visible.trace};try{bounded(stored,LIMITS.executionBytes,{undefinedValues:true});}catch{stored.outputs={};stored.outputsLimited=true;}}await state.store.set(`automation.native.run.${run.id}`,stored);const key=`automation.native.history.${run.workflowId}`,previous=await state.store.get(key,[]);let history=[...previous.filter(value=>value.id!==run.id),publicRun(run)].slice(-50);while(history.length>1&&Buffer.byteLength(JSON.stringify(history))>12*1024*1024)history.shift();await state.store.set(key,history);});}\nfunction schedule(state,run){if(state.closed||run.status!=='waiting')return;const delay=Date.parse(run.waitUntil)-Date.now();if(!Number.isFinite(delay)||delay>LIMITS.waitMs+1000)throw new Error('Invalid persisted wait interval');clearTimeout(state.timers.get(run.id));const timer=setTimeout(async()=>{state.timers.delete(run.id);if(state.closed)return;try{const fresh=await state.store.get(`automation.native.run.${run.id}`,null);if(fresh?.status==='waiting')begin(state,fresh);}catch(error){state.errors.set(run.id,error.message);}},Math.max(0,delay));timer.unref?.();state.timers.set(run.id,timer);}\nfunction begin(state,run){validateExecution(run);if(state.running.has(run.id))return state.running.get(run.id);clearTimeout(state.timers.get(run.id));state.timers.delete(run.id);const controller=new AbortController(),active={run,controller};state.running.set(run.id,active);active.promise=(async()=>{try{const check=preflight(run.workflow);if(!check.executable)throw new Error('Persisted workflow no longer passes native preflight');await advanceExecution(run,{signal:controller.signal,checkpoint:value=>persist(state,value)});if(run.status==='waiting')schedule(state,run);return publicRun(run);}catch(error){run.status='failed';run.error={code:'NATIVE_PERSISTENCE',message:error.message};run.pending=[];try{await persist(state,run);}catch{}return publicRun(run);}finally{state.running.delete(run.id);if(run.status!=='waiting')state.openRuns.delete(run.id);}})();return active;}\nasync function session(store,workspace){let state=sessions.get(store);if(!state){state={store,workspace,queue:Promise.resolve(),running:new Map(),timers:new Map(),errors:new Map(),openRuns:new Set(),closed:false};sessions.set(store,state);live.add(state);state.ready=(async()=>{const runIds=await store.get(jobs,[]);if(!Array.isArray(runIds)||runIds.length>1000)throw new Error('Invalid native execution index');for(const runId of runIds){const run=await store.get(`automation.native.run.${id(runId)}`,null);if(!run)continue;validateExecution(run);if(run.id!==runId)throw new Error('Persisted execution ID mismatch');if(run.status==='waiting'){if(state.openRuns.size>=16)throw new Error('Native concurrent execution count exceeds 16');state.openRuns.add(run.id);schedule(state,run);}else if(run.status==='running'||run.status==='ready'){run.status='interrupted';run.error={code:'NATIVE_INTERRUPTED',message:'Host ended during a node operation; effects are not automatically replayed'};run.pending=[];await persist(state,run);}}})();}await state.ready;return state;}\nexport async function handleNative({action,input={},store,workspace}){\n input=structuredClone(bounded(input,LIMITS.documentBytes+4096,{undefinedValues:true}));\n const state=await session(store,workspace);if(state.closed)throw new Error('Native execution session is closed');\n if(action==='native-list'){const ids=await store.get(index,[]);if(!Array.isArray(ids)||ids.length>1000)throw new Error('Invalid native workflow index');const workflows=[];for(const value of ids){const record=await store.get(`automation.native.workflow.${id(value)}`,null);if(record)workflows.push({id:record.id,revision:record.revision,name:record.workflow.name,updatedAt:record.updatedAt});}return{workflows};}\n if(action==='native-save')return queue(state,async()=>{const workflow=importWorkflow(input.workflow),workflowId=input.id?id(input.id):randomUUID(),key=`automation.native.workflow.${workflowId}`,previous=await store.get(key,null);if(previous&&input.expectedRevision!==previous.revision)throw new Error('Native workflow revision changed; reload before saving');if(!previous&&input.expectedRevision!==undefined&&input.expectedRevision!==0)throw new Error('Native workflow does not exist');const indexed=await store.get(index,[]);if(!Array.isArray(indexed)||(!previous&&indexed.length>=1000))throw new Error('Native saved workflow count exceeds 1,000');const record={id:workflowId,revision:(previous?.revision??0)+1,workflow,updatedAt:new Date().toISOString()};await store.set(key,record);const ids=await store.get(index,[]);if(!ids.includes(workflowId))await store.set(index,[...ids,workflowId]);return{record:structuredClone(record),preflight:preflight(workflow)};});\n if(action==='native-get'){const value=await store.get(`automation.native.workflow.${id(input.id)}`,null);if(!value)throw new Error('Native workflow not found');const record=structuredClone(value);return{record,preflight:preflight(record.workflow)};}\n if(action==='native-validate')return preflight(input.workflow);\n if(action==='native-history')return{runs:structuredClone(await store.get(`automation.native.history.${id(input.id)}`,[]))};\n if(action==='native-start'||action==='native-run'){const record=await store.get(`automation.native.workflow.${id(input.id)}`,null);if(!record)throw new Error('Native workflow not found');const run={...createExecution(record.workflow),workflowId:record.id,revision:record.revision};await queue(state,async()=>{const ids=await store.get(jobs,[]);if(!Array.isArray(ids)||ids.length>=1000)throw new Error('Native saved execution count exceeds 1,000; no automatic state deletion is available');if(state.openRuns.size>=16)throw new Error('Native concurrent execution count exceeds 16');state.openRuns.add(run.id);try{await store.set(`automation.native.run.${run.id}`,run);await store.set(jobs,[...ids,run.id]);}catch(error){state.openRuns.delete(run.id);throw error;}});const active=begin(state,run);return{run:action==='native-run'?await active.promise:publicRun(run)};}\n if(action==='native-status'){const runId=id(input.runId),active=state.running.get(runId);let run=active?.run??await store.get(`automation.native.run.${runId}`,null);if(!run||run.workflowId!==id(input.id))throw new Error('Native execution not found');if(state.errors.has(runId))throw new Error(state.errors.get(runId));if(!active&&run.status==='waiting'&&Date.parse(run.waitUntil)<=Date.now())run=begin(state,run).run;return{run:publicRun(run)};}\n if(action==='native-cancel'){const runId=id(input.runId),active=state.running.get(runId);const run=active?.run??await store.get(`automation.native.run.${runId}`,null);if(!run||run.workflowId!==id(input.id))throw new Error('Native execution not found');if(active){active.controller.abort(new NativeError('Execution cancelled','NATIVE_CANCELLED'));return{run:await active.promise};}if(run.status!=='waiting')throw new Error('Native execution is not active');clearTimeout(state.timers.get(runId));state.timers.delete(runId);state.openRuns.delete(runId);run.status='cancelled';run.pending=[];delete run.waitUntil;run.finishedAt=new Date().toISOString();await persist(state,run);return{run:publicRun(run)};}\n throw new Error('Unknown native Automation action');\n}\nexport async function disposeNative(workspace){for(const state of [...live])if(!workspace||state.workspace===workspace){state.closed=true;for(const timer of state.timers.values())clearTimeout(timer);state.timers.clear();for(const active of state.running.values())active.controller.abort(new NativeError('Host shutdown interrupted execution','NATIVE_INTERRUPTED'));await Promise.allSettled([...state.running.values()].map(value=>value.promise));await state.queue;live.delete(state);sessions.delete(state.store);}}\n"
    }
  },
