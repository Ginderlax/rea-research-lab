          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.9b443cfa787c38853e5a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Prometheus provides a built-in metric called `up` for every scrape target, a simple method to indicate whether scraping is successful:",
      "headingPath": [
        "Handle connectivity errors in alerts",
        "Detect target availability with the Prometheus `up` metric"
      ],
      "source": {
        "path": "docs/sources/alerting/guides/connectivity-errors.md",
        "gitBlobSha": "ac013ad7e78eb6f989a82991e5d246600a3e436d",
        "sha256": "a3943a943a9907ac7c1b3b13ba6b8f1519bbda6b9a19cf01591f2ade20d35b63",
