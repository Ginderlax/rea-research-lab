    },
    {
      "id": "grafana.candidate.182ac36c306f832e266c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Currently only supported for Prometheus data sources. The `$__rate_interval` variable is meant to be used in the rate function. Refer to [Prometheus query variables](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/prometheus/template-variables/#use-__rate_interval) for details.",
      "headingPath": [
        "Global variables",
        "`$__rate_interval`"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/variables/global-variables.md",
        "gitBlobSha": "47197c2d57632cafd89e881be4dbd3d8f67f4bca",
        "sha256": "96d599ac5546da4d5eff868adb4c39ebca5e8cd399dad64323c6d6aac90cab33",
        "lineStart": 94,
        "lineEnd": 94,
