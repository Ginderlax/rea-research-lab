import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const base=path.resolve(import.meta.dirname,'..'),lab=path.join(base,'outputs/rea-research-lab'),owned=path.join(base,'work/notes-inline-production-installation-next'),prefix='products/rea-studio/apps/notes/results/inline-confirmation-followup/',recordPrefix='products/rea-studio/results/notes-inline-reviewed-production-installation-20261013/',sha=b=>createHash('sha256').update(b).digest('hex');
function names(root,rel=''){return fs.readdirSync(path.join(root,rel),{withFileTypes:true}).flatMap(e=>{assert.ok(!e.isSymbolicLink());const n=rel?rel+'/'+e.name:e.name;return e.isDirectory()?names(root,n):[n];}).sort();}
function read(root,n,row){assert.ok(n&&!path.isAbsolute(n)&&!n.includes('..')&&!n.includes('\\'));const b=fs.readFileSync(path.join(root,n));if(row){assert.equal(b.length,row.bytes);assert.equal(sha(b),row.sha256);}return b;}
function frozen(folder,name,pin,count){const root=path.join(base,'work',folder),b=read(root,name);assert.equal(sha(b),pin);const m=JSON.parse(b),rows=Object.entries(m.inventory).map(([path,r])=>({path,...r}));assert.equal(rows.length,count);assert.deepEqual(names(root),[...rows.map(r=>r.path),name].sort());for(const r of rows)read(root,r.path,r);return{folder,root,rows:[...rows,{path:name,bytes:b.length,sha256:pin}]};}
const correction=frozen('notes-inline-browser-qualification-fix-next','freeze-manifest.json','913cfe7fbd41c638a624483deca1713c8fb4df44e56d65a0f3fe6458b606cf0a',31),sourceReview=frozen('notes-inline-publication-plan-independent-review','review-manifest.json','e1fd6f5b68e91a18bab40c018379e2603270bb8837e733fb2fb40b76dc2c9b44',46),correctionReview=frozen('notes-inline-browser-qualification-independent-review','review-manifest.json','b52075922191c225b74464789b37537ff02cedc379ea4a96d2d49f5fa142bd3d',14),copies=[];
function copy(root,n,destination,row,epoch){const b=read(root,n,row),p=path.join(lab,destination);assert.equal(fs.existsSync(p),false);fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,b,{flag:'wx'});copies.push({sourcePath:n,path:destination,bytes:b.length,sha256:sha(b),epoch,inert:true});}
for(const r of correction.rows)copy(correction.root,r.path,prefix+'browser-qualification-correction/frozen/'+r.path+'.snapshot',r,'browser-qualification-correction');
for(const [stage,role]of[[sourceReview,'source-plan-independent-review'],[correctionReview,'qualification-independent-review']])for(const r of stage.rows)copy(stage.root,r.path,recordPrefix+role+'/frozen/'+r.path+'.snapshot',r,role);
const installation=JSON.parse(read(owned,'installation.json'));assert.equal(installation.applicationMutations,8);assert.equal(installation.publicSnapshots,836);for(const r of installation.copies)read(lab,r.path,r);for(const r of installation.installed)read(lab,r.destination,r.after);for(const n of names(owned))copy(owned,n,recordPrefix+'root-installation/frozen/'+n+'.snapshot',null,'root-installation');
copy(path.dirname(import.meta.filename),path.basename(import.meta.filename),recordPrefix+'preservation-collector.mjs.snapshot',null,'root-preservation');
const record={schema:'rea-notes-inline-reviewed-installation-public-preservation/v1',at:new Date().toISOString(),installationCopies:836,qualificationCorrectionCopies:32,corePublicAliases:868,sourcePlanReviewCopies:47,qualificationReviewCopies:15,rootInstallationCopies:copies.filter(r=>r.epoch==='root-installation').length,allSourceStagesStrict:true,installedFiles:8,existingReplacements:6,newTests:2,behaviorTestsExecutedByPreservation:0,originalExecutions:0,browserExecutions:0,backendChanged:false,originalReceiptsRebound:false,sourceQualificationOriginalEc58Unchanged:true,localCarriersNotPublished:true,fullParity:false,superiority:false,copies};const b=Buffer.from(JSON.stringify(record,null,2)+'\n');fs.writeFileSync(path.join(lab,recordPrefix,'preservation-manifest.json'),b,{flag:'wx'});console.log(JSON.stringify({rootRecord:recordPrefix+'preservation-manifest.json',sha256:sha(b),corePublicAliases:868,reviewCopies:62,rootInstallationCopies:record.rootInstallationCopies,publicSnapshotsNew:copies.length,installedFiles:8}));
