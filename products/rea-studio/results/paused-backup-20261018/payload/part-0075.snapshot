    {
      "id": "grafana.candidate.5a1dc14b12217c8c5001",
      "syntaxRole": "table-row",
      "sourceText": "| `value`       | Conditional               | Plaintext secret value, 1 to 24,576 bytes. Sensitive and [write-only](https://developer.hashicorp.com/terraform/language/resources/ephemeral#write-only-arguments) in Terraform 1.11 or later. Sent to Grafana on apply but never written to state or plan files. Set exactly one of `value` or `ref`. |",
      "headingPath": [
        "Use Terraform to provision secure values",
        "Define a secure value",
        "Schema reference"
      ],
      "source": {
        "path": "docs/sources/as-code/infrastructure-as-code/terraform/terraform-secrets-management.md",
        "gitBlobSha": "52977e9c09c75dbafbdbbdb7ab05a511e921e281",
        "sha256": "408746cac5de95be048c327c72a92ce56e80f5a9bcb4614d2ab66a4dc946630b",
        "lineStart": 188,
        "lineEnd": 188,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/as-code/infrastructure-as-code/terraform/terraform-secrets-management.md#L188-L188"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.167d157972d34b5baf4b",
      "syntaxRole": "table-row",
      "sourceText": "| `ref`         | Conditional               | Reference to a secret already stored in a third-party keeper, 1 to 1,024 characters. Valid only when the active keeper for the namespace isn't the system keeper. Set exactly one of `value` or `ref`.                                                                                                 |",
      "headingPath": [
        "Use Terraform to provision secure values",
        "Define a secure value",
        "Schema reference"
      ],
      "source": {
        "path": "docs/sources/as-code/infrastructure-as-code/terraform/terraform-secrets-management.md",
        "gitBlobSha": "52977e9c09c75dbafbdbbdb7ab05a511e921e281",
        "sha256": "408746cac5de95be048c327c72a92ce56e80f5a9bcb4614d2ab66a4dc946630b",
        "lineStart": 189,
        "lineEnd": 189,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/as-code/infrastructure-as-code/terraform/terraform-secrets-management.md#L189-L189"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.33a126d0dd8a6dc7f352",
      "syntaxRole": "table-row",
      "sourceText": "| `decrypters`  | No                        | List of services permitted to decrypt this secure value. Up to 64 unique entries. Each entry must be a valid Kubernetes label value: letters, numbers, and the characters `.`, `-`, and `_`, with no slashes or spaces. For more information, refer to [Decrypters](#decrypters).                      |",
      "headingPath": [
        "Use Terraform to provision secure values",
        "Define a secure value",
        "Schema reference"
      ],
      "source": {
        "path": "docs/sources/as-code/infrastructure-as-code/terraform/terraform-secrets-management.md",
        "gitBlobSha": "52977e9c09c75dbafbdbbdb7ab05a511e921e281",
        "sha256": "408746cac5de95be048c327c72a92ce56e80f5a9bcb4614d2ab66a4dc946630b",
        "lineStart": 190,
        "lineEnd": 190,
