import test,{after}from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import path from'node:path';
import{layoutSelection}from'../sketch-alignment-next/products/rea-studio/apps/sketch/layout.mjs';import{validateScene,importExcalidraw,exportExcalidraw,selectGroup}from'../sketch-alignment-next/products/rea-studio/apps/sketch/core.mjs';
import{createOriginalOracle,negativeZeroPaths}from'./original-oracle.mjs';import{shape,scene,signedGeometry,nested,collision,overlapOrders,boundary,nativeDocument,nativeRect,originalElements}from'./fixtures.mjs';
const oracle=await createOriginalOracle(),packets=[],ops=['x','y'].flatMap(axis=>[...['start','center','end'].map(position=>({kind:'align',axis,position})),{kind:'distribute',axis}]);
const positions=shapes=>shapes.map(s=>({id:s.id,x:s.x,y:s.y})).sort((a,b)=>a.id.localeCompare(b.id));
function compare(input,op,ids=input.shapes.map(s=>s.id)){const before=structuredClone(input),expanded=new Set(ids.flatMap(id=>selectGroup(input.shapes,id))),selected=input.shapes.filter(s=>expanded.has(s.id)),elements=originalElements({shapes:selected}),expected=op.kind==='align'?oracle.align(elements,op):oracle.distribute(elements,{axis:op.axis,space:'between'}),result=layoutSelection(input,ids,op),actual=result.scene.shapes.filter(s=>expanded.has(s.id)),row={input:structuredClone(input),ids,op,actual:positions(actual),expected:positions(expected),signedZero:{actual:negativeZeroPaths(positions(actual)),expected:negativeZeroPaths(positions(expected))},groupCount:result.groupCount};packets.push(row);assert.deepEqual(row.actual,row.expected);assert.deepEqual(input,before);for(const s of result.scene.shapes)if(!expanded.has(s.id))assert.deepEqual(s,input.shapes.find(x=>x.id===s.id));return result;}
after(()=>{const target=process.env.SKETCH_REVIEW_OBSERVATIONS;assert.ok(target);fs.mkdirSync(path.dirname(target),{recursive:true});fs.writeFileSync(target,JSON.stringify({schema:'rea-sketch-alignment-independent-original-observations/v1',packets,original: {contracts:oracle.contracts,counts:oracle.counts,selectedSourceSlices:oracle.selectedSourceSlices,compiledOriginalDeclarations:oracle.compiledOriginalDeclarations,sourceUnits:oracle.sourceUnits,vmCompilations:oracle.vmCompilations,codeSHA256:oracle.codeSHA256,adapters:oracle.adapters,exactMutationHelpersExecuted:oracle.exactMutationHelpersExecuted,observations:oracle.observations},originalGUI:0,benchmarks:0,fullParity:false},null,2)+'\n',{flag:'wx'});console.log('INDEPENDENT_ORIGINAL_ACTION_PAIRS '+packets.length);});
test('all eight actions match original signed line and freehand point geometry',()=>{for(const op of ops)compare(signedGeometry(),op);});
test('outer nested groups and literal group-ID/shape-ID collision match original units',()=>{for(const input of[nested(),collision()]){const elements=originalElements(input),expected=oracle.groups(elements),result=layoutSelection(input,input.shapes.map(s=>s.id),ops[0]);assert.equal(result.groupCount,expected.length);for(const op of ops)compare(input,op);}for(const op of ops){const r=compare(nested(),op,['inner-a','isolated']);assert.equal(r.groupCount,2);assert.deepEqual(r.scene.shapes[1].groupIds,['inner','outer']);}});
test('negative-gap unusual anchor order and same-wide-group anchors match literal original behavior',()=>{for(const input of overlapOrders())for(const axis of['x','y']){const transposed=axis==='x'?input:scene(input.shapes.map(s=>({...s,x:s.y,y:s.x,w:s.h,h:s.w})));compare(transposed,{kind:'distribute',axis});}});
test('fractional geometry and signed-zero coordinates match without numeric normalization',()=>{const inputs=[scene([shape('a',1/3,-0,1/7,1/11),shape('b',2/3,-0,-1/9,-1/13,{type:'line'}),shape('c',4/3,0.3,0.2,0.1)]),scene([shape('a',-0,-0,0,0),shape('b',0.1,0.2,0.01,0.03),shape('c',0.6,0.7,0.13,0.17)]),scene([shape('a',0.1,0.1,0,0,{type:'freedraw',points:[[0.2,0.3],[-0.04,-0.05]]}),shape('b',0.7,0.9,0.11,0.12),shape('c',1.3,1.2,-0.6,-0.7,{type:'line'})])];for(const input of inputs)for(const op of ops)compare(input,op);});
test('partial outer selection expands; empty/single-unit selections are stable no-ops',()=>{const input=nested();for(const ids of[[],['inner-a']]){const before=structuredClone(input),r=layoutSelection(input,ids,ops[0]);assert.deepEqual(r.scene,validateScene(input));assert.deepEqual(r.changedIds,[]);assert.deepEqual(input,before);}const r=layoutSelection(input,['inner-a','isolated'],{kind:'align',axis:'y',position:'end'});assert.equal(r.scene.shapes[1].y-r.scene.shapes[0].y,5);assert.equal(r.scene.shapes[2].y-r.scene.shapes[0].y,-10);});
test('overflow and malformed requests reject without partially changing caller data',()=>{const input=boundary(),before=structuredClone(input);assert.throws(()=>layoutSelection(input,input.shapes.map(s=>s.id),{kind:'align',axis:'x',position:'end'}),/coordinate/);for(const ids of[['small','small'],['missing'],null,[7]])assert.throws(()=>layoutSelection(input,ids,ops[0]));for(const op of[{kind:'rotate',axis:'x'},{kind:'align',axis:'z',position:'start'},{kind:'align',axis:'x',position:'invalid'}])assert.throws(()=>layoutSelection(input,['small','max'],op));assert.deepEqual(input,before);});
test('native projection preserves opaque and unknown fields; geometry/version updates survive repeated roundtrips',()=>{const document=nativeDocument([nativeRect('a',10,20,10,10,{groupIds:['inner','outer']}),nativeRect('b',40,40,20,10,{groupIds:['outer']}),nativeRect('c',180,130,30,40),nativeRect('opaque',333,444,20,30,{type:'image',fileId:'ownedOpaque',unknownOpaque:{keep:true}}),nativeRect('deleted',77,88,99,11,{isDeleted:true,groupIds:['outer']})]),input=importExcalidraw(document,'Owned native'),before=structuredClone(input),r=layoutSelection(input,['a','c'],{kind:'align',axis:'y',position:'end'}),out=exportExcalidraw(r.scene);assert.deepEqual(input,before);for(const k of['appState','files','unknownOwnedDocument'])assert.deepEqual(out[k],document[k]);for(const e of out.elements){const old=document.elements.find(x=>x.id===e.id),s=r.scene.shapes.find(x=>x.id===e.id);if(!s||!r.changedIds.includes(e.id))assert.deepEqual(e,old);else assert.deepEqual(e,{...old,x:s.x,y:s.y,version:old.version+1});}const reopened=importExcalidraw(out,'Owned native reopened');assert.deepEqual(positions(reopened.shapes),positions(r.scene.shapes));assert.deepEqual(exportExcalidraw(reopened),out);});
test('opaque mixed groups and selected external binding refuse; unrelated or deleted records remain inert',()=>{for(const extra of[{type:'image',groupIds:['outer']},{boundElements:[{id:'bound',type:'arrow'}]}]){const doc=nativeDocument([nativeRect('a',0,10,20,10,{groupIds:['outer']}),nativeRect('b',200,80,20,10),nativeRect('constraint',30,20,10,10,extra)]),input=importExcalidraw(doc,'Constraints'),before=structuredClone(input);const ids=extra.boundElements?['constraint','b']:['a','b'];assert.throws(()=>layoutSelection(input,ids,ops[0]),/non-editable|external bindings/);assert.deepEqual(input,before);}const doc=nativeDocument([nativeRect('a',0,10,20,10),nativeRect('b',200,80,20,10),nativeRect('constraint',30,20,10,10,{boundElements:[{id:'bound',type:'arrow'}]})]),input=importExcalidraw(doc,'Unrelated');assert.deepEqual(exportExcalidraw(layoutSelection(input,['a','b'],ops[0]).scene).elements[2],doc.elements[2]);});
