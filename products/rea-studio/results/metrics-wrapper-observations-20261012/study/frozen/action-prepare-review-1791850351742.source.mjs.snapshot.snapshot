import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),source=path.resolve(here,'../metrics-wrapper-measurement-next'),sha=bytes=>createHash('sha256').update(bytes).digest('hex');
const fp=async file=>{const bytes=await fs.readFile(file);return {bytes:bytes.length,sha256:sha(bytes)};},copies=[];
async function copy(file,relative,expected){const bytes=await fs.readFile(file),record={bytes:bytes.length,sha256:sha(bytes)};if(expected)assert.deepEqual(record,expected);assert.ok(!relative.split('/').some(part=>['.local','work','artifacts','tooling','node_modules'].includes(part)));assert.ok(!/\.(?:tgz|exe)$/i.test(relative));const output=path.join(here,relative);await fs.mkdir(path.dirname(output),{recursive:true});await fs.writeFile(output,bytes,{flag:'wx'});assert.deepEqual(await fp(output),record);copies.push({sourcePath:file,path:relative,...record});}
const freezeBytes=await fs.readFile(path.join(source,'freeze-manifest.json')),freeze=JSON.parse(freezeBytes);assert.equal(sha(freezeBytes),'6bb39d2051d18147987ff2028d349b219f279d48216159ff00f5d7f2bc7858c3');assert.equal(Object.keys(freeze.inventory).length,2426);
const before={};for(const [name,record]of Object.entries(freeze.inventory)){assert.deepEqual(await fp(path.join(source,name)),record);before[name]=record;}
for(const [name,record]of Object.entries(freeze.inventory))if(!name.startsWith('preserved/latest-mixed-study/'))await copy(path.join(source,name),'preserved/readiness/'+name+'.snapshot',record);
await copy(path.join(source,'readiness-validation.json'),'preserved/readiness/readiness-validation.json.snapshot',{bytes:623413,sha256:'705c4540bb54ef37e6b396ed9082aaf7ffe4d944b362b03ac85bd0d76ec3c32c'});
await copy(path.join(source,'freeze-manifest.json'),'preserved/readiness/freeze-manifest.json.snapshot',{bytes:freezeBytes.length,sha256:sha(freezeBytes)});
const results=await fs.readdir(path.join(source,'results')),added=results.map(name=>'results/'+name).filter(name=>!Object.hasOwn(freeze.inventory,name));assert.equal(added.length,887);
for(const name of added)await copy(path.join(source,name),'preserved/observations/'+name.slice('results/'.length)+'.snapshot');
const reviews=[['metrics-wrapper-root-independent-review','179e382463cb0206c60ddc12f304a63baf3af3c856d0a4de670d796a9f36eca9'],['metrics-wrapper-readiness-independent-review','c82d95b1345fd15ac67d589cf9bfca524694312d6b44d592b777fbe12e03df99']];
for(const [folder,digest]of reviews){const root=path.resolve(here,'../'+folder);assert.equal((await fp(path.join(root,'review-validation.json'))).sha256,digest);for(const name of await fs.readdir(root))await copy(path.join(root,name),'preserved/independent-reviews/'+folder+'/'+name+'.snapshot');}
const rootStdout=path.resolve(here,'../metrics-wrapper-root-review.stdout.txt');await copy(rootStdout,'preserved/independent-reviews/metrics-wrapper-root-review.stdout.txt.snapshot');
const repo=path.resolve(here,'../../outputs/rea-research-lab'),publicationCommit='455ab6c46461981e6e4331ba5612d5362bf4ad22',publicHistory=[];
for(const [folder,digest]of [['metrics-algorithm-observations-20261012','57d49c9109a10d602aaa41bf8c848cebe6a97fb9a849b4e3e05635f8ca395a9f'],['metrics-selector-observations-20261012','ca303cb73784e197557b3b626fa437d8b5775afe7448e6c6a5d097e9fad6286d']]){const relative='products/rea-studio/results/'+folder+'/preservation-manifest.json',file=path.join(repo,relative),record=await fp(file);assert.equal(record.sha256,digest);await copy(file,'preserved/public-history-manifests/'+folder+'.json.snapshot',record);publicHistory.push({publicationCommit,repositoryRelativePath:relative,...record,fullTreeRecopied:false,referencedSnapshotTreeNotFreshlyScanned:true});}
const excluded=Object.keys(freeze.inventory).filter(name=>name.startsWith('preserved/latest-mixed-study/'));assert.equal(excluded.length,2218);
for(const [name,record]of Object.entries(before))assert.deepEqual(await fp(path.join(source,name)),record);
for(const record of copies){assert.deepEqual(await fp(record.sourcePath),{bytes:record.bytes,sha256:record.sha256});assert.deepEqual(await fp(path.join(here,record.path)),{bytes:record.bytes,sha256:record.sha256});}
for(const reference of publicHistory)assert.deepEqual(await fp(path.join(repo,reference.repositoryRelativePath)),{bytes:reference.bytes,sha256:reference.sha256});
const original=JSON.parse(await fs.readFile(path.join(source,'original-provenance.json'))),runtime=JSON.parse(await fs.readFile(path.join(source,'memory-preflight.control.json'))).runtime;
await fs.writeFile(path.join(here,'preservation.json'),JSON.stringify({schema:'rea-metrics-wrapper-review-preservation/v1',createdAt:new Date().toISOString(),readiness:{source,inventoryFiles:2426,beforeAfterAuthenticated:true,copiedInventoryFiles:208,readinessReceiptAndManifestCopied:true,omittedInertHistoryFiles:2218,omissionReason:'Already public exact negative studies are referenced by committed preservation manifest rather than recursively recopied.'},observations:{exactNewFiles:887,timingChildren:147,memoryChildren:147},completeWrapper86AlreadyInsideCopiedReadiness:true,publicHistory,copies,localOriginalExclusions:[...original.archives,{source:runtime.execPath,sha256:runtime.executableSHA256,reason:'Native runtime executable remains local; exact identity retained.'}],sourceOnly:true,newMeasurements:false,candidateIntegrated:false},null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({status:'authenticated; exact inert snapshots preserved',readinessFiles:2426,copiedReadinessFiles:210,omittedHistoryFiles:2218,newObservationFiles:887,copies:copies.length,publicReferences:publicHistory.length}));
