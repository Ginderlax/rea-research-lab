    {
      "id": "grafana.candidate.a9b7d99da9cac7441672",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If Users use the same email address in Google that they use with other authentication providers (such as Grafana.com), you need to do additional configuration to ensure that the users are matched correctly. Please refer to the [Using the same email address to login with different identity providers](../#using-the-same-email-address-to-login-with-different-identity-providers) documentation for more information.",
      "headingPath": [
        "Configure Google OAuth authentication"
      ],
