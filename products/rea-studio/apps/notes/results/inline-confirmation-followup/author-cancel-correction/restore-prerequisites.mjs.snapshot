import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const root=import.meta.dirname,source=path.resolve(root,'../notes-inline-confirmation-next'),hash=b=>createHash('sha256').update(b).digest('hex'),rows=JSON.parse(fs.readFileSync(path.join(root,'prior-authority/baseline-original-source31.json.snapshot')));assert.equal(rows.length,31);
for(const r of rows){const b=fs.readFileSync(path.join(source,r.path));assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);const p=path.join(root,r.path);assert.equal(fs.existsSync(p),false);fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,b,{flag:'wx'});}
fs.writeFileSync(path.join(root,'prerequisite-recovery.json'),JSON.stringify({schema:'rea-notes-cancel-correction-prerequisite-recovery/v1',at:new Date().toISOString(),copiedExactOriginalPrerequisites:rows,failedRun:'runs/focused-2026-10-13T01-47-53.074Z/attempt.json',failedSummary:{tests:69,pass:59,fail:10,skipped:0},cause:'Root preparation omitted31 inert original-helper prerequisite source/ledger copies. Ten selected tests failed ENOENT before those original helper invocations; no application defect is inferred. Failed source/raw/attempt are retained. No executable test or application source changes for prerequisite repair.',productionModified:false},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({copiedOriginalPrerequisites:31,runtimeChanged:false}));
