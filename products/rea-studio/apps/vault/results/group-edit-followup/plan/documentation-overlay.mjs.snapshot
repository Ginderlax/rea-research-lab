import assert from 'node:assert/strict';import {readFileSync,writeFileSync} from 'node:fs';import {resolve,posix} from 'node:path';import {createHash} from 'node:crypto';
const here=import.meta.dirname,id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),license=JSON.parse(readFileSync(resolve(here,'source-license-provenance.json'))).fullOriginalGPLLicense,changes=[];
function update(name,before,after){const path='proposed/'+name,b=readFileSync(resolve(here,path)),text=b.toString();assert.equal(text.split(before).length-1,1);const next=Buffer.from(text.replace(before,after));writeFileSync(resolve(here,path),next);changes.push({path,before,after,occurrences:1,beforeIdentity:id(b),afterIdentity:id(next),scope:'Declared per-app documentation overlay only; no runtime or case assertions changed.'});}
update('GROUP-EDIT-NOTICE.md',license.publicPath.replace('products/rea-studio/apps/vault/',''),posix.relative('products/rea-studio/apps/vault',license.publicPath));
update('GROUP-EDIT.md','Independent normal-browser/full-shared-host review remains required before installation/publication.','The historical885 host/browser evidence and corrected137 normal-browser/model evidence are qualified separately below. Source-bound installed validation and root publication approval remain required.');
update('README.md','Earlier343 and885 source epochs remain historical.','Earlier343 and885 source epochs remain historical. GROUP-RECYCLE.md describes the earlier343 recycle subset; its group create/edit gap is historical now that child creation and name/notes are supplied here. Tag/settings controls and broader group management remain open.');
const plan=JSON.parse(readFileSync(resolve(here,'installation-plan.json')));for(const r of plan.rows.filter(r=>r.kind==='documentation-overlay'))r.after=id(readFileSync(resolve(here,r.source)));writeFileSync(resolve(here,'installation-plan.json'),JSON.stringify(plan,null,2)+'\n');
writeFileSync(resolve(here,'documentation-deltas.json'),JSON.stringify({sourceOnly:true,changes,initialGeneratedDocsRetained:'initial-documentation',exactInverseRequired:true,initialLinkDefect:'The initial generated GPL link used a repository-relative path inside an app-relative document; corrected to the exact relative public alias.',productionWrites:0},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({sourceOnly:true,documentationSubstitutions:3,liveTargetsUnchanged:16,productionWrites:0}));
