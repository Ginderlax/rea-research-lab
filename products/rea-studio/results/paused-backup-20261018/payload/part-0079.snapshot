      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.072620863708a534d34e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Time series data is expected to contain unique timestamps for each data point within a series. If multiple points in the same series share the same timestamp, the visualization might not render or behave as expected.",
      "headingPath": [
        "Time series",
        "Supported data formats"
