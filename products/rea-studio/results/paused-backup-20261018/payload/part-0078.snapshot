    {
      "id": "grafana.candidate.0116274df90aae427100",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can use `if` statements in templates. For example, you can print `Variable empty` when a variable is empty:",
      "headingPath": [
        "If"
      ],
      "source": {
        "path": "docs/sources/shared/alerts/template-language.md",
