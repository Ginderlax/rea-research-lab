    {
      "id": "grafana.candidate.ec90204d8419b30b9cf9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In Grafana v11, support for deprecated endpoints and fields in **Reporting** related to the old scheduling format, email, and dashboard is fully removed. This prevents any calls to deprecated endpoints and passing in values to deprecated fields. This feature only affects Cloud and Enterprise customers who use the API to generate reports.",
      "headingPath": [
        "Breaking changes in Grafana v11.0",
        "Users and Operators",
        "Deprecated endpoints and fields in Reporting removed",
        "Description"
      ],
      "source": {
