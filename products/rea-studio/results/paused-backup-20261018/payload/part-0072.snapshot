const entries=[];
fs.mkdirSync(path.join(root,'artifacts/analysis-input'),{recursive:true});
for(const name of exports){
 const found=find(path.join(prod,'index.js'),name);console.log(name,found.local,found.file,found.text);
 fs.writeFileSync(path.join(root,'artifacts/analysis-input',name+'.js'),(found.isFunction?'':'var ')+found.text+';\nexport { '+found.local+' as '+name+' };\n');
 const {text,...metadata}=found;entries.push({publicExport:name,...metadata,file:path.relative(root,found.file).replaceAll('\\','/')});
}
