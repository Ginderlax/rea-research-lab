    },
    {
      "id": "grafana.candidate.368c23dd575749379566",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The number of anonymous devices is not limited by default. The configuration option `device_limit` allows you to enforce a limit on the number of anonymous devices. This enables you to have greater control over the usage within your Grafana instance and keep the usage within the limits of your environment. Once the limit is reached, any new devices that try to access Grafana will be denied access.",
      "headingPath": [
        "Anonymous authentication",
        "Anonymous devices"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/anonymous-auth/index.md",
        "gitBlobSha": "27c65e7bd028472cdead8f8e346ca73fb86fdb34",
