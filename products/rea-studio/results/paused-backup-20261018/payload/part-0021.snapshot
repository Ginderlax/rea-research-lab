    if r['path'] in transitions: assert transitions[r['path']]['after']==r['after']
    else: pin(source(r['path']),r['after'])
assert len([r for r in transitions.values() if r['before']])==3
assert len([r for r in transitions.values() if r['before'] is None])==4
for r in transitions.values():
    pin(source(r['afterImage']['path']),r['after']); pin(source(r['afterImage']['path']),r['afterImage'])
