import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
import {handle} from '../editor-search-path-fix-next/products/rea-studio/apps/editor/server.mjs';import {createWorkspace} from '../editor-search-path-fix-next/products/rea-studio/lib/storage.mjs';
const sha=value=>createHash('sha256').update(value).digest('hex'),deferred=()=>{let resolve;const promise=new Promise(r=>resolve=r);return{promise,resolve};};let sequence=0;
async function scenario(id,initialNext=false,mutate=false){const folder=path.join(import.meta.dirname,'runs',id+'-'+Date.now()+'-'+sequence++),base=await createWorkspace(path.join(folder,'workspace'));await fs.writeFile(base.resolve('a.txt'),'original\n');await fs.writeFile(base.resolve('b.txt'),'protected B\n');const revision=sha('original\n'),nextRevision=sha('first committed\n'),arrived=deferred(),release=deferred();let resolves=0;const workspace={...base,resolve:async name=>{const checked=base.resolve(name);if(++resolves===2){arrived.resolve();await release.promise;}return checked;}};const first=handle({action:'save',input:{path:'a.txt',content:'first committed\n',revision},workspace});await arrived.promise;const input={path:'a.txt',content:'second captured\n',revision:initialNext?nextRevision:revision},initial=structuredClone(input);let settled=false;const second=handle({action:'save',input,workspace}).then(result=>{settled=true;return{accepted:true,result};},error=>{settled=true;return{accepted:false,error:error.message};});await new Promise(resolve=>setImmediate(resolve));assert.equal(resolves,3);assert.equal(settled,false);if(mutate){input.revision=nextRevision;input.path='b.txt';input.content='caller mutation must not change captured content\n';}release.resolve();const firstResult=await first,secondResult=await second,diskA=await fs.readFile(base.resolve('a.txt'),'utf8'),diskB=await fs.readFile(base.resolve('b.txt'),'utf8'),observation={id,initial,afterCallerMutation:input,revision,nextRevision,firstResult,secondResult,diskA,diskB,resolves,actualRealSaveHandlers:true,heldInsideFirstExclusiveCallback:true,httpRequest:false};await fs.writeFile(path.join(folder,'observation.json'),JSON.stringify(observation,null,2)+'\n',{flag:'wx'});return observation;}
test('queued Save keeps its originally stale revision even when caller mutates the input object',async()=>{const result=await scenario('mutated-stale',false,true);assert.equal(result.firstResult.revision,result.nextRevision);assert.equal(result.secondResult.accepted,false,'The initially stale precondition was bypassed by queued caller input mutation');assert.match(result.secondResult.error,/File changed since/);assert.equal(result.diskA,'first committed\n');assert.equal(result.diskB,'protected B\n');});
test('control: unchanged queued stale precondition rejects after first commit',async()=>{const result=await scenario('unchanged-stale');assert.equal(result.secondResult.accepted,false);assert.match(result.secondResult.error,/File changed since/);assert.equal(result.diskA,'first committed\n');assert.equal(result.diskB,'protected B\n');});
test('control: queued precondition declared as the next revision succeeds with captured path and content',async()=>{const result=await scenario('declared-next',true,true);assert.equal(result.secondResult.accepted,true);assert.equal(result.secondResult.result.content,'second captured\n');assert.equal(result.secondResult.result.path,'a.txt');assert.equal(result.diskA,'second captured\n');assert.equal(result.diskB,'protected B\n');});
