    {
      "id": "grafana.candidate.3157cd605e6a62ff4dcd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For Tempo, refer to [Trace correlations](/docs/grafana/<GRAFANA_VERSION>/datasources/tempo/configure-tempo-data-source/trace-correlations/) for configuration instructions.",
      "headingPath": [
