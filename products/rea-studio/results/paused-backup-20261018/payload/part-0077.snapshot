    {
      "id": "grafana.candidate.619fb0761f4638849481",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Enable automated log rotation, valid options are `false` or `true`. Default is `true`. When enabled use the `max_lines`, `max_size_shift`, `daily_rotate` and `max_days` to configure the behavior of the log rotation.",
