    {
      "id": "grafana.candidate.bb1b9e79be27ceb8b6ab",
      "syntaxRole": "list-item",
      "sourceText": "- No validation is performed when you save a query, so it's possible to save an invalid query. You should confirm the query is working properly before you save it.",
      "headingPath": [
