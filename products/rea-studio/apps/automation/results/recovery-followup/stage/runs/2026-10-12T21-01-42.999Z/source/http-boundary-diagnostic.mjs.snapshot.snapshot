import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath,pathToFileURL} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const stage=path.dirname(fileURLToPath(import.meta.url)),hash=bytes=>createHash('sha256').update(bytes).digest('hex'),checkpoint=JSON.parse(await fs.readFile(path.join(stage,'historical/recovery-checkpoint-69.json.snapshot'))),runtime=path.join(stage,'.local/diagnostic69-runtime');await fs.mkdir(runtime,{recursive:true});
for(const name of ['native.mjs','routing.mjs']){const sourceName='products/rea-studio/apps/automation/'+name,row=checkpoint.sourceFingerprints.find(item=>item.path===sourceName),bytes=await fs.readFile(path.join(stage,checkpoint.runPath,'source',sourceName+'.snapshot'));assert.equal(hash(bytes),row.sha256);await fs.writeFile(path.join(runtime,name),bytes);}
const {executeNode,NativeError}=await import(pathToFileURL(path.join(runtime,'native.mjs'))),node=timeout=>({name:'HTTP',type:'n8n-nodes-base.httpRequest',parameters:{url:'http://127.0.0.1:1/owned',options:{timeout}}}),items=n=>Array.from({length:n},()=>({json:{}})),oldFetch=globalThis.fetch,oldPerformance=Object.getOwnPropertyDescriptor(globalThis,'performance'),observations=[];
for(const kind of ['expired-before-first','expired-between-items','expired-before-redirect','cancel-before-redirect','timeout-before-redirect']){
 let tick=0,calls=0;const controller=new AbortController(),budget={requests:0},context={executionBudget:budget,...(kind.startsWith('expired')?{deadline:kind==='expired-before-first'?-1:10}:{}),signal:controller.signal};Object.defineProperty(globalThis,'performance',{value:{now:()=>tick},configurable:true});
 globalThis.fetch=async()=>{calls++;if(kind==='expired-between-items')tick=20;if(kind.includes('redirect')&&calls===1)return{status:302,headers:new Headers({location:'/owned-redirect'}),body:{async cancel(){if(kind==='expired-before-redirect')tick=20;if(kind==='cancel-before-redirect')controller.abort(new NativeError('Owned cancel','NATIVE_CANCELLED'));if(kind==='timeout-before-redirect')await new Promise(done=>setTimeout(done,10));}}};return new Response('{}',{headers:{'content-type':'application/json'}});};
 let result;try{result={ok:true,value:await executeNode(node(kind==='timeout-before-redirect'?1:1000),items(kind==='expired-between-items'?2:1),context)};}catch(error){result={ok:false,code:error.code,message:error.message};}finally{globalThis.fetch=oldFetch;Object.defineProperty(globalThis,'performance',oldPerformance);}
 assert.equal(result.ok,true);assert.equal(calls,kind==='expired-before-first'?1:2);observations.push({kind,calls,chargedItemAttempts:budget.requests,result,scope:'Authenticated initial69 core bytes; owned test-only Fetch and monotonic clock. Fetch fixture intentionally ignores abort to prove that no explicit pre-effect recheck exists; no remote effects or stalled-IO preemption claim.'});
}
