import test from 'node:test';import assert from 'node:assert/strict';import{randomBytes,randomUUID}from'node:crypto';
import{normalizeRecycleData,recycleView,recycleRead,deleteRecycleEntry,restoreRecycleEntry}from'./recycle.mjs';
import{materializeKdbxDocument,projectKdbxDocument,encodeKdbxDate,decodeKdbxDate}from'./kdbx.mjs';
import{element,one,nodes,text,put,serializeXml}from'./xml.mjs';
const id='11111111-2222-3333-4444-555555555555',binId='77777777-8888-9999-aaaa-bbbbbbbbbbbb',now='2025-01-02T03:04:05Z';
const row=()=>({id,title:'Synthetic λ entry',username:'user',password:'only-synthetic-secret',url:'https://example.invalid',notes:'binary/Unicode 🧪',group:'Parent/Child',totpSecret:'',createdAt:'2024-01-01T00:00:00Z',updatedAt:'2024-01-02T00:00:00Z'});
function fixture(){return normalizeRecycleData({version:1,entries:[row()]});}
function edit(data,fn){const xml=materializeKdbxDocument(data);fn(xml);return {...data,entries:projectKdbxDocument(xml),kdbx:{...data.kdbx,xml:serializeXml(xml)}};}
function find(xml,name){const visit=n=>n.name===name?n:nodes(n).map(visit).find(Boolean);return visit(xml);}
function remove(data,key,opts={}){const r=recycleView(data,key).entries[0];return deleteRecycleEntry(data,r.id,r.recycleRevision,key,{confirm:true,now,binId,...opts});}
test('normal deletion creates a real native bin, keeps content/history, and restores identity to previous UUID',()=>{const key=randomBytes(32),data=fixture(),before=JSON.stringify(data);const d=remove(data,key);assert.equal(JSON.stringify(data),before);assert.deepEqual({recycled:d.result.recycled,permanent:d.result.permanent},{recycled:true,permanent:false});assert.equal(recycleView(d.data,key).entries.length,0);const [trash]=recycleView(d.data,key,{bin:true}).entries;assert.equal(trash.id,id);assert.equal(trash.password,row().password);assert.equal(trash.updatedAt,data.entries[0].updatedAt);assert.equal(trash.canRestorePreviousGroup,true);const restored=restoreRecycleEntry(d.data,id,trash.recycleRevision,key,{confirm:true,now:'2025-02-03T04:05:06Z'});assert.equal(recycleView(restored.data,key,{bin:true}).entries.length,0);const actual=recycleView(restored.data,key).entries[0];assert.equal(actual.group,row().group);assert.equal(actual.id,id);assert.equal(actual.password,row().password);assert.equal(actual.updatedAt,data.entries[0].updatedAt);assert.equal(actual.canRestorePreviousGroup,false);});
test('bin source defaults have trash icon, searching/Auto-Type disabled and no new history version',()=>{const data=remove(fixture(),randomBytes(32)).data,xml=materializeKdbxDocument(data),top=one(one(xml,'Root',true),'Group',true),bin=nodes(top,'Group').find(g=>text(one(g,'UUID'))===Buffer.from(binId.replaceAll('-',''),'hex').toString('base64'));assert.equal(text(one(bin,'IconID')),'43');assert.equal(text(one(bin,'EnableAutoType')),'False');assert.equal(text(one(bin,'EnableSearching')),'False');assert.equal(text(one(bin,'IsExpanded')),'True');assert.equal(nodes(one(nodes(bin,'Entry')[0],'History'),'Entry').length,0);});
test('permanent delete adds native UUID/time tombstone and cannot restore',()=>{const key=randomBytes(32),data=remove(fixture(),key,{permanent:true}).data;assert.equal(data.entries.length,0);const deleted=nodes(one(one(materializeKdbxDocument(data),'Root'),'DeletedObjects'),'DeletedObject');assert.equal(deleted.length,1);assert.equal(text(one(deleted[0],'UUID')),Buffer.from(id.replaceAll('-',''),'hex').toString('base64'));assert.equal(decodeKdbxDate(text(one(deleted[0],'DeletionTime'))),now.replace('Z','.000Z'));assert.throws(()=>restoreRecycleEntry(data,id,'0'.repeat(64),key,{confirm:true}),/not found/);});
test('disabled bin setting permanently deletes; deleting an existing bin entry also adds tombstone',()=>{const key=randomBytes(32),disabled=edit(fixture(),xml=>put(one(xml,'Meta'),'RecycleBinEnabled','False'));assert.equal(remove(disabled,key).result.permanent,true);const trashed=remove(fixture(),key).data,[r]=recycleView(trashed,key,{bin:true}).entries,purge=deleteRecycleEntry(trashed,r.id,r.recycleRevision,key,{confirm:true,now});assert.equal(purge.result.permanent,true);assert.equal(purge.data.entries.length,0);});
test('MAC rejects stale dataset, cross-key, mutated entry and missing confirmation without input changes',()=>{const key=randomBytes(32),data=fixture(),r=recycleView(data,key).entries[0],old=JSON.stringify(data);assert.throws(()=>deleteRecycleEntry(data,id,r.recycleRevision,randomBytes(32),{confirm:true}),/selection changed/);assert.throws(()=>deleteRecycleEntry(data,id,r.recycleRevision,key),/confirmation/);const modified={...data,entries:data.entries.map(e=>({...e,notes:'Changed'}))};assert.throws(()=>deleteRecycleEntry(modified,id,r.recycleRevision,key,{confirm:true}),/selection changed/);assert.equal(JSON.stringify(data),old);});
test('permissive/malformed clocks reject without writing and uint64 touch wraps exactly',()=>{const key=randomBytes(32),data=fixture(),r=recycleView(data,key).entries[0];for(const invalid of['2025-02-30T00:00:00Z','2025-01-01 00:00:00Z','2025-01-01T24:00:00Z',0])assert.throws(()=>deleteRecycleEntry(data,id,r.recycleRevision,key,{confirm:true,now:invalid}),/clock/);const max=edit(data,xml=>put(one(find(xml,'Entry'),'Times'),'UsageCount','18446744073709551615')),d=remove(max,key).data;assert.equal(text(one(one(find(materializeKdbxDocument(d),'Entry'),'Times'),'UsageCount')),'0');});
test('absent/zero previous group rejects recover and keeps encrypted-representation data unchanged',()=>{const key=randomBytes(32),d=remove(fixture(),key).data,bad=edit(d,xml=>put(find(xml,'Entry'),'PreviousParentGroup',Buffer.alloc(16).toString('base64'))),r=recycleView(bad,key,{bin:true}).entries[0],copy=JSON.stringify(bad);assert.equal(r.canRestorePreviousGroup,false);assert.throws(()=>restoreRecycleEntry(bad,id,r.recycleRevision,key,{confirm:true,now}),/previous group/);assert.equal(JSON.stringify(bad),copy);});
test('malformed root-bin UUID and invalid boolean settings reject before mutation',()=>{const key=randomBytes(32);const rootBin=edit(fixture(),xml=>put(one(xml,'Meta'),'RecycleBinUUID',text(one(one(one(xml,'Root'),'Group'),'UUID'))));assert.throws(()=>recycleView(rootBin,key),/root group/);const invalid=edit(fixture(),xml=>put(one(xml,'Meta'),'RecycleBinEnabled','yes'));assert.throws(()=>recycleView(invalid,key),/enablement/);});
test('explicit preview returns a copy and attachment values are included in selection binding',()=>{const key=randomBytes(32),data=fixture(),r=recycleView(data,key).entries[0],preview=recycleRead(data,id,r.recycleRevision,key);preview.entry.password='mutated';assert.equal(data.entries[0].password,row().password);const other={...data,kdbx:{...data.kdbx,binaries:[{protected:false,dataBase64:'AA=='}]}};assert.throws(()=>recycleRead(other,id,r.recycleRevision,key),/selection changed/);});
test('duplicate names do not redirect UUID recovery; existing bin is reused',()=>{const key=randomBytes(32);let data=fixture();data.entries.push({...row(),id:'aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee',title:'Second'});data=normalizeRecycleData(data);const parentId=data.entries[0].kdbxGroupId;data=edit(data,xml=>{const top=one(one(xml,'Root'),'Group'),copy=structuredClone(nodes(top,'Group')[0]);function reidentify(g){put(g,'UUID',Buffer.from(randomUUID().replaceAll('-',''),'hex').toString('base64'));g.children=g.children.filter(n=>typeof n==='string'||n.name!=='Entry');for(const child of nodes(g,'Group'))reidentify(child);}reidentify(copy);top.children.push(copy);});const first=recycleView(data,key).entries.find(r=>r.id===id);data=deleteRecycleEntry(data,id,first.recycleRevision,key,{confirm:true,now,binId}).data;const second=recycleView(data,key).entries[0];data=deleteRecycleEntry(data,second.id,second.recycleRevision,key,{confirm:true,now,binId:'cccccccc-dddd-eeee-ffff-000000000001'}).data;assert.equal(recycleView(data,key,{bin:true}).entries.length,2);const xml=materializeKdbxDocument(data),top=one(one(xml,'Root'),'Group');assert.equal(nodes(top,'Group').filter(g=>text(one(g,'IconID'))==='43').length,1);const selected=recycleView(data,key,{bin:true}).entries.find(e=>e.id===id),restored=restoreRecycleEntry(data,id,selected.recycleRevision,key,{confirm:true,now});assert.equal(restored.result.groupId,parentId);});
test('bin creation cannot exceed the10,000-group bound and input stays unchanged',()=>{const key=randomBytes(32),data=edit(fixture(),xml=>{const top=one(one(xml,'Root'),'Group');for(let i=0;i<9997;i++)top.children.push(element('Group',[element('UUID',Buffer.from(randomUUID().replaceAll('-',''),'hex').toString('base64')),element('Name','Empty '+i)]));});const copy=JSON.stringify(data),r=recycleView(data,key).entries[0];assert.throws(()=>deleteRecycleEntry(data,id,r.recycleRevision,key,{confirm:true,now,binId}),/group limit/);assert.equal(JSON.stringify(data),copy);});
test('previous-parent within a bin is not offered as recoverable; descendant bin entries purge by ancestry',()=>{const key=randomBytes(32),data=remove(fixture(),key).data,mutated=edit(data,xml=>{const top=one(one(xml,'Root'),'Group'),bin=nodes(top,'Group').find(g=>text(one(g,'IconID'))==='43'),e=nodes(bin,'Entry')[0],child=element('Group',[element('UUID',Buffer.from('ccccccccddddffffaaaa000000000001','hex').toString('base64')),element('Name','Nested bin group')]);bin.children=bin.children.filter(n=>n!==e);child.children.push(e);bin.children.push(child);put(e,'PreviousParentGroup',text(one(bin,'UUID')));});const r=recycleView(mutated,key,{bin:true}).entries[0];assert.equal(r.canRestorePreviousGroup,false);assert.throws(()=>restoreRecycleEntry(mutated,id,r.recycleRevision,key,{confirm:true,now}),/previous group/);assert.equal(deleteRecycleEntry(mutated,id,r.recycleRevision,key,{confirm:true,now}).result.permanent,true);});
