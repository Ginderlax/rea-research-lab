    {
      "id": "grafana.candidate.c679268a5839133cd496",
      "syntaxRole": "list-item",
      "sourceText": "- Standardize workflows: Ensure consistency across your teams by using repeatable, codified processes for managing Grafana resources.",
      "headingPath": [
        "Overview"
      ],
      "source": {
        "path": "docs/sources/as-code/_index.md",
        "gitBlobSha": "b26a3a67f6eb5daf314ec05f6c29fac596b3ac82",
        "sha256": "20fb5fd56b56114e0018973b7d395795c4c212cd73c4395ea5ece61167a29125",
        "lineStart": 37,
        "lineEnd": 37,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/as-code/_index.md#L37-L37"
      },
      "applicability": {
        "status": "unresolved-no-explicit-oss-products-label",
