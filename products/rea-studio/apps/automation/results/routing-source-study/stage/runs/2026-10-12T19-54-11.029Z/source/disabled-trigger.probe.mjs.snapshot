import fs from 'node:fs/promises';
import {createHash} from 'node:crypto';
import {createExecution,preflight} from './baseline/native.mjs';
const sha256=createHash('sha256').update(await fs.readFile(new URL('baseline/native.mjs',import.meta.url))).digest('hex');if(sha256!=='56219ace2735545b3c3ec198e729e1d53e38faacf789bf5a6701fcc7b9791bb0')throw new Error('Frozen baseline authentication failed');
const node=name=>({id:name,name,type:'n8n-nodes-base.manualTrigger',typeVersion:1,position:[0,0],parameters:{}}),document={name:'Synthetic enabled-trigger identity',nodes:[{...node('Disabled'),disabled:true},node('Enabled')],connections:{}},check=preflight(document),state=createExecution(document),receipt={createdAt:new Date().toISOString(),baselineSha256:sha256,scope:'Preflight and execution-state creation only; no node or network execution.',executable:check.executable,actualStart:state.pending[0].node,expectedStart:'Enabled',finding:'Frozen createExecution selects first Manual Trigger rather than the enabled trigger used by preflight.'};await fs.writeFile(new URL('disabled-trigger.baseline.json',import.meta.url),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify(receipt));if(!check.executable||receipt.actualStart!=='Disabled')throw new Error('Historical disabled-trigger finding was not reproduced');
