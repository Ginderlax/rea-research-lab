        "lineStart": 14,
        "lineEnd": 14,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/user-management/_index.md#L14-L14"
      },
      "applicability": {
