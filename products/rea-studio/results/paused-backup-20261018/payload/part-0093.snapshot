const fast=`export function doStandardCalcs(field, ignoreNulls, nullAsZero) {
  if (!field.values || !numericField(field)) return doGenericStandardCalcs(field, ignoreNulls, nullAsZero);
  const values = field.values;
  let sum = 0, max = -Number.MAX_VALUE, min = Number.MAX_VALUE, logmin = Number.MAX_VALUE;
  let first = null, last = null, firstNotNull = null, lastNotNull = null;
  let count = 0, nonNullCount = 0, allIsZero = true;
  let delta = 0, step = Number.MAX_VALUE, previousDeltaUp = true;
  for (let index = 0; index < values.length; index++) {
    let value = values[index];
    if (index === 0) first = value;
    last = value;
    if (value == null) { if (ignoreNulls) continue; if (nullAsZero) value = 0; }
    count++;
    if (value == null || Number.isNaN(value)) continue;
    if (typeof value !== 'number') return doGenericStandardCalcs(field, ignoreNulls, nullAsZero);
    const initial = firstNotNull === null;
    if (initial) firstNotNull = value;
    sum += value || 0;
    nonNullCount++;
    if (!initial) {
      const difference = value - lastNotNull;
      if (difference < step) step = difference;
      if (lastNotNull > value) previousDeltaUp = false;
      else { if (previousDeltaUp) delta += difference; previousDeltaUp = true; }
    }
    if (value > max) max = value;
    if (value < min) min = value;
    if (value > 0 && value < logmin) logmin = value;
    if (value !== 0) allIsZero = false;
    lastNotNull = value;
  }
  if (max === -Number.MAX_VALUE) max = null;
  if (min === Number.MAX_VALUE) min = null;
  if (step === Number.MAX_VALUE) step = null;
  const mean = nonNullCount ? sum / nonNullCount : null, allIsNull = nonNullCount === 0;
  if (allIsNull) allIsZero = false;
  const range = max !== null && min !== null ? max - min : null;
  const diff = typeof firstNotNull === 'number' && typeof lastNotNull === 'number' ? lastNotNull - firstNotNull : null;
  const diffperc = typeof firstNotNull === 'number' && typeof diff === 'number' ? diff / firstNotNull * 100 : 0;
  return { sum, max, min, logmin, mean, last, first, lastNotNull, firstNotNull, count, nonNullCount, allIsNull, allIsZero, range, diff, delta, step, diffperc, previousDeltaUp };
}

