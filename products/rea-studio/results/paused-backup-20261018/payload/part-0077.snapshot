    {
      "id": "grafana.candidate.6ef8538bbcf76ec7a3d8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Options are `production` and `development`. Default is `production`. _Don't_ change this option unless you are working on Grafana development.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`app_mode`"
      ],
      "source": {
