    {
      "id": "grafana.candidate.d0a18f4a5727ae673e35",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To get started creating subfolders, enable the `nestedFolders` feature toggle. We recommend that you enable this feature only on test or development instances, rather than in production environments.",
