import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import {spawn} from 'node:child_process';
const root=fileURLToPath(new URL('./',import.meta.url)),name=process.argv[2]??'initial',out=path.join(root,'runs',name),hash=b=>createHash('sha256').update(b).digest('hex');await fs.mkdir(out,{recursive:true});
async function sources(dir=root,prefix=''){const rows=[];for(const item of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const relative=prefix+item.name;if(item.isDirectory()){if(['runs','.local','original','baseline','failures'].includes(item.name))continue;rows.push(...await sources(path.join(dir,item.name),relative+'/'));}else{const bytes=await fs.readFile(path.join(dir,item.name));rows.push({path:relative,bytes:bytes.length,sha256:hash(bytes)});}}return rows;}
const before=await sources();await fs.writeFile(path.join(out,'source-before.json'),JSON.stringify(before,null,2)+'\n',{flag:'wx'});for(const row of before){const dest=path.join(out,'source',row.path+'.snapshot');await fs.mkdir(path.dirname(dest),{recursive:true});await fs.copyFile(path.join(root,row.path),dest);}const tests=process.argv.slice(3);const selected=tests.length?tests:['app.test.mjs','app.integration.test.mjs','jex.test.mjs','notebooks.test.mjs','notebooks.integration.test.mjs','notebook-trash.test.mjs','notebook-trash.integration.test.mjs','notebook-trash.ui.test.mjs'];
const args=['--test','--test-reporter=tap','--test-concurrency=1',...selected.map(f=>'products/rea-studio/apps/notes/'+f)],startedAt=new Date().toISOString();const result=await new Promise(resolve=>{let stdout='',stderr='';const child=spawn(process.execPath,args,{cwd:root,windowsHide:true});child.stdout.on('data',b=>stdout+=b);child.stderr.on('data',b=>stderr+=b);child.on('exit',(code,signal)=>resolve({code,signal,stdout,stderr}));});await fs.writeFile(path.join(out,'stdout.txt'),result.stdout);await fs.writeFile(path.join(out,'stderr.txt'),result.stderr);const after=await sources();await fs.writeFile(path.join(out,'source-after.json'),JSON.stringify(after,null,2)+'\n');const stable=JSON.stringify(before)===JSON.stringify(after),counts=Object.fromEntries(['tests','pass','fail','skipped','cancelled'].map(k=>[k,Number(new RegExp('# '+k+' (\\d+)').exec(result.stdout)?.[1]??0)]));const receipt={schema:'rea-notebook-trash-focused-run/v1',startedAt,finishedAt:new Date().toISOString(),node:process.version,args,exitCode:result.code,sourceStable:stable,counts,stdoutSha256:hash(result.stdout),stderrSha256:hash(result.stderr),sources:before};await fs.writeFile(path.join(out,'receipt.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({run:name,...counts,exitCode:result.code,sourceStable:stable}));if(result.code||!stable)process.exitCode=1;
