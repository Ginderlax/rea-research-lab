        "sha256": "6ced8f5013d0e7915d51e15ba80ed9f73c86317cb3e7dcc37918a1d2322c61be",
        "lineStart": 105,
        "lineEnd": 105,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/graphite/query-editor/index.md#L105-L105"
      },
      "applicability": {
