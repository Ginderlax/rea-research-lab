import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import {spawn} from 'node:child_process';import {authenticate} from './auth.mjs';
const here=import.meta.dirname,work=path.resolve(here,'..'),run='runs/finite-'+new Date().toISOString().replace(/[:.]/g,'-'),root=path.join(here,run),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),json=v=>Buffer.from(JSON.stringify(v,null,2)+'\n');async function save(p,b){await fs.mkdir(path.dirname(path.join(root,p)),{recursive:true});await fs.writeFile(path.join(root,p),b,{flag:'wx'});}
const authorityBefore=authenticate();await save('authority-before.json',json(authorityBefore));const paths=['auth.mjs','prepare.mjs','collect.mjs','ui-fixture.mjs','draft-boundaries.test.mjs','adjacent.test.mjs','fresh.test.mjs','adapter.json'];async function capture(){const result=[];for(const p of paths){const b=await fs.readFile(path.join(here,p));result.push({path:p,...id(b)});}for(const p of ['client.mjs','server.mjs','recycle.mjs','history.mjs','kdbx.mjs','xml.mjs','group-fixture.mjs']){const full=path.join(work,'vault-group-edit-late-draft-fix-next/products/rea-studio/apps/vault',p),b=await fs.readFile(full);result.push({path:'corrected-candidate/'+p,...id(b)});}return result;}const before=await capture();await save('source-before.json',json(before));for(const p of paths)await save('source/'+p+'.snapshot',await fs.readFile(path.join(here,p)));const node=id(await fs.readFile(process.execPath));assert.equal(node.sha256,'b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3');const attempts=[];
for(const [label,file,expectedCount,scope]of [['exact-six','draft-boundaries.test.mjs',6,'Exact six initial negative/control case bodies, path-only fixture replay'],['exact-five','adjacent.test.mjs',5,'Exact five prior independent adjacent bodies, path-only fixture replay'],['fresh-four','fresh.test.mjs',4,'Four fresh independent finite corrected-client/backend controls']]){const folder=path.join(root,label);await fs.mkdir(folder);const env={...process.env,VAULT_GROUP_REVIEW_OUTPUT:folder};delete env.NODE_OPTIONS;delete env.NODE_V8_COVERAGE;delete env.NODE_TEST_CONTEXT;const args=['--max-old-space-size=128','--test','--test-isolation=none','--test-concurrency=1','--test-reporter=tap',file],start=new Date().toISOString(),child=spawn(process.execPath,args,{cwd:here,env,windowsHide:true,shell:false,stdio:['ignore','pipe','pipe']}),stdout=[],stderr=[];let outBytes=0,errBytes=0,limit=null,error=null;const timer=setTimeout(()=>{limit='child20s';child.kill();},20000);child.on('error',e=>{error={name:e.name,message:e.message,code:e.code};});for(const [channel,parts]of [['stdout',stdout],['stderr',stderr]])child[channel].on('data',b=>{const prior=channel==='stdout'?outBytes:errBytes,left=1048576-prior;if(left>0)parts.push(b.subarray(0,left));if(channel==='stdout')outBytes+=b.length;else errBytes+=b.length;if(prior+b.length>1048576){limit=channel+'1MiB';child.kill();}});const exit=await new Promise(r=>child.on('close',(code,signal)=>r({code,signal})));clearTimeout(timer);const out=Buffer.concat(stdout),err=Buffer.concat(stderr);await fs.writeFile(path.join(folder,'stdout.txt'),out,{flag:'wx'});await fs.writeFile(path.join(folder,'stderr.txt'),err,{flag:'wx'});const counts={};for(const k of ['tests','pass','fail','skipped','cancelled','todo']){const matches=[...out.toString().matchAll(new RegExp('^# '+k+' (\\d+)$','gm'))];assert.equal(matches.length,1,k+' TAP total');counts[k]=Number(matches[0][1]);}assert.equal(counts.tests,expectedCount);attempts.push({label,file,scope,args,pid:child.pid,start,end:new Date().toISOString(),exit,limit,error,counts,raw:{stdout:id(out),stderr:id(err)},newOriginalExecutions:0,nativeBrowser:false,realCandidateClientServer:true,controlledDOMModel:true});await save(label+'/validation.json',json(attempts.at(-1)));}
const after=await capture();assert.deepEqual(after,before);await save('source-after.json',json(after));const authorityAfter=authenticate();assert.deepEqual(authorityAfter,authorityBefore);await save('authority-after.json',json(authorityAfter));const totals={tests:0,pass:0,fail:0,skipped:0,cancelled:0,todo:0};for(const r of attempts)for(const k of Object.keys(totals))totals[k]+=r.counts[k];const accepted=attempts.every(r=>r.exit.code===0&&r.exit.signal===null&&r.limit===null&&r.error===null&&r.counts.fail+r.counts.skipped+r.counts.cancelled+r.counts.todo===0);await save('validation.json',json({schema:'rea-vault-group-edit-correction-independent-finite-execution/v1',run,accepted,totals,attempts,node,nodeVersion:process.version,fullAuthoritiesStable:true,sourceStable:true,sourceRows:before.length,initial11ReplayedNotFresh:true,freshGroups:4,backendEncryptedPersistenceActual:true,persistenceStoreSyntheticMemory:true,original22OnlyHistoricalNotReexecuted:true,newOriginalExecutions:0,nativeBrowserExecutions:0,hostsStarted:0,productionWrites:0,authorStageWrites:0,benchmarks:0,fullParity:false}));console.log(JSON.stringify({run,accepted,totals,initialReplay11:true,fresh4:true,sourceStable:true}));assert(accepted,'Finite failures are retained');
