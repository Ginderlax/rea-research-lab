    {
      "id": "grafana.candidate.bde7b50fa0c4b26a8a76",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, Grafana installs some suggested plugins on startup. For a list of default preinstalled plugins, refer to [pkg/setting/setting_plugins.go:35](https://github.com/grafana/grafana/blob/main/pkg/setting/setting_plugins.go#L35-L40).",
      "headingPath": [
