    {
      "id": "grafana.candidate.1df65f2adbbe55068d00",
      "syntaxRole": "table-row",
      "sourceText": "| **Label names**   | `metric` (optional)                     | Returns all label names, optionally filtered by metric regular expression.      | Metric: `http_requests_total` → returns `job`, `instance`, `method`, `status`, etc.     |",
      "headingPath": [
        "Prometheus template variables",
        "Query variable types"
      ],
      "source": {
        "path": "docs/sources/datasources/prometheus/template-variables/_index.md",
