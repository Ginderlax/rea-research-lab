    {
      "id": "grafana.candidate.d6f71436a23215ba489c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana counts the data behind these sort options once a day, up to the end of the previous day. Because today's activity isn't included yet, these numbers can be lower than the view count in [dashboard insights](#dashboard-insights), which updates as activity happens.",
      "headingPath": [
        "Assess dashboard usage",
        "Sort dashboards by using insights data"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/assess-dashboard-usage/index.md",
        "gitBlobSha": "0119f673d99e64c871477792777162e850a395a4",
