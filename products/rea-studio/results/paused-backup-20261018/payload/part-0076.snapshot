    {
      "id": "grafana.candidate.aeca7c2f9c2e6acdb07c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Cause:** The SQL Server's TLS certificate must be verifiable from the PDC agent's perspective, not from Grafana Cloud. If the SQL Server uses a private CA certificate, the PDC agent host must trust that CA.",
      "headingPath": [
        "Troubleshoot Microsoft SQL Server data source issues",
        "Connection errors",
        "TLS certificate errors through PDC"
      ],
      "source": {
