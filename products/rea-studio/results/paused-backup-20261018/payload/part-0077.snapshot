    {
      "id": "grafana.candidate.f785a6dcc76101529f81",
      "syntaxRole": "procedural-step",
      "sourceText": "1. **Use the same identity provider for user provisioning and for authentication flow**: You must use the same identity provider for both authentication and user provisioning.",
      "headingPath": [
        "Configure SCIM provisioning",
        "Authentication and access requirements"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-scim-provisioning/_index.md",
        "gitBlobSha": "a298736a0d923353f597de1ee76f6a6ce0df3d22",
