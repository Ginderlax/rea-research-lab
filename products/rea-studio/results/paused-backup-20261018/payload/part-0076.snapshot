    {
      "id": "grafana.candidate.8b4319cf51710b746219",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "InfluxDB alerting supports all three query languages: InfluxQL, SQL, and Flux. Queries must return time-series data for Grafana to evaluate values over time and trigger alerts when thresholds are crossed.",
      "headingPath": [
        "InfluxDB alerting",
        "Supported query types"
      ],
      "source": {
