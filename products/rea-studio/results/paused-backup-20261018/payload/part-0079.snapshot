        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.471be7197d9e5c1339ec",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The **Window functions** mode also supports moving variance and moving standard deviation calculations if you need to analyze the volatility of your metric.",
      "headingPath": [
        "What’s new in Grafana v10.3",
        "Dashboards and visualizations",
        "Moving average and trend lines using transformations",
        "Moving average\\*"
      ],
