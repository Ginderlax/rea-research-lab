      "id": "grafana.candidate.4bf6ad3495b748342485",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "OpenTSDB is an open source time series database built on top of HBase. Use the OpenTSDB data source to visualize metrics, create alerts, and build dashboards from your time series data.",
      "headingPath": [
        "OpenTSDB data source"
      ],
      "source": {
