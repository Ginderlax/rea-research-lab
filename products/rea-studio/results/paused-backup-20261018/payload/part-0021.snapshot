block=once(block,'const selection={...input,notebook};','const selection={...request,notebook};')
ending='  });\r\n' if block.endswith('  });\r\n') else '  });\n'
assert block.endswith(ending)
block=block[:-len(ending)]+'    });\r\n  }\r\n'
server=server[:start]+block+server[end:]
put(prefix+'server.mjs',server.encode())
readme=read(prefix+'README.md')
readme+=b'''\n\n## New To-do: separate future source proposal\n\nThis separate, unexecuted candidate adds a **New to-do** draft next to New note. Choosing it stores nothing. Give the draft a title, choose a notebook/tags and write its body, then choose Save note. A successful first save writes the note and its open to-do state together at revision1, with no due date, completion date or prior saved versions. Saved-note controls can then set due metadata, complete/reopen or convert it. New note resets the draft type. Cancelling a discard keeps the previous draft. Attachments still require a saved note. Existing filters and updated-time sorting remain unchanged.\n\nA pending save blocks duplicate saves while typing and starting another draft remain possible. A late success or failure cannot replace a newer editor or a disposed view. A newer body typed while a successful response is held stays unsaved at the returned revision and needs another explicit Save. A persistence failure retains the draft and supports explicit retry. These are authored candidate policies, pending independent review and actual hosted execution.\n\nThe source contract uses Joplin Desktop3.6.14's pinned to-do documentation, Note.new/newTodo helpers and desktop newTodo/newNote commands. The original desktop command creates a provisional saved item; this candidate instead keeps an unsaved local draft until explicit Save. Planned exact helper-field and command-argument comparisons are narrow adapters. They do not execute Joplin's full database, provisional lifecycle, command framework, GUI, alarms or synchronization, and do not prove parity. This future epoch leaves the earlier92/8 and installed-source evidence unchanged.\n'''
put(prefix+'README.md',readme)
original_prefix='products/rea-studio/experiments/notes-new-todo/original/'
for name in ['packages/app-desktop/gui/WindowCommandsAndDialogs/commands/newTodo.ts','packages/app-desktop/gui/WindowCommandsAndDialogs/commands/newNote.ts']:
    put(original_prefix+name+'.snapshot',(acquired/'original'/(name+'.snapshot')).read_bytes())
put(original_prefix+'readme/apps/to-dos.md.snapshot',read('products/rea-studio/experiments/notes-todo/original/to-dos.md.snapshot'))
put(original_prefix+'LICENSE.snapshot',read('products/rea-studio/experiments/notes-todo/original/LICENSE.snapshot'))
note_path='products/rea-studio/apps/notes/results/notebooks-followup/stage/original/packages/lib/models/Note.ts.snapshot.snapshot'
base_model_path='products/rea-studio/apps/notes/results/notebooks-followup/stage/original/packages/lib/BaseModel.ts.snapshot.snapshot'
contract={
 'schema':'rea-Notes-new-to-do-future-source-contract/v1','sourceOnly':True,'parentSourceAuthority':pin((previous/'change-authority.json').read_bytes()),
 'originalRelease':'Joplin Desktop3.6.14','originalTag':'v3.6.14','originalCommit':'7e2765a3857754d12dbadea442b60ceaf9d4b23d',
 'originalSources':[{'path':note_path,**pin(read(note_path))},{'path':base_model_path,**pin(read(base_model_path))}]+[{'path':p.relative_to(candidate).as_posix(),**pin(p.read_bytes())} for p in sorted((candidate/original_prefix).rglob('*')) if p.is_file()],
 'sourceFindings':[
  'The pinned to-do documentation provides a desktop New to-do entry above the list. Its ordering prose is internally inconsistent; sorting remains outside this feature.',
  'Note.newTodo calls Note.new(parentId) then sets is_todo=true; Note.new preserves the selected parent and obtains remaining defaults from its superclass.',
  'The desktop newTodo command delegates newNote(body,true). newNote uses the valid active folder, is_todo1, the supplied body and provisional:true, then selects and sorts the saved item.',
  'The desktop enabled condition requires one valid selected folder outside conflict/read-only/trash. The candidate draft permits explicit notebook choice and defaults to Notes, a disclosed policy difference.',
 ],
 'candidateContract':[
  'New to-do chooses an unsaved draft type; no mutation or provisional record occurs until explicit Save.',
  'A new save may carry newTodo:true; only Boolean values are accepted and existing-note saves must omit the flag. Saved-note type changes keep their existing endpoints.',
  'Snapshot caller fields before waiting on the queue; validate and bind notebook in cloned state, then make one state commit containing both note and to-do fields.',
  'Revision1 creation starts open with due0/completed0/history0. Ordinary later saves preserve to-do state and build bounded history; cold restart and JEX preserve supported metadata.',
  'One pending save blocks duplicate saves, preserves newer typed body at the returned revision, and respects a newer editor or disposed view after real commit or failure.',
 ],
 'plannedComparisons':{'selectedHelperParentAndTypeComparisons':4,'desktopCommandArgumentComparisons':2,'comparisonsAddedToTestGroupCounts':False,'originalDefaultFieldAdapter':True,'originalDatabaseExecutions':0,'originalGuiExecutions':0,'originalFullApplicationExecutions':0},
 'unchangedHistoricalScope':['Notes92 finite campaign','Notes8 browser campaign','Notes installed-source R4 authority','old13 Notes tests','current shared collectors and workflows','all root proofs and requirement registries'],
 'localProductExecutions':0,'localTests':0,'localSyntaxChecks':0,'localBuilds':0,'freshHostedAcceptance':False,'fullParity':False,'superiority':False,
 'retrievalNotes':{'twoGuessedTopLevelDesktopCommandPathsReturned404':True,'correctPathsDiscoveredFromPinnedGuiGitTree':True,'rawCommandsAuthenticatedByGitBlobSha1':True},
}
tree=json.loads((acquired/'original/desktop-gui-tree-api.json').read_bytes())
for name in ['newTodo','newNote']:
    rel='WindowCommandsAndDialogs/commands/'+name+'.ts';row=next(r for r in tree['tree'] if r['path']==rel)
    b=(acquired/'original/packages/app-desktop/gui'/(rel+'.snapshot')).read_bytes()
    assert row['size']==len(b)
    assert hashlib.sha1(('blob '+str(len(b))+'\0').encode()+b).hexdigest()==row['sha']
contract_bytes=(json.dumps(contract,indent=2)+'\n').encode();put('products/rea-studio/experiments/notes-new-todo/contract.json',contract_bytes)
(stage/'source-contract.json').write_bytes(contract_bytes)
print(json.dumps({'candidateRoot':str(candidate),'sourceContract':pin(contract_bytes),'client':pin(client.encode()),'server':pin(server.encode()),'readme':pin(readme),'originalCommandGitObjectsAuthenticated':2,'sourceOnly':True}))
"""Work-only source authoring. Never imports/runs candidate code or tests."""
import copy
import hashlib
import json
import re
from pathlib import Path

work = Path(__file__).resolve().parent
repo = work.parent / 'outputs/rea-research-lab'
stage = work / 'notes-installed-source-proof-phase12-next'
candidate = stage / 'candidate'
candidate.mkdir(parents=True, exist_ok=False)
sha = lambda b: hashlib.sha256(b).hexdigest()
pin = lambda b: {'bytes': len(b), 'sha256': sha(b)}
raw = lambda name: (repo / name).read_bytes()
text = lambda name: raw(name).decode('utf-8')
read_json = lambda name: json.loads(raw(name).decode('utf-8-sig'))
encode_json = lambda v: (json.dumps(v, indent=2) + '\n').encode('utf-8')
written = {}
def save(name, data):
    assert name not in written
    target = candidate / name
    target.parent.mkdir(parents=True, exist_ok=True)
    with target.open('xb') as out:
        out.write(data)
    assert target.read_bytes() == data
    written[name] = pin(data)
    return written[name]
def once(source, old, new):
    assert source.count(old) == 1, old[:140]
    return source.replace(old, new)

