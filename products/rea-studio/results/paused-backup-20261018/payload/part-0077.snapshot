    {
      "id": "grafana.candidate.3fa89585c09c1b88f2c8",
      "syntaxRole": "table-row",
      "sourceText": "| false                             | false                | Synchronize user organization role with Grafana.com role. If no role is provided, `auto_assign_org_role` is set.                    | false      |",
      "headingPath": [
