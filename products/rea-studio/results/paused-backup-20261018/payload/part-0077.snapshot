    {
      "id": "grafana.candidate.e3b23441c47e23157b57",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When running Prometheus locally, there are two ways to configure Prometheus for Grafana. You can use a hosted Grafana instance at [Grafana Cloud](/) or run Grafana locally.",
      "headingPath": [
        "Get started with Grafana and Prometheus",
        "Configure Prometheus for Grafana"
      ],
