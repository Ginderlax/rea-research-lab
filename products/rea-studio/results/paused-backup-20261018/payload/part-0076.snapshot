      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c32fd30482431a9c8eab",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Alert conditions require numeric time-series data. Scenarios that produce logs (Logs), traces (Trace), graphs (Node Graph, Flame Graph), annotations (Annotations), or tables (Table Static) can't be used as alert conditions.",
      "headingPath": [
        "TestData alerting",
        "Limitations",
        "Only time-series scenarios work with alert conditions"
      ],
      "source": {
