    {
      "id": "grafana.candidate.afaf547d27a1bb420da2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now work much more efficiently with traces that consist of a large number of spans with span filtering.",
      "headingPath": [
        "What’s new in Grafana v10.0",
        "Tracing",
        "Span filtering for traces"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-0.md",
