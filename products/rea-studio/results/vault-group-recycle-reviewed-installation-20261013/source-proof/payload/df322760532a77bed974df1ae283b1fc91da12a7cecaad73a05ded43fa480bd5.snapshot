import test from'node:test';import assert from'node:assert/strict';import{randomUUID}from'node:crypto';import{render}from'./client.mjs';import{handle,dispose}from'./server.mjs';import{Element,descendants,button,field,deferred}from'./ui-fixture.mjs';
async function fixture(t,wrap){const workspace={root:'owned-coherence-'+randomUUID()},store={value:null,get:async()=>structuredClone(store.value),set:async(k,v)=>{store.value=structuredClone(v)}},call=(action,input={})=>handle({action,input,store,workspace}),requests=[];await call('create',{password:'Owned synthetic coherence master'});const A=(await call('save',{title:'A',group:'Parent/Selected',password:'Synthetic coherence password'})).id;globalThis.document={createElement:tag=>new Element(tag)};const root=new Element('main'),cleanup=await render(root,(action,input)=>{requests.push({action,id:input?.id});return wrap?wrap(action,input,()=>call(action,input)):call(action,input)});t.after(()=>{cleanup();dispose(workspace);delete globalThis.document});return{root,call,store,requests,A,cleanup};}
function row(root,name){const r=descendants(root).find(e=>e.tagName==='section'&&e.children.some(c=>c.tagName==='strong'&&c.textContent===name));assert(r,'Expected group '+name);return r;}
async function trashed(root){await button(root,'Show groups').click();const g=row(root,'Selected');field(g,'Confirm recycle group and descendants').checked=true;await button(g,'Recycle group and descendants').click();await button(root,'Show recycled groups').click();}
function purge(root){const g=row(root,'Selected');field(g,'Confirm permanently delete group and descendants').checked=true;return button(g,'Permanently delete group and descendants');}
test('older completed entry-bin list is invalidated before recursive purge and cannot republish its old rows',async t=>{let armed=false;const entered=deferred(),release=deferred();t.after(()=>release.resolve());const f=await fixture(t,async(action,input,real)=>{const value=await real();if(action==='recycleList'&&armed){armed=false;entered.resolve();await release.promise;}return value});await trashed(f.root);armed=true;const old=button(f.root,'Show recycle bin').click();await entered.promise;await purge(f.root).click();release.resolve();await old;assert(!descendants(f.root).some(e=>e.tagName==='strong'&&e.textContent==='A'));assert.equal((await f.call('recycleList')).entries.length,0);});
test('confirmed group effect scrubs an existing masked bin password immediately, before held persistence resolves',async t=>{const f=await fixture(t);await trashed(f.root);await button(f.root,'Show recycle bin').click();await button(f.root,'Preview recycled entry').click();const oldSecret=field(f.root,'Recycled password');assert.equal(oldSecret.value,'Synthetic coherence password');const entered=deferred(),release=deferred();t.after(()=>release.resolve());const set=f.store.set;f.store.set=async(k,v)=>{entered.resolve();await release.promise;return set(k,v)};const pending=purge(f.root).click();await entered.promise;assert.equal(oldSecret.value,'');assert(!descendants(f.root).some(e=>e.ownText==='Recycled password'));const before=f.requests.length;await button(f.root,'Show recycle bin').click();assert.equal(f.requests.length,before,'No API read for reopening during an effect.');release.resolve();await pending;});
test('unconfirmed and dirty refusals leave current bin preview/private field untouched and issue zero group mutations',async t=>{const f=await fixture(t);await trashed(f.root);await button(f.root,'Show recycle bin').click();await button(f.root,'Preview recycled entry').click();const secret=field(f.root,'Recycled password'),g=row(f.root,'Selected'),control=button(g,'Permanently delete group and descendants');await control.click();assert.equal(secret.value,'Synthetic coherence password');field(f.root,'Title').value='Enabled new unsaved draft';field(f.root,'Title').listeners.get('input')();field(g,'Confirm permanently delete group and descendants').checked=true;await control.click();assert.equal(secret.value,'Synthetic coherence password');assert.equal(field(f.root,'Title').value,'Enabled new unsaved draft');assert.equal(f.requests.filter(r=>r.action==='recycleGroupDelete').length,1,'Only initial recycle, no purge request.');});
test('held group preview cannot append stale descendant details after purge starts',async t=>{let armed=false;const entered=deferred(),release=deferred();t.after(()=>release.resolve());const f=await fixture(t,async(action,input,real)=>{const value=await real();if(action==='recycleGroupRead'&&armed){armed=false;entered.resolve();await release.promise;}return value});await trashed(f.root);const g=row(f.root,'Selected');armed=true;const old=button(g,'Preview group descendants').click();await entered.promise;await purge(f.root).click();release.resolve();await old;assert(!g.textContent.includes('Entry: A'));assert.equal(g.parentElement,null);});
test('failed purge drops held old bin publication; explicit fresh reopen and reconfirmation retry preserve backend atomicity',async t=>{let armed=false;const entered=deferred(),release=deferred();t.after(()=>release.resolve());const f=await fixture(t,async(action,input,real)=>{const value=await real();if(action==='recycleList'&&armed){armed=false;entered.resolve();await release.promise;}return value});await trashed(f.root);const before=structuredClone(f.store.value),set=f.store.set;armed=true;const old=button(f.root,'Show recycle bin').click();await entered.promise;f.store.set=async()=>{throw new Error('Synthetic coherence store failure')};await purge(f.root).click();release.resolve();await old;assert.deepEqual(f.store.value,before);assert(!descendants(f.root).some(e=>e.tagName==='strong'&&e.textContent==='A'));f.store.set=set;await button(f.root,'Show recycle bin').click();assert(descendants(f.root).some(e=>e.tagName==='strong'&&e.textContent==='A'));await button(f.root,'Show recycled groups').click();await purge(f.root).click();assert.equal((await f.call('recycleList')).entries.length,0);});
test('disposal before held purge commit suppresses every late view read while the real durable mutation completes',async t=>{const f=await fixture(t);await trashed(f.root);const entered=deferred(),release=deferred();t.after(()=>release.resolve());const set=f.store.set;f.store.set=async(k,v)=>{entered.resolve();await release.promise;return set(k,v)};const pending=purge(f.root).click();await entered.promise;const before=f.requests.length;f.cleanup();release.resolve();await pending;assert.equal(f.requests.length,before);assert.equal((await f.call('recycleList')).entries.length,0);assert(!descendants(f.root).some(e=>e.value==='Synthetic coherence password'));});
