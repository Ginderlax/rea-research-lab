// Source authoring and verified-backup filing only. Never import/evaluate candidate verifier or product code.
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import { createHash } from 'node:crypto';
import { gzipSync, gunzipSync } from 'node:zlib';
const work = import.meta.dirname, lab = path.resolve(work, '../outputs/rea-research-lab');
const stage = path.join(work, 'archive-historical-browser-pending-correction-20261016-next'), candidate = path.join(stage, 'public-candidate');
const prefix = 'products/rea-studio/results/archive-historical-browser-pending-correction-20261016', publicDir = path.join(candidate, prefix);
const run = '38905581634', job = '116988191615', artifactId = '12047572865', digest = '4f016e0e778890fd6c0542de0d4e1e3bd7c2146af30e0c68100bbb3b32d8378f';
const runFolder = path.join(work, 'cloud-verification-backups/run-' + run), backup = path.join(runFolder, 'artifact-' + artifactId), evidence = path.join(backup, 'readable-evidence');
const id = b => ({ bytes: b.length, sha256: createHash('sha256').update(b).digest('hex') });
function read(base, name) { assert(name && !/[\\:\x00-\x1f\x7f]/.test(name) && !name.startsWith('/') && name.split('/').every(part => part && part !== '.' && part !== '..')); let file = base; for (const part of name.split('/')) { file = path.join(file, part); assert(!fs.lstatSync(file).isSymbolicLink()); } const stat = fs.lstatSync(file); assert(stat.isFile() && stat.size <= 12 * 1024 * 1024); return fs.readFileSync(file); }
assert(!fs.existsSync(stage)); assert(!fs.existsSync(path.join(lab, prefix))); fs.mkdirSync(publicDir, { recursive: true });
const targets = ['scripts/editor-vault-proof-migration.mjs', 'scripts/verify-cloud-publication.mjs', 'scripts/publication-integrity-controls.mjs'];
const beforePins = [{ bytes: 103417, sha256: 'b8f562687cbd98b719971f7b7f794f608d546093fbdcab2781661068762942a6' }, { bytes: 34261, sha256: '01b0f4eea9dfc7614bda6909f054514ae203c6159b69e53a3eeb7df156d3ce1e' }, { bytes: 45181, sha256: '09408ab6d11022ce839113622e1a0072c6ad68c892f55a3e6636e0685f5046fc' }];
const before = targets.map((name, i) => { const b = read(lab, name); assert.deepEqual(id(b), beforePins[i]); return b; });
const oldFlags = " for(const flag of ['productionInstalled','productionIntegrationAccepted','browserAcceptance','fullArchiveAcceptance','historicalReceiptsRebound','fullDevelopmentSuiteAcceptance','fullParity','superiority'])assert.equal(preservation[flag],false);";
const newFlags = " assert.equal(preservation.browserAcceptance,'pending');\n for(const flag of ['productionInstalled','productionIntegrationAccepted','fullArchiveAcceptance','historicalReceiptsRebound','fullDevelopmentSuiteAcceptance','fullParity','superiority'])assert.equal(preservation[flag],false);";
let migration = before[0].toString('utf8'); assert.equal(migration.split(oldFlags).length, 2); migration = migration.replace(oldFlags, newFlags); const migrationAfter = Buffer.from(migration), migrationPin = id(migrationAfter);
const oldModulePin = "'scripts/editor-vault-proof-migration.mjs': [103417, 'b8f562687cbd98b719971f7b7f794f608d546093fbdcab2781661068762942a6']";
const newModulePin = "'scripts/editor-vault-proof-migration.mjs': [" + migrationPin.bytes + ", '" + migrationPin.sha256 + "']";
let producer = before[1].toString('utf8'); assert.equal(producer.split(oldModulePin).length, 2); producer = producer.replace(oldModulePin, newModulePin); const producerAfter = Buffer.from(producer), producerPin = id(producerAfter);
let controls = before[2].toString('utf8'); const oldProducerPin = JSON.stringify(beforePins[1]); assert.equal(controls.split(oldProducerPin).length, 2); controls = controls.replace(oldProducerPin, JSON.stringify(producerPin)); const controlsAfter = Buffer.from(controls), controlsPin = id(controlsAfter);
const authorityRows = [];
function write(target, bytes, previous = null) { const filename = path.join(candidate, target); fs.mkdirSync(path.dirname(filename), { recursive: true }); fs.writeFileSync(filename, bytes, { flag: 'wx' }); assert.deepEqual(read(candidate, target), bytes); authorityRows.push({ path: target, before: previous, after: id(bytes) }); }
for (let i = 0; i < targets.length; i++) write(prefix + '/verifier-before/' + targets[i].slice('scripts/'.length) + '.snapshot', before[i]);
write(targets[0], migrationAfter, beforePins[0]); write(targets[1], producerAfter, beforePins[1]); write(targets[2], controlsAfter, beforePins[2]);
const historicalPath = 'products/rea-studio/results/cloud-archive-aes-finite-pass-20261015/preservation-manifest.json', historicalBytes = read(lab, historicalPath), historical = JSON.parse(historicalBytes);
assert.deepEqual(id(historicalBytes), { bytes: 87704, sha256: '0231c511359d8ed8cf0de75b23a9b703fbfdbb65d816d74bf6a1a563e83dec0d' }); assert.equal(historical.browserAcceptance, 'pending'); for (const key of ['productionInstalled','productionIntegrationAccepted','fullArchiveAcceptance','historicalReceiptsRebound','fullDevelopmentSuiteAcceptance','fullParity','superiority']) assert.equal(historical[key], false);
const verificationBytes = read(backup, 'local-backup-verification.json'), verification = JSON.parse(verificationBytes); assert.equal(verification.allCRCAndBytesReadable, true); assert.equal(verification.artifactSHA256, digest); assert.equal(verification.files.length, 84);
const files = new Map(verification.files.map(row => [row.path, row])); function artifact(name) { const bytes = read(evidence, name), row = files.get(name); assert(row); assert.deepEqual(id(bytes), { bytes: row.bytes, sha256: row.sha256 }); return bytes; }
const attempt = JSON.parse(artifact('attempt-validation.json')); assert.equal(attempt.status, 'failed'); assert.equal(attempt.sourceCommit, 'b0eb4118dced28922537c187ce4cac548932df2c'); assert.deepEqual(attempt.phases, []); assert.equal(attempt.failure.message, "Expected values to be strictly equal:\n\n'pending' !== false\n"); assert.equal(attempt.controls, undefined);
const events = artifact('events.jsonl').toString('utf8').trim().split(/\r?\n/).map(line => JSON.parse(line)); assert.equal(events.filter(row => row.type === 'control-started').length, 1); assert.equal(events.find(row => row.type === 'control-started').name, 'named-migration-positive'); assert.equal(events.filter(row => row.type === 'control-passed').length, 0);
const records = [], objects = new Map(), credentials = /\b(?:ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,}|AKIA[0-9A-Z]{16})\b|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----/;
function save(role, raw) { assert(!records.some(row => row.sourcePath === role)); assert(!credentials.test(raw.toString('utf8'))); let stored = raw, encoding = 'identity'; if (raw.length > 65536) { const compressed = gzipSync(raw, { level: 9 }); if (compressed.length < raw.length * .85) { assert.deepEqual(gunzipSync(compressed), raw); stored = compressed; encoding = 'gzip'; } } const pin = id(raw), storedPin = id(stored), relative = 'payload/' + pin.sha256 + (encoding === 'gzip' ? '.gz.snapshot' : '.snapshot'); if (!objects.has(relative)) { write(prefix + '/' + relative, stored); objects.set(relative, storedPin); } records.push({ sourcePath: role, path: relative, ...pin, storage: { encoding, ...storedPin } }); }
const retained = [...files.keys()].filter(name => !name.startsWith('reviewed-sources/')), omitted = [...files.values()].filter(row => row.path.startsWith('reviewed-sources/')).map(row => ({ sourcePath: row.path, bytes: row.bytes, sha256: row.sha256 })); assert.equal(retained.length, 8); assert.equal(omitted.length, 76);
for (const name of retained) save('artifact/' + name, artifact(name));
save('local/local-backup-verification.json', verificationBytes); save('local/collection-summary.json', read(runFolder, 'collection-summary.json')); save('wrapper/job-' + job + '.txt', read(path.join(work, 'cloud-verification-backups/job-' + job), 'logs.txt'));
for (const name of ['run', 'jobs', 'artifacts']) save('control-plane/' + name + '.json', read(runFolder, 'control-plane-evidence/' + name + '.json'));
for (const name of ['unpack-publication-attempt.py', 'collect-readonly-installed-epoch-1245.mjs']) save('readers/' + name, read(work, name)); save('readers/source-authoring-and-preservation.mjs', fs.readFileSync(import.meta.filename));
const manifest = { schema: 'rea-archive-historical-browser-pending-source-correction/v1', createdAtUtc: new Date().toISOString(), status: 'source-authored-unexecuted',
  problem: 'The source-proof migration incorrectly required the immutable historical finite161 browserAcceptance field to be false. Its exact authenticated original value is the string pending. First actual installed-epoch publication control rejected this mismatch.',
  actualFailure: { runId: run, runAttempt: 1, jobId: job, artifactId, artifactSHA256: digest, branchHead: '5ff0a2fcd99ae2447311780a39688c554fc8fb2b', actualTestedMerge: attempt.sourceCommit, conclusion: 'failure', controlsStarted: 1, controlsPassed: 0, rootPhasesStarted: 0, generatedDerivedMetadataAccepted: false, exactFailure: attempt.failure },
  correction: 'Assert exactly historical browserAcceptance=pending separately; retain the other seven strict false assertions. Update only the existing producer module identity and complete-producer VM control identity. No old receipt, source plan, product code, capability gate, comparison criterion, generic route or read/artifact bound changes.',
  sourceBefore: Object.fromEntries(targets.map((target, i) => [target, beforePins[i]])), sourceAfter: Object.fromEntries(targets.map((target, i) => [target, [migrationPin, producerPin, controlsPin][i]])),
  immutableHistoricalManifest: { path: historicalPath, ...id(historicalBytes), browserAcceptance: 'pending', otherSevenAcceptanceFields: false, rewritten: false },
  sourceBeforeImages: targets.map((target, i) => ({ path: 'verifier-before/' + target.slice('scripts/'.length) + '.snapshot', ...beforePins[i] })),
  records, omittedReviewedSourceSnapshotPayloads: omitted, omissionScope: 'Only the76 reviewed-sources/ uploaded source payloads are omitted publicly, with exact identities retained. Complete readable copies remain in the verified84-file local backup. Every other uploaded artifact role, raw API/log evidence and actual backup reader/collector source is retained. Three immediate source before-images are separately preserved exactly.',
  completeReadableLocalBackupVerified: true, localReadableFiles: 84, retainedArtifactFiles: 8, uniquePublicPayloadObjects: objects.size, allStoredAndDecodedCopiesExact: true,
  plannedSourceControls: 156, inheritedControlsChangedExceptCompleteProducerPin: false, existingFirstMigrationPositiveRegressesActualHistoricalManifest: true,
  commonReadPathsAdded: 0, commonFileLimitChanged: false, separateArchiveReaderBoundsChanged: false, publicationArtifactBoundsChanged: false,
  productionRuntimeChanged: false, historicalReceiptsRebound: false, historicalManifestRewritten: false, newHostedAcceptanceEstablished: false, fullFeatureParity: false, superiority: false,
  localCandidateImports: 0, localVerifiers: 0, localSyntaxChecks: 0, localProductExecutions: 0, localTests: 0, localBuilds: 0, independentReviewPending: true, hostedReplayPending: true };
write(prefix + '/preservation-manifest.json', Buffer.from(JSON.stringify(manifest, null, 2) + '\n'));
for (const row of records) { const stored = read(publicDir, row.path); assert.deepEqual(id(stored), { bytes: row.storage.bytes, sha256: row.storage.sha256 }); assert.deepEqual(id(row.storage.encoding === 'gzip' ? gunzipSync(stored) : stored), { bytes: row.bytes, sha256: row.sha256 }); }
assert.deepEqual(id(read(lab, historicalPath)), manifest.immutableHistoricalManifest && { bytes: 87704, sha256: '0231c511359d8ed8cf0de75b23a9b703fbfdbb65d816d74bf6a1a563e83dec0d' });
const authority = { schema: 'rea-source-only-archive-historical-browser-pending-correction-authority/v1', createdAtUtc: new Date().toISOString(), stage, publicCandidate: candidate, files: authorityRows.length, rows: authorityRows, bytes: authorityRows.reduce((sum, row) => sum + row.after.bytes, 0), sourceTargets: 3, beforeImagePayloads: 3, oldHistoricalManifestUnchanged: true, sourceControlsPlanned: 156, actualFailedRunControlsPassed: 0, actualFailedRunRootPhasesStarted: 0, commonGraphReadPathsAdded: 0, allPublicStoredAndDecodedReadbacksExact: true, localProductExecutions: 0, localTests: 0, localBuilds: 0, localSyntaxChecks: 0, activeFilesWritten: 0, gitMutations: 0, independentReviewPending: true, hostedReplayPending: true };
const authorityBytes = Buffer.from(JSON.stringify(authority, null, 2) + '\n'); fs.writeFileSync(path.join(stage, 'copy-authority.json'), authorityBytes, { flag: 'wx' }); console.log(JSON.stringify({ stage, files: authority.files, bytes: authority.bytes, authority: id(authorityBytes), migrationAfter: migrationPin, producerAfter: producerPin, controlsAfter: controlsPin, localProductExecutions: 0 }));
