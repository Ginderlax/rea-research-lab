const artifacts=[preserve('observations.json',observationsBytes,'work/automation-recovery-browser-observations.json')];for(const name of ['automation-recovery-browser-host.json','automation-recovery-browser-proof.png','automation-recovery-browser-context.png'])artifacts.push(preserve('evidence/'+name,readFileSync(join(base,'work',name)),'work/'+name));
const checks=[{name:'current source captured before server launch',passed:true},{name:'supported graph and saved revision1 through UI',passed:true},{name:'six-step routing run with one Merge and two final JSON items',passed:true},{name:'same exact run and saved revision after browser reload',passed:true},{name:'source bytes unchanged through final evidence capture',passed:true}];
const receipt={schema:'rea-automation-recovery-browser-validation/v1',recordedAtUtc:new Date().toISOString(),url:observations.url,sourceInterval:{start:host.startedAtUtc,end:new Date().toISOString()},sourceFingerprints:host.sourceFingerprints,sourceBytesStable:true,workflowId:result.workflowId,runId:result.id,revision:result.revision,checks,artifacts,summary:{checks:checks.length,passed:checks.length,failed:0},runtimeImplementationSha256:'3d793bf9a9c7152be6c1248005d6c637f29ff52af148bd2305bcb965cb224c59',fullFeatureParity:false,universalSuperiority:false,scope:'Parent-owned real browser UI on a freshly started current-source loopback host and separate owned data folder. Saves/runs/reloads the routing example and reads exact persisted history. Reload is not a host restart; adversarial recovery and HTTP boundary proof comes from the separate focused test receipt. No released n8n browser/editor/runtime deployment was executed; no performance/usability superiority claim.'};
const receiptBytes=Buffer.from(JSON.stringify(receipt,null,2)+'\n');writeFileSync(join(destination,'validation.json'),receiptBytes,{flag:'wx'});
writeFileSync(join(destination,'preservation-manifest.json'),JSON.stringify({schema:'rea-automation-recovery-browser-preservation/v1',recordedAtUtc:new Date().toISOString(),receipt:{path:'validation.json',bytes:receiptBytes.length,sha256:sha(receiptBytes)},snapshots,fullFeatureParity:false,universalSuperiority:false},null,2)+'\n',{flag:'wx'});
