    },
    {
      "id": "grafana.candidate.573c59b0805a4e85d9fb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana provides data links or correlations, allowing you to convert any part of a log message into an internal or external link. These links enable you to navigate to related data or external resources, offering a seamless and convenient way to explore additional information.",
      "headingPath": [
        "Logs in Explore",
        "Logs",
        "Log details view",
        "Links"
      ],
      "source": {
