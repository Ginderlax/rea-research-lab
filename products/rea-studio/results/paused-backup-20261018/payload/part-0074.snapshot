          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.2c131b7253de49c08b9f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can manage dashboards in Grafana by adding one or more YAML configuration files in the [`provisioning/dashboards`](../../setup-grafana/configure-grafana/#dashboards) directory. Each configuration file contains a list of `providers` that Grafana uses to load dashboards from the local filesystem.",
      "headingPath": [
        "Provision Grafana",
        "Dashboards"
      ],
      "source": {
        "path": "docs/sources/administration/provisioning/index.md",
        "gitBlobSha": "a6caad47dea63fb1a213a61490f8f587ad16bba2",
        "sha256": "ae39c9c2a4c0e896492c8df476ac2f5ddb821206f6828b18e8d6bb1c2489bf61",
        "lineStart": 339,
        "lineEnd": 340,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/provisioning/index.md#L339-L340"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.0d471d2fb5810013fe07",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When Grafana starts, it updates or creates all dashboards found in the configured path. These files can define the dashboard using the dashboard JSON:",
      "headingPath": [
        "Provision Grafana",
        "Dashboards",
        "Example dashboard configuration file"
      ],
      "source": {
        "path": "docs/sources/administration/provisioning/index.md",
