async function fingerprints(folder,names){const rows=[];for(const name of names){const b=await fs.readFile(path.join(folder,name));rows.push({path:name,bytes:b.length,sha256:digest(b)});}return rows;}
const baselineManifests=['baseline-manifest.json','production-baseline-manifest.json'],baselineRows=(await Promise.all(baselineManifests.map(async name=>JSON.parse(await fs.readFile(path.join(here,name)))))).flatMap(m=>m.files),productionNames=baselineRows.map(row=>row.source),productionBefore=await fingerprints(product,productionNames);
