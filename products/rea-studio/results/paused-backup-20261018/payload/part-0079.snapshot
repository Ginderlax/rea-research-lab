    {
      "id": "grafana.candidate.263ad49a40ed8bd9e720",
      "syntaxRole": "list-item",
      "sourceText": "- [**Breaking change** PhantomJS removed.](#breaking-change---phantomjs-removed)",
      "headingPath": [
        "What's new in Grafana v7.0"
      ],
