  assert.equal(preparation.length,852);assert.equal(beforeAfter.records.length,830);
  for(const r of preparation) match(await read(r.root,r.path),r,'preparation identity '+r.root+'/'+r.path);
  const finalActual=new Map(beforeAfter.records.map(r=>[`${r.sourceRoot}/${r.sourcePath}`,{bytes:r.bytes,sha256:r.sha256}]));
