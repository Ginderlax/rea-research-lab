    {
      "id": "grafana.candidate.a44e7a33f0089e7a7e9c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Click **Save & test** to verify that Grafana can connect to your OpenTSDB server. A successful test confirms that the URL is correct and the server is responding.",
