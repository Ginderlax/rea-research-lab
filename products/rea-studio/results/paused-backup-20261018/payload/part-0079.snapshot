    },
    {
      "id": "grafana.candidate.4714155aecfa79ac3346",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For more complex queries that are not covered by the options in the builder you can switch to the manual Code editor and edit the query.",
      "headingPath": [
        "What’s new in Grafana v11.2",
        "Data sources",
        "Cloudwatch Metric Insights cross account observability support"
      ],
