    {
      "id": "grafana.candidate.7bb24226428bd528ef8a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you have [organization administrator](../../roles-and-permissions/#organization-roles) permissions and _not_ [server administrator](../../roles-and-permissions/#grafana-server-administrators) permissions, refer to [Manage users in a organization](../manage-org-users/).",
      "headingPath": [
        "Server user management"
