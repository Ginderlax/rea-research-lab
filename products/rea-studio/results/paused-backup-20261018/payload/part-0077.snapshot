    {
      "id": "grafana.candidate.563cf813a22df450596f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Once you have configured the LDAP settings, click **Save** to persist the configuration.",
      "headingPath": [
        "Configure LDAP authentication using the Grafana user interface",
        "Steps to configure LDAP authentication",
        "4. Persisting the configuration"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/ldap-ui/_index.md",
        "gitBlobSha": "2d749dad98e59ace7ff12b4b2ca4591e0358050f",
        "sha256": "fe97a1e1d8dd1f68e5d7fa181134d9b1972f2df61a2a774237a5d5ed0b2e0d6a",
        "lineStart": 120,
        "lineEnd": 120,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/ldap-ui/_index.md#L120-L120"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
