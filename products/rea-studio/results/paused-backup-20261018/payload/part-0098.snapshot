paths.push('products/rea-studio/apps/backup/results/compression-source-study/preservation-manifest.json',...preservation.snapshots.map(v=>v.path));
const fingerprints=()=>[...new Set(paths)].sort().map(path=>{const bytes=readFileSync(join(lab,path));return{path,bytes:bytes.length,sha256:sha(bytes)}});
const before=fingerprints(),startedAtUtc=new Date().toISOString();
const run=spawnSync(process.execPath,['--test','--test-reporter=tap','products/rea-studio/apps/backup/restic-compression.test.mjs','products/rea-studio/apps/backup/restic-compression-review.test.mjs'],{cwd:lab,encoding:'utf8',timeout:180000,maxBuffer:4*1024*1024,windowsHide:true});
