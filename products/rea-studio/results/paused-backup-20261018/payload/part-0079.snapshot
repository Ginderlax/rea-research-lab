    },
    {
      "id": "grafana.candidate.a5cbb8493c9e6075b69a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "With millions of users across the globe, Grafana has a global footprint. In order to make it accessible to a wider audience, we have taken the first steps in localizing key workflows. You can now set Grafana’s language for the navigation, viewing dashboards, and some settings. This will cover the main activities a Viewer performs within Grafana.",
      "headingPath": [
        "What's new in Grafana v9.3",
        "View dashboards in Spanish, French, German, and Simplified Chinese"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-3.md",
        "gitBlobSha": "acf11473ed5777a12056a218dd89128f81813beb",
        "sha256": "64900ffbe97db576e8db0598932deb044076d62fbd415d6bfd717f2d4b707209",
        "lineStart": 46,
        "lineEnd": 46,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v9-3.md#L46-L46"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.03c113623de8c4defd7e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Read more about configuring the [default language for your organization](../../administration/organization-preferences/) and [updating your profile](../../administration/user-management/user-preferences/) in our documentation.",
      "headingPath": [
        "What's new in Grafana v9.3",
        "View dashboards in Spanish, French, German, and Simplified Chinese"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-3.md",
        "gitBlobSha": "acf11473ed5777a12056a218dd89128f81813beb",
