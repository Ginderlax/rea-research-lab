import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import {spawn} from 'node:child_process';
const root=path.dirname(new URL(import.meta.url).pathname.replace(/^\/(\w:)/,'$1')),stage=path.resolve(root,'../notes-trash-next'),hash=b=>createHash('sha256').update(b).digest('hex');
async function fingerprint(file){const b=await fs.readFile(file);return{path:file,bytes:b.length,sha256:hash(b)};}
const manifestFile=path.join(stage,'preservation-manifest.json'),receiptFile=path.join(stage,'trash-validation.final.json'),manifest=JSON.parse(await fs.readFile(manifestFile));
if((await fingerprint(manifestFile)).sha256!=='aaa0b6f1f3fcf3b642e6cf23aec76b7596006cb39d49b073bac55b6af2af563b'||(await fingerprint(receiptFile)).sha256!=='f7d210df1eb4312a1de9a8c3d51a63a83b99de9c056964edfcfb525e1b99a9f3'||manifest.records.length!==325)throw new Error('Freeze identity mismatch');
async function authenticate(){for(const row of manifest.records){const candidate=path.resolve(stage,row.path);if(!candidate.startsWith(stage+path.sep))throw new Error('Unsafe manifest path');const actual=await fingerprint(candidate);if(actual.bytes!==row.bytes||actual.sha256!==row.sha256)throw new Error('Changed stage '+row.path);}}
await authenticate();await fs.mkdir(path.join(root,'source-baseline'),{recursive:true});const selected=['products/rea-studio/apps/notes/client.mjs','products/rea-studio/apps/notes/server.mjs','products/rea-studio/apps/notes/notebook-trash.mjs','products/rea-studio/apps/notes/notebook-trash-original-oracle.mjs','products/rea-studio/apps/notes/notebooks.mjs','README.md','trash-source-provenance.json','prior-source-provenance.json','preservation-manifest.json','freeze.json','trash-validation.final.json'];
for(const p of selected){const dest=path.join(root,'source-baseline',p+'.snapshot');await fs.mkdir(path.dirname(dest),{recursive:true});await fs.copyFile(path.join(stage,p),dest);}
const before=await Promise.all(selected.map(p=>fingerprint(path.join(stage,p)))),startedAt=new Date().toISOString();
await fs.writeFile(path.join(root,'source-before.json'),JSON.stringify(before,null,2)+'\n');
const result=await new Promise((resolve,reject)=>{const child=spawn(process.execPath,['--test','--test-concurrency=1',path.join(root,'review.test.mjs')],{cwd:root,windowsHide:true,stdio:['ignore','pipe','pipe'],env:{...process.env,NODE_TEST_CONTEXT:undefined}}),logs={stdout:[],stderr:[]};let total=0,termination=null;const timer=setTimeout(()=>{termination='deadline';child.kill();},60000);for(const name of['stdout','stderr'])child[name].on('data',b=>{total+=b.length;if(total>4*1024*1024){termination='output cap';child.kill();}else logs[name].push(b);});child.on('error',reject);child.on('close',(code,signal)=>{clearTimeout(timer);resolve({code,signal,termination,stdout:Buffer.concat(logs.stdout),stderr:Buffer.concat(logs.stderr)});});});
await fs.writeFile(path.join(root,'review.stdout.txt'),result.stdout);await fs.writeFile(path.join(root,'review.stderr.txt'),result.stderr);await authenticate();const after=await Promise.all(selected.map(p=>fingerprint(path.join(stage,p))));if(JSON.stringify(before)!==JSON.stringify(after))throw new Error('Stage changed during review');await fs.writeFile(path.join(root,'run.json'),JSON.stringify({startedAt,completedAt:new Date().toISOString(),exitCode:result.code,signal:result.signal,termination:result.termination,stageArtifactCount:325,stageStable:true,sources:before},null,2)+'\n');console.log(JSON.stringify({exitCode:result.code,stageStable:true,stdoutBytes:result.stdout.length,stderrBytes:result.stderr.length}));process.exitCode=result.code;
