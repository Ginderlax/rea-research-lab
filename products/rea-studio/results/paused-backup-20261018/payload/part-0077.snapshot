    {
      "id": "grafana.candidate.a6f4635c4d96e2270925",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This setting is only used in as a part of the `root_url` setting (see below). Important if you use GitHub or Google OAuth.",
