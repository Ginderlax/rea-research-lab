let seed=0x41d7be69;const random=()=>{seed^=seed<<13;seed^=seed>>>17;seed^=seed<<5;return seed>>>0;},cases=[];
for(const n of [17,257,2053,25000]){
  cases.push(['quadratic-drift-'+n,Array.from({length:n},(_,i)=>i*i/8192-37.0625)],['phase-bands-'+n,Array.from({length:n},(_,i)=>Math.sin((i%113)*.17)*31+(i%3)*.03125)],['rank-ties-'+n,Array.from({length:n},(_,i)=>i%20===19?95.125:Math.floor(i*997/n)/8)],['chunk-reset-'+n,Array.from({length:n},(_,i)=>(i%97)*.0625-(Math.floor(i/97)%7)*2)],['skew-tail-'+n,Array.from({length:n},(_,i)=>i%53===0?1e6+i/16:(random()%4099)/1024)],['interleaved-curves-'+n,Array.from({length:n},(_,i)=>i%2?(n-i)**2/16384:-i/32)],['tiny-magnitudes-'+n,Array.from({length:n},(_,i)=>i%13?((i%7)-3)*Number.MIN_VALUE:(i%5)*1e-280)],['null-gap-runs-'+n,Array.from({length:n},(_,i)=>i%67<19?null:(random()%65537-32768)/64)]);
