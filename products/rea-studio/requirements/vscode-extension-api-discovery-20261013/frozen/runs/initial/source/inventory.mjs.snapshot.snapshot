 const span=(start,end)=>{if(start<0||end<start||end>text.length)throw new Error('Invalid span');const a=sf.getLineAndCharacterOfPosition(start),b=sf.getLineAndCharacterOfPosition(end);return{utf16Start:start,utf16End:end,utf16Length:end-start,utf8Start:prefix[start],utf8End:prefix[end],utf8Length:prefix[end]-prefix[start],startLine:a.line+1,startColumn:a.character+1,endLine:b.line+1,endColumn:b.character+1,sha256:hash(Buffer.from(text.slice(start,end)))};};
