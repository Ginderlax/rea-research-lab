    },
    {
      "id": "grafana.candidate.f4d9a8a98890179b93c4",
      "syntaxRole": "table-row",
      "sourceText": "| Y Bucket | This setting determines how the y-axis is split into buckets. Choose from **Size** or **Count**. |",
      "headingPath": [
        "Heatmap",
        "Configuration options",
        "Heatmap options"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/heatmap/index.md",
