    {
      "id": "grafana.candidate.74d91c8b28198e68f6cc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The following examples show you how to set your [configuration](../../../configure-grafana/) or [provisioning](../../../../administration/provisioning/) files to use Vault to retrieve configuration values.",
      "headingPath": [
        "Integrate Grafana with Hashicorp Vault",
        "Using the Vault expander",
        "Examples"
      ],
