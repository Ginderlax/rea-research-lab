    {
      "id": "grafana.candidate.f73a40d952dcdc3e62f7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Instead of hard-coding server, application, and sensor names in your metric queries, you can use template variables. Variables appear as drop-down menus at the top of the dashboard, so you can change the data being displayed without editing queries.",
      "headingPath": [
        "OpenTSDB template variables"
      ],
      "source": {
        "path": "docs/sources/datasources/opentsdb/template-variables/index.md",
