import test from 'node:test';
import assert from 'node:assert/strict';
import { executeWorkflow, validateWorkflow, example, setPath } from './core.mjs';
import { handle } from './server.mjs';
import { createStore } from '../../lib/storage.mjs';
import { mkdtemp, rm } from 'node:fs/promises'; import { tmpdir } from 'node:os'; import { join } from 'node:path';
function memory() { const map = new Map(); return { get: async (key, fallback) => structuredClone(map.has(key) ? map.get(key) : fallback), set: async (key, value) => map.set(key, structuredClone(value)) }; }
test('order aggregation runs a complete saved workflow and persists history', async () => { const store = memory(); const { workflow } = await handle({ action: 'save', input: { workflow: example }, store }); const { run } = await handle({ action: 'run', input: { id: workflow.id, items: [{ amount: 125 }, { amount: 50 }, { amount: 200 }] }, store }); assert.equal(run.status, 'completed'); assert.deepEqual(run.outputs.result, [{ total: 325, count: 2, numericCount: 2 }]); assert.equal((await handle({ action: 'history', input: { id: workflow.id }, store })).runs.length, 1); });
test('branch partitions without mutating input and map reads nested paths', () => { const flow = { name: 'Branch', nodes: [{ id: 'a', type: 'input' }, { id: 'b', type: 'branch', config: { field: 'user.age', op: 'gte', value: 18 } }, { id: 'c', type: 'map', config: { keep: false, fields: { age: { from: 'user.age' } } } }, { id: 'yes', type: 'output' }, { id: 'no', type: 'output' }], edges: [{ from: 'a', to: 'b' }, { from: 'b', to: 'c', port: 'true' }, { from: 'c', to: 'yes' }, { from: 'b', to: 'no', port: 'false' }] }; const input = [{ user: { age: 30 } }, { user: { age: 10 } }]; const { outputs } = executeWorkflow(flow, input); assert.deepEqual(outputs.yes, [{ age: 30 }]); assert.deepEqual(outputs.no, [{ user: { age: 10 } }]); assert.equal(input[0].age, undefined); });
test('rejects cycles, disconnected nodes, unsafe property paths and unknown operators', () => { assert.throws(() => validateWorkflow({ ...example, edges: [...example.edges, { from: 'total', to: 'qualify' }] }), /cycle/); assert.throws(() => validateWorkflow({ ...example, nodes: [...example.nodes, { id: 'orphan', type: 'output' }] }), /reachable/); assert.throws(() => setPath({}, '__proto__.infected', true), /Unsafe/); assert.throws(() => validateWorkflow({ ...example, nodes: example.nodes.map(n => n.type === 'filter' ? { ...n, config: { field: 'amount', op: 'eval' } } : n) }), /operator/); assert.equal({}.infected, undefined); });
test('execution failures are retained and delete removes listing', async () => { const store = memory(); const { workflow } = await handle({ action: 'save', input: { workflow: example }, store }); const { run } = await handle({ action: 'run', input: { id: workflow.id, items: [4] }, store }); assert.equal(run.status, 'failed'); await handle({ action: 'delete', input: { id: workflow.id }, store }); assert.deepEqual((await handle({ action: 'list', store })).workflows, []); });
test('reserved identifiers cannot mutate execution result prototypes', () => { const flow = { name: 'Unsafe', nodes: [{ id: '__proto__', type: 'input' }, { id: 'out', type: 'output' }], edges: [{ from: '__proto__', to: 'out' }] }; assert.throws(() => executeWorkflow(flow, [{}]), /safe/); });
test('real disk store persists workflows and runs using host-compatible record keys', async () => { const directory = await mkdtemp(join(tmpdir(), 'rea-automation-integration-')); try { const store = await createStore(directory); const saved = await handle({ action: 'save', input: { workflow: example }, store }); const run = await handle({ action: 'run', input: { id: saved.workflow.id, items: [{ amount: 200 }] }, store }); assert.equal(run.run.outputs.result[0].total, 200); const reopened = await createStore(directory); assert.equal((await handle({ action: 'list', store: reopened })).workflows.length, 1); assert.equal((await handle({ action: 'history', input: { id: saved.workflow.id }, store: reopened })).runs.length, 1); } finally { await rm(directory, { recursive: true, force: true }); } });
test('invalid non-branch output ports reject before silently discarding records', () => { const flow = { name: 'Wrong port', nodes: [{ id: 'a', type: 'input' }, { id: 'b', type: 'output' }], edges: [{ from: 'a', to: 'b', port: 'false' }] }; assert.throws(() => executeWorkflow(flow, [{ value: 1 }]), /Only branch/); });
test('aggregate overflow produces a retained failed run rather than serialized null', async () => { const store = memory(); const { workflow } = await handle({ action: 'save', input: { workflow: example }, store }); const { run } = await handle({ action: 'run', input: { id: workflow.id, items: [{ amount: Number.MAX_VALUE }, { amount: Number.MAX_VALUE }] }, store }); assert.equal(run.status, 'failed'); assert.match(run.error, /non-finite/); assert.equal(run.outputs, undefined); const retained = await handle({ action: 'history', input: { id: workflow.id }, store }); assert.equal(retained.runs[0].status, 'failed'); });
test('aggregate aliases support nested paths and cannot overwrite metadata', () => { const flow = structuredClone(example); flow.nodes.find(n => n.type === 'aggregate').config.as = 'summary.total'; assert.deepEqual(executeWorkflow(flow, [{ amount: 150 }]).outputs.result, [{ count: 1, numericCount: 1, summary: { total: 150 } }]); flow.nodes.find(n => n.type === 'aggregate').config.as = 'count'; assert.throws(() => validateWorkflow(flow), /overwrite/); });
