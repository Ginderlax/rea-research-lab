    {
      "id": "grafana.candidate.d36de1ba848ac8f59607",
      "syntaxRole": "list-item",
      "sourceText": "- Provides more learning resources",
      "headingPath": [
        "What’s new in Grafana v12.0",
        "Breaking changes in Grafana v12.0"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v12-0.md",
        "gitBlobSha": "7f6e72dff79df2cabe87d7a42070c6cfca04178e",
