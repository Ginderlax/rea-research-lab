    },
    {
      "id": "grafana.candidate.279aed98d96b30bd9b2e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Filters automatically query your data source for available dimensions and lets users add or remove filters and group by dimensions on the dashboard dynamically. This allows you to quickly apply filters dashboard-wide to all metric queries that use the specified data source. The group by function allows you to then group data by keys, letting you split it up.",
      "headingPath": [
        "Dashboard URL variables",
        "Filters and group by dimensions"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/build-dashboards/create-dashboard-url-variables/index.md",
        "gitBlobSha": "24aff38ae5ef68283008fce248d7fe7b5e3eaeae",
        "sha256": "463f7eccf2ce086f756eb333f48ffdaeb3249d7fe85c653001e41d1ac003eca1",
        "lineStart": 86,
        "lineEnd": 88,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/dashboards/build-dashboards/create-dashboard-url-variables/index.md#L86-L88"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.65a01bbe6752f8dbeb85",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To pass a filter as a query parameter, use the variable syntax to pass the filter. Then provide the key, operator, and value as a pipe-separated list.",
      "headingPath": [
        "Dashboard URL variables",
        "Filters and group by dimensions"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/build-dashboards/create-dashboard-url-variables/index.md",
        "gitBlobSha": "24aff38ae5ef68283008fce248d7fe7b5e3eaeae",
        "sha256": "463f7eccf2ce086f756eb333f48ffdaeb3249d7fe85c653001e41d1ac003eca1",
        "lineStart": 92,
        "lineEnd": 92,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/dashboards/build-dashboards/create-dashboard-url-variables/index.md#L92-L92"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
