    },
    {
      "id": "grafana.candidate.5398ecd65039092096f7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When using multiple data sources, it would display something like this:",
      "headingPath": [
        "Annotation and label template reference",
        "Variables",
        "$values",
        "$value"
      ],
      "source": {
        "path": "docs/sources/alerting/alerting-rules/templates/reference.md",
