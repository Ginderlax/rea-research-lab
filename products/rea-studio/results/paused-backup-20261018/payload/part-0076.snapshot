    {
      "id": "grafana.candidate.101b36fa1d84d1e235fc",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Use alias patterns such as `$tag_hostname` in the **ALIAS** field so each series has a unique display name. Refer to [Alias patterns](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/influxdb/query-editor/#alias-patterns) for details.",
      "headingPath": [
        "Troubleshoot InfluxDB data source issues",
