    {
      "id": "grafana.candidate.4dbeac3e2c327e68383a",
      "syntaxRole": "table-row",
      "sourceText": "| Show points         | Whether to show data points to lines or bars. Choose from: <ul><li>**Auto** - Grafana determines a point's visibility based on the density of the data. If the density is low, then points appear.</li><li>**Always** - Show the points regardless of how dense the dataset is.</li><li>**Never** - Don't show points.</li></ul> |",
      "headingPath": [
        "Table",
        "Configuration options",
        "Cell options",
        "Sparkline"
      ],
      "source": {
