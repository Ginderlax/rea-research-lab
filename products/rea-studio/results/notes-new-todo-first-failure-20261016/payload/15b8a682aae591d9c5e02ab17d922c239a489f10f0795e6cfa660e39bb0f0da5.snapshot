  465 | function nativeTar(archive, entry = null) {
  466 |   const executable=path.join(process.env.SystemRoot,'System32/tar.exe'),args=entry===null?['-tf',archive]:['-xOf',archive,entry]; const result=spawnSync(executable,args,{shell:false,windowsHide:true,timeout:10000,maxBuffer:1024*1024}); assert.equal(result.error,undefined); assert.equal(result.status,0,result.stderr.toString('utf8')); return result.stdout;
  467 | }
  468 | function rawRecord(bytes) { const lines=bytes.toString('utf8').split('\n');if(lines.at(-1)==='')lines.pop();let boundary=lines.length-1;while(boundary>=0&&lines[boundary]!=='')boundary--;assert(boundary>=0);const properties=Object.fromEntries(lines.slice(boundary+1).map(line=>{const m=/^([a-z][a-z0-9_]*): (.*)$/.exec(line);assert(m);return[m[1],m[2]];}));return{title:lines[0],body:lines.slice(2,boundary).join('\n'),properties}; }
