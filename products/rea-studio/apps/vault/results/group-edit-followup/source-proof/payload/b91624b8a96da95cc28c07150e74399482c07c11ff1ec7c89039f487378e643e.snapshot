import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{spawn}from'node:child_process';import{authenticate}from'./source-auth.mjs';
const here=import.meta.dirname,run='runs/fresh-'+new Date().toISOString().replace(/[:.]/g,'-'),root=path.join(here,run),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),json=v=>Buffer.from(JSON.stringify(v,null,2)+'\n');async function save(p,b){await fs.mkdir(path.dirname(path.join(root,p)),{recursive:true});await fs.writeFile(path.join(root,p),b,{flag:'wx'});}
const before=await authenticate();await save('authority-before.json',json(before));const sources=[];for(const p of['collect.mjs','source-auth.mjs','ui-fixture.mjs','draft-boundaries.test.mjs']){const b=await fs.readFile(path.join(here,p));sources.push({path:p,...id(b)});await save('source/'+p+'.snapshot',b);}for(const p of['client.mjs','server.mjs','recycle.mjs','kdbx.mjs','history.mjs','xml.mjs','group-fixture.mjs']){const b=await fs.readFile(path.resolve(here,'../vault-group-edit-next/products/rea-studio/apps/vault',p));await save('candidate-source/'+p+'.snapshot',b);}await save('review-sources-before.json',json(sources));const node=id(await fs.readFile(process.execPath));assert.equal(node.sha256,'b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3');
const env={...process.env,VAULT_GROUP_REVIEW_OUTPUT:root};delete env.NODE_TEST_CONTEXT;delete env.NODE_OPTIONS;delete env.NODE_V8_COVERAGE;const args=['--test','--test-isolation=none','--test-concurrency=1','--test-reporter=tap','draft-boundaries.test.mjs'];const child=spawn(process.execPath,args,{cwd:here,env,windowsHide:true,stdio:['ignore','pipe','pipe']}),out=[],err=[];let outBytes=0,errBytes=0,limit=null;const timer=setTimeout(()=>{limit='child20s';child.kill();},20000);for(const[channel,chunks]of[['stdout',out],['stderr',err]])child[channel].on('data',b=>{let bytes=channel==='stdout'?outBytes:errBytes;const left=1048576-bytes;if(left>0)chunks.push(b.subarray(0,left));bytes+=b.length;if(channel==='stdout')outBytes=bytes;else errBytes=bytes;if(bytes>1048576){limit=channel+'1MiB';child.kill();}});const exit=await new Promise(resolve=>child.on('close',(code,signal)=>resolve({code,signal})));clearTimeout(timer);const stdout=Buffer.concat(out),stderr=Buffer.concat(err);await save('stdout.txt',stdout);await save('stderr.txt',stderr);const after=await authenticate();assert.deepEqual(after,before);await save('authority-after.json',json(after));const sourceAfter=[];for(const r of sources)sourceAfter.push({path:r.path,...id(await fs.readFile(path.join(here,r.path)))});assert.deepEqual(sourceAfter,sources);await save('review-sources-after.json',json(sourceAfter));const counts={};for(const key of['tests','pass','fail','skipped','cancelled','todo'])counts[key]=Number(stdout.toString().match(new RegExp('^# '+key+' (\\d+)$','m'))?.[1]);await save('validation.json',json({schema:'rea-vault-group-edit-independent-fresh-DOM-review/v1',run,counts,exit,limit,sourceStable:true,reviewSourceStable:true,node,nodeVersion:process.version,args,raw:{stdout:id(stdout),stderr:id(stderr)},DOMModel:true,canonicalFixtureReused:true,authorTestBodiesReadBeforeOwnCaseDesign:false,controlledResponseHolds:true,actualCandidateClientServer:true,originalExecutions:0,browserExecutions:0,productionWrites:0,candidateWrites:0,fullProductParity:false}));process.stdout.write(JSON.stringify({run,counts,exit,sourceStable:true,limit})+'\n');
