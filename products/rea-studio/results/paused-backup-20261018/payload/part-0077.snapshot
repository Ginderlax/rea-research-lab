    },
    {
      "id": "grafana.candidate.997da55ba189e7580ddf",
      "syntaxRole": "table-row",
      "sourceText": "| `allowed_organizations`      | No       | Yes                | List of comma- or space-separated organizations. The user should be a member of at least one organization to log in.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |                 |",
      "headingPath": [
        "Configure Generic OAuth authentication",
        "Configuration options"
      ],
      "source": {
