    {
      "id": "grafana.candidate.9b074ca735fb41577ee5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Caching currently works for all backend data sources. You can enable the cache globally or per data source, and you can configure the cache duration per data source. The cache is currently in-memory.",
      "headingPath": [
        "What's new in Grafana v7.5",
        "Enterprise features",
        "Query caching"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-5.md",
