    },
    {
      "id": "grafana.candidate.2e530019036b03f8580d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you migrate an API key to a service account, a service account is created with a service account token. Your existing API key—now migrated to a service account token—will continue working as before.",
      "headingPath": [
        "Migrate API keys to service account tokens"
      ],
