        "sha256": "edb4cc6f7fd075796d11237820052a62e2220cdfb904cbc4c113af5f6734066d",
        "lineStart": 230,
        "lineEnd": 230,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v7-4.md#L230-L230"
      },
