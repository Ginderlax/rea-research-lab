    {
      "id": "grafana.candidate.67120f68236db9c8deef",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Use `$__rate_interval` instead of hard-coded time windows in `rate()` queries. This variable automatically adjusts based on your scrape interval.",
      "headingPath": [
        "Troubleshoot Prometheus data source issues",
        "Configuration errors",
        "Scrape interval mismatch"
      ],
      "source": {
