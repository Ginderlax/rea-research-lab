import fs from 'node:fs/promises';import path from 'node:path';import crypto from 'node:crypto';import assert from 'node:assert/strict';import {fileURLToPath} from 'node:url';import {authenticate} from './prepare.mjs';
const root=path.dirname(fileURLToPath(import.meta.url)),hash=b=>crypto.createHash('sha256').update(b).digest('hex'),run='runs/2026-10-13T01-58-00.229Z';
const authority=await authenticate(),attempt=JSON.parse(await fs.readFile(path.join(root,run,'attempt.json'))),sources=JSON.parse(await fs.readFile(path.join(root,run,'sources-before.json'))),scope=JSON.parse(await fs.readFile(path.join(root,'scope-authentication.json'))),adapters=JSON.parse(await fs.readFile(path.join(root,'adapters.json'))),helper=JSON.parse(await fs.readFile(path.join(root,'helper-accounting-audit.json')));assert.deepEqual(attempt.summary,{tests:22,pass:22,fail:0,cancelled:0,skipped:0,todo:0});assert.equal(attempt.sourceStable,true);
const current=[];for(const r of sources.review){const b=await fs.readFile(path.join(root,r.path)),now={path:r.path,bytes:b.length,sha256:hash(b)};if(r.path!=='prepare.mjs')assert.deepEqual(now,r);current.push(now);}
const observationRecords=[];let observed=0;for(const name of ['inline-confirmation.json','independent.json','fresh-boundaries.json']){const b=await fs.readFile(path.join(root,run,'observations',name)),json=JSON.parse(b);observed+=json.length;observationRecords.push({path:run+'/observations/'+name,bytes:b.length,sha256:hash(b),groups:json.length});}assert.equal(observed,22);
const runtime=await Promise.all(['client.mjs','server.mjs','jex.mjs','markdown.mjs','notebooks.mjs','notebook-trash.mjs'].map(async name=>{const b=await fs.readFile(path.join(root,'source',name+'.snapshot'));return{path:name,bytes:b.length,sha256:hash(b)};}));
const receipt={schema:'rea-notes-inline-cancel-no-read-independent-review/v1',at:new Date().toISOString(),status:'finite-22-case-source-bound-acceptance',confirmedUnresolvedFindings:[],authority,rootAuthorReceipt:{sha256:'0de8e54eb885e0021ed7cdae08e3663f37e91f31645fc8dd93c62def9ad185f9',tests:69,pass:69,originalTopLevelHelperCallsAudited:41,reexecutedByIndependentReview:false},runtime,correction:{twoSubstitutionsExactlyReconstructed:scope.twoSubstitutionsExact,backendAndSupportUnchanged:scope.unchangedBackendAndSupportFiles},independent:{run,summary:attempt.summary,sourceStable:true,earlierReviewTestBodies:16,freshGroups:6,adapters:adapters.records,observations:observationRecords,originalExecutions:0,actualBrowserExecutions:0,actualHTTPHosts:0,ownedAttachmentFileFixtures:5,ownedAttachmentByteReadbacks:5,ownedAttachmentDirectoryCleanupChecks:5,domModelFixtureInstances:22,additionalReopenedViewRender:1,childTestProcesses:3},helperAudit:{path:'helper-accounting-audit.json',counts:helper.accounting,authenticatedSourceSpans:13,authenticatedAdditionalConstantHelper:1,authenticatedLicenses:scope.licenses.length,sourceAuthentication:'scope-authentication.json',wholeObjectComparisonClaim:false,internalInvocationTelemetryClaim:false},sourceEpochs:{executedReviewSources:sources.review,finalCurrentReviewSources:current,postRunCollectorOnlyChange:'prepare.mjs gained strict inventory checks; same run/test/runtime files remain exact. Source-only verify-scope.mjs successfully authenticated the stronger inventory. The original passing-run collector bytes remain in its source snapshots.'},failuresPreserved:{rootNegative:true,rootMissingPrerequisites:true,earlierReview:true,sourceOnlyCollector:[{path:'failures/scope-audit-v1',applicationFailureInferred:false,rawTransportBytesClaim:false}],readOnlyDiscoveryMistakes:helper.readOnlyDiscoveryMistakes},cleanup:{allOwnedChildProcessesExited:true,ownedTemporaryAttachmentDirectoriesRemoved:true,ownedHTTPHostsStarted:0,ownedBrowserTabsStarted:0,user4311Touched:false},limits:['DOM-model checks do not establish actual browser accessibility or full browser acceptance.','Retained original observations are audited, not reexecuted by this independent review.','No complete product/manual/workbench parity, original-grade security or superiority is established.'],flags:{fullProductParity:false,securityEquivalent:false,superiority:false,productionModified:false,frozenPriorEvidenceModified:false}};
await fs.writeFile(path.join(root,'review-validation.json'),JSON.stringify(receipt,null,2)+'\n');
const inventory={};let total=0;async function walk(p){for(const row of await fs.readdir(p,{withFileTypes:true})){const full=path.join(p,row.name);if(row.isDirectory())await walk(full);else if(row.isFile()){const rel=path.relative(root,full).replaceAll('\\','/');if(rel==='review-manifest.json')continue;const b=await fs.readFile(full);assert.ok(b.length<=32*1024*1024);total+=b.length;assert.ok(total<=128*1024*1024);inventory[rel]={bytes:b.length,sha256:hash(b)};}else throw Error('Nonregular review entry');}}await walk(root);
const receiptBytes=await fs.readFile(path.join(root,'review-validation.json')),manifest={schema:'rea-notes-inline-cancel-no-read-independent-freeze/v1',at:new Date().toISOString(),strict:true,selfExcluded:'review-manifest.json',files:Object.keys(inventory).length,totalBytes:total,receiptSHA256:hash(receiptBytes),inventory};await fs.writeFile(path.join(root,'review-manifest.json'),JSON.stringify(manifest,null,2)+'\n');const manifestBytes=await fs.readFile(path.join(root,'review-manifest.json'));console.log(JSON.stringify({receiptSHA256:hash(receiptBytes),manifestSHA256:hash(manifestBytes),files:manifest.files,totalBytes:total,summary:attempt.summary,sourceStable:true}));
