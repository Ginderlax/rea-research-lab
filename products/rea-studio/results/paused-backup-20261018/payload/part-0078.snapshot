    },
    {
      "id": "grafana.candidate.ac20eb9157e605a62ae1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can color the background or value text in a stat visualization: ![Stat visualization with three values in green and orange](/media/docs/grafana/panels-visualizations/screenshot-thresholds-value-v10.4.png)",
      "headingPath": [
        "Configure thresholds"
      ],
