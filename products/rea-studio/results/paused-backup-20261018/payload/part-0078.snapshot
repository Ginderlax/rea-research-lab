    },
    {
      "id": "grafana.candidate.be60f454bea5b8f0ff12",
      "syntaxRole": "list-item",
      "sourceText": "- `from` - Defines the lower limit of the time range, specified in ms, epoch, or relative time.",
      "headingPath": [],
      "source": {
        "path": "docs/sources/shared/dashboards/time-range-URLs.md",
        "gitBlobSha": "a80f5f4087e4d5fa54ea99b0d6d03f1c5d24b75c",
