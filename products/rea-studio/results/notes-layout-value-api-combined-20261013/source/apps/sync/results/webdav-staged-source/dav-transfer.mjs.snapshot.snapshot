import fs from 'node:fs/promises';
import path from 'node:path';
import {createHash,randomBytes} from 'node:crypto';
import {createWebDAV,remotePath,davLimits,connection} from './webdav.mjs';
import {compileFilters} from './native-filters.mjs';
import {compareDAV,davComparisonOptions} from './dav-comparison.mjs';
import {boundedInput} from './dav-input.mjs';
export const transferLimits=Object.freeze({entries:10000,depth:32,totalBytes:512*1024*1024,operationMilliseconds:120000,plans:100,planBytes:8*1024*1024,cacheBytes:32*1024*1024,expiresMilliseconds:15*60*1000});
const hash=bytes=>createHash('sha256').update(bytes).digest('hex');
const ordered=(a,b)=>Buffer.compare(Buffer.from(a.path),Buffer.from(b.path));
const fingerprint=entries=>hash(Buffer.from(JSON.stringify(entries)));
const join=(root,relative)=>root ? root+(relative?'/'+relative:''):relative;
const expectedAt=(item,target)=>Object.fromEntries(['path','type','size','modifiedMs','etag','strongETag'].map(key=>[key,key==='path'?target:item[key]]));
export function createDAVTransfer(workspace,{clock=Date.now}={}) {
  const root=path.resolve(workspace), plans=new Map(); let cacheBytes=0,busy=false,closed=false;
  const expire=()=>{ for(const [token,plan] of plans) if(clock()-plan.created>=transferLimits.expiresMilliseconds) {plans.delete(token);cacheBytes-=plan.byteLength;} };
  function budget() {const started=clock();let entries=0,bytes=0;return {check(count=0,size=0){entries+=count;bytes+=size;if(closed || entries>transferLimits.entries || bytes>transferLimits.totalBytes || clock()-started>transferLimits.operationMilliseconds) throw Error('WebDAV transfer scope is closed or exceeds its bounded inventory, byte or work budget.');}};}
  async function localRoot(relative) {
    remotePath(relative,false); if(relative.split('/').some(part=>part.toLowerCase().startsWith('.rea-sync'))) throw Error('Internal recovery directories cannot be transfer sources.');
    const base=await fs.realpath(root);if(base!==root)throw Error('Workspace aliases are unsupported.');let target=root;
    for(const part of relative.split('/')) {target=path.join(target,part);const st=await fs.lstat(target);if(st.isSymbolicLink() || !st.isDirectory() || await fs.realpath(target)!==target)throw Error('Source directory aliases are unsupported.');} return target;
  }
  async function localBytes(base,relative,guard=null) {
    remotePath(relative,false); const target=path.join(base,...relative.split('/'));let current=base;
    for(const part of relative.split('/')) {current=path.join(current,part);const st=await fs.lstat(current);if(st.isSymbolicLink() || await fs.realpath(current)!==current)throw Error('Source path aliases are unsupported.');}
    const handle=await fs.open(target,'r');try {const before=await handle.stat({bigint:true});if(!before.isFile() || before.nlink!==1n || before.size>BigInt(davLimits.file))throw Error('Source must be a bounded regular file with one link.');guard?.check(0,Number(before.size));const bytes=Buffer.alloc(Number(before.size));let offset=0;while(offset<bytes.length){guard?.check();const {bytesRead}=await handle.read(bytes,offset,Math.min(1024*1024,bytes.length-offset),offset);if(!bytesRead)throw Error('Source changed while reading.');offset+=bytesRead;}const extra=await handle.read(Buffer.alloc(1),0,1,bytes.length),after=await handle.stat({bigint:true});if(extra.bytesRead || before.size!==after.size || before.mtimeNs!==after.mtimeNs || before.ctimeNs!==after.ctimeNs || before.ino!==after.ino)throw Error('Source changed while reading.');return {bytes,size:bytes.length,modifiedMs:Number(before.mtimeNs)/1e6,mtimeNs:before.mtimeNs.toString(),sha256:hash(bytes)};}finally{await handle.close();}
  }
  async function scanLocal(base,guard) {
    const out=[];async function walk(relative,depth) {if(depth>transferLimits.depth)throw Error('Source depth exceeds its bound.');const target=path.join(base,...relative.split('/')),st=await fs.lstat(target);if(!st.isDirectory() || st.isSymbolicLink() || await fs.realpath(target)!==target)throw Error('Source directory aliases are unsupported.');const directory=await fs.opendir(target,{bufferSize:32});for await(const entry of directory){guard.check(1);const name=join(relative,entry.name);remotePath(name,false);if(entry.name.toLowerCase().startsWith('.rea-sync'))throw Error('Internal source entry is unsupported.');if(entry.isDirectory()){out.push({path:name,type:'directory'});await walk(name,depth+1);}else if(entry.isFile()){const {bytes,...meta}=await localBytes(base,name,guard);out.push({path:name,type:'file',...meta});}else throw Error('Source links and special files are unsupported.');}}
    await walk('',0);return out.sort(ordered);
  }
  async function scanRemote(client,destination,guard) {
    const out=[];async function walk(relative,depth) {if(depth>transferLimits.depth)throw Error('Remote depth exceeds its bound.');guard.check();for(const item of await client.list(join(destination,relative))){guard.check(1);const name=item.path.slice(destination?destination.length+1:0);if(item.type==='directory'){out.push({...item,path:name});await walk(name,depth+1);}else{if(!item.strongETag)throw Error('Transfer safety requires strong ETags for every existing destination file.');guard.check(0,item.size);const bytes=await client.read(item.path,{expected:item});out.push({...item,path:name,sha256:hash(bytes)});}}}
    const self=await client.stat(destination,{collection:true});if(!self || self.type!=='directory')throw Error('Existing destination collection required.');await walk('',0);return out.sort(ordered);
  }
  function safeInventory(items) {return items.map(item=>({...item}));}
  function remember(plan) {const token=randomBytes(24).toString('hex');plan.created=clock();plan.byteLength=Buffer.byteLength(JSON.stringify(plan));if(plan.byteLength>transferLimits.planBytes)throw Error('WebDAV plan exceeds its memory budget.');expire();while(plans.size>=transferLimits.plans || cacheBytes+plan.byteLength>transferLimits.cacheBytes){const [old]=plans.keys();cacheBytes-=plans.get(old).byteLength;plans.delete(old);}plans.set(token,structuredClone(plan));cacheBytes+=plan.byteLength;return token;}
  const summary=plan=>({endpoint:plan.endpoint,source:plan.source,destination:plan.destination,mode:plan.mode,operations:structuredClone(plan.operations),skipped:structuredClone(plan.skipped),comparison:plan.comparison,filters:plan.filters,counts:{copy:plan.operations.filter(x=>x.type==='copy').length,remove:plan.operations.filter(x=>x.type==='remove').length,mkdir:plan.operations.filter(x=>x.type==='mkdir').length},expiresAt:new Date(plan.created+transferLimits.expiresMilliseconds).toISOString(),safety:'Strong ETag conditional mutations and full inventory fingerprints; previous destination file bytes retained locally. Generic comparison has no shared hashes or writable modification times.'});
  async function exclusive(action) {if(closed || busy)throw Error('WebDAV transfer scope is closed or busy.');busy=true;try{return await action();}finally{busy=false;}}
  return {
    cache(){expire();return {plans:plans.size,bytes:cacheBytes,limits:transferLimits};},close(){closed=true;plans.clear();cacheBytes=0;},
    preview(input){return exclusive(async()=>{
      input=boundedInput(input,['endpoint','auth','source','destination','mode','filters','comparison']);const {endpoint}=connection({endpoint:input.endpoint,...(input.auth?{auth:input.auth}:{})});remotePath(input.destination??'');if(!['copy','sync'].includes(input.mode))throw Error('Use copy or sync.');const comparison=davComparisonOptions(input.comparison),filter=compileFilters(input.filters),guard=budget(),source=await localRoot(input.source),client=createWebDAV({endpoint,...(input.auth?{auth:input.auth}:{})});
      try {const sourceEntries=await scanLocal(source,guard),destinationEntries=await scanRemote(client,input.destination??'',guard),destinationMap=new Map(destinationEntries.map(x=>[x.path,x])),sourceMap=new Map(sourceEntries.map(x=>[x.path,x])),operations=[],skipped=[],matching={remaining:64000000};
        for(const item of sourceEntries)if(destinationMap.has(item.path) && destinationMap.get(item.path).type!==item.type)throw Error('Source and destination have a file/collection type collision.');
        for(const item of sourceEntries){if(item.type!=='file')continue;if(!filter.includeFile(item.path,item.size,matching) || item.path.split('/').slice(0,-1).some((_,index)=>!filter.includeDirectory(item.path.split('/').slice(0,index+1).join('/'),matching))){skipped.push({path:item.path,reason:'filtered-source'});continue;}const target=destinationMap.get(item.path);if(target?.type==='directory')throw Error('Source file collides with destination collection.');const decision=compareDAV(item,target,comparison);if(decision.type==='skip'){skipped.push({path:item.path,reason:decision.reason});continue;}
          const parts=item.path.split('/').slice(0,-1);for(let i=1;i<=parts.length;i++){const name=parts.slice(0,i).join('/'),existing=destinationMap.get(name);if(existing?.type==='file')throw Error('Source collection collides with destination file.');if(!existing && !operations.some(x=>x.type==='mkdir' && x.path===name))operations.push({type:'mkdir',path:name});}operations.push({type:'copy',path:item.path,reason:decision.reason,source:{...item},destination:target?{...target}:null});}
        if(input.mode==='sync')for(const item of destinationEntries)if(item.type==='file' && !sourceMap.has(item.path) && filter.includeFile(item.path,item.size,matching) && !item.path.split('/').slice(0,-1).some((_,index)=>!filter.includeDirectory(item.path.split('/').slice(0,index+1).join('/'),matching)))operations.push({type:'remove',path:item.path,reason:'destination-only',destination:{...item}});
        const plan={endpoint,source:input.source,destination:input.destination??'',mode:input.mode,comparison,filters:structuredClone(input.filters??{}),sourceEntries:safeInventory(sourceEntries),destinationEntries:safeInventory(destinationEntries),operations,skipped};const token=remember(plan);return {token,...summary({...plan,created:clock()})};
      }finally{client.close();input.auth=null;}
    });},
    apply(input){return exclusive(async()=>{
      input=boundedInput(input,['endpoint','auth','token','allowDeletes']);expire();if(typeof input.token!=='string' || !/^[a-f0-9]{48}$/.test(input.token) || !plans.has(input.token))throw Error('WebDAV preview is missing, expired or consumed.');const plan=plans.get(input.token),{endpoint}=connection({endpoint:input.endpoint,...(input.auth?{auth:input.auth}:{})});if(endpoint!==plan.endpoint)throw Error('Apply endpoint differs from the preview.');if(plan.operations.some(x=>x.type==='remove') && input.allowDeletes!==true)throw Error('Explicit removal approval is required.');const client=createWebDAV({endpoint,...(input.auth?{auth:input.auth}:{})}),guard=budget(),completed=[];let history=null,started=false,currentOperation=null;
      try {const base=await localRoot(plan.source),currentSource=await scanLocal(base,guard),currentDestination=await scanRemote(client,plan.destination,guard);if(fingerprint(currentSource)!==fingerprint(plan.sourceEntries) || fingerprint(currentDestination)!==fingerprint(plan.destinationEntries))throw Error('WebDAV preview is stale; source or destination changed.');
        plans.delete(input.token);cacheBytes-=plan.byteLength;started=true;
        if(plan.operations.length){const historyBase=path.join(root,'.rea-sync-history');try {await fs.mkdir(historyBase);}catch(error){if(error.code!=='EEXIST')throw error;}const st=await fs.lstat(historyBase);if(!st.isDirectory() || st.isSymbolicLink() || await fs.realpath(historyBase)!==historyBase)throw Error('Recovery directory aliases are unsupported.');history=path.join(historyBase,'dav-'+input.token);await fs.mkdir(history);const retained=[];
          for(const operation of plan.operations)if(operation.destination){guard.check();const expected=expectedAt(operation.destination,join(plan.destination,operation.path)),bytes=await client.read(expected.path,{expected});if(hash(bytes)!==operation.destination.sha256)throw Error('Destination changed before recovery retention.');const name=`${retained.length}.bin`;await fs.writeFile(path.join(history,name),bytes,{flag:'wx'});retained.push({path:operation.path,bytes:name,size:bytes.length,sha256:hash(bytes),etag:expected.etag});}
          await fs.writeFile(path.join(history,'manifest.json'),JSON.stringify({schemaVersion:1,endpoint:plan.endpoint,source:plan.source,destination:plan.destination,mode:plan.mode,retained,completed:[]},null,2)+'\n',{flag:'wx'});
        }
        for(const operation of plan.operations){guard.check();const target=join(plan.destination,operation.path);currentOperation={type:operation.type,path:operation.path,remoteMayHaveChanged:false};if(operation.type==='mkdir'){if(await client.stat(target))throw Error('Planned collection appeared before creation.');currentOperation.remoteMayHaveChanged=true;await client.mkdir(target);}else if(operation.type==='copy'){const {bytes,...meta}=await localBytes(base,operation.path);if(meta.sha256!==operation.source.sha256 || meta.mtimeNs!==operation.source.mtimeNs || meta.size!==operation.source.size)throw Error('Source changed immediately before upload.');const expected=operation.destination?expectedAt(operation.destination,target):null;currentOperation.remoteMayHaveChanged=true;await client.write(target,bytes,{expected});const current=await client.stat(target);if(!current?.strongETag || hash(await client.read(target,{expected:current}))!==operation.source.sha256)throw Error('Uploaded file verification failed.');}else {currentOperation.remoteMayHaveChanged=true;await client.remove(target,{expected:expectedAt(operation.destination,target)});}completed.push({type:operation.type,path:operation.path});currentOperation=null;if(history){const manifest=JSON.parse(await fs.readFile(path.join(history,'manifest.json'),'utf8'));manifest.completed=[...completed];await fs.writeFile(path.join(history,'manifest.json'),JSON.stringify(manifest,null,2)+'\n');}}
        return {applied:true,completed,retainedAt:history?path.relative(root,history).replaceAll('\\','/'):null,transaction:'Sequential conditional requests; whole-tree atomicity is unsupported.'};
      }catch(error){error.completed=structuredClone(completed);error.failedOperation=structuredClone(currentOperation);error.retainedAt=history?path.relative(root,history).replaceAll('\\','/'):null;error.planConsumed=started;throw error;}finally{client.close();input.auth=null;}
    });},
  };
}
