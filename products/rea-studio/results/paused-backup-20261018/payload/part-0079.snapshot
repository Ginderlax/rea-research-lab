    {
      "id": "grafana.candidate.b1e6c1a21cda2a9cbd63",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, the transform uses the first string field as the source. You can override this default setting by selecting **Field name** in the **Use as** column for the field you want to use instead.",
