    {
      "id": "grafana.candidate.89875d134e8b82b9dfd8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "These options control how images should be made public so they can be shared on services like Slack or email message.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[external_image_storage]`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
