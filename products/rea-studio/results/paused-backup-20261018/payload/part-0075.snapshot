    {
      "id": "grafana.candidate.91c33c12402d3c37bc27",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The Logs query builder is a [public preview feature](/docs/release-life-cycle/). It may not be enabled in all Grafana environments.",
