    },
    {
      "id": "grafana.candidate.7cb52da944595524e659",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "An Azure Resource Graph query is formatted as table data.",
      "headingPath": [
        "Azure Monitor query editor",
