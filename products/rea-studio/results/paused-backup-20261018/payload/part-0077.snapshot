    {
      "id": "grafana.candidate.c8ffe9deaeaf95908feb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If Users use the same email address in GitLab that they use with other authentication providers (such as Grafana.com), you need to do additional configuration to ensure that the users are matched correctly. Please refer to the [Using the same email address to login with different identity providers](../#using-the-same-email-address-to-login-with-different-identity-providers) documentation for more information.",
      "headingPath": [
        "Configure GitLab OAuth authentication"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/gitlab/index.md",
        "gitBlobSha": "60055d69865bdbc143aa7f58e3b08d13b64a58a6",
        "sha256": "11af01f967c74718eb99ac11c02fdfa3c3722d3fb4566916e5a70c0a5ecd2ac5",
        "lineStart": 29,
        "lineEnd": 29,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/gitlab/index.md#L29-L29"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.90d3dcba85081cfc5973",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Ensure you know how to create a GitLab OAuth application. Consult GitLab's documentation on [creating a GitLab OAuth application](https://docs.gitlab.com/ee/integration/oauth_provider.html) for more information.",
      "headingPath": [
        "Configure GitLab OAuth authentication",
        "Before you begin"
      ],
      "source": {
