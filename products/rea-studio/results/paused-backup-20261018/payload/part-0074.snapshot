    {
      "id": "grafana.candidate.abdb705bbdf219b9d975",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can create interactive links for Explore visualizations by setting up Correlations. These links can either run queries or generate external URLs related to presented data.",
