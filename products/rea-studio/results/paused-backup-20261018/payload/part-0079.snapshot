    },
    {
      "id": "grafana.candidate.3950e019aedfeb522140",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can customize the following standard options:",
      "headingPath": [
        "Flame graph",
        "Configuration options",
        "Standard options"
