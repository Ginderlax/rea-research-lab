    {
      "id": "grafana.candidate.e5523a8bb84dd2be68f4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**expression** : Regular expression. Named capture groups are mapped to variables matching the group name. If non-named matching groups are used a variable is created out of the first match. The value overrides the variable matching the input field or a new variable is created if mapValue is provided (check the example below)",
      "headingPath": [
        "Correlation",
        "Target query",
        "Regular expression transformation"
      ],
      "source": {
        "path": "docs/sources/administration/correlations/correlation-configuration/index.md",
        "gitBlobSha": "f01ef51d6708806dc074f63e55f543c0408d633b",
        "sha256": "fb4525128741c7b02cd6822866bed335a5a601af49f7ae89cdb7775390d7a0e1",
        "lineStart": 96,
        "lineEnd": 97,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/correlations/correlation-configuration/index.md#L96-L97"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.27eac095373e87c048f7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**mapValue** : Used with simple regex groups without named matching groups. By default, the first match overrides the variable with the name of the field that is used as the input. To change that default behavior you can specify the mapValue property. The provided name is used to create a new variable. This can be useful if your target query requires both the exact value and a part of the value extracted with the transformation.",
      "headingPath": [
        "Correlation",
        "Target query",
        "Regular expression transformation"
      ],
      "source": {
        "path": "docs/sources/administration/correlations/correlation-configuration/index.md",
        "gitBlobSha": "f01ef51d6708806dc074f63e55f543c0408d633b",
        "sha256": "fb4525128741c7b02cd6822866bed335a5a601af49f7ae89cdb7775390d7a0e1",
        "lineStart": 99,
        "lineEnd": 100,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/correlations/correlation-configuration/index.md#L99-L100"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.124310294b0f24c5d46c",
      "syntaxRole": "table-row",
      "sourceText": "| expression        | mapValue | output variables             | comment                                                                                           |",
      "headingPath": [
        "Correlation",
        "Target query",
        "Regular expression transformation"
      ],
