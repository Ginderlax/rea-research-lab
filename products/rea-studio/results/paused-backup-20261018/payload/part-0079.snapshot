    {
      "id": "grafana.candidate.8982179f1d4fe238984d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "With this awesome contribution from one of our community members, you can now toggle parsed fields in Explore if your logs are structured in `json` or `logfmt`.",
      "headingPath": [
        "What's new in Grafana v7.2",
        "Toggle parsed log fields"
      ],
      "source": {
