 const record=(epoch,p)=>{const rows=proof.records.filter(r=>r.epoch===epoch&&r.sourcePath===p);assert.equal(rows.length,1,epoch+' '+p);return rows[0];};const bytes=(epoch,p)=>bytesByPath.get(record(epoch,p).publicPath),data=(epoch,p)=>JSON.parse(bytes(epoch,p));
 const epochs=[];for(const[epoch,dir,pin,count]of pins){const authority=proof.epochs.find(r=>r.epoch===epoch);assert(authority);assert.equal(authority.originalDirectory,'work/'+dir);assert.equal(authority.manifestSha256,pin);assert.equal(authority.frozenPayloads,count);const manifestBytes=await fs.readFile(path.join(work,dir,'manifest.json'));assert.equal(id(manifestBytes).sha256,pin);assert(bytes(epoch,'manifest.json').equals(manifestBytes));const manifest=JSON.parse(manifestBytes);assert(Array.isArray(manifest.inventory));assert.equal(manifest.inventory.length,count);const expected=[...manifest.inventory.map(r=>r.path),'manifest.json'];const seen=new Set();for(const row of manifest.inventory){safe(row.path);assert(!seen.has(row.path));seen.add(row.path);const b=await fs.readFile(path.join(work,dir,row.path));assert.deepEqual(id(b),{bytes:row.bytes,sha256:row.sha256});assert(bytes(epoch,row.path).equals(b));}if(authority.freezeSidecar){const f=await fs.readFile(path.join(work,dir,'freeze.json'));assert.deepEqual(id(f),authority.freezeSidecar);assert(bytes(epoch,'freeze.json').equals(f));assert.equal(JSON.parse(f).manifest.sha256,pin);expected.push('freeze.json');}const entire=await tree(path.join(work,dir));const excluded=entire.filter(p=>p.split('/').includes('.local'));if(excluded.length)assert(manifest.excluded?.includes('.local/**'),'An original declared local-directory exclusion is mandatory');assert.deepEqual(entire.filter(p=>!p.split('/').includes('.local')).sort(),expected.sort());assert.equal(proof.records.filter(r=>r.epoch===epoch).length,expected.length);await save('epoch-manifests/'+epoch+'.json.snapshot',manifestBytes);epochs.push({epoch,manifest:id(manifestBytes),payloads:count,aliases:expected.length,strictCensus:true,declaredLocalOnlyPathsExcluded:excluded});}
 const gitHead=spawnSync('git',['rev-parse','HEAD'],{cwd:lab,encoding:'utf8',windowsHide:true}),gitStatus=spawnSync('git',['status','--porcelain'],{cwd:lab,encoding:'utf8',windowsHide:true});assert.equal(gitHead.status,0);assert.equal(gitStatus.status,0);assert.equal(gitHead.stdout.trim(),'f0b4746eae49b2a83694de1a0a28fee63e004257');assert.equal(gitStatus.stdout.trim(),'');await save('current-git.json',json({head:gitHead.stdout.trim(),status:gitStatus.stdout,gitReadOnlyCommands:2,applicationExecutions:0}));
 assert.equal(plan.rows.length,16);assert.equal(plan.count,16);assert.equal(plan.existing,4);assert.equal(plan.additions,12);assert.equal(plan.sourceOnly,true);assert.equal(plan.installedBehaviorExecuted,false);assert.equal(plan.currentFocusedOriginalAdapterAcceptance,false);assert.equal(plan.fullParity,false);assert.equal(plan.universalSuperiority,false);assert.equal(plan.sharedServerChanges,0);assert.equal(plan.historical159Sources232CapabilitiesUnchanged,true);
