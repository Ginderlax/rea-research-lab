    {
      "id": "grafana.candidate.41a720bbb0e2f9650aba",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When using multiple Alertmanagers, use the `Choose Alertmanager` dropdown to switch between Alertmanagers.",
      "headingPath": [
        "Configure Alertmanagers",
        "Add an Alertmanager"
      ],
      "source": {
        "path": "docs/sources/alerting/set-up/configure-alertmanager/_index.md",
