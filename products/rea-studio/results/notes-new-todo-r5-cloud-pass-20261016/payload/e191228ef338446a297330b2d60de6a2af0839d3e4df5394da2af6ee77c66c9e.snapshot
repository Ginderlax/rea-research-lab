"""Portable ZIP/source evidence reader only. Never imports or executes product code.
This pending-identity template MUST be versioned to an exact completed run first.
"""
import hashlib,io,json,re,stat,struct,subprocess,sys,tarfile,traceback,zipfile,zlib
from pathlib import Path
RUN='PENDING_ACTUAL_RUN_ID'
HEAD='PENDING_COMMITTED_HEAD'
assert re.fullmatch(r'[0-9]+',RUN) and re.fullmatch(r'[0-9a-f]{40}',HEAD),'Unbound template must not run'
WORK=Path(__file__).resolve().parent;LAB=WORK.parent/'outputs/rea-research-lab'
source=Path(sys.argv[1]).resolve();expected=sys.argv[2];ROLE=sys.argv[3]
assert ROLE in ('finite','browser') and sys.argv[4:]==[RUN,HEAD]
assert source.is_relative_to((WORK/'cloud-verification-backups').resolve()) and source.parent.name=='run-'+RUN
assert re.fullmatch(r'[0-9a-f]{64}',expected)
sha=lambda b:hashlib.sha256(b).hexdigest()
identity=lambda b:{'bytes':len(b),'sha256':sha(b)}
pin=lambda r:{k:r[k]for k in ('bytes','sha256')}
PREFIX='products/rea-studio/'
BUNDLE=PREFIX+'experiments/notes-new-todo/bundle.json'
COMPOSER=PREFIX+'scripts/compose-notes-new-todo-cloud.mjs'
COLLECTOR=PREFIX+'scripts/verify-notes-new-todo-cloud.mjs'
WORKFLOW='.github/workflows/notes-new-todo-experiment-cloud.yml'
PINS={BUNDLE:{'bytes':31483,'sha256':'37f8d9780bf1d12b0963c3ee8765df93885ac53f2d2601856dd68822b44a8d74'},COMPOSER:{'bytes':19432,'sha256':'41c18b37ccc696d161d9f439f0fcee2aeb32194cce6256a8ca8a68d9897c2733'},COLLECTOR:{'bytes':33133,'sha256':'6fa931d17d1f5af36fa6c8a90060c272d5f2feeccac207636eabc14dd8346b14'},WORKFLOW:{'bytes':14958,'sha256':'1d9f81e8f342ffc3682e08263824e9892118cdf29b782bda2e9de3b6cd03b705'}}
raw=source.read_bytes();assert len(raw)<=16*1024*1024 and sha(raw)==expected
folder=source.parent/(source.stem+'-new-todo-r5-reader-v1');folder.mkdir(exist_ok=False)
def safe(root,name):
 assert isinstance(name,str)and name and not re.search(r'[\\:\x00-\x1f\x7f]',name)and not name.startswith('/')and all(p not in ('','.','..')for p in name.split('/'))
 result=(root/name).resolve();assert result.is_relative_to(root.resolve())and not result.is_symlink();return result
def unpack(archive,destination,file_limit,byte_limit,individual_limit):
 destination.mkdir(parents=True,exist_ok=False);rows=[];names=set()
 with zipfile.ZipFile(archive)as z:
  entries=z.infolist();assert len(entries)<=file_limit and sum(r.file_size for r in entries)<=byte_limit
  for row in entries:
   assert row.filename not in names;names.add(row.filename);assert not stat.S_ISLNK(row.external_attr>>16)
   target=safe(destination,row.filename.rstrip('/'))
   if row.is_dir():target.mkdir(parents=True,exist_ok=True);continue
   assert row.file_size<=individual_limit;data=z.read(row);assert len(data)==row.file_size
   target.parent.mkdir(parents=True,exist_ok=True)
   with target.open('xb')as out:out.write(data)
   assert target.read_bytes()==data;rows.append({'path':row.filename,**identity(data),'zipCRC32':format(row.CRC,'08x')})
 return rows
outer=unpack(source,folder/'downloaded-contents',4,16*1024*1024,15*1024*1024)
assert len(outer)==1 and outer[0]['path']in('rea-notes-new-todo-'+ROLE+'-'+RUN+'-1.zip','rea-notes-new-todo-incomplete-'+ROLE+'-'+RUN+'-1.zip')
archive=folder/'downloaded-contents'/outer[0]['path'];evidence=folder/'readable-evidence'
files=unpack(archive,evidence,2500,96*1024*1024,8*1024*1024)
def content(name):
 p=safe(evidence,name);assert p.is_file()and p.stat().st_size<=8*1024*1024;return p.read_bytes()
def load(name):return json.loads(content(name).decode('utf-8-sig'))
def png(data):
 assert data[:8]==bytes.fromhex('89504e470d0a1a0a');at=8;dimensions=None;ended=False
 while at+12<=len(data):
  size=int.from_bytes(data[at:at+4],'big');kind=data[at+4:at+8];end=at+size+12;assert end<=len(data);payload=data[at+8:at+8+size];assert(zlib.crc32(kind+payload)&0xffffffff)==int.from_bytes(data[at+8+size:end],'big')
  if kind==b'IHDR':assert at==8 and size==13;dimensions=struct.unpack('>II',payload[:8])
  at=end
  if kind==b'IEND':assert size==0 and at==len(data);ended=True;break
 assert ended and dimensions==(1440,1100)
execution={'CI':'true','GITHUB_ACTIONS':'true','RUNNER_ENVIRONMENT':'github-hosted','RUNNER_OS':'Windows','RUNNER_ARCH':'X64','GITHUB_SHA':HEAD,'GITHUB_RUN_ID':RUN,'GITHUB_RUN_ATTEMPT':'1','GITHUB_REPOSITORY':'Ginderlax/rea-research-lab','GITHUB_JOB':'finite-twenty-one-file-selection'if ROLE=='finite'else'eight-real-chromium-scenarios'}
result={'schema':'rea-local-Notes-new-todo-R5-experiment-backup/v1','runId':RUN,'sourceCommit':HEAD,'role':ROLE,'artifact':str(source),'artifactSHA256':expected,'archiveBytes':len(raw),'portableEvidenceArchive':str(archive),'readableEvidence':str(evidence),'files':files,'allCRCAndBytesReadable':True,'recordedContractPassed':False,'evidenceConsistencyErrors':[],'localProductExecutions':0,'localTests':0,'localBuilds':0,'localBrowserExecutions':0,'fullParity':False,'superiority':False,'attempt':None}
tree_raw=subprocess.run(['git','-C',str(LAB),'ls-tree','-rz',HEAD],capture_output=True,check=True).stdout
tree={};modes={}
for item in tree_raw.split(b'\0'):
 if item:
  meta,name=item.split(b'\t',1);mode,kind,blob=meta.split()
  if kind==b'blob':tree[name.decode()]=blob.decode();modes[name.decode()]=mode
def gitbound(name,data):assert name in tree and modes[name]in(b'100644',b'100755')and hashlib.sha1(b'blob '+str(len(data)).encode()+b'\0'+data).hexdigest()==tree[name],name
def mapping(rows):
 assert isinstance(rows,list);d={r['path']:pin(r)for r in rows};assert len(d)==len(rows);return d
