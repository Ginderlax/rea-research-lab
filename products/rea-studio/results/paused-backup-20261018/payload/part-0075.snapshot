    {
      "id": "grafana.candidate.3edce804fae5f7c408b9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana includes built-in support for Alertmanager implementations in Prometheus and Grafana Mimir. After you add an Alertmanager data source, you can use the **Choose Alertmanager** drop-down in [Grafana Alerting](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/alerting/) to view and manage Alertmanager resources such as silences, contact points, and notification policies. You can also enable the Alertmanager to receive Grafana-managed alerts.",
      "headingPath": [
        "Alertmanager data source"
      ],
      "source": {
        "path": "docs/sources/datasources/alertmanager/_index.md",
