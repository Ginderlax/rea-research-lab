    {
      "id": "grafana.candidate.1b766e6a20ab47406107",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This timeout also affects alerting evaluations. If your alert rules use Log Analytics queries that exceed 30 seconds, you must increase this setting or alert evaluations fail with timeout errors. For alerting, also ensure your alert evaluation interval is long enough to accommodate the query duration.",
