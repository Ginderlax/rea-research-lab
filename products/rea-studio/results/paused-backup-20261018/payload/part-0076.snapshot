    {
      "id": "grafana.candidate.3c27f05949e7c730e711",
      "syntaxRole": "list-item",
      "sourceText": "- **SQL** - Standard SQL query language for InfluxDB 3.x and newer cloud products (Cloud Serverless, Cloud Dedicated, Clustered). InfluxData recommends SQL for new deployments. It supports JOINs, subqueries, and standard SQL functions. Refer to [InfluxDB SQL reference](https://docs.influxdata.com/influxdb/cloud-serverless/reference/sql/) for the full list of supported statements, operators, and functions.",
      "headingPath": [
        "Configure the InfluxDB data source",
        "Before you begin"
      ],
      "source": {
        "path": "docs/sources/datasources/influxdb/configure/_index.md",
        "gitBlobSha": "48e51cddd49bb025d09e0c040e81db0826e6f05d",
        "sha256": "eeb01a12d09a560072df50f6acfd13eb93181c39670772e30c9df0d2d7eb79ee",
        "lineStart": 54,
        "lineEnd": 54,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/influxdb/configure/_index.md#L54-L54"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.34bd147411880010a713",
      "syntaxRole": "list-item",
      "sourceText": "- **InfluxQL** - An SQL-like query language developed by InfluxData, available across all InfluxDB versions. InfluxQL doesn't support advanced functions such as JOINs. Refer to the [InfluxQL reference](https://docs.influxdata.com/influxdb/cloud-serverless/reference/influxql/) for details.",
      "headingPath": [
        "Configure the InfluxDB data source",
        "Before you begin"
      ],
      "source": {
        "path": "docs/sources/datasources/influxdb/configure/_index.md",
        "gitBlobSha": "48e51cddd49bb025d09e0c040e81db0826e6f05d",
        "sha256": "eeb01a12d09a560072df50f6acfd13eb93181c39670772e30c9df0d2d7eb79ee",
        "lineStart": 55,
        "lineEnd": 55,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/influxdb/configure/_index.md#L55-L55"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
