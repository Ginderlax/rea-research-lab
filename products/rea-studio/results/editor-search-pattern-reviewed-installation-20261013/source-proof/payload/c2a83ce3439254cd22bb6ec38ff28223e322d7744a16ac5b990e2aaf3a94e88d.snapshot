const matching=JSON.parse(await fs.readFile(path.join(root,'history/author573/runs/original-2026-10-13T03-58-26.442Z/source-after.json.snapshot')));assert.equal(matching.length,7);for(const r of matching)assert.deepEqual(id(await fs.readFile(path.join(root,r.path))),{bytes:r.bytes,sha256:r.sha256});await write('unchanged-matching-seven.json',{rows:matching,allSevenExact:true,original32Groups918PositionsAnd3DivergencesHistorical:true,newOriginalExecutions:0});const before31=JSON.parse(await fs.readFile(path.join(root,'history/author573/production-before.json.snapshot'))).rows;for(const r of before31)assert.deepEqual(id(await fs.readFile(path.join(repo,r.path))),{bytes:r.bytes,sha256:r.sha256});const beforeClient=await fs.readFile(path.join(root,'before-image/candidate/products/rea-studio/apps/editor/client.mjs.snapshot'),'utf8'),client=await fs.readFile(path.join(root,'candidate/products/rea-studio/apps/editor/client.mjs'),'utf8'),body=c=>c.slice(c.indexOf('async function save()'),c.indexOf('saveButton.onclick',c.indexOf('async function save()')));assert.equal(body(client),body(beforeClient));await write('unchanged-save-body.json',{exact:true,...id(Buffer.from(body(client))),scope:'Save request/content/revision/publication body byte-identical to author573; client guard addition is only result coordinate publication.'});
const stdout=await fs.readFile(path.join(root,'runs',run,'stdout.txt'),'utf8'),observations=stdout.split('\n').filter(s=>s.startsWith('# {')).map(s=>{try{return JSON.parse(s.slice(2)).editorTextareaNavigationObservations;}catch{return null;}}).filter(Boolean);assert.equal(observations.length,10);await write('textarea-model-observations.json',{cases:observations,modeledSubstrings:observations.reduce((n,r)=>n+r.expected.length,0),allSelectionsExact:true,nativeBrowser:false,modelNormalizationBoundToIndependentNativeProof141:true});const negative=JSON.parse(await fs.readFile(path.join(root,'negative-reference.json')));await write('validation.json',{schema:'rea-editor-pattern-textarea-correction/v1',at:new Date().toISOString(),status:'frozen-for-independent-review',focused:{path:'runs/'+run+'/validation.json',...record},candidateSources:41,sourceStable:true,modelGroupsAdded22:22,oldFocusedBodiesHistorical78:true,declaredAdaptedRegexUIFixture:true,sourceCoordinateChecks26:observations.reduce((n,r)=>n+r.expected.length,0),confirmedPreFixModelFailures:2,initialFixtureSetupErrorRetained:1,initialExecuted21SourceQualified:true,inverseClientAndFixtureExact:true,modifiedOriginalProposalRows:2,unchangedOriginalProposalRows:10,correctionNewRows:2,combinedLiveProposalRows:14,matchingSevenUnchanged:true,newOriginalEngineOrHelperCalls:0,oldOriginalComparisonsNotRerunOrRebound:true,saveBodyUnchanged:true,generationRevisionDirtyDraftGuardsRetained:true,exactNormalizedShownValueRequired:true,CRLFAndSurrogateInteriorEndpointsRefused:true,backendSourceLineLabelsRetained:true,rootSourceDiagnosticWrongGuessedFolderNotProductFailure:true,old573AndPlan44ExactRetained:true,negative141StrictReferenced:true,negative141Manifest:negative.manifest,negativeNativeBrowserChecks5:5,negativeNativeBrowserCorrectSelections0:0,negativeSourceCore16Pass:true,negativeWireLogNotDurableAndForcedCleanupDisclosed:true,source41AndProduction31Stable:true,productionWrites:0,publicWrites:0,browserExecutionsThisEpoch:0,originalWorkbenchExecutions:0,benchmarks:0,profiles:0,hostsWereInProcessFocusedFixturesOnly:true,independentCorrectedAcceptancePending:true,nativeDirtyCloseCancelStillUnverified:true,fullParity:false,semanticExhaustiveness:false,allWaysSuperior:false});
await write('README.md',Buffer.from('# Separate saved-source → textarea coordinate correction\n\nWORK-only pending independent/browser acceptance. Final100/100 zero skips/fails/cancel/todo,41 source rows exact before/after; current31 unchanged.22 new normalizing-model groups include26 literal/regex selected substrings plus boundary/lifecycle controls. Two pre-fix CRLF failures and one later fixture-setup error/source qualification remain exact. No actual corrected browser or original execution by this epoch.\n\nClient inline normalization/map is the only runtime change from573. It requires exact revision/clean source and exact LF-normalized DOM value, rejects invalid/CRLF/surrogate-interior endpoints and maps collapsed CRLF counts. Backend/worker/matching seven and Save body remain byte-identical. Bare-CR source labels retain saved LF-line geometry, even where native normalization displays extra lines. No new static route/vendor/dependency or benchmark.\n\nOld573+plan44 fully retained. Negative independent141 strict before/after authenticated and referenced, with selected exact native raw/finding/cleanup retained. Its five actual browser selections failed, including current-production controls; wire logs absent and forced cleanup remain disclosed. Original core16 and prepared/fresh engine comparison scopes stay historical.\n\nFour-row overlay replaces two original573 proposals (client and explicitly adapted regex UI fixture) and adds new22-case test/document. Ten other proposals remain exact. Combined prospective live14, no installed/public writes. Old source-only plan492→223 plus82 public-reconstructable fixture exclusions remains an unaccepted historical epoch. New current41 proof and actual corrected independent/browser campaign are required; old78 is not rebound.\n'));console.log(JSON.stringify({focused100:true,sources41Stable:true,overlay4:true,live14:true,inverseExact:true,matchingSevenExact:true,originalCalls0:true,productionWrites0:true}));
