import * as fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const root=fileURLToPath(new URL('./',import.meta.url)),hash=bytes=>createHash('sha256').update(bytes).digest('hex'),baseline=JSON.parse(await fs.readFile(path.join(root,'baseline-manifest.json'),'utf8'));
for(const item of baseline.files){for(const folder of [path.join(root,'baseline'),path.resolve(root,'../backup-rabin-next')]){const bytes=await fs.readFile(path.join(folder,item.path));assert.equal(bytes.length,item.bytes);assert.equal(hash(bytes),item.sha256);}}
const abort=JSON.parse(await fs.readFile(path.join(root,'lifecycle-abort-observations.json'),'utf8')),publication=JSON.parse(await fs.readFile(path.join(root,'lifecycle-publication-observations.json'),'utf8')),original=JSON.parse(await fs.readFile(path.join(root,'original-subset-observations.json'),'utf8'));
assert.ok(abort.cases.every(item=>item.materialFinding));assert.ok(publication.cases.every(item=>item.materialFinding));assert.equal(original.failure,null);assert.equal(original.cases.length,5);assert.ok(original.cases.every(item=>item.exactOrderedLengthsAndIds));assert.equal(original.commands.length,9);
async function fingerprints(names){const result=[];for(const name of names){const bytes=await fs.readFile(path.join(root,name));result.push({path:name,bytes:bytes.length,sha256:hash(bytes)});}return result;}
async function walk(folder,prefix=''){const result=[];for(const item of await fs.readdir(folder,{withFileTypes:true})){const name=prefix+item.name;if(item.isDirectory())result.push(...await walk(path.join(folder,item.name),name+'/'));else result.push(name);}return result;}
const fixtureNames=[];for(const item of await fs.readdir(root,{withFileTypes:true})){if(item.isDirectory()&&/^(abort|publication|original-subset)-fixture-/.test(item.name)){fixtureNames.push(...(await walk(path.join(root,item.name))).map(name=>item.name+'/'+name));}}
const sources=['baseline-manifest.json','preserve-baseline.mjs','lifecycle-probes.mjs','original-subset.mjs','record-pending-review.mjs','open-review.md','pending-review.json','fix-design-review.md','review-findings.md','finalize-review.mjs'];
const evidence=['lifecycle-abort-observations.json','lifecycle-publication-observations.json','original-subset-observations.json','lifecycle-abort.stdout.txt','lifecycle-abort.stderr.txt','lifecycle-publication.stdout.txt','lifecycle-publication.stderr.txt','original-subset.stdout.txt','original-subset.stderr.txt'];
const report={schema:'rea-rabin-independent-review/v1',completedAtUtc:new Date().toISOString(),runtime:process.version,platform:process.platform,stageReceiptSha256:baseline.stageReceiptSha256,stageAndBaselineBytesStable:true,baselineFiles:baseline.files.length,stageSourceFingerprints:baseline.files,reviewSourceFingerprints:await fingerprints(sources),evidenceFingerprints:await fingerprints(evidence),ownedSyntheticFixtureFingerprints:await fingerprints(fixtureNames.sort()),executions:[{name:'lifecycle-abort',exitCode:0,cases:2,reproduced:2},{name:'lifecycle-publication',exitCode:0,cases:1,reproduced:1},{name:'original-subset',exitCode:0,files:5,orderedChunkEntries:original.cases.reduce((sum,item)=>sum+item.originalChunks.length,0),originalExecutions:9,exactOrderedChunks:true}],materialDefects:[{name:'Missing post-stat abort/deadline guard',sources:[{path:'capture-file.mjs',line:32},{path:'capture-file.mjs',line:34},{path:'capture-file.mjs',line:35}],reproducedConsequences:abort.cases.map(item=>item.name)},{name:'Deadline-only temp cleanup rejects after commit',sources:[{path:'apps/backup/restic.mjs',line:120},{path:'apps/backup/restic.mjs',line:122}],inheritedFromCompressionWriter:true,reproducedConsequences:publication.cases.map(item=>item.name)}],scope:'Finite source-bound independent review and synthetic original comparisons. Prepared probes executed only after root closed Metrics timing interval. Write/sync/close failure and own-lock cleanup cases design-reviewed only. No app/stage edits, full parity, security or performance-superiority claim.',productionEdits:false,stageEdits:false,fullParity:false,securityVerified:false,performanceSuperiority:false};
const receipt=path.join(root,'review-validation.json');await fs.writeFile(receipt,JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({receipt,sha256:hash(await fs.readFile(receipt)),reviewSources:sources.length,evidence:evidence.length,fixtureFiles:fixtureNames.length,materialDefects:2,originalFiles:5,originalOrderedChunks:8,originalExecutions:9,stageUnchanged:true}));
