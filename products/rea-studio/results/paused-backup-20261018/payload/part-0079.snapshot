    {
      "id": "grafana.candidate.45e5c72e6b2f37779e3c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now use generative AI to assist you in your Grafana dashboards. So far generative AI can help you with the following tasks:",
      "headingPath": [
        "What’s new in Grafana v10.2",
        "Dashboards and visualizations",
        "Use AI to generate titles, descriptions, and change summaries"
      ],
      "source": {
