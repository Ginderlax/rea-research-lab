    {
      "id": "grafana.candidate.513b00de26f2e4c44c0e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana recommends setting this value to match your Microsoft SQL Server write frequency. For example, use `1m` if Microsoft SQL Server writes data every minute.",
      "headingPath": [
        "Configure the Microsoft SQL Server data source",
        "Configure the data source in the UI",
        "Min time interval"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/configure/index.md",
