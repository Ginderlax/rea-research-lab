    },
    {
      "id": "grafana.candidate.cb6bbed3d2a8d2009060",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When JWT validation is enabled, Grafana caches the JWKS keys to improve performance. The cache respects the `Cache-Control` header from the JWKS endpoint response. If no cache expiration is specified, keys are cached for 5 minutes by default.",
      "headingPath": [
        "Configure GitLab OAuth authentication",
        "Configure GitLab authentication client using the Grafana configuration file",
        "Configure JWT ID token validation"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/gitlab/index.md",
        "gitBlobSha": "60055d69865bdbc143aa7f58e3b08d13b64a58a6",
        "sha256": "11af01f967c74718eb99ac11c02fdfa3c3722d3fb4566916e5a70c0a5ecd2ac5",
        "lineStart": 160,
        "lineEnd": 160,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/gitlab/index.md#L160-L160"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
