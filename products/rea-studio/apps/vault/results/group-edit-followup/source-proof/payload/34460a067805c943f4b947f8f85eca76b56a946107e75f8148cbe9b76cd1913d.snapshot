import test from'node:test';import assert from'node:assert/strict';import{randomUUID}from'node:crypto';import{render}from'./client.mjs';import{handle,dispose}from'./server.mjs';import{Element,descendants,button,field,deferred,openEntry}from'./ui-fixture.mjs';
async function fixture(t,wrap){const workspace={root:'owned-group-edit-ui-'+randomUUID()},store={value:null,get:async()=>structuredClone(store.value),set:async(k,v)=>store.value=structuredClone(v)},api=(action,input={})=>handle({action,input,workspace,store}),requests=[];await api('create',{password:'Owned synthetic group UI editor master'});const A=(await api('save',{title:'A',group:'Parent/Selected',password:'Owned synthetic entry A'})).id;await api('save',{title:'B',group:'Parent/Selected/Deep',password:'Owned synthetic entry B'});const C=(await api('save',{title:'C',group:'Other',password:'Owned synthetic entry C'})).id;globalThis.document={createElement:tag=>new Element(tag)};const root=new Element('main'),cleanup=await render(root,async(action,input)=>{requests.push({action,id:input?.id,name:input?.name});return wrap?wrap(action,input,()=>api(action,input)):api(action,input)});t.after(()=>{cleanup();dispose(workspace);delete globalThis.document});return{root,api,store,requests,cleanup,A,C};}
function row(root,name='Selected'){const r=descendants(root).find(n=>n.tagName==='section'&&n.children.some(c=>c.tagName==='strong'&&c.textContent===name));assert(r,'Expected group row '+name);return r;}
function form(root){const f=descendants(root).find(n=>n.tagName==='section'&&n.children.some(c=>c.tagName==='h4'));assert(f,'Expected group editor');return f;}
const entryEditor=root=>descendants(root).find(n=>n.tagName==='section'&&n.children.some(c=>c.tagName==='h3'&&['New entry','Edit entry'].includes(c.textContent)));
async function begin(f,create=false,name='Selected'){await button(f.root,'Show groups').click();await button(row(f.root,name),create?'New child group':'Edit group details').click();return form(f.root);}
const mutate=(target,label,value,event=true)=>{const n=field(target,label);n.value=value;if(event)n.listeners.get('input')?.();return n;};
test('owned DOM creates empty native child, edits selected name/notes, and rerenders descendant entry paths',async t=>{const f=await fixture(t),create=await begin(f,true);mutate(create,'Group name','Owned empty child');mutate(create,'Group notes','Owned group notes');await button(create,'Create group').click();const child=(await f.api('recycleGroupList')).groups.find(g=>g.name==='Owned empty child');assert(child);assert.equal(child.entryCount,0);const edit=await begin(f);assert.equal(field(edit,'Group name').value,'Selected');mutate(edit,'Group name','Renamed');mutate(edit,'Group notes','Private group notes');await button(edit,'Save group details').click();const g=(await f.api('recycleGroupList')).groups.find(g=>g.name==='Renamed');assert.equal((await f.api('recycleGroupRead',{id:g.id,revision:g.recycleRevision})).group.notes,'Private group notes');assert.equal((await f.api('list')).entries.find(e=>e.title==='B').group,'Parent/Renamed/Deep');assert(f.root.textContent.includes('Parent/Renamed/Deep'));assert(!f.root.textContent.includes('Owned synthetic entry A'));assert(!descendants(f.root).some(n=>n.tagName==='h4'));});
test('root exposes creation/details but no root deletion control',async t=>{const f=await fixture(t),edit=await begin(f,false,'REA Vault'),r=row(f.root,'REA Vault');assert(!descendants(r).some(n=>n.tagName==='button'&&/delete group|Recycle group/.test(n.textContent)));mutate(edit,'Group name','Owned renamed root');await button(edit,'Save group details').click();assert((await f.api('recycleGroupList')).groups.some(g=>g.name==='Owned renamed root'));assert.equal((await f.api('list')).entries.find(e=>e.title==='A').group,'Parent/Selected');});
test('selected entry and unannounced dirty new-entry values refuse group writes before transport and preserve both drafts',async t=>{const f=await fixture(t),edit=await begin(f);mutate(edit,'Group name','Unsaved group');await openEntry(f.root,'A');await button(edit,'Save group details').click();assert.equal(f.requests.filter(r=>r.action==='groupSave').length,0);assert.equal(field(entryEditor(f.root),'Title').value,'A');await button(f.root,'New entry').click();mutate(entryEditor(f.root),'Notes','New unsaved entry notes',false);await button(edit,'Save group details').click();assert.equal(f.requests.filter(r=>r.action==='groupSave').length,0);assert.equal(field(entryEditor(f.root),'Notes').value,'New unsaved entry notes');assert.equal(field(edit,'Group name').value,'Unsaved group');});
test('group draft must be explicitly discarded before closing, switching lists/editor or recycling a group',async t=>{const f=await fixture(t),edit=await begin(f),notes=mutate(edit,'Group notes','Retained group draft',false),requests=f.requests.length;await button(f.root,'Show recycled groups').click();assert.equal(f.requests.length,requests);await button(row(f.root,'Other'),'Edit group details').click();assert.equal(f.requests.length,requests);await button(f.root,'Close group panel').click();assert.equal(form(f.root),edit);field(row(f.root),'Confirm recycle group and descendants').checked=true;await button(row(f.root),'Recycle group and descendants').click();assert.equal(f.requests.filter(r=>r.action==='recycleGroupDelete').length,0);field(f.root,'Confirm discarding unsaved group draft').checked=true;await button(f.root,'Close group panel').click();assert.equal(notes.value,'');assert(!descendants(f.root).some(n=>n.tagName==='h4'));});
test('group editor close refuses unsaved values until its own discard confirmation',async t=>{const f=await fixture(t),edit=await begin(f,true),name=mutate(edit,'Group name','Unsaved new group');await button(edit,'Close group editor').click();assert.equal(form(f.root),edit);field(edit,'Confirm discarding this unsaved group draft').checked=true;await button(edit,'Close group editor').click();assert.equal(name.value,'');assert(!descendants(f.root).some(n=>n.tagName==='h4'));assert.equal(f.requests.filter(r=>r.action==='groupCreate').length,0);});
for(const create of[false,true])test('held committed '+(create?'creation':'save')+' preserves newer group/entry drafts and renews only the saved group identity',async t=>{const entered=deferred(),release=deferred();t.after(()=>release.resolve());let hold=true;const f=await fixture(t,async(action,input,real)=>{const value=await real();if(hold&&action===(create?'groupCreate':'groupSave')){entered.resolve();await release.promise;hold=false;}return value}),edit=await begin(f,create),name=mutate(edit,'Group name','Submitted group'),notes=mutate(edit,'Group notes','Submitted notes'),save=button(edit,create?'Create group':'Save group details'),pending=save.click();await entered.promise;assert(save.disabled);mutate(edit,'Group name','Newer group draft');mutate(edit,'Group notes','Newer notes');const entry=entryEditor(f.root),title=mutate(entry,'Title','Newer entry draft');const count=f.requests.length;await button(f.root,'Search').click();await button(f.root,'Show recycle bin').click();await save.click();await button(f.root,'Save encrypted entry').click();assert.equal(f.requests.length,count);release.resolve();await pending;assert.equal(field(form(f.root),'Group name'),name);assert.equal(name.value,'Newer group draft');assert.equal(notes.value,'Newer notes');assert.equal(field(entryEditor(f.root),'Title'),title);assert.equal(title.value,'Newer entry draft');assert((await f.api('recycleGroupList')).groups.some(g=>g.name==='Submitted group'));await button(edit,'Save group details').click();assert.equal(f.requests.filter(r=>r.action==='groupSave'||r.action==='groupCreate').length,1);await button(f.root,'New entry').click();await button(edit,'Save group details').click();const groups=(await f.api('recycleGroupList')).groups;assert(groups.some(g=>g.name==='Newer group draft'));assert(!groups.some(g=>g.name==='Submitted group'));assert.equal(f.requests.filter(r=>r.action==='groupSave'||r.action==='groupCreate').length,2);});
test('failed creation/save keeps encrypted data exact and mounted user draft can retry unchanged revision',async t=>{for(const create of[false,true]){const f=await fixture(t),edit=await begin(f,create);mutate(edit,'Group name','Retry group');mutate(edit,'Group notes','Retry notes');const before=structuredClone(f.store.value),real=f.store.set;f.store.set=async()=>{throw new Error('Owned group UI persistence failure')};const save=button(edit,create?'Create group':'Save group details');await save.click();assert.deepEqual(f.store.value,before);assert.equal(save.disabled,false);assert.equal(field(form(f.root),'Group name').value,'Retry group');f.store.set=real;await save.click();assert((await f.api('recycleGroupList')).groups.some(g=>g.name==='Retry group'));}});
test('held committed group save cannot publish or read after view disposal; typed values are scrubbed',async t=>{const entered=deferred(),release=deferred();t.after(()=>release.resolve());const f=await fixture(t,async(action,input,real)=>{const value=await real();if(action==='groupSave'){entered.resolve();await release.promise;}return value}),edit=await begin(f),notes=mutate(edit,'Group notes','Owned disposable note'),pending=button(edit,'Save group details').click();await entered.promise;const count=f.requests.length;f.cleanup();assert.equal(notes.value,'');release.resolve();await pending;assert.equal(f.requests.length,count);assert(!descendants(f.root).some(n=>n.tagName==='h4'));});
test('close panel while committed create is held suppresses callback reads and preserves newly typed entry draft',async t=>{const entered=deferred(),release=deferred();t.after(()=>release.resolve());const f=await fixture(t,async(action,input,real)=>{const value=await real();if(action==='groupCreate'){entered.resolve();await release.promise;}return value}),edit=await begin(f,true),pending=button(edit,'Create group').click();await entered.promise;const title=mutate(entryEditor(f.root),'Title','Retained after close'),count=f.requests.length;await button(f.root,'Close group panel').click();release.resolve();await pending;assert.equal(f.requests.length,count);assert.equal(field(entryEditor(f.root),'Title'),title);assert.equal(title.value,'Retained after close');assert(!descendants(f.root).some(n=>n.tagName==='h4'));});
test('late group notes read cannot open a disposed or superseded group editor',async t=>{const entered=deferred(),release=deferred();t.after(()=>release.resolve());let hold=true;const f=await fixture(t,async(action,input,real)=>{const value=await real();if(hold&&action==='recycleGroupRead'){hold=false;entered.resolve();await release.promise;}return value});await button(f.root,'Show groups').click();const pending=button(row(f.root),'Edit group details').click();await entered.promise;await button(f.root,'Show recycled groups').click();release.resolve();await pending;assert(!descendants(f.root).some(n=>n.tagName==='h4'));});
test('held earlier descendant preview and active-entry read cannot republish after rename begins',async t=>{const readEntered=deferred(),previewEntered=deferred(),release=deferred();t.after(()=>release.resolve());let holdPreview=true;const f=await fixture(t,async(action,input,real)=>{const value=await real();if(action==='read'){readEntered.resolve();await release.promise;}if(action==='recycleGroupRead'&&holdPreview){holdPreview=false;previewEntered.resolve();await release.promise;}return value});await button(f.root,'Show groups').click();const selected=row(f.root),preview=button(selected,'Preview group descendants').click();await previewEntered.promise;await button(selected,'Edit group details').click();const edit=form(f.root),entry=openEntry(f.root,'A');await readEntered.promise;mutate(edit,'Group name','Rename while old reads held');await button(edit,'Save group details').click();release.resolve();await Promise.all([preview,entry]);assert.equal(field(entryEditor(f.root),'Title').value,'');assert(!f.root.textContent.includes('Entry: A'));assert(!descendants(f.root).some(n=>n.value==='Owned synthetic entry A'));});
test('older active list generation cannot republish after native creation commits',async t=>{const entered=deferred(),release=deferred();t.after(()=>release.resolve());let hold=false;const f=await fixture(t,async(action,input,real)=>{const value=await real();if(hold&&action==='list'){hold=false;entered.resolve();await release.promise;}return value}),edit=await begin(f,true);hold=true;const old=button(f.root,'Search').click();await entered.promise;mutate(edit,'Group name','New native child');await button(edit,'Create group').click();const rowsBefore=f.root.textContent;release.resolve();await old;assert.equal(f.root.textContent,rowsBefore);assert((await f.api('recycleGroupList')).groups.some(g=>g.name==='New native child'));});
test('earlier bin list and masked password preview are invalidated before group details commit',async t=>{for(const read of[false,true]){const entered=deferred(),release=deferred();t.after(()=>release.resolve());let hold=false;const f=await fixture(t,async(action,input,real)=>{const value=await real();if(hold&&action===(read?'recycleRead':'recycleList')){hold=false;entered.resolve();await release.promise;}return value}),C=(await f.api('list')).entries.find(e=>e.id===f.C);await f.api('recycleDelete',{id:C.id,revision:C.recycleRevision,confirm:true});const edit=await begin(f);let pending;if(read){await button(f.root,'Show recycle bin').click();hold=true;pending=button(row(f.root,'C'),'Preview recycled entry').click()}else{hold=true;pending=button(f.root,'Show recycle bin').click()}await entered.promise;mutate(edit,'Group name','Bin guarded rename');await button(edit,'Save group details').click();await button(f.root,'Show recycle bin').click();const state=f.root.textContent;release.resolve();await pending;assert.equal(f.root.textContent,state);assert(!descendants(f.root).some(n=>n.value==='Owned synthetic entry C'));}});
test('already displayed bin secret is scrubbed at group creation start and dirty refusal leaves it intact',async t=>{const entered=deferred(),release=deferred();t.after(()=>release.resolve());const f=await fixture(t,async(action,input,real)=>{const value=await real();if(action==='groupCreate'){entered.resolve();await release.promise;}return value}),C=(await f.api('list')).entries.find(e=>e.id===f.C);await f.api('recycleDelete',{id:C.id,revision:C.recycleRevision,confirm:true});const edit=await begin(f,true);await button(f.root,'Show recycle bin').click();await button(row(f.root,'C'),'Preview recycled entry').click();const secret=field(row(f.root,'C'),'Recycled password');assert.equal(secret.value,'Owned synthetic entry C');mutate(entryEditor(f.root),'Title','Unsaved entry');await button(edit,'Create group').click();assert.equal(secret.value,'Owned synthetic entry C');assert.equal(f.requests.filter(r=>r.action==='groupCreate').length,0);await button(f.root,'New entry').click();const pending=button(edit,'Create group').click();await entered.promise;assert.equal(secret.value,'');release.resolve();await pending;});
