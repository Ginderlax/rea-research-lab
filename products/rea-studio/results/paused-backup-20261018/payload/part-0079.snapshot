    {
      "id": "grafana.candidate.d0dfb5753b9f5254e19e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To only show the spans you've matched, you can enable the **Show matches only** toggle.",
      "headingPath": [
        "What’s new in Grafana v10.1",
        "Data sources",
        "Span filtering for traces is GA"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-1.md",
