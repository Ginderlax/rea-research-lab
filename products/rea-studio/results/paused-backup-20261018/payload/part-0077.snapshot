    {
      "id": "grafana.candidate.e7ca0f1598d551d3f44f",
      "syntaxRole": "table-row",
      "sourceText": "| `signout_redirect_url`   | No       | Yes                | URL to redirect to after the user logs out.                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |                               |",
      "headingPath": [
