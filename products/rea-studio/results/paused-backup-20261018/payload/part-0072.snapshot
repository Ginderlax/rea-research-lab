// Lightweight backup/orchestration only. It never imports repository code or executes a verifier.
import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { execFileSync } from 'node:child_process';

const work = 'C:/Users/evanh/Documents/Codex/2026-10-12/go/work';
const lab = 'C:/Users/evanh/Documents/Codex/2026-10-12/go/outputs/rea-research-lab';
const [run, artifact, expectedHead] = process.argv.slice(2);
assert(/^\d{8,12}$/.test(run) && /^\d{8,12}$/.test(artifact));
assert(/^[0-9a-f]{40}$/.test(expectedHead));
const derivedNames = ['PUBLICATION-MANIFEST.json', 'VALIDATION.json'];
const id = bytes => ({ bytes: bytes.length, sha256: createHash('sha256').update(bytes).digest('hex') });
const git = (...args) => execFileSync('git', ['-C', lab, ...args], { encoding: 'utf8', maxBuffer: 1024 * 1024 }).trim();
function safeRead(root, name, limit = 16 * 1024 * 1024) {
  assert(name && !/[\\:\x00-\x1f\x7f]/.test(name));
  let target = root;
  for (const part of name.split('/')) {
    assert(part && part !== '.' && part !== '..');
    target = path.join(target, part);
    assert(!fs.lstatSync(target).isSymbolicLink());
  }
  const stat = fs.lstatSync(target);
  assert(stat.isFile() && stat.size <= limit);
  const bytes = fs.readFileSync(target);
  assert.equal(bytes.length, stat.size);
  return bytes;
}
const runRoot = path.join(work, 'cloud-verification-backups', 'run-' + run);
const artifactRoot = path.join(runRoot, 'artifact-' + artifact);
const readable = path.join(artifactRoot, 'readable-evidence');
const collectionBytes = safeRead(runRoot, 'collection-summary.json');
const collection = JSON.parse(collectionBytes);
assert.equal(collection.schema, 'rea-readonly-completed-run-collection/v1');
assert.equal(collection.runId, run);
assert.equal(collection.headSHA, expectedHead);
assert.equal(collection.runStatus, 'completed');
assert.equal(collection.runConclusion, 'success');
assert.equal(collection.jobConclusion, 'success');
assert.equal(collection.artifacts.length, 1);
const collected = collection.artifacts[0];
assert.equal(String(collected.artifactId), artifact);
assert.equal(collected.readabilityVerified, true);
assert.equal(collected.readableFileCount, 91);
const zip = safeRead(runRoot, 'artifact-' + artifact + '.zip', 32 * 1024 * 1024);
assert.deepEqual(id(zip), { bytes: collected.bytes, sha256: collected.sha256 });
const verificationBytes = safeRead(artifactRoot, 'local-backup-verification.json');
const verification = JSON.parse(verificationBytes);
assert.equal(verification.schema, 'rea-local-publication-attempt-backup/v1');
assert.equal(verification.artifactSHA256, collected.sha256);
assert.equal(verification.archiveBytes, zip.length);
