    },
    {
      "id": "grafana.candidate.1cbc2974325aaec9e0cb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When a single data source is used in the alert rule, `$value` will return the query value directly.",
      "headingPath": [
        "Annotation and label template reference",
        "Variables",
        "$values",
        "$value"
      ],
      "source": {
        "path": "docs/sources/alerting/alerting-rules/templates/reference.md",
