const workflow=JSON.parse(evidence('workflow-attempt.json'));assert.equal(workflow.schema,'rea-cloud-full-oracle-workflow-attempt/v1');assert.equal(workflow.runId,run);assert.equal(workflow.runAttempt,'1');assert.equal(workflow.sourceCommit,tested);assert.equal(workflow.runnerEnvironment,'github-hosted');for(const n of ['checkoutOutcome','compositionOutcome','flowVaultOutcome','archiveOutcome','bsdtarOutcome','bsdtarSmokeOutcome','additionalOutcome','testOutcome','oraclePostcheckOutcome','statusBeforePackaging'])assert.equal(workflow[n],'success');
