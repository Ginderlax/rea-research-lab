    {
      "id": "grafana.candidate.8a3173175ce77746a9cd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana Explore now allows for logs filtering and pinning in content outline.",
      "headingPath": [
        "What’s new in Grafana v11.2",
        "Explore",
        "Logs filtering and pinning in Explore content outline"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-2.md",
