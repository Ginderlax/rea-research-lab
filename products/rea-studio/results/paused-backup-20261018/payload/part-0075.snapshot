    },
    {
      "id": "grafana.candidate.776b96fc74e2fd5e9af9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Enhance metric queries using template variables to create dynamic, reusable dashboards.",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Query CloudWatch metrics",
        "Metric Search queries"
      ],
      "source": {
