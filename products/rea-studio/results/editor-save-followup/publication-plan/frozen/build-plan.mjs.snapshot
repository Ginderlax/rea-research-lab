import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const here=import.meta.dirname,work=path.resolve(here,'..'),workspace=path.resolve(work,'..'),repo=path.join(workspace,'outputs/rea-research-lab'),hash=b=>createHash('sha256').update(b).digest('hex'),ident=async p=>{const b=await fs.readFile(p);return{bytes:b.length,sha256:hash(b)}},write=async(n,x)=>fs.writeFile(path.join(here,n),typeof x==='string'?x:JSON.stringify(x,null,2)+'\n',{flag:'wx'}),app='products/rea-studio/apps/editor/';
