    },
    {
      "id": "grafana.candidate.1baa37ea266c840ed847",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can configure the Microsoft SQL Server data source using [Terraform](https://www.terraform.io/) with the [Grafana Terraform provider](https://registry.terraform.io/providers/grafana/grafana/latest/docs).",
      "headingPath": [
