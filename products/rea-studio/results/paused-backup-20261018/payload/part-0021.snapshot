bykind={};faults=[];downloads=[];case_obs=[]
for c in cases:
    assert c['statusAtFixtureClose']=='passed' and c['retry']==0 and c['realBrowser'] and c['actualHTTP'] and c['serverCloseObserved'] and c['errors']==[]
    assert len(c['auxiliaryErrors'])==1
