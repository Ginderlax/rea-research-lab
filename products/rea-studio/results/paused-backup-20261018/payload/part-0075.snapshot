    {
      "id": "grafana.candidate.44b2c42ac36e17a847bb",
      "syntaxRole": "table-row",
      "sourceText": "| A service control policy (SCP) explicitly denies a required action | Review the service control policies applied to the account or organizational unit. An explicit `Deny` in an SCP overrides any `Allow` in an IAM policy, so the action must be permitted at both levels. |",
      "headingPath": [
        "Troubleshoot Amazon CloudWatch data source issues",
        "Authentication errors",
        "Access blocked by a VPC endpoint policy or service control policy"
      ],
      "source": {
