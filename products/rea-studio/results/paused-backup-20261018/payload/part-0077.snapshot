    {
      "id": "grafana.candidate.e2fc22a88c9c3dcbc5c5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Creates a new custom role and maps given permissions to that role. Note that roles with the same prefix as [Fixed roles](/docs/grafana/latest/administration/roles-and-permissions/access-control/#fixed-roles) can't be created.",
      "headingPath": [
        "RBAC API",
        "Create and manage custom roles",
