      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.46ad82d8924140d0ec80",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "> Currently the synchronization only happens when a user logs in, unless LDAP is used with the active background synchronization.",
