    {
      "id": "grafana.candidate.d98ea588cb36957ba29a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In this step, we use a built-in notification template to format alert notifications in a clear and organized way. Notification templates allow us to customize the structure of alert messages, making them easier to read and more relevant.",
      "headingPath": [
        "Set up the Grafana stack",
