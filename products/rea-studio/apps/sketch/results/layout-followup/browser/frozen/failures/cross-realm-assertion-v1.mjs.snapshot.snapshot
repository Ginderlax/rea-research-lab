// Exact initial action cell retained from the CUA campaign. It stopped after
// first Align left, at deepStrictEqual on equal cross-realm coordinate arrays.
var sketchImport = async (which,label)=>{await sketchTab.playwright.getByLabel('Studio scene JSON',{exact:true}).fill(JSON.stringify(sketchFixtures[which]));await sketchTab.playwright.getByRole('button',{name:'Import JSON as new scene',exact:true}).click();return(await sketchCapture(label)).read;};var sketchLayoutChecks=[];for(var i=0;i<4;i++){var control=sketchPlan.controls[i];var stem='control-'+i;var before=(await sketchImport('three',stem+'-import')).scene;await sketchTab.playwright.getByRole('button',{name:'Select all',exact:true}).click();var selected=(await sketchCapture(stem+'-selected')).read;sketchAssert.equal(selected.selection,'3 editable shapes selected');await sketchTab.playwright.getByRole('button',{name:control.label,exact:true}).click();var after=(await sketchCapture(stem+'-layout',i===2)).read;sketchAssert.deepEqual(after.scene.shapes.map(s=>s[control.axis]),control.values);sketchAssert.equal(after.status,'Selection aligned');await sketchTab.playwright.getByRole('button',{name:'Undo',exact:true}).click();var undo=(await sketchCapture(stem+'-undo')).read;sketchAssert.deepEqual(undo.scene,before);await sketchTab.playwright.getByRole('button',{name:'Redo',exact:true}).click();var redo=(await sketchCapture(stem+'-redo')).read;sketchAssert.deepEqual(redo.scene,after.scene);sketchLayoutChecks.push({label:control.label,exactCoordinates:true,selected3:true,oneUndoExact:true,oneRedoExact:true});}await sketchFs.writeFile(sketchRoot+'/layout-checks-partial.json',JSON.stringify(sketchLayoutChecks,null,2)+'\n');nodeRepl.write(sketchLayoutChecks);
