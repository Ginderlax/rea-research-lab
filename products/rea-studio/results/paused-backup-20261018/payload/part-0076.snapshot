    },
    {
      "id": "grafana.candidate.6a71b66432f13b2137d6",
      "syntaxRole": "table-row",
      "sourceText": "| **Max lifetime**  | The maximum time (in seconds) a connection can be reused before being closed and replaced. If set to `0`, connections are reused indefinitely.                                               |",
      "headingPath": [
        "Configure the Microsoft SQL Server data source",
        "Configure the data source in the UI"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/configure/index.md",
