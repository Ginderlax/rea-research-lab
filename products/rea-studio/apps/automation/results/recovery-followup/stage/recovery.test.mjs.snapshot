import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import os from 'node:os';import {createServer} from 'node:http';import {once} from 'node:events';
import {createExecution,advanceExecution,validateExecution,NativeError} from './products/rea-studio/apps/automation/native.mjs';
import {start} from './products/rea-studio/server.mjs';import {createStore} from './products/rea-studio/lib/storage.mjs';
const node=(type,name,parameters={},position=[0,0])=>({name,id:name,type:'n8n-nodes-base.'+type,typeVersion:{manualTrigger:1,httpRequest:4.4,wait:1.1,merge:3.2,set:3.4}[type],parameters,position}),target=(name,index=0)=>({node:name,type:'main',index}),item=json=>({json,pairedItem:{item:0}}),stateFor=document=>({...createExecution(document),workflowId:'owned',revision:1}),jsonCopy=value=>JSON.parse(JSON.stringify(value));
const effect=url=>node('httpRequest','Effect',{url,options:{timeout:1000}}),fields=(name,key,value,position)=>node('set',name,{mode:'manual',assignments:{assignments:[{name:key,value,type:'number'}]}},position);
function joined(url='http://127.0.0.1:1/owned'){return{name:'Owned preserved Wait/Merge fixture',nodes:[node('manualTrigger','Start'),fields('Left','left',1,[0,0]),node('wait','Wait',{resume:'timeInterval',amount:.01,unit:'seconds'},[0,100]),node('merge','Merge',{mode:'chooseBranch',numberInputs:2,chooseBranchMode:'waitForAll',output:'specifiedInput',useDataOfInput:1}),effect(url)],connections:{Start:{main:[[target('Left'),target('Wait')]]},Left:{main:[[target('Merge',0)]]},Wait:{main:[[target('Merge',1)]]},Merge:{main:[[target('Effect')]]}}};}
async function waiting(document=joined()){const state=stateFor(document);await advanceExecution(state);assert.equal(state.status,'waiting');return jsonCopy(state);}
async function counted(action){let calls=0;const previous=globalThis.fetch;globalThis.fetch=async()=>{calls++;return new Response('{}',{headers:{'content-type':'application/json'}});};try{await action();return calls;}finally{globalThis.fetch=previous;}}
const observations=[];
test('expired active deadline after awaited checkpoint rejects before HTTP invocation',async()=>{
 const fixture={name:'Owned deadline boundary',nodes:[node('manualTrigger','Start'),effect('http://127.0.0.1:1/owned')],connections:{Start:{main:[[target('Effect')]]}}},state=stateFor(fixture);state.activeMs=119950;let delayed=false;
 const calls=await counted(()=>advanceExecution(state,{checkpoint:async value=>{if(value.activeNode==='Effect'&&!delayed){delayed=true;await new Promise(done=>setTimeout(done,85));}}}));assert.equal(delayed,true);assert.equal(calls,0);assert.equal(state.status,'failed');assert.equal(state.error.code,'NATIVE_LIMIT');assert.match(state.error.message,/after checkpoint/);assert.ok(state.activeMs>120000);observations.push({name:'expired-checkpoint',calls,status:state.status,code:state.error.code,activeMs:state.activeMs,scope:'Cooperative recheck after awaited IO; elapsed IO is not preempted'});
});
test('abort during checkpoint retains cancellation precedence and issues no HTTP',async()=>{
 const fixture={name:'Owned abort boundary',nodes:[node('manualTrigger','Start'),effect('http://127.0.0.1:1/owned')],connections:{Start:{main:[[target('Effect')]]}}},state=stateFor(fixture),controller=new AbortController();
 const calls=await counted(()=>advanceExecution(state,{signal:controller.signal,checkpoint:async value=>{if(value.activeNode==='Effect')controller.abort(new NativeError('Owned cancellation','NATIVE_CANCELLED'));}}));assert.equal(calls,0);assert.equal(state.status,'cancelled');assert.equal(state.error.code,'NATIVE_CANCELLED');
});
test('reachable premature downstream invocation rejects before persisted recovery effects',async()=>{
 const state=await waiting();state.pending.push({node:'Effect',items:[item({injected:true})]});assert.throws(()=>validateExecution(state),/Contradictory persisted routing batch/);assert.equal(Object.hasOwn(state.outputs,'Merge'),false);observations.push({name:'premature-Effect-rejected',status:state.status,fixture:state.workflow});
});
test('genuine JSON serialized partial join and deferred Wait validate and resume exactly once',async()=>{
 const state=await waiting();assert.equal(state.joins.Merge[0][0].json.left,1);assert.equal(state.joins.Merge[1],null);assert.doesNotThrow(()=>validateExecution(state));const calls=await counted(()=>advanceExecution(state,{now:Date.parse(state.waitUntil)+1}));assert.equal(state.status,'completed');assert.equal(calls,1);assert.equal(state.trace.filter(step=>step.node==='Merge').length,1);assert.equal(state.trace.filter(step=>step.node==='Effect').length,1);observations.push({name:'genuine-partial-join-resume',calls,status:state.status});
});
test('buffers must match completed source outputs and cannot omit arrived batches',async()=>{
 const genuine=await waiting();for(const mutate of [state=>{state.joins.Merge[0][0].json.left=2;},state=>{state.joins.Merge[0]=null;state.joins.Merge[1]=[item({fake:true})];},state=>{state.joins.Merge[0]=[];}]){const state=jsonCopy(genuine);mutate(state);assert.throws(()=>validateExecution(state),/persisted|Persisted/);}
});
function queuedJoinFixture(){return{name:'Owned queued Merge plus separate Wait',nodes:[node('manualTrigger','Start'),fields('Left','left',1,[0,0]),fields('Right','right',2,[0,100]),node('merge','Merge',{mode:'append',numberInputs:2},[0,200]),node('wait','Wait',{resume:'timeInterval',amount:.01,unit:'seconds'},[0,0]),effect('http://127.0.0.1:1/owned')],connections:{Start:{main:[[target('Left'),target('Right')]]},Left:{main:[[target('Merge',0)]]},Right:{main:[[target('Merge',1),target('Wait')]]},Merge:{main:[[target('Effect')]]}}};}
test('genuine full Merge invocation queued behind an independent Wait remains valid',async()=>{
 const state=await waiting(queuedJoinFixture());assert.equal(state.pending[0].node,'Merge');assert.equal(state.pending[0].inputs.length,2);assert.doesNotThrow(()=>validateExecution(state));const calls=await counted(()=>advanceExecution(state,{now:Date.parse(state.waitUntil)+1}));assert.equal(state.status,'completed');assert.equal(calls,2);assert.equal(state.trace.filter(step=>step.node==='Merge').length,1);observations.push({name:'genuine-ready-Merge-behind-Wait',calls,status:state.status});
});
test('queued Merge substituted batches, missing arrived inputs and incomplete Choose Branch reject',async()=>{
 const genuine=await waiting(queuedJoinFixture());for(const mutate of [state=>{state.pending[0].inputs[0][0].json.left=5;},state=>{state.pending[0].inputs[0]=[];},state=>{state.workflow.nodes.find(node=>node.name==='Merge').parameters={mode:'chooseBranch',numberInputs:2,chooseBranchMode:'waitForAll',output:'specifiedInput',useDataOfInput:1};state.pending[0].inputs[0]=[];}]){const state=jsonCopy(genuine);mutate(state);assert.throws(()=>validateExecution(state),/Contradictory persisted/);}
});
test('genuine source fan-out pending beside a deferred Wait stays valid; altered item rejects',async()=>{
 const fixture=joined();fixture.nodes.push(fields('Side','side',9,[0,200]));fixture.connections.Start.main[0]=[target('Left')];fixture.connections.Left.main[0].push(target('Wait'),target('Side'));fixture.nodes.find(node=>node.name==='Wait').position=[0,-100];const state=await waiting(fixture);assert.ok(state.pending.some(invocation=>invocation.node==='Side'));assert.doesNotThrow(()=>validateExecution(state));const bad=jsonCopy(state);bad.pending.find(invocation=>invocation.node==='Side').items[0].json.left=9;assert.throws(()=>validateExecution(bad),/Contradictory persisted routing batch/);const calls=await counted(()=>advanceExecution(state,{now:Date.parse(state.waitUntil)+1}));assert.equal(calls,1);assert.equal(state.outputs.Side[0][0].json.side,9);
});
test('routing output shape and deferred Wait output ports are validated before recovery',async()=>{
 const genuine=await waiting();for(const mutate of [state=>{state.outputs.Unknown=[[item({})]];},state=>{state.outputs.Left={bad:true};},state=>{state.outputs.Left.push([item({})]);},state=>{state.outputs.Left[0]=[{json:[]}];}]){const state=jsonCopy(genuine);mutate(state);assert.throws(()=>validateExecution(state),/persisted routing outputs/);}
});
test('actual staged shared HTTP recovery rejects premature reachable pending effect with zero requests and no record change',async t=>{
 const folder=await fs.mkdtemp(path.join(os.tmpdir(),'rea-routing-recovery-stage-')),store=await createStore(path.join(folder,'automation/records'));let requests=0;
 const endpoint=createServer((req,res)=>{requests++;res.end('{}');});endpoint.listen(0,'127.0.0.1');await once(endpoint,'listening');
 const state=await waiting(joined('http://127.0.0.1:'+endpoint.address().port)),key='automation.native.run.'+state.id;state.waitUntil=new Date().toISOString();state.pending.push({node:'Effect',items:[item({injected:true})]});await store.set('automation.native.jobs',[state.id]);await store.set(key,state);const before=JSON.stringify(await store.get(key)),host=await start({port:0,dataDir:folder});
 t.after(async()=>{await host.close();endpoint.closeAllConnections();await new Promise(done=>endpoint.close(done));const owned=path.resolve(folder);assert.equal(path.dirname(owned),path.resolve(os.tmpdir()));assert.ok(path.basename(owned).startsWith('rea-routing-recovery-stage-'));await fs.rm(owned,{recursive:true,force:true});});
 const response=await fetch(host.url+'/api/automation/native-list',{method:'POST',headers:{'content-type':'application/json','x-rea-token':host.token},body:'{}'});assert.equal(response.status,400);assert.match((await response.json()).error,/Contradictory persisted routing batch/);await new Promise(done=>setTimeout(done,25));assert.equal(requests,0);assert.equal(JSON.stringify(await store.get(key)),before);observations.push({name:'actual-shared-host-malformed-recovery',httpStatus:400,requests,recordUnchanged:true});
});
test.after(async()=>{await fs.mkdir(new URL('./.local/recovery-observations/',import.meta.url),{recursive:true});await fs.writeFile(new URL('./.local/recovery-observations/recovery-observations.json',import.meta.url),JSON.stringify({schema:'rea-automation-routing-recovery-finite-regressions/v1',observations},null,2)+'\n');console.log('RECOVERY_OBSERVATIONS '+JSON.stringify(observations));});
