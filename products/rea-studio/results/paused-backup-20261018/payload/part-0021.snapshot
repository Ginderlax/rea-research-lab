assert summary['runId']==RUN and summary['headSHA']==HEAD and summary['runStatus']=='completed' and summary['runConclusion']=='success'
assert summary['terminalCompleteCollection'] and summary['bothRecordedContractsPassed']
cp={}
for x in summary['controlPlane']:pin(read(Path(x['path'])),x);cp[x['kind']]=load(Path(x['path']))
assert set(cp)=={'run','jobs','artifacts'}
