    {
      "id": "grafana.candidate.2dbf377be53b246139bd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set to true to attempt login with specific OAuth provider automatically, skipping the login screen. This setting is ignored if multiple auth providers are configured to use auto login. Defaults to `false`.",
      "headingPath": [
        "Configure authentication",
        "Extended authentication settings",
        "Automatic OAuth login"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/_index.md",
