 (b'if (!mounted || todoBusy || organizationBusy) return;',b'if (!mounted || todoBusy || organizationBusy || saveBusy) return;','Move the save-pending to-do exclusion into its explicit mutation boundary.'),
 (b'saveBusy=false;if(mounted){save.disabled=Boolean(current?.deletedAt);refreshTodo();}',b'saveBusy=false;if(mounted){save.disabled=organizationBusy||Boolean(current?.deletedAt);refreshTodo();}','Save cleanup releases only its own busy state and keeps the control disabled for an overlapping organization owner.'),
 (b'save.disabled=Boolean(current?.deletedAt);moveNote.disabled=',b'save.disabled=saveBusy||Boolean(current?.deletedAt);moveNote.disabled=','Organization cleanup releases only its own busy state and retains native Save disabling while the prior save is still pending.')
]
after=before
for old,new,reason in edits:
    assert after.count(old)==1
    after=after.replace(old,new)
assert after!=before
(S/'before').mkdir(parents=True)
(S/'before/client.mjs.snapshot').write_bytes(before)
dest=S/'candidate'/TARGET;dest.parent.mkdir(parents=True);dest.write_bytes(after)
assert (S/'before/client.mjs.snapshot').read_bytes()==before and dest.read_bytes()==after
