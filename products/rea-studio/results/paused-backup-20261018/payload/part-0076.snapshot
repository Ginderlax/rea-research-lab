    },
    {
      "id": "grafana.candidate.ad76c9b4f697abad0288",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Prometheus supports the [Filters](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/visualizations/dashboards/build-dashboards/filter-group-by/) variable type (formerly called \"ad hoc filters\"), which lets dashboard viewers dynamically add label filters without editing queries.",
      "headingPath": [
        "Prometheus template variables",
        "Filters variable"
      ],
      "source": {
        "path": "docs/sources/datasources/prometheus/template-variables/_index.md",
        "gitBlobSha": "c46792368b7251ac53d6d7b96120137523c04b66",
        "sha256": "cf10aa9014dc6c9b0b74b8ca53b59bdde3afa0237815afbd531f7cd5501471dd",
