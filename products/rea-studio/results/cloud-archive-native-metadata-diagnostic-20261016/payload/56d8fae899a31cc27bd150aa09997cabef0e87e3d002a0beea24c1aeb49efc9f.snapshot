const identity=bytes=>({bytes:bytes.length,sha256:createHash('sha256').update(bytes).digest('hex')});
const same=(bytes,row)=>assert.deepEqual(identity(bytes),{bytes:row.bytes,sha256:row.sha256});
function safe(name){assert(typeof name==='string'&&name&&!/[\\:\x00-\x1f\x7f]/.test(name)&&!name.startsWith('/')&&name.split('/').every(part=>part&&part!=='.'&&part!=='..'));return name;}
function read(name,maximum=16*1024*1024){let file=workspace;for(const part of safe(name).split('/')){file=path.join(file,part);assert(!fs.lstatSync(file).isSymbolicLink());}const item=fs.lstatSync(file);assert(item.isFile()&&item.size<=maximum);const raw=fs.readFileSync(file);assert.equal(raw.length,item.size);return raw;}
const sources=new Map();for(const row of inputs){assert(!sources.has(row.role));const raw=read(row.sourceReference);same(raw,row);sources.set(row.role,{row,raw});}
const raw=role=>{assert(sources.has(role),role);return sources.get(role).raw;};
const json=role=>JSON.parse(raw(role).toString('utf8').replace(/^\uFEFF/,''));
const report=json('data-only-readable-backup-report'),run=json('raw-run-api'),jobs=json('raw-jobs-api'),artifacts=json('raw-artifacts-api'),commit=json('raw-commit-api'),tree=json('raw-tree-api');
