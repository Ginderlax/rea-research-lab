reader=root/a['reader']['path'];collector=root/a['collector']['path'];text=reader.read_text();node=collector.read_text()
names,_=json.JSONDecoder().raw_decode(text.split('EXPECTED_MEMBERS=',1)[1]);assert names==a['exact95Roles'] and len(names)==len(set(names))==95
