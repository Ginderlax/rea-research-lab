    },
    {
      "id": "grafana.candidate.76b1c015202bc037b9cf",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Cause:** The PDC agent installed in your private network isn't running or can't connect to Grafana Cloud.",
      "headingPath": [
        "Troubleshoot Tempo data source issues",
        "Private data source connect issues (_Grafana Cloud only_)",
