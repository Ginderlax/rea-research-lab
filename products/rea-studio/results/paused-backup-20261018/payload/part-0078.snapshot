    },
    {
      "id": "grafana.candidate.4f012568a695edeeb2f1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Optionally, you can handle empty objects using `else`:",
      "headingPath": [
        "If",
        "Range"
      ],
      "source": {
        "path": "docs/sources/shared/alerts/template-language.md",
