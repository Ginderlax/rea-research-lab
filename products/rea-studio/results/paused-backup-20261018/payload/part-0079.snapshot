    },
    {
      "id": "grafana.candidate.55cd32d4995d94f1c187",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Edit API-provisioned alert rules from the Grafana UI. To make a provisioned alert editable, add the `x-disable-provenance` header to the following requests when creating or editing your alert rules in the API:",
      "headingPath": [
        "What's new in Grafana v9.3",
        "Alerting",
        "Edit alert rules created using the provisioning API"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-3.md",
