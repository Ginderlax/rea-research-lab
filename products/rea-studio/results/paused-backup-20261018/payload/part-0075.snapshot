    {
      "id": "grafana.candidate.2a649fdac66451c20282",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The eviction process for **MissingSeries** is designed to prevent alert flapping when a pod or instance disappears, reducing alert noise.",
      "headingPath": [
        "Handle missing data in Grafana Alerting",
        "Evict alert instances for missing series",
        "Why doesn’t MissingSeries match No Data behavior?"
      ],
      "source": {
        "path": "docs/sources/alerting/guides/missing-data.md",
        "gitBlobSha": "8816ddb5943b9f021d5f7758a11dafd170578791",
        "sha256": "bde64b9c1372e92555c153fdb5fbad273ee00be9c7ff4b8ae0113e22ce54dc2b",
        "lineStart": 189,
        "lineEnd": 189,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/guides/missing-data.md#L189-L189"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
