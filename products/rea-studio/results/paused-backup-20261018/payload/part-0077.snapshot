    {
      "id": "grafana.candidate.9fe64638160109aac1e3",
      "syntaxRole": "table-row",
      "sourceText": "| `login_prompt`                  | No       | Yes                | Indicates the type of user interaction when the user logs in with Entra ID. Available values are `login`, `consent` and `select_account`.                                                                                                                                                                                                                                                                                                                                                       |                                                      |",
      "headingPath": [
        "Configure Microsoft Entra ID OAuth authentication",
        "Configuration options"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/entraid/index.md",
        "gitBlobSha": "59fb58efe7a59116a30801f34622d72a3c482076",
        "sha256": "1fa9334110b531d913f725ea2734e69bce32e4da352e7d5a54ddde926605b058",
        "lineStart": 461,
        "lineEnd": 461,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/entraid/index.md#L461-L461"
