      "sourceText": "If the first bucket should not start at zero, a non-zero offset has the effect of shifting the aggregation window.",
      "headingPath": [
        "Histogram",
        "Configuration options",
        "Histogram options",
        "Bucket offset"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/histogram/index.md",
