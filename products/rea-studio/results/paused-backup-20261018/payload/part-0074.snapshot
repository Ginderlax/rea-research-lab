    {
      "id": "grafana.candidate.a3a4ace08bf6963f6b40",
      "syntaxRole": "table-row",
      "sourceText": "| [$values](#values) | Contains the labels and floating point values of all instant queries and expressions, indexed by their Ref IDs.                                                                                                                                                                  |",
      "headingPath": [
