    {
      "id": "grafana.candidate.bae5f57f627a9de502c0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "_For Grafana Cloud only._ Private data source connect (PDC) allows you to establish a private, secured connection between a Grafana Cloud instance and data sources secured within a private network. For more information, refer to [Private data source connect (PDC)](https://grafana.com/docs/grafana-cloud/connect-externally-hosted/private-data-source-connect/).",
      "headingPath": [
        "Configure the InfluxDB data source",
        "Configuration options",
        "Private data source connect"
      ],
      "source": {
        "path": "docs/sources/datasources/influxdb/configure/_index.md",
