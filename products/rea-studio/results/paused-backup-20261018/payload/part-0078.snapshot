    {
      "id": "grafana.candidate.55c3d26c88372bce4d6c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana applies your selections to the query before inserting it into the dashboard. However, the substitutions only apply to the query when it's reused, and the original saved query remains unchanged.",
      "headingPath": [
        "Annotate visualizations",
        "Annotation queries",
