    {
      "id": "grafana.candidate.330ff08e10430c9ad800",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The Grafana SCIM UI provides the following advantages over configuring SCIM in the Grafana configuration file:",
