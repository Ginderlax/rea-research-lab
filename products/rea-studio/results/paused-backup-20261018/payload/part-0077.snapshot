    {
      "id": "grafana.candidate.371325201d06ee042761",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Enter a comma-separated list of plugin identifiers to install on startup, using the Grafana catalog as the source. Same as `preinstall`, but installs plugins synchronously.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[plugins]`",
