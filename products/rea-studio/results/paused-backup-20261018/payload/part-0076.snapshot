    {
      "id": "grafana.candidate.40966211a20d9c2dc480",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Don't use `127.0.0.1` or `localhost` as the InfluxDB URL. PDC tunnels traffic over a SOCKS proxy, which can't resolve loopback addresses.",
      "headingPath": [
        "Troubleshoot InfluxDB data source issues",
        "Connection errors",
        "PDC connection fails with \"no such host\""
      ],
      "source": {
