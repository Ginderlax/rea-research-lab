    {
      "id": "grafana.candidate.486a4595115de910afe1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When querying multiple log groups you **must** use the `logGroups(logGroupIdentifier: [...])` syntax:",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Query CloudWatch Logs",
        "Query log groups and Amazon CloudWatch Logs data sources with OpenSearch SQL"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/query-editor/index.md",
