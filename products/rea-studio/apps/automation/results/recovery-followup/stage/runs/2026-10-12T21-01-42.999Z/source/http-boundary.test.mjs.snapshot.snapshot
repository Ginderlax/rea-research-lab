import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';
import {executeNode,NativeError} from './products/rea-studio/apps/automation/native.mjs';
const node=timeout=>({name:'HTTP',type:'n8n-nodes-base.httpRequest',parameters:{url:'http://127.0.0.1:1/owned',options:{timeout}}}),items=n=>Array.from({length:n},()=>({json:{}})),observations=[];
for(const kind of ['expired-before-first','expired-between-items','expired-before-redirect','cancel-before-redirect','timeout-before-redirect'])test('HTTP pre-effect guard: '+kind,async()=>{
 let tick=0,calls=0;const controller=new AbortController(),budget={requests:0},context={executionBudget:budget,...(kind.startsWith('expired')?{deadline:kind==='expired-before-first'?-1:10}:{}),signal:controller.signal},oldFetch=globalThis.fetch,oldPerformance=Object.getOwnPropertyDescriptor(globalThis,'performance');Object.defineProperty(globalThis,'performance',{value:{now:()=>tick},configurable:true});
 globalThis.fetch=async()=>{calls++;if(kind==='expired-between-items')tick=20;if(kind.includes('redirect')&&calls===1)return{status:302,headers:new Headers({location:'/owned-redirect'}),body:{async cancel(){if(kind==='expired-before-redirect')tick=20;if(kind==='cancel-before-redirect')controller.abort(new NativeError('Owned cancel','NATIVE_CANCELLED'));if(kind==='timeout-before-redirect')await new Promise(done=>setTimeout(done,10));}}};return new Response('{}',{headers:{'content-type':'application/json'}});};
 let error;try{await executeNode(node(kind==='timeout-before-redirect'?1:1000),items(kind==='expired-between-items'?2:1),context);}catch(value){error=value;}finally{globalThis.fetch=oldFetch;Object.defineProperty(globalThis,'performance',oldPerformance);}
 assert.ok(error);assert.equal(error.code,kind==='cancel-before-redirect'?'NATIVE_CANCELLED':kind==='timeout-before-redirect'?'NATIVE_HTTP_TIMEOUT':'NATIVE_LIMIT');assert.equal(calls,kind==='expired-before-first'?0:1);assert.equal(budget.requests,kind==='expired-between-items'?2:1);observations.push({kind,calls,chargedItemAttempts:budget.requests,errorCode:error.code,scope:'Owned Fetch/monotonic clock; no remote effects or blocked IO preemption claim'});
});
test.after(async()=>{await fs.writeFile(new URL('./http-boundary-observations.json',import.meta.url),JSON.stringify({schema:'rea-automation-routing-http-pre-effect-regressions/v1',observations},null,2)+'\n');console.log('HTTP_BOUNDARY_OBSERVATIONS '+JSON.stringify(observations));});
