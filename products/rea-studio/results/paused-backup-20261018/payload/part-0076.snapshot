    {
      "id": "grafana.candidate.391427b8565ddce02b5a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Because every returned data point creates an annotation, queries that return continuous data (like `node_cpu_seconds_total`) produce an annotation at every step interval, flooding your dashboard. Always use expressions that return data only at the moments you want annotated.",
      "headingPath": [
        "Prometheus annotations",
