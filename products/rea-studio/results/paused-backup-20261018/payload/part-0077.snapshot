    {
      "id": "grafana.candidate.913926e4bf108ecfc102",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Team provisioning requires `group_sync_enabled = true` in the SCIM configuration. See [Configure SCIM in Grafana](../../configure-scim-provisioning#configure-scim-in-grafana) for more information.",
      "headingPath": [
        "Manage users and teams with SCIM",
        "Team provisioning with SCIM"
      ],
