    },
    {
      "id": "grafana.candidate.db8f2181a93465d7b8f7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "> You will have to host your logo and other images used by the custom branding feature separately. Make sure Grafana can access the URL where the assets are stored.",
      "headingPath": [
        "Configure custom branding"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/configure-custom-branding/index.md",
        "gitBlobSha": "626068ce514684ffda01cbb550ec0d7bfca40775",
