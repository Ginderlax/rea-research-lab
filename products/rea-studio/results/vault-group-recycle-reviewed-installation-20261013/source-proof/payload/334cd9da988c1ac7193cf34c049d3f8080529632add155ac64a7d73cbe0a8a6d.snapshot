import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';import {spawn} from 'node:child_process';
const own=import.meta.dirname,workspace=path.resolve(own,'../..'),candidate=path.join(workspace,'work/keepass-group-active-list-fix-next'),sha=b=>createHash('sha256').update(b).digest('hex');
async function verify(){const b=await fs.readFile(path.join(candidate,'manifest.json'));assert.equal(sha(b),'d24b555cc9f35f4720920d385c97496803e787f69f76caca4af0fcf2b4c4acdd');const m=JSON.parse(b);assert.equal(m.inventory.length,343);for(const row of m.inventory){const bytes=await fs.readFile(path.join(candidate,row.path));assert.equal(bytes.length,row.bytes,row.path);assert.equal(sha(bytes),row.sha256,row.path);}return {records:343,manifestSha256:sha(b)};}
const before=await verify(),sources=[];for(const name of ['client','server','recycle','kdbx','history','xml']){const b=await fs.readFile(path.join(candidate,'products/rea-studio/apps/vault/'+name+'.mjs'));await fs.writeFile(path.join(own,name+'.mjs.snapshot'),b,{flag:'wx'});sources.push({source:'work/keepass-group-active-list-fix-next/products/rea-studio/apps/vault/'+name+'.mjs',bytes:b.length,sha256:sha(b)});}for(const name of ['probe.test.mjs','run.mjs']){const b=await fs.readFile(path.join(own,name));sources.push({source:'work/root-vault-group-dom-active-list-review/'+name,bytes:b.length,sha256:sha(b)});}assert.equal(sources[0].sha256,'6409badcd044cadc07d17edd4d749165f5cd5498d206f946f299da48d05477a5');await fs.writeFile(path.join(own,'source-before.json'),JSON.stringify(sources,null,2)+'\n',{flag:'wx'});
const startedAt=new Date().toISOString(),child=spawn(process.execPath,['--test','--test-reporter=tap','--test-concurrency=1',path.join(own,'probe.test.mjs')],{windowsHide:true}),chunks={stdout:[],stderr:[]};let problem=null;const deadline=setTimeout(()=>{problem='Owned finite DOM collector 60-second deadline';child.kill();},60000);for(const key of Object.keys(chunks))child[key].on('data',b=>chunks[key].push(b));const exit=await new Promise((resolve,reject)=>{child.once('error',reject);child.once('close',(code,signal)=>resolve({code,signal}));});clearTimeout(deadline);for(const key of Object.keys(chunks))await fs.writeFile(path.join(own,key+'.txt'),Buffer.concat(chunks[key]),{flag:'wx'});const after=await verify();for(const row of sources){const b=await fs.readFile(path.join(workspace,row.source));assert.equal(b.length,row.bytes);assert.equal(sha(b),row.sha256);}await fs.writeFile(path.join(own,'source-after.json'),JSON.stringify(sources,null,2)+'\n',{flag:'wx'});
const raw=Buffer.concat(chunks.stdout).toString(),counts=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(n=>[n,Number(new RegExp('# '+n+' (\\d+)').exec(raw)?.[1]??NaN)]));assert(Object.values(counts).every(Number.isSafeInteger));assert.equal(counts.tests,6);const validation={schema:'rea-root-vault-group-dom-review/v1',startedAt,endedAt:new Date().toISOString(),before,after,sources,sourceStable:true,counts,exit,collectorProblem:problem,scope:{actualCandidateClientAndHandler:true,DOMModel:true,HTTP:0,browser:0,originalExecutions:0,productionWrites:0,fullParity:false,universalSuperiority:false}};await fs.writeFile(path.join(own,'validation.json'),JSON.stringify(validation,null,2)+'\n',{flag:'wx'});const inventory=[];for(const name of(await fs.readdir(own)).sort()){const stat=await fs.stat(path.join(own,name));assert(stat.isFile());if(name==='manifest.json')continue;const b=await fs.readFile(path.join(own,name));inventory.push({path:name,bytes:b.length,sha256:sha(b)});}const manifest=Buffer.from(JSON.stringify({schema:'rea-strict-work-review/v1',files:inventory.length,inventory},null,2)+'\n');await fs.writeFile(path.join(own,'manifest.json'),manifest,{flag:'wx'});console.log(JSON.stringify({counts,exit,files:inventory.length,manifestSha256:sha(manifest),validationSha256:sha(await fs.readFile(path.join(own,'validation.json')))},null,2));process.exitCode=exit.code;
