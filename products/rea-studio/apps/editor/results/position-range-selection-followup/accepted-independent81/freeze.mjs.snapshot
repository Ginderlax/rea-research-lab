import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{authenticate}from'./run.mjs';const here=import.meta.dirname,sha=b=>createHash('sha256').update(b).digest('hex'),final=await authenticate(),runs=await fs.readdir(path.join(here,'runs'));assert.equal(runs.length,1);const runPath='runs/'+runs[0],run=JSON.parse(await fs.readFile(path.join(here,runPath,'run.json'))),raw=JSON.parse(await fs.readFile(path.join(here,runPath,'comparisons.json'))),decl=JSON.parse(await fs.readFile(path.join(here,'declaration-audit.json')));assert.equal(run.status.code,0);assert.equal(raw.counts.exactPairs,58);assert.equal(raw.counts.unequalPairs,0);assert.equal(raw.oracleTelemetry.successful,2);assert.equal(raw.oracleTelemetry.vmEvaluations,12);assert.equal(raw.oracleTelemetry.sourceUnitsEvaluated,10);const typed=raw.observations.filter(r=>r.comparison?.startsWith('Error rejection type')).length;assert.equal(typed,20);const controls=raw.observations.filter(r=>r.label.startsWith('strictness control')).length;assert.equal(controls,6);for(const r of run.source)assert.equal(sha(await fs.readFile(path.join(here,r.path))),r.sha256);
const selected=JSON.parse(await fs.readFile(path.join(here,'candidate/acquisition.json.snapshot')));for(const r of selected.records){const b=await fs.readFile(path.join(here,r.path));assert.equal(sha(b),r.sha256);}const receipt={schema:'rea-editor-value-api-correction-independent-review/v1',at:new Date().toISOString(),candidate:{path:'work/editor-position-range-selection-fix-next',files:319,manifestSHA256:'77ae818b4539341ab6f2f0126efaf8974117136f207747450d821df7c09baa1d',receiptSHA256:'a3c6ebeda22082c9c7e7d98f2ae71d501c873c60ba6473f860f66abdaf9fbd7c',runtimeSHA256:'9f5d89b260e88fc1c2197d23a9c2b0ca25fcff688c5eba839471c7a4fe499aa8',inverseOldRuntimeSHA256:'7ad0b5ebb78ea575ca381551b7f827776523c606d9a481801f0eb34a67e2f1c1'},finalAuthentication:final,original:{release:selected.release,commit:selected.commit,selectedSourceFiles:selected.records,compiler:'Official authenticated TypeScript5.9.3',Node:final.node,compositions:2,sourceUnits:10,VMEvaluations:12,explicitSourceModuleStrictness:true,unchangedScriptDescriptorControl:true,originalFunctionBodiesEdited:false,workbench:0,extensionHost:0,GUI:0},focused:{groups:9,pass:9,fail:0,skips:0,freshPairs:58,exactValueOrLibraryErrorPairs:38,engineErrorTypeOnlyPairs:20,rawEngineErrorsRetained:true,extraStrictnessDescriptorControls:6,prior43BodiesReplayed:0,author22GroupsNotRecounted:true,run:runPath,source:run.source,rawSHA256:sha(await fs.readFile(path.join(here,runPath,'comparisons.json')))},declarationCensus:{direct:decl.directEntries,optional:decl.optionalFields,inheritedNonConstructor:decl.inheritedRangeNonConstructorEntries,inheritedNames:decl.inheritedDistinctNames},currentCensus:{rows:31,EditorDirect:24,sharedHostPackageShell:7,beforeAfterStable:true,executed:false},preservedPreparationFailures:1,confirmedNewCandidateFaults:0,oracleCompositionFinding:'Removing ES module syntax loses strictness and changes legacy helper own caller/arguments; explicit strictness adaptation and unmodified control retained.',stageAndProductionMutations:0,browser:0,benchmarks:0,ownedChildren:1,remainingProcesses:0,sourceStable:true,finiteAcceptance:true,fullParity:false,superiority:false};await fs.writeFile(path.join(here,'review-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
async function walk(d,p=''){const rows=[];for(const e of await fs.readdir(d,{withFileTypes:true})){assert(!e.isSymbolicLink());if(e.isDirectory())rows.push(...await walk(path.join(d,e.name),p+e.name+'/'));else rows.push(p+e.name);}return rows;}const inventory=[];for(const p of(await walk(here)).sort()){assert.notEqual(p,'review-manifest.json');const b=await fs.readFile(path.join(here,p));inventory.push({path:p,bytes:b.length,sha256:sha(b)});}const m={schema:'rea-editor-value-api-correction-independent-freeze/v1',files:inventory.length,totalBytes:inventory.reduce((n,r)=>n+r.bytes,0),inventory},b=Buffer.from(JSON.stringify(m,null,2)+'\n');await fs.writeFile(path.join(here,'review-manifest.json'),b,{flag:'wx'});console.log(JSON.stringify({files:m.files,manifestSHA256:sha(b),receiptSHA256:sha(await fs.readFile(path.join(here,'review-validation.json'))),finiteAcceptance:true}));
