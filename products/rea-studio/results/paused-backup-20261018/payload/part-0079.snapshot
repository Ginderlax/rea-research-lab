    },
    {
      "id": "grafana.candidate.f835e83df0aa520f2777",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The status history visualization works best if you have data capturing the various status of entities over time, formatted as a table. The data must include:",
      "headingPath": [
        "Status history",
        "Supported data formats"
      ],
      "source": {
