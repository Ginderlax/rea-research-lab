import test from 'node:test';
import assert from 'node:assert/strict';
import * as fs from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import {createHash} from 'node:crypto';
import {zstdCompressSync,zstdDecompressSync} from 'node:zlib';
import {execFile} from 'node:child_process';
import {promisify} from 'node:util';
import {createWorkspace} from '../backup-compression-next/lib/storage.mjs';
import {handleNative} from '../backup-compression-next/apps/backup/restic.mjs';
import {encodeBlob,encodeMetadata,MODES} from '../backup-compression-next/apps/backup/restic-compression.mjs';
import {hash,seal,open,passwordKey,masterKey} from '../backup-compression-next/apps/backup/restic-crypto.mjs';
import {handleNative as oldNative} from '../../outputs/rea-research-lab/products/rea-studio/apps/backup/restic.mjs';
const MiB=1024*1024,exec=promisify(execFile),artifact=path.resolve('outputs/rea-research-lab/projects/09-restic/artifacts'),executable=path.join(artifact,'unpacked/restic_0.19.1_windows_amd64.exe'),syntheticPassword='independent-compression-review-local-only';
const observations=[];
function fixedBytes(length){const output=Buffer.alloc(length);for(let offset=0;offset<length;offset+=32)createHash('sha256').update(`independent-${offset}`).digest().copy(output,offset,0,Math.min(32,length-offset));return output;}
async function fixture(t){const folder=await fs.mkdtemp(path.join(os.tmpdir(),'rea-compression-review-')),workspace=await createWorkspace(path.join(folder,'workspace'));t.after(async()=>{assert.equal(path.dirname(folder),path.resolve(os.tmpdir()));assert.ok(path.basename(folder).startsWith('rea-compression-review-'));await fs.rm(folder,{recursive:true,force:true});});return{folder,workspace,api:(action,input={})=>handleNative({action,input:{repository:'repository',password:syntheticPassword,...input},workspace})};}
async function original(workspace,args){assert.equal(hash(await fs.readFile(executable)),'b0dd1fd21eea5d8fe1325f55f7118213c21f36de8a261e04c0624a5ab9fd7830');assert.equal(hash(await fs.readFile(path.join(artifact,'restic_0.19.1_windows_amd64.zip'))),'da948ad707ed690426473aaba2046cd61f8f90f6f0e7dab6be0d5796531de67d');try{const value=await exec(executable,['--no-cache','-r',workspace.resolve('repository'),...args],{env:{...process.env,RESTIC_PASSWORD:syntheticPassword,RESTIC_PASSWORD_FILE:'',RESTIC_PASSWORD_COMMAND:'',RESTIC_REPOSITORY:''},windowsHide:true,timeout:60000,maxBuffer:2*MiB});observations.push({args,exitCode:0,stdout:value.stdout,stderr:value.stderr});return value;}catch(error){observations.push({args,exitCode:error.code,stdout:error.stdout??'',stderr:error.stderr??''});throw error;}}
async function unlock(workspace){const names=await fs.readdir(workspace.resolve('repository/keys')),document=JSON.parse(await fs.readFile(workspace.resolve(`repository/keys/${names[0]}`),'utf8'));return masterKey(JSON.parse(open(await passwordKey(document,syntheticPassword),Buffer.from(document.data,'base64'))));}
function decodeObject(key,bytes){const plain=open(key,bytes);return JSON.parse((plain[0]===2?zstdDecompressSync(plain.subarray(1),{maxOutputLength:16*MiB}):plain).toString('utf8'));}
const encodeObject=(key,document)=>seal(key,Buffer.concat([Buffer.from([2]),zstdCompressSync(Buffer.from(JSON.stringify(document)))]));
async function indexes(workspace,key){const result=[];for(const name of await fs.readdir(workspace.resolve('repository/index')))result.push({name,document:decodeObject(key,await fs.readFile(workspace.resolve(`repository/index/${name}`)))});return result;}
async function publishIndex(workspace,key,name,document){const bytes=encodeObject(key,document),next=hash(bytes);await fs.writeFile(workspace.resolve(`repository/index/${next}`),bytes);await fs.unlink(workspace.resolve(`repository/index/${name}`));return next;}
async function source(workspace){await fs.mkdir(workspace.resolve('source/nested'),{recursive:true});const fixtures={'repeat.txt':Buffer.from('held-out compressed data \u2603 \ud83d\ude00\n'.repeat(7000)),'random.bin':fixedBytes(192*1024),'empty.txt':Buffer.alloc(0),'nested/\u03bb.txt':Buffer.from('independent Unicode bytes')};for(const[name,bytes]of Object.entries(fixtures))await fs.writeFile(workspace.resolve(`source/${name}`),bytes);return fixtures;}
async function assertRestore(f,snapshot,fixtures,target){await original(f.workspace,['restore',snapshot.id,'--target',path.join(f.folder,target)]);for(const[name,bytes]of Object.entries(fixtures))assert.deepEqual(await fs.readFile(path.join(f.folder,target,'source',name)),bytes);const checked=await f.api('nativeCheck',{id:snapshot.id});assert.equal(checked.verified,true);}
function frameWindow(frame){assert.equal(frame.readUInt32LE(0),0xfd2fb528);const descriptor=frame[4],single=Boolean(descriptor&32);assert.equal(descriptor&4,0);if(!single){const value=frame[5],base=2**(10+(value>>3));return base+(base/8)*(value&7);}let pos=5+[0,1,2,4][descriptor&3];const size=[1,2,4,8][descriptor>>6];return Number(size===8?frame.readBigUInt64LE(pos):frame.readUIntLE(pos,size))+(size===2?256:0);}
test('independent compression boundaries, frame windows and incompressible growth remain bounded',()=>{
 for(const mode of Object.keys(MODES))for(const bytes of [Buffer.alloc(0),Buffer.from([0xff]),fixedBytes(128*1024)])for(const type of ['data','tree']){const encoded=encodeBlob(bytes,type,2,mode),compressed=bytes.length>0&&(mode!=='off'||type==='tree');assert.equal(Boolean(encoded.uncompressedLength),compressed);assert.deepEqual(compressed?zstdDecompressSync(encoded.bytes):encoded.bytes,bytes);if(compressed)assert.ok(frameWindow(encoded.bytes)<=512*1024);if(compressed&&bytes.length===1)assert.ok(encoded.bytes.length>bytes.length,'growing frames retain compression metadata');}
 for(const mode of ['fastest','max']){const bytes=Buffer.alloc(16*MiB,0x41),encoded=encodeBlob(bytes,'tree',2,mode);assert.equal(encoded.uncompressedLength,bytes.length);assert.ok(frameWindow(encoded.bytes)<=512*1024);assert.deepEqual(zstdDecompressSync(encoded.bytes,{maxOutputLength:16*MiB}),bytes);assert.throws(()=>encodeBlob(Buffer.alloc(16*MiB+1),'tree',2,mode));}
 const empty=encodeMetadata(Buffer.alloc(0),2,'off');assert.equal(empty[0],2);assert.equal(zstdDecompressSync(empty.subarray(1)).length,0);assert.deepEqual(encodeMetadata(Buffer.from('{}'),1,'max'),Buffer.from('{}'));
});
test('mixed legacy v2 plaintext and compressed candidate snapshots preserve old blobs and deduplicate across modes',async t=>{
 const f=await fixture(t);assert.equal(hash(await fs.readFile('outputs/rea-research-lab/products/rea-studio/apps/backup/restic.mjs')),'70bf4a5bfd46041823fa00bd7cdbf880f6c0a9020f67ef9e7a807b4242fbb527');await oldNative({action:'nativeInit',input:{repository:'repository',password:syntheticPassword,version:2},workspace:f.workspace});const fixtures=await source(f.workspace);fixtures['chunk-repeat.bin']=Buffer.concat([Buffer.alloc(MiB,0x52),Buffer.alloc(MiB,0x52),fixedBytes(17)]);await fs.writeFile(f.workspace.resolve('source/chunk-repeat.bin'),fixtures['chunk-repeat.bin']);const older=await oldNative({action:'nativeSnapshot',input:{repository:'repository',password:syntheticPassword,source:'source'},workspace:f.workspace}),key=await unlock(f.workspace),initial=await indexes(f.workspace,key),oldData=initial.flatMap(v=>v.document.packs).flatMap(v=>v.blobs).filter(v=>v.type==='data');assert.ok(oldData.every(v=>!v.uncompressed_length));const details=await f.api('nativeInspect',{id:older.id}),large=details.entries.find(entry=>entry.path==='source/chunk-repeat.bin');assert.equal(large.content.length,3);assert.equal(large.content[0],large.content[1]);assert.notEqual(large.content[1],large.content[2]);
 await fs.writeFile(f.workspace.resolve('source/new.txt'),Buffer.from('new compressed data '.repeat(3000)));const currentFixtures={...fixtures,'new.txt':await fs.readFile(f.workspace.resolve('source/new.txt'))},fresh=await f.api('nativeSnapshot',{source:'source',compression:'auto'}),after=await indexes(f.workspace,key),allData=after.flatMap(v=>v.document.packs).flatMap(v=>v.blobs).filter(v=>v.type==='data');for(const blob of oldData)assert.equal(allData.filter(v=>v.id===blob.id).length,1);assert.ok(allData.some(v=>v.uncompressed_length));assert.ok((await fs.readdir(f.workspace.resolve('repository/index'))).length>=2);await original(f.workspace,['check','--read-data']);await assertRestore(f,older,fixtures,'old-restored');await assertRestore(f,fresh,currentFixtures,'new-restored');
 const last=await f.api('nativeSnapshot',{source:'source',compression:'off'}),finalData=(await indexes(f.workspace,key)).flatMap(v=>v.document.packs).flatMap(v=>v.blobs).filter(v=>v.type==='data');assert.equal(finalData.length,allData.length);for(const blob of allData)assert.deepEqual(finalData.find(v=>v.id===blob.id),blob);await original(f.workspace,['check','--read-data']);await assertRestore(f,last,currentFixtures,'off-restored');
});
test('candidate appends compressed data to an independently original-created v2 off repository',async t=>{
 const f=await fixture(t),fixtures=await source(f.workspace);await original(f.workspace,['init','--repository-version','2']);const first=JSON.parse((await original(f.workspace,['backup',f.workspace.resolve('source'),'--compression','off','--json'])).stdout.trim().split(/\r?\n/).at(-1));assert.equal(typeof first.snapshot_id,'string');await fs.writeFile(f.workspace.resolve('source/added.bin'),Buffer.from('original-created repository native append '.repeat(1000)));const fresh=await f.api('nativeSnapshot',{source:'source',compression:'max'});await original(f.workspace,['check','--read-data']);assert.equal((await f.api('nativeCheck',{id:first.snapshot_id})).verified,true);await assertRestore(f,fresh,{...fixtures,'added.bin':await fs.readFile(f.workspace.resolve('source/added.bin'))},'append-restored');
});
async function mutatedPack(workspace,key,index,blobType,change){const pack=index.document.packs.find(pack=>pack.blobs[0].type===blobType),oldID=pack.id,filename=workspace.resolve(`repository/data/${oldID.slice(0,2)}/${oldID}`),bytes=await fs.readFile(filename),length=bytes.readUInt32LE(bytes.length-4),start=bytes.length-4-length,header=open(key,bytes.subarray(start,-4)),payload=bytes.subarray(0,start);assert.equal(pack.blobs.length,1);const result=change({header:Buffer.from(header),payload:Buffer.from(payload),blob:pack.blobs[0]});let encodedHeader=result.encryptedHeader??seal(key,result.header??header),encodedPayload=result.payload??payload;const trailer=Buffer.alloc(4);trailer.writeUInt32LE(encodedHeader.length);const packed=Buffer.concat([encodedPayload,encodedHeader,trailer]),newID=hash(packed);pack.id=newID;await fs.mkdir(workspace.resolve(`repository/data/${newID.slice(0,2)}`),{recursive:true});await fs.writeFile(workspace.resolve(`repository/data/${newID.slice(0,2)}/${newID}`),packed);await fs.unlink(filename);await publishIndex(workspace,key,index.name,index.document);}
test('authenticated compressed corruption and pack/index disagreements reject before restore output, including original reader',async t=>{
 const f=await fixture(t);await f.api('nativeInit',{version:2});await source(f.workspace);const snapshot=await f.api('nativeSnapshot',{source:'source',compression:'auto'}),key=await unlock(f.workspace),base=f.workspace.resolve('repository');
 const cases=[['index-length',async(w,index)=>{index.document.packs.find(p=>p.blobs[0].type==='data').blobs[0].uncompressed_length++;await publishIndex(w,key,index.name,index.document);}],['payload-mac',async(w,index)=>mutatedPack(w,key,index,'data',({payload})=>{payload[20]^=1;return{payload};})],['header-mac',async(w,index)=>mutatedPack(w,key,index,'data',({header,payload})=>{const encryptedHeader=seal(key,header);encryptedHeader[20]^=1;return{encryptedHeader,payload};})],['frame-magic',async(w,index)=>mutatedPack(w,key,index,'data',({header,payload,blob})=>{const encoded=open(key,payload);encoded[0]^=1;const replacement=seal(key,encoded);header.writeUInt32LE(replacement.length,1);blob.length=replacement.length;return{header,payload:replacement};})],['frame-truncated-tree',async(w,index)=>mutatedPack(w,key,index,'tree',({header,payload,blob})=>{const encoded=open(key,payload).subarray(0,-1),replacement=seal(key,encoded);header.writeUInt32LE(replacement.length,1);blob.length=replacement.length;return{header,payload:replacement};})],['decoded-budget',async(w,index)=>mutatedPack(w,key,index,'data',({header,blob})=>{const encoded=zstdCompressSync(Buffer.alloc(2*MiB,65)),replacement=seal(key,encoded);header.writeUInt32LE(replacement.length,1);blob.length=replacement.length;return{header,payload:replacement};})]];
 for(const[name,change]of cases){const w=await createWorkspace(path.join(f.folder,name));await fs.cp(base,w.resolve('repository'),{recursive:true});const index=(await indexes(w,key))[0];await change(w,index);const api=(action,input={})=>handleNative({action,input:{repository:'repository',password:syntheticPassword,id:snapshot.id,...input},workspace:w});let checkError;try{await api('nativeCheck');}catch(error){checkError=error.message;}assert.ok(checkError,name);await assert.rejects(api('nativeRestore',{confirm:true,destination:'restored'}),undefined,name);await assert.rejects(fs.lstat(w.resolve('restored')),{code:'ENOENT'});const appLocksBeforeOriginal=await fs.readdir(w.resolve('repository/locks'));assert.deepEqual(appLocksBeforeOriginal,[]);await assert.rejects(original(w,['check','--read-data']));t.diagnostic(JSON.stringify({case:name,candidateError:checkError,restoreDestinationCreated:false,appLocksBeforeOriginal}));}
});
test('authenticated unsupported metadata marker and compressed metadata output budget reject without restore output',async t=>{
 const f=await fixture(t);await f.api('nativeInit',{version:2});await source(f.workspace);const snapshot=await f.api('nativeSnapshot',{source:'source',compression:'off'}),key=await unlock(f.workspace),base=f.workspace.resolve('repository'),document=decodeObject(key,await fs.readFile(f.workspace.resolve(`repository/snapshots/${snapshot.id}`)));
 for(const[name,plaintext]of [['unknown-marker',Buffer.concat([Buffer.from([3]),zstdCompressSync(Buffer.from(JSON.stringify(document)))])],['decoded-metadata-budget',Buffer.concat([Buffer.from([2]),zstdCompressSync(Buffer.concat([Buffer.from(JSON.stringify(document)),Buffer.alloc(17*MiB,32)]))])]]){const w=await createWorkspace(path.join(f.folder,name));await fs.cp(base,w.resolve('repository'),{recursive:true});const bytes=seal(key,plaintext),nextID=hash(bytes);await fs.writeFile(w.resolve(`repository/snapshots/${nextID}`),bytes);await fs.unlink(w.resolve(`repository/snapshots/${snapshot.id}`));const api=(action,input={})=>handleNative({action,input:{repository:'repository',password:syntheticPassword,id:nextID,...input},workspace:w});await assert.rejects(api('nativeCheck'));await assert.rejects(api('nativeRestore',{confirm:true,destination:'restored'}));await assert.rejects(fs.lstat(w.resolve('restored')),{code:'ENOENT'});assert.deepEqual(await fs.readdir(w.resolve('repository/locks')),[]);if(name==='unknown-marker')await assert.rejects(original(w,['check','--read-data']));else await original(w,['check','--read-data']);t.diagnostic(JSON.stringify({case:name,originalAccepts:name==='decoded-metadata-budget',candidateAccepts:false,documentedBoundary:name==='decoded-metadata-budget'?'16 MiB metadata subset':null}));}
});
test.after(async()=>{await fs.writeFile(new URL('original-observations.json',import.meta.url),`${JSON.stringify(observations,null,2)}\n`);});
