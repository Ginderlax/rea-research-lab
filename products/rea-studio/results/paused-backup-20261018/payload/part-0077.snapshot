    {
      "id": "grafana.candidate.7f671d98f2a092f467cb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This section describes the decisions you should make when using an Identity and Access Management (IAM) provider to manage access to Grafana. IAM ensures that users have secure access to sensitive data and [other resources](../../administration/data-source-management/), simplifying user management and authentication.",
      "headingPath": [
        "Plan your IAM integration strategy"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/_index.md",
