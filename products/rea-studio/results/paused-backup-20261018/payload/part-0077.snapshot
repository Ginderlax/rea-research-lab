    {
      "id": "grafana.candidate.082fde46ba41b1da049f",
      "syntaxRole": "table-row",
      "sourceText": "| `use_refresh_token`          | No       | Yes                | Set to `true` to use refresh token and check access token expiration. The `accessTokenExpirationCheck` feature toggle should also be enabled to use refresh token.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       | `true`                               |",
      "headingPath": [
        "Configure GitLab OAuth authentication",
        "Configuration options"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/gitlab/index.md",
