    {
      "id": "grafana.candidate.6815a347193a75630a50",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The maximum lifetime (duration) an authenticated user can be inactive before being required to login at next visit. Default is 7 days (7d). This setting should be expressed as a duration such `5m` (minutes), `6h` (hours), `10d` (days), `2w` (weeks), or `1M` (month). The lifetime resets at each successful token rotation (`token_rotation_interval_minutes`).",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[auth]`",
        "`login_maximum_inactive_lifetime_duration`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 1067,
        "lineEnd": 1069,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L1067-L1069"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.52a5090d7250fd8fca38",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The maximum lifetime (duration) an authenticated user can be logged in since login time before being required to login. Default is 30 days (30d). This setting should be expressed as a duration such `5m` (minutes), `6h` (hours), `10d` (days), `2w` (weeks), or `1M` (month).",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[auth]`",
        "`login_maximum_lifetime_duration`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 1073,
        "lineEnd": 1074,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L1073-L1074"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.48698bec58cac3eebc4f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "How often auth tokens are rotated for authenticated users when the user is active. The default is each 10 minutes.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[auth]`",
        "`token_rotation_interval_minutes`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
