const limits={sourceBytes:2*1024*1024,astNodes:150000,depth:256,declarations:20000};

export function inventory(ts,input,{fileName='vscode.d.ts',sourceURL=null}={}){
 const bytes=Buffer.isBuffer(input)?input:Buffer.from(input);if(bytes.length>limits.sourceBytes)throw new Error('Source exceeds2MiB');
 const text=bytes.toString('utf8');if(!Buffer.from(text).equals(bytes))throw new Error('Source is not canonical UTF8');
