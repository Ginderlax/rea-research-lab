        "lineStart": 65,
        "lineEnd": 67,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/dashboards/build-dashboards/import-dashboards/index.md#L65-L67"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
