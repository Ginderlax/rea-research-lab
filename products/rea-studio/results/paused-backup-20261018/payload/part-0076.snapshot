    {
      "id": "grafana.candidate.128f5c6fd17d7767e9d7",
      "syntaxRole": "table-row",
      "sourceText": "| Self-signed or private CA certificate isn't trusted                        | Enable **With CA Cert** and provide the root certificate under **TLS/SSL Root Certificate**.                                                                                                 |",
      "headingPath": [
        "Troubleshoot MySQL data source issues",
        "Connection errors",
        "TLS/SSL connection failures"
      ],
      "source": {
