assert git('rev-parse',AFTER+'^').decode().strip()==BEFORE
rows={r['path']:r for r in v['rows']};assert len(rows)==99
after=batch(AFTER,list(rows));oldnames=[p for p,r in rows.items()if r['before']is not None];assert len(oldnames)==4;before=batch(BEFORE,oldnames)
for p,r in rows.items():
    assert ident(read(R/p))==r['after']==ident(after[p])
    if r['before']is not None:assert ident(read(D/'before'/p))==r['before']==ident(before[p])
expected={p:'A'if r['before']is None else'M'for p,r in rows.items()}
