        "lineStart": 68,
        "lineEnd": 68,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/set-up/configure-alertmanager/_index.md#L68-L68"
      },
      "applicability": {
