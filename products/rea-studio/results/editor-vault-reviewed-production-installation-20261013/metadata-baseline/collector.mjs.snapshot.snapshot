import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const work=import.meta.dirname,lab=path.join(path.dirname(work),'outputs/rea-research-lab'),own=path.join(work,'editor-vault-checkpoint-preparation-next'),sha=b=>createHash('sha256').update(b).digest('hex'),names=['README.md','PUBLICATION-MANIFEST.json','products/rea-studio/README.md','products/rea-studio/STATUS.json','products/rea-studio/results/development-validation.json','products/rea-studio/NOTES-LAYOUT-VALUE-API-MILESTONE.md'];await fs.mkdir(own,{recursive:false});const rows=[];for(const p of names){const b=await fs.readFile(path.join(lab,p));if(p.endsWith('/development-validation.json'))assert.equal(sha(b),'1175423a8aa2660f3baea923f2ed0fdc932a53d176c0040901054eec0f1bd859');const target='before/'+p+'.snapshot';await fs.mkdir(path.dirname(path.join(own,target)),{recursive:true});await fs.writeFile(path.join(own,target),b,{flag:'wx'});rows.push({path:p,beforePath:target,bytes:b.length,sha256:sha(b)});}await fs.writeFile(path.join(own,'baseline.json'),JSON.stringify({schema:'rea-editor-vault-checkpoint-baseline/v1',productionCommit:'f0b4746eae49b2a83694de1a0a28fee63e004257',rows,liveAppsAlreadyUpdated:true,metadataNotUpdated:true,sourceOnly:true},null,2)+'\n',{flag:'wx'});await fs.copyFile(import.meta.filename,path.join(own,'collector.mjs.snapshot'));console.log(JSON.stringify({beforeMetadata:names.length,sourceOnly:true,own}));
