    {
      "id": "grafana.candidate.79e88589ed43715f7fd6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Symptom:** Data appears sparse, or `rate()` queries return no data or incomplete results.",
      "headingPath": [
