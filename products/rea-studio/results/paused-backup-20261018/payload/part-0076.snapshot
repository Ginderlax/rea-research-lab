    {
      "id": "grafana.candidate.a6c9a6c025916e739590",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The standalone plugin requires Grafana 12.3.0 or later. The InfluxDB data source bundled with Grafana 13.1 and earlier continues to work as before. Those versions are unaffected by this change.",
      "headingPath": [
        "InfluxDB data source",
        "Plugin updates"
      ],
      "source": {
        "path": "docs/sources/datasources/influxdb/_index.md",
        "gitBlobSha": "771c859f51d470e7fce9870f5e2a64bf1b8b6c70",
        "sha256": "2934a2738ef05247c22d6523ea50e68048253ba3067dd99f5f4e76a1ae051889",
