      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.405434c13734c493d790",
      "syntaxRole": "list-item",
      "sourceText": "- Create multiple data sources with some restrictions added in data source configuration that restrict access (like database name or credentials). Then use the [Data Source Permissions](../../administration/data-source-management/#data-source-permissions) Enterprise feature to restrict user access to the data source in Grafana.",
      "headingPath": [
        "Configure security",
        "Limit Viewer query permissions"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/_index.md",
