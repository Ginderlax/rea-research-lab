    {
      "id": "grafana.candidate.380d75131f1f4710aa98",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "TestData includes scenarios designed for testing how alerts respond to failures. Use these to verify that your alert rules handle edge cases correctly before connecting to production data sources.",
      "headingPath": [
        "TestData alerting",
        "Test error and no-data conditions"
      ],
      "source": {
        "path": "docs/sources/datasources/testdata/alerting/index.md",
        "gitBlobSha": "526f2432d34ad25382f4112893fa3beb53ea371c",
        "sha256": "4cdd8331327a15709d9d85afccaa1042c774296c7bfcbb031eef5b6c999fc194",
