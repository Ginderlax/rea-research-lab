import test from 'node:test';import assert from 'node:assert/strict';import {fixture,deferred,button,field,openEntry,beginRestore,descendants} from './ui-fixture.mjs';
function heldRestoreRead(){let armed=false;const arrived=deferred(),release=deferred();return{arrived,release,wrap:async(action,input,real)=>{const result=await real();if(action==='historyRestore')armed=true;else if(action==='read'&&armed){armed=false;arrived.resolve();await release.promise;}return result;}};}
test('New entry remains a new identity after a late post-restore read',async t=>{const hold=heldRestoreRead(),f=await fixture(t,'restore-read-new-entry',hold.wrap),start=await beginRestore(f.root),pending=start.start();await hold.arrived.promise;await button(f.root,'New entry').click();hold.release.resolve();await pending;f.observation.visibleTitle=field(f.root,'Title').value;field(f.root,'Title').value='New owned entry';field(f.root,'Password').value='New owned secret';await button(f.root,'Save encrypted entry').click();f.observation.savedRequest=f.requests.filter(row=>row.action==='save').at(-1);f.observation.entries=(await f.call('list')).entries;assert.equal(f.observation.savedRequest.id,undefined,'A new editor must not acquire the old restored entry ID.');assert.equal(f.observation.entries.length,3);});
test('locking during a held restore read cannot resurrect its old selected entry after unlock',async t=>{const hold=heldRestoreRead(),f=await fixture(t,'restore-read-lock',hold.wrap),start=await beginRestore(f.root),pending=start.start();await hold.arrived.promise;await button(f.root,'Lock now').click();hold.release.resolve();await pending;f.observation.lockedStatus=await f.call('status');f.observation.visiblePasswordWhileLocked=descendants(f.root).filter(node=>node.value==='A original').length;field(f.root,'Master password').value=f.master;await button(f.root,'Unlock').click();f.observation.editorAfterUnlock={title:field(f.root,'Title').value,password:field(f.root,'Password').value};assert.equal(f.observation.visiblePasswordWhileLocked,0);assert.equal(f.observation.editorAfterUnlock.title,'','Unlock must begin with a fresh editor rather than resurrecting a response from before lock.');});
test('late explicit history preview cannot populate a newly opened empty editor',async t=>{const arrived=deferred(),release=deferred(),f=await fixture(t,'late-history-preview',async(action,input,real)=>{const result=await real();if(action==='historyRead'){arrived.resolve();await release.promise;}return result;});await openEntry(f.root,'Entry A');await button(f.root,'Show entry history').click();const pending=button(f.root,'View this version').click();await arrived.promise;await button(f.root,'New entry').click();release.resolve();await pending;f.observation.title=field(f.root,'Title').value;f.observation.oldSecretRendered=descendants(f.root).some(node=>node.value==='A original');assert.equal(f.observation.title,'');assert.equal(f.observation.oldSecretRendered,false);});
test('a delayed post-restore list does not change the next editor selected by the user',async t=>{let armed=false;const arrived=deferred(),release=deferred(),f=await fixture(t,'late-restore-list',async(action,input,real)=>{const result=await real();if(action==='historyRestore')armed=true;else if(action==='list'&&armed){armed=false;arrived.resolve();await release.promise;}return result;}),start=await beginRestore(f.root),pending=start.start();await arrived.promise;await openEntry(f.root,'Entry B');release.resolve();await pending;f.observation.visibleTitle=field(f.root,'Title').value;field(f.root,'Title').value='Entry B safe update';await button(f.root,'Save encrypted entry').click();f.observation.savedRequest=f.requests.filter(row=>row.action==='save').at(-1);assert.equal(f.observation.visibleTitle,'Entry B');assert.equal(f.observation.savedRequest.id,f.B);});
test('a failed history restore persistence keeps ciphertext and active entry/history unchanged',async t=>{const f=await fixture(t,'failed-restore-commit'),row=(await f.call('historyList',{id:f.A})).revisions[0],encrypted=JSON.stringify(f.store.value),before=await f.call('read',{id:f.A}),history=await f.call('historyList',{id:f.A}),set=f.store.set;f.store.set=async()=>{throw new Error('owned immutable store failure')};await assert.rejects(f.call('historyRestore',{id:f.A,...row,confirm:true}),/owned immutable/);f.store.set=set;assert.equal(JSON.stringify(f.store.value),encrypted);assert.deepEqual(await f.call('read',{id:f.A}),before);assert.deepEqual(await f.call('historyList',{id:f.A}),history);f.observation.oldCiphertextPreserved=true;f.observation.oldSessionAndHistoryPreserved=true;});
test('ordinary save completion preserves a different editor opened while that response was held',async t=>{let armed=false;const arrived=deferred(),release=deferred(),f=await fixture(t,'ordinary-save-other-editor',async(action,input,real)=>{const result=await real();if(action==='save'&&!armed){armed=true;arrived.resolve();await release.promise;}return result;});await openEntry(f.root,'Entry A');field(f.root,'Notes').value='A intended edit';const pending=button(f.root,'Save encrypted entry').click();await arrived.promise;await openEntry(f.root,'Entry B');field(f.root,'Notes').value='B retained unsaved draft';release.resolve();await pending;f.observation.editor={title:field(f.root,'Title').value,notes:field(f.root,'Notes').value};assert.equal(f.observation.editor.title,'Entry B','Completion of A save must not clear the B editor.');assert.equal(f.observation.editor.notes,'B retained unsaved draft');});
