    {
      "id": "grafana.candidate.40cf873b5b661323d519",
      "syntaxRole": "table-row",
      "sourceText": "| 10:50<sup>\\*</sup> |                                | `backend`                 | 4                   | Group interval elapsed and resets timer. <br/> Send one notification reporting 4 alerts.       |",
      "headingPath": [
        "Group alert notifications",
        "Timing options",
        "Group interval"
      ],
      "source": {
        "path": "docs/sources/alerting/fundamentals/notifications/group-alert-notifications.md",
        "gitBlobSha": "91b5f217315c4289957555f22cc2173c7634f54f",
        "sha256": "68fe507d70754ee668e5a1f1f372f02560e35b04feb12867e869ea0ae6022dad",
        "lineStart": 154,
        "lineEnd": 154,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/fundamentals/notifications/group-alert-notifications.md#L154-L154"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
