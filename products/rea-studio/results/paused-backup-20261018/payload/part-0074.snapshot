      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.8f8bfff58a5d81543153",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Assigning a basic role such as `basic_admin` with `grafana_role_assignment` fails with the error `this endpoint cannot be used to assign basic, managed or external services roles`.",
      "headingPath": [
        "Provisioning RBAC with Terraform",
        "Provision basic roles"
      ],
      "source": {
        "path": "docs/sources/administration/roles-and-permissions/access-control/rbac-terraform-provisioning/index.md",
