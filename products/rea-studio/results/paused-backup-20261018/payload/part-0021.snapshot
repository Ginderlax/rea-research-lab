"""Static source data and text comparison only; no candidate code executes."""
import hashlib
import json
import re
import subprocess
from pathlib import Path

work = Path(__file__).resolve().parent
repo = work.parent / 'outputs/rea-research-lab'
stage = work / 'notes-installed-source-proof-phase12-next'
candidate = stage / 'candidate'
authority = json.loads((stage / 'change-authority.json').read_bytes())
pins = {row['path']: row['after'] for row in authority['files']}

def previous(name):
    return subprocess.run(['git', '-C', str(repo), 'show', authority['baseCommit'] + ':' + name], check=True, capture_output=True, timeout=30).stdout.decode('utf-8').replace('\r\n', '\n')

def current(name):
    return (candidate / name).read_text(encoding='utf-8').replace('\r\n', '\n')

def json_constants(text):
    values = {}
    for match in re.finditer(r'^const ([A-Za-z][A-Za-z0-9]*)=', text, re.M):
        try:
            value, consumed = json.JSONDecoder().raw_decode(text[match.end():])
        except json.JSONDecodeError:
            continue
        if text[match.end() + consumed:].lstrip().startswith(';'):
            assert match[1] not in values
            values[match[1]] = value
    return values

old = json_constants(previous('scripts/editor-vault-proof-migration.mjs'))
new = json_constants(current('scripts/editor-vault-proof-migration.mjs'))
assert set(new) == set(old) | {'notesSourceTransition'}
for name, value in old.items():
    if name == 'fixed':
        for row in value['verifiers']:
            if row['path'] in ('scripts/verify-records.mjs', 'scripts/verify-followup-records.mjs'):
                row['after'] = pins[row['path']]
    assert value == new[name], name
controls = current('scripts/publication-integrity-controls.mjs')
start = controls.index("  const notesIndexPath=")
end = controls.index("  const archiveIndexPath =", start)
notes_control_source = controls[start:end]
controls = controls[:start] + controls[end:]
controls = controls.replace("const ROOT_ID = { bytes: 149123, sha256: 'b5d48417f94e9464c071610ffc2720451cebae126b94b674e67c8f6fe16967d8' };", "const ROOT_ID = { bytes: 149064, sha256: '3878efc73e671246305e4368f7d3c52f288473591a4fe1697b343ab70249ae1e' };")
controls = controls.replace('assert.equal(result.routed, 13); assert.equal(result.unchanged, 724);', 'assert.equal(result.routed, 11); assert.equal(result.unchanged, 726);')
controls = controls.replace(json.dumps(pins['scripts/verify-cloud-publication.mjs'], separators=(',', ':')), '{"bytes":34261,"sha256":"7ddb50afc5712209664410a7e48a675453a946775e4985eeec71bfb4a85396e8"}')
controls = controls.replace('assert.equal(rows.length, 208);', 'assert.equal(rows.length, 164);')
assert controls == previous('scripts/publication-integrity-controls.mjs')
result = {'schema': 'rea-notes-phase12-unchanged-epochs-static-audit/v1', 'oldModuleJSONConstants': sorted(old), 'newModuleJSONConstants': sorted(new), 'allOldEpochConstantsUnchangedExceptTwoExplicitCurrentVerifierAfterPins': True, 'commonAndArchiveLimitsAndDefinitionsUnchanged': True, 'old164ControlSourceRetainedAfterOnlyRootPinRouteCountProducerPinAndTotalCountUpdates': True, 'newNotesControlSourceBytes': len(notes_control_source.encode()), 'localCandidateImports': 0, 'localTests': 0, 'localProductExecutions': 0, 'activeRepositoryMutations': 0}
with (work / 'notes-phase12-unchanged-epochs-static-audit-20261016.json').open('x', encoding='utf-8') as out:
    json.dump(result, out, indent=2)
    out.write('\n')
print(json.dumps(result))
