    {
      "id": "grafana.candidate.3337b1ade5deeb616d7e",
      "syntaxRole": "list-item",
      "sourceText": "- `org_mapping = Administration:*:Admin` to map users from `Administration` to all existing Grafana organizations as Admins.",
      "headingPath": [
