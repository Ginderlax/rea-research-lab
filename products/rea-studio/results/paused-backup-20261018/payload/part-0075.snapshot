    {
      "id": "grafana.candidate.14dec0ab84a3ac19e766",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Git Sync only manages dashboards and folders. Alerts, data sources, and library panels are **not** supported yet. Keep this in mind when migrating. Refer to [Before you begin](#before-you-begin) for details.",
      "headingPath": [
        "Add non-provisioned resources from Grafana"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/git-sync/export-resources.md",
