import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import {createHash} from 'node:crypto';
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab'),stage=path.join(work,'requirement-evidence-provenance-next'),candidate=path.join(stage,'candidate'),beforeRoot=path.join(stage,'before');
const prefix='products/rea-studio/results/requirement-evidence-provenance-20261015';
const sha=b=>createHash('sha256').update(b).digest('hex'),identity=b=>({bytes:b.length,sha256:sha(b)});
const names={root:'scripts/verify-records.mjs',migration:'scripts/editor-vault-proof-migration.mjs',producer:'scripts/verify-cloud-publication.mjs',controls:'scripts/publication-integrity-controls.mjs'};
const expected={root:{bytes:148558,sha256:'a78a9467ecd76ae44c3d2413b6d341c735bb1f98a657646d3b00a13dccf066f8'},migration:{bytes:74644,sha256:'1c11ce481db1d51e1d8f2e0483c78f02e8ad59f7a53510be2df517715cd1568e'},producer:{bytes:25836,sha256:'5f625fc6e6c92a76d64bcb73a1b1e80d809af2d7eb832e0c327a82b105539a97'},controls:{bytes:29589,sha256:'0bead8ef2dbd41d20711f83fae6c28f9c0e645315523c306fc91c4600e9a20b3'}};
const originals={};for(const key of Object.keys(names)){const b=fs.readFileSync(path.join(lab,names[key]));assert.equal(sha(b),expected[key].sha256);if(key==='controls')expected[key].bytes=b.length;assert.equal(b.length,expected[key].bytes);originals[key]=b;}
assert(!fs.existsSync(stage));for(const [key,name]of Object.entries(names)){const target=path.join(beforeRoot,name);fs.mkdirSync(path.dirname(target),{recursive:true});fs.writeFileSync(target,originals[key],{flag:'wx'});}
function write(name,bytes){const target=path.join(candidate,name);assert(!fs.existsSync(target));fs.mkdirSync(path.dirname(target),{recursive:true});fs.writeFileSync(target,bytes,{flag:'wx'});}
function replaceOnce(source,old,next,label){assert.equal(source.split(old).length,2,'Exact source marker: '+label);return source.replace(old,next);}
const oldLoop=`    for (const entry of localEvidence) {
      const bytes = readFileSync(join(root, entry.path));
      assert.equal(sha(bytes), entry.sha256, \x60Requirement implementation changed: \x24{entry.path}\x60);
      if (entry.bytes !== undefined) assert.equal(bytes.length, entry.bytes, \x60Requirement implementation size changed: \x24{entry.path}\x60);
    }`;
const newLoop=`    for (const entry of localEvidence) {
      safeRecordPath(entry.path);
      const historicalPath = sourceProofMigration.resolve(entry.path, entry);
