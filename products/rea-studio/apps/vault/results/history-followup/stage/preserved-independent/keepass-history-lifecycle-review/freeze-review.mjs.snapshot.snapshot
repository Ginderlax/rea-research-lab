import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';
const own=path.dirname(fileURLToPath(import.meta.url)),sha=b=>createHash('sha256').update(b).digest('hex'),base=path.resolve(own,'..'),stage=path.join(base,'keepass-history-selection-fix-next');async function id(file){const bytes=await fs.readFile(file);return{bytes:bytes.length,sha256:sha(bytes)}}
const run=JSON.parse(await fs.readFile(path.join(own,'runs/host-contract/validation.json'),'utf8'));await fs.mkdir(path.join(own,'baseline'),{recursive:true});for(const e of run.sourceFingerprints){const bytes=await fs.readFile(path.join(stage,e.path));if(sha(bytes)!==e.sha256)throw new Error('Changed implementation');await fs.writeFile(path.join(own,'baseline',e.path+'.snapshot'),bytes)}
const oldPath=path.join(base,'keepass-history-next/baseline/products/rea-studio/apps/vault/client.mjs.snapshot'),oldBytes=await fs.readFile(oldPath);await fs.writeFile(path.join(own,'baseline/pre-history-client.mjs.snapshot'),oldBytes);
const beforeParents=[['keepass-history-independent-review','review-manifest.json','659a694609e032da24f51b625d9f6528b0d9a5c3e558c9bc0d9fe7a0cf6f35d1'],['keepass-history-selection-independent-review','review-manifest.json','df87b099e0234bb611b76dd6079e09482f526696037a0124bd4374318738dd6d'],['keepass-history-draft-policy-review','review-manifest.json','a36e0aa279f305f5e9e7474ebbc05fa9661d2f27f4934ddd6811428b005dc6a9'],['keepass-history-selection-fix-next','selection-preservation-manifest.json','d6c09b4a6e4d45b3729ad8c8692b2352686e8e7e88e5ad791905fbb26b8b52de']];const authenticated=[];
for(const [dir,name,expected]of beforeParents){const root=path.join(base,dir),file=path.join(root,name),identity=await id(file);if(identity.sha256!==expected)throw new Error('Manifest changed');const m=JSON.parse(await fs.readFile(file,'utf8'));for(const e of m.files){const p=path.resolve(root,e.path);if(!p.startsWith(root+path.sep))throw new Error('Unsafe path');const identity=await id(p);if(identity.sha256!==e.sha256||identity.bytes!==e.bytes)throw new Error('Changed '+p)}authenticated.push({path:file,...identity,count:m.files.length,allEntriesMatch:true})}
const receipt={schema:'rea-independent-vault-detached-idle-review-final/v1',createdAt:new Date().toISOString(),status:'FROZEN_REVIEW_WITH_CONFIRMED_PREEXISTING_FINDING',authenticated,sourceFingerprints:run.sourceFingerprints,run:{...await id(path.join(own,'runs/host-contract/validation.json')),counts:run.counts,sourceStable:run.sourceStable},preHistorySource:{path:oldPath,sha256:sha(oldBytes),classification:'Same no-cleanup return and old content-parent guard; source inspection, not a prior-runtime execution'},finding:{priority:'P2',trigger:'Navigate away from Vault, reopen, make a new request, then older idle timer fires',observed:'The older detached view requests lock and locks the current active session',expected:'Detach/dispose cancels its timer and suppresses its later effects'},scope:run.scope};await fs.writeFile(path.join(own,'review-validation.json'),JSON.stringify(receipt,null,2)+'\n');
async function walk(dir){let list=[];for(const e of await fs.readdir(dir,{withFileTypes:true})){if(e.name==='.local')continue;const file=path.join(dir,e.name);if(e.isDirectory())list.push(...await walk(file));else if(!['review-manifest.json','freeze.json'].includes(e.name))list.push({path:path.relative(own,file).split(path.sep).join('/'),...await id(file)})}return list;}
const files=(await walk(own)).sort((a,b)=>a.path.localeCompare(b.path)),manifest={schema:'rea-independent-vault-idle-review-manifest/v1',count:files.length,files};await fs.writeFile(path.join(own,'review-manifest.json'),JSON.stringify(manifest,null,2)+'\n');const freeze={schema:'rea-independent-vault-idle-review-freeze/v1',count:files.length,receipt:await id(path.join(own,'review-validation.json')),manifest:await id(path.join(own,'review-manifest.json'))};await fs.writeFile(path.join(own,'freeze.json'),JSON.stringify(freeze,null,2)+'\n');console.log(JSON.stringify(freeze));
