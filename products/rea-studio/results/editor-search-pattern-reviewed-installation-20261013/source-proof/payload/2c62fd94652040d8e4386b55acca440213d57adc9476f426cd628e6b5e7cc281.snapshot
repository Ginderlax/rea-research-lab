import fs from'node:fs/promises';import path from'node:path';import{createHash}from'node:crypto';
const here=import.meta.dirname,stage=path.resolve(here,'../editor-search-pattern-next'),capture='source-only-initial/'+new Date().toISOString().replace(/[:.]/g,'-'),base='candidate/products/rea-studio/apps/editor/';
const names=['search-pattern.mjs','search-pattern-session.mjs','search-pattern-worker.mjs','workspace-search.mjs','server.mjs','client.mjs','search-pattern.test.mjs','SEARCH.md'];const paths=[...names.map(n=>base+n),'candidate/products/rea-studio/server.mjs','PROSPECTIVE-SCOPE.md','official-source-provenance.json','original-engine.json'];const id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),records=[];
async function save(p,b){await fs.mkdir(path.dirname(path.join(here,p)),{recursive:true});await fs.writeFile(path.join(here,p),b,{flag:'wx'});}
for(const p of paths){try{const b=await fs.readFile(path.join(stage,p));records.push({path:p,...id(b)});await save(capture+'/source/'+p+'.snapshot',b);}catch(e){records.push({path:p,unavailable:true,error:e.code});}}
await save(capture+'/source-before.json',JSON.stringify(records,null,2)+'\n');const after=[];for(const p of paths){try{const b=await fs.readFile(path.join(stage,p));after.push({path:p,...id(b)});}catch(e){after.push({path:p,unavailable:true,error:e.code});}}
await save(capture+'/source-after.json',JSON.stringify(after,null,2)+'\n');const stable=JSON.stringify(after)===JSON.stringify(records);await save(capture+'/validation.json',JSON.stringify({schema:'rea-editor-pattern-independent-initial-source-pass/v1',sourceOnly:true,authorFreezePending:true,capturedSourceStable:stable,files:records.length,applicationTests:0,originalCalls:0,browsers:0,hosts:0,candidateWrites:0},null,2)+'\n');process.stdout.write(JSON.stringify({capture,stable,files:records.length})+'\n');
