import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
const root=import.meta.dirname,hash=b=>createHash('sha256').update(b).digest('hex');
const references=[{root:'../notes-trash-publication-fix-next',manifest:'manifest.json',sha256:'50334e5366f39cb42ccf71dc4b6b6cc2544a63967705529fc377eb1cff5e7e51',count:504,receipt:'validation.json',receiptSha256:'322e1e5793a1204053a933e5ec0923a3d289289940780a8300fcf287c0e0599b'},{root:'../notes-trash-next',manifest:'preservation-manifest.json',sha256:'aaa0b6f1f3fcf3b642e6cf23aec76b7596006cb39d49b073bac55b6af2af563b',count:325},{root:'../notes-trash-independent-review',manifest:'review-manifest.json',sha256:'d6e485d9168f548709c69a30cd04e5fcc065cc6348892d3326606c34f0dff18f',count:37}];
for(const r of references){const folder=path.resolve(root,r.root),b=await fs.readFile(path.join(folder,r.manifest));if(hash(b)!==r.sha256)throw new Error('Manifest changed '+r.root);const m=JSON.parse(b),rows=m.records??m.files;if(rows.length!==r.count)throw new Error('Census '+r.root);for(const e of rows){const file=path.resolve(folder,e.path);if(!file.startsWith(folder+path.sep))throw new Error('Unsafe manifest '+e.path);const b=await fs.readFile(file);if(b.length!==e.bytes||hash(b)!==e.sha256)throw new Error('Changed '+r.root+'/'+e.path);}if(r.receiptSha256&&hash(await fs.readFile(path.join(folder,r.receipt)))!==r.receiptSha256)throw new Error('Receipt changed');const out=path.join(root,'baseline-bindings',r.root.slice(3));await fs.mkdir(out,{recursive:true});await fs.writeFile(path.join(out,r.manifest+'.snapshot'),b);if(r.receipt)await fs.copyFile(path.join(folder,r.receipt),path.join(out,r.receipt+'.snapshot'));}
await fs.mkdir(path.join(root,'regression'),{recursive:true});const adapters=[];
for(const name of['review.test.mjs','ui-fixture.mjs']){const b=await fs.readFile(path.resolve(root,'../notes-trash-independent-review',name));const original=b.toString(),from='../notes-trash-next/products',to='../../notes-trash-publication-fix-next/products',adapted=original.replaceAll(from,to);await fs.writeFile(path.join(root,'regression',name),adapted);await fs.writeFile(path.join(root,'baseline-bindings',name+'.snapshot'),b);adapters.push({name,originalSha256:hash(b),adaptedSha256:hash(adapted),from,to,occurrences:original.split(from).length-1,scope:'Only explicit import prefixes; test bodies, assertions and observation logic unchanged'});}
for(const name of['publication-boundaries.test.mjs']){const b=await fs.readFile(path.resolve(root,'../notes-trash-publication-fix-next/regression',name));if(hash(b)!=='bf70a1b54627a72b4d63bc3329d59b8977816a5ccd30df98ff6e0f50e8e9ff31')throw new Error('Author adjacent body identity');await fs.writeFile(path.join(root,'regression',name),b);adapters.push({name,sha256:hash(b),byteIdentical:true});}
const snapshots=['products/rea-studio/apps/notes/client.mjs','products/rea-studio/apps/notes/server.mjs','products/rea-studio/apps/notes/notebook-trash.mjs','products/rea-studio/apps/notes/notebooks.mjs','products/rea-studio/apps/notes/notebook-trash-original-oracle.mjs','products/rea-studio/apps/notes/jex.mjs','products/rea-studio/apps/notes/markdown.mjs','products/rea-studio/server.mjs','products/rea-studio/lib/storage.mjs','README.md'];for(const name of snapshots){const p=path.join(root,'source-baseline',name+'.snapshot');await fs.mkdir(path.dirname(p),{recursive:true});await fs.copyFile(path.resolve(root,'../notes-trash-publication-fix-next',name),p);}
await fs.writeFile(path.join(root,'baseline.json'),JSON.stringify({schema:'rea-notes-trash-fixed-independent-review-baseline/v1',capturedAt:new Date().toISOString(),references,authenticatedArtifacts:866,adapters,snapshots,productionModified:false},null,2)+'\n');console.log(JSON.stringify({authenticatedArtifacts:866,adapters}));
