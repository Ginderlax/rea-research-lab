import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import {here} from './harness.mjs';
const sha=b=>createHash('sha256').update(b).digest('hex');
const declarations=[
 ['KVH2611-AUTOMATIC-SAVE','KeePass/Forms/PwEntryForm.cs','private bool SaveEntry(', 'private void SaveDefaultSeq(', 'Back up before content changes, retain no extra backup or changed modification time for an unchanged entry, then maintain limits.'],
 ['KVH2611-BACKUP-COPY','KeePassLib/PwEntry.cs','public void CreateBackup(PwDatabase','public bool HasBackupOfData(', 'Append a deep entry copy without nested history; restoration retains its selected reference across backup and pruning.'],
 ['KVH2611-RESTORE-ASSIGN','KeePassLib/PwEntry.cs','public void AssignProperties(', 'public void Touch(bool bModified)', 'Copy recognized entry data/metadata while retaining history and location metadata when the corresponding flags are false.'],
 ['KVH2611-TOUCH','KeePassLib/PwEntry.cs','public void Touch(bool bModified, bool bTouchParents)','public void CreateBackup()', 'Update access time/usage, and modification time when requested; the dialog path does not touch parent groups.'],
 ['KVH2611-HISTORY-LIMITS','KeePassLib/PwEntry.cs','public bool MaintainBackups(', '// Cf. AutoType.GetEnabledText','Normalize history UUIDs and prune first-oldest snapshots to satisfy nonnegative count and byte limits.'],
 ['KVH2611-HISTORY-SIZE','KeePassLib/PwEntry.cs','public ulong GetSize()', 'public bool HasTag(', 'Approximate64bit memory using structural constants, UTF16 characters and raw attachment sizes.'],
 ['KVH2611-UNKNOWN-TIME','KeePassLib/Utility/TimeUtil.cs','private static readonly DateTime m_dtInvMin', 'internal static int CompareLastMod(', 'Treat the released unknown-date minute59/second59 family as past and equal; compare ordinary instants otherwise.'],
 ['KVH2611-SAFE-MAX','KeePassLib/Utility/TimeUtil.cs','public static readonly DateTime SafeMaxValueUtc', 'private static readonly string[]','The oldest-backup selection sentinel is DateTime.MaxValue minus one day.'],
 ['KVH2611-RESTORE-DIALOG','KeePass/Forms/PwEntryForm.cs','private void OnBtnHistoryRestore(', 'private void OnCtxHstSelectAll(', 'After validating a single historical selection, restore from backup and touch the live entry as modified.']
];
const contracts=[];for(const [id,file,start,stop,paraphrase] of declarations){const bytes=await fs.readFile(path.join(here,'source',file)),value=bytes.toString('utf8'),a=value.indexOf(start),b=value.indexOf(stop,a+start.length);if(a<0||b<0)throw new Error('Missing declared source span '+id);const offset=Buffer.byteLength(value.slice(0,a)),length=Buffer.byteLength(value.slice(a,b));contracts.push({id,paraphrase,file,fileSha256:sha(bytes),utf8ByteOffset:offset,utf8ByteLength:length,spanSha256:sha(bytes.subarray(offset,offset+length)),lineStart:value.slice(0,a).split('\n').length,lineEnd:value.slice(0,b).split('\n').length-1});}
const manual=await fs.readFile(path.resolve(here,'../keepass-manual-requirements-next/supplement/manual-contracts.json'));await fs.writeFile(path.join(here,'contract-map.json'),JSON.stringify({schema:'rea-stage-keepass-history-source-contracts/v1',release:'2.61.1',sourceArchiveSha256:'711bd9ec7076661678469e51bae876debac07a08c32f1b1c6b3b8fe5e761c13a',contracts,manualBinding:{ledgerSha256:sha(manual),ids:['KPM2611-HISTORY-SNAPSHOT','KPM2611-HISTORY-LIST','KPM2611-HISTORY-COUNT-LIMIT','KPM2611-HISTORY-SIZE-LIMIT'],ledgerUnmodified:true,selectedDeletionAndAgeMaintenanceImplemented:false,restoreIsAdditionalSourceContract:true},exhaustiveStudy:false,guiOriginalExecution:false},null,2));
