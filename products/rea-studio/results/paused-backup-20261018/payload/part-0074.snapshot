    {
      "id": "grafana.candidate.f69809020cd3f11d27f6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If a data source query request contains an `X-Cache-Skip` header, then Grafana skips the caching middleware, and does not search the cache for a response. This can be particularly useful when debugging data source queries using cURL.",
      "headingPath": [
        "Data source management",
        "Query and resource caching",
        "Sending a request without cache"
      ],
      "source": {
        "path": "docs/sources/administration/data-source-management/_index.md",
        "gitBlobSha": "48e0cd06582ded6e67389dc4fe82510ea7271f7b",
        "sha256": "087e0c6f2fdd1b21672ed0be96bcf714c87e35ca1887c2f4bb4382f0c4b4bdad",
