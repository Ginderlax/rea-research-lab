    {
      "id": "grafana.candidate.a3c7cfbab38c379cbd8a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Some functions like `aliasByNode` support an optional second argument. To add this argument, hover your mouse over the argument and a dialog box appears. To remove the second optional parameter, click on it to delete it.",
      "headingPath": [
        "Graphite query editor",
        "Functions"
      ],
      "source": {
