        "lineStart": 99,
        "lineEnd": 99,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/roles-and-permissions/access-control/manage-rbac-roles/index.md#L99-L99"
      },
      "applicability": {
