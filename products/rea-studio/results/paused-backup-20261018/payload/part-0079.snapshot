    {
      "id": "grafana.candidate.737a2c5603aa77bab264",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana caches the results of backend data source queries so that multiple users viewing the same dashboard or panel do not make multiple submissions of the same query to the data source (like Splunk or Snowflake) itself.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Enterprise features",
        "Data source query caching"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-0.md",
        "gitBlobSha": "08364874bf79c35cb3f0d907a16891c4cfb0eb1c",
        "sha256": "6f07cb510f8b0da003b838c600c8c34236d365c4cc7688913f7fe726f50a0fd7",
        "lineStart": 305,
        "lineEnd": 305,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v8-0.md#L305-L305"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.47b36968efb673dc910e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can enable caching per data source, and time-to-live (TTL) can be configured globally and per data source. Query caching can be set up with Redis, Memcached, or a simple in-memory cache.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Enterprise features",
        "Data source query caching"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-0.md",
        "gitBlobSha": "08364874bf79c35cb3f0d907a16891c4cfb0eb1c",
        "sha256": "6f07cb510f8b0da003b838c600c8c34236d365c4cc7688913f7fe726f50a0fd7",
        "lineStart": 309,
        "lineEnd": 309,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v8-0.md#L309-L309"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.35ef8fac900c2e15fc3d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For more information, refer to the [Data source query caching docs](../../administration/data-source-management/#query-and-resource-caching).",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Enterprise features",
        "Data source query caching"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-0.md",
