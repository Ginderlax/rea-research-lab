import * as fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const root=fileURLToPath(new URL('./',import.meta.url)),stage=path.resolve(root,'../backup-rabin-fixed-next'),hash=bytes=>createHash('sha256').update(bytes).digest('hex'),previous=JSON.parse(await fs.readFile(path.resolve(root,'../backup-rabin-review/baseline-manifest.json'),'utf8'));
const files=[];async function walk(folder,prefix=''){for(const item of await fs.readdir(folder,{withFileTypes:true})){const name=prefix+item.name;if(item.isDirectory())await walk(path.join(folder,item.name),name+'/');else{const bytes=await fs.readFile(path.join(folder,item.name)),output=path.join(root,'baseline',name);await fs.mkdir(path.dirname(output),{recursive:true});await fs.writeFile(output,bytes);files.push({path:name,bytes:bytes.length,sha256:hash(bytes)});}}}await walk(stage);files.sort((a,b)=>a.path.localeCompare(b.path));
const sourceFingerprints=files.filter(item=>/\.(mjs|go|md)$/.test(item.path)||item.path==='source-provenance.json'||item.path.startsWith('references/')||item.path==='author-baseline-manifest.json');
const changed=previous.files.filter(old=>sourceFingerprints.some(item=>item.path===old.path&&item.sha256!==old.sha256)).map(item=>item.path);assert.deepEqual(changed.sort(),['README.md','apps/backup/restic.mjs','capture-file.mjs'].sort());
const report={schema:'rea-rabin-fixed-review-baseline/v1',capturedAtUtc:new Date().toISOString(),stage,originalStageReceiptSha256:previous.stageReceiptSha256,originalReviewReceiptSha256:hash(await fs.readFile(path.resolve(root,'../backup-rabin-review/review-validation.json'))),copiedFiles:files,sourceFingerprints,expectedModifiedSources:changed,excludedLiveAuthorEvidence:'Root verifier is running in parallel and may replace its author receipts, output and measurement. This review authenticates immutable source files, and all copied baseline bytes.'};
const output=path.join(root,'baseline-manifest.json');await fs.writeFile(output,JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({files:files.length,sourceFiles:sourceFingerprints.length,sourceFingerprints:sourceFingerprints.filter(item=>changed.includes(item.path)),manifestSha256:hash(await fs.readFile(output))}));
