import fs from'node:fs/promises';import path from'node:path';import{fileURLToPath}from'node:url';import{createHash}from'node:crypto';import{spawn}from'node:child_process';const own=path.dirname(fileURLToPath(import.meta.url)),[name,...tests]=process.argv.slice(2),candidate=path.join(own,'candidate'),app=path.join(candidate,'products/rea-studio/apps/flow'),sha=b=>createHash('sha256').update(b).digest('hex');if(!/^[a-z0-9-]+$/.test(name??'')||!tests.length)throw new Error('Owned finite run name/tests required');const out=path.join(own,'runs',name);await fs.mkdir(out,{recursive:true});async function census(dir,prefix='',snapshot=false){let rows=[];for(const e of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){if(['.local','results','node_modules'].includes(e.name))continue;const p=prefix?prefix+'/'+e.name:e.name;if(e.isDirectory())rows.push(...await census(path.join(dir,e.name),p,snapshot));else{const b=await fs.readFile(path.join(dir,e.name));rows.push({path:p,bytes:b.length,sha256:sha(b)});if(snapshot){const d=path.join(out,'source',p+'.snapshot');await fs.mkdir(path.dirname(d),{recursive:true});await fs.writeFile(d,b);}}}return rows;}const before=await census(candidate,'',true),collector=await fs.readFile(fileURLToPath(import.meta.url));await fs.writeFile(path.join(out,'collector.mjs.snapshot'),collector);const env={...process.env,FLOW_LINK_OBSERVATIONS:path.join(out,'observations'),FLOW_ORIGINAL_CACHE:path.resolve(own,'../../outputs/rea-research-lab/.local/flow-original')};await fs.mkdir(env.FLOW_LINK_OBSERVATIONS,{recursive:true});const child=spawn(process.execPath,['--test','--test-concurrency=1',...tests.map(n=>path.join(app,n))],{windowsHide:true,env}),chunks={stdout:[],stderr:[]},sizes={stdout:0,stderr:0};let problem;const timer=setTimeout(()=>{problem='Owned focused run180s deadline';child.kill()},180000);for(const k of Object.keys(chunks))child[k].on('data',b=>{sizes[k]+=b.length;if(sizes[k]>4194304){problem='Owned capture4MiB per stream exceeded';child.kill()}else chunks[k].push(b)});const exit=await new Promise(r=>child.on('close',(code,signal)=>r({code,signal})));clearTimeout(timer);const after=await census(candidate);for(const k of Object.keys(chunks))await fs.writeFile(path.join(out,k+'.txt'),Buffer.concat(chunks[k]));await fs.writeFile(path.join(out,'run.json'),JSON.stringify({schema:'rea-flow-link-focused-run/v1',name,at:new Date().toISOString(),tests,before,after,sourceStable:JSON.stringify(before)===JSON.stringify(after),collector:{bytes:collector.length,sha256:sha(collector)},exit,problem:problem??null,sizes,originalCache:env.FLOW_ORIGINAL_CACHE},null,2)+'\n');process.stdout.write(Buffer.concat(chunks.stdout));process.stderr.write(Buffer.concat(chunks.stderr));console.log(JSON.stringify({name,exit,sourceStable:JSON.stringify(before)===JSON.stringify(after),sources:before.length}));process.exitCode=exit.code??1;
