    {
      "id": "grafana.candidate.2f90681f8c1da492aeb0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "SAML’s single logout (SLO) capability allows users to log out from all applications associated with the current identity provider (IdP) session established via SAML SSO. For more information, refer to the [docs](../../setup-grafana/configure-access/configure-authentication/saml/#single-logout).",
      "headingPath": [
        "What's new in Grafana v7.3",
        "Grafana Enterprise features",
        "SAML single logout"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-3.md",
