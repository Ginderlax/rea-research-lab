    },
    {
      "id": "grafana.candidate.9ba5a709824f8f0f6dcd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Span filters exist above the trace view and allow you to filter the spans that are shown in the trace view. The more filters you add, the more specifically span are filtered.",
      "headingPath": [
        "What’s new in Grafana v10.0",
        "Tracing",
        "Span filtering for traces"
      ],
