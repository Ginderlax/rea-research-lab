    {
      "id": "grafana.candidate.02800c4a59b879c3bf35",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can use template variables in your annotation queries to filter annotations based on dashboard variable selections:",
      "headingPath": [
        "Prometheus annotations",
        "Use template variables in annotations"
      ],
      "source": {
