    {
      "id": "grafana.candidate.60965a1a09e9d7b0ee5f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This query returns only spans that handled more than 300 requests in the 10-minute period.",
      "headingPath": [
        "Examples of trace-based alerts",
