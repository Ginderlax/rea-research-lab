        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.e66318e2174bc4f2d7ac",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Each global option applies only to the command in which it is used. For example, `--pluginsDir value` does not permanently change where Grafana saves plugins. It only changes it for command in which you apply the option.",
      "headingPath": [
        "Administer Grafana with the Grafana server CLI",
        "Global options"
      ],
