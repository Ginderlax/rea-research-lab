      "syntaxRole": "table-row",
      "sourceText": "| Certificate has expired or doesn't match the hostname                      | Renew the certificate, or enable **Skip TLS Verification** for development environments only.                                                                                                |",
      "headingPath": [
        "Troubleshoot MySQL data source issues",
        "Connection errors",
        "TLS/SSL connection failures"
      ],
      "source": {
