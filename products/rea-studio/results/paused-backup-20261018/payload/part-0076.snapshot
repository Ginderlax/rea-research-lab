    {
      "id": "grafana.candidate.22d1319e4a40fcc415ef",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The Azure SQL Server that you are connecting to must support Azure Entra authentication. For configuration details, refer to the [Azure SQL documentation](https://learn.microsoft.com/en-us/azure/azure-sql/database/authentication-aad-configure?view=azuresql&tabs=azure-portal).",
      "headingPath": [
        "Configure the Microsoft SQL Server data source",
        "Configure the data source in the UI",
        "Azure Entra ID (formerly Azure AD) Authentication"
      ],
      "source": {
