        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.ec103048ee6ffc378ee4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can also view the role definition directly in your browser by navigating to:",
      "headingPath": [
        "Manage RBAC roles",
        "View basic role definitions",
        "Using the browser"
      ],
      "source": {
        "path": "docs/sources/administration/roles-and-permissions/access-control/manage-rbac-roles/index.md",
