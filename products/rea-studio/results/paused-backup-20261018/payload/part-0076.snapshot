      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.320319d50bfaa69eca49",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Changes made to a query in Code mode don't transfer to Builder mode and are discarded. Grafana prompts you to copy your code to the clipboard to save any changes.",
      "headingPath": [
        "MySQL query editor",
        "MySQL Code mode"
      ],
      "source": {
