function store(bytes,path,sourcePath){mkdirSync(dirname(join(destination,path)),{recursive:true});writeFileSync(join(destination,path),bytes,{flag:'wx'});return{sourcePath,path,bytes:bytes.length,sha256:sha(bytes)};}
const snapshots=[],excluded=[];
for(const[path,entry]of Object.entries(receipt.inventory)){
 assert.ok(!path.split('/').includes('..'));const b=readFileSync(join(source,path));assert.equal(b.length,entry.bytes);assert.equal(sha(b),entry.sha256);
 if(path.endsWith('.tgz')){excluded.push({sourcePath:path,...entry,reason:'Exact original registry archive retained locally; excluded from the public source/log/figure payload.'});continue;}
 const mapped=path.replace('/node_modules/lodash/','/selected-lodash-source/');const inert=/\.(mjs|cjs|js|md|py|ps1)$/.test(mapped)?'.snapshot':'';snapshots.push(store(b,'stage/'+mapped+inert,path));
