import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const base=path.resolve(import.meta.dirname,'..'),lab=path.join(base,'outputs/rea-research-lab'),owned=path.join(base,'work/root-publication-reference-corrections-next'),prefix='products/rea-studio/results/root-publication-reference-corrections-20261013',sha=b=>createHash('sha256').update(b).digest('hex');
const verificationBytes=fs.readFileSync(path.join(base,'work/notes-layout-value-api-records.stdout.txt')),verification=JSON.parse(verificationBytes);assert.equal(verification.status,'passed');assert.equal(verification.product_development.recorded_tests_passed,847);assert.equal(verification.product_development.tested_source_hashes_checked,720);assert.equal(verification.named_historical_shared_host_receipts.backup_rabin_sources.prior_other_historical_rows,6);assert.equal(fs.readFileSync(path.join(base,'work/notes-layout-value-api-records.stderr.txt')).length,0);
fs.mkdirSync(owned,{recursive:true});
function copy(relative,destination=relative){const b=fs.readFileSync(path.join(base,relative)),p=path.join(owned,destination);fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,b,{flag:'wx'});}
const stages=['root-backup64-host-transition-next','root-named-historical-host-transition-next','root-metrics-historical-host-transition-next','root-rabin-historical-host-transition-next','root-notes-sketch-implementation-references-next'];for(const n of stages)for(const f of fs.readdirSync(path.join(base,'work',n)).sort()){assert.ok(fs.statSync(path.join(base,'work',n,f)).isFile());copy('work/'+n+'/'+f,'epochs/'+n+'/'+f);}
const reviews=[['root-backup64-host-transition-independent-review','587ebb4dbb8fd29fc89652b46b8823551e032873ebd2799385859aa9745b0eee'],['root-named-metrics-host-transition-independent-review','52df46c14fa771f821424ace5dc8e4bf239f6c1a280d2104b11938388eb7b562'],['root-rabin-host-transition-independent-review','bc7e149629ed8664ecbea6c9acbbd23caa083d4e8a3f98daadfcd8ab3b0b7cb4'],['root-notes-sketch-implementation-references-independent-review','156c572fc57a26f00c79fd33c937c2b1d0ebc49c73843aa9e7eb7c0dd6b0983d']];
for(const[n,pin]of reviews){const bytes=fs.readFileSync(path.join(base,'work',n,'review-validation.json'));assert.equal(sha(bytes),pin);const m=JSON.parse(fs.readFileSync(path.join(base,'work',n,'review-manifest.json')));assert.equal(m.inventory.length,1);assert.equal(m.inventory[0].path,'review-validation.json');assert.equal(m.inventory[0].bytes,bytes.length);assert.equal(m.inventory[0].sha256,pin);for(const f of ['review-validation.json','review-manifest.json'])copy('work/'+n+'/'+f,'reviews/'+n+'/'+f);}
for(const n of ['adapt-backup64-historical-host-fingerprint.mjs','adapt-named-historical-host-receipts.mjs','adapt-metrics-historical-host-receipt.mjs','adapt-rabin-historical-host-receipt.mjs','update-notes-sketch-implementation-references.mjs','inspect-historical-host-receipt-rows.mjs','inspect-current-requirement-implementation-bindings.mjs'])copy('work/'+n,'collectors/'+n+'.snapshot');
copy('work/notes-layout-value-api-records.stdout.txt','successful-prepublication-check.stdout.txt');copy('work/notes-layout-value-api-records.stderr.txt','successful-prepublication-check.stderr.txt');copy('outputs/rea-research-lab/VALIDATION.json','successful-prepublication-validation.json.snapshot');copy(path.relative(base,import.meta.filename).replaceAll('\\','/'),'preservation-collector.mjs.snapshot');
const diagnostic={schema:'rea-root-preparation-read-diagnostics/v1',at:new Date().toISOString(),toolOnlyReadFailures:['One repo-relative browser validation path requested from task cwd.','One nonexistent recorder-followup path requested before using declared recorderPrefix.','One work-relative publisher path requested from repo cwd.','One incorrect workspace.json name requested before using INDEX registry names.'],rawStderrNotInvented:true,productBehaviorFailures:0,changesFromFailedReads:0,handling:'Corrected reads use actual inventories and absolute workspace paths.'};fs.writeFileSync(path.join(owned,'preparation-read-diagnostics.json'),JSON.stringify(diagnostic,null,2)+'\n',{flag:'wx'});
const summary={schema:'rea-publication-reference-correction-summary/v1',at:new Date().toISOString(),rootVerifierSHA256:sha(fs.readFileSync(path.join(lab,'scripts/verify-records.mjs'))),historicalHostReceipts:verification.named_historical_shared_host_receipts,currentImplementationRowsUpdated:8,originalSources159AndCapabilities232Unchanged:true,appWrites:0,newBehaviorExecutions:0,productBehaviorFailures:0,failedMetadataAttemptsPreserved:5,fullSuite:{pass:847,sources:720,receiptUnchanged:true},scope:'Named historical shared-host evidence stays tied to old server; current host is independently guarded. Eight current registry implementation references are refreshed; original sources/capabilities and completion gates are unchanged. Successful root check is prepublication integrity, not another behavior run.'};fs.writeFileSync(path.join(owned,'summary.json'),JSON.stringify(summary,null,2)+'\n',{flag:'wx'});
function names(root,rel=''){return fs.readdirSync(path.join(root,rel),{withFileTypes:true}).flatMap(e=>{assert.ok(!e.isSymbolicLink());const n=rel?rel+'/'+e.name:e.name;assert.ok(!/[\\:\x00-\x1f]/.test(n)&&n.split('/').every(s=>s&&s!=='.'&&s!=='..'));return e.isDirectory()?names(root,n):[n];}).sort();}
const rows=names(owned).map(n=>{const b=fs.readFileSync(path.join(owned,n));return{path:n,bytes:b.length,sha256:sha(b)};}),mb=Buffer.from(JSON.stringify({schema:'rea-root-publication-corrections-freeze/v1',at:new Date().toISOString(),files:rows.length,records:rows},null,2)+'\n');fs.writeFileSync(path.join(owned,'freeze-manifest.json'),mb,{flag:'wx'});const copies=[];for(const r of [...rows,{path:'freeze-manifest.json',bytes:mb.length,sha256:sha(mb)}]){const b=fs.readFileSync(path.join(owned,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);const n='frozen/'+r.path+'.snapshot',p=path.join(lab,prefix,n);assert.equal(fs.existsSync(p),false);fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,b,{flag:'wx'});copies.push({sourcePath:r.path,path:n,bytes:r.bytes,sha256:r.sha256});}
const map={schema:'rea-frozen-followup-public-subset/v1',at:new Date().toISOString(),sourceStage:'root-publication-reference-corrections-next',originalFrozenArtifacts:rows.length,originalManifest:{sourcePath:'freeze-manifest.json',bytes:mb.length,sha256:sha(mb)},excludedLocalCarriers:[],publicSnapshots:copies.length,allSourceBytesStableBeforeAfter:true,allPublicCopiesExact:true,allSnapshotsInert:true,wholeStagePublic:true,fullProductParity:false,universalSuperiority:false,copies},pb=Buffer.from(JSON.stringify(map,null,2)+'\n');fs.writeFileSync(path.join(lab,prefix,'preservation-manifest.json'),pb,{flag:'wx'});
const milestone=path.join(lab,'products/rea-studio/NOTES-LAYOUT-VALUE-API-MILESTONE.md');fs.appendFileSync(milestone,'\nA separate [publication reference correction record](results/root-publication-reference-corrections-20261013/preservation-manifest.json) preserves five rejected metadata checks and their exact corrections. Backup aggregate/Rabin, Automation recovery/browser, Sync host dependencies and the unaccepted Metrics baseline each retain one old shared-server row through the authenticated3ba snapshot and exact99-byte transition; their other current/historical guards remain explicit. The current server stays mandatory. Eight Notes/Sketch implementation reference byte/SHA fields are refreshed to installed files, while all159original source identities,232capability rows and the847/720behavior receipt remain unchanged. These are integrity corrections; old browser/behavior runs are not rebound to the new host.\n');console.log(JSON.stringify({frozenFiles:rows.length,publicSnapshots:copies.length,preservationSHA256:sha(pb),fullSuiteUnchanged:true}));
