    },
    {
      "id": "grafana.candidate.6d69b698b4c466959598",
      "syntaxRole": "list-item",
      "sourceText": "- Each user who needs to query the data source has the **Monitoring Viewer** role (`roles/monitoring.viewer`) on the target GCP project.",
      "headingPath": [
        "Google authentication",
        "Use Forward OAuth Identity",
        "Prerequisites for Forward OAuth Identity"
