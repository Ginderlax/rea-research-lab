    {
      "id": "grafana.candidate.b20b690539edb85da74d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In the **X field** option, select a numeric field that contains ascending values.",
      "headingPath": [
        "Trend",
        "Configuration options",
        "X axis options"
      ],
      "source": {
