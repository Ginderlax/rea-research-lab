    {
      "id": "grafana.candidate.84551e9806e42842f4dc",
      "syntaxRole": "table-row",
      "sourceText": "| **Data source**           | Defines the target data source. You can select Loki, Elasticsearch, Splunk, OpenSearch, FalconLogScale, Google Cloud Logging, and VictoriaMetrics Logs data sources.                                                                                                                            |",
      "headingPath": [
        "Configure the Zipkin data source",
        "Trace to logs",
        "Trace to logs settings"
      ],
      "source": {
        "path": "docs/sources/datasources/zipkin/configure/index.md",
