    {
      "id": "grafana.candidate.ed056d3a412712d0d20a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The identifier (ID) of a library element is an auto-incrementing numeric value that is unique per Grafana install.",
      "headingPath": [
        "Library Element API",
        "Identifier (id) vs unique identifier (uid)"
      ],
      "source": {
        "path": "docs/sources/developer-resources/api-reference/http-api/api-legacy/library_element.md",
        "gitBlobSha": "930432f547e4f2191000c39dedc3a6ae73fec992",
