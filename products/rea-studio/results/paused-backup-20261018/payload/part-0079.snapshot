    },
    {
      "id": "grafana.candidate.aef4d092170ef1527037",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This feature introduces an account drop-down for selecting one or all of your source accounts and builds a query that targets them. Furthermore, results can be grouped by account ID by selecting **Account ID** in the **Group By** drop-down.",
      "headingPath": [
        "What’s new in Grafana v11.2",
        "Data sources",
        "Cloudwatch Metric Insights cross account observability support"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-2.md",
