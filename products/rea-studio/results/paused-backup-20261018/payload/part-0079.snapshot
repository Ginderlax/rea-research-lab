    {
      "id": "grafana.candidate.7186d0412d6f72c0818c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A table can display sub-tables inside expandable rows. You can add these nested tables using the [Group to nested tables transformation](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/panels-visualizations/query-transform-data/transform-data/#group-to-nested-tables), which groups rows by one or more fields, and can summarize nested row data by applying calculations.",
      "headingPath": [
        "Table",
        "Nested tables"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/table/index.md",
