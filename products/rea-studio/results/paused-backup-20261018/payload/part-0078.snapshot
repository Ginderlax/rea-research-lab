    },
    {
      "id": "grafana.candidate.d186816864ea73a9893c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can also add custom value to the **Data operations**. For example, a function that's not in the drop-down list. This allows you to add any number of parameters.",
      "headingPath": [
        "Macros"
      ],
      "source": {
