    },
    {
      "id": "grafana.candidate.f473babb21e554faa6f1",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Go to **Connections** > **Data sources** and select your Tempo data source.",
      "headingPath": [
        "Configure trace to logs correlation",
        "Configure the Tempo data source"
      ],
      "source": {
        "path": "docs/sources/datasources/tempo/configure-tempo-data-source/configure-trace-to-logs.md",
