import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),sha=b=>createHash('sha256').update(b).digest('hex'),expected='711bd9ec7076661678469e51bae876debac07a08c32f1b1c6b3b8fe5e761c13a';
const urls=['https://phoenixnap.dl.sourceforge.net/project/keepass/KeePass%202.x/2.61.1/KeePass-2.61.1-Source.zip','https://pilotfiber.dl.sourceforge.net/project/keepass/KeePass%202.x/2.61.1/KeePass-2.61.1-Source.zip'];
const attempts=await Promise.all(urls.map(async(url,i)=>{const startedAtUtc=new Date().toISOString(),parts=[];let size=0,response,error=null;try{response=await fetch(url,{signal:AbortSignal.timeout(20000)});for await(const part of response.body){size+=part.length;if(size>8*1024*1024)throw new Error('Response exceeds bound');parts.push(part);}}catch(e){error=e.message;}const data=Buffer.concat(parts),row={name:String(i+3).padStart(2,'0'),url,finalUrl:response?.url,status:response?.status,startedAtUtc,completedAtUtc:new Date().toISOString(),capturedBytes:data.length,sha256:sha(data),deadlineMs:20000,limit:8*1024*1024,error};await fs.writeFile(path.join(here,'.local/acquisition',row.name+'.bin'),data,{flag:'wx'});await fs.writeFile(path.join(here,'.local/acquisition',row.name+'.json'),JSON.stringify(row,null,2)+'\n',{flag:'wx'});return {row,data};}));
const accepted=attempts.find(a=>!a.row.error&&a.row.status===200&&a.row.sha256===expected&&a.data.length===5333853);
await fs.writeFile(path.join(here,'source-acquisition.final.json'),JSON.stringify({schema:'rea-keepass-history-release-source-acquisition/v1',attempts:attempts.map(a=>a.row),priorFailedAcquisitionSha256:sha(await fs.readFile(path.join(here,'source-acquisition.json'))),publisherExpectedSha256:expected,accepted:accepted?.row??null,openPgpVerified:false},null,2)+'\n',{flag:'wx'});
assert.ok(accepted,'Publisher-matched source unavailable; bounded exact failures retained');await fs.writeFile(path.join(here,'.local/KeePass-2.61.1-Source.zip'),accepted.data,{flag:'wx'});console.log(JSON.stringify(accepted.row));
