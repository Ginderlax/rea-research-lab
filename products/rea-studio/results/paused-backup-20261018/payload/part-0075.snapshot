    {
      "id": "grafana.candidate.9a315e31b2dbaac9611d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Azure Monitor Metrics collects numeric data from [supported resources](https://docs.microsoft.com/en-us/azure/azure-monitor/monitor-reference), and you can query them to investigate your resources' health and usage and maximize availability and performance.",
      "headingPath": [
        "Azure Monitor query editor",
        "Query Azure Monitor Metrics"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/query-editor/index.md",
