    {
      "id": "grafana.candidate.8dac686c06b6feb62336",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In v7.0, we introduced a new table panel and inspect mode with Download CSV enabled. However, CSV export to Excel was removed. Due to a large number of inquiries and requests, this [community contribution from tomdaly](https://github.com/grafana/grafana/pull/27284) brought the feature back.",
      "headingPath": [
        "What's new in Grafana v7.3",
        "CSV exports for Excel"
