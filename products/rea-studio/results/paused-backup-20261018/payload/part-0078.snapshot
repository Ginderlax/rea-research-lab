    {
      "id": "grafana.candidate.5273557964ae1b6a6818",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When joining results from the same Prometheus query across different data source instances, you can use this pattern:",
      "headingPath": [
        "SQL expressions",
        "Known limitations",
        "Schema changes and missing data",
        "Example: Handling Prometheus no data"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/sql-expressions/index.md",
        "gitBlobSha": "3e545e4b2f9dfa0e933cbe79b173d05a64036723",
