import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';import {createHash} from 'node:crypto';import {inventory} from './inventory.mjs';import {loadParser} from './parser-loader.mjs';
const original=await loadParser(),ts=new Proxy(original,{get(t,p){if(p==='createSourceFile')return(...args)=>{parseCalls++;return t.createSourceFile(...args);};return t[p];}});let parseCalls=0;const sha=b=>createHash('sha256').update(b).digest('hex');
const parse=s=>inventory(ts,s,{fileName:'owned.d.ts'}),row=(i,name)=>i.declarations.find(r=>r.qualifiedName===name);
test('nested declarations, generic heritage, constructors, events and method overloads retain exact locations',()=>{
 const s=`declare module 'owned' {
 /** API */
 export namespace api {
 /** Generic parent */
 export interface Parent<T> {
 /** value */
 value: T;
 }
 /** Child */
 export class Child<T extends string = 'x'> implements Parent<T> {
 /** event */
 onDidValue: Event<T>;
 /** ctor */
 constructor(value: T);
 /** first */
 run(value: string): T;
 /** second */
 run(value: number): T;
 private secret: string;
 protected helper(): void;
 }
 export interface Event<T> { (listener: (value: T) => unknown): void; }
 }
 }`;
 const i=parse(s),c=row(i,'owned.api.Child');assert.equal(c.typeParameters[0].constraint.text,'string');assert.equal(c.typeParameters[0].default.text,"'x'");assert.deepEqual(c.heritage[0].targetIDs,[row(i,'owned.api.Parent').id]);assert.equal(row(i,'owned.api.Child.onDidValue').isEvent,true);assert.equal(i.overloads.length,1);assert.equal(i.overloads[0].count,2);assert.equal(i.excluded.length,2);assert.equal(row(i,'owned.api.Child.secret'),undefined);for(const r of i.declarations){const b=Buffer.from(s.slice(r.declaration.utf16Start,r.declaration.utf16End));assert.equal(sha(b),r.declaration.sha256);assert.equal(b.length,r.declaration.utf8Length);}assert.equal(c.documented,true);assert.ok(i.declarations.some(r=>r.kind==='function-type-signature'));});
test('UTF16/UTF8 declaration, JSDoc and type parameter spans survive Unicode and CRLF without normalization',()=>{
 const s='/** Ω 🚀 */\r\ndeclare module "u" {\r\n/** λ */\r\nexport interface Ω<T> {\r\n/** 🚀 prop */\r\n"🚀": T;\r\n} }';const i=parse(s),r=row(i,'u.Ω.🚀');assert.equal(r.name,'🚀');assert.equal(r.declaration.utf8Start,Buffer.byteLength(s.slice(0,r.declaration.utf16Start)));assert.equal(r.declaration.utf8End,Buffer.byteLength(s.slice(0,r.declaration.utf16End)));assert.equal(sha(Buffer.from(s.slice(r.documentation[0].span.utf16Start,r.documentation[0].span.utf16End))),r.documentation[0].span.sha256);assert.equal(row(i,'u.Ω').typeParameters[0].name,'T');});
test('accessors, construct/index/call signatures and inline structural members are distinct from overloads',()=>{
 const i=parse('declare module "x" { export class C { get value(): string; set value(v: string); } export interface I { new(v: number): C; (v: string): C; [key: string]: any; } export function f(options: { nested: { ok: boolean }; callback: (v: number) => void }): { result: boolean }; }');assert.equal(i.counts.byKind['get-accessor'],1);assert.equal(i.counts.byKind['set-accessor'],1);assert.equal(i.counts.byKind['construct-signature'],1);assert.equal(i.counts.byKind['index-signature'],1);assert.equal(i.counts.byKind['call-signature'],1);assert.equal(i.overloads.length,0);assert.ok(i.auxiliary.length>=3);assert.ok(i.declarations.some(r=>r.name==='result'));});
test('namespace merging links heritage without duplicating inherited members or treating classes as extra overloads',()=>{
 const i=parse('declare module "x" { export namespace n { export interface A { a: string; } } export namespace n { export interface B extends A { b: number; } } } interface External extends PromiseLike<string> {}');const b=row(i,'x.n.B');assert.equal(b.heritage[0].targetIDs.length,1);assert.equal(i.declarations.filter(r=>r.qualifiedName==='x.n.B.a').length,0);assert.equal(row(i,'External').heritage[0].resolution,'unresolved-external-or-unsupported');assert.equal(i.counts.overloadGroups,0);});
test('parse errors fail extraction and import/re-export forms remain explicitly unresolved',()=>{
 assert.throws(()=>parse('export interface Broken {'),/Syntax diagnostics/);const i=parse('import { Other } from "not-read"; export { Other }; export interface I extends Other {}');assert.equal(i.unsupported.length,2);assert.equal(row(i,'I').heritage[0].targetIDs.length,0);});
test('bounded source refuses before parsing and deep nested syntax is refused with source evidence',()=>{
 const before=parseCalls;assert.throws(()=>parse(Buffer.alloc(2*1024*1024+1,32)),/2MiB/);assert.equal(parseCalls,before);const deep='declare module "x" { export type T = '+('Array<'.repeat(260))+'string'+('>'.repeat(260))+'; }';assert.throws(()=>parse(deep),/AST bound/);});
test('whole pinned API inventory is deterministic and every source/comment span and overload/inheritance target is authenticated',async()=>{
 const input=await fs.readFile(new URL('./source/vscode.d.ts.snapshot',import.meta.url)),s=input.toString(),i=inventory(ts,input,{fileName:'vscode.d.ts',sourceURL:'https://raw.githubusercontent.com/microsoft/vscode/07f806f999227108933c2e30515b26eecc1fda74/src/vscode-dts/vscode.d.ts'}),stored=JSON.parse(await fs.readFile(new URL('./results/api-inventory.json',import.meta.url)));assert.deepEqual(i,stored);const ids=new Set(i.declarations.map(r=>r.id));assert.equal(ids.size,i.declarations.length);for(const r of i.declarations){const spans=[r.declaration,...r.documentation.map(d=>d.span),...r.typeParameters.map(p=>p.span),...(r.parameters??[]).map(p=>p.span)];for(const p of spans){assert.equal(p.utf8Start,Buffer.byteLength(s.slice(0,p.utf16Start)));assert.equal(p.utf8End,Buffer.byteLength(s.slice(0,p.utf16End)));assert.equal(sha(input.subarray(p.utf8Start,p.utf8End)),p.sha256);}for(const h of r.heritage)for(const id of h.targetIDs)assert.ok(ids.has(id));}for(const g of i.overloads)for(const id of g.declarationIDs)assert.ok(ids.has(id));assert.equal(i.unsupported.length,0);assert.equal(row(i,'vscode.TextDocument.lineAt').kind,'method');assert.equal(i.declarations.filter(r=>r.qualifiedName==='vscode.TextDocument.lineAt').length,2);assert.equal(row(i,'Thenable').heritage[0].expression,'PromiseLike');assert.ok(i.counts.eventTypedDeclarations>50);});
test('constructor kind counts cannot inherit Object prototype fields',()=>{const i=parse('declare module "x" { export class C { constructor(x: number); constructor(x: string); } }');assert.equal(i.counts.byKind.constructor,2);assert.ok(Object.values(i.counts.byKind).every(Number.isSafeInteger));assert.equal(Object.values(i.counts.byKind).reduce((a,b)=>a+b,0),i.declarations.length);});
test.after(()=>{console.log('REA_API_DISCOVERY_PARSER '+JSON.stringify({parseCalls,parserModuleProcesses:1,originalProgramExecutions:0,tests:8}));});
