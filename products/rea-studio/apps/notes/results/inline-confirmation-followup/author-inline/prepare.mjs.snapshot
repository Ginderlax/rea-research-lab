import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const root=path.dirname(fileURLToPath(import.meta.url)),workspace=path.resolve(root,'../..'),lab=path.join(workspace,'outputs/rea-research-lab'),hash=b=>createHash('sha256').update(b).digest('hex');
const prior=path.join(workspace,'work/notes-vault-focused-integration-next'),manifestBytes=await fs.readFile(path.join(prior,'freeze-manifest.json')),manifest=JSON.parse(manifestBytes);assert.equal(hash(manifestBytes),'22372f04e114fed639ab036aa44bfae4a3ab1cdb327ef3bc223519541618b451');assert.equal(manifest.files,149);
for(const[p,r]of Object.entries(manifest.inventory)){const b=await fs.readFile(path.join(prior,p));assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);}
const source=JSON.parse(await fs.readFile(path.join(prior,'source-before.json'))),notes=source.filter(r=>r.path.startsWith('products/rea-studio/apps/notes/')&&!r.path.includes('/results/')),shared=source.filter(r=>['products/rea-studio/server.mjs','products/rea-studio/catalog.mjs','products/rea-studio/lib/storage.mjs'].includes(r.path));assert.equal(notes.length,25);assert.equal(shared.length,3);
const original=source.filter(r=>r.path.startsWith('products/rea-studio/apps/notes/results/'));
const save=async(p,b)=>{const target=path.join(root,p);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b,{flag:'wx'});};
for(const r of [...notes,...shared,...original]){const b=await fs.readFile(path.join(lab,r.path));assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);await save('baseline/'+r.path+'.snapshot',b);await save(r.path,b);}
await save('baseline-source28.json',JSON.stringify([...notes,...shared].sort((a,b)=>a.path.localeCompare(b.path)),null,2)+'\n');await save('baseline-original-source31.json',JSON.stringify(original,null,2)+'\n');
for(const n of ['integration-validation.json','completion-audit.json','freeze-manifest.json'])await save('authority/focused138-'+n+'.snapshot',await fs.readFile(path.join(prior,n)));
const refs=await fs.readFile(path.join(workspace,'work/notes-trash-publication-plan-final/references.json'));await save('authority/historical-stage-references.json.snapshot',refs);
await save('preparation.json',JSON.stringify({schema:'rea-notes-inline-confirmation-preparation/v1',at:new Date().toISOString(),baselineSourceFiles:28,unchangedOriginalSourceLedgerAndPayloads:original.length,focused138ManifestSha256:hash(manifestBytes),focused149ArtifactsAuthenticated:true,originalHelperPathsUnchanged:true,productionChanged:false},null,2)+'\n');
console.log(JSON.stringify({baselineSourceFiles:28,originalSourceAndLedgerFiles:original.length,priorFrozenArtifactsAuthenticated:149}));
