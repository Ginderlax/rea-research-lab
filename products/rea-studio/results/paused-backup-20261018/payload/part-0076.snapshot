    },
    {
      "id": "grafana.candidate.744145840145c84cf1e0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Select a query type to return the profile data. Data is shown in the [Flame Graph](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/panels-visualizations/visualizations/flame-graph/), metric data visualized in a graph, or both.",
      "headingPath": [
        "Query profile data",
        "Pyroscope query editor",
        "Query options"
      ],
      "source": {
        "path": "docs/sources/datasources/pyroscope/query-editor/index.md",
        "gitBlobSha": "f610ea6b5c725af436b9ddfad56ce462b258b8f0",
        "sha256": "c2bb15fd3956e70aee467819618adca7470b3f5b2a1f9f22afee217306b82382",
        "lineStart": 124,
        "lineEnd": 124,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/pyroscope/query-editor/index.md#L124-L124"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
