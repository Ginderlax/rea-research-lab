    {
      "id": "grafana.candidate.e66a5c4dc0ce2102806b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Available in [Grafana Enterprise](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/introduction/grafana-enterprise/) and to customers on select Grafana Cloud plans. For pricing information, visit [pricing](https://grafana.com/pricing/) or contact our sales team.",
      "headingPath": [
        "Configure auth proxy authentication",
        "Full walkthrough using Docker.",
        "Team Sync"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/auth-proxy/index.md",
        "gitBlobSha": "9a79b026fbdf94cc528ae47537d1a00d347ad48a",
        "sha256": "fa803a39ed5121a5bc3cd9e90c23855d067d46c7e0ef1fa5d076af5a7b13ba7d",
        "lineStart": 242,
        "lineEnd": 242,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/auth-proxy/index.md#L242-L242"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
