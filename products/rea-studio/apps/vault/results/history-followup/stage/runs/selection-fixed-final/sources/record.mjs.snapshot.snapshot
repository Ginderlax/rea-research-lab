import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import {here,child} from './harness.mjs';
const label=process.argv[2],files=process.argv.slice(3);if(!/^[a-z0-9-]+$/.test(label??'')||!files.length||files.some(f=>!/^[-a-z0-9.]+\.test\.mjs$/.test(f)))throw new Error('Explicit owned label and test files required.');
await fs.mkdir(path.join(here,'runs'),{recursive:true});const folder=path.join(here,'runs',label);await fs.mkdir(folder,{recursive:false});const sourceNames=['history.mjs','server.mjs','kdbx.mjs','xml.mjs','client.mjs','history-oracle.ps1','harness.mjs','prepare-host.mjs','http-runner.mjs','record.mjs',...files,'host/server.mjs','host/catalog.mjs','host/lib/storage.mjs','host/apps/vault/server.mjs','host/apps/vault/client.mjs'];
for(const optional of ['README.md','SOURCE-CONTRACTS.md'])if(await fs.access(path.join(here,optional)).then(()=>true,()=>false))sourceNames.push(optional);
const finalRun=label==='final-history'||label==='selection-fixed-final';const baseline=JSON.parse(await fs.readFile(path.join(here,'baseline-validation.json'))),census=JSON.parse(await fs.readFile(path.join(here,'source-census.final.json')));
if(finalRun)sourceNames.push('baseline-validation.json','contract-map.json','build-contract-map.mjs','source-census.final.json','source-acquisition.final.json','host-source-binding.json',...census.selectedFiles.map(f=>'source/'+f.path));if(label==='selection-fixed-final')sourceNames.push('ui-fixture.mjs','correction-baseline.json','SELECTION-CORRECTION.md','selection-finalize.mjs');
async function external(){const result=[];if(!finalRun)return result;const repo=path.resolve(here,'../../outputs/rea-research-lab');const files=[...baseline.appFiles.map(f=>({...f,absolute:path.join(repo,f.path)})),{path:'products/rea-studio/apps/vault/compatibility-evidence.json',sha256:baseline.oldCompatibilityReceiptSha256,absolute:path.join(repo,'products/rea-studio/apps/vault/compatibility-evidence.json')},{path:'.local/KeePass-2.61.1-Source.zip',sha256:census.archiveSha256,absolute:path.join(here,'.local/KeePass-2.61.1-Source.zip')},{path:'original-release/KeePass.exe',sha256:'04d29636c393f0c1fc99ff739295494be3adefded93271e44591e8e300225a5a',absolute:path.join(repo,'projects/07-keepass/artifacts/portable/KeePass.exe')}];for(const f of files){const bytes=await fs.readFile(f.absolute),actual=createHash('sha256').update(bytes).digest('hex');if(actual!==f.sha256)throw new Error('Preserved external input changed: '+f.path);result.push({path:f.path,bytes:bytes.length,sha256:actual})}for(const f of census.selectedFiles){const bytes=await fs.readFile(path.join(here,'source',f.path));if(bytes.length!==f.bytes||createHash('sha256').update(bytes).digest('hex')!==f.sha256)throw new Error('Release selected source changed: '+f.path)}return result;}
async function capture(snapshot){const source=[];for(const name of [...new Set(sourceNames)].sort()){const bytes=await fs.readFile(path.join(here,name));source.push({path:name,bytes:bytes.length,sha256:createHash('sha256').update(bytes).digest('hex')});if(snapshot){const dest=path.join(folder,'sources',name+'.snapshot');await fs.mkdir(path.dirname(dest),{recursive:true});await fs.writeFile(dest,bytes)}}return source;}
const sourceBefore=await capture(true),externalBefore=await external();await fs.writeFile(path.join(folder,'source-before.json'),JSON.stringify(sourceBefore,null,2));const env={...process.env};delete env.NODE_TEST_CONTEXT;const started=new Date().toISOString();let result,failure;
try{result=await child(process.execPath,['--test','--test-reporter=tap',...files.map(f=>path.join(here,f))],{env,deadline:60000,cap:4*1024*1024})}catch(e){failure=e.message;result=e.observation??{code:null,stdout:'',stderr:String(e)}}
await fs.writeFile(path.join(folder,'stdout.txt'),result.stdout);await fs.writeFile(path.join(folder,'stderr.txt'),result.stderr);const sourceAfter=await capture(false),externalAfter=await external();const stable=JSON.stringify(sourceBefore)===JSON.stringify(sourceAfter)&&JSON.stringify(externalBefore)===JSON.stringify(externalAfter);const readCount=name=>{const m=new RegExp('^# '+name+' (\\d+)$','m').exec(result.stdout);return m?Number(m[1]):null};
const details=[];for(const name of ['history-original','history-http','history-unknown-time']){const file=path.join(here,'.local/observations/'+name+'.json');if(!await fs.access(file).then(()=>true,()=>false))continue;const bytes=await fs.readFile(file);const item=JSON.parse(bytes);const expectedMarker=name==='history-original'?'REA_KEEPASS_HISTORY_ORIGINAL':name==='history-http'?'REA_KEEPASS_HISTORY_HTTP':'REA_KEEPASS_HISTORY_UNKNOWN';if(!result.stdout.includes(expectedMarker))continue;await fs.writeFile(path.join(folder,name+'.json'),bytes);details.push({path:name+'.json',sha256:createHash('sha256').update(bytes).digest('hex'),originalProcessExecutions:item.originalProcessExecutions,hostProcesses:item.httpObservations?.filter(o=>o.event==='host').length??0});}
const receipt={schema:'rea-stage-keepass-history-validation/v1',label,started,completed:new Date().toISOString(),node:process.version,scope:'Stage-only candidate; authenticated original assembly helpers; exact copied shared host with stage adapter; synthetic DOM interaction, not original or browser GUI.',files,sourceBefore,sourceAfter,externalBefore,externalAfter,sourceStable:stable,tests:{tests:readCount('tests'),pass:readCount('pass'),fail:readCount('fail'),skipped:readCount('skipped'),cancelled:readCount('cancelled')},result:{code:result.code,signal:result.signal,sizes:result.sizes,failure},details,originalProcessExecutions:details.reduce((n,d)=>n+d.originalProcessExecutions,0),hostProcesses:details.reduce((n,d)=>n+d.hostProcesses,0),productionChanges:false,originalGuiExecutions:0,originalTouchExecutions:0,fullProductParity:false,securityParity:false,superiority:false};await fs.writeFile(path.join(folder,'validation.json'),JSON.stringify(receipt,null,2));console.log(JSON.stringify({label,tests:receipt.tests,sourceStable:stable,originalProcessExecutions:receipt.originalProcessExecutions,hostProcesses:receipt.hostProcesses,code:result.code}));if(result.code!==0||!stable||receipt.tests.fail!==0||receipt.tests.skipped!==0)process.exitCode=1;
