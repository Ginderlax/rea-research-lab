        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.a5b1cd0009ee064d9674",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now configure Grafana to accept a JWT token provided in the HTTP header.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Grafana OSS features",
        "Authentication updates",
        "Added JWT authentication support"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-0.md",
