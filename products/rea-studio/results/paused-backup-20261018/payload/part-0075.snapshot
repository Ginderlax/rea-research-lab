    },
    {
      "id": "grafana.candidate.2006dd10dec3d5478f4a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Alternatively, you can manually specify a single log group directly in the `FROM` clause:",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Query CloudWatch Logs",
        "Query log groups and Amazon CloudWatch Logs data sources with OpenSearch SQL"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/query-editor/index.md",
