    {
      "id": "grafana.candidate.bd225813d9bae6f6f480",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For backward compatibility, there's an exception to the above rule for queries that return three columns and include a string column named `metric`. Instead of transforming the `metric` column into field labels, it becomes the field name, and then the series name is formatted as the value of the `metric` column. Refer to the example with the `metric` column below.",
      "headingPath": [
        "Microsoft SQL Server query editor",
        "Time series queries",
        "Create a metric query"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/query-editor/index.md",
