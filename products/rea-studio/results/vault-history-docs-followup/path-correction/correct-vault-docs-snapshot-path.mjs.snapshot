import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import {createHash} from 'node:crypto';
const work=import.meta.dirname,out=path.resolve(work,'../outputs/rea-research-lab/products/rea-studio/results/vault-history-docs-followup'),sha=b=>createHash('sha256').update(b).digest('hex'),before=await fs.readFile(path.join(out,'preservation-manifest.json'));
assert.equal(sha(before),'c154da35c52bdefb4498386e53b76dee15c9cb3aad8052b2e24fcd060bb093ca');const record=JSON.parse(before);assert.equal(record.snapshots.length,25);assert.ok(record.previousReadme.path.endsWith('/README.baseline.md.snapshot'));
const correctedPath=record.previousReadme.path+'.snapshot',lab=path.resolve(work,'../outputs/rea-research-lab'),baseline=await fs.readFile(path.join(lab,correctedPath));assert.equal(baseline.length,record.previousReadme.bytes);assert.equal(sha(baseline),record.previousReadme.sha256);
await fs.mkdir(path.join(out,'path-correction'),{recursive:true});
for(const[sourcePath,name,b]of[['root-metadata-correction/previous-preservation-manifest.json','previous-preservation-manifest.json.snapshot',before],['root-metadata-correction/install-vault-history-docs.mjs','install-vault-history-docs.mjs.snapshot',await fs.readFile(path.join(work,'install-vault-history-docs.mjs'))],['root-metadata-correction/failed-verification.stderr.txt','failed-verification.stderr.txt.snapshot',await fs.readFile(path.join(work,'records-vault-docs.stderr.txt'))],['root-metadata-correction/installation.stdout.txt','installation.stdout.txt.snapshot',await fs.readFile(path.join(work,'vault-history-docs-install.stdout.txt'))],['root-metadata-correction/correct-vault-docs-snapshot-path.mjs','correct-vault-docs-snapshot-path.mjs.snapshot',await fs.readFile(import.meta.filename)]]){const p='path-correction/'+name;await fs.writeFile(path.join(out,p),b,{flag:'wx'});record.snapshots.push({sourcePath,path:p,bytes:b.length,sha256:sha(b)});}
record.metadataCorrection={previousPreservationManifestSHA256:sha(before),changedField:'previousReadme.path',previousPath:record.previousReadme.path,correctedPath,sourceOrDocumentationBytesChanged:false,behaviorTestsRerun:false};record.previousReadme.path=correctedPath;
const bytes=JSON.stringify(record,null,2)+'\n';await fs.writeFile(path.join(out,'preservation-manifest.json'),bytes);console.log(JSON.stringify({snapshots:record.snapshots.length,manifestSHA256:sha(Buffer.from(bytes)),sourceOrDocumentationBytesChanged:false,behaviorTestsRerun:false}));
