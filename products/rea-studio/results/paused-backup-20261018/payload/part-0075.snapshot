    {
      "id": "grafana.candidate.b372c4c8fa453eb8c8a6",
      "syntaxRole": "table-row",
      "sourceText": "| **Query Result Timeout** | Grafana polls CloudWatch Logs every second until AWS returns a `Done` status or the timeout is reached. An error is returned if the timeout is exceeded. For alerting, the timeout defined in the Grafana configuration file takes precedence. Enter a valid duration string, such as `30m`, `30s` or `200ms`. The default is `30m`. |",
      "headingPath": [
        "Configure the Amazon CloudWatch data source",
        "Configure the data source in the UI"
      ],
