import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {here,sha,authenticateOriginal} from './authenticate-original.mjs';
const preservation=JSON.parse(await fs.readFile(path.join(here,'preservation.json'))),manifestBytes=await fs.readFile(path.join(here,'memory-preflight.control.json')),manifest=JSON.parse(manifestBytes),authority=await authenticateOriginal();assert.deepEqual(authority,manifest.authority);
for(const row of preservation.copies){const data=await fs.readFile(path.join(here,row.path));assert.equal(data.length,row.bytes);assert.equal(sha(data),row.sha256);assert.equal(sha(await fs.readFile(path.join(row.sourceRoot,row.sourcePath))),row.sha256);}
assert.equal(preservation.wrapperStage.copies.length,87);assert.equal(preservation.latestMixedStudy.copies.length,2218);
for(const row of preservation.adaptations){const original=await fs.readFile(path.join(here,'preserved/process-control-baseline',row.path),'utf8');let expected=original.replaceAll('candidate-algorithm.mjs','candidate-wrapper.mjs');if(row.path==='harness.test.mjs')expected=expected.replace(String.raw`/import \{ singlePercentile, preparePercentileValues \} from '\.\/selector-algorithm\.mjs';/`,String.raw`/import \{ singlePercentile \} from '\.\/selector-algorithm\.mjs';/`);if(row.path==='benchmark.mjs')expected=expected.replace('prospectiveAlgorithmHypothesis:true','prospectiveAlgorithmHypothesis:false,prospectiveWrapperHypothesis:true');assert.equal(sha(original),row.baselineSHA256);assert.equal(sha(expected),row.currentSHA256);assert.equal(await fs.readFile(path.join(here,row.path),'utf8'),expected);}
const old=JSON.parse(await fs.readFile(path.join(here,'preserved/previous-memory-preflight.control.json')));assert.deepEqual(manifest.expectedFiles,old.expectedFiles);assert.deepEqual(manifest.limits,old.limits);assert.equal(manifest.canonicalSourceSHA256,old.canonicalSourceSHA256);assert.equal(manifest.workloadSourceSHA256,old.workloadSourceSHA256);assert.equal(manifest.expectedMetadataSHA256,old.expectedMetadataSHA256);
for(const fixture of Object.values(manifest.expectedFiles)){assert.equal(sha(await fs.readFile(path.join(here,fixture.inputPath))),fixture.inputFileSHA256);assert.equal(sha(await fs.readFile(path.join(here,fixture.path))),fixture.sha256);}
const entry=await fs.readFile(manifest.implementations.candidate.entry,'utf8'),helper=await fs.readFile(path.join(here,'selector-algorithm.mjs'),'utf8'),baseline=await fs.readFile(path.join(here,'candidate-baseline.mjs'),'utf8');assert.equal((entry.match(/^import /gm)??[]).length,1);assert.match(entry,/import \{ singlePercentile \} from '\.\/selector-algorithm\.mjs';/);assert.equal((helper.match(/^import /gm)??[]).length,0);assert.equal((entry.match(/\bimport\s*\(/g)??[]).length,0);assert.equal((helper.match(/\bimport\s*\(/g)??[]).length,0);assert.equal(entry.replace("import { singlePercentile } from './selector-algorithm.mjs';\n",'').replace('    if (!shared) return singlePercentile(id, field, ignore, zero);\n',''),baseline);
for(const binding of Object.values(manifest.implementations))for(const [name,digest]of Object.entries(binding.files))assert.equal(sha(await fs.readFile(name)),digest);assert.equal(sha(await fs.readFile(preservation.productionPath)),preservation.productionSHA256);
const provenance=JSON.parse(await fs.readFile(path.join(here,'original-provenance.json')));assert.equal(provenance.originalCopies.length,6);assert.equal(provenance.archives.length,2);for(const row of provenance.originalCopies){assert.equal(sha(await fs.readFile(row.source)),row.sha256);assert.equal(sha(await fs.readFile(path.join(here,row.path))),row.sha256);}for(const row of provenance.archives)assert.equal(sha(await fs.readFile(row.source)),row.sha256);assert.equal(sha(await fs.readFile(manifest.runtime.execPath)),manifest.runtime.executableSHA256);
const bound=manifest.correctnessProvenanceOnly;assert.equal(bound.inputs,66);assert.equal(bound.notAMeasurementWorkload,true);assert.equal(sha(await fs.readFile(path.join(here,bound.path))),bound.sha256);assert.equal(Object.keys(manifest.expectedFiles).length,7);
const receipt={schema:'rea-metrics-wrapper-readiness-source-audit/v1',checkedAt:new Date().toISOString(),status:'passed',candidateEntrySHA256:manifest.implementations.candidate.files[manifest.implementations.candidate.entry],candidateHelperSHA256:manifest.implementations.candidate.files[path.join(here,'selector-algorithm.mjs')],baselineSHA256:preservation.productionSHA256,fullWrapperStageSnapshots:87,fullLatestMixedStudySnapshots:2218,allCopiedBytesSourceStable:true,exactPreviousSevenSpecsAnd14Files:true,seedsAndMeasuredLoopsUnchanged:true,exactControllerAdaptations:preservation.adaptations,nativeImportGraphExact:true,inverseSubstitutionRestoresBaseline:true,originalLoadedFiles:6,externalArchiveIdentities:2,correctnessOnlyFixtureInputs:66,timingMeasurementRun:false,memoryMeasurementRun:false,profileRun:false};await fs.writeFile(path.join(here,'results/source-binding-audit.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:'passed',snapshots:2305,fixtures:14,originalFiles:6,measurementRun:false}));
