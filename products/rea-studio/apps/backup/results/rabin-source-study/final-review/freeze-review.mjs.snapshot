import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const root=fileURLToPath(new URL('./',import.meta.url)),hash=bytes=>createHash('sha256').update(bytes).digest('hex'),manifest=JSON.parse(await fs.readFile(path.join(root,'baseline-manifest.json'),'utf8'));
async function inventory(folder,prefix=''){const result=[];for(const item of await fs.readdir(folder,{withFileTypes:true})){const name=prefix+item.name;if(item.isDirectory())result.push(...await inventory(path.join(folder,item.name),name+'/'));else{const bytes=await fs.readFile(path.join(folder,item.name));result.push({path:name,bytes:bytes.length,sha256:hash(bytes)});}}return result.sort((a,b)=>a.path.localeCompare(b.path));}
for(const item of manifest.sourceFingerprints)assert.equal(hash(await fs.readFile(path.join(manifest.stage,item.path))),item.sha256);assert.deepEqual(await inventory(path.join(root,'baseline')),manifest.copiedFiles);assert.deepEqual(await inventory(manifest.priorReviewRoot),manifest.priorReviewFingerprints);
const tap=await fs.readFile(path.join(root,'lifecycle.stdout.txt'),'utf8');for(const [label,value]of Object.entries({tests:20,pass:20,fail:0,cancelled:0,skipped:0,todo:0}))assert.match(tap,new RegExp(`^# ${label} ${value}$`,'m'));
const diagnostics=JSON.parse(await fs.readFile(path.join(root,'precommit-deadline-observations.json'),'utf8'));assert.equal(diagnostics.cases.length,3);assert.ok(diagnostics.cases.every(item=>item.allSubsequentIOPrevented&&!item.guardGapReproduced&&item.observedNewOpenAfterExpiry===0&&item.observedNewWriteAfterExpiry===0&&item.observedNewSyncAfterExpiry===0));
const evidence=[];for(const name of ['preserve-baseline.mjs','baseline-manifest.json','lifecycle.test.mjs','lifecycle-observations.json','lifecycle.stdout.txt','lifecycle.stderr.txt','precommit-deadline-probe.mjs','precommit-deadline-observations.json','precommit-deadline.stdout.txt','precommit-deadline.stderr.txt','review-findings.md','freeze-review.mjs']){const bytes=await fs.readFile(path.join(root,name));evidence.push({path:name,bytes:bytes.length,sha256:hash(bytes)});}
const fixtures=[];for(const item of await fs.readdir(root,{withFileTypes:true})){if(item.isDirectory()&&/^(template-|fixture-|guard-template-|guard-fixture-)/.test(item.name)){fixtures.push(...(await inventory(path.join(root,item.name))).map(row=>({...row,path:item.name+'/'+row.path})));}}
const report={schema:'rea-rabin-final-independent-review/v1',completedAtUtc:new Date().toISOString(),runtime:process.version,platform:process.platform,acceptedFiniteSlice:true,sourceFingerprints:manifest.sourceFingerprints,acceptedSourceSetSha256:hash(Buffer.from(JSON.stringify(manifest.sourceFingerprints))),exactBaselineFingerprints:manifest.copiedFiles,reviewFingerprints:evidence,ownedSyntheticFixtureFingerprints:fixtures,sourceBytesStableAcrossRun:true,priorReviewBytesStable:true,priorReviewReceiptSha256:manifest.priorReviewReceiptSha256,priorReviewFiles:manifest.priorReviewFingerprints.length,summary:{lifecycleTests:20,pass:20,fail:0,cancelled:0,skipped:0,todo:0,strictPrecommitDeadlineDiagnostics:3,diagnosticsPassed:3,subsequentIOAfterExpiry:0},productionEdits:false,stageEdits:false,originalOracleRerunInThisBatch:false,fullParity:false,securityCertified:false,performanceSuperiority:false,scope:'Source-bound finite lifecycle acceptance with owned synthetic test-only fault injection. Original/runtime-author oracle evidence remains separately attributed. No force preemption/RSS/transaction/crash-durability proof.'};
const receipt=path.join(root,'review-validation.json');await fs.writeFile(receipt,JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({receipt,sha256:hash(await fs.readFile(receipt)),sourceSetSha256:report.acceptedSourceSetSha256,lifecyclePass:20,diagnosticsPass:3,sourceFiles:manifest.sourceFingerprints.length,baselineFiles:manifest.copiedFiles.length,preservedPriorFiles:manifest.priorReviewFingerprints.length,fixtureFiles:fixtures.length}));
