    {
      "id": "grafana.candidate.5196bf5598178a93dd47",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Text wrapping is in [public preview](https://grafana.com/docs/release-life-cycle/#public-preview), however, it’s available to use by default. We’d love hear from you about how this new feature is working. To provide feedback, you can open an issue in the [Grafana GitHub repository](https://github.com/grafana/grafana).",
      "headingPath": [
        "What’s new in Grafana v11.1",
        "Dashboards and visualizations",
        "Visualization ease of use improvements",
        "Table cell text wrapping"
      ],
