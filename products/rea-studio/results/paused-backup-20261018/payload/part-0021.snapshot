const failed=fs.readFileSync(path.join(work,'cloud-verification-backups/run-38824834990/artifact-12015126323/readable-evidence/source/browser-tests/flow-vault.spec.mjs.snapshot'));assert.deepEqual(before,failed);
assert(!fs.existsSync(stage));for(const kind of ['before','candidate'])fs.mkdirSync(path.dirname(path.join(stage,kind,target)),{recursive:true});fs.writeFileSync(path.join(stage,'before',target),before,{flag:'wx'});
