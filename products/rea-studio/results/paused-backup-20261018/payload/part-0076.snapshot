    {
      "id": "grafana.candidate.fec2ec8db5391e311215",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "During alignment, all data points are received in a fixed interval. Within each interval, as defined by the [alignment period](#define-the-alignment-period), and for each time series, the data is aggregated into a single point. The value of that point is determined by the type of alignment function you use.",
      "headingPath": [
        "Google Cloud Monitoring query editor",
        "Query metrics",
        "Align data",
        "Select an alignment function"
      ],
      "source": {
        "path": "docs/sources/datasources/google-cloud-monitoring/query-editor/index.md",
