    {
      "id": "grafana.candidate.5a2a4e0963ef8ae5b0c2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Because the `repositories` resource has no Editor tier (`repositories:read` is granted to Viewer and above, while `write`, `create`, and `delete` are admin-only), `refs` accepts either of these checks, and viewers satisfy neither.",
      "headingPath": [
        "Git Sync permissions and access control",
        "Configure fine-grained access control (RBAC)",
        "Repository subresource access"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/git-sync/permissions-grafana.md",
