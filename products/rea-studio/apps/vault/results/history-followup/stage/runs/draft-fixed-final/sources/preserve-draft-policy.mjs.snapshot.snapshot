import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
const root=import.meta.dirname,source=path.resolve(root,'../keepass-history-draft-policy-review'),sha=b=>createHash('sha256').update(b).digest('hex'),manifest=await fs.readFile(path.join(source,'review-manifest.json')),receipt=await fs.readFile(path.join(source,'review-validation.json'));assert.equal(sha(manifest),'a36e0aa279f305f5e9e7474ebbc05fa9661d2f27f4934ddd6811428b005dc6a9');assert.equal(sha(receipt),'44ab39664a67b55a01e6937f18ae26afd2ebceb0653fffe089131904905c42cd');const parsed=JSON.parse(manifest),files=parsed.files??parsed.entries;assert.equal(files.length,16);const prefix='preserved-independent/keepass-history-draft-policy-review';for(const e of files){const b=await fs.readFile(path.join(source,e.path));assert.equal(sha(b),e.sha256);assert.equal(b.length,e.bytes);const target=path.join(root,prefix,e.path+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b);}for(const name of ['review-manifest.json','freeze.json'])await fs.copyFile(path.join(source,name),path.join(root,prefix,name+'.snapshot'));await fs.copyFile(path.join(source,'preexisting-draft.test.mjs'),path.join(root,'preexisting-draft.test.mjs'));await fs.writeFile(path.join(root,'draft-policy-preservation.json'),JSON.stringify({schema:'rea-vault-dirty-policy-preservation/v1',prefix,files,manifestSha256:sha(manifest),receiptSha256:sha(receipt),testBodyUnchanged:true},null,2)+'\n');
