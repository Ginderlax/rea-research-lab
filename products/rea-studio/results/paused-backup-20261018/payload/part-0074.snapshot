    {
      "id": "grafana.candidate.e34e5d210fb12ed62e51",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you have created a folder with the name `General` or `general`, you cannot manage its permissions with RBAC.",
