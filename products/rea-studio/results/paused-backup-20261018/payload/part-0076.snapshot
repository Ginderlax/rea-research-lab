        "lineStart": 213,
        "lineEnd": 213,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/elasticsearch/configure/index.md#L213-L213"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
