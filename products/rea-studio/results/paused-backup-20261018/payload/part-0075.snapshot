    },
    {
      "id": "grafana.candidate.34b6ecd1399914f732ed",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can apply label filters, or use `{__name__=~\"regex\"}` to select specific metrics. Then, use `count by (__name__)` to group results per metric name.",
      "headingPath": [
        "Examples of high-cardinality alerts",
        "Detect high-cardinality per metric"
      ],
      "source": {
