    {
      "id": "grafana.candidate.2209ae0bf4658e1781fb",
      "syntaxRole": "list-item",
      "sourceText": "- The Terraform `builtin_role_assignment` resource is deprecated. Please use [grafana_role](https://registry.terraform.io/providers/grafana/grafana/latest/docs/resources/role) resource instead.",
      "headingPath": [
        "Upgrade to Grafana v9.0",
