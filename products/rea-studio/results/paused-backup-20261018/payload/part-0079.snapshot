    {
      "id": "grafana.candidate.616a7f7b98e183090f80",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This topic includes the release notes for Grafana v7.0. For all details, read the full [CHANGELOG.md](https://github.com/grafana/grafana/blob/main/CHANGELOG.md).",
      "headingPath": [
        "What's new in Grafana v7.0"
      ],
      "source": {
