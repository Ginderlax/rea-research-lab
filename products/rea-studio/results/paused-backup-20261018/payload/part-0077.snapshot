    {
      "id": "grafana.candidate.48080f1954f9975078e4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Sign in to Grafana and navigate to **Administration > Authentication > SCIM**. Here you can configure the following settings:",
      "headingPath": [
        "Configure SCIM provisioning",
        "Configure SCIM using the Grafana user interface",
        "Configure SCIM settings"
