    {
      "id": "grafana.candidate.3dea9ea43a14389a496c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Depending on the trace data source you are using, you may see a blue button with the label `Query with <DATA SOURCE NAME>`. In the following example, the tracing data source is Tempo.",
      "headingPath": [
        "Introduction to exemplars",
        "View exemplar data",
        "In Explore"
      ],
