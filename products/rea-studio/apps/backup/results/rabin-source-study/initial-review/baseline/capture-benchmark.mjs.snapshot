import * as fs from 'node:fs/promises';
import os from 'node:os';
import path from 'node:path';
import {performance} from 'node:perf_hooks';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
import {captureRabinFile,READ_BYTES} from './capture-file.mjs';
import {MAX,TOTAL} from './rabin.mjs';
const root=await fs.mkdtemp(path.join(os.tmpdir(),'rea-rabin-measure-')),filename=path.join(root,'exact-cap.bin'),hash=bytes=>createHash('sha256').update(bytes).digest('hex'),samples=[];
try{const handle=await fs.open(filename,'wx'),block=Buffer.alloc(READ_BYTES,0x41);try{for(let count=0;count<TOTAL/READ_BYTES;count++)await handle.writeFile(block);}finally{await handle.close();}samples.push(process.memoryUsage());let emitted=0,largest=0;const begun=performance.now(),result=await captureRabinFile({filename,polynomial:'3da3358b4dc173',saveChunk:bytes=>{emitted++;largest=Math.max(largest,bytes.length);samples.push(process.memoryUsage());return hash(bytes);}});samples.push(process.memoryUsage());assert.equal(result.size,TOTAL);assert.equal(emitted,8);assert.equal(largest,MAX);const report={schema:'rea-rabin-capture-measurement/v1',checkedAtUtc:new Date().toISOString(),fileBytes:TOTAL,chunks:emitted,largestChunkBytes:largest,elapsedMilliseconds:performance.now()-begun,computedMaximumLiveCaptureBuffersBytes:result.maximumLiveCaptureBufferBytes,sampledPeakRssBytes:Math.max(...samples.map(value=>value.rss)),sampledPeakExternalBytes:Math.max(...samples.map(value=>value.external)),samples,samplingBoundary:'Before capture, each blob-sink callback, and after capture. These are process samples, not a guaranteed peak, hard RSS cap, or compression/pack writer allocation measurement.',deadlinePolicy:'Checks between 512 KiB reads, chunk work, stat checks and sink callbacks. A blocked callback/kernel operation is not forcibly preempted.'};await fs.writeFile(new URL('capture-measurement.json',import.meta.url),JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({...report,samples:undefined}));}finally{assert.equal(path.dirname(root),path.resolve(os.tmpdir()));assert.ok(path.basename(root).startsWith('rea-rabin-measure-'));await fs.rm(root,{recursive:true,force:true});}
