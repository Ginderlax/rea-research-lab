        "lineStart": 94,
        "lineEnd": 94,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/_index.md#L94-L94"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.9a616eac03fe1e25215a",
      "syntaxRole": "list-item",
      "sourceText": "- `token_rotation_interval_minutes`: Specifies the rotation interval of the token for active authenticated users.",
      "headingPath": [
        "Configure authentication",
        "Login and short-lived tokens"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/_index.md",
        "gitBlobSha": "4eaeb6c9573c12f36370a29ae5cde9ef8903af26",
        "sha256": "c0d14f6586dd5c3329bd35640260ccf0154fa243faff94f744821a626f330ebe",
        "lineStart": 96,
        "lineEnd": 96,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/_index.md#L96-L96"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.538651d80dd8740f4d1d",
      "syntaxRole": "list-item",
      "sourceText": "- `login_maximum_lifetime_duration`: Specifies for how long a user remains authenticated before being prompted to authenticate again.",
      "headingPath": [
        "Configure authentication",
        "Login and short-lived tokens"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/_index.md",
        "gitBlobSha": "4eaeb6c9573c12f36370a29ae5cde9ef8903af26",
        "sha256": "c0d14f6586dd5c3329bd35640260ccf0154fa243faff94f744821a626f330ebe",
        "lineStart": 97,
        "lineEnd": 97,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/_index.md#L97-L97"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.f861bb8fe2c68ab5a48a",
      "syntaxRole": "list-item",
      "sourceText": "- `login_maximum_inactive_lifetime_duration`: Specifies for how long inactive authenticated users will remain logged in.",
      "headingPath": [
        "Configure authentication",
        "Login and short-lived tokens"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/_index.md",
        "gitBlobSha": "4eaeb6c9573c12f36370a29ae5cde9ef8903af26",
