def unpack(data,directory,entries_limit,raw_limit,file_limit):
 directory.mkdir(parents=True,exist_ok=False);rows=[];seen=set()
 with zipfile.ZipFile(io.BytesIO(data)) as zipped:
  entries=zipped.infolist();need(len(entries)<=entries_limit and sum(x.file_size for x in entries)<=raw_limit,'Fixed ZIP count/raw bound')
  for entry in entries:
   name=entry.filename;normal=name[:-1] if entry.is_dir() else name;safe(normal)
   need(normal.casefold() not in seen,'Unique case-independent ZIP path');seen.add(normal.casefold())
   need(not entry.flag_bits&1 and not stat.S_ISLNK(entry.external_attr>>16) and entry.file_size<=file_limit,'Regular unencrypted bounded member')
   file=(directory/name).resolve();need(file.is_relative_to(directory.resolve()),'Owned recovery path')
   if entry.is_dir(): file.mkdir(parents=True,exist_ok=True);continue
   content=zipped.read(entry);need(len(content)==entry.file_size,'Complete CRC-checked bytes');file.parent.mkdir(parents=True,exist_ok=True)
   with file.open('xb') as stream: stream.write(content)
   need(file.read_bytes()==content,'Readable exact member');rows.append({'path':name,**identity(content)})
