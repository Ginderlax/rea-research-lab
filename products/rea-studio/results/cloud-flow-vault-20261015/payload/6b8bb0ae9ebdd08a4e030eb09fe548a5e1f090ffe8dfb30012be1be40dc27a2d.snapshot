import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab'),backup=path.join(work,'cloud-verification-backups/run-38803745286/artifact-12005836777'),source=path.join(backup,'readable-evidence'),prefix='products/rea-studio/results/cloud-flow-vault-20261015',target=path.join(lab,prefix),sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)});
const v=JSON.parse(await fs.readFile(path.join(backup,'local-backup-verification.json')));assert.equal(v.allCRCAndBytesReadable,true);assert.equal(v.currentProductAcceptance,true);assert.equal(v.attempt.repositoryCommit,'14e4859476be80a49f2e79bc6ab91dc23c355b4c');assert.equal(v.attempt.summary.pass,282);assert.equal(v.attempt.sourceFiles,762);assert.equal(v.sourceSnapshotsVerified,340);assert.equal(await fs.stat(target).then(()=>true,()=>false),false);
await fs.mkdir(path.join(target,'payload'),{recursive:true});const records=[],objects=new Set();async function save(name,b){assert(!name.startsWith('/')&&!name.includes('\\')&&name.split('/').every(s=>s&&s!=='.'&&s!=='..'));const key=sha(b),p='payload/'+key+'.snapshot';if(!objects.has(key)){await fs.writeFile(path.join(target,p),b,{flag:'wx'});objects.add(key);}records.push({sourcePath:name,path:p,...id(b)});}
async function walk(p=''){for(const e of(await fs.readdir(path.join(source,p),{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){assert(!e.isSymbolicLink());const n=p?p+'/'+e.name:e.name;if(e.isDirectory())await walk(n);else{assert(e.isFile());await save(n,await fs.readFile(path.join(source,n)));}}}await walk();await save('local-backup-verification.json',await fs.readFile(path.join(backup,'local-backup-verification.json')));await save('preservation-collector.mjs',await fs.readFile(import.meta.filename));
const receipt={schema:'rea-cloud-flow-vault-finite-preservation/v1',at:new Date().toISOString(),sourceCommit:v.attempt.repositoryCommit,runURL:'https://github.com/Ginderlax/rea-research-lab/actions/runs/38803745286',runId:38803745286,runAttempt:1,artifactId:12005836777,artifactSHA256:v.artifactSHA256,execution:'Verified standard GitHub-hosted windows-2022; original and candidate tests executed there.',summary:v.attempt.summary,sourceFiles:762,sourceStable:true,activeSourceSnapshots:340,sourceSnapshotsScope:'Active eligible runtime, tests and helpers outside historical results; full eligible census hash inventories retained.',records,uniqueInertObjects:objects.size,localBackupVerified:true,localProductExecutions:0,localBuilds:0,localTests:0,fullDevelopmentSuiteAcceptance:false,fullParity:false,superiority:false,historical937ReceiptRebound:false};await fs.writeFile(path.join(target,'preservation-manifest.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
const sp=path.join(lab,'products/rea-studio/STATUS.json'),s=JSON.parse(await fs.readFile(sp));assert.equal(s.current_verification.status,'pending');s.current_verification.status='finite-flow-vault-passed-full-suite-pending';s.current_verification.cloudRunId=38803745286;s.current_verification.cloudRunURL=receipt.runURL;s.current_verification.localBackupStatus='Actual ZIP and readable files downloaded, artifact digest/TAP summary/340 snapshots verified locally; no local product tests executed.';s.finite_flow_vault_verification={record:'results/cloud-flow-vault-20261015/preservation-manifest.json',sourceCommit:receipt.sourceCommit,pass:282,fail:0,skipped:0,cancelled:0,todo:0,wholeEligibleSourceCensus:762,activeSnapshots:340,fullDevelopmentSuiteAcceptance:false,allProductsComplete:false};s.current_verification.fullSuiteBlocker='Hosted Windows tar.exe has a different SHA from the historical Archive oracle; further original prerequisites remain to be provisioned and qualified.';await fs.writeFile(sp,JSON.stringify(s,null,2)+'\n');
for(const [p,base]of[['README.md','products/rea-studio/'],['products/rea-studio/README.md','']])await fs.appendFile(path.join(lab,p),`\nThe [hosted Flow/Vault recovery run](${base}results/cloud-flow-vault-20261015/preservation-manifest.json) passes **282/282 finite contract checks with zero skips** on recorded revision14e4859. Its762-file census remained exact;340 active source snapshots, raw logs and readable local backups are preserved. This is separate from the still-pending full ten-application suite.\n`);
