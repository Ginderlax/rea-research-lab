    },
    {
      "id": "grafana.candidate.8774738b72da1ce77f21",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use this transformation to convert time series results into a table, transforming a time series data frame into a **Trend** field which can then be used with the [sparkline cell type][]. If there are multiple time series queries, each will result in a separate table data frame. These can be joined using join or merge transforms to produce a single table with multiple sparklines per row.",
      "headingPath": [
        "Transform data",
        "Transformation functions",
        "Time series to table transform"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/transform-data/index.md",
        "gitBlobSha": "9cd072609170b1783ea50740845dd11e18b0fede",
        "sha256": "73ae12b953aaf13c6df7b5a072cc18677d57c977343a108001752487a81b2800",
        "lineStart": 1472,
        "lineEnd": 1472,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/panels-visualizations/query-transform-data/transform-data/index.md#L1472-L1472"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.47a146219c23ef449d4f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For each generated **Trend** field value, a calculation function can be selected. This value is displayed next to the sparkline and will be used for sorting table rows.",
      "headingPath": [
        "Transform data",
        "Transformation functions",
        "Time series to table transform"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/transform-data/index.md",
        "gitBlobSha": "9cd072609170b1783ea50740845dd11e18b0fede",
