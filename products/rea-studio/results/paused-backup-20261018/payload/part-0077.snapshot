    {
      "id": "grafana.candidate.09e91e9eb4945cbd4256",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Optional. This is mirroring the old configuration option, which will be deprecated. If `rudderstack_sdk_url` and `rudderstack_v3_sdk_url` are both set, the v3 SDK is loaded.",
      "headingPath": [
