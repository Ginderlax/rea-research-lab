    {
      "id": "grafana.candidate.d43299d5eab38ac5d114",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This is equivalent to the **Today so far** time range preset, but it starts at 8:00am instead of 12:00am by appending +8h to the periodic start time.",
      "headingPath": [
        "Use dashboards",
        "Set dashboard time range",
        "Common time range controls",
        "Semi-relative time range"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/use-dashboards/index.md",
