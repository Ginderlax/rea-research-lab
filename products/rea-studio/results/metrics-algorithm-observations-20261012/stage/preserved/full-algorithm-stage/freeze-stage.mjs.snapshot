import fs from 'node:fs/promises';
import path from 'node:path';
import assert from 'node:assert/strict';
import {here,sha,authenticateOriginal} from './authenticate-original.mjs';
const production=path.resolve(here,'../../outputs/rea-research-lab/products/rea-studio/apps/metrics/native-calculations.mjs');
async function checkRows(root,rows){let bytes=0;const entries=Array.isArray(rows)?rows.map(row=>[row.path,row]):Object.entries(rows);for(const[name,row]of entries){const target=path.resolve(root,name);assert.ok(target.startsWith(path.resolve(root)+path.sep),'Inventory path outside root');const data=await fs.readFile(target);assert.equal(data.length,row.bytes,name);assert.equal(sha(data),row.sha256,name);bytes+=data.length;}return {files:entries.length,bytes};}
if(process.argv.includes('--verify-only')){const receipt=JSON.parse(await fs.readFile(path.join(here,'stage-validation.json'))),manifest=JSON.parse(await fs.readFile(path.join(here,'freeze-manifest.json')));assert.equal(sha(await fs.readFile(path.join(here,'stage-validation.json'))),manifest.receiptSHA256);const checked=await checkRows(here,manifest.inventory);assert.equal(sha(await fs.readFile(production)),receipt.productionSHA256);console.log(JSON.stringify({status:'passed',...checked,receiptSHA256:manifest.receiptSHA256,manifestSHA256:sha(await fs.readFile(path.join(here,'freeze-manifest.json')))}));process.exit(0);}
const authority=await authenticateOriginal(),productionSHA256=sha(await fs.readFile(production));assert.equal(productionSHA256,'9269cf8c32be9bf2c075b67019e82e41272d9495f0321fefc17b2c5695a91371');
const preparation=JSON.parse(await fs.readFile(path.join(here,'preservation.json')));for(const[name,row]of Object.entries(preparation.copied)){const bytes=await fs.readFile(path.join(here,name));assert.equal(sha(bytes),row.sha256,name);assert.equal(sha(await fs.readFile(row.source)),row.sha256,'Older source changed: '+name);}
const olderReview=path.resolve(here,'../metrics-selector-measurement-review-next'),oldManifestBytes=await fs.readFile(path.join(olderReview,'freeze-manifest.json'));assert.equal(sha(oldManifestBytes),'3d23bbf39d41151f0edf341717d7f4fdf29f3acbd0b72d5f39d898a969a34349');const olderReviewVerified=await checkRows(olderReview,JSON.parse(oldManifestBytes).entries);
const oldStudy=JSON.parse(await fs.readFile(path.join(olderReview,'study-preservation.json'))),olderMeasuredStudyVerified=await checkRows(path.resolve(here,'../metrics-selector-measurement-next'),oldStudy.sourceInventory);
const result=async name=>JSON.parse(await fs.readFile(path.join(here,'results',name+'.json'))),full=await result('candidate-algorithm'),selection=await result('candidate-algorithm-selection-heldout'),standard=await result('candidate-algorithm-standard-heldout'),controls=await result('algorithm-controls'),budget=await result('algorithm-budget');
assert.equal(full.status,'passed');assert.equal(full.comparisons,2910751);assert.equal(full.cacheComparisons,48240);assert.equal(full.standardHelperComparisons,14240);assert.equal(selection.failureCount,0);assert.equal(selection.comparisons,3888);assert.equal(selection.registryComparisons,864);assert.equal(standard.status,'passed');assert.equal(controls.status,'passed');assert.equal(controls.comparisons,9984);assert.equal(budget.status,'passed');assert.equal(budget.originalSelections,462);assert.equal(budget.reducedBudgetChecks,3444);assert.equal(budget.refusedBudgetChecks,2662);assert.equal(budget.fixedComparisons,14);
const attempts=(await fs.readdir(path.join(here,'results'))).filter(name=>/^acceptance-attempt-\d+\.json$/.test(name)),attemptRecords=[];for(const name of attempts){const record=await result(name.slice(0,-5));assert.deepEqual(record.sourcesBefore,record.sourcesAfter);for(const[source,hash]of Object.entries(record.sourcesBefore))assert.equal(sha(await fs.readFile(path.join(here,source))),hash,source);attemptRecords.push({path:'results/'+name,sha256:sha(await fs.readFile(path.join(here,'results',name))),status:record.status,steps:record.steps});}
assert.equal(attemptRecords.length,1);assert.equal(attemptRecords[0].status,'passed');const contract=JSON.parse(await fs.readFile(path.join(here,'candidate-contract.json')));assert.equal(sha(await fs.readFile(path.join(here,'candidate-algorithm.mjs'))),contract.entrySHA256);assert.equal(sha(await fs.readFile(path.join(here,'selector-algorithm.mjs'))),contract.helperSHA256);
const fixture=JSON.parse(await fs.readFile(path.join(here,'fixture-preservation.json')));assert.equal(fixture.status,'passed');assert.equal(sha(await fs.readFile(path.join(here,fixture.fixture.path))),fixture.fixture.sha256);assert.equal(sha(await fs.readFile(path.join(here,'fixtures/selector-heldout.graph.jsonl'))),'211b89c96ec2b286b8c60e7b82861d48a940ef07e58a91c2677b9ae98834a741');
const receipt={schemaVersion:1,checkedAt:new Date().toISOString(),status:'source-stable finite correctness acceptance passed; unmeasured candidate not selected',productionSHA256,entrySHA256:contract.entrySHA256,helperSHA256:contract.helperSHA256,authority,contract,attemptRecords,counts:{fullReducers:full.comparisons,cacheIncluded:full.cacheComparisons,standardHelper:full.standardHelperComparisons,heldoutReducers:selection.comparisons,heldoutRegistry:selection.registryComparisons,standardHeldoutReducers:standard.reducerComparisons,standardHeldoutHelper:standard.helperComparisons,mutation:standard.mutationComparisons,exact42Controls:controls.comparisons,newInputs:budget.inputs,newOriginalSelections:budget.originalSelections,newDefaultSelections:budget.defaultSelections,reducedBudgetChecks:budget.reducedBudgetChecks,budgetRefusals:budget.refusedBudgetChecks,deterministicPivots:budget.deterministicPivots,fixedSevenComparisons:budget.fixedComparisons},olderReviewVerified,olderMeasuredStudyVerified,fixture,failuresPreserved:[{path:'results/freeze-attempt-1791845208669.json',classification:'Freeze metadata reader incorrectly used inventory instead of entries in the older manifest.'},{path:'results/freeze-attempt-1791845248697.json',classification:'Freeze metadata reader then assumed entries was a keyed map rather than path-bearing array rows.'}],noFailedAcceptanceAttempt:true,timingMeasurementRun:false,memoryMeasurementRun:false,profileRun:false,selectedForIntegration:null,performanceParityEstablished:false,fullProductComplete:false,universalCorrectnessEstablished:false,universalSuperiorityEstablished:false,scope:'Separate prospective algorithm correctness only. Original finite evidence and explicit bounds/alias checks, no new performance measurement or production integration.'};
const receiptBytes=JSON.stringify(receipt,null,2)+'\n';await fs.writeFile(path.join(here,'stage-validation.json'),receiptBytes,{flag:'wx'});
const inventory={};async function walk(directory,prefix=''){for(const row of await fs.readdir(directory,{withFileTypes:true})){const name=prefix+row.name;if(name==='freeze-manifest.json')continue;assert.ok(!row.isSymbolicLink());if(row.isDirectory())await walk(path.join(directory,row.name),name+'/');else{const bytes=await fs.readFile(path.join(directory,row.name));inventory[name]={bytes:bytes.length,sha256:sha(bytes)};}}}await walk(here);
const manifestBytes=JSON.stringify({schemaVersion:1,frozenAt:new Date().toISOString(),receiptSHA256:sha(receiptBytes),files:Object.keys(inventory).length,aggregateBytes:Object.values(inventory).reduce((sum,row)=>sum+row.bytes,0),inventory,excludes:['freeze-manifest.json'],timingMeasurementRun:false,memoryMeasurementRun:false,productionChanges:false},null,2)+'\n';await fs.writeFile(path.join(here,'freeze-manifest.json'),manifestBytes,{flag:'wx'});console.log(JSON.stringify({status:'frozen',receiptSHA256:sha(receiptBytes),manifestSHA256:sha(manifestBytes),files:Object.keys(inventory).length,olderReviewVerified,olderMeasuredStudyVerified,counts:receipt.counts}));
