    },
    {
      "id": "grafana.candidate.59cbbae82148455a79d1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The API can be used to create, update, delete, get, and list SSO Settings for OAuth2 and SAML.",
      "headingPath": [
        "SSO Settings API"
      ],
      "source": {
        "path": "docs/sources/developer-resources/api-reference/http-api/api-legacy/sso-settings.md",
        "gitBlobSha": "cbf19bd0019654b1220207fd1324d0a38c8828d8",
        "sha256": "116eddf48e12c4275f927314317344968174fe963226bdb30e28df22329d328d",
        "lineStart": 30,
        "lineEnd": 30,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/developer-resources/api-reference/http-api/api-legacy/sso-settings.md#L30-L30"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss",
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.45019cf1b5bd38a2aca7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The settings managed by this API are stored in the database and override [settings from other sources](/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-access/configure-authentication/) (arguments, environment variables, settings file, etc). Therefore, every time settings for a specific provider are removed or reset to the default settings at runtime, the settings are inherited from the other sources in the reverse order of precedence (`arguments > environment variables > settings file`).",
      "headingPath": [
        "SSO Settings API"
      ],
      "source": {
        "path": "docs/sources/developer-resources/api-reference/http-api/api-legacy/sso-settings.md",
        "gitBlobSha": "cbf19bd0019654b1220207fd1324d0a38c8828d8",
        "sha256": "116eddf48e12c4275f927314317344968174fe963226bdb30e28df22329d328d",
        "lineStart": 32,
        "lineEnd": 37,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/developer-resources/api-reference/http-api/api-legacy/sso-settings.md#L32-L37"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss",
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.486d9db712f9d4c4c27b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The providers or SSO keys that are not managed by this API are retrieved from the other sources (settings file, environment variables, default values).",
      "headingPath": [
        "SSO Settings API",
        "List SSO Settings"
      ],
      "source": {
        "path": "docs/sources/developer-resources/api-reference/http-api/api-legacy/sso-settings.md",
