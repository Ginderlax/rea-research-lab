    {
      "id": "grafana.candidate.395d48a0d63eeeeee2ab",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To avoid these types of false positives during low-traffic periods, you can include a **minimum traffic condition** in your alert rule queries. For example:",
      "headingPath": [
        "Examples of trace-based alerts",
        "Alerting on span metrics",
        "Enable traffic guardrails"
      ],
