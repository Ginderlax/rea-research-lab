    {
      "id": "grafana.candidate.b2b252daf2c5e5209cfb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "With this release, we've updated the canvas visualization to include much-requested flowcharting features. These improvements are:",
