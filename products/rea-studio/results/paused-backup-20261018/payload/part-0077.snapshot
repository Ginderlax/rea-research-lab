    {
      "id": "grafana.candidate.98640fba224f69ea8e6c",
      "syntaxRole": "list-item",
      "sourceText": "- Grafana version with build number",
      "headingPath": [
        "Configure custom branding"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/configure-custom-branding/index.md",
