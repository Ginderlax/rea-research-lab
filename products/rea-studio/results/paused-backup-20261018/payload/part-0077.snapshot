    {
      "id": "grafana.candidate.e996d50883159266d8aa",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When `rendering_mode = clustered`, you can define the maximum number of browser instances or incognito pages that can execute concurrently. Default is `5`.",
