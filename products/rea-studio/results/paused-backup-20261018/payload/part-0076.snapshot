    {
      "id": "grafana.candidate.47e6b5791d11ae90bd8c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**InfluxQL:** Select an InfluxDB data source in the query editor. Under the **Select measurement field** next to the **FROM** section, choose a measurement containing your log data, then choose the appropriate fields that display the log message. Add any additional filters by clicking the **+ sign** next to the **WHERE** field. Set **FORMAT AS** to **Logs**.",
      "headingPath": [
