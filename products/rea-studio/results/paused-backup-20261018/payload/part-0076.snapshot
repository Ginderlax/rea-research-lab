    {
      "id": "grafana.candidate.b8078efc485734aef859",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Error message:** Unexpected syntax errors or truncated results when string values contain `--` (double dash).",
      "headingPath": [
        "Troubleshoot PostgreSQL data source issues",
        "Query errors",
        "Query truncated by double-dash in string literals"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/troubleshooting/index.md",
        "gitBlobSha": "9e7c47bbc73ee4cbaf10551ba67b0d3574dd4690",
        "sha256": "50dbbd3a22180c1579b10bdecbe6b70c677128202f8e45231104a07fac3a52e0",
        "lineStart": 231,
        "lineEnd": 231,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/troubleshooting/index.md#L231-L231"
      },
      "applicability": {
