/** Source-assisted, newly written compatibility implementation. No original runtime imports.
 * See GRAFANA-CALCULATIONS.md and fixtures/reducers/sources.json for the pinned contract. */
export const NullValueMode = Object.freeze({ Null: 'null', Ignore: 'connected', AsZero: 'null as zero' });
const rows = [
  ['lastNotNull', 'Last *', 'Last non-null value (also excludes NaNs)', true, true, 'current'],
  ['last', 'Last', 'Last value', true, true],
  ['firstNotNull', 'First *', 'First non-null value (also excludes NaNs)', true, true],
  ['first', 'First', 'First Value', true, true],
  ['min', 'Min', 'Minimum Value', true, true],
  ['max', 'Max', 'Maximum Value', true, true],
  ['mean', 'Mean', 'Average Value', true, true, 'avg'],
  ['median', 'Median', 'Median Value', false, true, 'median'],
  ['variance', 'Variance', 'Variance of all values in a field', false, true],
  ['stdDev', 'StdDev', 'Standard deviation of all values in a field', false, true],
  ['sum', 'Total', 'The sum of all values', true, true, 'total', 0],
  ['count', 'Count', 'Number of values in response', true, false, undefined, 0],
  ['countAll', 'Count all', 'Number of values (including empty)', false, false, undefined, 0],
  ['range', 'Range', 'Difference between minimum and maximum values', true, true],
  ['delta', 'Delta', 'Cumulative change in value', true, true],
  ['step', 'Step', 'Minimum interval between values', true, true],
  ['diff', 'Difference', 'Difference between first and last values', true, true],
  ['logmin', 'Min (above zero)', 'Used for log min scale', true, true],
  ['allIsZero', 'All Zeros', 'All values are zero', true, true, undefined, false],
  ['allIsNull', 'All Nulls', 'All values are null', true, false, undefined, true],
  ['changeCount', 'Change Count', 'Number of times the value changes', false, false],
  ['distinctCount', 'Distinct Count', 'Number of distinct values', false, false],
  ['diffperc', 'Difference percent', 'Percentage difference between first and last values', true, false],
  ['allValues', 'All values', 'Returns an array with all values', false, false],
  ['uniqueValues', 'All unique values', 'Returns an array with all unique values', false, false],
];
const ordinal = value => value > 3 && value < 21 ? 'th' : ['th', 'st', 'nd', 'rd'][value % 10] ?? 'th';
export const calculationDefinitions = Object.freeze([
  ...rows.map(([id, name, description, standard, preservesUnits, alias, empty], index) => Object.freeze({ id, name, description, standard, preservesUnits, ...(alias ? { aliasIds: [alias] } : {}), ...(rows[index].length === 7 ? { emptyInputResult: empty } : {}) })),
  ...Array.from({ length: 99 }, (_, index) => { const p = index + 1; return Object.freeze({ id: `p${p}`, name: `${p}${ordinal(p)} %`, description: `${p}${ordinal(p)} percentile value`, standard: false, preservesUnits: true }); }),
]);
const definitions = new Map();
for (const definition of calculationDefinitions) { definitions.set(definition.id, definition); for (const alias of definition.aliasIds ?? []) if (!definitions.has(alias)) definitions.set(alias, definition); }
const enumOrder = ['sum', 'max', 'min', 'logmin', 'mean', 'variance', 'stdDev', 'last', 'median', 'first', 'count', 'countAll', 'range', 'diff', 'diffperc', 'delta', 'step', 'firstNotNull', 'lastNotNull', 'changeCount', 'distinctCount', 'allIsZero', 'allIsNull', 'allValues', 'uniqueValues', ...Array.from({ length: 99 }, (_, index) => `p${index + 1}`)];
export const ReducerID = Object.freeze(Object.fromEntries(enumOrder.map(id => [id, id])));
export function isReducerID(id) { return typeof id === 'string' && Object.hasOwn(ReducerID, id); }
export function getFieldTypeForReducer(id, fallback) { return ['count', 'countAll', 'distinctCount', 'changeCount'].includes(id) ? 'number' : ['allIsNull', 'allIsZero'].includes(id) ? 'boolean' : fallback; }
export const defaultCalcs = Object.freeze({ sum: 0, max: -Number.MAX_VALUE, min: Number.MAX_VALUE, logmin: Number.MAX_VALUE, mean: null, last: null, first: null, lastNotNull: null, firstNotNull: null, count: 0, nonNullCount: 0, allIsNull: true, allIsZero: true, range: null, diff: null, delta: 0, step: Number.MAX_VALUE, diffperc: 0, previousDeltaUp: true });
const numericField = field => field.type === 'number' || field.type === 'time';
const isNumber = value => typeof value === 'number' || Object.prototype.toString.call(value) === '[object Number]';

export function doStandardCalcs(field, ignoreNulls, nullAsZero) {
