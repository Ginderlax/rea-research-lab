    },
    {
      "id": "grafana.candidate.ab8bbe781d3d8250e3de",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Click **Save & test**.",
      "headingPath": [
        "Data source management",
        "Provisioned data sources",
        "Create an editable copy of a provisioned data source"
      ],
      "source": {
        "path": "docs/sources/administration/data-source-management/_index.md",
        "gitBlobSha": "48e0cd06582ded6e67389dc4fe82510ea7271f7b",
        "sha256": "087e0c6f2fdd1b21672ed0be96bcf714c87e35ca1887c2f4bb4382f0c4b4bdad",
        "lineStart": 98,
        "lineEnd": 98,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/data-source-management/_index.md#L98-L98"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "enterprise",
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
