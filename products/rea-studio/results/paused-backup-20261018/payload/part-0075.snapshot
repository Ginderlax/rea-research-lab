        "lineEnd": 42,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/examples/trace-based-alerts.md#L42-L42"
      },
      "applicability": {
