        "lineStart": 93,
        "lineEnd": 93,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/panels-visualizations/query-transform-data/expression-queries/index.md#L93-L93"
      },
      "applicability": {
