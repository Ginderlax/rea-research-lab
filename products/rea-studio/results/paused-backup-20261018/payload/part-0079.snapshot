    {
      "id": "grafana.candidate.82d7fc3b6efadd4b66af",
      "syntaxRole": "table-row",
      "sourceText": "| Color | Configures the color of the markers. The default `Fixed color` sets all markers to a specific color. There is also an option to have conditional colors depending on the selected field data point values and the color scheme set in the `Standard options` section. |",
      "headingPath": [
        "Geomap",
        "Configuration options",
        "Map layers options",
        "Markers layer"
      ],
