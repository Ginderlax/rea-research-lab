    {
      "id": "grafana.candidate.1b4c8ae151a5752068f0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana interprets query string parameters prefixed with `var-` as variables in the given dashboard.",
      "headingPath": [
        "Dashboard URL variables",
        "Variables as query parameters"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/build-dashboards/create-dashboard-url-variables/index.md",
        "gitBlobSha": "24aff38ae5ef68283008fce248d7fe7b5e3eaeae",
