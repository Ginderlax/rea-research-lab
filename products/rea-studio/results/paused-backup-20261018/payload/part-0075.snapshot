    {
      "id": "grafana.candidate.1904048f459f78cea9eb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you upgrade to Grafana 11.6.0, a migration is performed on the `alert_rule_versions` table. If you experience a 11.6.0 upgrade that causes a migration failure, then your `alert_rule_versions` table has too many rows. To fix this, you need to truncated the `alert_rule_versions` table for the migration to complete.",
      "headingPath": [
        "Performance considerations and limitations",
        "Alert rule migrations for Grafana 11.6.0"
      ],
      "source": {
        "path": "docs/sources/alerting/set-up/performance-limitations/index.md",
        "gitBlobSha": "c46bdb78fe635ffd74e357d5adc97e867aca5f91",
