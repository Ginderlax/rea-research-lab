    {
      "id": "grafana.candidate.c188a1852df1d2f82afa",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For even more detail about all the changes in this release, refer to the [changelog](https://github.com/grafana/grafana/blob/main/CHANGELOG.md). For the specific steps we recommend when you upgrade to v10.2, check out our [Upgrade Guide](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/upgrade-guide/upgrade-v10.2/).",
      "headingPath": [
        "What’s new in Grafana v10.2"
      ],
