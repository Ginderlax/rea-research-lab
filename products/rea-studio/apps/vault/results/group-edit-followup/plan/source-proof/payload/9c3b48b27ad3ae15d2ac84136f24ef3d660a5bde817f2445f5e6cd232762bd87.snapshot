      },
      "occurrences": 1
    },
    {
      "label": "Keep normal list reads unchanged; only the acknowledged mutation path supplies the loaded value",
      "before": "const request=++groupGeneration,value=await api('recycleGroupList',{bin});",
      "after": "const request=++groupGeneration,value=loaded??await api('recycleGroupList',{bin});",
      "beforeIdentity": {
        "bytes": 29821,
        "sha256": "7863c771c37013d744863472f58104388aaea7bf08710a90ffc30d9505eb76f2"
