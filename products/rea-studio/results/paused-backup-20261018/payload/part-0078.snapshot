        "lineStart": 74,
        "lineEnd": 75,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/shared/datasources/tempo-search-traceql.md#L74-L75"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
