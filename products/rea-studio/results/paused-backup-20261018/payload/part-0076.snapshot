        "lineStart": 186,
        "lineEnd": 186,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/mssql/configure/index.md#L186-L186"
      },
      "applicability": {
