    {
      "id": "grafana.candidate.279d795145c83fced035",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Many Git providers support `CODEOWNERS` files that automatically assign reviewers to pull requests based on which files are changed. When Git Sync creates a pull request, the Git provider can use the `CODEOWNERS` file to assign the appropriate team or users for review.",
      "headingPath": [
        "Configure Git repository protection",
        "Code review assignments"
      ],
