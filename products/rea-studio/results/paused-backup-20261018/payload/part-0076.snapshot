          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.881cc5bedd4f90176c2c",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Optionally set **Value Field** and **Text Field** to control which columns map to the variable value and display label.",
      "headingPath": [
        "PostgreSQL template variables",
        "Query variable"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/template-variables/index.md",
        "gitBlobSha": "e6e64d6c3ed9d36f0d02cd77e1fe05e47046e60a",
        "sha256": "bb19076da8c2b9241d06f526cf27f5585c6d69fb5d74dff31d957443108ed5df",
        "lineStart": 47,
        "lineEnd": 47,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/template-variables/index.md#L47-L47"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c0cf14232d851b9e4148",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For example, the following query returns all values from the `hostname` column:",
      "headingPath": [
        "PostgreSQL template variables",
        "Query variable"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/template-variables/index.md",
        "gitBlobSha": "e6e64d6c3ed9d36f0d02cd77e1fe05e47046e60a",
        "sha256": "bb19076da8c2b9241d06f526cf27f5585c6d69fb5d74dff31d957443108ed5df",
        "lineStart": 49,
        "lineEnd": 49,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/template-variables/index.md#L49-L49"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.a90b23ae95635aef292f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A query can return multiple columns, and Grafana automatically generates a list using the values from those columns. For example, the following query returns values from both the `hostname` and `hostname2` columns, which are included in the variable's drop-down list.",
      "headingPath": [
        "PostgreSQL template variables",
        "Query variable"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/template-variables/index.md",
        "gitBlobSha": "e6e64d6c3ed9d36f0d02cd77e1fe05e47046e60a",
        "sha256": "bb19076da8c2b9241d06f526cf27f5585c6d69fb5d74dff31d957443108ed5df",
        "lineStart": 55,
        "lineEnd": 55,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/template-variables/index.md#L55-L55"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.36b924dae1ac17229c3b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To use time range dependent macros like `$__timeFilter(column)` in your query, you must set the template variable's refresh mode to **On Time Range Change**.",
      "headingPath": [
        "PostgreSQL template variables",
        "Query variable"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/template-variables/index.md",
        "gitBlobSha": "e6e64d6c3ed9d36f0d02cd77e1fe05e47046e60a",
        "sha256": "bb19076da8c2b9241d06f526cf27f5585c6d69fb5d74dff31d957443108ed5df",
        "lineStart": 61,
        "lineEnd": 61,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/template-variables/index.md#L61-L61"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.416f76919c57d11049f2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can create a key/value variable so the drop-down shows a user-friendly label (for example, hostname) while panel queries use a different value (for example, ID). Use the variable editor’s **Value field** and **Text field** at the bottom of the query section to specify which query columns supply the value and the label. Your query can use any column names; you do not need `__value` or `__text` in the SQL.",
      "headingPath": [
        "PostgreSQL template variables",
        "Query variable",
        "Key/value variables"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/template-variables/index.md",
        "gitBlobSha": "e6e64d6c3ed9d36f0d02cd77e1fe05e47046e60a",
        "sha256": "bb19076da8c2b9241d06f526cf27f5585c6d69fb5d74dff31d957443108ed5df",
        "lineStart": 69,
        "lineEnd": 69,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/template-variables/index.md#L69-L69"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.92c5911da116e917ad5e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Example: run a query that returns `hostname` and `id`, then set **Text field** to `hostname` and **Value field** to `id`.",
      "headingPath": [
        "PostgreSQL template variables",
        "Query variable",
        "Key/value variables"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/template-variables/index.md",
        "gitBlobSha": "e6e64d6c3ed9d36f0d02cd77e1fe05e47046e60a",
        "sha256": "bb19076da8c2b9241d06f526cf27f5585c6d69fb5d74dff31d957443108ed5df",
        "lineStart": 71,
        "lineEnd": 71,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/template-variables/index.md#L71-L71"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.62c1fadcf52cbf0d4647",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Note that the values in the text column should be unique. If there are duplicates, Grafana uses only the first matching entry.",
      "headingPath": [
        "PostgreSQL template variables",
        "Query variable",
        "Key/value variables"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/template-variables/index.md",
        "gitBlobSha": "e6e64d6c3ed9d36f0d02cd77e1fe05e47046e60a",
        "sha256": "bb19076da8c2b9241d06f526cf27f5585c6d69fb5d74dff31d957443108ed5df",
        "lineStart": 77,
        "lineEnd": 77,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/template-variables/index.md#L77-L77"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b4a3eaaed7bf9a9c94a8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Alternatively, you can use the legacy approach: return columns named `__text` and `__value` in your query (for example, `SELECT hostname AS __text, id AS __value FROM host`).",
      "headingPath": [
        "PostgreSQL template variables",
        "Query variable",
        "Key/value variables"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/template-variables/index.md",
        "gitBlobSha": "e6e64d6c3ed9d36f0d02cd77e1fe05e47046e60a",
        "sha256": "bb19076da8c2b9241d06f526cf27f5585c6d69fb5d74dff31d957443108ed5df",
        "lineStart": 79,
        "lineEnd": 79,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/template-variables/index.md#L79-L79"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b638bfd642f32432e968",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can create nested variables, where one variable depends on the value of another. For example, if you have a variable named `region`, you can configure a `hosts` variable to only show hosts from the selected region. If `region` is a multi-value variable, use the `IN` operator instead of `=` to match against multiple selected values.",
      "headingPath": [
        "PostgreSQL template variables",
        "Query variable",
        "Nested variables"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/template-variables/index.md",
        "gitBlobSha": "e6e64d6c3ed9d36f0d02cd77e1fe05e47046e60a",
        "sha256": "bb19076da8c2b9241d06f526cf27f5585c6d69fb5d74dff31d957443108ed5df",
        "lineStart": 83,
        "lineEnd": 83,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/template-variables/index.md#L83-L83"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.5645ee9f9391416adb09",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When using a multi-value PostgreSQL query variable with **Include All option** enabled and **Display** set to **Hidden**, the variable defaults to the first returned value, not **All**. This is because Grafana persists the active selection at dashboard save time, and a hidden variable has no UI for users to change it. To default a hidden variable to **All**, temporarily show the variable, select **All** in the drop-down, save the dashboard, then hide the variable and save again.",
      "headingPath": [
        "PostgreSQL template variables",
        "Query variable",
        "Nested variables"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/template-variables/index.md",
        "gitBlobSha": "e6e64d6c3ed9d36f0d02cd77e1fe05e47046e60a",
        "sha256": "bb19076da8c2b9241d06f526cf27f5585c6d69fb5d74dff31d957443108ed5df",
        "lineStart": 90,
        "lineEnd": 92,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/template-variables/index.md#L90-L92"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.bf076f30fd54e569f29f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Using `__searchFilter` in the query field filters the query results based on user input in the drop-down selection box. If nothing is entered, the default value for `__searchFilter` is `%`.",
      "headingPath": [
        "PostgreSQL template variables",
        "Query variable",
        "Filter results with `__searchFilter`"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/template-variables/index.md",
        "gitBlobSha": "e6e64d6c3ed9d36f0d02cd77e1fe05e47046e60a",
        "sha256": "bb19076da8c2b9241d06f526cf27f5585c6d69fb5d74dff31d957443108ed5df",
        "lineStart": 97,
        "lineEnd": 97,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/template-variables/index.md#L97-L97"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.2d81c3fbe8024372bfc8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You must enclose the `__searchFilter` expression in quotes because Grafana doesn't add them automatically.",
      "headingPath": [
        "PostgreSQL template variables",
        "Query variable",
        "Filter results with `__searchFilter`"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/template-variables/index.md",
        "gitBlobSha": "e6e64d6c3ed9d36f0d02cd77e1fe05e47046e60a",
        "sha256": "bb19076da8c2b9241d06f526cf27f5585c6d69fb5d74dff31d957443108ed5df",
        "lineStart": 99,
        "lineEnd": 99,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/template-variables/index.md#L99-L99"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.12654ca337ed90b1e2c6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can use a **Regex** type variable to filter or transform values from another variable. For example, if you have a variable named `server` that returns values like `web-prod-01`, `web-staging-01`, and `db-prod-01`, you can create a regular expression variable to extract only the environment:",
      "headingPath": [
        "PostgreSQL template variables",
        "Query variable",
        "Regex variable"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/template-variables/index.md",
        "gitBlobSha": "e6e64d6c3ed9d36f0d02cd77e1fe05e47046e60a",
        "sha256": "bb19076da8c2b9241d06f526cf27f5585c6d69fb5d74dff31d957443108ed5df",
        "lineStart": 119,
        "lineEnd": 119,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/template-variables/index.md#L119-L119"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c28730590972c5a8401f",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Create a new variable with **Type: Query**.",
      "headingPath": [
        "PostgreSQL template variables",
        "Query variable",
        "Regex variable"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/template-variables/index.md",
        "gitBlobSha": "e6e64d6c3ed9d36f0d02cd77e1fe05e47046e60a",
        "sha256": "bb19076da8c2b9241d06f526cf27f5585c6d69fb5d74dff31d957443108ed5df",
        "lineStart": 121,
        "lineEnd": 121,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/template-variables/index.md#L121-L121"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.17034deedbfb7dde99df",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Set the query to return the raw values.",
      "headingPath": [
        "PostgreSQL template variables",
        "Query variable",
        "Regex variable"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/template-variables/index.md",
        "gitBlobSha": "e6e64d6c3ed9d36f0d02cd77e1fe05e47046e60a",
        "sha256": "bb19076da8c2b9241d06f526cf27f5585c6d69fb5d74dff31d957443108ed5df",
        "lineStart": 122,
        "lineEnd": 122,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/template-variables/index.md#L122-L122"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.975d3ee54ffaa69e5e22",
      "syntaxRole": "procedural-step",
      "sourceText": "1. In the **Regex** field, enter a pattern to extract or filter. For example, `/^web-(.+)-\\d+$/` extracts `prod` and `staging` from web server names.",
      "headingPath": [
        "PostgreSQL template variables",
        "Query variable",
        "Regex variable"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/template-variables/index.md",
        "gitBlobSha": "e6e64d6c3ed9d36f0d02cd77e1fe05e47046e60a",
        "sha256": "bb19076da8c2b9241d06f526cf27f5585c6d69fb5d74dff31d957443108ed5df",
        "lineStart": 123,
        "lineEnd": 123,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/template-variables/index.md#L123-L123"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.7c33c9b6bf91b4edb3b9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can also use regular expression to filter a variable's options. For example, setting the **Regex** field to `/prod/` on a variable that returns all server names limits the drop-down to only production servers.",
      "headingPath": [
        "PostgreSQL template variables",
        "Query variable",
        "Regex variable"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/template-variables/index.md",
        "gitBlobSha": "e6e64d6c3ed9d36f0d02cd77e1fe05e47046e60a",
        "sha256": "bb19076da8c2b9241d06f526cf27f5585c6d69fb5d74dff31d957443108ed5df",
        "lineStart": 125,
        "lineEnd": 125,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/template-variables/index.md#L125-L125"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c995a258e815b75f4a68",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The PostgreSQL data source supports **multi-property variables**. Use them when the same logical concept has different identifiers in different contexts (for example, an environment called `dev` in one system and `development` in another). Instead of maintaining several variables in sync, you can map all of those values to one variable and reference the property you need in each panel or query.",
      "headingPath": [
        "PostgreSQL template variables",
        "Multi-property variables"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/template-variables/index.md",
