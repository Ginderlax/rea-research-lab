    {
      "id": "grafana.candidate.50e921b5f012eab02ce2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Traditionally alerts in the Alert Panel were grouped by the alert rule that created them. When you are monitoring a complex resource like an industrial pump, you typically have multiple alerts defined for that resource to observe different metrics. The new custom grouping feature allows you to view all alert instances for individual resource by specifying a label such as “pump identifier”.",
      "headingPath": [
        "What's new in Grafana v8.4",
        "OSS",
        "Alerting",
        "Custom grouping for the Alert Panel"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-4.md",
        "gitBlobSha": "252f5beb8e3fcec627862bf9d7133a82ac790f48",
        "sha256": "698f50f998678faa1ffd85c3becf29427f209d103b67f78883e8ff9c47004eec",
