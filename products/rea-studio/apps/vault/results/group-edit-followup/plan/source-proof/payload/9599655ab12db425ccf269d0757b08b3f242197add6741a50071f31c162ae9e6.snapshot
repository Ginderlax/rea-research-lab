import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import{createHash}from'node:crypto';
const work=import.meta.dirname,prior=path.join(work,'root-vault-group-edit-browser-review-next'),own=path.join(work,'root-vault-group-edit-corrected-browser-review-next'),candidate=path.join(work,'vault-group-edit-late-draft-fix-next'),sha=b=>createHash('sha256').update(b).digest('hex');
async function authenticate(dir,pin){const mb=await fs.readFile(path.join(dir,'manifest.json'));assert.equal(sha(mb),pin);const m=JSON.parse(mb);for(const r of m.inventory){const b=await fs.readFile(path.join(dir,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);}return m.inventory.length;}
assert.equal(await authenticate(prior,'3dc5b7d9bebe9419477c7fe38235afc8c14705c83099e2dc889c161587da18cd'),21);assert.equal(await authenticate(candidate,'289208dda19cada4aad11b38827414af77faa897b344d40ce71ff6ccec8013d3'),137);
await fs.mkdir(own);const b=await fs.readFile(path.join(prior,'host.mjs'));assert.equal(sha(b),'b9994910202782bdf7d9bb5ad5e4049a1b27219375200a8251f9dd1174c7491e');await fs.writeFile(path.join(own,'host.mjs'),b,{flag:'wx'});
await fs.writeFile(path.join(own,'preparation.json'),JSON.stringify({scope:'Prepare only. Reuse the exact previously accepted normal shared-host/shell collector with dynamic candidate argument, now corrected137 after separate late-draft negative78. Prior885/21 acceptance remains historical. The collector embedded path-guess diagnostic refers only to its original preparation, not new product behavior. Root will launch after independent corrected acceptance.',priorBrowserManifest:'3dc5b7d9bebe9419477c7fe38235afc8c14705c83099e2dc889c161587da18cd',candidateManifest:'289208dda19cada4aad11b38827414af77faa897b344d40ce71ff6ccec8013d3',collectorSHA256:sha(b),productionWrites:0,hostStarts:0,browserTabs:0,user4311Touched:false},null,2)+'\n',{flag:'wx'});await fs.writeFile(path.join(own,'preparation-collector.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});console.log(JSON.stringify({prepared:true,hostStarted:false,candidateFiles:137}));
