    {
      "id": "grafana.candidate.dd1a625261c361daf97b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "As a continuation of our efforts to standardize tooltips across visualizations, we've updated canvas visualization tooltips to be supported for all elements tied to data. Besides the element name and data, the tooltip now also displays the timestamp. This is a step forward from the previous implementation where tooltips were shown only if data links were configured.",
      "headingPath": [
        "What’s new in Grafana v11.2",
        "Dashboards and visualizations",
        "Improvements in canvas visualizations",
        "Standardized tooltips"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-2.md",
        "gitBlobSha": "ceccf569bb3670f6d3ae8c4db9fa3befbb8ef80a",
        "sha256": "e3947d9db32859fc717703f21b781da2366f7e2bda8dcfaeb51f1812ec5a1342",
        "lineStart": 105,
        "lineEnd": 105,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-2.md#L105-L105"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.f897b3393e0a8971e9d4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We've updated canvas visualizations so that you can add data links to canvas elements without using an override. The **Selected element** configuration now includes a **Data links** section where you can add data links to elements using the same steps as in other visualizations.",
      "headingPath": [
        "What’s new in Grafana v11.2",
        "Dashboards and visualizations",
        "Improvements in canvas visualizations",
        "Data links improvements"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-2.md",
        "gitBlobSha": "ceccf569bb3670f6d3ae8c4db9fa3befbb8ef80a",
        "sha256": "e3947d9db32859fc717703f21b781da2366f7e2bda8dcfaeb51f1812ec5a1342",
        "lineStart": 109,
        "lineEnd": 109,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-2.md#L109-L109"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.0fe6b89df3aded2cccb8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Data links in canvas elements can also be configured to open with a single click. To enable this functionality, select **Link** under the one **One-click** section in the **Selected element** data link options. If there are multiple data links for an element, the first link in the list has the one-click functionality.",
      "headingPath": [
        "What’s new in Grafana v11.2",
        "Dashboards and visualizations",
        "Improvements in canvas visualizations",
        "Data links improvements"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-2.md",
        "gitBlobSha": "ceccf569bb3670f6d3ae8c4db9fa3befbb8ef80a",
        "sha256": "e3947d9db32859fc717703f21b781da2366f7e2bda8dcfaeb51f1812ec5a1342",
        "lineStart": 111,
        "lineEnd": 111,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-2.md#L111-L111"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.04508a2d52420b7de516",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In future releases, we'll add one-click functionality to data links in other Grafana visualizations.",
      "headingPath": [
        "What’s new in Grafana v11.2",
        "Dashboards and visualizations",
        "Improvements in canvas visualizations",
        "Data links improvements"
      ],
      "source": {
