import fs from'node:fs';const p='work/keepass-group-recycle-next/freeze.mjs';let s=fs.readFileSync(p,'utf8');const before="testCensus.push({name,definitions,bytes:b.length,sha256:sha(b),epoch:name.startsWith('group-')?'new group':'unchanged prior regression'});",after="const additionalParameterizedExecutions=['recycle-boundaries.test.mjs','recycle-controls.test.mjs'].includes(name)?1:0;if(additionalParameterizedExecutions)assert.ok(b.toString().includes(\"for(const operation of ['restore','purge'])test(\"));testCensus.push({name,staticTestCalls:definitions,additionalParameterizedExecutions,definitions:definitions+additionalParameterizedExecutions,bytes:b.length,sha256:sha(b),epoch:name.startsWith('group-')?'new group':'unchanged prior regression'});";if(!s.includes(before))throw new Error('Own finalizer census anchor absent');s=s.replace(before,after);s=s.replace("{attempt:'test-count planning'", "{attempt:'first freeze source-census accounting',result:'Metadata assertion65 static calls vs67 actual tests; no validation/manifest written.',classification:'Two existing restore/purge loops each expand one test call into two tests. Preserve old finalizer exact; new metadata explicitly counts static65+parameterized2. No behavior rerun/rebinding.'},{attempt:'test-count planning'");fs.writeFileSync(p,s);
