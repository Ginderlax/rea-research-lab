    {
      "id": "grafana.candidate.694fd5444eee1884681e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set the `auto_login` option to true to attempt log in automatically, skipping the login screen. This setting is ignored if multiple auth providers are configured to use auto login.",
      "headingPath": [
