const oldClient=await fs.readFile(path.join(old,'baseline/client.mjs.snapshot'),'utf8'),newClient=await fs.readFile(path.join(stage,'products/rea-studio/apps/vault/client.mjs'),'utf8'),needle='await list();if(viewCurrent())await binList();';assert.equal(oldClient.split(needle).length-1,2);assert.equal(oldClient.replaceAll(needle,'await list();if(binCurrent())await binList();'),newClient);
for(const name of ['bin-boundaries.test.mjs','ui-helper.mjs']){const b=await fs.readFile(path.join(old,name));await fs.writeFile(path.join(root,name+'.snapshot'),b,{flag:'wx'});await fs.writeFile(path.join(root,name),name==='ui-helper.mjs'?b.toString().replace('../keepass-recycle-next/','../keepass-recycle-bin-generation-fix-next/'):b,{flag:'wx'});}
for(const name of ['preview-host.mjs','close-preview.mjs']){let source=await fs.readFile(path.join(old,name),'utf8');source=source.replaceAll('keepass-recycle-independent-review','keepass-recycle-bin-fix-independent-review').replaceAll('keepass-recycle-next','keepass-recycle-bin-generation-fix-next').replaceAll('rea-recycle-browser-review-','rea-recycle-bin-fix-browser-');await fs.writeFile(path.join(root,name),source,{flag:'wx'});}
const sourceBefore={schema:'rea-independent-recycle-bin-fix-baseline/v1',at:new Date().toISOString(),candidate:'work/keepass-recycle-bin-generation-fix-next',receipt:{bytes:receiptBytes.length,sha256:hash(receiptBytes)},manifest:{files:208,bytes:manifestBytes.length,sha256:hash(manifestBytes)},runtime:receipt.runtime,priorReviewManifest:{files:61,sha256:hash(oldManifest)},testBodies:'Exact c095a6eadde6805eac2f7b50806f695aa95aa2794f8d86d5024aa7a80653354a bytes; helper stage path only retargeted.',exactTwoGuardTransform:true,backendFiveUnchanged:true};await fs.writeFile(path.join(root,'source-before.json'),JSON.stringify(sourceBefore,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({candidateArtifacts:208,priorReview61Unchanged:true,exactTwoGuards:true}));
