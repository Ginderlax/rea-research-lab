    {
      "id": "grafana.candidate.e5f449481a41b399194a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set this to true to force path-style addressing in S3 requests, which uses `http://s3.amazonaws.com/<BUCKET>/<KEY>`, instead of the default, which is virtual hosted bucket addressing when possible (`http://<BUCKET>.s3.amazonaws.com/<KEY>`).",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[external_image_storage.s3]`",
        "`path_style_access`"
      ],
