    {
      "id": "grafana.candidate.ffe605fdc75e29675dc9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Overrides the time range for individual panels by shifting its start and end relative to the time picker. For example, you can shift the time range for the panel to be two hours earlier than the dashboard time picker.",
