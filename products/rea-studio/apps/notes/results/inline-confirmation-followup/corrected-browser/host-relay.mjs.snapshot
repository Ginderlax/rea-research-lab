import fs from 'node:fs/promises';import {appendFileSync}from'node:fs';import path from 'node:path';import os from 'node:os';import assert from 'node:assert/strict';import http from 'node:http';import readline from 'node:readline';import {createHash} from 'node:crypto';import {pathToFileURL} from 'node:url';
const here=import.meta.dirname,workspace=path.resolve(here,'../..'),sha=b=>createHash('sha256').update(b).digest('hex'),fp=async p=>{const b=await fs.readFile(p);return{bytes:b.length,sha256:sha(b)}},save=(n,v)=>fs.writeFile(path.join(here,n),JSON.stringify(v,null,2)+'\n',{flag:'wx'}),say=value=>{const line=JSON.stringify(value);appendFileSync(path.join(here,'host.stdout.txt'),line+'\n');console.log(line);};const sources=JSON.parse(await fs.readFile(path.join(here,'source-before.json')));for(const r of sources)assert.deepEqual(await fp(path.join(here,r.clone)),{bytes:r.bytes,sha256:r.sha256});await save('controller-before.json',await fp(path.join(here,'host-relay.mjs')));
const prefix=path.resolve(os.tmpdir(),'notes-cancel-browser-'),dataDir=await fs.mkdtemp(prefix),host=await(await import(pathToFileURL(path.join(here,'studio/server.mjs')).href)).start({port:0,dataDir}),actual=[];let phase='seed';host.server.prependListener('request',(req,res)=>{const row={id:actual.length+1,at:new Date().toISOString(),phase,method:req.method,url:req.url};actual.push(row);res.once('finish',()=>{row.status=res.statusCode;row.completedAt=new Date().toISOString();});});
async function call(action,input={}){const response=await fetch(host.url+'/api/notes/'+action,{method:'POST',headers:{'content-type':'application/json','x-rea-token':host.token},body:JSON.stringify(input)}),value=await response.json();assert(response.ok,JSON.stringify(value));return value.result;}
let tree=await call('notebook-create',{title:'Owned Cancel Parent',revision:0}),parent=tree.notebook.id;tree=await call('notebook-create',{title:'Owned Cancel Child',parentId:parent,revision:tree.revision});const child=tree.notebook.id,note=await call('save',{title:'Owned Attachment Note',body:'Owned synthetic attached-note body.',notebookId:child,tags:['owned-cancel-browser']});phase='browser';
let relayPort,armed=null,held=null,closing=false;const forwarded=[],holds=[],hop=new Set(['connection','keep-alive','proxy-authenticate','proxy-authorization','te','trailer','transfer-encoding','upgrade']);
async function persisted(){const file=path.join(dataDir,'notes/records/notes-state-v2.json');const bytes=await fs.readFile(file);return{bytes:bytes.length,sha256:sha(bytes),state:JSON.parse(bytes)};}
const relay=http.createServer(async(req,res)=>{try{assert(['127.0.0.1','::1','::ffff:127.0.0.1'].includes(req.socket.remoteAddress));assert.equal(req.headers.host,'127.0.0.1:'+relayPort);if(req.headers.origin)assert.equal(req.headers.origin,'http://127.0.0.1:'+relayPort);assert(req.url.startsWith('/')&&!req.url.startsWith('//'));const pieces=[];let bytes=0;for await(const piece of req){bytes+=piece.length;assert(bytes<=4*1024*1024);pieces.push(piece);}const body=Buffer.concat(pieces),headers={...req.headers,host:new URL(host.url).host};for(const h of hop)delete headers[h];if(headers.origin)headers.origin=host.url;headers['content-length']=body.length;const row={id:forwarded.length+1,at:new Date().toISOString(),method:req.method,url:req.url,bodyBytes:body.length,bodySHA256:sha(body),transforms:{host:{from:req.headers.host,to:headers.host},origin:req.headers.origin?{from:req.headers.origin,to:headers.origin}:null,hopByHopRemoved:true,contentLength:body.length}};if(req.url.startsWith('/api/notes/')){const input=JSON.parse(body);row.input=input;row.action=req.url.slice('/api/notes/'.length);}forwarded.push(row);
 const response=await new Promise((resolve,reject)=>{const up=http.request(new URL(req.url,host.url),{method:req.method,headers,timeout:30000},reply=>{const chunks=[];let count=0;reply.on('data',chunk=>{count+=chunk.length;if(count>4*1024*1024){reply.destroy(new Error('Owned response bound'));return;}chunks.push(chunk);});reply.on('end',()=>resolve({status:reply.statusCode,headers:reply.headers,body:Buffer.concat(chunks)}));reply.on('error',reject);});up.on('error',reject);up.on('timeout',()=>up.destroy(new Error('Owned upstream timeout')));up.end(body);});row.upstreamStatus=response.status;row.upstreamBodyBytes=response.body.length;row.upstreamBodySHA256=sha(response.body);row.upstreamCompletedAt=new Date().toISOString();if(row.action)row.response=JSON.parse(response.body);const deliver=()=>{if(res.destroyed){row.browserSocketDestroyedBeforeDelivery=true;return;}const headers={...response.headers};for(const h of hop)delete headers[h];headers['content-length']=response.body.length;res.writeHead(response.status,headers);res.end(response.body);row.deliveredAt=new Date().toISOString();};
 if(armed&&row.action===armed.action&&response.status===200){assert.equal(held,null);const disk=await persisted(),noteState=disk.state.notes[note.id],record={label:armed.label,action:armed.action,at:new Date().toISOString(),forwardedId:row.id,committedBeforeHold:true,persisted:{bytes:disk.bytes,sha256:disk.sha256},note:noteState,response:row.response.result};if(row.action==='save'){assert.equal(noteState.body,row.input.body);assert.equal(noteState.revision,row.response.result.revision);}if(row.action==='notebook-trash')assert(noteState.deletedAt);if(row.action==='notebook-restore')assert.equal(noteState.deletedAt,null);holds.push(record);await save('held-'+armed.label+'.json',record);held={label:armed.label,deliver,record};armed=null;say({held:held.label,action:record.action,committed:true,revision:noteState.revision});}else deliver();
 }catch(error){appendFileSync(path.join(here,'host.stderr.txt'),String(error.stack)+'\n');if(!res.headersSent)res.writeHead(500,{'content-type':'text/plain'});res.end(String(error.message));say({relayError:String(error.message)});}});
await new Promise((resolve,reject)=>{relay.once('error',reject);relay.listen(0,'127.0.0.1',resolve);});relayPort=relay.address().port;await save('host.json',{at:new Date().toISOString(),pid:process.pid,actualHost:host.url,relayOrigin:'http://127.0.0.1:'+relayPort,browserUrl:'http://127.0.0.1:'+relayPort+'/#notes',dataDir,parent,child,noteId:note.id,sourceFiles:sources.length,seedCalls:3,fixtureOnlyRelay:true,headerTransforms:'Exact relay Host/Origin checked and normalized to owned actual host. Body, method, path and session token unchanged; hop headers removed; content-length recomputed.',proxySecurityClaim:false,originalGUI:0,benchmarks:0,user4311Touched:false});
async function observe(label){const disk=await persisted();await save('observation-'+label+'.json',{at:new Date().toISOString(),persisted:disk,actual:structuredClone(actual),forwarded:structuredClone(forwarded),holds:structuredClone(holds),held:held?.label??null,armed});say({observation:label,actual:actual.length,forwarded:forwarded.length,api:forwarded.filter(r=>r.action).length,held:held?.label??null,revision:disk.state.notes[note.id].revision,trashed:Boolean(disk.state.notes[note.id].deletedAt)});}
async function close(reason){if(closing)return;closing=true;clearTimeout(timer);if(held){held.deliver();held.record.releasedAt=new Date().toISOString();held=null;}await observe('before-close');await new Promise((resolve,reject)=>relay.close(error=>error?reject(error):resolve()));await host.close();for(const r of sources){assert.deepEqual(await fp(path.join(here,r.clone)),{bytes:r.bytes,sha256:r.sha256});assert.deepEqual(await fp(path.join(workspace,r.original)),{bytes:r.bytes,sha256:r.sha256});}assert.deepEqual(await fp(path.join(here,'host-relay.mjs')),JSON.parse(await fs.readFile(path.join(here,'controller-before.json'))));const resolved=path.resolve(dataDir);assert(resolved.startsWith(prefix)&&path.dirname(resolved)===path.resolve(os.tmpdir()));await fs.rm(resolved,{recursive:true,force:true});await save('source-after.json',sources);await save('cleanup.json',{at:new Date().toISOString(),reason,hostClosed:true,relayClosed:true,tempDataRemoved:true,sourceStable:true});say({closed:true,tempRemoved:true,sourceStable:true});process.exit(0);}
const timer=setTimeout(()=>close('20-minute bounded campaign').catch(e=>{console.error(e);process.exit(1);}),1200000),lines=readline.createInterface({input:process.stdin});let queue=Promise.resolve();lines.on('line',line=>{queue=queue.then(async()=>{const s=line.trim();if(s==='close')return close('explicit owned close');if(/^observe [a-z0-9-]+$/.test(s))return observe(s.slice(8));const arm=/^arm (save|notebook-trash|notebook-restore) ([a-z0-9-]+)$/.exec(s);if(arm){assert.equal(held,null);assert.equal(armed,null);armed={action:arm[1],label:arm[2]};return say({armed});}const release=/^release ([a-z0-9-]+)$/.exec(s);if(release){assert.equal(held?.label,release[1]);held.deliver();held.record.releasedAt=new Date().toISOString();say({released:held.label});held=null;}}).catch(e=>{appendFileSync(path.join(here,'host.stderr.txt'),String(e.stack)+'\n');console.error(e);});});say({browserUrl:'http://127.0.0.1:'+relayPort+'/#notes',actualHost:host.url,pid:process.pid,sourceFiles:sources.length});
