    {
      "id": "grafana.candidate.2e97fdfece8a46c17bbc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The port to bind to, defaults to `3000`. To use port 80 you need to either give the Grafana binary permission for example:",
      "headingPath": [
