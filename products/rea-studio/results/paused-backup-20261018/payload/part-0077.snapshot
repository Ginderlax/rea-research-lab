      "id": "grafana.candidate.6152cd0ee644bc5959a7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Whether image rendering is allowed for dashboard previews. Requires the image rendering service to be configured. Default is `true`.",
      "headingPath": [
