    {
      "id": "grafana.candidate.14484ece9e79c9097b7d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A custom error message for when users are unauthorized. Default is a key for an internationalized phrase in the frontend, `Login provider denied login request`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[auth]`",
        "`oauth_login_error_message`"
