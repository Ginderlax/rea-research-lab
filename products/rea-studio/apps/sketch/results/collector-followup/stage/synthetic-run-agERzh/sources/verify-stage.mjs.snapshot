receipt.artifacts=await fingerprints(here,[path.relative(here,path.join(runDirectory,'stdout.txt')).replaceAll('\\','/'),path.relative(here,path.join(runDirectory,'stderr.txt')).replaceAll('\\','/'),path.relative(here,path.join(runDirectory,'observations.json')).replaceAll('\\','/')]);
