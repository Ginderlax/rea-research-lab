      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.95a79828f6d6c5769975",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When the Redis engine is configured, Grafana Live keeps its state in Redis and uses Redis PUB/SUB functionality to deliver messages to all subscribers throughout all Grafana server nodes.",
      "headingPath": [
        "Set up Grafana Live",
        "Configure Grafana Live HA setup",
