import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const work=import.meta.dirname,workspace=path.dirname(work),lab=path.join(workspace,'outputs/rea-research-lab'),own=path.join(work,'vault-group-publication-plan-next'),sha=b=>createHash('sha256').update(b).digest('hex'),prefix='products/rea-studio/results/vault-group-recycle-reviewed-installation-20261013/source-proof';
await fs.mkdir(own,{recursive:false});const epochs=[
 ['initial777','keepass-group-recycle-next','048fc56fded29bb89cf43830919c4b717a82d055e531644028b85ef07917e28d',777],
 ['password-negative10','keepass-group-postfreeze-review','fca7b59a86ecb99ed54b20b2c2cca82d0a36df4349db29778bf5909eadd2590a',10],
 ['bin-coherence456','keepass-group-bin-coherence-fix-next','4db08d661ec1fd9d61cee593b66c470513bddc99d28594ca584c79324049fef0',456],
 ['active-list-negative14','root-vault-group-dom-review-next','9450b6c9504fb865a3fa7c96f7a11ec6d82ce7d127eb723f62c91d97e2018240',14],
 ['active-list343','keepass-group-active-list-fix-next','d24b555cc9f35f4720920d385c97496803e787f69f76caca4af0fcf2b4c4acdd',343],
 ['root-active-list16','root-vault-group-dom-active-list-review','997a710629497783b5631147b9a4f27c92584ba1320a12094382181f7e2036f4',16],
 ['root-http-first17','root-vault-group-http-review-next','fcb9afdc781ca39cb43974dcad47869df324a21878feb1682d0aa20c87795327',17],
 ['root-http19','root-vault-group-http-review-v2','066973a3d224e355cb3bb9e6fc854b7057540fb81ba797240015035e3a3512db',19],
 ['root-browser-unresolved18','root-vault-group-browser-review-next','f14ce1bfd7b22ea78e37d239bcf3f83f0935617d3d8591b27a1d220177886a0f',18],
 ['root-browser-visible20','root-vault-group-browser-visible-control','3c409a9150a39c9588323fe32b1fa74d0f2d1a095247bda93952cda349aa2582',20],
];
const payloads=new Map(),records=[],epochRecords=[];
function safe(p){assert(typeof p==='string'&&p&&!path.isAbsolute(p)&&!/[\\:\x00-\x1f]/.test(p)&&p.split('/').every(s=>s&&s!=='.'&&s!=='..'));}
function inert(b){assert(b.length<=32*1024*1024);assert(Buffer.from(b.toString()).equals(b),'Public payload must be exact UTF8');const h=b.subarray(0,8).toString('hex');for(const head of ['4d5a','7f454c46','504b0304','1f8b','377abcaf271c','03d9a29a','28b52ffd'])assert(!h.startsWith(head),'Native carrier cannot be public');}
async function retain(epoch,dir,name,expected){safe(name);const b=await fs.readFile(path.join(dir,name));if(expected){assert.equal(b.length,expected.bytes,name);assert.equal(sha(b),expected.sha256,name);}inert(b);const digest=sha(b),publicPath=prefix+'/payload/'+digest+'.snapshot';if(!payloads.has(digest)){const local=path.join(own,'source-proof/payload/'+digest+'.snapshot');await fs.mkdir(path.dirname(local),{recursive:true});await fs.writeFile(local,b,{flag:'wx'});payloads.set(digest,{path:publicPath,bytes:b.length,sha256:digest});}records.push({epoch,sourcePath:name,publicPath,bytes:b.length,sha256:digest});return {bytes:b.length,sha256:digest};}
for(const [epoch,name,pin,count] of epochs){const dir=path.join(work,name),mb=await fs.readFile(path.join(dir,'manifest.json'));assert.equal(sha(mb),pin,name);const manifest=JSON.parse(mb);assert(Array.isArray(manifest.inventory));assert.equal(manifest.inventory.length,count);const seen=new Set();for(const row of manifest.inventory){assert(!seen.has(row.path));seen.add(row.path);await retain(epoch,dir,row.path,row);}await retain(epoch,dir,'manifest.json',{bytes:mb.length,sha256:pin});let freeze=null;try{const b=await fs.readFile(path.join(dir,'freeze.json'));const f=JSON.parse(b);assert.equal(f.manifest.sha256,pin);freeze=await retain(epoch,dir,'freeze.json');}catch(e){if(e.code!=='ENOENT')throw e;}epochRecords.push({epoch,originalDirectory:'work/'+name,manifestSha256:pin,frozenPayloads:count,freezeSidecar:freeze,allManifestPayloadsExact:true});}
const proof={schema:'rea-vault-group-source-preservation/v1',createdAt:new Date().toISOString(),epochs:epochRecords,records,payloads:[...payloads.values()].sort((a,b)=>a.path.localeCompare(b.path)),sourceAliases:records.length,uniquePublicPayloads:payloads.size,exactUTF8InertCopies:true,sourceStableBeforeAfter:true,originalExecutableBytesPublic:0,originalArchiveBytesPublic:0,privateSessionTokensPublic:0,historicalReceiptsRebound:false,fullProductParity:false,universalSuperiority:false};
await fs.writeFile(path.join(own,'source-proof/preservation-manifest.json'),JSON.stringify(proof,null,2)+'\n',{flag:'wx'});
const stage=path.join(work,'keepass-group-active-list-fix-next'),proposal=JSON.parse(await fs.readFile(path.join(stage,'installation-proposal.json'))),rows=structuredClone(proposal.rows),docChanges=[];
const evidence='The final guarded candidate passed77 focused checks. The independent root replay passed the exact six previously tested case bodies, including the formerly failing held active-list case. A separate real shared-host HTTP campaign passed two cases through five process starts, including four recycle/restore/purge restarts, native tombstone order, history and encrypted-record checks. A normal shared Studio host and shell additionally passed eight finite browser observations for preview, confirmation, recycling, password reveal, recursive restoration, preview clearing and empty-bin reopening. These are distinct campaigns, not a combined test denominator. Original GUI/full-program executions and timing/resource comparative acceptance remain zero. The original15 managed-load author campaign remains its immutable initial777 epoch; it is not rebound to the corrected client. Current installed-source focused checks are recorded separately after installation.';
const changes={
 'GROUP-RECYCLE.md':[
 ['This work-only candidate adds group list/preview and confirmed recursive recycle, permanent delete and previous-parent restoration. It is not installed in Studio.','Group actions provide group list/preview and confirmed recursive recycle, permanent delete and previous-parent restoration.'],
 ['Future installation, actual browser/HTTP host acceptance and independent review remain pending.',evidence+' The immutable source and failed/corrected epochs are mapped by the [group preservation manifest](../../results/vault-group-recycle-reviewed-installation-20261013/source-proof/preservation-manifest.json).'],
 ],
 'GROUP-RECYCLE-NOTICE.md':[
 ['The complete selected upstream files with their copyright/license headers and complete GPL license bytes remain at stage `source-study/selected`.','The complete selected upstream files with their copyright/license headers and complete GPL license bytes are retained as exact inert public payloads. Their original paths and SHA256 values are mapped by the [group preservation manifest](../../results/vault-group-recycle-reviewed-installation-20261013/source-proof/preservation-manifest.json), including the initial777 `source-study/selected` records.'],
 ["selected exact16 source files are bound in `source-provenance.json`.","selected exact16 source files are bound by the retained initial777 `source-provenance.json` record in that manifest."],
 ],
 'README.md':[
 ['This work-only group recycle candidate supplements the preserved entry/history epochs with recursive group list/preview, confirmed recycle/purge and valid previous-parent restoration. It is not installed in production.','Group list/preview, confirmed recursive recycle/purge and valid previous-parent restoration supplement the preserved entry/history workflows.'],
 ['history comparison/deletion/settings/age cleanup; group recycling/recovery and whole-bin emptying; group rename/reordering/management UI;','history comparison/deletion/settings/age cleanup; whole-bin emptying; general group rename/reordering/management UI;'],
 ['Root will add current production-source results after installation; this proposal makes no new behavioral pass claim. Group recovery, empty bin, multi-selection and complete KeePass parity remain open.','Those entry epochs retain their original sources and counts. Recursive group recovery is described in [GROUP-RECYCLE.md](GROUP-RECYCLE.md), with the [immutable group evidence map](../../results/vault-group-recycle-reviewed-installation-20261013/source-proof/preservation-manifest.json). Whole-bin emptying, multi-selection, general group management and complete KeePass parity remain open.\n\n'+evidence],
 ]
};
for(const [name,replacements] of Object.entries(changes)){const relative='products/rea-studio/apps/vault/'+name,before=await fs.readFile(path.join(stage,relative));let text=before.toString();for(const [a,b] of replacements){assert.equal(text.split(a).length,2,name+' exact unique text');text=text.replace(a,b);}const after=Buffer.from(text),target=path.join(own,'documentation-proposal/'+name);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,after,{flag:'wx'});await fs.mkdir(path.join(own,'before-documents'),{recursive:true});await fs.writeFile(path.join(own,'before-documents/'+name+'.snapshot'),before,{flag:'wx'});docChanges.push({target:relative,before:{bytes:before.length,sha256:sha(before)},after:{bytes:after.length,sha256:sha(after)},replacements});const row=rows.find(r=>r.target===relative);assert(row);row.source='documentation-proposal/'+name;row.sourceRoot='this-plan';row.bytes=after.length;row.sha256=sha(after);row.explicitDocumentationOverlay=true;}
for(const row of rows){const base=row.sourceRoot==='this-plan'?own:stage,b=await fs.readFile(path.join(base,row.source));assert.equal(b.length,row.bytes,row.target);assert.equal(sha(b),row.sha256,row.target);if(row.expectedBefore){const current=await fs.readFile(path.join(lab,row.target));assert.equal(current.length,row.expectedBefore.bytes,row.target);assert.equal(sha(current),row.expectedBefore.sha256,row.target);}else await assert.rejects(fs.access(path.join(lab,row.target)),e=>e.code==='ENOENT');}
const output={...proposal,schema:'rea-root-vault-group-installation-plan/v1',at:new Date().toISOString(),rows,documentationOverlay:docChanges,publicSourcePrefix:prefix,publicSourceMap:{path:prefix+'/preservation-manifest.json',bytes:(await fs.stat(path.join(own,'source-proof/preservation-manifest.json'))).size,sha256:sha(await fs.readFile(path.join(own,'source-proof/preservation-manifest.json')))},sourceOnly:true,productionWrites:0,sourceRowsExact:true,installedBehaviorExecuted:false,currentFocusedOriginalAdapterAcceptance:false,fullParity:false,universalSuperiority:false};await fs.writeFile(path.join(own,'installation-plan.json'),JSON.stringify(output,null,2)+'\n',{flag:'wx'});await fs.copyFile(import.meta.filename,path.join(own,'collector.mjs.snapshot'));
// Reauthenticate every immutable input after proposal creation.
for(const [epoch,name,pin,count] of epochs){const dir=path.join(work,name),mb=await fs.readFile(path.join(dir,'manifest.json'));assert.equal(sha(mb),pin);for(const row of JSON.parse(mb).inventory){const b=await fs.readFile(path.join(dir,row.path));assert.equal(b.length,row.bytes);assert.equal(sha(b),row.sha256);}}
async function walk(dir,p=''){const found=[];for(const e of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const rel=p+e.name;if(e.isDirectory())found.push(...await walk(path.join(dir,e.name),rel+'/'));else{assert(e.isFile());const b=await fs.readFile(path.join(dir,e.name));found.push({path:rel,bytes:b.length,sha256:sha(b)});}}return found;}const inventory=await walk(own),manifest=Buffer.from(JSON.stringify({schema:'rea-strict-work-review/v1',files:inventory.length,inventory},null,2)+'\n');await fs.writeFile(path.join(own,'manifest.json'),manifest,{flag:'wx'});console.log(JSON.stringify({stage:own,sourceAliases:records.length,uniquePublicPayloads:payloads.size,installationRows:rows.length,productionWrites:0,manifestSHA256:sha(manifest),files:inventory.length}));
