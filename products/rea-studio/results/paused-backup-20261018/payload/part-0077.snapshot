    },
    {
      "id": "grafana.candidate.d87993ac82d7ed44b858",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "SQLite stores the journal mode in the database file, so a database that was opened with WAL keeps using it. Setting `wal` back to `false` puts the database into `DELETE` journal mode again on the next start.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[database]`",
        "`wal`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 478,
        "lineEnd": 478,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L478-L478"
      },
