import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs/promises';import{fixture}from'./normalization-ui-fixture.mjs';import{handle}from'./server.mjs';
const seed=JSON.parse(await fs.readFile(new URL('../../../../../authority/browser28-seed.json.snapshot',import.meta.url),'utf8'));
test('new input after the second Save await retains draft and committed raw baseline',async()=>{let enabled=false;const f=await fixture({rawText:seed.text,hold:a=>enabled&&a==='native-list'});let pending;try{await f.load();enabled=true;pending=f.button('Save native draft').click();await f.held;assert.equal((await handle({action:'native-export',input:{id:f.saved.flow.id},store:f.store})).text,seed.text);const text=f.field('Native Node-RED flow JSON'),next=JSON.stringify({...seed.document,newer:'after committed save list'});text.value=next;await text.fire('input',{programmatic:true});f.release();await pending;assert.equal(text.value,next);assert.match(f.section.textContent,/newer draft input remains/);assert.equal((await handle({action:'native-export',input:{id:f.saved.flow.id},store:f.store})).text,seed.text);await f.button('Save native draft').click();assert.equal((await handle({action:'native-export',input:{id:f.saved.flow.id},store:f.store})).text,next);}finally{f.release();if(pending)await pending;await f.close();}});
test('transient same-value input revisions still prevent late Export publication',async()=>{let enabled=false;const f=await fixture({rawText:seed.text,hold:a=>enabled&&a==='native-validate'});let pending;try{await f.load();enabled=true;pending=f.button('Export Node-RED JSON').click();await f.held;const field=f.field('Native Node-RED flow JSON'),before=field.value;field.value=before+' ';await field.fire('input',{programmatic:true});field.value=before;await field.fire('input',{programmatic:true});f.release();await pending;assert.equal(field.value,before);assert.equal(f.downloads.length,0);await f.button('Export Node-RED JSON').click();assert.equal(await f.downloads[0].text(),seed.text);}finally{f.release();if(pending)await pending;await f.close();}});
test('held Apply node validation cannot overwrite a newer native document',async()=>{let enabled=false;const f=await fixture({rawText:seed.text,hold:a=>enabled&&a==='native-validate'});let pending;try{await f.load();await f.field('Edit native node out').click();const editor=f.field('Selected native node properties'),changed=JSON.parse(editor.value);changed.name='Captured older node edit';editor.value=JSON.stringify(changed);enabled=true;pending=f.button('Apply native node changes').click();await f.held;const field=f.field('Native Node-RED flow JSON'),newer=JSON.stringify({...seed.document,newer:'after node validation'});field.value=newer;await field.fire('input',{programmatic:true});f.release();await pending;assert.equal(field.value,newer);assert.equal(JSON.parse(field.value).flows.find(x=>x.id==='out').name,'Static Out');}finally{f.release();if(pending)await pending;await f.close();}});
test('held link validation respects input revision even if display returns to identical normalized text',async()=>{let enabled=false;const f=await fixture({rawText:seed.text,hold:a=>enabled&&a==='native-validate'});let pending;try{await f.load();enabled=true;pending=f.button('Disconnect static link').click();await f.held;const field=f.field('Native Node-RED flow JSON'),before=field.value;field.value=before+' ';await field.fire('input',{programmatic:true});field.value=before;await field.fire('input',{programmatic:true});f.release();await pending;assert.equal(field.value,before);assert.deepEqual(JSON.parse(field.value).flows.find(x=>x.id==='in').links,['out']);assert.equal((await handle({action:'native-export',input:{id:f.saved.flow.id},store:f.store})).text,seed.text);}finally{f.release();if(pending)await pending;await f.close();}});
