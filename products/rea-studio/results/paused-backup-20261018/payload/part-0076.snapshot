    {
      "id": "grafana.candidate.2c02fdd5d8d3ed7d4873",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana Loki is a horizontally scalable, highly available, multi-tenant log aggregation system by Grafana Labs. Unlike other logging systems, Loki indexes only metadata about your logs in the form of labels, the same label model used by Prometheus. Loki compresses and stores the log content itself in chunks in object stores such as Amazon S3 or Google Cloud Storage, or on a local filesystem. The Loki data source in Grafana lets you query and visualize those logs, and correlate them with metrics, traces, and other data in unified dashboards.",
      "headingPath": [
        "Loki data source"
      ],
      "source": {
        "path": "docs/sources/datasources/loki/_index.md",
        "gitBlobSha": "abdf2c75e7a3bd42ab6dadba58dd79d8b63e82e3",
        "sha256": "e0edf9bb7b156cb750dbfe08dde96e71dcf7f922decd0b071785a283c57eb9c0",
