    {
      "id": "grafana.candidate.bc6c8e46f592a643f901",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Notification templates and alert rule templates, such as annotations and labels, both use the Go template language, [text/template](https://pkg.go.dev/text/template).",
      "headingPath": [
        "Alerting template language"
      ],
      "source": {
