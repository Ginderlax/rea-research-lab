    },
    {
      "id": "grafana.candidate.331fe83d258580a8c812",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Previously, you could only configure custom branding in Grafana's configuration files. Now, you can experiment with customization in Grafana's Admin section in the UI, or customize branding and links using the API. This is an early-access feature available only to self-managed customers.",
      "headingPath": [
        "What's new in Grafana v9.1",
        "Grafana Enterprise",
        "Sharing and customization",
        "(Beta) Configure custom branding in Grafana's UI"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-1.md",
        "gitBlobSha": "7f2b514efd5a050fef62ef5f9f55cac366248b28",
        "sha256": "d693aa46fe2713a3b657e9a37d23a3275c0fd01c2a3d5ed47c565a3c3019c53a",
        "lineStart": 200,
        "lineEnd": 202,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v9-1.md#L200-L202"
      },
      "applicability": {
        "status": "excluded-by-paid-or-hosted-section-heading",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ],
        "restriction": "What's new in Grafana v9.1 > Grafana Enterprise > Sharing and customization > (Beta) Configure custom branding in Grafana's UI"
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.2a47a32e83d7417345c6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "As part of our continued improvements to role-based access control (RBAC), we are rolling out RBAC across all of Grafana's features. In v9.1, you can determine which users, teams, and roles can access app plugins like OnCall and Synthetics.",
      "headingPath": [
        "What's new in Grafana v9.1",
        "Grafana Enterprise",
        "Authentication and security",
        "RBAC for app plugins, usage insights, and query caching"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-1.md",
        "gitBlobSha": "7f2b514efd5a050fef62ef5f9f55cac366248b28",
        "sha256": "d693aa46fe2713a3b657e9a37d23a3275c0fd01c2a3d5ed47c565a3c3019c53a",
        "lineStart": 210,
        "lineEnd": 211,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v9-1.md#L210-L211"
      },
      "applicability": {
        "status": "excluded-by-paid-or-hosted-section-heading",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ],
        "restriction": "What's new in Grafana v9.1 > Grafana Enterprise > Authentication and security > RBAC for app plugins, usage insights, and query caching"
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.bff26769b49e6516439b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "> **Note:** You can't yet define view or edit roles for app plugins. > For example, you cannot yet grant a user view-only access to OnCall. > This definition is planned for a future release.",
      "headingPath": [
        "What's new in Grafana v9.1",
        "Grafana Enterprise",
        "Authentication and security",
        "RBAC for app plugins, usage insights, and query caching"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-1.md",
        "gitBlobSha": "7f2b514efd5a050fef62ef5f9f55cac366248b28",
