    },
    {
      "id": "grafana.candidate.e0a54917c06546c00c24",
      "syntaxRole": "list-item",
      "sourceText": "- We have removed the deprecated `getFormStyles` function from [grafana-ui](https://www.npmjs.com/package/@grafana/ui). Use `GrafanaTheme2` and the `useStyles2` hook instead [PR #49945](https://github.com/grafana/grafana/pull/49945)",
      "headingPath": [
        "What's new in Grafana v9.0",
        "Breaking changes",
        "Plugins: Most relevant breaking changes"
      ],
      "source": {
