    {
      "id": "grafana.candidate.218b130c5de505859eab",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "One-time use links use browser cookies, so when a viewer is granted access through one of these links, they'll only have access on the browser they used to claim the link.",
      "headingPath": [
