    {
      "id": "grafana.candidate.1cf540fbe30085016e10",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When the `profilesHeatmap` feature is enabled, a **Heatmap** toggle appears in the **Options** section. The heatmap visualizes the distribution of profile samples over time, which helps you spot patterns and outliers across many profiles.",
      "headingPath": [
        "Query profile data",
        "Pyroscope query editor",
        "Query options",
        "Heatmap"
      ],
      "source": {
