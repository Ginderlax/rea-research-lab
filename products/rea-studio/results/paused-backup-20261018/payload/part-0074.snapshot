    },
    {
      "id": "grafana.candidate.aed0e88739bd1ed263c0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you're using Grafana Enterprise or Grafana Cloud, you can create custom roles to manage user permissions in a way that meets your security requirements. Custom roles contain unique combinations of permissions _actions_ (the allowed task) and _scopes_ (where to perform the task).",
      "headingPath": [
        "Role-based access control (RBAC) overview",
        "Available RBAC roles",
        "Custom roles"
      ],
      "source": {
        "path": "docs/sources/administration/roles-and-permissions/access-control/_index.md",
