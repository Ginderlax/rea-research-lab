async function restore(repo,input,entries) {
  if (input.confirm !== true) throw new Error('Restoring requires confirmation.');
  const destination = clean(input.destination); if (overlap(destination,repo.relative) || destination.split('/').some(p => p.toLowerCase() === '.rea-backup')) throw new Error('Restore outside both repositories.');
  const times = new Map();
  for (const entry of entries) if (entry.mtime !== undefined) {
    const time = resticTime(entry.mtime);
    // The current Windows Node/libuv utimes binding wraps seconds outside this
    // interval. Refuse before output rather than report incorrect metadata.
    if (process.platform === 'win32' && (time < 0 || time > 4294967295999)) throw new Error('Restic modification time is outside the supported Windows restore interval (1970 through 2106-02-07T06:28:15.999Z).');
    times.set(entry.path,time);
  }
  const setTime = async entry => {
    if (!times.has(entry.path)) return;
    const target = repo.workspace.resolve(`${destination}/${entry.path}`), time = times.get(entry.path);
    await fs.utimes(target,new Date(),new Date(time));
    if (Math.abs((await fs.stat(repo.workspace.resolve(`${destination}/${entry.path}`))).mtimeMs - time) >= 1) throw new Error('Restic modification time was not preserved by this filesystem.');
  };
  const checked = await repo.verify(entries); await repo.assertLock();
  const root = repo.workspace.resolve(destination); await fs.mkdir(path.dirname(root),{ recursive:true }); await fs.mkdir(root); let restored = 0;
  try {
    for (const entry of entries) {
      const target = repo.workspace.resolve(`${destination}/${entry.path}`);
      if (entry.type === 'dir') await fs.mkdir(target,{ recursive:true });
      else {
        await fs.mkdir(path.dirname(target),{ recursive:true }); const handle = await fs.open(target,'wx');
