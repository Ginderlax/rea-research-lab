    },
    {
      "id": "grafana.candidate.e5f02b5bdcd4b143ecc7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you enter a neutral value of `0`, the visualization looks like this and is easier to reason about:",
      "headingPath": [
        "Gauge",
        "Configuration options",
        "Gauge options",
        "Neutral value"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/gauge/index.md",
