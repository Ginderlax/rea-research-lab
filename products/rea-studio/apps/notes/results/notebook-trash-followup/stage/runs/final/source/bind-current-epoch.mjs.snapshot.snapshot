import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const root=fileURLToPath(new URL('./',import.meta.url)),repo=fileURLToPath(new URL('../../outputs/rea-research-lab/',import.meta.url)),relative='products/rea-studio/requirements/workspace-products.json',hash=b=>createHash('sha256').update(b).digest('hex'),old=await fs.readFile(path.join(root,'baseline',relative+'.snapshot')),current=await fs.readFile(path.join(repo,relative)),a=JSON.parse(old),b=JSON.parse(current);
assert.deepEqual(a.sources,b.sources);const core=row=>Object.fromEntries(['id','app','title','sourceIds','acceptanceGate','parityPassed'].map(k=>[k,row[k]]));assert.deepEqual(a.capabilities.map(core),b.capabilities.map(core));
const changedKeys=Object.keys(a).filter(k=>JSON.stringify(a[k])!==JSON.stringify(b[k])),capabilityEvidenceChanges=a.capabilities.filter((row,i)=>JSON.stringify(row)!==JSON.stringify(b.capabilities[i])).map(row=>({id:row.id,changedKeys:[...new Set([...Object.keys(row),...Object.keys(b.capabilities.find(r=>r.id===row.id))])].filter(k=>JSON.stringify(row[k])!==JSON.stringify(b.capabilities.find(r=>r.id===row.id)[k]))}));
await fs.mkdir(path.join(root,'epochs/current'),{recursive:true});await fs.writeFile(path.join(root,'epochs/current/workspace-products.json.snapshot'),current,{flag:'wx'});
const record={schema:'rea-notebook-trash-external-requirements-epoch/v1',boundAt:new Date().toISOString(),productionPath:relative,old:{path:'baseline/'+relative+'.snapshot',bytes:old.length,sha256:hash(old)},current:{path:'epochs/current/workspace-products.json.snapshot',bytes:current.length,sha256:hash(current)},sourceRows:a.sources.length,capabilityRows:a.capabilities.length,sourceRowsByteStructureEqual:true,capabilityCoreEqual:true,fullCapabilityRowsEqual:false,changedKeys,capabilityEvidenceChanges,stageChangedRequirements:false,authorization:'Parent authorized separate current requirements epoch after failed preflight; old evidence retained unchanged.'};await fs.writeFile(path.join(root,'epochs/current/epoch.json'),JSON.stringify(record,null,2)+'\n',{flag:'wx'});
await fs.writeFile(path.join(root,'failures/freeze-preflight-v1/diagnosis.json'),JSON.stringify({schema:'rea-tool-console-transcribed-failure/v1',exitCode:1,node:'v24.16.0',error:'AssertionError [ERR_ASSERTION]: products/rea-studio/requirements/workspace-products.json',actualSha256:'fcc9d9a4eac69a76621abe8830a48f61018600e8fde7c631004afd6a06aced29',expectedSha256:'446632e7a60da4450e79d78bc92a5e5aa589e606d1197df7cae24430679b9f16',location:'freeze.mjs:9:225',newTestsStarted:false,behaviorFailure:false,scope:'Read-only preflight before any final test or freeze artifact write; external requirements epoch changed. Exact failed freeze script is preserved. These error fields are transcribed from tool console, not claimed as captured raw stderr.'},null,2)+'\n',{flag:'wx'});
let text=await fs.readFile(path.join(root,'README.md'),'utf8');text=text.replace('Production and requirements are verified unchanged before and after the final focused run.','Production Notes and the selected shared host/storage/prior receipts are verified against the unchanged original baseline. Requirements changed externally while this stage was paused: `failures/freeze-preflight-v1` preserves the failed preflight and exact script, and `epochs/current` binds separate current bytes before the new final attempt. Old baseline bytes and all prior runs remain untouched. The final attempt verifies the new requirements epoch unchanged before/after, 48 source rows structurally exact and all 68 original capability core definitions unchanged; three notebook evidence/prose fields differ. This does not claim full capability rows or the old requirements file are current-byte identical.');text=text.replace('The strict preservation manifest covers baseline, original, failures, every historical run and final candidate/evidence.','A further preflight-only failure stopped before starting tests because the selected requirements file had changed externally; the old requirements snapshot, original failed script and transcribed console diagnosis remain separate from the authorized current epoch.\n\nThe strict preservation manifest covers baseline, original, failures, both requirements epochs, every historical run and final candidate/evidence.');await fs.writeFile(path.join(root,'README.md'),text);console.log(JSON.stringify(record,null,2));
