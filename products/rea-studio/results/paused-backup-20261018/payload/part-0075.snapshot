    {
      "id": "grafana.candidate.02a59b4fb52ebf5194e0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A typical PromQL expression for an alert rule to detect when a target becomes unreachable is:",
      "headingPath": [
