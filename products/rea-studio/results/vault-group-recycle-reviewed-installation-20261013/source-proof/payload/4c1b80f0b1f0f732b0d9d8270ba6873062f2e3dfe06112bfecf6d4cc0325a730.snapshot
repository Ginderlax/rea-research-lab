import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';import os from 'node:os';import path from 'node:path';import{randomBytes,createHash}from'node:crypto';import{fileURLToPath}from'node:url';import{spawn}from'node:child_process';
import{exportKdbx,materializeKdbxDocument,decodeKdbxDate}from'./kdbx.mjs';import{deleteRecycleGroup,restoreRecycleGroup,recycleGroupView}from'./recycle.mjs';import{one,nodes,text,put}from'./xml.mjs';import{fixture,edit,ids,now,restoreNow,selection,uuid64,findGroup}from'./group-fixture.mjs';
const here=path.dirname(fileURLToPath(import.meta.url)),password='Owned synthetic group original master',observations=[],sha=b=>createHash('sha256').update(b).digest('hex'),oracle=process.env.REA_KEEPASS_EXE;if(!oracle)throw new Error('REA_KEEPASS_EXE exact authenticated local release required.');
function decodeId(b64){const h=Buffer.from(b64,'base64').toString('hex');return h.slice(0,8)+'-'+h.slice(8,12)+'-'+h.slice(12,16)+'-'+h.slice(16,20)+'-'+h.slice(20);}
function ownRows(data){const xml=materializeKdbxDocument(data),groups=[],entries=[];function visit(g,parent){const id=decodeId(text(one(g,'UUID'))),t=one(g,'Times');groups.push({id,parent,previous:decodeId(text(one(g,'PreviousParentGroup'))||Buffer.alloc(16).toString('base64')),name:text(one(g,'Name')),notes:text(one(g,'Notes')),access:decodeKdbxDate(text(one(t,'LastAccessTime'))),modified:decodeKdbxDate(text(one(t,'LastModificationTime'))),location:decodeKdbxDate(text(one(t,'LocationChanged'))),usage:text(one(t,'UsageCount'))||'0'});for(const e of nodes(g,'Entry')){const row=data.entries.find(r=>r.id===decodeId(text(one(e,'UUID')))),times=one(e,'Times'),history=nodes(one(e,'History'),'Entry').map(h=>{const fields=new Map(nodes(h,'String').map(s=>[text(one(s,'Key')),text(one(s,'Value'))]));return{title:fields.get('Title'),password:fields.get('Password'),modified:decodeKdbxDate(text(one(one(h,'Times'),'LastModificationTime')))}});entries.push({id:row.id,parent:id,previous:decodeId(text(one(e,'PreviousParentGroup'))||Buffer.alloc(16).toString('base64')),title:row.title,password:row.password,access:decodeKdbxDate(text(one(times,'LastAccessTime'))),modified:decodeKdbxDate(text(one(times,'LastModificationTime'))),location:decodeKdbxDate(text(one(times,'LocationChanged'))),usage:text(one(times,'UsageCount'))||'0',history});}for(const c of nodes(g,'Group'))visit(c,id);}visit(one(one(xml,'Root'),'Group'),null);return{groups,entries,deleted:nodes(one(one(xml,'Root'),'DeletedObjects'),'DeletedObject').map(d=>({id:decodeId(text(one(d,'UUID'))),time:decodeKdbxDate(text(one(d,'DeletionTime')))})),binUuid:decodeId(text(one(one(xml,'Meta'),'RecycleBinUUID')))};}
async function original(t,data,operations,{save=false}={}){const originalBytes=await fs.readFile(oracle);assert.equal(sha(originalBytes),'04d29636c393f0c1fc99ff739295494be3adefded93271e44591e8e300225a5a');const directory=await fs.mkdtemp(path.join(os.tmpdir(),'rea-group-original-'));t.after(async()=>{assert.equal(path.dirname(directory),path.resolve(os.tmpdir()));assert(path.basename(directory).startsWith('rea-group-original-'));await fs.rm(directory,{recursive:true,force:true});});const buffer=await exportKdbx(data,{password},{kdf:'aes',aesRounds:100,compression:false}),database=path.join(directory,'synthetic.kdbx'),config={oracle,database,password,binId:ids.bin,operations,save};await fs.writeFile(database,buffer);await fs.writeFile(path.join(directory,'config.json'),JSON.stringify(config));const env={...process.env};delete env.NODE_TEST_CONTEXT;const child=spawn('powershell.exe',['-NoProfile','-NonInteractive','-File',path.join(here,'group-oracle.ps1'),'-Config',path.join(directory,'config.json')],{windowsHide:true,env}),chunks={stdout:[],stderr:[]},sizes={stdout:0,stderr:0};let problem;const timer=setTimeout(()=>{problem='Owned original child30s deadline';child.kill()},30000);for(const channel of ['stdout','stderr'])child[channel].on('data',b=>{sizes[channel]+=b.length;if(sizes[channel]>1024*1024){problem='Owned1MiB stream bound';child.kill()}else chunks[channel].push(b)});const exit=await new Promise(r=>child.on('close',(code,signal)=>r({code,signal})));clearTimeout(timer);const raw=Object.fromEntries(['stdout','stderr'].map(k=>[k,Buffer.concat(chunks[k]).toString('utf8')]));let value;try{value=JSON.parse(raw.stdout.trim())}catch{}const observation={input:{bytes:buffer.length,sha256:sha(buffer),kdbxVersion:buffer.readUInt32LE(8)},config:{...config,password:'synthetic fixture password; value omitted',database:'owned temporary synthetic.kdbx'},exit,problem:problem??null,raw,value:value??null,assemblyLoads:(raw.stderr.match(/REA_GROUP_ASSEMBLY_LOADED_2_61_1/g)||[]).length};observations.push(observation);await fs.mkdir(process.env.GROUP_OBSERVATIONS,{recursive:true});await fs.writeFile(path.join(process.env.GROUP_OBSERVATIONS,'group-original.json'),JSON.stringify(observations,null,2)+'\n');assert.equal(exit.code,0,raw.stderr);assert.equal(problem,undefined);assert(value,'Valid actual original observation');return value;}
function compare(data,original){const own=ownRows(data);assert.deepEqual(original.groups,own.groups);assert.deepEqual(original.entries,own.entries);assert.deepEqual(original.deleted,own.deleted);assert.equal(original.binUuid,own.binUuid);}
test('actual released group AddGroup/Touch/private bin helper matches recursive recycle then previous-parent restore',async t=>{const key=randomBytes(32),data=fixture(),g=selection(data,key),trashed=deleteRecycleGroup(data,g.id,g.recycleRevision,key,{confirm:true,now,binId:ids.bin}).data,first=await original(t,data,[{action:'delete',id:g.id,now}]);compare(trashed,first);const b=selection(trashed,key,g.id,true),restored=restoreRecycleGroup(trashed,b.id,b.recycleRevision,key,{confirm:true,now:restoreNow}).data,second=await original(t,data,[{action:'delete',id:g.id,now},{action:'restore',id:g.id,now:restoreNow}]);compare(restored,second);assert.equal(second.calls.privatePreviousParentGuard,1);assert.equal(second.calls.touch,1);});
test('actual DeleteAllObjects recursive tombstone ordering and disabled/permanent decisions match',async t=>{for(const disabled of [false,true]){const key=randomBytes(32),data=disabled?edit(fixture(),x=>put(one(x,'Meta'),'RecycleBinEnabled','False')):fixture(),g=selection(data,key),own=deleteRecycleGroup(data,g.id,g.recycleRevision,key,{confirm:true,now,permanent:!disabled}).data,actual=await original(t,data,[{action:'delete',id:g.id,now,permanent:!disabled}]);compare(own,actual);assert.equal(actual.calls.deleteAllObjects,1);}});
test('actual released root and previous-self/subtree/missing/zero guards agree with bounded refusal',async t=>{const key=randomBytes(32),data=fixture(),root=selection(data,key,ids.root),actualRoot=await original(t,data,[{action:'delete',id:ids.root,now}]);assert.equal(actualRoot.operations[0].refused,true);assert.throws(()=>deleteRecycleGroup(data,root.id,root.recycleRevision,key,{confirm:true,now}),/root/);const g=selection(data,key),trashed=deleteRecycleGroup(data,g.id,g.recycleRevision,key,{confirm:true,now,binId:ids.bin}).data;for(const previous of [ids.target,ids.deep,'eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee','00000000-0000-0000-0000-000000000000']){const bad=edit(trashed,x=>{const group=nodes(nodes(one(one(x,'Root'),'Group'),'Group').find(n=>text(one(n,'UUID'))===uuid64(ids.bin)),'Group')[0];put(group,'PreviousParentGroup',uuid64(previous))}),b=selection(bad,key,g.id,true),actual=await original(t,bad,[{action:'restore',id:g.id,now:restoreNow}]);assert.equal(actual.operations[0].refused,true);assert.throws(()=>restoreRecycleGroup(bad,b.id,b.recycleRevision,key,{confirm:true,now}),/previous parent/);}});
test('candidate moved group KDBX4.1 is read by original with previous parent/history retained; original save representation remains explicit',async t=>{const key=randomBytes(32),data=fixture(),g=selection(data,key),trashed=deleteRecycleGroup(data,g.id,g.recycleRevision,key,{confirm:true,now,binId:ids.bin}).data,actual=await original(t,trashed,[],{save:true});compare(trashed,actual);assert.equal(actual.version,0x00040001);assert.equal(actual.calls.saveDatabase,1);});
test('released default-feature writer downgrades to4.0 and loses group previous-parent after reopen',async t=>{const key=randomBytes(32),clean=edit(fixture(),x=>{function visit(g){for(const e of nodes(g,'Entry'))put(e,'QualityCheck','True');for(const c of nodes(g,'Group'))visit(c)}visit(one(one(x,'Root'),'Group'))}),g=selection(clean,key),trashed=deleteRecycleGroup(clean,g.id,g.recycleRevision,key,{confirm:true,now,binId:ids.bin}).data,actual=await original(t,trashed,[],{save:true});assert.equal(actual.version,0x00040000);assert.equal(actual.groups.find(r=>r.id===ids.target).previous,'00000000-0000-0000-0000-000000000000');assert.equal(ownRows(trashed).groups.find(r=>r.id===ids.target).previous,ids.parent);});
test('released bin child/bin itself/bin-containing ancestor all use permanent recursive purge',async t=>{for(const chosen of [ids.target,ids.bin,ids.parent]){const key=randomBytes(32),initial=fixture(),g=selection(initial,key),trashed=deleteRecycleGroup(initial,g.id,g.recycleRevision,key,{confirm:true,now,binId:ids.bin}).data,data=chosen===ids.parent?edit(trashed,x=>{const root=findGroup(x,ids.root),parent=findGroup(x,ids.parent),bin=findGroup(x,ids.bin);root.children=root.children.filter(n=>n!==bin);parent.children.push(bin)}):trashed,selected=selection(data,key,chosen,chosen!==ids.parent),own=deleteRecycleGroup(data,selected.id,selected.recycleRevision,key,{confirm:true,now:restoreNow}).data,actual=await original(t,data,[{action:'delete',id:chosen,now:restoreNow}]);compare(own,actual);assert.equal(actual.operations[0].permanent,true);}});
