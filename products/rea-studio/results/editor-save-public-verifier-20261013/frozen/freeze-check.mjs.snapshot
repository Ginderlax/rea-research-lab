import fs from 'node:fs/promises';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
const here = import.meta.dirname;
const sha = b => createHash('sha256').update(b).digest('hex');
const inventory = {};
for (const e of (await fs.readdir(here, { withFileTypes: true })).sort((a,b) => a.name.localeCompare(b.name))) {
  assert(e.isFile() && !e.isSymbolicLink());
  assert.notEqual(e.name, 'freeze-manifest.json');
  const b = await fs.readFile(path.join(here, e.name));
  inventory[e.name] = { bytes: b.length, sha256: sha(b) };
}
const receipt = await fs.readFile(path.join(here, 'validation.json'));
const manifest = { schema: 'rea-editor-save-public-verifier-installed-freeze/v1', frozenAt: new Date().toISOString(), files: Object.keys(inventory).length, totalBytes: Object.values(inventory).reduce((n,r) => n+r.bytes, 0), receiptSHA256: sha(receipt), inventory, immutableHistorical43: true, immutableHistorical21: true };
const payload = Buffer.from(JSON.stringify(manifest, null, 2) + '\n');
await fs.writeFile(path.join(here, 'freeze-manifest.json'), payload, { flag: 'wx' });
for (const [rel,r] of Object.entries(inventory)) { const b = await fs.readFile(path.join(here, rel)); assert.deepEqual({ bytes: b.length, sha256: sha(b) }, r); }
console.log(JSON.stringify({ files: manifest.files, receiptSHA256: manifest.receiptSHA256, manifestSHA256: sha(payload), verifier: JSON.parse(receipt).verifier }));
