    {
      "id": "grafana.candidate.f566aafe75bdf5e72d3a",
      "syntaxRole": "table-row",
      "sourceText": "| Stacking                         | Controls bar chart stacking. Choose from: <ul><li>**Off**: Bars will not be stacked.</li><li>**Normal**: Bars will be stacked on each other.</li><li>**100%**: Bars will be stacked on each other, and the height of each bar is the percentage of the total height of the stack.</li></ul> |",
      "headingPath": [
        "Bar chart",
        "Configuration options",
        "Bar chart options"
      ],
