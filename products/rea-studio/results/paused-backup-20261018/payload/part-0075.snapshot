    {
      "id": "grafana.candidate.2c3114594eedd67db8c2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Git Sync supports two sync targets: `target: folder` (the default) creates a folder named after the repository and places synced resources inside it, while `target: folderless` places synced resources at the top level without creating a wrapper folder. Refer to [Sync targets](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/as-code/observability-as-code/git-sync/key-concepts/#sync-targets) for details.",
      "headingPath": [
        "Set up Git Sync as code",
        "Create the resources CRDs",
        "Create the repository resource"
      ],
