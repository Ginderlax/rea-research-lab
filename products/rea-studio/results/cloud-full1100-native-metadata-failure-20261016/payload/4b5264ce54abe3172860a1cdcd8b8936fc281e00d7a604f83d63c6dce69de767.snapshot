const authorityBytes=Buffer.from(JSON.stringify(authority,null,2)+'\n');fs.writeFileSync(path.join(stage,'copy-authority.json'),authorityBytes,{flag:'wx'});console.log(JSON.stringify({stage,files:rows.length,bytes,roles:records.length,authority:id(authorityBytes),manifest:id(manifestBytes),localProductExecutions:0}));
