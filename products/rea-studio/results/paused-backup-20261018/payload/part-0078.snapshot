    },
    {
      "id": "grafana.candidate.fae6a6ddaf39c4c746eb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When working with data sources that support a full range logs volume, Explore automatically displays a graph showing the log distribution for all submitted log queries. This feature is currently supported by the Elasticsearch and Loki data sources.",
      "headingPath": [
        "Logs in Explore",
        "Logs volume"
