    {
      "id": "grafana.candidate.6d70deea0a4df2e1b1bc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Listen IP address and port to receive unified alerting messages for other Grafana instances. The port is used for both TCP and UDP. It is assumed other Grafana instances are also running on the same port. The default value is `0.0.0.0:9094`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[unified_alerting]`",
        "`ha_listen_address`"
      ],
      "source": {
