    {
      "id": "grafana.candidate.717cd85dacdd1e7810f8",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Add [two API actions](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/aws-cloudwatch/configure/#cross-account-observability-permissions) to the IAM policy attached to the role/user running the plugin.",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Cross-account observability"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/query-editor/index.md",
