    },
    {
      "id": "grafana.candidate.3e2c1c89822089fe18a0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This setting applies to `sqlite` only and controls the number of times the system retries a query when the database is locked. The default value is `0` (disabled).",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[database]`",
        "`query_retries`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
