assert.equal(post.schema,'rea-bsdtar-oracle-hosted-postrun-source-check/v1');assert.equal(post.sourceStable,true);assert.equal(post.checkedTargets,3);assert.equal(post.baselineGitCommit,tested);assert.equal(post.compositionSHA256,id(compositionBytes).sha256);assert.deepEqual(post.currentTargets,composition.currentTargets);
