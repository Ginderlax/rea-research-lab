      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.7888162bb348e872ac23",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This produces a safely quoted string (for example, `'server01'`) regardless of panel type or context. For multi-value variables, use `IN` with `${var:sqlstring}`:",
      "headingPath": [
        "MySQL template variables",
        "Use variables in queries",
        "Use explicit quoting for string variables"
