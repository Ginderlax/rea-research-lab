        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.60cafe097193ed00caf3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Depending on your OS, your custom configuration file is either the `<WORKING DIRECTORY>/conf/custom.ini` file or the `/usr/local/etc/grafana/grafana.ini` file. You can use a custom configuration path with the `--config` option.",
      "headingPath": [
        "Configure Grafana",
        "Configuration file location"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 38,
        "lineEnd": 39,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L38-L39"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.d987875d8e1ed9fece42",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you installed Grafana using the deb or RPM packages, then your configuration file is located at `/etc/grafana/grafana.ini` and a separate `custom.ini` is not used. This path is specified in the Grafana init.d script using `--config` option.",
      "headingPath": [
        "Configure Grafana",
        "Configuration file location",
        "Linux"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
