    },
    {
      "id": "grafana.candidate.5034c94beed503f3dc35",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Cross-account querying is available in the plugin through the **Logs**, **Metric search**, and **Metric Insights** modes. After you have configured it, you'll see a **Monitoring account** badge in the query editor header.",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Cross-account observability"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/query-editor/index.md",
        "gitBlobSha": "ef7df40715eb7f51a378b68c41c217a24bf2e54e",
        "sha256": "2fe99ed2b68f84a70ad35679bb7e67dc68175a40df0b6cabd0948aff1ccd7f23",
        "lineStart": 375,
        "lineEnd": 376,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/aws-cloudwatch/query-editor/index.md#L375-L376"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.7b1d1440f86b524c76ee",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you enable [query and resource caching](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/administration/data-source-management/#query-and-resource-caching), Grafana temporarily stores the results of data source queries and resource requests. Query caching is available in CloudWatch Metrics in Grafana Cloud and Grafana Enterprise. It is not available in CloudWatch Logs Insights due to how query results are polled from AWS.",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Query caching"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/query-editor/index.md",
        "gitBlobSha": "ef7df40715eb7f51a378b68c41c217a24bf2e54e",
        "sha256": "2fe99ed2b68f84a70ad35679bb7e67dc68175a40df0b6cabd0948aff1ccd7f23",
        "lineStart": 382,
        "lineEnd": 382,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/aws-cloudwatch/query-editor/index.md#L382-L382"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
