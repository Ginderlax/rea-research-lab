    {
      "id": "grafana.candidate.6389c144eb7f327b5c19",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This document provides solutions to common issues you may encounter when configuring or using the Amazon CloudWatch data source. For configuration instructions, refer to [Configure CloudWatch](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/aws-cloudwatch/configure/).",
      "headingPath": [
        "Troubleshoot Amazon CloudWatch data source issues"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/troubleshooting/index.md",
        "gitBlobSha": "beaeae2cfe415b08e86f250d421cb38d035fbede",
