    {
      "id": "grafana.candidate.805628fe161927ee9756",
      "syntaxRole": "list-item",
      "sourceText": "- A separate unidirectional stream between Grafana and backend data source opens on different Grafana servers. Publishing data to a channel delivers messages to instance subscribers, as a result, publications from different instances on different machines do not produce duplicate data on panels.",
      "headingPath": [
        "Set up Grafana Live",
        "Configure Grafana Live HA setup",
        "Configure Redis Live engine"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/set-up-grafana-live.md",
        "gitBlobSha": "0aa7adff7477bf1c9cc08fa8d9bf3408b5a587b2",
