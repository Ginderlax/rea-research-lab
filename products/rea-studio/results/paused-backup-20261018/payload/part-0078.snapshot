    {
      "id": "grafana.candidate.4b9b7a824d2a8740fc9e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Your Grafana Cloud stack comes with several default dashboards in the **Grafana Cloud** folder in **Dashboards**. If you're running your own installation of Grafana, you can find more example dashboards in the `public/dashboards/` directory.",
      "headingPath": [
        "Import dashboards",
        "More examples"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/build-dashboards/import-dashboards/index.md",
        "gitBlobSha": "516fd41633a76b745dbdbe187f0e4c982274c1ac",
