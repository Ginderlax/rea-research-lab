def finite_results(bundle,attempt):
 raw=content('finite-stdout.txt').decode();summary={}
 for key in('tests','pass','fail','cancelled','skipped','todo'):
  rows=re.findall(r'^# '+key+r' (\d+)\r?$',raw,re.M);assert len(rows)==1;summary[key]=int(rows[0])
 assert summary=={'tests':111,'pass':111,'fail':0,'cancelled':0,'skipped':0,'todo':0}and attempt['productTests']==111
