    },
    {
      "id": "grafana.candidate.32f0653cb71897869c3c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The **RefID** is a unique identifier assigned to each query within a Grafana panel that serves as a reference name for that query's data.",
      "headingPath": [
        "SQL expressions",
        "Create SQL expressions"
      ],
      "source": {
