    },
    {
      "id": "grafana.candidate.01ea58fbe4a4715c2dee",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Select **Error with source** and choose the error type:",
      "headingPath": [
        "TestData alerting",
        "Test error and no-data conditions",
        "Errors"
      ],
