    {
      "id": "grafana.candidate.77c8f92f22f32a9a09f9",
      "syntaxRole": "table-row",
      "sourceText": "| IAM role lacks permissions in the queried region | AWS evaluates permissions per region. If your role only has CloudWatch access in some regions, querying another region returns `AccessDenied`, and the error might not name the region. Set the data source **Default Region** to a region where your role has permissions, and only query regions your IAM policy allows.                                                                                                            |",
      "headingPath": [
        "Troubleshoot Amazon CloudWatch data source issues",
        "Authentication errors",
        "\"Access Denied\" or \"Not authorized to perform this operation\""
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/troubleshooting/index.md",
        "gitBlobSha": "beaeae2cfe415b08e86f250d421cb38d035fbede",
        "sha256": "79b4e209733bce22ae7957e88f953312e123bcebdda66984b637a9800c34625b",
