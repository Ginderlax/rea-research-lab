    {
      "id": "grafana.candidate.781d0f076c5818ae3ad3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For example, if you want to only give access to members of the tenant `example` with an ID of `8bab1c86-8fba-33e5-2089-1d1c80ec267d`, then set the following:",
      "headingPath": [
