import fs from 'node:fs/promises';import path from 'node:path';import {spawnSync} from 'node:child_process';import {here,sha} from './authenticate-original.mjs';
const kind=process.argv[2]??'format',source=await fs.readFile(path.join(here,'freeze-stage.mjs')),records=[];for(const [label,args]of [['freeze',[]],['verify-only',['--verify-only']]]){const child=spawnSync(process.execPath,[path.join(here,'freeze-stage.mjs'),...args],{windowsHide:true,encoding:'utf8',timeout:30000,maxBuffer:1024*1024}),stem='results/metadata-freeze-'+kind+'-'+label;for(const [suffix,data]of [['.source.mjs.snapshot',source],['.stdout.txt',child.stdout??''],['.stderr.txt',child.stderr??'']])await fs.writeFile(path.join(here,stem+suffix),data,{flag:'wx'});records.push({label,exitCode:child.status,sourceSHA256:sha(source),stdoutSHA256:sha(child.stdout??''),stderrSHA256:sha(child.stderr??'')});}await fs.writeFile(path.join(here,'results/metadata-freeze-'+kind+'-failure.json'),JSON.stringify({origin:'Initial direct tool failures were not automatically captured. These are exact unchanged-source captured replays before correction; verify-only replay repeats the same pre-freeze guard.',records,candidateChanged:false,semanticTestsStillPassed:true},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(records));
