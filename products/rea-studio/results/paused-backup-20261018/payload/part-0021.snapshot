(S/'change-authority.json').write_text(json.dumps(authority,indent=2)+'\n',encoding='utf8')
print(json.dumps({'stage':str(S),'before':ident(before),'after':ident(after),'authority':ident((S/'change-authority.json').read_bytes())}))
"""Copy recorded portable Notes8 evidence to a work-only public proposal."""
import gzip
import hashlib
import json
from pathlib import Path

work = Path(__file__).resolve().parent
stage = work / 'public-notes-browser8-first-pass-next'
relative = 'products/rea-studio/results/cloud-notes-todo-browser-first-pass-20261016'
destination = stage / 'candidate' / relative
destination.mkdir(parents=True, exist_ok=False)
payload = destination / 'payload'
payload.mkdir()
backup = work / 'cloud-verification-backups/run-38908759571'
readback = backup / 'artifact-12049048068-reader-v2'
evidence = readback / 'readable-evidence'
hash_bytes = lambda b: hashlib.sha256(b).hexdigest()
identity = lambda b: {'bytes': len(b), 'sha256': hash_bytes(b)}
read_json = lambda p: json.loads(p.read_text(encoding='utf-8-sig'))
write_json = lambda p, value: p.write_text(json.dumps(value, indent=2) + '\n', encoding='utf-8')
verification = read_json(readback / 'local-notes-browser-backup-verification.json')
assert verification['allCRCAndBytesReadable'] is True and verification['auditErrors'] == []
assert verification['recordedEightScenarioNotesGatesConsistent'] is True
assert len(verification['files']) == 467 and verification['sourceSnapshotFilesVerified'] == 383
assert verification['attempt']['sourceCommit'] == 'f61cb2ee1969b5fc4059f4e20961526d0594c519'
roles = []


def retain(role, source, expected=None, origin=None):
    data = source.read_bytes()
    plain = identity(data)
    if expected:
        assert plain == expected
    compressed = len(data) >= 16 * 1024 and not data.startswith((b'PK\x03\x04', b'\x89PNG\r\n\x1a\n'))
    stored = gzip.compress(data, mtime=0) if compressed else data
    name = 'payload/' + plain['sha256'] + ('.gz.snapshot' if compressed else '.snapshot')
    target = destination / name
    if target.exists():
        assert target.read_bytes() == stored
    else:
        with target.open('xb') as stream:
            stream.write(stored)
    decoded = gzip.decompress(target.read_bytes()) if compressed else target.read_bytes()
    assert decoded == data
    roles.append({'role': role, 'path': name, 'encoding': 'gzip' if compressed else 'raw',
                  'decoded': plain, 'stored': identity(stored), 'origin': origin or str(source.relative_to(work)).replace('\\', '/')})
    return plain


retain('complete-github-artifact-outer-zip', backup / 'artifact-12049048068.zip',
       {'bytes': 2011834, 'sha256': 'e1686da1bf3e082e761873476e757a6523ea3848c1797f7da6b0796b72d16fe2'})
# All artifact members remain inside the exact original portable ZIP. Every
# non-census role is also directly readable without unpacking that ZIP.
direct = []
for row in verification['files']:
    if row['path'].startswith('source/'):
        continue
    retain('artifact/' + row['path'], evidence / row['path'],
           {'bytes': row['bytes'], 'sha256': row['sha256']}, 'GitHub artifact member: ' + row['path'])
    direct.append(row['path'])
assert len(direct) == 84
for name in ('run', 'jobs', 'artifacts'):
    retain('raw-control-plane/' + name + '.json', backup / 'control-plane-evidence' / (name + '.json'))
retain('raw-job-log', work / 'cloud-verification-backups/job-116998951515/logs.txt',
       {'bytes': 57233, 'sha256': '49c6aac7b1d33656cd12dd7ca05d52685751ae1c66f218a586f77d5ea018f942'})
for version in ('v1', 'v2'):
    retain('backup-reader-' + version, work / ('unpack-notes-browser-run-38908759571-' + version + '.py'))
    retain('exact-run-collector-' + version, work / ('collect-readonly-notes-browser-run-38908759571-' + version + '.mjs'))
retain('initial-backup-reader-v1-report', backup / 'artifact-12049048068/local-notes-browser-backup-verification.json')
retain('completed-backup-reader-v2-report', readback / 'local-notes-browser-backup-verification.json',
       {'bytes': 129863, 'sha256': '859eeeaee3d90d295b45d08e6c6de8ab4a9de9efa34405588090a5cf9f71ee31'})
for filename in ('collection-download-summary.json', 'collection-summary.json', 'collection-summary-v2.json'):
    retain('local-collection/' + filename, backup / filename)
retain('reviewed-source-authority', work / 'notes-todo-browser-next/change-authority.json',
       {'bytes': 9951, 'sha256': '49eedb33f8b4c27b28c31eba70165ddb169b589f92203a3b619f687f872da888'})
retain('independent-complete-source-review', work / 'notes-todo-browser-independent-source-review-20261016.json',
       {'bytes': 7666, 'sha256': '493bcfc0f25d039f488b50e48c9ee976cd139f3a8184e368236cf09103173bb1'})
retain('archive-reader-precopy-investigation', work / 'notes-todo-browser-next/archive-proof-precopy-investigation.json',
       {'bytes': 5851, 'sha256': '9e9ff270e483da1d6226e7b3afc70d179c7290172dd106c01cc7c92b9ed85037'})
# Retain the already-public pinned input binary too. This is an exact source
# backup read, not a claim that this local copy participated in the cloud run.
retain('independent-readback-reference-original-jex', work.parent / 'outputs/rea-research-lab/products/rea-studio/apps/notes/fixtures/pinned-joplin.jex',
       {'bytes': 9728, 'sha256': '044885c906ba7d8cb97a95fbdd6bc2323ba31a3c301e7ed1d6e592acec8944af'},
       'Current readable copy of public pinned fixture; exact reviewed byte identity, not historical run provenance.')
source_inventory = [row for row in verification['files'] if row['path'].startswith('source/')]
write_json(destination / 'artifact-inventory.json', {'schema': 'rea-notes8-complete-artifact-inventory/v1',
    'runId': '38908759571', 'artifactId': '12049048068', 'files': verification['files'],
    'totalFiles': 467, 'sourceSnapshots': 383, 'directArtifactRolePaths': direct,
    'sourceSnapshotOmissions': [], 'allMembersRetainedInExactPortableZip': True,
    'looseCensusCopiesDeduplicatedIntoZip': source_inventory,
    'meaning': 'No artifact member is omitted. Census copies are inside the retained exact ZIP;84 other members also have direct content-addressed payload roles.'})
summary = {'schema': 'rea-notes8-first-real-browser-success/v1', 'sourceCommit': verification['sourceCommit'],
    'runId': '38908759571', 'runAttempt': '1', 'jobId': '116998951515', 'artifactId': '12049048068',
    'url': 'https://github.com/Ginderlax/rea-research-lab/actions/runs/38908759571',
    'repository': 'Ginderlax/rea-research-lab', 'runtime': {'executor': 'GitHub-hosted', 'os': 'windows-2022',
        'node': '24.16.0', 'playwright': '1.64.1', 'chromium': '156.0.8078.4'},
    'actualSummary': verification['attempt']['summary'], 'firstActualHostedAttempt': True,
    'sourceAuthentication': verification['sourceAuthentication'],
    'sourceCaptureStable': True, 'sourceSnapshotsReadable': 383, 'artifactMembersReadable': 467,
    'realHolds': verification['realHoldsVerified'], 'realDownloads': verification['realDownloadsVerified'],
    'pngs': verification['pngCRCReadbacks'], 'ownedFinalDiskRecords': verification['ownedSyntheticDiskRecordsVerified'],
    'ownedCleanupRecords': verification['ownedCleanupRecordsVerified'], 'scenarioObservations': verification['scenarioObservations'],
    'independentTarReadback': verification['independentTarReadback'], 'composerPostcheck': verification['composerPostcheckVerified'],
    'browserPostcheck': verification['browserPostcheckVerified'], 'gzipMembersInOriginalArtifact': 0,
    'backupReaderCorrection': {'v1Status': 'backup audit incomplete; raw467 file readability preserved',
        'cause': 'Composer stores the non-snapshot README.txt payload as bundle/README.txt.snapshot; reader v1 initially sought bundle/README.txt.',
        'v2Change': 'Exact stored-name mapping plus new output directory/schema. Both scripts and reports retained.',
        'hostedProductReruns': 0, 'historicalEvidenceModified': False, 'v2AuditErrors': []},
    'publicationScope': 'Finite Notes source-composition browser experiment only. Source remains inert until separately reviewed installation and proof integration.',
    'productionInstalled': False, 'originalFullApplicationExecutions': 0, 'newOriginalHelperExecutions': 0,
    'originalGuiComparisonSessions': 0, 'programmaticDisabledControlProbes': 0,
    'browserMatrixEstablished': False, 'fullSuiteEstablishedByThisRun': False, 'securityAcceptance': False,
    'fullParity': False, 'superiority': False, 'localProductExecutions': 0, 'localTests': 0, 'localBuilds': 0}
write_json(destination / 'evidence-summary.json', summary)
manifest = {'schema': 'rea-notes8-public-preservation-manifest/v1', 'sourceCommit': verification['sourceCommit'],
    'runId': '38908759571', 'roles': roles, 'roleCount': len(roles),
    'all467ArtifactMembersPreserved': True, 'sourceSnapshotOmissions': [],
    'rawApiAndLogsPreserved': True, 'backupReaderV1FailurePreserved': True,
    'productionInstalled': False, 'historicalReceiptsRebound': False,
    'encodingRule': 'Content-address uses decoded SHA-256. gzip roles store deterministic mtime0 gzip bytes; stored and decoded identities are both explicit.',
    'scope': 'Preserved actual finite experiment and backup-only audit records. No Notes installation, full parity or superiority claim.'}
write_json(destination / 'preservation-manifest.json', manifest)
readme = '''# Notes: first eight real Chromium scenarios

Run [38908759571](https://github.com/Ginderlax/rea-research-lab/actions/runs/38908759571), attempt1, tested commit `f61cb2ee1969b5fc4059f4e20961526d0594c519` on standard GitHub-hosted Windows, Node24.16 and Chromium156.0.8078.4.

All8 cases passed without skips, retries or flaky outcomes. They cover ordinary task conversion, completion, millisecond due metadata and filters; dirty-draft refusal before transport; actual-response timing after real disk commits; newer editor ownership and navigation disposal; a genuineHTTP400 revision conflict followed by explicit reopen/retry; and actualJEX/resource browser downloads. Four original successful host responses were delayed without rewriting them. Eight PNGs, eight synthetic final records and eight complete owned cleanup records are preserved.

The complete exact artifactZIP retains all467 members, including383 source snapshots. Every84 non-census artifact member also has a direct content-addressed role. Raw GitHubAPI records, the actual job log, both source postchecks, original reader/report versions and independent source review are included. `preservation-manifest.json` maps roles to payloads; raw roles decode directly, gzip roles decode with standard gzip. Decoded and stored hashes are explicit. `artifact-inventory.json` records every archive member. No source artifact member is omitted.

Backup reader v1 stopped at the composer's README snapshot naming convention after successfully preserving all467 readable members. Version2 corrects that backup-only path mapping, preserves v1, and reports no audit errors. This caused no product rerun or change to hosted evidence. Standard-library byte-onlyTAR readback independently checked eight entries, six unchanged original serialized records and the exact five-byte resource.

This is finite real-browser evidence for the exact eight-target ephemeral Notes composition. Notes is not installed by this capsule. No original full application or GUI ran in this campaign; it adds zero original helper executions. The pinned serializedJEX input retains its separately documented historical serializer/stub boundary. This result does not establish a browser matrix, full-suite acceptance, security, full parity or superiority.
'''
(destination / 'README.md').write_text(readme, encoding='utf-8')
candidate_files = []
for filename in sorted(destination.rglob('*')):
    if filename.is_file():
        data = filename.read_bytes()
        candidate_files.append({'path': str(filename.relative_to(stage / 'candidate')).replace('\\', '/'),
                                'before': None, 'after': identity(data)})
authority = {'schema': 'rea-work-only-notes8-capsule-copy-authority/v1', 'candidateRoot': str(stage / 'candidate'),
    'testedSourceCommit': verification['sourceCommit'], 'runId': '38908759571',
    'targetRoot': relative, 'files': candidate_files, 'candidateFileCount': len(candidate_files),
    'candidateBytes': sum(row['after']['bytes'] for row in candidate_files),
    'allTargetsAreAdditions': True, 'activeSourceMutationsByAuthor': 0, 'gitMutationsByAuthor': 0,
    'localProductExecutions': 0, 'localTests': 0, 'localBuilds': 0,
    'productionInstalled': False, 'fullParity': False, 'superiority': False}
write_json(stage / 'copy-authority.json', authority)
for role in roles:
    data = (destination / role['path']).read_bytes()
    assert identity(data) == role['stored']
    assert identity(gzip.decompress(data) if role['encoding'] == 'gzip' else data) == role['decoded']
print(json.dumps({'authority': str(stage / 'copy-authority.json'), **identity((stage / 'copy-authority.json').read_bytes()),
    'candidateFiles': len(candidate_files), 'candidateBytes': authority['candidateBytes'], 'roleCount': len(roles),
    'uniquePayloads': len(list(payload.iterdir())), 'directArtifactRoles': len(direct), 'omittedArtifactMembers': 0}))
