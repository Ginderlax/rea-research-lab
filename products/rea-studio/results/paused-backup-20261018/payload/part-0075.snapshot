    {
      "id": "grafana.candidate.8217dc32b921244adffe",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Click **View in CloudWatch console** to interactively view, search, and analyze your log data in the CloudWatch Logs Insights console. If you're not logged in to the CloudWatch console, the link forwards you to the login page.",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Query CloudWatch Logs",
        "Specify Amazon CloudWatch Logs data sources to query"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/query-editor/index.md",
