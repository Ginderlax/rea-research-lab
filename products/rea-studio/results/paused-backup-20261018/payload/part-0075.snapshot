    {
      "id": "grafana.candidate.0df5b3a14b772cc4883b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Create new time series metrics using mathematical functions on CloudWatch metrics. This supports arithmetic operators, unary subtraction, and other functions. For available functions, refer to [AWS Metric Math](https://docs.aws.amazon.com/AmazonCloudWatch/latest/monitoring/using-metric-math.html).",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Query CloudWatch metrics",
        "Metric Search queries",
        "Use metric math expressions"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/query-editor/index.md",
        "gitBlobSha": "ef7df40715eb7f51a378b68c41c217a24bf2e54e",
        "sha256": "2fe99ed2b68f84a70ad35679bb7e67dc68175a40df0b6cabd0948aff1ccd7f23",
        "lineStart": 164,
        "lineEnd": 164,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/aws-cloudwatch/query-editor/index.md#L164-L164"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
