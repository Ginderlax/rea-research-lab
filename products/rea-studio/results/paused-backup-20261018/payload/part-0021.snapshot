export function emptyRecycleBinPreview(data,key){
  const m=model(data);if(!m.bin)return {enabled:m.enabled,hasBin:false,id:null,revision:null,groupCount:0,entryCount:0,groups:[],entries:[],preservesBin:true,permanent:true};
  const members=groupMembers(m,m.bin),rows=new Map(m.projected.map(row=>[row.id,row]));
  return {enabled:m.enabled,hasBin:true,id:m.bin.id,name:text(one(m.bin.node,'Name',true)),revision:emptyBinToken(m,data,key),groupCount:members.groups.length-1,entryCount:members.entries.length,
    groups:members.groups.filter(g=>g!==m.bin).map(g=>({id:g.id,parentId:g.parent.id,name:text(one(g.node,'Name',true))})),
    entries:members.entries.map(e=>{const row=rows.get(e.id);return {id:e.id,parentId:e.parent.id,title:row.title,username:row.username,url:row.url};}),preservesBin:true,permanent:true};
}
export function emptyNativeRecycleBin(data,id,revision,key,{confirm=false,now=new Date().toISOString()}={}){
  if(confirm!==true)throw new Error('Emptying the recycle bin permanently requires confirmation.');
  uuid64(id);const m=model(data);if(!m.bin||m.bin.id!==id)throw new Error('The recycle bin is unavailable or changed.');
  if(typeof revision!=='string'||!/^\u005b0-9a-f\u005d{64}$/.test(revision)||!timingSafeEqual(Buffer.from(revision,'hex'),Buffer.from(emptyBinToken(m,data,key),'hex')))throw new Error('Recycle-bin contents changed; preview the bin again.');
  const encoded=clock(now),members=groupMembers(m,m.bin),groupCount=members.groups.length-1,entryCount=members.entries.length,needed=groupCount+entryCount;
  let deleted=one(m.root,'DeletedObjects');if((deleted?nodes(deleted,'DeletedObject').length:0)+needed>MAX_DELETED)throw new Error('Recycle tombstone limit exceeded.');
  if(needed){if(!deleted){deleted=element('DeletedObjects');m.root.children.push(deleted);}
    const append=value=>deleted.children.push(element('DeletedObject',[element('UUID',value),element('DeletionTime',encoded)]));
    function erase(node){for(const entry of nodes(node,'Entry'))append(text(one(entry,'UUID',true)));for(const child of nodes(node,'Group')){erase(child);append(text(one(child,'UUID',true)));}}
    erase(m.bin.node);m.bin.node.children=m.bin.node.children.filter(node=>typeof node==='string'||!['Entry','Group'].includes(node.name));
  }
