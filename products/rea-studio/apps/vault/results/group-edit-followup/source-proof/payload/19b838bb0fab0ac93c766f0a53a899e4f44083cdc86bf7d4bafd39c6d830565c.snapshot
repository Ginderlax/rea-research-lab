import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{spawn}from'node:child_process';
const here=import.meta.dirname,work=path.resolve(here,'..'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),json=v=>Buffer.from(JSON.stringify(v,null,2)+'\n'),run='runs/focused-'+new Date().toISOString().replace(/[:.]/g,'-'),root=path.join(here,run);async function save(p,b){await fs.mkdir(path.dirname(path.join(root,p)),{recursive:true});await fs.writeFile(path.join(root,p),b,{flag:'wx'});}
const selections=[['independent-six','regression/draft-boundaries.test.mjs','Unchanged independent6 bodies; import-only fixture adapter'],['independent-five','regression/adjacent.test.mjs','Unchanged independent5 adjacent bodies; import-only fixture adapter'],['new-controls','regression/correction-controls.test.mjs','New author correction controls, not independent acceptance'],['prior343-root-six','products/rea-studio/apps/vault/group-active-root-replay.test.mjs','Existing root6 body replay; not new independence'],['prior343-coherence','products/rea-studio/apps/vault/group-coherence-boundaries.test.mjs','Existing bounded coherence regression'],['prior343-active','products/rea-studio/apps/vault/group-active-controls.test.mjs','Existing active-list regression']];
async function references(){const records=[];for(const[folder,file,pin,count]of[['vault-group-edit-next','manifest.json','52a88d027dc910c3ef8723e80690aef98dacdc9c98d43902192663ca43799ff4',885],['vault-group-edit-independent-review','review-manifest.json','65dbe05edf39e3625833f828fcad760b577d6fb0f3c4b6d8826379b6b1dbbc93',78]]){const raw=await fs.readFile(path.join(work,folder,file));assert.equal(id(raw).sha256,pin);const m=JSON.parse(raw);assert.equal(m.inventory.length,count);for(const r of m.inventory)assert.deepEqual(id(await fs.readFile(path.join(work,folder,r.path))),{bytes:r.bytes,sha256:r.sha256});records.push({folder,file,...id(raw),payloads:count});}return records;}
const refsBefore=await references();await save('references-before.json',json(refsBefore));const roster=JSON.parse(await fs.readFile(path.join(here,'copied-source-roster.json'))),client=JSON.parse(await fs.readFile(path.join(here,'client-deltas.json'))).after,sourcePaths=[...roster.map(r=>r.path),'regression/draft-boundaries.test.mjs','regression/adjacent.test.mjs','regression/ui-fixture.mjs','regression/correction-controls.test.mjs','prepare.mjs','collect-focused.mjs'];async function capture(){const a=[];for(const p of sourcePaths){const b=await fs.readFile(path.join(here,p)),row={path:p,...id(b)};const copied=roster.find(r=>r.path===p);if(copied)assert.deepEqual(id(b),p.endsWith('/client.mjs')?client:{bytes:copied.bytes,sha256:copied.sha256});a.push(row);}return a;}const before=await capture();await save('source-before.json',json(before));for(const p of['regression/draft-boundaries.test.mjs','regression/adjacent.test.mjs','regression/ui-fixture.mjs','regression/correction-controls.test.mjs','collect-focused.mjs'])await save('review-source/'+p+'.snapshot',await fs.readFile(path.join(here,p)));await save('client.mjs.snapshot',await fs.readFile(path.join(here,'products/rea-studio/apps/vault/client.mjs')));
const node=id(await fs.readFile(process.execPath));assert.equal(node.sha256,'b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3');const results=[];for(const[name,file,scope]of selections){const folder=path.join(root,name);await fs.mkdir(folder,{recursive:true});const env={...process.env,VAULT_GROUP_REVIEW_OUTPUT:folder,GROUP_OBSERVATIONS:folder};delete env.NODE_TEST_CONTEXT;delete env.NODE_OPTIONS;delete env.NODE_V8_COVERAGE;const args=['--test','--test-isolation=none','--test-concurrency=1','--test-reporter=tap',file];const child=spawn(process.execPath,args,{cwd:here,env,windowsHide:true,stdio:['ignore','pipe','pipe']}),out=[],err=[];let limit=null,stdoutBytes=0,stderrBytes=0;const timer=setTimeout(()=>{limit='child20s';child.kill();},20000);for(const[channel,parts]of[['stdout',out],['stderr',err]])child[channel].on('data',b=>{let bytes=channel==='stdout'?stdoutBytes:stderrBytes;const left=1048576-bytes;if(left>0)parts.push(b.subarray(0,left));bytes+=b.length;if(channel==='stdout')stdoutBytes=bytes;else stderrBytes=bytes;if(bytes>1048576){limit=channel+'1MiB';child.kill();}});const exit=await new Promise(resolve=>child.on('close',(code,signal)=>resolve({code,signal})));clearTimeout(timer);const stdout=Buffer.concat(out),stderr=Buffer.concat(err);await fs.writeFile(path.join(folder,'stdout.txt'),stdout,{flag:'wx'});await fs.writeFile(path.join(folder,'stderr.txt'),stderr,{flag:'wx'});const counts={};for(const k of['tests','pass','fail','skipped','cancelled','todo'])counts[k]=Number(stdout.toString().match(new RegExp('^# '+k+' (\\d+)$','m'))?.[1]);const r={name,file,scope,args,counts,exit,limit,raw:{stdout:id(stdout),stderr:id(stderr)},originalExecutions:0,browserExecutions:0};results.push(r);await save(name+'/validation.json',json(r));}
const after=await capture();assert.deepEqual(after,before);await save('source-after.json',json(after));const refsAfter=await references();assert.deepEqual(refsAfter,refsBefore);await save('references-after.json',json(refsAfter));const totals={tests:0,pass:0,fail:0,skipped:0,cancelled:0,todo:0};for(const r of results)for(const k of Object.keys(totals))totals[k]+=r.counts[k];const accepted=results.every(r=>r.exit.code===0&&r.exit.signal===null&&r.limit===null&&r.counts.fail===0&&r.counts.skipped===0&&r.counts.cancelled===0&&r.counts.todo===0);await save('validation.json',json({schema:'rea-vault-group-editor-late-draft-focused/v1',run,accepted,totals,results,sourceStable:true,sourceRows:before.length,refsStable:true,node,nodeVersion:process.version,old885And78Immutable:true,originalExecutions:0,browserExecutions:0,hostsStarted:0,benchmarkCommands:0,productionWrites:0,fullProductParity:false}));process.stdout.write(JSON.stringify({run,accepted,totals,sourceRows:before.length,sourceStable:true})+'\n');assert(accepted,'Focused failures retained');
