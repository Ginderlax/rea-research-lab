import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';import {spawnSync} from 'node:child_process';
const root=import.meta.dirname,sha=b=>createHash('sha256').update(b).digest('hex'),stamp=new Date().toISOString().replaceAll(':','-'),folder=path.join(root,'runs',stamp);fs.mkdirSync(folder,{recursive:true});
function inventory(dir=root,relative=''){return fs.readdirSync(dir,{withFileTypes:true}).flatMap(e=>{const n=relative?relative+'/'+e.name:e.name;if(!relative&&e.name==='runs')return [];assert.ok(!e.isSymbolicLink());if(e.isDirectory())return inventory(path.join(dir,e.name),n);assert.ok(e.isFile());const b=fs.readFileSync(path.join(dir,e.name));return [{path:n,bytes:b.length,sha256:sha(b)}];}).sort((a,b)=>a.path.localeCompare(b.path));}
const before=inventory();for(const r of before){const p=path.join(folder,'source',r.path+'.snapshot');fs.mkdirSync(path.dirname(p),{recursive:true});fs.copyFileSync(path.join(root,r.path),p,fs.constants.COPYFILE_EXCL);}fs.writeFileSync(path.join(folder,'source-before.json'),JSON.stringify(before,null,2)+'\n',{flag:'wx'});
const nodeSHA=sha(fs.readFileSync(process.execPath));assert.equal(nodeSHA,'b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3');const files=['layout.test.mjs','layout-ui.test.mjs','products/rea-studio/apps/sketch/app.test.mjs','products/rea-studio/apps/sketch/client.test.mjs','products/rea-studio/apps/sketch/geometry-client.test.mjs'],startedAt=new Date().toISOString(),r=spawnSync(process.execPath,['--test','--test-concurrency=1','--test-reporter=tap',...files],{cwd:root,env:{...process.env,REA_LAYOUT_OBSERVATIONS:path.join(folder,'observations/original-actions.json')},encoding:'utf8',windowsHide:true,timeout:180000,maxBuffer:8*1024*1024});fs.writeFileSync(path.join(folder,'stdout.txt'),r.stdout??'',{flag:'wx'});fs.writeFileSync(path.join(folder,'stderr.txt'),r.stderr??'',{flag:'wx'});const after=inventory();fs.writeFileSync(path.join(folder,'source-after.json'),JSON.stringify(after,null,2)+'\n',{flag:'wx'});let stable=true;try{assert.deepEqual(after,before);}catch{stable=false;}const summary=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo','duration_ms'].map(k=>[k,Number((r.stdout??'').match(new RegExp('^# '+k+' ([0-9.]+)$','m'))?.[1]??NaN)])),record={schema:'rea-sketch-layout-focused-attempt/v1',startedAt,endedAt:new Date().toISOString(),exitCode:r.status,signal:r.signal,error:r.error?{name:r.error.name,message:r.error.message}:null,summary,sourceFiles:before.length,sourceStable:stable,runtime:{version:process.version,sha256:nodeSHA},selectedFiles:files,fullParity:false,superiority:false};fs.writeFileSync(path.join(folder,'attempt-validation.json'),JSON.stringify(record,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({folder,...record}));if(r.status!==0||!stable)process.exitCode=1;
