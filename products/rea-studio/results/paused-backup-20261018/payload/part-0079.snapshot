    {
      "id": "grafana.candidate.e5aa1a7df9a6b0238475",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Graphite queries are now automatically transformed to Loki queries according to user-defined rules when the data source changes in Explore.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Grafana OSS features",
        "Data source updates",
        "Graphite data source",
        "Map Graphite queries to Loki"
