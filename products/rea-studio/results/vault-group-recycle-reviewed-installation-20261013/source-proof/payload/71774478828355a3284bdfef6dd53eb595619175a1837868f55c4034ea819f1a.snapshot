import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const root=process.cwd(),own=path.join(root,'work/root-named-metrics-host-transition-independent-review');fs.mkdirSync(own,{recursive:true});const sha=b=>createHash('sha256').update(b).digest('hex'),epochs=[];for(const name of['root-named-historical-host-transition-next','root-metrics-historical-host-transition-next']){const d=path.join(root,'work',name),record=JSON.parse(fs.readFileSync(path.join(d,'transformation.json'))),before=fs.readFileSync(path.join(d,'verify-records.before.mjs.snapshot')),after=fs.readFileSync(path.join(d,'verify-records.after.mjs.snapshot'));for(const[b,e]of[[before,record.before],[after,record.after]]){assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256)}let s=after.toString();for(const c of [...record.changes].reverse()){assert.equal(s.split(c.after).length,2);s=s.replace(c.after,c.before)}assert.ok(Buffer.from(s).equals(before));epochs.push({name,before:record.before,after:record.after,changes:record.changes.length,inverseExact:true})}assert.deepEqual(epochs[0].after,epochs[1].before);const live=fs.readFileSync(path.join(root,'outputs/rea-research-lab/scripts/verify-records.mjs'));assert.equal(sha(live),epochs.at(-1).after.sha256);const text=live.toString();assert.ok(text.includes("function currentPublicFingerprint(entry,label){safeRecordPath(entry.path);const bytes=readFileSync(join(root,entry.path));if(entry.bytes!==undefined)assert.equal(bytes.length,entry.bytes"));assert.ok(text.includes("if(entry.bytes!==undefined)assert.equal(entry.bytes,7741);assert.equal(entry.sha256,'807a473e"));assert.ok(text.includes("for(const e of automationRecovery.artifacts)currentFingerprint"));const receipt={schema:'rea-named-metrics-host-transition-independent-source-review/v1',at:new Date().toISOString(),epochs,sourceStable:true,onlyNamedHistoricalLoopsChanged:true,omittedByteFieldPreservesSHAOnlyWebDAVContract:true,mandatoryOld7741SHAAndCapsuleAndCurrentAfterGuard:true,allOtherRowsUseCurrentChecks:true,noAppOrOriginalOrBenchmarkOrVerifierExecution:true,noRepoWrites:true,noBlockingSourceFlawFound:true,limits:'Pure inverse and guard source review; no root metadata verifier rerun and no blanket source compatibility claim.'};const b=Buffer.from(JSON.stringify(receipt,null,2)+'\n');fs.writeFileSync(path.join(own,'review-validation.json'),b);const mb=Buffer.from(JSON.stringify({schema:'rea-strict-independent-review/v1',inventory:[{path:'review-validation.json',bytes:b.length,sha256:sha(b)}]},null,2)+'\n');fs.writeFileSync(path.join(own,'review-manifest.json'),mb);console.log(JSON.stringify({receipt:sha(b),manifest:sha(mb),after:sha(live),noBlocker:true}));
