import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,workspace=path.resolve(here,'../..'),sha=b=>createHash('sha256').update(b).digest('hex'),facts=JSON.parse(await fs.readFile(path.join(here,'source-facts.json'))),identity=JSON.parse(await fs.readFile(path.join(here,'finalizer-source.json'))),script=await fs.readFile(path.join(workspace,identity.path));assert.equal(sha(script),identity.sha256);const text=script.toString();assert(text.includes('Six helper instances defined with nonconstructible shorthand methods'));assert(text.includes('45total host requests, including31browser Notes API requests,3seed calls and3programmatic attachment-fixture calls'));assert(text.includes('corrected188-file candidate on10-source private host'));assert.equal(facts.notesBrowser.value.actualHostRequests,45);assert.equal(facts.notesBrowser.value.browserAPIRequests,31);assert.equal(facts.notesBrowser.value.initialSeedCalls,3);assert.equal(facts.notesBrowser.value.programmaticAttachmentFixtureCalls,3);assert.equal(facts.notesBrowser.value.attachment.bytes,63);assert.equal(facts.notesBrowser.value.attachment.browserDownloadedFileVerified,true);assert.equal(facts.notesBrowser.value.attachment.browserUploadAcceptance,false);assert.equal(facts.sketchFocus.value.sketchGroups,39);assert.equal(facts.sketchFocus.value.sharedRouteHTTPGroups,2);assert.equal(facts.sketchFocus.value.exactLiteralLayoutPairs,3968);assert.equal(facts.sketchFocus.value.alignCalls+facts.sketchFocus.value.distributionCalls,3968);assert.equal(facts.sketchBrowser.value.semanticGroups,14);assert.equal(facts.sketchBrowser.value.sourceFiles,10);assert.equal(facts.sketchBrowser.value.productionHostRouteAccepted,false);assert.equal(facts.sketchBrowser.value.actualDownloadFileAcceptance,false);assert.equal(facts.apiFocus.value.summary.pass,13);assert.equal(facts.apiFocus.value.operations.originalLibraryExecutions,0);assert.equal(facts.installation.value.copies.length,1307);assert.equal(facts.installation.value.installed.length,14);const receipt={schema:'rea-notes-layout-value-api-finalizer-factual-review/v1',at:new Date().toISOString(),reviewedSource:identity,sourceOnly:true,findingsCorrectedByRoot:[{priorPhrase:'Six nonconstructible arrow helper functions',correction:'Six helper instances defined with nonconstructible shorthand methods',reason:'Two shorthand definitions across three classes; not arrow syntax.'},{priorPhrase:'45host/31Notes API requests',correction:'45total with31browser API+3seed+3attachment fixture calls',reason:'Browser API count differs from all host/setup calls.'},{priorPhrase:'corrected8source candidate',correction:'corrected188-file candidate on10-source private host',reason:'Eight live proposals differ from actual browser source scope.'}],remainingConfirmedFactualFindings:0,notes:{groups:8,hostRequests:45,browserAPIRequests:31,seed:3,attachmentSetup:3,downloadBytes:63,downloadFileAccepted:true,uploadAccepted:false},sketch:{installedAppGroups:39,installedHTTPGroups:2,currentFocused41:true,authorPairs:3968,alignCalls:2976,distributionCalls:992,independentActionCalls:164,independentUniquePairs:140,browserGroups:14,browserSources:10,privateRouteNotCurrentProductionRoute:true,downloadFileAccepted:false},editor:{installedPure13:true,candidate319AndReview81Separate:true,fresh58Pairs38Exact20ErrorTypePlus6DescriptorControls:true,normalTestsOriginalLibraryExecutions:0,clientOrExtensionHostBinding:false},installation:{files:14,inertCopies:1307,adds:11,replacements:3,behavioralExecutions:0},rootReportedAfterReview:{combinedChecks:847,sourceFiles:720,inertSnapshots:727,reviewerExecutedFinalizer:false,independentCombinedSuiteRerun:false},inputFacts:Object.fromEntries(Object.entries(facts).map(([k,r])=>[k,{path:r.path,bytes:r.bytes,sha256:r.sha256}])),reviewerDiagnostics:['A guessed installation path was absent; subsequent receipt reads used exact preservation-manifest sourcePath mappings.','One metadata inline command failed syntax before evaluation; scoped owned read-facts script then completed.','Requested helper follow-up was rejected by agent thread limit; factual review completed directly.'],productionOrScriptEdits:0,appTests:0,originalExecutions:0,browser:0,hosts:0,benchmarks:0,fullParity:false,factualSourceAcceptance:true};await fs.writeFile(path.join(here,'review-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});async function walk(d,p=''){const out=[];for(const e of await fs.readdir(d,{withFileTypes:true})){assert(!e.isSymbolicLink());if(e.isDirectory())out.push(...await walk(path.join(d,e.name),p+e.name+'/'));else out.push(p+e.name);}return out;}const inventory=[];for(const p of(await walk(here)).sort()){assert.notEqual(p,'review-manifest.json');const b=await fs.readFile(path.join(here,p));inventory.push({path:p,bytes:b.length,sha256:sha(b)});}const m={schema:'rea-finalizer-factual-review-freeze/v1',files:inventory.length,totalBytes:inventory.reduce((n,r)=>n+r.bytes,0),inventory},b=Buffer.from(JSON.stringify(m,null,2)+'\n');await fs.writeFile(path.join(here,'review-manifest.json'),b,{flag:'wx'});console.log(JSON.stringify({files:m.files,manifestSHA256:sha(b),receiptSHA256:sha(await fs.readFile(path.join(here,'review-validation.json'))),finalizerSHA256:identity.sha256,remainingFindings:0}));
