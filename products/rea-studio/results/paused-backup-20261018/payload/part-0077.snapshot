    },
    {
      "id": "grafana.candidate.1836e29a8f3ca147ba0d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This setting has precedence over each individual rule frequency. If a rule frequency is lower than this value, then this value is enforced.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[unified_alerting]`",
        "`min_interval`"
      ],
      "source": {
