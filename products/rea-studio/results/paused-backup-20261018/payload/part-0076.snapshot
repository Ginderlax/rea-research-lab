    },
    {
      "id": "grafana.candidate.685e6d9d677ea300d792",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use the debug section to see what your fields extract and how the URL interpolates. Click **Show example log message** to display a text area where you can enter a log message.",
      "headingPath": [
        "Configure the Loki data source",
        "Configure the data source in the UI",
