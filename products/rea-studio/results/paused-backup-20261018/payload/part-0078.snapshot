      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.74c6f5a22324b3706213",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Teams let you grant permissions to a group of users, instead of granting permissions to individual users one at a time.",
      "headingPath": [
        "Introduction",
        "Assign users to teams"
      ],
      "source": {
        "path": "docs/sources/tutorials/create-users-and-teams/index.md",
        "gitBlobSha": "b4d26c5ebe0a4fc9e3c13c5a9d873002b60aab96",
        "sha256": "c404cd2baa7f66c89a89539fb3349df10be4835e43107d19776559ee6c21bde1",
        "lineStart": 87,
        "lineEnd": 87,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/tutorials/create-users-and-teams/index.md#L87-L87"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.80857e15fbd6d97b43d7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Teams are useful when onboarding new colleagues. When you add a user to a team, they get access to all resources assigned to that team.",
      "headingPath": [
        "Introduction",
        "Assign users to teams"
      ],
      "source": {
        "path": "docs/sources/tutorials/create-users-and-teams/index.md",
        "gitBlobSha": "b4d26c5ebe0a4fc9e3c13c5a9d873002b60aab96",
