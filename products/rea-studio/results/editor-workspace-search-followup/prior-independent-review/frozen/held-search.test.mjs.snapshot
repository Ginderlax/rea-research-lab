import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import {render} from '../editor-search-next/products/rea-studio/apps/editor/client.mjs';
import {handle} from '../editor-search-next/products/rea-studio/apps/editor/server.mjs';
import {createWorkspace} from '../editor-search-next/products/rea-studio/lib/storage.mjs';
class Element{constructor(tag){this.tagName=tag;this.children=[];this.attributes={};this.value='';this.textContent='';this.disabled=false;this.checked=false;this.style={};this.selectionStart=this.selectionEnd=0;}append(...nodes){this.children.push(...nodes);}prepend(...nodes){this.children.unshift(...nodes);}replaceChildren(...nodes){this.children=[...nodes];}insertBefore(node,before){const i=this.children.indexOf(before);this.children.splice(i<0?this.children.length:i,0,node);}setAttribute(name,value){this.attributes[name]=value;}focus(){this.focused=true;}setSelectionRange(start,end){this.selectionStart=start;this.selectionEnd=end;}}
const all=root=>[root,...root.children.flatMap(all)],field=(root,label)=>all(root).find(node=>node.attributes['aria-label']===label),button=(root,label)=>all(root).find(node=>node.tagName==='button'&&node.textContent===label),deferred=()=>{let resolve;const promise=new Promise(r=>resolve=r);return{promise,resolve};};
let counter=0;
async function fixture(t,id){const folder=path.join(import.meta.dirname,'runs',id+'-'+Date.now()+'-'+counter++),workspace=await createWorkspace(path.join(folder,'workspace'));await fs.writeFile(workspace.resolve('a.txt'),'🧬target OLD\n');await fs.writeFile(workspace.resolve('b.txt'),'second target NEW\n');const before={document:globalThis.document,window:globalThis.window};globalThis.document={createElement:tag=>new Element(tag)};globalThis.window={confirm:()=>false};const root=new Element('main'),arrived=deferred(),release=deferred(),calls=[];const api=async(action,input)=>{calls.push({action,input:structuredClone(input)});const data=action==='gitStatus'?{initialized:false}:await handle({action,input,workspace});if(action==='read'&&input.path==='a.txt'){arrived.resolve();await release.promise;}return data;};const dispose=await render(root,api);t.after(()=>{release.resolve();dispose();globalThis.document=before.document;globalThis.window=before.window;});await button(root,'b.txt').onclick();field(root,'Find in saved files').value='target';await button(root,'Search saved files').onclick();const pending=button(root,'a.txt:1:3').onclick();await arrived.promise;return{root,workspace,folder,release,pending,dispose,calls};}
async function observe(f,id){const editor=field(f.root,'File contents'),data={id,editorValue:editor.value,selection:[editor.selectionStart,editor.selectionEnd],tabs:all(f.root).filter(node=>node.attributes['aria-pressed']!==undefined).map(node=>({label:node.textContent,active:node.attributes['aria-pressed']})),searchStatus:all(f.root).filter(node=>node.attributes.role==='status').map(node=>node.textContent),savedA:await fs.readFile(f.workspace.resolve('a.txt'),'utf8'),savedB:await fs.readFile(f.workspace.resolve('b.txt'),'utf8'),calls:f.calls};await fs.writeFile(path.join(f.folder,'observation.json'),JSON.stringify(data,null,2)+'\n',{flag:'wx'});return data;}
test('held result read must not publish after search text options invalidate its generation',{timeout:5000},async t=>{const f=await fixture(t,'options'),query=field(f.root,'Find in saved files');query.value='second';query.oninput();f.release.resolve();await f.pending;const observed=await observe(f,'options');assert.equal(observed.editorValue,'second target NEW\n','A stale result read replaced the earlier active file after options changed.');assert.equal(observed.savedA,'🧬target OLD\n');});
test('held result read must not publish after a newer complete search generation',{timeout:5000},async t=>{const f=await fixture(t,'new-search'),query=field(f.root,'Find in saved files');query.value='second';query.oninput();await button(f.root,'Search saved files').onclick();assert.ok(button(f.root,'b.txt:1:1'));f.release.resolve();await f.pending;const observed=await observe(f,'new-search');assert.equal(observed.editorValue,'second target NEW\n','A stale result read replaced the active file after newer search results were published.');});
test('control: later explicit file selection suppresses the held old read',{timeout:5000},async t=>{const f=await fixture(t,'file-control');await button(f.root,'b.txt:1:8').onclick();f.release.resolve();await f.pending;const observed=await observe(f,'file-control');assert.equal(observed.editorValue,'second target NEW\n');assert.deepEqual(observed.selection,[7,13]);});
test('control: later new draft suppresses held read and preserves disk bytes',{timeout:5000},async t=>{const f=await fixture(t,'draft-control');field(f.root,'Relative file path').value='fresh.txt';await button(f.root,'New file').onclick();const editor=field(f.root,'File contents');editor.value='held-out private draft';editor.oninput();f.release.resolve();await f.pending;const observed=await observe(f,'draft-control');assert.equal(observed.editorValue,'held-out private draft');assert.equal(observed.savedA,'🧬target OLD\n');await assert.rejects(fs.readFile(f.workspace.resolve('fresh.txt')),error=>error.code==='ENOENT');});
test('control: disposal suppresses held read publication',{timeout:5000},async t=>{const f=await fixture(t,'dispose-control');f.dispose();f.release.resolve();await f.pending;const observed=await observe(f,'dispose-control');assert.equal(observed.editorValue,'second target NEW\n');assert.ok(!observed.tabs.some(row=>row.label==='a.txt'));});
