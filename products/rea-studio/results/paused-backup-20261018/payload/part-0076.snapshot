          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.8b0e6bc9a80e6630da56",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Metrics queries aggregate data and produce calculations such as count, min, max, and more. Click the metric box to view options in the drop-down menu. The default is `count`.",
      "headingPath": [
        "Elasticsearch query editor",
        "Select a query type",
        "Metrics query type"
      ],
      "source": {
        "path": "docs/sources/datasources/elasticsearch/query-editor/index.md",
