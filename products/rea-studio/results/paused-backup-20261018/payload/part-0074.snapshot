    {
      "id": "grafana.candidate.4695a1bfeb6e38728102",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Plugin installation usually requires an Internet connection. You can check which endpoints are used during the installation on your instance and add them to your instance’s allow list.",
