rows=d['otherProofRows'];assert len(rows)==len({r['path']for r in rows})==59 and dp not in{r['path']for r in rows}
assert hp not in{r['path']for r in rows}and not any('/scripts/verify-notes36-cloud.mjs' in r['path']for r in rows)
