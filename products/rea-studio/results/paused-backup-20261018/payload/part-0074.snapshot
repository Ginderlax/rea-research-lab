    },
    {
      "id": "grafana.candidate.b6dc94b10e03490cff83",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you prefer to always use advanced configuration, you can disable the **Default** modes by disabling the `alertingQueryAndExpressionsStepMode` and `alertingNotificationsStepMode` feature toggles.",
      "headingPath": [
        "Configure Grafana-managed alert rules",
        "Before you begin",
        "Default versus Advanced options"
      ],
