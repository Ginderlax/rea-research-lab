rows=[]
for f in sorted(candidate.rglob('*')):
    if not f.is_file():continue
    name=f.relative_to(candidate).as_posix();before=previous/'candidate'/name
    if not before.is_file():before=repo/name
    rows.append({'path':name,'before':pin(before.read_bytes()) if before.is_file() else None,'after':pin(f.read_bytes())})
tests=[r for r in rows if r['path'].endswith('.test.mjs')]
groups=[]
for row in tests:
    groups.extend(re.findall(r"^test\('([^']+)'",(candidate/row['path']).read_text(),re.M))
assert len(tests)==4 and len(groups)==18 and len(set(groups))==18
assert len(rows)==12
assert len([r for r in rows if r['before'] is not None])==3
old_tests=sorted((repo/'products/rea-studio/apps/notes').glob('*.test.mjs'))
assert len(old_tests)==17
assert all(not (candidate/f.relative_to(repo)).exists() for f in old_tests)
