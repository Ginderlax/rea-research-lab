    },
    {
      "id": "grafana.candidate.37696caa214e5f7770c0",
      "syntaxRole": "list-item",
      "sourceText": "- `persistNotifications` - enables the alerts page under Profile",
      "headingPath": [
        "What's new in Grafana v9.0",
        "List of errors with trace IDs"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-0.md",
        "gitBlobSha": "3391f04dcb99b5fd7f3dc4839fe6fdf0d4bf3bae",
        "sha256": "39f11e18287d80cebb61272008eb6acbd2b991b12fd2ca34601c0b2454aa3aa1",
        "lineStart": 146,
        "lineEnd": 146,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v9-0.md#L146-L146"
      },
      "applicability": {
