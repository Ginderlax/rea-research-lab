import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,repo=path.resolve(here,'../../outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),before=JSON.parse(await fs.readFile(path.join(here,'source-before.json'))),after=[];for(const r of before.rows){const b=await fs.readFile(path.join(repo,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);after.push({...r,observedAfter:true});}for(const f of['verify-notes-vault-followups.mjs','verify-notes-inline-followups.mjs'])assert.equal(sha(await fs.readFile(path.join(repo,'scripts',f))),sha(await fs.readFile(path.join(here,'before',f+'.snapshot'))));const t=JSON.parse(await fs.readFile(path.join(here,'transformations.json'))),proposal=await fs.readFile(path.join(here,'proposed/verify-followup-records.mjs'));assert.equal(proposal.length,t.after.bytes);assert.equal(sha(proposal),t.after.sha256);let inverse=proposal.toString();for(const c of [...t.changes].reverse())inverse=inverse.replace(c.after,c.before);assert.equal(sha(inverse),t.before.sha256);const rawProof=JSON.parse(await fs.readFile(path.join(here,'observations/proposal-standalone.json'))),decoded=JSON.parse(await fs.readFile(path.join(here,'observations/proposal-records.json')));assert.equal(rawProof.exitCode,0);assert.equal(decoded.parentExitCode,0);assert.equal(decoded.wrapperParseAttemptExitCode,1);const prefix='products/rea-studio/results/sketch-layout-reviewed-installation-20261013/shared-route/frozen',mb=await fs.readFile(path.join(repo,prefix,'freeze-manifest.json.snapshot'));assert.equal(sha(mb),'86de6ef0f1f39a03d7c6b4039cbbc78d0230c0ab09aec6ea61aa105edaedb3f9');const m=JSON.parse(mb);assert.equal(m.records.length,51);for(const r of m.records){const b=await fs.readFile(path.join(repo,prefix,r.path+'.snapshot'));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);}const cb=await fs.readFile(path.join(repo,'products/rea-studio/results/milestones/search-trash-recycle-save-3baecf4e-20261013/snapshot-manifest.json'));assert.equal(sha(cb),'d969655ed6d1e73f925147c277261b38333e2d095b18a486f2c7c2a7700689ff');await fs.writeFile(path.join(here,'source-after.json'),JSON.stringify({at:new Date().toISOString(),rows:after,parentChildHostDependenciesUnmodified:true,root51AliasesUnmodified:true,old3baCapsuleUnmodified:true},null,2)+'\n',{flag:'wx'});const receipt={schema:'rea-followup-narrow-host-transition-proposal/v1',at:new Date().toISOString(),sourceOnly:true,parentPath:t.parentPath,before:t.before,after:t.after,transformations:t.changes.length,originalLines:t.changes.map(c=>c.beforeStartLine),inverseExact:true,childVerifierUnchanged:t.childVerifierUnchanged,onlyHostException:t.onlyHostException,hostTransition:decoded.parent.editorHostTransition,genericHistoricalFallback:false,defaultChildObservedSchema:decoded.parent.editorVerification.schema,childLiveMatchHonestFalse:true,childMismatchSingletonAuthenticated:true,proposedParentStandaloneExitCode:0,wrapperParsingPremiseFailures:2,dependentMissingRecordDiagnostic:1,reparseOnlyCorrection:true,rawJSONRecords:2,parentAndChildRootEdits:0,runtimeAppEdits:0,proofsRebound:0,sourceStable:true,routeRoot51PublicAliases:52,root51ManifestSHA256:sha(mb),old3baCapsuleSHA256:sha(cb),behavioralTestsExecuted:0,originalExecutions:0,browser:0,hosts:0,benchmarks:0,fullsuite:0,syntaxChecks:2,finiteSourceProposalAccepted:true,actualRootParentInstalled:false,currentHostBehaviorRetested:false,fullParity:false,securityEquivalence:false};await fs.writeFile(path.join(here,'validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});async function walk(d,p=''){const out=[];for(const e of await fs.readdir(d,{withFileTypes:true})){assert(!e.isSymbolicLink());if(e.isDirectory())out.push(...await walk(path.join(d,e.name),p+e.name+'/'));else out.push(p+e.name);}return out;}const inventory=[];for(const p of(await walk(here)).sort()){assert.notEqual(p,'freeze-manifest.json');const b=await fs.readFile(path.join(here,p));inventory.push({path:p,bytes:b.length,sha256:sha(b)});}const f={schema:'rea-followup-narrow-host-transition-proposal-freeze/v1',files:inventory.length,totalBytes:inventory.reduce((n,r)=>n+r.bytes,0),inventory},b=Buffer.from(JSON.stringify(f,null,2)+'\n');await fs.writeFile(path.join(here,'freeze-manifest.json'),b,{flag:'wx'});console.log(JSON.stringify({files:f.files,manifestSHA256:sha(b),receiptSHA256:sha(await fs.readFile(path.join(here,'validation.json'))),proposalSHA256:t.after.sha256,rootParentUnmodified:true}));
