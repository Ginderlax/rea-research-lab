    },
    {
      "id": "grafana.candidate.68838cf3becfd531f9b0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Enable this feature in configuration settings using the `templateVariables` flag.",
      "headingPath": [
        "What's new in Grafana v7.5",
        "Enterprise features",
        "Use template variable in reports"
      ],
