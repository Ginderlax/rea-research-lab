    {
      "id": "grafana.candidate.17c74d452d186cec350f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If a user role doesn't match any of configured values, then the role specified by the `auto_assign_org_role` configuration option will be assigned. If the `auto_assign_org_role` field is not set then the user role will default to `Viewer`.",
      "headingPath": [
        "Configure role sync for SAML"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/configure-saml-team-role-mapping/_index.md",
