    {
      "id": "grafana.candidate.707e1d9ccc13a0289c70",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In dashboards, a threshold is a value or limit you set for a metric that's reflected visually when it's met or exceeded. Thresholds are one way you can conditionally style and color your visualizations based on query results.",
      "headingPath": [
        "Configure thresholds"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/configure-thresholds/index.md",
