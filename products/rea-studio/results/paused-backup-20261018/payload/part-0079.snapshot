        "lineStart": 137,
        "lineEnd": 137,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/panels-visualizations/visualizations/stat/index.md#L137-L137"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.7a8601b3e05ef9f4586b",
      "syntaxRole": "table-row",
      "sourceText": "| [Wide layout](#wide-layout) | Set whether wide layout is enabled or not. Wide layout is enabled by default. This option is only applicable when **Text mode** is set to **Value and name**. |",
      "headingPath": [
        "Stat",
        "Configuration options",
        "Stat styles"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/stat/index.md",
