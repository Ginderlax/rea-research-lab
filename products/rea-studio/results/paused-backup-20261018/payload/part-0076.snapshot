    {
      "id": "grafana.candidate.70149da178eac94dc4f6",
      "syntaxRole": "list-item",
      "sourceText": "- **Plugin** — simulates a failure in the plugin itself. The alert enters an error state.",
      "headingPath": [
        "TestData alerting",
        "Test error and no-data conditions",
        "Errors"
      ],
      "source": {
