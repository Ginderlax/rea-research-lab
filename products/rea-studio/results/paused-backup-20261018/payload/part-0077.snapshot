        "lineStart": 73,
        "lineEnd": 73,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/fundamentals/timeseries-dimensions/index.md#L73-L73"
      },
      "applicability": {
