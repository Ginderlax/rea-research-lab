      "after": "const derivedNames = ['PUBLICATION-MANIFEST.json', 'VALIDATION.json'];\n// Exact final d24 epoch; all values are raw observed identities, not older receipt aliases.\nconst expectedEpoch = {\n  \"jobId\": \"117079122770\",\n  \"testedCommit\": \"5f23f782a7224aaacdce89edfe21eb7e3a565831\",\n  \"gitTree\": \"255dab0cc57d4f1a35af46c42903d8721e1dcd49\",\n  \"artifact\": {\n    \"bytes\": 3336976,\n    \"sha256\": \"383f98420972291bd67c61cc4344b6792bafb90021ae022b6f0ecacabf4b3da1\"\n  },\n  \"collection\": {\n    \"bytes\": 8555,\n    \"sha256\": \"0c3a1971826cbd0797a9a4e37d7641e36c72c47fecac6e1526999f3b1d41058d\"\n  },\n  \"backupVerification\": {\n    \"bytes\": 62186,\n    \"sha256\": \"02bd4649e8289924478e77d2da8d5bd70c25cf250e26924bfcabc7639adb89cb\"\n  },\n  \"attempt\": {\n    \"bytes\": 5307,\n    \"sha256\": \"79a3d2616c7b7ce313993268647c7b8a6db65ced180570121f178006d1b9baa5\"\n  },\n  \"payload\": {\n    \"files\": 28806,\n    \"bytes\": 1364428861,\n    \"rowsIdentity\": {\n      \"bytes\": 7250578,\n      \"sha256\": \"2ffa49a7872d963db924784647520612b6b57b34044d6a97745bf3964900349d\"\n    }\n  },\n  \"before\": {\n    \"PUBLICATION-MANIFEST.json\": {\n      \"bytes\": 8157062,\n      \"sha256\": \"015a21ce5cd693b0aafbec9b882e6355c240eb7347bdd50e4a8865979f114c95\"\n    },\n    \"VALIDATION.json\": {\n      \"bytes\": 46084,\n      \"sha256\": \"a67fa3c5ab8b40372e18fbce703a72fb1489e504def69d6329ed0eecb08763ac\"\n    }\n  },\n  \"after\": {\n    \"PUBLICATION-MANIFEST.json\": {\n      \"bytes\": 8230268,\n      \"sha256\": \"f865aa41d470ee3f402df8b966e0c336b6f028fc5032b769e7e18af0f695b9a0\"\n    },\n    \"VALIDATION.json\": {\n      \"bytes\": 46085,\n      \"sha256\": \"eb0d666b425f82ac3134992e64393e2d5049b616637d599c56e0623fc48dfd03\"\n    }\n  }\n};"
