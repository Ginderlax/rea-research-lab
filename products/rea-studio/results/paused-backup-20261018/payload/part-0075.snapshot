      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.ae20b26c797602ec3339",
      "syntaxRole": "list-item",
      "sourceText": "- `Credentials file` maps to the [SharedCredentialsProvider](https://docs.aws.amazon.com/sdk-for-go/api/aws/credentials/#SharedCredentialsProvider) provider in the [AWS SDK for Go](https://github.com/aws/aws-sdk-go).",
      "headingPath": [
        "Configure AWS authentication",
        "Select an authentication method"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/aws-authentication/index.md",
        "gitBlobSha": "2d131f34bdc1a2a0359d49e541ce35ce201cd154",
        "sha256": "84d1e043399ac35275e14ad5a6231a0692fa35043d31b823508f48d6c0993d0a",
        "lineStart": 46,
        "lineEnd": 46,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/aws-cloudwatch/aws-authentication/index.md#L46-L46"
      },
      "applicability": {
