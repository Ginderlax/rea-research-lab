import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import {gunzipSync} from 'node:zlib';
import assert from 'node:assert/strict';

// Observation arithmetic and byte authentication only. No stage module imports,
// reducer calls, workload generators, processes, timers or resource samplers.
const own=path.dirname(fileURLToPath(import.meta.url));
const stage=path.resolve(own,'../metrics-algorithm-measurement-review-next');
const retained=path.join(stage,'preserved/study');
const sha=b=>createHash('sha256').update(b).digest('hex');
const pins={
 'measurement-validation.json':'2ae7afaf499cffc9fa88b40b095b697849608b64ae5d485af8602e316f408b23',
 'freeze-manifest.json':'ee5683f780ab14007ef8731b07663dc32a1494b8f1b2ec0b43f0f8988ba0308d',
};
async function fp(file){const b=await fs.readFile(file);return{bytes:b.length,sha256:sha(b)}}
async function json(file){return JSON.parse(await fs.readFile(file,'utf8'))}
function confined(root,p){const file=path.resolve(root,p),rel=path.relative(root,file);assert.ok(rel&&!path.isAbsolute(rel)&&rel!=='..'&&!rel.startsWith('..'+path.sep));return file}
async function authenticate(entries,root){for(const e of entries)assert.deepEqual(await fp(confined(root,e.path)),{bytes:e.bytes,sha256:e.sha256});}
function statistics(values){const a=values.slice().sort((a,b)=>a-b);assert.ok(a.length&&a.every(Number.isFinite));return{samples:a.length,median:a.length%2?a[(a.length-1)/2]:(a[a.length/2-1]+a[a.length/2])/2,min:a[0],max:a.at(-1),values};}
function nullableStatistics(values){const a=values.filter(Number.isFinite);return{samples:a.length,missingOrUnavailable:values.length-a.length,censored:a.length!==values.length,median:a.length?statistics(a).median:null,min:a.length?Math.min(...a):null,max:a.length?Math.max(...a):null,values};}
function ranges(a,b){const lo=Math.max(a.min,b.min),hi=Math.min(a.max,b.max);return{overlap:lo<=hi,intersection:lo<=hi?[lo,hi]:null}}
function group(rows,name,role){const found=rows.filter(x=>x.caseName===name&&x.implementation===role).sort((a,b)=>a.runNumber-b.runNumber);assert.deepEqual(found.map(x=>x.runNumber),[0,1,2,3,4,5,6]);return found}
const roles=['original','baseline','candidate'];
for(const[p,h]of Object.entries(pins))assert.equal((await fp(path.join(stage,p))).sha256,h);
const frozen=await json(path.join(stage,'freeze-manifest.json')),receipt=await json(path.join(stage,'measurement-validation.json')),summary=await json(path.join(stage,'recomputed-summary.json'));
assert.equal(frozen.files,2217);assert.equal(frozen.entries.length,2217);assert.equal(new Set(frozen.entries.map(x=>x.path)).size,2217);assert.equal(frozen.receiptSHA256,pins['measurement-validation.json']);await authenticate(frozen.entries,stage);
async function tree(root,rel=''){const out=[];for(const e of await fs.readdir(path.join(root,rel),{withFileTypes:true})){const p=rel?rel+'/'+e.name:e.name;if(e.isDirectory())out.push(...await tree(root,p));else out.push(p);}return out}
assert.deepEqual((await tree(stage)).filter(p=>p!=='freeze-manifest.json').sort(),frozen.entries.map(x=>x.path).sort());
const readiness=await json(path.join(retained,'readiness-validation.json'));assert.equal((await fp(path.join(retained,'readiness-validation.json'))).sha256,'b6a3faf96d8fcc48158742892e74f2923c8931b25aa84ce00615a3439aee1c2b');assert.equal(Object.keys(readiness.inventory).length,117);await authenticate(Object.entries(readiness.inventory).map(([path,r])=>({path,...r})),retained);
assert.equal((await fp(path.join(retained,'freeze-manifest.json'))).sha256,'6f918727383492e06b3acf856d9f4e2cb938ad3e05fef082f2f3021a6801b2bc');
const planBytes=await fs.readFile(path.join(retained,'memory-preflight.control.json')),plan=JSON.parse(planBytes),planHash=sha(planBytes);assert.equal(planHash,'fa24a42a8a0c60ce7cf832390e23e0197d7301379203ff302f0a807c2c027b67');const cases=Object.keys(plan.expectedFiles);assert.equal(cases.length,7);
const preservation=await json(path.join(stage,'study-preservation.json'));assert.equal(preservation.copies.length,1006);const source=path.resolve(stage,preservation.sourceStage);for(const e of preservation.copies){assert.deepEqual(await fp(confined(stage,e.path)),{bytes:e.bytes,sha256:e.sha256});assert.deepEqual(await fp(confined(source,e.sourcePath)),{bytes:e.bytes,sha256:e.sha256});}
const newArtifacts=preservation.copies.filter(e=>!Object.hasOwn(readiness.inventory,e.sourcePath)&&!['readiness-validation.json','freeze-manifest.json'].includes(e.sourcePath));assert.equal(newArtifacts.length,887);
const previousPlan=await json(path.join(stage,'preserved/previous-negative-study/preserved/study/memory-preflight.control.json'));
const fixtureBindings=[];for(const name of cases){const e=plan.expectedFiles[name];assert.deepEqual(e,previousPlan.expectedFiles[name]);for(const[p,h]of [[e.path,e.sha256],[e.inputPath,e.inputFileSHA256]]){const b=await fs.readFile(confined(retained,p));assert.equal(sha(b),h);fixtureBindings.push({path:p,bytes:b.length,sha256:h});}}assert.equal(fixtureBindings.length,14);
for(const[k,h]of Object.entries(plan.implementations.candidate.files))assert.equal((await fp(k)).sha256,h);for(const[k,h]of Object.entries(plan.implementations.baseline.files))assert.equal((await fp(k)).sha256,h);
assert.equal((await fp(path.join(retained,'candidate-algorithm.mjs'))).sha256,receipt.candidate.entrySHA256);assert.equal((await fp(path.join(retained,'selector-algorithm.mjs'))).sha256,receipt.candidate.helperSHA256);assert.equal((await fp(path.join(retained,'candidate-baseline.mjs'))).sha256,receipt.candidate.baselineSHA256);
for(const[file,h]of Object.entries(receipt.productionBaselineAuthenticatedUnchanged))assert.equal((await fp(file)).sha256,h);assert.equal((await fp(plan.runtime.execPath)).sha256,plan.runtime.executableSHA256);

// Independently parse and authenticate the retained official archive members.
function tar(bytes){const data=gunzipSync(bytes,{maxOutputLength:32*1024*1024}),out=new Map();for(let off=0;off+512<=data.length;){const h=data.subarray(off,off+512);if(h.every(x=>x===0))break;let sum=0;for(let i=0;i<512;i++)sum+=i>=148&&i<156?32:h[i];const oct=(a,b)=>parseInt(h.subarray(a,b).toString('ascii').replaceAll('\0','').trim(),8);assert.equal(sum,oct(148,156));const n=oct(124,136);assert.ok(Number.isSafeInteger(n)&&n>=0&&off+512+n<=data.length);const clean=(a,b)=>h.subarray(a,b).toString('utf8').split('\0')[0],prefix=clean(345,500),name=(prefix?prefix+'/':'')+clean(0,100);assert.ok(!out.has(name));out.set(name,data.subarray(off+512,off+512+n));off+=512+Math.ceil(n/512)*512;}return out;}
const provenance=await json(path.join(retained,'original-provenance.json')),sourceProof=await json(path.join(retained,'preserved/sources.json')),archiveRecords=[];const archives=[];
for(const e of provenance.archives){const b=await fs.readFile(e.source);assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256);archives.push(b);archiveRecords.push({path:e.source,bytes:b.length,sha256:sha(b),sha512:'sha512-'+createHash('sha512').update(b).digest('base64')});}
assert.equal(archiveRecords[0].sha512,sourceProof.registryIntegrity);assert.equal(archiveRecords[1].sha512,sourceProof.oracleDependency.integrity);const official=tar(archives[0]),lodash=tar(archives[1]);assert.equal(Object.keys(plan.authority.files).length,6);
for(const[file,h]of Object.entries(plan.authority.files)){const b=await fs.readFile(file);assert.equal(sha(b),h);const name=file.replaceAll('\\','/');const member=name.endsWith('/lodash.js')?lodash.get('package/lodash.js'):official.get('package/'+name.split('/artifacts/package/')[1]);assert.ok(member&&b.equals(member));}
for(const e of provenance.originalCopies)assert.deepEqual(await fp(confined(retained,e.path)),{bytes:e.bytes,sha256:e.sha256});

const timing=await json(path.join(retained,'results/timing-attempt-1791846775405.json')),paired=await json(path.join(retained,'results/paired-control-1791846775389.json')),memory=await json(path.join(retained,'results/memory-observations-control-1791847131780.json'));
assert.equal(paired.records.length,147);assert.equal(memory.samples.length,147);assert.equal(paired.status,'passed');assert.equal(memory.status,'passed');assert.deepEqual(paired.sourceHashesBefore,paired.sourceHashesAfter);assert.deepEqual(memory.sourceHashesBefore,memory.sourceHashesAfter);assert.deepEqual(timing.sourceHashesBefore,timing.sourceHashesAfter);
assert.deepEqual(JSON.parse(await fs.readFile(confined(retained,timing.stdout.path),'utf8')),timing.result);assert.equal((await fp(confined(retained,timing.stdout.path))).sha256,timing.stdout.sha256);assert.equal((await fp(confined(retained,timing.stderr.path))).sha256,timing.stderr.sha256);
let timingChecks=0,memoryChecks=0,observerCount=0,rawFiles=0,childNegative=0,pairedNegative=0,zeroPercent=0;
for(const e of paired.records){assert.equal(e.exitCode,0);assert.equal(e.signal,null);assert.equal(e.error,undefined);assert.equal(e.result.measurementRun,true);assert.equal(e.result.loadedReducerImplementations,3);assert.equal(e.result.memoryIsNotIsolated,true);assert.equal(e.result.manifestSHA256,planHash);const spec=plan.expectedFiles[e.caseName];assert.equal(e.result.iterations,spec.spec.iterations);assert.equal(e.result.warmup,spec.spec.warmup);assert.equal(e.result.samples,spec.spec.n);assert.equal(e.result.selectionCount,spec.spec.reducers.length);assert.equal(e.result.inputSHA256,spec.inputSHA256);assert.equal(e.result.outputCacheSHA256,spec.canonicalOutputSHA256);assert.equal(e.result.millisecondsPerCall,e.result.elapsedMilliseconds/e.result.iterations);assert.equal(e.result.comparisons,9);timingChecks+=e.result.comparisons;for(const x of [e.stdout,e.stderr]){const b=await fs.readFile(confined(retained,x.path));assert.equal(sha(b),x.sha256);assert.ok(b.length<=2*1024*1024);rawFiles++;}assert.deepEqual(JSON.parse(await fs.readFile(confined(retained,e.stdout.path),'utf8')),e.result);}
const timingComputed=[];
for(const name of cases){const by=Object.fromEntries(roles.map(r=>[r,statistics(group(paired.records,name,r).map(x=>x.result.millisecondsPerCall))])),against={};for(const r of ['baseline','original'])against[r]={medianRatioPercent:100*(by.candidate.median/by[r].median-1),pairedDifferenceMilliseconds:statistics(by.candidate.values.map((v,i)=>v-by[r].values[i])),pairedRatioPercent:statistics(by.candidate.values.map((v,i)=>100*(v/by[r].values[i]-1))),observedRanges:ranges(by.candidate,by[r]),candidateSlowerPairs:by.candidate.values.filter((v,i)=>v>by[r].values[i]).length};timingComputed.push({caseName:name,millisecondsPerCall:by,candidateComparedWith:against});}
assert.deepEqual(timingComputed,summary.timingSummary);

const memoryRows=[],resultNames=await fs.readdir(path.join(retained,'results'));
for(const e of memory.samples){assert.equal(e.code,0);assert.equal(e.signal,null);assert.equal(e.failure,undefined);const r=e.result;assert.equal(r.pid,e.pid);assert.equal(r.implementation,e.implementation);assert.equal(r.caseName,e.caseName);assert.equal(r.measurementRun,true);assert.equal(r.loadedReducerImplementations,1);assert.equal(r.manifestSHA256,planHash);assert.deepEqual(r.selectedSources,plan.implementations[e.implementation].files);assert.equal(r.comparisons,3*(plan.expectedFiles[e.caseName].spec.retained+2));memoryChecks+=r.comparisons;
 if(e.implementation==='original')assert.deepEqual(r.loadedCJSModules.slice().sort(),Object.keys(plan.authority.files).sort());else{assert.equal(r.loadedCJSModules.length,0);assert.equal(r.loadedNativeModuleFiles,e.implementation==='candidate'?2:1);}
 const prefix='memory-control-'+e.implementation+'-'+e.caseName+'-'+e.runNumber+'-',matches=resultNames.filter(n=>n.startsWith(prefix)&&n.endsWith('.stdout.txt'));assert.equal(matches.length,1);const stem=matches[0].slice(0,-'.stdout.txt'.length),raw=[];for(const suffix of ['.stdout.txt','.stderr.txt','.observer.txt','.observer-errors.txt']){const b=await fs.readFile(path.join(retained,'results',stem+suffix));assert.ok(b.length<=plan.limits.stdoutBytes);raw.push(b);rawFiles++;}assert.equal(sha(raw[0]),e.stdoutSHA256);assert.equal(sha(raw[1]),e.stderrSHA256);assert.equal(raw[1].length,0);assert.equal(raw[3].length,0);
 const lines=b=>b.toString().trim().split(/\r?\n/).map(x=>JSON.parse(x)),rows=lines(raw[0]),obs=lines(raw[2]);assert.deepEqual(rows.filter(x=>x.kind==='result'),[r]);assert.deepEqual(rows.filter(x=>x.kind==='snapshot').map(({kind,...x})=>x),r.checkpoints);assert.equal(obs.length,e.ownedPIDObserver.samples);assert.ok(obs.length>0);for(const x of obs){assert.equal(x.pid,e.pid);assert.ok(Number.isFinite(x.rss)&&x.rss>0&&x.rss<=plan.limits.childRSSMiB*1024*1024);}assert.equal(Math.max(...obs.map(x=>x.rss)),e.ownedPIDObserver.peakRSS);observerCount+=obs.length;
 const point=n=>{const p=r.checkpoints.filter(x=>x.name===n);assert.equal(p.length,1);return p[0]};for(const n of ['beforeSelectedImport','afterSelectedInitialization','afterSharedInput','warmBase','afterTransient','beforeRetention','retainedAfterGC','releasedAfterGC'])point(n);for(const x of r.checkpoints){assert.equal(x.pid,e.pid);assert.ok(x.rss<=plan.limits.childRSSMiB*1024*1024);}
 const values={observedPeakRSSBytes:Math.max(...obs.map(x=>x.rss)),lifetimePeakRSSBytes:Math.max(...r.checkpoints.map(x=>x.lifetimePeakResidentKiB))*1024,checkpointPeakRSSBytes:Math.max(...r.checkpoints.map(x=>x.rss)),checkpointPeakHeapUsedBytes:Math.max(...r.checkpoints.map(x=>x.heapUsed))};for(const metric of ['rss','heapUsed','external','arrayBuffers'])for(const[label,a,b]of [['initialized','afterSelectedInitialization','beforeSelectedImport'],['retained','retainedAfterGC','beforeRetention'],['released','releasedAfterGC','beforeRetention'],['releasedFromWarmBase','releasedAfterGC','warmBase']])values[label+'-'+metric+'-signedBytes']=point(a)[metric]-point(b)[metric];childNegative+=Object.values(values).filter(x=>x<0).length;memoryRows.push({implementation:e.implementation,caseName:e.caseName,runNumber:e.runNumber,pid:e.pid,rawStem:'results/'+stem,observerSamples:obs.length,metrics:values});
}
assert.deepEqual(memoryRows,summary.memorySignedPerChildRows);const memoryComputed=[];
for(const name of cases){const rows=Object.fromEntries(roles.map(r=>[r,group(memoryRows,name,r)])),names=Object.keys(rows.original[0].metrics),by=Object.fromEntries(roles.map(r=>[r,Object.fromEntries(names.map(m=>[m,statistics(rows[r].map(x=>x.metrics[m]))]))])),against={};for(const r of ['baseline','original']){against[r]={};for(const m of names){const diff=rows.candidate.map((x,i)=>x.metrics[m]-rows[r][i].metrics[m]);const perc=rows.candidate.map((x,i)=>rows[r][i].metrics[m]===0?null:100*(x.metrics[m]-rows[r][i].metrics[m])/rows[r][i].metrics[m]);pairedNegative+=diff.filter(x=>x<0).length;zeroPercent+=perc.filter(x=>x===null).length;against[r][m]={medianDifferenceBytes:by.candidate[m].median-by[r][m].median,pairedDifferenceBytes:statistics(diff),observedRanges:ranges(by.candidate[m],by[r][m]),pairedPercentChange:nullableStatistics(perc),percentageDefinition:'Signed difference divided by signed control; unavailable when control is zero; not a physical allocation efficiency ratio for signed deltas.'};}}memoryComputed.push({caseName:name,metricsByImplementation:by,candidateComparedWith:against});}
assert.deepEqual(memoryComputed,summary.memorySummary);assert.equal(timingChecks,1323);assert.equal(memoryChecks,1311282);assert.equal(observerCount,1987);assert.equal(rawFiles,882);assert.equal(childNegative,27);assert.equal(pairedNegative,845);assert.equal(zeroPercent,686);assert.equal(paired.records.length*2,294);assert.equal(memory.samples.length*4,588);
for(const field of ['timingBranchFailures','memoryBranchFailures','partialChildren','failedOrLimitHitChildren','killedChildren'])assert.equal(receipt.failuresAndCensoring[field],0);assert.equal(receipt.rejection.numericAcceptanceThresholdIntroducedAfterMeasurements,false);assert.equal(receipt.productionIntegrated,false);assert.equal(frozen.candidateAccepted,false);assert.equal(frozen.productionIntegrated,false);
const ap=timingComputed.find(x=>x.caseName==='allPercentiles'),p95=memoryComputed.find(x=>x.caseName==='singlePercentile');const timingSeconds=(Date.parse(timing.interval.end)-Date.parse(timing.interval.start))/1000,memorySeconds=(Date.parse(memory.interval.end)-Date.parse(memory.interval.start))/1000;
assert.equal(timingSeconds,105.58);assert.equal(memorySeconds,273.433);assert.ok(Date.parse(timing.interval.start)>=Date.parse('2026-10-12T23:10:45Z')&&Date.parse(timing.interval.end)<=Date.parse('2026-10-12T23:13:48Z'));assert.ok(Date.parse(memory.interval.start)>=Date.parse('2026-10-12T23:13:48Z')&&Date.parse(memory.interval.end)<=Date.parse('2026-10-12T23:19:48Z'));
await authenticate(frozen.entries,stage);for(const[p,h]of Object.entries(pins))assert.equal((await fp(path.join(stage,p))).sha256,h);
const result={schema:'rea-independent-metrics-algorithm-measured-audit/v1',completedAt:new Date().toISOString(),status:'PASS_AUTHENTICATION_AND_RECOMPUTATION_CANDIDATE_REMAINS_UNACCEPTED',stage,pinnedSHA256:pins,strictArtifacts:2217,allBytesAndStrictPathsMatchBeforeAfter:true,currentStudySourceCopies:1006,readinessArtifacts:117,unchangedWorkloads:7,unchangedInputAndExpectedFiles:14,candidate:receipt.candidate,originalSourceBindings:receipt.originalSourceBindings,originalArchives:archiveRecords,originalArchiveMembersMatchAll6LoadedFiles:true,nodeRuntime:receipt.runtime,productionBaselineUnchanged:true,counts:{timingChildren:147,memoryChildren:147,timingFreshAndCachedPacketChecks:timingChecks,memoryFreshAndCachedPacketChecks:memoryChecks,ownedPIDObserverSamples:observerCount,rawChildAndObserverLogs:rawFiles,negativeSignedChildMetricValues:childNegative,negativePairedMetricValues:pairedNegative,zeroControlUnavailablePercentages:zeroPercent},all7TimingAnd7MemorySummaryRowsAnd147SignedRowsIndependentlyEqual:true,childCensoring:{failed:0,killed:0,partial:0,limitHit:0,noneInThisRecordedRun:true,derivedUnavailablePercentagesAreNotMissingChildren:true},observations:{allPercentiles:{candidateMsMedian:ap.millisecondsPerCall.candidate.median,baselineMsMedian:ap.millisecondsPerCall.baseline.median,ratioOfMediansPercent:ap.candidateComparedWith.baseline.medianRatioPercent,medianOfPairedPercentages:ap.candidateComparedWith.baseline.pairedRatioPercent.median,slowerPairs:ap.candidateComparedWith.baseline.candidateSlowerPairs,observedRangesOverlap:ap.candidateComparedWith.baseline.observedRanges.overlap},singleP95LifetimeRSSMiB:{baseline:p95.metricsByImplementation.baseline.lifetimePeakRSSBytes.median/1048576,candidate:p95.metricsByImplementation.candidate.lifetimePeakRSSBytes.median/1048576}},windows:{timingSeconds,memorySeconds,recordedWithinTrustedRootAuthorizationIntervals:true,coordinationIsTrustedSessionEvidenceNotMachineAttestation:true},limitations:['Seven repetitions of seven fixed synthetic workloads on one Windows host; ranges are descriptive, not confidence intervals.','Timing loads all three implementations for common prevalidation; its memory diagnostics are not isolated.','Memory loads one selected implementation; signed release/retention deltas include GC and common serialization/cache validation pressure.','Negative values are retained; percentages over signed controls do not describe physical allocation efficiency. Zero-control percentages remain unavailable.','Nominal100ms numeric-PID observer and checkpoints can miss peaks; lifetime RSS is a complete-child high-water mark. No process-start/PID-reuse proof, OS sandbox, cumulative allocation accounting or outer memory-controller watchdog.','Source-identical historic compatibility campaigns and66 correctness inputs are authenticated provenance; no new exhaustive semantic replay or measured-input replacement.','No new numeric acceptance threshold, production integration, causal explanation, superiority or performance parity.'],readOnlyLookupError:{attempted:'measurement-review-validation.json',actual:'measurement-validation.json',candidateIssue:false},executions:{newReducerCalls:0,newMeasurementChildren:0,newTests:0,newBrowsers:0},productionOrStageModified:false,fullPerformanceNonRegressionEstablished:false,fullProductParity:false,universalSuperiority:false};
result.counts.newMeasurementArtifacts=newArtifacts.length;result.counts.timingChildRawLogs=294;result.counts.memoryChildAndObserverRawLogs=588;
await fs.writeFile(path.join(own,'audit-validation.json'),JSON.stringify(result,null,2)+'\n');await fs.writeFile(path.join(own,'recomputed-statistics.json'),JSON.stringify({schema:'rea-independent-observation-arithmetic/v1',timingSummary:timingComputed,memorySummary:memoryComputed,memorySignedPerChildRows:memoryRows},null,2)+'\n');
console.log(JSON.stringify({status:result.status,receipt:await fp(path.join(own,'audit-validation.json')),counts:result.counts,observations:result.observations}));
