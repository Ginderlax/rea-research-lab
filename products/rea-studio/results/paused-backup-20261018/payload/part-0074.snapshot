    {
      "id": "grafana.candidate.21509795591c9f37e3ec",
      "syntaxRole": "list-item",
      "sourceText": "- **Organization -** Affects all users in an organization. Set by an [Organization admin](../roles-and-permissions/#organization-roles).",
      "headingPath": [
        "Organization preferences"
      ],
      "source": {
        "path": "docs/sources/administration/organization-preferences/index.md",
