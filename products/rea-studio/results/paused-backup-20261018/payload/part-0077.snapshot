    {
      "id": "grafana.candidate.441d1e7cf09d80bd8b15",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can roll back secrets encrypted with envelope encryption to legacy encryption. This might be necessary to downgrade to Grafana versions prior to v9.0 after an unsuccessful upgrade.",
      "headingPath": [
        "Configure database encryption",
        "Operational work",
        "Roll back secrets"
      ],
      "source": {
