    {
      "id": "grafana.candidate.2a5dc4082a98bce8b3bb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You **must** be familiar with a data source's query language. For more information, refer to [Data sources](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/).",
      "headingPath": [
