    },
    {
      "id": "grafana.candidate.be68faf4f4c453ad9a05",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The amount of times the HTTP or gRPC client will retry a failed request to Loki. The default is `10`.",
      "headingPath": [
        "Configure Grafana Enterprise",
        "[auditing.logs.loki]",
        "retries"
