    {
      "id": "grafana.candidate.4b71e2d4b41073424376",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Update the variable query to return unique values. For SQL, use `SELECT DISTINCT`. For InfluxQL, `SHOW` metadata queries already return unique values, so check for duplicates across retention policies.",
      "headingPath": [
        "Troubleshoot InfluxDB data source issues",
        "Template variable errors",
        "Variable drop-down contains a blank or duplicate entry"
      ],
