    {
      "id": "grafana.candidate.beddb5a1a72b6429f519",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Finally, you can also enable it using the UI by going to **Administration -> Authentication -> Auth settings**.",
      "headingPath": [
        "Configure authentication",
        "Extended authentication settings",
        "Enable email lookup"
      ],
      "source": {
