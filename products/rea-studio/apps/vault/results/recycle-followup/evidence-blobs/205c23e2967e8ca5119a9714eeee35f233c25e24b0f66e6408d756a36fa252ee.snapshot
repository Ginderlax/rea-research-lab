import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import os from 'node:os';
import path from 'node:path';
import {createHash,randomBytes,randomUUID} from 'node:crypto';
import {spawn} from 'node:child_process';
const stage=new URL('../keepass-recycle-next/',import.meta.url),app=new URL('products/rea-studio/apps/vault/',stage),own=import.meta.dirname;
const {normalizeRecycleData,recycleView,deleteRecycleEntry,restoreRecycleEntry,recycleRead}=await import(new URL('recycle.mjs',app)),{handle,dispose}=await import(new URL('server.mjs',app)),{importKdbx,exportKdbx,materializeKdbxDocument,projectKdbxDocument,encodeKdbxDate,decodeKdbxDate}=await import(new URL('kdbx.mjs',app)),{one,nodes,text,put,element,serializeXml}=await import(new URL('xml.mjs',app));
const A='11111111-2222-3333-4444-555555555555',binId='aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee',childId='99999999-8888-7777-6666-555555555555',now='2999-12-28T12:13:14Z',uuid64=id=>Buffer.from(id.replaceAll('-',''),'hex').toString('base64'),id64=raw=>{const h=Buffer.from(raw,'base64').toString('hex');return h.slice(0,8)+'-'+h.slice(8,12)+'-'+h.slice(12,16)+'-'+h.slice(16,20)+'-'+h.slice(20);},hash=b=>createHash('sha256').update(b).digest('hex');
function walk(node,name){if(node.name===name)return node;for(const child of nodes(node)){const result=walk(child,name);if(result)return result;}}
function changed(data,fn){const xml=materializeKdbxDocument(data);fn(xml);return {...data,entries:projectKdbxDocument(xml),kdbx:{...data.kdbx,xml:serializeXml(xml)}};}
function fixture(){return normalizeRecycleData({version:1,entries:[{id:A,title:'Held-out',username:'owned',password:'owned-secret',url:'',group:'Parent/Child',notes:'held-out content',totpSecret:'',createdAt:'0001-01-01T00:00:00Z',updatedAt:'2999-01-01T00:00:00Z'}]});}
function shape(data){const xml=materializeKdbxDocument(data),entry=walk(xml,'Entry'),times=entry&&one(entry,'Times');return {entry:entry?{id:id64(text(one(entry,'UUID'))),previous:one(entry,'PreviousParentGroup')?id64(text(one(entry,'PreviousParentGroup'))):'00000000-0000-0000-0000-000000000000',modified:decodeKdbxDate(text(one(times,'LastModificationTime'))),access:decodeKdbxDate(text(one(times,'LastAccessTime'))),location:decodeKdbxDate(text(one(times,'LocationChanged'))),usage:text(one(times,'UsageCount'))||'0',history:nodes(one(entry,'History'),'Entry').length}:null,tombstones:nodes(one(one(xml,'Root'),'DeletedObjects'),'DeletedObject').map(d=>({id:id64(text(one(d,'UUID'))),time:decodeKdbxDate(text(one(d,'DeletionTime')))}))};}
test('unknown native XML and preserved history/binaries survive recycle and restore without creating a history row',()=>{const key=randomBytes(32),data=changed(fixture(),xml=>{const e=walk(xml,'Entry'),historic=structuredClone(e);historic.children=historic.children.filter(n=>typeof n==='string'||n.name!=='History');one(e,'History').children.push(historic);e.children.push(element('OwnedFutureField',[element('Child','kept & private')]));put(one(e,'Times'),'UsageCount','7');}),before=JSON.stringify(data),row=recycleView(data,key).entries[0],deleted=deleteRecycleEntry(data,A,row.recycleRevision,key,{confirm:true,now,binId}).data,listed=recycleView(deleted,key,{bin:true}).entries[0],restored=restoreRecycleEntry(deleted,A,listed.recycleRevision,key,{confirm:true,now:'2999-12-29T12:13:14Z'}).data;assert.equal(JSON.stringify(data),before);assert.equal(shape(restored).entry.history,1);assert.equal(shape(restored).entry.usage,'8');assert.equal(shape(restored).entry.modified,shape(data).entry.modified);assert.equal(text(one(walk(materializeKdbxDocument(restored),'OwnedFutureField'),'Child')),'kept & private');assert.equal(recycleView(restored,key).entries[0].password,'owned-secret');});
test('graph MAC includes history-only unknown XML edits and binary protection changes; stale operations leave source intact',()=>{const key=randomBytes(32),data=fixture(),r=recycleView(data,key).entries[0];for(const candidate of [changed(data,xml=>walk(xml,'Entry').children.push(element('HistoryFutureField','new'))),{...data,kdbx:{...data.kdbx,binaries:[{dataBase64:'AAE=',protected:true}]}}]){const snapshot=JSON.stringify(candidate);assert.throws(()=>deleteRecycleEntry(candidate,A,r.recycleRevision,key,{confirm:true,now,binId}),/selection changed/);assert.throws(()=>recycleRead(candidate,A,r.recycleRevision,key),/selection changed/);assert.equal(JSON.stringify(candidate),snapshot);}});
async function session(t){const records=new Map(),workspace={root:'independent-semantic-'+randomUUID()},store={get:async(k,f)=>structuredClone(records.get(k)??f),set:async(k,v)=>records.set(k,structuredClone(v))},call=(action,input={})=>handle({action,input,store,workspace});t.after(()=>dispose(workspace));await call('create',{password:'owned master semantic password'});const id=(await call('save',{title:'Owned state',group:'Previous',password:'own-state-secret'})).id;let row=(await call('read',{id})).entry;await call('save',{...row,password:'own-newer-secret'});row=(await call('read',{id})).entry;await call('recycleDelete',{id,revision:row.recycleRevision,confirm:true});return{records,store,call,id};}
for(const action of ['recycleRestore','recycleDelete'])test('failed '+action+' commit keeps encrypted bytes, bin placement and history unchanged',async t=>{const f=await session(t),listed=(await f.call('recycleList')).entries[0],before=structuredClone(f.records.get('vault.database')),set=f.store.set;f.store.set=async()=>{throw new Error('owned rejected recovery/purge commit');};await assert.rejects(f.call(action,{id:f.id,revision:listed.recycleRevision,confirm:true,permanent:true}),/owned rejected/);f.store.set=set;assert.deepEqual(f.records.get('vault.database'),before);assert.equal((await f.call('recycleList')).entries[0].id,f.id);const preview=(await f.call('recycleRead',{id:f.id,revision:listed.recycleRevision})).entry;assert.equal(preview.password,'own-newer-secret');await f.call('recycleRestore',{id:f.id,revision:listed.recycleRevision,confirm:true});assert.equal((await f.call('historyList',{id:f.id})).revisions.length,1);});
test('held durable restore makes queued purge stale and lock/reopen retains recovered history',async t=>{const f=await session(t),listed=(await f.call('recycleList')).entries[0];let release,enter;const held=new Promise(r=>release=r),started=new Promise(r=>enter=r),set=f.store.set;t.after(()=>release());f.store.set=async(k,v)=>{enter();await held;return set(k,v);};const restore=f.call('recycleRestore',{id:f.id,revision:listed.recycleRevision,confirm:true});await started;const purge=f.call('recycleDelete',{id:f.id,revision:listed.recycleRevision,confirm:true,permanent:true});release();await restore;await assert.rejects(purge,/selection changed/);f.store.set=set;await f.call('lock');await f.call('unlock',{password:'owned master semantic password'});assert.equal((await f.call('recycleList')).entries.length,0);assert.equal((await f.call('historyList',{id:f.id})).revisions.length,1);assert.equal((await f.call('read',{id:f.id})).entry.password,'own-newer-secret');});
const password='owned original recycle master',releaseSha='04d29636c393f0c1fc99ff739295494be3adefded93271e44591e8e300225a5a',originalExe=path.resolve(own,'../../outputs/rea-research-lab/projects/07-keepass/artifacts/portable/KeePass.exe');
async function original(directory,label,config){assert.equal(hash(await fs.readFile(originalExe)),releaseSha);const helper=new URL('recycle-oracle.ps1',app),configPath=path.join(directory,label+'.json');await fs.writeFile(configPath,JSON.stringify({oracle:originalExe,password,...config}));const helperSha=hash(await fs.readFile(helper));const result=await new Promise(resolve=>{let stdout='',stderr='',problem;const p=spawn('powershell.exe',['-NoProfile','-NonInteractive','-File',helper.pathname.replace(/^\//,''),'-Config',configPath],{windowsHide:true,stdio:['ignore','pipe','pipe']});const timer=setTimeout(()=>{problem='30s child deadline';p.kill();},30000);p.stdout.on('data',b=>{stdout+=b;if(Buffer.byteLength(stdout)>1048576){problem='stdout cap';p.kill();}});p.stderr.on('data',b=>{stderr+=b;if(Buffer.byteLength(stderr)>1048576){problem='stderr cap';p.kill();}});p.on('error',e=>{problem=e.message;});p.on('close',code=>{clearTimeout(timer);resolve({stdout,stderr,problem:problem??null,code});});});const observation={label,config,helperSha256:helperSha,releaseSha256:releaseSha,...result,assemblyLoaded:result.stderr.includes('REA_RECYCLE_ASSEMBLY_LOADED_2_61_1')};await fs.mkdir(path.join(own,'observations/original'),{recursive:true});await fs.writeFile(path.join(own,'observations/original',label+'.json'),JSON.stringify(observation,null,2)+'\n');assert.equal(result.code,0,result.stderr);assert.equal(result.problem,null);assert.equal(hash(await fs.readFile(originalExe)),releaseSha);return JSON.parse(result.stdout);}
test('released library agrees on held-out existing-bin descendant purge and previous-parent recovery, and reads candidate output',async t=>{const dir=await fs.mkdtemp(path.join(os.tmpdir(),'rea-independent-recycle-'));t.after(async()=>{assert.equal(path.dirname(dir),path.resolve(os.tmpdir()));assert.ok(path.basename(dir).startsWith('rea-independent-recycle-'));await fs.rm(dir,{recursive:true,force:true});});const seedFile=path.join(dir,'seed.kdbx');await original(dir,'seed',{mode:'create',database:seedFile});const seed=await importKdbx(await fs.readFile(seedFile),{password}),key=randomBytes(32),active=recycleView(seed,key).entries[0],trashed=deleteRecycleEntry(seed,A,active.recycleRevision,key,{confirm:true,now,binId}).data;
 const nested=changed(trashed,xml=>{const top=one(one(xml,'Root'),'Group'),bin=nodes(top,'Group').find(g=>text(one(g,'UUID'))===uuid64(binId)),entry=nodes(bin,'Entry')[0],child=structuredClone(bin);put(child,'UUID',uuid64(childId));put(child,'Name','Child');child.children=child.children.filter(n=>typeof n==='string'||!['Entry','Group'].includes(n.name));bin.children=bin.children.filter(n=>n!==entry);child.children.push(entry);bin.children.push(child);});const candidateFile=path.join(dir,'nested.kdbx');await fs.writeFile(candidateFile,await exportKdbx(nested,{password},{kdf:'aes',rounds:100}));const binRow=recycleView(nested,key,{bin:true}).entries[0],restored=restoreRecycleEntry(nested,A,binRow.recycleRevision,key,{confirm:true,now}).data;
 const releaseRestored=await original(dir,'nested-restore',{mode:'read',database:candidateFile,operations:[{action:'restore',id:A,now}]});assert.equal(releaseRestored.savedVersion,0x40001);const expected=releaseRestored.entries[0],actual=shape(restored).entry;for(const k of ['id','previous','modified','access','location','usage','history'])assert.equal(actual[k],expected[k],k);assert.equal(restored.entries[0].kdbxGroupId,expected.parent);assert.equal(restored.entries[0].password,expected.fields.Password.value);assert.equal(actual.previous,childId);
 const restoredFile=path.join(dir,'restored.kdbx');await fs.writeFile(restoredFile,await exportKdbx(restored,{password},{kdf:'aes',rounds:100}));const opened=await original(dir,'candidate-read',{mode:'read',database:restoredFile,save:false});assert.equal(opened.entries[0].previous,childId);assert.equal(opened.entries[0].history,1);
 await fs.writeFile(candidateFile,await exportKdbx(nested,{password},{kdf:'aes',rounds:100}));const purged=deleteRecycleEntry(nested,A,binRow.recycleRevision,key,{confirm:true,now}).data,releasePurged=await original(dir,'nested-purge',{mode:'read',database:candidateFile,operations:[{action:'delete',id:A,now}]});assert.equal(purged.entries.length,0);assert.deepEqual(shape(purged).tombstones,releasePurged.deleted);assert.equal(releasePurged.calls.touch,0);assert.equal(releasePurged.calls.tombstoneConstructor,1);console.log(JSON.stringify({independentOriginalRecycle:{assemblyLoads:4,sourceComposedRestore:1,sourceComposedDelete:1,originalGUI:0,heldOutNestedBin:true,conditionalKdbx41:true}}));});
