    {
      "id": "grafana.candidate.6fbdc2f0f3befef40091",
      "syntaxRole": "list-item",
      "sourceText": "- Repeat the steps above for `region = us-east` but without overriding grouping and timing options. Use a different webhook endpoint as the contact point.",
      "headingPath": [
