    {
      "id": "grafana.candidate.344f01a51450bdf9dfd9",
      "syntaxRole": "list-item",
      "sourceText": "- Use environment variables in dashboard provisioning configuration, but not in the dashboard definition files themselves.",
      "headingPath": [
        "Provision Grafana",
        "Use environment variables"
      ],
      "source": {
