    {
      "id": "grafana.candidate.e3535daefb0d94d6ae35",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The MySQL data source supports username and password authentication, with optional TLS for encrypted connections. Kerberos, gMSA, and other external authentication mechanisms aren't supported. Create a dedicated MySQL user for Grafana instead.",
