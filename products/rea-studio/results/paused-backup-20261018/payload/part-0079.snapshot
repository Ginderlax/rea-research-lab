      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The bar is drawn around the point. The point is placed in the center of the bar. This is the default.",
      "headingPath": [
        "Candlestick",
        "Configuration options",
        "Graph styles options",
        "Bar alignment"
      ],
      "source": {
