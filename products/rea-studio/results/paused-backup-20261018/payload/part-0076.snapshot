    {
      "id": "grafana.candidate.f3bc8146cb1602dd38b6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "[Jaeger](https://www.jaegertracing.io/) is an open source, end-to-end distributed tracing system. Use the Jaeger data source to query and visualize traces, explore service dependencies, and correlate traces with logs and metrics.",
      "headingPath": [
        "Jaeger data source"
      ],
      "source": {
