import fs from'node:fs';import path from'node:path';import{createHash}from'node:crypto';const stage='work/keepass-group-bin-coherence-fix-next',app=stage+'/products/rea-studio/apps/vault',old=fs.readFileSync('work/keepass-group-postfreeze-review/probe.test.mjs','utf8');let next=old.replace("'../keepass-group-recycle-next/products/rea-studio/apps/vault/client.mjs'","'./client.mjs'").replace("'../keepass-group-recycle-next/products/rea-studio/apps/vault/server.mjs'","'./server.mjs'").replace("'../keepass-group-recycle-next/products/rea-studio/apps/vault/ui-fixture.mjs'","'./ui-fixture.mjs'").replace("const own=path.dirname(fileURLToPath(import.meta.url));","const own=process.env.GROUP_OBSERVATIONS??path.resolve(path.dirname(fileURLToPath(import.meta.url)),'../../../../.local/group-coherence-replay');await fs.mkdir(own,{recursive:true});");const body=s=>s.slice(s.indexOf('for(const close of'));if(body(old)!==body(next))throw new Error('Replay bodies changed');fs.writeFileSync(app+'/group-coherence-replay.test.mjs',next);const p=app+'/group-ui.test.mjs',before=fs.readFileSync(p,'utf8'),a="f.store.set=real;await control.click();assert.equal((await f.call('list')).entries.length,0);",b="f.store.set=real;await button(f.root,'Show groups').click();const fresh=row(f.root,'Selected');field(fresh,'Confirm recycle group and descendants').checked=true;await button(fresh,'Recycle group and descendants').click();assert.equal((await f.call('list')).entries.length,0);";if(!before.includes(a))throw new Error('Explicit retry adapter anchor absent');fs.writeFileSync(p,before.replace(a,b).replace('failed group persistence restores controls and explicit retry uses same uncommitted selection','failed group persistence allows explicit fresh list/reconfirmation retry of unchanged group'));const sha=x=>createHash('sha256').update(x).digest('hex');fs.writeFileSync(stage+'/test-adapters.json',JSON.stringify({schema:'rea-vault-group-coherence-test-adapters/v1',replay:{from:'work/keepass-group-p