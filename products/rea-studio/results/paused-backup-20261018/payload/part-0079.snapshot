    {
      "id": "grafana.candidate.0fbb7ba9e56591cd7bb4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Explore now supports forward direction search for Loki logs searches. This allows users to seamlessly browse logs in a time range in forward chronological order (for example, tracing a specific user's actions using logs).",
      "headingPath": [
        "What’s new in Grafana v11.2",
        "Explore",
        "Forward direction search for Loki"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-2.md",
