    {
      "id": "grafana.candidate.808b0835c14bd5ce346a",
      "syntaxRole": "list-item",
      "sourceText": "- Grafana provisioning has a new schema. Please refer to the documentation for more information.",
      "headingPath": [
        "What's new in Grafana v9.0",
        "Breaking changes",
        "Role-based access control: changes for general release"
      ],
