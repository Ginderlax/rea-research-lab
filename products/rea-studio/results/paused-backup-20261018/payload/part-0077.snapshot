    {
      "id": "grafana.candidate.be38960487673c3fe134",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you want to track Grafana usage with Google Analytics 4 specify _your_ GA4 ID here. By default this feature is disabled.",
