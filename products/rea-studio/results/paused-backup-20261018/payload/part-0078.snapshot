      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c97bd8bdce328e2857cf",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Refer to each individual data source's documentation for configuration instructions. For Tempo, refer to [Trace to metrics configuration](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/tempo/configure-tempo-data-source/configure-trace-to-metrics/).",
      "headingPath": [
        "Traces in Explore",
        "Trace view",
        "Trace to metrics"
      ],
