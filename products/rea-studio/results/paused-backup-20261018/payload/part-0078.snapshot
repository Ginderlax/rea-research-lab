    },
    {
      "id": "grafana.candidate.fdc667a3a42c5551e91f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Open the dashboard in edit mode and click Add → Visualization. Select a data source, write or build your query, choose how to visualize the results, and adjust the panel options on the right. Click Apply to add the panel to the dashboard, then Save to persist your changes.",
      "headingPath": [
        "Create dashboards",
        "Frequently asked questions"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/build-dashboards/create-dashboard/_index.md",
