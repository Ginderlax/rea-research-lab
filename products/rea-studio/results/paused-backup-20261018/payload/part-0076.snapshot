    {
      "id": "grafana.candidate.6ec58ea92fdf3fa9fcc1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "All operations display function parameters beneath the operation header. Some operations allow you to apply specific labels (for example, `by` or `without` clauses).",
