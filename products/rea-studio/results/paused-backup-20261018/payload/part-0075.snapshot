    },
    {
      "id": "grafana.candidate.ff3bb2fe11c520c89e86",
      "syntaxRole": "list-item",
      "sourceText": "- `<FOLDER_UI_NAME>` is the display name shown in the Grafana UI. This field is optional. If it's not set, Grafana uses the directory name instead.",
      "headingPath": [
