    {
      "id": "grafana.candidate.eda812d7c37aa8a04359",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For the heatmap visualization only, when you set the **Tooltip mode** to **Single**, the **Show histogram (Y axis)** option is displayed. This option controls whether or not the tooltip includes a histogram representing the y-axis.",
      "headingPath": [
        "Configure tooltips",
        "Tooltip options",
        "Show histogram (Y axis)"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/configure-tooltips/index.md",
        "gitBlobSha": "b31ec7bb6d07fe9c55b02309252a5b07e0c9b1c2",
        "sha256": "0a7fb2d48300a449bd6216d9bece010ec4fab1311ae2d6c82066fc11fa753b42",
        "lineStart": 151,
        "lineEnd": 151,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/panels-visualizations/configure-tooltips/index.md#L151-L151"
      },
