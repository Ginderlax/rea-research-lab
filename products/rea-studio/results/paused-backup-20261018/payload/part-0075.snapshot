    {
      "id": "grafana.candidate.95bcd5387efce3ff3048",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Enable **Enable Prefix Matching** to find alarms by name and action prefix rather than by a specific metric. Grafana requests up to 100 alarms from `cloudwatch:DescribeAlarms` using the **Alarm Name** and **Action** prefixes, then filters the returned alarms by the namespace, metric name, dimensions, statistic, and period you specify. You must provide both an **Alarm Name** prefix and an **Action** prefix for the query to run.",
      "headingPath": [
        "Amazon CloudWatch annotations",
        "Create an annotation query",
        "Match alarms by prefix"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/annotations/index.md",
        "gitBlobSha": "567430df82cce90bd65234bc648ec20c7bf15365",
        "sha256": "1134e2a7951e46d97473a1667a2e1d8db7a21a2b1961bf20a83c831fed62d980",
        "lineStart": 87,
        "lineEnd": 87,
