import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,workspace=path.resolve(here,'../..'),sha=b=>createHash('sha256').update(b).digest('hex'),authorities=JSON.parse(await fs.readFile(path.join(here,'authority-after.json')));for(const row of authorities){const name=row.directory.split('/').at(-1),dest=path.join(here,'authority',name);await fs.mkdir(dest,{recursive:true});for(const file of[row.manifest,name.endsWith('independent-review')?'review-validation.json':'validation.json'])await fs.writeFile(path.join(dest,file+'.snapshot'),await fs.readFile(path.join(workspace,row.directory,file)),{flag:'wx'});}async function walk(d,p=''){const out=[];for(const e of await fs.readdir(d,{withFileTypes:true})){if(e.isDirectory())out.push(...await walk(path.join(d,e.name),p+e.name+'/'));else out.push(p+e.name);}return out;}const inventory={};let totalBytes=0;for(const rel of(await walk(here)).sort()){assert.notEqual(rel,'freeze-manifest.json');const b=await fs.readFile(path.join(here,rel));inventory[rel]={bytes:b.length,sha256:sha(b)};totalBytes+=b.length;}const receipt=inventory['validation.json'];await fs.writeFile(path.join(here,'freeze-manifest.json'),JSON.stringify({schema:'rea-notes-corrected-inline-browser-strict-freeze/v1',at:new Date().toISOString(),strict:true,selfExcluded:'freeze-manifest.json',files:Object.keys(inventory).length,totalBytes,receiptSHA256:receipt.sha256,inventory},null,2)+'\n',{flag:'wx'});const manifest=await fs.readFile(path.join(here,'freeze-manifest.json'));console.log(JSON.stringify({files:Object.keys(inventory).length,receiptSHA256:receipt.sha256,manifestSHA256:sha(manifest),immutable:true}));
