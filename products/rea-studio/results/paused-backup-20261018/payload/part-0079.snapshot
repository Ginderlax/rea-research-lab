    {
      "id": "grafana.candidate.984cb4797252c376ca7d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "All panels that have migrated from Flot to uPlot will also render two to three times faster because the library is much more efficient. Right now, this includes the Time series, Stat, Timeline, Histogram, and Barchart panel visualizations.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Grafana OSS features",
        "Performance improvements",
        "Initial startup and load performance"
      ],
