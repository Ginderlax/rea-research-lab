    {
      "id": "grafana.candidate.d5432d7e93b28b73f79c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In version 8.5, we discontinued the \"Use Proxy\" option for Grafana news visualizations. As a result, RSS feeds that are not configured for request by Grafana's frontend (with the appropriate [CORS headers](https://developer.mozilla.org/en-US/docs/Web/HTTP/CORS)) may not load.",
      "headingPath": [
