import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';import {spawn} from 'node:child_process';
const own=import.meta.dirname,workspace=path.resolve(own,'../..'),candidate=path.join(workspace,'work/keepass-group-recycle-next'),lab=path.join(workspace,'outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex');
async function verifyCandidate(){const bytes=await fs.readFile(path.join(candidate,'manifest.json'));assert.equal(sha(bytes),'048fc56fded29bb89cf43830919c4b717a82d055e531644028b85ef07917e28d');const m=JSON.parse(bytes);assert.equal(m.schema,'rea-keepass-group-strict-preservation/v1');assert.equal(m.inventory.length,777);for(const row of m.inventory){const b=await fs.readFile(path.join(candidate,row.path));assert.equal(b.length,row.bytes,row.path);assert.equal(sha(b),row.sha256,row.path);}return {files:m.inventory.length,manifestSha256:sha(bytes)};}
const before=await verifyCandidate(),sources=[];
for(const [origin,base,relative] of [['public-f0b4746e',lab,'server.mjs'],['public-f0b4746e',lab,'catalog.mjs'],['public-f0b4746e',lab,'lib/storage.mjs'],...['server','recycle','history','kdbx','xml'].map(n=>['frozen777',candidate,'apps/vault/'+n+'.mjs'])]){const source=path.join(base,'products/rea-studio',relative),bytes=await fs.readFile(source),target=path.join(own,'host',relative);if(relative==='server.mjs')assert.equal(sha(bytes),'85fe09b1b52a1d91e9d09c85d99c6e768ac4b793f5d7694a1760a4c0560a0a94');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,bytes,{flag:'wx'});sources.push({origin,source:path.relative(workspace,source).replaceAll('\\','/'),materialized:path.relative(own,target).replaceAll('\\','/'),bytes:bytes.length,sha256:sha(bytes)});}
for(const n of ['http.test.mjs','host-runner.mjs','run.mjs']){const bytes=await fs.readFile(path.join(own,n));sources.push({origin:'owned-independent-review',source:path.relative(workspace,path.join(own,n)).replaceAll('\\','/'),materialized:n,bytes:bytes.length,sha256:sha(bytes)});}
const runtime=await fs.readFile(process.execPath);assert.equal(sha(runtime),'b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3');await fs.writeFile(path.join(own,'source-before.json'),JSON.stringify(sources,null,2)+'\n',{flag:'wx'});
const startedAt=new Date().toISOString(),child=spawn(process.execPath,['--test','--test-concurrency=1',path.join(own,'http.test.mjs')],{windowsHide:true}),output={stdout:[],stderr:[]};let outputBytes=0,collectorProblem=null;const timer=setTimeout(()=>{collectorProblem='Owned review 150-second deadline';child.kill();},150000);for(const k of Object.keys(output))child[k].on('data',b=>{outputBytes+=b.length;if(outputBytes>2*1024*1024){collectorProblem='Review output bound exceeded';child.kill();}else output[k].push(b);});const exit=await new Promise((resolve,reject)=>{child.once('error',reject);child.once('close',(code,signal)=>resolve({code,signal}));});clearTimeout(timer);for(const k of Object.keys(output))await fs.writeFile(path.join(own,k+'.txt'),Buffer.concat(output[k]),{flag:'wx'});
const after=await verifyCandidate();for(const row of sources){const original=await fs.readFile(path.join(workspace,row.source)),materialized=await fs.readFile(path.join(own,row.materialized));assert.equal(original.length,row.bytes);assert.equal(sha(original),row.sha256);assert.deepEqual(materialized,original);}await fs.writeFile(path.join(own,'source-after.json'),JSON.stringify(sources,null,2)+'\n',{flag:'wx'});
const raw=Buffer.concat(output.stdout).toString(),counts=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(k=>[k,Number(new RegExp('# '+k+' (\\d+)').exec(raw)?.[1]??NaN)]));const validation={schema:'rea-root-vault-group-http-review/v1',startedAt,endedAt:new Date().toISOString(),before,after,sources:11,sourceStable:true,runtime:{version:process.version,sha256:sha(runtime)},exit,counts,collectorProblem,scope:{actualSharedHTTP:true,sharedHostMaterializedExact:true,backendCandidate:'frozen777',browser:0,originalExecutions:0,fullParity:false,universalSuperiority:false,productionWrites:0}};await fs.writeFile(path.join(own,'validation.json'),JSON.stringify(validation,null,2)+'\n',{flag:'wx'});
async function walk(dir,prefix=''){const rows=[];for(const ent of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const rel=prefix+ent.name;if(ent.isDirectory())rows.push(...await walk(path.join(dir,ent.name),rel+'/'));else{assert(ent.isFile());if(rel==='manifest.json')continue;const b=await fs.readFile(path.join(dir,ent.name));rows.push({path:rel,bytes:b.length,sha256:sha(b)});}}return rows;}const inventory=await walk(own),manifest=Buffer.from(JSON.stringify({schema:'rea-strict-work-review/v1',files:inventory.length,inventory},null,2)+'\n');await fs.writeFile(path.join(own,'manifest.json'),manifest,{flag:'wx'});console.log(JSON.stringify({validation,files:inventory.length,manifestSha256:sha(manifest)},null,2));process.exitCode=exit.code??1;
