    },
    {
      "id": "grafana.candidate.c6caff9bb42b2948d173",
      "syntaxRole": "table-row",
      "sourceText": "| [Anonymous access](anonymous-auth/)  | N/A               | N/A          | N/A          | N/A                   | N/A       | N/A            | N/A         | N/A               | N/A        | N/A           | N/A          |",
      "headingPath": [
        "Configure authentication"
      ],
      "source": {
