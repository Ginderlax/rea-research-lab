    {
      "id": "grafana.candidate.dcd71a776b988b7d742e",
      "syntaxRole": "table-row",
      "sourceText": "| Apply to entire row | Toggle the switch on to apply the background color that's configured for the cell to the whole row. When more than one field has this option enabled (for example, when it's set through the panel-level cell type or through overrides that target multiple fields), the row uses the color from the first (leftmost) matching column. |",
      "headingPath": [
        "Table",
        "Configuration options",
        "Cell options",
        "Colored background"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/table/index.md",
