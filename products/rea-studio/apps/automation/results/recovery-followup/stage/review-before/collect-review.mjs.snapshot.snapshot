import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import {spawnSync} from 'node:child_process';
import assert from 'node:assert/strict';
const review=path.dirname(fileURLToPath(import.meta.url)),product=path.resolve(review,'../../outputs/rea-research-lab/products/rea-studio'),app=path.join(product,'apps/automation'),hash=b=>createHash('sha256').update(b).digest('hex'),baseline=JSON.parse(await fs.readFile(path.join(review,'baseline.json'))),run=path.join(review,'runs',new Date().toISOString().replaceAll(':','-'));await fs.mkdir(run,{recursive:true});
async function inventory(folder,prefix=''){const files=[];for(const entry of await fs.readdir(folder,{withFileTypes:true})){if(entry.name==='.local')continue;const name=prefix+entry.name;if(entry.isDirectory())files.push(...await inventory(path.join(folder,entry.name),name+'/'));else if(entry.isFile()){const bytes=await fs.readFile(path.join(folder,entry.name));files.push({path:name,bytes:bytes.length,sha256:hash(bytes)});}}return files.sort((a,b)=>a.path.localeCompare(b.path));}
assert.deepEqual(await inventory(app),baseline.files);
const commands=[{name:'evidence-review',args:[path.join(review,'verify-evidence.mjs')]},{name:'ordinary-routing-and-editor',args:['--test','--test-concurrency=1','--test-reporter=tap',path.join(app,'routing.test.mjs'),path.join(app,'native-client.test.mjs')]},{name:'independent-lifecycle-diagnostics',args:['--test','--test-concurrency=1','--test-reporter=tap',path.join(review,'lifecycle.test.mjs')]}],observations=[];
for(const command of commands){const result=spawnSync(process.execPath,command.args,{cwd:path.resolve(review,'../..'),encoding:'utf8',maxBuffer:16*1024*1024,timeout:60000,windowsHide:true});await fs.writeFile(path.join(run,command.name+'.stdout.txt'),result.stdout??'');await fs.writeFile(path.join(run,command.name+'.stderr.txt'),result.stderr??'');observations.push({name:command.name,exitCode:result.status,error:result.error?.message??null,stdoutSha256:hash(result.stdout??''),stderrSha256:hash(result.stderr??'')});assert.equal(result.status,0,command.name);}
const after=await inventory(app);assert.deepEqual(after,baseline.files,'App sources/results mutated during read-only review');await fs.writeFile(path.join(run,'source-after.json'),JSON.stringify(after,null,2)+'\n');
const evidence=JSON.parse(await fs.readFile(path.join(review,'evidence-observations.json'))),lifecycle=JSON.parse(await fs.readFile(path.join(review,'lifecycle-observations.json'))),ordinary=await fs.readFile(path.join(run,'ordinary-routing-and-editor.stdout.txt'),'utf8');assert.match(ordinary,/^# tests 16$/m);assert.match(ordinary,/^# pass 16$/m);assert.match(ordinary,/^# fail 0$/m);assert.match(ordinary,/^# skipped 0$/m);
const current=JSON.parse(await fs.readFile(path.join(app,'results/routing-validation.json'))),manifest=JSON.parse(await fs.readFile(path.join(app,'results/routing-source-study/preservation-manifest.json'))),baselineComparison=[];
for(const entry of manifest.entries.filter(entry=>entry.label.includes('25 production'))){const name=path.basename(entry.source),bytes=await fs.readFile(path.join(app,name));baselineComparison.push({path:name,oldSha256:entry.sha256,currentSha256:hash(bytes),unchanged:hash(bytes)===entry.sha256});}
assert.equal(baselineComparison.filter(row=>row.unchanged).length,19);
for(const name of ['native.mjs','native-server.mjs','native-client.mjs','native-example.mjs','routing.mjs','core.mjs','engine.mjs','server.mjs']){const staged=manifest.entries.find(entry=>entry.source.endsWith('/candidate/'+name)&&entry.label.includes('stage'));assert.ok(staged,'Frozen candidate snapshot missing '+name);assert.equal(hash(await fs.readFile(path.join(app,name))),staged.sha256);}
const result={schema:'rea-automation-routing-independent-production-review/v1',completedAtUtc:new Date().toISOString(),baselineFiles:baseline.files.length,allApplicationAndResultsBytesUnchanged:true,fullSuiteAppsResultsWriteAudit:'Static audit: routing-original.test.mjs only writes ignored .local observations; ordinary shared-host routing/editor tests also re-executed and all 814 non-local app files remained unchanged. Full 1873 original replay intentionally not performed.',authenticatedProductionReceiptSha256:hash(await fs.readFile(path.join(app,'results/routing-validation.json'))),strictPreservationManifestSha256:hash(await fs.readFile(path.join(app,'results/routing-source-study/preservation-manifest.json'))),implementationFingerprints:current.implementationFingerprints,normalRegressions:{tests:16,pass:16,fail:0,skip:0},diagnostics:{tests:2,reproduced:2},evidenceAudit:evidence,findings:lifecycle.observations.map((observation,index)=>({priority:'P2',file:'apps/automation/native.mjs',lines:index===0?'252,289–290':'208–211',...observation})),baselineComparison,commands:observations,runPath:path.relative(review,run).replaceAll('\\','/'),limits:'Read-only finite code/evidence review, seven direct original node/mode-helper cases and small synthetic lifecycle diagnostics. No full scheduler/server product replay, broad reliability/security/performance or parity claim.'};
await fs.writeFile(path.join(review,'review-validation.json'),JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify({receiptSha256:hash(await fs.readFile(path.join(review,'review-validation.json'))),normalRegressions:result.normalRegressions,diagnostics:result.diagnostics,preservedEntries:evidence.preservedEntries,independentOriginalCases:evidence.independentFiniteOriginalCases,allApplicationBytesUnchanged:true,findings:result.findings.map(row=>row.name)}));
