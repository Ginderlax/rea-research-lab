    {
      "id": "grafana.candidate.79c5e00b92795c6f7dcf",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you've customized the `forward_settings_to_plugins` setting under `[azure]`, verify that `grafana-azure-monitor-datasource` is included. This setting controls which plugins receive the Azure configuration from the Grafana server. By default, all Grafana Labs Azure plugins are included. Missing this setting causes `401 Unauthorized` errors even when Managed Identity is correctly configured on your Azure resource.",
      "headingPath": [
        "Configure the Azure Monitor data source",
        "Configure authentication",
        "Managed Identity",
        "Managed Identity Grafana server configuration"
      ],
