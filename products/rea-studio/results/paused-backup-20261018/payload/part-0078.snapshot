    {
      "id": "grafana.candidate.939d3701b2cb22e00001",
      "syntaxRole": "list-item",
      "sourceText": "- **Regular expression filtering**: Filter the values returned by a variable query.",
      "headingPath": [
        "Advanced variable configurations"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/variables/advanced-variables.md",
        "gitBlobSha": "415fc951b326f41b7cb50b9b9eed4c53a5c88dc1",
