    },
    {
      "id": "grafana.candidate.1a4777f90b4d2265f48a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you need to manage or access resources from your Grafana instance—such as dashboards, alerts, data sources, users, and more—refer to the [HTTP API](../http-api/) instead.",
      "headingPath": [
        "Grafana Cloud API"
      ],
      "source": {
        "path": "docs/sources/developer-resources/api-reference/cloud-api/_index.md",
