    },
    {
      "id": "grafana.candidate.551d4de3a7358c52acbc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To configure a Pyroscope data source, you need administrator rights to your Grafana instance and a running Pyroscope backend that's receiving profiling data.",
      "headingPath": [
        "Configure the Pyroscope data source",
        "Before you begin"
