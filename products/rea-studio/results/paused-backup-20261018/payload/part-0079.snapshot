    },
    {
      "id": "grafana.candidate.b5b1956d0063f6380c10",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This way, values can contain not only the last matching node from the metric query, but also the full path of the metric. It can also be narrowed down to a specific node with a regular expression.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Grafana OSS features",
        "Data source updates",
        "Graphite data source",
        "Variable metric names expand"
      ],
      "source": {
