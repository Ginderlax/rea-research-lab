    },
    {
      "id": "grafana.candidate.52bc5b6ae174a879d6a7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "RudderStack data plane URL to receive RudderStack events. You must also provide the `rudderstack_write_key` to enable this feature.",
