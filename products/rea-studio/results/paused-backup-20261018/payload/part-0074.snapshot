    {
      "id": "grafana.candidate.a8804985f9efec984160",
      "syntaxRole": "list-item",
      "sourceText": "- Service accounts resemble Grafana users and can be enabled/disabled, granted specific permissions, and remain active until they are deleted or disabled. API keys are only valid until their expiry date.",
      "headingPath": [
        "Service accounts",
        "When to use service accounts",
