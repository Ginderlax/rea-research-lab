for(const e of stageEntries){const filename=path.join(lab,e.path);await fs.mkdir(path.dirname(filename),{recursive:true});await fs.writeFile(filename,await fs.readFile(path.join(adapter,e.path)),{flag:'wx'});copies.push(e);}
