import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import {spawn} from 'node:child_process';
const root=import.meta.dirname,run=path.join(root,'runs',process.argv[2]??new Date().toISOString().replaceAll(':','-')),hash=b=>createHash('sha256').update(b).digest('hex');await fs.mkdir(run,{recursive:true});
const app='products/rea-studio/apps/vault/',selected=process.argv.slice(3),tests=selected.length?selected:['regression/bin-boundaries.test.mjs','regression/bin-controls.test.mjs',...['recycle-ui.test.mjs','ui.test.mjs','selection-independent.test.mjs','selection-boundaries.test.mjs','selection-adjacent.test.mjs','same-editor-draft.test.mjs','preexisting-draft.test.mjs','draft-adjacent.test.mjs','disposal-adjacent.test.mjs','idle-view.test.mjs'].map(p=>app+p)];
const baseline=JSON.parse(await fs.readFile(path.join(root,'baseline.json')));
async function authenticateExternal(){const old=path.resolve(root,'../keepass-recycle-next'),b=await fs.readFile(path.join(old,'manifest.json'));if(hash(b)!==baseline.previousStage.manifestSha256)throw new Error('Old manifest changed');const m=JSON.parse(b);for(const r of m.records??m.files){const bytes=await fs.readFile(path.join(old,r.path));if(bytes.length!==r.bytes||hash(bytes)!==r.sha256)throw new Error('Old stage changed '+r.path);}for(const r of baseline.productionBaseline){const b=await fs.readFile(r.path);if(b.length!==r.bytes||hash(b)!==r.sha256)throw new Error('Production baseline changed '+r.path);}}
async function capture(){const names=[...baseline.copies.map(r=>r.path),'regression/ui-helper.mjs','record-regression.mjs','README.md','diagnostic-correction.json','INTERRUPTED-ATTEMPT.json',...tests];return Promise.all([...new Set(names)].map(async p=>{const b=await fs.readFile(path.join(root,p));return{path:p,bytes:b.length,sha256:hash(b)};}));}
await authenticateExternal();const before=await capture();for(const r of before){const out=path.join(run,'sources',r.path+'.snapshot');await fs.mkdir(path.dirname(out),{recursive:true});await fs.copyFile(path.join(root,r.path),out);}await fs.writeFile(path.join(run,'source-before.json'),JSON.stringify(before,null,2)+'\n');
