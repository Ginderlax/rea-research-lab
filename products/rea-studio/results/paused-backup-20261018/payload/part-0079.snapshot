    {
      "id": "grafana.candidate.b82abc93272eb77f8386",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "It's easier than ever to view local data in Grafana: introducing drag and drop. The drag and drop functionality allows you to upload your csv, Excel, or numbers files by simply dragging and dropping them into the query editor of the Grafana data source.",
      "headingPath": [
        "What’s new in Grafana v10.0",
        "Dashboards and visualizations",
        "Drag and drop spreadsheets into Grafana"
      ],
