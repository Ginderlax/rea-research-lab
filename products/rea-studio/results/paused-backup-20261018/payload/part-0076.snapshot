    {
      "id": "grafana.candidate.4afc0176086b8a364203",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Alert queries can't contain template variables. Grafana evaluates alert rules on the backend without dashboard context, so variables like `$hostname` or `$region` aren't resolved.",
      "headingPath": [
