    {
      "id": "grafana.candidate.b52188056f12c6071981",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The default data source timeout is 30 seconds. Azure Log Analytics queries can take up to 3 minutes on the Azure side, especially for complex KQL queries, large time ranges, or queries across multiple workspaces. If queries fail with `DatasourceError`, `context deadline exceeded`, or timeout errors, increase the timeout.",
      "headingPath": [
        "Configure the Azure Monitor data source",
        "Additional configuration options",
        "Query timeout"
      ],
      "source": {
