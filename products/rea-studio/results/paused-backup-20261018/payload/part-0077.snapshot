    },
    {
      "id": "grafana.candidate.d6452c31f79dee77b929",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can enable TLS for cluster mode using the `rediss` scheme in Grafana Enterprise v8.5 and later versions.",
      "headingPath": [
        "Configure Grafana Enterprise",
        "[caching.redis]",
        "cluster"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md",
