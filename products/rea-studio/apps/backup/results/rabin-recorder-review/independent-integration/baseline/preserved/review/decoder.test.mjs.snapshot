import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';import {collect} from './independent-decoder.mjs';import {readRabinObservation} from './baseline/recorder/decoder.mjs';
const labels=['rabinBoundaryOriginalObservations','rabinSnapshotOriginalObservations','rabinLifecycleObservations','rabinDeadlineObservations'];
for(const name of ['first47','latest47','final47'])test('four observations reconstructed independently from retained '+name+' raw',async()=>{const raw=await fs.readFile(new URL(name==='final47'?'./baseline/final47/rabin-integration.stdout.txt':'./baseline/raw/'+name+'.stdout.txt',import.meta.url),'utf8');for(const label of labels)assert.deepEqual(collect(raw,label),readRabinObservation(raw,label));});
test('actual Node TAP escaped #, backslash, controls, quotes, Unicode and >64KiB chunked logger',async()=>{const raw=await fs.readFile(new URL('./synthetic-marker.stdout.txt',import.meta.url),'utf8'),result=collect(raw,'syntheticRabinObservation');assert.deepEqual(result,{path:'C:\\fixture\\#file.txt',stdout:'line1\nline2\tend',unicode:'é測試',literal:'\\#',quotes:'"quoted"',payload:'a'.repeat(90000)});assert.throws(()=>readRabinObservation(raw,'syntheticRabinObservation'),/Bad escaped character/);});
const value={path:'C:\\test\\#name',controls:'\n\t\r\u0000',literal:'\\#',unicode:'測試',quote:'"'},plain=JSON.stringify({syntheticRabinObservation:value}),encoded=plain.replaceAll('\\','\\\\').replaceAll('#','\\#'),prefixLength='{"syntheticRabinObservation":'.length;
test('all content split positions including pairs of escaping bytes reconstruct exactly',()=>{for(let n=prefixLength;n<encoded.length;n++)assert.deepEqual(collect('# '+encoded.slice(0,n)+'\n# '+encoded.slice(n)+'\n','syntheticRabinObservation'),value);});
test('truncation, non-comment interruption, duplicate markers and wrong labels reject',()=>{assert.throws(()=>collect('# '+encoded.slice(0,-3),'syntheticRabinObservation'));assert.throws(()=>collect('# '+encoded.slice(0,40)+'\nnot ok 1\n# '+encoded.slice(40),'syntheticRabinObservation'));assert.throws(()=>collect('# '+encoded+'\n# '+encoded,'syntheticRabinObservation'),/Exactly one/);assert.throws(()=>collect('# '+encoded,'otherLabel'),/Exactly one/);});
test('bounded collector rejects excessive allocation and excessive line fragments',()=>{assert.throws(()=>collect('# {"syntheticRabinObservation":"'+'x'.repeat(1024*1024)+'"}\n','syntheticRabinObservation'),/bound/);assert.throws(()=>collect('# {"syntheticRabinObservation":"\n'+Array(4097).fill('# x').join('\n')+'\n# "}','syntheticRabinObservation'),/Incomplete/);});
