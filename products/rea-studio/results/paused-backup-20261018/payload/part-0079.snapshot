    },
    {
      "id": "grafana.candidate.98615e46af9d4a13eb96",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This screenshot shows both a custom full date format with a 12 hour clock and am/pm suffix. The graph is also showing the same 12-hour clock format and a customized month and day format compared to the Grafana default `MM/DD` format.",
      "headingPath": [
        "What's new in Grafana v7.2",
        "New date formatting options added"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-2.md",
