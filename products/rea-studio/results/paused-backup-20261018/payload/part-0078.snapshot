          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.e2976faa776dc9a634d7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can also reuse previously created queries with the saved queries feature.",
      "headingPath": [
        "Get started with Explore",
        "Explore elements",
        "Query editor"
      ],
      "source": {
        "path": "docs/sources/visualizations/explore/get-started-with-explore.md",
