    {
      "id": "grafana.candidate.1fd7f787688cdd96c63d",
      "syntaxRole": "list-item",
      "sourceText": "- Because you must set exactly one of `value` or `ref`, your configuration must include one of them after import.",
      "headingPath": [
        "Use Terraform to provision secure values",
        "Import an existing secure value"
      ],
      "source": {
        "path": "docs/sources/as-code/infrastructure-as-code/terraform/terraform-secrets-management.md",
