    {
      "id": "grafana.candidate.5a24a32d569515902c66",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This query returns only series where the app tag matches the selected values in $`{apps}`, formatted as a regular expression. `=~` is the regular expression operator",
