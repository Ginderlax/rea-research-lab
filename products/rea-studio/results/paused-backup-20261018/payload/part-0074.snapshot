      "id": "grafana.candidate.d5893643ccfea11667b2",
      "syntaxRole": "table-row",
      "sourceText": "| Mention users   | Mention one or more specific users in the notification. Set the `mentionUsers` field with a comma-separated list of user IDs (for example, `U024BE7LH,U024BE7LJ`). To find a user's ID, refer to [Slack's documentation on finding member IDs](https://api.slack.com/methods/users.list). |",
      "headingPath": [
        "Configure Slack for Alerting",
        "Optional settings",
        "Configure mentions"
      ],
