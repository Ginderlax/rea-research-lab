      "after": "        async function mutate(action,confirmation,permanent){if(!current())return;if(selected||editorDirty()||entryEffects)throw new Error('Close the entry editor and save or discard its draft before changing a group.');if(groupEffects)throw new Error('Wait for the pending group operation.');if(!confirmation.checked)throw new Error('Confirm the recursive group operation.');selectionGeneration++;editor();binGeneration++;function scrub(n){if('value'in n)n.value='';for(const child of n.children)scrub(child);}scrub(binPanel);binPanel.replaceChildren();const operation=++groupGeneration;groupPanel.replaceChildren(node('h3','Group operation pending'));button(groupPanel,'Close group panel',async()=>{groupGeneration++;groupPanel.replaceChildren();});const operationCurrent=()=>viewCurrent()&&operation===groupGeneration&&groupPanel.parentElement===gate;groupEffects++;try{await api(action,{id:item.id,revision:item.recycleRevision,confirm:true,...(permanent===undefined?{}:{permanent})});if(!operationCurrent())return;await list();if(operationCurrent())await groupList(bin,true);}finally{groupEffects--;}}\n"
