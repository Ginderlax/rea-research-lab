    },
    {
      "id": "grafana.candidate.3fe9b07cc34b9dd91ec8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana currently supports three types of plugins: panel, data source, and app. For more information on managing plugins, refer to [Plugin Management](../../../administration/plugin-management/).",
      "headingPath": [
        "Run Grafana Docker image",
        "Install plugins in the Docker container"
      ],
      "source": {
