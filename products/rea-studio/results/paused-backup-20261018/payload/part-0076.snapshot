    {
      "id": "grafana.candidate.24162e6c8a7510d6d75d",
      "syntaxRole": "list-item",
      "sourceText": "- **Update manually:** Update at any time from the **Administration > Plugins** page without restarting Grafana.",
      "headingPath": [
        "OpenTSDB data source",
        "Plugin updates"
      ],
      "source": {
