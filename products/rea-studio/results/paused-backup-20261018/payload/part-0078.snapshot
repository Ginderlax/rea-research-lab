    {
      "id": "grafana.candidate.c20766c3c0eae3a3e9e6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Mean returns the total of all values in each series divided by the number of points in that series. In `strict` mode if any values in the series are null or nan, or if the series is empty, NaN is returned.",
      "headingPath": [
        "Write expression queries",
