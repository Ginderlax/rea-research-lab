    },
    {
      "id": "grafana.candidate.ccbd8b07521f2bd25086",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Enter a comma-separated list of plugin identifiers to install on startup, using the Grafana catalog as the source. Preinstalled plugins cannot be uninstalled from the Grafana user interface; they need to be removed from this list first.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[plugins]`",
        "`preinstall`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
