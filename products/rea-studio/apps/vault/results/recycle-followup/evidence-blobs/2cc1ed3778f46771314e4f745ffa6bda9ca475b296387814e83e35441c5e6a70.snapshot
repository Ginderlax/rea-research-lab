import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const own=fileURLToPath(new URL('./',import.meta.url)),stage=fileURLToPath(new URL('../keepass-recycle-next/',import.meta.url)),hash=b=>createHash('sha256').update(b).digest('hex');
async function identity(filename){const b=await fs.readFile(filename);return{bytes:b.length,sha256:hash(b)};}
const validation=await identity(path.join(stage,'validation.json')),manifestIdentity=await identity(path.join(stage,'manifest.json'));assert.equal(validation.sha256,'8911d007286682869c3346319e17e58342a730ba5af995d7af32c1faa684b0e1');assert.equal(manifestIdentity.sha256,'769523b00c626762f18aec86ee8df8f1bb317ff4bbc8147a09a03af44161c100');const manifest=JSON.parse(await fs.readFile(path.join(stage,'manifest.json'))),receipt=JSON.parse(await fs.readFile(path.join(stage,'validation.json')));assert.equal(manifest.files.length,546);assert.deepEqual(receipt.counts,{tests:68,pass:68,fail:0,skipped:0,cancelled:0,priorAcceptedHistory:41,newNative:12,newServer:5,newDOMModel:4,newHTTP:2,newOriginalGroups:4});assert.deepEqual(receipt.sourceBefore,receipt.sourceAfter);const seen=new Set();for(const row of manifest.files){assert.ok(!path.isAbsolute(row.path)&&!row.path.split('/').includes('..'));assert.ok(!seen.has(row.path));seen.add(row.path);assert.deepEqual(await identity(path.join(stage,row.path)),{bytes:row.bytes,sha256:row.sha256},row.path);}
async function inventory(dir=stage,prefix=''){let rows=[];for(const entry of await fs.readdir(dir,{withFileTypes:true})){const rel=prefix+entry.name;assert.equal(entry.isSymbolicLink(),false);if(entry.isDirectory())rows.push(...await inventory(path.join(dir,entry.name),rel+'/'));else if(rel!=='manifest.json')rows.push(rel);}return rows;}
assert.deepEqual((await inventory()).sort(),[...seen].sort());const runtime=receipt.sourceBefore.filter(row=>/^products\/rea-studio\/apps\/vault\/(?:client|server|recycle|history|kdbx|xml)\.mjs$/.test(row.path));assert.equal(runtime.length,6);await fs.mkdir(path.join(own,'baseline'),{recursive:true});for(const row of runtime){assert.deepEqual(await identity(path.join(stage,row.path)),{bytes:row.bytes,sha256:row.sha256});await fs.writeFile(path.join(own,'baseline',path.basename(row.path)+'.snapshot'),await fs.readFile(path.join(stage,row.path)),{flag:'wx'});}for(const name of ['validation.json','manifest.json','failure-ledger.json','source-provenance.json','contract-evidence.json','baseline-validation.json','README.md','NOTICE.md'])await fs.writeFile(path.join(own,'baseline',name+'.snapshot'),await fs.readFile(path.join(stage,name)),{flag:'wx'});
const provenance=JSON.parse(await fs.readFile(path.join(stage,'source-provenance.json'))),contracts=JSON.parse(await fs.readFile(path.join(stage,'contract-evidence.json')));assert.equal(provenance.files.length,16);for(const row of provenance.files){const bytes=await fs.readFile(path.join(stage,row.path));assert.equal(bytes.length,row.bytes);assert.equal(hash(bytes),row.sha256);for(const contract of contracts.contracts.filter(c=>c.source===row.upstreamPath)){assert.equal(hash(bytes),contract.sourceSha256);assert.equal(hash(bytes.subarray(contract.utf8ByteOffset,contract.utf8ByteOffset+contract.utf8ByteLength)),contract.rawSpanSha256);}}
assert.deepEqual(await identity(path.join(stage,'validation.json')),validation);assert.deepEqual(await identity(path.join(stage,'manifest.json')),manifestIdentity);const result={schema:'rea-keepass-recycle-independent-authentication/v1',checkedAt:new Date().toISOString(),stage:'work/keepass-recycle-next',validation,manifest:{...manifestIdentity,files:546},strictInventory:true,sourceStable:true,runtime,sourceFiles:16,contractSpans:contracts.contracts.length,candidateExecuted:false,originalExecuted:false,productionModified:false};await fs.writeFile(path.join(own,'stage-before.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({pass:true,files:546,sourceFiles:16,contractSpans:12,runtime}));
