    {
      "id": "grafana.candidate.e82df478e5067ade8cbc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Expired silences are automatically deleted after 5 days. This retention period is not configurable. The cleanup process runs automatically every 15 minutes to remove expired silences that are older than the retention period.",
      "headingPath": [
        "Configure silences",
        "Silence duration and retention"
      ],
      "source": {
        "path": "docs/sources/alerting/configure-notifications/create-silence.md",
