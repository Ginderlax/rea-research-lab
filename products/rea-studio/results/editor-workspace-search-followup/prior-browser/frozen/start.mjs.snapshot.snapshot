import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import{createHash}from'node:crypto';import{start}from'./editor-search-fix-next/products/rea-studio/server.mjs';
const root=path.join(import.meta.dirname,'editor-search-browser'),dataDir=path.join(root,'synthetic-data'),stage=path.join(import.meta.dirname,'editor-search-fix-next'),sha=b=>createHash('sha256').update(b).digest('hex');await fs.mkdir(root,{recursive:true});const manifestBytes=await fs.readFile(path.join(stage,'freeze-manifest.json'));assert.equal(sha(manifestBytes),'b858a4cf15312f962bf0ac5ba2fd6b6c17466248ff1394c727a49ee0e665e9ef');const manifest=JSON.parse(manifestBytes);for(const[name,row]of Object.entries(manifest.inventory)){const b=await fs.readFile(path.join(stage,name));assert.equal(sha(b),row.sha256);assert.equal(b.length,row.bytes);}await fs.writeFile(path.join(root,'source-before.json'),JSON.stringify(manifest.inventory,null,2)+'\n',{flag:'wx'});await fs.writeFile(path.join(root,'start.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});const host=await start({port:0,dataDir}),workspace=path.join(dataDir,'editor/workspace');await fs.mkdir(path.join(workspace,'src'),{recursive:true});await fs.writeFile(path.join(workspace,'src','unicode.txt'),'🧪needle\r\nNeedle repeated needle\n');await fs.writeFile(path.join(workspace,'second.txt'),'second needle\n');const receipt={schema:'rea-editor-search-owned-browser-host/v1',startedAtUtc:new Date().toISOString(),url:host.url,pid:process.pid,dataDir,stage,manifestSHA256:sha(manifestBytes),syntheticOnly:true,userPort4311Touched:false,originalGUIExecutions:0};await fs.writeFile(path.join(root,'host.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(receipt));let closing=false;async function close(){if(closing)return;closing=true;await host.close();await fs.writeFile(path.join(root,'host-closed.json'),JSON.stringify({closedAtUtc:new Date().toISOString(),pid:process.pid},null,2)+'\n',{flag:'wx'});process.exit(0);}process.on('SIGINT',close);process.on('SIGTERM',close);
