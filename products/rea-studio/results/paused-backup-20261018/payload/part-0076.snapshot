    {
      "id": "grafana.candidate.9295a2f8f6edadd2293f",
      "syntaxRole": "list-item",
      "sourceText": "- **Single query per condition:** Each alert condition evaluates a single query. If you need to combine results from multiple queries, use [math expressions](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/alerting/alerting-rules/create-grafana-managed-rule/#add-expressions) in the alert rule.",
      "headingPath": [
        "PostgreSQL alerting",
        "Limitations"
      ],
      "source": {
