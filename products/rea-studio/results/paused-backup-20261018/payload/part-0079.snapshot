    },
    {
      "id": "grafana.candidate.3bbe9eaf9c711e863afb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When enabled, look for the **✨ Auto generate** option next to the **Title** and **Description** fields in your panels and dashboards, or when you press the **Save** button.",
      "headingPath": [
        "What’s new in Grafana v10.2",
        "Dashboards and visualizations",
        "Use AI to generate titles, descriptions, and change summaries"
      ],
      "source": {
