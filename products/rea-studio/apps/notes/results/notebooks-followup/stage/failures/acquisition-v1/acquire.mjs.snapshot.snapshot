import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
const root=path.dirname(fileURLToPath(import.meta.url)),hash=bytes=>createHash('sha256').update(bytes).digest('hex'),tag='v3.6.14',commit='7e2765a3857754d12dbadea442b60ceaf9d4b23d',rows=[],failures=[];
async function fetchSave(url,name,{optional=false}={}){const response=await fetch(url,{headers:{'User-Agent':'REA-finite-notebook-source-study'}}),bytes=Buffer.from(await response.arrayBuffer()),target=path.join(root,'original',name+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,bytes);const row={url,path:path.relative(root,target).replaceAll('\\','/'),status:response.status,bytes:bytes.length,sha256:hash(bytes)};if(!response.ok){failures.push(row);if(!optional)throw new Error('Authoritative acquisition failed: '+url+' '+response.status);}else rows.push(row);return bytes;}
const ref=JSON.parse(await fetchSave('https://api.github.com/repos/laurent22/joplin/git/ref/tags/'+tag,'metadata/git-ref.json'));if(ref.object.type!=='commit'||ref.object.sha!==commit)throw new Error('Pinned official tag changed.');
const release=JSON.parse(await fetchSave('https://api.github.com/repos/laurent22/joplin/releases/tags/'+tag,'metadata/release.json'));if(release.tag_name!==tag||release.draft||release.prerelease)throw new Error('Require released stable desktop tag.');
for(const name of ['LICENSE','package.json','packages/app-desktop/package.json','packages/lib/models/Folder.ts','packages/lib/models/Folder.test.ts','packages/lib/models/Note.ts','packages/lib/models/BaseItem.ts','packages/lib/models/BaseModel.ts','packages/lib/services/database/types.ts','readme/apps/subnotebooks.md','readme/apps/import_export.md','packages/app-desktop/commands/moveToFolder.ts'])await fetchSave(`https://raw.githubusercontent.com/laurent22/joplin/${commit}/${name}`,name,{optional:name.endsWith('Folder.test.ts')||name.includes('/commands/')});
