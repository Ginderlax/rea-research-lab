    },
    {
      "id": "grafana.candidate.434c1c817ac66ae153f4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Layered layout can be slow when the graph has more than 500 nodes. For large graphs, use **Force** layout.",
