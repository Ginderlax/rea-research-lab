// Backup-only public filing proposal. Never import or execute product, tests, original code, or verifiers.
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import {createHash} from 'node:crypto';
import {gzipSync,gunzipSync} from 'node:zlib';
const work=import.meta.dirname;
const prefix='products/rea-studio/results/cloud-followup-6301492-20261015';
const stage=path.join(work,'cloud-followup-6301492-public-next'),publicRoot=path.join(stage,'public-candidate'),target=path.join(publicRoot,prefix);
const head='63014920a81d3d28108bdbde35731774a332462b';
const digest=b=>createHash('sha256').update(b).digest('hex');
const id=b=>({bytes:b.length,sha256:digest(b)});
const sensitive=/\b(?:ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,}|AKIA[0-9A-Z]{16})\b|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----/;
function safe(s){assert(typeof s==='string'&&s&&!/[\\:\x00-\x1f\x7f]/.test(s)&&!s.startsWith('/')&&s.split('/').every(p=>p&&p!=='.'&&p!=='..'));return s;}
function read(root,name){safe(name);let at=root;for(const part of name.split('/')){at=path.join(at,part);assert(!fs.lstatSync(at).isSymbolicLink());}const stat=fs.lstatSync(at);assert(stat.isFile()&&stat.size<=12*1024*1024);const bytes=fs.readFileSync(at);assert.equal(bytes.length,stat.size);return bytes;}
function json(root,name){return JSON.parse(read(root,name).toString('utf8').replace(/^\uFEFF/,''));}
assert(!fs.existsSync(stage));fs.mkdirSync(target,{recursive:true});
const definitions=[
 {name:'vault-empty-bin-failed',run:'38824829904',job:'116729726017',artifact:'12014711457',sha256:'53fa69cf1be20ad4a3283c21613cc2c7a1e78a7c32a8767e3809eb2524f6e475',reader:'unpack-cloud-attempt.py',verification:'local-backup-verification.json',metadata:'control-plane-evidence-observation-2026-10-15T23-42-19-425Z'},
 {name:'archive-browser-failed',run:'38824829929',job:'116729726778',artifact:'12014391721',sha256:'21fb9379a5229ef14da6aae74dc22fefedd2f96c5d8ede3061e91ba916dc95da',reader:'unpack-browser-cloud-attempt.py',verification:'local-browser-backup-verification.json',metadata:'control-plane-evidence'},
 {name:'publication-failed',run:'38824835014',job:'116729743662',artifact:'12014227780',sha256:'e5798afe02918ebc1c7620ee457b743c09204dd17a237149e9b5bc631cb611ce',reader:'unpack-publication-attempt.py',verification:'local-backup-verification.json',metadata:'control-plane-evidence'},
 {name:'proof-delivery-diagnostic',run:'38824829652',job:'116729725673',artifact:'12014432288',sha256:'fefb3c0744da8de8978cedc48853cc3fe77bfa563b8df8062a0fa21b25b36ee2',reader:'unpack-proof-delivery-audit.py',verification:'local-backup-verification.json',metadata:'control-plane-evidence'}
];
const summaries=[];let totalStored=0;
for(const definition of definitions){
 const runFolder=path.join(work,'cloud-verification-backups','run-'+definition.run),backup=path.join(runFolder,'artifact-'+definition.artifact),source=path.join(backup,'readable-evidence');
 const verificationBytes=read(backup,definition.verification),verification=JSON.parse(verificationBytes);
 assert.equal(verification.artifactSHA256,definition.sha256);assert.equal(verification.allCRCAndBytesReadable,true);assert.equal(verification.localProductExecutions,0);
 const entries=new Map(verification.files.map(row=>[safe(row.path),row]));assert.equal(entries.size,verification.files.length);
 function evidence(name){const raw=read(source,name),entry=entries.get(name);assert(entry);assert.deepEqual(id(raw),{bytes:entry.bytes,sha256:entry.sha256});return raw;}
 const omitted=[...entries.values()].filter(row=>row.path.startsWith('source/')).map(row=>({sourcePath:row.path,bytes:row.bytes,sha256:row.sha256}));
 const retained=[...entries.keys()].filter(name=>!name.startsWith('source/'));
 const folder=path.join(target,definition.name);fs.mkdirSync(path.join(folder,'payload'),{recursive:true});const records=[],objects=new Map();
 function save(role,raw){safe(role);assert(!records.some(row=>row.sourcePath===role));assert(!sensitive.test(raw.toString('utf8')),'Credential pattern in selected public evidence: '+role);
   const original=id(raw);let bytes=raw,encoding='identity';const png=raw.subarray(0,8).equals(Buffer.from('89504e470d0a1a0a','hex'));
   if(!png&&raw.length>65536){const compressed=gzipSync(raw,{level:9});if(compressed.length<raw.length*0.85){assert.deepEqual(gunzipSync(compressed),raw);bytes=compressed;encoding='gzip';}}
   const stored=id(bytes),relative='payload/'+original.sha256+(png?'.png':encoding==='gzip'?'.gz.snapshot':'.snapshot');
   if(!objects.has(relative)){fs.writeFileSync(path.join(folder,relative),bytes,{flag:'wx'});assert.deepEqual(read(folder,relative),bytes);objects.set(relative,stored);totalStored+=bytes.length;}
   records.push({sourcePath:role,path:relative,...original,storage:{encoding,...stored},nativePNG:png});
 }
 for(const name of retained)save('artifact/'+name,evidence(name));
 save('local/'+definition.verification,verificationBytes);
 save('wrapper/job-'+definition.job+'.txt',read(path.join(work,'cloud-verification-backups','job-'+definition.job),'logs.txt'));
 for(const kind of ['run','jobs','artifacts'])save('control-plane/'+kind+'.json',read(runFolder,definition.metadata+'/'+kind+'.json'));
 save('local/collection-summary.json',read(runFolder,'collection-summary.json'));
 save('readers/'+definition.reader,read(work,definition.reader));
 save('readers/collect-readonly-run-2336.mjs',read(work,'collect-readonly-run-2336.mjs'));
 save('readers/public-filing-collector.mjs',fs.readFileSync(import.meta.filename));
 const manifest={schema:'rea-hosted-followup-failure-preservation/v1',createdAt:new Date().toISOString(),name:definition.name,runId:definition.run,runAttempt:1,runURL:'https://github.com/Ginderlax/rea-research-lab/actions/runs/'+definition.run,jobId:definition.job,headSHA:head,artifactId:definition.artifact,artifactSHA256:definition.sha256,artifactBytes:verification.archiveBytes,completeLocalBackupVerified:true,localReadableFiles:entries.size,retainedArtifactFiles:retained.length,sourceSnapshotPayloadsOmittedPublicly:omitted.length,omittedSourceSnapshotPayloads:omitted,
 omissionScope:'Only artifact source/ active snapshot payloads are omitted from this public capsule; their byte identities remain here and complete readable contents remain in the verified local backup. Every other uploaded artifact file is retained exactly, either as raw bytes or reversible gzip with raw and stored identities. This does not claim contents that the workflow never uploaded.',
 records,uniquePublicObjects:0,storedBytes:0,allCopiesExact:true,portablePayloads:true,publicProductExecutions:0,localProductExecutions:0,localTests:0,localBuilds:0,historicalReceiptsRebound:false,productionInstallationClaimed:false,fullFeatureParity:false,superiority:false,acceptanceEstablished:false};
 if(definition.name==='vault-empty-bin-failed'){
   const attempt=JSON.parse(evidence('attempt-validation.json'));assert.equal(attempt.status,'failed');assert.equal(attempt.repositoryCommit,head);assert.deepEqual(attempt.summary,{tests:233,pass:231,fail:2,cancelled:0,skipped:0,todo:0,duration_ms:107475.2994});assert.equal(attempt.sourceFiles,779);assert.equal(attempt.sourceSnapshotFiles,357);assert.equal(attempt.sourceStable,true);assert.equal(omitted.length,357);
   const sidecar=read(backup,'local-empty-bin-sidecar-verification.json'),v=JSON.parse(sidecar);assert.equal(v.originalChildAttempts,2);assert.equal(v.recordedActualLibraryCalls,0);assert.equal(v.recordedActualAssemblyLoads,0);assert.equal(v.comparisonsPassed,0);
   save('local/local-empty-bin-sidecar-verification.json',sidecar);save('readers/verify-empty-bin-sidecar-backup.py',read(work,'verify-empty-bin-sidecar-backup.py'));
   Object.assign(manifest,{status:'failed',sourceCommit:attempt.repositoryCommit,summary:attempt.summary,sourceFiles:779,sourceStable:true,sourceSnapshotFiles:357,originalChildAttempts:2,originalActualLibraryCalls:0,originalActualAssemblyLoads:0,originalComparisonsPassed:0,allFourOriginalComparisonsEstablished:false,
     failure:'Both original comparison test groups fail because their owned PowerShell helper cannot resolve Get-FileHash. Two children started and closed with exit1 before an assembly-load marker or actual library observation; the two later planned children never started. Other231 selected groups passed. This run establishes no original empty-bin comparison.'});
 }else if(definition.name==='archive-browser-failed'){
   const attempt=JSON.parse(evidence('browser-attempt.json')),report=JSON.parse(evidence('playwright-results.json'));assert.equal(attempt.status,'failed');assert.equal(attempt.sourceCommit,head);assert.equal(attempt.sourceFiles,343);assert.equal(attempt.sourceStable,true);assert.equal(omitted.length,343);
   assert.deepEqual({expected:report.stats.expected,unexpected:report.stats.unexpected,skipped:report.stats.skipped,flaky:report.stats.flaky},{expected:0,unexpected:2,skipped:4,flaky:0});
   assert(![...entries.keys()].some(name=>name.startsWith('workspace-artifacts/')));assert.equal(attempt.actualDownloads,0);
   const cases=retained.filter(name=>/^case-.*\.json$/.test(name));assert.equal(cases.length,1);const observation=JSON.parse(evidence(cases[0]));assert.deepEqual(observation.observations,[]);assert.equal(observation.actualDownloads,0);assert.equal(observation.serverCloseObserved,true);
   Object.assign(manifest,{status:'failed',sourceCommit:attempt.sourceCommit,browserCounts:{selected:6,passed:0,failed:2,didNotRun:4,flaky:0,retries:0},sourceFiles:343,sourceStable:true,productDownloadUIAbsent:true,actualDownloads:0,createdArchiveArtifacts:0,restoredFileArtifacts:0,originalProcesses:0,archiveCompositionPostcheck:'passed',browserCompositionPostcheck:'passed',
     failure:'The first scenario times out selecting a disabled format control before any archive creation. The replacement Playwright worker then receives EEXIST opening browser-observation.json. Two scenarios fail and four do not run. The first fixture closes its actual server; one failed-case observation and screenshots are retained. No archive UI acceptance is established.'});
 }else if(definition.name==='publication-failed'){
   const attempt=JSON.parse(evidence('attempt-validation.json')),controls=JSON.parse(evidence('controls.json')),stderr=evidence('publication-write.stderr.txt').toString('utf8');assert.equal(attempt.status,'failed');assert.equal(controls.status,'passed');assert.equal(controls.checks,76);assert(stderr.includes('GROUP-EDIT.md links to missing results/group-edit-followup/source-proof/preservation-manifest.json'));
   Object.assign(manifest,{status:'failed',sourceCommit:attempt.sourceCommit,testedReference:'refs/pull/1/merge',controls:{status:'passed',checks:76},generatedManifestValidated:false,publicationAccepted:false,
     failure:'The root link check rejects GROUP-EDIT.md because results/group-edit-followup/source-proof/preservation-manifest.json does not exist at that relative destination. The76 negative/source controls passed separately; the generated publication manifest remains unvalidated.'});
 }else{
   const report=JSON.parse(evidence('audit-report.json'));assert.equal(report.status,'completed');assert.equal(report.provenance.sourceCommit,head);assert.equal(report.coverageComplete,false);assert.equal(report.counts.missingGit,0);assert.equal(report.counts.wrongGitMode,0);assert.equal(report.counts.declaredSizeMismatch,0);assert.equal(report.counts.unresolved,946);assert.deepEqual(report.errors,[]);
   const unresolved=evidence('unresolved.jsonl').toString('utf8').trim().split(/\r?\n/).map(line=>JSON.parse(line)),reasons={};for(const row of unresolved)reasons[row.reason]=(reasons[row.reason]??0)+1;assert.equal(unresolved.length,946);
   Object.assign(manifest,{status:'diagnostic-incomplete',sourceCommit:head,workflowConclusion:'failure',auditStatus:'completed',coverageComplete:false,declaredDeliveryComplete:false,declaredSizesMatch:false,knownMissingGitPayloads:0,knownWrongGitModes:0,knownDeclaredSizeMismatches:0,unresolved:946,unresolvedReasons:reasons,counts:report.counts,payloadSHAAuthenticationClaimed:false,
     interpretation:'The audit finds zero missing payloads among its recognized declarations after restoration of the known80 carriers. Coverage remains incomplete:846 inert manifests lack a reviewed projection,81 schema handlers are unknown,10 manifests cannot parse/register and9 audits remain incomplete. No complete delivery, size, hash or publication acceptance is asserted.'});
 }
 manifest.records=records;manifest.uniquePublicObjects=objects.size;manifest.storedBytes=[...objects.values()].reduce((sum,row)=>sum+row.bytes,0);
 const bytes=Buffer.from(JSON.stringify(manifest,null,2)+'\n');fs.writeFileSync(path.join(folder,'preservation-manifest.json'),bytes,{flag:'wx'});totalStored+=bytes.length;
 summaries.push({name:definition.name,path:definition.name+'/preservation-manifest.json',...id(bytes),runId:definition.run,status:manifest.status,records:records.length,objects:objects.size,storedPayloadBytes:manifest.storedBytes,omittedSourceSnapshots:omitted.length});
}
const readme=`# Hosted follow-up evidence from6301492\n\nThese four capsules preserve actual unsuccessful hosted checks and their diagnostic results. They do not establish replacement parity, superiority, a production installation or publication acceptance.\n\n- Vault:233selected groups,231passed,2failed. Two original helper children failed before loading KeePass; actual original library calls0 and successful comparisons0.\n- Archive browser:6selected scenarios,2failed and4didnotrun. No archive was created, no file restored and no browser download occurred.\n- Publication:76controls passed; the root verifier rejected a missing local link in GROUP-EDIT.md.\n- Delivery audit:zero known missing payloads, wrong Git modes or declared-size mismatches;946unresolved declarations keep coverage incomplete.\n\nEach manifest records its exact run, uploaded artifact hash, all retained non-source artifact roles, wrapper log, GitHub control-plane responses and backup readers. The source/ payloads alone are omitted publicly with their byte identities retained; complete readable copies remain in the verified local backup. No vendor executable is included.\n\nA payload with storage.encoding=identity contains the original bytes directly. A payload with storage.encoding=gzip is a lossless gzip member: decompress it, verify the result against the record's top-level bytes and sha256, and verify the stored object against storage.bytes and storage.sha256. PNGs remain native.png files. Compression changes storage only; failed receipts retain their original exact contents.\n`;
fs.writeFileSync(path.join(target,'README.md'),readme,{flag:'wx'});totalStored+=Buffer.byteLength(readme);
const index={schema:'rea-cloud-followup-failure-capsule-index/v1',headSHA:head,capsules:summaries,allCompletedRunsPreserved:true,acceptanceEstablished:false,sourceSnapshotPayloadsPubliclyOmitted:true,localProductExecutions:0,localTests:0,localBuilds:0};
fs.writeFileSync(path.join(target,'preservation-index.json'),JSON.stringify(index,null,2)+'\n',{flag:'wx'});
const copyRows=[];function inventory(dir){for(const entry of fs.readdirSync(dir,{withFileTypes:true})){const filename=path.join(dir,entry.name);assert(!entry.isSymbolicLink());if(entry.isDirectory())inventory(filename);else{const bytes=fs.readFileSync(filename);copyRows.push({path:path.relative(publicRoot,filename).replaceAll('\\','/'),...id(bytes)});}}}inventory(publicRoot);
const actualBytes=copyRows.reduce((sum,row)=>sum+row.bytes,0);assert(actualBytes<=4*1024*1024,'Public candidate exceeds4MiB');
const authority={schema:'rea-work-only-followup-public-copy-authority/v1',createdAt:new Date().toISOString(),publicCandidate:publicRoot,prefix,sourceHead:head,files:copyRows.length,bytes:actualBytes,rows:copyRows,activeRepositoryChanged:false,productExecutions:0,localTests:0,localBuilds:0,claims:'Exact reversible evidence filing proposal only. All failures and coverage gaps remain explicit.'};
fs.writeFileSync(path.join(stage,'copy-authority.json'),JSON.stringify(authority,null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({stage,publicCandidate:publicRoot,prefix,files:copyRows.length,bytes:actualBytes,capsules:summaries,copyAuthoritySHA256:digest(fs.readFileSync(path.join(stage,'copy-authority.json'))),activeRepositoryChanged:false,localProductExecutions:0,localTests:0,localBuilds:0}));
