import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
const work=import.meta.dirname,stage=path.join(work,'keepass-history-draft-fix-next'),root=path.join(work,'keepass-history-production-adapter'),repo=path.resolve(work,'../outputs/rea-research-lab'),app='products/rea-studio/apps/vault',study=app+'/results/history-followup',sha=b=>createHash('sha256').update(b).digest('hex'),readStage=n=>fs.readFile(path.join(stage,n));
const manifestBytes=await readStage('draft-preservation-manifest.json'),receiptBytes=await readStage('draft-validation.final.json');assert.equal(sha(manifestBytes),'52e8294fd06887d49b76f315a67d4aa05e4fcfc9744ab4e96de94763872389b5');assert.equal(sha(receiptBytes),'1e6426ecdc9aebccd6aea57c8211540096897b1561547a0e7b4960d84a9f82d3');const manifest=JSON.parse(manifestBytes);assert.equal(manifest.count,1454);await fs.mkdir(root,{recursive:false});
const preserved=[];for(const e of manifest.files){assert.ok(e.path&&!e.path.includes('\\')&&!e.path.startsWith('/')&&!e.path.split('/').includes('..'));const b=await readStage(e.path);assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256,e.path);const carrier=/\.(zip|exe|dll)(\.snapshot)*$/.test(e.path),target=(carrier?'.local/stage-carriers/':study+'/stage/')+e.path+'.snapshot';await fs.mkdir(path.dirname(path.join(root,target)),{recursive:true});await fs.writeFile(path.join(root,target),b);preserved.push({originalPath:e.path,preservedPath:target,kind:carrier?'local-original-carrier':'public-inert-snapshot',bytes:e.bytes,sha256:e.sha256});}
for(const name of ['draft-preservation-manifest.json','draft-freeze.json']){const target=path.join(root,study,'stage',name+'.snapshot');await fs.writeFile(target,await readStage(name));}
await fs.writeFile(path.join(root,study,'preservation-manifest.json'),JSON.stringify({schema:'rea-vault-history-production-adapter-preservation/v1',count:1454,publicInertSnapshots:1450,localCarriers:4,originalManifestSha256:sha(manifestBytes),originalReceiptSha256:sha(receiptBytes),files:preserved,manifestCarrier:{path:study+'/stage/draft-preservation-manifest.json.snapshot',bytes:manifestBytes.length,sha256:sha(manifestBytes)},freezeCarrier:{path:study+'/stage/draft-freeze.json.snapshot',sha256:sha(await readStage('draft-freeze.json'))},originalExeEmbedded:false},null,2)+'\n');
const baseline=[];async function copyCurrent(relative){const b=await fs.readFile(path.join(repo,relative)),target=path.join(root,relative);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b);baseline.push({path:relative,bytes:b.length,sha256:sha(b)});}for(const e of await fs.readdir(path.join(repo,app),{withFileTypes:true})){assert.equal(e.isFile(),true,'Unexpected app directory needs explicit scope');await copyCurrent(app+'/'+e.name);}for(const relative of ['server.mjs','catalog.mjs','lib/storage.mjs','public/index.html','public/studio.mjs','public/style.css'])await copyCurrent('products/rea-studio/'+relative);await fs.writeFile(path.join(root,'production-baseline.json'),JSON.stringify({schema:'rea-vault-production-adapter-baseline/v1',capturedAt:new Date().toISOString(),files:baseline,old18ReceiptSha256:'895cb736a9b285bfd0c541b6f76a4dc577aca88675be38e3bab9d2a8be105aee'},null,2)+'\n');
const runtime=['history.mjs','server.mjs','kdbx.mjs','xml.mjs','client.mjs'],tests=['history.test.mjs','unknown-time.test.mjs','http.test.mjs','ui.test.mjs','selection-independent.test.mjs','selection-boundaries.test.mjs','selection-adjacent.test.mjs','same-editor-draft.test.mjs','preexisting-draft.test.mjs','draft-adjacent.test.mjs','idle-view.test.mjs','disposal-adjacent.test.mjs'],helpers=['harness.mjs','history-oracle.ps1','http-runner.mjs','ui-fixture.mjs','lifecycle-ui-fixture.mjs'];for(const name of [...runtime,...tests,...helpers])await fs.writeFile(path.join(root,app,name),await readStage(name));
const changes=[];async function adapt(name,substitutions){const target=path.join(root,app,name),before=await fs.readFile(target,'utf8');let after=before;for(const [from,to]of substitutions){assert.ok(after.includes(from),'Expected exact path adaptation '+name+': '+from);after=after.replaceAll(from,to);}if(after!==before){await fs.writeFile(target,after);changes.push({path:app+'/'+name,oldSha256:sha(before),newSha256:sha(after),changes:substitutions.map(([from,to])=>({from,to})),scope:'Test-only path/output adapter; test scenarios and native semantics unchanged.'});}}
await adapt('harness.mjs',[["export const oracle=path.resolve(here,'../../outputs/rea-research-lab/projects/07-keepass/artifacts/portable/KeePass.exe');","export const fixtureRoot=path.resolve(here,'../../../..','.local/vault-history-fixtures',String(process.pid));\nexport const observationsDirectory=path.join(fixtureRoot,'observations');\nexport const oracle=process.env.REA_KEEPASS_EXE??path.resolve(here,'../../../..','projects/07-keepass/artifacts/portable/KeePass.exe');"]]);
for(const [name,file]of [['history.test.mjs','history-original.json'],['unknown-time.test.mjs','history-unknown-time.json'],['http.test.mjs','history-http.json']])await adapt(name,[["observations,pass} from './harness.mjs'","observations,pass,observationsDirectory} from './harness.mjs'"],["path.join(here,'.local/observations')","observationsDirectory"],["path.join(here,'.local/observations/"+file+"')","path.join(observationsDirectory,'"+file+"')"],["detail:'.local/observations/"+file+"'","detail:path.join(observationsDirectory,'"+file+"')"]]);
await adapt('http-runner.mjs',[["from './host/server.mjs'","from '../../server.mjs'"]]);
for(const [name,folder]of [['ui-fixture.mjs','selection-boundaries'],['lifecycle-ui-fixture.mjs','lifecycle-boundaries']])await adapt(name,[["import assert from 'node:assert/strict';","import {fixtureRoot,observationsDirectory} from './harness.mjs';\nimport assert from 'node:assert/strict';"],["path.join(own,'.local',name+'-'+process.pid)","path.join(fixtureRoot,name+'-'+process.pid)"],["path.join(own,'.local/observations/"+folder+"')","path.join(observationsDirectory,'"+folder+"')"]]);
await adapt('selection-independent.test.mjs',[["import {render} from './client.mjs';","import {fixtureRoot,observationsDirectory} from './harness.mjs';\nimport {render} from './client.mjs';"],["path.join(own,'.local/restore-selection-synthetic')","path.join(fixtureRoot,'restore-selection-synthetic')"],["path.join(own,'.local/observations')","observationsDirectory"],["path.join(own,'.local/observations/restore-selection-observation.json')","path.join(observationsDirectory,'restore-selection-observation.json')"]]);
const readmePath=path.join(root,app,'README.md'),oldReadme=await fs.readFile(readmePath,'utf8'),addition='\n\n## Entry history and safe editor publication\n\nChanged entry content creates an encrypted previous version. Imported count/size limits prune supported flat history using released source ordering; a no-op save updates access without creating a version. History previews are explicit and masked by default. Confirmed restoration preserves current identity/location and backs up the current entry. Unsaved editor values refuse Restore before an effect; drafts entered during pending Save/Restore are retained. View cleanup cancels its owned timer and prevents disposed responses from republishing private fields.\n\nThis finite source-assisted slice is documented in the [preserved study README](results/history-followup/stage/README.md.snapshot), [source contracts](results/history-followup/stage/SOURCE-CONTRACTS.md.snapshot), [draft/lifecycle correction](results/history-followup/stage/DRAFT-CORRECTION.md.snapshot) and [license notice](results/history-followup/NOTICE.md). Exact sources, original failures and historical receipts remain inert snapshots under results/history-followup/stage/. The original181/selection546/current1454 evidence and compatibility18 retain their own source identities. The application uses native JavaScript; original assembly execution occurs only in test tooling. Finite helper/DOM/HTTP evidence does not establish complete KeePass parity, original GUI execution or security/performance superiority. The full original ZIP and release executable remain local study/oracle carriers.\n';await fs.writeFile(readmePath,oldReadme+addition);changes.push({path:app+'/README.md',oldSha256:sha(oldReadme),newSha256:sha(oldReadme+addition),scope:'Documentation addition with actual app-relative inert study/notice links only; no runtime change.'});
await fs.writeFile(path.join(root,study,'NOTICE.md'),'# Vault history source study\n\nSelected upstream source is KeePass 2.61.1, Copyright (C) Dominik Reichl and contributors, GPL-2.0-or-later. The exact released license is preserved as [source/Docs/License.txt.snapshot](stage/source/Docs/License.txt.snapshot); the separate icons license is preserved as [source/KeePass/Resources/Icons/Nuvola/License.txt.snapshot](stage/source/KeePass/Resources/Icons/Nuvola/License.txt.snapshot). Source-assisted candidate history code retains GPL-2.0-or-later attribution; this notice does not determine a broader repository distribution license. No logo/icon use is added.\n\nThe [selected source census](stage/source-census.final.json.snapshot), [source acquisition provenance](stage/source-acquisition.final.json.snapshot), [contracts](stage/contract-map.json.snapshot) and [dirty editor guard spans](stage/draft-contract-map.json.snapshot) bind the complete original carrier census and selected source bytes. Four identical ZIP carrier copies are preserved locally and excluded from public inert snapshots; the full executable is authenticated locally by tests and is not embedded. The [preservation manifest](preservation-manifest.json) records every historical artifact and its actual local/public disposition.\n');
await fs.writeFile(path.join(root,'adaptations.json'),JSON.stringify({schema:'rea-vault-history-production-adapter-diff/v1',runtimeByteIdentical:true,runtime:await Promise.all(runtime.map(async name=>({path:app+'/'+name,sha256:sha(await readStage(name))}))),tests,changes,semanticTestChanges:false,allFrozen1454Preserved:true,appResultsWritesByNormalTests:false},null,2)+'\n');await fs.copyFile(import.meta.filename,path.join(root,'prepare-keepass-history-production-adapter.mjs'));console.log(JSON.stringify({root,preserved:1454,publicSnapshots:1450,localCarriers:4,adaptedFiles:changes.length,runtimeUnchanged:true}));
