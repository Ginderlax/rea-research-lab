    {
      "id": "grafana.candidate.cbef9bad1000e5aa6cb1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The MySQL query editor has two modes: **Builder** and **Code**.",
      "headingPath": [
        "MySQL query editor",
        "MySQL query editor components"
      ],
      "source": {
        "path": "docs/sources/datasources/mysql/query-editor/_index.md",
