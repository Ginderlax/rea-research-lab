    },
    {
      "id": "grafana.candidate.29e59fe20b99a0b4e74d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, persistent storage is disabled, which means that Grafana uses ephemeral storage, and all data will be stored within the container's file system. This data will be lost if the container is stopped, restarted, or if the container crashes.",
      "headingPath": [
        "Deploy Grafana using Helm Charts",
        "Customize Grafana default configuration",
        "Enable persistent storage **(recommended)**"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/installation/helm/index.md",
        "gitBlobSha": "41c9c763ba14b1a634ed0d24f1f44ec54f690f7b",
        "sha256": "27cec149272554118e038bc615ca8efaa33b8bbc137764bfc16cde0fce6430bb",
        "lineStart": 206,
        "lineEnd": 206,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/installation/helm/index.md#L206-L206"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.03cb730d25288a36e73c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "It is highly recommended that you enable persistent storage in Grafana Helm charts if you want to ensure that your data persists and is not lost in case of container restarts or failures.",
      "headingPath": [
        "Deploy Grafana using Helm Charts",
        "Customize Grafana default configuration",
        "Enable persistent storage **(recommended)**"
      ],
      "source": {
