    {
      "id": "grafana.candidate.528fd7175498a9d10ec0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Toggle **Wrap lines** if you encounter long lines of text that make it difficult to read and analyze the context around log entries. By enabling this toggle, Grafana automatically wraps long lines of text to fit within the visible width of the viewer, making the log entries easier to read and understand.",
      "headingPath": [
        "Logs in Explore",
        "Logs",
        "Log context"
      ],
