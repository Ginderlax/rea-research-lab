    {
      "id": "grafana.candidate.a2fa6ccfc44313c5d517",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In some cases, the query editor can detect which operations are most appropriate for a selected log stream. When it does, it shows a hint next to the **+ Operations** button. Click the hint to add the operations to your query.",
      "headingPath": [
        "Loki query editor",
        "Builder mode",
        "Hints"
      ],
