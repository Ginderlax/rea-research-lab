        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/shared/datasources/tempo-search-traceql.md#L25-L25"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.a8a0c752b2a9f25ff7e4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The builder supports a subset of TraceQL capabilities, including some structural operators (`>>`, `>`, `=~`, `!=`).",
      "headingPath": [
        "Write TraceQL queries using Search"
      ],
      "source": {
        "path": "docs/sources/shared/datasources/tempo-search-traceql.md",
