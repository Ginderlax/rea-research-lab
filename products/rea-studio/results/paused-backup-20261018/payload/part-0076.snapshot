    },
    {
      "id": "grafana.candidate.41f1854d679cf0d93e03",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "TraceQL evaluates a contiguously stored trace. If these two conditions are satisfied in separate tenants, then Tempo doesn't return the trace.",
      "headingPath": [
        "Query tracing data",
        "Cross-tenant TraceQL queries"
      ],
