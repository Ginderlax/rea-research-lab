import assert from 'node:assert/strict';
import * as fs from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import {createHash} from 'node:crypto';
import {execFile} from 'node:child_process';
import {promisify} from 'node:util';
import {fileURLToPath} from 'node:url';
import {RabinBoundaries,MIN,MAX} from './rabin.mjs';
import {hash,open,seal,passwordKey,masterKey,validPolynomial} from './restic-crypto.mjs';
const exec=promisify(execFile),MiB=1024*1024,exe=path.resolve('outputs/rea-research-lab/projects/09-restic/artifacts/unpacked/restic_0.19.1_windows_amd64.exe'),archive=path.resolve('outputs/rea-research-lab/projects/09-restic/artifacts/restic_0.19.1_windows_amd64.zip'),testPassword='own-rabin-original-boundary-fixtures-only';
function fixtureBytes(length){const out=Buffer.alloc(length);for(let offset=0;offset<length;offset+=32)createHash('sha256').update(`independent-rabin-corpus:${offset}`).digest().copy(out,offset,0,Math.min(32,length-offset));return out;}
function fixturePolynomials(){const rows=['3da3358b4dc173'];for(let trial=0;rows.length<3;trial++){const digest=createHash('sha256').update(`independent-rabin-polynomial:${trial}`).digest('hex'),value=((BigInt(`0x${digest.slice(0,14)}`)&((1n<<53n)-1n))|(1n<<53n)|1n).toString(16);if(validPolynomial(value)&&!rows.includes(value))rows.push(value);}return rows;}
function nativeRows(bytes,poly,width=512*1024){const chunker=new RabinBoundaries(poly),rows=[];for(let offset=0;offset<bytes.length;offset+=width)rows.push(...chunker.push(bytes.subarray(offset,offset+width)));rows.push(...chunker.finish());return rows.map(row=>({...row,sha256:hash(bytes.subarray(row.start,row.start+row.length))}));}
export async function compareOriginal(){
 const prototypeBytes=await fs.readFile(new URL('rabin.mjs',import.meta.url)),polynomials=fixturePolynomials(),base=fixtureBytes(12*MiB),mutated=Buffer.from(base);for(let offset=5*MiB;offset<5*MiB+7;offset++)mutated[offset]^=0x5a;
 const corpora={'baseline.bin':base,'inserted.bin':Buffer.concat([base.subarray(0,2*MiB),Buffer.from('INSERT!'),base.subarray(2*MiB)]),'mutated.bin':mutated,'forced-max.bin':Buffer.alloc(2*MAX+127,0x41),'zero.bin':Buffer.alloc(4*MIN),'min-minus.bin':fixtureBytes(MIN-1),'min-exact.bin':fixtureBytes(MIN),'min-plus.bin':fixtureBytes(MIN+1),'tiny.bin':Buffer.from('short'),'empty.bin':Buffer.alloc(0)},commands=[],comparisons=[],root=await fs.mkdtemp(path.join(os.tmpdir(),'rea-rabin-original-'));
 async function original(workspace,args){assert.equal(hash(await fs.readFile(exe)),'b0dd1fd21eea5d8fe1325f55f7118213c21f36de8a261e04c0624a5ab9fd7830');assert.equal(hash(await fs.readFile(archive)),'da948ad707ed690426473aaba2046cd61f8f90f6f0e7dab6be0d5796531de67d');const result=await exec(exe,['--no-cache','-r',path.join(workspace,'repository'),...args],{cwd:workspace,encoding:'buffer',env:{...process.env,RESTIC_PASSWORD:testPassword,RESTIC_PASSWORD_FILE:'',RESTIC_PASSWORD_COMMAND:'',RESTIC_REPOSITORY:''},windowsHide:true,timeout:60000,maxBuffer:MAX+MiB});commands.push({args,exitCode:0,stdoutBytes:result.stdout.length,stdoutSha256:hash(result.stdout),...(args[0]==='cat'&&args[1]==='blob'?{}:{stdout:result.stdout.toString('utf8')}),stderr:result.stderr.toString('utf8')});return result.stdout;}
 let failure;
 try{
  for(const polynomial of polynomials){const workspace=path.join(root,polynomial);await fs.mkdir(path.join(workspace,'corpus'),{recursive:true});for(const[name,bytes]of Object.entries(corpora))await fs.writeFile(path.join(workspace,'corpus',name),bytes);await original(workspace,['version']);await original(workspace,['init','--repository-version','2']);const keys=await fs.readdir(path.join(workspace,'repository','keys')),keyDoc=JSON.parse(await fs.readFile(path.join(workspace,'repository','keys',keys[0]),'utf8')),key=masterKey(JSON.parse(open(await passwordKey(keyDoc,testPassword),Buffer.from(keyDoc.data,'base64')))),configPath=path.join(workspace,'repository','config'),config=JSON.parse(open(key,await fs.readFile(configPath)));config.chunker_polynomial=polynomial;await fs.writeFile(configPath,seal(key,Buffer.from(JSON.stringify(config))));const replayedConfig=JSON.parse((await original(workspace,['cat','config'])).toString('utf8'));assert.equal(replayedConfig.chunker_polynomial,polynomial);
   const output=(await original(workspace,['backup','corpus','--compression','off','--json'])).toString('utf8'),snapshotID=JSON.parse(output.trim().split(/\r?\n/).at(-1)).snapshot_id;assert.match(snapshotID,/^[a-f0-9]{64}$/);const snapshot=JSON.parse((await original(workspace,['cat','snapshot',snapshotID])).toString('utf8')),files=new Map();
   async function tree(treeID){const doc=JSON.parse((await original(workspace,['cat','blob',treeID])).toString('utf8'));for(const node of doc.nodes){if(node.type==='dir')await tree(node.subtree);else if(node.type==='file'){assert.ok(!files.has(node.name));files.set(node.name,node);}}}await tree(snapshot.tree);
   const lengths=new Map();for(const name of await fs.readdir(path.join(workspace,'repository','index'))){const doc=JSON.parse((await original(workspace,['cat','index',name])).toString('utf8'));for(const pack of doc.packs)for(const blob of pack.blobs)if(blob.type==='data'){assert.ok(!blob.uncompressed_length,'Original off-mode data is uncompressed');const length=blob.length-32;if(lengths.has(blob.id))assert.equal(lengths.get(blob.id),length);lengths.set(blob.id,length);}}
   for(const[name,bytes]of Object.entries(corpora)){const rows=nativeRows(bytes,polynomial),originalIDs=files.get(name).content??[],ordered=originalIDs.map(id=>({length:lengths.get(id),sha256:id}));assert.equal(files.get(name).size,bytes.length);assert.deepEqual(rows.map(({length,sha256})=>({length,sha256})),ordered,`${polynomial}/${name}`);assert.equal(rows.reduce((sum,row)=>sum+row.length,0),bytes.length);comparisons.push({polynomial,name,bytes:bytes.length,sha256:hash(bytes),originalChunks:ordered,candidateChunks:rows,orderedBoundaryAndSha256Match:true});}
   const forced=comparisons.find(value=>value.polynomial===polynomial&&value.name==='forced-max.bin');assert.deepEqual(forced.originalChunks.map(value=>value.length),[MAX,MAX,127]);const held=await original(workspace,['cat','blob',forced.originalChunks[0].sha256]);assert.equal(held.length,MAX);assert.equal(hash(held),forced.originalChunks[0].sha256);await original(workspace,['check','--read-data']);console.log(JSON.stringify({polynomial,files:Object.keys(corpora).length,chunks:comparisons.filter(value=>value.polynomial===polynomial).reduce((sum,value)=>sum+value.originalChunks.length,0),status:'matched'}));
  }
 }catch(error){failure={message:error.message,stack:error.stack};throw error;}finally{assert.equal(hash(await fs.readFile(new URL('rabin.mjs',import.meta.url))),hash(prototypeBytes));const report={schema:'rea-rabin-original-comparison/v1',checkedAtUtc:new Date().toISOString(),candidateSha256:hash(prototypeBytes),original:{version:'restic 0.19.1',sourceCommit:'6aa3a516ce654808a1f28f9fa21e9b7c8e6e90bf',chunker:'v0.4.0',executableSha256:'b0dd1fd21eea5d8fe1325f55f7118213c21f36de8a261e04c0624a5ab9fd7830',archiveSha256:'da948ad707ed690426473aaba2046cd61f8f90f6f0e7dab6be0d5796531de67d',authenticatedBeforeEveryExecution:true},polynomials,comparisons,commands,failure:failure??null,sourceBytesStableAcrossRun:true,cutFingerprintRuntimeComparison:false,scope:'Exact ordered plaintext chunk SHA256 IDs and lengths from actual original backup/tree/index commands; original CLI does not expose rolling Cut fingerprints. No arbitrary-average/min/max option parity claim.'};await fs.writeFile(new URL('original-validation.json',import.meta.url),JSON.stringify(report,null,2)+'\n');assert.equal(path.dirname(root),path.resolve(os.tmpdir()));assert.ok(path.basename(root).startsWith('rea-rabin-original-'));await fs.rm(root,{recursive:true,force:true});}
 return{files:comparisons.length,chunks:comparisons.reduce((sum,row)=>sum+row.originalChunks.length,0),originalExecutions:commands.length};
}
if(process.argv[1]&&path.resolve(process.argv[1])===fileURLToPath(import.meta.url))console.log(JSON.stringify(await compareOriginal()));
