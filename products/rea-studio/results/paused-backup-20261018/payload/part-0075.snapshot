    {
      "id": "grafana.candidate.4062a305dbb9843eb2d0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This mode provides more flexible querying but may return metrics with unexpected additional dimensions.",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Query CloudWatch metrics",
        "Metric Search queries"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/query-editor/index.md",
