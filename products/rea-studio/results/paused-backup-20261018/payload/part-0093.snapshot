 const names=fs.readdirSync(evidence).filter(name=>/^case-.*\.json$/.test(name));assert.equal(names.length,8);const cases=names.map(name=>({name,value:json(name)}));assert.deepEqual(cases.map(row=>row.value.title).sort(),[...roster].sort());const screenshots=[],downloads=[],records=[],holds=[],faults=[],accepted=[];
 const kinds=['new-task-unsaved-validation-and-explicit-retry','native-discard-cancel-and-new-note-kind-reset','new-task-commit-held-native-duplicate-and-newer-draft','new-task-editor-ownership-after-actual-commit','new-task-disposal-after-actual-first-commit','new-task-postcommit-genuine-list400-newer-draft','new-task-committed-save-refresh-failure-explicit-recovery','new-task-actual-jex-native-tar-and-resource-download'];
 for(const item of cases){const value=item.value,index=roster.indexOf(value.title);assert(index>=0);assert.equal(value.schema,'rea-notes-new-todo-real-browser-case/v1');assert.equal(value.statusAtFixtureClose,'passed');assert.equal(value.retry,0);assert.equal(value.realBrowser,true);assert.equal(value.actualHTTP,true);assert.equal(value.serverCloseObserved,true);for(const key of['originalProductExecutions','originalFullApplicationExecutions','originalHelperExecutions','programmaticDisabledControlProbes'])assert.equal(value[key],0);assert.deepEqual(value.errors,[]);assert(/^[A-Za-z0-9-]+$/.test(value.testId));assert.equal(item.name,'case-'+value.testId+'.json');
  const cleanup=value.teardown;assert.equal(cleanup.stage,'completed');for(const key of['heldRoutesFinished','drained','contextClosed','serverClosed','screenshotSaved'])assert.equal(cleanup[key],true);assert.equal(cleanup.activeOwnedIOFault,false);assert.equal(cleanup.pendingOwnedRequests,0);assert.equal(cleanup.requestCounts.failed,0);assert.equal(cleanup.requestCounts.started,cleanup.requestCounts.finished);assert.deepEqual(cleanup.steps.map(row=>row.name),['release-held-routes','screenshot','drain-owned-page-requests','capture-synthetic-final-record','close-owned-context','close-owned-server']);assert(cleanup.steps.every(row=>row.status==='passed'));
  const relevant=value.observations.filter(row=>row.kind===kinds[index]);assert.equal(relevant.length,1);const observed=relevant[0];const screenshot='screenshots/'+value.testId+'.png';screenshots.push({path:screenshot,...png(read(screenshot))});const disk=value.observations.filter(row=>row.kind==='owned-synthetic-disk-record');assert.equal(disk.length,1);assert.equal(disk[0].path,'notes-records/'+value.testId+'.json');const storedBytes=read(disk[0].path);assert.deepEqual(identity(storedBytes),pin(disk[0]));const stored=JSON.parse(storedBytes);assert.equal(stored.schema,2);records.push({path:disk[0].path,...identity(storedBytes)});
  const expectedFailures=[0,5,6].includes(index)?1:0;assert.equal(value.expectedHttpFailures.length,expectedFailures);assert.equal(value.responses.filter(row=>row.status>=400).length,expectedFailures);for(const failure of value.expectedHttpFailures){assert.equal(failure.status,400);assert.equal(failure.observed,true);assert.equal(failure.path,index===0?'/api/notes/save':'/api/notes/list');if(index===0)assert.equal(failure.errorMessage,'Give the note a title.');else assert(/^(EISDIR|EPERM|EACCES): /.test(failure.errorMessage));const actual=value.responses.filter(row=>row.status===400&&row.expectedActualHostFailure===true&&row.path===failure.path&&row.error===failure.errorMessage);assert.equal(actual.length,1);}assert(value.expectedConsole.length<=expectedFailures);if(!expectedFailures)assert.deepEqual(value.expectedConsole,[]);
  assert.equal(value.faults.length,[2,3,4,5,6].includes(index)?1:0);for(const fault of value.faults){assert.equal(fault.handlerMocked,false);assert.equal(fault.responseRewritten,false);if([2,3,4].includes(index)){assert.equal(fault.kind,'delay-after-actual-host-response');assert.equal(fault.action,'save');assert.equal(fault.status,200);assert(fault.body.bytes>0&&/^[0-9a-f]{64}$/.test(fault.body.sha256));holds.push({title:value.title,...fault});}else{assert.equal(fault.kind,'actual-host-list400-after-owned-filesystem-read-fault');assert.equal(fault.actualStatus,400);assert.equal(fault.restoreCompletedBeforeResponseDelivery,true);assert.equal(fault.heldAfterRestore,index===5);assert.deepEqual(fault.originalCommittedState,fault.restoredState);assert.deepEqual(fault.steps.map(row=>row.name),['all-other-owned-requests-and-attachment-response-drained','fault-ownership-entered','committed-state-renamed-to-owned-sibling','empty-directory-installed-at-owned-state-file','unchanged-host-returned-real-filesystem400','owned-empty-directory-removed-without-recursion','original-state-restored','restored-exact-original-bytes-verified','actual-response-release-requested','unchanged-actual400-delivered-after-restoration']);let previous=0;for(const step of fault.steps){const time=Date.parse(step.atUtc);assert(Number.isFinite(time)&&time>=previous);previous=time;}assert.equal(fault.actualError,value.expectedHttpFailures[0].errorMessage);assert.equal(stored.notes[fault.noteId].revision,index===5?2:1);faults.push({title:value.title,...fault});if(fault.heldAfterRestore)holds.push({title:value.title,...fault});}}
  if(index===0){assert.equal(observed.ordinaryDraftMutationRequests,0);assert.equal(observed.actualEmptyTitleStatus,400);assert.equal(observed.explicitNewTodo,true);assert.equal(stored.notes[observed.noteId].revision,1);}if(index===1){assert.equal(observed.nativeDialogs,3);assert.equal(observed.cancellationRetainedAllFields,true);assert.equal(observed.savedAsTask,false);assert.equal(stored.notes[observed.noteId].todo?.isTodo??false,false);}if(index===2){assert.equal(observed.nativeDuplicatePointerClicks,2);assert.equal(observed.firstSaveRequests,1);assert.equal(observed.nextSubmittedRevision,1);assert.equal(observed.finalRevision,2);assert.equal(observed.ordinaryEnabledFieldTyping,true);assert.equal(observed.programmaticDisabledControlProbe,false);assert.equal(stored.notes[observed.noteId].revision,2);}if(index===3){assert.notEqual(observed.oldId,observed.newId);assert.equal(stored.notes[observed.oldId].revision,1);assert.equal(stored.notes[observed.newId].revision,1);}if(index===4){assert.equal(observed.lateNotesRequests,0);assert.equal(observed.detachedControlObserved,true);assert.equal(observed.detachedControlScrubbingClaimed,false);}if(index===5){assert.equal(observed.nextSubmittedRevision,1);assert.equal(observed.finalRevision,2);assert.equal(observed.ordinaryEnabledFieldTyping,true);}if(index===6){assert.equal(observed.explicitRefreshStatus,200);assert.deepEqual(observed.stateBefore,observed.stateAfter);assert.deepEqual(observed.stateAfter,identity(storedBytes));}
  assert.equal(value.downloads.length,index===7?2:0);for(const download of value.downloads){const suffix=download.suggestedFilename==='rea-notes.jex'?'-new-task-notes.jex':download.suggestedFilename==='sample.bin'?'-resource-sample.bin':null;assert(suffix);assert.equal(download.path,'downloads/'+value.testId+suffix);const bytes=read(download.path);assert.deepEqual(identity(bytes),download.observed);assert.deepEqual(value.observations.filter(row=>row.kind==='real-browser-file-download'&&row.path===download.path),[download]);if(suffix.endsWith('.bin'))assert.deepEqual(bytes,Buffer.from([0,1,127,128,255]));downloads.push({path:download.path,suggestedFilename:download.suggestedFilename,...identity(bytes)});}
  if(index===7){const archive=value.downloads.find(row=>row.suggestedFilename==='rea-notes.jex'),exported=tar(read(archive.path)),original=tar(helper.readSource('products/rea-studio/apps/notes/fixtures/pinned-joplin.jex'));assert.equal(original.size,8);assert.equal(exported.size,9);for(const[name,bytes]of original)assert.deepEqual(exported.get(name),bytes,'Original native JEX entry '+name);const raw=exported.get(observed.noteId.replaceAll('-','')+'.md');assert(raw);const text=raw.toString('utf8');assert(text.startsWith(stored.notes[observed.noteId].title+'\n\n'+stored.notes[observed.noteId].body+'\n\n'));for(const property of['is_todo: 1','todo_due: 0','todo_completed: 0','parent_id: '+'1'.repeat(32)])assert(text.split('\n').includes(property));assert.equal(observed.independentNativeTar.unchangedRawRecordComparisons,7);const listing=read('notes-native-tar-list-'+value.testId+'.txt');assert.deepEqual(identity(listing),observed.independentNativeTar.listing);assert.equal(listing.toString('utf8').trim().split(/\r?\n/).length,9);assert.deepEqual(identity(read(archive.path)),observed.independentNativeTar.archive);assert.deepEqual(observed.resourceDownload,{bytes:5,sha256:'0150a92bb1212cd00516b65fde0704614760000963874fcbb11eaa734ee87809'});}
  accepted.push({title:value.title,testId:value.testId,...identity(read(item.name))});
 }
 assert.equal(screenshots.length,8);assert.equal(records.length,8);assert.equal(downloads.length,2);assert.equal(holds.length,4);assert.equal(faults.length,2);assert.equal(fs.readdirSync(path.join(evidence,'screenshots')).filter(name=>name.endsWith('.png')).length,8);assert.equal(fs.readdirSync(path.join(evidence,'downloads')).length,2);assert.equal(fs.readdirSync(path.join(evidence,'notes-records')).length,8);return{cases:accepted,screenshots,downloads,ownedSyntheticRecords:records,realResponseHolds:holds,genuineOwnedIOFailures:faults,allOwnedCleanupVerified:true,worker:{path:workers[0],...identity(read(workers[0])),pid:worker.pid},summary:{tests:8,passed:8,failed:0,skipped:0,flaky:0,retries:0,successfulActualResponseHolds:3,failedActualResponseHolds:1,genuineEmptyTitle400:1,genuineOwnedHostList400:2,downloads:2,PNGs:8,completeOwnedCleanups:8,programmaticDisabledControlProbes:0,originalFullApplicationExecutions:0}};
}
async function browserPrerequisites(){
 const raw=read('browser-tooling-acquisition.json'),acquisition=JSON.parse(raw),execution={...helper.execution()};delete execution.GITHUB_JOB;assert.equal(acquisition.schema,'rea-cloud-browser-tooling-acquisition/v1');assert.equal(acquisition.status,'acquired');assert.deepEqual(acquisition.execution,execution);assert.equal(acquisition.sourceCommit,process.env.GITHUB_SHA);assert.equal(acquisition.productTests,0);assert.equal(acquisition.applicationSourcesChanged,false);assert.equal(acquisition.historicalReceiptsRebound,false);assert.equal(acquisition.children.length,2);for(const child of acquisition.children){assert.equal(child.exitCode,0);assert.equal(child.signal,null);assert.equal(child.closeObserved,true);assert.equal(child.stopReason,undefined);assert.equal(child.spawnError,undefined);}const expectedTooling={package:pin(tooling[7]),lock:pin(tooling[8]),browserMetadata:pin(tooling[9]),packageVersions:{'@playwright/test':'1.64.1',playwright:'1.64.1','playwright-core':'1.64.1'}};assert.deepEqual(acquisition.toolingSource,expectedTooling);
 const temporary=fs.realpathSync(process.env.RUNNER_TEMP),cache=fs.realpathSync(process.env.PLAYWRIGHT_BROWSERS_PATH);const inside=(parent,name)=>{const r=path.relative(parent,name);return r&&r!=='..'&&!r.startsWith('..'+path.sep)&&!path.isAbsolute(r);};assert(inside(temporary,cache));for(const name of['@playwright/test','playwright','playwright-core'])assert.equal(JSON.parse(fs.readFileSync(path.join(tools,'node_modules',name,'package.json'))).version,'1.64.1');assert.deepEqual(fs.readFileSync(path.join(tools,'node_modules/playwright-core/browsers.json')),committed(tooling[9].path,tooling[9]));const{chromium}=await import(pathToFileURL(path.join(tools,'node_modules/playwright/index.mjs')).href);const executable=fs.realpathSync(chromium.executablePath());assert(inside(cache,executable));assert(executable.split(path.sep).includes('chromium-1248'));assert.equal(acquisition.browserImage.executable,executable);assert.equal(acquisition.browserImage.revision,'1248');assert.equal(acquisition.browserImage.expectedVersion,'156.0.8078.4');assert.deepEqual(identity(fs.readFileSync(executable)),pin(acquisition.browserImage));return{acquisition:identity(raw),browserImage:acquisition.browserImage};
}
try{
 record.tooling=toolingProof();composition=helper.readComposition(evidence);record.composition=composition.receipt;record.notesSourceAuthentication=composition.value.composedSourceAuthentication;
 if(post){const attempt=json('new-todo-browser-attempt.json');sameAttempt(attempt);assert.deepEqual(attempt.composition,composition.receipt);assert.deepEqual(attempt.tooling,record.tooling);assert.deepEqual(json('new-todo-browser-source-before.json'),composition.after);record.priorAttempt=identity(read('new-todo-browser-attempt.json'));record.priorStatus=attempt.status;record.composerPostcheck=helper.verifyPostcheck(evidence,composition);record.sourceAuthentication=helper.authenticateCensus(helper.activeCensus(),composition.bundle,true);record.sourceStable=true;record.applicationSourcesChanged=false;record.status='source-verified';}
 else{
  captureTooling(record.tooling);before=helper.activeCensus();assert.deepEqual(before,composition.after);write('new-todo-'+role+'-source-before.json',before);for(const row of before)writeBytes('active-source/'+row.path+'.snapshot',helper.readSource('products/rea-studio/'+row.path));record.sourceCapturedBeforeExecution=true;record.sourceFiles=before.length;record.sourceCaptureLimits=helper.sourceLimits;
