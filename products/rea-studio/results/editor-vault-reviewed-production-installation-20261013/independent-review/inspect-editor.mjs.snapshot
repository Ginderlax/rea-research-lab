import fs from'node:fs/promises';import path from'node:path';import{createHash}from'node:crypto';import assert from'node:assert/strict';
const here=import.meta.dirname,stage=path.resolve(here,'../editor-pattern-root-installation-plan-next'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});const manifest=await fs.readFile(path.join(stage,'manifest.json'));assert.equal(id(manifest).sha256,'b5e21ff4810e0b92d066a72deeb8bb41538aed48e499a4bcd8774f8322b81996');const proof=JSON.parse(await fs.readFile(path.join(stage,'source-proof/preservation-manifest.json'))),plan=JSON.parse(await fs.readFile(path.join(stage,'installation-plan.json')));const out={manifest:id(manifest),proof:{keys:Object.keys(proof),epochs:proof.epochs,records:proof.records.length,payloads:proof.payloads.length,first:proof.records[0]},plan};await fs.writeFile(path.join(here,'editor-inspection.json'),JSON.stringify(out,null,2)+'\n',{flag:'wx'});process.stdout.write(JSON.stringify(out,null,2)+'\n');
