import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{authenticate}from'./audit.mjs';const here=import.meta.dirname,workspace=path.resolve(here,'../..'),sha=b=>createHash('sha256').update(b).digest('hex'),after=await authenticate(),before=JSON.parse(await fs.readFile(path.join(here,'authentication-before.json')));assert.deepEqual(after.scopes,before.scopes);assert.deepEqual(after.current24,before.current24);assert.deepEqual(after.current31,before.current31);assert.deepEqual(after.liveFour,before.liveFour);assert.deepEqual(after.allMap,before.allMap);assert.equal(new Set(after.allMap.map(r=>r.publicPath.toLowerCase())).size,475);for(const r of after.allMap)assert(r.publicPath.split('/').every(s=>! /^(CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\.|$)/i.test(s)));
const base=path.join(workspace,'work/editor-value-api-publication-plan-next'),proof=JSON.parse(await fs.readFile(path.join(base,'runs/final-pure13/validation.json'))),sourceBefore=JSON.parse(await fs.readFile(path.join(base,'runs/final-pure13/source-before.json'))),sourceAfter=JSON.parse(await fs.readFile(path.join(base,'runs/final-pure13/source-after.json')));assert.deepEqual(sourceBefore,sourceAfter);assert.deepEqual(proof.sources,sourceBefore);for(const r of proof.sources){const b=await fs.readFile(path.join(base,'runs/final-pure13/source-before',r.path+'.snapshot'));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);const current=await fs.readFile(path.join(base,r.path));assert.equal(sha(current),r.sha256);}assert.equal(proof.sources.length,7);
const docBytes=await fs.readFile(path.join(here,'docs-review/observations.json'));assert.equal(sha(docBytes),'484e4870777e29a2f503177660ea9fd0340cf039ba14d532df36e2b03916cf78');const notice=await fs.readFile(path.join(base,'proposed/products/rea-studio/apps/editor/position-range-selection.NOTICE.md')),license=await fs.readFile(path.join(workspace,'work/editor-position-range-selection-fix-next/source/LICENSE.txt.snapshot'));assert.equal(license.length,1088);assert.equal(notice.indexOf(license),593);assert.equal(sha(license),'9480271317925265e806a9a196aaa33410a962fa9d4d1e248a4a5187bc8c9df9');await fs.writeFile(path.join(here,'authentication-after.json'),JSON.stringify(after,null,2)+'\n',{flag:'wx'});const receipt={schema:'rea-editor-value-api-publication-independent-review/v1',at:new Date().toISOString(),sourceOnly:true,scopes:after.scopes,publicAliases:475,incoming402:402,incomingUniqueByteObjects:166,embeddedHistoricalRows:190,basePlanAliases:58,guideOverrideAliases:15,liveAdds:4,liveReplacements:0,existingREADMEUnchanged:true,currentEditor24Stable:true,currentDirectAndShared31Stable:true,wholeLabClaim:false,priorSketch43Stable:true,fieldsPathsAndHeaderGuards:after.guardResults,caseFoldPathsUnique:true,noWindowsDeviceAliases:true,contentScan:after.scan,pure13Historical:{receiptSHA256:after.pureHistoricalProofSHA256,summary:after.pureHistoricalSummary,sevenSourcesAndBeforeAfterExact:true,rerun:false},newGuideOverrideReruns:0,pureNormalTestImports:after.normalTestImports,documentationReview:{path:'docs-review/observations.json',sha256:sha(docBytes),observations:7,MITExactBytes:1088,MITOffset:593,MITOriginalSHA256:sha(license),blockingFindings:0},requirements:after.requirements,confirmedPlanDefects:0,diagnostics:[{kind:'Read path',detail:'Guide stage has INTEGRATION and proposed guide, no root README; failed harmless read left bytes unchanged.',productFailure:false}],appExecutions:0,testsExecuted:0,originalExecutions:0,browser:0,hosts:0,benchmarks:0,fullsuite:0,productionMutations:0,frozenMutations:0,sourceStable:true,finiteSourcePlanAcceptance:true,installedAcceptance:false,fullParity:false,superiority:false};await fs.writeFile(path.join(here,'review-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});async function walk(d,p=''){const out=[];for(const e of await fs.readdir(d,{withFileTypes:true})){assert(!e.isSymbolicLink());if(e.isDirectory())out.push(...await walk(path.join(d,e.name),p+e.name+'/'));else out.push(p+e.name);}return out;}const inventory=[];for(const p of(await walk(here)).sort()){assert.notEqual(p,'review-manifest.json');const b=await fs.readFile(path.join(here,p));inventory.push({path:p,bytes:b.length,sha256:sha(b)});}const m={schema:'rea-editor-value-api-publication-independent-review-freeze/v1',files:inventory.length,totalBytes:inventory.reduce((n,r)=>n+r.bytes,0),inventory},b=Buffer.from(JSON.stringify(m,null,2)+'\n');await fs.writeFile(path.join(here,'review-manifest.json'),b,{flag:'wx'});console.log(JSON.stringify({files:m.files,manifestSHA256:sha(b),receiptSHA256:sha(await fs.readFile(path.join(here,'review-validation.json'))),finiteSourcePlanAcceptance:true,testsExecuted:0}));
