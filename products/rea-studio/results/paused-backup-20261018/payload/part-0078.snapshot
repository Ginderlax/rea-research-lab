    {
      "id": "grafana.candidate.182c35ad2461e0c62f14",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For logs where a `level` label is specified, the value of this label is used to determine the log level and update the color of each log line accordingly. If the log doesn't have a specified level label, Grafana treats the log line as not containing a level and omits rendering any value for it. Refer to the following table for more information. The log level is always determined by the first match when level is defined.",
      "headingPath": [
        "Logs in Explore",
        "Logs",
        "Log level"
      ],
      "source": {
        "path": "docs/sources/visualizations/explore/logs-integration.md",
        "gitBlobSha": "b7571ffd9ad594743a288d44864ef8345da24da3",
