    },
    {
      "id": "grafana.candidate.0ae56c7d785b5b5ba8be",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Refer to [Troubleshoot PDC issues](https://grafana.com/docs/grafana-cloud/connect-externally-hosted/private-data-source-connect/troubleshooting/) for agent error codes, log interpretation, and token management guidance.",
      "headingPath": [
        "Troubleshoot InfluxDB data source issues",
        "Connection errors",
        "PDC connection stops working after certificate renewal fails"
      ],
      "source": {
        "path": "docs/sources/datasources/influxdb/troubleshooting/index.md",
        "gitBlobSha": "4a7b13c358eecf6574d0997b79ec479ac54c4614",
