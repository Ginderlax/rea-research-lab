import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const base=path.resolve(import.meta.dirname,'..'),lab=path.join(base,'outputs/rea-research-lab'),owned=path.join(base,'work/root-backup64-host-transition-next'),target=path.join(lab,'scripts/verify-records.mjs'),sha=b=>createHash('sha256').update(b).digest('hex');fs.mkdirSync(owned,{recursive:true});const before=fs.readFileSync(target);fs.writeFileSync(path.join(owned,'verify-records.before.mjs.snapshot'),before,{flag:'wx'});for(const[n,source]of [['failed-publication-check.stdout.txt','work/notes-layout-value-api-records.stdout.txt'],['failed-publication-check.stderr.txt','work/notes-layout-value-api-records.stderr.txt']])fs.copyFileSync(path.join(base,source),path.join(owned,n),fs.constants.COPYFILE_EXCL);const anchor="// The455 checkpoint remains historical when subsequent reviewed runtime/docs change.",helper="function backup64SourceFingerprint(entry){if(entry.path!=='products/rea-studio/server.mjs')return currentPublicFingerprint(entry,'Current64 aggregate Backup source');safeRecordPath(entry.path);assert.equal(entry.bytes,7741);assert.equal(entry.sha256,'807a473ec0334f60dfd58f2df8901c722f1bd4eb1d64c62d9ba1ea65c2b6b55f');const transition=followupEvidence.editorHostTransition;assert.equal(transition.path,entry.path);assert.deepEqual(transition.before,{bytes:entry.bytes,sha256:entry.sha256});assert.equal(transition.addedStaticMapLineBytes,99);assert.equal(transition.historical3baHostAndInverseExact,true);const live=readFileSync(join(root,entry.path));assert.equal(live.length,transition.after.bytes);assert.equal(sha(live),transition.after.sha256);const prefix='products/rea-studio/results/milestones/search-trash-recycle-save-3baecf4e-20261013',mb=readFileSync(join(root,prefix,'snapshot-manifest.json'));assert.equal(sha(mb),'d969655ed6d1e73f925147c277261b38333e2d095b18a486f2c7c2a7700689ff');const m=JSON.parse(mb),rows=m.sourceSnapshots.filter(r=>r.sourcePath===entry.path);assert.equal(rows.length,1);const r=rows[0];safeRecordPath(r.snapshotPath);assert.ok(r.snapshotPath.startsWith('products/rea-studio/results/search-trash-recycle-save-combined-20261013/source/'));assert.equal(r.bytes,entry.bytes);assert.equal(r.sha256,entry.sha256);const old=readFileSync(join(root,r.snapshotPath));assert.equal(old.length,entry.bytes);assert.equal(sha(old),entry.sha256);}\n"+anchor;let s=before.toString();assert.equal(s.split(anchor).length,2);s=s.replace(anchor,helper);const old="for(const e of packIntegration.implementationFingerprints)currentPublicFingerprint({...e,path:'products/rea-studio/'+e.path},'Current64 aggregate Backup source');",next="for(const e of packIntegration.implementationFingerprints)backup64SourceFingerprint({...e,path:'products/rea-studio/'+e.path});";assert.equal(s.split(old).length,2);s=s.replace(old,next);const inverse=s.replace(next,old).replace(helper,anchor);assert.ok(Buffer.from(inverse).equals(before));fs.writeFileSync(target,s);fs.writeFileSync(path.join(owned,'verify-records.after.mjs.snapshot'),s,{flag:'wx'});const record={schema:'rea-backup64-historical-host-source-transition/v1',at:new Date().toISOString(),before:{bytes:before.length,sha256:sha(before)},after:{bytes:Buffer.byteLength(s),sha256:sha(Buffer.from(s))},changes:[{before:anchor,after:helper},{before:old,after:next}],inverseExact:true,priorBackup64ReceiptRebound:false,historicalServerRows:1,otherBackupCurrentRows:41,currentHostGuardStillMandatory:true,currentFullSuiteChecks:847,currentFullSuiteSources:720,appWrites:0,productFailure:false,newBehaviorExecuted:0};fs.writeFileSync(path.join(owned,'transformation.json'),JSON.stringify(record,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({rootVerifierSHA256:record.after.sha256,backupOnlyHistoricalHost:1,otherCurrentRows:41,appWrites:0}));
