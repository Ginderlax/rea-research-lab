    {
      "id": "grafana.candidate.49835c311555f2b6c961",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now customize how dates are formatted in Grafana. Custom date formats apply to the time range picker, graphs, and other panel visualizations.",
      "headingPath": [
        "What's new in Grafana v7.2",
        "New date formatting options added"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-2.md",
