import test from'node:test';import assert from'node:assert/strict';import{randomBytes}from'node:crypto';import{render}from'./client.mjs';import{makeDom,deferred}from'./sevenzip-aes-ui-fixture.mjs';
async function setup(t,api){const dom=makeDom();t.after(()=>dom.restore());const dispose=await render(dom.root,api);t.after(dispose);return{...dom,dispose};}
test('actual staged component captures 7Z password/header choices, preserves compression level and clears private fields after success',async t=>{const password=randomBytes(24).toString('base64url'),calls=[],d=await setup(t,async(action,input)=>{calls.push({action,input});return{path:input.output,format:'sevenzip',entries:2,originalBytes:10,bytes:300,encrypted:true};});d.field('Archive format').value='sevenzip';await d.field('Archive format').emit('change');d.field('Compression').value='deflate';await d.field('Compression').emit('change');d.field('Compression level (0â€“9)').value='9';d.field('Encrypt 7Z contents with AES-256').checked=true;await d.field('Encrypt 7Z contents with AES-256').emit('change');assert.equal(d.field('Compression level (0â€“9)').value,'9');const p=d.field('7Z creation password (1â€“128 UTF16 units)');assert.equal(p.disabled,false);p.value=password;d.field('Encrypt 7Z names and header metadata').checked=true;await d.button('Create archive').click();assert.equal(calls.length,1);assert.equal(calls[0].input.password,password);assert.equal(calls[0].input.encryptHeaders,true);assert.equal(p.value,'');assert(d.root.textContent.includes('AES-256'));assert.equal(d.root.getAttribute('aria-busy'),'false');});
test('inspection captures even explicit empty read password, displays encrypted metadata and clears it after verification',async t=>{const calls=[],d=await setup(t,async(action,input)=>{calls.push({action,input});return{format:'sevenzip',headerEncrypted:true,entries:[{name:'owned',size:2,method:'lzma2',encrypted:true,solid:false,crc32:'12345678'}]};});d.field('Use a password for this 7Z archive').checked=true;await d.field('Use a password for this 7Z archive').emit('change');await d.button('List and verify every entry').click();assert.equal(calls[0].input.password,'');assert(d.root.textContent.includes('Names and header metadata were encrypted.'));assert(d.root.textContent.includes('AES-256'));assert.equal(d.field('7Z inspection/extraction password').value,'');});
test('held request blocks duplicate operations; disposal clears secrets and suppresses late success publication',async t=>{const wait=deferred(),calls=[],d=await setup(t,async(action,input)=>{calls.push({action,passwordPresent:Object.hasOwn(input,'password')});return wait.promise;});d.field('Use a password for this 7Z archive').checked=true;await d.field('Use a password for this 7Z archive').emit('change');const p=d.field('7Z inspection/extraction password');p.value=randomBytes(24).toString('base64url');const pending=d.button('List and verify every entry').click();assert.equal(d.button('Verify and extract').disabled,true);await d.button('List and verify every entry').click();assert.equal(calls.length,1);d.dispose();assert.equal(p.value,'');const before=d.root.textContent;wait.resolve({format:'sevenzip',entries:[{name:'late-owned',size:1}]});await pending;assert.equal(d.root.textContent,before);assert.equal(d.root.textContent.includes('late-owned'),false);});
test('refused password operation restores usable controls and scrubs fields; late failure after disposal does not publish',async t=>{const wait=deferred(),d=await setup(t,async()=>wait.promise);d.field('Use a password for this 7Z archive').checked=true;await d.field('Use a password for this 7Z archive').emit('change');const p=d.field('7Z inspection/extraction password');p.value=randomBytes(24).toString('base64url');const pending=d.button('List and verify every entry').click();wait.reject(new Error('7z: folder CRC mismatch'));await pending;assert.equal(p.value,'');assert.equal(d.button('List and verify every entry').disabled,false);assert(d.root.textContent.includes('CRC mismatch'));});
