    {
      "id": "grafana.candidate.7619c2e277e9851ad049",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The Grafana Proxy deletes forwarded cookies. Use the **Allowed cookies** field to specify cookies by name that should be forwarded to the data source.",
