    {
      "id": "grafana.candidate.bb2dc8e1d065df9df175",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use private data source connect (PDC) to connect to and query data within a secure network without opening that network to inbound traffic from Grafana Cloud. Refer to [Private data source connect](https://grafana.com/docs/grafana-cloud/connect-externally-hosted/private-data-source-connect/) for more information on how PDC works and [Configure Grafana private data source connect (PDC)](https://grafana.com/docs/grafana-cloud/connect-externally-hosted/private-data-source-connect/configure-pdc/#configure-grafana-private-data-source-connect-pdc) for steps on setting up a PDC connection.",
      "headingPath": [
        "Configure the Elasticsearch data source",
        "Private data source connect (PDC) and Elasticsearch"
      ],
      "source": {
        "path": "docs/sources/datasources/elasticsearch/configure/index.md",
