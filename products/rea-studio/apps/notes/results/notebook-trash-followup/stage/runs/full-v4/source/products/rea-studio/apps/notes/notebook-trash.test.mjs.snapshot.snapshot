import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import {changeNotebookTrash,restoreNoteFromTrash,trashDisplayParent,TRASH_NOTEBOOK_ID} from './notebook-trash.mjs';
import {folderRecord,ensureOrganization,CONFLICT_NOTEBOOK_ID} from './notebooks.mjs';
import {originalTrash} from './notebook-trash-original-oracle.mjs';
import {handle} from './server.mjs';
import {readJex} from './jex.mjs';
const id=n=>n.toString(16).padStart(32,'0'),before='2020-01-01T00:00:00.000Z',now='2026-10-12T00:00:00.000Z',ms=Date.parse(now),observations=[];
function fixture(){const s={schema:2,organization:{revision:7},records:{},notes:{},resources:{}};for(const [n,parent]of [[1,0],[2,1],[3,2],[4,0],[5,1]]){const r=folderRecord(id(n),'Folder '+n,before,parent?id(parent):'');r.props.deleted_time='0';r.props.icon='retained';r.props.application_data='{"unknown":true}';s.records[id(n)]=r;}for(const [n,parent,deleted,isConflict]of [[10,1,0,0],[11,2,0,0],[12,2,99,0],[13,3,0,0],[14,4,0,0],[15,2,0,1],[16,5,0,0]]){const deletedAt=deleted?new Date(deleted).toISOString():null;s.notes[id(n)]={id:id(n),title:'Note '+n,body:'Unknown metadata and links :/'+id(14),tags:['retained'],notebookId:id(parent),notebook:'',createdAt:before,updatedAt:before,revision:3,deletedAt,history:[],joplin:{type:1,title:'Note '+n,body:'Unknown metadata and links :/'+id(14),props:{id:id(n),parent_id:id(parent),updated_time:before,user_updated_time:before,deleted_time:String(deleted),is_conflict:String(isConflict),author:'retained',application_data:'{"custom":42}',type_:'1'}}};}s.records[id(3)].props.deleted_time='71';return ensureOrganization(s);}
function native(s){const numeric=r=>{const out={...r.props,title:r.title};for(const key of ['created_time','updated_time','user_created_time','user_updated_time'])if(out[key])out[key]=Date.parse(out[key]);out.deleted_time=Number(out.deleted_time??0);out.is_conflict=Number(out.is_conflict??0);return out;};return{folders:Object.values(s.records).filter(r=>r.type===2).map(numeric),notes:Object.values(s.notes).map(n=>({...numeric(n.joplin),parent_id:n.notebookId,deleted_time:n.deletedAt?Date.parse(n.deletedAt):0,updated_time:Date.parse(n.updatedAt),user_updated_time:Date.parse(n.userUpdatedAt??n.joplin.props.user_updated_time)}))};}
function compare(s,oracle){const rows=native(s);for(const [collection,map]of [[rows.folders,oracle.folderRows],[rows.notes,oracle.noteRows]])for(const row of collection){const original=map.get(row.id);for(const key of ['parent_id','deleted_time','updated_time','user_updated_time','application_data'])assert.equal(row[key],original[key],row.id+' '+key);}return rows.folders.length+rows.notes.length;}
test('released recursive folder/note trash matches native final metadata, including prior trash and conflicts',async()=>{const s=fixture(),old=JSON.stringify(s),oracle=await originalTrash({...native(s),time:ms});await oracle.Folder.batchDelete([id(1)],{toTrash:true});const result=changeNotebookTrash(s,{action:'notebook-trash',id:id(1),revision:7,confirmed:true},now);assert.equal(JSON.stringify(s),old);assert.equal(compare(result.state,oracle),12);assert.equal(result.state.notes[id(12)].deletedAt,s.notes[id(12)].deletedAt);assert.equal(result.state.notes[id(15)].deletedAt,null);assert.equal(result.state.records[id(3)].props.deleted_time,String(ms));assert.deepEqual(result.state.notes[id(14)],s.notes[id(14)]);assert.equal(result.state.notes[id(11)].revision,4);assert.equal(result.state.organization.revision,8);observations.push({contract:'recursive trash',originalTopLevelExecutions:1,matchedItemProjections:12,bindings:oracle.bindings,scope:oracle.scope,originalCalls:oracle.calls});});
test('released notebook restore restores independently trashed notes and deleted descendants with user times retained',async()=>{const s=changeNotebookTrash(fixture(),{action:'notebook-trash',id:id(1),revision:7,confirmed:true},now).state,time='2026-10-12T01:00:00.000Z',oracle=await originalTrash({...native(s),time:Date.parse(time)});await oracle.restoreItems(2,[id(1)]);const result=changeNotebookTrash(s,{action:'notebook-restore',id:id(1),revision:8,confirmed:true},time);assert.equal(compare(result.state,oracle),12);assert.equal(result.state.notes[id(12)].deletedAt,null);assert.equal(result.state.notes[id(15)].revision,s.notes[id(15)].revision);assert.equal(result.state.notes[id(11)].userUpdatedAt,before);assert.equal(result.state.records[id(2)].props.user_updated_time,now);observations.push({contract:'recursive restore',originalTopLevelExecutions:1,matchedItemProjections:12,bindings:oracle.bindings,originalCalls:oracle.calls});});
test('released restoring a child under a trashed parent detaches only the child subtree to root',async()=>{const s=changeNotebookTrash(fixture(),{action:'notebook-trash',id:id(1),revision:7,confirmed:true},now).state,time='2026-10-12T02:00:00.000Z',oracle=await originalTrash({...native(s),time:Date.parse(time)});await oracle.restoreItems(2,[id(2)]);const result=changeNotebookTrash(s,{action:'notebook-restore',id:id(2),revision:8,confirmed:true},time);assert.equal(compare(result.state,oracle),12);assert.equal(result.state.records[id(2)].props.parent_id,'');assert.equal(result.state.records[id(1)].props.deleted_time,String(ms));assert.equal(result.state.notes[id(11)].notebook,'Folder 2');assert.equal(result.state.notes[id(13)].notebook,'Folder 2 / Folder 3');observations.push({contract:'restore child under trashed parent',originalTopLevelExecutions:1,matchedItemProjections:12,bindings:oracle.bindings});});
test('released active child under trashed root leaves that active child notes untouched but restores trashed grandchild',async()=>{const s=fixture();s.records[id(1)].props.deleted_time='98';s.notes[id(11)].deletedAt=new Date(88).toISOString();const oracle=await originalTrash({...native(s),time:ms});await oracle.restoreItems(2,[id(1)]);const result=changeNotebookTrash(s,{action:'notebook-restore',id:id(1),revision:7,confirmed:true},now);assert.equal(compare(result.state,oracle),12);assert.equal(result.state.notes[id(11)].deletedAt,s.notes[id(11)].deletedAt);assert.equal(result.state.records[id(3)].props.deleted_time,'0');observations.push({contract:'mixed active/deleted descendants',originalTopLevelExecutions:1,matchedItemProjections:12,bindings:oracle.bindings});});
test('released direct note restore under a trashed parent falls back to unfiled and preserves conflict metadata',async()=>{const s=fixture();s.records[id(2)].props.deleted_time='99';s.notes[id(15)].deletedAt=new Date(97).toISOString();for(const key of [12,15]){const oracle=await originalTrash({...native(s),time:ms});await oracle.restoreItems(1,[id(key)]);const result=restoreNoteFromTrash(s,id(key),now);assert.equal(compare(result.state,oracle),12);assert.equal(result.note.notebookId,'');assert.equal(result.note.notebook,'Imported');assert.equal(result.note.userUpdatedAt,before);assert.equal(result.note.joplin.props.is_conflict,s.notes[id(key)].joplin.props.is_conflict);observations.push({contract:'direct restore '+key,originalTopLevelExecutions:1,matchedItemProjections:12,bindings:oracle.bindings});}});
test('released display parent helper matches virtual trash projection for six parent states',async()=>{const s=fixture(),oracle=await originalTrash({...native(s),time:ms});let comparisons=0;for(const deleted of [0,1])for(const parent of [null,{type:2,props:{id:id(1),deleted_time:'0'}},{type:2,props:{id:id(1),deleted_time:'1'}}]){const record={type:2,props:{id:id(2),parent_id:id(1),deleted_time:String(deleted)}};assert.equal(trashDisplayParent(record,parent),oracle.getDisplayParentId({parent_id:id(1),deleted_time:deleted},parent?{deleted_time:Number(parent.props.deleted_time)}:null));comparisons++;}assert.equal(TRASH_NOTEBOOK_ID,'de1e7ede1e7ede1e7ede1e7ede1e7ede');observations.push({contract:'virtual trash display',originalTopLevelExecutions:comparisons,comparisons,bindings:oracle.bindings});});
test('trash and restore refuse unconfirmed stale missing shared reserved cyclic and excessive states without source mutation',()=>{for(const configure of [s=>{},s=>{s.records[id(2)].props.share_id='shared';},s=>{s.notes[id(11)].joplin.props.share_id='shared';},s=>{s.records[id(1)].props.parent_id=id(2);},s=>{s.records[id(2)].props.deleted_time='garbage';}]){const s=fixture();configure(s);const beforeBytes=JSON.stringify(s);const params={action:'notebook-trash',id:id(1),revision:7,confirmed:true};if(configure.toString()==='s=>{}'){for(const bad of [{confirmed:false},{revision:6},{id:id(99)},{id:TRASH_NOTEBOOK_ID},{id:CONFLICT_NOTEBOOK_ID}])assert.throws(()=>changeNotebookTrash(s,{...params,...bad},now));}else assert.throws(()=>changeNotebookTrash(s,params,now));assert.equal(JSON.stringify(s),beforeBytes);}const many=fixture();for(let n=100;n<1101;n++)many.notes[id(n)]={...structuredClone(many.notes[id(10)]),id:id(n)};assert.throws(()=>changeNotebookTrash(many,{action:'notebook-trash',id:id(1),revision:7,confirmed:true},now),/1,000/);});
function memory(s){let saved=structuredClone(s);const store={get:async(k,f)=>k==='notes-state-v2'?structuredClone(saved):f,set:async(k,v)=>{saved=structuredClone(v);},list:async()=>[]};return{store,read:()=>structuredClone(saved),call:(action,input={})=>handle({action,input,store})};}
test('single failed state commit leaves entire cascade unchanged; held commits serialize stale organization and note writers',async()=>{const {store,read,call}=memory(fixture()),old=JSON.stringify(read()),set=store.set;store.set=async()=>{throw new Error('owned failed single commit');};await assert.rejects(call('notebook-trash',{id:id(1),revision:7,confirmed:true}),/failed single commit/);assert.equal(JSON.stringify(read()),old);let release,started;const held=new Promise(resolve=>{release=resolve;}),opened=new Promise(resolve=>{started=resolve;});store.set=async(k,v)=>{started();await held;return set(k,v);};const trash=call('notebook-trash',{id:id(1),revision:7,confirmed:true});await opened;const stale=call('notebook-rename',{id:id(1),revision:7,title:'Loser'});release();await trash;await assert.rejects(stale,/changed/);store.set=set;await assert.rejects(call('save',{...fixture().notes[id(11)],body:'stale edit'}),/Restore|changed/);assert.equal(read().records[id(1)].title,'Folder 1');assert.equal(read().notes[id(11)].body,fixture().notes[id(11)].body);});
test('actual server JEX preserves IDs unknown metadata and tag relations through notebook trash/restore',async()=>{const bytes=await fs.readFile(new URL('./fixtures/pinned-joplin.jex',import.meta.url)),{call}=memory({notes:{},records:{},resources:{}}); // Metadata comparison uses a resource-free derived ordinary fixture.
 const parsed=readJex(bytes);const {serializeRecord,writeTar}=await import('./jex.mjs');const records=[...parsed.records.values()].filter(r=>r.type!==4);for(const r of records)if(r.type===1)r.body=r.body.replace(/:\/[a-f0-9]{32}/g,':/44444444444444444444444444444444');await call('jex-import',{base64:writeTar(new Map(records.map(r=>[r.props.id+'.md',serializeRecord(r)]))).toString('base64')});const exported=async()=>readJex(Buffer.from((await call('jex-export',{includeTrash:true})).base64,'base64')),before=await exported();let tree=await call('notebook-list');tree=await call('notebook-trash',{id:'1'.repeat(32),revision:tree.revision,confirmed:true});assert.equal(tree.changedNotes.length,2);const trashed=await exported();assert.equal(Number(trashed.records.get('3'.repeat(32)).props.deleted_time)>0,true);assert.equal(trashed.records.get('3'.repeat(32)).props.user_updated_time,before.records.get('3'.repeat(32)).props.user_updated_time);assert.deepEqual(trashed.records.get('7'.repeat(32)),before.records.get('7'.repeat(32)));tree=await call('notebook-restore',{id:'1'.repeat(32),revision:tree.revision,confirmed:true});const restored=await exported();assert.equal(restored.records.get('3'.repeat(32)).props.deleted_time,'0');assert.equal(restored.records.get('1'.repeat(32)).props.parent_id,'');assert.equal(restored.records.get('1'.repeat(32)).props.icon,before.records.get('1'.repeat(32)).props.icon);assert.equal((await call('list')).total,2);});
test('actual server single note trash preserves user time and export matches released Note.batchDelete',async()=>{const initial=fixture(),f=memory(initial),deleted=await f.call('delete',{id:id(10),revision:3}),oracle=await originalTrash({...native(initial),time:Date.parse(deleted.updatedAt)});await oracle.Note.batchDelete([id(10)],{toTrash:true});const exported=readJex(Buffer.from((await f.call('jex-export',{includeTrash:true})).base64,'base64')); // Fixture has no binary resources or note-tag raw records.
 const row=exported.records.get(id(10)),original=oracle.noteRows.get(id(10));assert.equal(row.props.parent_id,original.parent_id);assert.equal(Number(row.props.deleted_time),original.deleted_time);assert.equal(Date.parse(row.props.updated_time),original.updated_time);assert.equal(Date.parse(row.props.user_updated_time),original.user_updated_time);assert.equal(row.props.application_data,original.application_data);observations.push({contract:'single note trash',originalTopLevelExecutions:1,matchedItemProjections:1,bindings:oracle.bindings});assert.throws(()=>restoreNoteFromTrash(f.read(),id(10),'invalid date'),/timestamp/);});
test.after(async()=>{const root=new URL('../../../../.local/observations/',import.meta.url);await fs.mkdir(root,{recursive:true});await fs.writeFile(new URL('trash-original.json',root),JSON.stringify(observations,null,2)+'\n');console.log(JSON.stringify({notebookTrashOriginal:{topLevelOriginalExecutions:observations.reduce((n,r)=>n+r.originalTopLevelExecutions,0),matchedItemProjections:observations.reduce((n,r)=>n+(r.matchedItemProjections??0),0),displayComparisons:6,helperFixtureCases:observations.length,fullApplicationExecutions:0}}));});
