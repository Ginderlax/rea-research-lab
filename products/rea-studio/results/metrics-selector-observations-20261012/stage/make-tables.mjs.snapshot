import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';
const here=path.dirname(fileURLToPath(import.meta.url)),summary=JSON.parse(await fs.readFile(path.join(here,'recomputed-summary.json'))),roles=['original','baseline','candidate'],number=value=>Number(value.toPrecision(7)).toString();
const timing=['case,implementation,samples,median_ms,min_ms,max_ms'];for(const row of summary.timingSummary)for(const role of roles){const item=row.millisecondsPerCall[role];timing.push([row.caseName,role,item.samples,item.median,item.min,item.max].join(','));}
await fs.writeFile(path.join(here,'timing-summary.csv'),timing.join('\n')+'\n',{flag:'wx'});
const memory=['case,implementation,metric,samples,median_bytes,min_bytes,max_bytes'];for(const row of summary.memorySummary)for(const role of roles)for(const [metric,item]of Object.entries(row.metricsByImplementation[role]))memory.push([row.caseName,role,metric,item.samples,item.median,item.min,item.max].join(','));
await fs.writeFile(path.join(here,'memory-summary.csv'),memory.join('\n')+'\n',{flag:'wx'});
const paired=['kind,case,reference,metric,samples,median,min,max,observed_ranges_overlap'];for(const row of summary.timingSummary)for(const reference of ['baseline','original']){const item=row.candidateComparedWith[reference];paired.push(['timing',row.caseName,reference,'paired_ratio_percent',item.pairedRatioPercent.samples,item.pairedRatioPercent.median,item.pairedRatioPercent.min,item.pairedRatioPercent.max,item.observedRanges.overlap].join(','));}
for(const row of summary.memorySummary)for(const reference of ['baseline','original'])for(const [metric,item]of Object.entries(row.candidateComparedWith[reference]))paired.push(['memory',row.caseName,reference,metric,item.pairedDifferenceBytes.samples,item.pairedDifferenceBytes.median,item.pairedDifferenceBytes.min,item.pairedDifferenceBytes.max,item.observedRanges.overlap].join(','));
await fs.writeFile(path.join(here,'paired-differences.csv'),paired.join('\n')+'\n',{flag:'wx'});
const lines=['The candidate remains unintegrated. Fixed fallback p95 regresses against baseline, and the remaining standard/multi-selection medians do not establish a whole-candidate nonregression result. Values below come from independently authenticated raw child records, with seven repetitions per implementation/workload. Ranges are observed minima/maxima, not confidence intervals.','', '| Workload | Original ms/call median [range] | Baseline median [range] | Candidate median [range] | Candidate vs baseline median | Ranges overlap? |','|---|---:|---:|---:|---:|---|'];
for(const row of summary.timingSummary){const display=role=>{const item=row.millisecondsPerCall[role];return number(item.median)+' ['+number(item.min)+', '+number(item.max)+']';};lines.push('| '+[row.caseName,display('original'),display('baseline'),display('candidate'),number(row.candidateComparedWith.baseline.medianRatioPercent)+'%',String(row.candidateComparedWith.baseline.observedRanges.overlap)].join(' | ')+' |');}
lines.push('','A positive timing percentage means slower. Both median ratios and per-repetition paired differences are preserved in recomputed-summary.json and paired-differences.csv. Original comparisons are separate from baseline comparisons. The substantial all-percentile/all-calculation advantage over original already belongs to baseline; it is not a new benefit established for this selector candidate.','', '| Workload | Original lifetime peak RSS MiB median [range] | Baseline median [range] | Candidate median [range] | Candidate minus baseline retained heap bytes median [paired range] |','|---|---:|---:|---:|---:|');
for(const row of summary.memorySummary){const display=role=>{const item=row.metricsByImplementation[role].lifetimePeakRSSBytes;return number(item.median/1048576)+' ['+number(item.min/1048576)+', '+number(item.max/1048576)+']';},delta=row.candidateComparedWith.baseline['retained-heapUsed-signedBytes'].pairedDifferenceBytes;lines.push('| '+[row.caseName,display('original'),display('baseline'),display('candidate'),number(delta.median)+' ['+number(delta.min)+', '+number(delta.max)+']'].join(' | ')+' |');}
lines.push('','Lifetime RSS is a complete-child high-water mark; independently polled RSS and checkpoint RSS are separate metrics in the JSON/CSV files. Initialization, retention and release deltas, paired reference differences and all negative values are retained without clipping. In all-calculations, released heap deltas include negative observations for baseline and candidate. These deltas include GC and the common post-retention serializer/cache validation pressure; they are not cumulative allocation or leak measurements.','', 'Timing controller duration was 100.064 seconds against the prospective 3–5 minute reservation. Isolated-memory duration was 264.904 seconds against the 10–15 minute reservation. These are scheduling durations, separate from measured per-call loops. Root/agents paused throughout each explicitly authorized window; unrelated Windows activity was uncontrolled. No machine-level isolation or universal performance claim is made.');
await fs.writeFile(path.join(here,'TABLES.md'),lines.join('\n')+'\n',{flag:'wx'});
console.log(JSON.stringify({timingRows:21,memoryRows:memory.length-1,pairedRows:paired.length-1,signedValuesUnclipped:true}));
