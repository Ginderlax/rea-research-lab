      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.aae8706989571da15a46",
      "syntaxRole": "list-item",
      "sourceText": "- The Terraform builtin_role_assignment resource is going away.",
      "headingPath": [
        "What's new in Grafana v9.0",
        "Breaking changes",
        "Role-based access control: changes for general release"
      ],
      "source": {
