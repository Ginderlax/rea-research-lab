    },
    {
      "id": "grafana.candidate.2ef0fd70613e10753fda",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To try out Simplified Alert Notification Routing enable the `alertingSimplifiedRouting` feature toggle.",
      "headingPath": [
        "What’s new in Grafana v10.4",
        "Alerting",
        "Simplified Alert Notification Routing"
      ],
      "source": {
