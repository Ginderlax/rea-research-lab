    {
      "id": "grafana.candidate.2b2f4a70b33ba01442f8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can configure the plugin to use a different browser binary instead of the pre-packaged version of Chromium.",
