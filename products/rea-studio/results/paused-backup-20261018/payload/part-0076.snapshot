    {
      "id": "grafana.candidate.fe750e5d017790a46d95",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Before you can request data from Google Cloud Monitoring, you must configure authentication. All requests to Google APIs are performed on the server-side by the Grafana backend.",
      "headingPath": [
