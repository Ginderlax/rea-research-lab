import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import os from 'node:os';
import path from 'node:path';
import {createServer} from 'node:http';
import {once} from 'node:events';
import {preflight,importWorkflow,exportWorkflow,executeNode,createExecution,advanceExecution,validateExecution,LIMITS,NativeError} from './candidate/native.mjs';
import {handleNative,disposeNative} from './candidate/native-server.mjs';
import {nativeRoutingExample} from './candidate/native-example.mjs';

export const node=(type,name,parameters={},position=[0,0])=>({id:name,name,type:'n8n-nodes-base.'+type,typeVersion:{manualTrigger:1,set:3.4,if:2.3,httpRequest:4.4,wait:1.1,switch:3.4,merge:3.2}[type],parameters,position});
export const condition=(type,operation,leftValue,rightValue,extra={})=>({options:{caseSensitive:true,typeValidation:'strict',version:3},combinator:'and',conditions:[{leftValue,...(rightValue===undefined?{}:{rightValue}),operator:{type,operation,...extra}}]});
export const merge=(parameters={})=>node('merge','Merge',{mode:'append',numberInputs:2,...parameters});
export const item=(json,index=0,input=0)=>({json,pairedItem:{item:index,...(input?{input}:{})}});
const target=(node,index=0)=>({node,type:'main',index});
const workflow=(nodes,connections)=>({name:'Synthetic routing stage',settings:{executionOrder:'v1'},nodes,connections});
const set=(name,value,position=[0,0])=>node('set',name,{mode:'raw',jsonOutput:JSON.stringify(value),includeOtherFields:false,options:{}},position);
const persisted=document=>({...createExecution(document),workflowId:'synthetic',revision:1});
function branchWorkflow(mode='append',wait=.04){
 return workflow([node('manualTrigger','Start'),set('Left',{left:1},[0,0]),set('Right',{right:2},[0,100]),node('wait','Wait',{resume:'timeInterval',amount:wait,unit:'seconds'},[100,100]),merge({mode}),set('Finish',{finished:true})],{Start:{main:[[target('Left'),target('Right')]]},Left:{main:[[target('Merge',0)]]},Right:{main:[[target('Wait')]]},Wait:{main:[[target('Merge',1)]]},Merge:{main:[[target('Finish')]]}});
}
test('Switch supports explicit filter rules, all-match routing, fallbacks and integer expressions without aliasing caller data',async()=>{
 const rules=[{conditions:condition('number','gte','={{ $json.amount }}',1),renameOutput:true,outputKey:'positive'},{conditions:condition('number','gte','={{ $json.amount }}',5)}];
 const n=node('switch','Switch',{mode:'rules',rules:{values:rules},options:{fallbackOutput:'extra',allMatchingOutputs:true}}),input=[{json:{amount:10,details:{safe:true}},pairedItem:{item:77}},{json:{amount:-1}}],before=structuredClone(input),outputs=await executeNode(n,input);
 assert.deepEqual(outputs.map(port=>port.length),[1,1,1]);assert.deepEqual(input,before);assert.deepEqual(outputs[0][0].pairedItem,{item:0});outputs[0][0].json.details.safe=false;assert.equal(outputs[1][0].json.details.safe,true);assert.equal(input[0].json.details.safe,true);
 const index=node('switch','Index',{mode:'expression',numberOutputs:3,output:'={{ $json.port }}'});assert.deepEqual((await executeNode(index,[item({port:2})])).map(port=>port.length),[0,0,1]);await assert.rejects(executeNode(index,[item({port:3})]),/output index/);assert.deepEqual((await executeNode(index,[item({port:'1'})])).map(port=>port.length),[0,1,0]);assert.deepEqual(await executeNode(index,[]),[[]]);
});
test('Merge append, choose-branch and nested position contracts preserve input ordering and caller ownership',async()=>{
 const input=[[item({a:1,nested:{x:1},arr:[1,2]})],[item({b:2,nested:{y:2},arr:[3]},0,1)]],before=structuredClone(input);
 assert.deepEqual(await executeNode(merge(),input[0],{inputs:input}),[[...input[0],...input[1]]]);
 assert.deepEqual(await executeNode(merge({mode:'chooseBranch',chooseBranchMode:'waitForAll',output:'specifiedInput',useDataOfInput:2}),input[0],{inputs:input}),[input[1]]);
 const p=merge({mode:'combine',combineBy:'combineByPosition',options:{clashHandling:{values:{resolveClash:'preferLast',mergeMode:'deepMerge'}}}}),outputs=await executeNode(p,input[0],{inputs:input});assert.deepEqual(outputs[0][0].json,{a:1,b:2,nested:{x:1,y:2},arr:[3,2]});assert.deepEqual(outputs[0][0].pairedItem,[{item:0},{item:0,input:1},{item:0,input:1}]);assert.deepEqual(input,before);outputs[0][0].json.arr[0]=99;assert.deepEqual(input,before);
 const empty=await executeNode(merge({mode:'chooseBranch',chooseBranchMode:'waitForAll',output:'empty'}),input[0],{inputs:input});assert.deepEqual(empty,[[{json:{},pairedItem:[{item:0},{item:0,input:1}]}]]);
});
test('Field Merge correctly handles multiple matches, missing keys, all join types and source tagging',async()=>{
 const inputs=[[item({id:1,a:'A'}),item({id:2,a:'B'},1),item({a:'missing'},2)],[item({id:1,b:'X'},0,1),item({id:1,b:'Y'},1,1),item({id:3,b:'Z'},2,1)]];
 const run=joinMode=>executeNode(merge({mode:'combine',combineBy:'combineByFields',advanced:false,fieldsToMatchString:'id',joinMode,outputDataFrom:'both'}),inputs[0],{inputs});
 assert.deepEqual((await run('keepMatches'))[0].map(item=>item.json),[{id:1,a:'A',b:'X'},{id:1,a:'A',b:'Y'}]);assert.equal((await run('keepEverything'))[0].length,5);
 assert.deepEqual((await run('keepNonMatches'))[0].map(item=>item.json),[{id:2,a:'B',_source:'input1'},{a:'missing',_source:'input1'},{id:3,b:'Z',_source:'input2'}]);assert.equal((await run('enrichInput1'))[0].length,4);assert.equal((await run('enrichInput2'))[0].length,3);
});
test('Cartesian, append, comparison work, deadlines and dangerous-property bounds reject with isolated inputs',async()=>{
 const cart=merge({mode:'combine',combineBy:'combineAll'}),a=Array.from({length:101},(_,i)=>item({i})),inputs=[a,a];await assert.rejects(executeNode(cart,a,{inputs}),/Cartesian/);assert.equal(a.length,101);
 const append=[Array.from({length:5001},()=>item({})),Array.from({length:5000},()=>item({}))];await assert.rejects(executeNode(merge(),append[0],{inputs:append}),/Append/);
 const fields=merge({mode:'combine',combineBy:'combineByFields',advanced:false,fieldsToMatchString:'i',joinMode:'keepMatches',outputDataFrom:'both'}),big=Array.from({length:1001},(_,i)=>item({i}));await assert.rejects(executeNode(fields,big,{inputs:[big,big]}),/comparison/);
 await assert.rejects(executeNode(cart,[item({})],{inputs:[[item({})],[item({})]],deadline:performance.now()-1}),/deadline/);
 const unsafe=item(JSON.parse('{"__proto__":{"polluted":true}}'));await assert.rejects(executeNode(cart,[unsafe],{inputs:[[unsafe],[item({})]]}),/Dangerous/);assert.equal({}.polluted,undefined);assert.equal(Object.hasOwn(unsafe.json,'__proto__'),true);
 const abort=new AbortController();abort.abort(new NativeError('cancelled','NATIVE_CANCELLED'));await assert.rejects(executeNode(cart,[item({})],{inputs:[[item({})],[item({})]],signal:abort.signal}),error=>error.code==='NATIVE_CANCELLED');
});

test('Switch fan-out allocation, aggregate item count and condition work are bounded before branch cloning',async()=>{
 const rule={conditions:condition('number','gte',1,0)},n=node('switch','Switch',{mode:'rules',rules:{values:Array.from({length:100},()=>structuredClone(rule))},options:{allMatchingOutputs:true}}),large=[item({value:'x'.repeat(90000)})];await assert.rejects(executeNode(n,large),/Switch output exceeds/);assert.equal(large[0].json.value.length,90000);
 await assert.rejects(executeNode(n,Array.from({length:101},()=>item({}))),/aggregate output items/);
 const conditions={options:{caseSensitive:true,typeValidation:'strict',version:3},combinator:'or',conditions:Array.from({length:100},()=>({leftValue:1,rightValue:2,operator:{type:'number',operation:'equals'}}))};const heavy=node('switch','Heavy',{mode:'rules',rules:{values:Array.from({length:100},()=>({conditions:structuredClone(conditions)}))},options:{}});await assert.rejects(executeNode(heavy,Array.from({length:101},()=>item({}))),/condition work/);
 await assert.rejects(executeNode(n,[item({})],{deadline:performance.now()-1}),/deadline/);const controller=new AbortController();controller.abort(new NativeError('cancelled','NATIVE_CANCELLED'));await assert.rejects(executeNode(n,[item({})],{signal:controller.signal}),error=>error.code==='NATIVE_CANCELLED');
});
test('whole workflow preflight preserves unknown documents and rejects SQL, wrong ports, cycles and ambiguous fan-in before effects',()=>{
 const document=branchWorkflow(),unknown=node('future','Unknown',{keep:{vendor:[1,2]}});unknown.typeVersion=99;document.nodes.push(unknown);document.meta={keep:true};assert.deepEqual(JSON.parse(exportWorkflow(document)),importWorkflow(document));assert.equal(preflight(document).executable,true);
 for(const mutate of [d=>d.nodes.find(n=>n.type.endsWith('.merge')).parameters.mode='combineBySql',d=>d.connections.Left.main[0][0].index=2,d=>d.connections.Left.main[0].push(target('Merge',0)),d=>d.connections.Finish={main:[[target('Start')]]},d=>d.nodes.find(n=>n.type.endsWith('.merge')).typeVersion=2.1]){const bad=structuredClone(document);mutate(bad);assert.equal(preflight(bad).executable,false);assert.throws(()=>createExecution(bad),/Workflow|Merge|version|port|input|Cycles|SQL|mode/);}
 const switchNode=node('switch','Switch',{mode:'expression',numberOutputs:10000,output:0});assert.equal(preflight(workflow([node('manualTrigger','Start'),switchNode],{Start:{main:[[target('Switch')]]}})).executable,false);
});

test('creation and resume use the same enabled Manual Trigger when a disabled preserved trigger appears first',async()=>{
 const document=branchWorkflow();document.nodes.unshift({...node('manualTrigger','Disabled'),disabled:true});assert.equal(preflight(document).executable,true);const state=persisted(document);assert.equal(state.pending[0].node,'Start');validateExecution(state);await advanceExecution(state);assert.equal(state.status,'waiting');assert.equal(Object.hasOwn(state.outputs,'Disabled'),false);await advanceExecution(state,{now:Date.parse(state.waitUntil)+1});assert.equal(state.status,'completed');assert.equal(state.trace[0].node,'Start');
});

test('staged UI routing example executes its Switch and deferred Wait fan-in with two linked output items',async()=>{
 const document=nativeRoutingExample();assert.equal(preflight(document).executable,true);const state=persisted(document);await advanceExecution(state);assert.equal(state.status,'waiting');assert.equal(state.joins.Merge[0].length,1);await advanceExecution(state,{now:Date.parse(state.waitUntil)+1});assert.equal(state.status,'completed');assert.deepEqual(state.outputs.Finished[0].map(item=>item.json),[{amount:150,finished:true},{amount:150,finished:true}]);assert.deepEqual(state.outputs.Merge[0].map(item=>item.pairedItem),[{item:0},{item:0,input:1}]);
});
test('Merge input queues survive serialized Wait checkpoints and resume exactly once with immediate input links',async()=>{
 const state=persisted(branchWorkflow()),checkpoints=[];await advanceExecution(state,{checkpoint:s=>checkpoints.push(JSON.stringify(s))});assert.equal(state.status,'waiting');assert.equal(state.joins.Merge[0][0].json.left,1);assert.equal(state.joins.Merge[1],null);assert.equal(Object.hasOwn(state.outputs,'Merge'),false);
 const restored=JSON.parse(checkpoints.at(-1));validateExecution(restored);await advanceExecution(restored,{now:Date.parse(restored.waitUntil)+1});assert.equal(restored.status,'completed');assert.deepEqual(restored.outputs.Merge[0].map(item=>item.json),[{left:1},{right:2}]);assert.deepEqual(restored.outputs.Merge[0].map(item=>item.pairedItem),[{item:0},{item:0,input:1}]);assert.equal(restored.trace.filter(step=>step.node==='Merge').length,1);assert.deepEqual(restored.joins,{});const steps=restored.steps;await advanceExecution(restored);assert.equal(restored.steps,steps);
});
test('inactive If branches allow partial append, while Choose Branch requires its first two arrived inputs',async()=>{
 for(const mode of ['append','chooseBranch']){const document=workflow([node('manualTrigger','Start'),node('if','If',{conditions:condition('boolean','true',false,undefined,{singleValue:true}),options:{}}),merge({mode,chooseBranchMode:'waitForAll',output:'specifiedInput',useDataOfInput:2})],{Start:{main:[[target('If')]]},If:{main:[[target('Merge',0)],[target('Merge',1)]]}}),state=persisted(document);await advanceExecution(state);assert.equal(state.status,'completed');if(mode==='append'){assert.equal(state.outputs.Merge[0].length,1);assert.deepEqual(state.outputs.Merge[0][0].pairedItem,{item:0,input:1});}else{assert.equal(Object.hasOwn(state.outputs,'Merge'),false);assert.equal(state.joins.Merge[0],null);}}
});
test('durable queue validation rejects unknown ports, unconnected preserved nodes and excessive or conflicting join data',()=>{
 const document=branchWorkflow(),state=persisted(document);document.nodes.push({...node('httpRequest','Disconnected',{url:'http://127.0.0.1:1',options:{timeout:1}}),typeVersion:99});const injected=persisted(document);injected.pending=[{node:'Disconnected',items:[item({})]}];assert.throws(()=>validateExecution(injected),/persisted invocation/);
 for(const mutate of [s=>s.joins={Merge:[[],[],[]]},s=>s.joins={Missing:[[],null]},s=>s.joins={Left:[[],null]},s=>{s.joins={Merge:[[],null]};s.outputs.Merge=[[]];},s=>s.pending=[{node:'Merge',items:[],inputs:[[],null]}],s=>s.joins={Merge:[null,null]},s=>s.joins={Merge:[[item({a:1})],[item({b:2})]]},s=>{s.pending=[{node:'Merge',items:[],inputs:[[item({a:1})],[]]}];s.joins={Merge:[[item({a:1})],null]};},s=>s.pending.push(structuredClone(s.pending[0])),s=>{s.outputs.Start=[[item({})]];},s=>{s.outputs.Wait=[[item({})]];s.waitingRoute='Wait';}]){const bad=structuredClone(state);mutate(bad);assert.throws(()=>validateExecution(bad),/persisted|Persisted/);}
});
test('app JSON persistence retains partial joins across HTTP host restart and cancellation prevents the joined effect',async t=>{
 const directory=await fs.mkdtemp(path.join(os.tmpdir(),'rea-routing-stage-')),data=path.join(directory,'store.json');
 t.after(()=>{const resolved=path.resolve(directory);assert.equal(path.dirname(resolved),path.resolve(os.tmpdir()));assert.ok(path.basename(resolved).startsWith('rea-routing-stage-'));return fs.rm(resolved,{recursive:true,force:true});});
 let values={};const store={async get(key,fallback=null){return structuredClone(Object.hasOwn(values,key)?values[key]:fallback);},async set(key,value){Object.defineProperty(values,key,{value:structuredClone(value),enumerable:true,writable:true,configurable:true});await fs.writeFile(data,JSON.stringify(values));}};
 async function host(){const workspace={},server=createServer(async(req,res)=>{try{let text='';for await(const part of req)text+=part;const{action,input}=JSON.parse(text);const result=await handleNative({action,input,store,workspace});res.writeHead(200,{'content-type':'application/json'});res.end(JSON.stringify(result));}catch(error){res.writeHead(400,{'content-type':'application/json'});res.end(JSON.stringify({error:error.message}));}});server.listen(0,'127.0.0.1');await once(server,'listening');return{async api(action,input={}){const response=await fetch(`http://127.0.0.1:${server.address().port}`,{method:'POST',body:JSON.stringify({action,input})}),result=await response.json();if(!response.ok)throw new Error(result.error);return result;},async close(){await disposeNative(workspace);server.closeAllConnections();await new Promise(done=>server.close(done));}};}
 let requests=0;const endpoint=createServer((req,res)=>{requests++;res.writeHead(200,{'content-type':'application/json'});res.end('{"synthetic":true}');});endpoint.listen(0,'127.0.0.1');await once(endpoint,'listening');t.after(()=>new Promise(done=>{endpoint.closeAllConnections();endpoint.close(done);}));const document=branchWorkflow('append',.08);document.nodes.push(node('httpRequest','Effect',{url:`http://127.0.0.1:${endpoint.address().port}`,options:{timeout:1000}}));document.connections.Merge={main:[[target('Effect')]]};document.connections.Effect={main:[[target('Finish')]]};
 let current=await host();t.after(()=>current.close());const{record}=await current.api('native-save',{workflow:document}),{run}=await current.api('native-run',{id:record.id});assert.equal(run.status,'waiting');assert.equal(values[`automation.native.run.${run.id}`].joins.Merge[0][0].json.left,1);assert.equal(Object.hasOwn(run,'joins'),false);assert.equal(Object.hasOwn(run,'waitingRoute'),false);assert.equal(requests,0);await current.close();values=JSON.parse(await fs.readFile(data,'utf8'));await new Promise(done=>setTimeout(done,95));current=await host();await current.api('native-list');let ended;for(let i=0;i<100;i++){ended=(await current.api('native-status',{id:record.id,runId:run.id})).run;if(ended.status==='completed')break;await new Promise(done=>setTimeout(done,5));}assert.equal(ended.status,'completed');assert.equal(ended.id,run.id);assert.equal(ended.trace.filter(step=>step.node==='Merge').length,1);assert.equal(requests,2);assert.deepEqual(values[`automation.native.run.${run.id}`].joins,{});
 const another=await current.api('native-run',{id:record.id});assert.equal(another.run.status,'waiting');assert.equal((await current.api('native-cancel',{id:record.id,runId:another.run.id})).run.status,'cancelled');await current.close();values=JSON.parse(await fs.readFile(data,'utf8'));current=await host();await current.api('native-list');await new Promise(done=>setTimeout(done,95));assert.equal((await current.api('native-status',{id:record.id,runId:another.run.id})).run.status,'cancelled');assert.equal((await current.api('native-history',{id:record.id})).runs.find(r=>r.id===another.run.id).status,'cancelled');assert.equal(requests,2);const history=await current.api('native-history',{id:record.id});assert.ok(history.runs.every(run=>!Object.hasOwn(run,'joins')&&!Object.hasOwn(run,'waitingRoute')));
});

test('HTTP recovery rejects an injected unreachable preserved node before scheduling any downstream effect',async t=>{
 let effects=0;const endpoint=createServer((req,res)=>{effects++;res.end('{}');});endpoint.listen(0,'127.0.0.1');await once(endpoint,'listening');t.after(()=>new Promise(done=>{endpoint.closeAllConnections();endpoint.close(done);}));
 const document=branchWorkflow();document.nodes.push({...node('httpRequest','Disconnected',{url:`http://127.0.0.1:${endpoint.address().port}`,options:{timeout:1000}}),typeVersion:99});const state=persisted(document);state.status='waiting';state.waitUntil=new Date().toISOString();state.pending=[{node:'Disconnected',items:[item({})]}];const values={'automation.native.jobs':[state.id],[`automation.native.run.${state.id}`]:JSON.parse(JSON.stringify(state))},workspace={},store={async get(key,fallback=null){return structuredClone(Object.hasOwn(values,key)?values[key]:fallback);},async set(key,value){values[key]=structuredClone(value);}};
 const server=createServer(async(req,res)=>{try{const result=await handleNative({action:'native-list',store,workspace});res.writeHead(200,{'content-type':'application/json'});res.end(JSON.stringify(result));}catch(error){res.writeHead(400,{'content-type':'application/json'});res.end(JSON.stringify({error:error.message}));}});server.listen(0,'127.0.0.1');await once(server,'listening');t.after(async()=>{await disposeNative(workspace);server.closeAllConnections();await new Promise(done=>server.close(done));});
 const response=await fetch(`http://127.0.0.1:${server.address().port}`);assert.equal(response.status,400);assert.match((await response.json()).error,/persisted invocation/);await new Promise(done=>setTimeout(done,30));assert.equal(effects,0);assert.equal(values[`automation.native.run.${state.id}`].status,'waiting');
});
