import test from 'node:test';import assert from 'node:assert/strict';import {render} from './client.mjs';import {handle,dispose} from './server.mjs';import {temp,pass} from './harness.mjs';
class Element{
 constructor(tag){this.tagName=tag;this.children=[];this.listeners=new Map();this.value='';this.checked=false;this.ownText='';this.parentElement=null;this.disabled=false}
 set textContent(value){this.ownText=String(value);for(const c of this.children)c.parentElement=null;this.children=[]}get textContent(){return this.ownText+this.children.map(c=>c.textContent).join('')}
 append(...items){for(const c of items){if(c.parentElement)c.parentElement.children=c.parentElement.children.filter(x=>x!==c);c.parentElement=this;this.children.push(c)}}
 replaceChildren(...items){for(const c of this.children)c.parentElement=null;this.children=[];this.ownText='';this.append(...items)}
 addEventListener(name,fn){this.listeners.set(name,fn)}async click(){if(!this.disabled)return this.listeners.get('click')?.()}
}
const descendants=root=>[root,...root.children.flatMap(descendants)];
function button(root,name){const result=descendants(root).find(e=>e.tagName==='button'&&e.textContent===name);assert.ok(result,'Button '+name);return result}
function input(root,label){const wrapper=descendants(root).find(e=>e.tagName==='label'&&e.ownText===label);assert.ok(wrapper,'Input '+label);return wrapper.children[0]}
async function fixture(t){globalThis.document={createElement:tag=>new Element(tag)};t.after(()=>delete globalThis.document);const workspace={root:await temp(t)},store={value:null,async get(){return structuredClone(this.value)},async set(k,v){this.value=structuredClone(v)}};t.after(()=>dispose(workspace));const api=(action,input={})=>handle({action,input,store,workspace});await api('create',{password:pass});const saved=await api('save',{title:'UI synthetic',password:'first synthetic password',notes:'first private notes',group:''});const old=(await api('read',{id:saved.id})).entry;await api('save',{...old,password:'second synthetic password'});return {api,id:saved.id,root:new Element('main')}}
test('staged DOM interaction lists redacted history, explicitly views masked secret and confirms restoration',async t=>{
 const {root,api,id}=await fixture(t);await render(root,api);await button(root,'Open entry').click();await button(root,'Show entry history').click();assert.ok(root.textContent.includes('Previous versions'));assert.equal(descendants(root).some(e=>e.value==='first synthetic password'),false);await button(root,'View this version').click();const prior=input(root,'Previous password');assert.equal(prior.value,'first synthetic password');assert.equal(prior.type,'password');assert.equal(prior.readOnly,true);await button(root,'Show / hide previous password').click();assert.equal(prior.type,'text');await button(root,'Restore this version').click();assert.equal((await api('read',{id})).entry.password,'second synthetic password');assert.ok(root.textContent.includes('explicit confirmation'));
 input(root,'Confirm restoring this version and saving the current version in history').checked=true;await button(root,'Restore this version').click();assert.equal((await api('read',{id})).entry.password,'first synthetic password');assert.equal((await api('historyList',{id})).revisions.length,2);assert.equal(input(root,'Password').value,'first synthetic password');await button(root,'Lock now').click();assert.equal(descendants(root).some(e=>e.value==='first synthetic password'),false);assert.ok(root.textContent.includes('Unlock your vault'));
});
test('history result arriving after selecting New entry cannot populate a stale editor',async t=>{
 const {root,api}=await fixture(t);let release,held;const transport=async(action,input)=>{if(action==='historyList'){const result=await api(action,input);held=true;return new Promise(r=>release=()=>r(result))}return api(action,input)};await render(root,transport);await button(root,'Open entry').click();const pending=button(root,'Show entry history').click();while(!held)await new Promise(r=>setImmediate(r));await button(root,'New entry').click();release();await pending;assert.equal(root.textContent.includes('Previous versions'),false);assert.equal(input(root,'Title').value,'');assert.equal(input(root,'Password').value,'');await button(root,'Lock now').click();
});
