    {
      "id": "grafana.candidate.b3cba60baa6b2c102b59",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Before you can use any Azure Entra ID authentication method, you must enable Azure authentication in the Grafana server configuration. Add the following to your `grafana.ini` or `custom.ini` file:",
      "headingPath": [
        "Configure the Microsoft SQL Server data source",
        "Configure the data source in the UI",
        "Azure Entra ID (formerly Azure AD) Authentication",
        "Required server configuration"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/configure/index.md",
        "gitBlobSha": "468ac6d022bd91271e046308509eabab23316d3c",
        "sha256": "78f3473345c7acf1680b5e482fdc29c61c6d73576e857090bae5239629ed0887",
        "lineStart": 258,
        "lineEnd": 258,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/mssql/configure/index.md#L258-L258"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
