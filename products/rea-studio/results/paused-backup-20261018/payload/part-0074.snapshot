    {
      "id": "grafana.candidate.62a98654c75a490c5fde",
      "syntaxRole": "list-item",
      "sourceText": "- For metrics: `{job=\"api-server\", region=\"europe\"}` filters metric data points matching `job=\"api-server\"` and `region=\"europe\"`.",
