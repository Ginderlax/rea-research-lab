        "lineStart": 67,
        "lineEnd": 67,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/aws-cloudwatch/query-editor/index.md#L67-L67"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.fa82a3ce3b4e53a87931",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Both the Metric Search and Metric Insights query types provide two editing modes. Use the **Builder** and **Code** toggle in the query editor to switch between them.",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Use Builder and Code modes"
      ],
