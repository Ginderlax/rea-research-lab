const readJson = path => JSON.parse(readFileSync(path, 'utf8').replace(/^\uFEFF/, ''));
const audit = readJson(join(root, 'metadata/backup-audit.json'));
const runtime = readJson(join(root, 'metadata/runtime-verification.json'));
const submodules = readJson(join(root, 'metadata/submodules.json'));
const repo = readJson(join(root, 'metadata/repository.json'));
const manifest = {
  snapshot_date_local: '2026-10-12',
  timezone: 'America/New_York',
  finalized_at_utc: new Date().toISOString(),
  repository_url: 'https://github.com/morluto/rea',
  main_commit: audit.main_commit,
  git_mirror_created_at_utc: statSync(join(root, 'rea.git')).birthtime.toISOString(),
  default_branch: repo.default_branch,
  snapshot_semantics: 'Dated complete advertised-ref snapshot, retained without following later upstream changes.',
  main_git: audit.mirror,
  main_bundle_sha256: audit.main_bundle_sha256,
  main_offline_restore: audit.offline_restore,
  published_package: { name: 'rea-agents', version: '6.4.0', integrity_verified: 'npm SHA-512', preserved_tarball: 'packages/rea-agents-6.4.0.tgz', dependencies_and_cache_preserved: true, offline_ci_verified: true },
  runtime_verification: runtime,
  submodules,
  release_metadata: { releases: 35, attached_assets: 0, complete_api_pagination_verified: true },
  additional_restore_check: { script: 'Restore-Repository.ps1', passed: true, restored_commit: audit.main_commit, integrity_check: 'git fsck --full', github_access_required: false },
  excluded: ['GitHub issues/PR conversations and Discussions', 'GitHub Actions logs/artifacts', 'Unadvertised or already-deleted remote data', 'External analysis engines, commercial licenses, Java, browsers and Android tools', 'Source-build development dependencies'],
  user_configuration: 'No global installation, agent registration, or chat management performed.',
  local_storage: 'This disk; no separate-device or cloud backup created.'
};
writeFileSync(join(root, 'metadata/snapshot-manifest.json'), JSON.stringify(manifest, null, 2));

async function sha256(path) {
  const hash = createHash('sha256');
  for await (const chunk of createReadStream(path)) hash.update(chunk);
  return hash.digest('hex');
}
function pathsIn(directory) {
  const result = [];
  for (const item of readdirSync(directory, { withFileTypes: true })) {
    const path = join(directory, item.name);
    if (item.isSymbolicLink()) throw new Error(`Symbolic link needs explicit preservation handling: ${path}`);
    if (item.isDirectory()) result.push(...pathsIn(path));
    else if (item.isFile()) result.push(path);
  }
  return result;
}
const excludedInventoryFiles = new Set(['checksums.json', 'checksums.sha256']);
const filePaths = pathsIn(root).filter(path => !excludedInventoryFiles.has(relative(root, path).replaceAll('\\', '/'))).sort();
const files = [];
let bytes = 0;
for (const path of filePaths) {
  const size = statSync(path).size;
  files.push({ path: relative(root, path).replaceAll('\\', '/'), bytes: size, sha256: await sha256(path) });
  bytes += size;
}
const inventoryPath = join(root, 'checksums.json');
writeFileSync(inventoryPath, JSON.stringify({ generated_at_utc: new Date().toISOString(), algorithm: 'SHA-256', excluded: [...excludedInventoryFiles], file_count: files.length, total_bytes: bytes, files }, null, 2));
writeFileSync(join(root, 'checksums.sha256'), `${await sha256(inventoryPath)}  checksums.json\n`);
console.log(JSON.stringify({ files: files.length, bytes, gib: (bytes / 1024 ** 3).toFixed(3), inventory_sha256: await sha256(inventoryPath) }));
