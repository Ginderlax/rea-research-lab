    {
      "id": "grafana.candidate.9664622dbc8f66dc3c51",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For a centralized reference of plugin roles and their default permissions, refer to [Grafana Cloud app plugin role definitions](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/administration/roles-and-permissions/access-control/plugin-role-definitions/).",
      "headingPath": [
        "Grafana RBAC permission actions and scopes",
        "Discover plugin actions"
      ],
