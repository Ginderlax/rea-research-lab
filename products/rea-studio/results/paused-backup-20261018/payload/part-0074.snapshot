    {
      "id": "grafana.candidate.96cb5fe88dfe93b24fe5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You cannot modify the `No Basic Role` permissions.",
      "headingPath": [
        "Plan your RBAC rollout strategy",
        "When to modify basic roles or create custom roles"
