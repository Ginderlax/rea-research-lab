    {
      "id": "grafana.candidate.1a4317890798724e7a57",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Open your Grafana configuration file, either `grafana.ini` or `custom.ini`. For file location based on operating system, refer to [Configuration file location](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-grafana/).",
      "headingPath": [
