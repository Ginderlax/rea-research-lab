    {
      "id": "grafana.candidate.2609766b6979a4fd1bea",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Define a query to get the data you want to measure and a condition that needs to be met before an alert rule fires.",
      "headingPath": [
        "Configure Grafana-managed alert rules",
        "Define query and condition"
      ],
      "source": {
        "path": "docs/sources/alerting/alerting-rules/create-grafana-managed-rule.md",
