    {
      "id": "grafana.candidate.b6ff5b9d260e6e360627",
      "syntaxRole": "list-item",
      "sourceText": "- Route `DatasourceError` alerts separately, sending them to different teams or channels depending on their impact and urgency.",
      "headingPath": [
        "Handle connectivity errors in alerts",
        "Handle query errors in Grafana Alerting",
        "Reduce redundant error notifications"
