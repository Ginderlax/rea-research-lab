    {
      "id": "grafana.candidate.7b0716fc11d7a9a71dc3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "How many seconds the OAuth state cookie lives before being deleted. Default is `600` (seconds) Administrators can increase this if they experience OAuth login state mismatch errors.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[auth]`",
        "`oauth_state_cookie_max_age`"
