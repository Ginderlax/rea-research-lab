    },
    {
      "id": "grafana.candidate.53da1549f465d6949f01",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use it as the range in a range aggregation:",
      "headingPath": [
        "Loki template variables",
        "Use the `$__auto` variable for Loki metric queries"
      ],
      "source": {
        "path": "docs/sources/datasources/loki/template-variables/index.md",
        "gitBlobSha": "bb6baccf3a16af879e02b220ff1c17064cb076ad",
        "sha256": "8193ee3d90cd1d5362b211957442b2274d69f01aad93e856b37b83baf82c751e",
        "lineStart": 105,
        "lineEnd": 105,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/loki/template-variables/index.md#L105-L105"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
