// File an already verified hosted artifact in a new work-only public capsule. No product/oracle execution.
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import { createHash } from 'node:crypto';
import { gzipSync, gunzipSync } from 'node:zlib';
const work = import.meta.dirname, lab = path.resolve(work, '../outputs/rea-research-lab');
const stage = path.join(work, 'cloud-vault-empty-bin-first-pass-public-20261016-next'), publicRoot = path.join(stage, 'public-candidate');
const prefix = 'products/rea-studio/results/cloud-vault-empty-bin-first-pass-20261016', target = path.join(publicRoot, prefix);
const run = '38903252563', job = '116980428086', artifactId = '12046583990', head = '1d6fd83d6e40453e6db96420de15baf7eca50fa0';
const digest = '1204af490223abb6b5bc480c3b77cb5dda017f34dd54dc2b65103bc8f4b010e4';
const runFolder = path.join(work, 'cloud-verification-backups/run-' + run), backup = path.join(runFolder, 'artifact-' + artifactId), evidence = path.join(backup, 'readable-evidence');
const sha = bytes => createHash('sha256').update(bytes).digest('hex'), identity = bytes => ({ bytes: bytes.length, sha256: sha(bytes) });
function safe(name) { assert(typeof name === 'string' && name && !/[\\:\x00-\x1f\x7f]/.test(name) && !name.startsWith('/') && name.split('/').every(part => part && part !== '.' && part !== '..')); return name; }
function read(base, name) { safe(name); let file = base; for (const part of name.split('/')) { file = path.join(file, part); assert(!fs.lstatSync(file).isSymbolicLink()); } const stat = fs.lstatSync(file); assert(stat.isFile() && stat.size <= 12 * 1024 * 1024); const bytes = fs.readFileSync(file); assert.equal(bytes.length, stat.size); return bytes; }
assert(!fs.existsSync(stage)); assert(!fs.existsSync(path.join(lab, prefix)));
const verifiedBytes = read(backup, 'local-backup-verification.json'), verified = JSON.parse(verifiedBytes);
assert.equal(verified.schema, 'rea-local-cloud-attempt-backup/v1'); assert.equal(verified.allCRCAndBytesReadable, true); assert.equal(verified.artifactSHA256, digest); assert.equal(verified.files.length, 416); assert.equal(verified.localProductExecutions, 0);
const zip = fs.readFileSync(backup + '.zip'); assert.equal(sha(zip), digest); assert.equal(zip.length, verified.archiveBytes); assert.equal(zip.length, 1627908);
const files = new Map(); for (const row of verified.files) { safe(row.path); assert(!files.has(row.path)); files.set(row.path, row); const stat = fs.lstatSync(path.join(evidence, row.path)); assert(stat.isFile() && !stat.isSymbolicLink()); assert.equal(stat.size, row.bytes); }
function artifact(name) { const bytes = read(evidence, name), row = files.get(name); assert(row); assert.deepEqual(identity(bytes), { bytes: row.bytes, sha256: row.sha256 }); return bytes; }
const attempt = JSON.parse(artifact('attempt-validation.json')); assert.equal(attempt.schema, 'rea-cloud-development-attempt/v1'); assert.equal(attempt.scope, 'vault-empty-bin-experiment'); assert.equal(attempt.status, 'passed'); assert.equal(attempt.phase, 'terminal'); assert.equal(attempt.repositoryCommit, head);
assert.deepEqual(attempt.summary, { tests: 233, pass: 233, fail: 0, cancelled: 0, skipped: 0, todo: 0, duration_ms: 110519.8129 }); assert.deepEqual(attempt.failures, []); assert.equal(attempt.failure, null); assert.equal(attempt.exitCode, 0); assert.equal(attempt.signal, null); assert.equal(attempt.childCloseObserved, true);
assert.equal(attempt.executionEnvironment, 'github-hosted'); assert.equal(attempt.runtime.version, 'v24.16.0'); assert.equal(attempt.runtime.platform, 'win32'); assert.equal(attempt.environment.GITHUB_RUN_ID, run); assert.equal(attempt.environment.GITHUB_SHA, head); assert.equal(attempt.environment.GITHUB_RUN_ATTEMPT, '1');
assert.equal(attempt.sourceFiles, 780); assert.equal(attempt.sourceSnapshotFiles, 358); assert.equal(attempt.sourceStable, true); assert.equal(attempt.sourceCapturedBeforeExecution, true); assert.equal(attempt.selectedTestFiles.length, 45); assert.equal(attempt.output.droppedOutputBytes, 0); assert.equal(attempt.output.retainedOutputTruncated, false);
assert.equal(attempt.historicalReceiptsRebound, false); assert.equal(attempt.historicalDevelopmentReceiptOverwritten, false); assert.equal(attempt.fullFeatureParityEstablished, false); assert.equal(attempt.universalSuperiorityEstablished, false);
const before = artifact('source-before.json'); assert.deepEqual(before, artifact('source-after.json')); const census = JSON.parse(before); assert.equal(census.length, 780);
const snapshots = JSON.parse(artifact('source-snapshot-manifest.json')); assert.equal(snapshots.files.length, 358);
const omitted = [...files.values()].filter(row => row.path.startsWith('source/')).map(row => ({ sourcePath: row.path, bytes: row.bytes, sha256: row.sha256 })); assert.equal(omitted.length, 358);
for (const row of snapshots.files) { const actual = files.get(row.path), active = census.find(entry => entry.path === row.sourcePath); assert(actual && active); assert.equal(row.bytes, actual.bytes); assert.equal(row.sha256, actual.sha256); assert.equal(active.bytes, row.bytes); assert.equal(active.sha256, row.sha256); }
const sidecarBytes = read(backup, 'local-empty-bin-sidecar-verification.json'), sidecars = JSON.parse(sidecarBytes);
const serializationBytes = read(backup, 'local-empty-bin-r7-serialization-verification.json'), serialized = JSON.parse(serializationBytes);
assert.equal(sidecars.allFourComparisonsEstablished, true); assert.equal(sidecars.originalChildAttempts, 4); assert.equal(sidecars.comparisonsPassed, 4); assert.equal(sidecars.recordedActualLibraryCalls, 4); assert.equal(sidecars.recordedActualAssemblyLoads, 4); assert(sidecars.observations.every(row => row.assemblyLoadMarkers === 1 && row.comparisonPassed && row.closeObserved));
assert.equal(serialized.expectedSerializedNamedProjectionExactlyMatchesActualReopened, true); assert.equal(serialized.allOtherNamedProjectionFieldsDeepExact, true); assert.equal(serialized.rawNamedDateFieldsChecked, 28); assert.equal(serialized.rawSubsecondDatesPreserved, 5); assert.equal(serialized.productionInstalled, false);
const originalSummary = JSON.parse(artifact('empty-bin-original-observations/summary.json')); assert.equal(originalSummary.childAttempts, 4); assert.equal(originalSummary.comparisonsPassed, 4); assert.equal(originalSummary.actualAssemblyLoads, 4); assert.equal(originalSummary.actualLibraryCalls, 4);
const children = originalSummary.observations.map(row => JSON.parse(artifact('empty-bin-original-observations/' + row.path))); const native = children.find(row => row.name === 'native-save-reopen'); assert(native);
for (const row of children) { assert.equal(row.status, 'passed'); assert.equal(row.comparisonPassed, true); assert.equal(row.actual.calls.assemblyLoads, 1); assert.equal(row.actual.calls.deleteAllObjects, 1); assert.equal(row.actual.calls.originalClockAssignments, 0); assert.equal(row.originalGUI, 0); assert.equal(row.originalProgram, 0); }
assert.deepEqual(native.serializedReopenContract.expectedReopened, native.actual.reopened); assert.equal(native.serializedReopenContract.rawObservationsRewritten, false); assert.equal(native.actual.inputHeaderVersion, 0x40001); assert.equal(native.actual.outputHeaderVersion, 0x40000);
const compositionBytes = artifact('vault-empty-bin-composition.json'), composition = JSON.parse(compositionBytes), post = JSON.parse(artifact('vault-empty-bin-postrun-source-check.json'));
assert.equal(composition.currentTargets.length, 9); assert.equal(composition.sourceCommit, head); assert.equal(composition.productionInstalled, false); assert.equal(post.status, 'passed'); assert.equal(post.sourceStable, true); assert.equal(post.checkedTargets, 9); assert.equal(post.compositionSHA256, sha(compositionBytes)); assert.deepEqual(post.currentTargets, composition.currentTargets); assert.equal(post.productionInstalled, false);
assert.equal(attempt.vaultEmptyBinOverlay.gitBaselineEligibleActiveFiles, 349); assert.equal(attempt.vaultEmptyBinOverlay.gitBaselineEligibleActiveBytesAuthenticated, true); assert.equal(attempt.vaultEmptyBinOverlay.gitWorkingTreeMatchesOverlayAfter, true);
const workflow = JSON.parse(artifact('vault-empty-bin-workflow-attempt.json')); assert.equal(workflow.runId, run); assert.equal(workflow.sourceCommit, head); assert.equal(workflow.runnerEnvironment, 'github-hosted'); assert.equal(workflow.productionInstalled, false); for (const key of ['checkoutOutcome', 'compositionOutcome', 'bootstrapOutcome', 'testOutcome', 'postcheckOutcome', 'statusBeforePackaging']) assert.equal(workflow[key], 'success');
const collectionBytes = read(runFolder, 'collection-summary.json'), collection = JSON.parse(collectionBytes); assert.equal(collection.runId, run); assert.equal(collection.jobId, job); assert.equal(collection.headSHA, head); assert.equal(collection.runConclusion, 'success');
const metadata = {}; for (const kind of ['run', 'jobs', 'artifacts']) { const row = collection.metadata.find(entry => entry.kind === kind); assert(row); const filename = path.resolve(row.path); assert(filename.startsWith(runFolder + path.sep)); const bytes = fs.readFileSync(filename); assert.deepEqual(identity(bytes), { bytes: row.bytes, sha256: row.sha256 }); metadata[kind] = { bytes, value: JSON.parse(bytes) }; }
assert.equal(metadata.run.value.status, 'completed'); assert.equal(metadata.run.value.conclusion, 'success'); assert.equal(metadata.run.value.head_sha, head); assert.equal(metadata.jobs.value.jobs.length, 1); assert.equal(String(metadata.jobs.value.jobs[0].id), job); assert.equal(metadata.jobs.value.jobs[0].runner_group_name, 'GitHub Actions'); assert(metadata.jobs.value.jobs[0].labels.includes('windows-2022')); assert.equal(metadata.artifacts.value.artifacts[0].digest, 'sha256:' + digest);
const priorRun = '38826463509', priorFolder = path.join(work, 'cloud-verification-backups/run-' + priorRun), priorBytes = read(priorFolder, 'collection-summary.json'), prior = JSON.parse(priorBytes); assert.equal(prior.runConclusion, 'failure'); const priorAttempt = prior.artifacts[0].attempts[0]; assert.equal(priorAttempt.status, 'failed'); assert.equal(priorAttempt.summary.fail, 1); const priorIdentity = identity(priorBytes);
fs.mkdirSync(path.join(target, 'payload'), { recursive: true }); const records = [], objects = new Map(); const credentials = /\b(?:ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,}|AKIA[0-9A-Z]{16})\b|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----/;
function save(role, raw, origin) { safe(role); assert(!records.some(row => row.sourcePath === role)); assert(!credentials.test(raw.toString('utf8'))); const decoded = identity(raw); let stored = raw, encoding = 'identity'; if (raw.length > 65536) { const gzip = gzipSync(raw, { level: 9 }); if (gzip.length < raw.length * .85) { assert.deepEqual(gunzipSync(gzip), raw); stored = gzip; encoding = 'gzip'; } } const storage = identity(stored), name = 'payload/' + decoded.sha256 + (encoding === 'gzip' ? '.gz.snapshot' : '.snapshot'); if (!objects.has(name)) { fs.writeFileSync(path.join(target, name), stored, { flag: 'wx' }); assert.deepEqual(read(target, name), stored); objects.set(name, storage); } records.push({ sourcePath: role, path: name, ...decoded, storage: { encoding, ...storage }, origin }); }
const retained = [...files.keys()].filter(name => !name.startsWith('source/')); assert.equal(retained.length, 58);
for (const name of retained) save('artifact/' + name, artifact(name), 'Exact uploaded non-source-subtree artifact role, including all raw original child observations/streams');
save('local/local-backup-verification.json', verifiedBytes, 'Complete ZIP/CRC/readability and raw TAP/source receipt'); save('local/local-empty-bin-sidecar-verification.json', sidecarBytes, 'Four actual original child/load/call/comparison stream identity verification'); save('local/local-empty-bin-r7-serialization-verification.json', serializationBytes, 'Backup-only exact28-date/reopen-projection consistency verification'); save('local/collection-summary.json', collectionBytes, 'Completed API/log/artifact collection binding');
save('wrapper/job-' + job + '.txt', read(path.join(work, 'cloud-verification-backups/job-' + job), 'logs.txt'), 'Actual GitHub-hosted wrapper log');
for (const kind of ['run', 'jobs', 'artifacts']) { save('control-plane-completed/' + kind + '.json', metadata[kind].bytes, 'Raw completed authenticated REST response'); save('control-plane-first-observation/' + kind + '.json', read(runFolder, 'control-plane-evidence/' + kind + '.json'), 'Earlier nonterminal REST observation retained separately; never rewritten as completed'); }
for (const name of ['unpack-cloud-attempt.py', 'verify-empty-bin-sidecar-backup.py', 'verify-empty-bin-r7-serialization-backup.py', 'collect-readonly-run-vault-1245.mjs']) save('readers/' + name, read(work, name), 'Actual backup-only reader/collector source'); save('readers/preservation-collector.mjs', fs.readFileSync(import.meta.filename), 'Exact work-only filing implementation');
save('historical-prior-failed-run/collection-summary.json', priorBytes, 'Immutable earlier failed233 run remains failed; no pass comparison counts rebound');
const manifest = { schema: 'rea-hosted-vault-empty-bin-first-pass-preservation/v1', createdAtUtc: new Date().toISOString(), status: 'passed-finite-vault-contracts', runId: run, runAttempt: 1, jobId: job, runURL: metadata.run.value.html_url, sourceCommit: head, testedReference: attempt.environment.GITHUB_REF, artifactId, artifactSHA256: digest, artifactArchiveBytes: zip.length,
 summary: attempt.summary, selectedTestFiles: attempt.selectedTestFiles, selectedFileCount: 45, originalComparisonCountSeparate: 4, originalChildAttempts: 4, originalAssemblyLoadMarkers: 4, actualOriginalAssemblyLoads: 4, actualOriginalDeleteAllObjectsCalls: 4, originalComparisonsPassed: 4, originalChildNames: children.map(row => row.name), originalRelease: 'KeePass2.61.1', originalExecutable: native.executable,
 originalGuiSessions: 0, originalFullProgramLaunches: 0, originalClockAssignments: 0, arbitraryXMLPreservationClaimed: false, namedProjectionOnly: true,
 nativeSaveAndReopen: { observed: true, originalInputHeaderVersion: native.actual.inputHeaderVersion, originalOutputHeaderVersion: native.actual.outputHeaderVersion, unchangedFileVersionClaimed: false, rawActualDatesRewritten: false, exactNamedDatesChecked: 28, rawSubsecondDatesPreserved: 5, exactWholeSecondProjectionMatchesReopened: true, allOtherNamedFieldsDeepExact: true, sourcePins: native.serializedReopenContract.sources },
 candidateWorkflowScope: 'Explicit empty-recycle-bin preview/confirmation, revision/queue and draft ownership, native delete-all descendants with tombstones and save/reopen. Root-bin and missing-bin refusal are stated candidate policies rather than claims of original behavior equivalence.',
 exactNineHostedTargets: composition.currentTargets, applicationRuntimeOverlayTargets: 3, newTestOrHelperTargets: 6, compositionSHA256: sha(compositionBytes), separatePostrunSourceCheck: 'passed', sourceFiles: 780, sourceStable: true, sourceCapturedBeforeExecution: true, activeSourceSnapshotsInVerifiedLocalBackup: 358, unaffectedGitBaselineActiveFilesAuthenticated: 349,
 completeReadableLocalBackupVerified: true, localReadableFiles: files.size, retainedArtifactFiles: retained.length, publicSourceSnapshotPayloads: 0, omittedSourceSnapshotPayloads: omitted,
 omissionScope: 'Only the source/ active snapshot subtree is omitted publicly with every exact bytes/SHA identity preserved. All58 other uploaded artifact roles, including original child stdout/stderr, complete raw actual before/after/reopened observations, serialization projection/source pins, bounded overlay sources and receipts remain recoverable. Complete readable source snapshots remain in the verified local backup. No vendor executable/archive is copied publicly.',
 records, uniquePublicObjects: objects.size, storedPayloadBytes: [...objects.values()].reduce((sum, row) => sum + row.bytes, 0), allCopiesExact: true, allStorageDecodesExact: true,
 historicalPriorFailedRun: { runId: priorRun, conclusion: 'failure', summaryIdentity: priorIdentity, artifactId: prior.artifacts[0].artifactId, artifactSHA256: prior.artifacts[0].sha256, summary: priorAttempt.summary, modified: false, countsRebound: false },
 productionInstalled: false, fullDevelopmentSuiteAcceptance: false, realBrowserAcceptance: false, historicalReceiptsRebound: false, fullFeatureParityEstablished: false, superiorityEstablished: false, localProductExecutions: 0, localOriginalExecutions: 0, localTests: 0, localBuilds: 0,
 acceptanceScope: 'An actual hosted Windows run passed233/233 finite Vault tests across45 files using the exact nine-target experimental composition. Four separate observed original-library children each loaded the released KeePass assembly and called DeleteAllObjects once. Native save/reopen retains the observed4.1→4.0 header change and raw .392Z dates; the exact authenticated original whole-second serialization rule matches all28 named date fields and every remaining named field is deep-exact. The source composition remains uninstalled. These finite library and candidate tests do not establish real-browser, arbitrary-format/XML, full KeePass-program, security, performance, every documented-feature parity or superiority acceptance.' };
const manifestBytes = Buffer.from(JSON.stringify(manifest, null, 2) + '\n'); fs.writeFileSync(path.join(target, 'preservation-manifest.json'), manifestBytes, { flag: 'wx' });
fs.writeFileSync(path.join(target, 'README.md'), '# Vault empty recycle bin: first hosted finite pass\n\n' + manifest.acceptanceScope + '\n\nEach record lists decoded and stored bytes/SHA. Read identity storage directly; decompress gzip storage and verify decoded identity. Only source/ snapshots are omitted publicly; complete readable local copies are verified. Earlier failures remain separate. No original executable or vendor archive is published.\n', { flag: 'wx' });
const rows = []; function inventory(folder) { for (const item of fs.readdirSync(folder, { withFileTypes: true })) { assert(!item.isSymbolicLink()); const file = path.join(folder, item.name); if (item.isDirectory()) inventory(file); else rows.push({ path: path.relative(publicRoot, file).split(path.sep).join('/'), ...identity(fs.readFileSync(file)) }); } } inventory(publicRoot);
const totalBytes = rows.reduce((sum, row) => sum + row.bytes, 0); assert(totalBytes <= 3 * 1024 * 1024); assert(rows.length <= 100);
for (const row of records) { const stored = read(target, row.path); assert.deepEqual(identity(stored), { bytes: row.storage.bytes, sha256: row.storage.sha256 }); assert.deepEqual(identity(row.storage.encoding === 'gzip' ? gunzipSync(stored) : stored), { bytes: row.bytes, sha256: row.sha256 }); }
assert.deepEqual(identity(read(priorFolder, 'collection-summary.json')), priorIdentity);
const authority = { schema: 'rea-work-only-vault-empty-bin-first-pass-copy-authority/v1', createdAtUtc: new Date().toISOString(), publicCandidate: publicRoot, targetPrefix: prefix, mode: 'new-directory-only', runId: run, jobId: job, artifactId, sourceCommit: head, files: rows.length, bytes: totalBytes, rows, manifest: identity(manifestBytes), logicalRoles: records.length, retainedArtifactFiles: retained.length, omittedActiveSnapshots: 358, fullLocalReadableFiles: 416, sourceCensusFiles: 780, summary: attempt.summary, originalComparisonCountSeparate: 4, sourceProjectionReadback: { namedDates: 28, rawSubseconds: 5, allOtherNamedFieldsExact: true },
 allStoredAndDecodedPublicObjectsReadBackExact: true, priorFailedRunUnchanged: true, priorBackupReaderReused: true, productionInstalled: false, activeFilesWritten: 0, gitMutations: 0, localProductExecutions: 0, localOriginalExecutions: 0, localTests: 0, localBuilds: 0, independentReviewPending: true };
const authorityBytes = Buffer.from(JSON.stringify(authority, null, 2) + '\n'); fs.writeFileSync(path.join(stage, 'copy-authority.json'), authorityBytes, { flag: 'wx' }); console.log(JSON.stringify({ stage, prefix, files: rows.length, bytes: totalBytes, logicalRoles: records.length, authority: identity(authorityBytes), manifest: identity(manifestBytes), localProductExecutions: 0 }));
