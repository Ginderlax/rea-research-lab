    {
      "id": "grafana.candidate.8946326cd71f5786f97c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For trace-based alerts, use [span metrics](https://grafana.com/docs/tempo/latest/metrics-from-traces/span-metrics/).",
      "headingPath": [
        "Examples of trace-based alerts",
