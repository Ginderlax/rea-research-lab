actual={p.relative_to(public).as_posix() for p in public.rglob('*') if p.is_file()}
assert actual=={r['path'] for r in a['rows']} and len(actual)==64
assert sum(r['bytes'] for r in a['rows'])==2602599
for r in a['rows']:assert pin((public/r['path']).read_bytes())=={k:r[k] for k in ('bytes','sha256')}
root=public/a['targetPrefix'];mraw=(root/'preservation-manifest.json').read_bytes();assert pin(mraw)==a['manifest'];m=json.loads(mraw)
assert len(m['records'])==87 and len({r['sourcePath'] for r in m['records']})==87
decoded={}
for r in m['records']:
    stored=(root/r['path']).read_bytes();assert pin(stored)=={k:r['storage'][k] for k in ('bytes','sha256')}
    assert r['storage']['encoding'] in ('identity','gzip')
    raw=gzip.decompress(stored) if r['storage']['encoding']=='gzip' else stored
    assert pin(raw)=={k:r[k] for k in ('bytes','sha256')};decoded[r['sourcePath']]=raw
run=work/'cloud-verification-backups/run-38932318510';backup=run/'artifact-12060237203';readable=backup/'readable-evidence';collection=json.loads((run/'collection-summary.json').read_bytes());verification=json.loads((backup/'local-backup-verification.json').read_bytes())
assert len(verification['files'])==431
expected={r['path']:r for r in verification['files']};zipraw=decoded['portable-artifact/complete-github-artifact.zip']
assert zipraw==(run/'artifact-12060237203.zip').read_bytes()
assert pin(zipraw)=={'bytes':1727060,'sha256':'ca987428cb9f3d9d0f0b7baa329f3259fff75e9ac03a61d047fab7ebb6c1c674'}
with zipfile.ZipFile(io.BytesIO(zipraw)) as outer:
    outerFiles=[i for i in outer.infolist() if not i.is_dir()];assert len(outerFiles)==1
    payload=outer.read(outerFiles[0]);assert zlib.crc32(payload)&0xffffffff==outerFiles[0].CRC
    with zipfile.ZipFile(io.BytesIO(payload)) as inner:
        members=[i for i in inner.infolist() if not i.is_dir()];assert len(members)==431
        assert {i.filename for i in members}==set(expected)
        for i in members:
            raw=inner.read(i);assert zlib.crc32(raw)&0xffffffff==i.CRC
            assert pin(raw)=={k:expected[i.filename][k] for k in ('bytes','sha256')}
            assert raw==(readable/i.filename).read_bytes()
artifactRoles={n.removeprefix('artifact/'):b for n,b in decoded.items() if n.startswith('artifact/')}
assert set(artifactRoles)=={n for n in expected if not n.startswith('source/')} and len(artifactRoles)==57
for n,b in artifactRoles.items():assert b==(readable/n).read_bytes()
meta={r['kind']:r for r in collection['metadata']}
prior=work/'cloud-verification-backups/run-38930461121/artifact-12059751864/readable-evidence'
for role,b in decoded.items():
    if role.startswith('artifact/') or role=='portable-artifact/complete-github-artifact.zip':continue
    if role=='local/local-backup-verification.json':source=backup/'local-backup-verification.json'
    elif role=='local/collection-summary.json':source=run/'collection-summary.json'
    elif role.startswith('wrapper/'):source=work/'cloud-verification-backups/job-117079121814/logs.txt'
    elif role.startswith('control-plane-completed/'):source=pathlib.Path(meta[role.split('/')[-1].split('.')[0]]['path'])
    elif role.startswith('control-plane-observations/'):source=run/role.removeprefix('control-plane-observations/')
    elif role.startswith('readers/'):
        source=work/('preserve-cloud-full1100-native-metadata-failure-20261016.mjs' if role=='readers/preservation-collector.mjs' else role.removeprefix('readers/'))
    elif role=='source-context/corrected-bounds-source-transition.json':source=repo/'products/rea-studio/results/archive-aes-properties-fixture-correction-20261016/source-transition.json'
    elif role=='source-context/notes-hosted-source-bundle.json':source=repo/'products/rea-studio/experiments/notes-todo/bundle.json'
    elif role=='failure-observations/exact-two-failures.txt':
        raw=(readable/'stdout.txt').read_bytes();assert b==raw[:raw.index(b'# Subtest: ZIP parser validates CRC')];continue
    elif role=='prior-scope/89e-successful-full-attempt.json':source=prior/'attempt-validation.json'
    elif role=='prior-scope/89e-identical-798-source-census.json':source=prior/'source-before.json'
    elif role.startswith('failure-source/'):source=readable/'source'/role.removeprefix('failure-source/')
    else:raise AssertionError(role)
    assert b==source.read_bytes(),role
