    },
    {
      "id": "grafana.candidate.3283e26ad6ef476ab2a2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Download the archive containing the plugin assets, and install it by extracting the archive into the plugin directory. For example:",
