    {
      "id": "grafana.candidate.8ccf9a84a2c9ed1ff48b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "InfluxData provides three query languages:",
      "headingPath": [
        "Configure the InfluxDB data source",
        "Before you begin"
      ],
      "source": {
        "path": "docs/sources/datasources/influxdb/configure/_index.md",
