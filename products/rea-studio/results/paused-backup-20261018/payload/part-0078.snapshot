    {
      "id": "grafana.candidate.ab1a4788da5ef15e9fdc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This is useful when writing reusable templates. For example, to print all alerts you might write the following:",
      "headingPath": [
        "If",
        "Templates",
        "Execute templates"
      ],
      "source": {
