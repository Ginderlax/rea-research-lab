// Strict completed browser evidence freeze; no app action is executed.
import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';const root=import.meta.dirname,hash=b=>createHash('sha256').update(b).digest('hex'),inventory={};async function walk(p,prefix=''){for(const e of(await fs.readdir(p,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){assert.equal(e.isSymbolicLink(),false);const name=prefix+e.name,q=path.join(p,e.name);if(e.isDirectory())await walk(q,name+'/');else{assert.ok(e.isFile());assert.notEqual(name,'freeze-manifest.json');const b=await fs.readFile(q);inventory[name]={bytes:b.length,sha256:hash(b)};}}}await walk(root);const b=await fs.readFile(path.join(root,'validation.json')),v=JSON.parse(b);assert.equal(v.finiteBrowserAcceptance,true);assert.equal(v.oldCandidate188Unmodified,true);assert.equal(v.actualDownloadFileAcceptance,false);const manifest={schema:'rea-sketch-layout-corrected-browser-strict-freeze/v1',at:new Date().toISOString(),files:Object.keys(inventory).length,bytes:Object.values(inventory).reduce((n,r)=>n+r.bytes,0),inventory,selfExcluded:true,validationSHA256:hash(b),StudioWrites:0,originalGUI:0,downloadFileAccepted:false},mb=Buffer.from(JSON.stringify(manifest,null,2)+'\n');await fs.writeFile(path.join(root,'freeze-manifest.json'),mb,{flag:'wx'});for(const[p,r]of Object.entries(inventory)){const b=await fs.readFile(path.join(root,p));assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);}console.log(JSON.stringify({files:manifest.files,bytes:manifest.bytes,manifestSHA256:hash(mb),validationSHA256:hash(b),finiteSemanticGroups:14,downloadFileAcceptance:false,StudioWrites:0}));
