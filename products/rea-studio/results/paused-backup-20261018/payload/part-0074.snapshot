    },
    {
      "id": "grafana.candidate.508803492ce01ef28af5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Add the plugins you want to install as a list in your values file. For more information about the configuration, refer to [the Helm chart configuration reference](https://github.com/grafana/helm-charts/tree/main/charts/grafana#configuration).",
      "headingPath": [
        "Install a plugin",
        "Install plugins using the Grafana Helm chart",
