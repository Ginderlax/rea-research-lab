export const selectionUnavailable = Symbol('selection unavailable');
const charge = (state, amount = 1) => (state.work += amount) <= state.limit;

// On a refused comparison, restore the held value before returning. The array
// must remain a permutation so the original stable-sort fallback is exact.
function insertionSort(values, left, right, state) {
  for (let i = left + 1; i <= right; i++) {
    const value = values[i];
    let j = i - 1;
    while (j >= left) {
      if (!charge(state)) { values[j + 1] = value; return false; }
      if (values[j] <= value) break;
      values[j + 1] = values[j]; j--;
    }
    values[j + 1] = value;
  }
  return true;
}

function samplePivot(values, left, right, state) {
  if (right - left < 127) {
    if (!charge(state, 3)) return selectionUnavailable;
    const a = values[left], b = values[Math.floor((left + right) / 2)], c = values[right];
    return a < b ? (b < c ? b : a < c ? c : a) : (a < c ? a : b < c ? c : b);
  }
  const sample = [];
  for (let i = 0; i < 9; i++) sample.push(values[left + Math.floor((right - left) * i / 8)]);
  if (!insertionSort(sample, 0, 8, state)) return selectionUnavailable;
  return sample[4];
}

function deterministicPivot(values, left, right, state) {
  state.deterministicPivots++;
  let count = 0;
  for (let start = left; start <= right; start += 5) {
    const end = Math.min(start + 4, right);
    if (!insertionSort(values, start, end, state)) return selectionUnavailable;
    const middle = start + Math.floor((end - start) / 2), destination = left + count++;
    const held = values[destination]; values[destination] = values[middle]; values[middle] = held;
  }
  return selectCore(values, left, left + count - 1, left + Math.floor(count / 2), state, true);
}

function selectCore(values, left, right, index, state, deterministic) {
  while (left < right) {
    if (right - left < 24) {
      state.smallSorts++;
      return insertionSort(values, left, right, state) ? values[index] : selectionUnavailable;
    }
    const pivot = deterministic || state.partitionScans > state.scanLimit
      ? deterministicPivot(values, left, right, state) : samplePivot(values, left, right, state);
    if (pivot === selectionUnavailable) return pivot;
    let low = left, current = left, high = right;
    while (current <= high) {
      if (!charge(state)) return selectionUnavailable;
      state.partitionScans++;
      const value = values[current];
      if (value < pivot) { values[current] = values[low]; values[low] = value; low++; current++; }
      else if (value > pivot) { values[current] = values[high]; values[high] = value; high--; }
      else current++;
    }
    if (index < low) right = low - 1;
    else if (index > high) left = high + 1;
    else return pivot;
  }
  return values[left];
}

/** Internal finite-array selection control; mutates only the supplied private
 * array. Explicit reduced budgets and diagnostics are for boundedness checks.
 * Unavailable always leaves an exact permutation for a stable-sort fallback. */
export function selectFiniteRank(values, index, workLimit = values.length * 64 + 128, diagnostics) {
  if (!values.length || !Number.isInteger(index) || index < 0 || index >= values.length || !Number.isSafeInteger(workLimit) || workLimit < 0) return selectionUnavailable;
  const state = { work: 0, limit: workLimit, partitionScans: 0, scanLimit: values.length * 2, deterministicPivots: 0, smallSorts: 0 };
  try { return selectCore(values, 0, values.length - 1, index, state, false); }
  finally { if (diagnostics) Object.assign(diagnostics, state); }
}

function finiteCandidates(values, ignore, zero) {
  const candidates = [];
  for (let i = 0; i < values.length; i++) {
    if (!(i in values)) { if (ignore) continue; return selectionUnavailable; }
    let value = values[i];
    if (ignore && value === null) continue;
    if (zero && value === null) value = 0;
    if (!Number.isFinite(value) || Object.is(value, -0)) return selectionUnavailable;
    candidates.push(value);
  }
  return candidates;
}

/** The authentic percentile collection and stable sort for all rejected finite
 * inputs and shared multi-percentile requests. Strict null checks are deliberate. */
export function preparePercentileValues(field, ignore, zero) {
  let candidates = field.values;
  if (ignore) candidates = candidates.filter(value => value !== null);
  if (zero) candidates = candidates.map(value => value === null ? 0 : value);
  return candidates.slice().sort((a, b) => a - b);
}

export function singlePercentile(id, field, ignore, zero) {
  const values = finiteCandidates(field.values, ignore, zero);
  if (values !== selectionUnavailable && values.length) {
    const index = Math.round((values.length - 1) * (Number(id.slice(1)) / 100));
    const selected = selectFiniteRank(values, index);
    if (selected !== selectionUnavailable) return { [id]: selected };
    values.sort((a, b) => a - b);
    return { [id]: values[index] };
  }
  const sorted = preparePercentileValues(field, ignore, zero);
  return { [id]: sorted[Math.round((sorted.length - 1) * (Number(id.slice(1)) / 100))] };
}
