import test from 'node:test';import assert from 'node:assert/strict';import {mkdtemp,readFile,rm} from 'node:fs/promises';import {tmpdir} from 'node:os';import {join} from 'node:path';import {request} from 'node:http';import {start} from '../server.mjs';
async function host(t){const dataDir=await mkdtemp(join(tmpdir(),'rea-layout-static-')),instance=await start({port:0,dataDir});t.after(async()=>{await instance.close();await rm(dataDir,{recursive:true,force:true});});return instance;}
test('shared host serves the actual Sketch client and both imported modules as exact JavaScript',async t=>{const instance=await host(t),client=await readFile(new URL('../apps/sketch/client.mjs',import.meta.url));assert.match(client.toString(),/from ['"]\.\/layout\.mjs['"]/);assert.match(client.toString(),/from ['"]\.\/core\.mjs['"]/);for(const name of ['client','core','layout']){const r=await fetch(instance.url+'/apps/sketch/'+name+'.mjs');assert.equal(r.status,200,name);assert.match(r.headers.get('content-type'),/^text\/javascript/);assert.equal(r.headers.get('x-content-type-options'),'nosniff');assert.equal(r.headers.get('cache-control'),'no-store');assert.deepEqual(Buffer.from(await r.arrayBuffer()),await readFile(new URL('../apps/sketch/'+name+'.mjs',import.meta.url)));}});
test('the exact layout route preserves host/origin guards, GET-only serving and private-module boundaries',async t=>{const instance=await host(t);for(const p of ['/apps/vault/layout.mjs','/apps/sketch/server.mjs','/apps/sketch/layout.test.mjs','/apps/sketch/layout.mjs/','/lib/storage.mjs','/apps/sketch/%6cayout.mjs','/apps/sketch/%2e%2e/lib/storage.mjs']){const r=await fetch(instance.url+p);assert.equal(r.status,404,p);await r.arrayBuffer();}for(const options of [{headers:{origin:'https://outside.invalid'}},{method:'POST'}]){const r=await fetch(instance.url+'/apps/sketch/layout.mjs',options);assert.equal(r.status,options.method?405:403);await r.arrayBuffer();}const badHostStatus=await new Promise((resolve,reject)=>{const req=request(instance.url+'/apps/sketch/layout.mjs',{headers:{host:'outside.invalid'}},res=>{res.resume();res.on('end',()=>resolve(res.statusCode));res.on('error',reject);});req.on('error',reject);req.end();});assert.equal(badHostStatus,403);const session=await fetch(instance.url+'/api/session');assert.equal(session.status,200);const data=await session.json();assert.equal(data.apps.length,10);assert.equal(data.status,'development');assert.match(data.token,/^[0-9a-f]{64}$/);});
