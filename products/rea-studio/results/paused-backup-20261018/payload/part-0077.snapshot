      "id": "grafana.candidate.7bd5da68d9065564b208",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Update the team's role assignments to match the provided set of UIDs. This will remove any assigned roles that aren't in the request and add roles that are in the set but are not already assigned to the user.",
      "headingPath": [
        "RBAC API",
        "Remove a team role assignment",
        "Set team role assignments"
      ],
      "source": {
        "path": "docs/sources/developer-resources/api-reference/http-api/api-legacy/access_control.md",
        "gitBlobSha": "23f0a00b4604f17d0d6f250151ed515d15a0bee6",
        "sha256": "b78e3ec44aac5ef862c3e46b43996f6c4c94be996bbaa59847c52201964c8c3f",
        "lineStart": 1318,
        "lineEnd": 1320,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/developer-resources/api-reference/http-api/api-legacy/access_control.md#L1318-L1320"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss",
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.85e0a3bbed4e8340fdbe",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you want to add or remove a single role, consider using [Add a team role assignment](#add-a-team-role-assignment) or [Remove a team role assignment](#remove-a-team-role-assignment) instead.",
      "headingPath": [
        "RBAC API",
        "Remove a team role assignment",
        "Set team role assignments"
      ],
      "source": {
        "path": "docs/sources/developer-resources/api-reference/http-api/api-legacy/access_control.md",
        "gitBlobSha": "23f0a00b4604f17d0d6f250151ed515d15a0bee6",
