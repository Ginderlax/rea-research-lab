// Recorded evidence recomputation only. No candidate/original/browser imports.
import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';
import {hash,authenticateBytes} from './proof-verifier.mjs';
const here=import.meta.dirname,workspace=path.resolve(here,'../..'),root=path.join(workspace,'work/sketch-layout-browser-next'),route=path.join(workspace,'work/sketch-layout-static-route-next');
const read=p=>fs.readFile(path.join(root,p)),j=async p=>JSON.parse(await read(p)),write=async(p,v)=>fs.writeFile(path.join(here,p),JSON.stringify(v,null,2)+'\n',{flag:'wx'});
const mb=await read('freeze-manifest.json');assert.equal(hash(mb),'1f40beb1ef5f2f5c558f250b905ede08426d3eadd1183cf6ee9965c267642f66');const inventory=JSON.parse(mb).inventory;for(const[p,r]of Object.entries(inventory))authenticateBytes(await read(p),r);
const steps=await j('browser-steps.json'),s=new Map(steps.map(r=>[r.label,r.read])),plan=await j('browser-plan.json'),prior=s.get('group-all-selected').scene,right=s.get('group-aligned-right').scene;
assert.equal(s.get('group-member-click').selection,'2 editable shapes selected');assert.equal(s.get('group-all-selected').selection,'3 editable shapes selected');assert.equal(s.get('group-cleared').selection,'No shape selected');assert.deepEqual(right.shapes.map(r=>r.x),plan.group.alignRightX);assert.equal(right.shapes[1].x-right.shapes[0].x,20.5);assert.equal(right.shapes[1].y-right.shapes[0].y,20.125);assert.deepEqual(s.get('group-undo').scene,prior);assert.deepEqual(s.get('group-redo').scene,right);
assert.equal(s.get('already-aligned-noop').status,'Selection already arranged');assert.deepEqual(s.get('already-aligned-noop').scene,right);assert.deepEqual(s.get('already-aligned-noop-undo').scene,prior);assert.deepEqual(s.get('already-aligned-noop-redo').scene,right);
assert.equal(s.get('single-group-noop').status,'Select at least two separate shapes or groups');assert.deepEqual(s.get('single-group-noop-undo').scene,s.get('before-single-group-import').scene);assert.deepEqual(s.get('single-group-noop-redo').scene,s.get('single-group-noop').scene);assert.deepEqual(s.get('final-group-before-save').scene,right);
assert.equal(s.get('gesture-held-pointer').selection,'2 editable shapes selected');assert.equal(s.get('gesture-layout-refused').status,'Finish the current gesture before arranging shapes');assert.deepEqual(s.get('gesture-layout-refused').scene,s.get('gesture-before').scene);assert.deepEqual(s.get('gesture-released').scene,s.get('gesture-before').scene);assert.deepEqual(s.get('saved').scene.shapes,right.shapes);assert.equal(s.get('new-before-reopen').scene.shapes.length,0);assert.equal(s.get('reopened-from-fresh-list').status,'Loaded scene');assert.deepEqual(s.get('reopened-from-fresh-list').scene,s.get('saved').scene);
const rv=JSON.parse(await fs.readFile(path.join(route,'validation.json'))),cases=[['first','runs/baseline-2026-10-13T03-00-38.089Z',0,2],['corrected-premise-baseline',rv.baseline.run,1,1],['corrected-route',rv.current.run,2,0]],raw=[];
for(const[name,p,pass,fail]of cases){const stdout=await fs.readFile(path.join(route,p,'stdout.txt')),stderr=await fs.readFile(path.join(route,p,'stderr.txt')),text=stdout.toString();const values={};for(const key of ['tests','pass','fail','cancelled','skipped','todo']){const m=text.match(new RegExp('^# '+key+' (\\d+)$','m'));assert.ok(m,key+' '+p);values[key]=Number(m[1]);}assert.deepEqual(values,{tests:2,pass,fail,cancelled:0,skipped:0,todo:0});raw.push({name,path:p,stdout:{bytes:stdout.length,sha256:hash(stdout)},stderr:{bytes:stderr.length,sha256:hash(stderr)},actualTAP:values});}
for(const p of [rv.baseline.run,rv.current.run]){const a=JSON.parse(await fs.readFile(path.join(route,p,'attempt.json')));assert.equal(a.sourceStable,true);const b=a.before??a.sourceBefore,after=a.after??a.sourceAfter;assert.deepEqual(after,b);assert.equal(b.length,10);}
await write('recorded-evidence-addendum.json',{schema:'rea-sketch-layout-recorded-evidence-recompute/v1',browserGroupSelectionOffsetsUndoRedoExact:true,noopTwoBodiesRecomputedExact:true,heldPointerRefusalBeforeMutationAndReleasedExact:true,persistenceBrowserBodiesRecomputedExact:true,sourceBrowser74StillExact:true,routeRawTAP:raw,recordedRouteIntervals10BeforeAfterExact:true,encodedPathLimit:'The encoded dot-segment probe is submitted through fetch; URL normalization can precede the wire. It is a finite fetch-path denial assertion, not a raw-wire encoded-path proof.',newBrowserCalls:0,newHTTPCalls:0,newOriginalCalls:0,newAppTests:0});
const node=await fs.readFile(process.execPath);await write('collector-runtime.json',{NodeVersion:process.version,executablePath:process.execPath,bytes:node.length,sha256:hash(node),usedFor:'Source-only standard-library hashing/JSON and metadata checks; no original or candidate runtime evaluated.'});
for(const[p,r]of Object.entries(inventory))authenticateBytes(await read(p),r);assert.equal(hash(await read('freeze-manifest.json')),hash(mb));console.log(JSON.stringify({recordedGroupsAndBoundariesExact:true,routeActualTAPExact:true,newBehavior0:true}));
