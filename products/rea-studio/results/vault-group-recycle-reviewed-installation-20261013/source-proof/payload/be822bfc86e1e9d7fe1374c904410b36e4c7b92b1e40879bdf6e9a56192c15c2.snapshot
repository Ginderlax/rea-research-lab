import fs from'node:fs/promises';import path from'node:path';import{fileURLToPath}from'node:url';import{createHash}from'node:crypto';import assert from'node:assert/strict';const own=path.dirname(fileURLToPath(import.meta.url)),workspace=path.resolve(own,'../..'),sha=b=>createHash('sha256').update(b).digest('hex');
const before=JSON.parse(await fs.readFile(path.join(own,'source-before.json'),'utf8'));for(const ref of before.refs){const dir=path.dirname(path.join(workspace,ref.path)),mb=await fs.readFile(path.join(workspace,ref.path));assert.equal(sha(mb),ref.sha256);for(const r of JSON.parse(mb).inventory){const b=await fs.readFile(path.join(dir,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);}}
const prod=JSON.parse(await fs.readFile(path.join(own,'baseline-source.json'),'utf8'));for(const r of prod.files){const b=await fs.readFile(path.join(workspace,r.source));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);assert.ok(b.equals(await fs.readFile(path.join(own,r.destination))));}
const run=JSON.parse(await fs.readFile(path.join(own,'runs/final-focused/run.json'),'utf8'));assert.equal(run.exit.code,0);assert.equal(run.sourceStable,true);const stdout=await fs.readFile(path.join(own,'runs/final-focused/stdout.txt'),'utf8'),counts=Object.fromEntries(['tests','pass','fail','skipped'].map(k=>[k,Number(stdout.match(new RegExp('ℹ '+k+' (\\d+)'))?.[1])]));assert.deepEqual(counts,{tests:68,pass:68,fail:0,skipped:0});for(const r of run.before){const b=await fs.readFile(path.join(own,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);assert.ok(b.equals(await fs.readFile(path.join(own,'runs/final-focused/source',path.basename(r.path)+'.snapshot'))));}
const changed=run.before.filter(r=>before.files.some(b=>b.path===r.path&&b.sha256!==r.sha256)),added=run.before.filter(r=>!before.files.some(b=>b.path===r.path));assert.deepEqual(changed.map(r=>path.basename(r.path)).sort(),['client.mjs','GROUP-RECYCLE.md','group-ui.test.mjs'].sort());
const bclient=await fs.readFile(path.join(own,'candidate-before/client.mjs.snapshot')),aclient=await fs.readFile(path.join(own,'products/rea-studio/apps/vault/client.mjs')),blines=bclient.toString().split(/(?<=\n)/),alines=aclient.toString().split(/(?<=\n)/);assert.equal(blines.length,alines.length);const transforms=[];for(let i=0;i<blines.length;i++)if(blines[i]!==alines[i])transforms.push({line:i+1,before:blines[i],after:alines[i]});assert.equal(transforms.length,3);let inverse=aclient.toString();for(const t of transforms){assert.equal(inverse.split(t.after).length,2);inverse=inverse.replace(t.after,t.before)}assert.ok(Buffer.from(inverse).equals(bclient));await fs.writeFile(path.join(own,'client-transformations.json'),JSON.stringify({schema:'rea-vault-group-client-coherence-transform/v1',before:{bytes:bclient.length,sha256:sha(bclient)},after:{bytes:aclient.length,sha256:sha(aclient)},transforms,inverseExact:true,backendChanges:0},null,2)+'\n');
const backend=['server.mjs','recycle.mjs','history.mjs','kdbx.mjs','xml.mjs'];for(const n of backend){const r=before.files.find(r=>r.path.endsWith('/'+n));assert.equal(sha(await fs.readFile(path.join(own,r.path))),r.sha256);}
const census=[];for(const n of run.tests){const b=await fs.readFile(path.join(own,'products/rea-studio/apps/vault',n)),calls=(b.toString().match(/\btest\s*\(/g)||[]).length,parameterized=['recycle-boundaries.test.mjs','recycle-controls.test.mjs','group-coherence-replay.test.mjs'].includes(n)?1:0;census.push({name:n,staticCalls:calls,parameterizedExtra:parameterized,tests:calls+parameterized,bytes:b.length,sha256:sha(b)});}assert.equal(census.reduce((n,r)=>n+r.tests,0),68);
const historical=JSON.parse(await fs.readFile(path.join(own,'references/initial777/validation.json.snapshot'),'utf8')),ledger={schema:'rea-vault-group-coherence-failure-ledger/v1',initial777:{manifest:before.refs[0],authorChecks:67,originalManagedLoads:15,knownFailuresAtItsFreeze:0},postfreeze:{manifest:before.refs[1],result:'1pass/1fail',classification:'Confirmed application cross-panel stale password publication after completed recursive purge.'},correctionAttempts:[{name:'first freeze metadata',result:'Ordinal source order versus locale comparator assertion mismatch',classification:'Exact finalizer source preserved before changing only both metadata arrays to identical sort; no application/test/original execution or source rebind.'},{name:'fresh-boundaries',result:'14pass/1fail',classification:'Owned fixture selected readonly bin Title instead of scoped New entry Title; failed before application request, exact source/raw retained.'},{name:'prior-retry-policy-negative',result:'6pass/1EXPECTEDfail',classification:'Import-only replay preserves old seven bodies; detached old-control retry now refuses. Explicit fresh list/reconfirmation adapter is disclosed; correct backend unchanged on failed write.'}],oldStagesModified:false,noFailureErasure:true};await fs.writeFile(path.join(own,'failure-ledger.json'),JSON.stringify(ledger,null,2)+'\n');
const receipt={schema:'rea-keepass-group-coherence-correction-validation/v1',at:new Date().toISOString(),refs:before.refs,refsSourceStable:true,counts,sourceStable:true,sourceFiles:run.before.length,implementationFingerprints:run.before,changedExisting:changed,added,census,productionBaselineFiles:prod.files.length,productionBaselineUnchanged:true,finalRun:'runs/final-focused/run.json',finalRunSHA256:sha(await fs.readFile(path.join(own,'runs/final-focused/run.json'))),collector:run.collector,clientInverseExact:true,clientTransformations:'client-transformations.json',backendUnchanged:backend,historicalOriginal:{receiptSHA256:'87f2716a6ee5adc42d6163a6cf4d1baea7f0ff28d094af23a186301c9a03e2f8',calls:historical.original.calls,managedLoads:15,attribution:'Exact immutable777 native/server implementation, unchanged five backend files. These15 loads are historical, not rerun or recounted as current executions.'},currentExecutions:{originalManagedLoads:0,originalGUI:0,originalProgram:0,browser:0,actualHTTPHost:0,benchmark:0},newChecks:{exactReplay:2,fresh:6},priorAuthorUI7Adapter:'test-adapters.json',failureLedger:'failure-ledger.json',limits:historical.limits,acceptance:{authorFinite:true,independent:false,production:false,fullParity:false,superiority:false},scope:'Client-only confirmed-effect invalidation/scrubbing and operation-generation publication. Pending request cannot be cancelled by closing its view; failed writes require explicit fresh list/reconfirmation. Newer enabled blank-editor draft is retained. No original GUI equivalence or crash/blocked-IO preemption claim.',sourceAssistedLicense:'GPL-2.0-or-later; selected pinned16 original files and original license retained.',cleanup:{childExit:0,hostsStarted:0,browserTabsOpened:0,ownedProcessesFinished:true,user4311Touched:false},repoWrites:0,registryWrites:0};await fs.writeFile(path.join(own,'validation.json'),JSON.stringify(receipt,null,2)+'\n');
const inventory=[];async function walk(dir,prefix=''){for(const e of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const p=prefix?prefix+'/'+e.name:e.name;if(e.name==='.local'||p==='manifest.json'||p==='freeze.json')continue;if(e.isDirectory())await walk(path.join(dir,e.name),p);else{const b=await fs.readFile(path.join(dir,e.name));assert(!/\.(?:exe|dll|zip|7z|kdbx|tar|gz|zst)$/i.test(p));assert(!b.subarray(0,2).equals(Buffer.from('MZ'))&&!b.subarray(0,2).equals(Buffer.from('PK')));inventory.push({path:p,bytes:b.length,sha256:sha(b)});}}}await walk(own);const mb=Buffer.from(JSON.stringify({schema:'rea-keepass-group-coherence-strict-preservation/v1',inventory,files:inventory.length,excluded:['.local/**','manifest.json','freeze.json'],pathsAreStrict:true,recursiveHistoryCopy:false,originalCarrierBytesCopied:false},null,2)+'\n');await fs.writeFile(path.join(own,'manifest.json'),mb);const vb=await fs.readFile(path.join(own,'validation.json')),frozen={schema:'rea-keepass-group-coherence-freeze/v1',at:new Date().toISOString(),manifest:{path:'manifest.json',bytes:mb.length,sha256:sha(mb),records:inventory.length},validation:{path:'validation.json',bytes:vb.length,sha256:sha(vb)},client:{path:'products/rea-studio/apps/vault/client.mjs',bytes:aclient.length,sha256:sha(aclient)},sourceFrozen:true,independentAcceptancePending:true};await fs.writeFile(path.join(own,'freeze.json'),JSON.stringify(frozen,null,2)+'\n');console.log(JSON.stringify(frozen));
