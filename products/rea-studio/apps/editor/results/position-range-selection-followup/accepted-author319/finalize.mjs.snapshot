import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const root=import.meta.dirname,workspace=path.resolve(root,'../..'),hash=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:hash(b)}),read=p=>fs.readFile(path.join(root,p));
async function save(p,b){await fs.mkdir(path.dirname(path.join(root,p)),{recursive:true});await fs.writeFile(path.join(root,p),b,{flag:'wx'});}const json=async(p,v)=>save(p,JSON.stringify(v,null,2)+'\n'),identity=async p=>({path:p,...id(await read(p))});
const history=JSON.parse(await read('history-authentication-before.json')),verified=[];for(const a of history.authorities){const folder=path.resolve(root,'..',a.directory),mb=await fs.readFile(path.join(folder,a.manifest));assert.equal(hash(mb),a.sha256);const m=JSON.parse(mb),rows=Array.isArray(m.inventory)?m.inventory:Object.entries(m.inventory).map(([path,r])=>({path,...r}));assert.equal(rows.length,a.count);const actual=[];async function census(dir){for(const e of await fs.readdir(dir,{withFileTypes:true})){assert.equal(e.isSymbolicLink(),false);const p=path.join(dir,e.name);if(e.isDirectory())await census(p);else{assert.ok(e.isFile());actual.push(path.relative(folder,p).replaceAll('\\','/'));}}}await census(folder);assert.deepEqual(actual.sort(),[...rows.map(r=>r.path),a.manifest].sort());}
for(const r of history.records){const b=await fs.readFile(path.resolve(workspace,r.sourceRoot,r.sourcePath));assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256},r.sourcePath);assert.deepEqual(id(await read(r.snapshot)),id(b),r.snapshot);verified.push({...r});}assert.equal(verified.length,190);await json('history-authentication-after.json',{authorities:history.authorities,records:verified,strictBeforeAfterExact:true,completePayloads188AndManifests2Preserved:true});
const tx=JSON.parse(await read('source-transformations.json'));for(const t of tx.transformations){const old=await fs.readFile(path.resolve(workspace,t.sourcePath)),now=await read(t.destination);assert.deepEqual(id(old),t.before);assert.deepEqual(id(now),t.after);let inverse=now.toString();for(const c of [...t.changes].reverse()){assert.equal(inverse.split(c.after).length-1,1);inverse=inverse.replace(c.after,c.before);}assert.deepEqual(id(Buffer.from(inverse)),id(old));}assert.deepEqual(await read('review-replay/oracle.mjs'),await fs.readFile(path.resolve(root,'../editor-position-range-selection-independent-review/oracle.mjs')));
const controls=JSON.parse(await read('execution-controls-before.json'));assert.deepEqual(id(await fs.readFile(process.execPath)),{bytes:controls.Node.bytes,sha256:controls.Node.sha256});assert.equal(process.version,controls.Node.version);for(const r of controls.independentOracleParser.records)assert.deepEqual(id(await fs.readFile(path.resolve(workspace,controls.independentOracleParser.sourceRoot,r.path))),{bytes:r.bytes,sha256:r.sha256});await json('execution-controls-after.json',{...controls,sourceStable:true});
