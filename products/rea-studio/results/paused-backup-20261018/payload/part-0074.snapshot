    {
      "id": "grafana.candidate.557c5032e8949324cc29",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana applies the highest permission a given user has to access a resource like a dashboard, so if you want to prevent a user from accessing a folder or dashboard you need to consider the user's organization role, folder permissions, and dashboard permissions.",
      "headingPath": [
        "Edit dashboard permissions",
        "Restrict access to dashboards"
      ],
