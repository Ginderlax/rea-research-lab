import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import{createHash}from'node:crypto';
const root=path.join(import.meta.dirname,'editor-search-fix-next'),sha=b=>createHash('sha256').update(b).digest('hex'),focused=JSON.parse(await fs.readFile(path.join(root,'focused-validation.json'),'utf8'));assert.deepEqual(focused.counts,{tests:39,pass:39,fail:0,cancelled:0,skipped:0,todo:0});assert.equal(focused.sourceStable,true);
const before=JSON.parse(await fs.readFile(path.join(focused.run,'before.json'),'utf8'));for(const row of before){const b=await fs.readFile(path.join(root,row.path));assert.equal(sha(b),row.sha256);assert.equal(b.length,row.bytes);}
const originalRun=(await fs.readdir(path.join(root,'runs'))).filter(name=>name.startsWith('original-'));assert.equal(originalRun.length,1);const original=JSON.parse(await fs.readFile(path.join(root,'runs',originalRun[0],'validation.json'),'utf8'));assert.equal(original.failure,null);assert.equal(original.inputGroups,20);assert.equal(original.matchedPositionComparisons,465);assert.equal(original.boundedOriginalEngineInvocations,21);
await fs.writeFile(path.join(root,'freeze-collector.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});
const receipt={schema:'rea-editor-search-corrected-candidate-freeze/v1',frozenAtUtc:new Date().toISOString(),status:'frozen correction awaiting independent review; unaccepted',priorStageReference:JSON.parse(await fs.readFile(path.join(root,'prior-stage-reference.json'),'utf8')),correctionReceipt:JSON.parse(await fs.readFile(path.join(root,'correction-validation.json'),'utf8')),focusedReceipt:{path:'focused-validation.json',sha256:sha(await fs.readFile(path.join(root,'focused-validation.json'))),counts:focused.counts,sourceFiles:focused.sourceFiles},originalReceipt:{path:`runs/${originalRun[0]}/validation.json`,sha256:sha(await fs.readFile(path.join(root,'runs',originalRun[0],'validation.json'))),inputGroups:20,matchedPositionComparisons:465,boundedEngineInvocations:21},currentSources:before,knownPriorFinding:'The prior frozen source lacked an originating-search-generation check before open() publication. This separate candidate carries and checks the search context before mutating file/draft state; independent regression confirmation is pending.',suspectedFindingAcceptedAsPassing:false,candidateAccepted:false,candidateIntegrated:false,productionUnchanged:true,actualBrowserSessions:0,originalWorkBenchOrGUIExecutions:0,fullParity:false,universalSuperiority:false};await fs.writeFile(path.join(root,'validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
const inventory={};async function walk(relative=''){for(const entry of(await fs.readdir(path.join(root,relative),{withFileTypes:true})).sort((a,b)=>a.name<b.name?-1:1)){const name=relative?`${relative}/${entry.name}`:entry.name;if(entry.isDirectory())await walk(name);else{assert.ok(entry.isFile());assert.notEqual(name,'freeze-manifest.json');const b=await fs.readFile(path.join(root,name));inventory[name]={bytes:b.length,sha256:sha(b)};}}}await walk();const manifest={schema:'rea-editor-search-corrected-candidate-preservation/v1',frozenAtUtc:new Date().toISOString(),files:Object.keys(inventory).length,aggregateBytes:Object.values(inventory).reduce((sum,row)=>sum+row.bytes,0),receiptSHA256:sha(await fs.readFile(path.join(root,'validation.json'))),inventory};await fs.writeFile(path.join(root,'freeze-manifest.json'),JSON.stringify(manifest,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:'FROZEN_UNACCEPTED',files:manifest.files,bytes:manifest.aggregateBytes,receiptSHA256:manifest.receiptSHA256,manifestSHA256:sha(Buffer.from(JSON.stringify(manifest,null,2)+'\n'))}));
