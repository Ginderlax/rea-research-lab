    },
    {
      "id": "grafana.candidate.54f7fbbe20666712a556",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The inline editing toggle lets you lock or unlock the canvas. When turned off the canvas becomes “locked”, freezing elements in place and preventing unintended modifications.",
      "headingPath": [
        "Canvas",
        "Configuration options",
        "Canvas options",
        "Inline editing"
      ],
      "source": {
