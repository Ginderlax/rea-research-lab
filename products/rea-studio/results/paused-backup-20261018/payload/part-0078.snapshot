    },
    {
      "id": "grafana.candidate.0d4d2fd851e9bbea1c47",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Before queries are sent to your data source, the query is _interpolated_, meaning the variable is replaced with its current value. During interpolation, the variable value might be _escaped_ to conform to the syntax of the query language and where it's used. For example, variables in InfluxDB or Prometheus regular expression queries are automatically escaped. Read the data source specific documentation topic for details on value escaping during interpolation.",
      "headingPath": [
        "Variable syntax"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/variables/variable-syntax.md",
        "gitBlobSha": "1291d8dfe98a991fac867deb8c57017f558d8663",
        "sha256": "bb736744f0c5aad2caafcb800789e2f649dacb3338ff97c9d0c4ec820e13b042",
        "lineStart": 34,
        "lineEnd": 37,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/dashboards/variables/variable-syntax.md#L34-L37"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
