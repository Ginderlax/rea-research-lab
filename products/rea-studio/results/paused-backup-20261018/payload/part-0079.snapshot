        "lineEnd": 149,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-4.md#L149-L149"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.35f9e9f16168c6a34c60",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To notice a change in your context, look at Grafana's breadcrumbs. If you go from _Home > **Dashboards**_ to _Home > **Explore**_, you've changed context. If you go from _Home > **Dashboards** > Playlist > Edit playlist_ to _Home > **Dashboards** > Reporting > Settings_, you are in the same context.",
      "headingPath": [
        "What’s new in Grafana v10.4",
        "Return to previous"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-4.md",
