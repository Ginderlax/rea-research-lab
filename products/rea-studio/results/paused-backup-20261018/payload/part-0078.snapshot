    {
      "id": "grafana.candidate.1a824f600ffedb3cf608",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set a **Soft min** or **soft max** option for better control of y-axis limits. By default, Grafana sets the range for the y-axis automatically based on the dataset.",
      "headingPath": [
        "Placement",
        "Scale",
        "Soft min and soft max"
      ],
      "source": {
        "path": "docs/sources/shared/visualizations/axis-options-2.md",
