    {
      "id": "grafana.candidate.944db4ac5224828bccf5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To complete this task, you must first have a SOCKS5 proxy server running, using host certificates signed by a Certificate Authority (CA) that you can get the public certificate for. You must also have a TLS client key pair for Grafana, with the client certificate signed by the same CA used to sign the proxy server certificate.",
      "headingPath": [
        "Configure a data source SOCKS5 connection proxy",
        "Before you begin"
      ],
