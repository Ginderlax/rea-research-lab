    {
      "id": "grafana.candidate.1d06c69d8d71b68399f8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Some data sources let you provide custom \"display names\" for the values. For instance, the PostgreSQL, MySQL, and Microsoft SQL Server plugins handle this by looking for fields named `__text` and `__value` in the result. Other data sources may look for `text` and `value` or use a different approach. Always remember to double-check the documentation for the data source.",
      "headingPath": [
        "Add variables",
        "Add a query variable",
        "Query type"
      ],
      "source": {
