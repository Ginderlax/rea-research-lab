    {
      "id": "grafana.candidate.0fea4e4c1e21eb0c6f97",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana 7.4 includes the following enhancements",
      "headingPath": [
        "What's new in Grafana v7.4",
        "Grafana OSS features",
        "Elasticsearch data source updates"
