    {
      "id": "grafana.candidate.390de4f9e0d62830e3df",
      "syntaxRole": "list-item",
      "sourceText": "- Which approach should I use when assigning roles? Should I use the Grafana UI, provisioning, or the API?",
      "headingPath": [
        "Plan your RBAC rollout strategy"
      ],
      "source": {
        "path": "docs/sources/administration/roles-and-permissions/access-control/plan-rbac-rollout-strategy/index.md",
        "gitBlobSha": "bfb1abe7463e753a27609a4020b4982dca3c3166",
        "sha256": "ff1b64f680c6f29b73014551d40e3c834698e27630901a79b72290900d74f2a6",
        "lineStart": 56,
        "lineEnd": 56,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/roles-and-permissions/access-control/plan-rbac-rollout-strategy/index.md#L56-L56"
      },
