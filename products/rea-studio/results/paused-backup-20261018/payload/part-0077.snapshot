    {
      "id": "grafana.candidate.a15e0cf820d3c5ff869f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Make sure to include the tenant IDs of all the federated Users' root directory if your Entra ID contains external identities.",
      "headingPath": [
        "Configure Microsoft Entra ID OAuth authentication",
        "Configure the Entra ID authentication client using the Grafana configuration file",
        "Configure allowed tenants"
