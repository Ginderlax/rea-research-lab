import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import {spawn} from 'node:child_process';
const here=path.dirname(fileURLToPath(import.meta.url));
const files=['candidate/native.mjs','candidate/routing.mjs','candidate/native-server.mjs','candidate/core.mjs','candidate/engine.mjs','candidate/server.mjs','candidate/native-client.mjs','candidate/native-example.mjs','routing.test.mjs','routing-original.test.mjs','original-harness.mjs','original-manifest.json','contracts.json','README.md','source-inventory.mjs','source-option-inventory.json','unreachable-pending.probe.mjs','disabled-trigger.probe.mjs','prior-native.test.mjs','prior-native-http.test.mjs','prior-native-server.test.mjs','prior-original-harness.mjs','test-host.mjs','preserved-storage.mjs','prepare-regressions.mjs','prepare-ui.mjs','ui-host.mjs','run-focused.mjs'];
const hash=bytes=>createHash('sha256').update(bytes).digest('hex'),before={};
const run=path.join(here,'runs',new Date().toISOString().replaceAll(':','-'));await fs.mkdir(run,{recursive:true});
for(const file of files){const bytes=await fs.readFile(path.join(here,file));before[file]={bytes:bytes.length,sha256:hash(bytes)};await fs.mkdir(path.dirname(path.join(run,'source',file)),{recursive:true});await fs.writeFile(path.join(run,'source',file),bytes);}
const results=[];
async function command(label,args){
 let output='';const started=performance.now(),child=spawn(process.execPath,args,{cwd:here,windowsHide:true,stdio:['ignore','pipe','pipe']});for(const stream of [child.stdout,child.stderr])stream.on('data',bytes=>{output+=bytes.toString();if(output.length>8*1024*1024){child.kill();throw new Error('Test log exceeds8MiB');}});
 const exitCode=await new Promise((resolve,reject)=>{child.on('error',reject);child.on('exit',resolve);});await fs.writeFile(path.join(run,label+'.log'),output);const result={label,exitCode,durationMs:Math.round(performance.now()-started),tests:Number(output.match(/^# tests (\d+)/m)?.[1]??0),passed:Number(output.match(/^# pass (\d+)/m)?.[1]??0),failed:Number(output.match(/^# fail (\d+)/m)?.[1]??0),skipped:Number(output.match(/^# skipped (\d+)/m)?.[1]??0)};results.push(result);console.log(JSON.stringify(result));return exitCode;
}
await command('existing-source-reachability',['unreachable-pending.probe.mjs']);
await command('existing-source-trigger-identity',['disabled-trigger.probe.mjs']);
await command('native-stage',['--test','--test-reporter=tap','routing.test.mjs']);
await command('released-original',['--test','--test-reporter=tap','routing-original.test.mjs']);
await command('prior-native-regressions',['--test','--test-reporter=tap','prior-native.test.mjs','prior-native-http.test.mjs','prior-native-server.test.mjs']);
await command('ui-syntax',['--check','candidate/native-client.mjs']);
await command('ui-example-syntax',['--check','candidate/native-example.mjs']);
const after={};for(const file of files){const bytes=await fs.readFile(path.join(here,file));after[file]={bytes:bytes.length,sha256:hash(bytes)};}
for(const artifact of ['unreachable-pending.baseline.json','disabled-trigger.baseline.json','original-results.json']){try{await fs.copyFile(path.join(here,artifact),path.join(run,artifact));}catch(error){if(error.code!=='ENOENT')throw error;}}
const sourceStable=JSON.stringify(before)===JSON.stringify(after),receipt={createdAt:new Date().toISOString(),sourceStable,before,after,results,runPath:path.relative(here,run).replaceAll('\\','/')};await fs.writeFile(path.join(run,'run.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({sourceStable,runPath:receipt.runPath}));if(!sourceStable||results.some(r=>r.exitCode!==0||r.skipped))process.exitCode=1;
