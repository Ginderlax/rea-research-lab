    {
      "id": "grafana.candidate.fd1793038478a9f12b99",
      "syntaxRole": "table-row",
      "sourceText": "| Alpha | `v1alpha1` | Early development stage. Unstable, may contain bugs, and subject to removal | For testing new features | No                  |",
      "headingPath": [
