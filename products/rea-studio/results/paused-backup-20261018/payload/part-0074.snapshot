    {
      "id": "grafana.candidate.323c2e0e78905756318b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Plugin signature verification, also known as _signing_, is a security measure to make sure plugins haven't been tampered with. Upon loading, Grafana checks to see if a plugin is signed or unsigned. Read more in [Plugin signatures](plugin-sign).",
      "headingPath": [
        "Plugin management",
        "Manage your plugins",
        "Verify your plugins"
      ],
