{
  "schema_version": 1,
  "title": "Release and documentation crosswalk for four system products",
  "recorded_date": "2026-10-12",
  "accepted_scope": "Every documented feature of the pinned original complete products; all requested comparison dimensions. This record does not narrow or declare that scope satisfied.",
  "all_products_complete": false,
  "inventory_complete": false,
  "status_legend": {
    "implemented-local-subset": "Tests demonstrate the current local application's stated subset only; original full contract/parity remains unverified.",
    "not-implemented": "No compatible new-application implementation exists. Prior bounded research code is separate.",
    "not-inventoried": "Documentation/options/platform expansion is still pending; absence is not a waiver."
  },
  "reproducibility": {
    "root_for_paths": "repository root",
    "commands": [
      "cd products/rea-studio; npm test",
      "For each source URL below: fetch its bytes and compare SHA-256; use recorded commit URLs for source documents.",
      "Verify original artifact digest before reproducing recorded read-only CLI inventory commands with synthetic/no configuration.",
      "Use projects/07-keepass and projects/08-7zip acquisition records to locate shipped CHM carriers; do not treat an extraction exit status as successful topic enumeration.",
      "node --test products/rea-studio/apps/vault/app.test.mjs products/rea-studio/apps/vault/app.integration.test.mjs products/rea-studio/apps/vault/kdbx.test.mjs products/rea-studio/apps/vault/kdbx.interop.test.mjs"
    ],
    "source_retention": "This crosswalk stores URL/commit/blob/content digests and catalog metadata, not redistributed vendor manual text. Complete frozen content retention and licensing review remain pending.",
    "tree_digest_note": "Git tree response hashes bind observed API responses, not a publisher cryptographic signature.",
    "local_evidence": "Verify local_implementation_evidence paths by SHA-256 and bytes. KeePass fixture tests verify the preserved binary before loading it and explicitly skip if unavailable; a skip is not interoperability evidence."
  },
  "completion_gates": [
    {
      "id": "SYSTEM.GATE.RELEASE",
      "status": "incomplete",
      "requirement": "Verify every complete-product release/artifact and supported-platform mapping; Extra/component evidence must not substitute for full products."
    },
    {
      "id": "SYSTEM.GATE.INVENTORY",
      "status": "incomplete",
      "requirement": "Freeze release-bound documentation and enumerate every documented behavior, option, format, command and provider requirement with traceable IDs."
    },
    {
      "id": "SYSTEM.GATE.ORIGINALFIXTURES",
      "status": "incomplete",
      "requirement": "Acquire executable original-behavior acceptance fixtures for every requirement; do not equate self-roundtrip tests with compatibility."
    },
    {
      "id": "SYSTEM.GATE.PARITY",
      "status": "incomplete",
      "requirement": "All registered requirements must pass original-compatible fixtures on their documented supported platforms."
    },
    {
      "id": "SYSTEM.GATE.IMPROVEMENT",
      "status": "incomplete",
      "requirement": "Publish comparative speed/resources/usability/compatibility/reliability protocols, measurements, losses and uncertainty. No system-product comparison is presently established."
    },
    {
      "id": "SYSTEM.GATE.READINESS",
      "status": "incomplete",
      "requirement": "Evaluate security, failure recovery, concurrency, large data, migration and sustained operation before product readiness."
    }
  ],
