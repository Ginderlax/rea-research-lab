newbrowser=code(candidate/'products/rea-studio/scripts/verify-cloud-browser.mjs')
ob,nb=funcs(oldbrowser),funcs(newbrowser)
browser_stable=[]
for name in ob:
    if name=='verifyNotesBrowserPhase':
        assert nb[name].replace('  if(notesInstalledScope)return verifyInstalledNotesBrowserPhase();\n','')==ob[name]
    elif name=='installedBrowser':
        # The formerly adjacent Notes function remains outside this extracted span.
        assert nb[name]==ob[name]
    else:
        # Last function includes the main/finally dispatch, which has the one new installed branch.
        if name==list(ob)[-1]:continue
        assert nb[name]==ob[name],name
        browser_stable.append(name)

producer=code(candidate/'scripts/verify-cloud-publication.mjs')
tooling=literal(producer,'NOTES_INSTALLED_TOOLING')
assert len(tooling)==4
for p,(size,sha) in tooling.items():pin(read(candidate/p),{'bytes':size,'sha256':sha})
oldproducer=code(phase12/'candidate/scripts/verify-cloud-publication.mjs')
assert literal(producer,'NOTES_REVIEWED')==literal(oldproducer,'NOTES_REVIEWED')
assert len(literal(producer,'NOTES_REVIEWED'))==52
assert "sourceFiles:56,proofSourceFiles:52,installedToolingSourceFiles:4" in producer
assert 'notesRows.length<64&&notesBytes<=8*1024*1024' in producer
assert 'content.length<=256*1024' in producer and 'notesEnvelope.length<=8*1024*1024' in producer and 'notesGzip.length<=4*1024*1024' in producer
controls=code(candidate/'scripts/publication-integrity-controls.mjs')
oldcontrols=code(phase12/'candidate/scripts/publication-integrity-controls.mjs')
producer_pin=identity(read(candidate/'scripts/verify-cloud-publication.mjs'))
newpin=json.dumps(producer_pin,separators=(',',':'))
