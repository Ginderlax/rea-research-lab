    {
      "id": "grafana.candidate.51660c34f657c245d3b1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Usernames and email addresses are now treated as case-insensitive in Grafana. If you're not using MySQL as a database, potential user identity conflicts may arise when users try to log in. We recommend you resolve any potential conflicts in advance by using the [Grafana CLI tool for managing user conflicts](/blog/2022/12/12/guide-to-using-the-new-grafana-cli-user-identity-conflict-tool-in-grafana-9.3/).",
      "headingPath": [
        "Upgrade to Grafana v10.0",
        "Technical notes",
        "Case-insensitive usernames and email addresses"
      ],
      "source": {
        "path": "docs/sources/upgrade-guide/upgrade-v10.0/index.md",
        "gitBlobSha": "dd17de6d803d293f6310407d7596f0488e510810",
        "sha256": "52030e0eb258ef2a3a422fc961da29d64d86c6314cc68fa8be47c0394340a21d",
        "lineStart": 91,
        "lineEnd": 92,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/upgrade-guide/upgrade-v10.0/index.md#L91-L92"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
