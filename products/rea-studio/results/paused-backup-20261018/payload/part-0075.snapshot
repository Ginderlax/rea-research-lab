    },
    {
      "id": "grafana.candidate.a6218e34a18c2bb35dd0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The `decrypters` list controls which Grafana services can decrypt a secret. If a service isn't in the list, it can't read the plaintext value, even if it has access to the secure value's metadata. An empty or unset list means no service can decrypt the value.",
      "headingPath": [
        "Use Terraform to provision secure values",
        "Define a secure value",
        "Decrypters"
      ],
