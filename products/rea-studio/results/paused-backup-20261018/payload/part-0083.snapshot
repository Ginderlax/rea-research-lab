function Pin([string]$f){@{bytes=(Get-Item -LiteralPath $f).Length;sha256=(Get-FileHash -LiteralPath $f -Algorithm SHA256).Hash.ToLowerInvariant()}}
function Match($a,$b){if($a.bytes -ne $b.bytes -or $a.sha256 -cne $b.sha256){throw 'Exact source identity mismatch'}}
function Safe([string]$p){if($p -match '[\\:\x00-\x1f\x7f]' -or $p.StartsWith('/') -or @($p.Split('/')|Where-Object {$_ -in @('','.', '..')}).Count){throw 'Noncanonical source path'}}
