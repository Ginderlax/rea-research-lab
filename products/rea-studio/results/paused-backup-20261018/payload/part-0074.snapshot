    },
    {
      "id": "grafana.candidate.b2ddfc49fdda24584d9d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you set `allowUiUpdates` to `false`, you can't save changes to a provisioned dashboard. When you try to save changes to a provisioned dashboard, Grafana brings up a _Cannot save provisioned dashboard_ dialog box.",
      "headingPath": [
