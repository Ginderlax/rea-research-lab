    {
      "id": "grafana.candidate.ac24ddf87ae2cb040c5b",
      "syntaxRole": "table-row",
      "sourceText": "| Deduplication                         | **None** does not perform any deduplication, **Exact** matches are done on the whole line except for date fields. **Numbers** matches are done on the line after stripping out numbers such as durations, IP addresses, and so on. **Signature** is the most aggressive deduplication as it strips all letters and numbers and matches on the remaining whitespace and punctuation. |",
      "headingPath": [
        "Logs in Explore",
        "Logs",
        "Visualization options"
      ],
