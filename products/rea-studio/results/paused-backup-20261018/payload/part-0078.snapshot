    {
      "id": "grafana.candidate.affb06864932d78f1fd1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "It's a good practice to use folders to organize collections of related dashboards. You can assign permissions at the folder level to individual users or teams.",
      "headingPath": [
        "Introduction",
        "Manage resource access with folders"
      ],
      "source": {
