    },
    {
      "id": "grafana.candidate.b405a522702308bc5cac",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use prefix matching when you want to surface a group of related alarms, for example, all production alarms that trigger a specific SNS action. To do this, set **Enable Prefix Matching** on, then set **Alarm Name** to `prod-` and **Action** to the ARN prefix of your SNS topic, such as `arn:aws:sns:us-east-1:123456789012:prod-`.",
      "headingPath": [
        "Amazon CloudWatch annotations",
        "Create an annotation query",
        "Match alarms by prefix"
      ],
      "source": {
