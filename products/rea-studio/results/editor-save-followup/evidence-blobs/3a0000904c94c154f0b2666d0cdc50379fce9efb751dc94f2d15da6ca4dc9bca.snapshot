import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const here=import.meta.dirname,work=path.resolve(here,'..'),hash=b=>createHash('sha256').update(b).digest('hex'),ident=async p=>{const b=await fs.readFile(p);return{bytes:b.length,sha256:hash(b)}},write=async(n,x)=>fs.writeFile(path.join(here,n),JSON.stringify(x,null,2)+'\n',{flag:'wx'}),run=JSON.parse(await fs.readFile(path.join(here,'run-validation.json')));assert(run.acceptedFiniteCases);assert.deepEqual(run.counts,{tests:14,pass:14,fail:0,cancelled:0,skipped:0,todo:0});
async function walk(base,prefix=''){const rows=[];for(const e of await fs.readdir(base,{withFileTypes:true})){assert(!e.isSymbolicLink());if(e.isDirectory())rows.push(...await walk(path.join(base,e.name),prefix+e.name+'/'));else rows.push(prefix+e.name);}return rows.sort();}
const after=[];for(const e of run.epochsAfter){const base=path.join(work,e.folder),mb=await fs.readFile(path.join(base,e.manifest.path));assert.equal(hash(mb),e.manifest.sha256);const m=JSON.parse(mb);assert.deepEqual((await walk(base)).filter(p=>p!==e.manifest.path),Object.keys(m.inventory).sort());for(const[rel,r]of Object.entries(m.inventory))assert.deepEqual(await ident(path.join(base,rel)),r);after.push({...e,allExactAfterFinalDocumentation:true});}
await write('inspection-notes.json',{schema:'rea-editor-save-review-inspection-notes/v1',candidateProbeFailures:0,metadataOnlyIssue:{operation:'Read selected client lines using Select-Object -Index (28..48),(124..148).',result:'PowerShell could not convert two arrays to Int32 index parameter; no source mutation or candidate execution. The same frozen Save block was subsequently read successfully using rg.',classification:'source-inspection command error, not an application failure'},broadGenericRunNonSaveLifecycleNotTested:true,sourceOnlyPreparationCommandsSucceeded:true});
const observationRows=[];for(const rel of(await walk(path.join(here,'runs'))).filter(r=>r.endsWith('/observation.json'))){const p='runs/'+rel;observationRows.push({path:p,...await ident(path.join(here,p))});}assert.equal(observationRows.length,14);const review={schema:'rea-editor-save-correction-independent-final/v1',at:new Date().toISOString(),acceptedFiniteSubset:true,remainingConfirmedSaveFindings:[],summary:run.counts,exactOldSevenUiBodies:true,exactOldThreeQueuedRevisionBodies:true,freshHeldOutGroups:4,run:{path:'run-validation.json',...await ident(path.join(here,'run-validation.json'))},sourceBefore:run.epochsBefore,sourceAfter:after,allFourInventoriesExact:true,acceptedCandidateSources:run.candidateSourceSnapshots,raw:{stdout:run.stdout,stderr:run.stderr},observations:observationRows,controllerDeadlineMilliseconds:60000,controllerMaxBufferPerStreamBytes:2097152,testControllerProcesses:1,perFileTestWorkerProcesses:3,universalDescendantIsolationEstablished:false,productionModified:false,originalEngineExecutions:0,httpHosts:0,browserExecutions:0,benchmarks:0,sourceAssistedPrimitiveOriginalComparisonCountsUnchangedHistorical:true,negativeDiskCommitAndDraftLossRemainDistinct:true,directMutableCallerScopeNotHttpObjectSharing:true,completeParity:false,securityParity:false,superiority:false,limits:'Finite actual-client/actual-Save-handle element model and owned synthetic filesystem; external filesystem races, generic non-Save lifecycle commands, renderer reload durability, original workbench/API parity and actual browser acceptance are unverified here.'};await write('review-validation.json',review);
const inventory={};for(const rel of await walk(here))if(!['freeze-manifest.json'].includes(rel))inventory[rel]=await ident(path.join(here,rel));await write('freeze-manifest.json',{schema:'rea-editor-save-correction-independent-freeze/v1',frozenAt:review.at,files:Object.keys(inventory).length,totalBytes:Object.values(inventory).reduce((n,r)=>n+r.bytes,0),receiptSHA256:(await ident(path.join(here,'review-validation.json'))).sha256,inventory});console.log(JSON.stringify({review:await ident(path.join(here,'review-validation.json')),manifest:await ident(path.join(here,'freeze-manifest.json')),files:Object.keys(inventory).length,tests:14,sourceStable:true,remainingConfirmedSaveFindings:0}));
