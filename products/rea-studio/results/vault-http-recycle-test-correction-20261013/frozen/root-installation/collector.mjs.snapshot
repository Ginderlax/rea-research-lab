import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const base=path.resolve(import.meta.dirname,'..'),lab=path.join(base,'outputs/rea-research-lab'),source=path.join(base,'work/vault-http-recycle-integration-next'),out=path.join(base,'work/vault-http-recycle-test-installation'),prefix='products/rea-studio/results/vault-http-recycle-test-correction-20261013',folder=path.join(lab,prefix),hash=b=>createHash('sha256').update(b).digest('hex');assert.equal(fs.existsSync(folder),false);assert.equal(fs.existsSync(out),false);
const mb=fs.readFileSync(path.join(source,'manifest.json'));assert.equal(hash(mb),'75960e2338968b82e2402ef2c6ec30dc4c3a6b98db966906845836154bdf89b0');const m=JSON.parse(mb);assert.equal(m.records.length,41);for(const r of m.records){const b=fs.readFileSync(path.join(source,r.path));assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);}
const vb=fs.readFileSync(path.join(source,'validation.json'));assert.equal(hash(vb),'7278192cc00bbfe1f4e23afe4f7c0927b6876bde628bc1be5815ee2a2fd8d1d2');const v=JSON.parse(vb),map=JSON.parse(fs.readFileSync(path.join(source,'integration-map.json')));assert.equal(v.baselineRun.summary.fail,1);assert.equal(v.correctedRun.summary.pass,2);assert.equal(v.correctedRun.sourceStable,true);assert.equal(v.sourceBefore.length,11);for(const r of v.sourceBefore){const b=fs.readFileSync(path.join(lab,r.path));assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);}
const proposed=fs.readFileSync(path.join(source,map.proposal.path)),dest=path.join(lab,map.destination);assert.equal(proposed.length,12648);assert.equal(hash(proposed),'09843c298d01af36937568ffa20dbbf25ec4e8ad10ea1abdff9d167e13942127');assert.equal(map.firstTestBodyByteIdentical,true);assert.equal(map.preDeleteKDBXAssertionsByteIdentical,true);fs.mkdirSync(out);fs.writeFileSync(path.join(out,'collector.mjs.snapshot'),fs.readFileSync(import.meta.filename),{flag:'wx'});fs.writeFileSync(dest,proposed);
for(const r of v.sourceBefore){const b=fs.readFileSync(path.join(lab,r.path));if(r.path===map.destination)assert.equal(hash(b),map.proposal.sha256);else{assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);}}
const installed={schema:'rea-vault-http-recycle-test-production-installation/v1',at:new Date().toISOString(),destination:map.destination,before:map.before,after:map.proposal,sourceManifestSHA256:hash(mb),sourceValidationSHA256:hash(vb),changedFiles:1,unchangedAdjacentSourceFiles:10,runtimeChanged:false,behavioralTestsRunByInstaller:0,originalExecutions:0,prior138ReceiptRebound:false,fullProductParity:false,universalSuperiority:false};fs.writeFileSync(path.join(out,'installation.json'),JSON.stringify(installed,null,2)+'\n',{flag:'wx'});
const freeze=fs.readFileSync(path.join(source,'freeze.json')),collector=fs.readFileSync(import.meta.filename),ib=fs.readFileSync(path.join(out,'installation.json')),extra=[{path:'freeze.json',bytes:freeze.length,sha256:hash(freeze),content:freeze},{path:'root-installation/collector.mjs',bytes:collector.length,sha256:hash(collector),content:collector},{path:'root-installation/installation.json',bytes:ib.length,sha256:hash(ib),content:ib}],rows=[...m.records,{path:'manifest.json',bytes:mb.length,sha256:hash(mb)},...extra],copies=[];
for(const r of rows){const b=r.content??fs.readFileSync(path.join(source,r.path));assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);assert(!(b[0]===0x4d&&b[1]===0x5a));assert(!(b[0]===0x50&&b[1]===0x4b));const n='frozen/'+r.path+'.snapshot';fs.mkdirSync(path.dirname(path.join(folder,n)),{recursive:true});fs.writeFileSync(path.join(folder,n),b,{flag:'wx'});copies.push({sourcePath:r.path,path:n,bytes:r.bytes,sha256:r.sha256});}
for(const r of m.records)assert.equal(hash(fs.readFileSync(path.join(source,r.path))),r.sha256);assert.equal(copies.length,45);const record={schema:'rea-frozen-followup-public-subset/v1',sourceStage:'vault-http-recycle-integration-next',originalManifest:{sourcePath:'manifest.json',bytes:mb.length,sha256:hash(mb)},originalFrozenArtifacts:41,publicSnapshots:45,extraSelfCarriers:extra.map(r=>({sourcePath:r.path,bytes:r.bytes,sha256:r.sha256})),excludedLocalCarriers:[],allSourceBytesStableBeforeAfter:true,allPublicCopiesExact:true,allSnapshotsInert:true,copies,fullProductParity:false,universalSuperiority:false};const pb=Buffer.from(JSON.stringify(record,null,2)+'\n');fs.writeFileSync(path.join(folder,'preservation-manifest.json'),pb,{flag:'wx'});
const registry=path.join(lab,'products/rea-studio/requirements/system-products.json'),rb=fs.readFileSync(registry);fs.writeFileSync(path.join(out,'system-products.before.json.snapshot'),rb,{flag:'wx'});const req=JSON.parse(rb),originalSources=JSON.stringify(req.sources);let updated=0;for(const p of req.products)for(const r of p.local_implementation_evidence??[])if(r.path===map.destination){r.bytes=proposed.length;r.sha256=hash(proposed);updated++;}assert.equal(updated,1);assert.equal(JSON.stringify(req.sources),originalSources);fs.writeFileSync(registry,JSON.stringify(req,null,2)+'\n');console.log(JSON.stringify({installedTest:map.destination,snapshots:45,preservationSHA256:hash(pb),installationSHA256:hash(ib),runtimeChanged:false,registryEntriesUpdated:updated}));
