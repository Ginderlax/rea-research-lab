        "lineStart": 174,
        "lineEnd": 174,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/influxdb/template-variables/index.md#L174-L174"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
