    {
      "id": "grafana.candidate.b468f468e20fcf257bf6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Here's the previous example printing now the value of the instant query with Ref ID `A`:",
      "headingPath": [
        "Annotation and label template reference",
        "Variables",
        "$values"
      ],
      "source": {
        "path": "docs/sources/alerting/alerting-rules/templates/reference.md",
