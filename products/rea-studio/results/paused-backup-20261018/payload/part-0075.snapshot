    {
      "id": "grafana.candidate.fbd691db78b44f1353d0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Enable current user authentication in the Grafana server configuration:",
      "headingPath": [
        "Configure the Azure Monitor data source",
        "Configure authentication",
        "Current User",
        "Current User Grafana server configuration"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/configure/index.md",
