    },
    {
      "id": "grafana.candidate.3ebe80a0345c37773ef7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "While upgrading to Grafana v10, you don't need to take any action; your API keys will be automatically migrated. To test or perform the migration from API keys to service accounts before upgrading to Grafana v10, follow our [migration documentation](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/administration/service-accounts/migrate-api-keys/).",
      "headingPath": [
        "Breaking changes in Grafana v10.0",
        "General breaking changes",
        "API keys are migrating to service accounts",
        "Migration path"
      ],
      "source": {
        "path": "docs/sources/breaking-changes/breaking-changes-v10-0.md",
