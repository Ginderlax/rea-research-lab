    },
    {
      "id": "grafana.candidate.1d5044214ee25c67738d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana expands macros into native PostgreSQL SQL before executing the query. When the [TimescaleDB](https://www.timescale.com/) extension is enabled, `$__timeGroup` and `$__timeGroupAlias` use `time_bucket()` for more efficient grouping.",
      "headingPath": [
        "PostgreSQL query editor",
        "Macros"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/query-editor/_index.md",
