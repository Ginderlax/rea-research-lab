      "exactSourceSnapshot": "import assert from 'node:assert/strict';\nimport * as fs from 'node:fs/promises';\nimport path from 'node:path';\nimport os from 'node:os';\nimport {createHash} from 'node:crypto';\nimport {execFile} from 'node:child_process';\nimport {promisify} from 'node:util';\nimport {fileURLToPath} from 'node:url';\nimport {RabinBoundaries,MIN,MAX} from './rabin.mjs';\nimport {hash,open,seal,passwordKey,masterKey,validPolynomial} from './restic-crypto.mjs';\nconst exec=promisify(execFile),MiB=1024*1024,exe=path.resolve('outputs/rea-research-lab/projects/09-restic/artifacts/unpacked/restic_0.19.1_windows_amd64.exe'),archive=path.resolve('outputs/rea-research-lab/projects/09-restic/artifacts/restic_0.19.1_windows_amd64.zip'),testPassword='own-rabin-original-boundary-fixtures-only';\nfunction fixtureBytes(length){const out=Buffer.alloc(length);for(let offset=0;offset<length;offset+=32)createHash('sha256').update(`independent-rabin-corpus:${offset}`).digest().copy(out,offset,0,Math.min(32,length-offset));return out;}\nfunction fixturePolynomials(){const rows=['3da3358b4dc173'];for(let trial=0;rows.length<3;trial++){const digest=createHash('sha256').update(`independent-rabin-polynomial:${trial}`).digest('hex'),value=((BigInt(`0x${digest.slice(0,14)}`)&((1n<<53n)-1n))|(1n<<53n)|1n).toString(16);if(validPolynomial(value)&&!rows.includes(value))rows.push(value);}return rows;}\nfunction nativeRows(bytes,poly,width=512*1024){const chunker=new RabinBoundaries(poly),rows=[];for(let offset=0;offset<bytes.length;offset+=width)rows.push(...chunker.push(bytes.subarray(offset,offset+width)));rows.push(...chunker.finish());return rows.map(row=>({...row,sha256:hash(bytes.subarray(row.start,row.start+row.length))}));}\nexport async function compareOriginal(){\n const prototypeBytes=await fs.readFile(new URL('rabin.mjs',import.meta.url)),polynomials=fixturePolynomials(),base=fixtureBytes(12*MiB),mutated=Buffer.from(base);for(let offset=5*MiB;offset<5*MiB+7;offset++)mu