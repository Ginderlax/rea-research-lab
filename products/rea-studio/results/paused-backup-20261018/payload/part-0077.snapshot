    {
      "id": "grafana.candidate.9fa51832b2b586b4db59",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This is the full URL used to access Grafana from a web browser. This is important if you use Google or GitHub OAuth authentication (for the callback URL to be correct).",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[server]`",
        "`root_url`"
      ],
