    {
      "id": "grafana.candidate.04c970ff45ffa69415f2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To ensure consistent sorting and coloring, use the `sortByName()` function to order labels alphabetically.",
      "headingPath": [
        "Graphite query editor",
        "Functions",
        "Sort labels"
      ],
      "source": {
