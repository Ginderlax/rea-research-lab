import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import {spawn} from 'node:child_process';
const root=import.meta.dirname,sha=b=>createHash('sha256').update(b).digest('hex'),name=process.argv[2]??'attempt-1',run=path.join(root,'runs',name);await fs.mkdir(run,{recursive:false});
const paths=['acquisition.json','acquire.mjs','inventory.mjs','inventory.test.mjs','parser-loader.mjs','build.mjs','run.mjs','source/vscode.d.ts.snapshot','source/LICENSE.txt.snapshot','source/package.json.snapshot','source/commit.json.snapshot','source/vendor-release-metadata.json.snapshot','parser/npm-metadata.json.snapshot','parser/LICENSE.txt.snapshot','parser/ThirdPartyNoticeText.txt.snapshot','.local/parser/lib/typescript.js','.local/parser/package.json','.local/parser/LICENSE.txt','.local/parser/ThirdPartyNoticeText.txt'];
const capture=()=>Promise.all(paths.map(async p=>{const b=await fs.readFile(path.join(root,p));return{path:p,bytes:b.length,sha256:sha(b)};}));const before=await capture();for(const r of before){const destination=path.join(run,'source',r.path.startsWith('.local/')?'private-parser/'+r.path.slice(7)+'.hash.json':r.path+'.snapshot');await fs.mkdir(path.dirname(destination),{recursive:true});if(r.path.startsWith('.local/'))await fs.writeFile(destination,JSON.stringify(r,null,2)+'\n');else await fs.copyFile(path.join(root,r.path),destination);}await fs.writeFile(path.join(run,'source-before.json'),JSON.stringify(before,null,2)+'\n');
const steps=[];for(const [label,args]of[['build',['build.mjs']],['test',['--test','--test-concurrency=1','--test-reporter=tap','inventory.test.mjs']]]){
 const env={...process.env};delete env.NODE_TEST_CONTEXT;const child=spawn(process.execPath,args,{cwd:root,env,windowsHide:true,stdio:['ignore','pipe','pipe']}),chunks={stdout:[],stderr:[]},sizes={stdout:0,stderr:0};let problem=null;const timer=setTimeout(()=>{problem='30second child deadline';child.kill();},30000);for(const stream of ['stdout','stderr'])child[stream].on('data',b=>{sizes[stream]+=b.length;if(sizes[stream]>4*1024*1024){problem='4MiB child output cap';child.kill();}else chunks[stream].push(b);});child.once('error',e=>problem=e.message);const code=await new Promise(r=>child.once('close',r));clearTimeout(timer);for(const stream of ['stdout','stderr'])await fs.writeFile(path.join(run,label+'.'+stream+'.txt'),Buffer.concat(chunks[stream]));steps.push({label,args,code,problem,sizes,stdoutSHA256:sha(Buffer.concat(chunks.stdout)),stderrSHA256:sha(Buffer.concat(chunks.stderr))});if(code!==0||problem)break;
}
const after=await capture(),stable=JSON.stringify(before)===JSON.stringify(after);await fs.writeFile(path.join(run,'source-after.json'),JSON.stringify(after,null,2)+'\n');const receipt={at:new Date().toISOString(),steps,sourceStable:stable,inputSources:before,originalProgramExecutions:0,productionModified:false,registryModified:false};await fs.writeFile(path.join(run,'validation.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({steps,sourceStable:stable}));if(!stable||steps.some(s=>s.code||s.problem))process.exitCode=1;
