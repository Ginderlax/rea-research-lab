    {
      "id": "grafana.candidate.2d79ac342b64f87daa9a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Important note**: While it is possible to configure Grafana to allow email-based user lookups, we strongly recommend against this approach in most cases due to potential security risks. If you still choose to proceed, the following configuration can be applied to enable email lookup.",
      "headingPath": [
        "Configure authentication",
        "Extended authentication settings",
        "Enable email lookup"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/_index.md",
