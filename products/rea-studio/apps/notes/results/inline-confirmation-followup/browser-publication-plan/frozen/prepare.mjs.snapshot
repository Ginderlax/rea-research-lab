assert.deepEqual(await authenticateEpoch(workspace,prior),old);assert.deepEqual(await authenticateEpoch(workspace,browser),actual);for(let i=0;i<EPOCHS.length;i++)assert.deepEqual(await authenticateEpoch(workspace,EPOCHS[i]),historical[i]);await json('authentication-after.json',{prior162Exact:true,browser87Exact:true,priorFour566Exact:true,currentInstalled34Exact:true,requirements159Sha232IdsReferencedUnchanged:true,currentStudioWrites:0,newTests:0,newOriginalExecutions:0,newBrowsers:0});await json('validation.json',{schema:'rea-notes-inline-browser-publication-addendum-validation/v1',at:new Date().toISOString(),sourceOnly:true,priorPlanFiles:162,newBrowserPayloads:87,strictFiveBehaviorEpochPayloads:653,priorInstallationPayloads:7,priorPlanAdditionalPayloads:162,totalInputPathRecordsIncludingSevenManifests:829,publicRecords:818,excludedLocal:11,uniquePublicByteObjects:new Set(payload.map(r=>r.sha256)).size,installedProposalFiles:8,historical34Exact:true,oldClientC57PreservedAsHistorical:true,currentCorrectedCandidateClient:v.clientSHA256,backendChanges:0,StudioWrites:0,tests:0,originalExecutions:0,browserExecutionsByAddendum:0,finiteIndependent22AndActualBrowser8Accepted:true,rootPlanReview:false,productionInstalled:false,oldFrozen162PendingBrowserClaimRetained:true,priorFourEpochsUnmodified:true,browserUploadAccepted:false,permissionChange:false,downloadBridgeTimeoutPreserved:true,wholeProductParity:false,securityEquivalence:false,superiority:false});
