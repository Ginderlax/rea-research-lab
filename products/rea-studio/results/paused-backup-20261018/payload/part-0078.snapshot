    },
    {
      "id": "grafana.candidate.2a89db41e9f2796cfd9d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For Tempo, refer to [Trace to profiles](/docs/grafana/<GRAFANA_VERSION>/datasources/tempo/configure-tempo-data-source/configure-trace-to-profiles/) for configuration instructions.",
      "headingPath": [
        "Traces in Explore",
