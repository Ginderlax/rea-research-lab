    {
      "id": "grafana.candidate.d9db792b608fd864cdbc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This allows you to provide added context to the dashboard when someone navigates to it.",
      "headingPath": [
