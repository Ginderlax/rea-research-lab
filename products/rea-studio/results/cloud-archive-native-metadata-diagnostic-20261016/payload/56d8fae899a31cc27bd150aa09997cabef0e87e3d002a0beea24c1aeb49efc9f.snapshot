assert.equal(artifacts.total_count,1);assert.equal(artifacts.artifacts.length,1);const artifact=artifacts.artifacts[0];assert.equal(String(artifact.id),ARTIFACT);assert.equal(artifact.name,'archive-native-diagnostic-'+RUN+'-1');assert.equal(artifact.expired,false);assert.equal(String(artifact.workflow_run.id),RUN);assert.equal(artifact.workflow_run.head_sha,HEAD);assert.equal(artifact.size_in_bytes,276192);assert.equal(artifact.digest,'sha256:c902dd084fd20ed412af248fe7161680e1a30ab1ba27caf77b724817581db44f');same(raw('exact-original-uploaded-outer-zip'),{bytes:276192,sha256:artifact.digest.slice(7)});
assert.equal(commit.sha,HEAD);assert.equal(tree.sha,commit.tree.sha);assert.equal(tree.sha,'4e7810dd96cd1137f3dffcb873c1ddb02136b131');assert.equal(tree.truncated,false);assert(tree.tree.length<=100000);
assert.equal(report.schema,'rea-local-native-metadata-diagnostic-backup/v1');assert.equal(report.runId,RUN);assert.equal(report.jobId,JOB);assert.equal(report.headSHA,HEAD);assert.equal(report.artifactId,ARTIFACT);assert.equal(report.allCRCAndBytesReadable,true);assert.equal(report.diagnosticFiveChecksAccepted,true);assert.equal(report.nativeObservationsQualified,true);assert.equal(report.completeTwoWorkerObservations,true);assert.deepEqual(report.auditErrors,[]);assert.equal(report.files.length,78);same(raw('exact-original-uploaded-outer-zip'),report.artifactIdentity);same(raw('exact-portable-inner-evidence-zip'),report.portableEvidenceArchiveIdentity);
assert.equal(report.historicalD24CauseProven,false);assert.equal(report.fullSuiteAcceptance,false);assert.equal(report.fullParity,false);assert.equal(report.superiority,false);for(const key of ['localCandidateExecutions','localProductExecutions','localTests','localBuilds','localSyntaxChecks'])assert.equal(report[key],0);
for(const phase of ['actualApiAndArtifact','exactCommittedSourceAndIndependentPostcheck','nativeObservationSourceAndSchema','fiveChecksAndCompleteAttempt'])assert.equal(report.qualification[phase].valid,true);
const binding=json('exact-run-binding-authority'),template=json('approved-unbound-r3-template-authority');assert.equal(binding.runId,RUN);assert.equal(binding.jobId,JOB);assert.equal(binding.headSHA,HEAD);assert.equal(binding.readerOrCollectorExecutions,0);assert.equal(binding.apiCollectionExecutions,0);assert.equal(binding.allByteBoundsSourceTablesAndAcceptanceGatesUnchanged,true);assert.equal(template.fixedSourceRows.length,70);assert.equal(template.sourceBytes,876654);
const expectedRows=template.fixedSourceRows,expectedNames=new Set(expectedRows.map(row=>'source/'+safe(row.path)+'.snapshot'));assert.equal(expectedNames.size,70);
const evidenceBase='work/cloud-verification-backups/run-'+RUN+'/artifact-'+ARTIFACT+'-native-diagnostic-reader-r3-v1/readable-evidence';
const members=new Map();for(const row of report.files){assert(!members.has(row.path));const bytes=read(evidenceBase+'/'+safe(row.path),8*1024*1024);same(bytes,row);members.set(row.path,{row,bytes});}
const evidence=name=>{assert(members.has(name));return members.get(name).bytes;};const observed=name=>JSON.parse(evidence(name).toString('utf8').replace(/^\uFEFF/,''));
const gitBlobs=new Map(tree.tree.filter(row=>row.type==='blob').map(row=>[row.path,row]));
for(const row of expectedRows){const bytes=evidence('source/'+row.path+'.snapshot');same(bytes,row);const blob=gitBlobs.get(row.path);assert(blob);assert.equal(blob.mode,'100644');assert.equal(blob.size,bytes.length);assert.equal(blob.sha,createHash('sha1').update(Buffer.from('blob '+bytes.length+'\0')).update(bytes).digest('hex'));}
const before=observed('source-before.json'),after=observed('source-after.json'),attempt=observed('diagnostic-attempt.json'),workflow=observed('workflow-attempt.json');
const execution={GITHUB_SHA:HEAD,GITHUB_RUN_ID:RUN,GITHUB_RUN_ATTEMPT:'1',GITHUB_JOB:'five-unchanged-archive-checks',GITHUB_REPOSITORY:'Ginderlax/rea-research-lab',RUNNER_ENVIRONMENT:'github-hosted',RUNNER_OS:'Windows',RUNNER_ARCH:'X64'};
assert.equal(before.schema,'rea-archive-native-diagnostic-source/v1');assert.equal(before.status,'verified-unexecuted');assert.equal(after.schema,'rea-archive-native-diagnostic-postcheck/v1');assert.equal(after.status,'source-verified');
for(const item of [before,after]){assert.deepEqual(item.execution,execution);assert.equal(item.sourceCommit,HEAD);assert.deepEqual(item.rows,expectedRows);assert.equal(item.sourceFiles,70);assert.equal(item.sourceBytes,876654);assert.equal(item.allGitBlobsAuthenticated,true);assert.equal(item.sourceOverlay,false);assert.equal(item.productExecutions,0);assert.equal(item.originalExecutions,0);}assert.deepEqual(after.beforeReceipt,identity(evidence('source-before.json')));assert.equal(after.sourceStable,true);
assert.equal(attempt.schema,'rea-archive-native-metadata-diagnostic/v1');assert.equal(attempt.status,'passed-five-instrumented-checks');assert.deepEqual(attempt.execution,execution);assert.equal(attempt.sourceCommit,HEAD);assert.deepEqual(attempt.sourceBefore,identity(evidence('source-before.json')));assert.equal(attempt.exitCode,0);assert.equal(attempt.signal,null);assert.equal(attempt.error,null);assert.deepEqual(attempt.summary,{tests:5,pass:5,fail:0,cancelled:0,skipped:0,todo:0});assert.deepEqual(attempt.stdout,identity(evidence('stdout.txt')));assert.deepEqual(attempt.stderr,identity(evidence('stderr.txt')));
const names=['archive HTTP file creation, ZIP validation and extraction persist through host restarts','stored and deflated ZIP files preserve binary, UTF-8, empty files and directories','ZIP parser validates CRC and headers and refuses traversal, duplicate paths, and oversized expansion','malicious archive cannot create files outside workspace and unconfirmed extraction does not write','Windows .NET independently reads generated ZIP and our parser reads independently created ZIP'];
const stdout=evidence('stdout.txt').toString('utf8');assert.deepEqual([...stdout.matchAll(/^# Subtest: (.+)\r?$/gm)].map(row=>row[1].replace(/\r$/,'')),names);assert.deepEqual([...stdout.matchAll(/^ok (\d+) - (.+)\r?$/gm)].map(row=>[Number(row[1]),row[2].replace(/\r$/,'')]),names.map((name,index)=>[index+1,name]));
for(const [key,value]of Object.entries(attempt.summary)){const rows=[...stdout.matchAll(new RegExp('^# '+key+'\\s+(\\d+)\\s*\\r?$','gm'))];assert.equal(rows.length,1);assert.equal(Number(rows[0][1]),value);}
assert.equal(attempt.command.hook,'scripts/archive-native-metadata-trace.mjs');assert.equal(attempt.command.deadlineMs,300000);assert.equal(attempt.command.inheritedNodeOptions,false);assert.equal(attempt.originalDeadlineMs,15000);assert.equal(attempt.applicationSourceChanged,false);assert.equal(attempt.instrumentedDependencyObserver,true);assert.equal(attempt.productAssertionsChanged,false);assert.equal(attempt.retried,false);assert.equal(attempt.historicalD24CauseProven,false);assert.equal(attempt.traceComplete,true);
assert.equal(workflow.schema,'rea-archive-native-diagnostic-workflow/v1');assert.equal(workflow.sourceCommit,HEAD);assert.equal(workflow.runId,RUN);assert.equal(workflow.runAttempt,'1');for(const key of ['checkout','before','execute','after'])assert.equal(workflow[key],'success');assert.equal(workflow.diagnosticOnly,true);assert.equal(workflow.applicationSourcesChanged,false);assert.equal(workflow.originalMetadataDeadlineMs,15000);assert.equal(workflow.historicalD24CauseProven,false);
const traces=report.qualifiedNativeObservations;assert.equal(traces.length,2);assert.deepEqual(new Map(attempt.traces.map(row=>[row.path,row])),new Map(traces.map(row=>[row.path,row])));const calls=[],workers=new Set();
for(const trace of traces){const bytes=evidence(trace.path);same(bytes,trace);assert.deepEqual(bytes.toString('utf8').trim().split('\n').map(line=>JSON.parse(line)),trace.rows);const match=/^trace\/native-events-([1-9]\d*)\.jsonl$/.exec(trace.path);assert(match);const pid=Number(match[1]);const labels=new Set();for(const[index,row]of trace.rows.entries()){assert.equal(row.schema,'rea-archive-native-exec-observation/v1');assert.equal(row.runId,RUN);assert.equal(row.runAttempt,'1');assert.equal(row.sourceCommit,HEAD);assert.equal(row.processId,pid);assert.equal(row.sequence,index+1);assert.equal(row.scriptSHA256,'76e3ac8e0aeb8b1fa42fbc84ec6956e2e2d044502f5de5e5552e8538f5f4b615');assert.equal(row.timeoutMs,15000);assert.equal(row.maxBuffer,67108864);assert.equal(row.callbackObserved,true);assert.equal(row.error,null);for(const key of ['inputRecorded','outputContentsRecorded','argumentsModified','limitsModified','retried'])assert.equal(row[key],false);labels.add(row.testFile);calls.push(row);}assert.equal(labels.size,1);workers.add([...labels][0]);}
assert.deepEqual([...workers].sort(),['app.integration.test.mjs','app.test.mjs']);assert.equal(calls.length,6);const integration=calls.filter(row=>row.testFile==='app.integration.test.mjs'),application=calls.filter(row=>row.testFile==='app.test.mjs');assert.equal(integration.length,1);assert.equal(application.length,5);assert.equal(integration[0].elapsedMs,4419.2207);assert.deepEqual(application.map(row=>row.elapsedMs),[374.8336,366.6019,366.47789999999986,363.0905,346.3083999999999]);
