import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';const here=import.meta.dirname,sha=bytes=>createHash('sha256').update(bytes).digest('hex'),fp=async file=>{const bytes=await fs.readFile(file);return{bytes:bytes.length,sha256:sha(bytes)};},load=async name=>JSON.parse(await fs.readFile(path.join(here,name)));
const focused=await load('focused-validation.json'),preparation=await load('preparation.json');assert.deepEqual(focused.totals,{tests:41,pass:41,fail:0,cancelled:0,skipped:0,todo:0});for(const [name,row]of Object.entries(focused.sources))assert.deepEqual(await fp(path.join(here,name)),row);for(const row of focused.results){assert.equal(row.exitCode,0);assert.equal(row.signal,null);for(const kind of ['stdout','stderr'])assert.deepEqual(await fp(path.join(here,row[kind].path)),{bytes:row[kind].bytes,sha256:row[kind].sha256});}
for(const binding of preparation.bindings){const bytes=await fs.readFile(path.join(binding.root,'freeze-manifest.json'));assert.equal(sha(bytes),binding.manifestSHA256);const manifest=JSON.parse(bytes);for(const [name,row]of Object.entries(manifest.inventory))assert.deepEqual(await fp(path.join(binding.root,name)),row);}
const changed=[];for(const row of preparation.copiedAcceptedSourceFiles){const current=await fp(path.join(here,row.path));if(current.sha256!==row.sha256)changed.push({path:row.path,before:{bytes:row.bytes,sha256:row.sha256},after:current});}const newPath='products/rea-studio/apps/editor/save-publication.ui.test.mjs';changed.push({path:newPath,before:null,after:await fp(path.join(here,newPath))});assert.deepEqual(changed.map(row=>row.path).sort(),['products/rea-studio/apps/editor/client.mjs','products/rea-studio/apps/editor/server.mjs','products/rea-studio/apps/editor/README.md',newPath].sort());
const observations=[];for(const name of (await fs.readdir(path.join(here,'runs'))).sort()){const relative='runs/'+name+'/observation.json';observations.push({path:relative,...await fp(path.join(here,relative)),observation:await load(relative)});}assert.equal(observations.length,10);const typed=observations.find(row=>row.observation.markerAfterResponse),queued=observations.find(row=>row.observation.id==='mutated-stale');assert.equal(typed.observation.editorValue,'newer unsaved A\n');assert.equal(typed.observation.markerAfterResponse,'a.txt •');assert.match(typed.observation.differenceAfterResponse,/Minimal line edits: 2/);assert.equal(typed.observation.diskA,'captured save A\n');assert.equal(queued.observation.secondResult.accepted,false);assert.equal(queued.observation.diskA,'first committed\n');
const productObservations=[];for(const line of (await fs.readFile(path.join(here,'save-and-search-regression.stdout.txt'),'utf8')).split('\n')){const text=line.replace(/^# /,'');if(text.startsWith('{')&&text.includes('editorSavePublicationObservation'))productObservations.push(JSON.parse(text).editorSavePublicationObservation);}assert.equal(productObservations.length,4);await fs.writeFile(path.join(here,'new-client-observations.json'),JSON.stringify(productObservations,null,2)+'\n',{flag:'wx'});
const acceptedReview=path.resolve(here,'../editor-search-path-independent-review'),acceptanceProof={receipt:await fp(path.join(acceptedReview,'review-validation.json')),manifest:await fp(path.join(acceptedReview,'freeze-manifest.json'))};assert.equal(acceptanceProof.receipt.sha256,'424c2973b77c6c9c8cb4a578f0a73dea2da92f55bc6322c78be17fe38f487553');assert.equal(acceptanceProof.manifest.sha256,'15b9c4b3712b769b1afedd860a7c56b17f5ea54ada4a2f4cd398dd3a18ada897');
const receipt={schema:'rea-editor-save-correction-freeze-validation/v1',frozenAt:new Date().toISOString(),status:'focused source-stable correction; independent acceptance pending',acceptance:false,productionIntegration:false,baseline:{stage:'editor-search-path-fix-next',manifestSHA256:'d071d370be094646a4738de79adadca9c28d794de53dfb940604f5d52d056edf',files:126,independentFiniteAcceptanceProof:acceptanceProof},negativeEpochs:[{stage:'editor-save-independent-review',files:166,receiptSHA256:'2a5ca220fcbea44b692686a8419241ff07f0d9e664d29d5afc3e437ac8b783f4',manifestSHA256:'0fba64bafa48e5235635951f50b17e22d6767e43d8e62836faf1f35d7e6b69fa',tests:7,pass:4,fail:3},{stage:'editor-save-revision-independent-review',files:26,receiptSHA256:'629cb8a2fedc23754049ef24c64ec6ff77dedf15644edd48d73273d6e0d34b48',manifestSHA256:'b1c3146a795e766f00b5d36dd9237ebb883a866a5d03678a4022254060b6e4c9',tests:3,pass:2,fail:1}],allPriorInventoriesBeforeAfterAuthenticated:true,
  focused:{path:'focused-validation.json',...await fp(path.join(here,'focused-validation.json')),totals:focused.totals,sourceFiles:28,sourceBeforeAfterStable:true,groups:focused.results.map(({label,counts,stdout,stderr,...row})=>({...row,label,counts,stdout,stderr}))},changes:changed,
  correctionContracts:['Captured successful write updates saved baseline/revision/bytes while retaining current draft text','Per-document pending flag refuses duplicate save requests without disabling typing or other documents','Success and error publication require mounted view and original document object ownership','Background settlement preserves the currently selected document status','Closed/reopened documents cannot accept an old item response','Direct Save captures declared primitive revision before any await or exclusive queue'],
  exactReplayBodiesExceptImports:true,observations,newProductObservations:{path:'new-client-observations.json',...await fp(path.join(here,'new-client-observations.json')),count:4,scope:'pending duplicate/keyboard + success retry; actual revision conflict/reopen retry; disposed activation guard; two-document save context'},
  boundedRun:{node:focused.node,testChildren:3,deadlineMsEach:180000,outputBudget:'4MiB stdout + 4MiB stderr per spawnSync pipe (runtime maxBuffer is per stream), outer capture uses the same runtime per-stream4MiB limit',actualOwnInProcessHTTPHostsFromRegressionTests:4,noUser4311Contacted:true},
  sourceSnapshots:'source-before contains exact executed candidate/source modules; frozen negative sources and logs are referenced/preserved separately',productDocClarification:'The executed preparation recipe initially said duplicate saves wait. Before source capture, app README wording was corrected to refusal/retry, matching the implemented guard; the original recipe snapshot remains exact historical preparation.',
  realDiskCommitsSeparatedFromUI:true,syntheticErrorControlClearlyScoped:true,httpSharedObjectRevisionExploit:false,originalEngineExecutions:0,actualBrowserExecution:false,newBenchmarkMemoryProfilerRuns:0,productionChanged:false,priorEpochsChanged:false,fullEditorParity:false,allDocumentedFeatures:false,allWaysSuperiority:false,filesystemRaceHardening:false,
  limits:'No hard cancellation of an already committed disk write. A disposed/closed/background view ignores or scopes UI publication while disk outcomes remain real. Existing stat/readFile/rename and external filesystem-race boundaries are unchanged. Failed background saves preserve the dirty document but do not replace another active document status. No persistent unsaved-draft recovery or autosave is introduced.',nextAction:'Archive independently authenticates frozen source and replays/adds finite cases before root decides installation.'};
await fs.writeFile(path.join(here,'validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});await fs.writeFile(path.join(here,'README.md'),`# Separate Editor save correction\n\nThis stage derives from immutable accepted search/path126 and is authored only after the UI-negative166 and queued-revision-negative26 epochs were frozen. Both negative inventories, exact failed source/logs and observations remain unchanged. No production or shared-host files were edited.\n\nA Save response updates the committed saved baseline, revision and byte count, while preserving the document's current content. Typing remains enabled; a per-document pending flag refuses duplicate requests. Late successful/failed responses publish only to a mounted view that still owns the same document object, and status publication is limited to that active document. Closed/reopened or disposed views cannot accept the old item response. Another open document can save independently. The server captures the primitive revision before any await/queue, matching its existing path/content capture; this fixes a direct shared-object precondition issue, not an HTTP JSON exploit.\n\nFocused verification passed 41/41 with zero failures/skips/cancellations and 28 source fingerprints stable before/after. Seven exact UI-negative/control bodies and three exact queued-revision bodies were replayed with only import paths changed; they pass 7/7 and 3/3. Thirty-one selected app/save/read/search/path/UI/HTTP regressions include four new actual-client controls. The unchanged Git CLI and sequence-diff suites were not rerun. No original engine or benchmark/profiling run occurred. These are finite actual-module element models and in-process HTTP hosts, not actual browser or original full workbench verification.\n\nThe previously reproduced typing loss now retains the newer dirty draft through navigation and comparison while disk still contains only the captured write. The queued stale mutation now rejects while the first accepted commit remains intact. Actual conflict/reopen retry, duplicate keyboard refusal with typing enabled, disposed activation and B save while A response is held passed. Exact raw logs and source snapshots are retained.\n\nOnly client.mjs, server.mjs and app README differ from accepted126; save-publication.ui.test.mjs is added. Source-only copies of shared staging host/library/catalog files are exact baseline dependencies for tests and are not proposed installation changes. New independent acceptance is pending. No whole-editor parity, universal behavior, all-feature or superiority claim is made. An already committed disk write cannot be cancelled by closing a tab; existing live filesystem race and unsaved-recovery limitations remain.\n`,{flag:'wx'});console.log(JSON.stringify({status:receipt.status,receipt:await fp(path.join(here,'validation.json')),changes:changed,tests:41,acceptance:false}));
