    {
      "id": "grafana.candidate.03e66cb616af79580686",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To create a dashboard, select New → New dashboard, then Add visualization. Choose the data source you want to query, build your query, and pick a visualization type (time series, table, stat, and so on) to display the results. Add as many panels as you need, then click Save dashboard to keep it.",
      "headingPath": [
        "Create dashboards",
        "Frequently asked questions"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/build-dashboards/create-dashboard/_index.md",
