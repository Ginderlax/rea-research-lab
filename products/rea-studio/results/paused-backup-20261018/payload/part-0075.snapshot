      "id": "grafana.candidate.0204a1ebd06b8f7dac8e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Amazon OpenSearch Service is the successor to Amazon Elasticsearch Service. For Amazon OpenSearch Service, use the [OpenSearch data source](https://grafana.com/docs/plugins/grafana-opensearch-datasource/latest/) instead of this Elasticsearch data source.",
