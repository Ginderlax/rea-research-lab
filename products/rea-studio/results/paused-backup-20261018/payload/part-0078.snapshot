        "lineEnd": 29,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/shared/datasources/datasouce-authentication.md#L28-L29"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.89f47c074e2878e580f0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Add self-signed certificate** : Activate this option to use a self-signed TLS certificate. You can add your own Certificate Authority (CA) certificate on top of one generated by the certificate authorities for additional security measure.",
      "headingPath": [],
      "source": {
        "path": "docs/sources/shared/datasources/datasouce-authentication.md",
