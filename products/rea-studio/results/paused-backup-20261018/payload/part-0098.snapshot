const old="const payload = seal(this.key,bytes), record = Buffer.alloc(37); record[0] = type === 'tree' ? 1:0; record.writeUInt32LE(payload.length,1); Buffer.from(blobID,'hex').copy(record,5);";
assert.ok(text.includes(old));
text=text.replace(old,"const encoded = encodeBlob(bytes,type,this.config.version,this.compression), payload = seal(this.key,encoded.bytes), record = Buffer.alloc(encoded.uncompressedLength ? 41:37); record[0] = (type === 'tree' ? 1:0) + (encoded.uncompressedLength ? 2:0); record.writeUInt32LE(payload.length,1); if (encoded.uncompressedLength) record.writeUInt32LE(encoded.uncompressedLength,5); Buffer.from(blobID,'hex').copy(record,encoded.uncompressedLength ? 9:5);");
text=text.replace("const blob = { id:blobID,type,offset:0,length:payload.length };", "const blob = { id:blobID,type,offset:0,length:payload.length,...(encoded.uncompressedLength ? {uncompressed_length:encoded.uncompressedLength}:{}) };");
text=text.replace('await repo.unlock(input.password);','await repo.unlock(input.password);\n  repo.compression = compressionMode(input.compression);');
writeFileSync(join(stage,'apps/backup/restic.mjs'),text);
