    {
      "id": "grafana.candidate.a5845c60d42fdada390d",
      "syntaxRole": "list-item",
      "sourceText": "- **Server -** Affects all users on the Grafana server. Set by a [Grafana server admin](../roles-and-permissions/#grafana-server-administrators).",
      "headingPath": [
        "Organization preferences"
      ],
      "source": {
        "path": "docs/sources/administration/organization-preferences/index.md",
