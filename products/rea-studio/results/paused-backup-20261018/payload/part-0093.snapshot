    },
    {
      "before": "const attempt = JSON.parse(attemptBytes);",
      "after": "// Authenticate all92 readable uploaded roles against the exact fixed backup report before mutation.\nlet uploadedRoleBytes = 0;\nfor (const name of rows.keys()) { const bytes = evidence(name); uploadedRoleBytes += bytes.length; assert(uploadedRoleBytes <= 64 * 1024 * 1024); }\nconst attempt = JSON.parse(attemptBytes);\nassert.deepEqual(id(attemptBytes), expectedEpoch.attempt);\nassert.equal(attempt.sourceCommit, expectedEpoch.testedCommit);\nassert.equal(attempt.gitTree, expectedEpoch.gitTree);\nassert.deepEqual(attempt.payloadBefore, expectedEpoch.payload);"
