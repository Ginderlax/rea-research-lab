    {
      "id": "grafana.candidate.9b5ae5fd99d4498c49d4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We've added a tooltip hover proximity limit option (in pixels), which makes it possible to reduce the number of hovered-over data points under the cursor when two datasets are not aligned in time.",
      "headingPath": [
        "What’s new in Grafana v10.4",
        "Dashboards and visualizations",
        "Tooltip improvements"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-4.md",
        "gitBlobSha": "2d82968c8f6eabe7b14bdd8962cbdce219ab422d",
