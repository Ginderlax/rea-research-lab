  "checks": [
    {
      "name": "vault HTTP CRUD persists encrypted data across host restarts and authenticates master passwords",
      "passed": true
    },
    {
      "name": "KDBX HTTP import/export preserves encrypted document metadata across restart and failed replacement leaves existing data intact",
      "passed": true
    },
    {
      "name": "encrypted entries survive lock and unlock without persisted plaintext; wrong passwords and tampering fail",
      "passed": true
    },
    {
      "name": "password changes rotate salt/key, encrypted export can be imported, and concurrent entries are retained",
      "passed": true
    },
    {
      "name": "TOTP matches six RFC 6238 SHA-1 vectors and rejects invalid Base32",
      "passed": true
    },
    {
      "name": "idle timer locks the vault without requiring a later expiry-check request",
      "passed": true
    },
    {
      "name": "KeePass 2.61.1 independently creates and opens KDBX across every supported KDF/cipher pair",
      "passed": true
    },
    {
      "name": "original KeePass 3.1/Salsa20 import and 4.0 import preserve history and attachments on 4.1 export",
      "passed": true
    },
    {
      "name": "independent original opens fresh Lab database; password + XML keyfile and keyfile-only work in both directions",
      "passed": true
    },
    {
      "name": "original arbitrary 64-byte high-bit key files use hashed bytes rather than masked ASCII",
      "passed": true
    },
    {
      "name": "authentic original compressed database with oversized attachment fails the inflation limit",
      "passed": true
    },
    {
      "name": "legacy compressed attachments stop at the remaining aggregate XML/Base64 budget before retaining all binaries",
      "passed": true
    },
    {
      "name": "Base64 decoding handles large values up to the 8 MiB bound without regex stack growth",
      "passed": true
    },
    {
      "name": "KDBX 4.0/4.1, AES/ChaCha20, AES-KDF/Argon2d/Argon2id and gzip/none roundtrip actual data",
      "passed": true
    },
    {
      "name": "KDBX authentication rejects wrong password/key, modified header/body/HMAC, truncation and trailing bytes",
      "passed": true
    },
    {
      "name": "key files accept raw, hex, XML v1/v2 and hashed arbitrary contents with integrity checks",
      "passed": true
    },
    {
      "name": "XML literal newline normalization and character-reference preservation follow XML 1.0",
      "passed": true
    },
    {
      "name": "parser rejects future format/KDF, costly derivation, unsafe XML and missing references instead of dropping content",
      "passed": true
    }
  ],
