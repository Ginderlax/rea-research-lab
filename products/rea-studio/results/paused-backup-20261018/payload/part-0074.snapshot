    {
      "id": "grafana.candidate.fba6070030dbc77562a3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana Advisor performs regular checks on data sources, plugins, and your Grafana instance, but will expand its capabilities in future releases to cover more aspects of your Grafana environment. You can suggest new checks and provide feedback through this [form](https://docs.google.com/forms/d/e/1FAIpQLSf8T-xMZauFXZ1uHw09OjZLT_AaiY-cl-hJGwC6Krkj0ThmZQ/viewform).",
      "headingPath": [
        "Manage Grafana Advisor using the Grafana CLI"
      ],
