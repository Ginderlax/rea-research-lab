    {
      "id": "grafana.candidate.d7751bff49edaa6dcc97",
      "syntaxRole": "list-item",
      "sourceText": "- **Logarithmic** - Use a logarithmic scale. When you select this option, a list appears for you to choose a binary (base 2) or common (base 10) logarithmic scale.",
      "headingPath": [
        "Placement",
        "Scale"
      ],
