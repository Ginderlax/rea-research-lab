    {
      "id": "grafana.candidate.0c5f5dcef25510940f8e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana Enterprise is the commercial edition of Grafana that includes additional features not found in the open source version. Building on everything you already know and love about Grafana, Grafana Enterprise adds enterprise data sources, advanced authentication options, more permission controls, 24x7x365 support, and training from the core Grafana team.",
      "headingPath": [
        "Grafana Enterprise"
      ],
