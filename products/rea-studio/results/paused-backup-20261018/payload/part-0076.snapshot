    {
      "id": "grafana.candidate.8a5cdf07cbada1c445a0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This query tells Grafana to format the selected values in the `servers` variable as a regular expression (e.g., (`server1`|`server2`) if two servers are selected).",
      "headingPath": [
        "Graphite template variables",
        "Use tag variables"
      ],
      "source": {
        "path": "docs/sources/datasources/graphite/template-variables/index.md",
