import fs from 'node:fs';
import path from 'node:path';
import {spawn} from 'node:child_process';
import crypto from 'node:crypto';
const here=import.meta.dirname, hash=b=>crypto.createHash('sha256').update(b).digest('hex');
const run=path.join(here,'tests',new Date().toISOString().replaceAll(':','-'));fs.mkdirSync(run,{recursive:true});
const names=['verify-notes-vault-followups.mjs','verifier.test.mjs','run-tests.mjs'];
const before=names.map(name=>{const b=fs.readFileSync(path.join(here,name));fs.writeFileSync(path.join(run,name+'.snapshot'),b);return{path:name,bytes:b.length,sha256:hash(b)};});
const child=spawn(process.execPath,['--test',path.join(here,'verifier.test.mjs')],{cwd:here,env:{...process.env,NODE_TEST_CONTEXT:''},stdio:['ignore','pipe','pipe']});
let out=Buffer.alloc(0),err=Buffer.alloc(0),reason;
const timer=setTimeout(()=>{reason='150000ms deadline';child.kill();},150000);
const collect=(type,b)=>{if(type==='stdout')out=Buffer.concat([out,b]);else err=Buffer.concat([err,b]);if(out.length>1024*1024||err.length>1024*1024){reason='1MiB stream cap';child.kill();}};
child.stdout.on('data',b=>collect('stdout',b));child.stderr.on('data',b=>collect('stderr',b));
const result=await new Promise(resolve=>{child.on('error',e=>resolve({error:e.message}));child.on('close',(code,signal)=>resolve({code,signal}));});clearTimeout(timer);
fs.writeFileSync(path.join(run,'stdout.txt'),out);fs.writeFileSync(path.join(run,'stderr.txt'),err);
const after=names.map(name=>{const b=fs.readFileSync(path.join(here,name));return{path:name,bytes:b.length,sha256:hash(b)};});
const text=out.toString(), summary=Object.fromEntries([...text.matchAll(/^# (tests|pass|fail|cancelled|skipped|todo) (\d+)$/gm)].map(m=>[m[1],Number(m[2])]));
const receipt={schema:'rea-public-proof-verifier-regression/v1',at:new Date().toISOString(),result,reason,sourceBefore:before,sourceAfter:after,sourceStable:JSON.stringify(before)===JSON.stringify(after),summary,stdout:{bytes:out.length,sha256:hash(out)},stderr:{bytes:err.length,sha256:hash(err)},originalExecutions:0,appBehaviorTests:0,sourceOnly:true};
fs.writeFileSync(path.join(run,'validation.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({run,...receipt}));
process.exitCode=result.code===0&&!reason&&receipt.sourceStable&&summary.fail===0?0:1;
