import test from 'node:test';import assert from 'node:assert/strict';import {fixture,deferred,button,field,openEntry,beginRestore,render,Element,descendants} from './lifecycle-ui-fixture.mjs';
function timers(t){const set=globalThis.setTimeout,clear=globalThis.clearTimeout,owned=new Map();let serial=0;globalThis.setTimeout=(callback,delay,...args)=>{if(delay!==300000)return set(callback,delay,...args);const id={logical:++serial};owned.set(id,{callback,args});return id;};globalThis.clearTimeout=id=>{if(owned.has(id)){owned.delete(id);return;}clear(id);};t.after(()=>{globalThis.setTimeout=set;globalThis.clearTimeout=clear;owned.clear();});return{owned,clients:()=>[...owned.values()].filter(t=>t.callback.constructor.name==='AsyncFunction')};}
test('cleanup invalidates a held history preview and prevents private fields or an owned idle timer from republishing',async t=>{
 const logical=timers(t),entered=deferred(),release=deferred(),f=await fixture(t,'dispose-held-history-preview',async(action,input,real)=>{const result=await real();if(action==='historyRead'){entered.resolve();await release.promise;}return result;});await openEntry(f.root,'Entry A');await button(f.root,'Show entry history').click();const pending=button(f.root,'View this version').click();await entered.promise;const oldPassword=field(f.root,'Password');assert.equal(logical.clients().length,1);assert.equal(typeof f.cleanup,'function');f.cleanup();f.cleanup();assert.equal(oldPassword.value,'');assert.equal(logical.clients().length,0);release.resolve();await pending;assert.equal(logical.clients().length,0);assert.equal(descendants(f.root).some(n=>n.value==='A original'||n.value==='A second'),false);assert.equal((await f.call('status')).locked,false);f.observation.cleanup={idempotent:true,scrubbedDetachedField:true,noLatePrivatePreview:true,noLateClientTimer:true,doesNotExplicitlyLockServer:true};
});
test('cleanup during held post-Restore read cannot resurrect selection, secret fields or an old timer over a reopened view',async t=>{
 const logical=timers(t),entered=deferred(),release=deferred();let restored=false;const f=await fixture(t,'dispose-held-restored-read',async(action,input,real)=>{const result=await real();if(action==='historyRestore')restored=true;else if(action==='read'&&restored){restored=false;entered.resolve();await release.promise;}return result;}),restore=await beginRestore(f.root),pending=restore.start();await entered.promise;f.cleanup();assert.equal(logical.clients().length,0);const reopened=new Element('main'),cleanup=await render(reopened,f.call);await openEntry(reopened,'Entry B');release.resolve();await pending;assert.equal(field(reopened,'Title').value,'Entry B');assert.equal(field(reopened,'Password').value,'B original');assert.equal(logical.clients().length,1);assert.equal((await f.call('status')).locked,false);cleanup();f.observation.oldReadCannotResurrectDisposedView=true;
});
test('the active view idle callback still locks and clears its own editor after a disposal-safe reopen',async t=>{
 const logical=timers(t),f=await fixture(t,'active-view-idle-control');await openEntry(f.root,'Entry A');assert.equal(logical.clients().length,1);const timer=logical.clients()[0];await timer.callback(...timer.args);assert.equal((await f.call('status')).locked,true);assert.equal(descendants(f.root).some(n=>n.value==='A second'),false);assert.ok(f.root.textContent.includes('Unlock your vault'));f.cleanup();f.observation.activeViewIdleStillLocks=true;
});
