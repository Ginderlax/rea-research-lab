    {
      "id": "grafana.candidate.e0ec9dc73442462b1d81",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The `from` and `to` also accept relative ranges defined in [Time units and relative ranges](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/dashboards/use-dashboards/#time-units-and-relative-ranges).",
