        "lineStart": 260,
        "lineEnd": 260,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v8-0.md#L260-L260"
      },
      "applicability": {
