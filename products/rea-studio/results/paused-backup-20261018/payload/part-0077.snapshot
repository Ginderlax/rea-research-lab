    {
      "id": "grafana.candidate.bb4bb06b4decd839a0c5",
      "syntaxRole": "list-item",
      "sourceText": "- Example: `grafana.example.net/login?disableAutoLogin=true` or `grafana.example.net/login?disableAutoLogin`",
