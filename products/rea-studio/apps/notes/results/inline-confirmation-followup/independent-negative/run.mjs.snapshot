import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';import {spawn} from 'node:child_process';import {pathToFileURL} from 'node:url';
const here=import.meta.dirname,workspace=path.resolve(here,'../..'),stage=path.resolve(here,'../notes-inline-confirmation-next'),repo=path.join(workspace,'outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),ident=async p=>{const b=await fs.readFile(p);return{bytes:b.length,sha256:sha(b)}},save=(n,v)=>fs.writeFile(path.join(here,n),JSON.stringify(v,null,2)+'\n',{flag:'wx'});
const before=JSON.parse(await fs.readFile(path.join(here,'source-before.json')));for(const r of before)assert.deepEqual(await ident(path.join(r.root==='stage'?stage:repo,r.path)),{bytes:r.bytes,sha256:r.sha256},r.path);const ownBefore={};for(const name of ['prepare.mjs','run.mjs','fixture.mjs','fresh-replay.test.mjs','independent.test.mjs'])ownBefore[name]=await ident(path.join(here,name));await save('review-sources-before.json',ownBefore);
const start=new Date().toISOString(),env={...process.env,NOTES_REVIEW_OUTPUT:pathToFileURL(path.join(here,'observations')+path.sep).href};delete env.NODE_TEST_CONTEXT;const args=['--test','--test-concurrency=1','--test-reporter=tap','fresh-replay.test.mjs','independent.test.mjs'],p=spawn(process.execPath,args,{cwd:here,env,windowsHide:true,stdio:['ignore','pipe','pipe']}),chunks={stdout:[],stderr:[]},sizes={stdout:0,stderr:0};let problem=null;const stop=why=>{problem??=why;p.kill();},timer=setTimeout(()=>stop('60-second child deadline'),60000);for(const name of ['stdout','stderr'])p[name].on('data',b=>{sizes[name]+=b.length;if(sizes[name]>4*1024*1024)stop(name+' exceeds4MiB');else chunks[name].push(b)});p.on('error',e=>problem??=e.message);const end=await new Promise(resolve=>p.on('close',(code,signal)=>resolve({code,signal})));clearTimeout(timer);const raw={};for(const name of ['stdout','stderr']){const b=Buffer.concat(chunks[name]);await fs.writeFile(path.join(here,'tests.'+name+'.txt'),b,{flag:'wx'});raw[name]={path:'tests.'+name+'.txt',bytes:b.length,sha256:sha(b)};}const text=Buffer.concat(chunks.stdout).toString('utf8'),counts=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(k=>[k,Number(text.match(new RegExp('^# '+k+' (\\d+)$','m'))?.[1])]));for(const r of before)assert.deepEqual(await ident(path.join(r.root==='stage'?stage:repo,r.path)),{bytes:r.bytes,sha256:r.sha256},r.path);for(const[n,r]of Object.entries(ownBefore))assert.deepEqual(await ident(path.join(here,n)),r,n);await save('source-after.json',before);await save('review-sources-after.json',ownBefore);await save('attempt.json',{schema:'rea-notes-inline-confirmation-independent-attempt/v1',startedAt:start,completedAt:new Date().toISOString(),counts,...end,problem,raw,sourceStable:true,sourceStageArtifacts:215,productionBaseline28:true,originalSource31:true,reviewSources:ownBefore,controller:{pid:p.pid,closed:true,deadlineMilliseconds:60000,maxCaptureBytesPerStream:4194304},run