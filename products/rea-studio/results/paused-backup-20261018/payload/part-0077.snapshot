    {
      "id": "grafana.candidate.0f8e8a99ed20dcdd030c",
      "syntaxRole": "table-row",
      "sourceText": "| `allow_sign_up`              | No       | Yes                | Whether to allow new Grafana user creation through GitLab login. If set to `false`, then only existing Grafana users can log in with GitLab OAuth.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       | `true`                               |",
      "headingPath": [
        "Configure GitLab OAuth authentication",
        "Configuration options"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/gitlab/index.md",
        "gitBlobSha": "60055d69865bdbc143aa7f58e3b08d13b64a58a6",
        "sha256": "11af01f967c74718eb99ac11c02fdfa3c3722d3fb4566916e5a70c0a5ecd2ac5",
        "lineStart": 306,
        "lineEnd": 306,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/gitlab/index.md#L306-L306"
      },
