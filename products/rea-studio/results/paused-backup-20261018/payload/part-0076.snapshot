    {
      "id": "grafana.candidate.f3f222e6ff7b09d85372",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Label-based access control (LBAC) filters the logs a team can query based on labels. It's available on Grafana Cloud and Grafana Enterprise, where it requires Grafana Enterprise Logs (GEL). If you can't enable LBAC, or teams see more logs than expected, check the following.",
      "headingPath": [
        "Troubleshoot Loki data source issues",
        "Label-based access control (LBAC) issues"
      ],
      "source": {
        "path": "docs/sources/datasources/loki/troubleshooting/index.md",
        "gitBlobSha": "dd06b2e05f654d3aab650bede0784bc9d62bf820",
        "sha256": "7bd76452f86f4f95b8ee8d9b91dbc9615da635d778afd53058bd19c3c1cb9bb9",
        "lineStart": 165,
        "lineEnd": 165,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/loki/troubleshooting/index.md#L165-L165"
      },
      "applicability": {
        "status": "conditional-or-paid-restriction-requires-review",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.00d4bc8e6dad7ab775fe",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can't enable LBAC on a provisioned or auto-provisioned Loki data source. Provisioning of LBAC data sources isn't supported.",
      "headingPath": [
        "Troubleshoot Loki data source issues",
        "Label-based access control (LBAC) issues",
        "Can't enable LBAC on a provisioned data source"
      ],
      "source": {
        "path": "docs/sources/datasources/loki/troubleshooting/index.md",
        "gitBlobSha": "dd06b2e05f654d3aab650bede0784bc9d62bf820",
        "sha256": "7bd76452f86f4f95b8ee8d9b91dbc9615da635d778afd53058bd19c3c1cb9bb9",
        "lineStart": 170,
        "lineEnd": 170,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/loki/troubleshooting/index.md#L170-L170"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
