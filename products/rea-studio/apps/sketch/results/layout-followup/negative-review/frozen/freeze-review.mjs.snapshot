import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,stage=path.resolve(here,'../sketch-alignment-next'),repo=path.resolve(here,'../../outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex');
async function walk(d,p=''){const out=[];for(const e of await fs.readdir(d,{withFileTypes:true})){assert(!e.isSymbolicLink());if(e.isDirectory())out.push(...await walk(path.join(d,e.name),p+e.name+'/'));else out.push(p+e.name);}return out;}
const mb=await fs.readFile(path.join(stage,'freeze-manifest.json'));assert.equal(sha(mb),'4684a6dffad102c461531476d4c24ad8b8eb5783b226aad9bbf82e2b81e0f2c7');const manifest=JSON.parse(mb);assert.deepEqual((await walk(stage)).sort(),[...manifest.records.map(r=>r.path),'freeze-manifest.json'].sort());for(const r of manifest.records){const b=await fs.readFile(path.join(stage,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256,r.path);}const baseline=JSON.parse(await fs.readFile(path.join(here,'source-baseline.json.snapshot')));for(const r of baseline){const b=await fs.readFile(path.join(repo,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256,r.path);}const provenance=JSON.parse(await fs.readFile(path.join(here,'candidate/source-provenance.json.snapshot')));for(const r of provenance.fetched){const b=await fs.readFile(path.join(here,r.path));assert.equal(sha(b),r.sha256);}
const runs=[];for(const n of (await fs.readdir(path.join(here,'runs'))).sort()){const r=JSON.parse(await fs.readFile(path.join(here,'runs',n,'run.json')));runs.push({path:'runs/'+n,status:r.status,tests:r.tests,source:r.source,sourceStable:r.sourceStable});}assert.equal(runs.length,4);const receipt={schema:'rea-sketch-alignment-independent-review/v1',at:new Date().toISOString(),candidate:{path:'work/sketch-alignment-next',files:277,manifestSHA256:sha(mb),receiptSHA256:sha(await fs.readFile(path.join(stage,'validation.json'))),source:JSON.parse(await fs.readFile(path.join(here,'candidate-before.json'))).sourceRows},productionBaseline:baseline,originalRelease:provenance.release,originalCommit:provenance.commit,originalSourceFiles:provenance.fetched,runs,distinctReviewGroups:{total:12,pass:11,fail:1},separateDiagnosticGroups:{total:1,pass:0,fail:1},firstUIPremiseFailures:3,correctedUIGroups:{total:4,pass:4},originalExecuted:{align:45,distribute:21,groups:2,totalActionCalls:66,uniqueActionPairs:62,selectedSlices:7,declarations:8,sourceUnits:5,VMCompilations:2},confirmedFinding:{id:'fractional-signed-line-extent',scope:'Finite literal arithmetic comparison; last bit discrepancy, no visible/safety loss demonstrated',operation:{kind:'distribute',axis:'x'},expectedLastX:1.333333333333333,actualLastX:1.3333333333333333,candidateLocation:'products/rea-studio/apps/sketch/layout.mjs:6',firstFailureRun:runs[0].path,diagnosticRun:runs[2].path},sourceStable:true,candidateAndProductionEdits:0,originalAppGUI:0,actualBrowser:0,HTTPHosts:0,benchmarks:0,acceptance:false,fullParity:false,superiority:false,ownedChildProcesses:4,ownedProcessesRemaining:0};
for(const n of[runs[0].path,runs[2].path]){const o=JSON.parse(await fs.readFile(path.join(here,n,'original-observations.json')));receipt[n.includes('02-37')?'originalInitialCounts':'originalDiagnosticCounts']=o.original?.counts??o.counts;}await fs.writeFile(path.join(here,'review-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});const records=[];for(const p of(await walk(here)).sort()){assert.notEqual(p,'review-manifest.json');const b=await fs.readFile(path.join(here,p));records.push({path:p,bytes:b.length,sha256:sha(b)});}const frozen={schema:'rea-sketch-alignment-independent-review-freeze/v1',files:records.length,totalBytes:records.reduce((n,r)=>n+r.bytes,0),records},frozenBytes=Buffer.from(JSON.stringify(frozen,null,2)+'\n');await fs.writeFile(path.join(here,'review-manifest.json'),frozenBytes,{flag:'wx'});console.log(JSON.stringify({files:frozen.files,manifestSHA256:sha(frozenBytes),receiptSHA256:sha(await fs.readFile(path.join(here,'review-validation.json'))),candidate277Stable:true,production14Stable:true,acceptance:false}));
