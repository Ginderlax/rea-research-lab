    {
      "id": "grafana.candidate.3f89cda104faa664a6de",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Starting in Grafana v13, you can use Grafana Assistant on-premise by installing the Assistant app in your self-hosted Grafana deployment and connecting it to a Grafana Cloud stack.",
      "headingPath": [
        "Grafana Assistant"
      ],
      "source": {
        "path": "docs/sources/administration/assistant/_index.md",
