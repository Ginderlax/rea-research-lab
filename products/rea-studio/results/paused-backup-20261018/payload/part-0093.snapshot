import fs from 'node:fs/promises';
import path from 'node:path';
const work=import.meta.dirname,stage=path.join(work,'metrics-selector-measurement-review-next'),lab=path.resolve(work,'../outputs/rea-research-lab'),prefix='products/rea-studio/results/metrics-selector-observations-20261012',destination=path.join(lab,prefix),sha=b=>createHash('sha256').update(b).digest('hex');
const frozenBytes=await fs.readFile(path.join(stage,'freeze-manifest.json'));assert.equal(sha(frozenBytes),'3d23bbf39d41151f0edf341717d7f4fdf29f3acbd0b72d5f39d898a969a34349');const frozen=JSON.parse(frozenBytes);assert.equal(frozen.schema,'rea-metrics-selector-measured-review-freeze/v1');assert.equal(frozen.entries.length,1042);assert.equal(frozen.publicationExcludedArchives.length,2);assert.equal(frozen.productionIntegrated,false);
const receiptBytes=await fs.readFile(path.join(stage,'measurement-validation.json'));assert.equal(sha(receiptBytes),'2226c0d8257df6db57616e6ace33cf91a9617154800553f01a0375c118260208');const receipt=JSON.parse(receiptBytes);assert.equal(receipt.productionIntegrated,false);assert.equal(receipt.performanceParityEstablished,false);assert.equal(receipt.universalSuperiorityEstablished,false);assert.equal(receipt.fullProductComplete,false);assert.equal(receipt.negativeValuesClipped,false);assert.equal(receipt.counts.timingChildren,147);assert.equal(receipt.counts.memoryChildren,147);assert.equal(receipt.negativeSignedChildMetricValues,24);assert.equal(receipt.negativePairedMetricValues,644);
