    {
      "id": "grafana.candidate.4684ce308b361ef5a7e6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In the scenario where you want users to grant access by the team they belong to, we recommend to set users role to `No Basic Role` and let the team assignment assign the role instead.",
