    {
      "id": "grafana.candidate.1c64b8fe9fa66dec6908",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The **Min step** setting controls how many data points the query returns, which directly affects how many annotations appear. A larger step means fewer annotations:",
      "headingPath": [
        "Prometheus annotations",
        "Control annotation density"
      ],
      "source": {
        "path": "docs/sources/datasources/prometheus/annotations/index.md",
