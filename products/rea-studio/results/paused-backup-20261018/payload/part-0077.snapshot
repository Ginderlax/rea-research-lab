    },
    {
      "id": "grafana.candidate.544d3c59debfe3acfbdc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can also customize the **loading logo** (`loading_logo`), which appears during the initial page load splash screen.",
      "headingPath": [
        "Configure custom branding"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/configure-custom-branding/index.md",
        "gitBlobSha": "626068ce514684ffda01cbb550ec0d7bfca40775",
