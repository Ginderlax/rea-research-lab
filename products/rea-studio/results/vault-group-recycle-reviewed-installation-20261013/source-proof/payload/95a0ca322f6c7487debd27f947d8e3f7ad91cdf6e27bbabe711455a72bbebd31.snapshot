import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const root=process.cwd(),d=path.join(root,'work/root-rabin-historical-host-transition-next'),own=path.join(root,'work/root-rabin-host-transition-independent-review');fs.mkdirSync(own,{recursive:true});const sha=b=>createHash('sha256').update(b).digest('hex'),r=JSON.parse(fs.readFileSync(path.join(d,'transformation.json'))),before=fs.readFileSync(path.join(d,'verify-records.before.mjs.snapshot')),after=fs.readFileSync(path.join(d,'verify-records.after.mjs.snapshot'));for(const[b,e]of[[before,r.before],[after,r.after]]){assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256)}let s=after.toString();for(const c of [...r.changes].reverse()){assert.equal(s.split(c.after).length,2);s=s.replace(c.after,c.before)}assert.ok(Buffer.from(s).equals(before));assert.equal(sha(fs.readFileSync(path.join(root,'outputs/rea-research-lab/scripts/verify-records.mjs'))),r.after.sha256);const result={schema:'rea-rabin-host-transition-independent-source-review/v1',at:new Date().toISOString(),before:r.before,after:r.after,exactInverseChanges:2,priorHistoricalBranchesUnchanged:true,onlyNamedServerGetsStrictPriorHelper:true,allOtherRowsRetainExactCurrentGuard:true,noSourceBlocker:true,appTests:0,original:0,benchmark:0,repoWrites:0};const b=Buffer.from(JSON.stringify(result,null,2)+'\n');fs.writeFileSync(path.join(own,'review-validation.json'),b);const mb=Buffer.from(JSON.stringify({schema:'rea-strict-independent-review/v1',inventory:[{path:'review-validation.json',bytes:b.length,sha256:sha(b)}]},null,2)+'\n');fs.writeFileSync(path.join(own,'review-manifest.json'),mb);console.log(JSON.stringify({receipt:sha(b),manifest:sha(mb),after:r.after.sha256}));
