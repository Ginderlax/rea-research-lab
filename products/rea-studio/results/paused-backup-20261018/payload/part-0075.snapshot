        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/fundamentals/notifications/group-alert-notifications.md#L49-L49"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
