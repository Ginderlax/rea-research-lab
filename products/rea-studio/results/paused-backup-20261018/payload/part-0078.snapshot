    {
      "id": "grafana.candidate.5fec5ef7579c04b4d360",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Inspired by PromQL and LogQL, TraceQL is a query language designed for selecting traces. TraceQL provides a method for formulating precise queries so you can zoom in to the data you need. Query results are returned faster because the queries limit what is searched.",
      "headingPath": [],
      "source": {
        "path": "docs/sources/shared/datasources/tempo-editor-traceql.md",
        "gitBlobSha": "003a449fd9604839ca39a071ca081b2985cca7ad",
