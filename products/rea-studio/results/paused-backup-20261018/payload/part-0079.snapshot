    },
    {
      "id": "grafana.candidate.a79765ae47efe87a1ef4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you want to show one gauge per table cell, under **Value options**, change the **Show** setting from **Calculate** to **All values**. Each gauge label is a concatenation of the text column with each value's column name.",
      "headingPath": [
        "Gauge",
        "Supported data formats",
        "Example - Multiple rows and values"
      ],
      "source": {
