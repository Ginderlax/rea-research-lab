for(let i=0;i<stageBefore.length;i++)assert.equal(stageBefore[i].sha256,frozen.files[i].sha256);assert.deepEqual(productionBefore,frozen.productionBefore);
const local=path.join(here,'.local');await fs.mkdir(local,{recursive:true});const runDirectory=await fs.mkdtemp(path.join(local,'run-'));await fs.mkdir(path.join(runDirectory,'sources'));for(const row of sourceBefore){const filename=path.join(runDirectory,'sources',row.path);await fs.mkdir(path.dirname(filename),{recursive:true});await fs.writeFile(filename,await fs.readFile(path.join(here,row.path)),{flag:'wx'});}
const startedAtUtc=new Date().toISOString(),runs=[];
for(const mode of ['normal','retained-observations']){const temporary=mode==='retained-observations'?await fs.mkdtemp(path.join(os.tmpdir(),'rea-sketch-collector-observations-')):null,env={...process.env};delete env.REA_SKETCH_COLLECTOR_REGRESSION_DIR;if(temporary)env.REA_SKETCH_COLLECTOR_REGRESSION_DIR=temporary;
 try{const result=await runSketchChild({args:['--test','--test-concurrency=1','--test-reporter=tap',path.join(here,'candidate/tests/sketch-collector.test.mjs')],cwd:here,env,timeoutMs:30000,stdoutBytes:4*1024*1024,stderrBytes:1024*1024});await fs.writeFile(path.join(runDirectory,mode+'.stdout.txt'),result.stdout,{flag:'wx'});await fs.writeFile(path.join(runDirectory,mode+'.stderr.txt'),result.stderr,{flag:'wx'});const summary=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(name=>[name,Number(result.stdout.toString('utf8').match(new RegExp(`^# ${name} (\\d+)$`,'m'))?.[1]??-1)])),marker=JSON.parse(result.stdout.toString('utf8').match(/^# SKETCH_COLLECTOR_OBSERVATIONS (.+)$/m)?.[1]??'null'),{stdout,stderr,...execution}=result;let observationsPresent=false;if(temporary){try{const filename=path.join(temporary,'observations.json');assert.ok((await fs.stat(filename)).size<=2*1024*1024);await fs.copyFile(filename,path.join(runDirectory,'observations.json'));observationsPresent=true;}catch(error){if(error.code!=='ENOENT')throw error;}}runs.push({mode,summary,marker,execution,observationsPresent});}
 finally{if(temporary){assert.equal(path.dirname(temporary),os.tmpdir());assert.ok(path.basename(temporary).startsWith('rea-sketch-collector-observations-'));await fs.rm(temporary,{recursive:true,force:true});}}
}
const sourceAfter=await fingerprints(here,sourceNames),stageAfter=await fingerprints(stage,stageNames),productionAfter=await fingerprints(product,productionNames),candidateInventoryAfter=await inventory(path.join(here,'candidate')),sourceBytesStable=JSON.stringify(sourceBefore)===JSON.stringify(sourceAfter),frozenStageUnchanged=JSON.stringify(stageBefore)===JSON.stringify(stageAfter),productionUnchanged=JSON.stringify(productionBefore)===JSON.stringify(productionAfter),candidateTreeUnchanged=JSON.stringify(candidateInventoryBefore)===JSON.stringify(candidateInventoryAfter),passed=runs.every(run=>run.execution.failure===null&&run.summary.tests===17&&run.summary.pass===17&&run.summary.fail===0&&run.summary.cancelled===0&&run.summary.skipped===0&&run.summary.todo===0&&run.marker?.groups===17)&&runs[1].observationsPresent&&sourceBytesStable&&frozenStageUnchanged&&productionUnchanged&&candidateTreeUnchanged;
const artifactNames=(await inventory(runDirectory)).filter(name=>!name.startsWith('sources/')),receipt={schema:'rea-sketch-collector-production-adapter-validation/v1',startedAtUtc,completedAtUtc:new Date().toISOString(),runtime:process.version,platform:process.platform,passed,runs,distinctRegressionGroups:17,regressionGroupExecutions:34,geometrySuiteExecutions:0,originalHelperExecutions:0,sourceBytesStable,frozenStageUnchanged,productionUnchanged,candidateTreeUnchanged,sourceBefore,sourceAfter,stageFreezeSha256:'59629ecca2019b50da247e4226498d583a65d503ae47350a47b0fe7499c88765',productionBefore,productionAfter,candidateInventoryBefore,candidateInventoryAfter,artifacts:await fingerprints(runDirectory,artifactNames),runDirectory:path.relative(here,runDirectory).replaceAll('\\','/'),scope:'Production-relative adapter files tested in isolated product-shaped tree; no installed production execution or geometry28 rerun. Normal and retained-observation modes both17/17. Synthetic data only private OS temp; retained logs only this ignored adapter .local.',limitations:['Child deadline/log bounds exclude bootstrap-fetch and fingerprint I/O hard deadlines','Windows taskkill cleanup is not race-free descendant isolation','POSIX cleanup branch not exercised']};await fs.writeFile(path.join(runDirectory,'validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});await fs.writeFile(path.join(here,'validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({passed,distinctGroups:17,executions:34,runDirectory:receipt.runDirectory,validationSha256:digest(await fs.readFile(path.join(here,'validation.json')))}));assert.equal(passed,true,'Adapter regression failed; raw/provenance evidence retained');
