    {
      "id": "grafana.candidate.75747b29d57a0f3b0720",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use a sampling server that supports the Jaeger remote sampling API, such as `jaeger-agent`, `jaeger-collector`, `opentelemetry-collector-contrib`, or [Grafana Alloy](https://grafana.com/oss/alloy-opentelemetry-collector/).",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[tracing.opentelemetry]`",
        "`sampling_server_url`"
      ],
