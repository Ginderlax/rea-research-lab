import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{fileURLToPath}from'node:url';
const own=path.dirname(fileURLToPath(import.meta.url)),workspace=path.resolve(own,'../..'),lab=path.join(workspace,'outputs/rea-research-lab'),studio=path.join(lab,'products/rea-studio'),sha=b=>createHash('sha256').update(b).digest('hex'),inputs=[];await fs.mkdir(path.join(own,'authority'),{recursive:true});async function read(file,save){const b=await fs.readFile(file);inputs.push({path:path.relative(workspace,file).replaceAll('\\','/'),absolute:file,bytes:b.length,sha256:sha(b)});if(save){const dest=path.join(own,'authority',save+'.snapshot');await fs.mkdir(path.dirname(dest),{recursive:true});await fs.writeFile(dest,b,{flag:'wx'});}return b;}async function json(file,save){return JSON.parse(await read(file,save));}
const script=await read(path.join(workspace,'work/finalize-editor-vault-checkpoint.mjs'),'finalize-editor-vault-checkpoint.mjs');assert.equal(script.length,22051);assert.equal(sha(script),'fedabe18d3ea0f2649296a111000b0b487d8fe965da7b164d5c132a6b1a12046');const source=script.toString(),preflight=await json(path.join(workspace,'work/editor-vault-finalization-next/preflight.json'),'preflight.json');assert.deepEqual(preflight.collector,{bytes:script.length,sha256:sha(script)});assert.equal(preflight.sourceFiles,737);assert.equal(preflight.installationRows,30);assert.equal(preflight.originalSourcePairs,159);assert.equal(preflight.capabilityIds,232);assert.equal(preflight.refreshedImplementationReferences.length,4);assert((await read(path.join(workspace,'work/editor-vault-finalization-next/collector.mjs.snapshot'))).equals(script));for(const r of preflight.metadataBefore){const b=await read(path.join(workspace,'work/editor-vault-finalization-next/before',r.path+'.snapshot'));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);}
const installation=await json(path.join(workspace,'work/editor-vault-reviewed-installation-next/installation.json'),'installation.json');assert.equal(installation.installed.length,30);const replacements=installation.installed.filter(x=>x.before!==null),additions=installation.installed.filter(x=>x.before===null);assert.equal(replacements.length,8);assert.equal(additions.length,22);for(const r of installation.installed){const b=await read(path.join(lab,r.destination));assert.equal(b.length,r.after.bytes);assert.equal(sha(b),r.after.sha256);}for(const r of preflight.refreshedImplementationReferences){const row=installation.installed.find(x=>x.destination===r.path);assert(row);assert.deepEqual(r.before,row.before);assert.deepEqual(r.after,row.after);}
const before=await json(path.join(workspace,'work/editor-vault-suite-runs/2026-10-13T05-22-11.249Z/source-before.json')),after=await json(path.join(workspace,'work/editor-vault-suite-runs/2026-10-13T05-22-11.249Z/source-after.json'));assert.deepEqual(before,after);async function names(dir){const rows=[];for(const e of await fs.readdir(dir,{withFileTypes:true})){if(e.isDirectory()){if(!['.local','node_modules'].includes(e.name))rows.push(...await names(path.join(dir,e.name)));}else rows.push(path.join(dir,e.name));}return rows;}const currentNames=[...(await Promise.all(['apps','lib','public','scripts','tests'].map(p=>names(path.join(studio,p))))).flat(),...['server.mjs','catalog.mjs','package.json'].map(p=>path.join(studio,p))].filter(p=>/\.(mjs|json|html|css|ps1)$/.test(p)).sort();const current=[];for(const file of currentNames){const b=await read(file);current.push({path:path.relative(studio,file).replaceAll('\\','/'),bytes:b.length,sha256:sha(b)});}assert.deepEqual(current,before);assert.equal(current.length,737);
async function authenticate(folder,manifestName){const m=await json(path.join(workspace,'work',folder,manifestName)),rows=Array.isArray(m.inventory)?m.inventory:Object.entries(m.inventory).map(([p,v])=>({path:p,...v}));for(const r of rows){const b=await read(path.join(workspace,'work',folder,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);}return {folder,manifestName,records:rows.length,manifestSHA256:sha(await fs.readFile(path.join(workspace,'work',folder,manifestName)))};}
const editorAuthority=await authenticate('editor-search-pattern-textarea-correction-independent-review','review-manifest.json'),editor=await json(path.join(workspace,'work/editor-search-pattern-textarea-correction-independent-review/review-validation.json'),'editor-review-validation.json');assert.equal(editor.independentlyObservedNativeSelections,26);assert.equal(editor.nativeSelectionPass,26);assert.equal(editor.nativeSelectionFail,0);assert.equal(editor.actualResponseBoundaryPass,2);assert.equal(editor.oldIndependentGroupsReplayed,16);assert.equal(editor.sharedStudioHostUsed,false);assert.equal(editor.gitStatusStubbed,true);assert.equal(editor.nativeDirtyCloseCancelAccepted,false);assert.equal(editor.nativeSaveSpecificCampaignExecuted,false);
const vaultAuthority=await authenticate('root-vault-group-browser-visible-control','manifest.json'),vault=await json(path.join(workspace,'work/root-vault-group-browser-visible-control/browser-observations.json'),'vault-visible-browser.json');assert.equal(vault.checks.length,8);assert.equal(vault.finiteBrowserWorkflowsAccepted,true);assert.equal(vault.normalSharedStudioHostAndShell,true);assert.equal(vault.transportBridge,false);assert.equal(vault.handlerSubstitutions,0);assert.equal(vault.permanentPurgeInThisBrowser,false);assert.equal(vault.heldTransportTestsInThisBrowser,0);assert.equal(vault.screenshot.localFileRetained,false);
const priorReview=await json(path.join(workspace,'work/editor-vault-suite-independent-review/review-validation.json'),'combined-review-validation.json');assert.equal(priorReview.groupOriginal.actualAssemblyLoadStderrMarkers,15);assert.equal(priorReview.groupOriginal.actualOpenDatabase,18);assert.equal(priorReview.groupOriginal.actualPassedGroups.length,7);assert.equal(priorReview.overlapPolicy.noSummedAllVaultOriginalTotalClaim,true);
for(const text of ['eight replacements and 22 additions','Sixteen retained model tests replay separately','Its private bridge is distinct from the normal whole Studio host','The initial candidate\'s 15 released KeePass managed loads stay bound to that epoch','These denominators overlap and are never added to the 937 combined total','Screenshot observations without retained image files do not imply published screenshot artifacts','assert.equal(status.complete_replacement_products,0)','assert.equal(status.goal_status,\'active\')','assert.deepEqual(project(registries[i],registryNames[i]),oldProjection[i])'])assert(source.includes(text));
const unique=new Map();for(const row of inputs){if(unique.has(row.absolute))assert.equal(unique.get(row.absolute).sha256,row.sha256);else unique.set(row.absolute,row);}for(const row of unique.values()){const b=await fs.readFile(row.absolute);assert.equal(b.length,row.bytes);assert.equal(sha(b),row.sha256);}await fs.writeFile(path.join(own,'input-authentication.json'),JSON.stringify({schema:'rea-editor-vault-finalizer-source-inputs/v1',inputs:[...unique.values()].map(({absolute,...r})=>r),allExactBeforeAfter:true},null,2)+'\n');
const report={schema:'rea-editor-vault-finalizer-independent-source-review/v1',at:new Date().toISOString(),collector:{bytes:script.length,sha256:sha(script)},sourceOnly:true,rootFinalizerExecuted:false,productionWrites:0,appTests:0,originalExecutions:0,browserExecutions:0,benchmarks:0,currentEligibleSourceCensus:{files:737,namesAndBytesExactToFrozenRun:true},installed:{paths:30,replacements:8,additions:22,allAfterExact:true},authorizedImplementationReferences:preflight.refreshedImplementationReferences,originalProjection:{sourceIdHashPairs:159,capabilityIds:232,sourceAssertionsRetainAfterWriting:true},editorBrowser:{authority:editorAuthority,actualNativeSelections:26,heldResponseControls:2,modelReplays:16,countsSeparate:true,normalSharedStudioHost:false,gitStatusStub:true,CancelAccepted:false,SaveSpecificCampaign:false},vaultBrowser:{authority:vaultAuthority,visibleNormalHostAcceptedObservations:8,earlierFailedIABAttemptNotPromoted:true,permanentPurgeBrowser:false,heldTransportBrowser:0,screenshotsLocallyPublished:false},currentGroupOriginal:{passedGroups:7,actualAssemblyLoads:15,actualDatabaseOpens:18,scope:'Separate existing-run observations authenticated by frozen independent31 review, not derived from declarations or added to historical777.'},documentClaims:{current937And737Supported:true,eightReplacementsTwentyTwoAdditionsSupported:true,privateBridgeAndGUIExclusionsExplicit:true,historicalEpochsNotRebound:true,stagedGroupEditorDefectAndFlowPendingExplicit:true,zeroCompleteProductsAndGoalActivePreserved:true},findings:[],finiteSourcePlanAccepted:true,limitations:['This review authenticates source/preflight/input bytes and factual plan wording; root owns finalizer execution and post-write validation.','No behavioral rerun, original GUI/full-program verification or performance measurement.','Original byte carriers read only for prior authentication; none copied into this review.']};await fs.writeFile(path.join(own,'review-validation.json'),JSON.stringify(report,null,2)+'\n');await fs.writeFile(path.join(own,'README.md'),'# Source-only checkpoint finalizer review\n\nNo blocking factual/count/source finding in exact22051/fedabe18 finalizer. Fresh current file-name/byte census equals frozen737;30 live paths are8 replacements22 additions. Four stale references use reviewed before/after pins;159 source-ID/hash pairs and232 capability IDs remain guarded. Browser26/2/16 and Vault8 are distinct denominators with explicit transport/GUI/Cancel/purge/screenshot limits. Current group7/15 actual evidence remains separate from historical777.\n\nRoot finalizer not executed; no production writes or tests/original/browser/benchmark runs. Frozen combined independent31 remains unchanged.\n');
async function inventory(dir,prefix=''){const rows=[];for(const e of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){if(!prefix&&['manifest.json','freeze.json'].includes(e.name))continue;const p=prefix?prefix+'/'+e.name:e.name;if(e.isDirectory())rows.push(...await inventory(path.join(dir,e.name),p));else{const b=await fs.readFile(path.join(dir,e.name));assert(!(b[0]===77&&b[1]===90));assert(!(b[0]===80&&b[1]===75));rows.push({path:p,bytes:b.length,sha256:sha(b)});}}return rows;}const rows=await inventory(own);await fs.writeFile(path.join(own,'manifest.json'),JSON.stringify({schema:'rea-editor-vault-finalizer-source-review-manifest/v1',files:rows.length,inventory:rows},null,2)+'\n');const r=await fs.readFile(path.join(own,'review-validation.json')),m=await fs.readFile(path.join(own,'manifest.json'));await fs.writeFile(path.join(own,'freeze.json'),JSON.stringify({schema:'rea-editor-vault-finalizer-source-review-freeze/v1',receipt:{path:'review-validation.json',bytes:r.length,sha256:sha(r)},manifest:{path:'manifest.json',bytes:m.length,sha256:sha(m)},files:rows.length},null,2)+'\n');console.log(JSON.stringify({finiteSourcePlanAccepted:true,files:rows.length,receiptSHA256:sha(r),manifestSHA256:sha(m)}));
