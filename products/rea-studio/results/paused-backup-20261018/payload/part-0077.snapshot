      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.06171f3538269402e3ed",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If set to `true` and the primary `protocol` is `http`, `https`, or `h2`, Grafana will additionally serve on the Unix domain socket configured via `socket`. Defaults to `false`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[server]`",
        "`serve_on_socket`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 344,
        "lineEnd": 344,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L344-L344"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b411b778f15052dc9bb0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana needs a database to store users and dashboards (and other things). By default it is configured to use [`sqlite3`](https://www.sqlite.org/index.html) which is an embedded database (included in the main Grafana binary).",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[database]`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 373,
        "lineEnd": 375,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L373-L375"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.8d75082efb2d91d7b738",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "SQLite isn't recommended for production environments; use MySQL or PostgreSQL for production deployments.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[database]`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 378,
        "lineEnd": 378,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L378-L378"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.318edf9240d4b1b14f3e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Only applicable to MySQL or Postgres. Includes IP or hostname and port or in case of Unix sockets the path to it. For example, for MySQL running on the same host as Grafana: `host = 127.0.0.1:3306` or with Unix sockets: `host = /var/run/mysqld/mysqld.sock`",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[database]`",
        "`host`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 387,
        "lineEnd": 388,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L387-L388"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.6df003340ace4e7aa709",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The name of the Grafana database. Leave it set to `grafana` or some other name.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[database]`",
        "`name`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 392,
        "lineEnd": 393,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L392-L393"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.452c5df9c0d305f06f21",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The database user's password (not applicable for `sqlite3`). If the password contains `#` or `;` you have to wrap it with triple quotes. For example `\"\"\"#password;\"\"\"`",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[database]`",
        "`password`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 401,
        "lineEnd": 401,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L401-L401"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.8b653945e3cc99bd2ac6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use either URL or the previous fields to configure the database Example: `type://user:password@host:port/name`",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[database]`",
        "`url`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 405,
        "lineEnd": 406,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L405-L406"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.e0b440bc47637f75328b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The maximum number of open connections to the database. For MYSQL, configure this setting on both Grafana and the database. For more information, refer to [`sysvar_max_connections`](https://dev.mysql.com/doc/refman/8.0/en/server-system-variables.html#sysvar_max_connections).",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[database]`",
        "`max_open_conn`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 414,
        "lineEnd": 414,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L414-L414"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.1b13aad96ee2cbfdad71",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Sets the maximum amount of time a connection may be reused. The default is 14400 (which means 14400 seconds or 4 hours). For MySQL, this setting should be shorter than the [`wait_timeout`](https://dev.mysql.com/doc/refman/5.7/en/server-system-variables.html#sysvar_wait_timeout) variable.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[database]`",
        "`conn_max_lifetime`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 418,
        "lineEnd": 418,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L418-L418"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.be89920414656f103c3f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set to `false` to disable database locking during the migrations. Default is true.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[database]`",
        "`migration_locking`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 422,
        "lineEnd": 422,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L422-L422"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.64af2b4bc614a60348bb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For `mysql` and `postgres` only. Specify the time, in seconds, to wait before failing to lock the database for the migrations. Default is `0`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[database]`",
        "`locking_attempt_timeout_sec`"
      ],
      "source": {
