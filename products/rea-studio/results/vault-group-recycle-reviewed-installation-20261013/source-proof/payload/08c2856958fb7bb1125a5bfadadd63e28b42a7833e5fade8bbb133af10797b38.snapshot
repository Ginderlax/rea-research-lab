import fs from'node:fs/promises';import path from'node:path';import{fileURLToPath}from'node:url';import{createHash}from'node:crypto';import assert from'node:assert/strict';const own=path.dirname(fileURLToPath(import.meta.url)),root=path.resolve(own,'../..'),sha=b=>createHash('sha256').update(b).digest('hex');
const p=JSON.parse(await fs.readFile(path.join(own,'source-provenance.json'),'utf8')),spans=[['KeePass/Forms/MainForm_Functions.cs',5196,5306,'DeleteSelectedGroup','Root refusal; recycle classification; confirmed recursive purge or move+Touch.'],['KeePass/Forms/MainForm_Functions.cs',6896,6923,'GetPreviousParentGroupSafeI','Previous UUID availability/current-parent and group self/subtree/depth guards; no fallback.'],['KeePass/Forms/MainForm_Functions.cs',7044,7066,'MoveToPreviousParentGroup','Complete group node move, previous-parent update, no Touch.'],['KeePassLib/PwGroup.cs',547,577,'Touch','Last access +uint64 usage; modifiedfalse leaves modification time; default touchParents follows new parent chain.'],['KeePassLib/PwGroup.cs',1291,1317,'AddGroup','Ownership/location update and maximum depth check.'],['KeePassLib/PwGroup.cs',1367,1387,'DeleteAllObjects','Entry-first, descendant-group postorder recursive tombstone sequence.']];const contracts=[];for(const[file,start,end,symbol,contract]of spans){const item=p.files.find(r=>r.upstreamPath===file),bytes=await fs.readFile(path.join(own,item.path));assert.equal(sha(bytes),item.sha256);const lines=bytes.toString('utf8').split(/\r?\n/),span=lines.slice(start-1,end).join('\n');assert.ok(span.includes(symbol),symbol+' span');contracts.push({sourcePath:item.path,upstreamPath:file,sourceSHA256:item.sha256,lineStart:start,lineEnd:end,spanSHA256:sha(Buffer.from(span)),symbol,contract});}
const archivePath='work/keepass-history-next/.local/KeePass-2.61.1-Source.zip',archive=await fs.readFile(path.join(root,archivePath));assert.equal(archive.length,5333853);assert.equal(sha(archive),'711bd9ec7076661678469e51bae876debac07a08c32f1b1c6b3b8fe5e761c13a');
const manual=JSON.parse(await fs.readFile(path.join(own,'manual-study/manual-contracts.json.snapshot'),'utf8'));const result={schema:'rea-keepass-group-contract-map/v1',release:'2.61.1',contracts,sourceArchive:{path:archivePath,bytes:archive.length,sha256:sha(archive),localOnly:true,copiedIntoStage:false},selectedGroupManualRecords:manual.requirements.filter(r=>r.area==='group'),localPolicies:['8MiB XML+attachment text /10k groups+entries+tombstones /XML100k nodes-depth64 /groupdepth63 /groupPath256','Explicit Studio confirmation, closed entry editor and clear draft','Restore-only from bin to valid outside-bin previous UUID; no destination fallback','New unused-bin ExpiryTime uses operation clock, originalprocess default differs','No group-create/edit/tag, whole-bin-empty or original GUI claims'],registryChanges:false,originalGUI:0,originalProgram:0};await fs.writeFile(path.join(own,'contract-map.json'),JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify({contracts:contracts.length,manualGroupRecords:result.selectedGroupManualRecords.length,archiveSHA256:result.sourceArchive.sha256}));
