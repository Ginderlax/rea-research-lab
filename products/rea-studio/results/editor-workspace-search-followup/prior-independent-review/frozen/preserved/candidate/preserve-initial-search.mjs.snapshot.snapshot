import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
const root=import.meta.dirname,destination=path.join(root,'attempts/initial-eight-pass');await fs.mkdir(destination,{recursive:true});const files=[];
for(const name of ['workspace-search.mjs','workspace-search.test.mjs','server.mjs','client.mjs']){const bytes=await fs.readFile(path.join(root,'products/rea-studio/apps/editor',name));await fs.writeFile(path.join(destination,`${name}.snapshot`),bytes,{flag:'wx'});files.push({path:name,bytes:bytes.length,sha256:createHash('sha256').update(bytes).digest('hex')});}
await fs.writeFile(path.join(destination,'attempt.json'),JSON.stringify({schema:'rea-editor-search-initial-attempt/v1',recordedAtUtc:new Date().toISOString(),testGroups:8,passed:8,failed:0,skipped:0,automaticSeparateRawStdoutStderrFilesSaved:false,outputLocation:'Tool result in the parent conversation',prePostSourceInventoryAtExecutionRecorded:false,sourceCopiesRetainedBeforeSubsequentEdits:true,files,otherReadOnlyLookupErrors:'Earlier root reads attempted a nonexistent lib/workspace.mjs and two reads from the wrong cwd; they made no file changes.',unboundedOriginalEngineVersionInvocation:1,originalEngineVersionRawOutputLocation:'Tool result in parent conversation; separate raw file was not captured.',originalEngineVersionObserved:'ripgrep15.0.0 rev3a612f88b8; PCRE2 10.45'},null,2)+'\n',{flag:'wx'});console.log('Preserved initial eight-pass source and capture limits.');
