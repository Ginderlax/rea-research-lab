    },
    {
      "id": "grafana.candidate.5bb4bac37fd3cefe2f6c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The initial log context query is created from all labels defining the stream for the selected log line. You can use the log context query editor to widen the search by removing one or more of the label filters from the log stream. If you used a parser in your original query, you can refine your search by using extracted label filters.",
      "headingPath": [
        "Loki query editor",
        "Create a log query",
        "Show log context"
      ],
      "source": {
        "path": "docs/sources/datasources/loki/query-editor/index.md",
