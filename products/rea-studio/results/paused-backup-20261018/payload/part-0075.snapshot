    {
      "id": "grafana.candidate.2804298ad1f4937a998e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Azure Monitor Logs collects and organizes log and performance data from [supported resources](https://docs.microsoft.com/en-us/azure/azure-monitor/monitor-reference), and makes many sources of data available to query together with the [Kusto Query Language (KQL)](https://docs.microsoft.com/en-us/azure/data-explorer/kusto/query/).",
      "headingPath": [
        "Azure Monitor query editor",
        "Query Azure Monitor Logs"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/query-editor/index.md",
        "gitBlobSha": "7e9d70541f1e4e273a619ba9e62b5958327ea3ee",
