    {
      "id": "grafana.candidate.e051780abd18aa428738",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In grid layout, you can sort nodes by clicking on the stats inside the legend. The marker next to the stat name shows which stat is currently used for sorting and the sorting direction:",
      "headingPath": [
        "Node graph",
        "Node graph navigation",
        "Switch layouts"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/node-graph/index.md",
