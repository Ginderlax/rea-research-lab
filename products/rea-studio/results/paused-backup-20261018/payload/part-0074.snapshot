    {
      "id": "grafana.candidate.d15b391f25027717e415",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "All permission and role updates, and role assignments are added to audit logs. Learn more about [access control audit logs](/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-security/audit-grafana/#access-control).",
