    },
    {
      "id": "grafana.candidate.3ce380a50ba131e18b76",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can manage plugin applications in Grafana by adding one or more YAML configuration files in the [`provisioning/plugins`](../../setup-grafana/configure-grafana/#provisioning) directory. Each configuration file contains a list of `apps` that Grafana configures during start up. Grafana configures each app to use the configuration in the file.",
      "headingPath": [
        "Provision Grafana",
        "Plugins"
      ],
      "source": {
        "path": "docs/sources/administration/provisioning/index.md",
        "gitBlobSha": "a6caad47dea63fb1a213a61490f8f587ad16bba2",
        "sha256": "ae39c9c2a4c0e896492c8df476ac2f5ddb821206f6828b18e8d6bb1c2489bf61",
        "lineStart": 304,
        "lineEnd": 306,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/provisioning/index.md#L304-L306"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.cff5c3eda4e417c91c9b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This feature enables you to provision plugin configurations, not the plugins themselves. You must have already installed the plugin to use plugin configuration provisioning.",
      "headingPath": [
        "Provision Grafana",
        "Plugins"
      ],
      "source": {
        "path": "docs/sources/administration/provisioning/index.md",
        "gitBlobSha": "a6caad47dea63fb1a213a61490f8f587ad16bba2",
        "sha256": "ae39c9c2a4c0e896492c8df476ac2f5ddb821206f6828b18e8d6bb1c2489bf61",
        "lineStart": 309,
        "lineEnd": 310,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/provisioning/index.md#L309-L310"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
