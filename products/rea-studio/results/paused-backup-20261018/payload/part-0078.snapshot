    {
      "id": "grafana.candidate.a827e92773f17b3e1178",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Optional: Complete the **TLS settings** for additional security methods.",
      "headingPath": [],
      "source": {
        "path": "docs/sources/shared/datasources/datasouce-authentication.md",
        "gitBlobSha": "cb51a39774a84a9afde327838def546b6395fd6d",
