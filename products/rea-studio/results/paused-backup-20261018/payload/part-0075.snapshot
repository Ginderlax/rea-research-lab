        "lineStart": 144,
        "lineEnd": 144,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/guides/best-practices.md#L144-L144"
      },
      "applicability": {
