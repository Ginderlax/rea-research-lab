    },
    {
      "id": "grafana.candidate.e401928a49ed160dffce",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The default is `1`.",
      "headingPath": [
        "Configure Grafana Enterprise",
