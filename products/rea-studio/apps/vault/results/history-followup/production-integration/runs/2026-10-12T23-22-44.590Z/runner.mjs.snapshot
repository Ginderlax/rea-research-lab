import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import fs from 'node:fs/promises';
import path from 'node:path';
import {spawn} from 'node:child_process';
import {unescapeTapJson} from './keepass-history-production-integration-bundle-ready/tap-observations.mjs';
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab'),studio=path.join(lab,'products/rea-studio'),publicRoot=path.join(studio,'apps/vault/results/history-followup/production-integration');
const run=path.join(work,'vault-history-production-runs',new Date().toISOString().replaceAll(':','-')),sha=b=>createHash('sha256').update(b).digest('hex');await fs.mkdir(run,{recursive:true});
const installationBytes=await fs.readFile(path.join(publicRoot,'installation-manifest.json'));assert.equal(sha(installationBytes),'7427b0c6582a3c2788c536fada88b37385a4b614913fc737dd2333f35bb9521a');const installation=JSON.parse(installationBytes);
async function authenticate(){for(const e of installation.copies){const b=await fs.readFile(path.join(lab,e.path));assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256,e.path);}for(const e of installation.retained){const b=await fs.readFile(path.join(publicRoot,e.path));assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256);}}
await authenticate();
const adaptation=JSON.parse(await fs.readFile(path.join(publicRoot,'adaptations.json.snapshot'))),selectedTests=adaptation.tests.map(n=>'apps/vault/'+n);assert.equal(selectedTests.length,12);
const names=['server.mjs','catalog.mjs','package.json','lib/storage.mjs','public/studio.mjs','public/style.css'];for(const e of await fs.readdir(path.join(studio,'apps/vault'),{withFileTypes:true}))if(e.isFile()&&/\.(mjs|ps1|json)$/.test(e.name))names.push('apps/vault/'+e.name);names.sort();
const fingerprint=async p=>{const b=await fs.readFile(path.join(studio,p));return{path:p,bytes:b.length,sha256:sha(b)};},before=await Promise.all(names.map(fingerprint));
for(const e of before){const b=await fs.readFile(path.join(studio,e.path));assert.equal(sha(b),e.sha256);const target=path.join(run,'source',e.path+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b,{flag:'wx'});}
await fs.writeFile(path.join(run,'source-before.json'),JSON.stringify(before,null,2)+'\n');const runnerBytes=await fs.readFile(import.meta.filename);await fs.writeFile(path.join(run,'runner.mjs.snapshot'),runnerBytes);const helperBytes=await fs.readFile(path.join(work,'keepass-history-production-integration-bundle-ready/tap-observations.mjs'));await fs.writeFile(path.join(run,'tap-observations.mjs.snapshot'),helperBytes);
const runtime={version:process.version,sha256:sha(await fs.readFile(process.execPath))},startedAtUtc=new Date().toISOString(),env={...process.env};delete env.NODE_TEST_CONTEXT;
const args=['--test','--test-concurrency=1','--test-reporter=tap',...selectedTests],result=await new Promise(resolve=>{const c=spawn(process.execPath,args,{cwd:studio,env,shell:false,windowsHide:true,stdio:['ignore','pipe','pipe']}),out=[],err=[];let failure=null,ob=0,eb=0;const stop=r=>{failure??=r;c.kill('SIGKILL');};for(const[s,parts,key,cap]of[[c.stdout,out,'out',8*1024*1024],[c.stderr,err,'err',2*1024*1024]])s.on('data',b=>{const retained=key==='out'?ob:eb,take=Math.max(0,Math.min(cap-retained,b.length));parts.push(b.subarray(0,take));if(key==='out')ob+=take;else eb+=take;if(take<b.length)stop('retained-output-cap');});const timer=setTimeout(()=>stop('180-second owned child deadline'),180000);c.on('error',e=>failure??=e.message);c.on('close',(exitCode,signal)=>{clearTimeout(timer);resolve({exitCode,signal,failure,stdout:Buffer.concat(out),stderr:Buffer.concat(err)});});});
await fs.writeFile(path.join(run,'stdout.txt'),result.stdout);await fs.writeFile(path.join(run,'stderr.txt'),result.stderr);const after=await Promise.all(names.map(fingerprint));await fs.writeFile(path.join(run,'source-after.json'),JSON.stringify(after,null,2)+'\n');
const raw=result.stdout.toString(),summary=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(n=>[n,Number(raw.match(new RegExp('^# '+n+' (\\d+)$','m'))?.[1]??-1)]));
assert.equal(result.failure,null);assert.equal(result.exitCode,0,result.stderr.toString()+raw);assert.deepEqual(summary,{tests:41,pass:41,fail:0,cancelled:0,skipped:0,todo:0});assert.deepEqual(after,before);
function marker(label){const prefix='# '+label+' ',lines=raw.split(/\r?\n/),starts=lines.flatMap((l,n)=>l.startsWith(prefix)?[n]:[]);assert.equal(starts.length,1,label);let value='';for(let n=starts[0];n<lines.length&&n<starts[0]+4096;n++){const line=lines[n];if(n===starts[0])value+=line.slice(prefix.length);else{if(!line.startsWith('# ')||line.startsWith('# Subtest:'))break;value+=line.slice(2);}assert.ok(value.length<=1024*1024);try{return JSON.parse(unescapeTapJson(value));}catch{}}throw new Error('Incomplete observation marker: '+label);}
const details=[];let originalLoads=0,hostProcesses=0;
for(const[label,name]of[['REA_KEEPASS_HISTORY_ORIGINAL','history-original'],['REA_KEEPASS_HISTORY_HTTP','history-http'],['REA_KEEPASS_HISTORY_UNKNOWN','history-unknown-time']]){const m=marker(label),source=path.resolve(m.detail),privateRoot=path.join(lab,'.local/vault-history-fixtures')+path.sep;assert.ok(source.startsWith(privateRoot));const b=await fs.readFile(source),data=JSON.parse(b);assert.ok(b.length<=4*1024*1024);assert.equal(data.originalProcessExecutions,m.originalProcessExecutions);originalLoads+=m.originalProcessExecutions;hostProcesses+=m.hostProcesses??0;await fs.writeFile(path.join(run,name+'.json'),b);details.push({path:name+'.json',bytes:b.length,sha256:sha(b),originalAssemblyLoads:m.originalProcessExecutions,hostProcesses:m.hostProcesses??0});}
assert.equal(originalLoads,24);assert.equal(hostProcesses,5);await authenticate();assert.equal(sha(await fs.readFile(process.execPath)),runtime.sha256);
const receipt={schema:'rea-vault-history-production-integration-validation/v1',startedAtUtc,completedAtUtc:new Date().toISOString(),summary,durationMs:Number(raw.match(/^# duration_ms ([\d.]+)$/m)?.[1]??-1),exitCode:result.exitCode,sourceStable:true,implementationFingerprints:before,selectedTests,arguments:args,runnerSHA256:sha(runnerBytes),tapHelperSHA256:sha(helperBytes),runtime,installationManifestSHA256:sha(installationBytes),originalAccounting:{assemblyLoads:24,originalGuiExecutions:0,originalFullApplicationExecutions:0,originalTouchExecutions:0,sourceComposedEditStepsAccountedSeparately:true},candidateAccounting:{domElementModelGroups:25,hostProcesses:5,actualBrowserExecutions:0},originalDetails:details,normalTestsWriteAppResults:false,historical18CompatibilityRebound:false,fullProductParity:false,securityParity:false,universalSuperiority:false};const bytes=JSON.stringify(receipt,null,2)+'\n';await fs.writeFile(path.join(run,'validation.json'),bytes);
const retained=[];async function walk(dir,relative=''){for(const e of await fs.readdir(dir,{withFileTypes:true})){const p=relative?relative+'/'+e.name:e.name;if(e.isDirectory())await walk(path.join(dir,e.name),p);else{const b=await fs.readFile(path.join(run,p)),name='runs/'+path.basename(run)+'/'+p,target=path.join(publicRoot,name);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b,{flag:'wx'});retained.push({path:name,bytes:b.length,sha256:sha(b)});}}}await walk(run);await fs.writeFile(path.join(publicRoot,'integration-validation.json'),bytes,{flag:'wx'});const manifest=JSON.stringify({schema:'rea-vault-history-production-run-preservation/v1',retained,receiptSHA256:sha(Buffer.from(bytes)),exactCopies:true},null,2)+'\n';await fs.writeFile(path.join(publicRoot,'integration-run-manifest.json'),manifest,{flag:'wx'});console.log(JSON.stringify({summary,sourceFiles:before.length,originalAssemblyLoads:originalLoads,hostProcesses,sourceStable:true,retained:retained.length,receiptSHA256:sha(Buffer.from(bytes)),runManifestSHA256:sha(Buffer.from(manifest))}));
