async function inventory(dir,prefix=''){const all=[];for(const e of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){if(!prefix&&e.name==='freeze-manifest.json')continue;assert.equal(e.isSymbolicLink(),false);const p=prefix+e.name;if(e.isDirectory())all.push(...await inventory(path.join(dir,e.name),p+'/'));else all.push({path:p,...await identity(path.join(dir,e.name))});}return all;}
const files=await inventory(root),manifest={schema:'rea-editor-position-range-selection-freeze/v1',recordedAtUtc:new Date().toISOString(),files:files.length,bytes:files.reduce((n,r)=>n+r.bytes,0),inventory:files,sourceScope:'Work-only candidate, authoritative source, all raw failures/observations, exact per-attempt source snapshots and final documentation; excludes original native/archive binaries, not copied here.'};await write('freeze-manifest.json',manifest);for(const r of files)assert.deepEqual(await identity(path.join(root,r.path)),{bytes:r.bytes,sha256:r.sha256});console.log(JSON.stringify({files:files.length,bytes:manifest.bytes,validation:await identity(path.join(root,'validation.json')),manifest:await identity(path.join(root,'freeze-manifest.json')),candidate:receipt.candidate,focused:receipt.focused.tap,packets:detail.counts.packets,originalDirectActions:detail.counts.originalDirectApiAttempts},null,2));
