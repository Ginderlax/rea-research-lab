    {
      "id": "grafana.candidate.55e7463a1be3325f3069",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you add `ApplicationIntent=ReadOnly` to the Host field to route queries to a read-only replica, be aware that read-only replicas may be significantly slower than the primary. This can cause dashboard load times of several minutes. Only use `ApplicationIntent=ReadOnly` if your replica is sized for the query workload and you've tested performance.",
      "headingPath": [
        "Configure the Microsoft SQL Server data source",
        "Configure the data source in the UI"
