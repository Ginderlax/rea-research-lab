    {
      "id": "grafana.candidate.db7fe66c87237e47bb7b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Audit logs are saved into files. You can configure the folder to use to save these files. Logs are rotated when the file size is exceeded and at the start of a new day.",
      "headingPath": [
        "Audit a Grafana instance",
        "Configure audit logging",
        "File exporter"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/audit-grafana.md",
