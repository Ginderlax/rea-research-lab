    {
      "id": "grafana.candidate.795fcb0bcc5cd70c6f13",
      "syntaxRole": "table-row",
      "sourceText": "| **Tags**                  | Defines the tags to use in the logs query. Default: `cluster`, `hostname`, `namespace`, `pod`, `service.name`, `service.namespace`. You can change the tag name to remove dots from the name if they aren't allowed in the target data source. For example, map `http.status` to `http_status`. |",
      "headingPath": [
        "Configure the Zipkin data source",
        "Trace to logs",
        "Trace to logs settings"
      ],
      "source": {
