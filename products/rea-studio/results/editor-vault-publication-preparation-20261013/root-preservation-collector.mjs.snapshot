import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import{createHash}from'node:crypto';
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab'),own=path.join(work,'editor-vault-publication-preparation-repair-next'),prefix='products/rea-studio/results/editor-vault-publication-preparation-20261013',dest=path.join(lab,prefix),sha=b=>createHash('sha256').update(b).digest('hex');
const fixture='products/rea-studio/apps/archive/fixtures/zstd/native-zip93.zip',pin='e9282f76dbd3c080d0e12ef95489458523ebbc65c2951f4b8f3cb880a16c5d8b';assert.equal(sha(await fs.readFile(path.join(lab,fixture))),pin);
const root=await fs.readFile(path.join(lab,'scripts/verify-records.mjs'),'utf8');assert(root.includes("const syntheticZip = { path: '"+fixture+"', sha256: '"+pin+"' };"));
const diagnostic={at:new Date().toISOString(),kind:'Root publication preparer policy omission',firstAttemptExitCode:1,firstAttemptError:'Excluded distributable: '+fixture,firstAttemptPublicationManifestWritten:false,firstAttemptFilesStaged:true,applicationFailure:false,correction:'Authenticate and retain only the exact previously published synthetic ZIP fixture exception already enforced by scripts/verify-records.mjs; all other vendor/runtime archive paths remain excluded.',fixture:{path:fixture,sha256:pin},productionApplicationChanges:0,newApplicationOriginalBrowserExecutions:0,rawToolOutput:'Observed in root tool result; this is a diagnostic transcription, not a captured raw stderr file.'};await fs.writeFile(path.join(own,'diagnostic.json'),JSON.stringify(diagnostic,null,2)+'\n',{flag:'wx'});
await fs.mkdir(dest);const rows=[];for(const [name,b] of [['preparer-before.mjs.snapshot',await fs.readFile(path.join(own,'preparer-before.mjs.snapshot'))],['preparer-after.mjs.snapshot',await fs.readFile(path.join(work,'prepare-editor-vault-publication.mjs'))],['diagnostic.json.snapshot',await fs.readFile(path.join(own,'diagnostic.json'))],['root-preservation-collector.mjs.snapshot',await fs.readFile(import.meta.filename)]]){await fs.writeFile(path.join(dest,name),b,{flag:'wx'});rows.push({path:name,bytes:b.length,sha256:sha(b)});}
const manifest=Buffer.from(JSON.stringify({schema:'rea-root-publication-preparation-correction/v1',sourceOnly:true,snapshots:rows,exactPriorFixtureException:true,newBehaviorExecutions:0,productFault:false},null,2)+'\n');await fs.writeFile(path.join(dest,'preservation-manifest.json'),manifest,{flag:'wx'});console.log(JSON.stringify({records:rows.length,manifestSHA256:sha(manifest),exactPriorFixtureException:true}));
