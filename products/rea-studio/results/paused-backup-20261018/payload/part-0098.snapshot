    assert ordered(disk_rows) == ordered(attempt['notesBrowser']['ownedDiskRecords'])
    assert sorted(holds, key=lambda row: row['title']) == sorted(attempt['notesBrowser']['realHolds'], key=lambda row: row['title'])
    assert {row['path'] for row in files if row['path'].startswith('screenshots/')} == {row['path'] for row in screenshots}
    assert {row['path'] for row in files if row['path'].startswith('downloads/')} == {row['path'] for row in downloads}
    assert {row['path'] for row in files if row['path'].startswith('notes-records/')} == {row['path'] for row in disk_rows}
    composer_post = load('notes-todo-postrun-source-check.json')
    assert composer_post['schema'] == 'rea-notes-todo-hosted-postrun-source-check/v1' and composer_post['status'] == 'passed'
    assert composer_post['execution'] == execution and composer_post['sourceCommit'] == HEAD
    assert composer_post['sourceStable'] is True and composer_post['checkedTargets'] == 8
    assert composer_post['compositionSHA256'] == sha(content('notes-todo-composition.json'))
    assert composer_post['currentTargets'] == composition['currentTargets'] and composer_post['gitStatus'] == composition['gitStatus']
    browser_post = load('browser-postrun-source-check.json')
    assert browser_post['schema'] == 'rea-cloud-notes-browser-postrun-source-check/v1' and browser_post['status'] == 'source-verified'
    assert browser_post['execution'] == execution and browser_post['sourceCommit'] == HEAD and browser_post['priorBrowserStatus'] == 'passed'
    assert browser_post['sourceStable'] is True and browser_post['applicationSourcesChanged'] is False
    assert browser_post['browserAttempt'] == identity(content('browser-attempt.json'))
    assert browser_post['composerPostcheck'] == identity(content('notes-todo-postrun-source-check.json'))
    assert browser_post['sourceAuthentication'] == attempt['sourceAuthentication']
    assert load('browser-postrun-source-after.json') == before
    workflow = load('notes-browser-workflow-attempt.json')
    assert workflow['schema'] == 'rea-notes-todo-browser-workflow-attempt/v1' and workflow['sourceCommit'] == HEAD
    assert workflow['runId'] == RUN and workflow['runAttempt'] == '1' and workflow['runnerEnvironment'] == 'github-hosted'
    assert [workflow[key] for key in ('checkoutOutcome', 'acquisitionOutcome', 'compositionOutcome', 'browserOutcome', 'composerPostcheckOutcome', 'browserPostcheckOutcome')] == ['success'] * 6
    assert all(workflow[k] is False for k in ('productionInstalled', 'historicalReceiptsRebound', 'acceptancePreclaimed', 'fullParity', 'superiority'))
    assert not (evidence / 'storage-failure.json').exists()
    result.update({'recordedEightScenarioNotesGatesConsistent': True, 'realHoldsVerified': holds,
                   'realDownloadsVerified': downloads, 'pngCRCReadbacks': screenshots,
                   'ownedSyntheticDiskRecordsVerified': disk_rows, 'ownedCleanupRecordsVerified': cleanups,
                   'scenarioObservations': summaries, 'composerPostcheckVerified': pin(browser_post['composerPostcheck']),
                   'browserPostcheckVerified': identity(content('browser-postrun-source-check.json')),
                   'sameAttemptWorkerRecordsVerified': 1, 'sourceAuthentication': attempt['sourceAuthentication']})


