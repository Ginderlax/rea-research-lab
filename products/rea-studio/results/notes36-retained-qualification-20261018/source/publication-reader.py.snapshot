  total+=len(content);need(total<=8*1024*1024,'Bounded aggregate decoded sources')
  payload=output/(row['sha256']+'.snapshot')
  if not payload.exists():
   with payload.open('xb') as stream: stream.write(content)
  need(payload.read_bytes()==content,'Readable exact recovered source');recovered_cache[(filename,name)]=content
  rows[name]={'sourcePath':name,'readPath':read_path,'bytes':len(content),'sha256':sha(content),'actualGitBlob':oid,'readablePayload':str(payload),'historicalView':groups,'executed':False}
 need(set(rows)==set(expected_sources) and total==envelope['rawSourceBytes']==declared['rawSourceBytes'],'Complete exact envelope source set/aggregate')
 summary={'verified':True,'schema':schema,'sourceCommit':git['sourceCommit'],'sourceFiles':len(rows),'rawSourceBytes':total,'stored':identity(stored),'decoded':identity(decoded),'allCapturedPhysicalGitBlobsVerified':True,'historicalView':groups,'rows':list(rows.values()),'sourcePayloadsExecuted':False}
