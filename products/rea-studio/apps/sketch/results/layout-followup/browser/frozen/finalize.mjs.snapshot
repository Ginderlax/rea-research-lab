// Exact source-only post-browser verification. No browser/original/app action here.
import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const root=import.meta.dirname,workspace=path.resolve(root,'../..'),hash=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:hash(b)}),read=p=>fs.readFile(path.join(root,p)),json=async(p,v)=>fs.writeFile(path.join(root,p),JSON.stringify(v,null,2)+'\n',{flag:'wx'});const before=JSON.parse(await read('authority-before.json')),candidate=path.resolve(workspace,before.root),mb=await fs.readFile(path.join(candidate,'freeze-manifest.json'));assert.deepEqual(id(mb),before.manifest);const m=JSON.parse(mb);assert.equal(m.records.length,188);const actual=[];async function census(p){for(const e of await fs.readdir(p,{withFileTypes:true})){assert.equal(e.isSymbolicLink(),false);const q=path.join(p,e.name);if(e.isDirectory())await census(q);else{assert.ok(e.isFile());actual.push(path.relative(candidate,q).replaceAll('\\','/'));}}}await census(candidate);assert.deepEqual(actual.sort(),[...m.records.map(r=>r.path),'freeze-manifest.json'].sort());for(const r of m.records)assert.deepEqual(id(await fs.readFile(path.join(candidate,r.path))),{bytes:r.bytes,sha256:r.sha256});assert.deepEqual(id(await fs.readFile(path.join(candidate,'validation.json'))),before.validation);await json('authority-after.json',{candidate188AndManifestStrictExact:true,candidateReceiptExact:true,oldSourceStageUnmodified:true,manifest:before.manifest,validation:before.validation});
const sources=JSON.parse(await read('source-before.json')),after=JSON.parse(await read('source-after.json'));assert.deepEqual(after,sources);assert.equal(sources.length,10);for(const r of sources){assert.deepEqual(id(await read(r.clone)),r.cloneIdentity);assert.deepEqual(id(await fs.readFile(path.join(workspace,r.source))),r.original);}const adapter=JSON.parse(await read('private-host-route-adapter.json')),privateHost=await read('studio/server.mjs'),hostBefore=await read('authority/shared-host-before.mjs.snapshot');assert.deepEqual(id(privateHost),adapter.after);assert.deepEqual(id(hostBefore),adapter.before);const inverse=privateHost.toString().replace(adapter.adapter.after,adapter.adapter.before);assert.deepEqual(id(Buffer.from(inverse)),adapter.before);assert.equal(sources.filter(r=>r.adapter).length,1);
const steps=JSON.parse(await read('browser-steps.json')),byLabel=new Map(steps.map(r=>[r.label,r])),plan=JSON.parse(await read('browser-plan.json')),checks=JSON.parse(await read('layout-checks.json'));assert.equal(checks.length,8);for(let i=0;i<8;i++){const c=plan.controls[i],p='control-'+i+'-',before=byLabel.get(p+'import').read.scene,after=byLabel.get(p+'layout').read.scene;assert.deepEqual(after.shapes.map(s=>s[c.axis]),c.values);assert.deepEqual(byLabel.get(p+'undo').read.scene,before);assert.deepEqual(byLabel.get(p+'redo').read.scene,after);assert.equal(byLabel.get(p+'selected').read.selection,'3 editable shapes selected');}const group=JSON.parse(await read('group-checks.json')),noop=JSON.parse(await read('noop-checks.json')),gesture=JSON.parse(await read('gesture-refusal.json'));assert.equal(group.actualCanvasGroupMemberClickSelects2,true);assert.equal(noop.alreadyArrangedCreatesNoUndo,true);assert.equal(noop.singleGroupCreatesNoUndo,true);assert.equal(gesture.refusedBeforeMutation,true);assert.equal(gesture.releaseObserved,true);assert.equal(gesture.syntheticDOMEvents,false);
const observation=JSON.parse(await read('observation-before-close.json')),api=observation.forwarded.filter(r=>r.action),saved=api.filter(r=>r.action==='save'),listed=api.filter(r=>r.action==='list'),exported=api.filter(r=>r.action==='exportExcalidraw');assert.equal(observation.actual.length,20);assert.equal(observation.forwarded.length,20);assert.equal(api.length,5);assert.equal(saved.length,1);assert.equal(listed.length,3);assert.equal(exported.length,1);assert.ok(api.every(r=>r.upstreamStatus===200&&r.response.ok));const scene=saved[0].response.result.scene,disk=observation.persisted.find(r=>r.path==='sketch/records/sketch.scene.'+scene.id+'.json');assert.ok(disk);assert.deepEqual(disk.value,scene);assert.deepEqual(id(Buffer.from(JSON.stringify(disk.value))),{bytes:disk.bytes,sha256:disk.sha256});assert.deepEqual(saved[0].input.scene.shapes,scene.shapes);assert.deepEqual(byLabel.get('saved').read.scene,scene);assert.deepEqual(byLabel.get('reopened-from-fresh-list').read.scene,scene);assert.deepEqual(listed.at(-1).response.result.scenes.find(r=>r.id===scene.id),scene);const index=observation.persisted.find(r=>r.path==='sketch/records/sketch.index.json');assert.deepEqual(index.value,[scene.id]);
const native=exported[0].response.result.document;assert.equal(native.type,'excalidraw');assert.equal(native.version,2);assert.deepEqual(native.elements.map(e=>({id:e.id,x:e.x,y:e.y,width:e.width,height:e.height,groupIds:e.groupIds??[]})),scene.shapes.map(s=>({id:s.id,x:s.x,y:s.y,width:s.w,height:s.h,groupIds:s.groupIds??[]})));await json('native-response-verification.json',{forwardedId:exported[0].id,document:native,HTTPResponseIdentity:exported[0].upstreamBody,exactIdsCoordinatesWidthsHeightsAndGroups:true,downloadFileVerification:false,originalNativeValidationExecuted:false});
const routes=observation.forwarded.filter(r=>r.url==='/apps/sketch/layout.mjs');assert.equal(routes.length,2);for(const r of routes){assert.equal(r.upstreamStatus,200);assert.deepEqual(r.upstreamBody,sources.find(r=>r.path==='apps/sketch/layout.mjs').cloneIdentity);}const download=JSON.parse(await read('native-download-bridge.json'));assert.equal(download.downloadFileVerified,false);assert.equal(download.bridgeError.message,'Timed out after 10000ms waiting for download.');const cleanup=JSON.parse(await read('cleanup.json')),tab=JSON.parse(await read('tab-cleanup.json'));assert.equal(cleanup.hostClosed&&cleanup.relayClosed&&cleanup.tempDataRemoved&&cleanup.sourceStable,true);assert.equal(tab.ownedTabCloseResolved,true);
const screenshotRows=steps.filter(r=>r.screenshot).map(r=>({label:r.label,...r.screenshot}));assert.equal(screenshotRows.length,9);for(const r of screenshotRows){const b=await read(r.path);assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});assert.equal(b.subarray(0,3).toString('hex'),'ffd8ff');assert.equal(r.actualMediaType,'image/jpeg');assert.ok(r.path.endsWith('.jpeg'));}await json('screenshot-census.json',{actualMediaType:'image/jpeg',rows:screenshotRows,images9Exact:true,originalFilenameMismatch:false,scope:'Owned actual Chrome corrected188/private one-route campaign; paired DOM/HTTP/disk evidence, no original GUI.'});
const sourceBaseline=JSON.parse(await fs.readFile(path.join(candidate,'source-baseline.json')));for(const r of sourceBaseline){assert.deepEqual(id(await fs.readFile(path.join(workspace,'outputs/rea-research-lab',r.path))),{bytes:r.bytes,sha256:r.sha256});}await json('production-baseline-postcheck.json',{records:sourceBaseline,historicalAuthorBaseline14StillMatchesCurrent:true,newCurrentSourceWrites:0,freshBeforeCaptureOfAll14ByThisBrowserCampaign:false,scope:'Ten live/copied browser sources have fresh before/after capture. Broader14 historical baseline is authenticated at postcheck and is not relabelled a new full before/after campaign.'});const started=steps[0].at,finished=tab.at,sourceGate=before.manifest;await json('accounting.json',{actualBrowserCampaigns:1,actualBrowser:'Chrome extension, created dedicated private tab',observations:steps.length,semanticGroups:14,layoutControls:8,groupSelectionAndOffsets:1,noopBoundaries:2,heldRealGestureRefusal:1,persistenceFreshReload:1,nativeHTTPExport:1,actualHostRequests:20,relayForwardedRequests:20,browserAPIRequests:5,browserSaveRequests:1,listRequests:3,nativeExportRequests:1,programmaticSeedCalls:0,persistedRecords:2,layoutRouteLoads:2,actualJPEGImages:9,downloadFileAccepted:false,downloadBridgeTimeoutMs:10000,debugDownloadEventObservationTruncated:true,originalAppOrGUIExecutions:0,originalHelperExecutions:0,testSuiteExecutions:0,benchmarks:0,profilers:0,started,finished});await json('validation.json',{schema:'rea-sketch-layout-corrected-browser-validation/v1',at:new Date().toISOString(),finiteBrowserAcceptance:true,semanticGroups:14,sourceFiles:10,sourceStable:true,candidateManifest:sourceGate,candidatePayloads:188,clientSHA256:sources.find(r=>r.path==='apps/sketch/client.mjs').original.sha256,layoutSHA256:sources.find(r=>r.path==='apps/sketch/layout.mjs').original.sha256,oneProspectivePrivateHostRouteAdapter:true,productionHostRouteAccepted:false,originalHostReconstructsExactly:true,allEightLayoutButtons:true,exactFractionalCoordinates:true,eachOneStepUndoRedo:true,actualGroupClickSelection:true,groupOffsetsPreserved:true,bothNoopHistoryBoundaries:true,realHeldPointerKeyboardLayoutRefused:true,actualBrowserSave1:true,freshReloadReopenExact:true,diskCommittedSceneExact:true,nativeExportHTTPAndDocumentExact:true,actualDownloadFileAcceptance:false,downloadEventBridgeTimeoutRetained:true,permissionChanges:false,ownedHostTabRelayNormalCleanup:true,tempDataRemoved:true,oldCandidate188Unmodified:true,StudioWrites:0,user4311Touched:false,otherTabsOrHostsChanged:false,originalGUI:0,originalHelpers:0,testSuites:0,benchmarks:0,profiling:0,fullParity:false,universalCorrectness:false,comparativeImprovement:false,diagnostics:[{name:'own cross-realm prototype assertion',productFinding:false,sourceAndMessageAndPartialStepsRetained:true,firstLayoutNotReapplied:true},{name:'download-event bridge',actualNativeHTTPPassed:true,downloadFileUnverified:true,noPermissionChange:true},{name:'favicon404',productFinding:false,scope:'Private shell asset request, unrelated to layout API success.'},{name:'optional absent host.stderr postread exit1',productFinding:false,scope:'Post-cleanup shell read only; no error text; host exit0 and source cleanup checks passed.'}],limits:'Bounded owned host/relay/request/response/retention/campaign controls; no machine isolation, hard whole-process memory watchdog or universal Windows descendant guarantee.'});console.log(JSON.stringify({semanticGroups:14,sourceFiles:10,sourceStable:true,exactEightControls:true,HTTP20API5Save1Export1:true,candidate188Exact:true,downloadFileAccepted:false,cleanup:true,StudioWrites:0}));
