    {
      "id": "grafana.candidate.fe64bf2e1d4af14ba04f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Enter only the base URL. Don't append API paths such as `/loki/api/v1/push`. That endpoint sends logs to Loki with an agent like Grafana Alloy; it isn't used to query Loki from the data source.",
      "headingPath": [
        "Configure the Loki data source",
        "Configure the data source in the UI",
        "Connection"
      ],
      "source": {
