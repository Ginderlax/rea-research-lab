    },
    {
      "id": "grafana.candidate.1f546734ac23cded352f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Audit logs are sent to a [Loki](https://grafana.com/oss/loki/)-compatible endpoint through HTTP or gRPC. You can use this exporter to send logs to Grafana Cloud Logs, a self-hosted Loki instance, or any other service that accepts the Loki push API.",
      "headingPath": [
        "Audit a Grafana instance",
        "Configure audit logging",
        "Loki exporter"
      ],
      "source": {
