from pathlib import Path
import hashlib,json,shutil
w=Path('C:/Users/evanh/Documents/Codex/2026-10-12/go/work')
prior=w/'notes-new-todo-r2-next';stage=w/'notes-new-todo-r3-next'
assert not stage.exists();stage.mkdir();shutil.copytree(prior/'candidate',stage/'candidate')
candidate=stage/'candidate';pin=lambda b:{'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
source=candidate/'products/rea-studio/apps/notes/client.mjs';b=source.read_bytes()
old=b'Due dates are metadata; this app does not send alarms.'
new=b'Due dates help you track tasks; reminders are not available yet.'
assert b.count(old)==1;b=b.replace(old,new);source.write_bytes(b)
contract=json.loads((prior/'source-contract.json').read_bytes())
prefix='products/rea-studio/experiments/notes-new-todo/original/'
for row in contract['originalSources']:
    path=row['path']
    if '/stage/original/' in path:
        path=path.split('/stage/original/',1)[1]
        while path.endswith('.snapshot'):path=path[:-len('.snapshot')]
    else:
        assert path.startswith(prefix) and path.endswith('.snapshot')
        path=path[len(prefix):-len('.snapshot')]
    row['url']='https://github.com/laurent22/joplin/blob/'+contract['originalCommit']+'/'+path
contract['userCopy']='Due dates help you track tasks; reminders are not available yet.'
encoded=(json.dumps(contract,indent=2)+'\n').encode()
(stage/'source-contract.json').write_bytes(encoded)
(candidate/'products/rea-studio/experiments/notes-new-todo/contract.json').write_bytes(encoded)
shutil.copyfile(prior/'IMPLEMENTATION-PLAN.md',stage/'IMPLEMENTATION-PLAN.md')
authority=json.loads((prior/'change-authority.json').read_bytes());authority['candidateRoot']=str(candidate)
for row in authority['files']:row['after']=pin((candidate/row['path']).read_bytes())
authority['candidateBytes']=sum(r['after']['bytes'] for r in authority['files'])
authority['supersededFutureSourceAuthority']=pin((prior/'change-authority.json').read_bytes())
authority['sourceAuthoringNotes'].append('R3 preserves frozen R2 and applies the parent-requested plain due-date copy in this future client only; six explicit pinned original URLs are added to the source contract. No text-only test or active copy was made.')
out=stage/'change-authority.json';out.write_bytes((json.dumps(authority,indent=2)+'\n').encode())
print(json.dumps({'path':str(out),**pin(out.read_bytes()),'candidateFiles':authority['candidateFiles'],'candidateBytes':authority['candidateBytes'],'contract':pin(encoded),'client':pin(b),'sourceOnly':True}))
