    },
    {
      "id": "grafana.candidate.0da911c3a29f70d87b8e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For example, if you provide the following `updates`:",
      "headingPath": [
        "Settings updates at runtime",
        "Update settings via the API"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/settings-updates-at-runtime/index.md",
        "gitBlobSha": "b3667bbf9771fe45d85c598660c42b6986801450",
        "sha256": "ee807afb8e2274f561d14247f34feee43e3a51d6fcdc4c4fd21e54eb08671d90",
        "lineStart": 46,
        "lineEnd": 46,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/settings-updates-at-runtime/index.md#L46-L46"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
