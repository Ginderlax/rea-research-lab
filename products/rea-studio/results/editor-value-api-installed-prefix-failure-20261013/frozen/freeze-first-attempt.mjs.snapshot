async function walk(root,prefix=''){const a=[];for(const e of(await fs.readdir(root,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){assert(!e.isSymbolicLink());const p=prefix+e.name;if(e.isDirectory())a.push(...await walk(path.join(root,e.name),p+'/'));else a.push(p);}return a;}
const inventory={};let bytes=0;for(const p of await walk(here)){const b=await fs.readFile(path.join(here,p));inventory[p]=id(b);bytes+=b.length;}
