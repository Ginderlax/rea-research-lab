    {
      "id": "grafana.candidate.f850504b69261fee2170",
      "syntaxRole": "table-row",
      "sourceText": "| **Log Analytics workspace**    | An Azure resource that collects and stores log data from your Azure resources, applications, and services. You query this data using KQL.                                                                                                                                                                                                 |",
