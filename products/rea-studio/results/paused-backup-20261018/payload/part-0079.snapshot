    {
      "id": "grafana.candidate.76832d396b35cc0cb7fe",
      "syntaxRole": "list-item",
      "sourceText": "- Search for label matchers and for contact points to see which notifications are going where",
      "headingPath": [
        "What's new in Grafana v9.5",
