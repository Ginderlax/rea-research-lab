import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
const root=import.meta.dirname,old=path.resolve(root,'../keepass-recycle-next'),review=path.resolve(root,'../keepass-recycle-independent-review'),hash=b=>createHash('sha256').update(b).digest('hex');
const fp=async file=>{const b=await fs.readFile(file);return{bytes:b.length,sha256:hash(b)};};
const mf=path.join(old,'manifest.json'),receipt=path.join(old,'validation.json'),manifest=JSON.parse(await fs.readFile(mf));
if((await fp(mf)).sha256!=='769523b00c626762f18aec86ee8df8f1bb317ff4bbc8147a09a03af44161c100'||(await fp(receipt)).sha256!=='8911d007286682869c3346319e17e58342a730ba5af995d7af32c1faa684b0e1')throw new Error('Original freeze identities');
const rows=manifest.records??manifest.files;if(rows.length!==546)throw new Error('Artifact census');for(const r of rows){const a=await fp(path.join(old,r.path));if(a.bytes!==r.bytes||a.sha256!==r.sha256)throw new Error('Old stage changed '+r.path);}
async function copy(source,destination){await fs.mkdir(path.dirname(destination),{recursive:true});await fs.copyFile(source,destination);}
const copies=[];for(const r of rows.filter(r=>r.path.startsWith('products/')&&!r.path.includes('/results/'))){await copy(path.join(old,r.path),path.join(root,r.path));copies.push(r);}
for(const name of['manifest.json','validation.json','freeze.json','README.md','NOTICE.md','source-provenance.json','contract-evidence.json','failure-ledger.json'])await copy(path.join(old,name),path.join(root,'prior-stage-binding',name+'.snapshot'));
const reviewer={test:{name:'bin-boundaries.test.mjs',hash:'c095a6eadde6805eac2f7b50806f695aa95aa2794f8d86d5024aa7a80653354a'},helper:{name:'ui-helper.mjs',hash:'102f79599e077a957ffa2342f288eb1a0e2dd5b24bba5f57f993f0efb3e7b93c'},stdout:{name:'bin-boundaries.stdout.txt',hash:'a2d491543a2d84605f7ef95428413d099b75d6ccbd83fb9222829aea8d26e753'},stderr:{name:'bin-boundaries.stderr.txt',hash:'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'}};
for(const r of Object.values(reviewer)){if((await fp(path.join(review,r.name))).sha256!==r.hash)throw new Error('Reviewer identity '+r.name);await copy(path.join(review,r.name),path.join(root,'prior-independent-failures',r.name+(r.name.endsWith('.mjs')?'.snapshot':'')));}
for(const entry of await fs.readdir(path.join(review,'observations'),{withFileTypes:true}))if(entry.isFile()&&entry.name.endsWith('.json'))await copy(path.join(review,'observations',entry.name),path.join(root,'prior-independent-failures','observations',entry.name));
await copy(path.join(review,reviewer.test.name),path.join(root,'regression',reviewer.test.name));let helper=await fs.readFile(path.join(review,reviewer.helper.name),'utf8');const from="../keepass-recycle-next/products/rea-studio/apps/vault/",to="../products/rea-studio/apps/vault/";if(helper.split(from).length!==2)throw new Error('Helper path adapter');helper=helper.replace(from,to);await fs.mkdir(path.join(root,'regression'),{recursive:true});await fs.writeFile(path.join(root,'regression','ui-helper.mjs'),helper);
const clientPath=path.join(root,'products/rea-studio/apps/vault/client.mjs'),before=await fs.readFile(clientPath,'utf8');await copy(clientPath,path.join(root,'prior-stage-binding','client.mjs.snapshot'));const oldText='await list();if(viewCurrent())await binList();',newText='await list();if(binCurrent())await binList();';if(before.split(oldText).length!==3)throw new Error('Exactly two guard sites expected');await fs.writeFile(clientPath,before.replaceAll(oldText,newText));
const production=path.resolve(root,'../../outputs/rea-research-lab/products/rea-studio/apps/vault'),productionBaseline=[];for(const n of['client.mjs','server.mjs','kdbx.mjs','xml.mjs','history.mjs'])productionBaseline.push({path:path.join(production,n),...await fp(path.join(production,n))});
await fs.writeFile(path.join(root,'baseline.json'),JSON.stringify({schema:'rea-vault-bin-generation-fix-baseline/v1',capturedAt:new Date().toISOString(),previousStage:{root:'work/keepass-recycle-next',count:546,manifestSha256:hash(await fs.readFile(mf)),receiptSha256:hash(await fs.readFile(receipt)),preservation:'Immutable manifest reference and selected exact snapshots, no recursive historical recopy'},copies,reviewer,adaptation:{unchangedFiveTestBodies:true,helper:{from,to,changedOccurrences:1},client:{from:oldText,to:newText,changedOccurrences:2},runtimeSemanticsBeyondClientGuard:false},productionBaseline},null,2)+'\n');console.log(JSON.stringify({copied:copies.length,oldStageArtifactsAuthenticated:546,client:await fp(clientPath)}));
