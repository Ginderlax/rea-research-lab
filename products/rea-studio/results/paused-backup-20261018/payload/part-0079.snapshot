      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Learn more in the [Format string documentation](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/panels-visualizations/query-transform-data/transform-data/#format-string).",
