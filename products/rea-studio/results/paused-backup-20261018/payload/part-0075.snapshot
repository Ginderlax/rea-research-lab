    {
      "id": "grafana.candidate.60327d5f94654c0551bb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The previous instructions enable sending **all** Grafana-managed alerts to an Alertmanager.",
      "headingPath": [
