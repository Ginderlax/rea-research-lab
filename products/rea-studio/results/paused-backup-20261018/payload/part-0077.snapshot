    {
      "id": "grafana.candidate.57eb65c8e9152df88d3f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use this configuration option to set the default error message shown to users. This message is displayed instead of sensitive backend errors, which should be obfuscated. The default message is `Please inspect the Grafana server log for details.`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[log]`",
        "`user_facing_default_error`"
      ],
