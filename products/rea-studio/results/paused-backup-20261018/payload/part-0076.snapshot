        "lineStart": 58,
        "lineEnd": 58,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/loki/template-variables/index.md#L58-L58"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b2913410bd5d166333cf",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, the Loki data source formats variable values based on the variable's settings:",
      "headingPath": [
        "Loki template variables",
        "Format variable values"
      ],
      "source": {
        "path": "docs/sources/datasources/loki/template-variables/index.md",
