    },
    {
      "id": "grafana.candidate.981edd367a74cb3ae29a",
      "syntaxRole": "table-row",
      "sourceText": "| Color | Configures the color of the nodes. The default `Fixed color` sets all nodes to a specific color. There is also an option to have conditional colors depending on the selected field data point values and the color scheme set in the `Standard options` section. |",
      "headingPath": [
        "Geomap",
        "Configuration options",
        "Map layers options",
        "Network layer",
        "Node styles options"
      ],
