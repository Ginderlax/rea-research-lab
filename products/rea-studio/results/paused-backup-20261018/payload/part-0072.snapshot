import { executeNative, inspectNativeState } from '../outputs/rea-research-lab/products/rea-studio/apps/flow/native.mjs';
const flow = rules => JSON.stringify([{id:'in',type:'inject',props:[],wires:[['change']]},{id:'change',type:'change',rules,wires:[['out']]},{id:'out',type:'debug',complete:'true',wires:[]}]);
await assert.rejects(executeNative(flow([{t:'set',p:'payload.extra.x',pt:'msg',to:'retained?',tot:'str'}]),{messages:[{payload:Buffer.from([1,2])}]}),/Buffer byte/);
const rules = [{t:'set',p:'bag',pt:'global',to:'[]',tot:'json'},{t:'set',p:'bag.x',pt:'global',to:'x'.repeat(600000),tot:'str'},...Array.from({length:11},(_,i)=>({t:'set',p:'bag.copy'+i,pt:'global',to:'bag.x',tot:'global'}))];
await assert.rejects(executeNative(flow(rules)),/byte limit/);
const safe=await executeNative(flow(rules.slice(0,2)));assert.equal(inspectNativeState(JSON.parse(JSON.stringify(safe.packedState))).global.bag.x.length,600000);
console.log('Buffer intermediate writes refuse; 12x600k named array context refuses; safe named array property reopens.');
import { executeNative, inspectNativeState } from '../outputs/rea-research-lab/products/rea-studio/apps/flow/native.mjs';
const flow = rules => JSON.stringify([{id:'in',type:'inject',props:[],wires:[['change']]},{id:'change',type:'change',rules,wires:[['out']]},{id:'out',type:'debug',complete:'true',wires:[]}]);
const bufferWrite = flow([{t:'set',p:'payload.extra.x',pt:'msg',to:'retained?',tot:'str'}]);
try { const result = await executeNative(bufferWrite,{messages:[{payload:Buffer.from([1,2])}]}); console.log(JSON.stringify({probe:'nested non-byte Buffer write',result:'completed',extra:result.debug[0].message.payload.extra ?? null})); } catch (error) { console.log(JSON.stringify({probe:'nested non-byte Buffer write',error:error.message})); }
const rules = [{t:'set',p:'bag',pt:'global',to:'[]',tot:'json'},{t:'set',p:'bag.x',pt:'global',to:'x'.repeat(600000),tot:'str'},...Array.from({length:11},(_,i)=>({t:'set',p:'bag.copy'+i,pt:'global',to:'bag.x',tot:'global'}))];
const result = await executeNative(flow(rules));
console.log(JSON.stringify({probe:'array own property byte bounds',packedBytes:Buffer.byteLength(JSON.stringify(result.packedState)),ownPropertyBytes:Object.values(result.state.global.bag).reduce((n,v)=>n+Buffer.byteLength(v),0),properties:Object.keys(result.state.global.bag).length}));
try {inspectNativeState(JSON.parse(JSON.stringify(result.packedState)));console.log('reopened');}catch(error){console.log(JSON.stringify({probe:'array own property reopen',error:error.message}));}
