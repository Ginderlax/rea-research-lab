import fs from 'node:fs/promises';
import {createReadStream} from 'node:fs';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import {spawn} from 'node:child_process';
import assert from 'node:assert/strict';
import {authenticateOriginal} from './authenticate-original.mjs';
const here=path.dirname(fileURLToPath(import.meta.url)),[mode,quietFrom,variant='control']=process.argv.slice(2),sha=bytes=>createHash('sha256').update(bytes).digest('hex');
assert.ok(mode==='--check-only'||mode==='--quiet-confirmed','Select non-measuring correctness checks or a newly coordinated quiet window.');assert.ok(variant==='control','Unexpected candidate manifest.');const manifestName='memory-preflight.'+variant+'.json',manifestBytes=await fs.readFile(path.join(here,manifestName)),manifest=JSON.parse(manifestBytes);assert.equal(manifest.variant,variant);
if(mode==='--quiet-confirmed'){assert.equal(process.platform,'win32','Declared owned-PID RSS observer is Windows-specific.');assert.ok(/^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{3})?Z$/.test(quietFrom)&&Date.parse(quietFrom)>Date.parse(manifest.checkedAt)&&Date.parse(quietFrom)<=Date.now(),'New coordinator quiet timestamp must follow this preflight.');}
const boundNames=['memory-runner.mjs','memory-worker.mjs','canonical.mjs','watch-owned-process.ps1','authenticate-original.mjs','workloads.mjs','candidate-baseline.mjs','candidate-module-control.mjs','selector-control.mjs'],before={};for(const name of boundNames)before[name]=sha(await fs.readFile(path.join(here,name)));
if(mode==='--quiet-confirmed'){const checks=JSON.parse(await fs.readFile(path.join(here,'results/memory-harness-checks.'+variant+'.json')));assert.equal(checks.status,'passed');assert.equal(checks.measurementRun,false);assert.equal(checks.variant,variant);assert.deepEqual(checks.sourceHashesBefore,before);assert.deepEqual(checks.sourceHashesAfter,before);assert.equal(checks.manifestSHA256,sha(manifestBytes));assert.equal(checks.samples.length,3);for(const sample of checks.samples){assert.equal(sample.result.comparisons,21);assert.equal(sample.result.loadedReducerImplementations,1);assert.equal(sample.result.measurementRun,false);}const authority=await authenticateOriginal();assert.equal(authority.archiveSHA256,manifest.authority.archiveSHA256);assert.deepEqual(authority.files,manifest.authority.files);const fullBytes=await fs.readFile(path.join(here,manifest.fullSemanticReceipt));assert.equal(sha(fullBytes),manifest.fullSemanticReceiptSHA256);const full=JSON.parse(fullBytes);assert.equal(full.failedAcceptanceAttempts,0);assert.equal(full.bothNativeModulesBoundBeforeAndAfter,true);assert.equal(full.candidate.entrySHA256,before['candidate-module-control.mjs']);assert.equal(full.candidate.helperSHA256,before['selector-control.mjs']);for(const fixture of Object.values(manifest.expectedFiles)){assert.equal(sha(await fs.readFile(path.join(here,fixture.path))),fixture.sha256);assert.equal(sha(await fs.readFile(path.join(here,fixture.inputPath))),fixture.inputFileSHA256);}}
const executableHash=createHash('sha256');for await(const chunk of createReadStream(process.execPath))executableHash.update(chunk);assert.equal(executableHash.digest('hex'),manifest.runtime.executableSHA256);
async function verifySelected(implementation){for(const [name,hash]of Object.entries(manifest.implementations[implementation].files))assert.equal(sha(await fs.readFile(name)),hash);}
const samples=[],start=new Date().toISOString();await fs.mkdir(path.join(here,'results'),{recursive:true});
async function run(implementation,caseName,runNumber){
  await verifySelected(implementation);const startedAt=new Date().toISOString(),measuring=mode==='--quiet-confirmed',args=[...(measuring?['--expose-gc','--max-old-space-size='+manifest.limits.childOldSpaceMiB]:[]),path.join(here,'memory-worker.mjs'),measuring?'measure':'check-only',implementation,caseName,measuring?quietFrom:'unused',variant],child=spawn(process.execPath,args,{windowsHide:true,stdio:[measuring?'pipe':'ignore','pipe','pipe']});
  let stdout='',stderr='',failure,watcher,watcherOutput='',watcherErrors='',observerTail='',observerReady=false;const observed=[];
  const stop=reason=>{failure??=reason;child.kill();};
  const deadline=setTimeout(()=>stop('Child exceeded declared wall time.'),manifest.limits.childWallSeconds*1000);
  if(measuring){watcher=spawn('powershell.exe',['-NoProfile','-NonInteractive','-File',path.join(here,'watch-owned-process.ps1'),'-OwnedProcessId',String(child.pid)],{windowsHide:true,stdio:['ignore','pipe','pipe']});watcher.stdout.on('data',bytes=>{watcherOutput+=bytes;observerTail+=bytes;if(Buffer.byteLength(watcherOutput)>manifest.limits.stdoutBytes)stop('Owned-PID observer output bound exceeded.');for(;;){const newline=observerTail.indexOf('\n');if(newline<0)break;const line=observerTail.slice(0,newline).trim();observerTail=observerTail.slice(newline+1);if(!line)continue;try{const record=JSON.parse(line);assert.equal(record.pid,child.pid);observed.push(record);if(record.rss>manifest.limits.childRSSMiB*1024*1024)stop('Owned child exceeded declared RSS limit.');if(!observerReady&&!failure){observerReady=true;child.stdin.end('start\n');}}catch(error){stop('Invalid owned-PID observer record: '+error.message);}}});watcher.stderr.on('data',bytes=>{watcherErrors+=bytes;if(Buffer.byteLength(watcherErrors)>65536)stop('Owned-PID observer error bound exceeded.');});watcher.on('error',error=>stop('Owned-PID observer failed: '+error.message));watcher.on('close',()=>{if(child.exitCode===null&&child.signalCode===null)stop('Owned-PID observer exited while child remained active.');});child.stdin.on('error',error=>stop('Measurement-start channel failed: '+error.message));}
  child.stdout.on('data',bytes=>{stdout+=bytes;if(Buffer.byteLength(stdout)>manifest.limits.stdoutBytes)stop('Child stdout bound exceeded.');});child.stderr.on('data',bytes=>{stderr+=bytes;if(Buffer.byteLength(stderr)>manifest.limits.stdoutBytes)stop('Child stderr bound exceeded.');});
  const outcome=await new Promise(resolve=>{child.on('error',error=>{failure??=error.message;resolve({code:null,signal:null});});child.on('close',(code,signal)=>resolve({code,signal}));});clearTimeout(deadline);if(watcher){watcher.kill();await new Promise(resolve=>{if(watcher.exitCode!==null||watcher.signalCode!==null)resolve();else watcher.once('close',resolve);});if(watcherErrors.trim())failure??='Owned-PID observer reported errors.';if(observed.length===0)failure??='Owned-PID observer produced no sample.';}
  const rows=stdout.trim().split('\n').filter(Boolean).map(line=>{try{return JSON.parse(line);}catch{return {invalidJSON:line};}}),result=rows.find(row=>row.kind==='result');if(outcome.code!==0||!result)failure??='Worker did not return a successful result.';if(result&&(result.variant!==variant||result.manifestSHA256!==sha(manifestBytes)||result.loadedReducerImplementations!==1))failure??='Worker selected a different candidate manifest or module count.';
  await verifySelected(implementation);const record={implementation,caseName,runNumber,startedAt,completedAt:new Date().toISOString(),pid:child.pid,args,...outcome,failure,result,ownedPIDObserver:{samples:observed.length,peakRSS:observed.length?Math.max(...observed.map(row=>row.rss)):null,independentWatcher:measuring},stdoutSHA256:sha(stdout),stderrSHA256:sha(stderr)};
  const stem=(measuring?'memory':'memory-preflight-check')+'-'+variant+'-'+implementation+'-'+caseName+'-'+runNumber+'-'+Date.now();for(const [suffix,value]of [['.stdout.txt',stdout],['.stderr.txt',stderr],['.observer.txt',watcherOutput],['.observer-errors.txt',watcherErrors]])await fs.writeFile(path.join(here,'results',stem+suffix),value);samples.push(record);console.log(JSON.stringify({implementation,variant,caseName,runNumber,status:failure?'failed':'passed',comparisons:result?.comparisons,measurementRun:measuring}));
  if(failure)throw Error(failure);
}
let caught;try{if(mode==='--check-only'){for(const implementation of ['original','baseline','candidate'])await run(implementation,'all-seven',0);}else for(let runNumber=0;runNumber<manifest.limits.samplesPerWorkloadAndImplementation;runNumber++)for(const caseName of Object.keys(manifest.expectedFiles))for(let offset=0;offset<3;offset++)await run(['original','baseline','candidate'][(runNumber+offset)%3],caseName,runNumber);}catch(error){caught=error.message;}
const after={};for(const name of boundNames)after[name]=sha(await fs.readFile(path.join(here,name)));assert.deepEqual(after,before);assert.equal(sha(await fs.readFile(path.join(here,manifestName))),sha(manifestBytes));
const receipt={schemaVersion:2,checkedAt:new Date().toISOString(),interval:{start,end:new Date().toISOString()},status:caught?'failed':'passed',error:caught,mode,variant,quietFrom:mode==='--quiet-confirmed'?quietFrom:undefined,sourceHashesBefore:before,sourceHashesAfter:after,manifestSHA256:sha(manifestBytes),singleImplementationPerWorker:true,samples,measurementRun:mode==='--quiet-confirmed',fullProductComplete:false,universalSuperiorityEstablished:false};const name=mode==='--check-only'?'memory-harness-checks.'+variant+'.json':'memory-observations-'+variant+'-'+Date.now()+'.json',output=JSON.stringify(receipt,null,2)+'\n';await fs.writeFile(path.join(here,'results',name),output);console.log(JSON.stringify({receipt:path.join(here,'results',name),sha256:sha(output),status:receipt.status,measurementRun:receipt.measurementRun}));if(caught)process.exitCode=1;
