    {
      "id": "grafana.candidate.c73bd757afe25ac76440",
      "syntaxRole": "list-item",
      "sourceText": "- **No index name configured:** You specify which index to query using the `FROM` command directly in your ES|QL query. This lets you query any index without creating a separate data source for each one.",
      "headingPath": [
        "Elasticsearch query editor",
