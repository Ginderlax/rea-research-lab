assert ident(ab)=={'bytes':27531,'sha256':'9f14de8432688d8acc94a2cccb49395dbd439845e66b95816512181a72c78d13'}
a=json.loads(ab); assert a['sourceOnly'] and a['baseCommittedSource']==HEAD
rows=a['files']; names={r['path'] for r in rows}
assert len(rows)==len(names)==a['candidateFiles']==59
assert {p.relative_to(C).as_posix() for p in C.rglob('*') if p.is_file()}==names
assert sum(r['after']['bytes'] for r in rows)==a['candidateBytes']==771755
main=[r for r in rows if r['role']=='main-cloud-source']
hist=[r for r in rows if r['role']=='new-historical-source-preservation']
assert len(main)==25 and len(hist)==34
tracked=set(git('ls-tree','-r','--name-only',HEAD).decode().splitlines())
for r in rows:
    pin(read(C/r['path']),r['after'])
