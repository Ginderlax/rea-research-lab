    {
      "id": "grafana.candidate.af3bfd129dd863331ae9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When adding a data source, ensure the database user you specify has only `SELECT` permissions on the relevant database and tables. Grafana doesn't validate the safety of queries, which means they can include potentially harmful SQL statements, such as `USE otherdb;` or `DROP TABLE user;`, which could get executed.",
      "headingPath": [
        "Configure the MySQL data source",
        "Before you begin",
        "Database user permissions"
      ],
