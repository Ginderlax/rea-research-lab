    {
      "id": "grafana.candidate.7e8888abb94f39a6bf82",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By using Team Sync, you can map GitLab groups to teams within Grafana. This will automatically assign users to the appropriate teams. Teams for each user are synchronized when the user logs in.",
      "headingPath": [
        "Configure GitLab OAuth authentication",
        "Configure team synchronization"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/gitlab/index.md",
