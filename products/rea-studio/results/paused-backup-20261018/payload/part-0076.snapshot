    {
      "id": "grafana.candidate.eac16a99c1004fa5ba27",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For example, entering `us-*` captures all values that start with \"us-\", and entering `*central-a` captures all values that end with \"central-a\". `*-central-*` captures all values with the substring of \"-central-\".",
      "headingPath": [
        "Google Cloud Monitoring query editor",
        "Query metrics",
        "Apply a filter",
        "Use simple wildcards"
      ],
      "source": {
        "path": "docs/sources/datasources/google-cloud-monitoring/query-editor/index.md",
