    {
      "id": "grafana.candidate.ccbfb9c493e961941019",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Confirm the InfluxDB host IP address or hostname hasn't changed. This is especially important after infrastructure migrations or Grafana upgrades.",
