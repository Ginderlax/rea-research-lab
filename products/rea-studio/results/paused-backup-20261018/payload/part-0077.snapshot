    {
      "id": "grafana.candidate.89b71e6df2220ae8819b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The maximum number of idle connections that Grafana maintains. Default is `100`. For more information, refer to the [`Transport.MaxIdleConns`](https://golang.org/pkg/net/http/#Transport.MaxIdleConns) documentation.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[dataproxy]`",
        "`max_idle_connections`"
      ],
