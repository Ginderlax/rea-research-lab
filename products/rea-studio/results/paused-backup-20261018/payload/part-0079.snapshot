      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.25e4922fce72755c6a71",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Switching between grid and other layouts this way only changes the layout temporarily. The visualization maintains the layout algorithm selected in the panel editor, and reverts to it when the dashboard refreshes.",
      "headingPath": [
        "Node graph",
        "Node graph navigation",
        "Switch layouts"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/node-graph/index.md",
