    {
      "id": "grafana.candidate.d0251d70433668a2d798",
      "syntaxRole": "table-row",
      "sourceText": "| Symbol vertical align | Configures the vertical alignment of the symbol relative to the data point. Note that the symbol's rotation angle is applied first around the data point, then the vertical alignment is applied relative to the rotation of the symbol. |",
