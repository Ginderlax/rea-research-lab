      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.a92b5f6b7727a64ac81b",
      "syntaxRole": "table-row",
      "sourceText": "| `$__dateBin(<column>)`        | Applies the [`date_bin`](https://docs.influxdata.com/influxdb/cloud-serverless/reference/sql/functions/time-and-date/#date_bin) function using `$__interval`. Column must be a timestamp.           |",
      "headingPath": [
        "InfluxDB query editor",
        "SQL query editor",
        "Macros"
      ],
      "source": {
        "path": "docs/sources/datasources/influxdb/query-editor/index.md",
        "gitBlobSha": "7a8d334025a46bda1f449a23dd9329b013ede772",
