  const prefix = 'products/rea-studio/results/cloud-archive-installed-corrected-bounds-' + role + '-pass-20261016', target = path.join(candidate, prefix);
  assert(!fs.existsSync(path.join(repository, prefix))); fs.mkdirSync(path.join(target, 'payload'), { recursive: true });
