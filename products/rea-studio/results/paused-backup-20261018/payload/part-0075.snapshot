        "lineStart": 338,
        "lineEnd": 338,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/breaking-changes/breaking-changes-v10-0.md#L338-L338"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
