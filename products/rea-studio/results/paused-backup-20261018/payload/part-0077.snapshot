    },
    {
      "id": "grafana.candidate.df8bf6cbe42dca9e840e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The configuration file in Grafana Enterprise contains the following options. For more information about configuring Grafana, refer to [Configure Grafana](../).",
      "headingPath": [
        "Configure custom branding"
      ],
      "source": {
