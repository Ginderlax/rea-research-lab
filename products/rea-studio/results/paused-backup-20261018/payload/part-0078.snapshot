    {
      "id": "grafana.candidate.10a566fddd3b477ba8d5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We recommend that you upgrade Grafana often to stay current with the latest fixes and enhancements. You can upgrade to any of the supported releases from any supported release.",
      "headingPath": [
        "Upgrade Grafana"
      ],
      "source": {
        "path": "docs/sources/upgrade-guide/_index.md",
        "gitBlobSha": "2861499149442f4f4464bde426557d62d1baadfb",
        "sha256": "8a4abb39af068dde8eaf6589da64dd21ae39f206433a313e91d32a04704bd35d",
        "lineStart": 21,
        "lineEnd": 21,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/upgrade-guide/_index.md#L21-L21"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
