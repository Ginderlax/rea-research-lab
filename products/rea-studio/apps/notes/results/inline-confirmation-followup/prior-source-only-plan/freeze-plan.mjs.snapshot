const validation={schema:'rea-notes-inline-publication-plan-validation/v1',at:new Date().toISOString(),status:'source-only-authenticated-prospective-plan',counts,epochs:before.epochs.map(({rows,...r})=>r),clientBefore:'c57fe2ee532fa9ce8c8afeaa1e777428fc74ce30bebc5c4e76782169ee602d87',candidateClient:'90886819feef847847fcae8c442e0a401a1146a7a4aa1fd862a54b5e01f41da9',sourceOnlyPlanValidated:true,allOldEpochsUnchanged:true,current34BeforeImagesExact:true,backendChanges:0,StudioWrites:0,publicationCopies:0,applicationTestsExecuted:0,originalExecutions:0,hosts:0,browserActions:0,benchmarks:0,historicalAcceptance:{author69:69,independent22:22,sourceBoundIndependentAcceptance:true,auditedAuthorHelperTopLevelCalls:41,helperCodeReexecutedByPlan:false},acceptance:{rootPlanReview:false,currentInstalledEightAcceptance:false,correctedClientActualBrowser:false,productionInstalled:false,wholeProductParity:false,originalGradeSecurity:false,superiority:false},requirementsIdShaBindings159AndIds232Unchanged:true,oldRegistryFingerprintBytesRebound:false,currentAlias:'current-notice-alias-reference.json',old935920InventoryRebound:false,failedSourceOnlyAssemblyAttempts:2,oldFirstProvisionalDiagnosticRetained:true,limitations:['Carrier signatures/classification are finite, not universal encoded-secret detection','Bounded per-file and inventory source reads do not establish race-free filesystem security or hard I/O deadlines','Observed original helper counts are top-level contract projections, not original app/database/GUI or transitive telemetry','Browser evidence applies original214 only; no corrected908 browser campaign has yet run','Optional four adapters are unexecuted import-only reconstructions outside the8-file installation']};await write('validation.json',validation);
async function walk(dir,prefix=''){const rows=[];for(const e of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){if(!prefix&&e.name==='freeze-manifest.json')continue;assert.equal(e.isSymbolicLink(),false);const p=prefix+e.name;if(e.isDirectory())rows.push(...await walk(path.join(dir,e.name),p+'/'));else{assert.ok(e.isFile());rows.push({path:p,...identity(await fs.readFile(path.join(dir,e.name)))});}}return rows;}
