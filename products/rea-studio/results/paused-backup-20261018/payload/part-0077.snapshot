      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.103744ea9dbaaa1542bf",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Resource history is available on all stable (GA) API versions (for example, `v1`, `v2`)**. Alpha or beta versions may not support it.",
      "headingPath": [
        "Resource History HTTP API"
      ],
