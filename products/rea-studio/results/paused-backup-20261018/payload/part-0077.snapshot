    {
      "id": "grafana.candidate.ada14c86f55e0fa22bda",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Options to configure a remote HTTP image rendering service, for example, using https://github.com/grafana/grafana-image-renderer.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[rendering]`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
