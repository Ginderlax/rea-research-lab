import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const own=path.dirname(fileURLToPath(import.meta.url)),sha=b=>createHash('sha256').update(b).digest('hex'),json=async file=>JSON.parse(await fs.readFile(file,'utf8'));async function id(file){const b=await fs.readFile(file);return{bytes:b.length,sha256:sha(b)}}
const baseline=await json(path.join(own,'baseline-validation.json')),run=await json(path.join(own,'runs/final-independent/validation.json')),browser=await json(path.join(own,'browser-proof/validation.json'));assert.equal(run.exitCode,0);assert.equal(run.counts.tests,11);assert.equal(run.counts.pass,11);assert.equal(run.counts.skipped,0);assert.equal(run.sourceStable,true);assert.equal(browser.status,'PASS');assert.equal(browser.sourceStable,true);
for(const e of run.inputs)assert.equal((await id(path.join(own,e.path))).sha256,e.sha256,'Executed test/helper bytes changed afterward');
const authenticatedAfter=[];for(const item of [baseline.authorManifest,...baseline.oldReviews]){assert.equal((await id(item.path)).sha256,item.sha256);const m=await json(item.path),root=path.dirname(item.path);for(const e of m.files){const file=path.resolve(root,e.path);assert.ok(file.startsWith(root+path.sep));const actual=await id(file);assert.equal(actual.sha256,e.sha256);assert.equal(actual.bytes,e.bytes);}authenticatedAfter.push({...item,allEntriesStillMatchAfterReview:true});}
for(const e of baseline.candidateFingerprints){assert.deepEqual(await id(path.join(baseline.stage,e.path)),{bytes:e.bytes,sha256:e.sha256});assert.equal((await id(path.join(own,'baseline',e.path+'.snapshot'))).sha256,e.sha256);}
const oldSelection=path.resolve(own,'../keepass-history-selection-independent-review'),oldTimer=path.resolve(own,'../keepass-history-lifecycle-review'),adapters=[];
const oldWrong=await fs.readFile(path.join(oldSelection,'restore-selection.test.mjs'),'utf8'),newWrong=await fs.readFile(path.join(own,'restore-selection.test.mjs'),'utf8');assert.equal(newWrong.replaceAll('../keepass-history-draft-fix-next/','../keepass-history-selection-fix-next/'),oldWrong);adapters.push({path:'restore-selection.test.mjs',fromSha256:sha(Buffer.from(oldWrong)),toSha256:sha(Buffer.from(newWrong)),transformation:'Only two runtime import paths changed; test body exact'});
for(const [name,source]of [['selection-boundaries.test.mjs',path.join(oldSelection,'selection-boundaries.test.mjs')],['same-editor-draft.test.mjs',path.join(oldSelection,'same-editor-draft.test.mjs')],['preexisting-draft.test.mjs',path.resolve(own,'../keepass-history-draft-policy-review/preexisting-draft.test.mjs')],['timer/idle-view.test.mjs',path.join(oldTimer,'idle-view.test.mjs')],['ui-fixture.mjs',path.join(oldSelection,'ui-fixture.mjs')]]){const old=await id(source),current=await id(path.join(own,name));assert.deepEqual(current,old);adapters.push({path:name,fromSha256:old.sha256,toSha256:current.sha256,transformation:'Exact bytes'});}
const timerSource=await fs.readFile(path.join(oldTimer,'ui-fixture.mjs'),'utf8'),timerAdapted=await fs.readFile(path.join(own,'timer/ui-fixture.mjs'),'utf8');assert.equal(timerAdapted.replace("path.join(own,'../../keepass-history-draft-fix-next')","path.join(own,'../keepass-history-selection-fix-next')").replace("path.resolve(own,'../..')+path.sep","path.resolve(own,'..')+path.sep"),timerSource);adapters.push({path:'timer/ui-fixture.mjs',fromSha256:sha(Buffer.from(timerSource)),toSha256:sha(Buffer.from(timerAdapted)),transformation:'Only default stage and owned workspace confinement directory references changed for nested fixture; cleanup-return model exact'});await fs.writeFile(path.join(own,'input-adapters.json'),JSON.stringify({schema:'rea-independent-vault-review-adapters/v1',adapters},null,2)+'\n');
const receipt={schema:'rea-independent-keepass-draft-lifecycle-review-final/v1',createdAt:new Date().toISOString(),status:'FROZEN_FINITE_ACCEPTANCE',authorReceipt:baseline.authorReceipt,authorManifest:baseline.authorManifest,candidateFingerprints:baseline.candidateFingerprints,authenticatedAfter,focusedRun:{path:'runs/final-independent/validation.json',...await id(path.join(own,'runs/final-independent/validation.json')),counts:run.counts,sourceStable:run.sourceStable},actualBrowser:{path:'browser-proof/validation.json',...await id(path.join(own,'browser-proof/validation.json')),status:browser.status,originalApplicationExecutionsThisReview:0,allOwnedProcessesExited:browser.ownedPreview.allProcessesExited,allOwnedTabsClosed:browser.ownedPreview.allTabsClosed,user4311Untouched:true},inputAdapters:{path:'input-adapters.json',...await id(path.join(own,'input-adapters.json'))},confirmedFindingsAgainstPriorCandidate:['Wrong-entry Save after stale Restore read','Other-editor draft loss after ordinary Save','Same-editor draft loss after delayed Restore/Save','Dirty-before-Restore loss contrary to released dialog guard','Detached-view idle timer locks reopened active session (pre-existing)'],finalResult:'No material defect reproduced within the eleven finite cases and actual private browser checks. All previously confirmed findings are corrected in the accepted candidate.',collectorFailures:['failures/browser-collector-v1/failure.json','failures/browser-collector-v2/failure.json'],limits:'Finite source-assisted history and client lifecycle review. Original application executions by reviewer0; original GUI0. Author comparison counts remain separately attributed. No full parity, security certification, production HTTP loss, performance/superiority or blocked-I/O preemption claim. Production untouched by reviewer.'};await fs.writeFile(path.join(own,'review-validation.json'),JSON.stringify(receipt,null,2)+'\n');
async function walk(dir){let files=[];for(const e of await fs.readdir(dir,{withFileTypes:true})){if(e.name==='.local')continue;const file=path.join(dir,e.name);if(e.isDirectory())files.push(...await walk(file));else if(!['review-manifest.json','freeze.json'].includes(e.name))files.push({path:path.relative(own,file).split(path.sep).join('/'),...await id(file)})}return files;}
const files=(await walk(own)).sort((a,b)=>a.path.localeCompare(b.path)),manifest={schema:'rea-independent-keepass-draft-lifecycle-review-strict-manifest/v1',count:files.length,files};await fs.writeFile(path.join(own,'review-manifest.json'),JSON.stringify(manifest,null,2)+'\n');const freeze={schema:'rea-independent-keepass-final-review-freeze/v1',count:files.length,receipt:await id(path.join(own,'review-validation.json')),manifest:await id(path.join(own,'review-manifest.json')),browser:await id(path.join(own,'browser-proof/validation.json'))};await fs.writeFile(path.join(own,'freeze.json'),JSON.stringify(freeze,null,2)+'\n');console.log(JSON.stringify(freeze));
