import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';
const own=path.dirname(fileURLToPath(import.meta.url)),base=path.resolve(own,'..'),stage=path.join(base,'keepass-history-draft-fix-next'),sha=b=>createHash('sha256').update(b).digest('hex');
const options=Object.fromEntries(Array.from({length:(process.argv.length-2)/2},(_,i)=>[process.argv[2+i*2].replace(/^--/,''),process.argv[3+i*2]]));for(const n of ['receipt','receipt-sha','manifest','manifest-sha'])if(!options[n])throw new Error('Explicit '+n+' required');
async function identity(file){const b=await fs.readFile(file);return{bytes:b.length,sha256:sha(b)}}
async function verify(root,name,expected){const file=path.resolve(root,name);if(!file.startsWith(root+path.sep))throw new Error('Unconfined manifest');const i=await identity(file);if(i.sha256!==expected)throw new Error('Manifest fingerprint mismatch '+file);const m=JSON.parse(await fs.readFile(file,'utf8'));for(const e of m.files){const file=path.resolve(root,e.path);if(!file.startsWith(root+path.sep))throw new Error('Unconfined source');const actual=await identity(file);if(actual.sha256!==e.sha256||actual.bytes!==e.bytes)throw new Error('Changed '+file)}return{path:file,...i,count:m.files.length,allEntriesMatch:true};}
const receiptPath=path.resolve(stage,options.receipt);if(!receiptPath.startsWith(stage+path.sep))throw new Error('Unconfined receipt');const authorReceipt=await identity(receiptPath);if(authorReceipt.sha256!==options['receipt-sha'])throw new Error('Author receipt fingerprint mismatch');
const authorManifest=await verify(stage,options.manifest,options['manifest-sha']),oldReviews=[];for(const [directory,hash]of [['keepass-history-independent-review','659a694609e032da24f51b625d9f6528b0d9a5c3e558c9bc0d9fe7a0cf6f35d1'],['keepass-history-selection-independent-review','df87b099e0234bb611b76dd6079e09482f526696037a0124bd4374318738dd6d'],['keepass-history-draft-policy-review','a36e0aa279f305f5e9e7474ebbc05fa9661d2f27f4934ddd6811428b005dc6a9'],['keepass-history-lifecycle-review','b631915fbfdb7dc40f7f5ba828d456b26aa7dbbeb2137d704fc4a0aa7f8ce939']])oldReviews.push(await verify(path.join(base,directory),'review-manifest.json',hash));
await fs.mkdir(path.join(own,'baseline'),{recursive:true});const candidateFingerprints=[];for(const name of ['history.mjs','server.mjs','client.mjs','kdbx.mjs','xml.mjs']){const bytes=await fs.readFile(path.join(stage,name));candidateFingerprints.push({path:name,bytes:bytes.length,sha256:sha(bytes)});await fs.writeFile(path.join(own,'baseline',name+'.snapshot'),bytes);}
const originalExecutable=path.join(base,'../outputs/rea-research-lab/projects/07-keepass/artifacts/portable/KeePass.exe'),originalId=await identity(originalExecutable);if(originalId.sha256!=='04d29636c393f0c1fc99ff739295494be3adefded93271e44591e8e300225a5a')throw new Error('Original executable changed');
const validation={schema:'rea-independent-keepass-draft-final-baseline/v1',createdAt:new Date().toISOString(),stage,authorReceipt:{path:receiptPath,...authorReceipt},authorManifest,oldReviews,candidateFingerprints,originalExecutable:{path:originalExecutable,...originalId,executionsThisReview:0},scope:'Exact frozen candidate and prior failed/control evidence authenticated before independent probes. Original source ZIP/selected source authentication remains in unchanged initial101 review.'};await fs.writeFile(path.join(own,'baseline-validation.json'),JSON.stringify(validation,null,2)+'\n');console.log(JSON.stringify(validation));
