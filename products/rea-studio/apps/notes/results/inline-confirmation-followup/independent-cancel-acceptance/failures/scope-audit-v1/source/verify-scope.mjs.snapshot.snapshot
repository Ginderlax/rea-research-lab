import fs from 'node:fs/promises';import path from 'node:path';import crypto from 'node:crypto';import assert from 'node:assert/strict';import {fileURLToPath} from 'node:url';import {authenticate} from './prepare.mjs';
const root=path.dirname(fileURLToPath(import.meta.url)),work=path.dirname(root),candidate=path.join(work,'notes-inline-cancel-no-read-next'),notes=path.join(candidate,'products/rea-studio/apps/notes'),prior=path.join(work,'notes-inline-confirmation-next/products/rea-studio/apps/notes'),hash=b=>crypto.createHash('sha256').update(b).digest('hex');
const before=await authenticate(),correction=JSON.parse(await fs.readFile(path.join(candidate,'correction.json'))),old=await fs.readFile(path.join(prior,'client.mjs')),current=await fs.readFile(path.join(notes,'client.mjs'));assert.equal(hash(old),correction.before.sha256);assert.equal(old.length,correction.before.bytes);
let transformed=old.toString('utf8');for(const t of correction.transforms){assert.equal(transformed.split(t.before).length-1,1);transformed=transformed.replace(t.before,t.after);}assert.equal(transformed,current.toString('utf8'));assert.equal(hash(current),correction.after.sha256);
const unchanged=[];for(const name of ['server.mjs','jex.mjs','markdown.mjs','notebooks.mjs','notebook-trash.mjs']){const a=await fs.readFile(path.join(prior,name)),b=await fs.readFile(path.join(notes,name));assert.deepEqual(a,b);unchanged.push({path:name,bytes:b.length,sha256:hash(b)});}
const audit=JSON.parse(await fs.readFile(path.join(root,'helper-accounting-audit.json'))),trash=JSON.parse(await fs.readFile(path.join(root,'source/author-trash-original.json.snapshot'))),retained=path.join(notes,'results/notebook-trash-followup/stage');
const priorProvenance=JSON.parse(await fs.readFile(path.join(retained,'prior-source-provenance.json.snapshot'))),trashProvenance=JSON.parse(await fs.readFile(path.join(retained,'trash-source-provenance.json.snapshot'))),records=[...priorProvenance.sources,...trashProvenance.records];
function method(source,name){const start=source.search(new RegExp(`public static (?:async )?${name}\\(`));assert.ok(start>=0);let depth=0;const brace=source.indexOf('{',start);for(let pos=brace;pos<source.length;pos++){if(source[pos]==='{')depth++;if(source[pos]==='}'&&!--depth)return{source:source.slice(start,pos+1),startLine:source.slice(0,start).split('\n').length,endLine:source.slice(0,pos+1).split('\n').length};}throw Error('Missing method end');}
const boundaryMap=new Map([
 ['packages/lib/models/Folder.ts:notes',['public static async notes(','public static async noteIds(']],
 ['packages/lib/models/Folder.ts:noteIds',['public static async noteIds(','public static async subFolderIds(']],
 ['packages/lib/models/Folder.ts:subFolderIds',['public static async subFolderIds(','public static async noteCount(']],
 ['packages/lib/models/Folder.ts:batchDelete',['public static async batchDelete(','public static conflictFolderTitle(']],
 ['packages/lib/models/Folder.ts:childrenIds',['public static async childrenIds(','public static async expandTree(']],
 ['packages/lib/models/Note.ts:batchDelete',['public static async batchDelete(','public static async permanentlyDeleteMessage(']],
 ['packages/lib/BaseModel.ts:saveQuery',['public static saveQuery(','public static userSideValidation(']],
 ['packages/lib/services/trash/restoreItems.ts:restoreItems',['const restoreItems =','export default restoreItems;']],
 ['packages/lib/services/trash/index.ts:getDisplayParentId',['export const getDisplayParentId =','export const getDisplayParentTitle =']]
]);
const bindings=[];for(const [kind,group]of [['organization',audit.observedMarkers.organization[0].bindings],['trash',trash[0].bindings]])for(const binding of group){
 const record=records.find(r=>r.url===binding.url),sourceBytes=await fs.readFile(path.join(retained,record.path+'.snapshot'));assert.equal(hash(sourceBytes),record.sha256);assert.equal(record.sha256,binding.sourceSha256);const text=sourceBytes.toString('utf8');let span;
 if(kind==='organization')span=method(text,binding.method);
 else{let matched;for(const [key,[start,end]]of boundaryMap)if(key.startsWith(binding.path+':')){const a=text.indexOf(start),b=text.indexOf(end,a+start.length);if(a<0||b<0)continue;let source=text.slice(a,b).trimEnd();if(start.startsWith('public static'))source=source.slice(0,source.lastIndexOf('}')+1);if(hash(source)===binding.sliceSha256){matched={source,startLine:text.slice(0,a).split('\n').length,endLine:text.slice(0,a+source.length).split('\n').length};break;}}assert.ok(matched,'Exact retained method boundary: '+binding.path);span=matched;}
 assert.equal(hash(span.source),binding.sliceSha256);assert.equal(span.startLine,binding.startLine);assert.equal(span.endLine,binding.endLine);bindings.push({kind,...binding,sourceBytes:sourceBytes.length,exactSpanVerified:true});
}
assert.equal(bindings.length,13);for(const row of trash)assert.deepEqual(row.bindings,trash[0].bindings);for(const row of audit.observedMarkers.organization)assert.deepEqual(row.bindings,audit.observedMarkers.organization[0].bindings);
const specialRecords=JSON.parse(await fs.readFile(path.join(retained,'license-and-special-id-provenance.json.snapshot'))),special=specialRecords.find(r=>r.url.endsWith('/getConflictFolderId.ts')),specialBytes=await fs.readFile(path.join(retained,special.path+'.snapshot'));assert.equal(hash(specialBytes),special.sha256);
const licenses=[];for(const r of specialRecords.filter(r=>/LICENSE(?:\.md)?$/.test(r.url))){const b=await fs.readFile(path.join(retained,r.path+'.snapshot'));assert.equal(hash(b),r.sha256);licenses.push({...r,bytes:b.length});}assert.ok(licenses.length>0);
const after=await authenticate();assert.deepEqual(before,after);
await fs.writeFile(path.join(root,'scope-authentication.json'),JSON.stringify({at:new Date().toISOString(),sourceStable:true,twoSubstitutionsExact:true,unchangedBackendAndSupportFiles:unchanged,bindings,conflictConstantHelper:{...special,bytes:specialBytes.length},licenses,originalCodeExecutedByThisCheck:false,methodBoundaryParser:'Mirrors the authenticated harness source-selection rule; no original code is compiled or invoked.',helperInternalRecursionCounted:false},null,2)+'\n');console.log(JSON.stringify({twoSubstitutionsExact:true,unchangedFiles:unchanged.length,exactReleasedSpans:bindings.length,licenses:licenses.length,sourceStable:true}));
