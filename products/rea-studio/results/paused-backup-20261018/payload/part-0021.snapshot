own=bykind['new-task-editor-ownership-after-actual-commit'];assert own['oldId']!=own['newId'] and own['oldRevision']==own['newRevision']==1
disp=bykind['new-task-disposal-after-actual-first-commit'];assert disp['lateNotesRequests']==0 and disp['detachedControlObserved'] and not disp['detachedControlScrubbingClaimed']
late=bykind['new-task-postcommit-genuine-list400-newer-draft'];assert late['actualHTTPStatus']==400 and late['restoredBeforeHeldDelivery'] and late['nextSubmittedRevision']==1 and late['finalRevision']==2
