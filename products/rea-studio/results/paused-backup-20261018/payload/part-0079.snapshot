    {
      "id": "grafana.candidate.5a5c0df1d69d7b8e01f2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "New log out events are logged based on when a token expires or is revoked, as well as [SAML Single Logout](../../setup-grafana/configure-access/configure-authentication/saml/#single-logout). A `tokenId` field was added to all audit logs to help understand which session was logged out of.",
      "headingPath": [
        "What's new in Grafana v7.4",
        "Grafana Enterprise features",
        "New audit log events"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-4.md",
