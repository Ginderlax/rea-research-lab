"""Read-only verification of copied source, immutable commit blobs and local backups."""
from pathlib import Path
import hashlib,json,subprocess
B=Path(__file__).resolve().parent.parent;W=B/'work';R=B/'outputs/rea-research-lab'
D=W/'cloud-recovery-20261015/new-todo-correction-and-failure-reviewed-copy'
AFTER='89e00f66c2249a50c701404accede7565094304e'
BEFORE='b635c33d971768682360e2c518b9b2bb0840985b'
def read(p): assert p.is_file() and not p.is_symlink(),str(p);return p.read_bytes()
def ident(b):return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def git(*args):return subprocess.run(['git',*args],cwd=R,check=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE).stdout
def batch(commit,names):
    raw=subprocess.run(['git','cat-file','--batch'],cwd=R,input=('\n'.join(commit+':'+p for p in names)+'\n').encode(),check=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE).stdout
    pos=0;out={}
    for p in names:
        end=raw.index(b'\n',pos);header=raw[pos:end].split();assert len(header)==3 and header[1]==b'blob',(p,header)
        size=int(header[2]);pos=end+1;out[p]=raw[pos:pos+size];assert len(out[p])==size and raw[pos+size:pos+size+1]==b'\n';pos+=size+1
    assert pos==len(raw);return out
receipt_bytes=read(D/'copy-receipt.json');v=json.loads(receipt_bytes)
assert v['preCopyHead']==BEFORE and v['authenticatedRows']==168 and len(v['rows'])==168
assert v['modifiedFiles']==9 and v['addedFiles']==145 and v['unchangedSourceRows']==14 and v['changedFiles']==154
assert git('rev-parse',AFTER+'^').decode().strip()==BEFORE
assert git('rev-parse','HEAD').decode().strip()==AFTER
rows={r['path']:r for r in v['rows']};assert len(rows)==168
assert sum(r['changed'] for r in rows.values())==154
after=batch(AFTER,list(rows))
before_names=[p for p,r in rows.items() if r['before'] is not None]
assert len(before_names)==v['beforeFilesReadable']==23
before=batch(BEFORE,before_names)
for p,r in rows.items():
    assert ident(read(R/p))==r['after']==ident(after[p])
    if r['before'] is not None: assert ident(read(D/'before'/p))==r['before']==ident(before[p])
    assert r['changed']==(r['before']!=r['after'])
actual=git('diff','--name-status',BEFORE,AFTER).decode().splitlines()
expected={p:('A' if r['before'] is None else 'M') for p,r in rows.items() if r['changed']}
assert dict(line.split('\t',1)[::-1] for line in actual)==expected
assert set(v['changedPaths'])==set(expected)
assert sum(s=='A' for s in expected.values())==145 and sum(s=='M' for s in expected.values())==9
protected=v['protectedRows'];assert len(protected)==len({r['path'] for r in protected})==38
protected_before=batch(BEFORE,[r['path'] for r in protected]);protected_after=batch(AFTER,[r['path'] for r in protected])
for r in protected:
    pin={k:r[k] for k in ('bytes','sha256')}
    assert ident(protected_before[r['path']])==ident(protected_after[r['path']])==ident(read(R/r['path']))==pin
assert len([r for r in protected if r['path'].startswith('products/rea-studio/apps/notes/')])==32
for filename,pin in [('authorities/corrected-source.json',v['sourceAuthority']),('authorities/failed-evidence.json',v['failureAuthority']),('authorities/corrected-source-independent-peer.json',{k:v['sourcePeer'][k] for k in ('bytes','sha256')})]:assert ident(read(D/filename))==pin
assert ident(read(D/'orchestration/copy-source.mjs'))=={'bytes':9042,'sha256':'f209cbf3c0d158abdefe0a0cfcca15e36c36462bb6d5ca09233398dbbca0c80a'}
assert not any(p.startswith('products/rea-studio/apps/') for p in expected)
report={'schema':'rea-independent-actual-NewTodo-corrected-cloud-copy-readback/v1','status':'passed-read-only','commit':AFTER,'parent':BEFORE,'actualCommitPaths':154,'modifiedPaths':9,'addedPaths':145,'all168AuthenticatedRowsMatchActiveFilesAndCommitBlobs':True,'unchangedSourceRows':14,'all23BeforeBackupsReadableAndMatchParentGit':True,'all38ProtectedFilesUnchangedAcrossParentCommitAndWorkingTree':True,'installedNotesProtectedFiles':32,'sourceAuthority':v['sourceAuthority'],'failureAuthority':v['failureAuthority'],'sourcePeer':v['sourcePeer'],'copyReceipt':ident(receipt_bytes),'reviewedCopyOnlySourcePreservedExact':True,'applicationRuntimeChanged':False,'freshCorrectedAcceptance':'pending-hosted-run','historicalFailurePromoted':False,'localProductExecutions':0,'localTests':0,'localBuilds':0,'localCandidateImports':0,'localSyntaxChecks':0,'activeWrites':0,'gitMutations':0,'errors':[]}
out=W/'new-todo-corrected-source-and-failure-actual-copy-independent-readback-20261016.json';assert not out.exists();out.write_text(json.dumps(report,indent=2)+'\n',encoding='utf8');print(json.dumps({'report':str(out),'identity':ident(read(out)),'status':report['status']}))
"""Independent portable failed-evidence/capsule byte reader only."""
from pathlib import Path
import gzip,hashlib,io,json,re,subprocess,zipfile,zlib
BASE=Path(__file__).resolve().parent.parent;W=BASE/'work';LAB=BASE/'outputs/rea-research-lab'
S=W/'notes-new-todo-first-failure-public-20261016-next';C=S/'public-candidate'
P='products/rea-studio/results/notes-new-todo-first-failure-20261016'
RUN=W/'cloud-verification-backups/run-38926216286';HEAD='b635c33d971768682360e2c518b9b2bb0840985b';PREFIX='products/rea-studio/'
ident=lambda b:{'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def read(p):assert p.is_file() and not p.is_symlink(),str(p);return p.read_bytes()
def load(p):return json.loads(read(p).decode('utf-8-sig'))
def pin(b,r):assert ident(b)=={k:r[k] for k in ('bytes','sha256')},r.get('path')
def git(args):return subprocess.run(['git','-C',str(LAB),*args],capture_output=True,check=True).stdout
ab=read(S/'copy-authority.json');assert ident(ab)=={'bytes':35547,'sha256':'7fd4b7596ff7875e3402b1463c304c66b1f4d049f822501a3aeaf1f046a82415'}
a=json.loads(ab);assert a['files']==len(a['rows'])==103 and a['bytes']==6351220 and a['records']==119
assert len({r['path'] for r in a['rows']})==103
assert {p.relative_to(C).as_posix() for p in C.rglob('*') if p.is_file()}=={r['path'] for r in a['rows']}
for r in a['rows']:assert r['before'] is None and r['path'].startswith(P+'/');pin(read(C/r['path']),r['after'])
assert sum(r['after']['bytes'] for r in a['rows'])==6351220
mb=read(C/P/'preservation-manifest.json');pin(mb,a['manifest'])
assert ident(mb)=={'bytes':320378,'sha256':'c31f2d62d82a168a65416734193878911dc891bc602dd8361800b88e7b7a8e27'}
m=json.loads(mb);assert len(m['records'])==len({r['sourcePath'] for r in m['records']})==119
collection=load(RUN/'new-todo-collection-summary-v4.json')
assert collection['runStatus']=='completed' and collection['runConclusion']=='failure' and collection['terminalCompleteCollection'] is True and collection['bothRecordedContractsPassed'] is False
tree={}
for line in git(['ls-tree','-rz',HEAD]).split(b'\0'):
    if line:
        meta,name=line.split(b'\t',1);mode,kind,blob=meta.split()
        if kind==b'blob':tree[name.decode()]=(mode,blob.decode())
def gitbound(name,data):
    assert name in tree and tree[name][0] in (b'100644',b'100755')
    assert hashlib.sha1(b'blob '+str(len(data)).encode()+b'\0'+data).hexdigest()==tree[name][1]
roots={'apps','lib','public','browser-tests','scripts','tests'};excluded={'node_modules','.local','results'}
eligible=set()
for full in tree:
    if full.startswith(PREFIX):
        name=full.removeprefix(PREFIX);parts=name.split('/')
        if name in {'server.mjs','catalog.mjs','package.json'} or (len(parts)>=2 and parts[0] in roots and not excluded.intersection(parts) and re.search(r'\.(mjs|json|html|css|ps1)$',name)):eligible.add(name)
assert len(eligible)==389
originals={};source_counts={};zip_counts={};nonsource_counts={}
for d in ({'role':'finite','artifact':12057440545,'job':117058306722,'bytes':2017598,'sha256':'5ea182003b164ea30c51cb7cca042ccaf8a91c00fd82bf69f221da4c5f4c58af','files':537,'nonsource':16},{'role':'browser','artifact':12056951653,'job':117058307183,'bytes':2468605,'sha256':'7548bd5b84ce260a01dd2d50b6b06bb5a7e8e810ea2e97e2b88b9f5b96811536','files':573,'nonsource':52}):
    role=d['role'];B=RUN/('artifact-'+str(d['artifact'])+'-new-todo-reader-v4');E=B/'readable-evidence';report=load(B/'local-new-todo-backup-verification.json')
    assert report['allCRCAndBytesReadable'] is True and report['recordedContractPassed'] is False and report['sourceProof']['allSourcesAuthenticated'] is True
    assert len(report['evidenceConsistencyErrors'])==1 and report['evidenceConsistencyErrors'][0]['stage']=='required-passed-attempt'
    assert len(report['files'])==len({r['path'] for r in report['files']})==d['files']
    for r in report['files']:pin(read(E/r['path']),r)
    outer=read(RUN/('artifact-'+str(d['artifact'])+'.zip'));pin(outer,d)
    with zipfile.ZipFile(io.BytesIO(outer)) as z:
        assert z.testzip() is None and len(z.namelist())==1
        inner=z.read(z.namelist()[0])
    with zipfile.ZipFile(io.BytesIO(inner)) as z:
        assert z.testzip() is None
        names=[n for n in z.namelist() if not n.endswith('/')];assert len(names)==d['files'] and set(names)=={r['path'] for r in report['files']}
        for r in report['files']:
            assert z.read(r['path'])==read(E/r['path'])
            assert format(z.getinfo(r['path']).CRC,'08x')==r['zipCRC32']
    zip_counts[role]=len(names)
    prefixes=('active-source/','composition-baseline-source/','composition-source/','tooling-source/')
    source_names={r['path'] for r in report['files'] if r['path'].startswith(prefixes)}
    retained={r['path'] for r in report['files']}-source_names
    assert len(source_names)==521 and len(retained)==d['nonsource'];source_counts[role]=521;nonsource_counts[role]=len(retained)
    job=next(r for r in m['jobs'] if r['role']==role)
    assert {r['sourcePath'] for r in job['sourceAliasesInsideCompletePublicZip']}==source_names
    for r in job['sourceAliasesInsideCompletePublicZip']:pin(read(E/r['sourcePath']),r)
    for name in retained:originals[role+'/artifact/'+name]=read(E/name)
    originals[role+'/portable-artifact/complete-github-artifact.zip']=outer
    for version in (2,3,4):originals[role+'/readback-history/local-new-todo-backup-verification-v'+str(version)+'.json']=read(RUN/('artifact-'+str(d['artifact'])+'-new-todo-reader-v'+str(version))/'local-new-todo-backup-verification.json')
    originals[role+'/wrapper/job-'+str(d['job'])+'.txt']=read(W/('cloud-verification-backups/job-'+str(d['job']))/'logs.txt')
    composition=load(E/'notes-new-todo-composition.json');bundle=load(E/('composition-source/'+PREFIX+'experiments/notes-new-todo/bundle.json.snapshot'))
    after={r['path']:{k:r[k] for k in ('bytes','sha256')} for r in load(E/'composition-source-after.json')};before={r['path']:{k:r[k] for k in ('bytes','sha256')} for r in load(E/'composition-source-before.json')}
    assert set(before)==eligible and len(after)==393
    targets={r['path']:r for r in bundle['transitions'] if re.search(r'\.(mjs|json|html|css|ps1)$',r['path'])};assert len(targets)==6
    additions={p.removeprefix(PREFIX) for p,r in targets.items() if r['before'] is None};assert len(additions)==4 and set(after)==eligible|additions
    for name,r in after.items():
        data=read(E/('active-source/'+name+'.snapshot'));pin(data,r)
        if PREFIX+name in targets:assert r==targets[PREFIX+name]['after']
        else:gitbound(PREFIX+name,data);assert before[name]==r
    attempt=load(E/('new-todo-'+role+'-attempt.json'))
    assert attempt['status']=='failed' and attempt['sourceStable'] is True and attempt['sourceCommit']==HEAD and attempt['productTests']==0
    assert attempt['children'][0]['exitCode']==1 and attempt['children'][0]['closeObserved'] is True
    assert attempt['execution']['GITHUB_RUN_ID']=='38926216286' and attempt['execution']['GITHUB_RUN_ATTEMPT']=='1'
    for r in attempt['tooling']['paths']:
        data=read(E/('tooling-source/'+r['path']+'.snapshot'));pin(data,r);gitbound(r['path'],data)
    self_data=read(E/'active-source/scripts/verify-notes-new-todo-cloud.mjs.snapshot');gitbound(PREFIX+'scripts/verify-notes-new-todo-cloud.mjs',self_data)
    post=load(E/'notes-new-todo-postrun-source-check.json');assert post['status']=='source-verified' and post['sourceStable'] is True and post['sourceCommit']==HEAD
    if role=='finite':
        tap=read(E/'finite-stdout.txt').decode();summary={key:int(re.findall(r'^# '+key+r' (\d+)\r?$',tap,re.M)[0]) for key in ('tests','pass','fail','cancelled','skipped','todo')}
        assert summary=={'tests':111,'pass':107,'fail':4,'cancelled':0,'skipped':0,'todo':0}
        assert re.findall(r'^not ok (\d+) - ',tap,re.M)==['23','57','59','62']
    else:
        stats=load(E/'playwright-results.json')['stats'];assert [stats[k] for k in ('expected','unexpected','skipped','flaky')]==[7,1,0,0]
        browserpost=load(E/'new-todo-browser-postrun-source-check.json');assert browserpost['status']=='source-verified' and browserpost['priorStatus']=='failed' and browserpost['sourceStable'] is True
for v in (2,3,4):originals['collection-history/new-todo-collection-summary-v'+str(v)+'.json']=read(RUN/('new-todo-collection-summary-v'+str(v)+'.json'))
for folder in RUN.iterdir():
    if folder.is_dir() and folder.name.startswith('new-todo-control-plane-'):
        for kind in ('run','jobs','artifacts'):originals['raw-api-observations/'+folder.name+'/'+kind+'.json']=read(folder/(kind+'.json'))
