    {
      "id": "grafana.candidate.b235b17b495f772658a7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Active Directory groups store the Distinguished Names (DNs) of members, so your filter needs to know the DN for the user based only on the submitted username. Multiple DN templates are searched by combining filters with the LDAP OR-operator. Two examples:",
      "headingPath": [
        "Configure LDAP authentication",
        "Grafana LDAP Configuration",
        "Nested/recursive group membership"
      ],
