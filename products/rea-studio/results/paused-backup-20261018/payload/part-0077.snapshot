    {
      "id": "grafana.candidate.98135181ba6403822964",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Length of time to attempt to reconnect to a lost peer. When running Grafana in a Kubernetes cluster, set this duration to less than `15m`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[unified_alerting]`",
        "`ha_reconnect_timeout`"
