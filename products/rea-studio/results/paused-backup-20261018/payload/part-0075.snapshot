    },
    {
      "id": "grafana.candidate.d67acfb1d83575f65e51",
      "syntaxRole": "list-item",
      "sourceText": "- **OpenSearch SQL** - OpenSearch SQL is a query language that uses a SQL-like syntax for querying data in OpenSearch. It supports standard SQL queries and is designed for users familiar with SQL.",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Query CloudWatch Logs"
      ],
      "source": {
