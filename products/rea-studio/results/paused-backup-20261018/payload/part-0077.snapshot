    {
      "id": "grafana.candidate.fbda76eafce1e97776b9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The interval between gossip full state syncs. Setting this interval lower (more frequent) increases convergence speeds across larger clusters at the expense of increased bandwidth usage. The default value is `60s`.",
      "headingPath": [
