    build_header_offset: info.header_offset, go_version_claim: info.go_version, module_path_claim: info.module.path,
    main_module: info.module.main, embedded_dependency_records: info.module.dependencies.length,
    metadata_parse_complete: info.module.complete, locations: evidence.locations.filter(item => item.kind !== 'artifact-path'),
    limitations: evidence.limitations, source_assisted: true,
    native_analysis: id === '10-rclone' ? { status: 'no-successful-native-result', source_attempt: 'provider-unavailable: source runtime has no built Windows native addon', published_attempt: 'cancelled for resource contention during a large Go import', record: 'artifacts/native-cancellation.json' } : { status: 'not-claimed' }
  };
  writeFileSync(join(root, 'rea-evidence-summary.json'), JSON.stringify(summary, null, 2));
  const study = {
    id, product: artifact.product, version: artifact.version, status: 'completed-bounded-study',
    component: id === '09-restic' ? 'Small-file plaintext content addressing, duplicate/rename identity and stored-object hashes' : 'Synthetic obscure wire format and non-character stdin preprocessing',
    report: 'REPORT.md', claims: 'CLAIMS.md', artifact, method: 'source-assisted reconstruction with original released executable as behavioral oracle',
    rea: summary,
    results: id === '09-restic' ? {
      differential_comparisons: result.content_id_comparisons, file_observations: result.content_id_comparisons,
      snapshots: result.snapshots, size_assertions: result.size_assertions, duplicate_reference_pair_checks: result.duplicate_reference_pair_checks,
      changed_content_id_checks: 1, renamed_content_id_checks: 1, plaintext_tree_id_checks: result.plaintext_tree_id_checks,
      stored_object_id_checks: result.stored_object_id_checks, original_integrity_check_passed: result.restic_read_data_check_passed,
      mismatches: result.mismatches, record: 'results.json', count_unit: 'Per-file content-ID list, repeated across snapshots; additional checks separately counted'
    } : {
      original_cli_executions: result.fixtures, differential_comparisons: result.differential_assertions,
      structural_assertions: result.structural_assertions, observed_distinct_ivs: result.observed_distinct_ivs,
      mismatches: result.mismatches, record: 'results.json', count_unit: 'Two assertions per original output; not 230 independent CLI executions'
    },
    reproduction: { acquire: 'node acquire.mjs', test: 'node reproduce.mjs', analyze: 'node analyze.mjs', demo: 'node reconstruction.mjs', required_host: 'Windows x64, Node.js 24+', fresh_outputs: 'artifacts/replays/' },
    limitations: id === '09-restic' ? result.exclusions : result.excludes,
    upstream_license: id === '09-restic' ? 'BSD-2-Clause' : 'MIT', source_reference_manifest: 'reference-manifest.json',
    original_artifact_and_full_evidence_location: 'artifacts/ (retained locally, excluded from Git)'
  };
  writeFileSync(join(root, 'study.json'), JSON.stringify(study, null, 2));
  const rows = id === '09-restic' ? [
    ['Observed', 'Exact release bytes and embedded Go claims', `REA ${evidence.evidence_id}; artifact-manifest.json`, 'Build metadata is not compiler/dependency authentication.'],
    ['Observed', '122 content-ID lists match the model across three snapshots', 'results.json: original_observations', 'Repeated files and one recorded release.'],
    ['Observed', 'Duplicate, revision and rename identity checks pass', 'results.json: duplicate_reference_pair_checks, changed_content_id_checks, renamed_content_id_checks', 'Finite fixtures, not a hash collision study.'],
    ['Observed', '12 stored-object names hash their stored bytes', 'results.json: storage_observations', 'Includes key metadata; not every object is asserted encrypted.'],
    ['Observed', 'Original restic full-data check passes', 'results.json: restic_read_data_check_passed; local integrity-check.txt', 'This synthetic repository only.'],
    ['Source-assisted model', 'Empty files have no blobs and nonempty small fixtures use a plaintext SHA-256 ID', 'reconstruction.mjs; version-pinned design reference', 'Chunking at or above 512 KiB is excluded.'],
    ['Unknown', 'Full chunker, encryption, pack/index or remote-backend equivalence', 'Declared exclusions', 'Not reconstructed or claimed.']
  ] : [
    ['Observed', 'Exact release bytes and embedded Go claims', `REA ${evidence.evidence_id}; artifact-manifest.json`, 'Metadata only; no native algorithm recovery.'],
    ['Source-assisted model', 'AES-CTR, public format constant, IV prefix and raw base64url', 'reference-manifest.json: format; reconstruction.mjs', 'Consulted before testing; not independently inferred by REA.'],
    ['Observed', '115 original outputs decode and re-encode exactly', 'results.json: cases', '230 assertions; valid synthetic UTF-8 and reused original IV.'],
    ['Observed', 'All 115 sample IVs are distinct', 'results.json: observed_distinct_ivs', 'No RNG distribution or global uniqueness claim.'],
    ['Observed', 'Hyphen with a pipe at EOF produces empty text', 'initial-counterexample.json; results.json: stdin cases', 'Character-device terminal behavior remains untested.'],
    ['Method limitation', 'Native import was unavailable/cancelled', 'rea-evidence-summary.json: native_analysis; artifacts/native-cancellation.json', 'No rclone decompilation result.'],
    ['Unknown', 'Malformed-token, remote-account and whole-product equivalence', 'Declared exclusions', 'No real credentials or remote configurations examined.']
  ];
  writeFileSync(join(root, 'CLAIMS.md'), '# Claim ledger\n\n| Class | Claim | Evidence | Limit |\n| --- | --- | --- | --- |\n' + rows.map(row => '| ' + row.join(' | ') + ' |').join('\n') + '\n');
  writeFileSync(join(root, 'THIRD_PARTY_NOTICES.md'), `# Attribution and material scope\n\nThe studied product is ${artifact.product} ${artifact.version}. Upstream license: ${study.upstream_license}; the pinned text and attribution are retained in [UPSTREAM-LICENSE.txt](UPSTREAM-LICENSE.txt). Consulted references are identified in [reference-manifest.json](reference-manifest.json).\n\nVendor executables, archives and full raw evidence remain local under ignored artifacts/. Published material consists of the study documentation, separately executed reconstruction, harness, manifests and synthetic observations. No repository-wide license overrides upstream terms.\n`);
  console.log(JSON.stringify({ project: id, status: study.status, differential_comparisons: study.results.differential_comparisons }));
}
