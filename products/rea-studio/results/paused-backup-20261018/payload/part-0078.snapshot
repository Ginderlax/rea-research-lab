    {
      "id": "grafana.candidate.880ce09268d8f9a46bf0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can also use the output of one transformation as the input to another transformation, which results in a performance gain.",
      "headingPath": [
