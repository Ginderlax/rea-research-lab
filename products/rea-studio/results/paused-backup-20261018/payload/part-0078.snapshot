    {
      "id": "grafana.candidate.9f8e405982ff070f3049",
      "syntaxRole": "list-item",
      "sourceText": "- Patching releases are for all supported minor versions of Grafana. Each supported minor version receives patch releases with bug fixes and security patches until its end of life.",
      "headingPath": [
        "Strategies for upgrading your self-managed Grafana instance",
        "When to expect releases",
        "A few important notes"
      ],
      "source": {
        "path": "docs/sources/upgrade-guide/when-to-upgrade/index.md",
        "gitBlobSha": "4d2b4a87fa81e54c20f7dba4437026da8cd92d2d",
