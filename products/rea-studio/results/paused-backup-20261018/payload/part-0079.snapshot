    },
    {
      "id": "grafana.candidate.0e688f52a7772c433c6a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now dynamically apply value filters to any table column. This option can be enabled for all columns or one specific column using an override rule.",
      "headingPath": [
        "What's new in Grafana v7.2",
        "Field options are out of beta!",
        "Added table column filters"
      ],
      "source": {
