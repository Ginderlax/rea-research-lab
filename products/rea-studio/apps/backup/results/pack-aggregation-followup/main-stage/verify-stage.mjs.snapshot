import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import {spawn} from 'node:child_process';
const root=path.dirname(fileURLToPath(import.meta.url)),hash=b=>createHash('sha256').update(b).digest('hex'),run=path.join(root,'runs',new Date().toISOString().replaceAll(':','-'));
await fs.mkdir(run,{recursive:true});
const baseline=JSON.parse(await fs.readFile(path.join(root,'production-baseline.json'))),production=[];
for(const row of baseline.files){const actual=await fs.readFile(path.join(baseline.repository,row.path));if(hash(actual)!==row.sha256)throw new Error(`Frozen production changed ${row.path}`);production.push(row);}
async function fingerprint(){const names=(await fs.readdir(path.join(root,'products/rea-studio/apps/backup'))).filter(n=>/\.(mjs|md)$/.test(n)).map(n=>'products/rea-studio/apps/backup/'+n);const provenance=JSON.parse(await fs.readFile(path.join(root,'source-provenance.json')));names.push('products/rea-studio/lib/storage.mjs','products/rea-studio/apps/backup/fixtures/legacy-v2-writer.mjs','products/rea-studio/apps/backup/results/compression-source-study/legacy/restic.mjs.snapshot','verify-stage.mjs','bootstrap.mjs','prepare-fixtures.mjs','adjust-tests.mjs','bind-sources.mjs','contract-bindings.json','record-bound-diagnostic.mjs','freeze-stage.mjs','README.md','production-baseline.json','source-provenance.json',...provenance.references.map(r=>r.path));const files=[];for(const relative of names.sort()){const bytes=await fs.readFile(path.join(root,relative));files.push({path:relative,bytes:bytes.length,sha256:hash(bytes)});}return files;}
const before=await fingerprint();await fs.writeFile(path.join(run,'source-before.json'),JSON.stringify(before,null,2)+'\n');
for(const row of before){const bytes=await fs.readFile(path.join(root,row.path)),target=path.join(run,'source',row.path+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,bytes);}
const files=['restic-data-pack.test.mjs','restic-pack-snapshot.test.mjs','restic-compression.test.mjs','restic-compression-review.test.mjs','rabin.test.mjs','capture-rabin-file.test.mjs','rabin-original.test.mjs','restic-rabin-snapshot.test.mjs','restic-rabin-lifecycle.test.mjs','restic-rabin-deadline.test.mjs'];
const stdout=await fs.open(path.join(run,'stdout.txt'),'wx'),stderr=await fs.open(path.join(run,'stderr.txt'),'wx');
const child=spawn(process.execPath,['--test','--test-concurrency=1',...files.map(name=>`products/rea-studio/apps/backup/${name}`)],{cwd:root,windowsHide:true,stdio:['ignore','pipe','pipe']});let output='',errors='';child.stdout.on('data',chunk=>{output+=chunk.toString();stdout.write(chunk);});child.stderr.on('data',chunk=>{errors+=chunk.toString();stderr.write(chunk);});
const exitCode=await new Promise((resolve,reject)=>{child.once('error',reject);child.once('close',resolve);});await stdout.close();await stderr.close();
const after=await fingerprint(),stable=JSON.stringify(before)===JSON.stringify(after);await fs.writeFile(path.join(run,'source-after.json'),JSON.stringify(after,null,2)+'\n');
const productionStable=(await Promise.all(production.map(async row=>hash(await fs.readFile(path.join(baseline.repository,row.path)))===row.sha256))).every(Boolean);
const counts=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(name=>[name,Number(new RegExp(`(?:ℹ|#) ${name} (\\d+)`).exec(output)?.[1]??-1)]));
const observations=output.split(/\r?\n/).find(line=>line.includes('"packAggregationOriginalObservations"'));if(observations){const start=observations.indexOf('{');await fs.writeFile(path.join(run,'original-observations.json'),JSON.stringify(JSON.parse(observations.slice(start)),null,2)+'\n');}
const receipt={schema:'rea-restic-pack-stage-run/v1',recordedAt:new Date().toISOString(),run:path.relative(root,run).replaceAll('\\','/'),exitCode,counts,sourceStable:stable,productionStable,sourceFingerprints:before,tests:files,scope:'Staged data pack batching only. Original command output and independent physical header/index checks. No timing/performance/full parity claim.'};
await fs.writeFile(path.join(run,'validation.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({run:receipt.run,exitCode,counts,sourceStable:stable,productionStable,errors:errors.slice(0,1000)}));if(exitCode!==0||!stable||!productionStable||counts.fail!==0)process.exitCode=1;
