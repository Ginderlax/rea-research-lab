const attempts={},stability=[];for(const selection of['author','independent']){const p='runs/'+selection+'/',attempt=JSON.parse(await read(p+'attempt.json'));assert.equal(attempt.success,true);assert.deepEqual(attempt.tap,{tests:selection==='author'?9:13,pass:selection==='author'?9:13,fail:0,skipped:0});assert.equal(attempt.sourceStable,true);assert.equal(attempt.authorityStable,true);assert.equal(attempt.limit,null);assert.equal(attempt.spawnError,null);const before=JSON.parse(await read(p+'source-before.json')),after=JSON.parse(await read(p+'source-after.json'));assert.deepEqual(after,before);let same=0;const ownCollectorOutputs=[];for(const r of before){assert.deepEqual(id(await read(p+'source-before/'+r.path+'.snapshot')),{bytes:r.bytes,sha256:r.sha256});if(['runs-author.stdout.txt','runs-author.stderr.txt'].includes(r.path)){ownCollectorOutputs.push({path:r.path,duringChild:r,current:await identity(r.path),explanation:'Outer collector stdout/stderr were owned output files; author stdout was emitted after child/source checks. They are raw records, not candidate/test source. Final inventory binds completed bytes.'});continue;}assert.deepEqual(id(await read(r.path)),{bytes:r.bytes,sha256:r.sha256},selection+' '+r.path);same++;}assert.equal(same,31);const raw=await read(p+attempt.raw.path);assert.deepEqual(id(raw),{bytes:attempt.raw.bytes,sha256:attempt.raw.sha256});assert.deepEqual(id(raw),{bytes:attempt.observation.bytes,sha256:attempt.observation.sha256});stability.push({selection,all33CapturedRowsStableDuringChild:true,actual31NonOutputSourceRowsStillExactAtConsolidation:true,ownCollectorOutputs});attempts[selection]={receipt:await identity(p+'attempt.json'),stdout:await identity(p+'stdout.txt'),stderr:await identity(p+'stderr.txt'),raw:await identity(p+attempt.raw.path),...attempt};}
