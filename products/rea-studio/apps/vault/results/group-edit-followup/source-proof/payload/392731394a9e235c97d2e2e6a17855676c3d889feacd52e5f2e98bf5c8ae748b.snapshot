import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs/promises';import path from'node:path';import{mount,button,field,groupRow,click,type,walk,ids,observations}from'./ui-fixture.mjs';
async function form(u,mode){await click(button(u.root,'Show groups'));await click(button(groupRow(u.root,'Selected'),mode==='create'?'New child group':'Edit group details'));await type(field(u.root,'Group name'),mode==='create'?'Submitted child':'Submitted renamed group');await type(field(u.root,'Group notes'),'Submitted notes');}
for(const mode of['create','save'])test('correction '+mode+' acknowledged unchanged values clear the editor after exactly one successful mutation',async t=>{const u=await mount(t,'acknowledged-'+mode);await form(u,mode);await click(button(u.root,mode==='create'?'Create group':'Save group details'));assert(!walk(u.root).some(n=>n.tagName==='LABEL'&&n._text==='Group name'));assert.equal(u.calls.filter(c=>c.action=== (mode==='create'?'groupCreate':'groupSave')).length,1);const names=(await u.direct('recycleGroupList',{bin:false})).groups.map(g=>g.name);assert(names.includes(mode==='create'?'Submitted child':'Submitted renamed group'));});
for(const mode of['create','save'])test('correction '+mode+' late programmatic value change preserves draft and follows the saved UUID/MAC on next Save',async t=>{const u=await mount(t,'late-value-'+mode);await form(u,mode);const held=u.hold('recycleGroupList'),saving=click(button(u.root,mode==='create'?'Create group':'Save group details'));await held.started.promise;field(u.root,'Group name').value='Later unsaved name';field(u.root,'Group notes').value='Later unsaved notes';held.release.resolve();await saving;assert.equal(field(u.root,'Group name').value,'Later unsaved name');assert.equal(field(u.root,'Group notes').value,'Later unsaved notes');const first=u.calls.find(c=>c.action===(mode==='create'?'groupCreate':'groupSave')),id=first.result.id;await click(button(u.root,'Save group details'));const last=u.calls.filter(c=>c.action==='groupSave').at(-1);assert.equal(last.input.id,id);assert.notEqual(last.input.revision,first.input.revision);assert.equal((await u.direct('recycleGroupList',{bin:false})).groups.find(g=>g.id===id).name,'Later unsaved name');assert.equal(u.calls.filter(c=>['groupCreate','groupSave'].includes(c.action)).length,2);assert.equal(u.calls.filter(c=>c.action==='groupCreate').length,mode==='create'?1:0);});
test('correction explicit Close while final list is held stays closed and preserves an independent newer entry draft',async t=>{const u=await mount(t,'late-close');await form(u,'create');const held=u.hold('recycleGroupList'),creating=click(button(u.root,'Create group'));await held.started.promise;await type(field(u.root,'Title'),'Newer entry draft');await type(field(u.root,'Password'),'Owned synthetic newer password');await type(field(u.root,'Group notes'),'Newer group draft to discard');field(u.root,'Confirm discarding unsaved group draft').checked=true;const notes=field(u.root,'Group notes');await click(button(u.root,'Close group panel'));assert.equal(notes.value,'');held.release.resolve();await creating;assert(!walk(u.root).some(n=>n.tagName==='H3'&&n.textContent==='Groups'));assert.equal(field(u.root,'Title').value,'Newer entry draft');assert.equal(field(u.root,'Password').value,'Owned synthetic newer password');assert.equal(u.calls.filter(c=>c.action==='groupCreate').length,1);});
test('correction final-list disposal prevents publication and scrubs held form values',async t=>{const u=await mount(t,'late-disposal');await form(u,'save');const held=u.hold('recycleGroupList'),saving=click(button(u.root,'Save group details'));await held.started.promise;const notes=field(u.root,'Group notes');u.cleanup();u.host.replaceChildren();held.release.resolve();await saving;assert.equal(notes.value,'');assert.equal(u.root.parentElement,null);assert.equal(u.calls.filter(c=>c.action==='groupSave').length,1);});
test('correction group-list completion can clear an acknowledged group form without clearing newer entry values',async t=>{const u=await mount(t,'late-entry-draft');await form(u,'save');const held=u.hold('recycleGroupList'),saving=click(button(u.root,'Save group details'));await held.started.promise;await type(field(u.root,'Title'),'Entry draft typed late');await type(field(u.root,'Password'),'Owned late secret draft');held.release.resolve();await saving;assert.equal(field(u.root,'Title').value,'Entry draft typed late');assert.equal(field(u.root,'Password').value,'Owned late secret draft');assert(!walk(u.root).some(n=>n.tagName==='LABEL'&&n._text==='Group name'));});
test('correction failed Save persistence retains existing group editor and retry writes a single final state',async t=>{const u=await mount(t,'save-persistence-retry');await form(u,'save');const initial=u.store.identity();u.store.failNext();await click(button(u.root,'Save group details'));assert.equal(u.store.identity(),initial);assert.equal(field(u.root,'Group name').value,'Submitted renamed group');await click(button(u.root,'Save group details'));const saves=u.calls.filter(c=>c.action==='groupSave');assert.equal(saves.length,2);assert.equal(saves.filter(c=>c.error).length,1);assert.equal(saves.filter(c=>c.result).length,1);assert.equal((await u.direct('recycleGroupList',{bin:false})).groups.find(g=>g.id===ids.target).name,'Submitted renamed group');});
test.after(async()=>{if(process.env.VAULT_GROUP_REVIEW_OUTPUT)await fs.writeFile(path.join(process.env.VAULT_GROUP_REVIEW_OUTPUT,'observations.json'),JSON.stringify(observations,null,2)+'\n',{flag:'wx'});});
