    },
    {
      "id": "grafana.candidate.fbe3d32e9220f07c7209",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, only organization administrators can create announcement banners. You can customize who can create announcement banners with [Role-based access control](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/administration/roles-and-permissions/access-control/).",
      "headingPath": [
        "What’s new in Grafana v11.3",
        "Announcement banner"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-3.md",
        "gitBlobSha": "5eb55341a0458eac320b2317223af815e066d128",
        "sha256": "42f0fbcea86ed7f49f166bc9b279b95673f27c4ef505737f7b54ede18c391332",
        "lineStart": 254,
        "lineEnd": 254,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-3.md#L254-L254"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.7df72dfeb643417e893c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To use the Announcement banner in self-managed Grafana, turn on the `notificationBanner` [feature toggle](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-grafana/feature-toggles/) in Grafana v11.3 or newer and navigate in your Grafana instance to Admin > General > Announcement Banner",
      "headingPath": [
        "What’s new in Grafana v11.3",
        "Announcement banner"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-3.md",
        "gitBlobSha": "5eb55341a0458eac320b2317223af815e066d128",
        "sha256": "42f0fbcea86ed7f49f166bc9b279b95673f27c4ef505737f7b54ede18c391332",
        "lineStart": 256,
        "lineEnd": 256,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-3.md#L256-L256"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.df02446876bfddcbf86b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now create subfolders within folders where you have Edit or Admin rights without needing any additional permissions. This enables users and teams to fully manage their folder and dashboard hierarchy, and allows you to keep your instance secure by granting users the minimum necessary set of permissions.",
      "headingPath": [
        "What’s new in Grafana v11.3",
        "Improved subfolder creation flow"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-3.md",
        "gitBlobSha": "5eb55341a0458eac320b2317223af815e066d128",
        "sha256": "42f0fbcea86ed7f49f166bc9b279b95673f27c4ef505737f7b54ede18c391332",
