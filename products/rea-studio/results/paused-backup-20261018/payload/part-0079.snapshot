    {
      "id": "grafana.candidate.5b593c8347aee42ab7a5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A SurrealDB data source has been [added to the Plugin Catalog](https://grafana.com/grafana/plugins/grafana-surrealdb-datasource/), enabling the integration of [SurrealDB](https://surrealdb.com/), a real-time, multi-model database, with Grafana's visualization capabilities. This datasource allows users to directly query and visualize data from SurrealDB within Grafana, using SurrealDB's query language.",
      "headingPath": [
        "What’s new in Grafana v10.4",
        "Data sources",
        "SurrealDB Data Source"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-4.md",
