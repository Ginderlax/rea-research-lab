import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const here=import.meta.dirname,work=path.resolve(here,'..'),workspace=path.resolve(work,'..'),lab=path.join(workspace,'outputs/rea-research-lab'),stage=path.join(work,'editor-pattern-root-installation-plan-next'),run='runs/editor-audit-'+new Date().toISOString().replace(/[:.]/g,'-'),base=path.join(here,run),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),json=v=>Buffer.from(JSON.stringify(v,null,2)+'\n');
async function save(p,b){await fs.mkdir(path.dirname(path.join(base,p)),{recursive:true});await fs.writeFile(path.join(base,p),b,{flag:'wx'});}function safe(p){assert(typeof p==='string'&&p&&!path.isAbsolute(p)&&!path.win32.isAbsolute(p)&&!/[\\:\x00-\x1f]/.test(p)&&p.split('/').every(s=>s&&s!=='.'&&s!=='..'));}async function tree(root,prefix=''){const out=[];for(const e of await fs.readdir(root,{withFileTypes:true})){assert(!e.isSymbolicLink());const p=prefix+e.name;if(e.isDirectory())out.push(...await tree(path.join(root,e.name),p+'/'));else{assert(e.isFile());out.push(p);}}return out;}
async function manifest(root,name,pin,count){const b=await fs.readFile(path.join(root,name));assert.equal(id(b).sha256,pin);const m=JSON.parse(b),rows=Array.isArray(m.inventory)?m.inventory:Object.entries(m.inventory).map(([p,r])=>({path:p,...r}));assert.equal(rows.length,count);assert.deepEqual((await tree(root)).sort(),[...rows.map(r=>r.path),name].sort());const seen=new Set();for(const r of rows){safe(r.path);assert(!seen.has(r.path));seen.add(r.path);assert.deepEqual(id(await fs.readFile(path.join(root,r.path))),{bytes:r.bytes,sha256:r.sha256});}return{raw:b,rows};}
const prefix='products/rea-studio/results/editor-search-pattern-reviewed-installation-20261013/source-proof/';
function validate(proof,cache){assert.equal(proof.records.length,1660);assert.equal(proof.sourceAliases,1660);assert.equal(proof.payloads.length,628);assert.equal(proof.publicPayloads,628);assert.equal(proof.fullProductParity,false);assert.equal(proof.universalSuperiority,false);assert.equal(proof.historicalReceiptsRebound,false);assert.equal(proof.originalExecutableBytesPublic,0);const publicPaths=new Map(),keys=new Set(),used=new Set();for(const p of proof.payloads){safe(p.path);assert(p.path.startsWith(prefix));assert(!p.path.split('/').includes('.local'));assert(!publicPaths.has(p.path));const b=cache.get(p.path);assert(b);assert.deepEqual(id(b),{bytes:p.bytes,sha256:p.sha256});assert(Buffer.from(b.toString('utf8')).equals(b));assert(!/^(4d5a|7f454c46|504b0304|1f8b|377abcaf271c|03d9a29a|28b52ffd)/.test(b.subarray(0,8).toString('hex')));publicPaths.set(p.path,p);}for(const r of proof.records){safe(r.sourceRoot);safe(r.sourcePath);const key=r.epoch+'\0'+r.sourceRoot+'\0'+r.sourcePath;assert(!keys.has(key));keys.add(key);const p=publicPaths.get(r.publicPath);assert(p);assert.deepEqual({bytes:r.bytes,sha256:r.sha256},{bytes:p.bytes,sha256:p.sha256});used.add(r.publicPath);}assert.equal(used.size,628);return{aliases:keys.size,uniquePublicPaths:publicPaths.size,distinctByteSHA256:new Set(proof.payloads.map(r=>r.sha256)).size};}
try{
 await save('collector.mjs.snapshot',await fs.readFile(import.meta.filename));const before=await manifest(stage,'manifest.json','b5e21ff4810e0b92d066a72deeb8bb41538aed48e499a4bcd8774f8322b81996',637);await save('plan-before.json',json(before.rows));await save('source/plan-manifest.json.snapshot',before.raw);
 const proofRaw=await fs.readFile(path.join(stage,'source-proof/preservation-manifest.json')),proof=JSON.parse(proofRaw),planRaw=await fs.readFile(path.join(stage,'installation-plan.json')),plan=JSON.parse(planRaw);assert.deepEqual(id(proofRaw),{bytes:plan.publicSourceMap.bytes,sha256:plan.publicSourceMap.sha256});
 await save('source/preservation-manifest.json.snapshot',proofRaw);await save('source/installation-plan.json.snapshot',planRaw);
 const cache=new Map();for(const p of proof.payloads){assert(p.path.startsWith(prefix));cache.set(p.path,await fs.readFile(path.join(stage,'source-proof',p.path.slice(prefix.length))));}const mapCounts=validate(proof,cache);
 const specs=[['old-plan44','editor-search-pattern-publication-plan','freeze-manifest.json','480b15c9c47c095b70d972b550312ead3e075efe62bd8c502a008bbde9dfb3fb',44],['negative141','editor-search-pattern-independent-review','review-manifest.json','76c89a780e5c8e2a7774d925073b500a1e8a5f5c164c86a6e4e71b809717db31',141],['corrected852','editor-search-pattern-textarea-fix-next','freeze-manifest.json','0b4297c0d1d498ed614f6d98b8850fd05520594f850e7448c82e9652b9653f17',852],['independent127','editor-search-pattern-textarea-correction-independent-review','review-manifest.json','9b477f47294669cece711f5c0aa323056bec44ed1fc08ff1539d87c836108646',127]];
 const epochs=[];for(const[epoch,name,file,pin,count]of specs){const result=await manifest(path.join(work,name),file,pin,count);const e=proof.epochs.find(r=>r.epoch===epoch);assert(e);assert.equal(e.manifestSHA256,pin);assert.equal(e.frozenPayloads,count);const records=proof.records.filter(r=>r.epoch===epoch);assert.equal(records.length,count+1);for(const r of records){assert.equal(r.sourceRoot,'work/'+name);const b=await fs.readFile(path.join(work,name,r.sourcePath));assert(b.equals(cache.get(r.publicPath)));}await save('epoch-manifests/'+epoch+'.json.snapshot',result.raw);epochs.push({epoch,manifest:id(result.raw),payloads:count,aliases:count+1,strictCensus:true});}
 const old=path.join(work,'editor-search-pattern-publication-plan'),selected=JSON.parse(await fs.readFile(path.join(old,'public-preservation-map.json'))),excluded=JSON.parse(await fs.readFile(path.join(old,'excluded-generated-fixture-census.json')));assert.equal(selected.length,492);assert.equal(excluded.length,82);for(let i=0;i<selected.length;i++){const r=selected[i],p=proof.records[i];for(const k of['epoch','sourceRoot','sourcePath','publicPath','bytes','sha256'])assert.equal(p[k],r[k]);const b=await fs.readFile(path.join(workspace,r.sourceRoot,r.sourcePath));assert(b.equals(cache.get(r.publicPath)));}assert.equal(new Set(selected.map(r=>r.publicPath)).size,223);
 const old573=await manifest(path.join(work,'editor-search-pattern-next'),'freeze-manifest.json','7f975ae3f7a0827f5b9ade231bd121c5b4028f17d88758455fd680962ff0f878',573);const full=new Map([...old573.rows,{path:'freeze-manifest.json',...id(old573.raw)}].map(r=>[r.path,r]));const sourceNames=new Set(selected.map(r=>r.sourcePath));for(const r of excluded){safe(r.sourcePath);assert(!sourceNames.has(r.sourcePath));sourceNames.add(r.sourcePath);assert.deepEqual({bytes:r.bytes,sha256:r.sha256},{bytes:full.get(r.sourcePath).bytes,sha256:full.get(r.sourcePath).sha256});}assert.equal(sourceNames.size,574);assert.deepEqual([...sourceNames].sort(),[...full.keys()].sort());await save('source/initial573-manifest.json.snapshot',old573.raw);await save('source/initial492-map.json.snapshot',await fs.readFile(path.join(old,'public-preservation-map.json')));await save('source/excluded82.json.snapshot',await fs.readFile(path.join(old,'excluded-generated-fixture-census.json')));
 assert.equal(plan.rows.length,14);assert.equal(plan.existing,4);assert.equal(plan.additions,10);assert.equal(plan.productionEpoch,'f0b4746eae49b2a83694de1a0a28fee63e004257');assert.equal(plan.sourceOnly,true);assert.equal(plan.installedBehaviorExecuted,false);assert.equal(plan.nativeSelectionAccepted26,true);assert.equal(plan.nativeDirtyCloseCancelAccepted,false);assert.equal(plan.saveSpecificNativeCampaignExecuted,false);assert.equal(plan.wholeHostAcceptance,false);assert.equal(plan.allParityAndSuperiorityGates,false);const installs=[];for(const r of plan.rows){safe(r.sourcePath);safe(r.livePath);assert(r.livePath.startsWith('products/rea-studio/apps/editor/'));const b=r.sourceRoot==='this-plan'?await fs.readFile(path.join(stage,r.sourcePath)):await fs.readFile(path.join(workspace,r.sourceRoot,r.sourcePath));assert.deepEqual(id(b),r.after);if(r.before){assert.equal(r.kind,'modified');const live=await fs.readFile(path.join(lab,r.livePath));assert.deepEqual(id(live),r.before);await save('before-install/'+path.basename(r.livePath)+'.snapshot',live);}else{assert.equal(r.kind,'new');await assert.rejects(fs.access(path.join(lab,r.livePath)),e=>e.code==='ENOENT');}await save('proposals/'+path.basename(r.livePath)+'.snapshot',b);installs.push({target:r.livePath,before:r.before,after:r.after});}assert.equal(installs.filter(r=>r.before).length,4);assert.equal(new Set(installs.map(r=>r.target)).size,14);
 const append='\nExact upstream source/license files and failed/corrected study epochs are mapped by the [immutable search evidence manifest](../../results/editor-search-pattern-reviewed-installation-20261013/source-proof/preservation-manifest.json).\n',overlays=[];for(const d of plan.documentationOverlay){const name=path.basename(d.target),b=await fs.readFile(path.join(stage,'before-documents',name+'.snapshot')),a=await fs.readFile(path.join(stage,'documentation-proposal',name));assert.deepEqual(id(b),d.before);assert.deepEqual(id(a),d.after);assert(a.toString().endsWith(append));let t=a.toString().slice(0,-append.length);for(const[x,y]of[...d.replacements].reverse()){assert.equal(t.split(y).length-1,1);t=t.replace(y,x);}assert(Buffer.from(t).equals(b));const candidate=await fs.readFile(path.join(work,'editor-search-pattern-textarea-fix-next/candidate/products/rea-studio/apps/editor',name));assert(candidate.equals(b));overlays.push({target:d.target,inverseExact:true,replacements:d.replacements.length,evidenceLinkAppended:true});await save('before-documents/'+name+'.snapshot',b);}assert.equal(overlays.length,3);
 const licensing=JSON.parse(await fs.readFile(path.join(old,'source-and-license-binding.json')));assert.equal(licensing.officialFiles.length,5);for(const f of licensing.officialFiles){const r=proof.records.find(r=>r.sourceRoot==='work/editor-search-pattern-next'&&r.sourcePath===f.destination);assert(r);assert.deepEqual(id(cache.get(r.publicPath)),{bytes:f.bytes,sha256:f.sha256});assert(f.url.startsWith('https://raw.githubusercontent.com/microsoft/vscode/07f806f999227108933c2e30515b26eecc1fda74/'));if(f.sourcePath.endsWith('.ts'))assert(cache.get(r.publicPath).toString().slice(0,600).includes('MIT License'));else assert(cache.get(r.publicPath).toString().includes('Permission is hereby granted'));}await save('source/MIT-license-binding.json.snapshot',await fs.readFile(path.join(old,'source-and-license-binding.json')));
 const controls=[];for(const[name,mutate]of[['duplicate-alias',m=>m.records[1]=structuredClone(m.records[0])],['traversal-source',m=>m.records[0].sourcePath='../escape'],['unmapped-public',m=>m.records[0].publicPath=prefix+'unmapped.snapshot'],['duplicate-public-payload',m=>m.payloads[1]=structuredClone(m.payloads[0])],['private-public-path',m=>m.payloads[0].path=prefix+'.local/x.snapshot'],['bad-alias-identity',m=>m.records[0].sha256='0'.repeat(64)],['scope-promotion',m=>m.fullProductParity=true],['historical-rebinding',m=>m.historicalReceiptsRebound=true]]){const m=structuredClone(proof);mutate(m);assert.throws(()=>validate(m,cache),undefined,name);controls.push({name,rejected:true,inMemoryOnly:true});}await save('negative-gates.json',json(controls));
 const after=await manifest(stage,'manifest.json','b5e21ff4810e0b92d066a72deeb8bb41538aed48e499a4bcd8774f8322b81996',637);assert.deepEqual(after,before);await save('plan-after.json',json(after.rows));await save('validation.json',json({schema:'rea-editor-pattern-root-plan-independent-source-review/v1',accepted:true,sourceOnly:true,planManifest:id(before.raw),planPayloads:637,...mapCounts,epochs,initialSelectedMap492Exact:true,initial223PublicPathsDistinct:true,initial82ExclusionsExactAndComplete:true,initialWhole573NotCalledPublic:true,installedRows:installs,replace:4,add:10,documentationInverse:overlays,completeMITSourceLicenseFiles:5,nativeAcceptance26ScopeNotPromoted:true,nativeCancelIncompleteRetained:true,saveSpecificNativeAcceptanceNotInvented:true,fullHostAcceptanceNotInvented:true,sourceOnlyNegativeGates:controls.length,sourceStable:true,appExecutions:0,originalExecutions:0,browserExecutions:0,productionWrites:0,candidateWrites:0,fullProductParity:false,universalSuperiority:false,finiteGaps:['Source-only installation proposal; current installed behavior and whole shared-host acceptance still pending.','628 counts unique public paths; distinct byte identities are separately reported.','Native dirty-close Cancel remains unaccepted and owned tab closure unconfirmed in immutable127 review.']}));process.stdout.write(JSON.stringify({run,accepted:true,plan637:true,aliases1660:true,mapCounts,installation14:true,sourceOnly:true})+'\n');
}catch(e){await save('failure.json',json({name:e.name,message:e.message,stack:e.stack,sourceOnly:true,productionWrites:0,appExecutions:0,originalExecutions:0}));process.stderr.write(String(e.stack)+'\n');process.exitCode=1;}
