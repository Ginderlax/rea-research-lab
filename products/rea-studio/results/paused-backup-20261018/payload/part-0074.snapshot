    {
      "id": "grafana.candidate.5e01a907bc181631da15",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Since Grafana 10.2.0, the `None` basic role is available for organization users or service accounts. This role has no permissions by default, and you can grant permissions with RBAC.",
      "headingPath": [
        "Service accounts",
