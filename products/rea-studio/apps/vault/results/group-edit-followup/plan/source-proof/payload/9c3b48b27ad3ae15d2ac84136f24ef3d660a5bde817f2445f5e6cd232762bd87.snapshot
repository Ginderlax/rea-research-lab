{
  "scope": "Private client publication correction only",
  "deltas": [
    {
      "label": "Allow a private already-fetched group list to be rendered without a second await",
      "before": "async function groupList(bin=false,internal=false){",
      "after": "async function groupList(bin=false,internal=false,loaded=null){",
      "beforeIdentity": {
