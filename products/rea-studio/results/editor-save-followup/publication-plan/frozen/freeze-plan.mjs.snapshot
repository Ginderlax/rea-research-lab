import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const here=import.meta.dirname,work=path.resolve(here,'..'),workspace=path.resolve(work,'..'),repo=path.join(workspace,'outputs/rea-research-lab'),hash=b=>createHash('sha256').update(b).digest('hex'),ident=async p=>{const b=await fs.readFile(p);return{bytes:b.length,sha256:hash(b)}},read=async n=>JSON.parse(await fs.readFile(path.join(here,n))),write=async(n,x)=>fs.writeFile(path.join(here,n),JSON.stringify(x,null,2)+'\n',{flag:'wx'});
const map=await read('selected-file-map.json'),scan=await read('content-scan.json'),requirements=await read('requirements-reference.json'),census=await read('source-test-census.json');async function walk(base,prefix=''){const rows=[];for(const e of await fs.readdir(base,{withFileTypes:true})){assert(!e.isSymbolicLink());if(e.isDirectory())rows.push(...await walk(path.join(base,e.name),prefix+e.name+'/'));else rows.push(prefix+e.name);}return rows.sort();}
const after=[];for(const e of map.epochs){const base=path.join(work,e.folder),b=await fs.readFile(path.join(base,e.manifest.path));assert.equal(hash(b),e.manifest.sha256);const m=JSON.parse(b);assert.equal(Object.keys(m.inventory).length,e.count);assert.deepEqual((await walk(base)).filter(p=>p!==e.manifest.path),Object.keys(m.inventory).sort());for(const[rel,r]of Object.entries(m.inventory))assert.deepEqual(await ident(path.join(base,rel)),r);assert.deepEqual(await ident(path.join(base,e.receipt.path)),{bytes:e.receipt.bytes,sha256:e.receipt.sha256});after.push({...e,allExact:true});}
for(const r of map.currentProductionSource)assert.deepEqual(await ident(path.join(repo,r.path)),{bytes:r.bytes,sha256:r.sha256});for(const r of map.installedSearchHistorical.reused)assert.deepEqual(await ident(path.join(repo,r.path)),{bytes:r.bytes,sha256:r.sha256});for(const r of map.install)assert.deepEqual(await ident(path.join(workspace,r.source)),{bytes:r.bytes,sha256:r.sha256});for(const r of map.adapters)assert.deepEqual(await ident(path.join(here,r.proposedPath)),{bytes:r.bytes,sha256:r.sha256});
const reqAfter=[],sourceIds=[],capIds=[];for(const r of requirements.registryEpoch){const b=await fs.readFile(path.join(repo,r.path)),x=JSON.parse(b),name=path.basename(r.path);reqAfter.push({path:r.path,bytes:b.length,sha256:hash(b)});sourceIds.push(...x.sources.map(s=>({registry:name,id:s.id,sha256:s.sha256})));capIds.push(...(x.capabilities??(x.baselineProducts??x.products).flatMap(p=>p.requirements??p.capabilities)).map(c=>({registry:name,id:c.id})));}const sort=x=>[...x].sort((a,b)=>(a.registry+'/'+a.id).localeCompare(b.registry+'/'+b.id));assert.deepEqual(sort(sourceIds),sort(requirements.sourceIds));assert.deepEqual(sort(capIds),sort(requirements.capabilityIds));assert.equal(sourceIds.length,159);assert.equal(capIds.length,232);assert.equal(census.retainedRegistrations,60);assert.equal(census.totalProspectiveRegistrations,78);
assert.equal(map.payload.length,516);assert.equal(map.uniquePublicBlobs,174);assert.equal(map.reusedPublicBlobs,73);assert.equal(map.newPublicBlobs,101);assert.equal(map.excluded.length,0);assert(scan.rows.every(r=>!r.header&&!r.embeddedNativeBase64.length&&!r.credentialLikeJsonLiteralMatches.length));assert.deepEqual([...new Set(scan.rows.flatMap(r=>r.emailCandidates))],['fixtures@example.invalid']);assert(map.payload.every(r=>!r.publicPath.split('/').includes('.local')));
await write('content-classification.json',{schema:'rea-editor-save-source-payload-finite-classification/v1',all174UniqueSourceObjectsScanned:true,publicNativeHeaderMatches:0,quotedBase64NativeCarriers:0,credentialLikeJsonValues:0,email:{value:'fixtures@example.invalid',classification:'Owned synthetic Git identity test fixture; example.invalid.'},localWindowsUsernamePathObjects:scan.rows.filter(r=>r.localWindowsUsernamePathMetadata).length,userCredentialDataSelected:false,limit:'Header/literal checks and source origin only; not universal secret or personal-data absence.'});await write('failure-ledger.json',{schema:'rea-editor-save-publication-plan-own-failure/v1',collectorFailure:{source:{path:'build-plan.v1.mjs.snapshot',...await ident(path.join(here,'build-plan.v1.mjs.snapshot'))},stderr:{path:'build-plan.stderr.txt',...await ident(path.join(here,'build-plan.stderr.txt'))},classification:'Own metadata schema mismatch: groups is on final receipt focused object, not focused-validation root. Four adapters already written; v2 authenticated exact existing adapter bytes and completed. No source/candidate execution.',successfulAttempt:'build-plan.v2.stdout.txt'},candidateTestsExecuted:0,sourceOnlyPathInspectionMistakes:'Initial search-history location lookup expected app results; actual root results path was then read/authenticated. No production mutation.'});
const sources=[];for(const n of['build-plan.mjs','freeze-plan.mjs','selected-file-map.json','source-test-census.json','content-scan.json','content-classification.json','requirements-reference.json','proposed-focused-selection.json','authentication.json','INTEGRATION.md','failure-ledger.json'])sources.push({path:n,...await ident(path.join(here,n))});const receipt={schema:'rea-editor-save-source-only-publication-plan-validation/v1',at:new Date().toISOString(),fiveEpochsBefore:map.epochs,fiveEpochsAfter:after,strictInventoriesExactBeforeAfter:true,currentProductionSourcesUnchanged:map.currentProductionSource,installedSearchBaselineHistoricalReuse:map.installedSearchHistorical,payload:{originalInventoryEntries:511,exactOriginalManifests:5,pathRecords:516,uniquePublicInertObjects:174,reusedExistingPublicObjects:73,newPublicBlobs:101,excludedNativeCarriers:0,publicLocalDirectorySegments:0,recursiveHistoryRecopy:false},install:map.install,adapters:map.adapters,sourceTestCensus:{retained60:true,new18:true,prospectiveExpanded78:true,prospectiveCorrectionSubset45:true,executedHere:false},requirementsBefore:requirements.registryEpoch,requirementsAfter:reqAfter,requirementsFullMetadataEpochStable:JSON.stringify(requirements.registryEpoch)===JSON.stringify(reqAfter),original159FingerprintsAnd232IdsUnchanged:true,sources,privacy:'Synthetic example.invalid identity and10 source objects with local Windows username/path metadata retained; finite scan only.',productionModified:false,currentReceiptsRebound:false,executions:{behavioralTests:0,candidateRuntime:0,original:0,browser:0,benchmarks:0},historicalAuthor41AndIndependent14Overlap10:true,negativeDiskCommitDraftLossDistinctionRetained:true,directCallerObjectMutationNotHttpObjectSharing:true,fullProductParity:false,securityParity:false,universalSuperiority:false,rootOwnsCurrentInstallationAndAcceptance:true};await write('validation.json',receipt);const inventory={};for(const rel of await walk(here))if(!['freeze-manifest.json'].includes(rel))inventory[rel]=await ident(path.join(here,rel));await write('freeze-manifest.json',{schema:'rea-editor-save-source-only-plan-freeze/v1',frozenAt:receipt.at,files:Object.keys(inventory).length,totalBytes:Object.values(inventory).reduce((n,r)=>n+r.bytes,0),receiptSHA256:(await ident(path.join(here,'validation.json'))).sha256,inventory});console.log(JSON.stringify({receipt:await ident(path.join(here,'validation.json')),manifest:await ident(path.join(here,'freeze-manifest.json')),files:Object.keys(inventory).length,publication174:true,new101Reuse73:true,prospective78VerifiedFromSource:true,productionModified:false}));
