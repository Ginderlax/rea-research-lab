    {
      "id": "grafana.candidate.5b1e924def986308cfa2",
      "syntaxRole": "list-item",
      "sourceText": "- **Both:** The default. Runs both a Range query and an Instant query and returns combined results.",
      "headingPath": [
        "Prometheus query editor",
        "Query options",
        "Type"
      ],
      "source": {
        "path": "docs/sources/datasources/prometheus/query-editor/_index.md",
