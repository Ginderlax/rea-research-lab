def identity(raw):return {'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()}
def utc():return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='milliseconds').replace('+00:00','Z')
def safe(name):
 assert isinstance(name,str) and name and not re.search(r'[\\:\x00-\x1f\x7f]',name) and not name.startswith('/')
 assert all(part not in ('','.','..')for part in name.split('/'))
 return name
def inside(base,name):
 safe(name);p=base.joinpath(*PurePosixPath(name).parts)
 assert p.resolve().is_relative_to(base.resolve())
 current=base
 for part in PurePosixPath(name).parts:
  current=current/part
  try:info=os.lstat(current)
  except FileNotFoundError:continue
  assert not stat.S_ISLNK(info.st_mode) and not getattr(info,'st_file_attributes',0)&getattr(stat,'FILE_ATTRIBUTE_REPARSE_POINT',0x400)
 return p
def read(base,name,expected=None,maximum=MAX_FILE):
 p=inside(base,name);st=p.stat();assert stat.S_ISREG(st.st_mode) and st.st_size<=maximum
 raw=p.read_bytes();assert len(raw)==st.st_size
 if expected is not None:assert identity(raw)=={k:expected[k]for k in ('bytes','sha256')},name
 return raw
def absent(base,name):
 p=inside(base,name);assert not p.exists() and not p.is_symlink(),name
def git(*args):
 r=subprocess.run([str(GIT),*args],cwd=REPO,stdout=subprocess.PIPE,stderr=subprocess.PIPE,check=True,timeout=30)
 assert not r.stderr,r.stderr.decode(errors='replace');return r.stdout
def status():
 raw=git('status','--porcelain=v1','--untracked-files=all','-z');parts=raw.split(b'\0')
 assert parts[-1]==b'';rows=[]
 for item in parts[:-1]:
  text=item.decode('utf-8');assert len(text)>3 and text[2]==' '
  code,name=text[:2],safe(text[3:]);assert code in (' M','??'),(code,name)
  rows.append({'code':code,'path':name})
 assert len({r['path']for r in rows})==len(rows)
 return sorted(rows,key=lambda r:r['path'])
def git_guards(clean=False):
 assert git('rev-parse','--show-toplevel').decode().strip().replace('\\','/').casefold()==str(REPO).replace('\\','/').casefold()
 assert git('rev-parse','HEAD').decode().strip()==EXPECTED_HEAD
 assert git('symbolic-ref','--short','HEAD').decode().strip()==EXPECTED_BRANCH
 assert git('rev-parse','refs/tags/'+TAG+'^{commit}').decode().strip()==EXPECTED_HEAD
 if clean:assert status()==[],'Active checkout must be entirely clean; no optional capsule lane is accepted'
def check_rows(table,view):
 for row in table:assert identity(view(row['path']))=={k:row[k]for k in ('bytes','sha256')},row['path']
def notes_names():
 base=inside(REPO,'products/rea-studio/apps/notes');found=[];directory_count=0
 def visit(directory,relative='',depth=0):
  nonlocal directory_count
  assert depth<=32;directory_count+=1;assert directory_count<=128
  for item in sorted(directory.iterdir(),key=lambda p:p.name):
   info=os.lstat(item);assert not stat.S_ISLNK(info.st_mode) and not getattr(info,'st_file_attributes',0)&getattr(stat,'FILE_ATTRIBUTE_REPARSE_POINT',0x400),str(item)
   if item.is_dir():
    if item.name!='results':visit(item,relative+item.name+'/',depth+1)
   else:
    assert item.is_file();found.append('products/rea-studio/apps/notes/'+relative+item.name);assert len(found)<=64
 visit(base);return sorted(found)
def before_guard(row):
 if row['before'] is None:absent(REPO,row['path'])
 else:read(REPO,row['path'],row['before'])
def write_backup(name,raw):
 p=inside(BACKUP,name);p.parent.mkdir(parents=True,exist_ok=True)
 with p.open('xb')as stream:stream.write(raw);stream.flush();os.fsync(stream.fileno())
 assert read(BACKUP,name)==raw
 return {'path':BACKUP_REL+'/'+name,**identity(raw)}
def save_local(name,value):return write_backup(name,(json.dumps(value,indent=2)+'\n').encode())
owned_temporaries=[]
def atomic_write(name,raw):
 target=inside(REPO,name);target.parent.mkdir(parents=True,exist_ok=True)
 # Every target is a fixed allowed file. No computed recursive move/delete occurs.
 descriptor,tempname=tempfile.mkstemp(prefix='.rea-notes36-owned-',suffix='.tmp',dir=target.parent)
 temporary=Path(tempname);assert temporary.resolve().parent==target.parent.resolve();owned_temporaries.append((temporary,identity(raw)))
 try:
  with os.fdopen(descriptor,'wb')as stream:stream.write(raw);stream.flush();os.fsync(stream.fileno())
  assert temporary.read_bytes()==raw
  os.replace(temporary,target)
  assert read(REPO,name)==raw
 finally:
  if temporary.exists():
   # This exact temporary was exclusively created by this call, under its fixed target parent.
   assert not temporary.is_symlink();temporary.unlink()
def rollback(touched,owned_images,before_bytes):
 problems=[];restored=[]
 for name in reversed(touched):
  try:
   target=inside(REPO,name)
   if not target.exists():
    assert name==PUBLIC_JOURNAL or next(r for r in ROWS if r['path']==name)['before'] is None
    continue
   current=read(REPO,name)
   old=before_bytes.get(name)
   if old is not None and current==old:continue
   assert any(current==version for version in owned_images[name]),'Foreign concurrent bytes refused during rollback: '+name
   if old is None:
    # Only a file proven absent at preflight and containing this attempt's exact bytes is removed.
    target.unlink();absent(REPO,name)
   else:atomic_write(name,old);assert read(REPO,name)==old
   restored.append(name)
  except BaseException as error:problems.append({'path':name,'errorType':type(error).__name__,'message':str(error)})
 return {'restoredPaths':restored,'problems':problems,'complete':not problems,'emptyDirectoriesMayRemain':True,'recursiveDeletes':0}

