        "lineStart": 266,
        "lineEnd": 266,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/alerting-rules/templates/examples.md#L266-L266"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.2279517495864ab3d277",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If the classic condition has two or more conditions, and a time series exceeds multiple conditions at the same time, then its labels will be duplicated for each condition that is exceeded:",
      "headingPath": [
        "Labels and annotations template examples",
        "Legacy Alerting templates",
        "Print all labels from a classic condition"
      ],
      "source": {
        "path": "docs/sources/alerting/alerting-rules/templates/examples.md",
