import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const base=path.resolve(import.meta.dirname,'..'),lab=path.join(base,'outputs/rea-research-lab'),owned=path.join(base,'work/editor-sketch-reviewed-installation-next'),sha=b=>createHash('sha256').update(b).digest('hex');
function safe(n){assert.ok(typeof n==='string'&&n&&!path.isAbsolute(n)&&!/[\\:\x00-\x1f]/.test(n)&&n.split('/').every(s=>s&&s!=='.'&&s!=='..'));return n;}
function read(root,n,r){safe(n);let p=root;for(const s of n.split('/')){p=path.join(p,s);assert.ok(!fs.lstatSync(p).isSymbolicLink());}const b=fs.readFileSync(p);assert.ok(b.length<=32*1024*1024);if(r){assert.equal(b.length,r.bytes,n);assert.equal(sha(b),r.sha256,n);}return b;}
function names(root,rel=''){return fs.readdirSync(path.join(root,rel),{withFileTypes:true}).flatMap(e=>{assert.ok(!e.isSymbolicLink());const n=rel?rel+'/'+e.name:e.name;safe(n);return e.isDirectory()?names(root,n):[n];}).sort();}
function strict(folder,name,pin,count){const root=path.join(base,'work',folder),b=read(root,name);assert.equal(sha(b),pin);const m=JSON.parse(b),raw=m.records??m.inventory,rows=Array.isArray(raw)?raw:Object.entries(raw).map(([path,r])=>({path,...r}));assert.equal(rows.length,count);assert.deepEqual(names(root),[...rows.map(r=>r.path),name].sort());for(const r of rows)read(root,r.path,r);return{folder,root,manifest:{path:name,bytes:b.length,sha256:pin},rows};}
const sketchPlan=strict('sketch-layout-publication-plan','plan-manifest.json','e444af9b00de3466ac3284e73d72e41e0bae8786291bfdb5b18eafa9e301e700',43),apiPlan=strict('editor-value-api-publication-plan-next','freeze-manifest.json','0322b822798739f44b4d719a8a7d61647465532c19277c1523cc98af04b5ee9b',57),guide=strict('editor-value-api-guide-proposal-next','freeze-manifest.json','08b546c762589b233c5edbca116f8caa7e1a5feb291f379ad34d6111622fefc8',14),browser=strict('sketch-layout-browser-next','freeze-manifest.json','1f40beb1ef5f2f5c558f250b905ede08426d3eadd1183cf6ee9965c267642f66',74),route=strict('sketch-layout-static-route-next','freeze-manifest.json','86de6ef0f1f39a03d7c6b4039cbbc78d0230c0ab09aec6ea61aa105edaedb3f9',51);
const sketchMap=JSON.parse(read(sketchPlan.root,'public-alias-copy-list.json')),sketchLive=JSON.parse(read(sketchPlan.root,'live-install-copy-list.json')),apiMap=JSON.parse(read(apiPlan.root,'public-preservation-map.json')),apiLive=JSON.parse(read(guide.root,'live-copy-list.json')),routeValidation=JSON.parse(read(route.root,'validation.json'));assert.equal(sketchMap.records.length,661);assert.equal(sketchLive.records.length,8);assert.equal(apiMap.payload.length,402);assert.equal(apiLive.proposals.length,4);assert.equal(apiLive.newPaths,4);assert.equal(apiLive.replacements,0);
for(const e of sketchMap.epochs)strict(e.sourceRoot.slice(5),e.manifest,e.manifestSHA256,e.records);for(const e of apiMap.epochs){const row=apiMap.payload.find(r=>r.epoch===e.id&&r.sourcePath===e.manifest.path);assert.ok(row,'Missing API epoch manifest mapping');strict(row.sourceRoot.slice(5),row.sourcePath,row.sha256,e.payloadFiles);}
const copies=[];function planned(source,destination,identity,epoch){safe(source);safe(destination);assert.ok(source.startsWith('work/'));assert.ok(destination.startsWith('products/rea-studio/')&&destination.endsWith('.snapshot'));read(base,source,identity);assert.equal(fs.existsSync(path.join(lab,destination)),false);copies.push({source,path:destination,bytes:identity.bytes,sha256:identity.sha256,epoch});}
for(const r of sketchMap.records)planned(r.source,r.destination,r,r.epoch);for(const r of apiMap.payload)planned(r.sourceRoot+'/'+r.sourcePath,r.publicPath,r,r.epoch);
for(const [stage,prefix,epoch]of[[sketchPlan,'products/rea-studio/results/sketch-layout-reviewed-installation-20261013/source-plan/frozen/','sketch-source-plan'],[apiPlan,'products/rea-studio/apps/editor/results/position-range-selection-followup/publication-plan/frozen/','api-historical-plan'],[guide,'products/rea-studio/apps/editor/results/position-range-selection-followup/guide-proposal/frozen/','api-guide-proposal'],[browser,'products/rea-studio/apps/sketch/results/layout-followup/browser/frozen/','sketch-browser'],[route,'products/rea-studio/results/sketch-layout-reviewed-installation-20261013/shared-route/frozen/','sketch-shared-route']])for(const r of [...stage.rows,stage.manifest])planned('work/'+stage.folder+'/'+r.path,prefix+r.path+'.snapshot',r,epoch);assert.equal(copies.length,1307);assert.equal(new Set(copies.map(r=>r.path)).size,1307);
const baselineSketch=JSON.parse(read(sketchPlan.root,'external-baseline14.json')).rows,baselineEditor=JSON.parse(read(apiPlan.root,'current-editor24-before.json'));assert.equal(baselineSketch.length,14);assert.equal(baselineEditor.length,24);for(const r of [...baselineSketch,...baselineEditor])read(lab,r.path,r);
const proposals=[];for(const r of sketchLive.records){safe(r.source);read(base,r.source,r);safe(r.destination);assert.ok(r.destination.startsWith('products/rea-studio/apps/sketch/'));if(r.prior)read(lab,r.destination,r.prior);else assert.equal(fs.existsSync(path.join(lab,r.destination)),false);proposals.push({source:r.source,destination:r.destination,before:r.prior,after:{bytes:r.bytes,sha256:r.sha256},role:'sketch'});}
for(const r of apiLive.proposals){assert.equal(r.before,null);assert.equal(r.action,'add-exact');safe(r.sourceRoot);safe(r.proposalPath);safe(r.destination);assert.ok(r.destination.startsWith('products/rea-studio/apps/editor/'));read(base,r.sourceRoot+'/'+r.proposalPath,r.after);assert.equal(fs.existsSync(path.join(lab,r.destination)),false);proposals.push({source:r.sourceRoot+'/'+r.proposalPath,destination:r.destination,before:null,after:r.after,role:'editor-api'});}
read(lab,routeValidation.runtime.path,routeValidation.runtime.before);read(route.root,routeValidation.runtime.path,routeValidation.runtime.after);const beforeHost=read(lab,routeValidation.runtime.path).toString(),afterHost=read(route.root,routeValidation.runtime.path).toString();assert.equal(afterHost.replace(routeValidation.runtime.exactInsertedLine,''),beforeHost);proposals.push({source:'work/'+route.folder+'/'+routeValidation.runtime.path,destination:routeValidation.runtime.path,before:routeValidation.runtime.before,after:routeValidation.runtime.after,role:'shared-host'});const routeTestPath='products/rea-studio/tests/sketch-layout-static-route.test.mjs',routeTestBytes=read(route.root,routeTestPath);assert.equal(fs.existsSync(path.join(lab,routeTestPath)),false);proposals.push({source:'work/'+route.folder+'/'+routeTestPath,destination:routeTestPath,before:null,after:{bytes:routeTestBytes.length,sha256:sha(routeTestBytes)},role:'shared-host-test'});assert.equal(proposals.length,14);
fs.mkdirSync(owned,{recursive:true});const installing=process.argv.includes('--install');fs.copyFileSync(import.meta.filename,path.join(owned,installing?'installation-collector.mjs.snapshot':'preflight-collector.mjs.snapshot'),fs.constants.COPYFILE_EXCL);const preflight={schema:'rea-reviewed-editor-sketch-installation-preflight/v1',at:new Date().toISOString(),strictEpochs:[sketchPlan,apiPlan,guide,browser,route].map(s=>({folder:s.folder,manifest:s.manifest,payloadFiles:s.rows.length})),copies,proposals,plannedInertCopies:1307,productionMutations:0,baselineSketch14Exact:true,baselineEditor24Exact:true,newProductionFiles:11,existingReplacements:3,sketchAuthorFocusedProspective30:true,sketchExpandedProspective39:true,apiPureProspective13:true,routeHttpProspective2:true,originalOrBrowserExecutedNow:0,fullParity:false,superiority:false};
if(!installing){fs.writeFileSync(path.join(owned,'preflight.json'),JSON.stringify(preflight,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({owned,plannedInertCopies:1307,proposals:14,productionWrites:0}));}
else{for(const flag of ['--sketch-review=','--api-review=']){const p=process.argv.find(a=>a.startsWith(flag))?.slice(flag.length);assert.ok(p,'Independent source-plan acceptance required');const b=fs.readFileSync(path.resolve(p)),r=JSON.parse(b);assert.equal(r.acceptance,true,'Independent plan acceptance boolean');fs.writeFileSync(path.join(owned,flag.includes('sketch')?'sketch-independent-review.json.snapshot':'api-independent-review.json.snapshot'),b,{flag:'wx'});}for(const r of copies){const b=read(base,r.source,r),p=path.join(lab,r.path);fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,b,{flag:'wx'});}for(const r of proposals.filter(r=>r.before)){const n='before-images/'+r.destination+'.snapshot',p=path.join(owned,n);fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,read(lab,r.destination,r.before),{flag:'wx'});}for(const r of proposals){const b=read(base,r.source,r.after);fs.mkdirSync(path.dirname(path.join(lab,r.destination)),{recursive:true});fs.writeFileSync(path.join(lab,r.destination),b,{flag:r.before?'w':'wx'});read(lab,r.destination,r.after);}for(const r of copies)read(base,r.source,r);for(const s of [sketchPlan,apiPlan,guide,browser,route])strict(s.folder,s.manifest.path,s.manifest.sha256,s.rows.length);for(const r of [...baselineSketch,...baselineEditor].filter(r=>!proposals.some(p=>p.destination===r.path)))read(lab,r.path,r);const record={...preflight,schema:'rea-reviewed-editor-sketch-production-installation/v1',at:new Date().toISOString(),productionMutations:14,installed:proposals,allSourcesExactBeforeAfter:true,oldReceiptsRebound:false,installedBehaviorTestsExecuted:0,originalExecutions:0,browserExecutions:0};fs.writeFileSync(path.join(owned,'installation.json'),JSON.stringify(record,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({installedFiles:14,publicInertCopies:1307,sourceBytesStable:true,receipt:path.join(owned,'installation.json')}));}
