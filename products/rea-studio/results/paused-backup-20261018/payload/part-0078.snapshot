    {
      "id": "grafana.candidate.6b7debb25bd7b75f095d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "After making these steps Grafana UI should subscribe to the channel `stream/custom_stream_id/cpu` and you should see CPU data updates coming from Telegraf in near real-time.",
      "headingPath": [
        "Introduction",
