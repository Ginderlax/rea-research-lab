      "replacements": [
        [
          "import{spawnSync}from'node:child_process';",
          "import{spawnSync}from'node:child_process';import{makeOracleRun}from'./original-lzma-test-helper.mjs';"
        ],
        [
          "const sha=b=>createHash('sha256').update(b).digest('hex'),stage=process.env.ARCHIVE_AES_STAGE;if(!stage)throw new Error('Explicit owned AES stage required');",
          "const sha=b=>createHash('sha256').update(b).digest('hex'),stage=path.resolve(import.meta.dirname,'../../../..');"
        ],
        [
          "const backup=path.resolve(stage,'../full-archive-baseline-20261012'),original=path.join(backup,'full-product-x64/7z.exe'),pins=",
          "const pins="
        ],
        [
          "const base=path.join(stage,'.local/oracle-fixtures');fs.mkdirSync(base,{recursive:true});const run=fs.mkdtempSync(path.join(base,label+'-')),records=[];",
          "const{original,run}=makeOracleRun('aes-'+label),records=[];"
        ],
        [
          "const out=process.env.ARCHIVE_AES_OBSERVATIONS;if(!out)throw new Error('Owned observations output required');",
          "const out=process.env.ARCHIVE_AES_OBSERVATIONS||path.join(run,'observations');"
        ]
      ],
