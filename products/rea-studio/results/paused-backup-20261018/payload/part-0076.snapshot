        "lineStart": 163,
        "lineEnd": 163,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/influxdb/query-editor/index.md#L163-L163"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
