    {
      "id": "grafana.candidate.842a8fe0be902618d604",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana Cloud includes [Grafana Cloud Traces](https://grafana.com/docs/grafana-cloud/send-data/traces/), a pre-configured tracing data source backed by Tempo. Add a Tempo data source manually when you need to connect to a self-managed Tempo instance or require custom configuration beyond what Grafana Cloud Traces provides.",
      "headingPath": [
        "Configure the Tempo data source",
        "Connection"
      ],
      "source": {
        "path": "docs/sources/datasources/tempo/configure-tempo-data-source/_index.md",
