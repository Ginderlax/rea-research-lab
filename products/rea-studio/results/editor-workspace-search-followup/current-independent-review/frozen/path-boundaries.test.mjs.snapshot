import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
import {handle} from '../editor-search-path-fix-next/products/rea-studio/apps/editor/server.mjs';
import {createWorkspace} from '../editor-search-path-fix-next/products/rea-studio/lib/storage.mjs';
import {editorRelativePath,MAX_EDITOR_PATH_CHARACTERS} from '../editor-search-path-fix-next/products/rea-studio/apps/editor/file-path.mjs';
import {SEARCH_LIMITS} from '../editor-search-path-fix-next/products/rea-studio/apps/editor/workspace-search.mjs';
const sha=bytes=>createHash('sha256').update(bytes).digest('hex');let sequence=0;
async function fixture(id){const folder=path.join(import.meta.dirname,'runs',id+'-'+Date.now()+'-'+sequence++),workspace=await createWorkspace(path.join(folder,'workspace'));return{folder,workspace,put:async(name,content)=>{const file=workspace.resolve(name);await fs.mkdir(path.dirname(file),{recursive:true});await fs.writeFile(file,content,{flag:'wx'});},call:(action,input)=>handle({action,input,workspace}),observe:async value=>fs.writeFile(path.join(folder,'observation.json'),JSON.stringify(value,null,2)+'\n',{flag:'wx'})};}
function fileName(length,astral=false){const dirs=Array.from({length:5},(_,i)=>astral?'🧪'.repeat(79)+String(i)+'x':String(i)+'x'.repeat(159)),prefix=dirs.join('/')+'/',tail=length-prefix.length-4;assert.ok(tail>160&&tail<251);return prefix+(astral?'🧬'.repeat(80)+'y'.repeat(tail-160):'y'.repeat(tail))+'.txt';}
test('exact old 1096-unit fixture is reported incomplete without an unopenable match',async()=>{const f=await fixture('old-long-path'),name=Array.from({length:6},(_,i)=>String(i)+'x'.repeat(179)).join('/')+'/result.txt';assert.equal(name.length,1096);await f.put(name,'target\n');const result=await f.call('search',{query:'target'});await f.observe({name,pathLength:name.length,result,savedContent:await fs.readFile(f.workspace.resolve(name),'utf8')});assert.equal(result.matches.length,0);assert.equal(result.inspectedFiles,0);assert.equal(result.readBytes,0);assert.equal(result.truncated,true);assert.deepEqual(result.limitReasons,['editor-path-contract']);assert.equal(result.skipped.length,1);assert.equal(result.skipped[0].reason,'editor-path-contract');assert.equal(result.skipped[0].path.length,1085);await assert.rejects(f.call('read',{path:name}),/relative file path/);assert.equal(await fs.readFile(f.workspace.resolve(name),'utf8'),'target\n');});
test('1024-unit ASCII path can search, read and save through the same boundary',async()=>{const f=await fixture('ascii1024'),name=fileName(1024);await f.put(name,'target\n');assert.equal(name.length,1024);const result=await f.call('search',{query:'target'}),opened=await f.call('read',{path:name});assert.equal(result.truncated,false);assert.equal(result.matches.length,1);assert.equal(result.matches[0].path,name);assert.equal(opened.revision,result.matches[0].revision);const saved=await f.call('save',{path:name,revision:opened.revision,content:'target changed\n'});assert.equal(saved.revision,sha(Buffer.from('target changed\n')));assert.equal((await f.call('read',{path:name})).content,'target changed\n');await f.observe({name,length:name.length,result,opened,saved});});
test('1025-unit ASCII file is skipped and both read and save refuse before disk changes',async()=>{const f=await fixture('ascii1025'),name=fileName(1025);await f.put(name,'target\n');const result=await f.call('search',{query:'target'});await assert.rejects(f.call('read',{path:name}),/relative file path/);await assert.rejects(f.call('save',{path:name,revision:null,content:'changed'}),/relative file path/);await f.observe({name,length:name.length,result});assert.equal(result.matches.length,0);assert.equal(result.truncated,true);assert.deepEqual(result.skipped,[{path:name,reason:'editor-path-contract'}]);assert.equal(await fs.readFile(f.workspace.resolve(name),'utf8'),'target\n');});
test('astral path bounds use UTF-16 units while UTF-8 saved revisions and selections stay exact',async()=>{const f=await fixture('astral-path'),accepted=fileName(1024,true),refused=fileName(1025,true),bytes=Buffer.from('\ufeff𐐀x\r\ny𐐨z\n');assert.equal(accepted.length,1024);assert.ok(Buffer.byteLength(accepted)>1024);await f.put(accepted,bytes);await f.put(refused,'target\n');const result=await f.call('search',{query:'𐐀',matchCase:false}),opened=await f.call('read',{path:accepted});assert.deepEqual(result.matches.map(row=>[row.line,row.column,row.endColumn,row.start,row.end]),[[1,1,3,0,2],[2,2,4,6,8]]);assert.ok(result.matches.every(row=>row.path===accepted&&row.revision===sha(bytes)&&row.revision===opened.revision));assert.deepEqual(result.skipped,[{path:refused,reason:'editor-path-contract'}]);assert.equal(result.truncated,true);await assert.rejects(f.call('read',{path:refused}),/relative file path/);await f.observe({accepted,refused,lengths:[accepted.length,refused.length],utf8PathBytes:Buffer.byteLength(accepted),result,opened});assert.ok((await fs.readFile(f.workspace.resolve(accepted))).equals(bytes));});
test('whitespace validity is shared and valid leading-space names are preserved',async()=>{const f=await fixture('whitespace'),name=' space name.txt';await f.put(name,'target\n');assert.equal(editorRelativePath(name),name);for(const invalid of ['', ' ', '\t\r\n',null,undefined,123,'bad\0name']){assert.throws(()=>editorRelativePath(invalid),/relative file path/);await assert.rejects(f.call('read',{path:invalid}),/relative file path/);await assert.rejects(f.call('save',{path:invalid,revision:null,content:'changed'}),/relative file path/);}assert.equal(editorRelativePath('folder\\name.txt'),'folder/name.txt');const result=await f.call('search',{query:'target'});assert.equal(result.matches[0].path,name);assert.equal((await f.call('read',{path:name})).content,'target\n');assert.equal(result.truncated,false);assert.equal(MAX_EDITOR_PATH_CHARACTERS,1024);assert.equal(SEARCH_LIMITS.pathCharacters,1024);await f.observe({name,result,invalidPathValuesChecked:7});});
test('a valid 1024-unit directory is traversed but its 1026-unit child is explicitly skipped',async()=>{const f=await fixture('directory1024'),directory=fileName(1024),name=directory+'/x';await f.put(name,'target\n');assert.equal(directory.length,1024);assert.equal(name.length,1026);const result=await f.call('search',{query:'target'});assert.deepEqual(result.skipped,[{path:name,reason:'editor-path-contract'}]);assert.deepEqual(result.limitReasons,['editor-path-contract']);assert.equal(result.matches.length,0);assert.equal(result.readBytes,0);await f.observe({directory,name,result});});
test('exact file-byte boundary is searchable and an oversized neighboring file is disclosed',async()=>{const f=await fixture('file-byte-boundary'),content='x'.repeat(SEARCH_LIMITS.fileBytes-6)+'target';await f.put('exact.txt',content);await f.put('oversize.txt',content+'x');const result=await f.call('search',{query:'target'}),opened=await f.call('read',{path:'exact.txt'});assert.equal(result.matches.length,1);assert.equal(result.matches[0].start,SEARCH_LIMITS.fileBytes-6);assert.equal(result.matches[0].end,SEARCH_LIMITS.fileBytes);assert.equal(result.matches[0].revision,opened.revision);assert.deepEqual(result.skipped,[{path:'oversize.txt',reason:'file-size-limit'}]);assert.equal(result.truncated,false);assert.equal(result.readBytes,SEARCH_LIMITS.fileBytes);await f.observe({result,opened:{bytes:opened.bytes,revision:opened.revision},contentsSHA256:sha(Buffer.from(content))});});
test('maximum navigable Unicode path and preview pressure stop at the declared output limit',async()=>{const f=await fixture('response-boundary'),name=fileName(1024,true),content=('🧪'.repeat(180)+'target').repeat(1001);await f.put(name,content);const result=await f.call('search',{query:'target'}),outputBytes=Buffer.byteLength(JSON.stringify(result));assert.equal(result.truncated,true);assert.ok(result.limitReasons.includes('output-byte-limit'));assert.ok(result.matches.length>0&&result.matches.length<1000);assert.ok(outputBytes<=SEARCH_LIMITS.outputBytes);assert.ok(result.matches.every(row=>row.path===name&&row.preview.length<=400));assert.equal((await f.call('read',{path:name})).content,content);await f.observe({pathLength:name.length,contentBytes:Buffer.byteLength(content),outputBytes,matchCount:result.matches.length,limitReasons:result.limitReasons,first:result.matches[0],last:result.matches.at(-1)});});
