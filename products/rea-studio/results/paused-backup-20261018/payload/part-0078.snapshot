        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.6d191d03132440bc5b2d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Continuous profiling provides ongoing performance insights, capturing long-term trends and intermittent issues.",
      "headingPath": [
        "Profiling",
        "Continuous profiling"
      ],
      "source": {
        "path": "docs/sources/shared/datasources/pyroscope-profile-tracing-intro.md",
