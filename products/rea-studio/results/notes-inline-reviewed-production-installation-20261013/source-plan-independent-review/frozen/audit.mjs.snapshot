for(const p of ['../escape','C:/absolute','folder\\file','folder//file','/absolute','public/.local/private','bad\0name']){try{rel(p,true);assert.fail('unsafe path accepted');}catch(e){assert.notEqual(e.message,'unsafe path accepted');negativeGates.push({gate:'unsafe-path',input:p,rejected:true});}}
try{uniquePaths([finalMap.payload[0],finalMap.payload[0]]);assert.fail('duplicate accepted');}catch(e){assert.notEqual(e.message,'duplicate accepted');negativeGates.push({gate:'duplicate-public-path',rejected:true});}
