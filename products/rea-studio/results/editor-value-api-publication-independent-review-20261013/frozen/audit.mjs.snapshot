const current24=JSON.parse(await fs.readFile(path.join(base.root,'current-editor24-before.json')));assert.equal(current24.length,24);for(const r of current24){const b=await fs.readFile(path.join(repo,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);}const prior31=JSON.parse(await fs.readFile(path.join(workspace,'work/editor-search-save-current-browser-next/source-before.json')));assert.equal(prior31.length,31);for(const r of prior31){const b=await fs.readFile(path.join(repo,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256,r.path);}assert.deepEqual(current24.map(r=>r.path).sort(),prior31.filter(r=>r.path.startsWith('products/rea-studio/apps/editor/')).map(r=>r.path).sort());
const pure=await fs.readFile(path.join(base.root,'runs/final-pure13/validation.json'));assert.equal(sha(pure),'6aa8e84bf3046ad1d4231b97470fab9040aaa824b46214e7d91241f5802b22fc');const proof=JSON.parse(pure);assert.deepEqual(proof.summary,{tests:13,pass:13,fail:0,skipped:0});for(const[k,file]of[['stdout','stdout.txt'],['stderr','stderr.txt']]){const b=await fs.readFile(path.join(base.root,'runs/final-pure13',file));assert.equal(b.length,proof[k].bytes);assert.equal(sha(b),proof[k].sha256);}const testText=await fs.readFile(path.join(base.root,live.proposals[1].proposalPath),'utf8');assert.equal((testText.match(/^test\(/gm)||[]).length,13);const imports=[...testText.matchAll(/from\s+['"]([^'"]+)['"]/g)].map(m=>m[1]);assert.deepEqual(imports,['node:test','node:assert/strict','./position-range-selection.mjs']);assert(!/\b(?:writeFile|mkdir|appendFile|eval|new Function|runInContext)\s*\(/.test(testText));
const binding=JSON.parse(await fs.readFile(path.join(workspace,'work/sketch-layout-publication-plan/requirements-binding.json'))),sources=[],capabilities=[],registryObservations=[];for(const r of binding.registries){const b=await fs.readFile(path.join(repo,r.path)),j=JSON.parse(b),name=path.basename(r.path);registryObservations.push({path:r.path,bytes:b.length,sha256:sha(b)});for(const s of j.sources)sources.push({registry:name,id:s.id,sha256:s.sha256});const rows=name==='workspace-products.json'?j.capabilities:name==='visual-products.json'?j.baselineProducts.flatMap(p=>p.requirements):j.products.flatMap(p=>p.capabilities);for(const c of rows)capabilities.push({registry:name,id:c.id});}assert.deepEqual(sources,binding.originalSources);assert.deepEqual(capabilities,binding.originalCapabilityIds);
const guardResults=[];function negative(name,fn){assert.throws(fn);guardResults.push({name,rejected:true,sourceOnly:true,filesWritten:0});}const good=map.payload[0],freshSeen=()=>seen.delete(good.publicPath);negative('duplicate-public-path',()=>validateRow(good));freshSeen();negative('source-traversal',()=>validateRow({...good,sourcePath:'../escape'}));negative('public-traversal',()=>validateRow({...good,publicPath:prefix+'../escape.snapshot'}));negative('public-private-segment',()=>validateRow({...good,publicPath:prefix+'.local/escape.snapshot'}));negative('unlisted-source-path',()=>validateRow({...good,sourcePath:'unlisted-file.json'}));negative('missing-sha-field',()=>{const r={...good};delete r.sha256;validateRow(r);});negative('missing-byte-field',()=>{const r={...good};delete r.bytes;validateRow(r);});negative('invalid-byte-identity',()=>validateRow({...good,bytes:good.bytes+1}));negative('invalid-native-header',()=>assert(headerSafe(Buffer.from('4d5a9000','hex'))));seen.add(good.publicPath);
return{at:new Date().toISOString(),scopes:scopes.map(s=>({folder:s.folder,files:s.count,manifest:s.name,manifestSHA256:s.pin})),incoming402:map.payload.length,uniqueIncoming166:new Set(map.payload.map(r=>r.sha256)).size,publicAliases475:all.length,allMap:all,embedded190:embedded.rows.length,liveFour:live.proposals,READMEUnchanged:true,current24,current31:prior31,scan,pureHistoricalProofSHA256:sha(pure),pureHistoricalSummary:proof.summary,normalTestImports:imports,guardResults,requirements:{sources159:sources.length,capabilities232:capabilities.length,originalProjectionsExact:true,registryObservations},applicationExecutions:0,testsExecuted:0,originalExecutions:0,browser:0,hosts:0,benchmarks:0,productionMutations:0};}
if(process.argv[1]===import.meta.filename){const before=await authenticate();await fs.mkdir(path.join(here,'authority'),{recursive:true});for(const[d,n]of[['editor-value-api-publication-plan-next','freeze-manifest.json'],['editor-value-api-publication-plan-next','validation.json'],['editor-value-api-guide-proposal-next','freeze-manifest.json'],['editor-value-api-guide-proposal-next','validation.json'],['editor-value-api-guide-proposal-next','live-copy-list.json']])await fs.writeFile(path.join(here,'authority',d+'-'+n+'.snapshot'),await fs.readFile(path.join(workspace,'work',d,n)),{flag:'wx'});await fs.writeFile(path.join(here,'authentication-before.json'),JSON.stringify(before,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({sourceOnly:true,stages:before.scopes.length,publicAliases:475,incomingUnique:166,liveAdds:4,embedded190:190,guards:before.guardResults.length,noApplicationExecution:true}));}
