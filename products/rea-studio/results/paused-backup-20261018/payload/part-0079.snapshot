    {
      "id": "grafana.candidate.9b5a585519e56449ea89",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Copy on click support**",
      "headingPath": [
        "What’s new in Grafana v10.4",
        "Dashboards and visualizations",
        "Tooltip improvements"
