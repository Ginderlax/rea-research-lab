    },
    {
      "id": "grafana.candidate.ff10044799a8afe648c8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Let's assume we are tracking this data in InfluxDB and Grafana. Let's also assume that each of the above data sources comes from different buckets. How do we alert on this? How do we use Grafana and Flux to alert on two distinct conditions originating from two distinct data sources?",
      "headingPath": [
        "How to create Grafana alerts with InfluxDB and the Flux query language",
        "Example 2: how to create a Grafana alert from two queries and two conditions"
      ],
      "source": {
        "path": "docs/sources/tutorials/create-alerts-from-flux-queries/index.md",
        "gitBlobSha": "ff67f50b26681d3dc7d4d8e7eb10e4620c9488c3",
        "sha256": "48b344a4b7311941040db4785da4177ce4cd0dcaccadd5ebdd24c843c328bc40",
        "lineStart": 102,
        "lineEnd": 102,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/tutorials/create-alerts-from-flux-queries/index.md#L102-L102"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
