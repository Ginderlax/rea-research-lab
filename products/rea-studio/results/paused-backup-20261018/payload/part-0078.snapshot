    {
      "id": "grafana.candidate.6b2a0621cd0be9eac821",
      "syntaxRole": "table-row",
      "sourceText": "| `currency:<unit>`                  | Custom currency unit.                                                                                                                                                                                                                                                                                                                                   |",
      "headingPath": [
        "Configure standard options",
        "Standard options",
        "Unit",
        "Custom units"
      ],
      "source": {
