    },
    {
      "id": "grafana.candidate.73e9d57be5a877322802",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Fields other than the profile type and label selector don't interpolate template variables. If you enter a variable such as `$group` in the **Group by**, **Span ID**, **Max Nodes**, or **Limit** fields, Grafana passes the literal text to the backend instead of the variable's value.",
      "headingPath": [
        "Pyroscope template variables",
        "Where you can use template variables"
      ],
      "source": {
        "path": "docs/sources/datasources/pyroscope/template-variables/index.md",
