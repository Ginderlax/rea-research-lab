    {
      "id": "grafana.candidate.fa63409d349002990672",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We want to create one multidimensional alert that will notify us whenever the temperature in any tank is less than 30 °C or greater than 60 °C.",
      "headingPath": [
        "How to create Grafana alerts with InfluxDB and the Flux query language",
        "Example 4: create a dynamic (multidimensional) Grafana Alert using Flux"
      ],
