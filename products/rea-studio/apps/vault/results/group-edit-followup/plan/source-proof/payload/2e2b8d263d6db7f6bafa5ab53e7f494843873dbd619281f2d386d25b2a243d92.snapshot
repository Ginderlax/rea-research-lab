import assert from 'node:assert/strict';import {readFileSync,writeFileSync,readdirSync} from 'node:fs';import {resolve} from 'node:path';import {createHash} from 'node:crypto';import {authenticate} from './auth.mjs';
const here=import.meta.dirname,sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)});const authorities=authenticate(),runs=readdirSync(resolve(here,'runs'));assert.equal(runs.length,1);const run='runs/'+runs[0],raw=JSON.parse(readFileSync(resolve(here,run,'validation.json')));assert.equal(raw.accepted,true);assert.equal(raw.totals.tests,15);assert.equal(raw.totals.pass,15);assert.equal(raw.totals.fail+raw.totals.skipped+raw.totals.cancelled+raw.totals.todo,0);assert.deepEqual(authorities,JSON.parse(readFileSync(resolve(here,'authority-before.json'))));const adapter=JSON.parse(readFileSync(resolve(here,'adapter.json')));assert.equal(adapter.initialCaseBodies11Unchanged,true);assert.equal(adapter.sourceCorrectionFourSubstitutionsInverseExact,true);let fixture=readFileSync(resolve(here,'ui-fixture.mjs'),'utf8');for(const r of adapter.changes.filter(r=>r.path==='ui-fixture.mjs').slice().reverse()){assert.equal(fixture.split(r.after).length-1,1);fixture=fixture.replace(r.after,r.before);}assert.deepEqual(Buffer.from(fixture),readFileSync(resolve(here,'fixture-before.mjs.snapshot')));
const fresh=JSON.parse(readFileSync(resolve(here,run,'fresh-four/observations.json'))),cleanup=fresh.filter(r=>r.cleanup===true);assert.equal(cleanup.length,4);assert(cleanup.every(r=>r.tempGone));const observations=Object.fromEntries(fresh.filter(r=>r.name.startsWith('fresh-')&&r.actualBackendPersistenceEvents).map(r=>[r.name,r]));assert.equal(observations['fresh-singular-create-continuation-writes'].actualBackendPersistenceEvents.length,2);assert.equal(observations['fresh-failed-save-retry-persistence'].acceptedWrites,1);assert.equal(observations['fresh-final-list-disposal-proof'].followupRequestsAfterDisposal,0);
const validation={schema:'rea-vault-group-edit-correction-independent-review/v1',at:new Date().toISOString(),finiteAcceptance:true,confirmedNewCandidateFaults:0,authorities:authorities.map(r=>({name:r.name,folder:r.folder,file:r.file,manifest:r.manifest,payloads:r.payloads,fullListedInventoryExact:r.fullListedInventoryExact,declaredLocalExtras:r.declaredLocalExtras.length})),authoritiesSourceBeforeAfterStable:true,correctedClient:{bytes:29850,sha256:'29f99c9132286e93ffdcc26105daa9d4209591b4aedad438cc6830841f227908'},fourSubstitutionRuntimeCorrectionInverseExact:true,initialNegativeControlCaseBodies11Unchanged:true,fixtureRuntimeImportPathAdapterSubstitutions:4,fixtureAdapterInverseExact:true,executionReceipt:run+'/validation.json',executionReceiptIdentity:id(readFileSync(resolve(here,run,'validation.json'))),counts:raw.totals,replayGroups:11,newIndependentlyWrittenGroups:4,blindHeldOut:false,authorCorrectionControlBodiesReadBeforeNewFourDesign:true,sourceRows:15,sourceStable:true,actualClientAndBackend:true,syntheticDOMModel:true,persistenceStoreSyntheticMemory:true,actualEncryptedPersistenceCallsObserved:true,freshAcceptedCreateWrites:1,freshSubsequentSaveWrites:1,freshFailedSaveAttempts:1,freshFailedSaveRetryAcceptedWrites:1,freshUnchangedEffectiveDraftAcknowledged:true,freshFinalListDisposeFollowupReads:0,all15FixtureTempsRemoved:true,historicalOriginalAccounting:{author885TotalAssemblyLoads:22,reexecutedNow:0,originalGui:0,originalFullProgram:0},historicalHTTP21AndBrowser21NotCorrectedClientAcceptance:true,newOriginalExecutions:0,nativeBrowserExecutions:0,hostProcessesStarted:0,benchmarks:0,productionWrites:0,authorStageWrites:0,fullParity:false,securityEquivalence:false,superiority:false,limits:{children:3,sequential:true,perChildDeadlineMs:20000,perChannelOutputBytes:1048576,oldSpaceMiB:128,outerHardMemoryWatchdog:false,scope:'Finite captured response/order/draft/persistence cases; no universal async, storage, DOM or browser-equivalence claim.'}};
writeFileSync(resolve(here,'review-validation.json'),JSON.stringify(validation,null,2)+'\n');writeFileSync(resolve(here,'authority-after.json'),JSON.stringify(authorities,null,2)+'\n');writeFileSync(resolve(here,'README.md'),'Finite independent correction acceptance:15/15 pass, zero fail/skip/cancel/todo. Exact11 previous negative/control case bodies are replayed without edits; four fixture import paths select corrected client/server/helpers. Four additional independently written controls observe actual encrypted backend persistence and final response boundaries. The author control bodies were read beforehand; these are not blind held-out cases.\n\nThe complete frozen137/885/78 inventories and historical HTTP21/browser21 authorities authenticate unchanged before/after. Four client substitutions reverse exactly to885. Original22 assembly loads and the previous HTTP/browser campaigns remain historical; no original, native browser, host, full-suite or benchmark execution occurred here. The model uses the real corrected client and server with a synthetic in-memory persistence store and owned empty temporary workspace; every fixture clears it.\n\nAccepted finite outcomes: a newer final-list draft follows the new UUID/current MAC on subsequent Save with one actual encrypted write per accepted operation; effective values returned to the submitted draft are acknowledged and cleared; failed persistence leaves the encrypted document/session revision unchanged and a retry commits once; final-list disposal scrubs controls and sends no later requests. Further actual corrected-browser and production integration are root-owned and pending.\n');
function files(p='',out=[]){for(const d of readdirSync(resolve(here,p),{withFileTypes:true})){assert(!d.isSymbolicLink());const n=p?p+'/'+d.name:d.name;if(d.isDirectory())files(n,out);else out.push(n);}return out;}
const inventory=files().filter(p=>p!=='review-manifest.json').sort().map(path=>({path,...id(readFileSync(resolve(here,path)))}));for(const r of inventory)assert.deepEqual(id(readFileSync(resolve(here,r.path))),{bytes:r.bytes,sha256:r.sha256});const manifest={schema:'rea-vault-group-edit-correction-independent-strict-freeze/v1',files:inventory.length,strict:true,inventory,sourceOnlyAuthorityAuthentication:true,finiteBehavioralReview:true,allSourcesStable:true,applicationProductionChanges:0};writeFileSync(resolve(here,'review-manifest.json'),JSON.stringify(manifest,null,2)+'\n');console.log(JSON.stringify({frozen:inventory.length,receipt:id(readFileSync(resolve(here,'review-validation.json'))),manifest:id(readFileSync(resolve(here,'review-manifest.json'))),counts:raw.totals,sourceStable:true}));
