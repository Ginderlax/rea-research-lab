import assert from 'node:assert/strict';
import {readFileSync,writeFileSync,readdirSync,lstatSync,mkdirSync,linkSync,copyFileSync,openSync,readSync,closeSync,existsSync} from 'node:fs';
import {resolve,dirname} from 'node:path';
import {createHash} from 'node:crypto';
const stage=import.meta.dirname,repo=resolve(stage,'../../outputs/rea-research-lab'),mirror=resolve(stage,'private-proof-layout-v3'),records=JSON.parse(readFileSync(resolve(stage,'transition-records.json'))),copied=[],excluded=[],sha=b=>createHash('sha256').update(b).digest('hex');let total=0;
assert(!existsSync(mirror),'One immutable mirror acquisition per attempt; use a new work directory for retries');
function put(src,p,owned=false){const target=resolve(mirror,p);if(existsSync(target))return;const stat=lstatSync(src);assert(stat.isFile()&&!stat.isSymbolicLink());assert(stat.size<=32*1024*1024,'Per-file mirror admission');assert(copied.length<15000&&total+stat.size<=1024*1024*1024,'Mirror acquisition cap');const fd=openSync(src,'r'),head=Buffer.alloc(Math.min(512,stat.size));try{readSync(fd,head,0,head.length,0);}finally{closeSync(fd);}const magic=head.subarray(0,8).toString('hex');const carrier=['4d5a','7f454c46','504b0304','504b0506','1f8b','377abcaf271c','fd377a585a00','28b52ffd','03d9a29a'].some(x=>magic.startsWith(x))||head.subarray(257,262).toString()==='ustar';if(carrier){excluded.push({path:p,bytes:stat.size,reason:'Native/archive carrier not needed by source-only proof readers'});return;}mkdirSync(dirname(target),{recursive:true});if(owned)copyFileSync(src,target);else linkSync(src,target);copied.push({path:p,bytes:stat.size,mode:owned?'independent-owned-copy':'read-only-hardlink-from-public-root'});total+=stat.size;}
function visit(p){for(const d of readdirSync(resolve(repo,p),{withFileTypes:true})){assert(!d.isSymbolicLink());const n=p+'/'+d.name;if(d.isDirectory()){if(['.local','work','node_modules','artifacts','tooling'].includes(d.name)){excluded.push({path:n,reason:'Private/local directory never acquired'});continue;}visit(n);}else put(resolve(repo,n),n);}}
// Acquire only the exact proof families referenced by these readers, excluding
// unrelated huge Metrics studies rather than widening the failed v1 budget.
for(const p of ['products/rea-studio/apps/editor','products/rea-studio/apps/notes','products/rea-studio/apps/vault','products/rea-studio/apps/sketch','products/rea-studio/lib','products/rea-studio/public','products/rea-studio/requirements'])visit(p);
for(const p of ['package.json','server.mjs','STATUS.json'])put(resolve(repo,'products/rea-studio',p),'products/rea-studio/'+p);
for(const r of records.sources)put(resolve(repo,r.path),r.path);
const prefixes=new Set();for(const name of ['verify-followup-records.mjs','verify-notes-layout-value-api-checkpoint.mjs','verify-editor-value-api-followups.mjs','verify-editor-save-followup.mjs']){const body=readFileSync(resolve(stage,'candidate/scripts',name),'utf8');for(const m of body.matchAll(/['"](products\/rea-studio\/results\/[^'"]+)['"]/g)){const p=m[1].replace(/\/$/,'');if(existsSync(resolve(repo,p)))prefixes.add(p);}}
for(const p of [...prefixes].sort()){const stat=lstatSync(resolve(repo,p));if(stat.isDirectory())visit(p);else put(resolve(repo,p),p);}
for(const r of [...records.routes.map(r=>({path:r.historicalPath})),...Object.values(records.metadata).map(r=>({path:r.historicalPath})),records.installation.manifest,records.installation.record,records.oldCapsule])put(resolve(repo,r.path),r.path);
for(const n of readdirSync(resolve(stage,'candidate/scripts')))put(resolve(stage,'candidate/scripts',n),'scripts/'+n,true);
for(const r of records.verifiers)put(resolve(stage,'verifier-before',r.path.slice(8)+'.snapshot'),r.historicalPath,true);
for(const n of ['verify-sketch-layout-followups.mjs','sketch-layout-public-proof-loader.mjs','sketch-layout-proof-verifier.mjs']){const at=resolve(repo,'scripts',n);if(existsSync(at))put(at,'scripts/'+n);}
// Root's installed Sketch source-only runner declares its exact module filenames.
for(const n of readdirSync(resolve(repo,'scripts'))){if(existsSync(resolve(mirror,'scripts',n)))continue;if(n.endsWith('.mjs'))put(resolve(repo,'scripts',n),'scripts/'+n);}
writeFileSync(resolve(stage,'mirror-acquisition-v3.json'),JSON.stringify({schema:'rea-editor-vault-private-source-proof-layout/v1',at:new Date().toISOString(),sourceOnly:true,mirrorFiles:copied.length,declaredBytes:total,capFiles:15000,capBytes:1024*1024*1024,perFileCap:32*1024*1024,copied,excluded,prefixes:[...prefixes],applicationImports:0,originalExecutions:0,productionWrites:0,prohibition:'Never modify linked bytes or run --write. Candidate and beforealias files are independently owned copies.'},null,2)+'\n');console.log(JSON.stringify({sourceOnly:true,files:copied.length,bytes:total,excluded:excluded.length,productionWrites:0}));

