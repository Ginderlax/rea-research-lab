      "syntaxRole": "table-row",
      "sourceText": "| Credentials have expired                         | For temporary credentials, generate new ones. For access keys, verify they haven't been deactivated or deleted.                                                                                                                                                                                                                                                                                                                       |",
      "headingPath": [
