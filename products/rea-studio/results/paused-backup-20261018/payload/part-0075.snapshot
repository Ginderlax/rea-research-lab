    {
      "id": "grafana.candidate.0f8c5e653e007c1c8efd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In these cases, we recommend that you take these steps before the upgrade to enable subfolders:",
      "headingPath": [
        "Breaking changes in Grafana v11.0",
        "Users and Operators",
        "Subfolders cause very rare issues with folders that have forward slashes in their names",
        "Description and migration/mitigation"
      ],
      "source": {
