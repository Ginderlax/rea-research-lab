for(const initial of [undefined,{}, {unrelated:'kept'}, {p95:31,unrelated:'kept'}, {p95:31,p50:17,allValues:[7],unrelated:'kept'}])for(const reducers of [['p95'],['p95','p50'],['p95','unknown-reducer'],['p95','allValues'],['avg','p95']]){const expected=run(original,Array.from({length:25000},(_,i)=>i%101===0?null:i/16),'number','connected',reducers,initial);for(const role of roles){note('cache:'+JSON.stringify(initial)+':'+reducers.join(','),role,expected,run(implementations[role],Array.from({length:25000},(_,i)=>i%101===0?null:i/16),'number','connected',reducers,initial));counts[role].cacheAlias++;cacheAliasCount++;}}
