 assert(options.installedManifest,'Installed Notes scope requires --installed-manifest');assert(!options.bootstrapManifest);assert(!options.overlayManifest);
 assert.equal(path.resolve(options.installedManifest),path.join(path.dirname(output),'notes-installed-source-check.json'));
 assert.equal(record.executionEnvironment,'github-hosted');assert.equal(process.platform,'win32');assert.equal(process.version,'v24.16.0');
