import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import {createHash} from 'node:crypto';

const work=import.meta.dirname,adapter=path.join(work,'keepass-history-production-adapter'),review=path.join(work,'keepass-history-production-adapter-review-preservation'),root=path.join(work,'keepass-history-production-integration-bundle-ready');
const sha=b=>createHash('sha256').update(b).digest('hex'),read=(dir,n)=>fs.readFile(path.join(dir,n)),parse=async(dir,n)=>JSON.parse(await read(dir,n));
const app='products/rea-studio/apps/vault/',study=app+'results/history-followup/',sanitize=n=>n.split('/').map(v=>v==='.local'?'private-study-records':v).join('/');
const bind=async(dir,n)=>{const b=await read(dir,n);return{path:n,bytes:b.length,sha256:sha(b)}};
const expected={adapter:'c9ea75292133e63bb3be1c2275ad8143f2d1129faf36e884c9da2fea2dce9516',review:'b52cc17fccdc55719950340a6cdff2fc332ffd2672ed9ba7cb88c11874049e9e'};
async function authenticate(dir,name,hash,count){assert.equal(sha(await read(dir,name)),hash);const m=await parse(dir,name);assert.equal(m.count,count);assert.equal(m.files.length,count);const names=new Set();for(const e of m.files){assert(!names.has(e.path));names.add(e.path);assert(!path.isAbsolute(e.path)&&!e.path.split('/').includes('..'));const b=await read(dir,e.path);assert.equal(b.length,e.bytes,e.path);assert.equal(sha(b),e.sha256,e.path);}return m;}
const am=await authenticate(adapter,'adapter-manifest.json',expected.adapter,1600),rm=await authenticate(review,'preservation-manifest.json',expected.review,87),validation=await parse(adapter,'adapter-validation.json'),adaptations=await parse(adapter,'adaptations.json'),rp=await parse(review,'review-preservation.json');
const zipSha='711bd9ec7076661678469e51bae876debac07a08c32f1b1c6b3b8fe5e761c13a',carrierTargets=new Map(am.files.filter(e=>e.sha256===zipSha&&!e.path.startsWith('.local/')).map((e,i)=>[e.path,'.local/stage-carriers/additional-acquisition/source-zip-'+String(i+1).padStart(2,'0')+'.bin.snapshot']));
assert.equal(validation.sourceStable,true);assert.equal(validation.counts.pass,41);assert.equal(validation.additionalProbeCounts.pass,11);assert.equal(rp.reviewerArtifactCount,82);await fs.mkdir(root);
const sourceCopies=[],publicRenames=[];
async function copy(dir,n,target){const b=await read(dir,n);await fs.mkdir(path.dirname(path.join(root,target)),{recursive:true});await fs.writeFile(path.join(root,target),b,{flag:'wx'});sourceCopies.push({sourceRoot:dir===adapter?'frozen-production-adapter':'frozen-review-preservation',originalPath:n,preservedPath:target,bytes:b.length,sha256:sha(b)});if(n!==target&&n.startsWith(study))publicRenames.push({originalPath:n,preservedPath:target,bytes:b.length,sha256:sha(b)});}
for(const e of am.files)await copy(adapter,e.path,carrierTargets.get(e.path)??(e.path===study+'preservation-manifest.json'?study+'production-adapter/public-preservation-manifest.original.json.snapshot':e.path.startsWith(study)?sanitize(e.path):e.path));
for(const n of ['adapter-manifest.json','adapter-freeze.json'])await copy(adapter,n,n);
for(const e of rm.files){const target=e.path.startsWith(app)?sanitize(e.path):'preserved-final-review-bundle/'+e.path+'.snapshot';await copy(review,e.path,target);}
for(const n of ['preservation-manifest.json','freeze.json'])await copy(review,n,'preserved-final-review-bundle/'+n+'.snapshot');

// Publicly preserve the tested adapter's exact infrastructure and evidence, as inert files.
// Original ZIP carriers stay in the bundle-local .local tree and never enter the copy list.
for(const e of am.files.filter(e=>!e.path.startsWith(app)&&!e.path.startsWith('.local/')))await copy(adapter,e.path,sanitize(study+'production-adapter/'+e.path+'.snapshot'));
for(const n of ['adapter-manifest.json','adapter-freeze.json'])await copy(adapter,n,study+'production-adapter/'+n+'.snapshot');
for(const n of ['README.md','review-preservation.json','preserve-keepass-final-review-for-adapter.mjs','preservation-manifest.json','freeze.json'])await copy(review,n,study+'final-independent-review/preservation-bundle/'+n+'.snapshot');

const originalPreservation=await parse(adapter,study+'preservation-manifest.json');
const currentPreservation={...originalPreservation,schema:'rea-vault-history-public-production-path-preservation/v1',historicalManifest:await bind(adapter,study+'preservation-manifest.json'),historicalPublicInertSnapshots:1450,historicalLocalCarriers:4,publicInertSnapshots:1442,localCarriers:12,publicPathAdaptation:'Every public directory segment named .local is mapped to private-study-records. Content bytes and original paths stay exact. Eight acquisition .bin snapshots match the exact source ZIP hash and join the four named ZIP carriers as local-only.',files:originalPreservation.files.map(e=>({...e,kind:carrierTargets.has(e.preservedPath)?'local-original-carrier':e.kind,preservedPath:carrierTargets.get(e.preservedPath)??(e.kind==='public-inert-snapshot'?sanitize(e.preservedPath):e.preservedPath)}))};
assert.equal(currentPreservation.files.length,1454);await fs.writeFile(path.join(root,study+'preservation-manifest.json'),JSON.stringify(currentPreservation,null,2)+'\n');
await fs.writeFile(path.join(root,study+'final-independent-review/preservation-mapping.json'),JSON.stringify({...rp,mappings:rp.mappings.map(e=>({...e,preservedPath:sanitize(e.preservedPath)})),historicalPreservationBundleManifestSha256:expected.review},null,2)+'\n',{flag:'wx'});
await fs.writeFile(path.join(root,'assembly.mjs'),await fs.readFile(import.meta.filename),{flag:'wx'});
const failedRoot=path.join(work,'keepass-history-production-integration-bundle');
for(const n of ['assembly.failed-v1.mjs.snapshot','assembly.failed-v1.stdout.txt']){const b=await read(failedRoot,n),target=study+'production-adapter/assembly-failures/'+n;await fs.mkdir(path.dirname(path.join(root,target)),{recursive:true});await fs.writeFile(path.join(root,target),b,{flag:'wx'});}
for(const n of ['assembly.failed-v2.mjs.snapshot','assembly.failed-v2.stdout.txt']){const b=await read(path.join(work,'keepass-history-production-integration-bundle-final'),n),target=study+'production-adapter/assembly-failures/'+n;await fs.writeFile(path.join(root,target),b,{flag:'wx'});}
await fs.writeFile(path.join(root,study+'production-adapter/assembly-failures/failure.json'),JSON.stringify({schema:'rea-vault-bundle-assembly-failure/v1',exitCode:1,kind:'collector-only',message:"TypeError: Cannot read properties of undefined (reading 'map')",cause:'Historical manifest uses files; v1 assembly expected mappings.',preservedPartialTree:'work/keepass-history-production-integration-bundle',sourceScript:'assembly.failed-v1.mjs.snapshot',productionModified:false,testsExecuted:0,repair:'New separate final bundle uses actual files field; old partial tree and exact failed script remain unchanged.'},null,2)+'\n',{flag:'wx'});
await fs.writeFile(path.join(root,'INTEGRATION.md'),`# Frozen Vault integration bundle\n\nThis bundle combines the exact tested production adapter with the accepted independent final review. Install only entries in integration-copy-list.json. The 23 live app files comprise five byte-identical runtime modules, twelve tests, five helpers and the app README. Shared host, catalog, storage and public assets here are prior validation infrastructure; they are not proposed replacements.\n\nCurrent-layout 41/41 and the separate author replay 11/11 were executed in the frozen adapter before this preservation-only assembly. Their source identities remain exact. The accepted independent review separately ran 11/11 and real private-browser draft/restore/save/restart checks; it executed no original assembly. No acceptance rerun, browser operation or production edit occurred during bundle assembly. Historical compatibility18, earlier failed probes and all original counts remain preserved without rebinding. Original24 assembly loads, DOM25 candidate groups, author-repeated DOM11, five shared-host test processes and one private route host remain separate.\n\nEvery public .local directory segment is renamed private-study-records with original-path/hash mappings. Frozen historical metadata remains inert and exact; the new current public preservation manifest names the actual adapted paths. Four authenticated full original source ZIP copies remain bundle-local and are excluded from integration. No original EXE/DLL carrier is embedded. Native runtime imports no original helper/runtime. Full product parity, original-grade security and superiority remain false.\n\nThis bundle is frozen. Parent production integration and its final browser/full-suite checks remain subsequent work.\n`,{flag:'wx'});
async function inventory(relative=''){let out=[];for(const e of await fs.readdir(path.join(root,relative),{withFileTypes:true})){const n=relative?relative+'/'+e.name:e.name;if(e.isDirectory())out.push(...await inventory(n));else{assert(e.isFile(),'No links '+n);out.push(await bind(root,n));}}return out;}
const liveNames=[...adaptations.runtime.map(e=>e.path),app+'README.md',...adaptations.tests.map(n=>app+n),...['harness.mjs','history-oracle.ps1','http-runner.mjs','ui-fixture.mjs','lifecycle-ui-fixture.mjs'].map(n=>app+n)];assert.equal(new Set(liveNames).size,23);
for(const n of liveNames)assert.equal(sha(await read(root,n)),sha(await read(adapter,n)),'Live app changed '+n);
for(const e of currentPreservation.files){const b=await read(root,e.preservedPath);assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256);}
for(const e of rp.mappings)assert.equal(sha(await read(root,sanitize(e.preservedPath))),e.sha256);
const all=await inventory(),publicFiles=all.filter(e=>e.path.startsWith(study));
assert(publicFiles.every(e=>!e.path.split('/').includes('.local')));
assert(publicFiles.every(e=>!/(?:\.zip|\.exe|\.dll)(?:\.snapshot)*$/i.test(e.path)),'Original carrier extension in public data');
for(const e of publicFiles){const b=await read(root,e.path);assert(!(b[0]===77&&b[1]===90),'PE/MZ bytes embedded '+e.path);assert(!(b[0]===80&&b[1]===75),'PK/archive bytes embedded '+e.path);assert.notEqual(e.sha256,zipSha,'Source ZIP embedded publicly');}
const localCarriers=all.filter(e=>e.path.startsWith('.local/stage-carriers/'));assert.equal(localCarriers.length,12);assert(localCarriers.every(e=>e.sha256===zipSha));
// Compare to the actual authenticated executable identity, not merely its extension.
const exeSha='04d29636c393f0c1fc99ff739295494be3adefded93271e44591e8e300225a5a';assert(all.every(e=>e.sha256!==exeSha));
const originalPortable=path.join(work,'../outputs/rea-research-lab/projects/07-keepass/artifacts/portable'),originalNative=[];async function nativeInventory(relative=''){for(const e of await fs.readdir(path.join(originalPortable,relative),{withFileTypes:true})){const n=relative?relative+'/'+e.name:e.name;if(e.isDirectory())await nativeInventory(n);else{assert(e.isFile());if(/\.(exe|dll)$/i.test(n))originalNative.push(await bind(originalPortable,n));}}}await nativeInventory();assert(originalNative.some(e=>e.path==='KeePass.exe'&&e.sha256===exeSha));assert(publicFiles.every(e=>!originalNative.some(n=>n.sha256===e.sha256)));
const copyList=[...(await Promise.all(liveNames.map(n=>bind(root,n)))),...publicFiles].map(e=>({...e,targetPath:e.path,kind:e.path.startsWith(study)?'inert-evidence':'live-app-proposal'}));copyList.sort((a,b)=>a.path.localeCompare(b.path,'en'));
const copyRecord={schema:'rea-vault-history-integration-copy-list/v1',count:copyList.length,liveAppFiles:23,publicEvidenceFiles:publicFiles.length,files:copyList,localOnly:localCarriers,excludedSharedFiles:true,existingCompatibilityReceiptPreserved:true};await fs.writeFile(path.join(root,'integration-copy-list.json'),JSON.stringify(copyRecord,null,2)+'\n',{flag:'wx'});
await fs.writeFile(path.join(root,'source-preservation-mappings.json'),JSON.stringify({schema:'rea-vault-history-integration-source-copies/v1',count:sourceCopies.length,files:sourceCopies,publicRenames},null,2)+'\n',{flag:'wx'});
const beforeAfter={adapter:await authenticate(adapter,'adapter-manifest.json',expected.adapter,1600),review:await authenticate(review,'preservation-manifest.json',expected.review,87)};
const receipt={schema:'rea-vault-history-final-production-integration-bundle/v1',completed:new Date().toISOString(),productionEdited:false,newBehavioralTestsRun:0,sourceStable:true,runtimeByteIdentical:true,runtime:await Promise.all(adaptations.runtime.map(e=>bind(root,e.path))),testedAdapterReceipt:await bind(adapter,'adapter-validation.json'),testedAdapterManifest:await bind(adapter,'adapter-manifest.json'),testedFocusedReceipt:validation.focused,focusedCounts:validation.counts,authorReplayCounts:validation.additionalProbeCounts,independentReview:{artifactCount:82,receiptSha256:rp.originalReceiptSha256,manifestSha256:rp.originalManifestSha256,browserReceiptSha256:rp.originalBrowserReceiptSha256,preservationBundleManifestSha256:expected.review,reviewerOriginalExecutions:0},originalAccounting:validation.originalAccounting,candidateAccounting:validation.candidateAccounting,routes:validation.routes,old18CompatibilityReceiptSha256:validation.old18CompatibilityReceiptSha256,oldCompatibilityRebound:false,oldFrozenAdapterChanged:false,oldFrozenReviewChanged:false,copyList:await bind(root,'integration-copy-list.json'),sourceMappings:await bind(root,'source-preservation-mappings.json'),publicEvidenceFiles:publicFiles.length,liveAppFiles:23,publicLocalSegments:0,localSourceZipCarriers:localCarriers,noOriginalExecutableOrDllCarriersEmbedded:true,originalNativeArtifacts:originalNative,publicContentAudit:{files:publicFiles.length,rejectedMZAndPKPrefixes:true,rejectedExactSourceZipHash:true,rejectedExactNativeReleaseArtifactHashes:true},originalExecutableSha256:exeSha,normalTestsWriteAppResults:false,applicationImportsOriginalRuntime:false,fullProductParity:false,securityParity:false,superiority:false,assemblyOnly:'New bundle public-path/preservation mappings checked; acceptance tests retain exact old adapter source binding. Parent production tests are subsequent.',assemblyFailuresPreserved:['v1 historical schema field mismatch','v2 acquisition .bin source ZIP hash caught before freeze']};
await fs.writeFile(path.join(root,'integration-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
const files=(await inventory()).sort((a,b)=>a.path.localeCompare(b.path,'en'));await fs.writeFile(path.join(root,'integration-manifest.json'),JSON.stringify({schema:'rea-vault-history-final-integration-strict-manifest/v1',count:files.length,files,strictInventory:true,metadataExclusions:['integration-manifest.json','integration-freeze.json']},null,2)+'\n',{flag:'wx'});
const freeze={schema:'rea-vault-history-final-integration-freeze/v1',frozenAt:new Date().toISOString(),count:files.length,receipt:await bind(root,'integration-validation.json'),manifest:await bind(root,'integration-manifest.json'),copyList:await bind(root,'integration-copy-list.json'),runtimeByteIdentical:true,productionEdited:false,allSourcesDocsEvidenceFrozen:true};await fs.writeFile(path.join(root,'integration-freeze.json'),JSON.stringify(freeze,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(freeze));
