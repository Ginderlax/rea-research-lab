"""Read-only source/data inventory for a future installation architecture; no app imports."""
from pathlib import Path
import json, hashlib, subprocess

ROOT=Path(r'C:/Users/evanh/Documents/Codex/2026-10-12/go')
REPO=ROOT/'outputs/rea-research-lab'
OUT=ROOT/'work/notes36-installed-architecture-next'
OUT.mkdir(exist_ok=True)
def ident(b): return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def source(p):
    b=(REPO/p).read_bytes()
    return {'path':p,**ident(b)}
def literal(p,name):
    text=(REPO/p).read_text(encoding='utf-8-sig')
    start=text.index('=',text.index('const '+name))+1
    return json.JSONDecoder().raw_decode(text[start:].lstrip())[0]
module='scripts/editor-vault-proof-migration.mjs'
producer='scripts/verify-cloud-publication.mjs'
old=literal(module,'notesSourceTransition')
oldobjects=old['objects']
for row in oldobjects:
    assert ident((REPO/row['path']).read_bytes())==row['stored']
bundlepath='products/rea-studio/experiments/notes-new-todo/bundle.json'
bundle=json.loads((REPO/bundlepath).read_bytes())
assert len(bundle['baselineNotesSources'])==32 and len(bundle['composedNotesSources'])==36
proofgroups={
    'current36':bundle['composedNotesSources'],
    'payload17':bundle['payloads'],
    'historicalOriginalDependencies':bundle['historicalOriginalDependencies'],
    'sharedHostSources':bundle['sharedHostSources'],
    'frozenBundle':[source(bundlepath)],
    'frozenWorkflow':[bundle['workflow']],
}
proof={}
members={}
for group,rows in proofgroups.items():
    for row in rows:
        p=row['path']; expected={k:row[k] for k in ['bytes','sha256']}
        if p in proof: assert proof[p]==expected
        proof[p]=expected
        members.setdefault(p,[]).append(group)
assert len(proof)==60
for p,pin in proof.items():
    # Current app targets are prospective after images and not installed.
    target=next((r for r in bundle['transitions'] if r['path']==p),None)
    actualp=target['afterImage']['path'] if target else p
    assert ident((REPO/actualp).read_bytes())==pin
notespaths={r['path'] for r in bundle['baselineNotesSources']}
actual={p.relative_to(REPO).as_posix() for p in (REPO/'products/rea-studio/apps/notes').rglob('*') if p.is_file() and 'results' not in p.relative_to(REPO/'products/rea-studio/apps/notes').parts}
assert actual==notespaths
for row in bundle['baselineNotesSources']: assert source(row['path'])==row
oldpub=literal(producer,'NOTES_REVIEWED')
oldtools=literal(producer,'NOTES_INSTALLED_TOOLING')
assert len(oldpub)==52 and len(oldtools)==4
assert {r['path'] for r in oldobjects}==set(oldpub)
for p,pair in {**oldpub,**oldtools}.items(): assert source(p)=={'path':p,'bytes':pair[0],'sha256':pair[1]}
git=r'C:/Program Files/Git/cmd/git.exe'
head=subprocess.run([git,'rev-parse','HEAD'],cwd=REPO,check=True,capture_output=True).stdout.decode().strip()
protected=[module,producer,'scripts/publication-integrity-controls.mjs','scripts/verify-records.mjs','scripts/verify-followup-records.mjs',
 'products/rea-studio/scripts/verify-notes-installed-cloud.mjs','products/rea-studio/scripts/verify-cloud.mjs','products/rea-studio/scripts/verify-cloud-browser.mjs',
 'products/rea-studio/scripts/compose-notes-new-todo-cloud.mjs','products/rea-studio/scripts/verify-notes-new-todo-cloud.mjs',
 '.github/workflows/notes-installed-cloud.yml','.github/workflows/notes-new-todo-experiment-cloud.yml']
result={
 'schema':'rea-notes36-future-installation-source-inventory/v1','sourceOnly':True,'sourceCommit':head,
 'localActivity':{'applicationExecutions':0,'testExecutions':0,'originalExecutions':0,'browserExecutions':0,'sourceMutationInRepository':False},
 'currentInstalledNotesFiles':len(actual),'futureNotesFiles':36,'futureEligibleNotesFiles':34,
 'transitions':bundle['transitions'],'baseline32':bundle['baselineNotesSources'],'future36':bundle['composedNotesSources'],
 'fixedTests':bundle['fixedTests'],'oldNames':bundle['oldNamedGroupsRequired'],'newNames':bundle['newNamedGroupsRequired'],
 'separateComparisons':bundle['separateComparisonCounts'],
 'future60Proof':{'distinctPaths':len(proof),'rawSourceBytes':sum(r['bytes'] for r in proof.values()),'maxIndividualBytes':max(r['bytes'] for r in proof.values()),'fileLimit':64,'aggregateLimit':8*1024*1024,'individualLimit':256*1024,
   'groups':{k:{'rows':len(v),'paths':[r['path'] for r in v]} for k,v in proofgroups.items()},'rows':[{'path':p,**proof[p],'groups':members[p]} for p in sorted(proof)]},
 'legacy52Proof':{'distinctPaths':len(oldobjects),'rawStoredBytes':sum(r['stored']['bytes'] for r in oldobjects),'objects':oldobjects,'sources':old['sources'],'readerBeforeImages':old['readerBeforeImages'],'currentVerifierAfter':old['currentVerifierAfter']},
 'legacy56PublicationEnvelope':{'proofRows':52,'toolingRows':4,'rawSourceBytes':sum(v[0] for v in oldpub.values())+sum(v[0] for v in oldtools.values()),'tooling':oldtools},
 'protectedSourcePins':[source(p) for p in protected]
}
(OUT/'source-inventory.json').write_text(json.dumps(result,indent=2)+'\n',encoding='utf-8')
print(json.dumps({'sourceCommit':head,'installed':len(actual),'future':36,'future60Proof':{k:v for k,v in result['future60Proof'].items() if k not in ['groups','rows']},'proofGroupRows':{k:len(v) for k,v in proofgroups.items()},'legacy52ProofBytes':result['legacy52Proof']['rawStoredBytes'],'legacy56PublicationEnvelope':result['legacy56PublicationEnvelope'],'report':source if False else str(OUT/'source-inventory.json')},indent=2))
