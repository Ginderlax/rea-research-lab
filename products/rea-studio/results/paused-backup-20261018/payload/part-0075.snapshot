        "sha256": "a4c77de1b3e14dd2cc3fab3017051ab5602b01b90d5d7d990f7d3539c73769c8",
        "lineStart": 114,
        "lineEnd": 114,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/as-code/observability-as-code/git-sync/key-concepts.md#L114-L114"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss",
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.5ba90560c94eca0234b1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Both modes can coexist with each other and with resources that aren't managed by Git Sync.",
      "headingPath": [
        "Git Sync key concepts",
        "How does Git Sync behave?",
        "Sync targets"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/git-sync/key-concepts.md",
