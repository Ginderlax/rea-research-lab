      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.2ad7bc8272882bcb7091",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This section includes information for Grafana administrators, team administrators, and users performing administrative tasks:",
