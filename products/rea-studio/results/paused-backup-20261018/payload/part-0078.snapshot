    {
      "id": "grafana.candidate.b36a97e7b35da3a3dd54",
      "syntaxRole": "list-item",
      "sourceText": "- **No data responses**: If a query returns no rows, the SQL expression engine cannot infer a schema.",
      "headingPath": [
        "SQL expressions",
        "Known limitations",
        "Schema changes and missing data"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/sql-expressions/index.md",
