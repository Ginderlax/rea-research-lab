    {
      "id": "grafana.candidate.48168a118e6c513a168c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Instruct headless browser instance whether to ignore HTTPS errors during navigation. Per default HTTPS errors are not ignored. Due to the security risk, we do not recommend that you ignore HTTPS errors.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[plugin.grafana-image-renderer]`",
