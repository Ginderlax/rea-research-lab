      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.289bffa15fa4ec72393f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This value is `true` by default.",
      "headingPath": [
        "Configure Grafana Enterprise",
        "[caching]",
        "enabled"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md",
        "gitBlobSha": "51174e643296aefdf7f2a277d5fe604eeb1d2300",
        "sha256": "43ec22c446ce6485d8d3dc90918a7efc784c7b19118c82019ee5ab6cb8881586",
        "lineStart": 468,
        "lineEnd": 468,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md#L468-L468"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.9f9115b68cfe4e4f373c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This setting enables the caching feature, but it does not turn on query caching for any data source. To turn on query caching for a data source, update the setting on the data source configuration page. For more information, refer to the [query caching docs](../../../administration/data-source-management/#enable-and-configure-query-caching).",
      "headingPath": [
        "Configure Grafana Enterprise",
        "[caching]",
        "enabled"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md",
        "gitBlobSha": "51174e643296aefdf7f2a277d5fe604eeb1d2300",
        "sha256": "43ec22c446ce6485d8d3dc90918a7efc784c7b19118c82019ee5ab6cb8881586",
        "lineStart": 471,
        "lineEnd": 471,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md#L471-L471"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.1c232b0a1923e2ea7f59",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "_Time to live_ (TTL) is the time that a query result is stored in the caching system before it is deleted or refreshed. This setting defines the time to live for query caching, when TTL is not configured in data source settings. The default value is `1m` (1 minute).",
      "headingPath": [
        "Configure Grafana Enterprise",
        "[caching]",
        "ttl"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md",
        "gitBlobSha": "51174e643296aefdf7f2a277d5fe604eeb1d2300",
        "sha256": "43ec22c446ce6485d8d3dc90918a7efc784c7b19118c82019ee5ab6cb8881586",
        "lineStart": 476,
        "lineEnd": 476,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md#L476-L476"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.98f68e3542110094cecd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The max duration that a query result is stored in the caching system before it is deleted or refreshed. This value will override `ttl` config option or data source setting if the `ttl` value is greater than `max_ttl`. To disable this constraint, set this value to `0s`.",
      "headingPath": [
        "Configure Grafana Enterprise",
        "[caching]",
        "max_ttl"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md",
        "gitBlobSha": "51174e643296aefdf7f2a277d5fe604eeb1d2300",
        "sha256": "43ec22c446ce6485d8d3dc90918a7efc784c7b19118c82019ee5ab6cb8881586",
        "lineStart": 480,
        "lineEnd": 480,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md#L480-L480"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.914e8f6ba16228253aef",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The default is `0s` (disabled).",
      "headingPath": [
        "Configure Grafana Enterprise",
        "[caching]",
        "max_ttl"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md",
