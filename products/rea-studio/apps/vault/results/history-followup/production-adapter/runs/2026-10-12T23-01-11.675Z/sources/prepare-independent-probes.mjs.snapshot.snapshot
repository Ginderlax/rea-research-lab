import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
const root=import.meta.dirname,source=path.resolve(root,'../keepass-history-draft-independent-review'),sha=b=>createHash('sha256').update(b).digest('hex'),runBytes=await fs.readFile(path.join(source,'runs/final-independent/validation.json')),run=JSON.parse(runBytes);assert.equal(run.counts.tests,11);assert.equal(run.counts.pass,11);assert.equal(run.sourceStable,true);const records=[];for(const e of run.inputs){const b=await fs.readFile(path.join(source,e.path));assert.equal(sha(b),e.sha256,e.path);const target=path.join(root,'independent-source-inputs',e.path+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b);records.push({path:e.path,bytes:b.length,sha256:e.sha256});if(e.path!=='run-final.mjs'){const live=path.join(root,'independent-probes',e.path);await fs.mkdir(path.dirname(live),{recursive:true});await fs.writeFile(live,b);}}
await fs.writeFile(path.join(root,'independent-source-inputs/run-validation.json.snapshot'),runBytes);const adaptations=[];async function adapt(file,substitutions){const target=path.join(root,'independent-probes',file),before=await fs.readFile(target,'utf8');let after=before;for(const [from,to]of substitutions){assert.ok(after.includes(from));after=after.replaceAll(from,to);}await fs.writeFile(target,after);adaptations.push({path:'independent-probes/'+file,originalSha256:sha(before),newSha256:sha(after),changes:substitutions.map(([from,to])=>({from,to})),scenarioBodiesUnchanged:true});}
await adapt('restore-selection.test.mjs',[["../keepass-history-draft-fix-next/client.mjs","../products/rea-studio/apps/vault/client.mjs"],["../keepass-history-draft-fix-next/server.mjs","../products/rea-studio/apps/vault/server.mjs"],["path.join(own,'restore-selection-observation.json')","path.join(own,'.local/restore-selection-observation.json')"]]);
await adapt('ui-fixture.mjs',[["path.join(own,'../keepass-history-selection-fix-next')","path.join(own,'../products/rea-studio/apps/vault')"],["path.join(own,'boundary-observations')","path.join(own,'../.local/independent-observations')"]]);await adapt('timer/ui-fixture.mjs',[["path.join(own,'../../keepass-history-draft-fix-next')","path.join(own,'../../products/rea-studio/apps/vault')"],["path.join(own,'boundary-observations')","path.join(own,'../../.local/independent-observations')"]]);
await fs.mkdir(path.join(root,'independent-probes/.local'),{recursive:true});await fs.writeFile(path.join(root,'independent-probe-provenance.json'),JSON.stringify({schema:'rea-vault-production-adapter-independent-probes/v1',sourceReviewRunSha256:sha(runBytes),historicalIndependentRunCounts:run.counts,sourceReview:'keepass-history-draft-independent-review/runs/final-independent',originalInputs:records,adaptations,productionEdited:false,behavioralBodiesUnchanged:true,newIndependentAuthor:false},null,2)+'\n');
