    },
    {
      "id": "grafana.candidate.db83c4623b2ab5dc4299",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Path to where Grafana stores the sqlite3 database (if used), file-based sessions (if used), and other data. This path is usually specified via command line in the init.d script or the systemd service file.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[paths]`",
        "`data`"
      ],
      "source": {
