    {
      "id": "grafana.candidate.f33f33a11018529feebb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Optional settings to set different levels for specific loggers. For example: `filters = sqlstore:debug`",
      "headingPath": [
