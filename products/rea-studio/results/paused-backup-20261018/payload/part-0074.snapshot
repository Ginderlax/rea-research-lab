    {
      "id": "grafana.candidate.d8136e6b2109363cb9d3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Once saved, the new recording metric is available for use in dashboards and alert rules.",
      "headingPath": [
        "Create data source-managed recording rules",
        "Query the new metric in dashboards or alert rules"
      ],
      "source": {
