    {
      "id": "grafana.candidate.d589676b91cb0d944dce",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you invite users to join an organization, you assign the **Admin**, **Editor**, or **Viewer** role, or select **No basic role**. Organization roles control user access to resources, such as dashboards and data sources, owned by the organization. Users receive an email that prompts them to accept the invitation.",
      "headingPath": [
        "Manage users in an organization",
        "Invite a user to join an organization"
      ],
