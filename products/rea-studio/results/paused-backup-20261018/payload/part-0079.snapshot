    {
      "id": "grafana.candidate.3fefe107e490ddf28c99",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Starting with Grafana v11.0, you can enable an opinionated strong password policy feature. This configuration option validates all password updates to comply with our strong password policy.",
      "headingPath": [
        "What’s new in Grafana v11.0",
        "Authentication and authorization",
        "New strong password policy"
      ],
