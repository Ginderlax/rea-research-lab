    {
      "id": "grafana.candidate.75f80a5456420b1bd769",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Database:** SQLite isn't recommended for production environments and isn't suitable at this tier. Use an external MySQL or PostgreSQL database. Refer to [Supported databases](#supported-databases) for guidance on choosing an external database.",
      "headingPath": [
        "Install Grafana",
        "Hardware recommendations",
        "Deployment tiers",
        "Medium"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/installation/_index.md",
