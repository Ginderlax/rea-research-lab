    },
    {
      "id": "grafana.candidate.1d5b711fe168f6de4605",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you have an existing Alertmanager running in your infrastructure, you can use a contact point to forward Grafana alerts to your Alertmanager.",
      "headingPath": [
        "Configure an Alertmanager contact point"
      ],
      "source": {
        "path": "docs/sources/alerting/configure-notifications/manage-contact-points/integrations/configure-alertmanager.md",
        "gitBlobSha": "f611d16fb37cd30657c1aa0bafc00f1ffd6f54dc",
        "sha256": "6aa704a54a9535818a9d7937d0112bc398465c81d2d21037bae9dd550e059737",
        "lineStart": 34,
        "lineEnd": 34,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/configure-notifications/manage-contact-points/integrations/configure-alertmanager.md#L34-L34"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.45098ce4f45b7f17456f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For example, a team might run its own Alertmanager to manage notifications from other alerting systems. That team can create alerts with Grafana and configure an Alertmanager contact point to forward only their alerts to their existing Alertmanager.",
      "headingPath": [
        "Configure an Alertmanager contact point"
      ],
      "source": {
        "path": "docs/sources/alerting/configure-notifications/manage-contact-points/integrations/configure-alertmanager.md",
        "gitBlobSha": "f611d16fb37cd30657c1aa0bafc00f1ffd6f54dc",
