    {
      "id": "grafana.candidate.179bfb91e22de889c6c4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Imagine you are managing a web application or a fleet of servers, tracking critical metrics such as CPU, memory, and disk usage. While monitoring is essential, managing alerts allows your team to act on issues without necessarily feeling overwhelmed by the noise.",
      "headingPath": [],
      "source": {
        "path": "docs/sources/tutorials/alerting-get-started-pt5/index.md",
