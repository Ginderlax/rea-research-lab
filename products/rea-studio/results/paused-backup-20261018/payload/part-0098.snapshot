    assert all(attempt[k] == 0 for k in ('retries', 'originalProductExecutions')) and attempt['workers'] == 1
    assert len(attempt['children']) == 1
    child = attempt['children'][0]
    assert child['label'] == 'eight-real-notes-browser-scenarios' and child['exitCode'] == 0 and child['closeObserved'] is True
    assert child['signal'] is None and child['stopReason'] is None
    acquisition = load('browser-tooling-acquisition.json')
