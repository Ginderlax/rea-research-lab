const here=import.meta.dirname,sha=bytes=>createHash('sha256').update(bytes).digest('hex'),fp=async file=>{const bytes=await fs.readFile(file);return{bytes:bytes.length,sha256:sha(bytes)};},sources=[['editor-search-path-fix-next','d071d370be094646a4738de79adadca9c28d794de53dfb940604f5d52d056edf',126],['editor-save-independent-review','0fba64bafa48e5235635951f50b17e22d6767e43d8e62836faf1f35d7e6b69fa',166],['editor-save-revision-independent-review','b1c3146a795e766f00b5d36dd9237ebb883a866a5d03678a4022254060b6e4c9',26]],bindings=[];
for(const [name,digest,count]of sources){const root=path.resolve(here,'../'+name),bytes=await fs.readFile(path.join(root,'freeze-manifest.json')),manifest=JSON.parse(bytes);assert.equal(sha(bytes),digest);assert.equal(Object.keys(manifest.inventory).length,count);for(const [name,row]of Object.entries(manifest.inventory))assert.deepEqual(await fp(path.join(root,name)),row);bindings.push({stage:name,manifestSHA256:digest,files:count,root,inventory:manifest.inventory});}
