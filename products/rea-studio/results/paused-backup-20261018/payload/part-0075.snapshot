    {
      "id": "grafana.candidate.45f0524026fcc34a9f92",
      "syntaxRole": "procedural-step",
      "sourceText": "2. **Alert rule → Prometheus ← Target**",
      "headingPath": [
        "Handle connectivity errors in alerts",
        "Understand connectivity issues in alerts"
      ],
      "source": {
        "path": "docs/sources/alerting/guides/connectivity-errors.md",
        "gitBlobSha": "ac013ad7e78eb6f989a82991e5d246600a3e436d",
        "sha256": "a3943a943a9907ac7c1b3b13ba6b8f1519bbda6b9a19cf01591f2ade20d35b63",
        "lineStart": 80,
        "lineEnd": 80,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/guides/connectivity-errors.md#L80-L80"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
