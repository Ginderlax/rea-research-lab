for(let offset=0;offset+512<=tar.length;){const h=tar.subarray(offset,offset+512);if(h.every(v=>v===0))break;const name=h.subarray(0,100).toString().split('\0')[0],size=Number.parseInt(h.subarray(124,136).toString().replace(/\0/g,'').trim(),8);assert.ok(Number.isSafeInteger(size)&&size>=0&&offset+512+size<=tar.length);if(name==='package/LICENSE')dependencyLicense=tar.subarray(offset+512,offset+512+size);offset+=512+Math.ceil(size/512)*512;}
assert.ok(dependencyLicense);snapshots.push(store(dependencyLicense,'licenses/LODASH-LICENSE','authenticated lodash-4.17.23.tgz package/LICENSE'));
