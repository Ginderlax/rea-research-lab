    {
      "id": "grafana.candidate.357d73c78d93b27fd0ad",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For recent releases of Grafana, there are also `minor` version tags in the `grafana/grafana` and `grafana/grafana-enterprise` docker repositories. For example, if you want to always have the latest `12.1` version, you can use `grafana/grafana-enterprise:12.1` or `grafana/grafana-enterprise:12.1-ubuntu`.",
      "headingPath": [
