import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { createRequire } from 'node:module';
import { pathToFileURL } from 'node:url';
import { join } from 'node:path';
import { performance } from 'node:perf_hooks';
const lab='C:/Users/evanh/Documents/Codex/2026-10-12/go/outputs/rea-research-lab', app=join(lab,'products/rea-studio/apps/metrics');
const sha=bytes=>createHash('sha256').update(bytes).digest('hex');
const [implementation,caseName,candidatePath]=process.argv.slice(2);
const sources=JSON.parse(readFileSync(join(app,'fixtures/reducers/sources.json'),'utf8'));
const originalRoot=join(lab,'projects/02-grafana/artifacts');
assert.equal(sha(readFileSync(join(originalRoot,'release.tgz'))),sources.archiveSha256);
const originalPath=join(originalRoot,'package/dist/cjs/transformations/fieldReducer.cjs');
for(const source of sources.sources.filter(row=>!row.path.startsWith('docs/')))assert.equal(sha(readFileSync(join(originalRoot,'package',source.path))),source.sha256);
assert.equal(sha(readFileSync(join(originalRoot,'lodash-4.17.23.tgz'))),sources.oracleDependency.sha256);
const require=createRequire(originalPath);assert.equal(require.resolve('lodash'),join(originalRoot,'node_modules/lodash/lodash.js'));
const native=await import(pathToFileURL(candidatePath??join(app,'native-calculations.mjs')).href);
const original=require(originalPath);
const all=native.calculationDefinitions.map(row=>row.id),percentiles=all.filter(id=>/^p\d+$/.test(id));
const cases={smallStandard:{n:100,reducers:['mean','min','max','sum','delta'],iterations:2000},largeStandard:{n:25000,reducers:['mean','min','max','sum','delta'],iterations:100},singlePercentile:{n:25000,reducers:['p95'],iterations:10},allPercentiles:{n:25000,reducers:percentiles,iterations:2},allCalculations:{n:25000,reducers:all,iterations:2}};
const specification=cases[caseName]; assert.ok(specification);
const values=Array.from({length:specification.n},(_,i)=>i%23===0?null:((i*7879)%7919)-3959.25);
const field=()=>({name:'synthetic',type:'number',config:{nullValueMode:'connected'},values,state:{}});
const expected=original.reduceField({field:field(),reducers:specification.reducers});
assert.deepEqual(native.reduceField({field:field(),reducers:specification.reducers}),expected);
const fn=implementation==='original'?original.reduceField:native.reduceField;
for(let i=0;i<3;i++)fn({field:field(),reducers:specification.reducers});
global.gc?.();
const beforeMemory=process.memoryUsage(),beforeCpu=process.cpuUsage(),start=performance.now();let actual;
for(let i=0;i<specification.iterations;i++)actual=fn({field:field(),reducers:specification.reducers});
const elapsedMilliseconds=performance.now()-start,cpu=process.cpuUsage(beforeCpu),afterMemory=process.memoryUsage();
assert.deepEqual(actual,expected);
console.log(JSON.stringify({implementation,caseName,iterations:specification.iterations,samples:values.length,selectionCount:specification.reducers.length,elapsedMilliseconds,millisecondsPerCall:elapsedMilliseconds/specification.iterations,cpuMicroseconds:cpu.user+cpu.system,beforeMemory,afterMemory,peakResidentKiB:process.resourceUsage().maxRSS,exactOutputEqual:true,inputSha256:sha(Buffer.from(JSON.stringify(values))),outputSha256:sha(Buffer.from(JSON.stringify(expected))),candidateSha256:sha(readFileSync(candidatePath??join(app,'native-calculations.mjs')))}));
