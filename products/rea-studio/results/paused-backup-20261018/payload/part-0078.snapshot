    {
      "id": "grafana.candidate.8aaa15ea6b4df529cd1d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To display timestamps that are in seconds since epoch, multiply your timestamp values by 1000 using a transformation following these steps:",
      "headingPath": [
        "Configure standard options",
        "Standard options",
        "Unit",
        "Custom units",
        "Time format units"
