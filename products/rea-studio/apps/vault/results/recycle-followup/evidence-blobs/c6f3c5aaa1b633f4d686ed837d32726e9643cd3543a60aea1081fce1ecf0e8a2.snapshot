import test from 'node:test';import assert from 'node:assert/strict';import {fixture,trashA,button,field,descendants}from'./ui-helper.mjs';
for(const operation of ['restore','purge'])test('unchecked '+operation+' confirmation refuses mutation and leaves current bin preview usable',async t=>{const f=await fixture(t,'unchecked-'+operation);await trashA(f.root);const before=f.store.value;await button(f.root,operation==='restore'?'Restore recycled entry':'Permanently delete recycled entry').click();assert.deepEqual(f.store.value,before);assert.equal((await f.call('recycleList')).entries.length,1);await button(f.root,'Preview recycled entry').click();assert.equal(field(f.root,'Recycled password').value,'A-owned-secret');assert.equal(field(f.root,'Recycled password').readOnly,true);assert.equal(descendants(f.root).some(n=>n.textContent==='Close recycle bin'),true);f.observe.refusedWithoutStateMutation=true;});
