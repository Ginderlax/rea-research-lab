let inverse=beforeWorking;for(const e of [...edits].reverse()){assert.equal(inverse.split(e.after).length-1,1,e.after);inverse=inverse.replace(e.after,e.before);}assert.equal(inverse,before);await fs.writeFile(file,beforeWorking);await fs.writeFile(path.join(own,'client-transformation.json'),JSON.stringify({schema:'rea-flow-native-source-aware-client-correction/v1',before:{bytes:Buffer.byteLength(before),sha256:sha(before)},after:{bytes:Buffer.byteLength(beforeWorking),sha256:sha(beforeWorking)},edits,inverseExact:true,scope:'Native view only. Raw decoded backing, HTML CR-only comparison, source-aware captured Save/Export/Import/validation/node/link publication and disposal. Static compiler/runtime/server/shared host unchanged.'},null,2)+'\n');console.log(JSON.stringify({edits:edits.length,clientBytes:Buffer.byteLength(beforeWorking),clientSHA256:sha(beforeWorking),inverseExact:true}));
