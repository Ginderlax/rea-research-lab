    {
      "id": "grafana.candidate.7b1922f5784778029421",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The URL the user is redirected to upon signing out. To support [OpenID Connect RP-Initiated Logout](https://openid.net/specs/openid-connect-rpinitiated-1_0.html), the user must add `post_logout_redirect_uri` to the `signout_redirect_url`.",
