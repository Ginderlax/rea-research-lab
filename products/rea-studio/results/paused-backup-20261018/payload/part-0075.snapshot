        "lineStart": 164,
        "lineEnd": 164,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/as-code/infrastructure-as-code/terraform/terraform-secrets-management.md#L164-L164"
      },
      "applicability": {
