    {
      "id": "grafana.candidate.97859dcaebeba26bfe8f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The `grafana-cli` and `grafana-server` commands, deprecated since Grafana v10.0, are removed in Grafana v13.0. Update any scripts, systemd units, Docker entrypoints, CI pipelines, or other automation to use `grafana cli` and `grafana server` instead.",
      "headingPath": [
        "Upgrade to Grafana v13.0",
        "Technical notes",
        "Removal of `grafana-cli` and `grafana-server` commands"
      ],
      "source": {
