}
function command(){assertHosted();const args=process.argv.slice(2);assert.equal(args.length,4);assert.equal(args[0],'--phase');assert(['compose','postcheck'].includes(args[1]));assert.equal(args[2],'--evidence');const root=ownedEvidence(args[3]),post=args[1]==='postcheck',name=post?'notes-new-todo-postrun-source-check.json':'notes-new-todo-composition.json';let result={schema:post?'rea-Notes-new-todo-postrun-source-check/v1':'rea-Notes-new-todo-composition/v1',status:'failed',execution:execution(),sourceCommit:process.env.GITHUB_SHA,productionInstalled:false,historicalReceiptsRebound:false,applicationExecutions:0,originalExecutions:0,browserExecutions:0,fullParity:false,superiority:false};try{if(!post)result=compose(root);else{const value=readComposition(root);result={...result,status:'source-verified',compositionReceipt:value.receipt,currentSources:value.current.currentSources,sourceStable:true,sourceAuthentication:authenticateCensus(activeCensus(),value.bundle,true),proofReadFiles:value.current.readFiles,proofReadBytes:value.current.readBytes};}}catch(error){result.failure={name:error.name,message:error.message};process.exitCode=1;}saveJSON(root,name,result);console.log(JSON.stringify({phase:args[1],status:result.status,sourceCommit:result.sourceCommit}));}
