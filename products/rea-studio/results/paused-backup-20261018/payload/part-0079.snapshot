    {
      "id": "grafana.candidate.a5295c70df0f2d490963",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We’ve made stability and usability improvements to Recorded Queries, and removed the feature flag so you can get started with Recorded Queries out of the box.",
      "headingPath": [
        "What's new in Grafana v8.4",
        "Grafana Enterprise",
        "Performance improvements",
        "Recorded queries is more stable and usable"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-4.md",
        "gitBlobSha": "252f5beb8e3fcec627862bf9d7133a82ac790f48",
        "sha256": "698f50f998678faa1ffd85c3becf29427f209d103b67f78883e8ff9c47004eec",
        "lineStart": 145,
        "lineEnd": 145,
