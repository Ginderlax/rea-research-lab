import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const here=import.meta.dirname,work=path.resolve(here,'..'),stage=path.join(work,'vault-group-edit-next'),review=path.join(work,'vault-group-edit-independent-review'),repo=path.resolve(work,'../outputs/rea-research-lab'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),json=v=>Buffer.from(JSON.stringify(v,null,2)+'\n');
async function save(p,b){await fs.mkdir(path.dirname(path.join(here,p)),{recursive:true});await fs.writeFile(path.join(here,p),b,{flag:'wx'});}
async function auth(root,file,pin,count){const raw=await fs.readFile(path.join(root,file));assert.equal(id(raw).sha256,pin);const m=JSON.parse(raw);assert.equal(m.inventory.length,count);for(const r of m.inventory)assert.deepEqual(id(await fs.readFile(path.join(root,r.path))),{bytes:r.bytes,sha256:r.sha256});return{raw,m};}
const original=await auth(stage,'manifest.json','52a88d027dc910c3ef8723e80690aef98dacdc9c98d43902192663ca43799ff4',885),negative=await auth(review,'review-manifest.json','65dbe05edf39e3625833f828fcad760b577d6fb0f3c4b6d8826379b6b1dbbc93',78);
await save('authority/original885-manifest.json.snapshot',original.raw);await save('authority/independent78-manifest.json.snapshot',negative.raw);await save('authority/independent78-review-validation.json.snapshot',await fs.readFile(path.join(review,'review-validation.json')));await save('authority/independent78-finding.json.snapshot',await fs.readFile(path.join(review,'finding.json')));
const copied=[];for(const row of original.m.inventory.filter(r=>r.path.startsWith('products/')||r.path.startsWith('source-study/'))){const b=await fs.readFile(path.join(stage,row.path));await save(row.path,b);copied.push(row);}await save('source-study.json',await fs.readFile(path.join(stage,'source-study.json')));
const p='products/rea-studio/apps/vault/client.mjs',before=await fs.readFile(path.join(stage,p));assert.deepEqual(id(before),{bytes:29809,sha256:'d706e9a91f784d6ba6473f542a221749186caade8523d318580eef1d263d7a4f'});await save('authority/client885.mjs.snapshot',before);let text=before.toString();const deltas=[];
for(const[label,a,b]of[
 ['Allow a private already-fetched group list to be rendered without a second await','async function groupList(bin=false,internal=false){','async function groupList(bin=false,internal=false,loaded=null){'],
 ['Keep normal list reads unchanged; only the acknowledged mutation path supplies the loaded value',"const request=++groupGeneration,value=await api('recycleGroupList',{bin});","const request=++groupGeneration,value=loaded??await api('recycleGroupList',{bin});"],
 ['Await the final list while the group form remains current, then check both current generation and signature',"if(signature()!==submittedSignature){const fresh=await api('recycleGroupList',{bin:false});if(!operationCurrent())return;const saved=fresh.groups.find(g=>g.id===result.id);","const fresh=await api('recycleGroupList',{bin:false});if(!operationCurrent())return;\n              if(signature()!==submittedSignature){const saved=fresh.groups.find(g=>g.id===result.id);"],
 ['Only replace an unchanged acknowledged form from the already-fetched list',"await groupList(false,true);if(viewCurrent())status.textContent=result.created?'Group created.':'Group details saved.';","await groupList(false,true,fresh);if(viewCurrent())status.textContent=result.created?'Group created.':'Group details saved.';"],
 ]){assert.equal(text.split(a).length-1,1,label);const beforeStep=id(Buffer.from(text));text=text.replace(a,b);deltas.push({label,before:a,after:b,beforeIdentity:beforeStep,afterIdentity:id(Buffer.from(text)),occurrences:1});}
const after=Buffer.from(text);await fs.writeFile(path.join(here,p),after);let inverse=text;for(const d of[...deltas].reverse()){assert.equal(inverse.split(d.after).length-1,1);inverse=inverse.replace(d.after,d.before);}assert(Buffer.from(inverse).equals(before));await save('client-deltas.json',json({scope:'Private client publication correction only',deltas,inverseExact:true,before:id(before),after:id(after)}));
const replayNames=['draft-boundaries.test.mjs','adjacent.test.mjs','ui-fixture.mjs'];const adapters=[];for(const name of replayNames){const b=await fs.readFile(path.join(review,name));let t=b.toString();if(name==='ui-fixture.mjs'){const a='../vault-group-edit-next/products/rea-studio/apps/vault/',replacement='../products/rea-studio/apps/vault/';assert.equal(t.split(a).length-1,4);t=t.replaceAll(a,replacement);}const out=Buffer.from(t);await save('regression/'+name,out);adapters.push({path:name,before:id(b),after:id(out),changes:name==='ui-fixture.mjs'?'Four runtime/fixture import paths only':'Byte-identical test bodies'});}await save('replay-adapters.json',json({sourceReviewManifest:negative.raw.length,rows:adapters,caseBodiesChanged:false,initial11BodiesRetained:true}));
const liveBefore=id(await fs.readFile(path.join(repo,p)));await save('production-client-before.json',json({path:p,...liveBefore,readOnly:true,installedProductionNotModified:true}));await save('copied-source-roster.json',json(copied));
await save('client-overlay-proposal.json',json({schema:'rea-vault-group-edit-client-correction-overlay/v1',target:p,source:p,before885:id(before),after:id(after),beforeInstalledProduction:liveBefore,supersedesOnly885Client:true,backendUnchanged:true,rootOwnsFullGroupEditInstallation:true,productionWrites:0}));
await auth(stage,'manifest.json','52a88d027dc910c3ef8723e80690aef98dacdc9c98d43902192663ca43799ff4',885);await auth(review,'review-manifest.json','65dbe05edf39e3625833f828fcad760b577d6fb0f3c4b6d8826379b6b1dbbc93',78);process.stdout.write(JSON.stringify({prepared:true,copied:copied.length,clientBefore:id(before),clientAfter:id(after),substitutions:4,inverseExact:true,old885And78Exact:true,productionWrites:0})+'\n');
