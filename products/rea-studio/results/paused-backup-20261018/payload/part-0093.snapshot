assert(/^\d{8,12}$/.test(run) && /^\d{8,12}$/.test(artifact));
assert(/^[0-9a-f]{40}$/.test(expectedHead));
assert.equal(run, '38922041634'); assert.equal(artifact, '12055985724'); assert.equal(expectedHead, '25b54d733ad6fd59a0b0d2a28fad3d6fa014700a');
const derivedNames = ['PUBLICATION-MANIFEST.json', 'VALIDATION.json'];
const id = bytes => ({ bytes: bytes.length, sha256: createHash('sha256').update(bytes).digest('hex') });
const git = (...args) => execFileSync('git', ['-C', lab, ...args], { encoding: 'utf8', maxBuffer: 1024 * 1024 }).trim();
function safeRead(root, name, limit = 16 * 1024 * 1024) {
  assert(name && !/[\\:\x00-\x1f\x7f]/.test(name));
  let target = root;
  for (const part of name.split('/')) {
    assert(part && part !== '.' && part !== '..');
    target = path.join(target, part);
    assert(!fs.lstatSync(target).isSymbolicLink());
  }
  const stat = fs.lstatSync(target);
  assert(stat.isFile() && stat.size <= limit);
  const bytes = fs.readFileSync(target);
  assert.equal(bytes.length, stat.size);
  return bytes;
}
