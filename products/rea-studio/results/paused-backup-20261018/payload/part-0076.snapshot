    {
      "id": "grafana.candidate.503a06b665c8fb27fd98",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The standalone plugin requires Grafana 12.3.0 or later. The MySQL data source bundled with Grafana 13.1 and earlier continues to work as before. These versions are unaffected by the change.",
      "headingPath": [
        "MySQL data source",
        "Plugin updates"
      ],
      "source": {
        "path": "docs/sources/datasources/mysql/_index.md",
