        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.ee62dce5b6fcd8a80262",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can also resolve the name of the Monitored Resource Type with the `resource.type` alias.",
      "headingPath": [
        "Google Cloud Monitoring query editor",
        "Query metrics",
        "Set alias patterns",
        "Alias pattern examples"
      ],
      "source": {
        "path": "docs/sources/datasources/google-cloud-monitoring/query-editor/index.md",
        "gitBlobSha": "35f2bbc8926a6d131f4d3cbcb6a6184dabccd704",
        "sha256": "5bd24c0a5753f11d9c5d6296eadff38bbc9734793a5e4cc55da2cb6fe1d87ef1",
        "lineStart": 186,
        "lineEnd": 186,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/google-cloud-monitoring/query-editor/index.md#L186-L186"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
