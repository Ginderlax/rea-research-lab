    },
    {
      "id": "grafana.candidate.1864e23ee8b8f1bdb2ef",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The following example allows access to all plugins that have a backend:",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[security]`",
        "`actions_allow_post_url`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
