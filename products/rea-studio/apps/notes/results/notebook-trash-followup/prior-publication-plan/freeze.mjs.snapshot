import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
const root=import.meta.dirname,go=path.resolve(root,'../..'),work=path.dirname(root),sha=b=>createHash('sha256').update(b).digest('hex');
async function fp(p){const b=await fs.readFile(path.join(root,p));return{path:p,bytes:b.length,sha256:sha(b)};}
async function walk(d,p=''){const a=[];for(const e of await fs.readdir(path.join(d,p),{withFileTypes:true})){const f=(p?p+'/':'')+e.name;if(e.isSymbolicLink())throw new Error('Symlink');if(e.isDirectory())a.push(...await walk(d,f));else a.push(f);}return a.sort();}
const refs=JSON.parse(await fs.readFile(path.join(root,'references.json'))),map=JSON.parse(await fs.readFile(path.join(root,'public-preservation-map.json'))),ex=JSON.parse(await fs.readFile(path.join(root,'local-exclusions.json'))),live=JSON.parse(await fs.readFile(path.join(root,'live-copy-list.json')));
for(const r of refs.references){const folder=path.join(work,r.folder),m=await fs.readFile(path.join(folder,r.manifest));if(sha(m)!==r.manifestSha256)throw new Error('Reference manifest changed');const parsed=JSON.parse(m),rows=parsed.records??parsed.files;if(rows.length!==r.count)throw new Error('Count');for(const row of rows){const b=await fs.readFile(path.join(folder,row.path));if(b.length!==row.bytes||sha(b)!==row.sha256)throw new Error('Reference changed');}}
for(const r of map.records){const b=await fs.readFile(path.join(go,r.sourceRoot,r.sourcePath));if(b.length!==r.bytes||sha(b)!==r.sha256)throw new Error('Mapped source changed');if(r.destination.split('/').includes('.local'))throw new Error('Private public path');}
const adaptations=[];
for(const r of live.proposals){const original=await fs.readFile(path.join(go,r.source)),proposed=await fs.readFile(path.join(root,r.proposalPath));if(original.length!==r.sourceBytes||sha(original)!==r.sourceSha256||proposed.length!==r.proposedBytes||sha(proposed)!==r.proposedSha256)throw new Error('Live source mismatch');const a=original.toString(),b=proposed.toString();let expected=a;
 if(r.destination.endsWith('notebook-original-oracle.mjs')||r.destination.endsWith('notebook-trash-original-oracle.mjs'))expected=a.replace("new URL('../../../../',import.meta.url)","new URL('./results/notebook-trash-followup/stage/',import.meta.url)").replaceAll("new URL('prior-source-provenance.json',root)","new URL('prior-source-provenance.json.snapshot',root)").replaceAll("new URL('license-and-special-id-provenance.json',root)","new URL('license-and-special-id-provenance.json.snapshot',root)").replace("['prior-source-provenance.json','trash-source-provenance.json']","['prior-source-provenance.json.snapshot','trash-source-provenance.json.snapshot']").replaceAll('new URL(record.path,root)',"new URL(record.path+'.snapshot',root)").replaceAll('new URL(special.path,root)',"new URL(special.path+'.snapshot',root)");
 else if(r.destination==='apps/notes/notebook-trash.test.mjs')expected=a.replace("'../../../../.local/observations/'","'../../.local/notes-notebook-trash-observations/'");
 else if(r.destination.includes('notebook-trash-review')||r.destination.includes('notebook-trash-publication-boundaries')||r.destination.includes('notebook-trash-fresh-boundaries'))expected=a.replaceAll('../../notes-trash-publication-fix-next/products/rea-studio/apps/notes/','./').replaceAll('../products/rea-studio/apps/notes/','./').replaceAll("'./ui-fixture.mjs'","'./notebook-trash-review-fixture.mjs'").replaceAll("process.env.NOTES_REVIEW_OUTPUT??'./observations/'","process.env.NOTES_REVIEW_OUTPUT??'../../.local/notes-notebook-trash-observations/'").replaceAll("process.env.NOTES_REVIEW_OUTPUT??'../.local/observations/'","process.env.NOTES_REVIEW_OUTPUT??'../../.local/notes-notebook-trash-observations/'");
 if(!r.destination.endsWith('README.md')&&expected!==b)throw new Error('Non-path code change '+r.destination);
 adaptations.push({destination:r.destination,pathOnlyCodeAdaptationAuthenticated:!r.destination.endsWith('README.md'),runtimeExact:['client.mjs','server.mjs','notebook-trash.mjs'].some(n=>r.destination==='apps/notes/'+n)?original.equals(proposed):undefined,sha256:sha(proposed)});
}
const registry=JSON.parse(await fs.readFile(path.join(root,'registry-identity-binding.json')));if(registry.sourceFingerprints!==159||registry.capabilityIDs!==232)throw new Error('Identity count');
const receipt={schema:'rea-notes-trash-publication-plan-validation/v1',at:new Date().toISOString(),sourceOnly:true,productionModified:false,originalExecutions:0,tests:0,hosts:0,browserActions:0,references:refs.references,originalStrictArtifacts:927,selfManifestFreezeCarriers:8,inspectedFiles:935,publicPreservationFiles:920,localNativeArchiveCopies:15,uniqueExcludedNativeArchiveHashes:[...new Set(ex.excluded.map(r=>r.sha256))],unmanifestedGeneratedPrivateFiles:4,publicNativeExecutableLibraryDatabaseArchiveCarriers:0,wholeTreePublic:false,allSourcesExact:true,liveFiles:13,adaptations,prospectiveCurrentLayoutTests:73,executedCurrentLayoutTests:0,registrySourceIdentities:159,registryCapabilityIDs:232,priorRegistryProvenanceRebound:false,nativeConfirmationBrowserAcceptance:'incomplete; tool focus/dialog control blocked, no backend trash request; owned Chrome closure unconfirmed',ownedHostsRunning:0,scope:'Finite source-only proposal; no runtime validation of adapted bytes. Root installs and verifies current-layout tests and real UI separately.'};
await fs.writeFile(path.join(root,'validation.json'),JSON.stringify(receipt,null,2)+'\n');
const excluded=['manifest.json','freeze.json'],files=(await walk(root)).filter(p=>!excluded.includes(p)),records=await Promise.all(files.map(fp));await fs.writeFile(path.join(root,'manifest.json'),JSON.stringify({schema:'rea-strict-source-only-proposal/v1',strict:true,excluded,records},null,2)+'\n');await fs.writeFile(path.join(root,'freeze.json'),JSON.stringify({at:new Date().toISOString(),manifest:await fp('manifest.json'),receipt:await fp('validation.json'),artifacts:records.length},null,2)+'\n');console.log(JSON.stringify({artifacts:records.length,manifest:await fp('manifest.json'),receipt:await fp('validation.json')}));
