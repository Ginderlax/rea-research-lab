    {
      "id": "grafana.candidate.25fb14f6bbcf8ed10429",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can pan the view by clicking outside any node or edge and dragging your mouse.",
      "headingPath": [
        "Node graph",
        "Node graph navigation",
        "Pan"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/node-graph/index.md",
