    },
    {
      "id": "grafana.candidate.81145843c70f2b87b895",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Stored procedures can be used in table, time series, and annotation queries, provided that the returned data matches the expected column names and formats described in the relevant previous sections in this document.",
      "headingPath": [
        "Microsoft SQL Server query editor",
        "Use stored procedures"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/query-editor/index.md",
