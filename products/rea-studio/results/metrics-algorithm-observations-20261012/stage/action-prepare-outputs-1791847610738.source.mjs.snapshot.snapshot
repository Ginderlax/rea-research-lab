import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),old=path.resolve(here,'../metrics-selector-measurement-review-next');
let tables=await fs.readFile(path.join(old,'make-tables.mjs'),'utf8');
const change=(a,b)=>{assert.ok(tables.includes(a));tables=tables.replaceAll(a,b);};
change('Fixed fallback p95 regresses against baseline','All-percentiles median regresses against baseline');
change('100.064 seconds against the prospective 3–5 minute reservation','105.580 seconds against the prospective 5–8 minute reservation');
change('264.904 seconds','273.433 seconds');
change('In all-calculations, released heap deltas include negative observations for baseline and candidate.', 'Both release references are provided: releasedAfterGC minus beforeRetention, and releasedAfterGC minus warmBase. The latter is the prospective summary definition; the former preserves the historical comparison definition. Negative signed observations and paired differences remain visible.');
tables+=`\nconst signed=['case,implementation,run,pid,metric,signed_or_absolute_bytes'];for(const row of summary.memorySignedPerChildRows)for(const [metric,value]of Object.entries(row.metrics))signed.push([row.caseName,row.implementation,row.runNumber,row.pid,metric,value].join(','));await fs.writeFile(path.join(here,'memory-per-child.csv'),signed.join('\\n')+'\\n',{flag:'wx'});\nconst percentages=['case,reference,metric,run,signed_percentage_or_unavailable'];for(const row of summary.memorySummary)for(const reference of ['baseline','original'])for(const [metric,item]of Object.entries(row.candidateComparedWith[reference]))item.pairedPercentChange.values.forEach((value,index)=>percentages.push([row.caseName,reference,metric,index,value===null?'unavailable_zero_control':value].join(',')));await fs.writeFile(path.join(here,'memory-paired-percentages.csv'),percentages.join('\\n')+'\\n',{flag:'wx'});console.log(JSON.stringify({perChildMetricRows:signed.length-1,pairedSignedPercentRows:percentages.length-1,zeroDenominatorPercentagesNotInvented:true}));\n`;
await fs.writeFile(path.join(here,'make-tables.mjs'),tables,{flag:'wx'});
let figures=await fs.readFile(path.join(old,'make-reportlab-figures.py'),'utf8');
const figureChange=(a,b)=>{assert.ok(figures.includes(a),a);figures=figures.replaceAll(a,b);};
figureChange('18a5373363c0103dc54e25cd9deccc8254ebabfbf1e4f775343295c6d81bd78f','e1bd043ecf79c7b878c4a5be76cd1f4b4b38d721435f555b35eee3cde8b92029');
figureChange('Selector control: timing medians and observed ranges','Algorithm candidate: timing medians and observed ranges');
figureChange('Candidate retained without integration: fallback p95 median is 27.91% slower than baseline. Windows background work uncontrolled.', 'Candidate unaccepted: all-percentiles median +38.00% vs baseline (overlapping ranges). Windows and user activity uncontrolled.');
figureChange("rss=lambda value:left_start+value/1048576/300*(left_end-left_start)\ndelta=lambda value:right_start+(value+8500)/10000*(right_end-right_start)\nfor value in [0,100,200,300]:", "max_rss=max(item['max'] for row in summary['memorySummary'] for item in [row['metricsByImplementation'][role]['lifetimePeakRSSBytes'] for role in roles])/1048576\nrss_bound=math.ceil(max_rss/25)*25\ndelta_values=[row['candidateComparedWith']['baseline']['retained-heapUsed-signedBytes']['pairedDifferenceBytes'][key] for row in summary['memorySummary'] for key in ['min','max']]\ndelta_low=math.floor(min([0]+delta_values)/1000)*1000-1000\ndelta_high=math.ceil(max([0]+delta_values)/1000)*1000+1000\nrss=lambda value:left_start+value/1048576/rss_bound*(left_end-left_start)\ndelta=lambda value:right_start+(value-delta_low)/(delta_high-delta_low)*(right_end-right_start)\nfor value in [0,rss_bound/3,rss_bound*2/3,rss_bound]:");
figureChange("str(value),8,anchor='middle')\nfor value in [-8000,-4000,0,1000]:", "f'{value:g}',8,anchor='middle')\nfor value in sorted(set([delta_low,round(delta_low/2),0,delta_high])):");
figureChange("assert -8500<=item['min']<=item['max']<=1500", "assert delta_low<=item['min']<=item['max']<=delta_high");
figureChange("'rasterVisualInspectionPerformed':False,'preferredMatplotlibUnavailable':True", "'rasterVisualInspectionPerformed':False,'matplotlibAttemptedDuringCurrentConsolidation':False,'axesIncludeAllObservedValues':True,'rssAxisMaximumMiB':rss_bound,'signedDeltaAxisBoundsBytes':[delta_low,delta_high]");
await fs.writeFile(path.join(here,'make-reportlab-figures.py'),figures,{flag:'wx'});await fs.writeFile(path.join(here,'render-figures.mjs'),await fs.readFile(path.join(old,'render-figures.mjs')),{flag:'wx'});
console.log('Prepared source-bound tables and vector figure renderer; no PDF authoring or measurement yet.');
