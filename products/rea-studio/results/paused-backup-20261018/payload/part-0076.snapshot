    {
      "id": "grafana.candidate.c9622776fc34a69865b2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Starting with Grafana v13.2, the PostgreSQL data source is a standalone plugin, preinstalled in both Grafana OSS and Enterprise. This enables more frequent updates independent of Grafana releases. Grafana automatically checks the plugin catalog and installs the latest version on each server restart.",
