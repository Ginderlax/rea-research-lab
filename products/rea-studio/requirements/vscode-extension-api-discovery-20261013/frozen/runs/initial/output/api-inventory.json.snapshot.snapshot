        {
          "name": "options",
          "span": {
            "utf16Start": 397159,
            "utf16End": 398145,
            "utf16Length": 986,
            "utf8Start": 397171,
            "utf8End": 398157,
            "utf8Length": 986,
            "startLine": 11791,
            "startColumn": 156,
