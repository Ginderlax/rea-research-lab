"""Independent actual hosted evidence/portable backup audit; product code is never executed."""
from pathlib import Path
import hashlib,io,json,re,struct,subprocess,tarfile,zipfile,zlib
B=Path(__file__).resolve().parent.parent;W=B/'work';R=B/'outputs/rea-research-lab'
D=W/'cloud-verification-backups/run-38930449217'
HEAD='89e00f66c2249a50c701404accede7565094304e';RUN='38930449217';P='products/rea-studio/'
def read(p):assert p.is_file() and not p.is_symlink(),str(p);return p.read_bytes()
def ident(b):return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def pin(b,r):assert ident(b)=={k:r[k]for k in('bytes','sha256')},r.get('path')
def load(p):return json.loads(read(p).decode('utf-8-sig'))
def git(*args):return subprocess.run(['git',*args],cwd=R,check=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE).stdout
def jsjson(x):return json.dumps(x,ensure_ascii=False,separators=(',',':')).encode()
summary=load(D/'new-todo-r5-collection-summary-v2.json')
assert summary['runId']==RUN and summary['headSHA']==HEAD and summary['runStatus']=='completed' and summary['runConclusion']=='success'
assert summary['terminalCompleteCollection'] and summary['bothRecordedContractsPassed']
cp={}
for x in summary['controlPlane']:pin(read(Path(x['path'])),x);cp[x['kind']]=load(Path(x['path']))
assert set(cp)=={'run','jobs','artifacts'}
assert cp['run']['id']==int(RUN) and cp['run']['head_sha']==HEAD and cp['run']['conclusion']=='success' and cp['run']['run_attempt']==1
assert cp['jobs']['total_count']==len(cp['jobs']['jobs'])==2
assert cp['artifacts']['total_count']==len(cp['artifacts']['artifacts'])==2
jobids={'finite':117072778435,'browser':117072778039}
for j in summary['jobs']:
    assert j['jobId']==jobids[j['role']] and j['status']=='completed' and j['conclusion']=='success'
    raw=next(x for x in cp['jobs']['jobs']if x['id']==j['jobId']);assert raw['conclusion']=='success' and raw['status']=='completed'
    pin(read(Path(j['rawJobLog']['path'])),j['rawJobLog'])
expected_art={'finite':(12058676606,2026036,'1bb0266814953261edf6e84939dc02d096ff501f65b5a3eef55d53488b373382',538),'browser':(12057774573,2424187,'d6c3f7d6d6f7a7841feeef211fe8af52b9286be2a60fb8648f3712e72cf51a8b',570)}
tree={}
for row in git('ls-tree','-r','-z',HEAD).split(b'\0'):
    if row:
        header,p=row.split(b'\t');mode,kind,oid=header.split();assert kind==b'blob' and mode in(b'100644',b'100755');tree[p.decode()]=oid.decode()
bundle=load(R/(P+'experiments/notes-new-todo/bundle.json'))
trans={r['path']:r for r in bundle['transitions']}
eligible={p:r for p,r in trans.items()if re.search(r'\.(mjs|json|html|css|ps1)$',p)}
assert len(trans)==7 and len(eligible)==6
all_data={};backups=[]
for a in summary['artifacts']:
    role=a['role'];aid,size,digest,count=expected_art[role];assert a['artifactId']==aid
    outer=read(Path(a['path']));assert ident(outer)=={'bytes':size,'sha256':digest}
    rawapi=next(x for x in cp['artifacts']['artifacts']if x['id']==aid)
    assert rawapi['digest']=='sha256:'+digest and rawapi['size_in_bytes']==size and rawapi['workflow_run']['id']==int(RUN) and rawapi['workflow_run']['head_sha']==HEAD
    assert not rawapi['expired']
    v=load(Path(a['verification']));assert v['recordedContractPassed'] and v['allCRCAndBytesReadable'] and v['evidenceConsistencyErrors']==[]
    d=Path(v['readableEvidence']);files={r['path']:r for r in v['files']};assert len(files)==count==a['readableFiles']
    with zipfile.ZipFile(io.BytesIO(outer))as oz:
        assert len(oz.infolist())==1;inner=oz.read(oz.namelist()[0])
    data={}
    with zipfile.ZipFile(io.BytesIO(inner))as iz:
        infos=[x for x in iz.infolist()if not x.is_dir()];assert len(infos)==count
        assert {x.filename for x in infos}==set(files)
        for info in infos:
            raw=iz.read(info);row=files[info.filename];assert raw==read(d/info.filename);pin(raw,row);assert f'{zlib.crc32(raw)&0xffffffff:08x}'==row['zipCRC32'];data[info.filename]=raw
    all_data[role]=data
    at=json.loads(data['new-todo-'+role+'-attempt.json'])
    assert at==v['attempt'] and at['status']=='passed' and at['sourceCommit']==HEAD and at['execution']['GITHUB_RUN_ID']==RUN and at['execution']['GITHUB_RUN_ATTEMPT']=='1'
    assert at['sourceOverlay'] and not at['productionInstalled'] and not at['historicalReceiptsRebound'] and at['sourceStable']
    assert at['exactTargets']==7 and at['eligibleTargets']==6 and at['composedNotesFiles']==36
