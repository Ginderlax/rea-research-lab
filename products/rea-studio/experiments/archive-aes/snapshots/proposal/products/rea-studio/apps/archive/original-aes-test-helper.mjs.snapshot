// Verification only; no application imports this module. Passwords use UTF-8
// private stdin, never command arguments or retained invocation records.
import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{spawnSync}from'node:child_process';import{makeOracleRun}from'./original-lzma-test-helper.mjs';
const sha=b=>createHash('sha256').update(b).digest('hex'),stage=path.resolve(import.meta.dirname,'../../../..');
const pins=[['7z.exe','95fff19b73eff77c87c0d7bd32822e43fb90dd2932459f962eb532d8dfb6ba53'],['7z.dll','899cd73d7fc60e1c1c35c7de0f5bed3dc69bfe2cecbd48014d868a347970a0b1']];
export function makeAesOracle(label){if(!/^[a-z0-9-]+$/.test(label))throw new Error('Owned fixture label required');const{original,run}=makeOracleRun('aes-'+label),records=[];
 function authenticate(){return pins.map(([name,pin])=>{const b=fs.readFileSync(path.join(path.dirname(original),name));assert.equal(sha(b),pin);return{name,bytes:b.length,sha256:pin};});}
 function cli(args,{password,cwd=run,expected=0,binary=false}={}){const identity=authenticate(),options=['-sccUTF-8','-bso0','-bsp0','-bse2'];if(password!==undefined){if(typeof password!=='string'||/[\r\n\0]/.test(password))throw new Error('Owned stdin password is invalid');if(args[0]==='a')options.push('-p');}const result=spawnSync(original,[...args,...options],{cwd,input:password===undefined?undefined:Buffer.from(password+'\n','utf8'),windowsHide:true,timeout:30000,maxBuffer:8*1024**2}),clean=b=>{let s=(b??Buffer.alloc(0)).toString('utf8');if(password)s=s.replaceAll(password,'[redacted synthetic password]');return s;},row={number:records.length+1,args:[...args,...options].map(x=>path.isAbsolute(x)?path.relative(run,x).replaceAll('\\','/'):x),passwordTransport:password===undefined?'none':'private UTF8 stdin; update -p prompt, extract/test omit defined-empty -p',binaryStdout:binary,exitCode:result.status,signal:result.signal,error:result.error?.code??null,stdout:{bytes:result.stdout?.length??0,sha256:sha(result.stdout??Buffer.alloc(0)),...(binary?{}:{text:clean(result.stdout)})},stderr:{bytes:result.stderr?.length??0,text:clean(result.stderr)},identity};records.push(row);assert.equal(result.status,expected,JSON.stringify(row));authenticate();return result.stdout;}
 function retain(name,details={}){const b=fs.readFileSync(path.join(run,name));return{path:path.relative(stage,path.join(run,name)).replaceAll('\\','/'),bytes:b.length,sha256:sha(b),...details};}
 function finish(details={}){const out=process.env.ARCHIVE_AES_OBSERVATIONS||path.join(run,'observations');fs.mkdirSync(out,{recursive:true});fs.writeFileSync(path.join(out,label+'.json'),JSON.stringify({schema:'rea-sevenzip-aes-original-observations/v1',label,originalRelease:'7-Zip26.04 completeWindowsx64',credentialsRetained:false,originalProcesses:records.length,originalGUI:0,records,...details},null,2)+'\n');}
 return{run,cli,retain,finish,sha};
}
