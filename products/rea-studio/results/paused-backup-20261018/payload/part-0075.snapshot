    {
      "id": "grafana.candidate.622e984373c1ae26260d",
      "syntaxRole": "procedural-step",
      "sourceText": "2. `predict_linear` uses the previous `14` days of disk utilization to predict the value `7` days into the future.",
      "headingPath": [
