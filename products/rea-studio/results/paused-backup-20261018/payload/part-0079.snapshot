    {
      "id": "grafana.candidate.6c6fcdbac5a8d5fde99f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This isn't only useful in the stat visualization&mdash;gauge, bar gauge, and status history visualizations, table cells formatted by thresholds, and gauge table cells all benefit from this addition.",
