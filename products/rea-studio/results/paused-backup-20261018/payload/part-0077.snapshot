    {
      "id": "grafana.candidate.4c8e45ae7c3efadfdade",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Place your cursor over an exemplar (highlighted star).",
      "headingPath": [
        "Introduction to exemplars",
