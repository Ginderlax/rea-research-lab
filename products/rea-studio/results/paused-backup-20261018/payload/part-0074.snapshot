    {
      "id": "grafana.candidate.59df3c19fa4a0ccd6595",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Next, it replaces the variables that use the syntax `$ENV_VAR_NAME`.",
      "headingPath": [
        "Provision Grafana",
        "Use environment variables",
        "Use of the special character `$`"
      ],
      "source": {
        "path": "docs/sources/administration/provisioning/index.md",
        "gitBlobSha": "a6caad47dea63fb1a213a61490f8f587ad16bba2",
