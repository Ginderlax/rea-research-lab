    },
    {
      "id": "grafana.candidate.779c4a5f46014d9d4345",
      "syntaxRole": "table-row",
      "sourceText": "| `uid`         | A unique identifier associated with the role. The UID enables you to change or delete the role. You can either generate a UID yourself, or let Grafana generate one for you. You cannot use the same UID within the same Grafana instance.                                                                                                                                                                           |",
      "headingPath": [
        "Create custom RBAC roles",
        "Create custom roles using file-based provisioning"
      ],
      "source": {
        "path": "docs/sources/administration/roles-and-permissions/access-control/create-custom-roles/index.md",
        "gitBlobSha": "c1e14a922787a6e57b9e58fbf1faa34693c53abe",
        "sha256": "697aeb40a2c923f1f32f32716f90540b5e0d2a873a91a8e152e35910b1b8c426",
        "lineStart": 207,
        "lineEnd": 207,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/roles-and-permissions/access-control/create-custom-roles/index.md#L207-L207"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.3ed9cedd52954d819eed",
      "syntaxRole": "table-row",
      "sourceText": "| `orgId`       | Identifies the organization to which the role belongs. The [default org ID](/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-grafana/#auto_assign_org_id) is used if you do not specify `orgId`.                                                                                                                                                                                                              |",
      "headingPath": [
        "Create custom RBAC roles",
        "Create custom roles using file-based provisioning"
      ],
      "source": {
        "path": "docs/sources/administration/roles-and-permissions/access-control/create-custom-roles/index.md",
        "gitBlobSha": "c1e14a922787a6e57b9e58fbf1faa34693c53abe",
        "sha256": "697aeb40a2c923f1f32f32716f90540b5e0d2a873a91a8e152e35910b1b8c426",
        "lineStart": 208,
        "lineEnd": 208,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/roles-and-permissions/access-control/create-custom-roles/index.md#L208-L208"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.8a5f968cbfab4669d836",
      "syntaxRole": "table-row",
      "sourceText": "| `global`      | Global roles are not associated with any specific organization, which means that you can reuse them across all organizations. This setting overrides `orgId`.                                                                                                                                                                                                                                                        |",
      "headingPath": [
        "Create custom RBAC roles",
        "Create custom roles using file-based provisioning"
      ],
      "source": {
        "path": "docs/sources/administration/roles-and-permissions/access-control/create-custom-roles/index.md",
