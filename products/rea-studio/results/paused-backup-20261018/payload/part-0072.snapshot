    ['format', 'https://raw.githubusercontent.com/rclone/rclone/v1.75.2/fs/config/obscure/obscure.go'],
    ['cli', 'https://raw.githubusercontent.com/rclone/rclone/v1.75.2/cmd/obscure/obscure.go']
  ];
  const referenceRecords = [];
  mkdirSync(join(root, 'artifacts/references'), { recursive: true });
  for (const [name, url] of references) {
