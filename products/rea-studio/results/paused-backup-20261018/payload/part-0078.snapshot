      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.036c99e7df37a4cb7a0e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Streaming is available for both the **Search** and **TraceQL** query types. You'll get immediate visibility of incoming traces on the results table.",
      "headingPath": [
        "Write TraceQL queries using Search",
        "Run queries and view results",
        "Stream results"
