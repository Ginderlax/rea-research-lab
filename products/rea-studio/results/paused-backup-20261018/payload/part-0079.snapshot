    {
      "id": "grafana.candidate.7f65c626ba974f584933",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can enjoy all the details query inspector gave you in dashboards now in Explore as well. You can open query inspector tab with the button next to query history. See [Query inspector in Explore](../../explore/#query-inspector) for more details.",
      "headingPath": [
        "What's new in Grafana v7.2",
        "Inspect queries in Explore"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-2.md",
        "gitBlobSha": "b14fe6b9f0ce989975bd191eded6a4b1402c46e6",
