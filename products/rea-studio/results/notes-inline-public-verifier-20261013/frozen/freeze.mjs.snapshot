import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const root=import.meta.dirname,id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});
const final=JSON.parse(await fs.readFile(path.join(root,'runs/with-override/validation.json')));assert.equal(final.allPass,true);assert.equal(final.controls,23);assert.equal(final.strictPublicAliases,868);assert.deepEqual(id(await fs.readFile(path.join(root,'verify-notes-inline-followups.mjs'))),final.module);
async function walk(p=''){const r=[];for(const e of(await fs.readdir(path.join(root,p),{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const n=p+e.name;if(n==='manifest.json')continue;assert.equal(e.isSymbolicLink(),false);if(e.isDirectory())r.push(...await walk(n+'/'));else{assert.ok(e.isFile());r.push({path:n,...id(await fs.readFile(path.join(root,n)))});}}return r;}
const all=await walk(),local=all.filter(r=>r.path.split('/').includes('private-proof-layout'));await fs.writeFile(path.join(root,'private-layout-exclusions.json'),JSON.stringify({schema:'rea-notes-inline-verifier-private-layout-records/v1',localOnly:true,wholeStagePublic:false,files:local.length,bytes:local.reduce((n,r)=>n+r.bytes,0),records:local,nativeExcludedFixtureCopies:0},null,2)+'\n',{flag:'wx'});
const receipt={schema:'rea-notes-inline-public-verifier-frozen-candidate/v1',at:new Date().toISOString(),acceptance:true,sourceOnly:true,sourceStable:true,module:final.module,controlsFinal23:true,historical836Controls19Separate:true,finalReceipt:{path:'runs/with-override/validation.json',...id(await fs.readFile(path.join(root,'runs/with-override/validation.json')))},original836Receipt:{path:'runs/final/validation.json',...id(await fs.readFile(path.join(root,'runs/final/validation.json')))},publicAliases868:true,historical34Resolver:true,requireCurrentDefault:true,requireCurrentFalseNeverCurrentAcceptance:true,installedBehaviorAcceptance:false,sourcePrerequisites31:true,requirements159SHA232IDs:true,qualificationCorrection32:true,applicationTests:0,originalExecutions:0,browserExecutions:0,hosts:0,benchmarks:0,productionWrites:0,publishedCopies:0,ownCollectorFailures:2,sourceOnlyValidationAttempts:4,localMirrorFiles:local.length,localExcludedFixturesCopied:0,fullParity:false,securityEquivalence:false,superiority:false};await fs.writeFile(path.join(root,'validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
const r=await walk();await fs.writeFile(path.join(root,'manifest.json'),JSON.stringify({schema:'rea-notes-inline-public-verifier-candidate-strict-freeze/v1',at:new Date().toISOString(),strict:true,selfExcluded:true,files:r.length,bytes:r.reduce((n,r)=>n+r.bytes,0),receiptSHA256:id(await fs.readFile(path.join(root,'validation.json'))).sha256,wholeStagePublic:false,publicCandidateFiles:r.filter(r=>!r.path.split('/').includes('private-proof-layout')).length,privateMirrorFiles:local.length,inventory:Object.fromEntries(r.map(r=>[r.path,{bytes:r.bytes,sha256:r.sha256}]))},null,2)+'\n',{flag:'wx'});for(const x of r)assert.deepEqual(id(await fs.readFile(path.join(root,x.path))),{bytes:x.bytes,sha256:x.sha256});console.log(JSON.stringify({files:r.length,module:final.module,receipt:id(await fs.readFile(path.join(root,'validation.json'))),manifest:id(await fs.readFile(path.join(root,'manifest.json'))),localMirrorFiles:local.length}));
