import fs from 'node:fs/promises';import path from 'node:path';import {spawn} from 'node:child_process';import {root,stage,hash,authenticate} from './authority.mjs';
const run=path.join(root,'runs',new Date().toISOString().replaceAll(':','-'));await fs.mkdir(path.join(run,'source'),{recursive:true});const authorityBefore=await authenticate(),files=['authority.mjs','oracle.mjs','differential.test.mjs','run.mjs'];async function sources(){return Promise.all(files.map(async p=>{const b=await fs.readFile(path.join(root,p));return{path:p,bytes:b.length,sha256:hash(b)};}));}const before=await sources();for(const name of files)await fs.copyFile(path.join(root,name),path.join(run,'source',name+'.snapshot'));await fs.copyFile(path.join(stage,'position-range-selection.mjs'),path.join(run,'source/candidate.mjs.snapshot'));await fs.writeFile(path.join(run,'source-before.json'),JSON.stringify({authority:authorityBefore,review:before},null,2)+'\n');
const env={...process.env,EDITOR_REVIEW_OUTPUT:path.join(run,'observations')};delete env.NODE_TEST_CONTEXT;const args=['--max-old-space-size=256','--test','--test-isolation=none','--test-reporter=tap','differential.test.mjs'];await fs.writeFile(path.join(run,'invocation.json'),JSON.stringify({execPath:process.execPath,args,cwd:root,inheritedNodeTestContextRemoved:true,ownedOutput:env.EDITOR_REVIEW_OUTPUT},null,2)+'\n');
const child=spawn(process.execPath,args,{cwd:root,env,windowsHide:true,stdio:['ignore','pipe','pipe']});let stdout=[],stderr=[],outBytes=0,errBytes=0,termination=null;const outCap=1024*1024,errCap=1024*1024,deadline=setTimeout(()=>{termination='deadline';child.kill();},60000);child.stdout.on('data',b=>{outBytes+=b.length;if(outBytes>outCap){termination='stdout-budget';child.kill();return;}stdout.push(b);});child.stderr.on('data',b=>{errBytes+=b.length;if(errBytes>errCap){termination='stderr-budget';child.kill();return;}stderr.push(b);});
const processResult=await new Promise(resolve=>{child.once('error',e=>resolve({error:String(e),code:null}));child.once('close',(code,signal)=>resolve({code,signal}));});clearTimeout(deadline);stdout=Buffer.concat(stdout);stderr=Buffer.concat(stderr);await fs.writeFile(path.join(run,'stdout.txt'),stdout);await fs.writeFile(path.join(run,'stderr.txt'),stderr);
const authorityAfter=await authenticate(),after=await sources();await fs.writeFile(path.join(run,'source-after.json'),JSON.stringify({authority:authorityAfter,review:after},null,2)+'\n');const raw=stdout.toString('utf8'),summary=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(k=>[k,Number(raw.match(new RegExp('^# '+k+' (\\d+)$','m'))?.[1]??NaN)]));const attempt={at:new Date().toISOString(),run:path.relative(root,run).replaceAll('\\','/'),process:{...processResult,nodeVersion:process.version,termination,outBytes,errBytes,deadlineMs:60000,oldSpaceMiB:256,stdoutCap:outCap,stderrCap:errCap,hardRSSWatchdog:false,descendantIsolationClaim:false},summary,sourceStable:JSON.stringify(before)===JSON.stringify(after)&&JSON.stringify(authorityBefore)===JSON.stringify(authorityAfter)};await fs.writeFile(path.join(run,'attempt.json'),JSON.stringify(attempt,null,2)+'\n');console.log(JSON.stringify(attempt));if(processResult.code!==0||!attempt.sourceStable)process.exitCode=1;
