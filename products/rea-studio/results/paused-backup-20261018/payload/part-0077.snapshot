    {
      "id": "grafana.candidate.f5d67c3cbf429cfd772d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Path to the certificate key file (if `protocol` is set to `https` or `h2`).",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[server]`",
        "`cert_key`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
