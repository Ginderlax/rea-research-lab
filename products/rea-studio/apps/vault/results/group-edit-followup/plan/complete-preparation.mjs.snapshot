import assert from 'node:assert/strict';import {readFileSync,writeFileSync,existsSync,readdirSync,lstatSync} from 'node:fs';import {resolve} from 'node:path';import {createHash} from 'node:crypto';
const here=import.meta.dirname,work=resolve(here,'..'),repo=resolve(work,'../outputs/rea-research-lab'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),key=r=>r.bytes+':'+r.sha256,j=(p,v)=>writeFileSync(resolve(here,p),JSON.stringify(v,null,2)+'\n',{flag:'wx'});
const before=JSON.parse(readFileSync(resolve(here,'current-before.json')));for(const r of before.rows)assert.deepEqual(id(readFileSync(resolve(repo,r.path))),{bytes:r.bytes,sha256:r.sha256});const live=JSON.parse(readFileSync(resolve(here,'installation-plan.json')));assert.equal(live.rows.length,16);for(const r of live.rows)assert.deepEqual(id(readFileSync(resolve(here,r.source))),r.after);
