      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.cc211f72f40ac344ceea",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set the **Format** option to **Time series** to create and run time series queries.",
      "headingPath": [
        "PostgreSQL query editor",
        "Time series queries"
      ],
