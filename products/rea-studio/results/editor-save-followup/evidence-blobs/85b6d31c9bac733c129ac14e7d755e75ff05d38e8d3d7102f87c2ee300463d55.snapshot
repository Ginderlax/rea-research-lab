import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const here=import.meta.dirname,base=path.resolve(here,'../editor-save-revision-independent-review'),hash=b=>createHash('sha256').update(b).digest('hex');const mb=await fs.readFile(path.join(base,'freeze-manifest.json'));assert.equal(hash(mb),'b1c3146a795e766f00b5d36dd9237ebb883a866a5d03678a4022254060b6e4c9');const manifest=JSON.parse(mb);assert.equal(Object.keys(manifest.inventory).length,26);for(const[rel,r]of Object.entries(manifest.inventory)){const b=await fs.readFile(path.join(base,rel));assert.deepEqual({bytes:b.length,sha256:hash(b)},r);}const receipt=await fs.readFile(path.join(base,'review-validation.json'));assert.equal(hash(receipt),'629cb8a2fedc23754049ef24c64ec6ff77dedf15644edd48d73273d6e0d34b48');const b=await fs.readFile(path.join(base,'queued-revision.test.mjs')),old=b.toString(),needle='../editor-search-path-fix-next/products/rea-studio/',replacement='../editor-save-fix-next/products/rea-studio/';assert.equal(old.split(needle).length-1,2);const adapted=old.replaceAll(needle,replacement),offset=old.indexOf("test('queued Save");assert(offset>0);assert.equal(adapted.slice(adapted.indexOf("test('queued Save")),old.slice(offset));await fs.writeFile(path.join(here,'queued-revision-retargeted.test.mjs'),adapted,{flag:'wx'});await fs.writeFile(path.join(here,'baseline-sources/queued-revision.test.mjs.snapshot'),b,{flag:'wx'});const record={schema:'rea-editor-save-review-queued-revision-adapter/v1',negativeManifest:{path:'work/editor-save-revision-independent-review/freeze-manifest.json',bytes:mb.length,sha256:hash(mb),files:26},negativeReceipt:{path:'work/editor-save-revision-independent-review/review-validation.json',bytes:receipt.length,sha256:hash(receipt)},source:{bytes:b.length,sha256:hash(b)},adapter:{from:needle,to:replacement,occurrences:2},proposed:{path:'queued-revision-retargeted.test.mjs',bytes:Buffer.byteLength(adapted),sha256:hash(adapted)},threeBodiesUnchanged:true,bodySha256:hash(old.slice(offset)),executed:false,productionModified:false};await fs.writeFile(path.join(here,'revision-probe-adapters.json'),JSON.stringify(record,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({negative26Authenticated:true,threeBodiesUnchanged:true,executed:false}));
