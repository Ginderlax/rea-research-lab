    {
      "id": "grafana.candidate.c6bd631bb6c686ae79e4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, Grafana automatically chooses display settings. You can override these settings by choosing one of the following cell types to control the default display for all fields. Additional configuration is available for some cell types.",
      "headingPath": [
        "Table",
        "Configuration options",
        "Cell options",
        "Cell type"
      ],
