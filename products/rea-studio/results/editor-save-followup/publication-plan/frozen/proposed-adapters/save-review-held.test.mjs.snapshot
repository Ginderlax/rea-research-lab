import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs/promises';
import{fixture,all,field,button}from'./save-review-fixture.mjs';
test('typing after a committed held save must remain a dirty draft through tab navigation',async t=>{const f=await fixture(t,'typing');assert.equal(f.committed.diskA,'captured save A\n');assert.equal(f.editor.disabled,false);f.editor.value='newer unsaved A\n';f.editor.oninput();f.release.resolve();await f.pending;const marker=all(f.root).find(node=>node.attributes['aria-pressed']==='true').textContent;await button(f.root,'Compare with saved version').onclick();const difference=field(f.root,'Line difference').textContent;await button(f.root,'b.txt').onclick();await button(f.root,'a.txt').onclick();const observed=await f.observe({markerAfterResponse:marker,differenceAfterResponse:difference});assert.equal(observed.editorValue,'newer unsaved A\n');assert.equal(marker,'a.txt •');assert.match(difference,/Minimal line edits: 2/);assert.equal(observed.diskA,'captured save A\n');});
test('control: no typing publishes the committed save and a clean current tab',async t=>{const f=await fixture(t,'no-typing');f.release.resolve();await f.pending;await button(f.root,'b.txt').onclick();await button(f.root,'a.txt').onclick();const observed=await f.observe({noLaterTyping:true});assert.equal(observed.editorValue,'captured save A\n');assert.equal(observed.diskA,'captured save A\n');assert.ok(observed.tabs.some(row=>row.label==='a.txt'&&row.active==='true'));});
test('control: held save settlement preserves an unrelated new draft and captured disk commit',async t=>{const f=await fixture(t,'new-draft');field(f.root,'Relative file path').value='new.txt';await button(f.root,'New file').onclick();f.editor.value='unrelated new draft\n';f.editor.oninput();f.release.resolve();await f.pending;const observed=await f.observe({newDraft:true});assert.equal(observed.editorValue,'unrelated new draft\n');assert.ok(observed.tabs.some(row=>row.label==='new.txt •'&&row.active==='true'));assert.equal(observed.diskA,'captured save A\n');await assert.rejects(fs.readFile(f.workspace.resolve('new.txt')),error=>error.code==='ENOENT');});
test('control: selection during held save keeps the selected file active',async t=>{const f=await fixture(t,'selection');await button(f.root,'b.txt').onclick();f.release.resolve();await f.pending;const observed=await f.observe({selectedB:true});assert.equal(observed.editorValue,'original B\n');assert.ok(observed.tabs.some(row=>row.label==='b.txt'&&row.active==='true'));assert.equal(observed.diskA,'captured save A\n');});
test('control: confirmed close during held save does not reopen the closed tab',async t=>{const f=await fixture(t,'close');await button(f.root,'Close tab').onclick();f.release.resolve();await f.pending;const observed=await f.observe({confirmedClose:true});assert.deepEqual(observed.tabs,[]);assert.equal(observed.editorValue,'');assert.equal(observed.editorDisabled,true);assert.equal(observed.diskA,'captured save A\n');});
test('disposal must suppress held successful save response publication',async t=>{const f=await fixture(t,'dispose');f.dispose();const before={status:all(f.root).filter(node=>node.attributes.role==='status').map(node=>node.textContent),tabs:all(f.root).filter(node=>node.attributes['aria-pressed']!==undefined).map(node=>({label:node.textContent,active:node.attributes['aria-pressed']}))};f.release.resolve();await f.pending;const observed=await f.observe({disposedBeforeResponse:true,before});assert.deepEqual(observed.status,before.status);assert.deepEqual(observed.tabs,before.tabs);assert.equal(observed.diskA,'captured save A\n');});
test('disposal must suppress held failed save response publication without a disk commit',async t=>{const f=await fixture(t,'dispose-error',{heldError:true});assert.equal(f.committed.diskA,'original A\n');f.dispose();const before=all(f.root).filter(node=>node.attributes.role==='status').map(node=>node.textContent);f.release.resolve();await f.pending;const observed=await f.observe({disposedBeforeFailure:true,before});assert.deepEqual(observed.status,before);assert.equal(observed.diskA,'original A\n');});
