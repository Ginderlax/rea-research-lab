    {
      "id": "grafana.candidate.d625136c375cee4771f8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "See [the documentation for more information](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/panels-visualizations/query-transform-data/transform-data/#group-to-nested-tables).",
      "headingPath": [
        "What’s new in Grafana v11.2",
        "Dashboards and visualizations",
        "Transformation updates"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-2.md",
