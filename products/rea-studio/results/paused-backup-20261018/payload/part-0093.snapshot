import hashlib,json,gzip,zipfile,io,base64,stat
w=Path('C:/Users/evanh/Documents/Codex/2026-10-12/go/work');stage=w/'notes-historical-id-string-correction-20261016-next';candidate=stage/'public-candidate'
pin=lambda b:{'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
authority_bytes=(stage/'copy-authority.json').read_bytes();assert pin(authority_bytes)=={'bytes':51671,'sha256':'42e83a1f09be27f744901cb6330eef37be343d35fb58558b2c67bda0a6171300'}
a=json.loads(authority_bytes);assert a['files']==len(a['rows'])==148 and a['bytes']==6820992
for row in a['rows']:assert pin((candidate/row['path']).read_bytes())==row['after']
assert {p.relative_to(candidate).as_posix() for p in candidate.rglob('*') if p.is_file()}=={r['path'] for r in a['rows']}
prefix='products/rea-studio/results/notes-historical-id-string-correction-20261016';root=candidate/prefix
m=json.loads((root/'preservation-manifest.json').read_bytes());roles={};gzip_roles=0
for row in m['records']:
    assert row['sourcePath'] not in roles;stored=(root/row['path']).read_bytes();assert pin(stored)=={k:row['storage'][k] for k in ('bytes','sha256')}
    if row['storage']['encoding']=='gzip':decoded=gzip.decompress(stored);gzip_roles+=1
    else:assert row['storage']['encoding']=='identity';decoded=stored
    assert pin(decoded)=={k:row[k] for k in ('bytes','sha256')};roles[row['sourcePath']]=decoded
assert len(roles)==152
z=roles['complete-github-artifact-outer-zip'];assert pin(z)['sha256']=='763ffd3ff16554d4609df473a24d73d844c430d6df670e62e39c1394f6002c4b'
with zipfile.ZipFile(io.BytesIO(z)) as outer:
    outer_entries=outer.infolist();assert len(outer_entries)==1 and outer_entries[0].filename=='rea-publication-38917432854-1.zip'
    inner=outer.read(outer_entries[0])
with zipfile.ZipFile(io.BytesIO(inner)) as archive:
