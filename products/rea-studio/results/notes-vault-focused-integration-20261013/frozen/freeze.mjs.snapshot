import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const root=path.dirname(fileURLToPath(import.meta.url)),workspace=path.resolve(root,'../..'),lab=path.join(workspace,'outputs/rea-research-lab'),hash=b=>createHash('sha256').update(b).digest('hex');
const read=p=>fs.readFile(path.join(root,p)),parse=async p=>JSON.parse(await read(p)),put=(p,v)=>fs.writeFile(path.join(root,p),JSON.stringify(v,null,2)+'\n',{flag:'wx'});
const receipt=await parse('integration-validation.json'),before=await parse('source-before.json'),after=await parse('source-after.json');assert.deepEqual(before,after);assert.equal(before.length,105);assert.equal(receipt.finiteAcceptance,true);
for(const r of before){const b=await fs.readFile(path.join(lab,r.path));assert.equal(b.length,r.bytes,r.path);assert.equal(hash(b),r.sha256,r.path);assert.equal(hash(await read('source/'+r.path+'.snapshot')),r.sha256);}
const authority=await parse('authority/installation.json.snapshot');for(const r of authority.installed){const b=await fs.readFile(path.join(lab,r.destination));assert.equal(b.length,r.after.bytes);assert.equal(hash(b),r.after.sha256);}
for(const label of ['notes','vault']){const raw=await read(label+'.stdout.txt'),attempt=await parse(label+'-attempt.json');assert.equal(hash(raw),attempt.stdoutSha256);assert.equal(hash(await read(label+'.stderr.txt')),attempt.stderrSha256);assert.equal(attempt.code,0);assert.equal(attempt.problem,null);assert.deepEqual(attempt.summary,{tests:label==='notes'?59:79,pass:label==='notes'?59:79,fail:0,cancelled:0,skipped:0,todo:0});}
const exe=receipt.originalPrerequisites.KeePassExe,binary=await fs.readFile(path.join(lab,exe.path));assert.equal(binary.length,exe.bytes);assert.equal(hash(binary),exe.sha256);
for(const r of await parse('native-process-controls.json')){const b=await fs.readFile(r.path);assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);}
const node=receipt.originalPrerequisites.runtime,nodeBytes=await fs.readFile(node.path);assert.equal(nodeBytes.length,node.bytes);assert.equal(hash(nodeBytes),node.sha256);
const history=await parse('observations/vault/REA_KEEPASS_HISTORY_ORIGINAL.json'),unknown=await parse('observations/vault/REA_KEEPASS_HISTORY_UNKNOWN.json'),recycle=await parse('observations/vault/REA_RECYCLE_ORIGINAL.json');
assert.equal(history.originalProcessExecutions,14);assert.equal(history.observations.length,14);assert.equal(unknown.originalProcessExecutions,9);assert.equal(unknown.observations.length,9);
for(const r of [...history.observations,...unknown.observations]){assert.equal(r.result.code,0);assert.equal(r.result.signal,null);assert.equal(r.value.guiExecuted,false);assert.equal(r.value.assemblySha256.toLowerCase(),exe.sha256);}
const processNames=(await fs.readdir(path.join(root,'observations/vault/recycle-processes'))).sort();assert.equal(processNames.length,14);const processRecords=await Promise.all(processNames.map(n=>parse('observations/vault/recycle-processes/'+n)));
for(const r of processRecords){assert.equal(r.code,0);assert.equal(r.problem,null);assert.equal(r.assemblyLoaded,true);assert.equal(r.releaseSha256,exe.sha256);assert.equal(r.value.calls.originalGUI,0);assert.equal(r.helperSha256,before.find(v=>v.path.endsWith('/vault/recycle-oracle.ps1')).sha256);}
assert.equal(recycle.observations.length,14);assert.equal(recycle.assemblyLoads,14);assert.deepEqual(processRecords.map(r=>hash(JSON.stringify(r))).sort(),recycle.observations.map(r=>hash(JSON.stringify(r))).sort());
const trash=await parse('observations/notes/trash-original.json'),review=await parse('observations/notes/review.json'),publication=await parse('observations/notes/publication-boundaries.json'),fresh=await parse('observations/notes/fresh-boundaries.json');assert.equal(trash.length,8);assert.equal(review.length,7);assert.equal(publication.length,7);assert.equal(fresh.length,4);
const notes=receipt.notesOriginalObservations,top=trash.reduce((n,r)=>n+(r.originalTopLevelExecutions??0),0),matched=trash.reduce((n,r)=>n+(r.matchedItemProjections??0),0),held=review.find(r=>r.case==='held-out released restore');assert.equal(top,13);assert.equal(matched,73);assert.equal(held.helperTopLevelExecutions,1);assert.equal(held.matchedItemProjections,11);assert.equal(held.matchedScalarFields,55);assert.equal(held.originalFullApplicationExecutions,0);assert.equal(notes.notebookTrashOriginal.topLevelOriginalExecutions,top);
const fixtureMetadata=await parse('source/products/rea-studio/apps/notes/fixtures/pinned-joplin.json.snapshot'),tarBranchCalls=Object.keys(fixtureMetadata.expected).length+2;assert.equal(tarBranchCalls,9);
const audit={schema:'rea-notes-vault-focused-completion-audit/v1',completedAtUtc:new Date().toISOString(),acceptance:true,actualTapGroups:138,currentSourceFingerprints:105,installedExactAfterIdentities:34,beforeAfterAndFinalStable:true,originalExeHash:exe.sha256,originalProcesses:{history14:14,unknownTime9:9,recycle14:14,total:37},observedRecycleAssemblyMarkers:14,recycleSummaryMatchesAll14CurrentPerProcessRecords:true,historyDirectMethodsLabelBoundary:'The per-process directMethods array is a declared family list, not an invocation counter; it is not summed.',notes:{organizationNestingComparisons:20,organizationPathComparisons:4,organizationContractMoves:2,candidateOriginalMoveComparisons:2,additionalOriginalMoveExecutions:2,trashTopLevelHelperCallsIncludingDisplay:13,trashItemProjections:73,trashDisplayComparisons:6,currentReviewerRestoreTopLevelCalls:1,currentReviewerItemProjections:11,currentReviewerScalarFields:55,originalApplicationDatabaseGuiExecutions:0,currentSerializedFixtureGenerationExecutions:0},nativeTar:{successfulSelectedSourceBranchInvocations:tarBranchCalls,boundary:'Nine calls derive from the unchanged passing test source: one listing, seven record reads and one resource read. No process-tree telemetry was added.'},rawObservations:{trashCases:8,reviewCases:7,adjacentPublicationCases:7,freshCases:4,vaultHistoryProcesses:14,vaultUnknownProcesses:9,vaultRecycleProcessRecords:14},collectorErrors:0,scope:'Current-layout focused acceptance only; no added behavior tests, browser, full suite, measurement, whole-application parity or production edits.'};
await put('completion-audit.json',audit);
async function walk(folder,prefix=''){let files=[];for(const r of(await fs.readdir(folder,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const p=prefix+r.name;if(r.isDirectory())files.push(...await walk(path.join(folder,r.name),p+'/'));else{assert.ok(r.isFile(),'Only ordinary frozen files');files.push(p);}}return files;}
const rows=[];for(const p of await walk(root)){if(p==='freeze-manifest.json'||p==='public-map-proposal.json')continue;const b=await read(p);rows.push({path:p,bytes:b.length,sha256:hash(b)});}
const exclusions=rows.filter(r=>r.sha256==='044885c906ba7d8cb97a95fbdd6bc2323ba31a3c301e7ed1d6e592acec8944af').map(r=>({...r,reason:'Existing synthetic binary TAR/JEX carrier; source/input metadata and exact identity remain available. Payload remains local.'}));assert.equal(exclusions.length,1);
const publicRows=rows.filter(r=>!exclusions.some(e=>e.path===r.path)).map(r=>({...r,sourcePath:'work/notes-vault-focused-integration-next/'+r.path,proposedPath:'focused-integration/'+r.path.split('/').map(s=>s==='.local'?'private-local':s).join('/')+'.snapshot'}));
await put('public-map-proposal.json',{schema:'rea-notes-vault-focused-source-only-public-map-proposal/v1',notInstalled:true,payloads:publicRows,excludedPayloads:exclusions,metadataToPreserveSeparately:['public-map-proposal.json','freeze-manifest.json'],originalNativeExecutableNeverCopied:{...exe,reason:'Retained local original only; exact prerequisite identity authenticated before/after/final'},historicalPreexistingOutputBoundary:'preexisting/ files are exact prior app-owned observation bytes captured before fixed-name current test outputs overwrote them; they are not current acceptance observations.',pathBoundary:'Proposed inert paths replace the .local directory segment with private-local; sourcePath remains exact. No current app/results files are written by this collector.'});
const inventory={};for(const p of await walk(root)){if(p==='freeze-manifest.json')continue;const b=await read(p);inventory[p]={bytes:b.length,sha256:hash(b)};}
const manifest={schema:'rea-notes-vault-focused-integration-freeze/v1',frozenAtUtc:new Date().toISOString(),files:Object.keys(inventory).length,bytes:Object.values(inventory).reduce((n,r)=>n+r.bytes,0),inventory,scope:'Private source-bound acceptance evidence; exact138 test groups. No production changes or public copy authorized/performed here.'};await put('freeze-manifest.json',manifest);
for(const[p,r]of Object.entries(inventory)){const b=await read(p);assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);}
console.log(JSON.stringify({files:manifest.files,bytes:manifest.bytes,manifestSha256:hash(await read('freeze-manifest.json')),receiptSha256:hash(await read('integration-validation.json')),auditSha256:hash(await read('completion-audit.json')),publicMapSha256:hash(await read('public-map-proposal.json')),proposedPublicPayloads:publicRows.length,excludedPayloads:exclusions.length,actualTests:138,actualOriginalLibraryProcesses:37,sourceStable:true}));
