    {
      "id": "grafana.candidate.9d4d5e54a1f07dd90f7f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Sets a custom value for the `User-Agent` header for outgoing data proxy requests. If empty, the default value is `Grafana/<BuildVersion>` (for example `Grafana/13.0.0`).",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[dataproxy]`",
        "`user_agent`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
        "lineStart": 593,
        "lineEnd": 593,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L593-L593"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.3f2d15b4b66a7160eec4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If enabled, the data proxy preserves the client's original `User-Agent` header by appending it to the proxy's `User-Agent`. Useful for tracking the originating client (browser, CLI, AI agent, etc.) at upstream data sources. Default is `false`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[dataproxy]`",
        "`forward_user_agent`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
