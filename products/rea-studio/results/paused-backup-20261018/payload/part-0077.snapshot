    },
    {
      "id": "grafana.candidate.94d4a9dfccb376cca1eb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Don't use environment variables to _add_ new configuration settings. Instead, use environment variables to _override_ existing options.",
      "headingPath": [
        "Configure Grafana",
        "Override configuration with environment variables"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
