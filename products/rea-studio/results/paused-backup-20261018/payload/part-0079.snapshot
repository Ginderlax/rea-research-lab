    {
      "id": "grafana.candidate.e731d2a097d7a47e26ca",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "IdP-initiated single sign on (SSO) allows the user to log in directly from the SAML identity provider (IdP). It is disabled by default for security reasons. For more information, refer to the [docs](../../setup-grafana/configure-access/configure-authentication/saml/#idp-initiated-single-sign-on-sso).",
      "headingPath": [
        "What's new in Grafana v7.3",
        "Grafana Enterprise features",
        "SAML IdP-initiated single sign on"
      ],
