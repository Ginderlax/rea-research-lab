    },
    {
      "id": "grafana.candidate.cf585f51f9d68b84d1f1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Data source permissions on global roles:** If a Terraform-managed `grafana_role` combines `global = true` with `datasources:uid:<uid>`, recreate the role as a non-global role with a new UID. Grafana can't change the scope of an existing role in place. Set `datasource_type` on data source permission resources when possible.",
      "headingPath": [
        "Upgrade to Grafana v13.0",
        "Technical notes",
        "RBAC enforcement changes for custom roles",
        "Migration"
      ],
      "source": {
        "path": "docs/sources/upgrade-guide/upgrade-v13.0/index.md",
        "gitBlobSha": "f45eec63216c452b0eebba76d1eb812e54001903",
        "sha256": "471090ddf07331c874d83707d16041b15600bd3e6b1842af09268a9b6a6ffc40",
        "lineStart": 208,
        "lineEnd": 208,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/upgrade-guide/upgrade-v13.0/index.md#L208-L208"
      },
      "applicability": {
        "status": "unresolved-no-explicit-oss-products-label",
        "products": []
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.addb5ffe9d68324923c1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Dashboard annotation fixed roles:** Remove `fixed:annotations.dashboard:writer` and `fixed:annotations.dashboard:reader` from your configurations. Use dashboard or folder permissions (View, Edit, Admin) to control dashboard annotation access instead. Use `annotations:type:organization` for organization-level annotations.",
      "headingPath": [
        "Upgrade to Grafana v13.0",
        "Technical notes",
        "RBAC enforcement changes for custom roles",
        "Migration"
      ],
      "source": {
        "path": "docs/sources/upgrade-guide/upgrade-v13.0/index.md",
        "gitBlobSha": "f45eec63216c452b0eebba76d1eb812e54001903",
        "sha256": "471090ddf07331c874d83707d16041b15600bd3e6b1842af09268a9b6a6ffc40",
        "lineStart": 210,
        "lineEnd": 210,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/upgrade-guide/upgrade-v13.0/index.md#L210-L210"
      },
      "applicability": {
        "status": "unresolved-no-explicit-oss-products-label",
        "products": []
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b031ff4cb01434edec5e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If a role is stuck because Grafana refuses to update or delete it, the role may contain a deprecated permission that must be removed before Terraform or API updates can succeed. Contact Grafana support for assistance.",
      "headingPath": [
        "Upgrade to Grafana v13.0",
        "Technical notes",
        "RBAC enforcement changes for custom roles",
        "Migration"
      ],
      "source": {
        "path": "docs/sources/upgrade-guide/upgrade-v13.0/index.md",
        "gitBlobSha": "f45eec63216c452b0eebba76d1eb812e54001903",
