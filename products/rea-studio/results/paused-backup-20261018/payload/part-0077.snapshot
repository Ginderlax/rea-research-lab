    {
      "id": "grafana.candidate.10e9984dd0061f757f4b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The HTTP option for the Loki exporter is available only in Grafana Enterprise version 7.4 and later.",
