    {
      "id": "grafana.candidate.eecbb716de89f15afb18",
      "syntaxRole": "list-item",
      "sourceText": "- Interact with Grafana without signing in as a user",
      "headingPath": [
        "Plan your IAM integration strategy",
        "Access to external systems",
        "Service accounts"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/_index.md",
