async function walk(base,prefix=''){const rows=[];for(const e of await fs.readdir(base,{withFileTypes:true})){assert(!e.isSymbolicLink());if(e.isDirectory())rows.push(...await walk(path.join(base,e.name),prefix+e.name+'/'));else rows.push(prefix+e.name);}return rows.sort();}
async function authenticate(e){const base=path.join(work,e.folder),mb=await fs.readFile(path.join(base,'freeze-manifest.json'));assert.equal(hash(mb),e.manifestSha);const m=JSON.parse(mb);assert.equal(Object.keys(m.inventory).length,e.count);assert.deepEqual((await walk(base)).filter(p=>p!=='freeze-manifest.json'),Object.keys(m.inventory).sort());for(const[rel,r]of Object.entries(m.inventory))assert.deepEqual(await ident(path.join(base,rel)),r);assert.equal((await ident(path.join(base,e.receiptName))).sha256,e.receiptSha);return{...e,manifest:{path:'freeze-manifest.json',bytes:mb.length,sha256:hash(mb)},receipt:{path:e.receiptName,...await ident(path.join(base,e.receiptName))},inventory:m.inventory,strictExact:true};}
const before=[],payload=[];for(const e of epochs){const record=await authenticate(e);before.push(record);for(const[rel,r]of Object.entries({...record.inventory,'freeze-manifest.json':{bytes:record.manifest.bytes,sha256:record.manifest.sha256}}))payload.push({epoch:e.id,sourceRoot:'work/'+e.folder,sourcePath:rel,...r});}
const historical='products/rea-studio/results/editor-workspace-search-followup/path-correction/preservation-manifest.json',prior=JSON.parse(await fs.readFile(path.join(repo,historical))),priorShaMap=new Map();assert.equal(prior.originalManifest.sha256,epochs[0].manifestSha);for(const r of prior.copies){if(!priorShaMap.has(r.sha256))priorShaMap.set(r.sha256,{path:path.posix.dirname(historical)+'/'+r.path,bytes:r.bytes,sha256:r.sha256});}
const magic=[['MZ','4d5a'],['ZIP','504b0304'],['ZIP-empty','504b0506'],['GZIP','1f8b'],['7Z','377abcaf271c'],['XZ','fd377a585a00'],['ZSTD','28b52ffd'],['KDBX','03d9a29a67fb4bb5']],unique=new Map(),reused=new Map(),rows=[];
for(const r of payload){let scan=unique.get(r.sha256);if(!scan){const b=await fs.readFile(path.join(workspace,r.sourceRoot,r.sourcePath)),s=b.toString('utf8'),header=magic.find(([,h])=>b.subarray(0,h.length/2).toString('hex')===h)?.[0]??null,embedded=[];for(const match of s.matchAll(/(["'])([A-Za-z0-9+/]{32,}={0,2})\1/g)){const d=Buffer.from(match[2],'base64'),kind=magic.find(([,h])=>d.subarray(0,h.length/2).toString('hex')===h)?.[0];if(kind)embedded.push({kind,bytes:d.length,sha256:hash(d)});}const credentialLike=[];for(const match of s.matchAll(/"(password|secret|token|authorization)"\s*:\s*"((?:[^"\\]|\\.)*)"/gi))credentialLike.push({key:match[1],valueSha256:hash(match[2]),characters:match[2].length});scan={sha256:r.sha256,bytes:r.bytes,header,embeddedNativeBase64:embedded,credentialLikeJsonLiteralMatches:credentialLike,localWindowsUsernamePathMetadata:(s.match(/C:[\\/]+Users[\\/]+evanh|C:\\\\Users\\\\evanh/gi)??[]).length,emailCandidates:[...new Set(s.match(/[a-zA-Z0-9_.+-]+@[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}/g)??[])]};unique.set(r.sha256,scan);}const exclusion=scan.header!==null||scan.embeddedNativeBase64.length>0;const old=exclusion?null:priorShaMap.get(r.sha256);if(old&&!reused.has(r.sha256)){assert.deepEqual(await ident(path.join(repo,old.path)),{bytes:old.bytes,sha256:old.sha256});reused.set(r.sha256,old);}rows.push({...r,publication:exclusion?'local-digest-exclusion':'public-inert-source',publicPath:exclusion?null:old?.path??'products/rea-studio/results/editor-save-followup/evidence-blobs/'+r.sha256+'.snapshot',action:exclusion?'keep-local':old?'reuse-exact-installed-search-history':'add-exact-inert-blob'});}
const production=[];for(const rel of(await walk(path.join(repo,app))).filter(p=>!p.startsWith('results/')))production.push({path:app+rel,...await ident(path.join(repo,app,rel))});const install=[];for(const name of['client.mjs','server.mjs','README.md','save-publication.ui.test.mjs']){const source='work/editor-save-fix-next/'+app+name,candidate=await ident(path.join(workspace,source)),current=await ident(path.join(repo,app,name)).catch(e=>{if(e.code==='ENOENT')return null;throw e;});install.push({source,destination:app+name,action:current?'replace-exact':'add-exact',...candidate,existing:current});}
