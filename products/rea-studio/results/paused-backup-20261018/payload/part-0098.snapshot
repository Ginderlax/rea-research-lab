manuscript=manuscript.replace('The [routing contract](apps/automation/ROUTING.md) documents the finite runtime bounds and unsupported behavior.','The [routing contract](apps/automation/ROUTING.md) documents the finite runtime bounds and unsupported behavior. The [current recovery receipt](apps/automation/results/recovery-followup/integration-validation.json) passes74 groups, including ten added recovery and five HTTP boundary groups, with43 current source identities stable. Its raw original count is unchanged. The [independent review preservation](apps/automation/results/recovery-followup/independent-review/preservation-manifest.json) retains57 exact artifacts and the corrected source/guards review.');
manuscript=manuscript.replace('This does not cover the subsequently discovered recovery defects.','This predates the subsequently discovered recovery defects. A [fresh parent-owned current-source Automation check](results/browser-automation-recovery-20261012/validation.json) passed five checks on a separate newly started host: graph validation, revision1 save, a six-step completed run, and the same exact saved run after browser reload, with41 source identities unchanged. Reload is not a host restart; adversarial recovery and HTTP boundary proof comes from the74-check backend collection.');
manuscript=manuscript.replace('The final all-application validation count, recovery/collector follow-up identities and final publication record are inserted only after source-stable passing runs.',`The [current combined validation](results/development-validation.json) records **${pass}/${pass} passing tests**, zero skips/failures/cancellations/todo, and${sourceCount} exact source fingerprints unchanged throughout the run. Private generated data/original caches and inert historical test snapshots are excluded from runnable test discovery. The [current Sketch collector receipt](apps/sketch/results/collector-followup/integration-validation.json) records17 groups and five unchanged collector/test sources, with54 stage,27 adapter and21 independent-review artifacts preserved separately. The [Backup recorder receipt](apps/backup/results/rabin-recorder-review/integration-validation.json) records eight tests. The public commit identity is verified after publication in the ignored local publication receipt; no pre-publication commit is invented.`);
manuscript=manuscript.replace(/\b(Switch|Merge|restic|n8n|revision)(?=\d)/g,'$1 ').replace(/(records|contains|comprises|and|against|identical|interval|with|cases|exceeds|minimum|maximum|separate|unchanged|sources|of)(?=\d)/g,'$1 ').replace('The232','The 232').replace('The82','The 82').replace('public revisionb9','public revision b9');
write(join(studio,'RABIN-ROUTING-GEOMETRY-MILESTONE.md'),manuscript);
let rootReadme=read(join(lab,'README.md'));const rootOld='The current [compression and remote synchronization milestone](products/rea-studio/COMPRESSION-REMOTE-MILESTONE.md) adds compressed LZMA/LZMA2 archives, compressed restic v2 writing and generic WebDAV synchronization with 496 passing implemented-contract checks and 0 skips.';assert.ok(rootReadme.includes(rootOld));rootReadme=rootReadme.replace(rootOld,`The historical [compression and remote synchronization milestone](products/rea-studio/COMPRESSION-REMOTE-MILESTONE.md) preserves the 496-test checkpoint. The current [Rabin, workflow routing and drawing geometry milestone](products/rea-studio/RABIN-ROUTING-GEOMETRY-MILESTONE.md) adds bounded Rabin backup capture, Switch/Merge routing with recovery corrections, signed lines/diamonds and bounded test-process collection, with **${pass} passing implemented-contract checks and 0 skips**. It retains exact failures, source-bound original comparisons, real browser checks and two unaccepted Metrics experiments.`);write(join(lab,'README.md'),rootReadme);
let productReadme=read(join(studio,'README.md'));productReadme=productReadme.replace('The current record contains 496 passing tests and 0 skips. The [compression and remote synchronization milestone](COMPRESSION-REMOTE-MILESTONE.md) describes the current capabilities.',`The current record contains **${pass} passing tests and 0 skips**, with ${sourceCount} unchanged source fingerprints. The [Rabin, routing and drawing geometry milestone](RABIN-ROUTING-GEOMETRY-MILESTONE.md) describes the current capabilities, recovery corrections, original comparisons and unaccepted Metrics experiments. The [compression and remote synchronization milestone](COMPRESSION-REMOTE-MILESTONE.md) preserves the historical 496-test checkpoint.`).replace('[current compression/remote synchronization checks]','[historical compression/remote synchronization checks]');productReadme=productReadme.replace('exercise the local interfaces with synthetic data.','and [frozen Rabin/routing/geometry browser checks](results/milestones/rabin-routing-geometry-browser-20261012/snapshot-manifest.json) and [current Automation recovery browser checks](results/browser-automation-recovery-20261012/validation.json) exercise the local interfaces with synthetic data.');write(join(studio,'README.md'),productReadme);
