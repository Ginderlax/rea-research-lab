    {
      "id": "grafana.candidate.5a1d7091c769a3c930d3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana graphs now support Prometheus _exemplars_. They are displayed as diamonds in the graph visualization.",
      "headingPath": [
