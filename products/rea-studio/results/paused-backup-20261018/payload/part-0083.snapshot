const ledger=JSON.parse(bytes.get('manual-contracts.json')),binding=JSON.parse(bytes.get('existing-requirements-binding.json')),census=JSON.parse(bytes.get('carrier-census-manifest.json')),license=JSON.parse(bytes.get('license-provenance.json')),validation=JSON.parse(bytes.get('public-subset-validation.json'));
assert.equal(ledger.requirements.length,199);assert.equal(new Set(ledger.requirements.map(e=>e.id)).size,199);assert.deepEqual(ledger.requirements.map(e=>e.id),manifest.stableIds);assert.equal(ledger.counts.selectedTopics,10);assert.equal(binding.originalSourceFingerprintCount,159);assert.equal(binding.capabilityAreaIdCount,232);assert.equal(binding.existingRecordsModified,false);assert.equal(census.files.length,139);assert.equal(census.htmlTopics.length,45);assert.equal(census.fullManualRedistributed,false);assert.equal(license.documentationRedistributionGrantEstablished,false);assert.equal(validation.originalKeePassExecutions,0);assert.equal(validation.candidateAcceptanceExecutions,0);assert.equal(validation.exhaustiveAtomicDiscovery,false);assert.equal(sha(bytes.get('public-subset-validation.json')),'0a6a55197a153c23b71f1d3e5666073f8e51091870a6c78717141c48ac4c9154');
await fs.mkdir(target,{recursive:false});for(const[n,b]of bytes)await fs.writeFile(path.join(target,n),b,{flag:'wx'});
for(const[n,b]of bytes){assert.deepEqual(await fs.readFile(path.join(source,n)),b);assert.deepEqual(await fs.readFile(path.join(target,n)),b);}
