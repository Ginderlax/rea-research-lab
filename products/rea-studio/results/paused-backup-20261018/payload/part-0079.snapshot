        "lineStart": 50,
        "lineEnd": 50,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-0.md#L50-L50"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
          "cloud",
          "enterprise",
