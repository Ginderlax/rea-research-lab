    {
      "id": "grafana.candidate.62a07fc14344a2452579",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The new Explore inspector helps you understand and troubleshoot your queries. You can inspect the raw data, export that data to a comma-separated values (CSV) file, export log results in text format, and view query requests.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Grafana OSS features",
        "Inspector in Explore"
