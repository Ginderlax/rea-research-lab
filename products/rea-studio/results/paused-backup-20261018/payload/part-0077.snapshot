    },
    {
      "id": "grafana.candidate.44f0b03794876fcb13a5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The `vault` provider is only available in Grafana Enterprise.",
      "headingPath": [
