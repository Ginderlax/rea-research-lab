      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.38eabcac316afbc1c37d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Note that `tempdb`, `model`, `msdb`, and `master` system databases are not included in the query editor drop-down.",
      "headingPath": [
        "Microsoft SQL Server query editor",
        "Builder mode"
      ],
