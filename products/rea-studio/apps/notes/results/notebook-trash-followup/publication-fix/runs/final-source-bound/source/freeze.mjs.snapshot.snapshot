import fs from 'node:fs/promises';
import path from 'node:path';
import assert from 'node:assert/strict';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
const root=fileURLToPath(new URL('./',import.meta.url)),hash=b=>createHash('sha256').update(b).digest('hex');
async function identity(rel){const b=await fs.readFile(path.join(root,rel));return{path:rel,bytes:b.length,sha256:hash(b)};}
const baseline=JSON.parse(await fs.readFile(path.join(root,'baseline-reference.json'))),runs=[];for(const name of ['initial-unfixed','corrected-review','heldout-before-list-guard','heldout-after-list-guard','final-candidate','final-source-bound']){const rel='runs/'+name+'/validation.json',b=await fs.readFile(path.join(root,rel)),r=JSON.parse(b);assert.equal(r.sourceStable,true);assert.deepEqual(r.before,r.after);runs.push({name,receipt:await identity(rel),counts:r.counts,exit:r.exitCode,sourceStable:true});}
const final=JSON.parse(await fs.readFile(path.join(root,'runs/final-source-bound/validation.json')));assert.deepEqual(final.counts,{tests:55,pass:55,fail:0,skipped:0,cancelled:0});assert.equal(final.exitCode,0);for(const r of final.before)assert.deepEqual(await identity(r.path),r);
const changes=[];for(const r of baseline.records.filter(r=>!r.referenceOnly)){const current=await identity(r.path);if(current.sha256!==r.sha256)changes.push({path:r.path,before:{bytes:r.bytes,sha256:r.sha256},after:current});}assert.deepEqual(changes.map(r=>r.path).sort(),['products/rea-studio/apps/notes/client.mjs','products/rea-studio/apps/notes/server.mjs']);
const references=[];for(const[folder,name,expected]of[['../notes-trash-next/','preservation-manifest.json','aaa0b6f1f3fcf3b642e6cf23aec76b7596006cb39d49b073bac55b6af2af563b'],['../notes-trash-independent-review/','review-manifest.json','d6e485d9168f548709c69a30cd04e5fcc065cc6348892d3326606c34f0dff18f']]){const directory=fileURLToPath(new URL(folder,import.meta.url)),bytes=await fs.readFile(path.join(directory,name));assert.equal(hash(bytes),expected);const m=JSON.parse(bytes),rows=m.files??m.records;for(const r of rows){const b=await fs.readFile(path.join(directory,r.path));assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);}references.push({folder,name,sha256:expected,artifacts:rows.length,allUnchanged:true});}
const raw=await fs.readFile(path.join(root,'runs/final-source-bound/stdout.txt'),'utf8'),marker=name=>JSON.parse(new RegExp('^# (\\{\\"'+name+'\\".+)$','m').exec(raw)[1])[name],trash=marker('notebookTrashOriginal'),organization=marker('notebookOriginalObservations'),http=marker('notebookTrashHttp'),review=JSON.parse(await fs.readFile(path.join(root,'runs/final-source-bound/observations/review.json'))).find(r=>r.case==='held-out released restore');assert.equal(trash.topLevelOriginalExecutions,13);assert.equal(trash.matchedItemProjections,73);assert.equal(trash.displayComparisons,6);assert.equal(review.helperTopLevelExecutions,1);assert.equal(review.matchedScalarFields,55);assert.equal(review.matchedItemProjections,11);
const receipt={schema:'rea-notes-trash-publication-fix-validation/v1',at:new Date().toISOString(),candidate:'work/notes-trash-publication-fix-next',baselineReferences:references,baselineRecord:await identity('baseline-reference.json'),exactlyTwoModifiedCopiedSources:changes,focused:await identity('runs/final-source-bound/validation.json'),tests:55,pass:55,fail:0,skip:0,sourceStable:true,runHistory:runs,adapterTestBodiesUnchanged:baseline.adapters,originalEvidence:{tag:'v3.6.14',commit:'7e2765a3857754d12dbadea442b60ceaf9d4b23d',license:'AGPL-3.0-or-later',trash,organization,independentHeldOutRestore:{topLevelHelperCalls:1,itemProjections:11,scalarFields:55,bindings:review.bindings,originalCalls:review.originalCalls},fullApplication:0,originalDatabase:0,originalGUI:0,scope:review.scope},actualHostEvidence:http,ownedCorrectionBrowser:0,knownFindingsResolvedInFiniteCases:['old Save publisher overwrites enabled draft after notebook trash','new Trash/Restore input caller alias across serialization await','old post-Save list republishes after newer cascade refresh'],boundsInheritedUnchanged:true,stalePartialRunObservationCarriers:'Early partial collectors copied prior cached synthetic observations as well; counts are from exact per-run TAP and source snapshots, not summed carrier rows. Final collector clears its owned observation directory before running all selected tests.',productionModified:false,requirementsModified:false,oldReceiptsRebound:false,priorHistoryRecopied:false,fullParity:false,securityParity:false,superiority:false,ioPreemption:false,performanceMeasurements:false};await fs.writeFile(path.join(root,'validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
async function walk(dir=root,prefix=''){let rows=[];for(const e of await fs.readdir(dir,{withFileTypes:true})){assert.equal(e.isSymbolicLink(),false);const rel=prefix+e.name;if(e.isDirectory()){if(e.name!=='.local')rows.push(...await walk(path.join(dir,e.name),rel+'/'));}else if(!['manifest.json','freeze.json'].includes(rel))rows.push(await identity(rel));}return rows;}
const files=(await walk()).sort((a,b)=>a.path.localeCompare(b.path));await fs.writeFile(path.join(root,'manifest.json'),JSON.stringify({schema:'rea-strict-work-stage-preservation/v1',files,excludes:['manifest.json','freeze.json','.local/']},null,2)+'\n',{flag:'wx'});const freeze={schema:'rea-notes-publication-candidate-freeze/v1',at:new Date().toISOString(),validation:await identity('validation.json'),manifest:await identity('manifest.json'),files:files.length,runtime:await Promise.all(['client','server','notebook-trash','notebooks','jex','markdown'].map(n=>identity('products/rea-studio/apps/notes/'+n+'.mjs')))};await fs.writeFile(path.join(root,'freeze.json'),JSON.stringify(freeze,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(freeze));
