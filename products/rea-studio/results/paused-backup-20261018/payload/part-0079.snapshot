          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.5f792a9a4e9b3cd01ace",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For even more detail about all the changes in this release, refer to the [changelog](https://github.com/grafana/grafana/blob/main/CHANGELOG.md). For the specific steps we recommend when you upgrade to v13.0, check out our [Upgrade Guide](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/upgrade-guide/upgrade-v13.0/).",
      "headingPath": [
        "What’s new in Grafana v13.0"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v13-0.md",
        "gitBlobSha": "0290ff78ead554e3a462deaa51087b3ab943530f",
        "sha256": "2e78beb2d25d0ef9d9baaf0f550fe801ef07c3b4c40530fa699f1e5ee85a8ab6",
        "lineStart": 88,
        "lineEnd": 88,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v13-0.md#L88-L88"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b3179fffeed6433169d8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This release helps you build dashboards with less setup, connect more of your data securely, and get answers across your whole stack without leaving Grafana. Apply quick filters and grouping without configuring template variables, scope variables to the rows and tabs where they belong, and copy panel styling in a couple of clicks. Git Sync matures with verified commits, dashboard import, and root-level sync, bringing auditable GitOps to teams that require signed commits and branch protection. And Grafana Assistant now queries Snowflake, Jira, Dynatrace, and five more sources directly, so you can ask questions across your databases and observability data in one place.",
      "headingPath": [
        "What's new in Grafana v13.1"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v13-1.md",
        "gitBlobSha": "892f96e95a20e977e0b91bb69ca1d218fd23407f",
        "sha256": "81d73736b6dd18fc79161df06e97d6bc0fefe3d6c605a817f4e3ae2bc7982d7f",
        "lineStart": 50,
        "lineEnd": 50,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v13-1.md#L50-L50"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.88a48a6f42d61403c439",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For even more detail about all the changes in this release, refer to the [changelog](https://github.com/grafana/grafana/blob/main/CHANGELOG.md). For the specific steps we recommend when you upgrade to v13.1, check out our [Upgrade Guide](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/upgrade-guide/upgrade-v13.1/).",
      "headingPath": [
        "What's new in Grafana v13.1"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v13-1.md",
        "gitBlobSha": "892f96e95a20e977e0b91bb69ca1d218fd23407f",
        "sha256": "81d73736b6dd18fc79161df06e97d6bc0fefe3d6c605a817f4e3ae2bc7982d7f",
        "lineStart": 52,
        "lineEnd": 52,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v13-1.md#L52-L52"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.8142e9177117fed8746d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Saved queries are now generally available in Grafana Enterprise and Grafana Cloud, helping individual's knowledge become a library everyone can draw on: find them from anywhere using the command palette (cmd/ctrl+K) then quickly jump into Explore, and reliably manage them as code with Terraform.",
      "headingPath": [
        "What's new in Grafana v13.2"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v13-2.md",
        "gitBlobSha": "6515d00df452754dc37499c94b22f6dd7f73b130",
        "sha256": "2a4b1c2af797afa049fd208f839b0e6c53721825ca836aba74a751735c6e9653",
        "lineStart": 48,
        "lineEnd": 48,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v13-2.md#L48-L48"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.3dc50ac18bf38198074f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "View panel mode gains a controls sidebar in public preview, so you can adjust visualization options without edit permissions and fan a busy time series out into one graph per series or label to see which one is actually moving. Query variables get a redesigned editor, OpenSearch adds an index picker to configuration and query editing, and BigQuery and Google Cloud Monitoring can now authenticate with Google Workload Identity Federation in Grafana Cloud instead of a service account key file.",
      "headingPath": [
        "What's new in Grafana v13.2"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v13-2.md",
        "gitBlobSha": "6515d00df452754dc37499c94b22f6dd7f73b130",
