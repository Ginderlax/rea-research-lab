        "lineStart": 46,
        "lineEnd": 46,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/examples/multi-dimensional-alerts.md#L46-L46"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.7b4a450e78e5b9a90e83",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In Prometheus, each unique combination of labels defines a distinct time series. Grafana Alerting uses the same model: each label set is evaluated independently, and a separate alert instance is created for each series.",
      "headingPath": [
        "Example of multi-dimensional alerts on time series data"
      ],
      "source": {
        "path": "docs/sources/alerting/examples/multi-dimensional-alerts.md",
        "gitBlobSha": "bf496b32b55a4738ca06289b54503b871254f5b5",
