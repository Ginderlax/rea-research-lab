import fs from 'node:fs/promises';import path from 'node:path';import {spawnSync} from 'node:child_process';import assert from 'node:assert/strict';import {here,sha,authenticateOriginal} from './authenticate-original.mjs';
const names=['run-readiness.mjs','summary.mjs','summary.test.mjs','check-harnesses.mjs','harness.test.mjs','memory-runner.mjs','memory-worker.mjs','timing-runner.mjs','timing-worker.mjs','benchmark.mjs','canonical.mjs','workloads.mjs','authenticate-original.mjs','watch-owned-process.ps1','parse-observer.ps1','memory-preflight.control.json','candidate-algorithm.mjs','selector-algorithm.mjs','candidate-baseline.mjs'],before={},attempt='readiness-attempt-'+Date.now(),steps=[],authority=await authenticateOriginal();
await fs.mkdir(path.join(here,'preserved',attempt),{recursive:true});for(const name of names){const bytes=await fs.readFile(path.join(here,name));before[name]=sha(bytes);await fs.writeFile(path.join(here,'preserved',attempt,name),bytes,{flag:'wx'});}
for(const task of [{name:'signed-summary-tests',args:['--test',path.join(here,'summary.test.mjs')]},{name:'nonmeasuring-harness-preflight',args:[path.join(here,'check-harnesses.mjs')]}]){
 const startedAt=new Date().toISOString(),child=spawnSync(process.execPath,task.args,{encoding:'utf8',timeout:60000,maxBuffer:4*1024*1024,windowsHide:true}),stem=attempt+'-'+task.name;
 await fs.writeFile(path.join(here,'results',stem+'.stdout.txt'),child.stdout??'',{flag:'wx'});await fs.writeFile(path.join(here,'results',stem+'.stderr.txt'),child.stderr??'',{flag:'wx'});steps.push({task:task.name,startedAt,completedAt:new Date().toISOString(),exitCode:child.status,signal:child.signal,error:child.error?.message,stdout:{path:'results/'+stem+'.stdout.txt',sha256:sha(child.stdout??'')},stderr:{path:'results/'+stem+'.stderr.txt',sha256:sha(child.stderr??'')}});console.log(JSON.stringify(steps.at(-1)));if(child.status!==0)break;
}
const after={};for(const name of names)after[name]=sha(await fs.readFile(path.join(here,name)));assert.deepEqual(before,after);for(const[file,digest]of Object.entries(authority.files))assert.equal(sha(await fs.readFile(file)),digest);
const receipt={schemaVersion:1,checkedAt:new Date().toISOString(),status:steps.length===2&&steps.every(row=>row.exitCode===0)?'passed':'failed',sourceHashesBefore:before,sourceHashesAfter:after,authority,steps,timingMeasurementRun:false,memoryMeasurementRun:false,profileRun:false,measurementBranchExecutionTested:false,scope:'Synthetic signed/censoring summaries plus guard/observer-syntax and correctness-only fresh/cache checks on fixed inputs. No measured loops, snapshots or observer execution.'};await fs.writeFile(path.join(here,'results',attempt+'.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({receipt:attempt+'.json',status:receipt.status}));if(receipt.status!=='passed')process.exitCode=1;
