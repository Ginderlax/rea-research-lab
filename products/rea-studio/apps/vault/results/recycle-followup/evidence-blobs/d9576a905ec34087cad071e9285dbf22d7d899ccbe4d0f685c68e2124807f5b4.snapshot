import test,{after}from'node:test';import assert from'node:assert/strict';import fs from'node:fs/promises';import os from'node:os';import path from'node:path';import{spawn}from'node:child_process';
import{importKdbx,materializeKdbxDocument}from'./kdbx.mjs';import{one,nodes,text}from'./xml.mjs';
const observations=[],master='Synthetic recycle HTTP master',output=path.resolve(import.meta.dirname,'../../../..','.local/recycle-http-observations.json');
after(async()=>{await fs.mkdir(path.dirname(output),{recursive:true});await fs.writeFile(output,JSON.stringify({observations,hostProcesses:observations.filter(e=>e.event==='host').length,originalExecutions:0},null,2)+'\n');console.log('REA_RECYCLE_HTTP '+JSON.stringify({detail:output,hostProcesses:observations.filter(e=>e.event==='host').length,originalExecutions:0}));});
async function temp(t){const dir=await fs.mkdtemp(path.join(os.tmpdir(),'rea-recycle-http-'));t.after(async()=>{assert.equal(path.dirname(dir),path.resolve(os.tmpdir()));assert(path.basename(dir).startsWith('rea-recycle-http-'));await fs.rm(dir,{recursive:true,force:true});});return dir;}
async function host(dir){const env={...process.env};delete env.NODE_TEST_CONTEXT;const p=spawn(process.execPath,[path.join(import.meta.dirname,'http-runner.mjs'),dir],{env,windowsHide:true,stdio:['ignore','pipe','pipe','ipc']});let bytes=0,logs='',problem;const deadline=setTimeout(()=>{problem='Host30-second deadline';p.kill()},30000);for(const stream of[p.stdout,p.stderr])stream.on('data',b=>{bytes+=b.length;if(bytes>1024*1024){problem='Host logs exceed1MiB';p.kill()}else logs+=b.toString()});const ready=await new Promise((resolve,reject)=>{p.once('message',resolve);p.once('error',reject);p.once('exit',code=>reject(new Error('Host exited before ready '+code+' '+logs)));});observations.push({event:'host',pid:p.pid,url:ready.url});let closed=false;return{...ready,async close(){if(closed)return;closed=true;await new Promise((r,j)=>{const timer=setTimeout(()=>{p.kill();j(new Error('Host5-second cleanup deadline'))},5000);p.once('exit',code=>{clearTimeout(timer);clearTimeout(deadline);observations.push({event:'closed',pid:p.pid,code,problem,logs});code===0&&!problem?r():j(new Error(problem??logs))});p.send('close')})},async api(action,input={},expected=200){const response=await fetch(ready.url+'/api/vault/'+action,{method:'POST',headers:{'content-type':'application/json','x-rea-token':ready.token},body:JSON.stringify(input),signal:AbortSignal.timeout(10000)}),value=await response.json();assert.equal(response.status,expected,action+' '+JSON.stringify(value));observations.push({event:'request',action,status:response.status});return expected===200?value.result:value}};}
test('actual shared HTTP host persists native bin/history/recovery/tombstones through three genuine process starts',async t=>{const dir=await temp(t);let h=await host(dir);t.after(()=>h.close());await h.api('create',{password:master});const seed={title:'HTTP recycle λ',group:'Previous/Child',password:'Synthetic first',notes:'Synthetic private notes'},id=(await h.api('save',seed)).id;await h.api('save',{...seed,id,password:'Synthetic current'});const selected=(await h.api('read',{id})).entry;await h.api('recycleDelete',{id,revision:selected.recycleRevision,confirm:false},400);const record=path.join(dir,'vault/records/vault.database.json'),before=await fs.readFile(record,'utf8');await h.api('recycleDelete',{id,revision:'0'.repeat(64),confirm:true},400);assert.equal(await fs.readFile(record,'utf8'),before);
 await h.api('recycleDelete',{id,revision:selected.recycleRevision,confirm:true});assert.equal((await h.api('list')).entries.length,0);await h.api('read',{id},400);const listed=(await h.api('recycleList')).entries[0];assert(!JSON.stringify(listed).includes('Synthetic current'));assert(!Object.hasOwn(listed,'notes'));assert(!Object.hasOwn(listed,'totpSecret'));assert(!Object.hasOwn(listed,'password'));await h.close();h=await host(dir);assert.equal((await h.api('status')).locked,true);await h.api('recycleList',{},400);await h.api('unlock',{password:master});const bin=(await h.api('recycleList')).entries[0];assert.equal(bin.id,id);const preview=(await h.api('recycleRead',{id,revision:bin.recycleRevision})).entry;assert.equal(preview.password,'Synthetic current');assert.equal(preview.notes,seed.notes);await h.api('recycleRestore',{id,revision:bin.recycleRevision,confirm:true});const active=(await h.api('read',{id})).entry;assert.equal(active.group,seed.group);assert.equal((await h.api('historyList',{id})).revisions.length,1);
 await h.close();h=await host(dir);await h.api('unlock',{password:master});const reloaded=(await h.api('read',{id})).entry;assert.equal(reloaded.password,'Synthetic current');assert.equal((await h.api('historyList',{id})).revisions.length,1);await h.api('recycleDelete',{id,revision:reloaded.recycleRevision,confirm:true,permanent:true});const exported=await h.api('exportKdbx',{password:master,options:{kdf:'aes',rounds:100}}),native=await importKdbx(Buffer.from(exported.fileBase64,'base64'),{password:master}),xml=materializeKdbxDocument(native);assert.equal(native.entries.length,0);const deleted=nodes(one(one(xml,'Root'),'DeletedObjects'),'DeletedObject');assert.equal(deleted.length,1);assert.equal(Buffer.from(text(one(deleted[0],'UUID')),'base64').toString('hex'),id.replaceAll('-',''));const disk=await fs.readFile(record,'utf8');for(const secret of['Synthetic current',seed.password,seed.notes])assert(!disk.includes(secret));observations.push({event:'persistenceAssertions',historyRetained:true,uuidRecovered:true,tombstoneUUID:id,encryptedSecretsAbsent:true});});
test('actual host retains token guard, entry-only rejection and private runtime/oracle/source routes',async t=>{const dir=await temp(t),h=await host(dir);t.after(()=>h.close());const denied=await fetch(h.url+'/api/vault/recycleList',{method:'POST',headers:{'content-type':'application/json'},body:'{}'});assert.equal(denied.status,403);await h.api('create',{password:master});const paths=[['/apps/vault/client.mjs',200],['/apps/vault/server.mjs',404],['/apps/vault/recycle.mjs',404],['/apps/vault/recycle-oracle.ps1',404],['/apps/vault/harness.mjs',404],['/apps/vault/history.mjs',404],['/apps/vault/results/recycle/source-study.json',404]];for(const[url,expected]of paths){const response=await fetch(h.url+url);await response.arrayBuffer();assert.equal(response.status,expected,url);observations.push({event:'route',url,status:response.status});}const record=path.join(dir,'vault/records/vault.database.json'),before=await fs.readFile(record,'utf8');for(const action of['deleteGroup','recycleGroup','emptyRecycleBin'])await h.api(action,{confirm:true},400);assert.equal(await fs.readFile(record,'utf8'),before);});
