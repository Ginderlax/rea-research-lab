          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.880f53e55bbf6d7b19ba",
      "syntaxRole": "list-item",
      "sourceText": "- **maplibre** loads a custom tile server defined by the user. Set a valid style `url` for this option to properly load a default base map. Here's an example:",
      "headingPath": [
        "Geomap",
        "Configuration options",
        "Basemap layer options",
        "Configure the default base layer with provisioning"
      ],
