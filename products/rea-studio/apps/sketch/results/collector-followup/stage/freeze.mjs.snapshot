import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),product=path.resolve(here,'../../outputs/rea-research-lab/products/rea-studio'),digest=b=>createHash('sha256').update(b).digest('hex'),receipt=JSON.parse(await fs.readFile(path.join(here,'validation.json')));
assert.equal(receipt.passed,true);assert.equal(receipt.geometrySuiteRerun,false);assert.equal(receipt.productionBytesUnchanged,true);
for(const row of receipt.sourceBefore){assert.equal(digest(await fs.readFile(path.join(here,row.path))),row.sha256);assert.equal(digest(await fs.readFile(path.join(here,receipt.runDirectory,'sources',row.path))),row.sha256);}
for(const row of receipt.productionBefore)assert.equal(digest(await fs.readFile(path.join(product,row.path))),row.sha256);
for(const row of receipt.artifacts)assert.equal(digest(await fs.readFile(path.join(here,row.path))),row.sha256);
async function inventory(folder,prefix=''){const files=[];for(const item of await fs.readdir(folder,{withFileTypes:true})){const name=prefix+item.name;if(name==='freeze-validation.json')continue;assert.ok(!item.isSymbolicLink());if(item.isDirectory()){assert.ok(!item.name.startsWith('owned-'));files.push(...await inventory(path.join(folder,item.name),name+'/'));}else{const bytes=await fs.readFile(path.join(folder,item.name));files.push({path:name,bytes:bytes.length,sha256:digest(bytes)});}}return files.sort((a,b)=>a.path.localeCompare(b.path));}
const frozen={schema:'rea-sketch-bounded-collector-stage-freeze/v1',frozenAtUtc:new Date().toISOString(),validationSha256:digest(await fs.readFile(path.join(here,'validation.json'))),files:await inventory(here),productionBefore:receipt.productionBefore,scope:'All candidate, synthetic regression, raw observation, exact baseline and historical geometry evidence bytes frozen. No production/results mutation or geometry28 rerun. Bootstrap/fingerprint I/O has no hard deadline; Windows tree cleanup is not race-free isolation.'};
await fs.writeFile(path.join(here,'freeze-validation.json'),JSON.stringify(frozen,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({files:frozen.files.length,sha256:digest(await fs.readFile(path.join(here,'freeze-validation.json')))}));
