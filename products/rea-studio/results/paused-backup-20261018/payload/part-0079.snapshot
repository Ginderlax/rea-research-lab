      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.f6fa2fce0fcb7203e1cd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "[Configuration](../../setup-grafana/configure-grafana/#hidden_users) has been updated for this feature.",
