import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),stage=path.resolve(here,'../sketch-collector-next'),digest=b=>createHash('sha256').update(b).digest('hex'),freezeBytes=await fs.readFile(path.join(stage,'freeze-validation.json'));assert.equal(digest(freezeBytes),'59629ecca2019b50da247e4226498d583a65d503ae47350a47b0fe7499c88765');const frozen=JSON.parse(freezeBytes);for(const row of frozen.files)assert.equal(digest(await fs.readFile(path.join(stage,row.path))),row.sha256,'Frozen stage exact bytes');
const copies=[['candidate/verify-sketch-geometry.mjs','candidate/scripts/verify-sketch-geometry.mjs'],['candidate/sketch-collector-process.mjs','candidate/scripts/sketch-collector-process.mjs'],['fixtures/runner.mjs','candidate/tests/fixtures/sketch-collector/runner.mjs'],['fixtures/descendant.mjs','candidate/tests/fixtures/sketch-collector/descendant.mjs']],mapping=[];
for(const [from,to] of copies){const bytes=await fs.readFile(path.join(stage,from)),output=path.join(here,to);await fs.mkdir(path.dirname(output),{recursive:true});await fs.writeFile(output,bytes,{flag:'wx'});mapping.push({stagePath:from,candidatePath:to,adaptation:'Exact copy',sha256:digest(bytes)});}
const original=await fs.readFile(path.join(stage,'runner.test.mjs'),'utf8');let test=original;
function replace(from,to){assert.equal(test.split(from).length,2,'Unique production-test adapter anchor');test=test.replace(from,to);}
replace("import {fileURLToPath} from 'node:url';","import {fileURLToPath} from 'node:url';import os from 'node:os';");
replace("from './candidate/sketch-collector-process.mjs'","from '../scripts/sketch-collector-process.mjs'");
replace("const here=path.dirname(fileURLToPath(import.meta.url)),fixture=path.join(here,'fixtures/runner.mjs'),records=[];","const fixture=fileURLToPath(new URL('./fixtures/sketch-collector/runner.mjs',import.meta.url)),scratchParent=os.tmpdir(),here=await fs.mkdtemp(path.join(scratchParent,'rea-sketch-collector-')),records=[];");
const tail=test.indexOf('test.after(async()=>');assert.ok(tail>0);test=test.slice(0,tail)+"test.after(async()=>{try{const supplied=process.env.REA_SKETCH_COLLECTOR_REGRESSION_DIR,directory=supplied?path.resolve(supplied):here;assert.equal(path.dirname(directory),scratchParent);assert.ok(path.basename(directory).startsWith('rea-sketch-collector-'));await fs.writeFile(path.join(directory,'observations.json'),JSON.stringify({schema:'rea-sketch-collector-synthetic-regressions/v1',createdAt:new Date().toISOString(),runtime:process.version,platform:process.platform,records,scope:'Only owned synthetic Node processes/source files; os.tmpdir data, no tests-dir/apps-results writes or geometry28 rerun.'},null,2)+'\\n',{flag:'wx'});console.log('SKETCH_COLLECTOR_OBSERVATIONS '+JSON.stringify({groups:17,recordedChildExecutions:records.length}));}finally{assert.equal(path.dirname(here),scratchParent);assert.ok(path.basename(here).startsWith('rea-sketch-collector-'));await fs.rm(here,{recursive:true,force:true});}});\n";
const candidatePath='candidate/tests/sketch-collector.test.mjs';await fs.writeFile(path.join(here,candidatePath),test,{flag:'wx'});mapping.push({stagePath:'runner.test.mjs',stageSha256:digest(original),candidatePath,sha256:digest(test),adaptation:'Production-relative scripts import and explicit tests/fixtures/sketch-collector path; privately owned os.tmpdir fixtures/observations, bounded caller-selected temp sink, cleanup and small count marker. No assertions changed.'});
await fs.writeFile(path.join(here,'adaptation.json'),JSON.stringify({schema:'rea-sketch-collector-production-adapter/v1',createdAt:new Date().toISOString(),frozenStageSha256:digest(freezeBytes),mapping,scope:'Staged proposed production paths only, no production edits. Exact frozen collector/helper/fixtures; test adaptation explicit. No geometry28 rerun.'},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({mapping:mapping.length}));
