    {
      "id": "grafana.candidate.1001f4efa4cbaf21d947",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana provides a query editor for the Azure Monitor data source, which is located on the [Explore page](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/explore/). You can also access the Azure Monitor query editor from a dashboard panel. Click the menu in the upper right of the panel and select **Edit**.",
      "headingPath": [
        "Azure Monitor query editor"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/query-editor/index.md",
