      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.39137a72ea017d08f223",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Access policies and tokens must have a unique combination of name, org ID, and region.",
      "headingPath": [
        "Grafana Cloud API",
        "Access policies and tokens"
      ],
      "source": {
