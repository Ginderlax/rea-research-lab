import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,sha=b=>createHash('sha256').update(b).digest('hex'),raw=await fs.readFile(path.join(here,'observations/proposal-standalone.stdout.txt'),'utf8'),records=raw.trim().split(/\r?\n/).map(s=>JSON.parse(s));assert.equal(records.length,2);assert.equal(records[0].schema,'rea-notes-vault-public-proof-verification/v1');assert.equal(records[0].installedFiles,34);assert.equal(records[0].newBehaviorTests+records[0].newOriginalExecutions,0);const result=records[1];assert.equal(result.editorHostTransition.addedStaticMapLineBytes,99);assert.equal(result.editorHostTransition.authenticatedRootRoutePayloads,51);assert.equal(result.editorHostTransition.onlyEditorSaveLiveMismatch,true);assert.equal(result.editorHostTransition.currentEditorOther30RowsMandatory,true);assert.equal(result.editorHostTransition.currentSharedHostOther2RowsMandatory,true);assert.equal(result.editorVerification.liveSourceMatch,false);assert.equal(result.editorVerification.liveMismatches.length,1);await fs.mkdir(path.join(here,'failures/wrapper-single-json-premise-v1'),{recursive:true});const wrapper=await fs.readFile(path.join(here,'run-proposal.mjs'));await fs.writeFile(path.join(here,'failures/wrapper-single-json-premise-v1/run-proposal.mjs.snapshot'),wrapper,{flag:'wx'});let error;try{JSON.parse(raw);}catch(e){error={name:e.name,message:e.message};}assert.equal(error.name,'SyntaxError');await fs.writeFile(path.join(here,'failures/wrapper-single-json-premise-v1/diagnostic.json'),JSON.stringify({wrapperExitCode:1,parentExitCode:0,sourceSHA256:sha(wrapper),rawStdoutPath:'observations/proposal-standalone.stdout.txt',error,premise:'Imported Notes verifier also emits standalone JSON under the same CLI flag; original parent CLI behavior has multiple JSON records.',correction:'Read both retained JSON lines and use the explicit final parent transition record; no parent rerun or source modification.',productOrProposalFailure:false,rawRetained:true},null,2)+'\n',{flag:'wx'});await fs.writeFile(path.join(here,'observations/proposal-records.json'),JSON.stringify({sourceOnly:true,parentExitCode:0,wrapperParseAttemptExitCode:1,decodedRecords:records.length,notesVaultImportedStandalone:records[0],parent:result,rawSHA256:sha(raw),rawPreserved:true,reparseOnly:true,newAppTestOriginalBrowserHostExecutions:0},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({parentExitCode:0,records:2,sourceOnly:true,transition:result.editorHostTransition,childSchema:result.editorVerification.schema}));
