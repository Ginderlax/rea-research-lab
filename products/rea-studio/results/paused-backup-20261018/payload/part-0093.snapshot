def need(condition,label):
 if not condition: raise AssertionError(label)
def safe(name):
 need(isinstance(name,str) and name and len(name)<=4096 and not name.startswith('/') and not re.search(r'[\\:\x00-\x1f\x7f]',name),'Safe portable path')
 need(all(p and p not in ('.','..') for p in name.split('/')),'Safe portable components');return name
def parsed(data): return json.loads(data.decode('utf-8-sig'))
def utc(value):
 need(isinstance(value,str) and re.fullmatch(r'\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{3}Z',value),'Exact millisecond UTC')
 result=datetime.datetime.fromisoformat(value.replace('Z','+00:00'));need(result.isoformat(timespec='milliseconds').replace('+00:00','Z')==value,'Round-trip UTC');return result
if len(sys.argv)==4 and sys.argv[1]=='--peek':
 source=Path(sys.argv[2]).resolve();expected=sys.argv[3];base=Path(__file__).resolve().parent/'cloud-verification-backups'
 need(source.is_relative_to(base.resolve()) and re.fullmatch(r'[0-9a-f]{64}',expected),'Owned bounded header discovery')
 content=source.read_bytes();need(len(content)<=32*1024*1024 and sha(content)==expected,'Exact API-bound header ZIP')
 with zipfile.ZipFile(io.BytesIO(content)) as outer:
  entries=outer.infolist();need(len(entries)<=4 and sum(e.file_size for e in entries)<=32*1024*1024,'Bounded outer header container')
  leaves=[e for e in entries if not e.is_dir()];need(len(leaves)==1 and leaves[0].filename.endswith('.zip') and leaves[0].file_size<=15*1024*1024,'One bounded inner header ZIP')
  for entry in entries: safe(entry.filename.rstrip('/'));need(not stat.S_ISLNK(entry.external_attr>>16) and not entry.flag_bits&1,'Regular header carrier')
  inner=outer.read(leaves[0])
 with zipfile.ZipFile(io.BytesIO(inner)) as archive:
  entries=archive.infolist();need(len(entries)<=96 and sum(e.file_size for e in entries)<=35*1024*1024 and all(e.file_size<=12*1024*1024 for e in entries),'Fixed inner header boundaries')
  names=[e.filename for e in entries];need(len({n.casefold() for n in names})==len(names),'Unique header members')
  for entry in entries: safe(entry.filename.rstrip('/'));need(not stat.S_ISLNK(entry.external_attr>>16) and not entry.flag_bits&1,'Regular header member')
  found=[e for e in entries if e.filename=='attempt-validation.json'];need(len(found)<=1,'One producer receipt header')
  if found: need(found[0].file_size<=256*1024,'Bounded receipt header')
  receipt=parsed(archive.read(found[0])) if found else None
 candidate=receipt.get('sourceCommit') if isinstance(receipt,dict) else None
 need(candidate is None or isinstance(candidate,str) and re.fullmatch(r'[0-9a-f]{40}',candidate),'Discovered source SHA syntax')
 print(json.dumps({'schema':'rea-data-only-publication-header-discovery/v1','sourceCommit':candidate,'receiptPresent':receipt is not None,'scope':'Unqualified sourceCommit discovery for read-only actual Git API retrieval; no source/product/publication acceptance.'}));sys.exit(0)
need(len(sys.argv)==5,'ZIP SHA256 raw-control-folder artifact-ID')
source=Path(sys.argv[1]).resolve();expected=sys.argv[2];control=Path(sys.argv[3]).resolve();artifact_id=sys.argv[4]
base=Path(__file__).resolve().parent/'cloud-verification-backups'
need(source.is_relative_to(base.resolve()) and source.is_file() and control.is_relative_to(base.resolve()) and control.is_dir(),'Owned backup/API directories')
need(re.fullmatch(r'[0-9a-f]{64}',expected) and artifact_id.isdigit(),'Artifact identity syntax')
raw=source.read_bytes();need(len(raw)<=32*1024*1024 and sha(raw)==expected,'Bounded exact uploaded ZIP')
folder=source.parent/(source.stem+'-notes36-publication-reader-v1');folder.mkdir(exist_ok=False)
def unpack(data,directory,entries_limit,raw_limit,file_limit):
 directory.mkdir(parents=True,exist_ok=False);rows=[];seen=set()
 with zipfile.ZipFile(io.BytesIO(data)) as zipped:
  entries=zipped.infolist();need(len(entries)<=entries_limit and sum(x.file_size for x in entries)<=raw_limit,'Fixed ZIP count/raw bound')
  for entry in entries:
   name=entry.filename;normal=name[:-1] if entry.is_dir() else name;safe(normal)
   need(normal.casefold() not in seen,'Unique case-independent ZIP path');seen.add(normal.casefold())
   need(not entry.flag_bits&1 and not stat.S_ISLNK(entry.external_attr>>16) and entry.file_size<=file_limit,'Regular unencrypted bounded member')
   file=(directory/name).resolve();need(file.is_relative_to(directory.resolve()),'Owned recovery path')
   if entry.is_dir(): file.mkdir(parents=True,exist_ok=True);continue
   content=zipped.read(entry);need(len(content)==entry.file_size,'Complete CRC-checked bytes');file.parent.mkdir(parents=True,exist_ok=True)
   with file.open('xb') as stream: stream.write(content)
   need(file.read_bytes()==content,'Readable exact member');rows.append({'path':name,**identity(content)})
 return rows
outer=folder/'downloaded-contents';outer_rows=unpack(raw,outer,4,32*1024*1024,16*1024*1024)
need(len(outer_rows)==1 and outer_rows[0]['path'].endswith('.zip'),'Exactly one portable inner ZIP')
inner=(outer/outer_rows[0]['path']).read_bytes();need(len(inner)<=15*1024*1024,'Unchanged15MiB portable ZIP boundary')
evidence=folder/'readable-evidence';files=unpack(inner,evidence,96,35*1024*1024,12*1024*1024);members={r['path']:r for r in files}
result={'schema':'rea-local-current36-publication-backup/v1','runId':RUN,'headSHA':HEAD,'jobId':JOB,'artifactId':artifact_id,'artifact':str(source),'artifactIdentity':identity(raw),
 'portableEvidenceArchive':str(outer/outer_rows[0]['path']),'portableEvidenceArchiveIdentity':identity(inner),'readableEvidence':str(evidence),'files':files,'allCRCAndBytesReadable':True,
 'rawBytesPreservedBeforeQualification':True,'publicationAcceptance':False,'qualification':{},'auditErrors':[],
 'localCandidateExecutions':0,'localProductExecutions':0,'localTests':0,'localBuilds':0,'localSyntaxChecks':0,'applicationBehaviorAccepted':False,'installationJournalAuthenticated':False,'fullDevelopmentSuiteAcceptance':False,'fullParity':False,'superiority':False,
 'scope':'This data-only reader authenticates preserved publication evidence. Source-byte qualification, historical32 view, current36 view and306-control/two-phase publication acceptance are separate; no application or original product is executed.'}
def data(name):
 safe(name);need(name in members,'Missing uploaded role '+name);content=(evidence/name).read_bytes();need(identity(content)=={k:members[name][k] for k in ('bytes','sha256')},'Member readback identity');return content
def item(name): return parsed(data(name))
def stage(name,operation):
 try:
  value=operation();result['qualification'][name]={'valid':True,'value':value};return value
 except Exception as error:
  result['qualification'][name]={'valid':False,'errorType':type(error).__name__,'error':str(error)};result['auditErrors'].append({'stage':name,'errorType':type(error).__name__,'error':str(error)});return None
attempt=None
if 'attempt-validation.json' in members:
 try: attempt=item('attempt-validation.json')
