import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs/promises';import path from'node:path';import{render}from'./client.mjs';import{handle,dispose}from'./server.mjs';import{createWorkspace}from'../../lib/storage.mjs';
class Element{constructor(tag){this.tagName=tag;this.children=[];this.attributes={};this._value='';this.textContent='';this.disabled=false;this.checked=false;this.style={};this.selectionStart=this.selectionEnd=0;}get value(){return this._value;}set value(v){const value=this.tagName==='textarea'?String(v).replace(/\r\n?/g,'\n'):String(v);if(value!==this._value){this._value=value;if(this.tagName==='textarea')this.selectionStart=this.selectionEnd=value.length;}}append(...n){this.children.push(...n);}prepend(...n){this.children.unshift(...n);}replaceChildren(...n){this.children=[...n];}insertBefore(n,b){const at=this.children.indexOf(b);this.children.splice(at<0?this.children.length:at,0,n);}setAttribute(n,v){this.attributes[n]=v;}focus(){this.focused=true;}setSelectionRange(a,b){this.selectionStart=a;this.selectionEnd=b;}}
const all=n=>[n,...n.children.flatMap(all)],field=(r,l)=>all(r).find(n=>n.attributes['aria-label']===l),button=(r,l)=>all(r).find(n=>n.tagName==='button'&&n.textContent===l),deferred=()=>{let resolve;const promise=new Promise(r=>resolve=r);return{resolve,promise};};
const base=path.resolve(import.meta.dirname,'../../../../../.local/pattern-ui');
async function fixture(t,wrapper){await fs.mkdir(base,{recursive:true});const folder=await fs.mkdtemp(path.join(base,'owned-')),workspace=await createWorkspace(folder);await fs.writeFile(workspace.resolve('a.txt'),'🧪cat cats\r\nnext cat\n');await fs.writeFile(workspace.resolve('b.txt'),'B saved cat\n');const old={document:globalThis.document,window:globalThis.window};globalThis.document={createElement:n=>new Element(n)};globalThis.window={confirm:()=>true};const root=new Element('main'),calls=[];const api=async(action,input)=>{calls.push({action,input:structuredClone(input)});const real=()=>action==='gitStatus'?{initialized:false}:handle({action,input,workspace});return wrapper?wrapper(action,input,real):real();};const cleanup=await render(root,api);t.after(async()=>{cleanup();await dispose(workspace);globalThis.document=old.document;globalThis.window=old.window;assert.equal(path.dirname(folder),base);await fs.rm(folder,{recursive:true,force:true});});return{root,workspace,calls,cleanup};}
async function search(root,query){field(root,'Find in saved files').value=query;await button(root,'Search saved files').onclick();}
test('actual accessible toggles submit literal defaults then whole-word and regex with exact CRLF navigation',async t=>{
 const f=await fixture(t),word=field(f.root,'Whole word in workspace search'),regex=field(f.root,'Regular expression in workspace search');assert.equal(word.checked,false);assert.equal(regex.checked,false);await search(f.root,'cat');assert.deepEqual(f.calls.find(x=>x.action==='search').input,{query:'cat',matchCase:true,wholeWord:false,useRegex:false});assert.ok(button(f.root,'a.txt:1:7'));
 word.checked=true;word.onchange();assert.equal(field(f.root,'Workspace search results').children.length,0);await search(f.root,'cat');assert.equal(button(f.root,'a.txt:1:7'),undefined);assert.ok(button(f.root,'a.txt:1:3'));
 word.checked=false;word.onchange();regex.checked=true;regex.onchange();await search(f.root,'^next\\s+cat$');await button(f.root,'a.txt:2:1').onclick();const editor=field(f.root,'File contents');assert.equal(editor.value,'🧪cat cats\nnext cat\n');assert.equal(editor.selectionStart,11);assert.equal(editor.selectionEnd,19);assert.equal(editor.focused,true);
});
test('invalid regex displays explicit error and does not retain older literal results',async t=>{
 const f=await fixture(t);await search(f.root,'cat');const regex=field(f.root,'Regular expression in workspace search');regex.checked=true;regex.onchange();await search(f.root,'[');assert.equal(field(f.root,'Workspace search results').children.length,0);assert.equal(button(f.root,'Search saved files').disabled,false);assert.ok(all(f.root).some(n=>n.attributes.role==='status'&&/Invalid or unsupported/.test(n.textContent)));assert.equal(await fs.readFile(f.workspace.resolve('a.txt'),'utf8'),'🧪cat cats\r\nnext cat\n');
});
test('changing new pattern options rejects a held search publication and permits a fresh retry',async t=>{
 const arrived=deferred(),release=deferred();let held=true;const f=await fixture(t,async(a,i,real)=>{const data=await real();if(a==='search'&&held){arrived.resolve();await release.promise;}return data;});const pending=search(f.root,'cat');await arrived.promise;const word=field(f.root,'Whole word in workspace search');word.checked=true;word.onchange();release.resolve();await pending;assert.equal(field(f.root,'Workspace search results').children.length,0);held=false;await button(f.root,'Search saved files').onclick();assert.ok(button(f.root,'a.txt:1:3'));assert.equal(button(f.root,'a.txt:1:7'),undefined);
});
for(const option of['Whole word in workspace search','Regular expression in workspace search'])test(`held result read cannot replace dirty B after changing ${option}`,async t=>{
 const arrived=deferred(),release=deferred(),f=await fixture(t,async(a,i,real)=>{const data=await real();if(a==='read'&&i.path==='a.txt'){arrived.resolve();await release.promise;}return data;});await button(f.root,'b.txt').onclick();await search(f.root,'cat');const pending=button(f.root,'a.txt:1:3').onclick();await arrived.promise;const control=field(f.root,option);control.checked=true;control.onchange();const editor=field(f.root,'File contents');editor.value='B newer unsaved draft';editor.oninput();release.resolve();await pending;assert.equal(editor.value,'B newer unsaved draft');assert.equal(field(f.root,'Workspace search results').children.length,0);assert.equal(button(f.root,'a.txt •'),undefined);
});
test('regex results while real Save response is held preserve typed draft and later exact revision retry',async t=>{
 const arrived=deferred(),release=deferred();let held=true;const f=await fixture(t,async(a,i,real)=>{const data=await real();if(a==='save'&&held){arrived.resolve();await release.promise;}return data;});await button(f.root,'a.txt').onclick();const editor=field(f.root,'File contents');editor.value='saved cat\n';editor.oninput();const pending=button(f.root,'Save file').onclick();await arrived.promise;assert.equal(await fs.readFile(f.workspace.resolve('a.txt'),'utf8'),'saved cat\n');editor.value='newer draft cat\n';editor.oninput();field(f.root,'Regular expression in workspace search').checked=true;await search(f.root,'^saved');await button(f.root,'a.txt:1:1').onclick();assert.equal(editor.value,'newer draft cat\n');release.resolve();await pending;assert.equal(editor.value,'newer draft cat\n');held=false;await button(f.root,'Save file').onclick();assert.equal(await fs.readFile(f.workspace.resolve('a.txt'),'utf8'),'newer draft cat\n');await search(f.root,'^newer');await button(f.root,'a.txt:1:1').onclick();assert.equal(editor.selectionStart,0);assert.equal(editor.selectionEnd,5);
});
test('disposed actual client never publishes a held completed regex search',async t=>{
 const arrived=deferred(),release=deferred(),f=await fixture(t,async(a,i,real)=>{const data=await real();if(a==='search'){arrived.resolve();await release.promise;}return data;});field(f.root,'Regular expression in workspace search').checked=true;const pending=search(f.root,'cat$');await arrived.promise;f.cleanup();release.resolve();await pending;assert.equal(field(f.root,'Workspace search results').children.length,0);
});
test('zero-length result navigation selects safe astral endpoint without changing content',async t=>{
 const f=await fixture(t);field(f.root,'Regular expression in workspace search').checked=true;await search(f.root,'(?=cat)');await button(f.root,'a.txt:1:3').onclick();const editor=field(f.root,'File contents');assert.equal(editor.selectionStart,2);assert.equal(editor.selectionEnd,2);assert.equal(editor.value,'🧪cat cats\nnext cat\n');
});
test('closing active tab while a result read is held prevents that earlier open from republishing',async t=>{
 const arrived=deferred(),release=deferred(),f=await fixture(t,async(a,i,real)=>{const data=await real();if(a==='read'&&i.path==='a.txt'){arrived.resolve();await release.promise;}return data;});await button(f.root,'b.txt').onclick();field(f.root,'Regular expression in workspace search').checked=true;await search(f.root,'cat');const pending=button(f.root,'a.txt:1:3').onclick();await arrived.promise;button(f.root,'Close tab').onclick();assert.equal(field(f.root,'File contents').value,'');release.resolve();await pending;assert.equal(field(f.root,'File contents').value,'');assert.equal(all(f.root).filter(n=>n.attributes['aria-pressed']!==undefined).length,0);
});
test('cancelled Close retains dirty tab and does not invalidate an explicitly requested held read',async t=>{
 const arrived=deferred(),release=deferred(),f=await fixture(t,async(a,i,real)=>{const data=await real();if(a==='read'&&i.path==='a.txt'){arrived.resolve();await release.promise;}return data;});await button(f.root,'b.txt').onclick();const editor=field(f.root,'File contents');editor.value='B dirty retained';editor.oninput();await search(f.root,'cat');const pending=button(f.root,'a.txt:1:3').onclick();await arrived.promise;globalThis.window.confirm=()=>false;button(f.root,'Close tab').onclick();assert.equal(editor.value,'B dirty retained');release.resolve();await pending;assert.equal(editor.value,'🧪cat cats\nnext cat\n');assert.ok(button(f.root,'b.txt •'));
});
