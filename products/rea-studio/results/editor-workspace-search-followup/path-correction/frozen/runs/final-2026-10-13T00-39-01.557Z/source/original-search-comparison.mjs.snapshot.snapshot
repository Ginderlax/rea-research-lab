const root=import.meta.dirname,originalRoot=path.join(root,'../original-products/vscode/1.140.0'),engineRelative='07f806f999/resources/app/node_modules.asar.unpacked/@vscode/ripgrep-universal/bin/win32-x64/rg.exe',engine=path.join(originalRoot,'unpacked',engineRelative),sha=b=>createHash('sha256').update(b).digest('hex'),run=path.join(root,'runs',`original-${new Date().toISOString().replaceAll(':','-')}`);
await fs.mkdir(run,{recursive:true});await fs.writeFile(path.join(run,'collector.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});
const authenticatedTree=JSON.parse(await fs.readFile(path.join(root,'../vscode-original-acquisition-record/unpacked-source-before.json'),'utf8')),engineRecord=authenticatedTree.find(row=>row.path===engineRelative);assert.ok(engineRecord);const engineBefore=await fs.readFile(engine);assert.equal(sha(engineBefore),engineRecord.sha256);
const workspace=await createWorkspace(path.join(run,'synthetic-workspace')),files={
 'plain.txt':'needle NEEDLE needles\n.* [] +$ a\\b <script>\naaaa\n',
 'src/unicode.txt':'🧪needle🧪\r\nΣ σ ς; Kelvin K K k; É é\r\n',
 'src/bom.txt':'\ufeffneedle 🧪\n',
 'empty.txt':'',
 'space name.txt':'line one\nneedle needle\nlast',
 'ignored/.literal':'needle\n',
 '.git/hidden.txt':'needle\n',
 'node_modules/pkg.txt':'needle\n',
 '.rea-save-owned':'needle\n'
};
let seed=0x517ead91;const random=()=>{seed=(Math.imul(seed,1664525)+1013904223)>>>0;return seed;},symbols=['a','b','🧪','é','Σ','k','.','[',']','$','+','\\'];for(let i=0;i<6;i++)files[`generated/${i}.txt`]=Array.from({length:80},()=>symbols[random()%symbols.length]).join('')+'\n';
for(const[name,value]of Object.entries(files)){const file=workspace.resolve(name);await fs.mkdir(path.dirname(file),{recursive:true});await fs.writeFile(file,value,{flag:'wx'});}
const inputs=[{query:'needle'},{query:'needle',matchCase:false},{query:'🧪'},{query:'σ',matchCase:false},{query:'k',matchCase:false},{query:'aa'},{query:'.*'},{query:'[]'},{query:'+$'},{query:'a\\b'},{query:'<script>'},{query:'no-match'},{query:'é',matchCase:false},...symbols.slice(0,7).map(query=>({query}))];
await fs.writeFile(path.join(run,'inputs.json'),JSON.stringify({seed:'0x517ead91',files,inputs},null,2)+'\n',{flag:'wx'});
const children=[];
async function invoke(args,index){const startedAtUtc=new Date().toISOString(),result=await new Promise(resolve=>{const child=spawn(engine,args,{cwd:workspace.root,windowsHide:true,shell:false,stdio:['ignore','pipe','pipe']}),out=[],err=[];let outputBytes=0,failure=null;for(const[stream,parts]of[[child.stdout,out],[child.stderr,err]])stream.on('data',bytes=>{outputBytes+=bytes.length;if(outputBytes>1024*1024){failure??='1MiB combined output bound';child.kill('SIGKILL');}else parts.push(bytes);});const timer=setTimeout(()=>{failure??='30second child deadline';child.kill('SIGKILL');},30000);child.on('error',error=>failure??=error.message);child.on('close',(exitCode,signal)=>{clearTimeout(timer);resolve({exitCode,signal,failure,stdout:Buffer.concat(out),stderr:Buffer.concat(err)});});});const name=String(index).padStart(2,'0');await fs.writeFile(path.join(run,`${name}.stdout.txt`),result.stdout,{flag:'wx'});await fs.writeFile(path.join(run,`${name}.stderr.txt`),result.stderr,{flag:'wx'});children.push({index,args,startedAtUtc,completedAtUtc:new Date().toISOString(),exitCode:result.exitCode,signal:result.signal,failure:result.failure,stdoutBytes:result.stdout.length,stdoutSHA256:sha(result.stdout),stderrBytes:result.stderr.length,stderrSHA256:sha(result.stderr)});await fs.writeFile(path.join(run,'children.json'),JSON.stringify(children,null,2)+'\n');assert.equal(result.failure,null);assert.equal(result.signal,null);return result;}
let failure=null,observations=[];
try{
 const version=await invoke(['--version'],0);assert.equal(version.exitCode,0);assert.match(version.stdout.toString(),/^ripgrep15\.0\.0|^ripgrep 15\.0\.0/);assert.match(version.stdout.toString(),/3a612f88b8/);
 for(let i=0;i<inputs.length;i++){
  const input=inputs[i],candidate=await searchWorkspace(workspace,input),native=await invoke(['--no-config','--json','--fixed-strings',input.matchCase===false?'--ignore-case':'--case-sensitive','--no-ignore','--hidden','--glob','!.git/**','--glob','!node_modules/**','--glob','!.rea-save-*','--',input.query,'.'],i+1);assert.ok([0,1].includes(native.exitCode));assert.equal(native.stderr.length,0);const original=[];
  for(const line of native.stdout.toString().trim().split('\n').filter(Boolean)){const event=JSON.parse(line);if(event.type!=='match')continue;const data=event.data;assert.ok(data.path.text!==undefined&&data.lines.text!==undefined);const name=data.path.text.replaceAll('\\','/').replace(/^\.\//,'');for(const match of data.submatches){const prefix=Buffer.from(data.lines.text).subarray(0,match.start),span=Buffer.from(data.lines.text).subarray(match.start,match.end),column=new TextDecoder('utf-8',{fatal:true}).decode(prefix).length+1;original.push({path:name,line:data.line_number,column,endColumn:column+new TextDecoder('utf-8',{fatal:true}).decode(span).length});}}
  const key=row=>JSON.stringify([row.path,row.line,row.column,row.endColumn]),project=row=>({path:row.path,line:row.line,column:row.column,endColumn:row.endColumn}),expected=original.sort((a,b)=>key(a)<key(b)?-1:1),actual=candidate.matches.map(project).sort((a,b)=>key(a)<key(b)?-1:1);assert.equal(candidate.truncated,false);assert.deepEqual(actual,expected,`Released search engine comparison${i}`);observations.push({index:i,input,matchedPositions:actual.length,candidate:actual,original:expected});
 }
 for(const[name,value]of Object.entries(files))assert.equal(await fs.readFile(workspace.resolve(name),'utf8'),value);assert.ok((await fs.readFile(engine)).equals(engineBefore));
}catch(error){failure=error.stack||String(error);}
const receipt={schema:'rea-released-vscode-search-engine-comparison/v1',recordedAtUtc:new Date().toISOString(),run,release:'1.140.0',commit:'07f806f999227108933c2e30515b26eecc1fda74',engineRelative,engineSHA256:engineRecord.sha256,engineVersion:'ripgrep15.0.0 rev3a612f88b8',inputGroups:inputs.length,completedInputGroups:observations.length,matchedPositionComparisons:observations.reduce((sum,row)=>sum+row.matchedPositions,0),boundedOriginalEngineInvocations:children.length,originalEngineIdentityInvocations:1,originalWorkBenchOrGUIExecutions:0,allSyntheticFileBytesStable:failure===null,engineBytesStable:failure===null,fullOriginalSearchSemantics:false,fullParity:false,universalSuperiority:false,scope:'Direct bundled ripgrep engine on ordinary valid UTF-8 regular files; literal single-line case modes, Unicode/CRLF/BOM positions and explicit common exclusions. No original search-service/workbench or replacement workflows are exercised.',failure,children,observations};await fs.writeFile(path.join(run,'validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});if(failure){console.error(failure);process.exitCode=1;}else console.log(JSON.stringify({status:'PASS',inputGroups:receipt.inputGroups,matchedPositionComparisons:receipt.matchedPositionComparisons,originalEngineInvocations:children.length,run}));
