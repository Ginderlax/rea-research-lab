 targets={row['path']:row for row in bundle['transitions']};assert len(targets)==7 and len([row for row in targets.values()if row['before']])==3 and len([row for row in targets.values()if row['before']is None])==4 and len([name for name in targets if re.search(r'\.(mjs|json|html|css|ps1)$',name)])==6
