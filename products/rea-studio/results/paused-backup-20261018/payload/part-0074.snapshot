    {
      "id": "grafana.candidate.3020047c51c9b3859be6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, Grafana uses a single notification policy tree for all alert routing. As organizations grow in size and complexity, managing a single global tree can become difficult. Multiple notification policies allow you to split routing logic into separate, independently managed routing trees.",
      "headingPath": [
        "Configure notification policies",
        "Manage multiple notification policies"
      ],
      "source": {
        "path": "docs/sources/alerting/configure-notifications/create-notification-policy.md",
