    {
      "id": "grafana.candidate.239f6b9ded6c3d886a26",
      "syntaxRole": "table-row",
      "sourceText": "| **URL**             | The HTTP protocol, IP address, and port of your OpenTSDB server. The default port is `4242`. Example: `http://localhost:4242`. |",
