const baseline=JSON.parse(evidence('git-baseline-active-source.json'));assert.equal(baseline.files.length,363);assert.equal(baseline.repositoryCommit,tested);assert.deepEqual(baseline.excludedComposedOracleTargets,overlayTargets);
