import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,stage=path.resolve(here,'../sketch-layout-precision-next'),old=path.resolve(here,'../sketch-alignment-independent-review'),repo=path.resolve(here,'../../outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex');async function keep(p,b){const q=path.join(here,p);await fs.mkdir(path.dirname(q),{recursive:true});await fs.writeFile(q,b,{flag:'wx'});}const mb=await fs.readFile(path.join(stage,'freeze-manifest.json'));assert.equal(sha(mb),'1dd88ded543ef519876546a668ad6e258755a87bf07fd7eb563d4f707b66ffd1');const m=JSON.parse(mb);assert.equal(m.files,188);for(const r of m.records){const b=await fs.readFile(path.join(stage,r.path));assert.equal(b.length,r.bytes,r.path);assert.equal(sha(b),r.sha256,r.path);}const vb=await fs.readFile(path.join(stage,'validation.json'));assert.equal(sha(vb),'acfd61bcc7388554842bceb317d24e981ea3b42a9869c755fa3ed66258c0cb06');const p='products/rea-studio/apps/sketch/layout.mjs',layout=await fs.readFile(path.join(stage,p));assert.equal(layout.length,3910);assert.equal(sha(layout),'ac83dc4fdefaf55f4839424a5a2d7e3d417421f2e98e1e1f1eadcd82b97e9752');
for(const p of['freeze-manifest.json','validation.json','README.md','source-provenance.json','source-baseline.json'])await keep('candidate/'+p+'.snapshot',await fs.readFile(path.join(stage,p)));const provenance=JSON.parse(await fs.readFile(path.join(stage,'source-provenance.json')));for(const r of provenance.fetched)await keep(r.path,await fs.readFile(path.join(stage,r.path)));for(const r of m.records.filter(r=>r.path.startsWith('products/rea-studio/')&&!r.path.includes('/results/')))await keep('candidate-source/'+r.path+'.snapshot',await fs.readFile(path.join(stage,r.path)));
await keep('original-oracle.mjs',await fs.readFile(path.join(old,'original-oracle.mjs')));await keep('fixtures.mjs',await fs.readFile(path.join(old,'fixtures.mjs')));const adapters=[];for(const p of['review.test.mjs','ui-review.test.mjs','ui-fixture.mjs','fractional-diagnostics.test.mjs']){const b=await fs.readFile(path.join(old,p)),text=b.toString().replaceAll('../sketch-alignment-next/','../sketch-layout-precision-next/');assert.notEqual(text,b.toString());await keep('replay-'+p,text);adapters.push({source:'work/sketch-alignment-independent-review/'+p,beforeSHA256:sha(b),destination:'replay-'+p,afterSHA256:sha(text),changes:'Candidate import path only; bodies preserved.'});}const uiPath=path.join(here,'replay-ui-review.test.mjs'),u=await fs.readFile(uiPath,'utf8');await keep('prepared-versions/ui-review-path-only-pre-fixture-adapter.mjs.snapshot',u);await fs.writeFile(uiPath,u.replace("from'./ui-fixture.mjs'","from'./replay-ui-fixture.mjs'"));adapters.find(r=>r.destination==='replay-ui-review.test.mjs').afterSHA256=sha(await fs.readFile(uiPath));adapters.find(r=>r.destination==='replay-ui-review.test.mjs').changes+=' Own fixture import path retargeted.';await keep('replay-adapters.json',JSON.stringify(adapters,null,2)+'\n');
const baseline=JSON.parse(await fs.readFile(path.join(stage,'source-baseline.json')));assert.equal(baseline.length,14);for(const r of baseline){const b=await fs.readFile(path.join(repo,r.path));assert.equal(sha(b),r.sha256);await keep('production-baseline/'+r.path+'.snapshot',b);}await keep('authentication-before.json',JSON.stringify({at:new Date().toISOString(),candidate188:sha(mb),receipt:sha(vb),layoutSHA256:sha(layout),originalSourceFiles:provenance.fetched.length,baseline14:baseline,scope:'Sketch fourteen named source rows only; unrelated Notes installation excluded.',originalOracle:'Exact previously frozen independent source oracle; fresh new fixture/test bodies plus explicitly labelled replays.'},null,2)+'\n');console.log('PRECISION188 AUTHENTICATED; SKETCH14 EXACT');
