          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b10c71ba913020118bde",
      "syntaxRole": "list-item",
      "sourceText": "- **Flux** - A functional data scripting language for InfluxDB 2.x. Flux is not supported on InfluxDB 3.x. Refer to [Query InfluxDB with Flux](https://docs.influxdata.com/influxdb/cloud/query-data/get-started/query-influxdb/) for a basic guide.",
      "headingPath": [
        "Configure the InfluxDB data source",
        "Before you begin"
      ],
      "source": {
        "path": "docs/sources/datasources/influxdb/configure/_index.md",
