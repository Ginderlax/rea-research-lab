replace("await api('native-validate', { text: text.value }); const url = URL.createObjectURL(new Blob([text.value], { type: 'application/json' })), link = el('a', '', { href: url, download: `${name.value.replace(/[^\\w-]/g, '-').slice(0, 100) || 'native-flow'}.json` });", "const capture=captureDraft();await api('native-validate',{text:capture.text});if(!sameDraft(capture)){status.textContent='Draft changed during export; export the current draft again.';return;}const url = URL.createObjectURL(new Blob([capture.text], { type: 'application/json' })), link = el('a', '', { href: url, download: `${capture.name.replace(/[^\\w-]/g, '-').slice(0, 100) || 'native-flow'}.json` });");
replace("const changed = JSON.parse(nodeEditor.value); if (changed.id !== selected)", "const capture=captureDraft(),properties=nodeEditor.value,selection=selected;const changed = JSON.parse(properties); if (changed.id !== selected)");
replace("await api('native-validate', { text: next }); text.value = next; await preview();", "await api('native-validate', { text: next });if(!sameDraft(capture)||selected!==selection||nodeEditor.value!==properties)return;setNativeText(next); await preview();");
replace("async function editLink(connect){const epoch=generation,draft=text.value,document=JSON.parse(draft)", "async function editLink(connect){const capture=captureDraft(),sourceId=linkFrom.value,targetId=linkTo.value,draft=capture.text,document=JSON.parse(draft)");
