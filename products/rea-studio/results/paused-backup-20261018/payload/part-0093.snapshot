source=producer.decode();tables={}
for key in a['sourceTables']:
 if key=='REVIEWED':
  m=re.findall(r'const REVIEWED\s*=\s*(\{.*?\n\});',source,re.S);assert len(m)==1;tables[key]=ast.literal_eval(m[0])
 else:
  value=source.split('const '+key+'=',1)[1]if'const '+key+'='in source else source.split('const '+key+' =',1)[1]
  tables[key],end=json.JSONDecoder().raw_decode(value.lstrip())
 assert tables[key]==a['sourceTables'][key],key
reviewed_literal=source.split('const REVIEWED = ',1)[1].split('};',1)[0]+'}'
tables['REVIEWED']=ast.literal_eval(reviewed_literal);assert len(tables['REVIEWED'])==76
assert tables['NOTES36_ARTIFACT_PATHS']==names if 'NOTES36_ARTIFACT_PATHS'in tables else True
assert 'READER_BYTES=48123' in node and "READER_SHA256='29cf28806d3f4b42be2a5a5c6ce74286e9aa45a96650e3a49956f77dcb0a488c'"in node
dpath=R/'products/rea-studio/results/notes36-source-transition-20261016/current-source-declaration.json';d=json.loads(dpath.read_bytes())
legacy={row['sourcePath']:row['readPath']for row in [*d['legacy52LogicalToPhysicalRows'],*d['legacyInstalledToolingRows']]};assert len(legacy)==56
checked=[]
for group in ['REVIEWED','NOTES_REVIEWED','NOTES_INSTALLED_TOOLING','NOTES36_CURRENT','NOTES36_TOOLING']:
 for name,value in tables[group].items():
  expected={'bytes':value[0],'sha256':value[1]}if isinstance(value,list)else value
  physical=legacy[name]if group in ['NOTES_REVIEWED','NOTES_INSTALLED_TOOLING']else name
  assert pin((R/physical).read_bytes())==expected,(group,name,physical)
  checked.append({'group':group,'logicalPath':name,'physicalPath':physical})
