    },
    {
      "id": "grafana.candidate.3b1bfd17df906aec3524",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "[JWT authentication](../../setup-grafana/configure-access/configure-authentication/jwt/) was added and [Configuration](../../setup-grafana/configure-grafana/#authjwt) was updated as a result of this feature.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Grafana OSS features",
        "Authentication updates",
        "Added JWT authentication support"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-0.md",
        "gitBlobSha": "08364874bf79c35cb3f0d907a16891c4cfb0eb1c",
        "sha256": "6f07cb510f8b0da003b838c600c8c34236d365c4cc7688913f7fe726f50a0fd7",
        "lineStart": 270,
        "lineEnd": 270,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v8-0.md#L270-L270"
      },
