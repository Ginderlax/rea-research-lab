    {
      "id": "grafana.candidate.2cf0eab0f236ecf297f0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If an alert is resolved before the duration elapses, no notification is sent for that alert. This reduces noise from flapping alerts.",
      "headingPath": [
        "Group alert notifications",
        "Timing options",
        "Group wait"
      ],
      "source": {
