import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const root=fileURLToPath(new URL('./',import.meta.url)),hash=bytes=>createHash('sha256').update(bytes).digest('hex'),manifest=JSON.parse(await fs.readFile(path.join(root,'baseline-manifest.json'),'utf8'));
for(const item of manifest.sourceFingerprints)assert.equal(hash(await fs.readFile(path.join(manifest.stage,item.path))),item.sha256);for(const item of manifest.copiedFiles)assert.equal(hash(await fs.readFile(path.join(root,'baseline',item.path))),item.sha256);
const names=['baseline-manifest.json','preserve-baseline.mjs','lifecycle.test.mjs','lifecycle-observations.json','lifecycle.stdout.txt','lifecycle.stderr.txt','freeze-initial.mjs','initial-validation.json','freeze-initial.stdout.txt','freeze-initial.stderr.txt','freeze-initial.pre-encoding-fix.mjs','freeze-initial.failed.stdout.txt','freeze-initial.failed.stderr.txt','precommit-deadline-probe.mjs','precommit-deadline-observations.json','precommit-deadline.stdout.txt','precommit-deadline.stderr.txt','review-findings.md','freeze-review.mjs'],evidence=[];
for(const name of names){const bytes=await fs.readFile(path.join(root,name));evidence.push({path:name,bytes:bytes.length,sha256:hash(bytes)});}
const actual=JSON.parse(await fs.readFile(path.join(root,'precommit-deadline-observations.json'),'utf8'));assert.equal(actual.cases.length,3);assert.ok(actual.cases.every(item=>item.guardGapReproduced));
const report={schema:'rea-rabin-fixed-independent-review/v1',completedAtUtc:new Date().toISOString(),runtime:process.version,platform:process.platform,sourceFingerprints:manifest.sourceFingerprints,exactCopiedBaselineFingerprints:manifest.copiedFiles,reviewFingerprints:evidence,sourceBytesStableAcrossRun:true,summary:{lifecycleTests:20,pass:20,fail:0,skipped:0,additionalPrecommitDeadlineDiagnostics:3,reproducedRemainingGuardGaps:3},retainedHarnessFailure:{name:'freeze-initial TAP encoding',behaviorTestsUnaffected:true,exactErroneousSource:'freeze-initial.pre-encoding-fix.mjs',rawReproducedFailure:'freeze-initial.failed.stderr.txt',fix:'Read UTF-8 TAP text'},remainingRecommendation:'Post-await pre-commit IO deadline guards, with cleanup and committed success boundaries unchanged',stageEdits:false,productionEdits:false,scope:'Finite synthetic lifecycle tests and deadline diagnostics. Root author evidence updates excluded from live source binding. No full parity/security/performance claim.'};
const receipt=path.join(root,'review-validation.json');await fs.writeFile(receipt,JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({receipt,sha256:hash(await fs.readFile(receipt)),lifecyclePass:20,additionalDiagnostics:3,remainingGuardGaps:3,sourceFiles:manifest.sourceFingerprints.length,reviewFiles:evidence.length}));
