    {
      "id": "grafana.candidate.b2c9dcb35f254a851be5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To switch a dashboard between InfluxDB instances, use a data source variable. Don't use a query variable that returns data source names as a workaround. Query-based workarounds can break after Grafana upgrades because they depend on internal identifiers. Refer to [Add a data source variable](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/dashboards/variables/add-template-variables/#add-a-data-source-variable) for details.",
      "headingPath": [
        "InfluxDB template variables",
        "Supported variable types"
      ],
