import fs from 'node:fs/promises';import path from 'node:path';import {createRequire} from 'node:module';import assert from 'node:assert/strict';import {authenticateOriginal,here,sha} from './authenticate-original.mjs';import {canonical,packet,metadataFor} from './canonical.mjs';import {valuesForSpec,specsFor} from './workloads.mjs';
const authority=await authenticateOriginal(),require=createRequire(authority.entry),original=require(authority.entry),expectedFiles={},specs=specsFor(original);
async function writeOrVerify(name,bytes){try{await fs.writeFile(path.join(here,name),bytes,{flag:'wx'});}catch(error){if(error.code!=='EEXIST')throw error;assert.equal(sha(await fs.readFile(path.join(here,name))),sha(bytes),'Existing expected fixture is immutable');}}
for(const[name,spec]of Object.entries(specs)){const values=valuesForSpec(spec),field={name:'synthetic',type:'number',config:{nullValueMode:'connected'},values,state:{}},result=original.reduceField({field,reducers:spec.reducers}),fresh=canonical(packet(field,result)),repeat=canonical(packet(field,original.reduceField({field,reducers:spec.reducers}))),subset=canonical(packet(field,original.reduceField({field,reducers:[spec.reducers[0]]}))),input=canonical(values),inputPath='fixtures/'+name+'.input.json',expectedPath='fixtures/'+name+'.expected.json',body=JSON.stringify({fresh,repeat,subset},null,2)+'\n';assert.ok(Buffer.byteLength(body)<8*1024*1024);await writeOrVerify(inputPath,JSON.stringify(values)+'\n');await writeOrVerify(expectedPath,body);expectedFiles[name]={spec,inputPath,inputBytes:Buffer.byteLength(JSON.stringify(values)+'\n'),inputFileSHA256:sha(JSON.stringify(values)+'\n'),inputSHA256:sha(input),path:expectedPath,bytes:Buffer.byteLength(body),sha256:sha(body),canonicalOutputSHA256:sha(fresh),repeatOutputSHA256:sha(repeat),subsetOutputSHA256:sha(subset)};}
const selectorReceipt='preserved/selector-validation.json',selectorBytes=await fs.readFile(path.join(here,selectorReceipt));assert.equal(sha(selectorBytes),'b582c0da35dcd8b81a701cd1252c995c0ffb1e7307932b5b9f1279e737378aa6');const proof=JSON.parse(selectorBytes);assert.equal(proof.bothNativeModulesBoundBeforeAndAfter,true);assert.equal(proof.failedAcceptanceAttempts,0);
const baseline=path.join(here,'candidate-baseline.mjs'),entry=path.join(here,'candidate-module-control.mjs'),helper=path.join(here,'selector-control.mjs');
const implementations={original:authority,baseline:{entry:baseline,format:'esm',files:{[baseline]:sha(await fs.readFile(baseline))}},candidate:{entry,format:'esm',files:{[entry]:sha(await fs.readFile(entry)),[helper]:sha(await fs.readFile(helper))},nativeImportGraph:{[entry]:[helper],[helper]:[]}}};
assert.equal(implementations.baseline.files[baseline],proof.candidate.baselineSHA256);assert.equal(implementations.candidate.files[entry],proof.candidate.entrySHA256);assert.equal(implementations.candidate.files[helper],proof.candidate.helperSHA256);
const manifest={schemaVersion:3,checkedAt:new Date().toISOString(),variant:'control',authority,runtime:{execPath:process.execPath,version:process.version,platform:process.platform,arch:process.arch,versions:process.versions,executableSHA256:sha(await fs.readFile(process.execPath))},implementations,expectedFiles,expectedMetadataSHA256:sha(canonical(metadataFor(original))),canonicalSourceSHA256:sha(await fs.readFile(path.join(here,'canonical.mjs'))),workloadSourceSHA256:sha(await fs.readFile(path.join(here,'workloads.mjs'))),fullSemanticReceipt:selectorReceipt,fullSemanticReceiptSHA256:sha(selectorBytes),selectorSemanticBinding:'Exact two module source identities previously accepted by full/held-out/cache/adversarial oracle checks, preserved unchanged; no current2.9million replay claim.',limits:{samplesPerWorkloadAndImplementation:7,childWallSeconds:120,childOldSpaceMiB:256,childRSSMiB:512,stdoutBytes:4*1024*1024},preflightOnly:true,freshOriginalCalculations:7,originalCachedReads:14,warmupCallsExecuted:0,transientCallsExecuted:0,retentionCallsExecuted:0,timingMeasurementRun:false,memoryMeasurementRun:false,performanceEstablished:false,fullProductComplete:false,universalSuperiorityEstablished:false};
await fs.writeFile(path.join(here,'memory-preflight.control.json'),JSON.stringify(manifest,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({cases:Object.keys(specs),freshOriginalCalculations:7,cachedOriginalReads:14,manifestSHA256:sha(await fs.readFile(path.join(here,'memory-preflight.control.json'))),measurementRun:false}));
