    {
      "id": "grafana.candidate.619e526c6228cb18ab62",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana stores its own configuration data — users, data sources, dashboards, and so on — in a database, and supports the following:",
