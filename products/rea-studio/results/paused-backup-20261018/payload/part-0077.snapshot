    {
      "id": "grafana.candidate.f6ce9fb608386b2b45d3",
      "syntaxRole": "table-row",
      "sourceText": "| `team_ids`                   | No       | Yes                | String list of team IDs. If set, the user must be a member of one of the given teams to log in. If you configure `team_ids`, you must also configure `teams_url` and `team_ids_attribute_path`.                                                                                                                                                                                                                                                                                                                                                                                                             |                 |",
      "headingPath": [
        "Configure Generic OAuth authentication",
        "Configuration options"
      ],
