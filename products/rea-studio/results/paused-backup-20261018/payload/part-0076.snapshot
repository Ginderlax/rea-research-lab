    {
      "id": "grafana.candidate.1fefc04a06a62b2450cf",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "PDC connectivity issues are almost always caused by networking on the customer side (DNS, firewall rules, routing), not by Grafana Cloud. The data source test passing doesn't guarantee sustained connectivity under load. It only verifies a single query succeeds.",
      "headingPath": [
        "Troubleshoot Prometheus data source issues",
        "Connection errors",
        "PDC connectivity errors"
      ],
      "source": {
