    {
      "id": "grafana.candidate.9f019e024328b78e2b06",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Add the Cloud Monitoring read scope to your Google authentication configuration in `grafana.ini` or `custom.ini`:",
      "headingPath": [
