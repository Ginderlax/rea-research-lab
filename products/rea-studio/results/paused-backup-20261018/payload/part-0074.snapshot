    {
      "id": "grafana.candidate.a45d8c00faea2c2a4f1a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A Grafana server administrator (sometimes referred to as a **Grafana Admin**) manages server-wide settings and access to resources such as organizations, users, and licenses. Grafana includes a default server administrator that you can use to manage all of Grafana, or you can divide that responsibility among other server administrators that you create.",
      "headingPath": [
        "Roles and permissions",
        "Grafana server administrators"
