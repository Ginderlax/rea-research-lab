    {
      "id": "grafana.candidate.0a2697cdb4065e9f7b86",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Loki stores your logs and only indexes labels for each log stream. Using Loki with Grafana Alerting is a powerful way to keep track of what’s happening in your environment. You can create metric alert rules based on content in your log lines to notify your team. What’s even better is that you can add label data from the log message directly into your alert notification.",
      "headingPath": [
        "How to create alert rules with log data"
      ],
      "source": {
        "path": "docs/sources/tutorials/create-alerts-with-logs/index.md",
        "gitBlobSha": "4c288a7ea68800890f118124ba5f6b9be455499d",
