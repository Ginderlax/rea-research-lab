    },
    {
      "id": "grafana.candidate.89310a304d4a8416374d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If your data contains the character `$`, for example `Pa$sw0rd`, and you're using an environment variable, use the `$ENV_VAR_NAME` syntax to avoid double expansion. If you use the `${ENV_VAR_NAME}` syntax, the value will be first replaced as `Pa$sw0rd` and then again as `Pa` since `$sw0rd` will be considered another variable.",
      "headingPath": [
        "Provision Grafana",
        "Use environment variables",
        "Use of the special character `$`"
      ],
      "source": {
        "path": "docs/sources/administration/provisioning/index.md",
        "gitBlobSha": "a6caad47dea63fb1a213a61490f8f587ad16bba2",
        "sha256": "ae39c9c2a4c0e896492c8df476ac2f5ddb821206f6828b18e8d6bb1c2489bf61",
        "lineStart": 72,
        "lineEnd": 72,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/provisioning/index.md#L72-L72"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.539b14565f8eb3512b81",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you want to use the literal value `Pa$sw0rd`, you need to escape the character `$` using a double `$$`: `Pa$$sw0rd`.",
      "headingPath": [
        "Provision Grafana",
        "Use environment variables",
        "Use of the special character `$`"
      ],
      "source": {
        "path": "docs/sources/administration/provisioning/index.md",
        "gitBlobSha": "a6caad47dea63fb1a213a61490f8f587ad16bba2",
        "sha256": "ae39c9c2a4c0e896492c8df476ac2f5ddb821206f6828b18e8d6bb1c2489bf61",
        "lineStart": 74,
        "lineEnd": 74,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/provisioning/index.md#L74-L74"
      },
      "applicability": {
