    {
      "id": "grafana.candidate.58a8b5beb3269c4c39e6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If true, it establishes a secure connection to Loki. Defaults to true.",
      "headingPath": [
        "Configure Grafana Enterprise",
