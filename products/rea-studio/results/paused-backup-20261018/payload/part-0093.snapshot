import hashlib, json, subprocess
from pathlib import Path

root = Path(__file__).resolve().parent.parent
work = root / 'work'
repo = root / 'outputs/rea-research-lab'
stage = work / 'native-diagnostic-backup-binding-38938239800-r3-next'
def pin(path):
    b = path.read_bytes()
    return {'path': path.relative_to(root).as_posix(), 'bytes': len(b), 'sha256': hashlib.sha256(b).hexdigest()}
def check(path, n, h):
    p = pin(path)
    assert p['bytes'] == n and p['sha256'] == h, p
    return p
