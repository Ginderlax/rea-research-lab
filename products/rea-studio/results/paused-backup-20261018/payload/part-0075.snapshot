      },
      "applicability": {
        "status": "unresolved-no-explicit-oss-products-label",
        "products": []
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.49bd24be7594ca681f11",
      "syntaxRole": "list-item",
      "sourceText": "- **Shared experimentation**: A team experiments freely in one space without affecting shared production dashboards.",
      "headingPath": [
        "Testing sandboxes with Git Sync",
        "Use it for"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/git-sync/scenarios/testing-sandboxes.md",
