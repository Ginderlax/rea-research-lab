    {
      "id": "grafana.candidate.8e4c25c3fbb63624acb1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can choose to use the sidebar docked or undocked by clicking the **Dock/Undock** icon in the sidebar. When the sidebar is docked, the content of the dashboard resizes to accommodate the sidebar. When it's undocked, the sidebar floats on top of the dashboard content. In edit mode, the sidebar is docked by default and in view mode, it's undocked.",
      "headingPath": [
        "Create dashboards",
        "Dashboard edit",
        "The sidebar and toolbar",
        "Docked and undocked sidebar"
      ],
