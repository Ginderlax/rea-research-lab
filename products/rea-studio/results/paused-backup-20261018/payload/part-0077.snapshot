    {
      "id": "grafana.candidate.cb8ba7636626ede3528b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "How long temporary images in `data` directory should be kept. Defaults to: `24h`. Supported modifiers: `h` (hours), `m` (minutes), for example: `168h`, `30m`, `10h30m`. Use `0` to never clean up temporary files.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[paths]`",
        "`temp_data_lifetime`"
      ],
      "source": {
