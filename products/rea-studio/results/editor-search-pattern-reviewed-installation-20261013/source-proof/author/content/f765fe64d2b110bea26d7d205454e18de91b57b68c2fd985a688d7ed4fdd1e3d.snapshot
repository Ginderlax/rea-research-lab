import fs from 'node:fs/promises';import path from 'node:path';import vm from 'node:vm';import {stripTypeScriptTypes}from'node:module';import{spawn}from'node:child_process';import{createHash}from'node:crypto';import assert from'node:assert/strict';
import{createWorkspace}from'./candidate/products/rea-studio/lib/storage.mjs';import{searchWorkspace}from'./candidate/products/rea-studio/apps/editor/workspace-search.mjs';import{sourcePattern}from'./candidate/products/rea-studio/apps/editor/search-pattern.mjs';
const root=import.meta.dirname,workspaceRoot=path.resolve(root,'../..'),hash=b=>createHash('sha256').update(b).digest('hex'),run=path.join(root,'runs','original-'+new Date().toISOString().replaceAll(':','-'));await fs.mkdir(run,{recursive:true});await fs.writeFile(path.join(run,'collector.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});
const sourcePaths=['workspace-search.mjs','file-path.mjs','server.mjs','search-pattern.mjs','search-pattern-worker.mjs','search-pattern-session.mjs'].map(n=>'candidate/products/rea-studio/apps/editor/'+n);sourcePaths.push('candidate/products/rea-studio/lib/storage.mjs');const sourceBefore=[];for(const p of sourcePaths){const b=await fs.readFile(path.join(root,p));sourceBefore.push({path:p,bytes:b.length,sha256:hash(b)});const out=path.join(run,'source-before',p+'.snapshot');await fs.mkdir(path.dirname(out),{recursive:true});await fs.writeFile(out,b,{flag:'wx'});}await fs.writeFile(path.join(run,'source-before.json'),JSON.stringify(sourceBefore,null,2)+'\n',{flag:'wx'});
const provenance=JSON.parse(await fs.readFile(path.join(root,'official-source-provenance.json'))),meta=JSON.parse(await fs.readFile(path.join(root,'original-engine.json'))),engine=path.join(workspaceRoot,meta.path);assert.equal(hash(await fs.readFile(engine)),meta.identity.sha256);const src={};for(const row of provenance.fetched){const b=await fs.readFile(path.join(root,row.destination));assert.equal(hash(b),row.sha256);src[row.sourcePath]=b.toString();}
const extracts=[];function extract(sourcePath,name){const text=src[sourcePath],at=text.indexOf('export function '+name+'('),end=text.indexOf('\n}',at)+2;assert.ok(at>=0&&end>at);const code=text.slice(at,end);extracts.push({sourcePath,name,startLine:text.slice(0,at).split('\n').length,endLine:text.slice(0,end).split('\n').length,sha256:hash(Buffer.from(code))});return code;}
const ts=extract('src/vs/base/common/strings.ts','escapeRegExpCharacters')+'\n'+extract('src/vs/base/common/strings.ts','createRegExp')+'\n'+extract('src/vs/workbench/services/search/node/ripgrepTextSearchEngine.ts','unicodeEscapesToPCRE2');await fs.writeFile(path.join(run,'selected-original-helpers.ts.snapshot'),ts,{flag:'wx'});const js=stripTypeScriptTypes(ts.replaceAll('export function','function'));await fs.writeFile(path.join(run,'selected-original-helpers.js.snapshot'),js,{flag:'wx'});const context=vm.createContext({});vm.runInContext(js,context,{timeout:1000});
const files={'plain.txt':'cat cats xcat cat_ cat́ cat\u200cb CAT\r\ncat! (cat) cat. .cat a|b a b ab ba\n^ $ [] .a a. --\n','unicode.txt':'🧪 café ١２ 42\r\n漢字 é Σ σ ς K K k\n','bom.txt':'\ufeffcat 🧪\n','blank.txt':'\r\n','empty.txt':'','generated.txt':''};let seed=0x19e74bc1;const symbols=['cat','cats','🧪','é','漢','á','_','3','١','.'];for(let i=0;i<100;i++){seed=(Math.imul(seed,1664525)+1013904223)>>>0;files['generated.txt']+=symbols[seed%symbols.length]+(i%10===9?'\r\n':' ');}
const inputs=[...['cat','.a','a.','--','cat!','é','漢','[','a|b','🧪'].map(query=>({query,wholeWord:true})),{query:'cat',wholeWord:true,matchCase:false},...['cat','c.t','cat|漢','[a-c]+','\\w+','\\d+','\\bcat\\b','\\Bcat','\\p{L}+','(?<= )cat','cat(?=!)','(?:cat){1,2}','[\\w]+','[^\\d ]+','\\u00e9','^cat','$','^|$'].map(query=>({query,useRegex:true})),{query:'a|b',useRegex:true,wholeWord:true},{query:'cat',useRegex:true,matchCase:false},{query:'k|σ',useRegex:true,matchCase:false}].map(input=>({...input,expectedExact:true}));
// Prospective separate divergence controls; never counted as exact acceptance.
inputs.push(...[{query:'(?:)',useRegex:true},{query:'a?',useRegex:true},{query:'cat|',useRegex:true}].map(input=>({...input,expectedExact:false,qualification:'Known original empty-match byte iteration differs from safe Unicode scalar iterator.'})));
const w=await createWorkspace(path.join(run,'synthetic-workspace'));for(const[name,content]of Object.entries(files))await fs.writeFile(w.resolve(name),content,{flag:'wx'});await fs.writeFile(path.join(run,'inputs.json'),JSON.stringify({seed:'0x19e74bc1',files,inputs,scope:'Predeclared finite single-line cases; original service/workbench not executed.'},null,2)+'\n',{flag:'wx'});
const children=[],observations=[];async function invoke(args,index){const startedAt=new Date().toISOString(),r=await new Promise(resolve=>{const child=spawn(engine,args,{cwd:w.root,windowsHide:true,shell:false,stdio:['ignore','pipe','pipe']}),out=[],err=[];let failure=null,bytes=0;for(const[s,p]of[[child.stdout,out],[child.stderr,err]])s.on('data',b=>{bytes+=b.length;if(bytes>1024*1024){failure??='combined output cap1MiB';child.kill();}else p.push(b);});const timer=setTimeout(()=>{failure??='30s child deadline';child.kill();},30000);child.on('error',e=>{failure??=e.message;});child.on('close',(code,signal)=>{clearTimeout(timer);resolve({code,signal,failure,stdout:Buffer.concat(out),stderr:Buffer.concat(err)});});});const prefix=String(index).padStart(2,'0');await fs.writeFile(path.join(run,prefix+'.stdout.txt'),r.stdout,{flag:'wx'});await fs.writeFile(path.join(run,prefix+'.stderr.txt'),r.stderr,{flag:'wx'});children.push({index,args,startedAt,endedAt:new Date().toISOString(),code:r.code,signal:r.signal,failure:r.failure,stdout:{bytes:r.stdout.length,sha256:hash(r.stdout)},stderr:{bytes:r.stderr.length,sha256:hash(r.stderr)}});await fs.writeFile(path.join(run,'children.json'),JSON.stringify(children,null,2)+'\n');return r;}
let failure=null;try{const version=await invoke(['--version'],0);assert.equal(version.code,0);assert.match(version.stdout.toString(),/3a612f88b8/);for(let i=0;i<inputs.length;i++){
 const input=inputs[i];context.input=input;const helperSource=vm.runInContext('createRegExp(input.query,!!input.useRegex,{wholeWord:!!input.wholeWord,matchCase:input.matchCase!==false}).source.replace(/\\\\\\//g,"/")',context,{timeout:1000});const ours=sourcePattern(input.query,input);assert.equal(ours,helperSource,`helper${i}`);context.pattern=helperSource;const pattern=vm.runInContext('unicodeEscapesToPCRE2(pattern)',context,{timeout:1000});
 const candidate=await searchWorkspace(w,input),native=await invoke(['--no-config','--json','--crlf','--engine','auto',input.matchCase===false?'--ignore-case':'--case-sensitive','--regexp',pattern,'--',...Object.keys(files)],i+1);assert.equal(native.failure,null);assert.ok([0,1].includes(native.code));assert.equal(native.stderr.length,0);const original=[];
 for(const line of native.stdout.toString().split('\n').filter(Boolean)){const event=JSON.parse(line);if(event.type!=='match')continue;const d=event.data,name=d.path.text.replaceAll('\\','/'),decoded=new TextDecoder('utf-8',{fatal:true}).decode(Buffer.from(files[name])),lineOffset=decoded.split('\n').slice(0,d.line_number-1).reduce((n,s)=>n+s.length+1,0),bytes=Buffer.from(d.lines.text);for(const m of d.submatches){let invalidUtf8Boundary=false;let before,span;try{before=new TextDecoder('utf-8',{fatal:true}).decode(bytes.subarray(0,m.start));span=new TextDecoder('utf-8',{fatal:true}).decode(bytes.subarray(m.start,m.end));}catch{invalidUtf8Boundary=true;before=bytes.subarray(0,m.start).toString();span=bytes.subarray(m.start,m.end).toString();}original.push({path:name,line:d.line_number,column:before.length+1,endColumn:before.length+span.length+1,start:lineOffset+before.length,end:lineOffset+before.length+span.length,...(invalidUtf8Boundary?{invalidUtf8Boundary}:{}),originalByteSpan:[m.start,m.end]});}}
 const project=m=>({path:m.path,line:m.line,column:m.column,endColumn:m.endColumn,start:m.start,end:m.end}),key=m=>JSON.stringify(project(m)),order=(a,b)=>key(a).localeCompare(key(b)),actual=candidate.matches.map(project).sort(order),expected=original.map(project).sort(order);let exact=true;try{assert.deepEqual(actual,expected);assert.equal(candidate.truncated,false);}catch{exact=false;}observations.push({index:i,input,sourceHelperExact:ours===helperSource,helperSource,originalPattern:pattern,candidate:actual,original,exact,positions:actual.length});await fs.writeFile(path.join(run,'observations.json'),JSON.stringify(observations,null,2)+'\n');
 }}catch(e){failure=e.stack;}const sourceAfter=[];for(const row of sourceBefore){const b=await fs.readFile(path.join(root,row.path));sourceAfter.push({path:row.path,bytes:b.length,sha256:hash(b)});}await fs.writeFile(path.join(run,'source-after.json'),JSON.stringify(sourceAfter,null,2)+'\n',{flag:'wx'});assert.deepEqual(sourceAfter,sourceBefore);const current=JSON.parse(await fs.readFile(path.join(root,'production-before.json')));for(const r of current.rows)assert.equal(hash(await fs.readFile(path.join(workspaceRoot,'outputs/rea-research-lab',r.path))),r.sha256);assert.equal(hash(await fs.readFile(engine)),meta.identity.sha256);const exact=observations.filter(x=>x.input.expectedExact),failed=exact.filter(x=>!x.exact);const receipt={schema:'rea-editor-pattern-original-comparison/v1',at:new Date().toISOString(),engine:meta.identity,release:meta.release,commit:meta.commit,selectedHelpers:extracts,node:process.version,matchingSourceRows:sourceBefore.length,matchingSourceStable:true,corpusQualification:"Exact replay of author-prepared35 cases; previous32/918+3divergence receipt remains historical, not fresh held-out",sourceHelperCalls:observations.length,unicodeConversionHelperCalls:observations.length,originalEngineCalls:children.length,engineIdentityCalls:1,originalWorkbenchCalls:0,originalGUICalls:0,benchmarkCalls:0,productionWrites:0,declaredExactGroups:inputs.filter(x=>x.expectedExact).length,completedExactGroups:exact.length,failedExactGroups:failed.map(x=>x.index),exactPositionComparisons:exact.filter(x=>x.exact).reduce((n,x)=>n+x.positions,0),declaredDivergenceGroups:inputs.filter(x=>!x.expectedExact).length,divergenceObservations:observations.filter(x=>!x.input.expectedExact).map(x=>({index:x.index,exact:x.exact,qualification:x.input.qualification})),failure,passed:!failure&&!failed.length&&observations.length===inputs.length,originalBytesStable:true,production31Stable:true,children,fullSearchParity:false};await fs.writeFile(path.join(run,'validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({run,...receipt,children:undefined}));if(!receipt.passed)process.exitCode=1;
