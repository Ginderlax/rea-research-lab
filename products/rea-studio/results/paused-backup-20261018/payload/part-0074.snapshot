    {
      "id": "grafana.candidate.46b1e3772aaa21375d0d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To learn more about the permissions you can grant for each resource, refer to [RBAC role definitions](ref:rbac-role-definitions).",
      "headingPath": [
        "Role-based access control (RBAC) overview",
