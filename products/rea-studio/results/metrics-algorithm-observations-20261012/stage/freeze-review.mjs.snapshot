import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),sha=data=>createHash('sha256').update(data).digest('hex'),receiptName='measurement-validation.json',manifestName='freeze-manifest.json',roles=['original','baseline','candidate'];
const fp=async file=>{const data=await fs.readFile(file);return {bytes:data.length,sha256:sha(data)};},read=async name=>JSON.parse(await fs.readFile(path.join(here,name))),median=values=>[...values].sort((a,b)=>a-b)[Math.floor(values.length/2)];
async function inventory(base,dir=base){const out={};for(const row of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const file=path.join(dir,row.name),relative=path.relative(base,file).replaceAll('\\','/');if(base===here&&[receiptName,manifestName].includes(relative))continue;assert.ok(!row.isSymbolicLink());if(row.isDirectory())Object.assign(out,await inventory(base,file));else {assert.ok(row.isFile());out[relative]=await fp(file);}}return out;}
async function authenticatePreservation(){const preservation=await read('study-preservation.json'),algorithm=await read('full-algorithm-preservation.json'),source=path.resolve(here,preservation.sourceStage);assert.deepEqual(await inventory(source),preservation.sourceInventory);for(const rows of [preservation.copies,preservation.previousNegativeStudy.copies,preservation.algorithmPreparationFailures.copies,preservation.independentReadinessProof.copies,algorithm.copies])for(const row of rows)assert.deepEqual(await fp(path.join(here,row.path)),{bytes:row.bytes,sha256:row.sha256});assert.equal(preservation.copies.length,1006);assert.equal(preservation.previousNegativeStudy.copies.length,1043);assert.equal(algorithm.copies.length,89);
const old=await read('preserved/previous-negative-study/freeze-manifest.json');assert.equal(old.entries.length,1042);assert.equal((await fp(path.join(here,'preserved/previous-negative-study/freeze-manifest.json'))).sha256,preservation.previousNegativeStudy.manifestSHA256);for(const row of old.entries)assert.deepEqual(await fp(path.join(here,'preserved/previous-negative-study',row.path)),{bytes:row.bytes,sha256:row.sha256});
const candidate=await read('preserved/full-algorithm-stage/freeze-manifest.json');assert.equal(Object.keys(candidate.inventory).length,88);assert.equal((await fp(path.join(here,'preserved/full-algorithm-stage/freeze-manifest.json'))).sha256,algorithm.manifest.sha256);for(const [name,row]of Object.entries(candidate.inventory)){assert.deepEqual(await fp(path.join(here,'preserved/full-algorithm-stage',name)),row);assert.deepEqual(await fp(path.join(path.resolve(here,algorithm.sourceStage),name)),row);}
assert.equal((await fp(path.join(here,'preserved/independent-readiness-review/review-validation.json'))).sha256,'842ce4b92c211844c5ddc090a6ea7d173665a0eda628db6e019fe7ca6ca50e86');assert.equal((await fp(path.join(here,'preserved/study/preserved/root-independent-review.json'))).sha256,'902f7d0e96a3642ed51419824dd23c1cb75420d65c79a353e58fd03c4398e6cb');return {preservation,algorithm};}
async function recomputeFromPreserved(summary){const timing=await read('preserved/study/results/paired-control-1791846775389.json'),memory=await read('preserved/study/results/memory-observations-control-1791847131780.json');assert.equal(timing.records.length,147);assert.equal(memory.samples.length,147);
for(const row of summary.timingSummary){const actual={};for(const role of roles){const values=timing.records.filter(r=>r.caseName===row.caseName&&r.implementation===role).sort((a,b)=>a.runNumber-b.runNumber).map(r=>r.result.millisecondsPerCall);actual[role]=values;assert.deepEqual(values,row.millisecondsPerCall[role].values);assert.equal(median(values),row.millisecondsPerCall[role].median);assert.equal(Math.min(...values),row.millisecondsPerCall[role].min);assert.equal(Math.max(...values),row.millisecondsPerCall[role].max);}for(const ref of ['baseline','original']){assert.equal(100*(median(actual.candidate)/median(actual[ref])-1),row.candidateComparedWith[ref].medianRatioPercent);assert.deepEqual(actual.candidate.map((v,i)=>v-actual[ref][i]),row.candidateComparedWith[ref].pairedDifferenceMilliseconds.values);}}
for(const row of summary.memorySignedPerChildRows){const sample=memory.samples.find(r=>r.caseName===row.caseName&&r.implementation===row.implementation&&r.runNumber===row.runNumber);assert.ok(sample);const cp=name=>sample.result.checkpoints.find(r=>r.name===name);assert.equal(row.pid,sample.pid);assert.equal(row.pid,sample.result.pid);assert.equal(row.metrics.observedPeakRSSBytes,sample.ownedPIDObserver.peakRSS);for(const key of ['rss','heapUsed','external','arrayBuffers']){assert.equal(row.metrics['initialized-'+key+'-signedBytes'],cp('afterSelectedInitialization')[key]-cp('beforeSelectedImport')[key]);assert.equal(row.metrics['retained-'+key+'-signedBytes'],cp('retainedAfterGC')[key]-cp('beforeRetention')[key]);assert.equal(row.metrics['released-'+key+'-signedBytes'],cp('releasedAfterGC')[key]-cp('beforeRetention')[key]);assert.equal(row.metrics['releasedFromWarmBase-'+key+'-signedBytes'],cp('releasedAfterGC')[key]-cp('warmBase')[key]);}}
for(const row of summary.memorySummary){const values={};for(const role of roles){values[role]={};for(const [key,stats]of Object.entries(row.metricsByImplementation[role])){const list=summary.memorySignedPerChildRows.filter(r=>r.caseName===row.caseName&&r.implementation===role).sort((a,b)=>a.runNumber-b.runNumber).map(r=>r.metrics[key]);values[role][key]=list;assert.deepEqual(list,stats.values);assert.equal(median(list),stats.median);assert.equal(Math.min(...list),stats.min);assert.equal(Math.max(...list),stats.max);}}for(const ref of ['baseline','original'])for(const [key,comp]of Object.entries(row.candidateComparedWith[ref])){assert.deepEqual(values.candidate[key].map((v,i)=>v-values[ref][key][i]),comp.pairedDifferenceBytes.values);assert.deepEqual(values.candidate[key].map((v,i)=>values[ref][key][i]===0?null:100*(v-values[ref][key][i])/values[ref][key][i]),comp.pairedPercentChange.values);}}
}
async function verifyArtifacts(summary){const figure=await read('figure-validation.json'),visual=await read('visual-inspection.json');assert.equal(figure.summarySHA256,(await fp(path.join(here,'recomputed-summary.json'))).sha256);for(const row of [...figure.files,...visual.files])assert.deepEqual(await fp(path.join(here,row.path)),{bytes:row.bytes,sha256:row.sha256});assert.equal(visual.noObservedClippingOrOverlap,true);assert.equal(figure.axesIncludeAllObservedValues,true);assert.equal(summary.counts.newMeasurementArtifacts,887);assert.equal(summary.counts.ownedPIDObserverSamples,1987);return {figure,visual};}
const {preservation,algorithm}=await authenticatePreservation(),summary=await read('recomputed-summary.json');await recomputeFromPreserved(summary);const {figure,visual}=await verifyArtifacts(summary);
if(process.argv.includes('--verify-only')){const receipt=await read(receiptName),manifest=await read(manifestName);assert.deepEqual(await inventory(here),receipt.inventory);for(const row of manifest.entries)assert.deepEqual(await fp(path.join(here,row.path)),{bytes:row.bytes,sha256:row.sha256});assert.equal((await fp(path.join(here,receiptName))).sha256,manifest.receiptSHA256);console.log(JSON.stringify({status:'passed',readOnly:true,files:manifest.entries.length,receiptSHA256:manifest.receiptSHA256,manifestSHA256:(await fp(path.join(here,manifestName))).sha256,fullSourceAndRawCopiesStable:true}));}
else {const actions=[];for(const name of(await fs.readdir(here)).filter(n=>/^action-.*-\d+\.json$/.test(n)).sort()){const item=await read(name),stem=name.slice(0,-5);for(const [suffix,digest]of [['.source.mjs.snapshot',item.sourceSHA256],['.stdout.txt',item.stdoutSHA256],['.stderr.txt',item.stderrSHA256]])assert.equal((await fp(path.join(here,stem+suffix))).sha256,digest);assert.equal(item.sourceSHA256,item.sourceAfterSHA256);actions.push({path:name,...await fp(path.join(here,name)),exitCode:item.exitCode,source:item.source,startedAt:item.startedAt,finishedAt:item.finishedAt});}assert.equal(actions.length,7);assert.equal(actions.filter(a=>a.exitCode!==0).length,0);
const negativeSigned=summary.memorySignedPerChildRows.reduce((s,r)=>s+Object.entries(r.metrics).filter(([k,v])=>k.endsWith('signedBytes')&&v<0).length,0),negativePaired=summary.memorySummary.reduce((s,r)=>s+Object.values(r.candidateComparedWith).reduce((n,metrics)=>n+Object.values(metrics).reduce((a,m)=>a+m.pairedDifferenceBytes.values.filter(v=>v<0).length,0),0),0),zeroPercent=summary.memorySummary.reduce((s,r)=>s+Object.values(r.candidateComparedWith).reduce((n,metrics)=>n+Object.values(metrics).reduce((a,m)=>a+m.pairedPercentChange.values.filter(v=>v===null).length,0),0),0);assert.equal(negativeSigned,27);assert.equal(negativePaired,845);assert.equal(zeroPercent,686);
const current=await inventory(here),receiptBindings=Object.fromEntries(await Promise.all(['preserved/study/results/timing-attempt-1791846775405.json','preserved/study/results/paired-control-1791846775389.json','preserved/study/results/memory-observations-control-1791847131780.json'].map(async name=>[name,await fp(path.join(here,name))])));
const receipt={schema:'rea-metrics-algorithm-measured-review/v1',frozenAt:new Date().toISOString(),status:'authenticated source-stable measured study; candidate unaccepted without integration',sourceStage:preservation.sourceStage,readinessReceiptSHA256:summary.readinessReceipt.sha256,readinessInventoryFiles:117,readinessInventoryUnchanged:true,readinessManifestSHA256:'6f918727383492e06b3acf856d9f4e2cb938ad3e05fef082f2f3021a6801b2bc',measurementManifestSHA256:summary.manifestSHA256,candidate:summary.candidate,originalSourceBindings:summary.originalSourceBindings,runtime:summary.runtime,productionBaselineAuthenticatedUnchanged:summary.currentProductionSourcesAuthenticatedUnchanged,counts:summary.counts,measuredReceiptBindings:receiptBindings,independentSummary:{path:'recomputed-summary.json',...await fp(path.join(here,'recomputed-summary.json'))},timingAndMemoryIndependentlyRecomputed:true,allMedianRangesSignedOriginalAndBaselineComparisonsRetained:true,negativeSignedChildMetricValues:negativeSigned,negativePairedMetricValues:negativePaired,unavailableZeroControlPercentages:zeroPercent,negativeValuesClipped:false,windows:summary.windows,sourceStudyFiles:1006,preservedExactCurrentSourceAndLogFiles:1006,preservedCurrentBytes:preservation.preservedBytes,fullAlgorithmStage:{inventoryFiles:88,filesIncludingSelfExcludedManifest:89,preservedFiles:algorithm.copies.length,manifestSHA256:algorithm.manifest.sha256,allAcceptanceSourceLogsAnd66FixturePreserved:true,fixtureUsedAsCorrectnessProvenanceOnly:true,sourceStable:true},previousNegativeStudy:{inventoryFiles:1042,filesIncludingSelfExcludedManifest:1043,preservedFiles:1043,manifestSHA256:preservation.previousNegativeStudy.manifestSHA256,receiptSHA256:preservation.previousNegativeStudy.receiptSHA256,retainedUnchanged:true},independentReadinessReview:preservation.independentReadinessProof,rootAlgorithmReview:preservation.rootAlgorithmProof,sourceBeforeAfterStable:true,publicationExcludedLocalOriginalArchives:preservation.publicationExcludedArchives,originalExecutableCopied:false,publicationExcludedStageFiles:algorithm.publicationExcludedLocalArchives,failuresAndCensoring:summary.failureAndCensoring,algorithmPreparationFailures:preservation.algorithmPreparationFailures,consolidationAttempts:actions,currentConsolidationOrFigureFailures:0,historicalReviewFailuresPreserved:true,unrelatedVaultFailuresIncluded:false,figures:figure,visualInspection:visual,limitations:summary.limitations,fullCorrectnessRerun:false,newTimingMemoryOrProfilerRunsDuringConsolidation:0,rejection:summary.rejection,bothCandidateModulesPreservedAsInertEvidence:true,publicProductionCandidateProposalPrepared:false,ownedMeasurementControllersAndChildrenCompleted:true,productionOrOldStageEdited:false,productionIntegrated:false,performanceParityEstablished:false,universalCorrectnessEstablished:false,universalSuperiorityEstablished:false,fullProductComplete:false,inventory:current};
await fs.writeFile(path.join(here,receiptName),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});assert.deepEqual(await inventory(here),current);const entries=Object.entries(current).map(([name,row])=>({path:name,...row})),record=await fp(path.join(here,receiptName));entries.push({path:receiptName,...record});const manifest={schema:'rea-metrics-algorithm-measured-review-freeze/v1',receiptSHA256:record.sha256,entries:entries.sort((a,b)=>a.path.localeCompare(b.path)),files:entries.length,aggregateBytes:entries.reduce((s,r)=>s+r.bytes,0),excludes:[manifestName],externalPublicationExclusions:preservation.publicationExcludedArchives,sourceOnlyInertEvidence:true,candidateAccepted:false,productionIntegrated:false};await fs.writeFile(path.join(here,manifestName),JSON.stringify(manifest,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:receipt.status,receiptSHA256:record.sha256,manifestSHA256:(await fp(path.join(here,manifestName))).sha256,files:entries.length,bytes:manifest.aggregateBytes,counts:receipt.counts,negativeSigned,negativePaired,zeroPercent,candidateAccepted:false}));}
