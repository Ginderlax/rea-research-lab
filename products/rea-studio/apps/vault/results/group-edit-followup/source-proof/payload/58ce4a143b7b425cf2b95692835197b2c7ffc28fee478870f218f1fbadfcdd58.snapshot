import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const here=import.meta.dirname,work=path.resolve(here,'..'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});
export const authorities=[['candidate885','vault-group-edit-next','52a88d027dc910c3ef8723e80690aef98dacdc9c98d43902192663ca43799ff4',885],['rootHTTP21','root-vault-group-edit-http-review-next','83680e5b27eafdd04abaa84d3789bf7e33a1cc01cb0a72f59b567435f760afbd',21],['rootBrowser21','root-vault-group-edit-browser-review-next','3dc5b7d9bebe9419477c7fe38235afc8c14705c83099e2dc889c161587da18cd',21]];
async function tree(root,prefix=''){const out=[];for(const e of await fs.readdir(root,{withFileTypes:true})){assert(!e.isSymbolicLink());const p=prefix+e.name;if(e.isDirectory())out.push(...await tree(path.join(root,e.name),p+'/'));else{assert(e.isFile());out.push(p);}}return out;}
export async function authenticate(){const result=[];for(const[name,folder,pin,count]of authorities){const root=path.join(work,folder),raw=await fs.readFile(path.join(root,'manifest.json'));assert.equal(id(raw).sha256,pin);const m=JSON.parse(raw);assert.equal(m.inventory.length,count);const listed=m.inventory.map(r=>r.path),actual=await tree(root),extra=actual.filter(p=>!listed.includes(p)&&p!=='manifest.json'&&p!=='freeze.json');assert(extra.every(p=>p.split('/').includes('.local')&&m.excluded?.includes('.local/**')),name+' undeclared extra paths');const expected=[...listed,'manifest.json'];if(actual.includes('freeze.json'))expected.push('freeze.json');assert.deepEqual(actual.filter(p=>!extra.includes(p)).sort(),expected.sort());for(const r of m.inventory)assert.deepEqual(id(await fs.readFile(path.join(root,r.path))),{bytes:r.bytes,sha256:r.sha256},name+' '+r.path);result.push({name,folder,manifest:id(raw),payloads:count,declaredLocalExtras:extra,rows:m.inventory});}return result;}
if(process.argv[1]&&path.resolve(process.argv[1])===import.meta.filename){const output=await authenticate();await fs.writeFile(path.join(here,'authority-before.json'),JSON.stringify(output,null,2)+'\n',{flag:'wx'});for(const row of output){const b=await fs.readFile(path.join(work,row.folder,'manifest.json'));await fs.writeFile(path.join(here,row.name+'-manifest.json.snapshot'),b,{flag:'wx'});}process.stdout.write(JSON.stringify({authenticated:output.map(r=>({name:r.name,payloads:r.payloads,manifest:r.manifest,localExtras:r.declaredLocalExtras.length}))})+'\n');}
