import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const base=path.resolve(import.meta.dirname,'..'),owned=path.join(base,'work/notes-inline-production-installation-next'),sha=b=>createHash('sha256').update(b).digest('hex');
function inventory(root,rel=''){return fs.readdirSync(path.join(root,rel),{withFileTypes:true}).flatMap(e=>{assert.ok(!e.isSymbolicLink());const n=rel?rel+'/'+e.name:e.name;return e.isDirectory()?inventory(root,n):[n];}).sort();}
function authenticate(folder,name,pin,count){const root=path.join(base,'work',folder),b=fs.readFileSync(path.join(root,name));assert.equal(sha(b),pin);const manifest=JSON.parse(b),rows=Object.entries(manifest.inventory).map(([path,r])=>({path,...r}));assert.equal(rows.length,count);assert.deepEqual(inventory(root),[...rows.map(r=>r.path),name].sort());for(const r of rows){assert.ok(r.path&&!r.path.includes('..')&&!r.path.includes('\\'));const x=fs.readFileSync(path.join(root,r.path));assert.equal(x.length,r.bytes);assert.equal(sha(x),r.sha256);}return{folder,manifest:{path:name,bytes:b.length,sha256:pin},records:rows};}
const sourceReview=authenticate('notes-inline-publication-plan-independent-review','review-manifest.json','e1fd6f5b68e91a18bab40c018379e2603270bb8837e733fb2fb40b76dc2c9b44',46),fix=authenticate('notes-inline-browser-qualification-fix-next','freeze-manifest.json','913cfe7fbd41c638a624483deca1713c8fb4df44e56d65a0f3fe6458b606cf0a',31),fixReview=authenticate('notes-inline-browser-qualification-independent-review','review-manifest.json','b52075922191c225b74464789b37537ff02cedc379ea4a96d2d49f5fa142bd3d',14);
function receipt(folder,n,pin){const b=fs.readFileSync(path.join(base,'work',folder,n));assert.equal(sha(b),pin);return JSON.parse(b);}
const s=receipt(sourceReview.folder,'review-validation.json','98576a1d667b507107f583a2c48a7466e6ab4e944a0f745ce03b7d0e94f994e4'),q=receipt(fixReview.folder,'review-validation.json','6e3e0da2c39bb23555eaa83c98ff9c146bb980fc73500966b894e63eec8aa726');assert.equal(s.status,'base-plan-accepted-addendum-byte-integrity-accepted-one-metadata-correction-required');assert.equal(s.findings.length,1);assert.equal(s.findings[0].affectedRecords,12);assert.equal(q.acceptance,true);assert.equal(q.metadataCorrectionAccepted,true);assert.equal(q.soleChangedField,'qualification');assert.equal(q.changedRows,12);assert.equal(q.baseMapSHA256,s.findings[0].sourceSha256);assert.equal(q.productAcceptanceExpanded,false);
const record={schema:'rea-notes-inline-root-installation-approval/v1',at:new Date().toISOString(),acceptance:true,sourceOnly:true,sourceReview,qualificationCorrection:fix,qualificationIndependentAcceptance:fixReview,exactPlan162:'ab0bccd1aaf43da7b932193a0991531659b2e5017b72c28933b37bcc7ddcf3ae',exactAddendum17:'697af388815ed18acacdfebf69dd58eb6ddb601c84722e0ba2185401afaa9aff',originalMapUnchanged:'ec5839d46fd9ff16e0e752bfac86b850689731b0bfa6a9fb87ffd4d4aaa8c2d7',qualificationOverride:'50a6f287e52f68c73988a487e2e045e4e0b1652d8ac5c8d9a2804d8e9f872804',correctedMap:'48d1677a8a5b4faa80102caadd61f072c6cc90efd1e60b79a31ea1d21d1e3e66',install8AfterReviewed34BeforeImages:true,publicCopies836ThenAdditional32QualificationRecords:true,independentReviewsRemainUnmodified:true,applicationExecutionsByThisCollector:0,fullParity:false,superiority:false};const p=path.join(owned,'installation-approval.json');fs.writeFileSync(p,JSON.stringify(record,null,2)+'\n',{flag:'wx'});fs.copyFileSync(import.meta.filename,path.join(owned,'approval-collector.mjs.snapshot'),fs.constants.COPYFILE_EXCL);console.log(JSON.stringify({approval:p,sha256:sha(fs.readFileSync(p)),accepted:true,sourceOnly:true,applicationWrites:0}));
