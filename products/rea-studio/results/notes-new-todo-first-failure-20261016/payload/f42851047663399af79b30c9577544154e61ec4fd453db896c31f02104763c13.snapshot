const readme=Buffer.from('# First New To-do experimental failure\n\nThe first hosted seven-target composition failed: **107/111 finite groups passed; 4 failed**, and **7/8 real Chromium cases passed; 1 failed**. These separate counts are not aggregated. [Actual run](https://github.com/Ginderlax/rea-research-lab/actions/runs/'+run+') tested committed source `'+commit+'`.\n\nThe raw finite failures include three older notebook-trash asynchronous publication scenarios and one HTTP400 canonical-record comparison. The browser failure is a canonical-record comparison involving `metadataEdited:false`. Corrections and a fresh hosted replay are pending. This proposal was not installed into the active product. Generic publication controls and syntax checks do not establish New To-do acceptance.\n\nBoth complete original GitHub artifact ZIPs, all1,110 uploaded files, all68 nonsource roles, raw API objects and complete job logs are recoverable here. The manifest maps logical roles to exact stored objects and records decoded and stored SHA-256 identities. Gzip objects are storage compression only; their original bytes remain identified. Source aliases omitted as separate objects remain inside the exact complete ZIPs.\n\nThe failed attempt receipts retain `productTests:0` because their collector aborted on child exit1 before assigning a success summary. The separately preserved raw TAP and Playwright reports prove the actual111 and8 executed cases. Two earlier backup-reader diagnostics are preserved; final v4 authenticated the source proof and then correctly rejected the failed-attempt gate. The data-only filing also independently checked all12 tooling snapshots per job and the separate browser source postcheck. Success-only observation contracts not reached by the failed reader are not claimed.\n\nNo full original application, database or GUI comparison, complete feature parity, security acceptance or superiority is claimed. No product, original, test, build or browser was executed locally for this filing. Historical installation and successful receipts retain their original scope.\n');fs.writeFileSync(path.join(target,'README.md'),readme,{flag:'wx'});
for(const r of records){const stored=read(target,r.path);assert.deepEqual(id(stored),pin(r.storage));assert.deepEqual(id(r.storage.encoding==='gzip'?gunzipSync(stored):stored),pin(r));}
const rows=[{path:prefix+'/README.md',before:null,after:id(readme)},{path:prefix+'/preservation-manifest.json',before:null,after:id(manifestBytes)},...[...objects].map(([n,p])=>({path:prefix+'/'+n,before:null,after:p}))];const total=rows.reduce((n,r)=>n+r.after.bytes,0);assert(rows.length<=240&&total<=16*1024*1024);assert.equal(jobs.reduce((n,j)=>n+j.readableUploadedFiles,0),1110);assert.equal(jobs.reduce((n,j)=>n+j.retainedNonsourceArtifactRoles,0),68);
const authority={schema:'rea-Notes-new-todo-first-failure-public-copy-authority/v1',stage,runId:run,sourceCommit:commit,files:rows.length,bytes:total,rows,manifest:id(manifestBytes),records:records.length,uniquePublicObjects:objects.size,rawRoleBytes,sourceOnlyFiling:true,allStoredAndDecodedCopiesExact:true,completeLocalBackupsReadable:true,completePublicHostedArtifactZips:2,all1110HostedFilesRecoverableInsidePublicZips:true,retainedNonsourceRoles:68,exactToolingPinsPerJob:12,observedFinite:{tests:111,pass:107,fail:4},observedBrowser:{tests:8,passed:7,failed:1},recordedContractsPassed:false,correctionPending:true,productionInstalled:false,independentReviewPending:true,activeFilesWritten:0,gitMutations:0,localProductExecutions:0,localOriginalExecutions:0,localTests:0,localBuilds:0,localBrowserExecutions:0,historicalReceiptsRebound:false,fullParity:false,superiority:false};const authorityBytes=Buffer.from(JSON.stringify(authority,null,2)+'\n');fs.writeFileSync(path.join(stage,'copy-authority.json'),authorityBytes,{flag:'wx'});console.log(JSON.stringify({authority:id(authorityBytes),files:rows.length,bytes:total,records:records.length,manifest:id(manifestBytes),observedFinite:authority.observedFinite,observedBrowser:authority.observedBrowser}));
