        "sha256": "fb91b2da8e977c8a060669eeaffc278336ffb966cb095c2a769e4b29beb50f2e",
        "lineStart": 221,
        "lineEnd": 221,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/loki/query-editor/index.md#L221-L221"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.659a7f69f07369480c8e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can also adjust the size of the time window that the log context loads, so you can expand or narrow the range of surrounding logs without leaving the context view.",
      "headingPath": [
        "Loki query editor",
        "Create a log query",
        "Show log context"
      ],
      "source": {
        "path": "docs/sources/datasources/loki/query-editor/index.md",
