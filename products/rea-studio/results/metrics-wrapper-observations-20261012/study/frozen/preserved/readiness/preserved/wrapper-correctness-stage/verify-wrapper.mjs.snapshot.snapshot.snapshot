import fs from 'node:fs/promises';import path from 'node:path';import {pathToFileURL} from 'node:url';import {createRequire} from 'node:module';import assert from 'node:assert/strict';import {here,sha,authenticateOriginal} from './authenticate-original.mjs';import {canonical,packet,metadataFor} from './canonical.mjs';import {valuesForSpec} from './workloads.mjs';
const preparation=JSON.parse(await fs.readFile(path.join(here,'preparation.json'))),authority=await authenticateOriginal(),original=createRequire(authority.entry)(authority.entry),candidate=await import('./candidate-wrapper.mjs'),baseline=await import('./candidate-baseline.mjs'),manifest=JSON.parse(await fs.readFile(path.join(here,'preserved/measured-manifest.json')));assert.equal(sha(await fs.readFile(path.join(here,'candidate-wrapper.mjs'))),preparation.candidate.sha256);assert.equal(sha(await fs.readFile(path.join(here,'selector-algorithm.mjs'))),preparation.candidate.helperSHA256);assert.equal(sha(canonical(metadataFor(candidate))),manifest.expectedMetadataSHA256);let packetChecks=0;
for(const [caseName,row]of Object.entries(manifest.expectedFiles)){const values=valuesForSpec(row.spec);assert.equal(sha(canonical(values)),row.inputSHA256);for(const native of [original,baseline,candidate]){const field={name:'synthetic',type:'number',config:{nullValueMode:'connected'},values,state:{}};let result=native.reduceField({field,reducers:row.spec.reducers});assert.equal(sha(canonical(packet(field,result))),row.canonicalOutputSHA256);packetChecks++;result=native.reduceField({field,reducers:row.spec.reducers});assert.equal(sha(canonical(packet(field,result))),row.repeatOutputSHA256);packetChecks++;result=native.reduceField({field,reducers:[row.spec.reducers[0]]});assert.equal(sha(canonical(packet(field,result))),row.subsetOutputSHA256);packetChecks++;}}
const probeSource="import {singlePercentile as actual} from './selector-algorithm.mjs';\nexport let calls=0;export function reset(){calls=0;}export function singlePercentile(...args){calls++;return actual(...args);}\n",entry=await fs.readFile(path.join(here,'candidate-wrapper.mjs'),'utf8');await fs.writeFile(path.join(here,'results/selector-probe.mjs.snapshot'),probeSource,{flag:'wx'});await fs.writeFile(path.join(here,'results/candidate-probe.mjs.snapshot'),entry.replace("'./selector-algorithm.mjs'","'./selector-probe.mjs'"),{flag:'wx'});
// Probe modules live only in this work stage. The isolated import substitution
// observes dispatch without changing the measured candidate or frozen helper.
await fs.writeFile(path.join(here,'selector-probe.mjs'),probeSource,{flag:'wx'});await fs.writeFile(path.join(here,'candidate-probe.mjs'),entry.replace("'./selector-algorithm.mjs'","'./selector-probe.mjs'"),{flag:'wx'});const probed=await import('./candidate-probe.mjs'),probe=await import('./selector-probe.mjs'),dispatch=[];
for(const [label,reducers,expectedCalls]of [['standard',['mean','min','max','sum','delta'],0],['single-p95',['p95'],1],['all-percentiles',original.fieldReducers.list().filter(r=>/^p\d+$/.test(r.id)).map(r=>r.id),0],['mixed',['mean','p95'],0],['duplicates',['p95','p95'],0],['unknown-filtered-single',['unknown','p95'],1]]){probe.reset();const make=()=>({type:'number',config:{nullValueMode:'connected'},values:[null,9,4,1,2,7,3],state:{calcs:{unrelated:'retained'}}}),a=make(),b=make();assert.equal(canonical(packet(a,probed.reduceField({field:a,reducers}))),canonical(packet(b,original.reduceField({field:b,reducers}))));assert.equal(probe.calls,expectedCalls,label);dispatch.push({label,calls:probe.calls,expectedCalls});}
probe.reset();const direct=probed.fieldReducers.get('p95').reduce({type:'number',values:[9,3,7,null],config:{}},true,false);assert.equal(canonical(direct),canonical(original.fieldReducers.get('p95').reduce({type:'number',values:[9,3,7,null],config:{}},true,false)));assert.equal(probe.calls,1);dispatch.push({label:'direct-registry',calls:probe.calls,expectedCalls:1});
probe.reset();const cached={type:'number',config:{},values:[1,2],state:{calcs:{p95:91}}};assert.equal(probed.reduceField({field:cached,reducers:['p95']}).p95,91);assert.equal(probe.calls,0);dispatch.push({label:'cached-single',calls:probe.calls,expectedCalls:0});
assert.equal(sha(await fs.readFile(path.join(here,'candidate-wrapper.mjs'))),preparation.candidate.sha256);assert.equal(sha(await fs.readFile(path.join(here,'selector-algorithm.mjs'))),preparation.candidate.helperSHA256);assert.equal(sha(await fs.readFile(preparation.production.path)),preparation.production.sha256);
const receipt={schema:'rea-metrics-wrapper-correctness-controls/v1',checkedAt:new Date().toISOString(),status:'passed',authority,packetChecks,dispatch,dispatchChecks:dispatch.length,allSevenFrozenFixturesExact:true,candidateEntrySHA256:preparation.candidate.sha256,helperSHA256:preparation.candidate.helperSHA256,probeImportSubstitutionOnly:true,probeIsNotMeasuredCandidate:true,measurementRun:false,profileRun:false,performanceEstablished:false,productionChanged:false};await fs.writeFile(path.join(here,'results/wrapper-controls.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:'passed',packetChecks,dispatchChecks:dispatch.length,measurementRun:false}));
