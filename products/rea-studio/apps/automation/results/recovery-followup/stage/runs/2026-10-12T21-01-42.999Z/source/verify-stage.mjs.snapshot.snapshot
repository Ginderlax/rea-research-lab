import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import {spawnSync} from 'node:child_process';import assert from 'node:assert/strict';
const stage=path.dirname(fileURLToPath(import.meta.url)),app=path.join(stage,'products/rea-studio/apps/automation'),hash=b=>createHash('sha256').update(b).digest('hex'),baseline=JSON.parse(await fs.readFile(path.join(stage,'production-baseline.json'))),diagnosticsOnly=process.argv.includes('--diagnostics-only'),run=path.join(stage,'runs',new Date().toISOString().replaceAll(':','-'));await fs.mkdir(path.join(run,'source'),{recursive:true});
async function sources(folder,prefix=''){const rows=[];for(const entry of await fs.readdir(folder,{withFileTypes:true})){const name=prefix+entry.name;if(!prefix&&['.local','runs','review-before','production-baseline'].includes(entry.name))continue;if(entry.isDirectory())rows.push(...await sources(path.join(folder,entry.name),name+'/'));else if(entry.isFile()&&(/\.(mjs|md)$/.test(name)||name.startsWith('products/')&&name.endsWith('.json'))){const bytes=await fs.readFile(path.join(folder,entry.name));rows.push({path:name,bytes:bytes.length,sha256:hash(bytes)});}}return rows.sort((a,b)=>a.path.localeCompare(b.path));}
async function production(){for(const entry of baseline.selectedFiles){const bytes=await fs.readFile(path.join(baseline.sourceRoot,entry.path));assert.equal(bytes.length,entry.bytes);assert.equal(hash(bytes),entry.sha256,'Selected production source/receipt changed '+entry.path);}}
await production();const before=await sources(stage);for(const entry of before){const output=path.join(run,'source',entry.path+'.snapshot');await fs.mkdir(path.dirname(output),{recursive:true});await fs.writeFile(output,await fs.readFile(path.join(stage,entry.path)),{flag:'wx'});}await fs.writeFile(path.join(run,'source-before.json'),JSON.stringify(before,null,2)+'\n');
const initialDiagnostic=spawnSync(process.execPath,[path.join(stage,'http-boundary-diagnostic.mjs')],{cwd:stage,encoding:'utf8',timeout:10000,maxBuffer:1024*1024,windowsHide:true});await fs.writeFile(path.join(run,'initial-http-diagnostic.stdout.txt'),initialDiagnostic.stdout??'');await fs.writeFile(path.join(run,'initial-http-diagnostic.stderr.txt'),initialDiagnostic.stderr??'');assert.equal(initialDiagnostic.status,0);const names=diagnosticsOnly?[]:['native.test.mjs','native-http.test.mjs','native-server.test.mjs','routing.test.mjs','routing-original.test.mjs','native-client.test.mjs'],result=spawnSync(process.execPath,['--test','--test-concurrency=1','--test-reporter=tap',...names.map(name=>path.join(app,name)),path.join(stage,'recovery.test.mjs'),path.join(stage,'http-boundary.test.mjs')],{cwd:stage,encoding:'utf8',timeout:90000,maxBuffer:16*1024*1024,windowsHide:true}),stdout=result.stdout??'',stderr=result.stderr??'';
await fs.writeFile(path.join(run,'stdout.txt'),stdout);await fs.writeFile(path.join(run,'stderr.txt'),stderr);const summary=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(key=>[key,Number(stdout.match(new RegExp('^# '+key+' (\\d+)$','m'))?.[1]??-1)])),after=await sources(stage);await fs.writeFile(path.join(run,'source-after.json'),JSON.stringify(after,null,2)+'\n');await production();const sourceStable=JSON.stringify(before)===JSON.stringify(after),runReceipt={schema:'rea-automation-routing-recovery-attempt/v1',completedAtUtc:new Date().toISOString(),diagnosticsOnly,exitCode:result.status,error:result.error?.message??null,summary,sourceStable,before,after,stdoutSha256:hash(stdout),stderrSha256:hash(stderr)};await fs.writeFile(path.join(run,'run.json'),JSON.stringify(runReceipt,null,2)+'\n');assert.ok(sourceStable);assert.equal(result.status,0);assert.deepEqual(summary,{tests:diagnosticsOnly?15:74,pass:diagnosticsOnly?15:74,fail:0,cancelled:0,skipped:0,todo:0});
if(diagnosticsOnly){console.log(JSON.stringify({runPath:path.relative(stage,run),summary,sourceStable}));process.exit(0);}
function marker(label){const lines=stdout.split(/\r?\n/),start=lines.findIndex(line=>line.startsWith('# {"'+label+'":'));assert.ok(start>=0);let encoded='';for(let n=start;n<lines.length&&n<start+4096;n++){if(!lines[n].startsWith('# ')||lines[n].startsWith('# Subtest:'))break;encoded+=lines[n].slice(2);assert.ok(encoded.length<=1024*1024);try{let decoded='';for(let i=0;i<encoded.length;i++){if(encoded[i]!=='\\'){decoded+=encoded[i];continue;}const next=encoded[++i];assert.ok(next==='\\'||next==='#');decoded+=next;}return JSON.parse(decoded)[label];}catch{}}throw Error('Incomplete marker '+label);}
const original=marker('automationRoutingOriginalObservations');assert.deepEqual(original.counts,{exactOutputMatches:1812,rejectionOutcomeMatches:10,deliberateSafetyDeviations:3,boundedRepresentationDeviations:48});assert.equal(original.observations.switchNodeExecutions+original.observations.mergeModeExecutions,1873);assert.equal(original.observations.coreEnqueueHelperExecutions,7);assert.equal(original.observations.corePartialDrainExecutions,4);const observationRoot=path.join(stage,'.local/automation-routing-original/observations'),originalPath=path.resolve(original.path);assert.ok(originalPath.startsWith(observationRoot+path.sep));const originalBytes=await fs.readFile(originalPath);assert.equal(hash(originalBytes),original.sha256);assert.equal(originalBytes.length,original.bytes);await fs.writeFile(path.join(run,'original-results.json'),originalBytes,{flag:'wx'});const recoveryBytes=await fs.readFile(path.join(stage,'recovery-observations.json'));await fs.writeFile(path.join(run,'recovery-observations.json'),recoveryBytes,{flag:'wx'});
const httpBoundaryBytes=await fs.readFile(path.join(stage,'http-boundary-observations.json'));await fs.writeFile(path.join(run,'http-boundary-observations.json'),httpBoundaryBytes,{flag:'wx'});const initialDiagnosticBytes=await fs.readFile(path.join(stage,'http-boundary-initial-diagnosis.json'));await fs.writeFile(path.join(run,'http-boundary-initial-diagnosis.json'),initialDiagnosticBytes,{flag:'wx'});for(const entry of baseline.reviewFiles)assert.equal(hash(await fs.readFile(path.join(stage,entry.snapshotPath))),entry.sha256);const changed=[];for(const entry of baseline.selectedFiles.filter(entry=>entry.path.startsWith('apps/automation/')&&!entry.path.includes('/results/'))){const file=path.join(stage,'products/rea-studio',entry.path);if(hash(await fs.readFile(file))!==entry.sha256)changed.push(entry.path);}assert.deepEqual(changed,['apps/automation/native.mjs']);const receipt={schema:'rea-automation-routing-recovery-stage-validation/v1',completedAtUtc:new Date().toISOString(),summary,sourceStable,selectedProductionFilesStable:baseline.selectedFiles.length,changedImplementationFiles:changed,sourceFingerprints:before,sourceAssistance:'Existing frozen source-assisted production implementation; prospective recovery consistency and cooperative guard additions are newly authored. Original primitive runtime bytes remain unchanged.',reviewReceiptSha256:baseline.reviewReceiptSha256,baselineReceiptSha256:'b85b20796ca6c029ff37cc955e91b62b547ec493721dad4a6342413ddfa03801',originalCounts:original.counts,originalExecutions:original.observations,nodeAndModeExecutions:1873,runPath:path.relative(stage,run).replaceAll('\\','/'),recoveryModel:'Immediate queued batch consistency with recorded predecessor output and deferred Wait routing; not authentication or proof of a complete historical graph prefix/trace/item-link semantics',httpBudgetModel:'500 prepared input-item attempts, including guard-rejected attempts; redirect hops separately capped 0–10 per item and share per-item timeout',initial69ReceiptSha256:hash(await fs.readFile(path.join(stage,'historical/recovery-checkpoint-69.json.snapshot'))),evidence:[{path:path.relative(stage,path.join(run,'stdout.txt')).replaceAll('\\','/'),bytes:Buffer.byteLength(stdout),sha256:hash(stdout)},{path:path.relative(stage,path.join(run,'stderr.txt')).replaceAll('\\','/'),bytes:Buffer.byteLength(stderr),sha256:hash(stderr)},{path:path.relative(stage,path.join(run,'original-results.json')).replaceAll('\\','/'),bytes:originalBytes.length,sha256:hash(originalBytes)},{path:path.relative(stage,path.join(run,'recovery-observations.json')).replaceAll('\\','/'),bytes:recoveryBytes.length,sha256:hash(recoveryBytes)},{path:path.relative(stage,path.join(run,'http-boundary-observations.json')).replaceAll('\\','/'),bytes:httpBoundaryBytes.length,sha256:hash(httpBoundaryBytes)},{path:path.relative(stage,path.join(run,'http-boundary-initial-diagnosis.json')).replaceAll('\\','/'),bytes:initialDiagnosticBytes.length,sha256:hash(initialDiagnosticBytes)},{path:path.relative(stage,path.join(run,'initial-http-diagnostic.stdout.txt')).replaceAll('\\','/'),bytes:Buffer.byteLength(initialDiagnostic.stdout??''),sha256:hash(initialDiagnostic.stdout??'')}],limits:['Cooperative deadline recheck after awaited checkpoint; blocked IO/wall-clock preemption not claimed','Malformed local queue consistency checks do not authenticate coordinated state rewriting','Finite original node/mode/helper matrix; no full scheduler/server/editor/SQL or product parity','Only isolated stage modified; exact production historical receipts preserved'],fullParity:false,securityCertified:false,performanceSuperiority:false};await fs.writeFile(path.join(stage,'stage-validation.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({summary,sourceStable,changed,original:original.counts,receiptSha256:hash(await fs.readFile(path.join(stage,'stage-validation.json'))),nativeSha256:hash(await fs.readFile(path.join(app,'native.mjs')))}));
