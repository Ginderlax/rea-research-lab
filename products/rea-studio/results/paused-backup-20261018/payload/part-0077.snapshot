    {
      "id": "grafana.candidate.06384aa6f48229de4576",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set to `true` to disable [brute force login protection by username](https://cheatsheetseries.owasp.org/cheatsheets/Authentication_Cheat_Sheet.html#account-lockout). Default is `false`. User will be unable to login for 5 minutes if all login attempts are spent within a 5 minute window.",
      "headingPath": [
