    {
      "id": "grafana.candidate.6f22fd97e09b1c6f59af",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The older non-TraceQL powered editor has been removed. Any existing queries using the older editor will be automatically migrated to the new TraceQL-powered editor.",
      "headingPath": [
        "What’s new in Grafana v11.0",
        "Data sources",
        "Removal of old Tempo Search and Loki Search in Tempo",
        "Removal of old Tempo Search tab"
      ],
