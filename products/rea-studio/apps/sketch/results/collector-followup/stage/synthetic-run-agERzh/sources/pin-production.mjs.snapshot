import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),product=path.resolve(here,'../../outputs/rea-research-lab/products/rea-studio'),hash=b=>createHash('sha256').update(b).digest('hex'),names=[...['core.mjs','client.mjs','server.mjs','fixtures.mjs','app.test.mjs','client.test.mjs','vendor-oracle.mjs','vendor-oracle.test.mjs','geometry-oracle.mjs','geometry.test.mjs','geometry-client.test.mjs','README.md','THIRD-PARTY-NOTICE.md'].map(name=>'apps/sketch/'+name),'lib/storage.mjs','apps/sketch/results/excalidraw-compatibility.json'],receipt=JSON.parse(await fs.readFile(path.join(here,'baseline/apps/sketch/results/geometry-validation.json'))),files=[];
