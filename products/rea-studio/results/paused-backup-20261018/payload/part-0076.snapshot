    },
    {
      "id": "grafana.candidate.d2408e957f1e54fdd033",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When using TestData with Grafana Alerting, be aware of the following limitations.",
      "headingPath": [
        "TestData alerting",
        "Limitations"
      ],
      "source": {
        "path": "docs/sources/datasources/testdata/alerting/index.md",
        "gitBlobSha": "526f2432d34ad25382f4112893fa3beb53ea371c",
        "sha256": "4cdd8331327a15709d9d85afccaa1042c774296c7bfcbb031eef5b6c999fc194",
        "lineStart": 130,
        "lineEnd": 130,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/testdata/alerting/index.md#L130-L130"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.26d0c1b5bcdad26d818c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana evaluates alert rules on the backend without dashboard context. Template variables like `$varname` aren't resolved during alert evaluation. Use fixed values in the scenario options instead.",
      "headingPath": [
        "TestData alerting",
        "Limitations",
        "Template variables aren't supported in alert queries"
      ],
      "source": {
        "path": "docs/sources/datasources/testdata/alerting/index.md",
        "gitBlobSha": "526f2432d34ad25382f4112893fa3beb53ea371c",
