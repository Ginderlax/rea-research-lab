          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.eb15b9fab06d89d8e93e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We've implemented support for adding time regions to the Time series panel. Time regions provide a more contextualized experience, enabling you to highlight certain days of the week, such as Monday to Friday to display work weeks, right alongside your data. Time regions are also a useful way to highlight specific parts of a day like night, work hours, or whatever you want to define for each day. They allow you to quickly orient yourself in parts of the day or ignore highlighted parts of the time series.",
      "headingPath": [
        "What’s new in Grafana v10.0",
        "Dashboards and visualizations",
        "Time series time region support"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-0.md",
        "gitBlobSha": "744b2d1230211f70aa6158231d9505e732ac0315",
        "sha256": "dd311853975cca7ef6ad474588f832614dd9c445856343920d238a1ddf183739",
        "lineStart": 161,
        "lineEnd": 161,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-0.md#L161-L161"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.24a19f300f0b6d3291ef",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To learn more, refer to our [time region documentation](../../dashboards/build-dashboards/annotate-visualizations/#add-time-regions).",
      "headingPath": [
        "What’s new in Grafana v10.0",
        "Dashboards and visualizations",
        "Time series time region support"
      ],
      "source": {
