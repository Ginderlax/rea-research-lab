    {
      "id": "grafana.candidate.64f1fafb7581026aeef6",
      "syntaxRole": "list-item",
      "sourceText": "- You can't use the Grafana UI to edit or delete provisioned resources.",
      "headingPath": [
        "On-prem file provisioning",
        "How it works"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/provision-resources/_index.md",
        "gitBlobSha": "cfbd59bfc467a4ac42b645e91ad33686a4b2e081",
