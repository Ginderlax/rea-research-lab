    {
      "id": "grafana.candidate.b55be533bf7a90027df2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you select an element that you've added to a canvas, you can access [configuration options](#selected-element-options) for it that are dependent on the element type.",
