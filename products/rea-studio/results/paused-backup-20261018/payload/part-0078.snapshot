    {
      "id": "grafana.candidate.f6639752a3b93443f32a",
      "syntaxRole": "list-item",
      "sourceText": "- **CTEs** are temporary named result sets that help make complex queries more readable and reusable.",
      "headingPath": [
        "SQL expressions",
        "Transform data with SQL expressions"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/sql-expressions/index.md",
        "gitBlobSha": "3e545e4b2f9dfa0e933cbe79b173d05a64036723",
        "sha256": "f821b02e2b87c25ad95fd5dee78a7973144d794c06fd2c6fcad576ccf23ed53d",
        "lineStart": 64,
        "lineEnd": 64,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/panels-visualizations/query-transform-data/sql-expressions/index.md#L64-L64"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
