      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.2dc891e9dc28d02e95cc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Learn more about this feature in [Transformations](../../panels-visualizations/query-transform-data/transform-data/#transformation-functions).",
      "headingPath": [
        "What's new in Grafana v7.0",
        "Transformations"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-0.md",
        "gitBlobSha": "f8a2dff1665364c77c678ce11827aaa9c6f62083",
        "sha256": "4e6c2d51a33ed64dd73b0f776a7c738b03a4cd0e49ad15073950a020ec0f53f0",
        "lineStart": 92,
        "lineEnd": 92,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v7-0.md#L92-L92"
      },
      "applicability": {
