    },
    {
      "id": "grafana.candidate.9775bd038709fa7c0993",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Important**: When role sync is configured, any changes of user roles and organization membership made manually in Grafana will be overwritten on next user login. Assign user organizations and roles in the IdP instead.",
      "headingPath": [
        "Configure role sync for SAML"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/configure-saml-team-role-mapping/_index.md",
        "gitBlobSha": "727e58aab87aa12f202bdd630c6b5d4a2d80ec31",
        "sha256": "ee4d4ffddc50f2b7c4ad41a2aaaea84eaeae21bba1b53770850ee119744b6cc1",
        "lineStart": 101,
        "lineEnd": 101,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/saml/configure-saml-team-role-mapping/_index.md#L101-L101"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
