    },
    {
      "id": "grafana.candidate.b71aa0c71accfb832504",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The tags you configure must be present in the spans attributes or resources for a trace to metrics span link to appear. You can optionally configure a new name for the tag. This is useful if the tag has dots in the name and the target data source doesn't allow using dots in labels. For example, you can remap `service.name` to `service_name`.",
      "headingPath": [
        "Configure trace to metrics correlation",
        "Set up a basic configuration"
      ],
      "source": {
        "path": "docs/sources/datasources/tempo/configure-tempo-data-source/configure-trace-to-metrics.md",
        "gitBlobSha": "3a874f96d0fd6bc3d0ed6847f9cf1e6fda46c416",
        "sha256": "07a34143f831f7b56fc90f88ad40803b34f7d385a85ec30be2c12ba376c15cae",
