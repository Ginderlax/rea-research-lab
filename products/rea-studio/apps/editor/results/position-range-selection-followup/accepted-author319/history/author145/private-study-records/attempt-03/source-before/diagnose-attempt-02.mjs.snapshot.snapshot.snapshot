import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const root=path.dirname(fileURLToPath(import.meta.url)),raw=await fs.readFile(path.join(root,'.local/attempt-02/original-comparisons.json')),data=JSON.parse(raw),differences=[];for(const x of data.observations)for(let i=0;i<x.original.rows.length;i++){const a=x.original.rows[i],b=x.candidate.rows[i];if(JSON.stringify(a)!==JSON.stringify(b))differences.push({label:x.label,original:a,candidate:b});}assert.equal(differences.length,5);for(const d of differences){assert.ok(d.original.name.includes('.readonly '));assert.equal(d.original.error.name,'TypeError');assert.equal(d.candidate.error.name,'TypeError');assert.equal(d.original.error.message.replace('[object Object]','<receiver>'),d.candidate.error.message.replace(/#<(Position|Range|Selection)>/,'<receiver>'));}
const result={schema:'rea-editor-value-api-verifier-failure-diagnosis/v1',raw:{bytes:raw.length,sha256:createHash('sha256').update(raw).digest('hex')},packets:data.counts.packets,differences,failedGroups:1,passedGroups:8,reason:'Five V8 getter-assignment TypeError receiver labels differ across VM realms. Keep raw errors, normalize only that receiver label in readonly assignment comparison, add post-attempt unchanged property reads. Explicit original library errors and every other observed engine error remain exact.',candidateUnchanged:true,originalApiExecutions:0};await fs.writeFile(path.join(root,'failure-diagnosis-02.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({packets:result.packets,differences:differences.length,candidateUnchanged:true}));
