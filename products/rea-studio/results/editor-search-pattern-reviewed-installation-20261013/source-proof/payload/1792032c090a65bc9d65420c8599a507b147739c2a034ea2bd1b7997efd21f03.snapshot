import fs from 'node:fs/promises';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
const here=import.meta.dirname,work=path.resolve(here,'..');
const stage=path.join(work,'editor-search-pattern-textarea-fix-next');
const old=path.join(work,'editor-search-pattern-next');
const negative=path.join(work,'editor-search-pattern-independent-review');
const id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});
const run=path.join(here,'runs/source-audit-'+new Date().toISOString().replace(/[:.]/g,'-'));
async function write(p,b){await fs.mkdir(path.dirname(path.join(run,p)),{recursive:true});await fs.writeFile(path.join(run,p),b,{flag:'wx'});}
const json=v=>Buffer.from(JSON.stringify(v,null,2)+'\n');
async function files(root,prefix=''){const names=[];for(const entry of await fs.readdir(root,{withFileTypes:true})){assert(!entry.isSymbolicLink());const name=prefix+entry.name;if(entry.isDirectory())names.push(...await files(path.join(root,entry.name),name+'/'));else{assert(entry.isFile());names.push(name);}}return names;}
async function authenticate(root,manifestName,sha,count){const raw=await fs.readFile(path.join(root,manifestName));assert.equal(id(raw).sha256,sha);const m=JSON.parse(raw);const rows=Array.isArray(m.inventory)?m.inventory:Object.entries(m.inventory).map(([p,r])=>({path:p,...r}));assert.equal(rows.length,count);assert.deepEqual((await files(root)).sort(),[...rows.map(r=>r.path),manifestName].sort());const result=[];for(const r of rows){assert(!path.isAbsolute(r.path)&&!r.path.split(/[\\/]/).some(s=>s===''||s==='..'||s==='.'));const b=await fs.readFile(path.join(root,r.path));assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256},r.path);result.push({path:r.path,...id(b)});}return{manifest:{path:manifestName,...id(raw)},schema:m.schema,rows:result};}
const input=[['correction',stage,'freeze-manifest.json','0b4297c0d1d498ed614f6d98b8850fd05520594f850e7448c82e9652b9653f17',852],['old573',old,'freeze-manifest.json','7f975ae3f7a0827f5b9ade231bd121c5b4028f17d88758455fd680962ff0f878',573],['negative141',negative,'review-manifest.json','76c89a780e5c8e2a7774d925073b500a1e8a5f5c164c86a6e4e71b809717db31',141]];
const before=[];for(const[n,root,file,sha,count]of input){const r=await authenticate(root,file,sha,count);before.push({name:n,...r});}
await write('authority-before.json',json(before));
await write('collector.mjs.snapshot',await fs.readFile(import.meta.filename));
const app='candidate/products/rea-studio/apps/editor/';
const current=await fs.readFile(path.join(stage,app+'client.mjs'));
const former=await fs.readFile(path.join(old,app+'client.mjs'));
assert.deepEqual(id(current),{bytes:19681,sha256:'113a0781b166c9fb4c8994abcefeac0818d55719975e35dfdbead13fa4f3d62a'});
await write('source/current-client.mjs.snapshot',current);await write('source/old-client.mjs.snapshot',former);
const deltasBytes=await fs.readFile(path.join(stage,'correction-deltas.json'));await write('source/correction-deltas.json.snapshot',deltasBytes);
const deltas=JSON.parse(deltasBytes).rows.filter(r=>r.file===app+'client.mjs');assert.equal(deltas.length,2);
let reconstructed=current.toString('utf8');const steps=[];
for(const delta of [...deltas].reverse()){assert.equal(reconstructed.split(delta.after).length-1,1);assert.deepEqual(id(Buffer.from(reconstructed)),delta.idAfter);reconstructed=reconstructed.replace(delta.after,delta.before);assert.deepEqual(id(Buffer.from(reconstructed)),delta.idBefore);steps.push({label:delta.label,...id(Buffer.from(reconstructed))});}
assert(Buffer.from(reconstructed).equals(former));
const sevenNames=['workspace-search.mjs','file-path.mjs','server.mjs','search-pattern.mjs','search-pattern-worker.mjs','search-pattern-session.mjs'].map(n=>app+n).concat('candidate/products/rea-studio/lib/storage.mjs');
const seven=[];for(const name of sevenNames){const a=await fs.readFile(path.join(stage,name)),b=await fs.readFile(path.join(old,name));assert(a.equals(b),name);seven.push({path:name,...id(a)});await write('source/'+name+'.snapshot',a);}
const after=[];for(const[n,root,file,sha,count]of input){const r=await authenticate(root,file,sha,count);after.push({name:n,...r});}assert.deepEqual(after,before);await write('authority-after.json',json(after));
await write('validation.json',json({schema:'rea-editor-textarea-correction-independent-source-audit/v1',accepted:true,sourceStable:true,strictAuthorities:before.map(r=>({name:r.name,manifest:r.manifest,payloads:r.rows.length,schema:r.schema})),runtimeSubstitutions:steps,unchangedBackendSeven:seven,saveAndGenerationsAndLifecycleUnchangedByExactInverse:true,originalExecutions:0,browserExecutions:0,behavioralTests:0,candidateWrites:0,productionWrites:0,fullProductParity:false}));
process.stdout.write(JSON.stringify({run:path.relative(here,run),sourceAudit:true,strict852:true,old573Exact:true,negative141Exact:true,runtimeSubstitutions:2,backend7Exact:true})+'\n');
