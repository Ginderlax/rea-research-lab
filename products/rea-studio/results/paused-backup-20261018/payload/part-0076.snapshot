    {
      "id": "grafana.candidate.ace0c4372ee655677a60",
      "syntaxRole": "list-item",
      "sourceText": "- **Downstream** — simulates a failure in the data source or network. The alert enters an error state with a downstream classification.",
      "headingPath": [
        "TestData alerting",
        "Test error and no-data conditions",
        "Errors"
      ],
      "source": {
