        "lineEnd": 28,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/developer-resources/api-reference/http-api/api-legacy/sso-settings.md#L28-L28"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
          "enterprise",
          "oss",
