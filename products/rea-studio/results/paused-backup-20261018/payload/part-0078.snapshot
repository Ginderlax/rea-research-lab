        "lineStart": 13,
        "lineEnd": 13,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/shared/alerts/alerting-provisioning-export-produces.md#L13-L13"
      },
      "applicability": {
        "status": "unresolved-no-explicit-oss-products-label",
        "products": []
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
