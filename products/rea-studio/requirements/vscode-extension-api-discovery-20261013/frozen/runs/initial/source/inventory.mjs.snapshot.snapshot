  if(n.parameters)row.parameters=n.parameters.map(p=>({name:nodeName(p,p.getText(sf)),span:span(p.getStart(sf),p.end),optional:Boolean(p.questionToken),rest:Boolean(p.dotDotDotToken),modifiers:mods(p),type:p.type?.getText(sf)??null,initializer:p.initializer?.getText(sf)??null,documentation:docs(p)}));
  row.typeParameters=(n.typeParameters??[]).map(p=>({name:p.name.text,span:span(p.getStart(sf),p.end),constraint:p.constraint?{text:p.constraint.getText(sf),span:span(p.constraint.getStart(sf),p.constraint.end)}:null,default:p.default?{text:p.default.getText(sf),span:span(p.default.getStart(sf),p.default.end)}:null,modifiers:mods(p),documentation:docs(p)}));
