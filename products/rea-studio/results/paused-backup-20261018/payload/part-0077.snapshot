    },
    {
      "id": "grafana.candidate.d36c34a35b4844511f4c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When a user logs in using an OAuth provider, Grafana verifies that the access token has not expired. When an access token expires, Grafana uses the provided refresh token (if any exists) to obtain a new access token.",
      "headingPath": [
        "Configure GitLab OAuth authentication",
        "Configure GitLab authentication client using the Grafana configuration file",
        "Configure a refresh token"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/gitlab/index.md",
        "gitBlobSha": "60055d69865bdbc143aa7f58e3b08d13b64a58a6",
        "sha256": "11af01f967c74718eb99ac11c02fdfa3c3722d3fb4566916e5a70c0a5ecd2ac5",
        "lineStart": 122,
        "lineEnd": 122,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/gitlab/index.md#L122-L122"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.d4a8feaeb886159bc2ee",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana uses a refresh token to obtain a new access token without requiring the user to log in again. If a refresh token doesn't exist, Grafana logs the user out of the system after the access token has expired.",
      "headingPath": [
        "Configure GitLab OAuth authentication",
        "Configure GitLab authentication client using the Grafana configuration file",
        "Configure a refresh token"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/gitlab/index.md",
        "gitBlobSha": "60055d69865bdbc143aa7f58e3b08d13b64a58a6",
        "sha256": "11af01f967c74718eb99ac11c02fdfa3c3722d3fb4566916e5a70c0a5ecd2ac5",
        "lineStart": 124,
        "lineEnd": 124,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/gitlab/index.md#L124-L124"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c95cd76868b3805ffa59",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, GitLab provides a refresh token.",
      "headingPath": [
        "Configure GitLab OAuth authentication",
        "Configure GitLab authentication client using the Grafana configuration file",
        "Configure a refresh token"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/gitlab/index.md",
        "gitBlobSha": "60055d69865bdbc143aa7f58e3b08d13b64a58a6",
        "sha256": "11af01f967c74718eb99ac11c02fdfa3c3722d3fb4566916e5a70c0a5ecd2ac5",
        "lineStart": 126,
        "lineEnd": 126,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/gitlab/index.md#L126-L126"
      },
      "applicability": {
