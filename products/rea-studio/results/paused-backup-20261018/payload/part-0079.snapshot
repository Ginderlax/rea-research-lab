    {
      "id": "grafana.candidate.ad3bc66d6c541f22576b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To sort nested and top-level rows in nested tables, click a column title to change the sort order from default to descending to ascending. Each time you click, the sort order changes to the next option in the cycle. You can sort multiple columns by holding the `Cmd` or `Ctrl` key and clicking the column name.",
      "headingPath": [
