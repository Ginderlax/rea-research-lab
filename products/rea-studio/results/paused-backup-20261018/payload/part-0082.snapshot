import { readFile, writeFile, mkdir } from 'node:fs/promises';
import { createHash } from 'node:crypto';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
const root = path.dirname(fileURLToPath(import.meta.url));
const registryPath = path.resolve(root, '../../outputs/rea-research-lab/products/rea-studio/requirements/workspace-products.json');
const registry = JSON.parse(await readFile(registryPath, 'utf8')), catalogue = registry.documentCatalogues.find(item => item.id === 'grafana-documents');
if (catalogue.commit !== '6193dc03311b631b9727b560d24369e683dc396e' || catalogue.files.length !== 772 || catalogue.truncated) throw new Error('Unexpected source census.');
const acquired = [];
let next = 0;
async function acquire(entry) {
  const destination = path.join(root, 'corpus', entry.path), url = `https://raw.githubusercontent.com/grafana/grafana/${catalogue.commit}/${entry.path}`;
  let bytes, retrievedAt, reused = false;
  try { bytes = await readFile(destination); reused = true; retrievedAt = (await import('node:fs/promises')).stat ? (await (await import('node:fs/promises')).stat(destination)).mtime.toISOString() : null; } catch (error) { if (error.code !== 'ENOENT') throw error; }
  if (!bytes) {
    let last;
    for (let attempt = 0; attempt < 3; attempt++) { try { const response = await fetch(url); if (!response.ok) throw new Error(`${response.status} ${entry.path}`); bytes = Buffer.from(await response.arrayBuffer()); retrievedAt = new Date().toISOString(); break; } catch (error) { last = error; await new Promise(resolve => setTimeout(resolve, 250 * (attempt + 1))); } }
    if (!bytes) throw last;
  }
  const gitBlobSha = createHash('sha1').update(Buffer.from(`blob ${bytes.length}\0`)).update(bytes).digest('hex');
  if (gitBlobSha !== entry.gitBlobSha || bytes.length !== entry.bytes) throw new Error(`Original bytes do not match pinned tree: ${entry.path}`);
  if (!reused) { await mkdir(path.dirname(destination), { recursive: true }); await writeFile(destination, bytes); }
  acquired.push({ path: entry.path, localPath: destination, url, bytes: bytes.length, gitBlobSha, sha256: createHash('sha256').update(bytes).digest('hex'), retrievedAt, byteVerified: true });
  if (acquired.length % 100 === 0) console.log(`Verified ${acquired.length}/${catalogue.files.length} docs.`);
}
const failures = [];
await Promise.all(Array.from({ length: 8 }, async () => { while (next < catalogue.files.length) { const entry = catalogue.files[next++]; try { await acquire(entry); } catch (error) { failures.push({ path: entry.path, error: error.message }); } } }));
acquired.sort((a, b) => a.path < b.path ? -1 : a.path > b.path ? 1 : 0);
const receipt = { candidateTag: 'v13.2.3', commit: catalogue.commit, corpusPredicate: catalogue.selectionPredicate, catalogueSha256: catalogue.inventorySha256, acquiredAt: new Date().toISOString(), expectedFiles: catalogue.files.length, verifiedFiles: acquired.length, bytes: acquired.reduce((sum, item) => sum + item.bytes, 0), failures, files: acquired, limitations: ['Only docs/sources Markdown is acquired by this pass. Included shared content, external linked references, code-generated API references and visual screenshot details require separate coverage.', 'Documents mix OSS, Enterprise and Cloud. File acquisition alone establishes neither OSS applicability nor semantic feature completeness.'] };
await writeFile(path.join(root, 'acquisition.json'), JSON.stringify(receipt, null, 2) + '\n');
console.log(JSON.stringify({ verifiedFiles: receipt.verifiedFiles, expectedFiles: receipt.expectedFiles, bytes: receipt.bytes, failures }));
if (failures.length) process.exitCode = 1;
