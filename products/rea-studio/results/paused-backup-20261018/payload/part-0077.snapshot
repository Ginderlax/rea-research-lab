    },
    {
      "id": "grafana.candidate.ac09c5c1bcddc084ba3f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set the setting `allow_assign_grafana_admin` under `[auth.azuread]` to `true` for this to work. If the setting is set to `false`, the user is assigned the role of `Admin` of the default organization, but not server administrator privileges.",
      "headingPath": [
        "Configure Microsoft Entra ID OAuth authentication",
        "Register your application with Microsoft Entra ID",
        "Assign server administrator privileges"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/entraid/index.md",
        "gitBlobSha": "59fb58efe7a59116a30801f34622d72a3c482076",
