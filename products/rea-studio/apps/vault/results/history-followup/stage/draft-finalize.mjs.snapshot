import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import {here} from './harness.mjs';
const sha=b=>createHash('sha256').update(b).digest('hex'),read=n=>fs.readFile(path.join(here,n)),bind=async n=>{const b=await read(n);return{path:n,bytes:b.length,sha256:sha(b)}},runName='runs/draft-fixed-final',run=JSON.parse(await read(runName+'/validation.json'));
assert.equal(run.sourceStable,true);assert.deepEqual(run.tests,{tests:41,pass:41,fail:0,skipped:0,cancelled:0});assert.equal(run.originalProcessExecutions,24);assert.equal(run.hostProcesses,5);for(const f of run.sourceBefore){const b=await read(f.path);assert.equal(sha(b),f.sha256,'Tested source changed '+f.path);}
const prior=JSON.parse(await read('draft-correction-baseline.json')),policy=JSON.parse(await read('draft-policy-preservation.json')),lifecycle=JSON.parse(await read('lifecycle-preservation.json'));for(const [prefix,files]of [[prior.preservationPrefix,prior.selectionStageFiles],...prior.independentReviews.map(r=>[r.prefix+'/',r.files]),[policy.prefix+'/',policy.files],[lifecycle.prefix+'/',lifecycle.files]])for(const f of files){const b=await read(prefix+f.path+'.snapshot');assert.equal(sha(b),f.sha256);assert.equal(b.length,f.bytes);}
const original=JSON.parse(await read('preserved-original-stage/history-validation.final.json.snapshot')),candidates=run.sourceBefore.filter(f=>['client.mjs','history.mjs','server.mjs','kdbx.mjs','xml.mjs'].includes(f.path));for(const f of candidates.filter(f=>f.path!=='client.mjs'))assert.equal(f.sha256,original.sourceBindings.candidate.find(v=>v.path===f.path).sha256);
const observDir=runName+'/draft-selection-observations';await fs.mkdir(path.join(here,observDir));const observations=[];for(const base of ['restore-selection-observation.json','selection-boundaries','lifecycle-boundaries']){const dir=path.join(here,'.local/observations',base);const names=base.endsWith('.json')?[base]:(await fs.readdir(dir)).filter(n=>n.endsWith('.json')).map(n=>base+'/'+n);for(const name of names){const b=await read('.local/observations/'+name),target=observDir+'/'+name;await fs.mkdir(path.dirname(path.join(here,target)),{recursive:true});await fs.writeFile(path.join(here,target),b);observations.push(await bind(target));}}
const exactPending=await read('same-editor-draft.test.mjs'),exactDirty=await read('preexisting-draft.test.mjs');assert.equal(sha(exactPending),'688c325bf72747320ec19f94c3c6856fdfb6b1054053c0e2251d4d96e8266643');assert.equal(sha(exactDirty),'c9ec466204154d2e4db9c7c6e8c1cf9b02d91063a45fc3ebd2d1ffade0ed7bbe');
const receipt={schema:'rea-stage-keepass-draft-lifecycle-correction-final/v1',completed:new Date().toISOString(),scope:'Separate stage-only draft/lifecycle client correction. Historical original181/selection546/review evidence remains separately bound.',focused:await bind(runName+'/validation.json'),counts:run.tests,sourceStable:true,sourceBefore:run.sourceBefore,sourceAfter:run.sourceAfter,externalBefore:run.externalBefore,externalAfter:run.externalAfter,priorBefore:run.priorBefore,priorAfter:run.priorAfter,candidateSources:candidates,historyAndServerImplementationUnchanged:true,originalAccounting:original.originalAccounting,originalAssemblyExecutions:24,stagedHostProcesses:5,DOMElementModelGroups:25,browserExecutions:0,originalGuiExecutions:0,newCaseAccounting:{original18Groups:18,priorSelectionGroups:10,unchangedSameEditorCases:2,unchangedDirtyBeforeRestore:1,additionalDraftGroups:6,controlledTimerBodyWithPathAdapter:1,additionalDisposalGroups:3},sourceAssistedDirtyGuard:await bind('draft-contract-map.json'),lifecycleAdapter:lifecycle.adaptations,draftObservations:observations,historicalEvidence:{selection546ManifestSha256:prior.selectionStageManifestSha256,selection546ReceiptSha256:prior.selectionStageReceiptSha256,selection546ArtifactsPreserved:546,original181IncludedAndUnchanged:true,independentReviewArtifactCounts:[101,36,16,33],allPriorArtifactsAuthenticatedBeforeAfter:true,pendingFailureSourceSha256:sha(exactPending),dirtyFailureSourceSha256:sha(exactDirty),old18CompatibilityReceiptSha256:'895cb736a9b285bfd0c541b6f76a4dc577aca88675be38e3bab9d2a8be105aee',oldReceiptsRebound:false},changeSummary:['Seven-value signatures, input revisions and mutation request generations retain drafts entered during Save/Restore/read awaits.','Already dirty Restore refuses before an effect request, tied to exact released dialog source spans.','New-entry Save retains its committed ID for the next draft Save; late Delete converts newer values to a New draft.','Delayed generated passwords cannot overwrite subsequent typed values.','Returned host cleanup clears its timer, private detached fields and pending view publications/rearming without locking the server session.'],limits:original.boundsAndLimits,claims:{productionChanged:false,fullProductParity:false,securityParity:false,superiority:false,vendorRuntimeInCandidate:false,independentPostFixReviewPending:true}};await fs.writeFile(path.join(here,'draft-validation.final.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
const files=[];async function walk(relative=''){for(const e of await fs.readdir(path.join(here,relative),{withFileTypes:true})){const n=relative?relative+'/'+e.name:e.name;if(['draft-preservation-manifest.json','draft-freeze.json'].includes(n)||n==='.local/observations'||n==='.local/oracle-probe')continue;if(e.isDirectory())await walk(n);else if(e.isFile())files.push(await bind(n));else throw new Error('Unexpected artifact link '+n);}}await walk();files.sort((a,b)=>a.path.localeCompare(b.path,'en'));await fs.writeFile(path.join(here,'draft-preservation-manifest.json'),JSON.stringify({schema:'rea-keepass-draft-lifecycle-preservation/v1',count:files.length,files,strictInventory:true,excludedMutableDirectories:['.local/observations','.local/oracle-probe'],metadataExclusions:['draft-preservation-manifest.json','draft-freeze.json']},null,2)+'\n',{flag:'wx'});const freeze={schema:'rea-keepass-draft-lifecycle-freeze/v1',frozen:new Date().toISOString(),receipt:await bind('draft-validation.final.json'),manifest:await bind('draft-preservation-manifest.json'),allExecutableTestDocsAndEvidenceFrozen:true,productionChanged:false};await fs.writeFile(path.join(here,'draft-freeze.json'),JSON.stringify(freeze,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(freeze));
