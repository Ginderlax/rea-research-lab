import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {identity,same} from '../notes-inline-publication-plan-next/notes-inline-provenance.mjs';const root=import.meta.dirname;
async function walk(dir,prefix=''){const rows=[];for(const e of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){if(!prefix&&e.name==='freeze-manifest.json')continue;assert.equal(e.isSymbolicLink(),false);const p=prefix+e.name;if(e.isDirectory())rows.push(...await walk(path.join(dir,e.name),p+'/'));else rows.push({path:p,...identity(await fs.readFile(path.join(dir,e.name)))});}return rows;}
const rows=await walk(root),manifest={schema:'rea-notes-inline-browser-publication-addendum-freeze/v1',at:new Date().toISOString(),strict:true,files:rows.length,bytes:rows.reduce((n,r)=>n+r.bytes,0),inventory:Object.fromEntries(rows.map(r=>[r.path,{bytes:r.bytes,sha256:r.sha256}])),selfExcluded:true,validationSha256:identity(await fs.readFile(path.join(root,'validation.json'))).sha256};await fs.writeFile(path.join(root,'freeze-manifest.json'),JSON.stringify(manifest,null,2)+'\n',{flag:'wx'});for(const r of rows)same(identity(await fs.readFile(path.join(root,r.path))),r);console.log(JSON.stringify({files:manifest.files,bytes:manifest.bytes,manifest:identity(await fs.readFile(path.join(root,'freeze-manifest.json'))),receipt:identity(await fs.readFile(path.join(root,'validation.json'))),map:identity(await fs.readFile(path.join(root,'public-preservation-map.json')))},null,2));
