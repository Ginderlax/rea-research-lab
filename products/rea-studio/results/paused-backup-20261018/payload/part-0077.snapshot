      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b8a4614b6a7e2c07eef3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The following configurations are set by default when you start the Grafana Docker container. When running in Docker you cannot change the configurations by editing the `conf/grafana.ini` file. Instead, you can modify the configuration using [environment variables](../configure-grafana/#override-configuration-with-environment-variables).",
      "headingPath": [
        "Configure a Grafana Docker image",
        "Default paths"
      ],
      "source": {
