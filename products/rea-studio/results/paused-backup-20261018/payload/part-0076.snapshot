    },
    {
      "id": "grafana.candidate.1161939094fe62a73f3c",
      "syntaxRole": "table-row",
      "sourceText": "| **Label value**  | Profile type, label | Returns the values for the selected label, scoped to the selected profile type.                                                                                                                                 |",
      "headingPath": [
        "Pyroscope template variables",
        "Query variable types"
      ],
      "source": {
        "path": "docs/sources/datasources/pyroscope/template-variables/index.md",
