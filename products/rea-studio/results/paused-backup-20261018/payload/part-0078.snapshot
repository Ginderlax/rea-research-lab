    },
    {
      "id": "grafana.candidate.18cf8bc3ff0eb52e6f7b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Graphona has hired a consultant to assist the Marketing team. The consultant should only be able to access the SEO dashboard in the Analytics folder.",
