          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.62f8ad0e8414406f0a47",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Refer to the feature support table in the [Tempo data source overview](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/tempo/) for details on alerting support.",
      "headingPath": [
        "Troubleshoot Tempo data source issues",
        "Other common issues",
        "TraceQL alerting not available"
      ],
      "source": {
