    {
      "id": "grafana.candidate.7834c015287f0a83b6b6",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Set the callback URL for your OAuth2 app to `http://<my_grafana_server_name_or_ip>:<grafana_server_port>/login/generic_oauth`.",
      "headingPath": [
        "Configure Generic OAuth authentication",
        "Configure generic OAuth authentication client using the Grafana configuration file",
        "Steps"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/generic-oauth/index.md",
