          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.0bb6c22096cc754239b9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In the notification policy, you can also configure how often notifications are sent for each [group of alerts](#group-notifications). There are three distinct timers applied to groups within the notification policy:",
      "headingPath": [
        "Group alert notifications",
        "Timing options"
      ],
      "source": {
        "path": "docs/sources/alerting/fundamentals/notifications/group-alert-notifications.md",
