import fs from 'node:fs/promises';
import {createHash} from 'node:crypto';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
const root=new URL('./',import.meta.url), app=new URL('products/rea-studio/apps/notes/',root), hash=b=>createHash('sha256').update(b).digest('hex');
const extra=JSON.parse(await fs.readFile(new URL('../notes-notebooks-next/license-and-special-id-provenance.json',root)));
for(const row of extra){const bytes=await fs.readFile(new URL('../notes-notebooks-next/'+row.path,root));if(hash(bytes)!==row.sha256)throw new Error('Prior source changed');await fs.mkdir(path.dirname(fileURLToPath(new URL(row.path,root))),{recursive:true});try{await fs.writeFile(new URL(row.path,root),bytes,{flag:'wx'});}catch(e){if(e.code!=='EEXIST'||hash(await fs.readFile(new URL(row.path,root)))!==row.sha256)throw e;}}
await fs.writeFile(new URL('license-and-special-id-provenance.json',root),JSON.stringify(extra,null,2)+'\n',{flag:'wx'});
async function edit(name,transform){const filename=new URL(name,app),old=await fs.readFile(filename,'utf8'),next=transform(old);if(next===old)throw new Error('No transform for '+name);await fs.writeFile(filename,next);}
await edit('notebook-original-oracle.mjs',s=>s.replace("new URL('./results/notebooks-followup/stage/',import.meta.url)","new URL('../../../../',import.meta.url)").replace('source-provenance.json.snapshot','prior-source-provenance.json').replaceAll("record.path+'.snapshot'","record.path").replace('license-and-special-id-provenance.json.snapshot','license-and-special-id-provenance.json').replace("special.path+'.snapshot'","special.path"));
await edit('server.mjs',s=>s.replace("const stateKey =", "import {changeNotebookTrash,restoreNoteFromTrash,trashOrganizationRows} from './notebook-trash.mjs';\n\nconst stateKey =").replace("if(action==='notebook-list')return organizationList(await state(store));","if(action==='notebook-list'){const s=await state(store),rows=organizationList(s);return{...rows,notebooks:trashOrganizationRows(s,rows.notebooks)};}\n  if(['notebook-trash','notebook-restore'].includes(action))return exclusive(async()=>{const original=await state(store),result=changeNotebookTrash(original,{...input,action},new Date().toISOString());await store.set(stateKey,result.state);const rows=organizationList(result.state);return{...rows,notebooks:trashOrganizationRows(result.state,rows.notebooks),changedNotes:result.changedNotes,changedNotebooks:result.changedNotebooks};});").replace("const time=new Date().toISOString(),updated = { ...note, metadataEdited:true,userUpdatedAt:time, deletedAt: action === 'delete' ? time : null, updatedAt:time, revision: note.revision + 1 };","const time=new Date().toISOString();if(action==='restore'){const result=restoreNoteFromTrash(s,note.id,time);await store.set(stateKey,result.state);return result.note;}const updated = { ...note, metadataEdited:true,userUpdatedAt:note.userUpdatedAt??note.joplin?.props.user_updated_time??note.updatedAt, deletedAt:time, updatedAt:time, revision: note.revision + 1 };"));
await edit('client.mjs',s=>s.replace("noteDestination=el('select')","trashNotebook=el('button','Move notebook to trash','button'),restoreNotebook=el('button','Restore notebook','button'),noteDestination=el('select')").replace('moveNotebook,noteDestination,moveNote]','moveNotebook,trashNotebook,restoreNotebook,noteDestination,moveNote]').replace('Create notebooks, rename them, and choose a parent to organize a tree. Save your draft before changing organization.','Organize notebooks or move a notebook with its descendants to trash. Restoring also restores independently trashed descendant notes. Save your draft first.').replace('function choices(control,first,value){','function choices(control,first,value,manage=false){').replace('option.disabled=!row.editable;','option.textContent+=(row.trashed?\' · trash\':\'\');option.disabled=manage?!(row.editable||row.restoreEligible):!row.editable;').replace("choices(organizationChoice,'Choose a notebook','');","choices(organizationChoice,'Choose a notebook','',true);").replace("row.editable?'':' · retained shared/trash metadata'","row.trashed?' · trash':row.editable?'':' · retained shared metadata'").replace('  moveNote.onclick=',"  trashNotebook.onclick=()=>run(()=>organize(async()=>{const row=organizationState.notebooks.find(row=>row.id===organizationChoice.value);if(!row?.trashEligible)throw new Error('Choose an active local notebook.');if(!window.confirm(`Move “${row.path}” and all its subnotebooks and regular notes to trash? Attachments remain stored. You can restore it.`))return;await api('notebook-trash',{id:row.id,revision:organizationState.revision,confirmed:true});status.textContent='Notebook and descendants moved to trash.';}));\n  restoreNotebook.onclick=()=>run(()=>organize(async()=>{const row=organizationState.notebooks.find(row=>row.id===organizationChoice.value);if(!row?.restoreEligible)throw new Error('Choose a trashed local notebook.');if(!window.confirm(`Restore “${row.path}”, its trashed subnotebooks and notes, including notes trashed separately? A trashed parent remains in trash; this notebook becomes top level.`))return;await api('notebook-restore',{id:row.id,revision:organizationState.revision,confirmed:true});status.textContent='Notebook restored with its contents.';}));\n  moveNote.onclick="));
console.log(JSON.stringify({adapted:['notebook-original-oracle.mjs','server.mjs','client.mjs'],productionModified:false}));
