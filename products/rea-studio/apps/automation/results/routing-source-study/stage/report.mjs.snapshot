import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import {verifyOriginalIntegrity} from './original-harness.mjs';
const here=path.dirname(fileURLToPath(import.meta.url)),hash=bytes=>createHash('sha256').update(bytes).digest('hex'),read=async file=>JSON.parse(await fs.readFile(path.join(here,file),'utf8'));
const names=(await fs.readdir(path.join(here,'runs'))).sort(),runs=[];for(const name of names)runs.push(await read('runs/'+name+'/run.json'));const latest=runs.at(-1),original=await read(latest.runPath+'/original-results.json'),baseline=await read('baseline-validation.json'),ui=await read('ui-observations.json'),browserSources=(await read('runs/2026-10-12T19-50-15.155Z/run.json')).before;
if(!latest.sourceStable||latest.results.some(result=>result.exitCode!==0||result.skipped))throw new Error('Latest complete run did not pass');
const fingerprints={};for(const[file,expected]of Object.entries(latest.after)){const bytes=await fs.readFile(path.join(here,file));if(hash(bytes)!==expected.sha256)throw new Error('Source changed since latest focused run: '+file);fingerprints[file]={bytes:bytes.length,sha256:hash(bytes)};}
const baselineCurrent=[];for(const entry of baseline.fingerprints){const saved=await fs.readFile(path.join(here,'baseline',entry.path)),current=await fs.readFile(path.join(baseline.source,entry.path));if(hash(saved)!==entry.sha256||hash(current)!==entry.sha256)throw new Error('Frozen production/baseline changed: '+entry.path);baselineCurrent.push({path:entry.path,sha256:entry.sha256,bytes:entry.bytes});}
await verifyOriginalIntegrity();const artifacts={};for(const file of ['original-results.json','unreachable-pending.baseline.json','disabled-trigger.baseline.json','ui-observations.json','ui-routing-completed.png','ui-routing-completed.txt','ui-routing-controls.txt','baseline-validation.json','setup-failure.json','failures/original-test-syntax-001.json','failures/original-test-syntax-001.mjs','failures/prepare-ui-syntax.mjs','failures/run-001-corrections.json',latest.runPath+'/run.json']){const bytes=await fs.readFile(path.join(here,file));artifacts[file]={bytes:bytes.length,sha256:hash(bytes)};}
for(const run of runs.filter(run=>run.results.some(result=>result.exitCode!==0))){const file=run.runPath+'/run.json',bytes=await fs.readFile(path.join(here,file));artifacts[file]={bytes:bytes.length,sha256:hash(bytes)};}
const tests=latest.results.reduce((n,result)=>n+result.tests,0),manifest=await read('baseline/native-original-manifest.json'),own=await read('original-manifest.json');if(original.observations.switchNodeExecutions+original.observations.mergeModeExecutions!==Object.values(original.counts).reduce((sum,value)=>sum+value,0))throw new Error('Differential accounting is inconsistent');
const report={createdAt:new Date().toISOString(),status:'Frozen isolated stage ready for independent review/integration; production unchanged',fullParity:false,sourceCommit:manifest.sourceCommit,environment:{node:process.version,platform:process.platform,arch:process.arch},tests:{total:tests,passed:tests,failed:0,skipped:0,sourceStable:latest.sourceStable,runPath:latest.runPath,commands:latest.results},original:{binding:'n8n/n8n-workflow/n8n-core/n8n-nodes-base 2.16.0',archives:manifest.archives,sharedDependencySourceFiles:Object.keys(manifest.files).length,ownRetainedFiles:Object.keys(own.files).length,packageLockSha256:manifest.packageLockSha256,authenticatedBeforeAndAfter:true,nodeAndModeExecutions:original.observations.switchNodeExecutions+original.observations.mergeModeExecutions,observations:original.observations,comparisonAccounting:original.counts,scope:original.scope,countsAreIndependentOfTestGroups:true,serializedObservationLimit:'Exact assertions run in memory; JSON raw observations cannot preserve undefined properties or signed zero. Source-stable TAP and exact assertion code are retained.',errorEquality:'Rejection presence only; messages/classes/codes are not claimed equal.',dangerousPropertyCases:'Original accepted all3 dangerous-key cases; candidate rejected3, not counted as exact matches.',nonJsonArrayCases:'48 released outputs contain non-index array properties. Candidate rejects them because JSON checkpoints cannot retain them; not counted as exact or rejection-outcome matches.',fullSchedulerNodeExecutions:0,fullReleasedServerExecutions:0},applicationEvidence:{nativeRoutingTests:latest.results.find(result=>result.label==='native-stage'),preservedRegressionTests:latest.results.find(result=>result.label==='prior-native-regressions'),scope:'Actual staged native API/backend and synthetic HTTP endpoints, saved JSON continuations, own temporary workspace stores and fresh workspace sessions; preserved prior corpus has only import paths adapted and uses an isolated minimal stage host, not shared host validation.',checks:['all port/index shapes and immediate item links','deep/shallow/override-empty/suffix/preferred merge semantics','first/all/fallback Switch behavior','input and branch ownership','Cartesian/append/Switch allocation limits; work/deadline/abort limits','whole graph unsupported settings and ports rejected before execution','partial Merge queues serialized and resumed once after Wait','fresh HTTP host session same-run restart,2 downstream requests exactly once','Wait cancellation survives another restart and retains cancelled history without downstream requests','public/history omit joins/deferred marker; terminal records clear buffers','unreachable persisted unsupported node rejects through actual HTTP recovery with zero requests','contradictory routing queue states reject','enabled Manual Trigger consistency with disabled preserved trigger first'],productionHostValidated:false},browserEvidence:{observation:'ui-observations.json',scope:ui.scope,checks:ui.checks,sources:browserSources,sourceBinding:'Browser host started after the corresponding modules were prepared and these sources were subsequently captured by the source-stable19:50:15 run. Browser observation preceded final enabled-trigger fix; earlier source identity is preserved explicitly. No pre/post browser-source snapshot assertion is claimed.',currentUiModuleHashesMatch:['candidate/native-client.mjs','candidate/native-example.mjs'].every(file=>browserSources[file].sha256===fingerprints[file].sha256),freshBrowserAgainstFinalEnabledTriggerFix:false,uiSyntaxChecked:true,proofs:ui.proofs},findingsAndCorrections:[{finding:'Historical validator accepts disconnected unsupported pending node',evidence:'unreachable-pending.baseline.json',correction:'Stage pending/join names use same Manual reachable graph; actual HTTP recovery regression rejects before scheduling.'},{finding:'Historical state creation chooses disabled first Manual Trigger',evidence:'disabled-trigger.baseline.json',failedRun:'runs/2026-10-12T19-54-11.029Z',correction:'Stage creation selects same enabled Manual trigger as preflight/resume; meaningful regression passes.'},{finding:'Initial Wait routed output before checkpoint; overrideEmpty/private-alias Merge discrepancies',evidence:'runs/2026-10-12T19-27-21.175Z',correction:'Defer Wait routing until resume; retain released shallow-target/customizer alias effects in private clones.'},{finding:'Deep merge object into array incorrectly replaced array',evidence:'runs/2026-10-12T19-37-33.351Z',correction:'Retain array type; explicitly reject named array properties that cannot survive JSON storage.'},{finding:'Advanced field duplicate destinations compared all pairs',evidence:'runs/2026-10-12T19-44-17.065Z',correction:'Use last source lookup per destination, matching released helper.'},{finding:'Signed zero replaced despite released SameValueZero retention',evidence:'runs/2026-10-12T19-44-47.802Z',correction:'Retain equal existing scalar; JSON equality matches bounded released strict/fuzzy behavior.'},{finding:'Original drain harness used generic schemas which stripped explicit parameters; fixture retained undefined rightValue',evidence:['runs/2026-10-12T19-40-14.508Z','runs/2026-10-12T19-40-57.378Z'],correction:'Clone caller document, materialize explicit ports/parameters, omit absent JSON field. Harness scope remains explicit.'},{finding:'Setup/import and test/UI preparation syntax failures',evidence:['setup-failure.json','failures/original-test-syntax-001.json','failures/prepare-ui-syntax.mjs'],correction:'Use actual engine filename and correct test/preparation syntax; failed bytes preserved.'}],intentionalDeviations:['Recursive dangerous Merge own keys reject','Named array output properties reject','Caller/branch data isolated; general JS identity/alias parity not claimed','New allocation/work/input bounds may reject values accepted by original','Restricted executable node versions, options and expressions; unknown documents preserved'],remainingGaps:['Full released scheduler/server/database/editor and deployed product comparisons','Complete Merge class/router/default-schema and SQL execution','Legacy versions; arbitrary expressions/code, date/regex filters, credentials/providers/OAuth/binary attachments','Cycles/repeated batches/multiple edges per input/partial execution/source-overwrite item links','Production durability/security/reliability/performance/superiority assessment'],optionInventory:{path:'source-option-inventory.json',definitions:118,scope:'Static literal parameter definitions across retained released versions; generated filter schemas/dynamic spreads explicitly excluded'},fingerprints,frozenProductionBaselineVerifiedUnchanged:baselineCurrent,artifacts,historicalRuns:runs.map(run=>({path:run.runPath,sourceStable:run.sourceStable,results:run.results}))};
await fs.writeFile(path.join(here,'validation.json'),JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({tests,originalNodeAndModeExecutions:report.original.nodeAndModeExecutions,comparisons:original.counts,coreHelperExecutions:original.observations.coreEnqueueHelperExecutions,coreDrainBlockExecutions:original.observations.corePartialDrainExecutions,receiptSha256:hash(await fs.readFile(path.join(here,'validation.json')))}));
