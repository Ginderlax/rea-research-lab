idateChunks:rows,orderedBoundaryAndSha256Match:true});}\n   const forced=comparisons.find(value=>value.polynomial===polynomial&&value.name==='forced-max.bin');assert.deepEqual(forced.originalChunks.map(value=>value.length),[MAX,MAX,127]);const held=await original(workspace,['cat','blob',forced.originalChunks[0].sha256]);assert.equal(held.length,MAX);assert.equal(hash(held),forced.originalChunks[0].sha256);await original(workspace,['check','--read-data']);console.log(JSON.stringify({polynomial,files:Object.keys(corpora).length,chunks:comparisons.filter(value=>value.polynomial===polynomial).reduce((sum,value)=>sum+value.originalChunks.length,0),status:'matched'}));\n  }\n }catch(error){failure={message:error.message,stack:error.stack};throw error;}finally{assert.equal(hash(await fs.readFile(new URL('rabin.mjs',import.meta.url))),hash(prototypeBytes));const report={schema:'rea-rabin-original-comparison/v1',checkedAtUtc:new Date().toISOString(),candidateSha256:hash(prototypeBytes),original:{version:'restic 0.19.1',sourceCommit:'6aa3a516ce654808a1f28f9fa21e9b7c8e6e90bf',chunker:'v0.4.0',executableSha256:'b0dd1fd21eea5d8fe1325f55f7118213c21f36de8a261e04c0624a5ab9fd7830',archiveSha256:'da948ad707ed690426473aaba2046cd61f8f90f6f0e7dab6be0d5796531de67d',authenticatedBeforeEveryExecution:true},polynomials,comparisons,commands,failure:failure??null,sourceBytesStableAcrossRun:true,cutFingerprintRuntimeComparison:false,scope:'Exact ordered plaintext chunk SHA256 IDs and lengths from actual original backup/tree/index commands; original CLI does not expose rolling Cut fingerprints. No arbitrary-average/min/max option parity claim.'};await fs.writeFile(new URL('original-validation.json',import.meta.url),JSON.stringify(report,null,2)+'\\n');assert.equal(path.dirname(root),path.resolve(os.tmpdir()));assert.ok(path.basename(root).startsWith('rea-rabin-original-'));await fs.rm(root,{recursive:true,force:true});}\n return{files:comparisons.length,chunks:comparisons.reduce((sum,row)=>sum+row.originalChunks.length,0),originalExecutions:commands.length};\n}\nif(process.argv[1]&&path.resolve(process.argv[1])===fileURLToPath(import.meta.url))console.log(JSON.stringify(await compareOriginal()));\n",
