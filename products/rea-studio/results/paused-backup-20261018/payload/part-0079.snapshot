    },
    {
      "id": "grafana.candidate.270c1d9046d1b3b6b97f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "These rule-specific silences are guaranteed to only apply to a single rule and permissions to read, create, update or delete are tied to a user’s permissions for that rule.",
      "headingPath": [
        "What’s new in Grafana v11.1",
        "Alerting",
        "Rule-specific silences with permissions"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-1.md",
