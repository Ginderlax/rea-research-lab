assert.equal(composition.schema,'rea-bsdtar-oracle-hosted-composition/v1');assert.equal(composition.status,'composed-unexecuted-oracle-test-overlay');assert.equal(composition.sourceCommit,tested);assert.equal(composition.baselineGitCommit,tested);assert.equal(composition.applicationRuntimeChanged,false);assert.equal(composition.productionInstalled,false);assert.deepEqual(composition.transitions.map(r=>r.path),overlayTargets);
