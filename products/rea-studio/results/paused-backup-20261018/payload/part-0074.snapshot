    {
      "id": "grafana.candidate.93f8bcd8f5350eff936e",
      "syntaxRole": "table-row",
      "sourceText": "| Private          | <p>Private plugins are for use on your own Grafana. They may not be distributed to the Grafana community, and are not published in the Grafana catalog.</p>                                                              |",
      "headingPath": [
        "Plugin signatures",
        "Plugin signature levels"
      ],
      "source": {
