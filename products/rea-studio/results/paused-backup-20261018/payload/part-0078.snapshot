    },
    {
      "id": "grafana.candidate.8580e85d3bf8457719bb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Reports use the time zone of the dashboard from which they're generated. You can control the time zone for your reports by setting the dashboard to a specific time zone. Note that this affects the display of the dashboard for all users.",
      "headingPath": [
        "Create and manage reports",
        "Create a report",
        "2. Schedule",
        "Time zone"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/create-reports/_index.md",
