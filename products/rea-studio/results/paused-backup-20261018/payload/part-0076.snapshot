    },
    {
      "id": "grafana.candidate.02fb4269156fde45ced6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To combine time series, click **Combine** in the **Functions** list.",
      "headingPath": [
        "Graphite query editor",
        "Functions",
        "Combine time series"
      ],
      "source": {
        "path": "docs/sources/datasources/graphite/query-editor/index.md",
