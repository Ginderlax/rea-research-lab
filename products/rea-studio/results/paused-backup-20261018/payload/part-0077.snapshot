    {
      "id": "grafana.candidate.dce5b317d6c6daf6bb99",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Optional endpoint URL (hostname or fully qualified URI) to override the default generated S3 endpoint. If you want to keep the default, just leave this empty. You must still provide a `region` value if you specify an endpoint.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[external_image_storage.s3]`",
        "`endpoint`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
