import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import {spawnSync} from 'node:child_process';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),hash=x=>createHash('sha256').update(x).digest('hex'),names=['independent-decoder.mjs','decoder.test.mjs','marker-fixture.test.mjs','probe-decoder.mjs','audit-integration.mjs','README.md','freeze-review.mjs','baseline-manifest.json','recorder-baseline-manifest.json','final47-baseline-manifest.json','integration-review.json','decoder-finding.json','synthetic-marker.stdout.txt','synthetic-marker.stderr.txt','reconstructed-first47.json','reconstructed-latest47.json','reconstructed-final47.json'];
const fingerprint=async()=>Promise.all(names.map(async name=>{const bytes=await fs.readFile(path.join(here,name));return{path:name,bytes:bytes.length,sha256:hash(bytes)};})),before=await fingerprint();
const result=spawnSync(process.execPath,['--test','--test-reporter=tap',path.join(here,'decoder.test.mjs')],{encoding:'utf8',timeout:30000,maxBuffer:2*1024*1024});await fs.writeFile(path.join(here,'collector-tests.stdout.txt'),result.stdout,{flag:'wx'});await fs.writeFile(path.join(here,'collector-tests.stderr.txt'),result.stderr,{flag:'wx'});const after=await fingerprint();assert.deepEqual(after,before);assert.equal(result.status,0);const summary={};for(const name of ['tests','pass','fail','cancelled','skipped','todo'])summary[name]=Number(result.stdout.match(new RegExp('^# '+name+' (\\d+)$','m'))?.[1]);assert.deepEqual(summary,{tests:7,pass:7,fail:0,cancelled:0,skipped:0,todo:0});
const integration=JSON.parse(await fs.readFile(path.join(here,'integration-review.json'))),manifest=JSON.parse(await fs.readFile(path.join(here,'baseline-manifest.json')));for(const row of manifest.files.filter(x=>x.path.startsWith('baseline/production/')))assert.equal(hash(await fs.readFile(row.source)),row.sha256);const nodeTap=process.binding('natives')['internal/test_runner/reporter/tap'];assert.equal(hash(nodeTap),hash(await fs.readFile(path.join(here,'baseline/recorder/node-tap-reporter.js.snapshot'))));
const receipt={schema:'rea-rabin-production-independent-collector-review/v1',completedAtUtc:new Date().toISOString(),runtime:process.version,platform:process.platform,productionChanges:false,behavioralTestsRerun:0,originalResticExecutions:0,timingMemoryComparisons:0,syntheticActualTapLoggerTests:1,collectorSummary:summary,sourceBytesStableAcrossRun:true,acceptedStageFingerprintsVerified:integration.acceptedStageFingerprintsVerified,implementationComparisons:integration.implementationComparisons,productionSourceFingerprints:integration.productionSourceFingerprints,preservedParentBehaviorReceiptSha256:'a0e8198e438fb9c5cc08d0394793bc684682efa82fde7c4bca0ca202038bfec0',historicalReconstruction:integration.reconstructed,confirmedFindings:[{id:'tap-hash-escape',resolvedInProposedModule:true,productionCollectorUnmodifiedByReviewer:true,proof:'decoder-finding.json',module:'independent-decoder.mjs',scope:'Observation collector only; baseline finite Backup behavior sources unchanged'}],unresolvedConfirmedImplementationFindings:0,reviewFingerprints:before,collectorRawSha256:hash(result.stdout),nodeTapReporterSha256:hash(nodeTap),limits:integration.limitations,scope:'Finite independent source/import/artifact and report reconstruction review only; parent-owned historical 47 behavior counts are not attributed as new execution.',fullParity:false,securityCertified:false,performanceSuperiority:false};await fs.writeFile(path.join(here,'review-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({summary,receiptSha256:hash(JSON.stringify(receipt,null,2)+'\n'),productionStable:integration.productionSourceFingerprints.length,moduleSha256:before.find(x=>x.path==='independent-decoder.mjs').sha256}));
