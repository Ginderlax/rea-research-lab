    {
      "id": "grafana.candidate.62a2f1998dff1db74bce",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "But this alert rule might result in noisy alerts as one single scrape failure will fire the alert. To reduce noise, you should add a delay:",
      "headingPath": [
        "Handle connectivity errors in alerts",
        "Detect target availability with the Prometheus `up` metric"
      ],
      "source": {
        "path": "docs/sources/alerting/guides/connectivity-errors.md",
