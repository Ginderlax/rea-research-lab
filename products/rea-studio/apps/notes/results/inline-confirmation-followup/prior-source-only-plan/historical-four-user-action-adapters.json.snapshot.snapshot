  {
    "path": "products/rea-studio/apps/notes/notebook-trash-review.test.mjs",
    "beforeSha256": "03c06071a8b58ce8b34fabafc0d39668f853b47351702cb848013f1aa686289b",
    "afterSha256": "a2b47baadeab95035c1255865bb216943f685776e779495793607001fe897518",
    "before": "import test from 'node:test';\nimport assert from 'node:assert/strict';\nimport fs from 'node:fs/promises';\nimport path from 'node:path';\nimport os from 'node:os';\nimport {ui,memory,gate} from './notebook-trash-review-fixture.mjs';\nimport {handle} from './server.mjs';\nimport {changeNotebookTrash} from './notebook-trash.mjs';\nimport {folderRecord,ensureOrganization} from './notebooks.mjs';\nimport {originalTrash} from './notebook-trash-original-oracle.mjs';\nconst observations=[],id=n=>n.toString(16).padStart(32,'0'),initial='2020-01-01T00:00:00.000Z',now='2026-10-13T01:00:00.000Z';\ntest('dirty draft prevents notebook cascade with no mutation request',async t=>{const f=await ui(t);await f.open();f.manage();f.type(f.byLabel('Markdown note'),'Private draft');const before=f.calls.length;await f.click(f.byText('Move notebook to trash'));assert.equal(f.byLabel('Markdown note').value,'Private draft');assert.equal(f.calls.slice(before).some(c=>c.action==='notebook-trash'),false);assert.equal(f.read().notes[f.note.id].deletedAt,null);observations.push({case:'dirty guard',passed:true});});\ntest('held cascade disables real typing/selection and retains saved body after release',async t=>{const g=gate();let hold=true;const f=await ui(t,async({action})=>{if(action==='notebook-trash'&&hold){g.enter();await g.held;}});await f.open();f.manage();const p=f.click(f.byText('Move notebook to trash'));await g.started;assert.equal(f.byLabel('Markdown note').disabled,true);assert.equal(f.byText('New note').disabled,true);assert.equal(await f.click(f.byText('New note')),false);assert.throws(()=>f.type(f.byLabel('Markdown note'),'Unavailable user typing'),/disabled/);hold=false;g.release();await p;assert.equal(f.byLabel('Markdown note').value,'Saved body');assert.equal(f.byLabel('Markdown note').disabled,false);assert.equal(f.byText('Save note').disabled,true);observations.push({case:'held cascade',passed:true});});\ntest('older completed Save response must preserve a draft typed after notebook trash',async t=>{const g=gate();let hold=false;const f=await ui(t,async({action})=>{if(action==='save'&&hold){g.enter();await g.held;}});await f.open();f.manage();hold=true;const save=f.click(f.byText('Save note'));await g.started;await f.click(f.byText('Move notebook to trash'));assert.ok(f.read().notes[f.note.id].deletedAt);assert.equal(f.byText('Save note').disabled,true);assert.equal(f.byLabel('Markdown note').disabled,false);f.type(f.byLabel('Markdown note'),'New typed draft after trash');hold=false;g.release();await save;const observed={case:'old Save after cascade',body:f.byLabel('Markdown note').value,saveEnabled:!f.byText('Save note').disabled,backend:f.read().notes[f.note.id],calls:f.calls};observations.push(observed);assert.equal(observed.body,'New typed draft after trash','Older Save completion replaced the enabled-field draft');assert.equal(observed.saveEnabled,false,'A trashed backend note must remain disabled');});\ntest('queued notebook trash snapshots the caller request before yielding',async()=>{const f=memory();let a=await f.call('notebook-create',{title:'A',revision:0}),b=await f.call('notebook-create',{title:'B',revision:a.revision});const input={id:a.notebook.id,revision:b.revision,confirmed:true};const pending=f.call('notebook-trash',input);input.id=b.notebook.id;await pending;const rows=await f.call('notebook-list'),observed={case:'caller mutation',requestedId:a.notebook.id,mutatedId:b.notebook.id,rows};observations.push(observed);assert.equal(rows.notebooks.find(n=>n.id===a.notebook.id).trashed,true,'Original request target changed during the queue await');assert.equal(rows.notebooks.find(n=>n.id===b.notebook.id).trashed,false);});\ntest('failed restore commit leaves persisted subtree and history unchanged; a later fresh server import restores',async t=>{const dir=await fs.mkdtemp(path.join(os.tmpdir(),'rea-notes-review-'));t.after(()=>fs.rm(dir,{recursive:true,force:true}));const file=path.join(dir,'owned-state.json');let fail=false;const store={get:async(k,f)=>{try{return JSON.parse(await fs.readFile(file,'utf8'));}catch(e){if(e.code==='ENOENT')return f;throw e;}},set:async(k,v)=>{if(fail)throw new Error('synthetic write denied');await fs.writeFile(file,JSON.stringify(v));},list:async()=>[]};const call=(action,input={})=>handle({action,input,store});const a=await call('notebook-create',{title:'Parent',revision:0}),n=await call('save',{title:'N',body:'Persisted',notebookId:a.notebook.id});let tree=await call('notebook-list');tree=await call('notebook-trash',{id:a.notebook.id,revision:tree.revision,confirmed:true});const before=await fs.readFile(file);fail=true;await assert.rejects(call('notebook-restore',{id:a.notebook.id,revision:tree.revision,confirmed:true}),/write denied/);assert.deepEqual(await fs.readFile(file),before);fail=false;const fresh=await import('./server.mjs?independent-reopen');await fresh.handle({action:'notebook-restore',input:{id:a.notebook.id,revision:tree.revision,confirmed:true},store});const actual=await fresh.handle({action:'get',input:{id:n.id},store});assert.equal(actual.deletedAt,null);assert.equal(actual.body,'Persisted');assert.equal(actual.history.length,2);observations.push({case:'failed commit and disk reopen',passed:true,hostProcesses:0,mode:'File-backed state plus fresh module; process restart not claimed'});});\nfunction heldOut(){const s={schema:2,organization:{revision:19},records:{},notes:{},resources:{}};for(const[n,parent,deleted]of[[1,0,2],[2,1,3],[3,2,0],[4,3,4],[5,0,0]]){const r=folderRecord(id(n),'N'+n,initial,parent?id(parent):'');Object.assign(r.props,{deleted_time:String(deleted),application_data:'{\"retained\":\"unicode Ω\"}'});s.records[id(n)]=r;}for(const[n,parent,deleted,is_conflict]of[[10,1,10,0],[11,2,20,0],[12,3,30,0],[13,4,40,0],[14,4,50,1],[15,5,0,0]])s.notes[id(n)]={id:id(n),title:'Note'+n,body:'Content '+n,tags:['tag'],notebookId:id(parent),notebook:'',createdAt:initial,updatedAt:initial,revision:9,deletedAt:deleted?new Date(deleted).toISOString():null,history:[],joplin:{type:1,title:'Note'+n,body:'Content '+n,props:{id:id(n),parent_id:id(parent),updated_time:initial,user_updated_time:initial,deleted_time:String(deleted),is_conflict:String(is_conflict),application_data:'{\"opaque\":true}',type_:'1'}}};return ensureOrganization(s);}\nfunction native(s){return{folders:Object.values(s.records).map(r=>({...r.props,title:r.title,deleted_time:Number(r.props.deleted_time),updated_time:Date.parse(r.props.updated_time),user_updated_time:Date.parse(r.props.user_updated_time)})),notes:Object.values(s.notes).map(n=>({...n.joplin.props,title:n.title,parent_id:n.notebookId,deleted_time:n.deletedAt?Date.parse(n.deletedAt):0,is_conflict:Number(n.joplin.props.is_conflict),updated_time:Date.parse(n.updatedAt),user_updated_time:Date.parse(n.userUpdatedAt??n.joplin.props.user_updated_time)}))};}\ntest('held-out multi-generation restore matches released helper final rows',async()=>{const s=heldOut(),before=JSON.stringify(s),oracle=await originalTrash({...native(s),time:Date.parse(now)});await oracle.restoreItems(2,[id(2)]);const actual=changeNotebookTrash(s,{action:'notebook-restore',id:id(2),revision:19,confirmed:true},now).state;let projections=0,fields=0;for(const [rows,map]of[[native(actual).folders,oracle.folderRows],[native(actual).notes,oracle.noteRows]])for(const row of rows){projections++;for(const k of['parent_id','deleted_time','updated_time','user_updated_time','application_data']){fields++;assert.equal(row[k],map.get(row.id)[k],row.id+' '+k);}}assert.equal(JSON.stringify(s),before);observations.push({case:'held-out released restore',helperTopLevelExecutions:1,originalFullApplicationExecutions:0,matchedItemProjections:projections,matchedScalarFields:fields,bindings:oracle.bindings,originalCalls:oracle.calls,scope:oracle.scope});});\ntest('invalid deep hierarchy and oversized aggregate refuse before modifying input',()=>{for(const mode of['depth','notes']){const s=heldOut();if(mode==='depth'){let parent='';for(let i=100;i<170;i++){s.records[id(i)]=folderRecord(id(i),'x',initial,parent);s.records[id(i)].props.deleted_time='0';parent=id(i);}}else for(let i=100;i<1101;i++)s.notes[id(i)]={...structuredClone(s.notes[id(10)]),id:id(i)};const before=JSON.stringify(s);assert.throws(()=>changeNotebookTrash(s,{action:'notebook-restore',id:id(2),revision:19,confirmed:true},now),mode==='depth'?/64|depth|200/:/1,000/);assert.equal(JSON.stringify(s),before);}observations.push({case:'bounds',passed:true});});\ntest.after(async()=>{await fs.mkdir(new URL(process.env.NOTES_REVIEW_OUTPUT??'../../.local/notes-notebook-trash-observations/',import.meta.url),{recursive:true});await fs.writeFile(new URL('review.json',new URL(process.env.NOTES_REVIEW_OUTPUT??'../../.local/notes-notebook-trash-observations/',import.meta.url)),JSON.stringify(observations,null,2)+'\\n');});\n",
    "after": "import test from 'node:test';\nimport assert from 'node:assert/strict';\nimport fs from 'node:fs/promises';\nimport path from 'node:path';\nimport os from 'node:os';\nimport {ui,memory,gate} from './notebook-trash-review-fixture.mjs';\nimport {handle} from './server.mjs';\nimport {changeNotebookTrash} from './notebook-trash.mjs';\nimport {folderRecord,ensureOrganization} from './notebooks.mjs';\nimport {originalTrash} from './notebook-trash-original-oracle.mjs';\nconst observations=[],id=n=>n.toString(16).padStart(32,'0'),initial='2020-01-01T00:00:00.000Z',now='2026-10-13T01:00:00.000Z';\ntest('dirty draft prevents notebook cascade with no mutation request',async t=>{const f=await ui(t);await f.open();f.manage();f.type(f.byLabel('Markdown note'),'Private draft');const before=f.calls.length;await f.click(f.byText('Move notebook to trash'));assert.equal(f.byLabel('Markdown note').value,'Private draft');assert.equal(f.calls.slice(before).some(c=>c.action==='notebook-trash'),false);assert.equal(f.read().notes[f.note.id].deletedAt,null);observations.push({case:'dirty guard',passed:true});});\ntest('held cascade disables real typing/selection and retains saved body after release',async t=>{const g=gate();let hold=true;const f=await ui(t,async({action})=>{if(action==='notebook-trash'&&hold){g.enter();await g.held;}});await f.open();f.manage();const p=f.confirmNotebook('Move notebook to trash');await g.started;assert.equal(f.byLabel('Markdown note').disabled,true);assert.equal(f.byText('New note').disabled,true);assert.equal(await f.click(f.byText('New note')),false);assert.throws(()=>f.type(f.byLabel('Markdown note'),'Unavailable user typing'),/disabled/);hold=false;g.release();await p;assert.equal(f.byLabel('Markdown note').value,'Saved body');assert.equal(f.byLabel('Markdown note').disabled,false);assert.equal(f.byText('Save note').disabled,true);observations.push({case:'held cascade',passed:true});});\ntest('older completed Save response must preserve a draft typed after notebook trash',async t=>{const g=gate();let hold=false;const f=await ui(t,async({action})=>{if(action==='save'&&hold){g.enter();await g.held;}});await f.open();f.manage();hold=true;const save=f.click(f.byText('Save note'));await g.started;await f.confirmNotebook('Move notebook to trash');assert.ok(f.read().notes[f.note.id].deletedAt);assert.equal(f.byText('Save note').disabled,true);assert.equal(f.byLabel('Markdown note').disabled,false);f.type(f.byLabel('Markdown note'),'New typed draft after trash');hold=false;g.release();await save;const observed={case:'old Save after cascade',body:f.byLabel('Markdown note').value,saveEnabled:!f.byText('Save note').disabled,backend:f.read().notes[f.note.id],calls:f.calls};observations.push(observed);assert.equal(observed.body,'New typed draft after trash','Older Save completion replaced the enabled-field draft');assert.equal(observed.saveEnabled,false,'A trashed backend note must remain disabled');});\ntest('queued notebook trash snapshots the caller request before yielding',async()=>{const f=memory();let a=await f.call('notebook-create',{title:'A',revision:0}),b=await f.call('notebook-create',{title:'B',revision:a.revision});const input={id:a.notebook.id,revision:b.revision,confirmed:true};const pending=f.call('notebook-trash',input);input.id=b.notebook.id;await pending;const rows=await f.call('notebook-list'),observed={case:'caller mutation',requestedId:a.notebook.id,mutatedId:b.notebook.id,rows};observations.push(observed);assert.equal(rows.notebooks.find(n=>n.id===a.notebook.id).trashed,true,'Original request target changed during the queue await');assert.equal(rows.notebooks.find(n=>n.id===b.notebook.id).trashed,false);});\ntest('failed restore commit leaves persisted subtree and history unchanged; a later fresh server import restores',async t=>{const dir=await fs.mkdtemp(path.join(os.tmpdir(),'rea-notes-review-'));t.after(()=>fs.rm(dir,{recursive:true,force:true}));const file=path.join(dir,'owned-state.json');let fail=false;const store={get:async(k,f)=>{try{return JSON.parse(await fs.readFile(file,'utf8'));}catch(e){if(e.code==='ENOENT')return f;throw e;}},set:async(k,v)=>{if(fail)throw new Error('synthetic write denied');await fs.writeFile(file,JSON.stringify(v));},list:async()=>[]};const call=(action,input={})=>handle({action,input,store});const a=await call('notebook-create',{title:'Parent',revision:0}),n=await call('save',{title:'N',body:'Persisted',notebookId:a.notebook.id});let tree=await call('notebook-list');tree=await call('notebook-trash',{id:a.notebook.id,revision:tree.revision,confirmed:true});const before=await fs.readFile(file);fail=true;await assert.rejects(call('notebook-restore',{id:a.notebook.id,revision:tree.revision,confirmed:true}),/write denied/);assert.deepEqual(await fs.readFile(file),before);fail=false;const fresh=await import('./server.mjs?independent-reopen');await fresh.handle({action:'notebook-restore',input:{id:a.notebook.id,revision:tree.revision,confirmed:true},store});const actual=await fresh.handle({action:'get',input:{id:n.id},store});assert.equal(actual.deletedAt,null);assert.equal(actual.body,'Persisted');assert.equal(actual.history.length,2);observations.push({case:'failed commit and disk reopen',passed:true,hostProcesses:0,mode:'File-backed state plus fresh module; process restart not claimed'});});\nfunction heldOut(){const s={schema:2,organization:{revision:19},records:{},notes:{},resources:{}};for(const[n,parent,deleted]of[[1,0,2],[2,1,3],[3,2,0],[4,3,4],[5,0,0]]){const r=folderRecord(id(n),'N'+n,initial,parent?id(parent):'');Object.assign(r.props,{deleted_time:String(deleted),application_data:'{\"retained\":\"unicode Ω\"}'});s.records[id(n)]=r;}for(const[n,parent,deleted,is_conflict]of[[10,1,10,0],[11,2,20,0],[12,3,30,0],[13,4,40,0],[14,4,50,1],[15,5,0,0]])s.notes[id(n)]={id:id(n),title:'Note'+n,body:'Content '+n,tags:['tag'],notebookId:id(parent),notebook:'',createdAt:initial,updatedAt:initial,revision:9,deletedAt:deleted?new Date(deleted).toISOString():null,history:[],joplin:{type:1,title:'Note'+n,body:'Content '+n,props:{id:id(n),parent_id:id(parent),updated_time:initial,user_updated_time:initial,deleted_time:String(deleted),is_conflict:String(is_conflict),application_data:'{\"opaque\":true}',type_:'1'}}};return ensureOrganization(s);}\nfunction native(s){return{folders:Object.values(s.records).map(r=>({...r.props,title:r.title,deleted_time:Number(r.props.deleted_time),updated_time:Date.parse(r.props.updated_time),user_updated_time:Date.parse(r.props.user_updated_time)})),notes:Object.values(s.notes).map(n=>({...n.joplin.props,title:n.title,parent_id:n.notebookId,deleted_time:n.deletedAt?Date.parse(n.deletedAt):0,is_conflict:Number(n.joplin.props.is_conflict),updated_time:Date.parse(n.updatedAt),user_updated_time:Date.parse(n.userUpdatedAt??n.joplin.props.user_updated_time)}))};}\ntest('held-out multi-generation restore matches released helper final rows',async()=>{const s=heldOut(),before=JSON.stringify(s),oracle=await originalTrash({...native(s),time:Date.parse(now)});await oracle.restoreItems(2,[id(2)]);const actual=changeNotebookTrash(s,{action:'notebook-restore',id:id(2),revision:19,confirmed:true},now).state;let projections=0,fields=0;for(const [rows,map]of[[native(actual).folders,oracle.folderRows],[native(actual).notes,oracle.noteRows]])for(const row of rows){projections++;for(const k of['parent_id','deleted_time','updated_time','user_updated_time','application_data']){fields++;assert.equal(row[k],map.get(row.id)[k],row.id+' '+k);}}assert.equal(JSON.stringify(s),before);observations.push({case:'held-out released restore',helperTopLevelExecutions:1,originalFullApplicationExecutions:0,matchedItemProjections:projections,matchedScalarFields:fields,bindings:oracle.bindings,originalCalls:oracle.calls,scope:oracle.scope});});\ntest('invalid deep hierarchy and oversized aggregate refuse before modifying input',()=>{for(const mode of['depth','notes']){const s=heldOut();if(mode==='depth'){let parent='';for(let i=100;i<170;i++){s.records[id(i)]=folderRecord(id(i),'x',initial,parent);s.records[id(i)].props.deleted_time='0';parent=id(i);}}else for(let i=100;i<1101;i++)s.notes[id(i)]={...structuredClone(s.notes[id(10)]),id:id(i)};const before=JSON.stringify(s);assert.throws(()=>changeNotebookTrash(s,{action:'notebook-restore',id:id(2),revision:19,confirmed:true},now),mode==='depth'?/64|depth|200/:/1,000/);assert.equal(JSON.stringify(s),before);}observations.push({case:'bounds',passed:true});});\ntest.after(async()=>{await fs.mkdir(new URL(process.env.NOTES_REVIEW_OUTPUT??'../../.local/notes-notebook-trash-observations/',import.meta.url),{recursive:true});await fs.writeFile(new URL('review.json',new URL(process.env.NOTES_REVIEW_OUTPUT??'../../.local/notes-notebook-trash-observations/',import.meta.url)),JSON.stringify(observations,null,2)+'\\n');});\n",
    "scope": "Fixture exposes explicit confirmation user action and disposal/focus model, or successful old actions call that helper; backend assertions unchanged. Dirty rejection actions remain direct."
