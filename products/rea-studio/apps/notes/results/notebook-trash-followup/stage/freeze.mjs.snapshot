import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import {spawnSync} from 'node:child_process';
import assert from 'node:assert/strict';
const root=fileURLToPath(new URL('./',import.meta.url)),repo=fileURLToPath(new URL('../../outputs/rea-research-lab/',import.meta.url)),hash=b=>createHash('sha256').update(b).digest('hex'),baseline=JSON.parse(await fs.readFile(path.join(root,'baseline.json')));
const epoch=JSON.parse(await fs.readFile(path.join(root,'epochs/current/epoch.json')));
async function identity(filename){const bytes=await fs.readFile(filename);return{bytes:bytes.length,sha256:hash(bytes)};}
async function authenticateBaseline(){const rows=[];for(const record of baseline.records){const actual=await identity(path.join(repo,record.originalPath)),snapshot=await identity(path.join(root,record.preservedPath));assert.equal(snapshot.sha256,record.sha256,record.preservedPath);assert.equal(snapshot.bytes,record.bytes);const current=record.originalPath===epoch.productionPath?epoch.current:record;assert.equal(actual.sha256,current.sha256,record.originalPath);assert.equal(actual.bytes,current.bytes);if(record.originalPath===epoch.productionPath)assert.deepEqual(await identity(path.join(root,epoch.current.path)),actual);rows.push({path:record.originalPath,...actual,originalBaselineSha256:record.sha256,separateEpoch:record.originalPath===epoch.productionPath});}return rows;}
const productionBefore=await authenticateBaseline(),old22=JSON.parse(await fs.readFile(path.join(root,'baseline/products/rea-studio/apps/notes/fixtures/oracle-verification.json.snapshot'))),old28=JSON.parse(await fs.readFile(path.join(root,'baseline/products/rea-studio/apps/notes/results/notebooks-followup/integration-validation.json.snapshot')));assert.equal(old22.passed,22);assert.equal(old28.summary.pass,28);
const originals=[];for(const name of ['prior-source-provenance.json','trash-source-provenance.json','license-and-special-id-provenance.json']){const data=JSON.parse(await fs.readFile(path.join(root,name)));for(const record of Array.isArray(data)?data:data.sources??data.records){const actual=await identity(path.join(root,record.path));assert.equal(actual.sha256,record.sha256,record.path);assert.equal(actual.bytes,record.bytes,record.path);originals.push({path:record.path,url:record.url,status:record.status??200,...actual});}}
await fs.mkdir(path.join(root,'checks'),{recursive:true});await fs.writeFile(path.join(root,'checks','baseline-before.json'),JSON.stringify(productionBefore,null,2)+'\n',{flag:'wx'});
const child=spawnSync(process.execPath,['run-focused.mjs','final'],{cwd:root,encoding:'utf8',windowsHide:true});if(child.error)throw child.error;if(child.status!==0)throw new Error('Final focused run failed: '+child.stdout+' '+child.stderr);
const run=JSON.parse(await fs.readFile(path.join(root,'runs/final/receipt.json')));assert.equal(run.sourceStable,true);assert.deepEqual(run.counts,{tests:41,pass:41,fail:0,skipped:0,cancelled:0});
const productionAfter=await authenticateBaseline();assert.deepEqual(productionAfter,productionBefore);await fs.writeFile(path.join(root,'checks','baseline-after.json'),JSON.stringify(productionAfter,null,2)+'\n',{flag:'wx'});
for(const record of originals)assert.deepEqual(await identity(path.join(root,record.path)),{bytes:record.bytes,sha256:record.sha256},record.path);
const observations=JSON.parse(await fs.readFile(path.join(root,'runs/final/observations/trash-original.json')));assert.equal(observations.length,8);assert.equal(observations.reduce((n,r)=>n+r.originalTopLevelExecutions,0),13);assert.equal(observations.reduce((n,r)=>n+(r.matchedItemProjections??0),0),73);
const bindings=observations[0].bindings;assert.equal(bindings.length,9);
const appPrefix='products/rea-studio/apps/notes/',changed=[],unchanged=[];for(const row of run.sources.filter(r=>r.path.startsWith(appPrefix))){const previous=baseline.records.find(b=>b.originalPath===row.path);(previous?.sha256===row.sha256?unchanged:changed).push({...row,baselineSha256:previous?.sha256??null,newFile:!previous});}
const receipt={schema:'rea-notebook-trash-stage-validation/v1',completedAt:new Date().toISOString(),status:'frozen-prospective-candidate',productionModified:false,requirementsModified:false,fullNotebookParity:false,fullProductParity:false,securityParity:false,performanceParity:false,superiority:false,baseline:{authenticatedFiles:productionAfter.length,productionBefore,productionAfter,historicalSerialization:{checks:22,sha256:baseline.records.find(r=>r.originalPath.endsWith('fixtures/oracle-verification.json')).sha256,commit:old22.sourceCommit},historicalNotebook:{tests:28,sha256:baseline.records.find(r=>r.originalPath.endsWith('integration-validation.json')).sha256}},release:{edition:'Joplin Desktop',version:'3.6.14',tag:'v3.6.14',commit:'7e2765a3857754d12dbadea442b60ceaf9d4b23d',fullOriginalAppExecutions:0,originalDatabaseExecutions:0,originalGuiExecutions:0},finalRun:{path:'runs/final/receipt.json',...(await identity(path.join(root,'runs/final/receipt.json'))),counts:run.counts,sourceStable:true,originalSourceStable:true},comparison:{releasedSlices:9,oracleContexts:8,topLevelTrashRestoreCalls:7,displayParentCalls:6,matchedItemProjections:73,fieldsPerProjection:5,scalarAssertions:365,priorNotebookExactComparisons:26,priorNotebookOriginalOnlyAssertions:2,historical22Reexecuted:false,bindings,scope:observations[0].scope},interaction:{actualCandidateHttpGroup:1,coldRestarts:2,independentImportHosts:1,actualBrowserExecutions:0,domGroups:2,domScope:'Actual staged client and server with owned DOM/transport model; no actual browser or original GUI'},implementation:{changedOrNew:changed,baselineUnchanged:unchanged},originals,failures:[{path:'failures/acquisition-v1',kind:'EEXIST exclusive acquisition; transcribed tool output'},{path:'failures/adaptation-v1',kind:'ENOENT source parent directory; transcribed tool output'},{path:'runs/initial-core',tests:9,pass:3,fail:6,receiptCountsIncorrect:true,kind:'Provenance shape/setup and human-reporter count parser; exact raw logs preserved'},{path:'runs/full-v4',tests:41,pass:40,fail:1,kind:'Unsupported synthetic folder application_data; fixture only corrected, runtime acceptance unchanged'}],limits:{jexBytes:8*1024*1024,resourceBytes:4*1024*1024,notes:1000,rawRecords:2000,tarEntries:3000,depth:64,pathCharacters:200,stateBytes:16*1024*1024,memoryIsolation:false,deadlineOrAbortAdded:false},scope:'Confirmed recoverable local notebook cascades plus direct note restore. Missing-parent inputs, permanent deletion, purge, optional restore/move targets, shared/read-only/sync semantics, original write order/events/GUI remain unverified or unsupported.'};
receipt.baseline.productionOriginalEpochUnchangedFiles=20;receipt.baseline.preservedOriginalBaselineFiles=21;receipt.baseline.requirementsEpoch=epoch;receipt.failures.push({path:'failures/freeze-preflight-v1',kind:'External requirements epoch changed; preflight-only assertion before any new test; exact source/transcribed diagnosis retained'});
await fs.writeFile(path.join(root,'trash-validation.final.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
async function inventory(dir=root,prefix=''){const rows=[];for(const entry of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const rel=prefix+entry.name;if(entry.isDirectory()){if(entry.name==='.local')continue;rows.push(...await inventory(path.join(dir,entry.name),rel+'/'));}else if(!['preservation-manifest.json','freeze.json'].includes(rel))rows.push({path:rel,...await identity(path.join(dir,entry.name))});}return rows;}
const records=await inventory(),manifest={schema:'rea-strict-stage-preservation/v1',createdAt:new Date().toISOString(),strict:true,excluded:['.local/**','preservation-manifest.json','freeze.json'],records};await fs.writeFile(path.join(root,'preservation-manifest.json'),JSON.stringify(manifest,null,2)+'\n',{flag:'wx'});const freeze={schema:'rea-stage-freeze/v1',frozenAt:new Date().toISOString(),receipt:{path:'trash-validation.final.json',...await identity(path.join(root,'trash-validation.final.json'))},manifest:{path:'preservation-manifest.json',files:records.length,...await identity(path.join(root,'preservation-manifest.json'))},implementation:changed};await fs.writeFile(path.join(root,'freeze.json'),JSON.stringify(freeze,null,2)+'\n',{flag:'wx'});for(const row of records)assert.deepEqual(await identity(path.join(root,row.path)),{bytes:row.bytes,sha256:row.sha256},row.path);console.log(JSON.stringify(freeze,null,2));
