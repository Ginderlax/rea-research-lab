import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{pathToFileURL}from'node:url';
const own=import.meta.dirname,base=path.resolve(own,'../..'),stage=path.join(base,'work/flow-native-textarea-normalization-fix-next'),sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)}),observed=[];
function read(root,p,r){assert(p.split('/').every(s=>s&&s!=='.'&&s!=='..')&&!/[\\:\x00-\x1f]/.test(p));const b=fs.readFileSync(path.join(root,p));if(r)assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});observed.push({root:path.relative(base,root).replaceAll('\\','/'),path:p,...id(b)});return b;}
function save(p,b){const at=path.join(own,p);fs.mkdirSync(path.dirname(at),{recursive:true});fs.writeFileSync(at,b,{flag:'wx'});}
function authority(rootName,pin,n){const root=path.join(base,rootName),mb=read(root,'manifest.json');assert.equal(sha(mb),pin);const m=JSON.parse(mb);assert.equal(m.inventory.length,n);for(const r of m.inventory)read(root,r.path,r);return m;}
authority('work/flow-native-textarea-normalization-fix-next','70c19b06ecca7b79a9461cb53680429cee2bdc91e022c5015fdf19b258f69ce9',197);authority('work/flow-native-link-next','0a03866476a81f83762bdfc10d65be639c24f25778b6c03fdac5b9ee906bea5d',457);authority('work/root-flow-link-browser-review-next','bae3c0a14e33e8bdd083a86046c6f1e15c455805d4d8e24f899ba0d0793c5f2b',28);
const validation=JSON.parse(read(stage,'validation.json'));assert.equal(validation.independentAcceptance,false);assert.equal(validation.productionAcceptance,false);assert.equal(validation.browser.currentCorrectedAccepted,false);const transformation=JSON.parse(read(stage,'client-transformation.json')),app='candidate/products/rea-studio/apps/flow/',before=read(path.join(base,'work/flow-native-link-next'),app+'client.mjs',transformation.before),after=read(stage,app+'client.mjs',transformation.after);let forward=before.toString(),inverse=after.toString();assert.equal(transformation.edits.length,16);for(const c of transformation.edits){assert.equal(forward.split(c.before).length-1,1);forward=forward.replace(c.before,c.after);}for(const c of [...transformation.edits].reverse()){assert.equal(inverse.split(c.after).length-1,1);inverse=inverse.replace(c.after,c.before);}assert.equal(forward,after.toString());assert.equal(inverse,before.toString());assert.equal(after.toString().split('async function renderNative(')[0],before.toString().split('async function renderNative(')[0]);
const fixtureTransform=JSON.parse(read(stage,'fixture-adapter.json'));let oldFixture=read(stage,app+'link-ui-fixture.mjs'),newFixture=read(stage,app+'normalization-ui-fixture.mjs'),reverse=newFixture.toString();for(const c of [...fixtureTransform.edits].reverse()){assert.equal(reverse.split(c.after).length-1,1);reverse=reverse.replace(c.after,c.before);}assert.deepEqual(Buffer.from(reverse),oldFixture);
for(const p of ['client.mjs','server.mjs','native.mjs','native-link.mjs','core.mjs','normalization-ui.test.mjs','normalization-boundaries.test.mjs','normalization-ui-fixture.mjs','link-ui-fixture.mjs','NATIVE-TEXT-SOURCE.md','LINK-SOURCE-NOTICE.md'])save('source/'+p+'.snapshot',read(stage,app+p));for(const p of ['manifest.json','freeze.json','validation.json','client-transformation.json','fixture-adapter.json','source-authority.json'])save('source/author/'+p+'.snapshot',read(stage,p));save('source/browser28-seed.json.snapshot',read(stage,'authority/browser28-seed.json.snapshot'));
const adapter=[];function change(source,before,after){assert.equal(source.split(before).length-1,1);adapter.push({before,after,occurrences:1});return source.replace(before,after);}
let fixture=newFixture.toString();fixture=change(fixture,"from './client.mjs'","from '"+pathToFileURL(path.join(stage,app+'client.mjs')).href+"'");fixture=change(fixture,"from './server.mjs'","from '"+pathToFileURL(path.join(stage,app+'server.mjs')).href+"'");save('fixture.mjs',fixture);
let replay=read(stage,app+'normalization-ui.test.mjs').toString();replay=change(replay,"from'./normalization-ui-fixture.mjs'","from'../fixture.mjs'");replay=change(replay,"from'./server.mjs'","from'"+pathToFileURL(path.join(stage,app+'server.mjs')).href+"'");replay=change(replay,"'../../../../../authority/browser28-seed.json.snapshot'","'../source/browser28-seed.json.snapshot'");save('replay/normalization-ui.test.mjs',replay);
save('input-adapters.json',JSON.stringify({schema:'rea-flow-textarea-independent-import-only-adapters/v1',changes:adapter,fixtureInfrastructure:'Exact author native-normalization DOM model with runtime imports only; fresh reviewer test bodies independent.',replayGroups:14,unchangedSemanticBodies:true,actualBrowser:0},null,2)+'\n');save('authority-before.json',JSON.stringify(observed,null,2)+'\n');console.log(JSON.stringify({authenticated:observed.length,clientInverse16:true,fixtureInverse7:true,replay14Prepared:true,appExecutions:0}));
