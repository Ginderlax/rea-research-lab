    {
      "id": "grafana.candidate.1a8a1b6e4de323910795",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "LBAC for data sources enables you to filter access for logs, metrics, and traces. By defining rules with label or attribute selectors, you can specify:",
      "headingPath": [
        "Label Based Access Control (LBAC) for data sources",
        "Logs, metrics, and traces filtering with LBAC"
      ],
