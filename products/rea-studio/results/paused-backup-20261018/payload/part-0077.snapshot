    {
      "id": "grafana.candidate.e47dc39da5c1e0d570f8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "System for Cross-domain Identity Management (SCIM) is an open standard that allows automated user provisioning and management. With SCIM, you can automate the provisioning of users and groups from your identity provider to Grafana.",
      "headingPath": [
        "Configure SCIM provisioning"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-scim-provisioning/_index.md",
