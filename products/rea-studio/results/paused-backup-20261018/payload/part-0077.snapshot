    {
      "id": "grafana.candidate.c4c1cd3940c77815efdf",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Extend the `scopes` field of `[auth.generic_oauth]` section in Grafana configuration file with additional scopes.",
