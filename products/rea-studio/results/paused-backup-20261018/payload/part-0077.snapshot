    {
      "id": "grafana.candidate.0c5421aab0b6526014b4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To enable Google OAuth you must register your application with Google. Google will generate a client ID and secret key for you to use.",
      "headingPath": [
        "Configure Google OAuth authentication"
      ],
      "source": {
