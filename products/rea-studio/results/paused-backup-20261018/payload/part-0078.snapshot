        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.3c03bf7218cb415d0093",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "`traffic.har` is usually the most valuable file in the bundle, but it isn't available for every data source. When upstream traffic can't be captured, Grafana still generates the rest of the bundle, and `querydata.json` still shows what the data source plugin returned.",
      "headingPath": [
        "Generate a data source diagnostic bundle",
        "Data source support for capturing upstream traffic"
      ],
      "source": {
