    },
    {
      "id": "grafana.candidate.d602f1655f6ab9916a48",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When a user logs in using an OAuth provider, Grafana verifies that the access token has not expired. When an access token expires, Grafana uses the provided refresh token (if any exists) to obtain a new access token without requiring the user to log in again.",
      "headingPath": [
        "Configure Okta OIDC authentication",
        "Configure Okta authentication client using the Grafana configuration file",
        "Configure a refresh token"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/okta/index.md",
        "gitBlobSha": "4de8751f865ff55ac58451811f4eafc681a66671",
        "sha256": "fe422737ef152e83e92f9b6cbc00fc7578d6b44c697ed6a6486447f716916c6d",
        "lineStart": 190,
        "lineEnd": 190,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/okta/index.md#L190-L190"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.e710b8d0b40938c7ae81",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If a refresh token doesn't exist, Grafana logs the user out of the system after the access token has expired.",
      "headingPath": [
        "Configure Okta OIDC authentication",
        "Configure Okta authentication client using the Grafana configuration file",
        "Configure a refresh token"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/okta/index.md",
