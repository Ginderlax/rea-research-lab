import test from 'node:test';import assert from 'node:assert/strict';import{randomUUID}from'node:crypto';import{render}from'./client.mjs';import{handle,dispose}from'./server.mjs';import{Element,descendants,button,field,deferred,openEntry}from'./ui-fixture.mjs';
async function fixture(t,wrap){const workspace={root:'owned-group-ui-'+randomUUID()},store={value:null,get:async()=>structuredClone(store.value),set:async(k,v)=>{store.value=structuredClone(v)}},call=(action,input={})=>handle({action,input,workspace,store}),requests=[];await call('create',{password:'Synthetic group UI master'});const A=(await call('save',{title:'A',group:'Parent/Selected',password:'A only synthetic secret'})).id;await call('save',{title:'B',group:'Parent/Selected/Deep',password:'B only synthetic secret'});globalThis.document={createElement:tag=>new Element(tag)};const root=new Element('main'),cleanup=await render(root,(action,input)=>{requests.push({action,id:input?.id});return wrap?wrap(action,input,()=>call(action,input)):call(action,input)});t.after(()=>{cleanup();dispose(workspace);delete globalThis.document});return{workspace,root,store,call,requests,A,cleanup};}
function row(root,name){const group=descendants(root).find(e=>e.tagName==='section'&&e.children.some(c=>c.tagName==='strong'&&c.textContent===name));assert(group,'Expected group '+name);return group;}
async function begin(root){await button(root,'Show native groups').click();const selected=row(root,'Selected');field(selected,'Confirm recycle group and descendants').checked=true;return button(selected,'Recycle group and descendants');}
test('actual group UI previews descendants without passwords, confirms recursive recycle and restore',async t=>{const f=await fixture(t);await button(f.root,'Show native groups').click();const selected=row(f.root,'Selected');await button(selected,'Preview group descendants').click();assert(selected.textContent.includes('Entry: A'));assert(!selected.textContent.includes('only synthetic secret'));await button(selected,'Recycle group and descendants').click();assert.equal((await f.call('list')).entries.length,2);field(selected,'Confirm recycle group and descendants').checked=true;await button(selected,'Recycle group and descendants').click();assert.equal((await f.call('list')).entries.length,0);await button(f.root,'Show recycled groups').click();const recycled=row(f.root,'Selected');field(recycled,'Confirm restoring this group and all descendants').checked=true;await button(recycled,'Restore recycled group').click();assert.equal((await f.call('list')).entries.length,2);});
test('open entry and new dirty draft prevent group commands before any mutation transport',async t=>{const f=await fixture(t);await openEntry(f.root,'A');const control=await begin(f.root);await control.click();assert.equal(f.requests.filter(r=>r.action==='recycleGroupDelete').length,0);await button(f.root,'New entry').click();field(f.root,'Title').value='New unsaved draft';field(f.root,'Title').listeners.get('input')();await control.click();assert.equal(f.requests.filter(r=>r.action==='recycleGroupDelete').length,0);assert.equal(field(f.root,'Title').value,'New unsaved draft');});
test('held real committed recursive deletion retains newly typed draft, blocks duplicate/entry Save, and suppresses closed-panel publication',async t=>{const arrived=deferred(),release=deferred(),f=await fixture(t,async(action,input,real)=>{const result=await real();if(action==='recycleGroupDelete'){arrived.resolve();await release.promise;}return result});const control=await begin(f.root),pending=control.click();await arrived.promise;assert.equal(control.disabled,true);assert.equal((await f.call('list')).entries.length,0);field(f.root,'Title').value='New draft after commit';field(f.root,'Title').listeners.get('input')();await control.click();await button(f.root,'Save encrypted entry').click();assert.equal(f.requests.filter(r=>r.action==='save').length,0);await button(f.root,'Close group panel').click();release.resolve();await pending;assert.equal(field(f.root,'Title').value,'New draft after commit');assert(!descendants(f.root).some(e=>e.tagName==='h3'&&e.textContent==='Native groups'));assert.equal(f.requests.filter(r=>r.action==='recycleGroupDelete').length,1);});
test('held group preview cannot publish after view disposal',async t=>{const arrived=deferred(),release=deferred(),f=await fixture(t,async(action,input,real)=>{const result=await real();if(action==='recycleGroupRead'){arrived.resolve();await release.promise;}return result});await button(f.root,'Show native groups').click();const selected=row(f.root,'Selected'),pending=button(selected,'Preview group descendants').click();await arrived.promise;f.cleanup();release.resolve();await pending;assert(!selected.textContent.includes('Entry: A'));assert(!descendants(f.root).some(e=>e.value?.includes('only synthetic secret')));});
test('failed group persistence restores controls and explicit retry uses same uncommitted selection',async t=>{const f=await fixture(t),control=await begin(f.root),real=f.store.set,before=structuredClone(f.store.value);f.store.set=async()=>{throw new Error('Synthetic group store failure')};await control.click();assert.equal(control.disabled,false);assert.deepEqual(f.store.value,before);assert.equal((await f.call('list')).entries.length,2);f.store.set=real;await control.click();assert.equal((await f.call('list')).entries.length,0);assert.equal(f.requests.filter(r=>r.action==='recycleGroupDelete').length,2);});
test('older real entry read cannot reopen a now-recycled descendant after group mutation starts',async t=>{const arrived=deferred(),release=deferred(),f=await fixture(t,async(action,input,real)=>{const result=await real();if(action==='read'){arrived.resolve();await release.promise;}return result});const pending=openEntry(f.root,'A');await arrived.promise;const control=await begin(f.root);await control.click();release.resolve();await pending;assert.equal(field(f.root,'Title').value,'');assert(!descendants(f.root).some(e=>e.value==='A only synthetic secret'));assert.equal((await f.call('list')).entries.length,0);});
test('late committed group response performs no follow-up API read after disposal',async t=>{const arrived=deferred(),release=deferred(),f=await fixture(t,async(action,input,real)=>{const result=await real();if(action==='recycleGroupDelete'){arrived.resolve();await release.promise;}return result});const control=await begin(f.root),pending=control.click();await arrived.promise;const before=f.requests.length;f.cleanup();release.resolve();await pending;assert.equal(f.requests.length,before);assert.equal((await f.call('list')).entries.length,0);assert(!descendants(f.root).some(e=>e.value==='A only synthetic secret'));});
