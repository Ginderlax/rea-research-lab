    {
      "id": "grafana.candidate.a4ea85203d9084789ad5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A threshold returns `0` when the condition is false and `1` when true.",
      "headingPath": [
        "Queries and conditions",
        "Advanced options: Expressions",
        "Threshold"
      ],
      "source": {
        "path": "docs/sources/alerting/fundamentals/alert-rules/queries-conditions.md",
        "gitBlobSha": "552ed8aeffdfa414ba93a5e202cd372a2c5004fa",
        "sha256": "5a45c7a1167e0656a3c24f733bc9219d36fcf33f18bd1e16bd1a04eb4fa85296",
        "lineStart": 171,
        "lineEnd": 171,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/fundamentals/alert-rules/queries-conditions.md#L171-L171"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.414f7397b6056973b343",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If the threshold is set as the alert condition, the alert fires when the threshold returns `1`.",
      "headingPath": [
        "Queries and conditions",
        "Advanced options: Expressions",
        "Threshold"
      ],
      "source": {
        "path": "docs/sources/alerting/fundamentals/alert-rules/queries-conditions.md",
