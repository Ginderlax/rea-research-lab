import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {runSketchChild,collectSketchChild,requireSketchCollectionSuccess} from './candidate/sketch-collector-process.mjs';
const here=path.dirname(fileURLToPath(import.meta.url)),fixture=path.join(here,'fixtures/runner.mjs'),records=[];
async function run(name,args,extra={}){const result=await runSketchChild({args:[fixture,...args],cwd:here,timeoutMs:2000,stdoutBytes:8192,stderrBytes:8192,...extra});records.push({name,...result,stdout:result.stdout.toString('utf8'),stderr:result.stderr.toString('utf8')});return result;}
test('normal child returns exact UTF8 raw output and successful completion',async()=>{const result=await run('normal',['normal']);assert.equal(result.failure,null);assert.equal(result.exitCode,0);assert.equal(result.closed,true);assert.equal(result.stdout.toString(),'café\n');assert.equal(result.stderr.toString(),'diagnostic\n');assert.equal(result.output.stdoutCaptured,6);});
test('exact stdout/stderr cap is accepted without truncation',async()=>{const result=await run('exact',['exact','8192','4096'],{stderrBytes:4096});assert.equal(result.failure,null);assert.equal(result.output.stdoutCaptured,8192);assert.equal(result.output.stderrCaptured,4096);assert.equal(result.output.stdoutTruncated,false);assert.equal(result.output.stderrTruncated,false);});
test('stdout growth returns bounded partial bytes and terminates the owned process',async()=>{const result=await run('oversized-stdout',['stdout'],{stdoutBytes:1000});assert.equal(result.failure.code,'SKETCH_CHILD_STDOUT_LIMIT');assert.equal(result.stdout.length,1000);assert.equal(result.output.stdoutTruncated,true);assert.equal(result.cleanup.confirmed,true);assert.equal(result.closed,true);assert.throws(()=>process.kill(result.pid,0),error=>error.code==='ESRCH');});
test('stderr growth is capped independently and terminates the owned process',async()=>{const result=await run('oversized-stderr',['stderr'],{stderrBytes:777});assert.equal(result.failure.code,'SKETCH_CHILD_STDERR_LIMIT');assert.equal(result.stderr.length,777);assert.equal(result.output.stderrTruncated,true);assert.equal(result.cleanup.confirmed,true);assert.equal(result.closed,true);assert.throws(()=>process.kill(result.pid,0),error=>error.code==='ESRCH');});
test('stalled child hits its active deadline and closes after tree cleanup',async()=>{const result=await run('stalled-child',['stall'],{timeoutMs:150});assert.equal(result.failure.code,'SKETCH_CHILD_TIMEOUT');assert.equal(result.cleanup.confirmed,true);assert.equal(result.closed,true);assert.throws(()=>process.kill(result.pid,0),error=>error.code==='ESRCH');});
test('deadline kills actual owned grandchild as well as the runner',async t=>{const folder=await fs.mkdtemp(path.join(here,'owned-tree-')),filename=path.join(folder,'pids.json');t.after(async()=>{assert.equal(path.dirname(folder),here);assert.ok(path.basename(folder).startsWith('owned-tree-'));await fs.rm(folder,{recursive:true,force:true});});const result=await run('stalled-process-tree',['tree',filename],{timeoutMs:250}),pids=JSON.parse(await fs.readFile(filename));assert.equal(pids.parent,result.pid);assert.equal(result.failure.code,'SKETCH_CHILD_TIMEOUT');assert.equal(result.cleanup.confirmed,true);assert.throws(()=>process.kill(pids.parent,0),error=>error.code==='ESRCH');assert.throws(()=>process.kill(pids.child,0),error=>error.code==='ESRCH');records.at(-1).descendantPid=pids.child;records.at(-1).bothOwnedProcessesDead=true;});
test('nonzero exit is diagnosed without inventing a cap/deadline failure',async()=>{const result=await run('nonzero-exit',['exit']);assert.equal(result.failure.code,'SKETCH_CHILD_EXIT');assert.equal(result.exitCode,7);assert.match(result.stderr.toString(),/synthetic controlled failure/);assert.equal(result.cleanup,null);});
test('spawn failure settles with a diagnostic and no cleanup target',async()=>{const result=await run('spawn-error',['normal'],{cwd:path.join(here,'missing-directory')});assert.equal(result.failure.code,'SKETCH_CHILD_SPAWN_ERROR');assert.equal(result.pid,null);assert.equal(result.cleanup.confirmed,true);assert.equal(result.cleanup.attempted,false);});
test('child environment clears inherited test context without mutating caller environment',async()=>{const env={...process.env,NODE_TEST_CONTEXT:'child-v8'},args=[fixture,'context'],resultPromise=runSketchChild({args,cwd:here,env});args[1]='stdout';env.NODE_TEST_CONTEXT='mutated';const result=await resultPromise;records.push({name:'caller-snapshot',...result,stdout:result.stdout.toString(),stderr:result.stderr.toString()});assert.equal(result.failure,null);assert.deepEqual(JSON.parse(result.stdout),{hasNodeTestContext:false});assert.equal(env.NODE_TEST_CONTEXT,'mutated');});
test('malformed resource limits reject before child execution',async()=>{for(const extra of [{timeoutMs:0},{timeoutMs:120001},{stdoutBytes:-1},{stderrBytes:Infinity},{cleanupMs:1}])await assert.rejects(runSketchChild({args:[fixture,'normal'],cwd:here,...extra}),/Invalid collector/);await assert.rejects(runSketchChild({args:['x\0'],cwd:here}),/arguments/);});
async function collectionFolder(t){const folder=await fs.mkdtemp(path.join(here,'owned-collection-'));t.after(async()=>{assert.equal(path.dirname(folder),here);assert.ok(path.basename(folder).startsWith('owned-collection-'));await fs.rm(folder,{recursive:true,force:true});});const source=path.join(folder,'source.mjs'),observationDirectory=path.join(folder,'observations'),receipt=path.join(folder,'success-receipt.json');await fs.writeFile(source,'export const finite = true;\n');await fs.writeFile(receipt,'EXISTING SUCCESS EVIDENCE');await fs.mkdir(observationDirectory);return{folder,source,observationDirectory,receipt};}
async function collect(name,owned,args,extra={}){const result=await collectSketchChild({args:[fixture,...args],cwd:here,observationDirectory:owned.observationDirectory,sources:[{name:'synthetic-source',path:owned.source}],timeoutMs:2000,stdoutBytes:8192,stderrBytes:8192,...extra});records.push({name,...result,stdout:result.stdout.toString('utf8'),stderr:result.stderr.toString('utf8')});assert.equal(await fs.readFile(owned.receipt,'utf8'),'EXISTING SUCCESS EVIDENCE');assert.deepEqual(JSON.parse(await fs.readFile(path.join(owned.observationDirectory,'child-run.json'))),result.diagnostic);return result;}
test('successful collection snapshots caller inputs and records stable source diagnostics',async t=>{const owned=await collectionFolder(t),args=[fixture,'context'],sources=[{name:'synthetic-source',path:owned.source}],env={...process.env,NODE_TEST_CONTEXT:'child-v8'},promise=collectSketchChild({args,cwd:here,env,observationDirectory:owned.observationDirectory,sources});args[1]='stall';sources[0].path='C:/nonexistent';env.NODE_TEST_CONTEXT='mutated';const result=await promise;records.push({name:'collection-caller-snapshot',...result,stdout:result.stdout.toString(),stderr:result.stderr.toString()});assert.equal(requireSketchCollectionSuccess(result),result);assert.deepEqual(JSON.parse(result.stdout),{hasNodeTestContext:false});assert.equal(result.diagnostic.sourceBytesStable,true);assert.equal(await fs.readFile(owned.receipt,'utf8'),'EXISTING SUCCESS EVIDENCE');});
test('stalled collection retains bounded diagnostics and cannot qualify as success',async t=>{const owned=await collectionFolder(t),result=await collect('collection-stall',owned,['stall'],{timeoutMs:100});assert.equal(result.failure.code,'SKETCH_CHILD_TIMEOUT');assert.equal(result.diagnostic.sourceBytesStable,true);assert.throws(()=>requireSketchCollectionSuccess(result),/SKETCH_CHILD_TIMEOUT/);assert.equal((await fs.readFile(path.join(owned.observationDirectory,'stdout.txt'))).length,0);assert.throws(()=>process.kill(result.pid,0),error=>error.code==='ESRCH');});
test('oversized collection writes clipped output and a failure instead of a success receipt',async t=>{const owned=await collectionFolder(t),result=await collect('collection-stdout-limit',owned,['stdout'],{stdoutBytes:101});assert.equal(result.failure.code,'SKETCH_CHILD_STDOUT_LIMIT');assert.equal((await fs.readFile(path.join(owned.observationDirectory,'stdout.txt'))).length,101);assert.throws(()=>requireSketchCollectionSuccess(result),/SKETCH_CHILD_STDOUT_LIMIT/);});
test('successful child that changes a source is rejected with before/after fingerprints',async t=>{const owned=await collectionFolder(t),result=await collect('collection-source-mutation',owned,['mutate-source',owned.source]);assert.equal(result.failure,null);assert.equal(result.diagnostic.sourceBytesStable,false);assert.notEqual(result.diagnostic.sourceBefore[0].sha256,result.diagnostic.sourceAfter[0].sha256);assert.throws(()=>requireSketchCollectionSuccess(result),/source changed/);});
test('source deletion after execution remains diagnosable and cannot qualify as success',async t=>{const owned=await collectionFolder(t),result=await collect('collection-source-deletion',owned,['delete-source',owned.source]);assert.equal(result.failure,null);assert.equal(result.diagnostic.sourceAfter,null);assert.match(result.diagnostic.sourceError,/ENOENT/);assert.throws(()=>requireSketchCollectionSuccess(result),/source changed/);});
test('exclusive diagnostic writes preserve preexisting evidence bytes',async t=>{const owned=await collectionFolder(t),oldOutput=path.join(owned.observationDirectory,'stdout.txt');await fs.writeFile(oldOutput,'HISTORICAL OUTPUT');await assert.rejects(collectSketchChild({args:[fixture,'normal'],cwd:here,observationDirectory:owned.observationDirectory,sources:[{name:'source',path:owned.source}]}),error=>error.code==='EEXIST');assert.equal(await fs.readFile(oldOutput,'utf8'),'HISTORICAL OUTPUT');assert.equal(await fs.readFile(owned.receipt,'utf8'),'EXISTING SUCCESS EVIDENCE');});
test('source byte budget rejects before launching a child',async t=>{const owned=await collectionFolder(t);await fs.writeFile(owned.source,Buffer.alloc(8*1024*1024+1));await assert.rejects(collectSketchChild({args:[fixture,'tree',path.join(owned.folder,'pids.json')],cwd:here,observationDirectory:owned.observationDirectory,sources:[{name:'source',path:owned.source}]}),/source bytes exceed/);await assert.rejects(fs.stat(path.join(owned.folder,'pids.json')),error=>error.code==='ENOENT');assert.deepEqual(await fs.readdir(owned.observationDirectory),[]);});
test.after(async()=>{let directory=process.env.REA_SKETCH_COLLECTOR_REGRESSION_DIR;if(!directory)directory=await fs.mkdtemp(path.join(here,'synthetic-run-'));directory=path.resolve(directory);assert.equal(path.dirname(directory),here);assert.ok(path.basename(directory).startsWith('synthetic-run-'));await fs.writeFile(path.join(directory,'observations.json'),JSON.stringify({schema:'rea-sketch-collector-synthetic-regressions/v1',createdAt:new Date().toISOString(),runtime:process.version,platform:process.platform,records,scope:'Only owned synthetic Node processes/source files; no geometry28 rerun or production/results mutation.'},null,2)+'\n',{flag:'wx'});});
