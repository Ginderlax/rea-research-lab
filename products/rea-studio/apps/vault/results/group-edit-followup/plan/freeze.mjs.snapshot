import assert from 'node:assert/strict';import {readFileSync,writeFileSync,readdirSync} from 'node:fs';import {resolve} from 'node:path';import {createHash} from 'node:crypto';
const here=import.meta.dirname,repo=resolve(here,'../../outputs/rea-research-lab'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),plan=JSON.parse(readFileSync(resolve(here,'installation-plan.json'))),source=JSON.parse(readFileSync(resolve(here,'source-proof/preservation-manifest.json'))),validation=JSON.parse(readFileSync(resolve(here,'plan-validation-final-v2.json')));assert.equal(validation.finiteSourcePlanAcceptance,true);assert.equal(validation.adaptersExecuted,false);assert.equal(validation.proposedLiveFiles,16);
for(const r of plan.rows){assert.deepEqual(id(readFileSync(resolve(here,r.source))),r.after);if(r.before)assert.deepEqual(id(readFileSync(resolve(repo,r.target))),r.before);}for(const r of source.records){const b=readFileSync(r.reusedExistingPublic?resolve(repo,r.publicPath):resolve(here,'source-proof/payload',r.sha256+'.snapshot'));assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});}
const doc=JSON.parse(readFileSync(resolve(here,'documentation-deltas.json')));for(const name of ['GROUP-EDIT.md','GROUP-EDIT-NOTICE.md','README.md']){let text=readFileSync(resolve(here,'proposed',name),'utf8');for(const r of doc.changes.filter(r=>r.path==='proposed/'+name).slice().reverse()){assert.equal(text.split(r.after).length-1,1);text=text.replace(r.after,r.before);}assert.equal(text,readFileSync(resolve(here,'initial-documentation',name+'.snapshot'),'utf8'));}
const groupBase='products/rea-studio/apps/vault',licenses=JSON.parse(readFileSync(resolve(here,'source-license-provenance.json')));assert(readFileSync(resolve(here,'proposed/GROUP-EDIT-NOTICE.md'),'utf8').includes('../../results/editor-vault-reviewed-production-installation-20261013/'));assert.equal(licenses.sources.length,17);
function all(p='',out=[]){for(const d of readdirSync(resolve(here,p),{withFileTypes:true})){assert(!d.isSymbolicLink());const n=p?p+'/'+d.name:d.name;if(d.isDirectory())all(n,out);else out.push(n);}return out;}
const files=all().filter(p=>p!=='manifest.json').sort(),inventory=files.map(path=>({path,...id(readFileSync(resolve(here,path)))}));for(const r of inventory)assert.deepEqual(id(readFileSync(resolve(here,r.path))),{bytes:r.bytes,sha256:r.sha256});const m={schema:'rea-vault-group-edit-source-only-installation-plan-strict-freeze/v1',strict:true,files:inventory.length,inventory,productionWrites:0,publicWrites:0,proposalTestsExecuted:false,originalExecutions:0,browserExecutions:0,appSourceBytesChanged:0,selectedOriginalGPLFiles:17,publicAliasRows:1230,newUniquePayloads:234,reusedExistingAliases:832,privateGeneratedExclusions:59,proposedLivePaths:16,currentBeforeSourceFiles:57,futureHistoricalProofTransitionRequired:true};writeFileSync(resolve(here,'manifest.json'),JSON.stringify(m,null,2)+'\n');console.log(JSON.stringify({frozen:inventory.length,manifest:id(readFileSync(resolve(here,'manifest.json'))),validation:id(readFileSync(resolve(here,'plan-validation-final-v2.json'))),installation:id(readFileSync(resolve(here,'installation-plan.json'))),sourceProof:id(readFileSync(resolve(here,'source-proof/preservation-manifest.json'))),live16:true,testsExecuted:0}));
