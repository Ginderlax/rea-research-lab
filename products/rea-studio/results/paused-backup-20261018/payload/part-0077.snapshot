    {
      "id": "grafana.candidate.36c5ce42e894a5e29225",
      "syntaxRole": "procedural-step",
      "sourceText": "1. To find object IDs for a specific group on the Azure portal, go to **Microsoft Entra ID > Manage > Groups**.",
      "headingPath": [
        "Configure Microsoft Entra ID OAuth authentication",
        "Configure the Entra ID authentication client using the Grafana configuration file",
        "Configure allowed groups"
      ],
