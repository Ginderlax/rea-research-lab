    {
      "id": "grafana.candidate.26355c2d5566e233da53",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Log returns the natural logarithm of of its argument which can be a number or a series. If the value is less than 0, NaN is returned. For example `log(-1)` or `log($A)`.",
      "headingPath": [
