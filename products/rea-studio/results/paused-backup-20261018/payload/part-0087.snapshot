    15: lambda bit: 0,  # Always set to zero
}


def mergeUnitsPerEm(lst):
    lst = list(lst)
    if any(item != lst[0] for item in lst[1:]):
        raise ValueError(
            "Cannot merge fonts with different unitsPerEm values: %s" % lst
        )
    return lst[0]


