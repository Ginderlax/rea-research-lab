    },
    {
      "id": "grafana.candidate.f8f4f3bf20540c00d262",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you have [server administrator](../../roles-and-permissions/#grafana-server-administrators) permissions in Grafana, you can manage all users for a Grafana instance in the Server Admin section:",
      "headingPath": [
        "Server user management"
      ],
      "source": {
        "path": "docs/sources/administration/user-management/server-user-management/_index.md",
