    {
      "id": "grafana.candidate.c3923f737b8690f648b0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you are not using a [Terraform backend](https://www.terraform.io/language/settings/backends/configuration) to store the `.tfstate` file, add the following code block to the end of the GitHub workflow file to make sure the Terraform state file is stored in Git.",
      "headingPath": [
        "Create and manage dashboards using Terraform and GitHub Actions",
        "Managing the Terraform state"
      ],
      "source": {
        "path": "docs/sources/as-code/infrastructure-as-code/terraform/dashboards-github-action.md",
        "gitBlobSha": "459c5b38cd31ce2779b873ae9d74fa74634fd374",
        "sha256": "ceb61440ea29be660fd3e7c9c6ab437b193c2955c50ffe13a6b182f1d558ac97",
