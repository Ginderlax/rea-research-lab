    {
      "id": "grafana.candidate.92e984e03665d28d1c5b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can then use the `severity` label to control how alerts are handled. For instance, you could send `critical` alerts immediately, while routing `low` severity alerts to a team for further investigation.",
      "headingPath": [
