    {
      "id": "grafana.candidate.abb73b9cd627ff2e50d0",
      "syntaxRole": "table-row",
      "sourceText": "| **Region**      | Select an AWS region if it differs from the default.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |",
      "headingPath": [
