    {
      "id": "grafana.candidate.5fd11ba55410527530d8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Sustained requests per second that the webhook endpoint allows per client before it returns `429 Too Many Requests`. The instantaneous burst allowance is twice this value. Default is `0`, which disables rate limiting.",
