    {
      "id": "grafana.candidate.b981d5e1c87a7fcd4297",
      "syntaxRole": "table-row",
      "sourceText": "| [Synthetic Monitoring](https://grafana.com/docs/grafana-cloud/testing/synthetic-monitoring/)                                                                                          | `grafana-synthetic-monitoring-app` | [Configure RBAC for Synthetic Monitoring](https://grafana.com/docs/grafana-cloud/testing/synthetic-monitoring/user-and-team-management/)                                                         |",
