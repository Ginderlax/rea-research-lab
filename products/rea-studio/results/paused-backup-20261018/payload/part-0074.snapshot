    {
      "id": "grafana.candidate.868041648710e414a88c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If one of your data sources can only be accessed from your internal network, take a look at the [Private Data Source Connect documentation](https://grafana.com/docs/grafana-cloud/connect-externally-hosted/private-data-source-connect/).",
