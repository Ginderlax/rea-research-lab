        "sha256": "2ec4cfb1a6f5d411460dc0daf71bcbdcb3d69327597eb7fedf4af39ec2d594ee",
        "lineStart": 126,
        "lineEnd": 126,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/shared/alerts/template-language.md#L126-L126"
      },
      "applicability": {
        "status": "unresolved-no-explicit-oss-products-label",
        "products": []
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
