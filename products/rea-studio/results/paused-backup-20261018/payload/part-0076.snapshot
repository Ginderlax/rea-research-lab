          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.5ba01c0aabd5aa3fd290",
      "syntaxRole": "list-item",
      "sourceText": "- **Opt out of auto-updates:** Set `preinstall_auto_update` to `false` in your [configuration file](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-grafana/).",
      "headingPath": [
        "OpenTSDB data source",
        "Plugin updates"
      ],
