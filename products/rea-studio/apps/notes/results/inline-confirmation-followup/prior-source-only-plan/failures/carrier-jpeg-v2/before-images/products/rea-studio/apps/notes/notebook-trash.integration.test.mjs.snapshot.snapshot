import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import {start} from '../../server.mjs';
import {readJex} from './jex.mjs';
test('actual HTTP notebook trash and detached child restore survive cold restart with JEX and exact attachment bytes',async t=>{
 const dataDir=await fs.mkdtemp(path.join(os.tmpdir(),'rea-notebook-trash-http-'));let host=await start({port:0,dataDir}),other;
 t.after(async()=>{await host.close();await other?.close();assert.equal(path.dirname(dataDir),path.resolve(os.tmpdir()));assert.ok(path.basename(dataDir).startsWith('rea-notebook-trash-http-'));await fs.rm(dataDir,{recursive:true,force:true});});
 const call=async(action,input={},status=200,target=host)=>{const response=await fetch(target.url+'/api/notes/'+action,{method:'POST',headers:{'content-type':'application/json','x-rea-token':target.token},body:JSON.stringify(input)}),payload=await response.json();assert.equal(response.status,status,payload.error);return payload.result??payload;},fixture=await fs.readFile(new URL('./fixtures/pinned-joplin.jex',import.meta.url)),original=readJex(fixture),id=d=>d.repeat(32);
 await call('jex-import',{base64:fixture.toString('base64')});let tree=await call('notebook-list');const revision=tree.revision,old=await call('get',{id:id('3')});await call('notebook-trash',{id:id('1'),revision},400);assert.equal((await call('list')).total,2);
 tree=await call('notebook-trash',{id:id('1'),revision,confirmed:true});assert.equal(tree.changedNotes.length,2);assert.equal(tree.notebooks.find(r=>r.id===id('1')).displayParentId,'de1e7ede1e7ede1e7ede1e7ede1e7ede');assert.equal(tree.notebooks.find(r=>r.id===id('2')).displayParentId,id('1'));assert.equal((await call('list')).total,0);assert.equal((await call('list',{trash:true})).total,2);await call('save',{...old,body:'stale pre-trash draft'},400);
 await host.close();host=await start({port:0,dataDir});assert.equal((await call('get',{id:id('3')})).deletedAt!==null,true);const archive=await call('jex-export',{includeTrash:true}),parsed=readJex(Buffer.from(archive.base64,'base64'));assert.deepEqual(parsed.resources.get(id('5')).bytes,original.resources.get(id('5')).bytes);assert.deepEqual(parsed.records.get(id('7')),original.records.get(id('7')));assert.equal(parsed.records.get(id('3')).props.user_updated_time,original.records.get(id('3')).props.user_updated_time);assert.equal(parsed.records.get(id('1')).props.icon,original.records.get(id('1')).props.icon);
 other=await start({port:0,dataDir:path.join(dataDir,'independent-import')});await call('jex-import',{base64:archive.base64},200,other);assert.equal((await call('list',{trash:true},200,other)).total,2);tree=await call('notebook-list');tree=await call('notebook-restore',{id:id('2'),revision:tree.revision,confirmed:true});assert.equal(tree.notebooks.find(r=>r.id===id('2')).parentId,'');assert.equal(tree.notebooks.find(r=>r.id===id('1')).trashed,true);
 await host.close();host=await start({port:0,dataDir});const note=await call('get',{id:id('3')});assert.equal(note.deletedAt,null);assert.equal(note.notebookId,id('2'));assert.equal(note.notebook,'Experiments');assert.equal((await call('list')).total,1);const attachment=await call('attachment-get',{noteId:note.id,id:id('5')});assert.deepEqual(Buffer.from(attachment.base64,'base64'),original.resources.get(id('5')).bytes);
 const final=await call('jex-export',{includeTrash:true}),finalParsed=readJex(Buffer.from(final.base64,'base64'));assert.equal(finalParsed.records.get(id('2')).props.parent_id,'');assert.equal(Number(finalParsed.records.get(id('1')).props.deleted_time)>0,true);await call('jex-export',{},400); // Existing complete-link validation refuses omitted trashed link targets.
 console.log(JSON.stringify({notebookTrashHttp:{hostRestarts:2,independentImportHosts:1,originalApplicationExecutions:0,attachmentSha256:attachment.sha256,trashExportSha256:archive.sha256,restoreExportSha256:final.sha256,defaultExportDanglingTrashedLinkRefused:true}}));
});
