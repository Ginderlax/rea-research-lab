    {
      "id": "grafana.candidate.727b236816531581c492",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Pyroscope enforces query limits on the server side that are separate from, and often shorter than, the data retention period. These limits are enforced by the Pyroscope query frontend, not by the Grafana data source, so the data source can't change or override them.",
      "headingPath": [
        "Troubleshoot Pyroscope data source issues",
        "Grafana Cloud-specific issues",
        "Query time range and retention limits"
      ],
