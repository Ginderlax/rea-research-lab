    {
      "id": "grafana.candidate.5e41fba4a74cda0a5481",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To create a gauge visualization you need a dataset containing at least one numeric field. These values are identified by the field name. Additional text fields aren't required but can be used for identification and labeling.",
