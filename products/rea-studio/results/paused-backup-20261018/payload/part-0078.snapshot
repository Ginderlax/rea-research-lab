    },
    {
      "id": "grafana.candidate.89cfe3a2cb52ddb37b06",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can share a panel by embedding it on another website using an iframe. Users must be signed into Grafana to view the panel unless you have anonymous access permission enabled for your Grafana instance.",
      "headingPath": [
        "Share dashboards and panels",
        "Share panels",
        "Share an embed"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/share-dashboards-panels/_index.md",
        "gitBlobSha": "f451636c2960980ff5e4b91812417279a8958c48",
        "sha256": "36af7f04ef8bb3cb6efb3ae3c832a9cd7faf8af7eb5139895361d60ee3c4f760",
        "lineStart": 320,
        "lineEnd": 320,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/dashboards/share-dashboards-panels/_index.md#L320-L320"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.e8689866bd0d3b7f6011",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Panel embedding and anonymous access permissions are not available in Grafana Cloud, even for panels in [externally shared dashboards](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/visualizations/dashboards/share-dashboards-panels/shared-dashboards/). These capabilities are only supported in Grafana Enterprise and Grafana Open Source.",
      "headingPath": [
        "Share dashboards and panels",
        "Share panels",
        "Share an embed"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/share-dashboards-panels/_index.md",
