import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import {spawnSync} from 'node:child_process';import assert from 'node:assert/strict';
const here=import.meta.dirname,sha=bytes=>createHash('sha256').update(bytes).digest('hex'),fp=async file=>{const bytes=await fs.readFile(file);return{bytes:bytes.length,sha256:sha(bytes)};},preparation=JSON.parse(await fs.readFile(path.join(here,'preparation.json')));
async function authenticatePrior(){for(const binding of preparation.bindings){const bytes=await fs.readFile(path.join(binding.root,'freeze-manifest.json'));assert.equal(sha(bytes),binding.manifestSHA256);const manifest=JSON.parse(bytes);assert.equal(Object.keys(manifest.inventory).length,binding.files);for(const [name,row]of Object.entries(manifest.inventory))assert.deepEqual(await fp(path.join(binding.root,name)),row);}}
await authenticatePrior();
async function files(folder,list=[]){for(const entry of await fs.readdir(path.join(here,folder),{withFileTypes:true})){const name=folder?folder+'/'+entry.name:entry.name;if(entry.isDirectory())await files(name,list);else list.push(name);}return list;}
const names=[...await files('products'),...['capture-action.mjs','prepare-candidate.mjs','run-validation.mjs','held-save.test.mjs','queued-revision.test.mjs']].sort(),before={};for(const name of names){const bytes=await fs.readFile(path.join(here,name));before[name]={bytes:bytes.length,sha256:sha(bytes)};const relative='source-before/'+name+'.snapshot';await fs.mkdir(path.dirname(path.join(here,relative)),{recursive:true});await fs.writeFile(path.join(here,relative),bytes,{flag:'wx'});}await fs.writeFile(path.join(here,'sources.before.json'),JSON.stringify(before,null,2)+'\n',{flag:'wx'});
const prefix='products/rea-studio/apps/editor/',groups=[['exact-held-save-replay',['held-save.test.mjs']],['exact-queued-revision-replay',['queued-revision.test.mjs']],['save-and-search-regression',['app.integration.test.mjs','app.test.mjs','workspace-search-path.test.mjs','workspace-search.integration.test.mjs','workspace-search.test.mjs','workspace-search.ui.test.mjs','save-publication.ui.test.mjs'].map(name=>prefix+name)]],results=[];
for(const [label,tests]of groups){const start=new Date().toISOString(),args=['--test','--test-reporter=tap',...tests],child=spawnSync(process.execPath,args,{cwd:here,encoding:'utf8',windowsHide:true,timeout:180000,maxBuffer:4*1024*1024}),stdout=child.stdout??'',stderr=child.stderr??'';for(const [suffix,bytes]of [['.stdout.txt',stdout],['.stderr.txt',stderr]])await fs.writeFile(path.join(here,label+suffix),bytes,{flag:'wx'});const counts=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(key=>[key,Number(stdout.match(new RegExp('^# '+key+' (\\d+)$','m'))?.[1])]));results.push({label,tests,args,start,end:new Date().toISOString(),exitCode:child.status,signal:child.signal,error:child.error?.message,counts,stdout:{path:label+'.stdout.txt',...await fp(path.join(here,label+'.stdout.txt'))},stderr:{path:label+'.stderr.txt',...await fp(path.join(here,label+'.stderr.txt'))}});}
const after={};for(const name of names)after[name]=await fp(path.join(here,name));assert.deepEqual(after,before);assert.deepEqual((await files('products')).sort(),names.filter(name=>name.startsWith('products/')).sort());await authenticatePrior();await fs.writeFile(path.join(here,'sources.after.json'),JSON.stringify(after,null,2)+'\n',{flag:'wx'});
const totals=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(key=>[key,results.reduce((sum,row)=>sum+row.counts[key],0)])),receipt={schema:'rea-editor-save-correction-focused-validation/v1',checkedAt:new Date().toISOString(),status:totals.fail||results.some(row=>row.exitCode!==0)?'failed; raw retained':'passed focused checks; independent acceptance pending',acceptance:false,priorBindings:preparation.bindings.map(({root,...row})=>row),allPriorBeforeAfterAuthenticated:true,sourceBeforeAfterStable:true,sourceFiles:names.length,sources:before,results,totals,
  exactOldHeldBodiesExceptImports:true,exactOldQueuedRevisionBodiesExceptImports:true,newProductClientControls:4,regressionSelection:'Editor app/read/save/HTTP and workspace search core/path/UI/HTTP; unchanged Git CLI and sequence-diff suites not rerun.',originalEngineExecutions:0,noBenchmarkMemoryProfilerRuns:true,productionChanged:false,node:{version:process.version,execPath:process.execPath},childDeadlineMs:180000,childCombinedOutputLimitBytes:4*1024*1024};await fs.writeFile(path.join(here,'focused-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:receipt.status,totals,sourceFiles:names.length,sourceStable:true,groups:results.map(({label,counts,exitCode,error})=>({label,counts,exitCode,error}))}));if(receipt.status.startsWith('failed'))process.exitCode=1;
