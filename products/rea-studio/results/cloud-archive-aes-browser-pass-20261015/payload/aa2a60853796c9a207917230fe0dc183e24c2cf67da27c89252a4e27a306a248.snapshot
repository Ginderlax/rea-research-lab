// Preserve exact already-verified hosted browser evidence; no app/browser execution.
import assert from'node:assert/strict';import fs from'node:fs';import path from'node:path';import{createHash}from'node:crypto';import{gzipSync,gunzipSync}from'node:zlib';
const work=import.meta.dirname,stage=path.join(work,'cloud-browser-success-d493-public-next'),publicRoot=path.join(stage,'public-candidate'),hash=b=>createHash('sha256').update(b).digest('hex'),identity=b=>({bytes:b.length,sha256:hash(b)});
const definitions=[
 {kind:'archive-aes',prefix:'products/rea-studio/results/cloud-archive-aes-browser-pass-20261015',run:'38826463567',job:'116734959469',artifact:'12015565859',sha256:'a55a7bfaba09abc98506e0dc25cf693bbebed625f4f1c79fa4b2c6bc28e27b06',verification:'local-archive-browser-backup-verification.json',reader:'unpack-archive-browser-cloud-attempt.py',snapshots:343,totalFiles:388},
 {kind:'flow-vault-cleanup',prefix:'products/rea-studio/results/cloud-flow-vault-browser-cleanup-pass-20261015',run:'38826470332',job:'116734980646',artifact:'12015233580',sha256:'7cf2c9b40e6385b2622a313d28f3bdf5b3399abe3b528271e23316a8d5f1dbfa',verification:'local-browser-backup-verification.json',reader:'unpack-browser-cloud-attempt.py',snapshots:330,totalFiles:373}
];
function safe(name){assert(typeof name==='string'&&name&&!/[\\:\x00-\x1f\x7f]/.test(name)&&!name.startsWith('/')&&name.split('/').every(p=>p&&p!=='.'&&p!=='..'));return name;}
function read(root,name){safe(name);let at=root;for(const part of name.split('/')){at=path.join(at,part);assert(!fs.lstatSync(at).isSymbolicLink());}const s=fs.lstatSync(at);assert(s.isFile()&&s.size<=12*1024*1024);const bytes=fs.readFileSync(at);assert.equal(bytes.length,s.size);return bytes;}
assert(!fs.existsSync(stage));const capsuleSummaries=[];
const credentials=/\b(?:ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,}|AKIA[0-9A-Z]{16})\b|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----/;
for(const definition of definitions){
 const runFolder=path.join(work,'cloud-verification-backups','run-'+definition.run),backup=path.join(runFolder,'artifact-'+definition.artifact),evidence=path.join(backup,'readable-evidence');
 const verificationBytes=read(backup,definition.verification),verified=JSON.parse(verificationBytes);assert.equal(verified.artifactSHA256,definition.sha256);assert.equal(verified.allCRCAndBytesReadable,true);assert.equal(verified.localProductExecutions,0);assert.equal(verified.files.length,definition.totalFiles);assert.equal(verified.sourceSnapshotFilesVerified,definition.snapshots);
 const files=new Map(verified.files.map(row=>[safe(row.path),row]));assert.equal(files.size,definition.totalFiles);
 function artifactFile(name){const b=read(evidence,name),row=files.get(name);assert(row);assert.deepEqual(identity(b),{bytes:row.bytes,sha256:row.sha256});return b;}
 const attempt=JSON.parse(artifactFile('browser-attempt.json'));assert.equal(attempt.status,'passed');assert.equal(attempt.sourceStable,true);assert.equal(attempt.sourceFiles,definition.snapshots);assert.equal(attempt.originalProductExecutions,0);
 const retained=[...files.keys()].filter(name=>!name.startsWith('source/')),omitted=[...files.values()].filter(row=>row.path.startsWith('source/')).map(row=>({sourcePath:row.path,bytes:row.bytes,sha256:row.sha256}));assert.equal(omitted.length,definition.snapshots);
 const target=path.join(publicRoot,definition.prefix);fs.mkdirSync(path.join(target,'payload'),{recursive:true});const records=[],objects=new Map();
 function save(role,raw){safe(role);assert(!records.some(row=>row.sourcePath===role));assert(!credentials.test(raw.toString('utf8')));const decoded=identity(raw),png=raw.subarray(0,8).equals(Buffer.from('89504e470d0a1a0a','hex')),zip=raw.subarray(0,4).equals(Buffer.from('504b0304','hex')),sevenzip=raw.subarray(0,6).equals(Buffer.from('377abcaf271c','hex'));let bytes=raw,encoding='identity';if(!png&&!zip&&!sevenzip&&raw.length>65536){const gzip=gzipSync(raw,{level:9});if(gzip.length<raw.length*.85){assert.deepEqual(gunzipSync(gzip),raw);bytes=gzip;encoding='gzip';}}const stored=identity(bytes),name='payload/'+decoded.sha256+(png?'.png':zip?'.zip.snapshot':sevenzip?'.7z.snapshot':encoding==='gzip'?'.gz.snapshot':'.snapshot');if(!objects.has(name)){fs.writeFileSync(path.join(target,name),bytes,{flag:'wx'});assert.deepEqual(read(target,name),bytes);objects.set(name,stored);}records.push({sourcePath:role,path:name,...decoded,storage:{encoding,...stored},nativePNG:png});}
 for(const name of retained)save('artifact/'+name,artifactFile(name));
 save('local/'+definition.verification,verificationBytes);save('local/collection-summary.json',read(runFolder,'collection-summary.json'));save('wrapper/job-'+definition.job+'.txt',read(path.join(work,'cloud-verification-backups','job-'+definition.job),'logs.txt'));
 for(const name of ['run','jobs','artifacts'])save('control-plane/'+name+'.json',read(runFolder,'control-plane-evidence/'+name+'.json'));
 save('readers/'+definition.reader,read(work,definition.reader));save('readers/public-preservation-collector.mjs',fs.readFileSync(import.meta.filename));
 const manifest={schema:'rea-hosted-browser-followup-pass-preservation/v1',createdAt:new Date().toISOString(),status:'passed-finite-browser-contracts',kind:definition.kind,runId:definition.run,runAttempt:1,runURL:'https://github.com/Ginderlax/rea-research-lab/actions/runs/'+definition.run,jobId:definition.job,headSHA:'d493fe8845f859855c5d3695a85a41ed7b8c0bd8',sourceCommit:attempt.sourceCommit,artifactId:definition.artifact,artifactSHA256:definition.sha256,artifactBytes:verified.archiveBytes,summary:attempt.summary,sourceFiles:attempt.sourceFiles,sourceStable:true,sourceCapturedBeforeExecution:true,sourceSnapshotFiles:definition.snapshots,screenshots:attempt.screenshots,browserImage:attempt.browserImage,completeReadableLocalBackupVerified:true,localReadableFiles:definition.totalFiles,retainedArtifactFiles:retained.length,publicSourceSnapshotPayloads:0,omittedSourceSnapshotPayloads:omitted,omissionScope:'Only artifact source/ active snapshot payloads are omitted publicly with every identity retained. Complete readable copies remain in the verified local backup. Every other uploaded artifact role, raw output, actual produced artifact, screenshot, wrapper log, raw API response and backup reader remains recoverable exactly.',records,uniquePublicObjects:0,storedPayloadBytes:0,allCopiesExact:true,allStorageDecodesExact:true,originalProductExecutions:0,historicalReceiptsRebound:false,applicationSourcesMutatedDuringRun:false,localProductExecutions:0,localBrowserExecutions:0,localTests:0,localBuilds:0,fullDevelopmentSuiteAcceptance:false,fullProductParity:false,superiority:false,browserMatrixAcceptance:false};
 if(definition.kind==='archive-aes'){
   assert.equal(attempt.sourceCommit,'d493fe8845f859855c5d3695a85a41ed7b8c0bd8');assert.equal(verified.recordedSixScenarioArchiveGatesConsistent,true);assert.equal(verified.sameAttemptWorkerRecordsVerified,1);assert.equal(verified.realWorkspaceArtifactsVerified.length,8);
   assert.deepEqual(attempt.summary,{tests:6,passed:6,failed:0,skipped:0,flaky:0,retries:0,exactRealDownloads:0,exactCreatedArchiveArtifacts:3,exactRestoredFileArtifacts:5,productDownloadUIAbsent:true,originalProcesses:0});
   Object.assign(manifest,{testedReference:'refs/heads/codex/rea-cloud-recovery-20261015',productionInstalled:false,exactEphemeralArchiveTargets:21,eligibleAfterimageSources:14,allArchiveSourceFiles:62,actualBrowserDownloads:0,productDownloadUIAbsent:true,actualCreatedArchiveArtifacts:3,actualRestoredFileArtifacts:5,workspaceArtifacts:verified.realWorkspaceArtifactsVerified,sameAttemptWorkerRecords:attempt.browserWorkers,independentArchiveSourcePostcheck:'passed',independentBrowserSourcePostcheck:'source-verified',acceptedScope:'Six real Chromium scenarios on the exact21 experimental Archive overlay: plain ZIP and AES7Z create/list/extract, ZIP encryption refusal, wrong passwords, held actual responses and disposal. All8 workspace artifacts were checked against exact raw byte identities. This does not install the overlay or establish complete format, encryption, browser or product parity.'});
 }else{
   assert.equal(attempt.sourceCommit,'a89735ac1dd1dc0d39f1aeb7f71c1ff0b0ef4ac1');assert.equal(verified.passedRecordedBrowserGatesConsistent,true);assert.deepEqual(attempt.summary,{tests:12,passed:12,failed:0,skipped:0,flaky:0,retries:0,exactRealDownloads:3});
   const cleanupBytes=read(backup,'local-owned-cleanup-verification.json'),cleanup=JSON.parse(cleanupBytes);assert.equal(cleanup.allTwelveCasesDrainedAndClosed,true);assert.equal(cleanup.allTwelveUnexpectedErrorsEmpty,true);assert.equal(cleanup.sameAttemptWorkerRecords,1);save('local/local-owned-cleanup-verification.json',cleanupBytes);save('readers/verify-flow-vault-cleanup-backup-2336.mjs',read(work,'verify-flow-vault-cleanup-backup-2336.mjs'));
   Object.assign(manifest,{testedReference:'refs/pull/1/merge',applicationRuntimeOverlayTargets:0,actualBrowserDownloads:3,allTwelveRequestDrainContextCloseServerCloseRecorded:true,sameAttemptWorkerRecords:1,fixtureCleanupEpochChanged:true,originalServerCloseCauseProven:false,acceptedScope:'Twelve real Chromium Flow/Vault scenarios passed with unchanged behavior assertions and the reviewed owned-fixture teardown correction. Every case recorded drained requests, context closure and server closure, with errors[] empty and no failed owned page requests. Three exact raw UTF8 downloads are retained. This pass does not prove the precise cause of the earlier server-close timeout or establish a broad reliability, complete product or browser-matrix improvement.'});
 }
 manifest.records=records;manifest.uniquePublicObjects=objects.size;manifest.storedPayloadBytes=[...objects.values()].reduce((sum,row)=>sum+row.bytes,0);const manifestBytes=Buffer.from(JSON.stringify(manifest,null,2)+'\n');fs.writeFileSync(path.join(target,'preservation-manifest.json'),manifestBytes,{flag:'wx'});
 const readme='# Finite hosted browser pass\n\n'+manifest.acceptedScope+'\n\nThis capsule retains every uploaded non-source artifact role exactly. The source/ payloads are omitted publicly with all byte identities preserved; complete readable local copies are verified. Native PNGs remain PNGs. Test-created archives remain exact inert.zip/.7z snapshots, and no vendor executable is included.\n\nEach record gives its original decoded bytes/sha256 and storage bytes/sha256. Read storage.encoding=identity directly; decompress storage.encoding=gzip and authenticate the result with the top-level identity. Compression affects storage only. Earlier failed receipts remain separate and unchanged.\n';fs.writeFileSync(path.join(target,'README.md'),readme,{flag:'wx'});
 capsuleSummaries.push({kind:definition.kind,prefix:definition.prefix,runId:definition.run,manifest:identity(manifestBytes),roles:records.length,objects:objects.size,retainedArtifactFiles:retained.length,omittedSourceSnapshots:omitted.length,storedPayloadBytes:manifest.storedPayloadBytes});
}
const rows=[];function inventory(dir){for(const item of fs.readdirSync(dir,{withFileTypes:true})){const filename=path.join(dir,item.name);assert(!item.isSymbolicLink());if(item.isDirectory())inventory(filename);else rows.push({path:path.relative(publicRoot,filename).replaceAll('\\','/'),...identity(fs.readFileSync(filename))});}}inventory(publicRoot);const bytes=rows.reduce((sum,row)=>sum+row.bytes,0);assert(bytes<=3*1024*1024);
const authority={schema:'rea-work-only-d493-browser-success-copy-authority/v1',createdAt:new Date().toISOString(),publicCandidate:publicRoot,files:rows.length,bytes,capsules:capsuleSummaries,rows,olderCapsulesChanged:false,activeFilesWritten:0,localProductExecutions:0,localTests:0,localBuilds:0};fs.writeFileSync(path.join(stage,'copy-authority.json'),JSON.stringify(authority,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({stage,files:rows.length,bytes,capsules:capsuleSummaries,copyAuthority:identity(fs.readFileSync(path.join(stage,'copy-authority.json'))),activeFilesWritten:0,localProductExecutions:0}));
