 assert receipt['productionInstalled']is False and receipt['historicalReceiptsRebound']is False and receipt['applicationExecutions']+receipt['originalExecutions']+receipt['browserExecutions']==0
 after_dir='composition-source/';before_dir='composition-baseline-source/';raw_bundle=content(after_dir+BUNDLE+'.snapshot');assert identity(raw_bundle)==PINS[BUNDLE];gitbound(BUNDLE,raw_bundle);bundle=json.loads(raw_bundle)
 assert bundle['schema']=='rea-Notes-new-to-do-cloud-source-bundle/v1'and bundle['productionInstalled']is False and bundle['historicalReceiptsRebound']is False
 assert len(bundle['transitions'])==7 and len(bundle['payloads'])==17 and len(bundle['baselineNotesSources'])==32 and len(bundle['composedNotesSources'])==36 and len(bundle['fixedTests'])==21
 assert len(bundle['oldNamedGroupsRequired'])==23 and len(bundle['newNamedGroupsRequired'])==19 and bundle['plannedGroups']==111
 assert bundle['separateComparisonCounts']=={'existingConversionAndCompletion':20,'newParentAndType':4,'newDesktopCommandArguments':2,'addedToTestGroupCounts':False}
 assert bundle['featureAuthority']=={'bytes':12444,'sha256':'3761f2727dc549992c6a0e56c601d0f7c674fba10cfd770d5de039b82c93d310'}and bundle['featureIndependentPeer']=={'bytes':6520,'sha256':'f1fe470de0346126b69920f7b321b197d549800dce519fc3fafab33c114625bc'}
 targets={r['path']:r for r in bundle['transitions']};assert len(targets)==7
 eligible={p:r for p,r in targets.items()if re.search(r'\.(mjs|json|html|css|ps1)$',p)};assert len(eligible)==6
 shared=[{'path':BUNDLE,**PINS[BUNDLE]},*bundle['payloads'],*bundle['historicalOriginalDependencies'],*bundle['sharedHostSources'],bundle['workflow']]
 before_inputs={r['path']:pin(r)for r in [*shared,*bundle['baselineNotesSources']]};after_inputs={r['path']:pin(r)for r in [*shared,*bundle['composedNotesSources']]};assert len(before_inputs)==56 and len(after_inputs)==60
 for name,expected_pin in before_inputs.items():data=content(before_dir+name+'.snapshot');assert identity(data)==expected_pin;gitbound(name,data)
 for name,expected_pin in after_inputs.items():
  data=content(after_dir+name+'.snapshot');assert identity(data)==expected_pin
  if name in targets:
   assert identity(data)==targets[name]['after']
   if targets[name]['before']:assert targets[name]['before']==before_inputs[name]
   else:assert name not in tree
  else:gitbound(name,data)
 for row in bundle['transitions']:
  assert pin(row['afterImage'])==row['after']and pin(next(r for r in bundle['payloads']if r['path']==row['afterImage']['path']))==row['after']
  if row['before']:assert pin(row['beforeImage'])==row['before']and pin(next(r for r in bundle['payloads']if r['path']==row['beforeImage']['path']))==row['before']
 assert mapping(receipt['baselineSources'])==mapping(bundle['baselineNotesSources'])and mapping(receipt['composedSources'])==mapping(bundle['composedNotesSources'])
 assert mapping(receipt['currentSourceInputs'])==after_inputs and receipt['proofReadFiles']==60 and receipt['proofReadBytes']==sum(r['bytes']for r in after_inputs.values())and receipt['proofFileLimit']==64 and receipt['proofByteLimit']==8388608
 assert receipt['bundle']==PINS[BUNDLE]and[receipt[k]for k in('exactTargets','eligibleTargets','separateReadmeTargets')]==[7,6,1]
 allowed={p:(' M'if r['before']else'??')for p,r in targets.items()};actual_allowed=receipt['allowedDirtyPaths'];assert len(actual_allowed)==len({r['path']for r in actual_allowed})==7 and all(set(r)=={'path','status'}for r in actual_allowed);assert {r['path']:r['status']for r in actual_allowed}==allowed
 expected_baseline={p for p in tree if p.startswith(PREFIX+'apps/notes/')and'/results/'not in p};assert expected_baseline==set(mapping(bundle['baselineNotesSources']))
 oldtests={p for p in expected_baseline if p.endswith('.test.mjs')};assert len(oldtests)==17 and oldtests.issubset(mapping(bundle['composedNotesSources']))
 for p in oldtests:assert before_inputs[p]==after_inputs[p]
 assert sorted(bundle['fixedTests'])==sorted(p.removeprefix(PREFIX)for p in after_inputs if p.startswith(PREFIX+'apps/notes/')and p.endswith('.test.mjs'))
 before=load('composition-source-before.json');after=load('composition-source-after.json');bm=mapping(before);am=mapping(after);assert len(after)==len(before)+4
 roots={'apps','lib','public','browser-tests','scripts','tests'};excluded={'node_modules','.local','results'};top={'server.mjs','catalog.mjs','package.json'}
 expected_eligible=set()
 for full in tree:
  if not full.startswith(PREFIX):continue
  relative=full.removeprefix(PREFIX);parts=relative.split('/')
  if relative in top or(len(parts)>=2 and parts[0]in roots and not excluded.intersection(parts)and re.search(r'\.(mjs|json|html|css|ps1)$',relative)):expected_eligible.add(relative)
 assert set(bm)==expected_eligible,'Complete baseline six-directory census must equal HEAD eligible Git tree'
 additions={name.removeprefix(PREFIX)for name,row in eligible.items()if row['before']is None};assert len(additions)==4 and not additions.intersection(expected_eligible)
 assert set(am)==expected_eligible|additions,'Complete after census must add exactly four reviewed test files'
 assert all(name.removeprefix(PREFIX)in am for name in eligible)
 assert receipt['baselineCensus']==identity(content('composition-source-before.json'))and receipt['composedCensus']==identity(content('composition-source-after.json'))
 assert len(before)<=2000 and len(after)<=2000 and sum(r['bytes']for r in after)<=67108864 and all(r['bytes']<=8388608 for r in after)
 for p,r in bm.items():
  name=PREFIX+p
  if name in eligible:assert eligible[name]['before']and r==eligible[name]['before']
  else:assert am[p]==r
 for p,r in am.items():
  data=content('active-source/'+p+'.snapshot');assert identity(data)==r
  if PREFIX+p in eligible:assert r==eligible[PREFIX+p]['after']
  else:assert p in bm;gitbound(PREFIX+p,data)
 expected_auth={'activeSixDirectorySources':len(after),'eligibleNotesSources':34,'exactOverlayAfterimages':6,'allOtherGitBlobs':len(after)-6,'separatelyPinnedReadme':1,'sourceOverlay':True}
 assert receipt['composedSourceAuthentication']==expected_auth
