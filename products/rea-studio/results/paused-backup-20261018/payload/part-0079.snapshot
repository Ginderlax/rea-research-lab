    },
    {
      "id": "grafana.candidate.646137f63f3568db0e15",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For more information, refer to the [documentation](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/tempo/query-editor/traceql-search/#optional-use-aggregate-by), as well as the following video demo.",
      "headingPath": [
        "What’s new in Grafana v10.2",
        "Data sources and querying",
        "Tempo data source",
        "Compute RED metrics over spans aggregated by attribute with the \"Aggregate By\" Search option"
      ],
      "source": {
