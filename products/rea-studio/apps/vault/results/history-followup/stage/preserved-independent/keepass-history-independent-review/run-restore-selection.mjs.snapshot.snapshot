import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import {spawn} from 'node:child_process';
const own=path.dirname(fileURLToPath(import.meta.url)),stage=path.resolve(own,'../keepass-history-next'),sha=b=>createHash('sha256').update(b).digest('hex'),names=['history.mjs','server.mjs','client.mjs','kdbx.mjs','xml.mjs'];async function fingerprint(){return Promise.all(names.map(async name=>({path:name,sha256:sha(await fs.readFile(path.join(stage,name)))})));}
const before=await fingerprint(),output=path.join(own,'runs/restore-selection');await fs.mkdir(output,{recursive:true});const child=spawn(process.execPath,['--test',path.join(own,'restore-selection.test.mjs')],{cwd:own,windowsHide:true,stdio:['ignore','pipe','pipe']});let stdout='',stderr='';child.stdout.on('data',part=>stdout+=part);child.stderr.on('data',part=>stderr+=part);const exitCode=await new Promise((resolve,reject)=>{child.once('error',reject);child.once('close',resolve);});await fs.writeFile(path.join(output,'stdout.txt'),stdout);await fs.writeFile(path.join(output,'stderr.txt'),stderr);const after=await fingerprint();const receipt={schema:'rea-independent-keepass-restore-selection-run/v1',exitCode,sourceStable:JSON.stringify(before)===JSON.stringify(after),sourceFingerprints:before,test:{path:'restore-selection.test.mjs',sha256:sha(await fs.readFile(path.join(own,'restore-selection.test.mjs')))},expectedSafetyAssertion:true};await fs.writeFile(path.join(output,'validation.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify(receipt));
