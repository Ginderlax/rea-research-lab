    {
      "id": "grafana.candidate.8a4425d5a3a29ecb8a23",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This variable is only available in the **Singlestat** panel and can be used in the prefix or suffix fields on the Options tab. The variable is replaced with the series name or alias.",
