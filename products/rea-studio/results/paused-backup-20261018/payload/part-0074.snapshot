    {
      "id": "grafana.candidate.bbd31f09f1558e2f72f2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "`--insecure` allows you to turn off Transport Layer Security (TLS) verification (insecure). You might want to do this if you are downloading a plugin from a non-default source.",
      "headingPath": [
        "Administer Grafana with the Grafana server CLI",
        "Global options",
        "Override Transport Layer Security"
      ],
