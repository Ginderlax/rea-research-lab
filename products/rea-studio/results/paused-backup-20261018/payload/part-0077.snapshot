      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Add the `https://www.googleapis.com/auth/cloud-identity.groups.readonly` scope to your Grafana `[auth.google]` scopes configuration to retrieve groups.",
      "headingPath": [
