def publication_pass():
 need(api is not None and git is not None and tables is not None and declaration is not None and historical is not None and tooling is not None,'All independent source/Git/envelope gates required')
 need(attempt['status']=='passed' and api['runConclusion']==api['jobConclusion']=='success','Failed attempts cannot receive publication acceptance')
 need(len(members)==95 and set(members)==set(EXPECTED_MEMBERS),'Exact95 roles for a passed attempt')
 contract=attempt['artifactRoleContract'];need(contract=={'schema':'rea-Notes36-publication-artifact-roles/v1','expectedFiles':95,'unchangedFileLimit':96,'paths':EXPECTED_MEMBERS,'workflowAttemptWrittenAfterProducer':True,'expectedProducerFiles':94,'producerFilesVerified':94,'exactRoleSetVerifiedBeforeWorkflow':True},'Exact95/94/96 role contract')
 controls=item('controls.json');need(controls['schema']=='rea-cloud-publication-controls/v1' and controls['status']=='passed' and controls['sourceOnly'] is True and controls['checks']==len(controls['rows'])==306 and all(r['passed'] is True for r in controls['rows']),'All306 actual control rows passed')
 names=[r['name'] for r in controls['rows']];need(names==EXPECTED_CONTROL_NAMES and len(set(names))==306 and attempt['controls']=={'status':'passed','checks':306},'Exact preserved208 plus additional98 control names and order')
 event_raw=data('events.jsonl');need(event_raw.endswith(b'\n'),'Complete JSONL events');events=[json.loads(x) for x in event_raw.decode().splitlines()];need(0<len(events)<=5000,'Bounded raw event count')
 previous=None
 for index,row in enumerate(events):
  need(row['sequence']==index+1,'Consecutive raw event sequence');at=utc(row['at']);need(previous is None or previous<=at,'Ordered event clocks');previous=at
 need([r['name'] for r in events if r['type']=='control-started']==names and [r['name'] for r in events if r['type']=='control-passed']==names and all(r['passed'] is True for r in events if r['type']=='control-passed'),'Raw306 event names/order match all control rows')
 need(events[-1]['type']=='terminal' and events[-1]['status']=='passed','Successful raw terminal event')
 phases=attempt['phases'];need(len(phases)==2 and [p['name'] for p in phases]==['publication-write','publication-recheck'],'Exactly two original root phases')
 start=utc(attempt['startedAtUtc']);end=utc(attempt['completedAtUtc']);need(start<=utc(phases[0]['startedAtUtc'])<=utc(phases[0]['completedAtUtc'])<=utc(phases[1]['startedAtUtc'])<=utc(phases[1]['completedAtUtc'])<=end,'Sequential outer phase bounds')
 job_start=datetime.datetime.fromisoformat(api['jobStartedAtUtc'].replace('Z','+00:00'));job_end=datetime.datetime.fromisoformat(api['jobCompletedAtUtc'].replace('Z','+00:00'));need(job_start<=start<=end<=job_end,'Owning job clock bounds')
 outputs=[];clocks=[]
 for phase in phases:
  name=phase['name'];out=data(name+'.stdout.txt');err=data(name+'.stderr.txt');need(phase['stdoutBytes']==len(out) and phase['stderrBytes']==len(err) and len(out)<=2097152 and len(err)<=1048576,'Exact retained phase stream sizes/bounds')
  need(phase['timeoutMs']==1200000 and len(phase['command']) in (2,3) and phase['command'][1]=='scripts/verify-records.mjs' and phase['command'][2:]==(['--write'] if name=='publication-write' else []),'Exact original root command/deadline')
  value=json.loads(out.decode().strip().splitlines()[-1]);stable,clock=projected(value,phase);outputs.append((value,stable));clocks.append(clock)
 need(exact_json(outputs[0][1],outputs[1][1]),'All fields except exactly three validated owned clocks deeply equal, including boolean/null/array types')
 comparison=attempt['repeatComparison'];need(comparison['status']=='passed' and comparison['onlyNamedObservationClocksProjected'] is True and comparison['allOtherFieldsDeepEqual'] is True,'Recorded strict repeat comparator')
 for key,index in [('first',0),('second',1)]: need(comparison[key]=={'clocks':clocks[index],'rawStdout':identity(data(phases[index]['name']+'.stdout.txt'))},'Exact raw clock/stream receipt '+key)
 derived=attempt['derived'];need(len(derived)==2 and {r['path'] for r in derived}=={'PUBLICATION-MANIFEST.json','VALIDATION.json'},'Exactly two derived records')
 for row in derived: need(identity(data('derived/'+row['path']))=={k:row[k] for k in ('bytes','sha256')},'Derived byte identity '+row['path'])
 need(item('derived/VALIDATION.json')==outputs[0][0],'Original first root output equals actual derived validation JSON')
 manifest=item('derived/PUBLICATION-MANIFEST.json');need(manifest['schema']=='rea-publication-manifest/v1' and manifest['algorithm']=='sha256' and manifest['derived_records_excluded']==['PUBLICATION-MANIFEST.json','VALIDATION.json'],'Manifest schema/derivative exclusions')
 payload=manifest['files'];need(24000<len(payload)<=30000 and len({r['path'] for r in payload})==len(payload),'Manifest unique bounded payload rows')
 for row in payload: safe(row['path']);need(type(row['bytes']) is int and row['bytes']>=0 and re.fullmatch(r'[0-9a-f]{64}',row['sha256']),'Manifest row shape')
 need({r['path'] for r in payload}==set(git_blobs)-{'PUBLICATION-MANIFEST.json','VALIDATION.json'},'Manifest path closure equals actual tested Git tree')
 compact=json.dumps(payload,ensure_ascii=False,separators=(',',':')).encode();payload_id={'files':len(payload),'bytes':sum(r['bytes'] for r in payload),'rowsIdentity':identity(compact)}
 need(payload_id==attempt['payloadBefore']==attempt['payloadAfter'] and attempt['payloadStable'] is True,'Exact stable payload identity and canonical ordered manifest rows')
 need(attempt['generatedManifest']==identity(data('derived/PUBLICATION-MANIFEST.json')) and attempt['generatedManifestValidated'] is True and attempt['firstRootWritePassed'] is True,'Final generated manifest validation')
 need(attempt['derivedWorktreePaths']==sorted(set(attempt['derivedWorktreePaths'])) and set(attempt['derivedWorktreePaths'])<=set(['PUBLICATION-MANIFEST.json','VALIDATION.json']),'Only two permitted derived worktree paths')
 workflow=item('workflow-attempt.json');need(workflow['schema']=='rea-hosted-publication-workflow-attempt/v1' and workflow['sourceCommit']==git['sourceCommit'] and workflow['runId']==RUN and workflow['runAttempt']==ATTEMPT and workflow['runnerEnvironment']=='github-hosted' and workflow['checkoutOutcome']==workflow['verificationOutcome']=='success','Actual workflow outcome/identity')
 need(workflow['published'] is False and workflow['historicalReceiptsRewritten'] is False and workflow['fullDevelopmentSuiteAcceptance'] is False and workflow['fullParity'] is False,'Workflow does not publish/claim behavioral acceptance')
 need(attempt['applicationTestsExecuted']==0 and attempt['originalExecutions']==0 and attempt['historicalReceiptsRewritten'] is False and attempt['fullDevelopmentSuiteAcceptance'] is False and attempt['fullParity'] is False and attempt['superiority'] is False,'Publication scope only')
 publication=attempt['publicationResult'];need(publication['status']=='passed' and publication['payloadFiles']==len(payload) and publication['syntaxChecks']==outputs[0][0]['javascript_syntax_checks'] and type(publication['syntaxChecks']) is int and publication['syntaxChecks']>0 and publication['credentialPatternScan'] is True and publication['rootLinksResolve'] is True and publication['historical937Tests']==937 and publication['finiteHosted282Tests']==282,'Observed syntax count and original publication gates; no forecasted count')
 result['publicationAcceptance']=True;result['controls']={'status':'passed','checks':306};result['payloadIdentity']=payload_id;result['rawOwnedPhaseClocks']=clocks
 return {'publicationAccepted':True,'controlsPassed':306,'rootPhasesPassed':2,'actualSyntaxChecks':publication['syntaxChecks'],'artifactRoles':95,'legacyHistoricalSources':56,'currentProofSources':60,'fixedCurrentTooling':12,'separateCollectorSelf':1,'allCapturedSourcesGitAuthenticated':True,'fullPayloadBytesRehashedLocally':False,'applicationBehaviorAccepted':False}
stage('Exact95All306TwoRootPhasesAndPayloadPublication',publication_pass)
if attempt is None: result['evidenceState']='No producer receipt; complete uploaded bytes retained without source or publication acceptance.'
elif attempt['status']!='passed': result['evidenceState']='Actual '+attempt['status']+' producer attempt preserved. Partial source qualification does not promote it to a publication pass.'
if len(members)!=95: result['artifactCompleteness']='Not the exact95-role passed contract; all actual uploaded bytes are still retained.'
report=folder/'local-notes36-publication-backup-verification.json'
with report.open('x',encoding='utf-8',newline='') as stream: stream.write(json.dumps(result,indent=2,ensure_ascii=False)+'\n')
need(parsed(report.read_bytes())==result,'Readable terminal report')
print(json.dumps({k:v for k,v in result.items() if k not in ('files','attempt','currentNotes36Envelope','historicalNotes32Envelope','currentTooling12Envelope')},ensure_ascii=False))
