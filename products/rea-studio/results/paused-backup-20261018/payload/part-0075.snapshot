    {
      "id": "grafana.candidate.9c41abff8d5a75dfeb1f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can mark one data source as the **Default** by toggling the option on its configuration page. The default data source is pre-selected when you create new panels, navigate to Explore, or create alert rules.",
      "headingPath": [
