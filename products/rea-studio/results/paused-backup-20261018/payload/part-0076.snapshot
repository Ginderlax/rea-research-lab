    {
      "id": "grafana.candidate.8120222a11e10b50d675",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana ships with the Google Cloud Monitoring data source preinstalled in both Grafana OSS and Grafana Enterprise, so there's nothing for you to install. For details on how the standalone plugin updates, refer to [Plugin updates](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/google-cloud-monitoring/#plugin-updates).",
      "headingPath": [
        "Configure the Google Cloud Monitoring data source",
        "Before you begin"
      ],
      "source": {
        "path": "docs/sources/datasources/google-cloud-monitoring/configure/index.md",
