    {
      "id": "grafana.candidate.22f2ee8ba2b3ee2cfb09",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grizzly is a command line tool that streamlines working with Grafana resources. Use it to migrate most of the content in your Grafana instance. Follow these steps in your terminal to install Grizzly. If you need to change the os or the architecture, Refer to the Grizzly [releases](https://github.com/grafana/grizzly/releases) and use the binary according to your needs.",
      "headingPath": [
        "Migrate from Grafana OSS/Enterprise to Grafana Cloud manually",
        "Migrate Grafana resources",
        "Migrate dashboards, folders, data sources, library panels, and alert rules using Grizzly"
      ],
      "source": {
        "path": "docs/sources/administration/migration-guide/manually-migrate-to-grafana-cloud.md",
