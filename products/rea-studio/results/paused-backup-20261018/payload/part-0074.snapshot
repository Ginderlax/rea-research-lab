    },
    {
      "id": "grafana.candidate.dc02b7df1786157ab555",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To link to a new silence page for an external Alertmanager, add a `alertmanager` query parameter with the Alertmanager data source name.",
      "headingPath": [
