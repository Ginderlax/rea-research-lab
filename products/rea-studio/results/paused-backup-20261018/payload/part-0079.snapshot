    {
      "id": "grafana.candidate.131a1838225779e23c76",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Cell options allow you to control how data is displayed in a table. The options are differ based on the cell type that you select and are outlined within the descriptions of each cell type. The following table provides short descriptions for each cell type and links to a longer description and the cell type options.",
      "headingPath": [
        "Table",
        "Configuration options",
        "Cell options"
      ],
