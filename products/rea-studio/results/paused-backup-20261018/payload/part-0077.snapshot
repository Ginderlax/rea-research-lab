    },
    {
      "id": "grafana.candidate.00fda6fdbb5a1f7284af",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can override variables on Linux machines with:",
      "headingPath": [
        "Configure Grafana",
        "Override configuration with environment variables"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
