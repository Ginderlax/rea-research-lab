    {
      "id": "grafana.candidate.9d288abac1148dca09b6",
      "syntaxRole": "table-row",
      "sourceText": "| `!~`     | Select alerts where the label does not match the regular expression. |",
      "headingPath": [
        "Configure inhibition rules",
        "Inhibition rule schema",
        "Matcher format"
      ],
      "source": {
        "path": "docs/sources/alerting/configure-notifications/inhibition-rules.md",
        "gitBlobSha": "3030f57a20ca73738b38302be6ed815ab5155afb",
