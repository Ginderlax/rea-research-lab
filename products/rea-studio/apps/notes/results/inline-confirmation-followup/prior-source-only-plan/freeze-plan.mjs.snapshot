let files=await walk(root);const selfMap={schema:'rea-notes-inline-plan-self-public-map/v1',sourceRoot:'work/notes-inline-publication-plan-next',records:files.map(r=>({sourcePath:r.path,...r,publicPath:safeRelative(PUBLIC_PREFIX+'publication-plan/frozen/'+r.path+'.snapshot',true)})),wholeInputTreesClaim:false,newNativeCarriers:0};await write('plan-self-public-map.json',selfMap);files=await walk(root);const manifest={schema:'rea-notes-inline-publication-plan-freeze/v1',at:new Date().toISOString(),files:files.length,bytes:files.reduce((n,r)=>n+r.bytes,0),strict:true,inventory:Object.fromEntries(files.map(r=>[r.path,{bytes:r.bytes,sha256:r.sha256}])),selfExcluded:true,validationSha256:identity(await fs.readFile(path.join(root,'validation.json'))).sha256};await write('freeze-manifest.json',manifest);for(const r of files)same(identity(await fs.readFile(path.join(root,r.path))),r);console.log(JSON.stringify({files:manifest.files,bytes:manifest.bytes,manifest:identity(await fs.readFile(path.join(root,'freeze-manifest.json'))),validation:identity(await fs.readFile(path.join(root,'validation.json'))),module:identity(await fs.readFile(path.join(root,'notes-inline-provenance.mjs'))),live:identity(await fs.readFile(path.join(root,'live-copy-list.json'))),publicMap:identity(await fs.readFile(path.join(root,'public-preservation-map.json'))),counts},null,2));
