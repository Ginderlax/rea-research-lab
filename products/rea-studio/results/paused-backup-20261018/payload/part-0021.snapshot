"""Independent actual hosted evidence/portable backup audit; product code is never executed."""
from pathlib import Path
import hashlib,io,json,re,struct,subprocess,tarfile,zipfile,zlib
B=Path(__file__).resolve().parent.parent;W=B/'work';R=B/'outputs/rea-research-lab'
D=W/'cloud-verification-backups/run-38930449217'
HEAD='89e00f66c2249a50c701404accede7565094304e';RUN='38930449217';P='products/rea-studio/'
def read(p):assert p.is_file() and not p.is_symlink(),str(p);return p.read_bytes()
def ident(b):return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def pin(b,r):assert ident(b)=={k:r[k]for k in('bytes','sha256')},r.get('path')
def load(p):return json.loads(read(p).decode('utf-8-sig'))
def git(*args):return subprocess.run(['git',*args],cwd=R,check=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE).stdout
def jsjson(x):return json.dumps(x,ensure_ascii=False,separators=(',',':')).encode()
summary=load(D/'new-todo-r5-collection-summary-v2.json')
assert summary['runId']==RUN and summary['headSHA']==HEAD and summary['runStatus']=='completed' and summary['runConclusion']=='success'
assert summary['terminalCompleteCollection'] and summary['bothRecordedContractsPassed']
cp={}
for x in summary['controlPlane']:pin(read(Path(x['path'])),x);cp[x['kind']]=load(Path(x['path']))
assert set(cp)=={'run','jobs','artifacts'}
assert cp['run']['id']==int(RUN) and cp['run']['head_sha']==HEAD and cp['run']['conclusion']=='success' and cp['run']['run_attempt']==1
assert cp['jobs']['total_count']==len(cp['jobs']['jobs'])==2
assert cp['artifacts']['total_count']==len(cp['artifacts']['artifacts'])==2
jobids={'finite':117072778435,'browser':117072778039}
for j in summary['jobs']:
    assert j['jobId']==jobids[j['role']] and j['status']=='completed' and j['conclusion']=='success'
    raw=next(x for x in cp['jobs']['jobs']if x['id']==j['jobId']);assert raw['conclusion']=='success' and raw['status']=='completed'
    pin(read(Path(j['rawJobLog']['path'])),j['rawJobLog'])
expected_art={'finite':(12058676606,2026036,'1bb0266814953261edf6e84939dc02d096ff501f65b5a3eef55d53488b373382',538),'browser':(12057774573,2424187,'d6c3f7d6d6f7a7841feeef211fe8af52b9286be2a60fb8648f3712e72cf51a8b',570)}
tree={}
for row in git('ls-tree','-r','-z',HEAD).split(b'\0'):
    if row:
        header,p=row.split(b'\t');mode,kind,oid=header.split();assert kind==b'blob' and mode in(b'100644',b'100755');tree[p.decode()]=oid.decode()
bundle=load(R/(P+'experiments/notes-new-todo/bundle.json'))
trans={r['path']:r for r in bundle['transitions']}
eligible={p:r for p,r in trans.items()if re.search(r'\.(mjs|json|html|css|ps1)$',p)}
assert len(trans)==7 and len(eligible)==6
all_data={};backups=[]
for a in summary['artifacts']:
    role=a['role'];aid,size,digest,count=expected_art[role];assert a['artifactId']==aid
    outer=read(Path(a['path']));assert ident(outer)=={'bytes':size,'sha256':digest}
    rawapi=next(x for x in cp['artifacts']['artifacts']if x['id']==aid)
    assert rawapi['digest']=='sha256:'+digest and rawapi['size_in_bytes']==size and rawapi['workflow_run']['id']==int(RUN) and rawapi['workflow_run']['head_sha']==HEAD
    assert not rawapi['expired']
    v=load(Path(a['verification']));assert v['recordedContractPassed'] and v['allCRCAndBytesReadable'] and v['evidenceConsistencyErrors']==[]
    d=Path(v['readableEvidence']);files={r['path']:r for r in v['files']};assert len(files)==count==a['readableFiles']
    with zipfile.ZipFile(io.BytesIO(outer))as oz:
        assert len(oz.infolist())==1;inner=oz.read(oz.namelist()[0])
    data={}
    with zipfile.ZipFile(io.BytesIO(inner))as iz:
        infos=[x for x in iz.infolist()if not x.is_dir()];assert len(infos)==count
        assert {x.filename for x in infos}==set(files)
        for info in infos:
            raw=iz.read(info);row=files[info.filename];assert raw==read(d/info.filename);pin(raw,row);assert f'{zlib.crc32(raw)&0xffffffff:08x}'==row['zipCRC32'];data[info.filename]=raw
    all_data[role]=data
    at=json.loads(data['new-todo-'+role+'-attempt.json'])
    assert at==v['attempt'] and at['status']=='passed' and at['sourceCommit']==HEAD and at['execution']['GITHUB_RUN_ID']==RUN and at['execution']['GITHUB_RUN_ATTEMPT']=='1'
    assert at['sourceOverlay'] and not at['productionInstalled'] and not at['historicalReceiptsRebound'] and at['sourceStable']
    assert at['exactTargets']==7 and at['eligibleTargets']==6 and at['composedNotesFiles']==36
    assert at['applicationSourcesChanged'] is False # means unchanged DURING execution; seven overlays already disclosed.
    assert at['sourceFiles']==393
    census=json.loads(data['composition-source-after.json']);before=json.loads(data['composition-source-before.json'])
    assert len(census)==393 and len(before)==389 and len({r['path']for r in census})==393
    prefix_roots=('apps/','lib/','public/','browser-tests/','scripts/','tests/')
    git_active={p[len(P):]for p in tree if p.startswith(P) and (p[len(P):].startswith(prefix_roots) or p[len(P):]in('server.mjs','catalog.mjs','package.json')) and not set(p[len(P):].split('/'))&{'node_modules','.local','results'} and re.search(r'\.(mjs|json|html|css|ps1)$',p)}
    assert {r['path']for r in before}==git_active
    assert {r['path']for r in census}==git_active|{p[len(P):]for p,r in eligible.items()if r['before']is None}
    for row in census:
        name=P+row['path'];raw=data['active-source/'+row['path']+'.snapshot'];pin(raw,row)
        if name in eligible:pin(raw,eligible[name]['after'])
        else:assert hashlib.sha1(b'blob '+str(len(raw)).encode()+b'\0'+raw).hexdigest()==tree[name]
    composition=json.loads(data['notes-new-todo-composition.json'])
    assert composition['baselineSources']==bundle['baselineNotesSources'] and composition['composedSources']==bundle['composedNotesSources']
    assert composition['proofReadFiles']==60 and composition['proofFileLimit']==64 and composition['proofByteLimit']==8388608
    assert len(composition['currentSourceInputs'])==60
    for row in composition['currentSourceInputs']:pin(data['composition-source/'+row['path']+'.snapshot'],row)
    assert len([n for n in data if n.startswith('composition-baseline-source/')])==56
    assert len([n for n in data if n.startswith('composition-source/')])==60
    assert len([n for n in data if n.startswith('tooling-source/')])==12
    assert len(at['tooling']['paths'])==12
    for row in at['tooling']['paths']:
        raw=data['tooling-source/'+row['path']+'.snapshot'];pin(raw,row);assert hashlib.sha1(b'blob '+str(len(raw)).encode()+b'\0'+raw).hexdigest()==tree[row['path']]
    post=json.loads(data['notes-new-todo-postrun-source-check.json'])
    assert post['status']=='source-verified' and post['sourceStable'] and post['sourceCommit']==HEAD and post['compositionReceipt']==ident(data['notes-new-todo-composition.json'])
    assert post['currentSources']==bundle['composedNotesSources'] and post['sourceAuthentication']=={'activeSixDirectorySources':393,'eligibleNotesSources':34,'exactOverlayAfterimages':6,'allOtherGitBlobs':387,'separatelyPinnedReadme':1,'sourceOverlay':True}
    if role=='browser':
        bp=json.loads(data['new-todo-browser-postrun-source-check.json']);assert bp['status']=='source-verified' and bp['sourceStable'] and bp['priorStatus']=='passed' and bp['sourceAuthentication']==post['sourceAuthentication']
    backups.append({'role':role,'artifactId':aid,'bytes':size,'sha256':digest,'readableMembers':count,'sourceAliasMembers':521,'nonsourceMembers':count-521,'sourceAuthentication':post['sourceAuthentication']})
finite=all_data['finite'];tap=finite['finite-stdout.txt'].decode();assert finite['finite-stderr.txt']==b''
passed=re.findall(r'^ok (\d+) - (.+)$',tap,re.M);assert len(passed)==111 and [int(n)for n,_ in passed]==list(range(1,112))
assert not re.search(r'^not ok ',tap,re.M)
for k,val in [('tests',111),('pass',111),('fail',0),('cancelled',0),('skipped',0),('todo',0)]:assert re.search(r'^# '+k+' '+str(val)+r'\s*$',tap,re.M)
for name in bundle['oldNamedGroupsRequired']+bundle['newNamedGroupsRequired']:assert name in {name for _,name in passed}
regressions=[{'group':n,'name':dict(passed)[str(n)]}for n in(23,57,59,62)]
fo=json.loads(finite['new-todo-finite-observations.json']);assert fo['summary']=={'tests':111,'pass':111,'fail':0,'cancelled':0,'skipped':0,'todo':0}
assert fo['fixedFiles']==bundle['fixedTests'] and fo['oldNamedGroupsObserved']==23 and fo['newNamedGroupsObserved']==19
assert fo['separateComparisonCounts']=={'existingConversionAndCompletion':20,'newParentAndType':4,'newDesktopCommandArguments':2,'addedToTestGroupCounts':False}
for k in('originalFullApplicationExecutions','originalDatabaseExecutions','originalGuiExecutions'):assert fo[k]==0
fa=json.loads(finite['new-todo-finite-attempt.json']);assert fa['command']==fa['children'][0]['command'] and fa['children'][0]['exitCode']==0 and fa['children'][0]['closeObserved'] and fa['productTests']==111
assert fa['command'][1:4]==['--test','--test-reporter=tap','--test-concurrency=1'] and fa['command'][4:]==bundle['fixedTests']
browser=all_data['browser'];cases=[json.loads(raw)for n,raw in browser.items()if n.startswith('case-')and n.endswith('.json')]
roster=load(R/(P+'browser-tests/notes-new-todo-roster.json'));assert len(cases)==8 and {c['title']for c in cases}==set(roster)
bykind={};faults=[];downloads=[];case_obs=[]
for c in cases:
    assert c['statusAtFixtureClose']=='passed' and c['retry']==0 and c['realBrowser'] and c['actualHTTP'] and c['serverCloseObserved'] and c['errors']==[] and c['auxiliaryErrors']==[]
    assert c['programmaticDisabledControlProbes']==0 and c['originalFullApplicationExecutions']==0
    td=c['teardown'];assert td['stage']=='completed' and td['heldRoutesFinished'] and td['drained'] and td['contextClosed'] and td['serverClosed'] and td['screenshotSaved'] and td['pendingOwnedRequests']==0 and not td['activeOwnedIOFault']
    for row in c['observations']:
        bykind[row['kind']]=row
        if row['kind']=='owned-synthetic-disk-record':pin(browser[row['path']],row)
        if row['kind']=='real-browser-file-download':pin(browser[row['path']],row['observed']);downloads.append(row)
    faults+=c['faults'];case_obs.append({'title':c['title'],'status':'passed','observations':c['observations'],'cleanupPassed':True})
    for err in c['expectedHttpFailures']:
        assert err['observed'] and any(r['path']==err['path']and r['status']==err['status']for r in c['responses'])
assert len(faults)==2 and len(downloads)==2
for f in faults:
    assert f['actualStatus']==400 and f['actualError']=='EISDIR: illegal operation on a directory, read' and not f['handlerMocked'] and not f['responseRewritten']
    assert f['originalCommittedState']==f['restoredState'] and f['restoreCompletedBeforeResponseDelivery']
    steps={x['name']:x['atUtc']for x in f['steps']};assert len(steps)==10
    assert steps['all-other-owned-requests-and-attachment-response-drained']<=steps['fault-ownership-entered']<=steps['unchanged-host-returned-real-filesystem400']<=steps['restored-exact-original-bytes-verified']<=steps['unchanged-actual400-delivered-after-restoration']
