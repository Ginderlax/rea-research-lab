import assert from 'node:assert/strict';
import { readFileSync, writeFileSync, readdirSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';
import { createHash } from 'node:crypto';
import { spawnSync } from 'node:child_process';
const root=dirname(fileURLToPath(import.meta.url));
const digest=bytes=>createHash('sha256').update(bytes).digest('hex');
const walk=directory=>readdirSync(directory,{withFileTypes:true}).flatMap(item=>item.isDirectory()?walk(join(directory,item.name)):[join(directory,item.name)]);
const names=[...walk(join(root,'apps')),...walk(join(root,'lib')),...walk(join(root,'references')),...['compression.test.mjs','verify-stage.mjs','source-provenance.json'].map(name=>join(root,name))].sort();
const fingerprint=file=>{const bytes=readFileSync(file);return{path:file.slice(root.length+1).replaceAll('\\','/'),bytes:bytes.length,sha256:digest(bytes)}};
const before=names.map(fingerprint);
const run=spawnSync(process.execPath,['--test','--test-reporter=tap','--test-concurrency=1','compression.test.mjs'],{cwd:root,encoding:'utf8',timeout:120000,maxBuffer:4*1024*1024});
writeFileSync(join(root,'formal-test-output.tap.txt'),run.stdout??'');
assert.equal(run.status,0,run.stderr); assert.deepEqual(names.map(fingerprint),before);
const summary=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo','duration_ms'].map(label=>{const match=new RegExp('^# '+label+' (\\d+(?:\\.\\d+)?)$','m').exec(run.stdout);assert.ok(match,label);return[label,Number(match[1])]}));
assert.equal(summary.tests,summary.pass);assert.equal(summary.fail+summary.cancelled+summary.skipped+summary.todo,0);
const record={schema:'rea-restic-compression-stage-validation/v1',checkedAtUtc:new Date().toISOString(),summary,sourceBytesStableAcrossRun:true,fingerprints:before,rawEvidence:{path:'formal-test-output.tap.txt',sha256:digest(Buffer.from(run.stdout))},scope:'Staged source-assisted native v2 compressed blob/tree/metadata writing; authenticated complete original CLI checks and exact-byte restores. Not integrated into the application.',original:{version:'0.19.1',sourceCommit:'6aa3a516ce654808a1f28f9fa21e9b7c8e6e90bf',cliCases:6,modes:['off','fastest','auto','better','max'],fixtureFilesPerCase:4},compressionPolicy:'Node/libzstd levels 1/3/7/19 with 512KiB window and disabled CRC; distinct encoder policy, not klauspost bitstream/ratio/performance parity.',fullFeatureParity:false,universalSuperiority:false};
writeFileSync(join(root,'draft-validation.json'),JSON.stringify(record,null,2)+'\n');console.log(JSON.stringify({summary,fingerprints:before.length}));
