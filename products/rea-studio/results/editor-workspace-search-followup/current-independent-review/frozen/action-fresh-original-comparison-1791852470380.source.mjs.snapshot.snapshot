import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import {spawn} from 'node:child_process';import assert from 'node:assert/strict';
import {searchWorkspace} from '../editor-search-path-fix-next/products/rea-studio/apps/editor/workspace-search.mjs';import {createWorkspace} from '../editor-search-path-fix-next/products/rea-studio/lib/storage.mjs';
const here=import.meta.dirname,sha=bytes=>createHash('sha256').update(bytes).digest('hex'),provenance=JSON.parse(await fs.readFile(path.resolve(here,'../editor-search-independent-review/provenance-validation.corrected.json'))),engine=provenance.engine.path,engineBytes=await fs.readFile(engine);assert.equal(sha(engineBytes),provenance.engine.sha256);
const source=path.resolve(here,'../editor-search-path-fix-next'),manifestBytes=await fs.readFile(path.join(source,'freeze-manifest.json')),manifest=JSON.parse(manifestBytes);assert.equal(sha(manifestBytes),'d071d370be094646a4738de79adadca9c28d794de53dfb940604f5d52d056edf');for(const [name,row]of Object.entries(manifest.inventory)){const bytes=await fs.readFile(path.join(source,name));assert.deepEqual({bytes:bytes.length,sha256:sha(bytes)},row);}
const run=path.join(here,'runs','fresh-original-'+Date.now()),workspace=await createWorkspace(path.join(run,'workspace')),files={'unicode.txt':'\ufeff𐐀 𐐨; I İ ı i; ß ẞ; ſ S s\r\né É É é; 👩‍🔬\r\n\ufeffinternalBOM\n','literal.txt':'[a-z]+(x)?$^{}| a\\b\\c -- -x\nSAME same samesamesame ç Ç\n','nested/space name.txt':'old\r\n𐐨same👩‍🔬\n','.git/hidden.txt':'same','nested/.git/hidden.txt':'same','nested/node_modules/hidden.txt':'same','.rea-save-temporary':'same','nested/.rea-save-folder/hidden.txt':'same'};
let seed=0x712ace05;const random=()=>{seed=(Math.imul(seed,1103515245)+12345)>>>0;return seed;},symbols=['x','Y','𐐀','𐐨','İ','ı','ß','ẞ','ſ','s','é','é','[',']','-','\\','👩‍🔬'];for(let i=0;i<4;i++)files['generated/'+i+'.txt']=Array.from({length:120},()=>symbols[random()%symbols.length]).join('')+'\n';for(const [name,value]of Object.entries(files)){const file=workspace.resolve(name);await fs.mkdir(path.dirname(file),{recursive:true});await fs.writeFile(file,value,{flag:'wx'});}
const inputs=[{query:'𐐀',matchCase:false},{query:'i',matchCase:false},{query:'ß',matchCase:false},{query:'ſ',matchCase:false},{query:'é',matchCase:false},{query:'\ufeff'},{query:'\u200d'},{query:'[a-z]+(x)?$^{}|'},{query:'a\\b\\c'},{query:'--'},{query:'same'},{query:'ç',matchCase:false}];await fs.writeFile(path.join(run,'inputs.json'),JSON.stringify({seed:'0x712ace05',files,inputs},null,2)+'\n',{flag:'wx'});
const children=[],observations=[];
async function invoke(args,index){const start=new Date().toISOString(),out=[],err=[];let bytes=0,failure=null;const outcome=await new Promise(resolve=>{const child=spawn(engine,args,{cwd:workspace.root,windowsHide:true,shell:false,stdio:['ignore','pipe','pipe']}),timer=setTimeout(()=>{failure??='30s deadline';child.kill();},30000);for(const [stream,parts]of [[child.stdout,out],[child.stderr,err]])stream.on('data',part=>{bytes+=part.length;if(bytes>1048576){failure??='1MiB combined output limit';child.kill();}else parts.push(part);});child.on('error',error=>failure??=error.message);child.on('close',(code,signal)=>{clearTimeout(timer);resolve({code,signal});});});const stdout=Buffer.concat(out),stderr=Buffer.concat(err),stem=String(index).padStart(2,'0');await fs.writeFile(path.join(run,stem+'.stdout.txt'),stdout,{flag:'wx'});await fs.writeFile(path.join(run,stem+'.stderr.txt'),stderr,{flag:'wx'});children.push({args,start,end:new Date().toISOString(),...outcome,failure,stdout:{path:stem+'.stdout.txt',bytes:stdout.length,sha256:sha(stdout)},stderr:{path:stem+'.stderr.txt',bytes:stderr.length,sha256:sha(stderr)}});await fs.writeFile(path.join(run,'children.json'),JSON.stringify(children,null,2)+'\n');assert.equal(failure,null);assert.equal(outcome.signal,null);return{...outcome,stdout,stderr};}
let failure=null;try{const version=await invoke(['--version'],0);assert.equal(version.code,0);assert.match(version.stdout.toString(),/ripgrep 15\.0\.0.*3a612f88b8/);for(let index=0;index<inputs.length;index++){const input=inputs[index],actualResult=await searchWorkspace(workspace,input),original=await invoke(['--no-config','--json','--fixed-strings',input.matchCase===false?'--ignore-case':'--case-sensitive','--no-ignore','--hidden','--glob','!**/.git/**','--glob','!**/node_modules/**','--glob','!**/.rea-save-*','--glob','!**/.rea-save-*/**','--',input.query,'.'],index+1);assert.ok([0,1].includes(original.code));assert.equal(original.stderr.length,0);const expected=[];for(const line of original.stdout.toString().split('\n').filter(Boolean)){const event=JSON.parse(line);if(event.type!=='match')continue;const data=event.data,name=data.path.text.replaceAll('\\','/').replace(/^\.\//,''),saved=await fs.readFile(workspace.resolve(name)),raw=Buffer.from(new TextDecoder('utf-8',{fatal:true}).decode(saved)),decode=bytes=>new TextDecoder('utf-8',{fatal:true,ignoreBOM:true}).decode(bytes),lineStart=decode(raw.subarray(0,data.absolute_offset)).length;for(const hit of data.submatches){const start=decode(raw.subarray(0,data.absolute_offset+hit.start)).length,end=decode(raw.subarray(0,data.absolute_offset+hit.end)).length;expected.push({path:name,line:data.line_number,column:start-lineStart+1,endColumn:end-lineStart+1,start,end});}}const project=({path,line,column,endColumn,start,end})=>({path,line,column,endColumn,start,end}),key=row=>JSON.stringify(Object.values(row)),sort=rows=>rows.sort((a,b)=>key(a).localeCompare(key(b))),actual=sort(actualResult.matches.map(project));sort(expected);observations.push({index,input,actual,expected,truncated:actualResult.truncated});assert.equal(actualResult.truncated,false);assert.deepEqual(actual,expected,'Fresh bundled-engine group'+index);}}
catch(error){failure=error.stack||String(error);}
for(const [name,value]of Object.entries(files))assert.equal(await fs.readFile(workspace.resolve(name),'utf8'),value);assert.ok((await fs.readFile(engine)).equals(engineBytes));for(const [name,row]of Object.entries(manifest.inventory)){const bytes=await fs.readFile(path.join(source,name));assert.deepEqual({bytes:bytes.length,sha256:sha(bytes)},row);}
const receipt={schema:'rea-independent-editor-fresh-bundled-engine-comparison/v1',checkedAt:new Date().toISOString(),run,status:failure?'failed':'passed',failure,engine:{path:engine,sha256:sha(engineBytes)},fixedCandidateManifestSHA256:sha(manifestBytes),freshSeed:'0x712ace05',inputsReusedFromPriorPreparedButFailedCollector:true,priorCompleteQueryGroups:0,leadingBOMByteOffsetsConvertedThroughCanonicalDecodedContent:true,freshInputGroups:12,completedGroups:observations.filter(row=>JSON.stringify(row.actual)===JSON.stringify(row.expected)).length,observedPositions:observations.reduce((sum,row)=>sum+row.actual.length,0),actualBoundedOriginalEngineInvocations:children.length,originalWorkbenchOrGUIExecutions:0,sourceBeforeAfterAuthenticated:true,engineBeforeAfterIdentical:true,syntheticFilesUnchanged:true,children,observations,scope:'Direct released bundled ripgrep on twelve fresh ordinary valid UTF-8 literal queries with explicit common exclusions; UTF-16/global offsets from original byte offsets. Not original workbench/search-service or universal parity.',fullParity:false,universalSuperiority:false,newTimingMemoryOrProfilerRuns:0};await fs.writeFile(path.join(here,'fresh-original-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:receipt.status,freshGroups:receipt.completedGroups,positions:receipt.observedPositions,originalInvocations:children.length,failure}));if(failure)process.exitCode=1;
