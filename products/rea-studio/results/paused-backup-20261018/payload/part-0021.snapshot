// Source authoring into a work-only stage. No product imports or execution.
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import {createHash} from 'node:crypto';
import {spawnSync} from 'node:child_process';
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab'),stage=path.join(work,'notes-new-todo-r5-current-docs-next');
const record='products/rea-studio/results/notes-new-todo-r5-cloud-pass-20261016/preservation-manifest.json';
const pin=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});
const evidence=fs.readFileSync(path.join(work,'notes-new-todo-r5-cloud-pass-public-20261016-next/public-candidate',record));
assert.deepEqual(pin(evidence),{bytes:326552,sha256:'99522b3c32cfd28d9898549e7eebc719c4403d589c3cad64ee25babfd9813d2d'});
const m=JSON.parse(evidence);assert.equal(m.runId,'38930449217');assert.equal(m.sourceCommit,'89e00f66c2249a50c701404accede7565094304e');assert.equal(m.finite111Acceptance,true);assert.equal(m.realBrowser8Acceptance,true);assert.equal(m.productionInstalled,false);assert.equal(m.readableUploadedFiles,1108);
const g=spawnSync('git',['-C',lab,'rev-parse','HEAD'],{shell:false,windowsHide:true,encoding:'utf8'});assert.equal(g.status,0);assert.equal(g.stdout.trim(),m.sourceCommit);assert(!fs.existsSync(stage));
const names=['README.md','CLOUD-VERIFICATION.md','products/rea-studio/STATUS.json','products/rea-studio/experiments/notes-new-todo/README.md'];
const before=new Map(names.map(n=>[n,fs.readFileSync(path.join(lab,n))])),after=new Map();
const newline=b=>b.includes(Buffer.from('\r\n'))?'\r\n':'\n';
let text=before.get(names[0]).toString('utf8');const marker='Complete-product parity and superiority remain unproven.';assert.equal(text.split(marker).length,2);
const paragraph='The separately composed [New To-do experiment]('+record+') now passes **111/111 selected checks and eight real Chromium scenarios** in run `38930449217`, on source `89e00f6`. It adds a direct task draft and first-save flow, including duplicate-save prevention, newer-draft retention and genuine refresh-failure recovery. All 1,108 uploaded files are recoverable from two complete public ZIPs and readable local backups. The earlier four finite failures and one browser failure remain documented with exact sources; the correction keeps every older check. This is accepted experimental evidence. Installing the 36-file candidate into the normal Notes application requires a separate source-proof transition and fresh installed checks. The installed 32-file application and its 92/8 evidence remain unchanged; counts are never added together.';
text=text.replace(marker,marker+newline(before.get(names[0])).repeat(2)+paragraph);after.set(names[0],Buffer.from(text));
const cloudSection=`## Corrected New To-do experimental acceptance, 16 October 2026

The [complete experimental evidence](${record}) records **111/111 groups across exactly 21 files** and **8/8 real Chromium cases**, with zero failures, skips or retries, in [run38930449217](https://github.com/Ginderlax/rea-research-lab/actions/runs/38930449217) on exact committed source89e00f66c2249a50c701404accede7565094304e. All23 required older names and19 new names occur once. The current installed32 Notes files remain unchanged: seven explicit targets are composed only in the hosted checkout, resulting in36 Notes files and six eligible overlays. The393-file source census and every387 other Git blob remain exact. The56-path baseline proof,60-path composed proof,12 tooling inputs and independent always-run composer/browser postchecks pass.

Browser checks use actual enabled controls and an owned real host. Three successful responses and one genuine failed response are held. Two list400s result from temporary synthetic I/O faults inside owned data; original file bytes are restored and verified before delivery of the unchanged real response. Empty-title400 and explicit retry, native duplicate clicks, newer typing, editor ownership, disposal, two native downloads, eight PNG/state/cleanup records and all seven prior JEX raw records plus the five-byte resource pass. A real ordinary second Save establishes a revision2/history1/metadataEdited:true baseline; its complete JSON identity remains equal across the unrelated new task. Invalid requests retain every persisted byte.

Original comparisons are narrow and separate:20 existing conversion/completion helper observations, four parent/type helper observations over declared field adapters, and two delegated desktop-command argument observations. They are not added to111. The full Joplin application, database, GUI and provisional-save lifecycle are not executed. The candidate intentionally keeps a draft unsaved until explicit Save; the original desktop command uses provisional persistence. Raw clocks retain their original provenance and are not performance measurements.

Both exact public outer ZIPs retain all1,108 uploaded members:538 finite and570 browser files. All66 nonsource uploaded roles are also retained directly;1,042 source aliases remain recoverable inside the complete ZIPs with identities listed. Independent source, actual-behavior and final byte reviews verify the portable evidence. The [first failed epoch](products/rea-studio/results/notes-new-todo-first-failure-20261016/preservation-manifest.json) remains unchanged:107 of111 finite groups passed and four failed; seven of eight browser cases passed and one failed. All four previously failed finite checks now pass without removing an older test or dropping a comparison field.

The same89e installed-source control separately passes92/92 plus eight browser cases, with951 readable uploaded files. The current implemented full-suite baseline remains1,100 checks; the separate b635 repeat passes1,100/1,100 with431 readable files. These counts belong to their exact source intervals and are not combined with the experiment. Publication run38930461083 separately passes208 controls, both root phases and963 syntax checks on its stable28,711-file/1,358,239,974-byte payload, with92 readable files and56 decoded Notes proof sources. Adding this public evidence and documentation creates a new payload requiring its own publication check before importing only its two derived metadata files.

This milestone accepts the bounded experiment. Production installation, every documented feature of all ten products, complete original compatibility, security acceptance and comparative superiority remain open.
`;
const cloudEol=newline(before.get(names[1]));after.set(names[1],Buffer.concat([before.get(names[1]),Buffer.from(cloudEol+cloudSection.replaceAll('\n',cloudEol))]));
const s=JSON.parse(before.get(names[2]));s.phase='new-todo-experiment111-8-accepted-current32-installation-open';
s.next_required_milestone='Publish verified New To-do experimental evidence, then prepare a separately reviewed 36-source installation/proof transition replacing both current32-based workflow contracts with equally strict no-overlay current36 checks. Preserve all old32/52/56 source and receipt epochs. Obtain fresh installed111/8 and full-suite superset results. The final preservation/document payload needs fresh publication verification before exact two-file metadata import. Continue every remaining documented feature and whole-product comparison.';
s.implemented_milestone='Current installed Notes task editing passes92/92 and8browser cases; the full implemented baseline passes1100/1100. The separately composed corrected New To-do experiment passes111/111 across21files and8/8 real Chromium cases, with complete1108-file readable local backups and exact public ZIPs. Earlier107/111 and7/8 failed-epoch results remain immutable. The36-file candidate is not installed. Publication on89e passes208controls/bothphases/963syntax for its exact assessed payload; new preservation files require fresh validation. All ten complete replacement and superiority gates remain open.';
s.notes_new_todo_experimental_acceptance={record:record.replace('products/rea-studio/',''),runId:38930449217,sourceCommit:m.sourceCommit,status:'passed-fixed-experimental-source-contracts',finiteJobId:117072778435,browserJobId:117072778039,finiteGroups:111,finiteFiles:21,oldRequiredNames:23,newRequiredNames:19,comparisonCountsSeparate:[20,4,2],browserCases:8,successfulRealResponseHolds:3,failedRealResponseHolds:1,genuineOwnedIOFaultList400s:2,genuineEmptyTitle400:1,downloads:2,PNGs:8,completeOwnedCleanups:8,baselineNotesFiles:32,composedNotesFiles:36,explicitSourceOverlays:7,eligibleSourceOverlays:6,sourceCensusFiles:393,otherGitBlobs:387,proofReadPaths:60,toolingReadPaths:12,finiteReadableFiles:538,browserReadableFiles:570,allUploadedFilesPubliclyRecoverable:1108,finiteArtifactId:12058676606,finiteArtifactSHA256:'1bb0266814953261edf6e84939dc02d096ff501f65b5a3eef55d53488b373382',browserArtifactId:12057774573,browserArtifactSHA256:'d6c3f7d6d6f7a7841feeef211fe8af52b9286be2a60fb8648f3712e72cf51a8b',canonicalRawNoteBaseline:'real ordinary second Save/revision2/history1/metadataEdited:true; whole JSON identity preserved',originalFullApplicationExecutions:0,originalDatabaseExecutions:0,originalGuiExecutions:0,productionInstalled:false,historicalReceiptsRebound:false,fullFeatureParity:false,superiority:false};
const statusEol=newline(before.get(names[2]));after.set(names[2],Buffer.from((JSON.stringify(s,null,2)+'\n').replaceAll('\n',statusEol)));
let experiment=before.get(names[3]).toString('utf8');const old='This R5 experiment has not executed.';assert.equal(experiment.split(old).length,2);experiment=experiment.replace(old,'This frozen R5 proposal was unexecuted when authored. It subsequently passed111/111 selected groups and8/8 real Chromium scenarios in run38930449217 on89e00f6; [complete source-bound evidence](../../results/notes-new-todo-r5-cloud-pass-20261016/preservation-manifest.json) preserves all1,108 uploaded files. The normal installed32-file Notes application remains unchanged.');after.set(names[3],Buffer.from(experiment));
const rows=[];for(const n of names){for(const[dir,b]of[['before',before.get(n)],['public-candidate',after.get(n)]]){const f=path.join(stage,dir,n);fs.mkdirSync(path.dirname(f),{recursive:true});fs.writeFileSync(f,b,{flag:'wx'});assert.deepEqual(fs.readFileSync(f),b);}rows.push({path:n,before:pin(before.get(n)),after:pin(after.get(n))});}
