    {
      "id": "grafana.candidate.6e025115a090f82db594",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In the following example, a template query displays time series data from multiple servers in a table visualization. The results of only one query can be viewed at a time.",
      "headingPath": [
        "Transform data",
        "Transformation functions",
        "Join by field",
