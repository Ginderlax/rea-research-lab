    {
      "id": "grafana.candidate.cd1e894928ca1be5b2c6",
      "syntaxRole": "procedural-step",
      "sourceText": "3. If the alert is not associated with a dashboard there are logs for `Cannot take screenshot for alert rule as it is not associated with a dashboard`.",
      "headingPath": [
        "Use images in notifications",
        "Troubleshooting"
      ],
