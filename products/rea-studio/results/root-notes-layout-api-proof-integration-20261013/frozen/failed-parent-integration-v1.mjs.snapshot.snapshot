import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const base=process.cwd(),lab=path.join(base,'outputs/rea-research-lab'),owned=path.join(base,'work/root-notes-layout-api-proof-integration-next'),sha=b=>createHash('sha256').update(b).digest('hex');const source=fs.readFileSync('work/verify-notes-layout-value-api-checkpoint.proposed.mjs','utf8');assert.equal(source.split('__FULL_SUITE_PIN__').length,2);const cb=fs.readFileSync(path.join(lab,'products/rea-studio/results/notes-layout-value-api-combined-20261013/preservation-manifest.json'));assert.equal(sha(cb),'1826eba75ba777edbe69bdb44874a0827dbf684e9305ea49f51af134549b7004');const checked=source.replace('__FULL_SUITE_PIN__',sha(cb)),dest=path.join(lab,'scripts/verify-notes-layout-value-api-checkpoint.mjs');assert.equal(fs.existsSync(dest),false);fs.writeFileSync(dest,checked,{flag:'wx'});fs.writeFileSync(path.join(owned,'checkpoint-verifier.mjs.snapshot'),checked,{flag:'wx'});const parentPath=path.join(lab,'scripts/verify-followup-records.mjs'),before=fs.readFileSync(parentPath),t=JSON.parse(fs.readFileSync('work/followup-host-transition-proposal-next/transformations.json'));assert.equal(before.length,t.after.bytes);assert.equal(sha(before),t.after.sha256);const changes=[{before:"import {verifyNotesInlineFollowups} from './verify-notes-inline-followups.mjs';",after:"import {verifyNotesInlineFollowups} from './verify-notes-inline-followups.mjs';\nimport {verifyNotesLayoutValueApiCheckpoint} from './verify-notes-layout-value-api-checkpoint.mjs';"},{before:" const notesInlineVerification=verifyNotesInlineFollowups(root),notesInlineResolver=notesInlineVerification.resolveHistorical;",after:" const notesLayoutValueApiCheckpoint=verifyNotesLayoutValueApiCheckpoint(root);\n const notesInlineVerification=verifyNotesInlineFollowups(root),notesInlineResolver=notesInlineVerification.resolveHistorical;"},{before:' return{notesInlineVerification:',after:' return{notesLayoutValueApiCheckpoint,notesInlineVerification:'}];let next=before.toString();for(const c of changes){assert.equal(next.split(c.before).length,2);next=next.replace(c.before,c.after);}let inverse=next;for(const c of [...changes].reverse())inverse=inverse.replace(c.after,c.before);assert.ok(Buffer.from(inverse).equals(before));fs.writeFileSync(parentPath,next);fs.writeFileSync(path.join(owned,'parent.post-checkpoint-integration.mjs.snapshot'),next,{flag:'wx'});const record={schema:'rea-root-followup-checkpoint-verifier-integration/v1',at:new Date().toISOString(),parentPath:'scripts/verify-followup-records.mjs',before:{bytes:before.length,sha256:sha(before)},after:{bytes:Buffer.byteLength(next),sha256:sha(Buffer.from(next))},transformations:changes,inverseExact:true,checkpointVerifier:{path:'scripts/verify-notes-layout-value-api-checkpoint.mjs',bytes:Buffer.byteLength(checked),sha256:sha(Buffer.from(checked))},combinedPin:sha(cb),APIProofModuleInstallationPending:true,newAppMutations:0,behaviorExecuted:0};fs.writeFileSync(path.join(owned,'parent-checkpoint-integration.json'),JSON.stringify(record,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({parentTransforms:3,parentSHA256:record.after.sha256,checkpointVerifier:record.checkpointVerifier}));
