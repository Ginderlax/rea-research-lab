    },
    {
      "id": "grafana.candidate.a1ec8fda5bd5c638585a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use the asterisk (`*`) wildcard for dimension values to create dynamic queries that automatically monitor changing sets of AWS resources.",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Query CloudWatch metrics",
        "Metric Search queries",
        "Create dynamic queries with dimension wildcards"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/query-editor/index.md",
