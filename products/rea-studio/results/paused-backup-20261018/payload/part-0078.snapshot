    },
    {
      "id": "grafana.candidate.53c9a044d576b3598b7c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For example, if a template is passed a list of firing alerts then dot refers to that list of firing alerts:",
      "headingPath": [
        "If",
        "Templates",
        "Execute templates"
      ],
      "source": {
        "path": "docs/sources/shared/alerts/template-language.md",
