    {
      "id": "grafana.candidate.065010cbb41e5919c97b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana provides several ways to manage the time ranges of the data being visualized, for dashboard, panels and also for alerting.",
      "headingPath": [
        "Use dashboards",
        "Set dashboard time range"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/use-dashboards/index.md",
        "gitBlobSha": "f755d0704ca4e884c68952e657ea8401c4f893ae",
