import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{authenticate}from'./run.mjs';const here=import.meta.dirname,sha=b=>createHash('sha256').update(b).digest('hex'),stage=path.resolve(here,'../sketch-layout-precision-next'),old=path.resolve(here,'../sketch-alignment-next'),final=await authenticate(),newLayout=await fs.readFile(path.join(stage,'products/rea-studio/apps/sketch/layout.mjs')),oldLayout=await fs.readFile(path.join(old,'products/rea-studio/apps/sketch/layout.mjs')),n=newLayout.toString(),o=oldLayout.toString(),marker='\nfunction selection(scene,ids){';assert.equal(n.slice(n.indexOf(marker)),o.slice(o.indexOf(marker)));const inverse=o.slice(0,o.indexOf(marker))+n.slice(n.indexOf(marker));assert.equal(sha(inverse),sha(oldLayout));const candidate=JSON.parse(await fs.readFile(path.join(here,'candidate/freeze-manifest.json.snapshot'))),otherRows=candidate.records.filter(r=>r.path.startsWith('products/rea-studio/')&&!r.path.includes('/results/')&&!r.path.endsWith('/layout.mjs'));for(const r of otherRows){const b=await fs.readFile(path.join(old,r.path));assert.equal(sha(b),r.sha256,r.path);}assert.equal(otherRows.length,14);
const names=(await fs.readdir(path.join(here,'runs'))).sort(),runs=[];let fresh,replay,diagnostic;for(const name of names){const p='runs/'+name,r=JSON.parse(await fs.readFile(path.join(here,p,'run.json')));assert.equal(r.status.code,0);for(const s of r.source)assert.equal(sha(await fs.readFile(path.join(here,s.path))),s.sha256);runs.push({path:p,...r});if(r.variant==='main'){fresh=JSON.parse(await fs.readFile(path.join(here,p,'fresh-observations.json')));replay=JSON.parse(await fs.readFile(path.join(here,p,'replay-original-observations.json')));}else diagnostic=JSON.parse(await fs.readFile(path.join(here,p,'replay-original-observations.json')));}assert.equal(fresh.packets.length,78);assert.equal(replay.packets.length,62);assert.equal(diagnostic.packets.length,24);assert(diagnostic.packets.every(p=>p.exact));const total={align:fresh.original.counts.align+replay.original.counts.align+diagnostic.counts.align,distribute:fresh.original.counts.distribute+replay.original.counts.distribute+diagnostic.counts.distribute,groups:fresh.original.counts.groups+replay.original.counts.groups+diagnostic.counts.groups};assert.deepEqual(total,{align:114,distribute:50,groups:2});const adapters=JSON.parse(await fs.readFile(path.join(here,'replay-adapters.json')));for(const r of adapters){assert.equal(sha(await fs.readFile(path.join(here,r.destination))),r.afterSHA256);const prior=await fs.readFile(path.resolve(here,'..',r.source.slice('work/'.length)));assert.equal(sha(prior),r.beforeSHA256);}await fs.writeFile(path.join(here,'metadata-tool-diagnostic.json'),JSON.stringify({kind:'Owned post-test metadata inspection',command:'node -e loop over observation files',rawErrorName:'SyntaxError',rawErrorMessage:"Unexpected token '}'",cause:'Extra closing brace in evaluator text',evaluationStarted:false,testsOrOriginalHelpersExecuted:false,sourceMutations:false,productFailure:false},null,2)+'\n',{flag:'wx'});
