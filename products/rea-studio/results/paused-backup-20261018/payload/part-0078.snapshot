    {
      "id": "grafana.candidate.ced98646beb819870ba2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can navigate from a span in a trace view directly to logs relevant for that span. This feature is available for the Tempo, Jaeger, and Zipkin data sources. Refer to each individual data source's documentation for configuration instructions.",
