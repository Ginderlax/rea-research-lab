assert len({r['path'] for r in a['rows']})==len(a['rows'])==144
assert {p.relative_to(C).as_posix() for p in C.rglob('*') if p.is_file()}=={r['path'] for r in a['rows']}
for r in a['rows']:pin(read(C/r['path']),r['after'])
assert sum(r['after']['bytes'] for r in a['rows'])==6343696
target='scripts/publication-integrity-controls.mjs';before=read(C/(PREFIX+'/immediate-before/'+target+'.snapshot'));after=read(C/target)
assert ident(before)=={'bytes':53775,'sha256':'ad8654ca46ca20291d4d722b2bd547ebf6d23e219cb6788a03aa5d6b91bf4e06'}
assert ident(after)=={'bytes':54066,'sha256':'3ea26c86c77d84e1f29af38b642183c7bcb143aac38125bfa9d7d72cfd869190'}
assert read(LAB/target)==before
