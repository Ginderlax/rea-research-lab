def read(p): assert p.is_file() and not p.is_symlink(); return p.read_bytes()
def ident(b):return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
ab=read(W/'installed-notes-repeat-backup-authority-38930449222.json')
