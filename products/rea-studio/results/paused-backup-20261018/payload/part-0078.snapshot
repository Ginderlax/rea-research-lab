    {
      "id": "grafana.candidate.511152d5a30ae5c9f7d9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana provides alternative ways to start building a dashboard with templates and suggested dashboards.",
      "headingPath": [
        "Create dashboards from templates and suggestions"
      ],
      "source": {
