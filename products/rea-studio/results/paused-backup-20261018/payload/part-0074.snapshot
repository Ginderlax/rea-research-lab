    {
      "id": "grafana.candidate.b3b0a936d71432d0c353",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "> **Note:** Any user or service account with the ability to modify roles can only create, update, or delete roles with permissions they have been granted. For example, a user with the `Editor` role would be able to create and manage roles only with the permissions they have or with a subset of them.",
      "headingPath": [
        "Plan your RBAC rollout strategy",
        "Permissions scenarios",
        "Enable an editor to create custom roles"
      ],
