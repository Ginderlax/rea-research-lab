    {
      "id": "grafana.candidate.732650adaa6fbcdc1072",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "TestData generates a hierarchical metric tree with nodes named using letter combinations. The tree has 6 levels of depth, with each level containing 8 nodes labeled A through H. The query string navigates this tree using dot-separated path segments.",
      "headingPath": [
        "TestData template variables",
        "Metric tree queries"
      ],
      "source": {
        "path": "docs/sources/datasources/testdata/template-variables/index.md",
        "gitBlobSha": "1030d7d913497529fa397c2d8057ea6265427353",
