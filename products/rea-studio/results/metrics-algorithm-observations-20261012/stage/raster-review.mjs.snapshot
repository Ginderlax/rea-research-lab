import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import {spawnSync} from 'node:child_process';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),exe='C:/Users/evanh/.cache/codex-runtimes/codex-primary-runtime/dependencies/native/poppler/Library/bin/pdftoppm.exe',sha=data=>createHash('sha256').update(data).digest('hex'),records=[];await fs.mkdir(path.join(here,'visual-qa'),{recursive:true});
for(const name of ['timing-ranges','memory-ranges-and-signed-deltas']){const args=['-png','-r','100','-singlefile',path.join(here,name+'.pdf'),path.join(here,'visual-qa',name)],start=new Date().toISOString(),child=spawnSync(exe,args,{windowsHide:true,timeout:30000,maxBuffer:1024*1024,encoding:'utf8'});for(const [suffix,data]of [['stdout',child.stdout??''],['stderr',child.stderr??'']])await fs.writeFile(path.join(here,'visual-qa',name+'.'+suffix+'.txt'),data,{flag:'wx'});records.push({name,args,start,end:new Date().toISOString(),exitCode:child.status,signal:child.signal,error:child.error?.message??null});assert.equal(child.status,0);}
await fs.writeFile(path.join(here,'raster-render-validation.json'),JSON.stringify({executable:exe,executableSHA256:sha(await fs.readFile(exe)),records,measurementRun:false},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({rendered:2,measurementRun:false}));
