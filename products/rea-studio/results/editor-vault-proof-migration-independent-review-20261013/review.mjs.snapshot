import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import {createHash} from 'node:crypto';
import {pathToFileURL} from 'node:url';

// Independent, source-only byte review. No application, original, host or shell subprocess.
const own=import.meta.dirname,out=path.join(own,'final'),base=path.resolve(own,'../..'),stage=path.join(base,'work/editor-vault-proof-migration-next'),repo=path.join(base,'outputs/rea-research-lab');
const sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)}),seen=new Map(),checks=[];
function safe(p){assert(typeof p==='string'&&p&&p.length<=4096&&!/[\\:\x00-\x1f\x7f]/.test(p)&&!p.startsWith('/'));assert(p.split('/').every(s=>s&&s!=='.'&&s!=='..'));return p;}
function read(root,p,expected){safe(p);let at=root;for(const s of p.split('/')){at=path.join(at,s);assert(!fs.lstatSync(at).isSymbolicLink());}const st=fs.statSync(at);assert(st.isFile()&&st.size<=32*1024*1024);const b=fs.readFileSync(at),r=id(b);assert.equal(st.size,b.length);if(expected)assert.deepEqual(r,{bytes:expected.bytes,sha256:expected.sha256},p);const key=root+'|'+p;if(seen.has(key))assert.deepEqual(seen.get(key).identity,r,'Source changed '+p);else seen.set(key,{root:root===stage?'author-stage':root===repo?'public-repository':root===own?'owned-review':'external-source',absoluteRoot:root,path:p,identity:r});return b;}
const json=(root,p,e)=>JSON.parse(read(root,p,e));
function save(p,b){const at=path.join(out,safe(p));fs.mkdirSync(path.dirname(at),{recursive:true});fs.writeFileSync(at,b,{flag:'wx'});}
function check(name,fn=()=>{}){const value=fn();checks.push({name,passed:true,...(value??{})});}
function rejected(name,fn){let e;try{fn();}catch(error){e=error;}assert(e,'Expected rejection '+name);checks.push({name,passed:true,rejected:true,error:{name:e.name,message:e.message}});}
async function main(){
  const freezeBytes=read(stage,'freeze-manifest.json');assert.equal(sha(freezeBytes),'e54e383a182201e6971ac1201ab41a5c20351e4f6dd3f28a35daab8faa6f9ead');
  const freeze=JSON.parse(freezeBytes);assert.equal(freeze.schema,'rea-editor-vault-proof-migration-source-only-strict-freeze/v1');assert.equal(freeze.inventory.length,192);assert.equal(freeze.strict,true);
  const inventory=new Map();for(const r of freeze.inventory){safe(r.path);assert(!inventory.has(r.path));inventory.set(r.path,r);read(stage,r.path,r);}
  const excluded=new Map();for(const r of freeze.excludedReusedPublicInputs){assert(!inventory.has(r.path)&&!excluded.has(r.path));excluded.set(r.path,r);assert.deepEqual(read(stage,r.path,r),read(repo,r.publicPath,r));}assert.equal(excluded.size,73);
  function leaves(p=''){const out=[];for(const d of fs.readdirSync(path.join(stage,p),{withFileTypes:true})){assert(!d.isSymbolicLink());const n=p?p+'/'+d.name:d.name;if(d.isDirectory()){if(!freeze.excludedGeneratedMirrorPrefixes.includes(n))out.push(...leaves(n));}else{assert(d.isFile());out.push(n);}}return out;}
  const normal=leaves().sort(),allowed=[...inventory.keys(),...excluded.keys(),'freeze-manifest.json'].sort();assert.deepEqual(normal,allowed);
  const census=json(stage,'excluded-mirror-census.json');assert.equal(census.records.length,46985);assert.equal(census.bytes,2417230845);assert.equal(census.captureOnly,true);assert.equal(census.notImmutablePayload,true);assert.equal(census.records.reduce((n,r)=>n+r.bytes,0),census.bytes);assert.equal(new Set(census.records.map(r=>r.path)).size,census.records.length);for(const r of census.records)assert(freeze.excludedGeneratedMirrorPrefixes.some(p=>r.path.startsWith(p+'/')));
  check('strict192 plus73 exact reused inputs; generated46985 are capture-only excluded, not fresh byte claims');
  const copy=json(stage,'public-copy-list.json'),live=json(stage,'live-verifier-copy-list.json'),records=json(stage,'transition-records.json'),transform=json(stage,'verifier-transformations.json'),validation=json(stage,'validation.json');
  assert.equal(copy.records.length,191);assert.equal(live.records.length,8);assert.equal(transform.changes.length,31);
  const prefix='products/rea-studio/results/editor-vault-proof-migration-20261013',destinations=new Set(),copySources=new Set();for(const r of copy.records){safe(r.sourcePath);safe(r.publicPath);assert(r.publicPath.startsWith(prefix+'/')&&r.publicPath.endsWith('.snapshot'));assert(!r.publicPath.split('/').some(s=>['.local','work','node_modules','artifacts','tooling'].includes(s)));assert(!destinations.has(r.publicPath)&&!copySources.has(r.sourcePath));destinations.add(r.publicPath);copySources.add(r.sourcePath);assert.deepEqual(id(read(stage,r.sourcePath)),{bytes:r.bytes,sha256:r.sha256});assert(inventory.has(r.sourcePath));}assert.deepEqual([...copySources].sort(),[...inventory.keys()].filter(p=>p!=='public-copy-list.json').sort());
  for(const r of records.verifiers){assert(copy.records.some(c=>c.sourcePath==='verifier-before/'+path.posix.basename(r.path)+'.snapshot'&&c.publicPath===r.historicalPath));}
  check('public191+copylist+strict manifest =193 inert aliases; exact seven beforeimage addresses');
  const moduleSource=read(stage,'candidate/scripts/editor-vault-proof-migration.mjs');const match=moduleSource.toString().match(/const fixed=(\{[\s\S]*?\n\});\r?\nconst sha=/);assert(match);assert.deepEqual(JSON.parse(match[1]),records);
  const currentScripts=[],inverses=[];for(const row of live.records){assert(/^scripts\/[a-z-]+\.mjs$/.test(row.destination));assert.equal(row.sourcePath,'candidate/'+row.destination);assert(!currentScripts.includes(row.destination));currentScripts.push(row.destination);const after=read(stage,row.sourcePath,row.after);save('source/candidate/'+row.destination+'.snapshot',after);if(row.before){const before=read(repo,row.destination,row.before);save('source/before/'+row.destination+'.snapshot',before);assert.deepEqual(before,read(stage,'verifier-before/'+path.posix.basename(row.destination)+'.snapshot',row.before));const changes=transform.changes.filter(c=>c.path===row.destination);assert(changes.length);let forward=before.toString(),inverse=after.toString();for(const c of changes){assert.equal(c.occurrences,1);assert.equal(forward.split(c.before).length-1,1,c.path+' forward');forward=forward.replace(c.before,c.after);}for(const c of [...changes].reverse()){assert.equal(inverse.split(c.after).length-1,1,c.path+' inverse');inverse=inverse.replace(c.after,c.before);}assert.deepEqual(Buffer.from(forward),after);assert.deepEqual(Buffer.from(inverse),before);inverses.push({path:row.destination,substitutions:changes.length,before:row.before,after:row.after,inverseExact:true});}else assert(!fs.existsSync(path.join(repo,row.destination)));}
  assert.equal(inverses.length,7);assert.equal(inverses.reduce((n,r)=>n+r.substitutions,0),31);save('inverse-results.json',Buffer.from(JSON.stringify(inverses,null,2)+'\n'));check('seven exact inverses31 substitutions; one new module; production eight destinations still before/absent');
  for(const p of ['freeze-manifest.json','transition-records.json','verifier-transformations.json','live-verifier-copy-list.json','public-copy-list.json','validation.json','README.md','runs/attempt-v6/receipt.json','preflight-validation.json','current-development-validation.json'])save('source/author/'+p+'.snapshot',read(stage,p));
  for(const r of freeze.inventory){const b=read(stage,r.path,r);assert(!(b[0]===0x4d&&b[1]===0x5a),'Native MZ payload '+r.path);assert(!(b[0]===0x50&&b[1]===0x4b),'ZIP payload '+r.path);}
  check('all192 payload headers source-only; no MZ/PK carriers or generated mirrors in public copy set');
  const historical=json(stage,'runs/attempt-v6/receipt.json');assert.equal(historical.attempts.length,5);assert.equal(historical.mandatoryCensus,55);assert.equal(historical.sourceBeforeAfterStable,true);assert.deepEqual(json(stage,'runs/attempt-v6/source-before.json'),json(stage,'runs/attempt-v6/source-after.json'));for(const a of historical.attempts){assert.equal(a.status,0);assert.equal(a.error,null);const out=read(stage,'runs/attempt-v6/'+a.label+'.stdout.txt',a.stdout);read(stage,'runs/attempt-v6/'+a.label+'.stderr.txt',a.stderr);assert.equal(a.stderr.bytes,0);JSON.parse(out);}
  const preflight=json(stage,'preflight-validation.json');assert.equal(preflight.checks.length,24);assert(preflight.checks.every(r=>r.passed));assert.equal(preflight.checks.filter(r=>r.rejected).length,10);assert.equal(preflight.sourceBeforeAfter.length,607);for(const r of preflight.sourceBeforeAfter){const v=records.verifiers.find(v=>v.path===r.path),b=records.verifiers.find(v=>v.historicalPath===r.path);read(v||b?stage:repo,v?'candidate/'+v.path:b?'verifier-before/'+path.posix.basename(b.path)+'.snapshot':r.path,r);}
  check('historical author5 filesystem reader logs,24 checks/10 rejects/607 identities authenticated; not newly executed');
  const current=json(stage,'current-development-validation.json');assert.equal(current.observedSources.length,1493);assert.equal(current.authenticatedBytes,182883467);assert.equal(current.appTestsRerun,false);assert.equal(current.currentSourceFiles,737);assert.equal(current.capsuleSnapshots,753);for(const r of current.observedSources)read(repo,r.path,r);const dev=json(repo,current.currentDevelopment.path,current.currentDevelopment);assert.equal(dev.summary.tests,937);assert.equal(dev.summary.pass,937);for(const k of ['fail','cancelled','skipped','todo'])assert.equal(dev.summary[k],0);assert.equal(dev.source_files.length,737);
  const sourceBefore=json(base,'work/editor-vault-suite-runs/2026-10-13T05-22-11.249Z/source-before.json');assert.equal(sourceBefore.length,737);assert.deepEqual(sourceBefore.map(({path,sha256})=>({path,sha256})),dev.source_files);for(const r of sourceBefore)read(repo,'products/rea-studio/'+r.path,r);
  check('separate current937 receipt/737 sources/753 capsule with1493 authenticated identities; no test reexecution');
  // Narrow read adapter emulates prospective script installation only. No filesystem mirror.
  const mapping=new Map();for(const r of records.verifiers){mapping.set(r.path,read(stage,'candidate/'+r.path,r.after));mapping.set(r.historicalPath,read(stage,'verifier-before/'+path.posix.basename(r.path)+'.snapshot',r.before));}
  const raw=p=>mapping.has(p)?Buffer.from(mapping.get(p)):read(repo,p);
  const {createEditorVaultProofMigration}=await import(pathToFileURL(path.join(stage,'candidate/scripts/editor-vault-proof-migration.mjs')));
  const migration=createEditorVaultProofMigration(raw);const summary=migration.summary();assert.equal(summary.currentInstalledSourcesMandatory,30);assert.equal(summary.currentVerifierAfterMandatory,7);assert.equal(summary.old720ChangedCodeRoutes,6);assert.equal(summary.fullParity,false);
  for(const r of [...records.routes,...records.verifiers]){assert.equal(migration.resolve(r.path,r.before),r.historicalPath);assert.equal(migration.resolve(r.path,r.after),null);}
  check('fresh in-memory prospective proof validates current30/host/seven afters plus all exact named histories',()=>({sourceOnly:true}));
  const guardStart=checks.length;
  rejected('named old identity cannot use same-size forged SHA',()=>migration.resolve(records.routes[0].path,{...records.routes[0].before,sha256:'0'.repeat(64)}));
  rejected('named old identity cannot be omitted',()=>migration.resolve(records.routes[1].path));
  rejected('named old identity cannot mutate after length',()=>migration.resolve(records.routes[2].path,{...records.routes[2].after,bytes:records.routes[2].after.bytes-1}));
  for(const p of ['../x','products/.local/x','products/work/x','products/node_modules/x','/absolute','a\\b','a//b','a:stream'])rejected('unsafe proof path '+JSON.stringify(p),()=>migration.resolve(p));
  assert.equal(migration.resolve('products/rea-studio/apps/editor/unlisted.mjs',{bytes:1,sha256:'0'.repeat(64)}),null);check('unlisted ordinary path has no fallback mapping');
  rejected('unknown metadata cannot obtain current-development alias',()=>migration.historicalMetadata('current'));
  rejected('prototype metadata name not accepted',()=>migration.historicalMetadata('__proto__'));
  rejected('unlisted verifier cannot obtain historical body',()=>migration.historicalVerifier('scripts/unknown.mjs'));
  for(const [label,p] of [['current-source',records.sources[0].path],['host',records.sharedHost.path],['current-verifier',records.verifiers[0].path],['historical-before',records.routes[0].historicalPath],['old-dev',records.metadata.development.historicalPath],['old-status',records.metadata.status.historicalPath],['old-verifier',records.verifiers[0].historicalPath],['installation-manifest',records.installation.manifest.path],['installation-record',records.installation.record.path],['old-capsule',records.oldCapsule.path]])rejected('same-length byte mutation '+label,()=>createEditorVaultProofMigration(q=>{const b=raw(q);if(q===p){const changed=Buffer.from(b);changed[Math.floor(b.length/2)]^=1;return changed;}return b;}));
  rejected('non-Buffer source reader rejected',()=>createEditorVaultProofMigration(p=>raw(p).toString()));
  let drift=false;const drifting=createEditorVaultProofMigration(p=>{const b=raw(p);if(drift&&p===records.sources[0].path){b[0]^=1;}return b;});drift=true;rejected('summary reread rejects later source drift',()=>drifting.summary());
  const guards=checks.slice(guardStart);save('proof-guards.json',Buffer.from(JSON.stringify({checks:guards,applicationExecutions:0,proofOnly:true,prospectiveAfterReader:true,inMemoryOnly:true,privateFilesystemMirrorsCreated:0},null,2)+'\n'));
  const installer=read(base,'work/install-editor-vault-proof-migration.mjs');save('source/root-installer.mjs.snapshot',installer);const it=installer.toString();for(const expected of ['assert.equal(copies.records.length,191)','assert.equal(live.records.length,8)','assert.equal(publicRows.length,193)','assert(process.argv.includes(\'--install\')','assert.equal(sha(dev),\'333303c8bd8cd131da3f01e1414b0fba92bc321b2b63f178ab91d138b2bcfa44\')','assert.equal(sha(rb),reviewPin)','{flag:r.before?\'w\':\'wx\'}'])assert(it.includes(expected));assert(!/spawn|execFile|fetch\(/.test(it));assert(it.includes("path.join(lab,r.destination)"));assert(it.includes("stageFreezeSHA256:freezePin"));assert(it.includes('await authority();for(const r of before)'));assert(!fs.existsSync(path.join(base,'work/root-editor-vault-proof-migration-installation-next')));
  check('root installer source: explicit --install/review SHA gate; exact193 inert+8 script writes; two root artifacts; app737 unchanged gates; not executed');
  save('collector-read-diagnostics.json',Buffer.from(JSON.stringify({schema:'rea-independent-source-read-diagnostic/v1',wrongRead:'runs/attempt-v6/mandatory-before.json',observed:'ENOENT during initial read-only PowerShell inspection',actualFile:'runs/attempt-v6/source-before.json',classification:'Reviewer filename assumption; no application or proof module execution failed',retainedAsFailure:true},null,2)+'\n'));
  for(const key of ['productionWrites','publicWrites','newApplicationExecutions','newOriginalExecutions','newBrowserExecutions','benchmarks'])assert.equal(validation[key],0);for(const key of ['fullParity','securityEquivalence','superiority'])assert.equal(validation[key],false);
  const nodeBytes=fs.readFileSync(process.execPath);assert.equal(sha(nodeBytes),'b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3');save('node-provenance.json',Buffer.from(JSON.stringify({version:process.version,path:process.execPath,...id(nodeBytes),originalProgramExecution:false},null,2)+'\n'));
  const before=[...seen.values()];save('source-before.json',Buffer.from(JSON.stringify(before,null,2)+'\n'));for(const r of before)read(r.absoluteRoot,r.path,r.identity);save('source-after.json',Buffer.from(JSON.stringify([...seen.values()],null,2)+'\n'));assert.deepEqual([...seen.values()],before);
  save('review-validation.json',Buffer.from(JSON.stringify({schema:'rea-editor-vault-proof-migration-independent-source-only-review/v1',at:new Date().toISOString(),migrationAccepted:true,installerSourceAccepted:true,finiteSourceOnlyAcceptance:true,authorManifestSHA256:sha(freezeBytes),authorValidationSHA256:sha(read(stage,'validation.json')),installerSHA256:sha(installer),checks,checkCount:checks.length,freshProofOnlyRejectionChecks:guards.filter(r=>r.rejected).length,freshProofOnlyPositiveChecks:guards.filter(r=>!r.rejected).length,inverses:7,uniqueSubstitutions:31,strictAuthorPayloads:192,reusedPublicInputs:73,excludedGeneratedMirrorLeafCount:46985,excludedGeneratedMirrorsFreshAuthenticated:false,plannedPublicInertBeforeRootArtifacts:193,plannedLiveScripts:8,appSourcesAuthenticated:737,currentReceiptTestsNotReexecuted:937,currentCapsuleAliases:753,authorFiveFilesystemReadersAuthenticatedNotRerun:true,sourceBeforeAfterStable:true,authenticatedSourceIdentities:before.length,productionWrites:0,publicWrites:0,applicationExecutions:0,originalExecutions:0,browserExecutions:0,benchmarkExecutions:0,fullParity:false,securityEquivalence:false,superiority:false,limitations:['This checks exact source identities and finite proof logic; root must install and rerun the global publication proof.','The historical847/720/727 and78/browser receipts remain historical, not current behavior acceptance.','The reviewed installer gate relies on root manually approving the accepted review receipt before passing its manifest SHA; it does not itself parse acceptance flags.','Generated mirrors excluded from immutable payload were not freshly content-authenticated; only their recorded capture census is authenticated.','Filesystem checks and current source rereads are bounded authentication, not race-free atomic snapshots.'],findings:[],collectorMistakes:[{name:'wrong guessed mandatory-before filename',fixedBy:'reading source-before/source-after; no source mutation',applicationFailure:false}]},null,2)+'\n'));
  console.log(JSON.stringify({accepted:true,checks:checks.length,freshRejections:guards.filter(r=>r.rejected).length,sourceStable:true,sourceIdentities:before.length,newAppExecutions:0,productionWrites:0}));
}
main().catch(e=>{save('collector-failure.json',Buffer.from(JSON.stringify({at:new Date().toISOString(),name:e.name,message:e.message,stack:e.stack,completedChecks:checks,sourceReads:[...seen.values()],applicationExecutions:0},null,2)+'\n'));console.error(e);process.exitCode=1;});
