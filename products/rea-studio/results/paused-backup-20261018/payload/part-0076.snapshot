    {
      "id": "grafana.candidate.0d688dc268e9cab73abf",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Starting with Grafana 13.2, the Microsoft SQL Server data source is a standalone plugin, preinstalled in both Grafana OSS and Grafana Enterprise. This enables more frequent updates independent of Grafana releases. Grafana automatically checks the plugin catalog and installs the latest version on each server restart.",
      "headingPath": [
        "Microsoft SQL Server data source",
        "Plugin updates"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/_index.md",
        "gitBlobSha": "2093ac7d941f6e4cac1dc71b31cf99009c00f952",
        "sha256": "b55cf05938640b5fa5ac0fa2c4a3e67d412760501a0cf6f15f84c637a98ff596",
        "lineStart": 86,
        "lineEnd": 86,
