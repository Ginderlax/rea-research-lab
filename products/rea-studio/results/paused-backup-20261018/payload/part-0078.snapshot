        "lineStart": 249,
        "lineEnd": 249,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/panels-visualizations/query-transform-data/sql-expressions/index.md#L249-L249"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.0af5372f3a7c7e12b4f8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For SQL Expressions to work properly with alerting and recording rules, your query must return:",
      "headingPath": [
        "SQL expressions",
        "Alerting and recording rules"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/sql-expressions/index.md",
