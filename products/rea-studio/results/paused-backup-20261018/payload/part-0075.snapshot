    },
    {
      "id": "grafana.candidate.f3817f7fcb6cb578f869",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Each contact point integration can also define the notification message to be sent, which can use the predefined message, a custom message, or notification templates.",
      "headingPath": [
        "Contact points"
      ],
      "source": {
        "path": "docs/sources/alerting/fundamentals/notifications/contact-points.md",
        "gitBlobSha": "ea2d5aa183da0a3bde6bf1e1aeb5a0b176617493",
