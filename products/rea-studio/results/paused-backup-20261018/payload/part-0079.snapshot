    },
    {
      "id": "grafana.candidate.dd8a3e309c1a6905f26e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use this transformation to combine the result from multiple time series data queries into one single result. This is helpful when using the table panel visualization.",
      "headingPath": [
        "Transform data",
        "Transformation functions",
        "Series to rows"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/transform-data/index.md",
        "gitBlobSha": "9cd072609170b1783ea50740845dd11e18b0fede",
        "sha256": "73ae12b953aaf13c6df7b5a072cc18677d57c977343a108001752487a81b2800",
        "lineStart": 1404,
        "lineEnd": 1404,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/panels-visualizations/query-transform-data/transform-data/index.md#L1404-L1404"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c1f5761b0fe70153aeef",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The result from this transformation will contain three columns: Time, Metric, and Value. The Metric column is added so you easily can see from which query the metric originates from. Customize this value by defining Label on the source query.",
      "headingPath": [
        "Transform data",
        "Transformation functions",
        "Series to rows"
