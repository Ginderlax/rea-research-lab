        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/as-code/observability-as-code/provision-resources/file-path-setup.md#L38-L38"
      },
      "applicability": {
