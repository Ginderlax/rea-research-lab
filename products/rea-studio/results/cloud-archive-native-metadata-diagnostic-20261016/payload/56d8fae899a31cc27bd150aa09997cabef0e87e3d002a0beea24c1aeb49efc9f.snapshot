const historical=json('immutable-d24-failure-manifest');assert.equal(historical.runId,'38932318510');assert.equal(historical.summary.tests,1100);assert.equal(historical.summary.pass,1098);assert.equal(historical.summary.fail,2);
assert(!fs.existsSync(stage));fs.mkdirSync(stage);const candidate=path.join(stage,'public-candidate');fs.mkdirSync(candidate);const objects=new Map(),roles=[];
function write(name,bytes){const target=path.join(candidate,safe(name));fs.mkdirSync(path.dirname(target),{recursive:true});fs.writeFileSync(target,bytes,{flag:'wx'});assert.deepEqual(fs.readFileSync(target),bytes);}
function preserve(role,bytes,sourceReference){const decoded=identity(bytes),compress=bytes.length>256*1024&&!role.includes('zip'),stored=compress?gzipSync(bytes,{level:9}):bytes,storedId=identity(stored),file=prefix+'/payload/'+storedId.sha256+(compress?'.gz.snapshot':'.snapshot');if(!objects.has(file)){write(file,stored);objects.set(file,storedId);}const reread=fs.readFileSync(path.join(candidate,file));assert.deepEqual(compress?gunzipSync(reread,{maxOutputLength:16*1024*1024}):reread,bytes);roles.push({role,sourceReference,decoded,stored:{path:file,...storedId,encoding:compress?'gzip':'identity'}});}
for(const [role,value]of sources)preserve(role,value.raw,value.row.sourceReference);
for(const name of nonSource)preserve('uploaded/'+name,evidence(name),'uploaded-inner-zip:'+name);
