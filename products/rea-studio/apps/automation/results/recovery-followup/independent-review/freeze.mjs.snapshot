import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const here=fileURLToPath(new URL('./',import.meta.url)),workspace=path.resolve(here,'../..'),studio=path.join(workspace,'outputs/rea-research-lab/products/rea-studio'),hash=bytes=>createHash('sha256').update(bytes).digest('hex');
const publicReceipt='apps/automation/results/recovery-followup/integration-validation.json',receiptBytes=await fs.readFile(path.join(studio,publicReceipt));assert.equal(hash(receiptBytes),'915e4c14ed5185029e75171d1e7197f3d6ec61cff66541fea4803f08b1637d33');const receipt=JSON.parse(receiptBytes);
assert.deepEqual(receipt.summary,{tests:74,pass:74,fail:0,cancelled:0,skipped:0,todo:0});assert.equal(receipt.implementationFingerprints.length,43);
for(const item of receipt.implementationFingerprints){const bytes=await fs.readFile(path.join(studio,item.path));assert.equal(bytes.length,item.bytes,item.path);assert.equal(hash(bytes),item.sha256,item.path);}
assert.equal(hash(await fs.readFile(path.join(workspace,receipt.runner.path))),receipt.runner.sha256);
const nativeManifest=JSON.parse(await fs.readFile(path.join(studio,'apps/automation/native-original-manifest.json'))),routingManifest=JSON.parse(await fs.readFile(path.join(studio,'apps/automation/routing-original-manifest.json')));
assert.equal(Object.keys(nativeManifest.files).length,4350);assert.equal(Object.keys(routingManifest.files).length,202);
const publicFingerprints=[];
async function publicStamp(relative,expected){const bytes=await fs.readFile(path.join(studio,relative));if(expected){assert.equal(bytes.length,expected.bytes,relative);assert.equal(hash(bytes),expected.sha256,relative);}publicFingerprints.push({path:relative,bytes:bytes.length,sha256:hash(bytes)});}
for(const item of receipt.artifacts)await publicStamp(item.path,item);
for(const item of receipt.implementationFingerprints)await publicStamp(receipt.runPath+'/source/'+item.path+'.snapshot',item);
await publicStamp(receipt.runner.publicSnapshot,{bytes:(await fs.readFile(path.join(workspace,receipt.runner.path))).length,sha256:receipt.runner.sha256});
await publicStamp(receipt.runPath+'/validation.json',{bytes:receiptBytes.length,sha256:hash(receiptBytes)});await publicStamp(publicReceipt,{bytes:receiptBytes.length,sha256:hash(receiptBytes)});
for(const which of ['current','historical']){const binding=receipt.preservation[which],bytes=await fs.readFile(path.join(studio,binding.path));assert.equal(hash(bytes),binding.sha256);const manifest=JSON.parse(bytes),items=which==='current'?manifest.snapshots:manifest.entries;assert.equal(items.length,binding.snapshots);for(const item of items){const relative=which==='current'?path.posix.join(path.posix.dirname(binding.path),item.path):item.snapshot;const file=await fs.readFile(path.join(studio,relative));assert.equal(file.length,item.bytes,relative);assert.equal(hash(file),item.sha256,relative);}}
assert.equal(hash(await fs.readFile(path.join(studio,receipt.historicalRoutingReceipt.path))),receipt.historicalRoutingReceipt.sha256);
const inventory={};async function walk(folder,prefix=''){for(const item of await fs.readdir(folder,{withFileTypes:true})){const relative=prefix+item.name;if(item.isDirectory())await walk(path.join(folder,item.name),relative+'/');else{assert.notEqual(relative,'review-validation.json','Already frozen');const bytes=await fs.readFile(path.join(folder,item.name));inventory[relative]={bytes:bytes.length,sha256:hash(bytes)};}}}await walk(here);
const summary={schema:'rea-automation-recovery-independent-review/v1',frozenAtUtc:new Date().toISOString(),summary:receipt.summary,runInterval:{start:receipt.runStartedAtUtc,end:receipt.runCompletedAtUtc},currentPublicReceipt:{path:publicReceipt,sha256:hash(receiptBytes)},runner:receipt.runner,currentSourceIdentityCount:43,currentSourcesVerifiedUnchangedAtFreeze:true,old721AndNew340SnapshotsAuthenticatedAtFreeze:true,historicalFirst56Receipt:receipt.historicalRoutingReceipt,originalCounts:receipt.original.counts,nodeAndModeExecutions:1873,coreEnqueueExecutions:7,corePartialDrainExecutions:4,rawOriginalBytes:receipt.original.bytes,rawOriginalSHA256:receipt.original.sha256,newReproducedDefects:0,focusedFailedRuns:0,findings:receipt.independentReviewFindings,productionRuntimeChanged:false,historicalEvidenceRebound:false,browserExecuted:false,geometryExecuted:false,fullSuiteExecuted:false,timingMeasured:false,memoryMeasured:false,fullParity:false,securityCertified:false,performanceSuperiority:false,publicFingerprints,inventory};
await fs.writeFile(path.join(here,'review-validation.json'),JSON.stringify(summary,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({path:'work/automation-recovery-independent-review/review-validation.json',sha256:hash(await fs.readFile(path.join(here,'review-validation.json'))),privateInventoryFiles:Object.keys(inventory).length,publicFingerprintFiles:publicFingerprints.length,summary:receipt.summary}));
