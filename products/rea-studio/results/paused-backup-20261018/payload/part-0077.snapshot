    {
      "id": "grafana.candidate.1714d66c9a796e1d59fc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Service Account should have \"Storage Object Writer\" role. The access control model of the bucket needs to be \"Set object-level and bucket-level permissions\". Grafana makes the images public readable when signed URLs aren't enabled.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[external_image_storage.gcs]`",
        "`key_file`"
      ],
      "source": {
