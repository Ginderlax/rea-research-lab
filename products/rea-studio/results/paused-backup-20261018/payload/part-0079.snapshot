    },
    {
      "id": "grafana.candidate.86862d6bfcb36da28838",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Starting with Grafana 8.4, you can configure a [WeCom contact point](https://grafana.com/docs/grafana/latest/alerting/alerting-rules/manage-contact-points/) , to send alert notifications to WeCom.",
      "headingPath": [
        "What's new in Grafana v8.4",
        "OSS",
        "Alerting",
        "WeCom contact point"
      ],
      "source": {
