    {
      "id": "grafana.candidate.0586f71c688eadc1394d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To configure your Prometheus instance to work with Grafana locally instead of Grafana Cloud, install Grafana [here](/grafana/download) and follow the configuration steps listed [here](/docs/grafana/latest/datasources/prometheus/#configure-the-data-source).",
