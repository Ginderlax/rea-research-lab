    {
      "id": "grafana.candidate.be899e9811f82d0b6a95",
      "syntaxRole": "table-row",
      "sourceText": "| Color field | Set which field's values control the color of the points in the chart. To use the color value options under the **Standard** options, you must set this field. Typically, this field is used when you only have one series displayed in the chart. Required in **Manual** mode. Only supports `number` fields.  |",
      "headingPath": [
        "XY chart",
        "Configuration options",
        "XY Chart options"
      ],
