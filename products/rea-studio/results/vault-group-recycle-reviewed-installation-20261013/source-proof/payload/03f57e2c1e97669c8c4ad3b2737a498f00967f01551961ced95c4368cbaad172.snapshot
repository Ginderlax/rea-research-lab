import fs from'node:fs';const p='work/keepass-group-recycle-next/products/rea-studio/apps/vault/group-original.test.mjs';let s=fs.readFileSync(p,'utf8');s=s.replace('selection,uuid64,findGroup}', 'selection,uuid64,findGroup,attachmentFixture}');const a="usage:text(one(times,'UsageCount'))||'0',history});",b="usage:text(one(times,'UsageCount'))||'0',history,binaries:nodes(one(e,'Binaries'),'Binary').map(n=>({name:text(one(n,'Key')),base64:data.kdbx.binaries[Number(one(n,'Value').attrs.Ref)].dataBase64,protected:data.kdbx.binaries[Number(one(n,'Value').attrs.Ref)].protected}))});";if(!s.includes(a))throw new Error('Own rows adapter anchor absent.');s=s.replace(a,b);s+=`\ntest('protected descendant attachment survives recursive recycle and actual original KDBX save/reopen',async t=>{const key=randomBytes(32),data=attachmentFixture(),g=selection(data,key),trashed=deleteRecycleGroup(data,g.id,g.recycleRevision,key,{confirm:true,now,binId:ids.bin}).data,actual=await original(t,trashed,[],{save:true});compare(trashed,actual);assert.deepEqual(actual.entries.find(e=>e.id===ids.a).binaries,[{name:'owned.bin',base64:'AQCA/w==',protected:true}]);assert.equal(actual.calls.binaryRead,1);});\n`;fs.writeFileSync(p,s);
