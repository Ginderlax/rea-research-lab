    {
      "id": "grafana.candidate.f619b8b3c4c97bfa8477",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you enable SCIM in Grafana, the following requirements and restrictions apply:",
      "headingPath": [
