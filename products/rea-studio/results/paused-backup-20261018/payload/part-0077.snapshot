    },
    {
      "id": "grafana.candidate.cacbbb7357d7fbed656f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The path to the CA certificate to use. On many Linux systems, certs can be found in `/etc/ssl/certs`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[database]`",
        "`ca_cert_path`"
