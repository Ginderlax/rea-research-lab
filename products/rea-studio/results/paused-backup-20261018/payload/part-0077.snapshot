        "lineStart": 3131,
        "lineEnd": 3131,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/_index.md#L3131-L3131"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.a4bc6710c34e6a013c92",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The `from` and `to` fields should be valid relative time ranges. For more information the relative time formats, refer to [Time units and relative ranges.](/docs/grafana/<GRAFANA_VERSION>/dashboards/use-dashboards/#time-units-and-relative-ranges). The `from` field is required, but omitting `to` will result in the `from` value being used in both fields.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[time_picker]`",
        "`quick_ranges`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
