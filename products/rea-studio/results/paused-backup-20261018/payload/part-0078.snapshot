    {
      "id": "grafana.candidate.6062571d6d2bd60343d7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Limit how many series items are shown by default. When the series count exceeds the limit, click the link to show all items to see the full list of series.",
      "headingPath": [
