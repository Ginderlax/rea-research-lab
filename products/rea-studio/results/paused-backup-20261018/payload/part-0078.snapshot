        "lineStart": 21,
        "lineEnd": 21,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/set-up-grafana-monitoring.md#L21-L21"
      },
      "applicability": {
