    {
      "id": "grafana.candidate.ca725312a3670aa47e4f",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Create a new CloudWatch data source (or update an existing one) and select **Grafana Assume Role** as an authentication provider.",
      "headingPath": [
        "Configure AWS authentication",
        "Use Grafana Assume Role"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/aws-authentication/index.md",
