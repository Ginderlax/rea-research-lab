    {
      "id": "grafana.candidate.6b3b77650d3a13829d66",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can set a **Pending period** to prevent unnecessary notifications caused by temporary issues.",
      "headingPath": [
        "Alert rule evaluation",
        "Pending period"
      ],
      "source": {
        "path": "docs/sources/alerting/fundamentals/alert-rule-evaluation/_index.md",
