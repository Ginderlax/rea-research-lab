      },
      "sourceExcerpt": "You can also set the **Pending period** to zero to skip the **Pending** state entirely and transition immediately to the **Alerting**, **No Data**, or **Error** state.",
      "applicability": {
        "status": "reviewed-oss-section-contract",
        "documentProducts": [
          "cloud",
          "enterprise",
          "oss"
        ],
        "editionBoundary": "Dedicated No Data/Error notification rules need their own contracts."
      },
      "platform": {
        "classification": "platform-scope-not-yet-normalized",
        "scopeVerified": false
      },
      "scopeLimitations": [
        "Dedicated No Data/Error notification rules need their own contracts."
      ],
      "sourceReviewed": true,
      "acceptanceExecuted": false,
      "originalProductOracle": null,
      "implementationStatus": "not-assessed-by-this-inventory"
    },
    {
