    },
    {
      "id": "grafana.candidate.8d5093d04e95cd309ad5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You must use relative references when linking to docs within the Grafana repo. Please do not use absolute URLs. For more information about relrefs, refer to [Links and references](/docs/writers-toolkit/writing-guide/references/).",
      "headingPath": [
        "What’s new in Grafana v10.0",
        "Feature"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-0.md",
        "gitBlobSha": "744b2d1230211f70aa6158231d9505e732ac0315",
        "sha256": "dd311853975cca7ef6ad474588f832614dd9c445856343920d238a1ddf183739",
        "lineStart": 30,
        "lineEnd": 30,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-0.md#L30-L30"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.fe3e94776b36267ef2bc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now bring context from multiple data sources into the Explore experience. Correlations is an extension of our existing data links functionality and now enables you to link from any data source to any other data source.",
      "headingPath": [
        "What’s new in Grafana v10.0",
        "Correlations"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-0.md",
        "gitBlobSha": "744b2d1230211f70aa6158231d9505e732ac0315",
        "sha256": "dd311853975cca7ef6ad474588f832614dd9c445856343920d238a1ddf183739",
        "lineStart": 44,
        "lineEnd": 44,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-0.md#L44-L44"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.49d2751ee124e8746804",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Correlations enable you to seamlessly jump from one data source to another. You define relationships between your different data sources; when you're using Explore, simply click a button next to a related field in one data source and Grafana will run the corresponding query in the other data source.",
      "headingPath": [
        "What’s new in Grafana v10.0",
        "Correlations"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-0.md",
        "gitBlobSha": "744b2d1230211f70aa6158231d9505e732ac0315",
        "sha256": "dd311853975cca7ef6ad474588f832614dd9c445856343920d238a1ddf183739",
        "lineStart": 46,
        "lineEnd": 46,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-0.md#L46-L46"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.822ffce7194477c5ddac",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Correlations is currently in preview. As such, we recommended you only enable it on test or development instances, rather than in production environments.",
      "headingPath": [
        "What’s new in Grafana v10.0",
        "Correlations"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-0.md",
        "gitBlobSha": "744b2d1230211f70aa6158231d9505e732ac0315",
        "sha256": "dd311853975cca7ef6ad474588f832614dd9c445856343920d238a1ddf183739",
        "lineStart": 48,
        "lineEnd": 48,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-0.md#L48-L48"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.2d95624b74560267c54d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To try out Correlations, enable the `correlations` feature toggle. If you’re using Grafana Cloud and would like to enable this feature, please contact customer support.",
      "headingPath": [
        "What’s new in Grafana v10.0",
        "Correlations"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-0.md",
