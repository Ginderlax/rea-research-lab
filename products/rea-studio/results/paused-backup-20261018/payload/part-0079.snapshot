    {
      "id": "grafana.candidate.087aabe3d2292dab5e77",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you don't have an SVG file, you can use a rectangle element instead of an icon and set its background image to an image file type. To add a custom image for another element type, follow the steps to [add a custom image](#add-custom-images-to-elements).",
      "headingPath": [
        "Canvas",
        "Elements",
        "Element types",
        "Icon",
        "Add a custom icon"
      ],
