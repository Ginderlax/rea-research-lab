    {
      "id": "grafana.candidate.bd2b0797f039f83ee0d3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This topic describes how to configure GitLab OAuth authentication.",
      "headingPath": [
        "Configure GitLab OAuth authentication"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/gitlab/index.md",
