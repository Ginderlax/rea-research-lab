      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.911d93795cd94ad02baa",
      "syntaxRole": "list-item",
      "sourceText": "- The `query` permission allows users to query the data source.",
      "headingPath": [
        "Data source management",
        "Data source permissions"
      ],
