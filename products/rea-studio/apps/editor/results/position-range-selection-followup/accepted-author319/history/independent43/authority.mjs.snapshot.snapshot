import fs from 'node:fs/promises';import path from 'node:path';import crypto from 'node:crypto';import assert from 'node:assert/strict';import {fileURLToPath} from 'node:url';import {createRequire} from 'node:module';
export const root=path.dirname(fileURLToPath(import.meta.url)),stage=path.join(path.dirname(root),'editor-position-range-selection-next'),discovery=path.join(path.dirname(root),'vscode-extension-api-discovery-next');
export const hash=b=>crypto.createHash('sha256').update(b).digest('hex');
export const pins={manifest:'8e423a7d82ea58c696f9bc3d91f6d3df460c51a2041cbcdcc87d2806c0997ee5',receipt:'1fa9fa963406e95ed5a23a7ca785eaebbaf18b84a512ddfb4c19ee7316b921f0',node:'b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3',candidate:'7ad0b5ebb78ea575ca381551b7f827776523c606d9a481801f0eb34a67e2f1c1',parser:'3ae902c92cc44dace175c0e69e13a4b0899f6983c6121d76b9ab8dd5795e7675'};
export async function authenticate(){const manifestBytes=await fs.readFile(path.join(stage,'freeze-manifest.json'));assert.equal(hash(manifestBytes),pins.manifest);const manifest=JSON.parse(manifestBytes);assert.equal(manifest.files,145);assert.equal(manifest.inventory.length,145);let total=0;for(const r of manifest.inventory){const p=path.resolve(stage,r.path);assert.ok(p.startsWith(stage+path.sep));const b=await fs.readFile(p);assert.equal(b.length,r.bytes,r.path);assert.equal(hash(b),r.sha256,r.path);total+=b.length;}const actual=[];async function walk(p){for(const r of await fs.readdir(p,{withFileTypes:true})){const q=path.join(p,r.name);if(r.isDirectory())await walk(q);else{assert.ok(r.isFile());actual.push(path.relative(stage,q).replaceAll('\\','/'));}}}await walk(stage);assert.deepEqual(actual.filter(p=>p!=='freeze-manifest.json').sort(),manifest.inventory.map(r=>r.path).sort());assert.equal(total,manifest.bytes);assert.equal(hash(await fs.readFile(path.join(stage,'validation.json'))),pins.receipt);assert.equal(hash(await fs.readFile(path.join(stage,'position-range-selection.mjs'))),pins.candidate);
 const node=await fs.readFile(process.execPath);assert.equal(node.length,92279112);assert.equal(hash(node),pins.node);assert.equal(process.version,'v24.16.0');
 const parserCache=JSON.parse(await fs.readFile(path.join(discovery,'local-only-cache.json'))),parserRecords=[];for(const r of parserCache.records.filter(r=>r.path.startsWith('.local/parser/'))){const b=await fs.readFile(path.join(discovery,r.path));assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);parserRecords.push(r);}assert.equal(parserRecords.length,4);assert.equal(parserRecords.find(r=>r.path.endsWith('typescript.js')).sha256,pins.parser);
 return{stageManifest:{sha256:pins.manifest,files:145,bytes:total},stageReceiptSHA256:pins.receipt,candidateSHA256:pins.candidate,node:{version:process.version,path:process.execPath,bytes:node.length,sha256:hash(node)},parser:{version:'5.9.3',selectedCacheFiles:parserRecords,package:'Official TypeScript package retained/authenticated by the frozen earlier discovery; local-only cache.'}};}
export async function parser(){const b=await fs.readFile(path.join(discovery,'.local/parser/lib/typescript.js'));assert.equal(hash(b),pins.parser);const ts=createRequire(import.meta.url)(path.join(discovery,'.local/parser/lib/typescript.js'));assert.equal(ts.version,'5.9.3');return ts;}
