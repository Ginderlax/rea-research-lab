    {
      "id": "grafana.candidate.68f649952f307bea4c6a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The Azure Monitor data source now supports Managed Identity for users hosting Grafana in Azure to simplify and secure configuring Azure Monitor in Grafana.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Grafana OSS features",
        "Data source updates",
        "Azure Monitor data source"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-0.md",
