    {
      "id": "grafana.candidate.267e53b1c90804ea0e59",
      "syntaxRole": "list-item",
      "sourceText": "- **General silences** — not attached to any specific alert rule. They can match alerts from any rule in the organization. Only users with org-scoped silence permissions can create them.",
      "headingPath": [
        "Configure silence access",
        "Silence types"
      ],
