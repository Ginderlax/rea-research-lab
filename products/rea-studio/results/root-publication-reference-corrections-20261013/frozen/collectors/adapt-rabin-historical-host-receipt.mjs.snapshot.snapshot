import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const base=path.resolve(import.meta.dirname,'..'),lab=path.join(base,'outputs/rea-research-lab'),owned=path.join(base,'work/root-rabin-historical-host-transition-next'),target=path.join(lab,'scripts/verify-records.mjs'),sha=b=>createHash('sha256').update(b).digest('hex');fs.mkdirSync(owned,{recursive:true});const before=fs.readFileSync(target);assert.equal(sha(before),'e07cfb27a144fd0ae85a3f059adf3c262c5c3e269e22ba8d9eed8d8b58ccba3d');fs.writeFileSync(path.join(owned,'verify-records.before.mjs.snapshot'),before,{flag:'wx'});for(const n of['stdout','stderr'])fs.copyFileSync(path.join(base,`work/notes-layout-value-api-records.${n}.txt`),path.join(owned,`failed-publication-check.${n}.txt`),fs.constants.COPYFILE_EXCL);
const changes=[
 ["    else currentFingerprint(entry, 'Backup Rabin integration');", "    else if(entry.path==='products/rea-studio/server.mjs')namedHistoricalHostFingerprint(entry,'Historical Backup Rabin shared host');\n    else currentFingerprint(entry, 'Backup Rabin integration');"],
 ["metrics_algorithm_baseline: { current_nonhost_rows:7, historical_host_rows:1 },", "metrics_algorithm_baseline: { current_nonhost_rows:7, historical_host_rows:1 }, backup_rabin_sources: { current_nonhost_rows:27, prior_other_historical_rows:6, historical_host_rows:1 },"],
];let source=before.toString();for(const[a,b]of changes){assert.equal(source.split(a).length,2);source=source.replace(a,b);}let inverse=source;for(const[a,b]of [...changes].reverse())inverse=inverse.replace(b,a);assert.ok(Buffer.from(inverse).equals(before));const after=Buffer.from(source);fs.writeFileSync(target,after);fs.writeFileSync(path.join(owned,'verify-records.after.mjs.snapshot'),after,{flag:'wx'});const record={schema:'rea-rabin-historical-host-transition/v1',at:new Date().toISOString(),before:{bytes:before.length,sha256:sha(before)},after:{bytes:after.length,sha256:sha(after)},changes:changes.map(([before,after])=>({before,after})),inverseExact:true,priorRabinReceiptRebound:false,currentNonhostSourceRows:27,priorOtherHistoricalSourceRows:6,historicalHostRows:1,priorSixHistoricalGuardsUntouched:true,appWrites:0,behaviorExecutions:0};fs.writeFileSync(path.join(owned,'transformation.json'),JSON.stringify(record,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({after:record.after,inverseExact:true,appWrites:0}));
