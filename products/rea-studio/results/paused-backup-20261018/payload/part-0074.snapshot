    },
    {
      "id": "grafana.candidate.b4fdad7c7d97f1d9f4ce",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you are running a pre-9.0 version of Grafana Enterprise, please refer to the documentation for that version to learn more about license enforcement in your current version.",
      "headingPath": [
        "Grafana Enterprise license",
        "Grafana Enterprise license restrictions",
        "Tiered licensing (deprecated)"
      ],
      "source": {
