    },
    {
      "id": "grafana.candidate.87edc24cca34ba40d9ee",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To access **Search**, select your Tempo data source, and then choose **Explore** and select **Query type** > **Search**. You can use the query builder to search trace data by resource service name, span name, duration, one or more tags. The examples on this page use the default filters.",
      "headingPath": [
        "Write TraceQL queries using Search"
      ],
      "source": {
        "path": "docs/sources/shared/datasources/tempo-search-traceql.md",
