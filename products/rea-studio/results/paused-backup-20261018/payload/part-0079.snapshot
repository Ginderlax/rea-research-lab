    {
      "id": "grafana.candidate.0dceea759c397fc6c7c0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Manage contact points, mute timings, and notification templates through Role-Based Access Control (RBAC). Choose who can create, edit, and read contact points, mute timings, and notification templates using permissions or fixed roles.",
      "headingPath": [
        "What’s new in Grafana v11.3",
        "Alerting",
        "Role-based access control for notifications in Alerting"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-3.md",
