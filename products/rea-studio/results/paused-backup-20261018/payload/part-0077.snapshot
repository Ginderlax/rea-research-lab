      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.f0a194d95b627d373133",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "[Install Telegraf](https://docs.influxdata.com/telegraf/v1.18/introduction/installation/). This tool is an agent that helps you get metrics into InfluxDB. For more information, refer to [Telegraf documentation](https://docs.influxdata.com/telegraf/v1.18/).",
      "headingPath": [
        "Get started with Grafana and InfluxDB",
        "Get InfluxDB",
        "Install other InfluxDB software"
      ],
      "source": {
        "path": "docs/sources/fundamentals/getting-started/first-dashboards/get-started-grafana-influxdb.md",
