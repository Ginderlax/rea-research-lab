    {
      "id": "grafana.candidate.0f6db44163225f8f325f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The JSON configuration used to define the default base map. Four base map options to choose from are `carto`, `esriXYZTiles`, `xyzTiles`, `standard`. For example, to set cartoDB light as the default base layer:",
      "headingPath": [
