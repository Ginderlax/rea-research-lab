    {
      "id": "grafana.candidate.b82a62e44b7d78fdbc02",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can explore [this alert example in Grafana Play](https://play.grafana.org/alerting/grafana/qp_pvc_disk_capacity_forecast/view?tech=docs&pg=alerting-examples&plcmt=learn-more&cta=alert-forecast-with-predict-linear).",
