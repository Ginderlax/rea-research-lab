    {
      "id": "grafana.candidate.5db98b797f96d519bd63",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If a query returns no results, widen the time range and confirm the correct Tempo data source is selected. Prefer trace-level intrinsic fields like `trace:duration` and `trace:rootService` for faster queries.",
      "headingPath": [
        "TraceQL query examples"
      ],
