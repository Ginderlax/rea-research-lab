    {
      "id": "grafana.candidate.8ec13ca4bdfa0b635630",
      "syntaxRole": "procedural-step",
      "sourceText": "1. To retrieve the Playlists from your Grafana OSS/Enterprise instance, issue an HTTP GET request to the `/api/playlists` endpoint. Use the following shell command:",
