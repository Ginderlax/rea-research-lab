 const baseline=data('active-list343','baseline-source.json');assert.equal(baseline.files.length,46);for(const r of baseline.files){const current=await fs.readFile(path.join(workspace,r.source));assert.deepEqual(id(current),{bytes:r.bytes,sha256:r.sha256},r.source);assert(bytes('active-list343',r.destination).equals(current));}await save('source/baseline46.json.snapshot',bytes('active-list343','baseline-source.json'));
 const provenance=data('initial777','source-provenance.json');assert.equal(provenance.release,'2.61.1');assert.equal(provenance.selectedUniqueFileCount,16);assert.equal(provenance.files.length,16);assert.equal(provenance.license,'GPL-2.0-or-later');assert.equal(provenance.originalRuntimeImportedByApp,false);assert.equal(provenance.openPGPSignatureVerified,false);for(const r of provenance.files){const b=bytes('initial777',r.path);assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});if(r.upstreamPath.endsWith('.cs'))assert(/GNU General Public License/.test(b.toString('utf8').slice(0,2500)),r.upstreamPath);}const license=provenance.files.find(r=>r.upstreamPath==='Docs/License.txt');assert(license);await save('source/source-provenance.json.snapshot',bytes('initial777','source-provenance.json'));await save('source/GPL-License.txt.snapshot',bytes('initial777',license.path));
 for(const d of plan.documentationOverlay){const text=(await fs.readFile(path.join(stage,'documentation-proposal',path.basename(d.target)))).toString();assert(text.includes('../../results/vault-group-recycle-reviewed-installation-20261013/source-proof/preservation-manifest.json'));if(d.target.endsWith('NOTICE.md'))assert(text.includes('GPL-2.0-or-later')&&text.includes('source-assisted derivation')&&text.includes('not a clean-room or MIT claim'));for(const match of text.matchAll(/\]\(([^)]+)\)/g)){const link=match[1];if(link.startsWith('http'))continue;assert(!path.isAbsolute(link));const target=path.posix.normalize(path.posix.join(path.posix.dirname(d.target),link));assert(target.startsWith('products/rea-studio/'));if(target===prefix.slice(0,-1)+'/preservation-manifest.json')continue;if(plan.rows.some(r=>r.target===target))continue;await fs.access(path.join(lab,target));}}
 const originalBefore=bytes('active-list343','products/rea-studio/apps/vault/group-original.test.mjs'),adapted=bytes('active-list343','proposed-live/group-original.test.mjs');let inverse=adapted.toString();const adaptations=[['oracle=process.env.REA_KEEPASS_EXE??path.resolve(here,\'../../../..\',\'projects/07-keepass/artifacts/portable/KeePass.exe\'),observationRoot=process.env.GROUP_OBSERVATIONS??path.join(os.tmpdir(),\'rea-group-original-observations-\'+process.pid);','oracle=process.env.REA_KEEPASS_EXE;if(!oracle)throw new Error(\'REA_KEEPASS_EXE exact authenticated local release required.\');'],['fs.mkdir(observationRoot,','fs.mkdir(process.env.GROUP_OBSERVATIONS,'],["path.join(observationRoot,'group-original.json')","path.join(process.env.GROUP_OBSERVATIONS,'group-original.json')"]];for(const[a,b]of adaptations){assert.equal(inverse.split(a).length-1,1);inverse=inverse.replace(a,b);}assert(Buffer.from(inverse).equals(originalBefore));const originalPath=path.resolve(lab,'products/rea-studio/apps/vault','../../../..','projects/07-keepass/artifacts/portable/KeePass.exe');const originalIdentity=id(await fs.readFile(originalPath));assert.equal(originalIdentity.sha256,'04d29636c393f0c1fc99ff739295494be3adefded93271e44591e8e300225a5a');await save('source/original-adapter-before.mjs.snapshot',originalBefore);await save('source/original-adapter-after.mjs.snapshot',adapted);await save('adapter-proof.json',json({sourceOnly:true,substitutions:adaptations.length,inverseExact:true,defaultExecutable:originalPath,authenticated:originalIdentity,originalExecutions:0,assertionBodiesChanged:false,currentOriginalAdapterExecutionPending:true,observationFallbackIsOwnedOsTmpdir:true}));
 const negativeGates=[];for(const[name,mutate]of[['duplicate-alias',m=>m.records[1]=structuredClone(m.records[0])],['traversal-source-path',m=>m.records[0].sourcePath='../escape'],['unmapped-public-path',m=>m.records[0].publicPath=prefix+'payload/'+ '0'.repeat(64)+'.snapshot'],['duplicate-payload',m=>m.payloads[1]=structuredClone(m.payloads[0])],['bad-alias-identity',m=>m.records[0].sha256='0'.repeat(64)],['private-public-path',m=>m.payloads[0].path=prefix+'.local/'+m.payloads[0].sha256+'.snapshot'],['scope-promotion',m=>m.fullProductParity=true],['historical-receipt-rebinding',m=>m.historicalReceiptsRebound=true]]){const clone=structuredClone(proof);mutate(clone);assert.throws(()=>validateMap(clone,bytesByPath),undefined,name);negativeGates.push({name,rejected:true,inMemoryOnly:true});}await save('negative-gates.json',json({sourceOnlyCollectorGuards:negativeGates,applicationTests:0}));
