      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.d7145ff7ecfcbd01fa78",
      "syntaxRole": "list-item",
      "sourceText": "- **No actionable response**: the signal indicates service reliability, but doesn't trigger immediate action.",
      "headingPath": [
