    },
    {
      "id": "grafana.candidate.6efc897026354cdc9e0d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For advanced syntax to override data source default formatting, refer to [Advanced variable format options](#advanced-variable-format-options).",
      "headingPath": [
        "Variable syntax"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/variables/variable-syntax.md",
        "gitBlobSha": "1291d8dfe98a991fac867deb8c57017f558d8663",
