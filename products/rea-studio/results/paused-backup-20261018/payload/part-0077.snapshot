    {
      "id": "grafana.candidate.8d86f72874096353d9af",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Audit logs can be saved into files, sent to a Loki-compatible endpoint, or sent to the Grafana default logger. You can choose which exporter to use in the [configuration file](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-grafana/).",
      "headingPath": [
        "Audit a Grafana instance",
        "Configure audit logging"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/audit-grafana.md",
