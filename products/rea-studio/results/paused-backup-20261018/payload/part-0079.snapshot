    },
    {
      "id": "grafana.candidate.3df5c5900259d71fb9af",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Note:** The Grafana and Grafana Cloud documentation has not yet been updated to reflect changes to the navigation - these changes will roll out when the new navigation becomes generally available.",
      "headingPath": [
        "What's new in Grafana v9.3",
        "New navigation"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-3.md",
