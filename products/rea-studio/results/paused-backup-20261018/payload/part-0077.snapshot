    {
      "id": "grafana.candidate.6b81ffe81f50ca94c54c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use the application role `GrafanaAdmin` to grant users server administrator privileges. This is useful if you want to grant server administrator privileges to a subset of users.",
      "headingPath": [
        "Configure Microsoft Entra ID OAuth authentication",
        "Register your application with Microsoft Entra ID",
        "Assign server administrator privileges"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/entraid/index.md",
