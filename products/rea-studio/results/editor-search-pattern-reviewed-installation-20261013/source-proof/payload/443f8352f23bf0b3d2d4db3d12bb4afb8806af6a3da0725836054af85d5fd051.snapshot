import fs from'node:fs/promises';import path from'node:path';import{createHash}from'node:crypto';const root=import.meta.dirname,dir=path.join(root,'candidate/products/rea-studio/apps/editor'),rows=[];for(const name of(await fs.readdir(dir)).filter(n=>/\.(mjs|md)$/.test(n)).sort()){const b=await fs.readFile(path.join(dir,name)),p='negative-close/source/'+name+'.snapshot';await fs.mkdir(path.dirname(path.join(root,p)),{recursive:true});await fs.writeFile(path.join(root,p),b,{flag:'wx'});rows.push({path:p,bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});}await fs.writeFile(path.join(root,'negative-close/validation.json'),JSON.stringify({scope:'Actual client with real saved search/read and held completed response; no browser/original',tests:1,pass:0,fail:1,skips:0,finding:'Close B while earlier A result read held, then release, republishes A after accepted Close. Close handler unchanged from production baseline295e...',sourceCapture:'Exact post-run/pre-correction source epoch retained, no retrospective before/after interval claim.',rows,raw:['close-read-initial.stdout.txt','close-read-initial.stderr.txt'],additionalFixtureCorrection:'Unreached final assertion used global button(a.txt) even though file list always contains that button. Final corrected assertion will inspect tab aria-pressed nodes only; this does not explain the confirmed editor-content failure.'},null,2)+'\n',{flag:'wx'});
