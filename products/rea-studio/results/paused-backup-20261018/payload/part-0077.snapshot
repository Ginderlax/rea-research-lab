    {
      "id": "grafana.candidate.c3b07c8c05cf5c3d2d9c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To re-encrypt secrets, use the [Grafana CLI](../../../cli/) by running the `grafana cli admin secrets-migration re-encrypt` command or the `/encryption/reencrypt-secrets` endpoint of the Grafana [Admin API](../../../developers/http_api/admin/#roll-back-secrets). It's safe to run more than once, more recommended under maintenance mode.",
      "headingPath": [
        "Configure database encryption",
        "Operational work",
        "Re-encrypt secrets"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-database-encryption/_index.md",
