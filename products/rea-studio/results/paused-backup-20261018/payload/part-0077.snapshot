    {
      "id": "grafana.candidate.1bb8a7f5d563ee84fd58",
      "syntaxRole": "table-row",
      "sourceText": "| `login_prompt`               | No       | Yes                | Indicates the type of user interaction when the user logs in with Google. Available values are `login`, `consent` and `select_account`.                                                                                                                                                                                                                                                                                                                                                         |                                                    |",
      "headingPath": [
        "Configure Google OAuth authentication",
        "Configuration options"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md",
