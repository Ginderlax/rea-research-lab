    {
      "id": "grafana.candidate.cc729698dc998e34c95a",
      "syntaxRole": "table-row",
      "sourceText": "| `per_datasource_http_proxy_enabled` | Allows each CloudWatch data source instance to use its own HTTP proxy configuration for requests to AWS, instead of a shared proxy. Disabled by default. Set to `true` to enable.                                                                                                                                                                                                                                                               |",
      "headingPath": [
        "Configure the Amazon CloudWatch data source",
        "Configure the data source in the UI",
        "Configure the data source with grafana.ini"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/configure/index.md",
        "gitBlobSha": "55de406ecf9d9059613bbf9035604a180127e1c5",
