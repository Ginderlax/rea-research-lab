    {
      "id": "grafana.candidate.a8dff7db28c6b096dd83",
      "syntaxRole": "table-row",
      "sourceText": "| `count:<unit>`                     | Custom count unit.                                                                                                                                                                                                                                                                                                                                      |",
      "headingPath": [
