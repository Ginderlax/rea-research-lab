import test from 'node:test';import assert from 'node:assert/strict';import {randomUUID}from'node:crypto';import {handle,dispose} from './server.mjs';
const password='Owned synthetic group master';
async function fixture(t){const records=new Map(),workspace={root:'owned-group-'+randomUUID()},store={get:async(k,d)=>records.has(k)?structuredClone(records.get(k)):d,set:async(k,v)=>{records.set(k,structuredClone(v))}},api=(action,input={})=>handle({action,input,store,workspace});t.after(()=>dispose(workspace));await api('create',{password});const A=await api('save',{title:'A',group:'Parent/Selected',password:'Synthetic A'}),B=await api('save',{title:'B',group:'Parent/Selected/Deep',password:'Synthetic B'}),C=await api('save',{title:'C',group:'Other',password:'Synthetic C'});return {records,workspace,store,api,A,B,C};}
test('encrypted recursive group recycle survives lock/reopen and restore/purge with no secret in index/preview',async t=>{const f=await fixture(t),g=(await f.api('recycleGroupList')).groups.find(g=>g.name==='Selected');assert.equal(g.entryCount,2);const preview=await f.api('recycleGroupRead',{id:g.id,revision:g.recycleRevision});assert.equal(preview.group.entries.length,2);assert(!JSON.stringify(preview).includes('Synthetic A'));await f.api('recycleGroupDelete',{id:g.id,revision:g.recycleRevision,confirm:true});assert.equal((await f.api('list')).entries.length,1);await f.api('lock');await f.api('unlock',{password});const bin=(await f.api('recycleGroupList',{bin:true})).groups.find(g=>g.id===g.id&&g.name==='Selected');assert(bin.canRestorePreviousGroup);await f.api('recycleGroupRestore',{id:bin.id,revision:bin.recycleRevision,confirm:true});assert.equal((await f.api('list')).entries.length,3);const fresh=(await f.api('recycleGroupList')).groups.find(g=>g.id===bin.id);await f.api('recycleGroupDelete',{id:fresh.id,revision:fresh.recycleRevision,confirm:true,permanent:true});await f.api('lock');await f.api('unlock',{password});assert.equal((await f.api('list')).entries.length,1);assert.equal((await f.api('recycleGroupList',{bin:true})).groups.length,1);assert(!JSON.stringify(f.records.get('vault.database')).includes('Synthetic A'));});
test('failed encrypted persistence leaves group/entries/history/bin untouched and confirmation rejects before write',async t=>{const f=await fixture(t),g=(await f.api('recycleGroupList')).groups.find(g=>g.name==='Selected'),before=structuredClone(f.records.get('vault.database'));await assert.rejects(f.api('recycleGroupDelete',{id:g.id,revision:g.recycleRevision}),/confirmation/);f.store.set=async()=>{throw new Error('Owned group persistence rejection')};await assert.rejects(f.api('recycleGroupDelete',{id:g.id,revision:g.recycleRevision,confirm:true}),/persistence rejection/);assert.deepEqual(f.records.get('vault.database'),before);assert.equal((await f.api('list')).entries.length,3);assert.equal((await f.api('recycleGroupList',{bin:true})).groups.length,0);});
test('queued direct input target is privately captured; stale concurrent group tokens refuse after durable commit',async t=>{const f=await fixture(t),g=(await f.api('recycleGroupList')).groups.find(g=>g.name==='Selected');let entered,release;const started=new Promise(r=>entered=r),gate=new Promise(r=>release=r),real=f.store.set;f.store.set=async(k,v)=>{entered();await gate;return real(k,v)};const input={id:g.id,revision:g.recycleRevision,confirm:true},first=f.api('recycleGroupDelete',input);input.id='mutated';await started;const second=f.api('recycleGroupDelete',{id:g.id,revision:g.recycleRevision,confirm:true});release();await first;await assert.rejects(second,/selection changed/);assert.equal((await f.api('list')).entries.length,1);});
