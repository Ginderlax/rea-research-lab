    {
      "id": "grafana.candidate.bc96aedc4e13fc3ee475",
      "syntaxRole": "list-item",
      "sourceText": "- The calculations and reducer functions apply to all fields in the table, by default. To control which fields have a calculation or function applied, add the table footer in an override instead.",
      "headingPath": [
