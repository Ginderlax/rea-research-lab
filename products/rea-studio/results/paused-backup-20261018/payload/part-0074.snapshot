      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.0828f92496b229c2d262",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For Search, metrics, and autocomplete endpoints, only spans matching the LBAC rules appear regardless of the configured redaction mode.",
