    {
      "id": "grafana.candidate.425d6529d5abf675c94a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To set up cross-account querying for AWS Cloudwatch Plugin, see instructions [here](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/aws-cloudwatch/query-editor/#cross-account-observability).",
      "headingPath": [
