    {
      "id": "grafana.candidate.df19398266c10fda6396",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "As of Grafana 13.0, fill resampling in `$__timeGroup` and `$__unixEpochGroup` includes additional safeguards to prevent incorrect data points when the query returns no rows or the time range falls outside the data boundaries.",
      "headingPath": [
