import test,{after}from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import{layoutSelection}from'../sketch-layout-precision-next/products/rea-studio/apps/sketch/layout.mjs';import{validateScene,selectGroup,importExcalidraw,exportExcalidraw}from'../sketch-layout-precision-next/products/rea-studio/apps/sketch/core.mjs';import{createOriginalOracle,negativeZeroPaths}from'./original-oracle.mjs';import{shape,scene,nativeDocument,nativeRect,originalElements}from'./fixtures.mjs';
const original=await createOriginalOracle(),packets=[],ops=['x','y'].flatMap(axis=>[...['start','center','end'].map(position=>({kind:'align',axis,position})),{kind:'distribute',axis}]),positions=shapes=>shapes.map(s=>({id:s.id,x:s.x,y:s.y})).sort((a,b)=>a.id.localeCompare(b.id));
function compare(raw,op,ids=raw.shapes.map(s=>s.id)){const input=validateScene(raw),before=structuredClone(input),expanded=new Set(ids.flatMap(id=>selectGroup(input.shapes,id))),selected=input.shapes.filter(s=>expanded.has(s.id)),elements=originalElements({shapes:selected}),expected=op.kind==='align'?original.align(elements,op):original.distribute(elements,{axis:op.axis,space:'between'}),result=layoutSelection(input,ids,op),actual=result.scene.shapes.filter(s=>expanded.has(s.id));packets.push({input,ids,operation:op,expected:positions(expected),actual:positions(actual),negativeZero:{expected:negativeZeroPaths(positions(expected)),actual:negativeZeroPaths(positions(actual))},groupCount:result.groupCount});assert.deepEqual(positions(actual),positions(expected));assert.deepEqual(input,before);for(const s of result.scene.shapes.filter(s=>!expanded.has(s.id)))assert.deepEqual(s,input.shapes.find(x=>x.id===s.id));return result;}
after(()=>{fs.writeFileSync(process.env.PRECISION_FRESH_OUTPUT,JSON.stringify({schema:'rea-sketch-precision-fresh-independent-pairs/v1',packets,original:{contracts:original.contracts,counts:original.counts,observations:original.observations,selectedSlices:7,declarations:8,units:5,VMCompilations:1,adapters:original.adapters,codeSHA256:original.codeSHA256},noTolerance:true,originalGUI:0,benchmarks:0},null,2)+'\n',{flag:'wx'});console.log('FRESH_PRECISION_ACTION_PAIRS '+packets.length);});
test('fresh prime-denominator fractional line/freehand extrema match at tiny and large scales',()=>{for(const scale of[1,1/1024,1/1048576,8192,65536,262144]){const input=scene([shape('line',scale*7/31,scale*5/37,-scale*3/131,scale*7/127,{type:'line'}),shape('stroke',scale*11/41,scale*13/43,0,0,{type:'freedraw',points:[[-scale*2/73,scale*3/79],[scale*5/83,-scale*7/89],[scale*11/97,scale*13/101]]}),shape('diamond',scale*17/47,scale*19/53,scale*23/103,scale*29/107,{type:'diamond'}),shape('rect',scale*31/59,scale*37/61,scale*41/109,scale*43/113)]);for(const op of ops)compare(input,op);}});
test('fractional partial nested group selection expands outer signed/freehand members exactly',()=>{const input=scene([shape('in-a',13/17,19/23,-7/31,-5/37,{type:'line',groupIds:['inner-prime','outer-prime']}),shape('in-b',29/41,31/43,0,0,{type:'freedraw',points:[[3/47,5/53],[-7/59,-11/61]],groupIds:['inner-prime','outer-prime']}),shape('in-c',37/67,41/71,13/73,17/79,{groupIds:['other-inner','outer-prime']}),shape('single-a',43/83,47/89,19/97,23/101),shape('single-b',53/103,59/107,29/109,31/113),shape('untouched',100,101,2,3)]);for(const op of ops){const r=compare(input,op,['in-a','single-a','single-b']);assert.equal(r.groupCount,3);assert.deepEqual(r.scene.shapes[1].points,input.shapes[1].points);}});
test('fractional negative-gap anchors and equal-center overlap order preserve original literal behavior',()=>{const fixtures=[scene([shape('wide',1/17,2/19,37/23,1/29),shape('early',3/31,5/37,7/41,1/43),shape('middle',11/47,13/53,17/59,1/61),shape('late',19/67,23/71,29/73,1/79)]),scene([shape('wide',0,0,1,1/17),shape('inside-a',1/8,0,3/4,1/19),shape('inside-b',1/4,0,1/2,1/23)]),scene([shape('left',1/3,0,1,1/29),shape('right',2/3,0,1,1/31),shape('middle',1/2,0,1,1/37)])];for(const f of fixtures)for(const axis of['x','y'])compare(axis==='x'?f:scene(f.shapes.map(s=>({...s,x:s.y,y:s.x,w:s.h,h:s.w}))),{kind:'distribute',axis});});
test('fractional group-ID/ungrouped-shape-ID collision preserves exact original unit grouping',()=>{const input=scene([shape('member-a',1/19,3/23,5/29,7/31,{groupIds:['owned-collision']}),shape('member-b',11/37,13/41,-17/43,19/47,{type:'line',groupIds:['owned-collision']}),shape('owned-collision',23/53,29/59,31/61,37/67),shape('separate',41/71,43/73,47/79,53/83)]);for(const op of ops)assert.equal(compare(input,op).groupCount,2);});
test('native fractional line/freehand translation retains unknown fields and exact geometry through two roundtrips',()=>{const doc=nativeDocument([nativeRect('native-line',17/29,19/31,11/37,13/41,{type:'line',points:[[0,0],[-11/37,13/41]],startBinding:null,endBinding:null}),nativeRect('native-stroke',23/43,29/47,7/53,11/59,{type:'freedraw',points:[[1/61,3/67],[-5/71,7/73],[11/79,-13/83]],pressures:[.2,.4,.6],simulatePressure:false}),nativeRect('native-rect',31/89,37/97,41/101,43/103),nativeRect('opaque',59,61,1,2,{type:'image',fileId:'ownedOpaque',unknownOwnedOpaque:{keep:17}})]),input=importExcalidraw(doc,'Fresh native fractions');for(const op of ops){const r=compare(input,op),out=exportExcalidraw(r.scene);assert.deepEqual(out.files,doc.files);assert.deepEqual(out.unknownOwnedDocument,doc.unknownOwnedDocument);assert.deepEqual(out.elements[3],doc.elements[3]);assert.deepEqual(out.elements[1].points,doc.elements[1].points);assert.deepEqual(out.elements[1].pressures,doc.elements[1].pressures);for(const e of out.elements)assert.deepEqual(e.unknownOwnedElement,doc.elements.find(x=>x.id===e.id).unknownOwnedElement);const reopened=importExcalidraw(out,'Fresh native fractions reopened');assert.deepEqual(positions(reopened.shapes),positions(r.scene.shapes));assert.deepEqual(exportExcalidraw(reopened),out);}});
test('declared coordinate overflow still refuses atomically; accepted no-op remains exact',()=>{const input=scene([shape('offset-origin',999999.5,0,0,.1,{type:'freedraw',points:[[-999999.25,0],[-999999.125,.1]]}),shape('edge',999999.5,1,.5,.125)]),before=structuredClone(input);assert.throws(()=>layoutSelection(input,input.shapes.map(s=>s.id),{kind:'align',axis:'x',position:'end'}),/coordinate/);assert.deepEqual(input,before);const noOp=scene([shape('a',1/17,-0,1/19,1/23),shape('b',1/17,1/29,1/31,1/37)]),result=layoutSelection(noOp,['a','b'],{kind:'align',axis:'x',position:'start'});assert.deepEqual(result.changedIds,[]);assert.deepEqual(result.scene,validateScene(noOp));});
