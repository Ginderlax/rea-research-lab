    },
    {
      "id": "grafana.candidate.6f4858165c4ff3f44af1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana’s new panel design is available only for React-based panels. No Angular-based panels, like the legacy Graph and Worldmap panels, are redesigned. As a reminder, Angular is deprecated in Grafana and will be removed in a future release. See our [deprecation docs](../../developers/angular_deprecation/) for more information.",
      "headingPath": [
        "What's new in Grafana v9.5",
        "Dashboards and visualizations",
        "Redesigned dashboard panel is generally available"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-5.md",
        "gitBlobSha": "c2c2ff159ae288e6085e71233ed9e2f0d46eabfc",
