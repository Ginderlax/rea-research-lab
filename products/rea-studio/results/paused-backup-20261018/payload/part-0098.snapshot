$server=$server.Replace($anchor,$anchor+"    if(!Object.hasOwn(input,'id')||!Object.hasOwn(input,'revision'))throw new Error('Unversioned empty-bin commands are unsupported. Preview the bin and confirm its current revision.');`n")
$before="if(action==='deleteGroup'||action==='recycleGroup')throw new Error('Use revision-bound group commands.');"
$after="if(action==='deleteGroup'||action==='recycleGroup')throw new Error('Unsupported group command. Use revision-bound group commands.');"
