import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';const root=import.meta.dirname,file=path.join(root,'original-pattern-comparison.mjs'),old=await fs.readFile(file,'utf8');const marker='const current=JSON.parse(await fs.readFile(path.join(root,\'production-before.json\')));';assert.equal(old.split(marker).length,2);const insertion="const sourceAfter=[];for(const row of sourceBefore){const b=await fs.readFile(path.join(root,row.path));sourceAfter.push({path:row.path,bytes:b.length,sha256:hash(b)});}await fs.writeFile(path.join(run,'source-after.json'),JSON.stringify(sourceAfter,null,2)+'\\n',{flag:'wx'});assert.deepEqual(sourceAfter,sourceBefore);";let next=old.replace(marker,insertion+marker);assert.equal(next.split("sourceHelperCalls:observations.length").length,2);next=next.replace('sourceHelperCalls:observations.length','matchingSourceRows:sourceBefore.length,matchingSourceStable:true,corpusQualification:"Exact replay of author-prepared35 cases; previous32/918+3divergence receipt remains historical, not fresh held-out",sourceHelperCalls:observations.length');await fs.writeFile(file,next);
