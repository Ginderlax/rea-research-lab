import test from 'node:test';import assert from 'node:assert/strict';import {randomBytes} from 'node:crypto';
import {createNativeGroup,editNativeGroup,recycleGroupRead,recycleGroupView,recycleView,recycleRead,deleteRecycleGroup} from './recycle.mjs';
import {materializeKdbxDocument,decodeKdbxDate,encodeKdbxDate,exportKdbx,importKdbx} from './kdbx.mjs';
import {nodes,one,text,put,element,serializeXml} from './xml.mjs';
import {fixture,attachmentFixture,edit,ids,now,old,uuid64,findGroup,selection} from './group-fixture.mjs';
const freshId='30000000-0000-0000-0000-000000000001',fields={name:'Created <&> 🗂',notes:'owned line one\r\nline two & <text>'};
const key=randomBytes(32);
function create(data=fixture(),parentId=ids.target,values=fields,options={}){const g=selection(data,key,parentId);return createNativeGroup(data,g.id,g.recycleRevision,key,values,{now,groupId:freshId,...options});}
function update(data=fixture(),id=ids.target,values={name:'Renamed',notes:'Owned updated notes'},options={}){const g=selection(data,key,id);return editNativeGroup(data,g.id,g.recycleRevision,key,values,{now,...options});}
function node(data,id){return findGroup(materializeKdbxDocument(data),id);}
test('new group has released folder/inheritance defaults, owned identity, untouched parent times and no entry changes',()=>{
 const data=edit(fixture(),x=>put(findGroup(x,ids.target),'IsExpanded','False')),before=JSON.stringify(data),parentBefore=node(data,ids.target),timesBefore=serializeXml(one(parentBefore,'Times')),created=create(data),g=node(created.data,freshId);
 assert.equal(JSON.stringify(data),before);assert.equal(created.result.parentId,ids.target);assert.deepEqual(created.data.entries,data.entries);assert.equal(text(one(g,'UUID')),uuid64(freshId));assert.equal(text(one(g,'Name')),fields.name);assert.equal(text(one(g,'Notes')),fields.notes);assert.equal(text(one(g,'IconID')),'48');assert.equal(text(one(g,'EnableAutoType')),'null');assert.equal(text(one(g,'EnableSearching')),'null');assert.equal(text(one(g,'LastTopVisibleEntry')),Buffer.alloc(16).toString('base64'));assert.equal(one(g,'PreviousParentGroup'),undefined);assert.equal(one(g,'CustomData'),undefined);assert.equal(nodes(g,'Entry').length,0);assert.equal(text(one(one(g,'Times'),'UsageCount')),'1');assert.equal(text(one(one(g,'Times'),'Expires')),'False');for(const k of['CreationTime','LastModificationTime','LastAccessTime','LocationChanged','ExpiryTime'])assert.equal(decodeKdbxDate(text(one(one(g,'Times'),k))),now.replace('Z','.000Z'));assert.equal(text(one(node(created.data,ids.target),'IsExpanded')),'True');assert.equal(serializeXml(one(node(created.data,ids.target),'Times')),timesBefore);
});
test('name/notes edit projects every descendant path while preserving exact subtree entries/history/unknown fields/attachments',()=>{
 const data=attachmentFixture(),before=JSON.stringify(data),xml=materializeKdbxDocument(data),entry=serializeXml(nodes(findGroup(xml,ids.target),'Entry')[0]),deep=serializeXml(findGroup(xml,ids.deep)),other=serializeXml(findGroup(xml,ids.other)),parentTimes=serializeXml(one(findGroup(xml,ids.parent),'Times')),changed=update(data),g=node(changed.data,ids.target);
 assert.equal(JSON.stringify(data),before);assert.equal(serializeXml(nodes(g,'Entry')[0]),entry);assert.equal(serializeXml(node(changed.data,ids.deep)),deep);assert.equal(serializeXml(node(changed.data,ids.other)),other);assert.equal(serializeXml(one(node(changed.data,ids.parent),'Times')),parentTimes);assert.deepEqual(changed.data.kdbx.binaries,data.kdbx.binaries);assert.equal(serializeXml(one(g,'Unknown.Group')),serializeXml(one(findGroup(xml,ids.target),'Unknown.Group')));assert.equal(changed.data.entries.find(e=>e.id===ids.a).group,'Parent/Renamed');assert.equal(changed.data.entries.find(e=>e.id===ids.b).group,'Parent/Renamed/Deep');assert.equal(changed.data.entries.find(e=>e.id===ids.a).kdbxGroupId,ids.target);assert.deepEqual(changed.result.affectedEntryIds,[ids.a,ids.b]);assert.equal(text(one(one(g,'Times'),'UsageCount')),'6');for(const k of['LastModificationTime','LastAccessTime'])assert.equal(decodeKdbxDate(text(one(one(g,'Times'),k))),now.replace('Z','.000Z'));for(const k of['CreationTime','LocationChanged','ExpiryTime'])assert.equal(decodeKdbxDate(text(one(one(g,'Times'),k))),old.replace('Z','.000Z'));
});
test('root remains protected from deletion but native root naming and child creation are safe',()=>{
 const data=fixture(),root=selection(data,key,ids.root);assert(root.canEdit);assert(root.canCreateChild);assert.equal(root.canDelete,false);const changed=update(data,ids.root,{name:'Root renamed',notes:'Root notes'});assert.deepEqual(changed.data.entries,data.entries);const child=create(changed.data,ids.root,{name:'At root',notes:''});assert.equal(child.result.parentId,ids.root);assert.throws(()=>deleteRecycleGroup(data,root.id,root.recycleRevision,key,{confirm:true,now}),/root/);
});
test('empty, whitespace, duplicate and slash names follow text semantics without changing identity',()=>{
 for(const name of['','  duplicate  ','Other','Part/Name']){const data=fixture(),changed=update(data,ids.target,{name,notes:'\r\n\t'});assert.equal(text(one(node(changed.data,ids.target),'Name')),name);assert.equal(text(one(node(changed.data,ids.target),'Notes')),'\r\n\t');assert.equal(changed.data.entries.find(e=>e.id===ids.a).kdbxGroupId,ids.target);}
 const result=create(fixture(),ids.other,{name:'Selected',notes:''});assert.equal(result.result.id,freshId);assert.equal(recycleGroupView(result.data,key).groups.filter(g=>g.name==='Selected').length,2);
});
test('whole-graph revisions reject stale text/attachment edits, wrong key, wrong UUID and entry tokens transactionally',()=>{
 const data=attachmentFixture(),g=selection(data,key),before=JSON.stringify(data),entry=recycleView(data,key).entries[0];for(const rev of[undefined,'0'.repeat(64),entry.recycleRevision])assert.throws(()=>editNativeGroup(data,g.id,rev,key,fields,{now}),/selection changed/);assert.throws(()=>createNativeGroup(data,ids.other,g.recycleRevision,key,fields,{now,groupId:freshId}),/selection changed/);assert.throws(()=>editNativeGroup(data,g.id,g.recycleRevision,randomBytes(32),fields,{now}),/selection changed/);const changed=update(data).data;assert.throws(()=>createNativeGroup(changed,g.id,g.recycleRevision,key,fields,{now,groupId:freshId}),/selection changed/);const binary=structuredClone(data);binary.kdbx.binaries[0].dataBase64='AgCA/w==';assert.throws(()=>editNativeGroup(binary,g.id,g.recycleRevision,key,fields,{now}),/selection changed/);assert.equal(JSON.stringify(data),before);
});
test('recycled bin and descendants refuse creation/edit and expose active editor flags accurately',()=>{
 const data=fixture(),g=selection(data,key),trashed=deleteRecycleGroup(data,g.id,g.recycleRevision,key,{confirm:true,now,binId:ids.bin}).data,before=JSON.stringify(trashed);for(const id of[ids.target,ids.deep,ids.bin]){const row=selection(trashed,key,id,true);assert.equal(row.canEdit,false);assert.equal(row.canCreateChild,false);assert.throws(()=>createNativeGroup(trashed,id,row.recycleRevision,key,fields,{now,groupId:freshId}),/recycled parent/);assert.throws(()=>editNativeGroup(trashed,id,row.recycleRevision,key,fields,{now}),/recycled group/);}assert.equal(JSON.stringify(trashed),before);
});
test('new UUID collision, zero and tombstoned UUID refusals leave caller unchanged',()=>{
 for(const id of[ids.a,ids.target,'00000000-0000-0000-0000-000000000000','bad']){const data=fixture(),before=JSON.stringify(data);assert.throws(()=>create(data,ids.target,fields,{groupId:id}),/identity|collides/);assert.equal(JSON.stringify(data),before);}const data=edit(fixture(),x=>one(one(x,'Root'),'DeletedObjects').children.push(element('DeletedObject',[element('UUID',uuid64(freshId)),element('DeletionTime',encodeKdbxDate(now))])));assert.throws(()=>create(data),/collides/);
});
test('bounded text, invalid XML, invalid usage and canonical clock refusal are transactional',()=>{
 const data=fixture(),before=JSON.stringify(data);for(const values of[{name:'x'.repeat(257),notes:''},{name:'x',notes:'x'.repeat(100001)},{name:3,notes:''},{name:'x'},{name:'x',notes:'',iconId:1},{name:'x\u0000',notes:''},{name:'\ud800',notes:''}]){assert.throws(()=>create(data,ids.target,values));assert.throws(()=>update(data,ids.target,values));}for(const bad of['2025-02-30T00:00:00Z','0000-01-01T00:00:00Z',0]){assert.throws(()=>create(data,ids.target,fields,{now:bad}),/clock/);assert.throws(()=>update(data,ids.target,fields,{now:bad}),/clock/);}assert.equal(JSON.stringify(data),before);const malformed=edit(data,x=>put(one(findGroup(x,ids.target),'Times'),'UsageCount','-1'));assert.throws(()=>update(malformed),/usage/);
});
test('paths that exceed 256 characters refuse group creation and ancestor rename with full rollback',()=>{
 const data=fixture(),before=JSON.stringify(data);assert.throws(()=>create(data,ids.target,{name:'n'.repeat(250),notes:''}),/Group paths/);assert.throws(()=>update(data,ids.parent,{name:'n'.repeat(250),notes:''}),/Group paths/);assert.equal(JSON.stringify(data),before);
});
test('unchanged save still touches only selected group and wraps native uint64 usage',()=>{
 const data=edit(fixture(),x=>put(one(findGroup(x,ids.target),'Times'),'UsageCount','18446744073709551615')),result=update(data,ids.target,{name:'Selected',notes:''}),g=node(result.data,ids.target);assert.equal(text(one(one(g,'Times'),'UsageCount')),'0');assert.equal(text(one(one(node(result.data,ids.parent),'Times'),'UsageCount')),'5');assert.equal(recycleGroupRead(result.data,ids.target,selection(result.data,key).recycleRevision,key).group.notes,'');
});
test('new group metadata pushes deep XML past the parser depth limit without mutating original',()=>{
 const data=edit(fixture(),x=>{let parent=findGroup(x,ids.other);for(let i=0;i<58;i++){const id='40000000-0000-0000-0000-'+String(i).padStart(12,'0');const g=element('Group',[element('UUID',uuid64(id)),element('Name','x')]);parent.children.push(g);parent=g;}}),id='40000000-0000-0000-0000-000000000057',before=JSON.stringify(data);assert.throws(()=>create(data,id,{name:'x',notes:''}),/depth limit/);assert.equal(JSON.stringify(data),before);
});
test('native KDBX export/import retains new empty group, renamed paths, unknown fields and protected attachments',async()=>{
 const data=update(attachmentFixture()).data,created=create(data),bytes=await exportKdbx(created.data,{password:'Synthetic group export master'},{kdf:'aes',rounds:100,compression:false}),reopened=await importKdbx(bytes,{password:'Synthetic group export master'});assert.deepEqual(reopened.kdbx.binaries,created.data.kdbx.binaries);assert.equal(reopened.entries.find(e=>e.id===ids.a).group,'Parent/Renamed');assert.equal(text(one(node(reopened,freshId),'Name')),fields.name);assert.equal(text(one(node(reopened,freshId),'Notes')),fields.notes);assert.equal(serializeXml(one(node(reopened,ids.target),'Unknown.Group')),serializeXml(one(node(created.data,ids.target),'Unknown.Group')));assert.equal(nodes(one(nodes(node(reopened,ids.target),'Entry')[0],'History'),'Entry').length,1);
});
test('creation and edit stale every old group and entry recycle MAC without changing unaffected entry payload',()=>{for(const effect of[create,update]){const data=fixture(),group=selection(data,key,ids.other),entry=recycleView(data,key).entries.find(e=>e.id===ids.c),after=effect(data).data;assert.throws(()=>recycleGroupRead(after,group.id,group.recycleRevision,key),/selection changed/);assert.throws(()=>recycleRead(after,entry.id,entry.recycleRevision,key),/selection changed/);assert.deepEqual(after.entries.find(e=>e.id===ids.c),data.entries.find(e=>e.id===ids.c));}});
test('unknown known-field attributes, icons, group settings and public metadata remain exact through editing',()=>{const data=edit(attachmentFixture(),x=>{const g=findGroup(x,ids.target);one(g,'Name').attrs['Vendor.Name']='retained';put(g,'IconID','42');put(g,'CustomIconUUID',uuid64(ids.other));put(g,'EnableAutoType','False');put(g,'EnableSearching','False');put(g,'DefaultAutoTypeSequence','{USERNAME}{ENTER}');g.children.push(element('Tags','owned; tag'),element('CustomData',[element('Item',[element('Key','owned'),element('Value','retained custom group value')])]))});data.kdbx.publicCustomData={owned:{type:0x18,value:'owned retained public header'}};const before=node(data,ids.target),after=update(data).data,g=node(after,ids.target);assert.equal(one(g,'Name').attrs['Vendor.Name'],'retained');for(const k of['IconID','CustomIconUUID','EnableAutoType','EnableSearching','DefaultAutoTypeSequence','Tags','CustomData'])assert.equal(serializeXml(one(g,k)),serializeXml(one(before,k)));assert.deepEqual(after.kdbx.publicCustomData,data.kdbx.publicCustomData);});
