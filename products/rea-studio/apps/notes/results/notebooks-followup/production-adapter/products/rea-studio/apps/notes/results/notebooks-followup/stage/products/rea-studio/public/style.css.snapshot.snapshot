:root{font-family:Inter,Segoe UI,Arial,sans-serif;color:#e7edf8;background:#10151e;color-scheme:dark;--accent:#b8ed88;--line:#2a3444;--panel:#192230;--muted:#9eacc0}
*{box-sizing:border-box}body{margin:0}header{height:70px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 30px;background:#131b26}.brand{font-size:24px;letter-spacing:1px}.brand strong{font-weight:400;color:var(--accent)}.header-note{color:var(--muted);font-size:13px}.shell{display:grid;grid-template-columns:230px minmax(0,1fr);min-height:calc(100vh - 70px)}aside{border-right:1px solid var(--line);padding:24px 16px}.eyebrow{font-size:10px;letter-spacing:2px;color:var(--muted);margin:0 12px 18px}nav{display:grid;gap:6px}nav button{text-align:left;border:0;background:transparent;color:#b8c5d6;border-radius:8px;padding:12px 14px;cursor:pointer;font-size:14px}nav button:hover{background:#202d3c}nav button.active{color:#e0facb;background:#2e4230}.aside-note{font-size:12px;line-height:1.7;color:var(--muted);margin:32px 12px}main{padding:30px 36px;max-width:1600px;width:100%}h1{font-size:28px;font-weight:550;margin:0 0 8px}h2{font-size:18px;font-weight:550}h3{font-size:15px}.muted{color:var(--muted);line-height:1.6}.development-note{font-size:12px;color:#accb9a;background:#1c2c25;border:1px solid #35473b;border-radius:8px;padding:10px 14px;margin:20px 0}.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:20px;margin-bottom:18px}.row{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}.button,button{font:inherit;border-radius:7px;border:1px solid #42546a;background:#253346;color:#e7edf8;padding:9px 14px;cursor:pointer}button:hover,.button:hover{background:#344762}button:disabled{opacity:.5;cursor:wait}button.primary{background:var(--accent);color:#182714;border-color:var(--accent)}input,textarea,select{font:inherit;background:#111a26;color:#e7edf8;border:1px solid #42516a;border-radius:6px;padding:9px 11px;max-width:100%}textarea{width:100%;min-height:180px;line-height:1.6}input[type=checkbox]{width:auto}label{display:grid;gap:7px;font-size:13px;color:#b7c5d8;margin:8px 0}pre{background:#0e1621;border:1px solid var(--line);border-radius:8px;padding:15px;white-space:pre-wrap;overflow-wrap:anywhere;max-height:520px;overflow:auto}code{font-family:Cascadia Code,Consolas,monospace}table{width:100%;border-collapse:collapse}td,th{text-align:left;border-bottom:1px solid var(--line);padding:10px 12px;font-size:13px}th{color:var(--muted)}.status{padding:10px 12px;background:#243429;border-radius:6px;color:#c9ebbc;white-space:pre-wrap}.status.error{background:#3c2530;color:#ffb3b3}a{color:#b9e894}canvas{max-width:100%;border-radius:8px;touch-action:none}svg{max-width:100%}.toolbar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}.empty{padding:30px;text-align:center;color:var(--muted)}.split{display:grid;grid-template-columns:minmax(220px,1fr) minmax(0,3fr);gap:18px}@media(max-width:800px){header{padding:0 18px}.header-note{display:none}.shell{grid-template-columns:1fr}aside{border-right:0;border-bottom:1px solid var(--line);padding:12px}nav{display:flex;overflow:auto}nav button{white-space:nowrap}.aside-note,.eyebrow{display:none}main{padding:20px 16px}.split{grid-template-columns:1fr}}
