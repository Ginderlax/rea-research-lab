import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import {randomUUID} from 'node:crypto';
import {render} from '../keepass-group-active-list-fix-next/products/rea-studio/apps/vault/client.mjs';
import {handle,dispose} from '../keepass-group-active-list-fix-next/products/rea-studio/apps/vault/server.mjs';
class Element {constructor(tag){this.tagName=tag;this.children=[];this.listeners=new Map();this.value='';this.checked=false;this.disabled=false;this.ownText='';this.parentElement=null;}set textContent(value){this.ownText=String(value);for(const c of this.children)c.parentElement=null;this.children=[];}get textContent(){return this.ownText+this.children.map(c=>c.textContent).join('');}append(...items){for(const c of items){if(c.parentElement)c.parentElement.children=c.parentElement.children.filter(x=>x!==c);c.parentElement=this;this.children.push(c);}}replaceChildren(...items){for(const c of this.children)c.parentElement=null;this.children=[];this.ownText='';this.append(...items);}addEventListener(n,cb){this.listeners.set(n,cb);}async click(){if(!this.disabled)return this.listeners.get('click')?.();}}
const descendants=root=>[root,...root.children.flatMap(descendants)],observations=[],secret='Root only synthetic descendant password',gate=()=>{let resolve;const promise=new Promise(r=>resolve=r);return {resolve,promise};};
const button=(root,name)=>{const n=descendants(root).find(e=>e.tagName==='button'&&e.textContent===name);assert(n,'Missing button '+name);return n;};
const field=(root,name)=>{const n=descendants(root).find(e=>e.tagName==='label'&&e.ownText===name);assert(n,'Missing field '+name);return n.children[0];};
const row=(root,title)=>{const n=descendants(root).find(e=>e.tagName==='section'&&e.children.some(c=>c.tagName==='strong'&&c.textContent===title));assert(n,'Missing row '+title);return n;};
test.after(async()=>fs.writeFile(path.join(import.meta.dirname,'observations.json'),JSON.stringify({scope:'Fresh finite independent root DOM model and real candidate handler; completed responses held by owned transport. No HTTP/browser/original.',observations},null,2)+'\n'));
async function fixture(t,name,wrap){const workspace={root:'owned-root-vault-group-'+randomUUID()},store={value:null,get:async()=>structuredClone(store.value),set:async(k,v)=>{store.value=structuredClone(v);}},requests=[],api=(action,input={})=>handle({action,input,workspace,store});await api('create',{password:'Root owned synthetic group master'});const A=(await api('save',{title:'Root A',group:'Parent/Selected',password:secret})).id;await api('save',{title:'Root B',group:'Parent/Selected/Deep',password:'Root only synthetic B'});await api('save',{title:'Root C',group:'Other',password:'Root only synthetic C'});globalThis.document={createElement:tag=>new Element(tag)};const root=new Element('main'),result={name},cleanup=await render(root,async(action,input)=>{requests.push({action,id:input?.id});const real=()=>api(action,input);return wrap?wrap(action,input,real):real();});t.after(()=>{cleanup();dispose(workspace);delete globalThis.document;observations.push({name,requests,result});});return {root,store,api,A,cleanup,result,requests};}
async function command(root,bin=false){await button(root,bin?'Show recycled groups':'Show groups').click();const g=row(root,'Selected'),label=bin?'Permanently delete group and descendants':'Recycle group and descendants';field(g,'Confirm '+label.toLowerCase()).checked=true;return button(g,label);}
async function recycle(f){await (await command(f.root)).click();assert.equal((await f.api('list')).entries.length,1);}

test('completed old entry-bin password read cannot publish after recursive permanent deletion',async t=>{const entered=gate(),release=gate(),f=await fixture(t,'held-bin-password',async(a,i,real)=>{const v=await real();if(a==='recycleRead'){entered.resolve();await release.promise;}return v;});t.after(()=>release.resolve());await recycle(f);await button(f.root,'Show recycle bin').click();const pending=button(row(f.root,'Root A'),'Preview recycled entry').click();await entered.promise;await (await command(f.root,true)).click();assert.equal((await f.api('recycleList')).entries.length,0);release.resolve();await pending;f.result.passwordPublished=descendants(f.root).some(e=>e.value===secret);assert.equal(f.result.passwordPublished,false);assert(!descendants(f.root).some(e=>e.tagName==='strong'&&e.textContent==='Root A'));});

test('completed old bin list cannot resurrect descendant rows after recursive restore',async t=>{const entered=gate(),release=gate();let held=false;const f=await fixture(t,'held-bin-list',async(a,i,real)=>{const v=await real();if(a==='recycleList'&&held){entered.resolve();await release.promise;}return v;});t.after(()=>release.resolve());await recycle(f);held=true;const pending=button(f.root,'Show recycle bin').click();await entered.promise;await button(f.root,'Show recycled groups').click();const g=row(f.root,'Selected');field(g,'Confirm restoring this group and all descendants').checked=true;await button(g,'Restore recycled group').click();assert.equal((await f.api('list')).entries.length,3);release.resolve();await pending;f.result.binHeaderPublished=descendants(f.root).some(e=>e.tagName==='h3'&&e.textContent==='Recycle bin');assert.equal(f.result.binHeaderPublished,false);await button(f.root,'Show recycle bin').click();assert(f.root.textContent.includes('The recycle bin is empty.'));});

test('already displayed password is scrubbed in detached controls before recursive write starts',async t=>{const entered=gate(),release=gate();let held=false;const f=await fixture(t,'prewrite-secret-scrub',async(a,i,real)=>{if(a==='recycleGroupDelete'&&held){entered.resolve();await release.promise;}return real();});t.after(()=>release.resolve());await recycle(f);await button(f.root,'Show recycle bin').click();await button(row(f.root,'Root A'),'Preview recycled entry').click();const password=field(f.root,'Recycled password');assert.equal(password.value,secret);held=true;const control=await command(f.root,true),pending=control.click();await entered.promise;assert.equal((await f.api('recycleList')).entries.length,2);assert.equal(password.value,'');assert(!descendants(f.root).some(e=>e.value===secret));release.resolve();await pending;assert.equal((await f.api('recycleList')).entries.length,0);f.result.detachedSecretScrubbed=true;});

test('unconfirmed group refusal leaves existing entry-bin preview intact and performs no group write',async t=>{const f=await fixture(t,'unconfirmed-control');await recycle(f);await button(f.root,'Show recycle bin').click();await button(row(f.root,'Root A'),'Preview recycled entry').click();await button(f.root,'Show recycled groups').click();const previous=f.requests.filter(r=>r.action==='recycleGroupDelete').length;await button(row(f.root,'Selected'),'Permanently delete group and descendants').click();assert.equal(f.requests.filter(r=>r.action==='recycleGroupDelete').length,previous);assert.equal(field(f.root,'Recycled password').value,secret);assert.equal((await f.api('recycleList')).entries.length,2);f.result.refusalPreservesPreview=true;});

test('completed older active-entry list must not republish deleted descendant rows while group commit response is held',async t=>{const listed=gate(),releaseList=gate(),committed=gate(),releaseCommit=gate();let holdList=false;const f=await fixture(t,'held-active-list-during-group',async(a,i,real)=>{const v=await real();if(a==='list'&&holdList){listed.resolve();await releaseList.promise;}if(a==='recycleGroupDelete'){committed.resolve();await releaseCommit.promise;}return v;});t.after(()=>{releaseList.resolve();releaseCommit.resolve();});const originalRows=[row(f.root,'Root A'),row(f.root,'Root B')];holdList=true;const pendingList=button(f.root,'Search').click();await listed.promise;const control=await command(f.root),pendingGroup=control.click();await committed.promise;assert.deepEqual((await f.api('list')).entries.map(e=>e.title),['Root C']);releaseList.resolve();await pendingList;const republished=descendants(f.root).filter(e=>e.tagName==='strong'&&['Root A','Root B'].includes(e.textContent)).map(e=>e.textContent);f.result.deletedRowsRepublished=republished;f.result.newRowsFromReleasedResponse=republished.length>0&&['Root A','Root B'].every(name=>!originalRows.includes(row(f.root,name)));holdList=false;releaseCommit.resolve();await pendingGroup;assert.deepEqual(republished,[],'Earlier active list must be invalidated when the confirmed recursive group operation starts.');});

test('view disposal while completed bin read is held scrubs current values and suppresses publication',async t=>{const entered=gate(),release=gate(),f=await fixture(t,'disposed-bin-read',async(a,i,real)=>{const v=await real();if(a==='recycleRead'){entered.resolve();await release.promise;}return v;});t.after(()=>release.resolve());await recycle(f);await button(f.root,'Show recycle bin').click();const pending=button(row(f.root,'Root A'),'Preview recycled entry').click();await entered.promise;f.cleanup();release.resolve();await pending;assert(!descendants(f.root).some(e=>e.value===secret));assert(!descendants(f.root).some(e=>e.tagName==='strong'&&e.textContent==='Root A'));f.result.disposalSuppressesPublication=true;});
