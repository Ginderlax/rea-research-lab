    if (/^\s*(?:\d+[.)]|[a-z][.)])\s+/.test(line)) { flush(at - 1); add(trimmed, at + 1, at + 1, 'procedural-step'); continue; }
    if (/^\s*[-*+]\s+/.test(line)) { flush(at - 1); add(trimmed, at + 1, at + 1, 'list-item'); continue; }
