    {
      "id": "grafana.candidate.a284b5cd98dde8d530fa",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Code mode's autocompletion feature works automatically while typing. To manually trigger autocompletion, use the keyboard shortcut <key>Ctrl</key>/<key>Cmd</key> + <key>Space</key>.",
      "headingPath": [
        "Microsoft SQL Server query editor",
        "Code mode",
        "Use autocompletion"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/query-editor/index.md",
