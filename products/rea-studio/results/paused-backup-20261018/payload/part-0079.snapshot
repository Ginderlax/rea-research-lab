    {
      "id": "grafana.candidate.a9cf034789608d413b76",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now set a custom line limit for logs queries instead of accepting the previously hard-coded 500. We also simplified the query editor to only show relevant fields when issuing logs queries.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Grafana OSS features",
        "Data source updates",
        "Elasticsearch data source",
        "Allow setting a custom limit for log queries"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-0.md",
