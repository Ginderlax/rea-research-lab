      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b173e713b8715e1d8501",
      "syntaxRole": "procedural-step",
      "sourceText": "2. In the AWS Console, create a new IAM role, and under **Trusted entity type**, select **Another AWS account** as the trusted Entity.",
      "headingPath": [
        "Configure AWS authentication",
        "Use Grafana Assume Role"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/aws-authentication/index.md",
