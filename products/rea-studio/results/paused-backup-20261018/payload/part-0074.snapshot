        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.f1954e323c7b6c704440",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The remote write target is the Prometheus data source that recorded query data points are written to. You will need a Prometheus with remote write enabled and you will need to create a data source for this Prometheus.",
      "headingPath": [
        "Recorded queries (deprecated)",
        "Using a recorded query",
        "Remote write target"
      ],
      "source": {
        "path": "docs/sources/administration/recorded-queries/index.md",
