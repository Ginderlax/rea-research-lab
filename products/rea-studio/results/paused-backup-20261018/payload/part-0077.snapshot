    },
    {
      "id": "grafana.candidate.7c7b2578b8a409db9504",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If `validate_id_token` is set to `true`, you must configure `jwk_set_url`. Authentication will fail if the JWK Set URL is not provided or if the ID token signature cannot be verified.",
      "headingPath": [
        "Configure GitLab OAuth authentication",
        "Configure GitLab authentication client using the Grafana configuration file",
        "Configure JWT ID token validation"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/gitlab/index.md",
        "gitBlobSha": "60055d69865bdbc143aa7f58e3b08d13b64a58a6",
        "sha256": "11af01f967c74718eb99ac11c02fdfa3c3722d3fb4566916e5a70c0a5ecd2ac5",
        "lineStart": 164,
        "lineEnd": 164,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/gitlab/index.md#L164-L164"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
