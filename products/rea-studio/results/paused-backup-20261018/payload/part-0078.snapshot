          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.526fd8982b8577b0a949",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In this URL, the query parameter `var-filter=key|=|value` applies the configured filter using the `example_key` key, the `=` operator, and the `example_value` value.",
      "headingPath": [
        "Dashboard URL variables",
        "Filters and group by dimensions"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/build-dashboards/create-dashboard-url-variables/index.md",
