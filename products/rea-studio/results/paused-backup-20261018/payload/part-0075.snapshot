    {
      "id": "grafana.candidate.72b8233936c7a9d2834b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Default**: 30 seconds",
      "headingPath": [
        "Group alert notifications",
        "Timing options",
        "Group wait"
