import test from'node:test';import assert from'node:assert/strict';import{compileNativeLinks}from'./native-link.mjs';import{parseNative,nativePreflight,executeNative}from'./native.mjs';
const base=()=>[{id:'tab',type:'tab'},{id:'start',type:'inject',z:'tab',x:100,y:100,props:[],wires:[['out']]},{id:'out',type:'link out',z:'tab',x:200,y:100,links:['in'],wires:[['ignored']]},{id:'in',type:'link in',z:'tab',x:300,y:100,links:['out'],wires:[['debug']]},{id:'debug',type:'debug',z:'tab',x:400,y:100,complete:'true',active:true,tosidebar:true}];
test('union incoming/outgoing duplicates and integer object-key ordering match released compiler contract without input mutation',()=>{const nodes=[{id:'out',type:'link out',links:['z','10','2','z'],wires:[['physical']]},{id:'z',type:'link in',links:['out']},{id:'a',type:'link in',links:['out']},{id:'10',type:'link in'},{id:'2',type:'link in'}],copy=JSON.stringify(nodes),result=compileNativeLinks(nodes);assert.deepEqual(result.nodes.get('out').wires,[['2','10','z','a']]);assert.deepEqual(result.linkConnections.map(c=>c.target),['2','10','z','a']);assert.equal(JSON.stringify(nodes),copy);});
test('missing/falsy outgoing links retain physical wires; an explicitly empty array compiles incoming backrefs',()=>{for(const value of[undefined,null,false,0,'']){const nodes=[{id:'out',type:'link out',wires:[['physical']],...(value===undefined?{}:{links:value})},{id:'in',type:'link in',links:['out']}],result=compileNativeLinks(nodes);assert.deepEqual(result.nodes.get('out').wires,[['physical']]);assert.deepEqual(result.linkConnections,[]);}const nodes=[{id:'out',type:'link out',links:[],wires:[['physical']]},{id:'in',type:'link in',links:['out']}];assert.deepEqual(compileNativeLinks(nodes).nodes.get('out').wires,[['in']]);});
test('native execution follows compiled virtual path, records Link Out event and keeps exact raw JSON document',async()=>{const text=JSON.stringify({opaque:'retained',flows:base()},null,2),info=parseNative(text);assert.deepEqual(info.document.flows[2].wires,[['ignored']]);assert.deepEqual(info.compiledNodes.get('out').wires,[['in']]);const r=await executeNative(text,{messages:[{_msgid:'fixed',payload:{nested:1},_event:'before'}]});assert.deepEqual(r.debug[0].message,{_msgid:'fixed',payload:{nested:1},_event:'node:out'});assert.deepEqual(r.trace.map(x=>x.node),['start','out','in','debug']);assert.equal(JSON.stringify(info.document),JSON.stringify(JSON.parse(text)));});
test('preflight traverses virtual targets and rejects missing/non-LinkIn/unsupported reachable nodes before context effects',()=>{for(const mode of['missing','wrong','unimplemented']){const nodes=base();if(mode==='missing')nodes[2].links=['absent'];if(mode==='wrong')nodes[2].links=['debug'];if(mode==='unimplemented')nodes.push({id:'opaque',type:'function',z:'tab',x:500,y:100,wires:[]}),nodes[3].wires=[['opaque']];const info=parseNative(JSON.stringify(nodes));assert.throws(()=>nativePreflight(info,'start'),/missing|not Link In|not implemented/);}});
test('static Link Out accepts released falsy/default link modes; return/LinkCall retained but cannot execute',async()=>{for(const mode of[undefined,null,false,0,'','link']){const nodes=base();if(mode!==undefined)nodes[2].mode=mode;assert.equal((await executeNative(JSON.stringify(nodes),{messages:[{_msgid:'fixed'}]})).debug[0].message._event,'node:out');}for(const mode of['return','other',true]){const nodes=base();nodes[2].mode=mode;assert.throws(()=>nativePreflight(parseNative(JSON.stringify(nodes))),/not implemented/);}const nodes=base();nodes.push({id:'call',type:'link call',z:'tab',x:500,y:100,links:['in'],wires:[]});nodes[3].wires=[['call']];assert.throws(()=>nativePreflight(parseNative(JSON.stringify(nodes))),/not implemented/);});
test('disabled link nodes and tabs drop deliveries; incoming backref union still supplies enabled routing',async()=>{for(const tab of[false,true]){const nodes=base();if(tab){nodes.push({id:'disabled',type:'tab',disabled:true});nodes[3].z='disabled';}else nodes[3].d=true;assert.equal((await executeNative(JSON.stringify(nodes))).debug.length,0);}const nodes=base();nodes[2].links=[];assert.equal((await executeNative(JSON.stringify(nodes))).debug.length,1);});
test('bounded static link cycles refuse at5000 deliveries and preserve caller inputs/context representation',async()=>{const nodes=base();nodes[3].wires=[['out']];const messages=[{_msgid:'fixed',payload:1}],copy=JSON.stringify(messages);await assert.rejects(executeNative(JSON.stringify(nodes),{messages}),/5,000 deliveries/);assert.equal(JSON.stringify(messages),copy);});
test('link declarations/identities/malformed truthy lists are bounded before execution',()=>{for(const links of[['__proto__'],['constructor'],['prototype'],[1],{},'in'])assert.throws(()=>compileNativeLinks([{id:'out',type:'link out',links}]),/id|arrays/);assert.throws(()=>compileNativeLinks([{id:'out',type:'link out',links:Array(2001).fill('in')}]),/2,000/);assert.throws(()=>compileNativeLinks([{id:'out',type:'link out',links:Array(1500).fill('in')},{id:'in',type:'link in',links:Array(501).fill('out')}]),/2,000/);});
