import fs from'node:fs/promises';import path from'node:path';import{fileURLToPath}from'node:url';import{createHash}from'node:crypto';import{spawn}from'node:child_process';import assert from'node:assert/strict';const own=path.dirname(fileURLToPath(import.meta.url)),stage=path.resolve(own,'../keepass-group-recycle-next'),sha=b=>createHash('sha256').update(b).digest('hex');async function verify(){const mb=await fs.readFile(path.join(stage,'manifest.json'));assert.equal(sha(mb),'048fc56fded29bb89cf43830919c4b717a82d055e531644028b85ef07917e28d');const m=JSON.parse(mb);for(const r of m.inventory){const b=await fs.readFile(path.join(stage,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);}return{records:m.inventory.length,sha256:sha(mb)};}const before=await verify();const sourcePins=[];for(const n of['client.mjs','server.mjs','recycle.mjs']){const b=await fs.readFile(path.join(stage,'products/rea-studio/apps/vault',n));await fs.writeFile(path.join(own,n+'.snapshot'),b);sourcePins.push({path:n,bytes:b.length,sha256:sha(b)});}const child=spawn(process.execPath,['--test','--test-concurrency=1',path.join(own,'probe.test.mjs')],{windowsHide:true}),chunks={stdout:[],stderr:[]};for(const k of Object.keys(chunks))child[k].on('data',b=>chunks[k].push(b));const exit=await new Promise(r=>child.on('close',(code,signal)=>r({code,signal})));for(const k of Object.keys(chunks))await fs.writeFile(path.join(own,k+'.txt'),Buffer.concat(chunks[k]));const after=await verify();const receipt={schema:'rea-vault-group-postfreeze-lifecycle-review/v1',at:new Date().toISOString(),before,after,sourcePins,exit,sourceStable:true,stagedSourceWrites:0,productionWrites:0,actualHTTP:0,browser:0,originalGUI:0,scope:'Two owned finite DOM/real-handler cases against immutable777; negative password republication plus explicit-close control.'};await fs.writeFile(path.join(own,'validation.json'),JSON.stringify(receipt,null,2)+'\n');const inventory=[];for(const n of(await fs.readdir(own)).sort()){const stat=await fs.stat(path.join(own,n));if(stat.isFile()&&n!=='manifest.json'){const b=await fs.readFile(path.join(own,n));inventory.push({path:n,bytes:b.length,sha256:sha(b)});}}const mb=Buffer.from(JSON.stringify({schema:'rea-strict-work-review/v1',inventory,files:inventory.length},null,2)+'\n');await fs.writeFile(path.join(own,'manifest.json'),mb);process.stdout.write(Buffer.concat(chunks.stdout));process.stderr.write(Buffer.concat(chunks.stderr));console.log(JSON.stringify({receipt:sha(await fs.readFile(path.join(own,'validation.json'))),manifest:sha(mb),files:inventory.length}));process.exitCode=exit.code;
