    {
      "id": "grafana.candidate.52c0d79292847cb7d464",
      "syntaxRole": "table-row",
      "sourceText": "| `jwk_set_url`                | No       | Yes                | URL of the JSON Web Key Set (JWKS) endpoint used to verify JWT ID token signatures. Required when ID token validation is enabled. For GitLab.com, use `https://gitlab.com/oauth/discovery/keys`. For self-hosted GitLab instances, use `https://<your-gitlab-domain>/oauth/discovery/keys`.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |                                      |",
      "headingPath": [
        "Configure GitLab OAuth authentication",
        "Configuration options"
      ],
