 'products/rea-studio/requirements/keepass-manual-supplement/manual-contracts.json',
 'products/rea-studio/requirements/keepass-manual-supplement/existing-requirements-binding.json',
];
async function identity(file){const b=await fs.readFile(file);return{bytes:b.length,sha256:sha(b)}}
const bindings=[];for(const p of files)bindings.push({root:'repository',path:p,...await identity(path.join(repo,p))});
for(const p of ['work/keepass-history-production-integration-bundle-ready/integration-validation.json','work/keepass-history-draft-independent-review/review-validation.json','work/keepass-history-integration-independent-review/review-validation.json','work/keepass-history-integration-independent-review/review-manifest.json','work/keepass-history-draft-fix-next/README.md'])bindings.push({root:'workspace',path:p,...await identity(path.join(base,p))});
const json=async p=>JSON.parse(await fs.readFile(path.join(repo,p),'utf8'));
const w=await json(files[0]),s=await json(files[1]),v=await json(files[2]);
const sourceCounts=[w.sources.length,s.sources.length,v.sources.length],capabilityCounts=[w.capabilities.length,s.products.reduce((n,p)=>n+p.capabilities.length,0),v.baselineProducts.reduce((n,p)=>n+p.requirements.length,0)];
assert.equal(sourceCounts.reduce((a,b)=>a+b),159);assert.equal(capabilityCounts.reduce((a,b)=>a+b),232);
const selections=[...w.capabilities.filter(x=>['joplin.notebooks','joplin.note-crud','joplin.search-filters'].includes(x.id)),...s.products.flatMap(x=>x.capabilities).filter(x=>['KP.ENTRY.001','KP.LOCK.001','RESTIC.REPOSITORY.001','RESTIC.CHUNKING.001','RESTIC.BACKUP.001','RESTIC.CHECK.001','RESTIC.RESTORE.001','RESTIC.LOCKING.001'].includes(x.id))];
const supplement=await json('products/rea-studio/requirements/keepass-manual-supplement/manual-contracts.json');assert.equal(supplement.requirements.length,199);const manualSelections=supplement.requirements.filter(x=>['KPM2611-HISTORY-SNAPSHOT','KPM2611-HISTORY-LIST','KPM2611-HISTORY-COUNT-LIMIT','KPM2611-HISTORY-SIZE-LIMIT'].includes(x.id));assert.equal(manualSelections.length,4);
for(const e of bindings)assert.deepEqual(await identity(path.join(e.root==='repository'?repo:base,e.path)),{bytes:e.bytes,sha256:e.sha256});
const result={schema:'rea-work-only-notes-backup-vault-crosswalk-proposal/v1',createdAt:new Date().toISOString(),proposal:'SCOPE-PROPOSAL.md',sourceBindings:bindings,originalCounts:{sourceIdentities:159,capabilityIds:232,sourceCounts,capabilityCounts,unchangedBeforeAndAfter:true},selectedExistingRows:selections,supplement:{totalRows:199,unchangedBeforeAndAfter:true,selectedExistingRows:manualSelections},sourceEpochPolicy:'Historical receipts bind their recorded source bytes. Current runtime identities are recorded separately and do not rebind old behavior evidence. Root current41/global collection is separately attributed, not independently executed here.',requirementsModified:false,productionModified:false,evidenceRebound:false,executions:{behavioralTests:0,originalApplications:0,browser:0,measurements:0},fullProductParity:false,universalSuperiority:false};
await fs.writeFile(path.join(own,'source-binding.json'),JSON.stringify(result,null,2)+'\n');
const manifest=[];for(const p of ['SCOPE-PROPOSAL.md','bind-proposal.mjs','source-binding.json'])manifest.push({path:p,...await identity(path.join(own,p))});
await fs.writeFile(path.join(own,'preservation-manifest.json'),JSON.stringify({schema:'rea-crosswalk-proposal-strict-manifest/v1',count:manifest.length,files:manifest},null,2)+'\n');
console.log(JSON.stringify({receipt:await identity(path.join(own,'source-binding.json')),manifest:await identity(path.join(own,'preservation-manifest.json')),sources:bindings.length,requirementsStable:true}));
