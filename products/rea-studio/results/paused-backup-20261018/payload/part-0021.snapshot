 raw_tree=subprocess.run(['git','ls-tree','-r','-z',actual_head,'--',*sorted(required)],cwd=REPO,capture_output=True,check=True).stdout
 blobs={}
 for entry in raw_tree.split(b'\0'):
  if not entry: continue
  meta,name=entry.split(b'\t',1);mode,kind,sha=meta.decode().split();expect(kind=='blob' and mode=='100644','Regular before source mode');blobs[name.decode()]=sha
 expect(set(blobs)==required,'Complete selected Git closure')
 for name in required:
  data=current(name);expect(hashlib.sha1(b'blob '+str(len(data)).encode()+b'\0'+data).hexdigest()==blobs[name],'Current exact Git bytes '+name)
