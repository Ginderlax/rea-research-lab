import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import {spawnSync} from 'node:child_process';
const here=path.dirname(fileURLToPath(import.meta.url)),studio=path.resolve(here,'../../outputs/rea-research-lab/products/rea-studio'),names=['apps/backup/results/rabin-validation.json','apps/backup/results/rabin-source-before.json','apps/backup/results/rabin-integration.stdout.txt','apps/backup/results/rabin-integration.stderr.txt','scripts/read-rabin-tap.mjs','scripts/verify-backup-rabin.mjs'];
await fs.mkdir(path.join(here,'baseline/final47'),{recursive:true});const rows=[];for(const name of names){const bytes=await fs.readFile(path.join(studio,name)),target='baseline/final47/'+path.basename(name);await fs.writeFile(path.join(here,target),bytes,{flag:'wx'});rows.push({source:name,path:target,bytes:bytes.length,sha256:createHash('sha256').update(bytes).digest('hex')});}
await fs.writeFile(path.join(here,'final47-baseline-manifest.json'),JSON.stringify({createdAt:new Date().toISOString(),scope:'Parent-owned final 47 behavior run exact receipt/source/collector/raw; independent preservation, no behavioral rerun',files:rows},null,2)+'\n',{flag:'wx'});
const old=await fs.readFile(path.join(here,'audit-integration.mjs'));await fs.writeFile(path.join(here,'audit-integration.before-comment-normalization.mjs.snapshot'),old,{flag:'wx'});const run=spawnSync(process.execPath,[path.join(here,'audit-integration.mjs')],{encoding:'utf8',timeout:30000,maxBuffer:1024*1024});await fs.writeFile(path.join(here,'audit-before-comment-normalization.stdout.txt'),run.stdout,{flag:'wx'});await fs.writeFile(path.join(here,'audit-before-comment-normalization.stderr.txt'),run.stderr,{flag:'wx'});console.log(JSON.stringify({preserved:rows,auditExit:run.status}));
