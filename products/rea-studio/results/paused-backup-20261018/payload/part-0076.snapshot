    {
      "id": "grafana.candidate.9ad20cf9a37b35f0fbf8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Trace to metrics lets you navigate from a span in a trace to metrics in a Prometheus or other metrics data source. When configured, a **Metrics for this span** link appears in the trace view.",
      "headingPath": [
        "Configure trace to metrics correlation"
      ],
      "source": {
        "path": "docs/sources/datasources/tempo/configure-tempo-data-source/configure-trace-to-metrics.md",
        "gitBlobSha": "3a874f96d0fd6bc3d0ed6847f9cf1e6fda46c416",
