    },
    {
      "id": "grafana.candidate.f6f34f8c1c8d6dca4851",
      "syntaxRole": "table-row",
      "sourceText": "| `allowed_domains`            | No       | Yes                | List of comma- or space-separated domains. The user should belong to at least one domain to log in.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         |                 |",
      "headingPath": [
