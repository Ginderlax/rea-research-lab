import {fixtureRoot,observationsDirectory} from './harness.mjs';
import assert from 'node:assert/strict';import path from 'node:path';import {fileURLToPath,pathToFileURL} from 'node:url';import fs from 'node:fs/promises';
export const own=path.dirname(fileURLToPath(import.meta.url)),stage=path.resolve(process.env.VAULT_REVIEW_STAGE??own);
if(!stage.startsWith(path.resolve(own,'..')+path.sep))throw new Error('Only owned workspace stage imports accepted.');
const {render}=await import(pathToFileURL(path.join(stage,'client.mjs'))),{handle,dispose}=await import(pathToFileURL(path.join(stage,'server.mjs')));export {render};
export class Element{constructor(tag){this.tagName=tag;this.children=[];this.listeners=new Map();this.value='';this.checked=false;this.ownText='';this.parentElement=null;this.disabled=false;}set textContent(value){this.ownText=String(value);for(const child of this.children)child.parentElement=null;this.children=[];}get textContent(){return this.ownText+this.children.map(child=>child.textContent).join('');}append(...items){for(const child of items){if(child.parentElement)child.parentElement.children=child.parentElement.children.filter(value=>value!==child);child.parentElement=this;this.children.push(child);}}replaceChildren(...items){for(const child of this.children)child.parentElement=null;this.children=[];this.ownText='';this.append(...items);}addEventListener(name,callback){this.listeners.set(name,callback);}async click(){if(!this.disabled)return this.listeners.get('click')?.();}}
export const descendants=root=>[root,...root.children.flatMap(descendants)];
export function button(root,title){const found=descendants(root).find(node=>node.tagName==='button'&&node.textContent===title);assert.ok(found,'Expected button '+title);return found;}
export function field(root,title){const found=descendants(root).find(node=>node.tagName==='label'&&node.ownText===title);assert.ok(found,'Expected field '+title);return found.children[0];}
export function openEntry(root,title){const row=descendants(root).find(node=>node.tagName==='section'&&node.children.some(child=>child.tagName==='strong'&&child.textContent===title));assert.ok(row,'Expected entry row '+title);return button(row,'Open entry').click();}
export function deferred(){let resolve;const promise=new Promise(r=>resolve=r);return{promise,resolve};}
export async function fixture(t,name,wrap){const workspace={root:path.join(fixtureRoot,name+'-'+process.pid)},store={value:null,async get(){return structuredClone(this.value)},async set(key,value){this.value=structuredClone(value)}},requests=[],call=(action,input={})=>handle({action,input,workspace,store}),master='owned synthetic master pass';globalThis.document={createElement:tag=>new Element(tag)};const root=new Element('main'),observation={name,stage};t.after(async()=>{const lock=descendants(root).find(node=>node.tagName==='button'&&node.textContent==='Lock now');if(lock)await lock.click();dispose(workspace);delete globalThis.document;const directory=process.env.VAULT_REVIEW_OUTPUT??path.join(observationsDirectory,'lifecycle-boundaries');await fs.mkdir(directory,{recursive:true});await fs.writeFile(path.join(directory,name+'.json'),JSON.stringify({observation,requests,scope:'Actual staged client/server, owned synthetic in-memory encrypted store, own DOM element model and deterministic held transport'},null,2)+'\n');});await call('create',{password:master});const A=(await call('save',{title:'Entry A',password:'A original',notes:'A content'})).id,B=(await call('save',{title:'Entry B',password:'B original',notes:'B content'})).id;const old=(await call('read',{id:A})).entry;await call('save',{...old,password:'A second'});observation.ids={A,B};const transport=async(action,input)=>{requests.push({action,id:input?.id,title:input?.title});return wrap?wrap(action,input,()=>call(action,input)):call(action,input);};const cleanup=await render(root,transport);return{root,call,store,A,B,master,observation,requests,cleanup};}
export async function beginRestore(root){await openEntry(root,'Entry A');await button(root,'Show entry history').click();await button(root,'View this version').click();field(root,'Confirm restoring this version and saving the current version in history').checked=true;return{start:()=>button(root,'Restore this version').click()};}
