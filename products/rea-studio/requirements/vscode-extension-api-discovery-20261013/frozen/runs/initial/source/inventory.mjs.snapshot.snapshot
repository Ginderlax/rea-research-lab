  ts.forEachChild(n,c=>visit(c,next,depth+1));
 }
 visit(sf,base);
 const qualified=new Map();for(const r of rows){const a=qualified.get(r.qualifiedName)??[];a.push(r);qualified.set(r.qualifiedName,a);}
 function resolve(expression,owner){const parts=owner.namespace?owner.namespace.split('.'):[],candidates=[];for(let i=parts.length;i>=0;i--)candidates.push([...parts.slice(0,i),expression].filter(Boolean).join('.'));candidates.push('vscode.'+expression,expression);for(const q of [...new Set(candidates)]){const a=(qualified.get(q)??[]).filter(r=>['class','interface','type-alias'].includes(r.kind));if(a.length)return a;}return[];}
 for(const r of rows){for(const h of r.heritage){const matches=resolve(h.expression,r);h.targetIDs=matches.map(m=>m.id);h.resolution=matches.length?'source-declaration-link':'unresolved-external-or-unsupported';}for(const d of r.documentation)for(const l of d.links){const candidates=[];if(l.target){let q=l.target.replace('#','.');for(const p of [r.qualifiedName,r.parentQualifiedName,r.namespace,'vscode','']){const a=qualified.get([p,q].filter(Boolean).join('.'));if(a)candidates.push(...a);}}l.targetIDs=[...new Set(candidates.map(x=>x.id))];l.resolution=l.targetIDs.length?'source-declaration-link':'unresolved-textual-reference';}}
 const callableKinds=new Set(['function','method','constructor','call-signature','construct-signature']);const groups=new Map();for(const r of rows)if(callableKinds.has(r.kind)){const key=r.kind+':'+r.qualifiedName+':'+r.modifiers.includes('static');const a=groups.get(key)??[];a.push(r);groups.set(key,a);}
 const overloads=[];for(const [key,a]of groups)if(a.length>1){const id='overload:'+key;overloads.push({id,qualifiedName:a[0].qualifiedName,kind:a[0].kind,declarationIDs:a.map(r=>r.id),count:a.length,scope:'Syntactically repeated callable declarations; no semantic applicability or implementation comparison.'});for(let i=0;i<a.length;i++)a[i].overload={groupID:id,index:i,count:a.length};}
 const kindCounts={};for(const r of rows)kindCounts[r.kind]=(kindCounts[r.kind]??0)+1;
 const inheritance=rows.flatMap(r=>r.heritage.map(h=>({ownerID:r.id,...h}))),comments=rows.flatMap(r=>r.documentation),inline=rows.filter(r=>r.category==='inline-signature'||r.parentID?.startsWith('inline-type:'));
 return{schema:'rea-vscode-extension-api-ast-inventory/v1',source:{fileName,sourceURL,bytes:bytes.length,sha256:hash(bytes),utf16CodeUnits:text.length,lines:sf.getLineStarts().length},parser:{name:'typescript',version:ts.version,parseDiagnostics:0,parseCalls:1},limits,counts:{visitedNodes,maxDepth,declarations:rows.length,documentedDeclarations:rows.filter(r=>r.documented).length,undocumentedDeclarations:rows.filter(r=>!r.documented).length,byKind:kindCounts,eventTypedDeclarations:rows.filter(r=>r.isEvent).length,typeParameters:rows.reduce((a,r)=>a+r.typeParameters.length,0),parameterDeclarations:rows.reduce((a,r)=>a+(r.parameters?.length??0),0),inlineSignatureAndTypeLiteralMembers:inline.length,auxiliaryStructuralRecords:auxiliary.length,privateProtectedExcluded:excluded.length,overloadGroups:overloads.length,overloadDeclarations:overloads.reduce((a,g)=>a+g.count,0),additionalOverloadDeclarations:overloads.reduce((a,g)=>a+g.count-1,0),directHeritageLinks:inheritance.length,resolvedHeritageLinks:inheritance.filter(h=>h.targetIDs.length).length,unresolvedHeritageLinks:inheritance.filter(h=>!h.targetIDs.length).length,documentationComments:comments.length,documentationLinkReferences:comments.reduce((a,d)=>a+d.links.length,0),unsupportedDeclarationForms:unsupported.length},declarations:rows,overloads,inheritance,auxiliary,excluded,unsupported,syntaxKinds,denominator:'Syntactic public declarations in this exact file, including global support types and inline signatures; parameters/type parameters, inherited members and helper structural records are separate counts, never multiplied into named API features.',gaps:['No semantic typechecker or cross-file/import/re-export resolution.','No inherited-member cloning, generic substitution, override/conflict evaluation or recursive inherited API expansion.','Overloads are repeated source declarations, not distinct documented feature or runtime acceptance counts.','Event projections identify direct Event<T>/vscode.Event<T> annota