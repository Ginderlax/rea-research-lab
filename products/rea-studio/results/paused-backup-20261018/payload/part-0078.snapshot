    {
      "id": "grafana.candidate.329b9d501af83d91d5cb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For help with debugging queries, Explore allows you to investigate query requests and responses, as well as query statistics, via the Query inspector. Refer to [Query inspector in Explore](/docs/grafana/<GRAFANA_VERSION>/explore/explore-inspector/) for more information.",
      "headingPath": [
        "Query management in Explore"
      ],
      "source": {
