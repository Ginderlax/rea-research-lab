    {
      "id": "grafana.candidate.ead5b6f3183d1e52f566",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana has built-in time range variables: `$__from` and `$__to`. They're always interpolated as epoch milliseconds by default, but you can control date formatting.",
      "headingPath": [
        "Global variables",
        "`$__from` and `$__to`"
