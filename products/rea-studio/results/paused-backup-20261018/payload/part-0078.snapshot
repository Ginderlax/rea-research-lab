    {
      "id": "grafana.candidate.6e4c4fbc8bf6862fd9e4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you hover your cursor over the cards, a blue plus sign appears beside the card. You can use that to add queries, expressions, or transformations in that position. Hovering your cursor over a card also displays duplicate, hide, and delete actions for a specific data element:",
      "headingPath": [
        "Query and transform data",
        "Navigate the query editor"
