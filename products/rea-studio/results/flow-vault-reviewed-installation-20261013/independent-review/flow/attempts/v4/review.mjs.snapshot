    const declared=map.epochs.find(e=>e.name===name);
    assert(declared);assert.equal(declared.sourceRoot,root);assert.equal(declared.strictPayloads,count);assert.deepEqual(declared.sidecars,sidecars);
    for(const r of j.inventory)expected.set(`${root}/${r.path}`,{bytes:r.bytes,sha256:r.sha256});
    for(const f of sidecars)expected.set(`${root}/${f}`,identity(await read(root,f)));
    check('exact whole source epoch',{name,selectedPayloads:count,sidecars:sidecars.length,privateUninventoriedPrefix:name==='static-link-stage'||name==='textarea-correction'?'.local':null});
  }
  validateMap(map.records,expected);
  assert.equal(map.records.length,830);
  assert.equal(new Set(map.records.map(r=>`${r.bytes}:${r.sha256}`)).size,233);
  check('complete830 direct aliases /233 byte identities /597 duplicate identities');
  const preparation=await parsed(planRoot,'preparation-source-identities.json');
