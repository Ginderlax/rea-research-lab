    },
    {
      "id": "grafana.candidate.f48b71d846792950990e",
      "syntaxRole": "procedural-step",
      "sourceText": "3. Enter the Grafana account id (displayed in the instructions box on the **Settings** tab of the CloudWatch data source configuration) and check the **Require external ID** box.",
      "headingPath": [
        "Configure AWS authentication",
        "Use Grafana Assume Role"
      ],
      "source": {
