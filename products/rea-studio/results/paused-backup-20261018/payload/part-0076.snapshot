    },
    {
      "id": "grafana.candidate.af50bba82111276d7f34",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can compose TraceQL queries in Grafana and Grafana Cloud using **Explore** and a Tempo data source.",
      "headingPath": [
        "Query tracing data",
        "Before you begin"
      ],
      "source": {
        "path": "docs/sources/datasources/tempo/query-editor/_index.md",
        "gitBlobSha": "3d808fd736f68dd2ce682856b4d35c09f6112e32",
        "sha256": "e9e0dc96d5fb0a015ff14ee389f5e3ce8b9f32d4fe29ff7e3595a2c9eb4aabe8",
        "lineStart": 36,
        "lineEnd": 36,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/tempo/query-editor/_index.md#L36-L36"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
