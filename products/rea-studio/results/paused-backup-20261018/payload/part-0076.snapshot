    {
      "id": "grafana.candidate.da89f7a18488286eb927",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Using the Pyroscope data source, you can integrate profiles into your dashboards. For example, you can embed flame graphs using the [flame graph panel](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/panels-visualizations/visualizations/flame-graph/).",
      "headingPath": [
        "Pyroscope data source",
        "Integrate profiles into dashboards"
      ],
