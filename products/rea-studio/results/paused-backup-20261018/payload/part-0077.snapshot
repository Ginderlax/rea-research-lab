    },
    {
      "id": "grafana.candidate.a03391f52467e1fece89",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The propagation specifies the text map propagation format. The values `jaeger` and `w3c` are supported. Add a comma (`,`) between values to specify multiple formats (for example, `\"jaeger,w3c\"`). The default value is `w3c`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[tracing.opentelemetry.jaeger]`",
        "`propagation`"
      ],
      "source": {
