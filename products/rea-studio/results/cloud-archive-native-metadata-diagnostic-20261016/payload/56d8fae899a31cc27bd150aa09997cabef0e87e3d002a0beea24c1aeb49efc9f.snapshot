const authorityRaw=Buffer.from(JSON.stringify(authority,null,2)+'\n');fs.writeFileSync(path.join(stage,'copy-authority.json'),authorityRaw,{flag:'wx'});assert.deepEqual(fs.readFileSync(path.join(stage,'copy-authority.json')),authorityRaw);console.log(JSON.stringify({stage,files:rows.length,bytes:total,roles:roles.length,sourceAliases:70,authority:identity(authorityRaw),manifest:identity(manifestRaw),localProductExecutions:0}));
