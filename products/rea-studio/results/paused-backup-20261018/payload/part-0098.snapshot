import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
import { join } from 'node:path';
import { spawnSync } from 'node:child_process';
import assert from 'node:assert/strict';

const root = 'C:/Users/evanh/Documents/Codex/2026-10-12/go/outputs/rea-backup-2026-10-12';
const meta = join(root, 'metadata');
const cli = join(root, 'runtime/node_modules/rea-agents/scripts/rea.mjs');
const evidence = JSON.parse(readFileSync(join(meta, 'javascript-smoke-evidence.json'), 'utf8').replace(/^\uFEFF/, ''));
assert.equal(evidence.operation, 'analyze_javascript_application');
assert.equal(evidence.normalized_result.statistics.parsed_javascript_files, 2);
assert.equal(evidence.normalized_result.statistics.parse_failures, 0);
const observations = evidence.normalized_result.graph.nodes.flatMap(node => node.observations);
assert(observations.some(item => item.properties?.exported_name === 'findNotes'));
assert(observations.some(item => item.properties?.exported_name === 'normalizeQuery'));
assert(evidence.normalized_result.graph.edges.some(item => item.relation === 'imports' && item.properties?.specifier === './search.js' && item.properties?.resolved_path === 'src/search.js'));

const checks = [];
function run(command, input, name) {
  const inputPath = join(meta, `${name}-input.json`);
  writeFileSync(inputPath, JSON.stringify(input));
  const result = spawnSync(process.execPath, [cli, command, inputPath, '--json'], { encoding: 'utf8', timeout: 120000, maxBuffer: 20 * 1024 * 1024 });
  writeFileSync(join(meta, `${name}-result.json`), result.stdout || '');
  writeFileSync(join(meta, `${name}-stderr.txt`), result.stderr || '');
  assert.equal(result.status, 0, `${name}: ${result.stderr}`);
  const parsed = JSON.parse(result.stdout);
  assert(!parsed.error, `${name}: error result`);
  checks.push({ name, command, exit_code: result.status, operation: parsed.operation ?? null });
  return parsed;
}
