    {
      "id": "grafana.candidate.0647e4b9e41a848c4a2d",
      "syntaxRole": "table-row",
      "sourceText": "| `use_refresh_token`             | No       | Yes                | Enables the use of refresh tokens and checks for access token expiration. When enabled, Grafana automatically adds the `offline_access` scope to the list of scopes.                                                                                                                                                                                                                                                                                                                            | `true`                                               |",
      "headingPath": [
