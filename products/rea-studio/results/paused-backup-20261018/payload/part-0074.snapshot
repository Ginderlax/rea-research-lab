    {
      "id": "grafana.candidate.19cf48ef5e6544fff218",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Data source plugins communicate with external sources of data and return the data in a format that Grafana understands. By adding a data source plugin, you can immediately use the data in any of your existing dashboards.",
