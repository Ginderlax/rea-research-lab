    },
    {
      "id": "grafana.candidate.ea11a1eecbfd09e3ee1c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Tables can be configured and shared with team members via explore URLs or by adding the table to a dashboard panel.",
      "headingPath": [
        "What’s new in Grafana v10.3",
        "Logs",
        "Logs Table UI"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-3.md",
        "gitBlobSha": "e43fdcd331e25519da2fbdea223ad59ec4f7ad4c",
        "sha256": "0e1c94c3c83b280306b5bf6a8543bb3a2707c17132691f3d48d3818f08b029c7",
        "lineStart": 309,
        "lineEnd": 309,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-3.md#L309-L309"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
