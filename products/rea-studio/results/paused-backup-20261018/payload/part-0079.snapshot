    {
      "id": "grafana.candidate.9bcdf9d4ee75b9cc087f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For more details, see the [Auditing docs](../../setup-grafana/configure-security/audit-grafana/).",
