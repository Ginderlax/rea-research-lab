const after=[];for(const [p,r]of seen){assert.deepEqual(identity(await fs.readFile(p)),r);after.push({path:path.relative(workspace,p).replaceAll('\\','/'),...r});}await save('authentication-after.json',{sourceStable:true,files:after.length,records:after,observedReadBytes:readBytes,productionWrites:0});
