import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,workspace=path.resolve(here,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),rows=[];for(const[p,pin]of[['scripts/verify-followup-records.mjs','7727409e4214511af330efb5f61bc1ba6fcb63837638748fea8539bdd9f90969'],['scripts/verify-editor-save-followup.mjs','4b93961b46b79fe901eafcfc3e1eda564803b60a12be411feb58350da604f001'],['products/rea-studio/server.mjs','85fe09b1b52a1d91e9d09c85d99c6e768ac4b793f5d7694a1760a4c0560a0a94']]){const b=await fs.readFile(path.join(repo,p));assert.equal(sha(b),pin);const target=path.join(here,'before',p+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b,{flag:'wx'});rows.push({path:p,bytes:b.length,sha256:sha(b),snapshot:path.relative(here,target).replaceAll('\\','/')});}await fs.writeFile(path.join(here,'source-before.json'),JSON.stringify({at:new Date().toISOString(),rows,currentHostTransitionAlreadyInstalled:true,parentAndChildUnmodified:true},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(rows));
