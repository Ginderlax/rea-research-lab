import fs from 'node:fs/promises';import path from 'node:path';import {spawnSync} from 'node:child_process';import assert from 'node:assert/strict';import {here,sha,authenticateOriginal} from './authenticate-original.mjs';
const[mode,quietFrom]=process.argv.slice(2);assert.ok(['--check-only','--quiet-confirmed'].includes(mode));const manifestBytes=await fs.readFile(path.join(here,'memory-preflight.control.json')),manifest=JSON.parse(manifestBytes);
if(mode==='--quiet-confirmed')assert.ok(/^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{3})?Z$/.test(quietFrom)&&Date.parse(quietFrom)>Date.parse(manifest.checkedAt)&&Date.parse(quietFrom)<=Date.now(),'New coordinator quiet timestamp must follow preflight.');
const boundNames=['timing-runner.mjs','timing-worker.mjs','benchmark.mjs','canonical.mjs','workloads.mjs','authenticate-original.mjs','candidate-baseline.mjs','candidate-wrapper.mjs','selector-algorithm.mjs'],before={};for(const name of boundNames)before[name]=sha(await fs.readFile(path.join(here,name)));
for(const binding of Object.values(manifest.implementations))for(const[file,digest]of Object.entries(binding.files))assert.equal(sha(await fs.readFile(file)),digest);
const fullBytes=await fs.readFile(path.join(here,manifest.fullSemanticReceipt));assert.equal(sha(fullBytes),manifest.fullSemanticReceiptSHA256);const full=JSON.parse(fullBytes);assert.equal(full.candidate.entrySHA256,before['candidate-wrapper.mjs']);assert.equal(full.candidate.helperSHA256,before['selector-algorithm.mjs']);assert.equal(full.failedAcceptanceAttempts,0);
const authority=await authenticateOriginal();assert.deepEqual(authority.files,manifest.authority.files);
for(const fixture of Object.values(manifest.expectedFiles)){assert.equal(sha(await fs.readFile(path.join(here,fixture.path))),fixture.sha256);assert.equal(sha(await fs.readFile(path.join(here,fixture.inputPath))),fixture.inputFileSHA256);}
if(mode==='--quiet-confirmed'){const memoryChecks=JSON.parse(await fs.readFile(path.join(here,'results/memory-harness-checks.control.json')));assert.equal(memoryChecks.status,'passed');assert.equal(memoryChecks.manifestSHA256,sha(manifestBytes));assert.equal(memoryChecks.measurementRun,false);for(const sample of memoryChecks.samples){assert.equal(sample.result.comparisons,21);assert.equal(sample.result.loadedReducerImplementations,1);}const readiness=JSON.parse(await fs.readFile(path.join(here,'results/timing-readiness.json')));assert.equal(readiness.status,'passed');assert.equal(readiness.manifestSHA256,sha(manifestBytes));assert.deepEqual(readiness.sourceHashesBefore,before);assert.deepEqual(readiness.sourceHashesAfter,before);}
const startedAt=new Date().toISOString(),args=mode==='--check-only'?[path.join(here,'timing-worker.mjs'),'check-only','original','all-seven','unused']:[path.join(here,'benchmark.mjs'),'--quiet-confirmed',quietFrom],child=spawnSync(process.execPath,args,{encoding:'utf8',timeout:mode==='--check-only'?60000:600000,maxBuffer:4*1024*1024,windowsHide:true}),stdout=child.stdout??'',stderr=child.stderr??'',after={};for(const name of boundNames)after[name]=sha(await fs.readFile(path.join(here,name)));const sourceStable=JSON.stringify(before)===JSON.stringify(after),stem=(mode==='--check-only'?'timing-readiness':'timing-attempt')+'-'+Date.now();await fs.writeFile(path.join(here,'results',stem+'.stdout.txt'),stdout,{flag:'wx'});await fs.writeFile(path.join(here,'results',stem+'.stderr.txt'),stderr,{flag:'wx'});
let result,failure;if(child.status!==0)failure='Timing branch failed';else try{result=JSON.parse(stdout);if(mode==='--check-only'){assert.equal(result.comparisons,63);assert.equal(result.measurementRun,false);}else assert.equal(result.status,'passed');}catch(error){failure=error.message;}if(!sourceStable)failure??='Timing source changed';
const receipt={schemaVersion:3,checkedAt:new Date().toISOString(),status:failure?'failed':'passed',failure,mode,interval:{start:startedAt,end:new Date().toISOString()},exitCode:child.status,error:child.error?.message,sourceHashesBefore:before,sourceHashesAfter:after,manifestSHA256:sha(manifestBytes),stdout:{path:'results/'+stem+'.stdout.txt',sha256:sha(stdout)},stderr:{path:'results/'+stem+'.stderr.txt',sha256:sha(stderr)},result,timingMeasurementRun:mode==='--quiet-confirmed',memoryMeasurementRun:false,quietFrom:mode==='--quiet-confirmed'?quietFrom:undefined,selectedForIntegration:null,fullProductComplete:false,universalSuperiorityEstablished:false};await fs.writeFile(path.join(here,'results',mode==='--check-only'?'timing-readiness.json':stem+'.json'),JSON.stringify(receipt,null,2)+'\n',{flag:mode==='--check-only'?'wx':'wx'});console.log(JSON.stringify({status:receipt.status,measurementRun:receipt.timingMeasurementRun}));if(failure)process.exitCode=1;
