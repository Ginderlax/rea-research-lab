import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import {spawnSync} from 'node:child_process';
import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)), name=process.argv[2];
assert.ok(/^[a-z][a-z-]*\.mjs$/.test(name));
const bytes=await fs.readFile(path.join(here,name)),sha=value=>createHash('sha256').update(value).digest('hex'),stem='action-'+name.slice(0,-4)+'-'+Date.now();
await fs.writeFile(path.join(here,stem+'.source.mjs.snapshot'),bytes,{flag:'wx'});
const start=new Date().toISOString(),result=spawnSync(process.execPath,[path.join(here,name),...process.argv.slice(3)],{windowsHide:true,encoding:'utf8',timeout:120000,maxBuffer:4*1024*1024}),stdout=result.stdout??'',stderr=result.stderr??'';
for(const [suffix,value]of [['.stdout.txt',stdout],['.stderr.txt',stderr]])await fs.writeFile(path.join(here,stem+suffix),value,{flag:'wx'});
await fs.writeFile(path.join(here,stem+'.json'),JSON.stringify({name,start,end:new Date().toISOString(),exitCode:result.status,signal:result.signal,error:result.error?.message,sourceSHA256:sha(bytes),stdoutSHA256:sha(stdout),stderrSHA256:sha(stderr),newMeasurementRun:false},null,2)+'\n',{flag:'wx'});
process.stdout.write(stdout);process.stderr.write(stderr);process.exitCode=result.status??1;
