    {
      "id": "grafana.candidate.7472a322b7299d5eaa76",
      "syntaxRole": "list-item",
      "sourceText": "- Permission to read a folder. For example, the fixed role `fixed:folders:reader` includes the action `folders:read` and a folder scope `folders:id:`.",
      "headingPath": [
        "Basic and fixed roles permissions",
        "Permissions associated to fixed roles",
        "Alerting roles"
      ],
