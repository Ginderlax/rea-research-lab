      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.23526800bec917adc932",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "There is also experimental support to use the browser location and language to dynamically change the current date format for each user. This feature is disabled by default.",
      "headingPath": [
        "What's new in Grafana v7.2",
        "New date formatting options added"
      ],
