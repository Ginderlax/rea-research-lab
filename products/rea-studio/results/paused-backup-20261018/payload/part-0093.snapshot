      "before": "const collection = JSON.parse(collectionBytes);",
      "after": "const collection = JSON.parse(collectionBytes);\nassert.deepEqual(id(collectionBytes), expectedEpoch.collection);\nassert.equal(collection.jobId, expectedEpoch.jobId);"
