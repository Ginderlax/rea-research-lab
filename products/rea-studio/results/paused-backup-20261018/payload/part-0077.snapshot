          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.6a91d4ae3f90c4f87ce7",
      "syntaxRole": "list-item",
      "sourceText": "- Configure SAML using the [SSO Settings API](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/developers/http_api/sso-settings/)",
      "headingPath": [
        "SAML authentication in Grafana",
