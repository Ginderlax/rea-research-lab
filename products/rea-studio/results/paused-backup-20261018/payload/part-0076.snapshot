    {
      "id": "grafana.candidate.10ed5c131545b0a404bf",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Private data source connect** - _Only for Grafana Cloud users._ Private data source connect, or PDC, allows you to establish a private, secured connection between a Grafana Cloud instance, or stack, and data sources secured within a private network. Click the drop-down to locate the URL for PDC. For more information regarding Grafana PDC refer to [Private data source connect (PDC)](https://grafana.com/docs/grafana-cloud/connect-externally-hosted/private-data-source-connect/).",
      "headingPath": [
        "Configure the MySQL data source",
        "Additional settings"
      ],
