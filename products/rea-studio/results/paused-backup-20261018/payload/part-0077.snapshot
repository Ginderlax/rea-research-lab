    {
      "id": "grafana.candidate.7d89fa943ee774f427f6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set to `true` to disable (hide) the login form, useful if you use OAuth 2.0. Default is `false`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[auth]`",
        "`disable_login_form`"
      ],
      "source": {
