    {
      "id": "grafana.candidate.ce5b848a6ec548cda7d3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Monitor Metrics use a lightweight format that stores only numeric data in a specific structure and supports near real-time scenarios, making it useful for fast detection of issues. In contrast, Azure Monitor Logs can store a variety of data types, each with their own structure.",
      "headingPath": [
        "Azure Monitor query editor",
