    {
      "id": "grafana.candidate.9a7d6af6fef71857c2e0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can then create alert rules that query metrics derived from traces.",
      "headingPath": [
        "Examples of trace-based alerts",
        "Alerting on span metrics"
      ],
      "source": {
