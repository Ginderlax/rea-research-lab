    {
      "id": "grafana.candidate.127b0a149b309f95d1d5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For the Redirect URI to be correct, it might be necessary to set the `root_url` option in the `[server]`section of the Grafana configuration file. For example, if you are serving Grafana behind a proxy.",
      "headingPath": [
