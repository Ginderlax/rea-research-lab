    },
    {
      "id": "grafana.candidate.9f36cf8559d5d77d86c5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, metrics from Grafana itself can be accessed without authentication. This can lead to information leakage.",
      "headingPath": [
        "Configure security hardening",
        "Additional security hardening",
        "Enable auth for metrics"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md",
