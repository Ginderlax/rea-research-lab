    },
    {
      "id": "grafana.candidate.02494db625bed9bdb1c4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "![Table query](/media/docs/postgres/PostgreSQL-query-editor-v11.4.png)",
