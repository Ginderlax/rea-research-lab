import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import {fileURLToPath} from 'node:url';
import {execFile} from 'node:child_process';
import {promisify} from 'node:util';
import {start} from '../../server.mjs';
import {createWorkspace} from '../../lib/storage.mjs';
import {hash} from './restic-crypto.mjs';
import {verifyBatch,verifyUnchanged} from './native-policy-assertions.mjs';
const exec=promisify(execFile),password='synthetic-native-fixture-only-2026',artifact=fileURLToPath(new URL('../../../../projects/09-restic/artifacts/',import.meta.url));
async function filesAt(root,prefix=''){const files={};for(const child of await fs.readdir(path.join(root,prefix),{withFileTypes:true})){const name=prefix?`${prefix}/${child.name}`:child.name;if(child.isDirectory())Object.assign(files,await filesAt(root,name));else files[name]=hash(await fs.readFile(path.join(root,name)));}return files;}
test('private production host batches three-file native capture, preserves exact dedup across restart and restores through HTTP and original',async()=>{
 const root=await fs.mkdtemp(path.join(os.tmpdir(),'rea-pack-host-adapter-'));let host;const commands=[],requests=[];
 try{
  const dataDir=path.join(root,'host-data');host=await start({port:0,dataDir});const workspace=await createWorkspace(path.join(dataDir,'backup/workspace'));await fs.mkdir(workspace.resolve('source/nested/empty'),{recursive:true});const binary=Buffer.alloc(2*1024*1024+47);for(let i=0;i<binary.length;i++)binary[i]=(i*113+Math.floor(i/1024))&255;await fs.writeFile(workspace.resolve('source/binary.bin'),binary);await fs.writeFile(workspace.resolve('source/nested/雪😀.txt'),'Unicode fixture — identical bytes');await fs.writeFile(workspace.resolve('source/empty.txt'),'');const time=new Date('2023-04-05T06:07:08.123Z');await fs.utimes(workspace.resolve('source/binary.bin'),time,time);
  const call=async(action,input={})=>{const response=await fetch(`${host.url}/api/backup/${action}`,{method:'POST',headers:{'content-type':'application/json','x-rea-token':host.token},body:JSON.stringify({repository:'native',password,...input})}),body=await response.json();requests.push({action,status:response.status});assert.equal(response.status,200,JSON.stringify(body));return body.result;};
  await call('nativeInit',{version:2});const first=await call('nativeSnapshot',{source:'source',label:'three-file-host'});assert.equal(first.files,3);await verifyBatch({workspace,snapshot:first,password});const checked=await call('nativeCheck',{id:first.id});assert.equal(checked.files,3);assert.equal(checked.checkedBytes,binary.length+Buffer.byteLength('Unicode fixture — identical bytes'));const second=await call('nativeSnapshot',{source:'source',compression:'off'});await verifyUnchanged({workspace,password});assert.equal((await call('nativeList')).snapshots.length,2);
  await host.close();host=null;host=await start({port:0,dataDir});assert.ok((await call('nativeList')).snapshots.some(s=>s.id===second.id));assert.equal((await call('nativeCheck',{id:second.id})).verified,true);await verifyUnchanged({workspace,password});await call('nativeRestore',{id:second.id,destination:'http-restored',confirm:true});assert.deepEqual(await filesAt(workspace.resolve('http-restored/source')),await filesAt(workspace.resolve('source')));assert.ok((await fs.stat(workspace.resolve('http-restored/source/nested/empty'))).isDirectory());assert.ok(Math.abs((await fs.stat(workspace.resolve('http-restored/source/binary.bin'))).mtimeMs-time.getTime())<1);
  const exeBytes=await fs.readFile(path.join(artifact,'unpacked/restic_0.19.1_windows_amd64.exe'));assert.equal(hash(exeBytes),'b0dd1fd21eea5d8fe1325f55f7118213c21f36de8a261e04c0624a5ab9fd7830');assert.equal(hash(await fs.readFile(path.join(artifact,'restic_0.19.1_windows_amd64.zip'))),'da948ad707ed690426473aaba2046cd61f8f90f6f0e7dab6be0d5796531de67d');const exe=path.join(root,'original-restic.exe');await fs.writeFile(exe,exeBytes,{flag:'wx'});const original=async args=>{assert.equal(hash(await fs.readFile(exe)),'b0dd1fd21eea5d8fe1325f55f7118213c21f36de8a261e04c0624a5ab9fd7830');const result=await exec(exe,['--no-cache','-r',workspace.resolve('native'),...args],{env:{...process.env,RESTIC_PASSWORD:password,RESTIC_PASSWORD_FILE:'',RESTIC_PASSWORD_COMMAND:'',RESTIC_REPOSITORY:''},windowsHide:true,timeout:60000,maxBuffer:4*1024*1024});commands.push({args,exitCode:0,...result});return result.stdout;};assert.match(await original(['check','--read-data']),/no errors were found/);const target=path.join(root,'original-restored');await original(['restore',second.id,'--target',target]);assert.deepEqual(await filesAt(path.join(target,'source')),await filesAt(workspace.resolve('source')));for(const name of ['tmp','locks'])assert.deepEqual(await fs.readdir(workspace.resolve(`native/${name}`)),[]);
  console.log(JSON.stringify({nativePackHostObservation:{requests,commands,firstSnapshot:first.id,secondSnapshot:second.id,fixtureFiles:await filesAt(workspace.resolve('source')),checkedBytes:checked.checkedBytes,restartPersistence:true,exactDataPackAndRowDedup:true,httpRestoreBytesAndMtime:true,originalRestoreBytes:true,ports:'Private ephemeral ports; existing hosts untouched.'}}));
 }finally{if(host)await host.close();assert.equal(path.dirname(root),path.resolve(os.tmpdir()));assert.ok(path.basename(root).startsWith('rea-pack-host-adapter-'));await fs.rm(root,{recursive:true,force:true});}
});
