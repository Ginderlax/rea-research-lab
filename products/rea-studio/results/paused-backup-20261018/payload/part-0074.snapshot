    {
      "id": "grafana.candidate.577154e559ecd7f9fd50",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana reads custom configuration from `<WORKING DIRECTORY>/conf/custom.ini`. You can override the custom configuration path with the `--config` option.",
