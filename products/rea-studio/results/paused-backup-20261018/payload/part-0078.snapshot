    {
      "id": "grafana.candidate.a73ea67ba2f07939dcd4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The display options section contains tabs where you configure almost every aspect of your data visualization.",
      "headingPath": [
        "Panel editor",
        "Panel display options"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/panel-editor-overview/index.md",
        "gitBlobSha": "9af0a8be4aeab58d807b6bcf488720d0ddb59d2d",
        "sha256": "7b79324a1d1da061b81b260dc8c9a97ff42387be973dd63d413e3391fdadc96e",
        "lineStart": 75,
        "lineEnd": 75,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/panels-visualizations/panel-editor-overview/index.md#L75-L75"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
