      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.6b62b10d4c6827729e0e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Duration for which presigned URLs remain valid. Uses Go duration format (e.g., `168h` for 7 days, `6h` for 6 hours). Default is `168h` (7 days).",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[external_image_storage.s3]`",
        "`presigned_url_expiration`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
