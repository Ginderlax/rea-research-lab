import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {here,sha} from './authenticate-original.mjs';
const current=path.join(here,'memory-preflight.control.json'),preserved=path.join(here,'memory-preflight.control.initial-p1.json');assert.equal(path.dirname(current),here);assert.equal(path.dirname(preserved),here);assert.equal(sha(await fs.readFile(current)),'786471ae6bb91263fbb264ad44b30ee553e5195d66ac4a3ce0e5378dacfd5606');try{await fs.stat(preserved);throw Error('Initial manifest already exists');}catch(error){if(error.code!=='ENOENT')throw error;}await fs.rename(current,preserved);
