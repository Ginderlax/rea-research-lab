import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs/promises';
import{fixture,all,field,button}from'./save-review-fixture.mjs';
const tabLabel=root=>all(root).find(n=>n.attributes['aria-pressed']==='true')?.textContent;
const status=root=>all(root).filter(n=>n.attributes.role==='status').map(n=>n.textContent);
test('held old Save cannot overwrite a dirty reopened document with the same file path',async t=>{const f=await fixture(t,'held-out-close-reopen');await button(f.root,'Close tab').onclick();await button(f.root,'a.txt').onclick();assert.equal(f.editor.value,'captured save A\n');f.editor.value='new reopened draft\n';f.editor.oninput();const before=status(f.root);f.release.resolve();await f.pending;assert.equal(f.editor.value,'new reopened draft\n');assert.equal(tabLabel(f.root),'a.txt •');assert.deepEqual(status(f.root),before);await button(f.root,'b.txt').onclick();await button(f.root,'a.txt').onclick();const observed=await f.observe({heldOut:'closed-object response; same path/new document identity'});assert.equal(observed.editorValue,'new reopened draft\n');assert.equal(observed.diskA,'captured save A\n');});
test('new reopened Save revision survives old Save settlement and permits the next real Save',async t=>{const f=await fixture(t,'held-out-reopened-revision');await button(f.root,'Close tab').onclick();await button(f.root,'a.txt').onclick();f.editor.value='second committed reopened A\n';f.editor.oninput();await button(f.root,'Save file').onclick();assert.equal(await fs.readFile(f.workspace.resolve('a.txt'),'utf8'),'second committed reopened A\n');const before=status(f.root);f.release.resolve();await f.pending;assert.deepEqual(status(f.root),before);f.editor.value='third committed reopened A\n';f.editor.oninput();await button(f.root,'Save file').onclick();const observed=await f.observe({heldOut:'different document object accepted new revision before old response'});assert.equal(observed.diskA,'third committed reopened A\n');assert.equal(observed.editorValue,'third committed reopened A\n');assert.equal(tabLabel(f.root),'a.txt');assert.equal(observed.calls.filter(r=>r.action==='save').length,3);});
test('pending same-document keyboard Save is suppressed while enabled typing survives and later Save works',async t=>{const f=await fixture(t,'held-out-pending-duplicate');assert.equal(f.editor.disabled,false);assert.equal(button(f.root,'Save file').disabled,true);f.editor.value='newer keyboard draft\n';f.editor.oninput();let prevented=0;f.editor.onkeydown({ctrlKey:true,key:'s',preventDefault(){prevented++}});f.editor.onkeydown({metaKey:true,key:'s',preventDefault(){prevented++}});await Promise.resolve();await Promise.resolve();assert.equal(prevented,2);assert.equal(f.calls.filter(r=>r.action==='save').length,1);f.release.resolve();await f.pending;assert.equal(f.editor.value,'newer keyboard draft\n');assert.equal(tabLabel(f.root),'a.txt •');assert.equal(button(f.root,'Save file').disabled,false);await button(f.root,'Save file').onclick();const observed=await f.observe({heldOut:'two keyboard attempts during pending same-item Save; typing remains enabled'});assert.equal(observed.calls.filter(r=>r.action==='save').length,2);assert.equal(observed.diskA,'newer keyboard draft\n');assert.equal(tabLabel(f.root),'a.txt');});
test('a different document can save while A response waits; A settlement preserves B success context',async t=>{const f=await fixture(t,'held-out-other-document-save');await button(f.root,'b.txt').onclick();f.editor.value='committed B during held A\n';f.editor.oninput();assert.equal(button(f.root,'Save file').disabled,false);await button(f.root,'Save file').onclick();const before=status(f.root);assert(before.some(s=>s.includes('Saved b.txt')));f.release.resolve();await f.pending;const observed=await f.observe({heldOut:'per-document pending state and selected-document publication'});assert.equal(observed.editorValue,'committed B during held A\n');assert.equal(observed.diskA,'captured save A\n');assert.equal(observed.diskB,'committed B during held A\n');assert.equal(tabLabel(f.root),'b.txt');assert.deepEqual(observed.status,before);});
