 for(const row of[parent,command]){assert.equal(row.countsAddedToTestGroups,false);for(const key of['originalDatabaseExecutions','originalGuiExecutions','originalFullApplicationExecutions'])assert.equal(row[key],0);}for(const row of[...old.bindings,...parent.bindings])assert(/^[0-9a-f]{64}$/.test(row.sha256)&&Number.isInteger(row.startLine)&&Number.isInteger(row.endLine)&&row.endLine>=row.startLine);
