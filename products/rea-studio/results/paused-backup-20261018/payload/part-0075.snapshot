      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c7634360aa90fa78b91c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Using Git Sync, you can manage your dashboards in the UI and synchronize them with your configured Git repository. If you push a change in the repository, those changes are mirrored in your Grafana instance.",
      "headingPath": [
        "Work with provisioned dashboards in Git Sync",
        "Manage dashboards provisioned with Git Sync"
      ],
