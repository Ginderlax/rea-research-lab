        "sha256": "42f0fbcea86ed7f49f166bc9b279b95673f27c4ef505737f7b54ede18c391332",
        "lineStart": 55,
        "lineEnd": 55,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-3.md#L55-L55"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
