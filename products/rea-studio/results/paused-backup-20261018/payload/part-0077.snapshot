    {
      "id": "grafana.candidate.93627309407a7688e2d6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Auto Login:** Automatically redirects to provider login page if user is not logged in \\* for OAuth; Only works if it's the only configured provider",
