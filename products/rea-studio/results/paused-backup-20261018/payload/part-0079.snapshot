    },
    {
      "id": "grafana.candidate.444cc71f87ff7ff2b970",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For even more detail about all the changes in this release, refer to the [changelog](https://github.com/grafana/grafana/blob/main/CHANGELOG.md). For the specific steps we recommend when you upgrade to v12.2, check out our [Upgrade Guide](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/upgrade-guide/upgrade-v12.2/).",
      "headingPath": [
        "What’s new in Grafana v12.2"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v12-2.md",
        "gitBlobSha": "649516652755e085d354800312d36fcb01b36d03",
        "sha256": "d239dfebaabe752d5a3c7ac5157e213879d131b33cbeeab79f1c74ae8d328b86",
        "lineStart": 73,
        "lineEnd": 73,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v12-2.md#L73-L73"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.da42afd73226723280e1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This release reimagines how you explore logs, delivers more ways to connect your data, and enables more intuitive sharing, so you can spend less time navigating tools and more time turning signals into action. It starts with a completely redesigned logs panel that brings faster pattern recognition, clearer context, and a smoother exploration experience. We’ve also expanded what you can do with new data sources and query improvements, from SolarWinds Enterprise to advanced Honeycomb and OpenSearch capabilities.",
      "headingPath": [
        "What’s new in Grafana v12.3"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v12-3.md",
        "gitBlobSha": "bcbb2201f65f44e4c21f94bde0666816f85d611c",
        "sha256": "855e9523da8327a0c850ba3e213e24dab7b28c2ef1c1887d8a955c82b84288ec",
        "lineStart": 51,
        "lineEnd": 51,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v12-3.md#L51-L51"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.15c19a91cbf069642b57",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Sharing insights is easier too, with streamlined dashboard image exports and consolidated panel time controls that make comparisons and overrides more intuitive. And to help you learn as you go, a new interactive learning experience now brings contextual guidance directly into Grafana, giving you tips, tutorials, and documentation right when you need them. All of this comes together to make open observability easier, more accessible, and more powerful for every team.",
      "headingPath": [
        "What’s new in Grafana v12.3"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v12-3.md",
        "gitBlobSha": "bcbb2201f65f44e4c21f94bde0666816f85d611c",
        "sha256": "855e9523da8327a0c850ba3e213e24dab7b28c2ef1c1887d8a955c82b84288ec",
        "lineStart": 53,
        "lineEnd": 53,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v12-3.md#L53-L53"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b64136294d87a53c24b0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For even more detail about all the changes in this release, refer to the [changelog](https://github.com/grafana/grafana/blob/main/CHANGELOG.md). For the specific steps we recommend when you upgrade to v12.3, check out our [Upgrade Guide](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/upgrade-guide/upgrade-v12.3/).",
      "headingPath": [
        "What’s new in Grafana v12.3"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v12-3.md",
        "gitBlobSha": "bcbb2201f65f44e4c21f94bde0666816f85d611c",
        "sha256": "855e9523da8327a0c850ba3e213e24dab7b28c2ef1c1887d8a955c82b84288ec",
        "lineStart": 57,
        "lineEnd": 57,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v12-3.md#L57-L57"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.772f09cf8d0aec2dc774",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The headline is improved dashboard productivity: Dynamic dashboards and template-driven workflows make it far easier to create, reuse, and operate dashboards at scale. Create dashboards from templates, map one variable to multiple values, apply regular expression transforms to variable values or display text, and benefit from smarter visualization suggestions and an updated gauge panel that help surface the right view for your data. At the same time, Git Sync is now available in public preview, providing a smooth Git-backed workflow to keep dashboards in source control and enable safer, auditable changes to dashboard content. These two areas together are aimed at speeding up development, improving consistency, and making dashboard CI/CD practical for teams.",
      "headingPath": [
        "What’s new in Grafana v12.4"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v12-4.md",
        "gitBlobSha": "04ad850f76a1bd6804127ce24fbb0f9df8a2ed6b",
        "sha256": "219e8ff6f6f8af116bbda811cae0768c617c6196d98b4c1f284cb5496bbca8c4",
        "lineStart": 66,
        "lineEnd": 66,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v12-4.md#L66-L66"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.33bfe95e9252338cf717",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Beyond dashboards, this version includes improvements across the product: Logs and Logs Drilldown get better default columns and save/resume log explorations, data sources receive sensible new defaults and expanded support, SCIM provisioning simplifies user and team management, short URLs are now persistent, and a small set of breaking changes and storage migration enhancements help ensure long-term manageability.",
      "headingPath": [
        "What’s new in Grafana v12.4"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v12-4.md",
        "gitBlobSha": "04ad850f76a1bd6804127ce24fbb0f9df8a2ed6b",
        "sha256": "219e8ff6f6f8af116bbda811cae0768c617c6196d98b4c1f284cb5496bbca8c4",
        "lineStart": 68,
        "lineEnd": 68,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v12-4.md#L68-L68"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.2418b2c5a20513fa6cc3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For even more detail about all the changes in this release, refer to the [changelog](https://github.com/grafana/grafana/blob/main/CHANGELOG.md). For the specific steps we recommend when you upgrade to v12.4, check out our [Upgrade Guide](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/upgrade-guide/upgrade-v12.4/).",
      "headingPath": [
        "What’s new in Grafana v12.4"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v12-4.md",
        "gitBlobSha": "04ad850f76a1bd6804127ce24fbb0f9df8a2ed6b",
        "sha256": "219e8ff6f6f8af116bbda811cae0768c617c6196d98b4c1f284cb5496bbca8c4",
        "lineStart": 72,
        "lineEnd": 72,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v12-4.md#L72-L72"
      },
