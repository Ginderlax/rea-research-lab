    {
      "id": "grafana.candidate.b8d1610ae17e18f14bc1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Toggles the insecure communication setting, defaults to `true`. When set to `false`, the OTLP client will use TLS credentials with the default system cert pool for communication.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[tracing.opentelemetry.otlp]`",
        "`insecure`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
