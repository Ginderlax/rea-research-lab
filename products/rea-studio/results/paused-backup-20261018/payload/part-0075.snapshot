    {
      "id": "grafana.candidate.fc369364ae6c083b34e6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Cause:** The default data source timeout in Grafana is 30 seconds, but Azure Log Analytics queries can take up to 3 minutes on the Azure side, especially for complex KQL queries or large time ranges.",
      "headingPath": [
        "Troubleshoot Azure Monitor data source issues",
        "Query errors",
        "Logs query timeout"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/troubleshooting/index.md",
