import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const here=import.meta.dirname,work=path.resolve(here,'..'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),json=v=>Buffer.from(JSON.stringify(v,null,2)+'\n');
async function write(p,b){await fs.writeFile(path.join(here,p),b,{flag:'wx'});}async function tree(root,prefix=''){const list=[];for(const e of await fs.readdir(root,{withFileTypes:true})){assert(!e.isSymbolicLink());const p=prefix+e.name;if(e.isDirectory())list.push(...await tree(path.join(root,e.name),p+'/'));else{assert(e.isFile());list.push(p);}}return list;}
const v=JSON.parse(await fs.readFile(path.join(here,'runs/audit-2026-10-13T05-13-49-445Z/validation.json'))),e=JSON.parse(await fs.readFile(path.join(here,'runs/editor-audit-2026-10-13T05-18-30-550Z/validation.json'))),s=JSON.parse(await fs.readFile(path.join(here,'runs/audit-2026-10-13T05-13-49-445Z/semantic-receipts.json')));assert(v.accepted&&e.accepted);assert.equal(s.initial777.original.assemblyLoads,15);assert.equal(s.initial777.original.calls.originalGUI,0);assert.equal(s.initial777.original.calls.originalProgram,0);assert.equal(s.active343.counts.tests,77);assert.equal(s.active343.counts.pass,77);assert.equal(s.root6.counts.tests,6);assert.equal(s.root6.counts.pass,6);assert.equal(s.http2.counts.tests,2);assert.equal(s.http2.counts.pass,2);assert.equal(s.visibleBrowser.checks.length,8);assert.equal(s.visibleBrowser.finiteBrowserWorkflowsAccepted,true);assert.equal(s.visibleBrowser.automatedTestFunctionCount,0);assert.equal(s.unresolvedBrowser.finiteBrowserAcceptance,false);
const finalAuthorities=[];for(const[name,pin,count]of[['vault-group-publication-plan-next','8a575dd9610bf71a6b81169314d45b023aaff96f629a9648d4af9df5222d9521',325],['editor-pattern-root-installation-plan-next','b5e21ff4810e0b92d066a72deeb8bb41538aed48e499a4bcd8774f8322b81996',637]]){const root=path.join(work,name),raw=await fs.readFile(path.join(root,'manifest.json'));assert.equal(id(raw).sha256,pin);const m=JSON.parse(raw);assert.equal(m.inventory.length,count);assert.deepEqual((await tree(root)).sort(),[...m.inventory.map(r=>r.path),'manifest.json'].sort());for(const r of m.inventory)assert.deepEqual(id(await fs.readFile(path.join(root,r.path))),{bytes:r.bytes,sha256:r.sha256});finalAuthorities.push({name,manifest:{path:'manifest.json',...id(raw)},payloads:count});}
await write('review-validation.json',json({schema:'rea-editor-vault-installation-plans-independent-source-review/v1',at:new Date().toISOString(),editorPlanAccepted:true,vaultPlanAccepted:true,productionWrites:0,publicWrites:0,candidateWrites:0,sourceOnly:true,sourceStable:true,finalAuthorities,perPlanReceipts:{vault:'runs/audit-2026-10-13T05-13-49-445Z/validation.json',editor:'runs/editor-audit-2026-10-13T05-18-30-550Z/validation.json'},vault:{payloads:325,aliases:1703,deduplicatedByteIdentities:316,epochs:10,epochPayloads:1690,manifestAliases:10,freezeSidecarAliases:3,installationRows:16,replacements:4,additions:12,baseline46Exact:true,originalAdapterInverseExact:true,defaultOriginalExecutableAuthenticatedWithoutExecution:true,root6HTTP2Browser8AndInitialOriginal15KeptSeparate:true,selectedGPLSourceLicenseFiles:16},editor:{payloads:637,aliases:1660,uniquePublicPaths:628,distinctByteIdentities:405,initial492Aliases223PublicPaths82ExclusionsPreserved:true,initialWhole573NotCalledPublic:true,strict44Plus141Plus852Plus127Preserved:true,installationRows:14,replacements:4,additions:10,documentationOverlays:3,MITSourceLicenseFiles:5,nativeSelection26AcceptedInHistorical127:true,nativeCancelAccepted:false,saveSpecificNativeCampaignExecuted:false,wholeHostAcceptance:false},sourceOnlyNegativeCollectorGuards:16,collectorFailureHistory:{vaultInitialStrictCensusFailed:true,reason:'Original epoch manifests explicitly exclude .local/**. The first reviewer census counted9 generated local-only observations; frozen source identities were exact. Separatev2 honors only the declared exclusion and retains all old source/error artifacts.',planOrProductFailure:false,editorCollectorFailures:0,recordInspectionConsoleTruncated:true,completeRecordInspectionJSONRetained:true},applicationTests:0,appExecutions:0,originalExecutions:0,originalGUI:0,browserExecutions:0,benchmarks:0,fullProductParity:false,universalSuperiority:false,finiteGaps:['Source-only acceptance authorizes the exact proposed bytes and preservation map; it does not certify installed/current behavior.','Root current original-adapter and installed focused verification remain separate and pending at this plan epoch.','Editor native dirty-close Cancel/Save-specific browser and whole shared-host acceptance remain incomplete; previous browser tab closure is unconfirmed.','Historical receipts are authenticated and their declared counters inspected, not replayed by this source-only reviewer.','Unique public paths and distinct byte hashes are reported separately; original generated/private/native carrier exclusions are retained as source metadata.']}));
const inventory=[];for(const p of(await tree(here)).sort())inventory.push({path:p,...id(await fs.readFile(path.join(here,p)))});await write('review-manifest.json',json({schema:'rea-editor-vault-installation-plans-independent-strict-freeze/v1',files:inventory.length,inventory}));process.stdout.write(JSON.stringify({payloads:inventory.length,manifest:id(await fs.readFile(path.join(here,'review-manifest.json'))),receipt:id(await fs.readFile(path.join(here,'review-validation.json'))),editorPlanAccepted:true,vaultPlanAccepted:true,productionWrites:0})+'\n');
