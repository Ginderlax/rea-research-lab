    },
    {
      "id": "grafana.candidate.1a572e20b851119b9be9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Ensure that the callback URL is the complete HTTP address that you use to access Grafana via your browser, but with the appended path of `/login/generic_oauth`.",
      "headingPath": [
        "Configure Generic OAuth authentication",
        "Configure generic OAuth authentication client using the Grafana configuration file",
