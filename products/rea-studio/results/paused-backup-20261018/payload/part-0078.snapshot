    {
      "id": "grafana.candidate.b45dc288e0991a6851aa",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The template should be flexible enough to capture the target keywords (e.g., prod, staging) by adjusting which label the[`$labels`](https://grafana.com/docs/grafana/latest/alerting/alerting-rules/templates/reference/#labels) is referencing.",
      "headingPath": [
        "Before you begin",
        "Done! Your alerts are now dynamically routed"
