    },
    {
      "id": "grafana.candidate.79590cf0b824fb8a2737",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "After you create a variable, reference it in the query editor using the `$variable` or `${variable}` syntax. You can reference variables in both the profile type field and the label selector.",
      "headingPath": [
        "Pyroscope template variables",
        "Use variables in queries"
      ],
      "source": {
