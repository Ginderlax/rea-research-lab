import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const work=import.meta.dirname,before=path.join(work,'root-vault-group-http-review-next'),after=path.join(work,'root-vault-group-http-review-v2'),sha=b=>createHash('sha256').update(b).digest('hex');
const manifest=await fs.readFile(path.join(before,'manifest.json'));assert.equal(sha(manifest),'fcb9afdc781ca39cb43974dcad47869df324a21878feb1682d0aa20c87795327');for(const row of JSON.parse(manifest).inventory){const b=await fs.readFile(path.join(before,row.path));assert.equal(b.length,row.bytes);assert.equal(sha(b),row.sha256);}
await fs.mkdir(after,{recursive:false});const changes=[];
for(const name of ['http.test.mjs','host-runner.mjs','run.mjs']){const bytes=await fs.readFile(path.join(before,name));let text=bytes.toString();const replacements=name==='http.test.mjs'?[
  ["const observations=[],own=import.meta.dirname,master=", "const activeHosts=new Map(),observations=[],own=import.meta.dirname,master="],
  ["t.after(async()=>{assert.equal(path.dirname(dir)","t.after(async()=>{for(const h of activeHosts.get(dir)??[])await h.close();assert.equal(path.dirname(dir)"],
  ["return {...ready,async close()", "const value={...ready,async close()"],
  ["return expected===200?result.result:result;}};", "return expected===200?result.result:result;}};const owned=activeHosts.get(dir)??[];owned.push(value);activeHosts.set(dir,owned);return value;"],
]:name==='run.mjs'?[["['--test','--test-concurrency=1'","['--test','--test-reporter=tap','--test-concurrency=1'"],["process.exitCode=exit.code??1;","assert(Object.values(counts).every(Number.isSafeInteger),'All finite test totals must be parsed');assert.equal(counts.tests,2);assert.equal(counts.pass,2);assert.equal(counts.fail,0);assert.equal(counts.cancelled,0);assert.equal(counts.skipped,0);assert.equal(counts.todo,0);process.exitCode=exit.code??1;"]]:[];
  for(const [old,newValue] of replacements){assert.equal(text.split(old).length,2,name+' expected unique transform');text=text.replace(old,newValue);}const updated=Buffer.from(text);await fs.writeFile(path.join(after,name),updated,{flag:'wx'});changes.push({path:name,before:{bytes:bytes.length,sha256:sha(bytes)},after:{bytes:updated.length,sha256:sha(updated)},replacements});}
const diagnostic={scope:'Own collector and harness correction only; first product cases passed2/2 but collector parsed spec output as TAP, recording null totals. Initial cleanup removed owned data before idle hosts closed. Frozen first17 and777 remain unchanged.',previousManifestSha256:sha(manifest),changes};await fs.writeFile(path.join(after,'preparation.json'),JSON.stringify(diagnostic,null,2)+'\n',{flag:'wx'});await fs.copyFile(import.meta.filename,path.join(after,'preparation-collector.mjs.snapshot'));console.log(JSON.stringify({stage:after,previousFiles:17,changes:changes.map(c=>c.path)}));
