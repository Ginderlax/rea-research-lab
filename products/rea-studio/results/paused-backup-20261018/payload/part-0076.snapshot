    {
      "id": "grafana.candidate.70a738696003106dcd83",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you use raw query mode, your query must include `WHERE $timeFilter`. You should also provide a group by time and an aggregation function. Otherwise, InfluxDB may return hundreds of thousands of data points, potentially causing your browser to hang.",
      "headingPath": [
        "InfluxDB query editor",
        "InfluxQL query editor",
        "Raw query editor mode"
      ],
