        },
        {
          "before": "async function bsdtar(root) {\n  const bytes = await fs.readFile(path.join(process.env.WINDIR || 'C:/Windows', 'System32/tar.exe')); assert.equal(sha(bytes), '4e598a8cec84af779e3377442fce2b94b976f614ed4c6e5a665e19308fd1e379');\n  const exe = path.join(root, 'bsdtar.exe'); await fs.writeFile(exe, bytes, { flag: 'wx' }); assert.match(command(exe, ['--version'], root).toString(), /bsdtar 3\\.8\\.8.*libzstd\\/1\\.5\\.7/); return args => command(exe, args, root);\n}",
