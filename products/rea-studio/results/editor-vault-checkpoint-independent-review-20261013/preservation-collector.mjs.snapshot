import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import{createHash}from'node:crypto';
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab'),prefix='products/rea-studio/results/editor-vault-checkpoint-independent-review-20261013',dest=path.join(lab,prefix),sha=b=>createHash('sha256').update(b).digest('hex');
const roots=[['suite','editor-vault-suite-independent-review','a9ecb400ee1e34bad15d549301383f4d19372d89118d6e899a7b95f386a94ec4',31],['finalizer','editor-vault-finalizer-independent-review','8006c073f4d828d6688c8b704c3a84d6718450db27c4a7a622d19a88d6fed3d6',10]];
const rows=[],authorities=[];
async function list(dir,prefix=''){const out=[];for(const e of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){assert(!e.isSymbolicLink());if(e.isDirectory())out.push(...await list(path.join(dir,e.name),prefix+e.name+'/'));else{assert(e.isFile());out.push(prefix+e.name);}}return out;}
async function save(name,b,sourcePath){const p=path.join(dest,name);await fs.mkdir(path.dirname(p),{recursive:true});await fs.writeFile(p,b,{flag:'wx'});rows.push({sourcePath,path:name,bytes:b.length,sha256:sha(b)});}
async function verify(folder,pin,count){const b=await fs.readFile(path.join(folder,'manifest.json'));assert.equal(sha(b),pin);const m=JSON.parse(b);assert.equal(m.inventory.length,count);for(const r of m.inventory){const x=await fs.readFile(path.join(folder,r.path));assert.equal(x.length,r.bytes);assert.equal(sha(x),r.sha256);}return b;}
await fs.mkdir(dest);
for(const [role,name,pin,count]of roots){const folder=path.join(work,name);await verify(folder,pin,count);const names=await list(folder);for(const n of names)await save(role+'/'+n+'.snapshot',await fs.readFile(path.join(folder,n)),'work/'+name+'/'+n);await verify(folder,pin,count);authorities.push({role,manifestSHA256:pin,payloadFiles:count,allRegularFiles:names.length,sourceStable:true});}
await save('finalization.json.snapshot',await fs.readFile(path.join(work,'editor-vault-finalization-next/finalization.json')),'work/editor-vault-finalization-next/finalization.json');
await save('preservation-collector.mjs.snapshot',await fs.readFile(import.meta.filename),'work/'+path.basename(import.meta.filename));
const m={schema:'rea-editor-vault-checkpoint-independent-preservation/v1',at:new Date().toISOString(),snapshots:rows,authorities,sourceOnly:true,newAppOriginalBrowserBenchmarkExecutions:0,priorRunActualOriginalManagedLoads:15,priorRunOriginalTestGroups:7,oldReceiptsRebound:false,fullProductParity:false,universalSuperiority:false};
const mb=Buffer.from(JSON.stringify(m,null,2)+'\n');await fs.writeFile(path.join(dest,'preservation-manifest.json'),mb,{flag:'wx'});
console.log(JSON.stringify({snapshots:rows.length,manifestSHA256:sha(mb),publicPrefix:prefix}));
