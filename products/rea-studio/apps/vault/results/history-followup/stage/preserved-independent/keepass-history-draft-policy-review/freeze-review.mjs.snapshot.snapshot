import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
const own=path.dirname(fileURLToPath(import.meta.url)),sha=b=>createHash('sha256').update(b).digest('hex'),base=path.resolve(own,'..'),stage=path.join(base,'keepass-history-selection-fix-next');
async function fingerprint(file){const b=await fs.readFile(file);return{bytes:b.length,sha256:sha(b)}}
async function verify(root,name,expected){const file=path.join(root,name),identity=await fingerprint(file);if(identity.sha256!==expected)throw new Error('Manifest identity mismatch '+file);const m=JSON.parse(await fs.readFile(file,'utf8'));for(const e of m.files){const p=path.resolve(root,e.path);if(!p.startsWith(path.resolve(root)+path.sep))throw new Error('Unconfined source entry');const a=await fingerprint(p);if(a.bytes!==e.bytes||a.sha256!==e.sha256)throw new Error('Changed '+p)}return{path:file,...identity,count:m.files.length,allEntriesMatch:true};}
const authenticated=await Promise.all([
verify(stage,'selection-preservation-manifest.json','d6c09b4a6e4d45b3729ad8c8692b2352686e8e7e88e5ad791905fbb26b8b52de'),
verify(path.join(base,'keepass-history-independent-review'),'review-manifest.json','659a694609e032da24f51b625d9f6528b0d9a5c3e558c9bc0d9fe7a0cf6f35d1'),
verify(path.join(base,'keepass-history-selection-independent-review'),'review-manifest.json','df87b099e0234bb611b76dd6079e09482f526696037a0124bd4374318738dd6d')]);
const run=JSON.parse(await fs.readFile(path.join(own,'runs/initial-policy/validation.json'),'utf8'));await fs.mkdir(path.join(own,'baseline'),{recursive:true});for(const e of run.sourceFingerprints){const b=await fs.readFile(path.join(stage,e.path));if(sha(b)!==e.sha256)throw new Error('Changed implementation');await fs.writeFile(path.join(own,'baseline',e.path+'.snapshot'),b)}
const receipt={schema:'rea-independent-keepass-dirty-restore-review-final/v1',createdAt:new Date().toISOString(),status:'FROZEN_REVIEW_WITH_CONFIRMED_FINDING',authenticated,run:{...await fingerprint(path.join(own,'runs/initial-policy/validation.json')),counts:run.counts,sourceStable:run.sourceStable},candidateFingerprints:run.sourceFingerprints,finding:{priority:'P2',trigger:'Unsaved Notes in the same editor before confirmed Restore',observed:'Draft lost; one historyRestore request and encrypted record changes',expected:'Refuse restore and preserve the dirty editor without issuing the effect',originalSource:run.originalSource},limits:run.scope};await fs.writeFile(path.join(own,'review-validation.json'),JSON.stringify(receipt,null,2)+'\n');
async function walk(dir){let files=[];for(const e of await fs.readdir(dir,{withFileTypes:true})){if(e.name==='.local')continue;const file=path.join(dir,e.name);if(e.isDirectory())files.push(...await walk(file));else if(!['review-manifest.json','freeze.json'].includes(e.name))files.push({path:path.relative(own,file).split(path.sep).join('/'),...await fingerprint(file)})}return files;}
const files=(await walk(own)).sort((a,b)=>a.path.localeCompare(b.path)),manifest={schema:'rea-independent-keepass-dirty-restore-review-manifest/v1',count:files.length,files};await fs.writeFile(path.join(own,'review-manifest.json'),JSON.stringify(manifest,null,2)+'\n');const freeze={schema:'rea-independent-keepass-review-freeze/v1',count:files.length,receipt:await fingerprint(path.join(own,'review-validation.json')),manifest:await fingerprint(path.join(own,'review-manifest.json'))};await fs.writeFile(path.join(own,'freeze.json'),JSON.stringify(freeze,null,2)+'\n');console.log(JSON.stringify(freeze));
