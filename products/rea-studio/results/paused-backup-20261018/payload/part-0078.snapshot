    {
      "id": "grafana.candidate.2f212d607cbf609f9eb7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can copy and paste the time range from a dashboard to **Explore** and vice versa, or from one dashboard to another. Click the **Copy time range to clipboard** icon to copy the current time range to the clipboard. Then paste the time range into **Explore** or another dashboard.",
      "headingPath": [
        "Use dashboards",
        "Set dashboard time range",
        "Common time range controls",
        "Copy and paste time range"
      ],
      "source": {
