    {
      "id": "grafana.candidate.9beecb5d364a42214981",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The Share shortened link capability allows you to create smaller and simpler URLs of the format `/goto/:uid` instead of using longer URLs with query parameters. To create a shortened link to the executed query, click the **Share** option in the Explore toolbar.",
      "headingPath": [
        "Get started with Explore",
        "Share shortened link"
      ],
      "source": {
        "path": "docs/sources/visualizations/explore/get-started-with-explore.md",
