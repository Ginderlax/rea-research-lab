    },
    {
      "id": "grafana.candidate.fe18842bde8b99d049d5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Consider using the `$__auto` variable in your Loki metric queries, which will automatically be substituted with the [step value](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/loki/query-editor/#options) for range queries, and with the selected time range's value (computed from the starting and ending times) for instant queries.",
      "headingPath": [
        "Loki template variables",
        "Use the `$__auto` variable for Loki metric queries"
      ],
      "source": {
        "path": "docs/sources/datasources/loki/template-variables/index.md",
