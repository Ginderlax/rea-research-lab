    {
      "id": "grafana.candidate.ccc900b6f1852c91dbc4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This transformation enables rows in returned data to be converted into separate fields. Prior to this enhancement, you could style and configure fields individually, but not rows. For more information, refer to [Rows to fields transform].",
      "headingPath": [
        "What's new in Grafana v8.1",
        "Annotation panel",
        "Transformations improvements",
        "Rows to fields (Beta)"
      ],
