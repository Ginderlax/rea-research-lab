    {
      "id": "grafana.candidate.c0d7f8b54a64cc99c259",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To navigate in the reverse direction, from a metric to its associated trace, configure exemplars in your Prometheus data source. Refer to [Exemplars](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/fundamentals/exemplars/) for setup instructions.",
      "headingPath": [
        "Configure trace to metrics correlation",
        "Link from metrics to traces"
      ],
      "source": {
