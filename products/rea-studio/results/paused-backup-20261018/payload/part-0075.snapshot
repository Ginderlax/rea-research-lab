    },
    {
      "id": "grafana.candidate.b34bbf9a7b176afbf2c5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Git Sync functionalities are constantly evolving. [Contact Grafana](https://grafana.com/help/) for support or to report any issues you encounter and help us improve this feature.",
      "headingPath": [
        "Add non-provisioned resources from Grafana"
      ],
      "source": {
