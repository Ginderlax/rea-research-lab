    },
    {
      "id": "grafana.candidate.8fac9ed7ba64e5ffaa7d",
      "syntaxRole": "list-item",
      "sourceText": "- The first four lines of the virtualhost configuration are standard, so we won’t go into detail on what they do.",
      "headingPath": [
        "Configure auth proxy authentication",
        "Making Apache’s auth work together with Grafana’s AuthProxy",
        "Apache BasicAuth",
        "Apache configuration"
      ],
      "source": {
