import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
const own=path.dirname(fileURLToPath(import.meta.url)), workspace=path.resolve(own,'../..'), prior=path.join(workspace,'WORK/keepass-group-recycle-next');
const hash=b=>createHash('sha256').update(b).digest('hex');
async function write(p,b){const file=path.join(own,p);await fs.mkdir(path.dirname(file),{recursive:true});await fs.writeFile(file,b);}
const manifestBytes=await fs.readFile(path.join(prior,'manifest.json'));
if(hash(manifestBytes)!=='048fc56fded29bb89cf43830919c4b717a82d055e531644028b85ef07917e28d')throw new Error('Prior manifest pin mismatch.');
const manifest=JSON.parse(manifestBytes);if(manifest.files!==777||manifest.inventory.length!==777)throw new Error('Prior roster mismatch.');
for(const r of manifest.inventory){const b=await fs.readFile(path.join(prior,r.path));if(b.length!==r.bytes||hash(b)!==r.sha256)throw new Error('Prior inventory mismatch '+r.path);}
const baseline=[];
for(const r of manifest.inventory.filter(r=>/^products\/rea-studio\/apps\/vault\/[^/]+$/.test(r.path)||/^products\/rea-studio\/lib\/[^/]+$/.test(r.path))){const b=await fs.readFile(path.join(prior,r.path));await write(r.path,b);await write('baseline/'+r.path+'.snapshot',b);baseline.push(r);}
for(const r of manifest.inventory.filter(r=>r.path.startsWith('source-study/')||r.path.startsWith('manual-study/'))){await write(r.path,await fs.readFile(path.join(prior,r.path)));}
await write('authority/group-recycle-manifest.json.snapshot',manifestBytes);
for(const name of ['source-provenance.json','authority-baseline.json','contract-map.json'])await write('authority/'+name+'.snapshot',await fs.readFile(path.join(prior,name)));
const archive=path.join(workspace,'WORK/keepass-history-draft-fix-next/.local/KeePass-2.61.1-Source.zip'),archiveBytes=await fs.readFile(archive);
if(archiveBytes.length!==5333853||hash(archiveBytes)!=='711bd9ec7076661678469e51bae876debac07a08c32f1b1c6b3b8fe5e761c13a')throw new Error('Original source carrier mismatch.');
const original=path.join(workspace,'outputs/rea-research-lab/projects/07-keepass/artifacts/portable/KeePass.exe'),exe=await fs.readFile(original);
if(hash(exe)!=='04d29636c393f0c1fc99ff739295494be3adefded93271e44591e8e300225a5a')throw new Error('Original managed assembly mismatch.');
await write('baseline.json',JSON.stringify({schema:'rea-vault-group-edit-baseline/v1',createdAt:new Date().toISOString(),stageManifest:{source:'WORK/keepass-group-recycle-next/manifest.json',sha256:hash(manifestBytes),verifiedInventoryCount:777},files:baseline,sourceArchive:{source:path.relative(workspace,archive).replaceAll('\\','/'),bytes:archiveBytes.length,sha256:hash(archiveBytes)},originalAssembly:{source:path.relative(workspace,original).replaceAll('\\','/'),bytes:exe.length,sha256:hash(exe)},originalBinariesCopied:false,scope:'Isolated group creation and name/notes candidate. No publication or production edits.'},null,2)+'\n');
console.log(JSON.stringify({verifiedPrior:777,copiedBaseline:baseline.length,originalBinariesCopied:false}));
