    {
      "id": "grafana.candidate.3c4d8a5c398c44c85c23",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Starting with Grafana release `12.4.0` , the `grafana/grafana-oss` Docker Hub repository will no longer be updated. Instead, we encourage you to use the `grafana/grafana` Docker Hub repository. These two repositories have the same Grafana OSS docker images.",
