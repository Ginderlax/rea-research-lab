const definitions = [
  { name: 'formats.test.mjs', beforeSHA: '7a7847d60b34ead39b597aac54c1612f616ffe69b9a267e193bb01fc78554c98', anchor: "import { createWorkspace } from '../../lib/storage.mjs';", old: `async function bsdtar(root) {
  const original = path.join(process.env.WINDIR || 'C:/Windows', 'System32/tar.exe'); const bytes = await fs.readFile(original);
  assert.equal(sha(bytes), '4e598a8cec84af779e3377442fce2b94b976f614ed4c6e5a665e19308fd1e379', 'The recorded Windows bsdtar oracle changed; rebind explicitly before claiming this comparison.');
  const executable = path.join(root, 'oracle-bsdtar.exe'); await fs.writeFile(executable, bytes, { flag: 'wx' }); assert.match(command(executable, ['--version'], root).toString(), /bsdtar 3\\.8\\.8 - libarchive 3\\.8\\.8/);
  return args => command(executable, args, root);
}`, next: `async function bsdtar(root) {
  const executable = await prepareOriginalBsdtar(root, 'oracle-bsdtar.exe');
  assert.match(command(executable, ['--version'], root).toString(), /bsdtar 3\\.8\\.8 - libarchive 3\\.8\\.8/);
  return args => command(executable, args, root);
}`, patch: 'formats-bsdtar-pair.patch' },
  { name: 'zstd.test.mjs', beforeSHA: 'b50927498b32b96dd40096618a0a412b7a9a54a9548a40cd76fe23c0fba6dbaa', anchor: "import { installerPath, bootstrapPath } from './bootstrap-original.mjs';", old: `async function bsdtar(root) {
  const bytes = await fs.readFile(path.join(process.env.WINDIR || 'C:/Windows', 'System32/tar.exe')); assert.equal(sha(bytes), '4e598a8cec84af779e3377442fce2b94b976f614ed4c6e5a665e19308fd1e379');
  const exe = path.join(root, 'bsdtar.exe'); await fs.writeFile(exe, bytes, { flag: 'wx' }); assert.match(command(exe, ['--version'], root).toString(), /bsdtar 3\\.8\\.8.*libzstd\\/1\\.5\\.7/); return args => command(exe, args, root);
}`, next: `async function bsdtar(root) {
  const exe = await prepareOriginalBsdtar(root, 'bsdtar.exe');
  assert.match(command(exe, ['--version'], root).toString(), /bsdtar 3\\.8\\.8.*libzstd\\/1\\.5\\.7/);
  return args => command(exe, args, root);
}`, patch: 'zstd-bsdtar-pair.patch' },
];
const transitions = [];
for (const definition of definitions) {
  const appPath = 'products/rea-studio/apps/archive/' + definition.name, before = fs.readFileSync(path.join(lab, appPath));
  assert.equal(sha(before), definition.beforeSHA);
  const text = before.toString('utf8'), eol = text.includes('\r\n') ? '\r\n' : '\n';
  const adaptations = [{ before: definition.anchor, after: definition.anchor + eol + helperImport }, { before: definition.old.replaceAll('\n', eol), after: definition.next.replaceAll('\n', eol) }];
  let afterText = text;
  for (const adaptation of adaptations) { assert.equal(afterText.split(adaptation.before).length, 2, 'Source-authoring anchor must be exact and unique'); afterText = afterText.replace(adaptation.before, adaptation.after); }
  const beforeRow = save('before/' + appPath + '.snapshot', before, 'unchanged active source before-image');
  const afterRow = save('after/' + appPath + '.snapshot', Buffer.from(afterText), 'source-text transform from the exact before-image and work-only patch');
  transitions.push({ target: appPath, before: { sourcePath: beforeRow.path, ...identity(before) }, after: { sourcePath: afterRow.path, ...identity(Buffer.from(afterText)) }, patch: 'plan/' + definition.patch + '.snapshot', adaptations });
}
