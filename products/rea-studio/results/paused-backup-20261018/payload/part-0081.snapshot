no_link(source);no_link(metadata)
control={name:json_file(metadata/(name+'.json'))for name in ['run','jobs','artifacts','tested-commit','tested-tree','branch-commit','branch-tree']}
run=control['run'];assert str(run['id'])==RUN and run['head_sha']==HEAD and run['run_attempt']==ATTEMPT and run['status']=='completed'
assert run['repository']['full_name']==REPOSITORY and run['head_repository']['full_name']==REPOSITORY
