import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath,pathToFileURL} from 'node:url';
import {createHash} from 'node:crypto';
import {spawn} from 'node:child_process';
import assert from 'node:assert/strict';
const root=fileURLToPath(new URL('./',import.meta.url)),name=process.argv[2],out=path.join(root,'runs',name),hash=b=>createHash('sha256').update(b).digest('hex');assert.match(name,/^[a-z0-9-]+$/);await fs.mkdir(out,{recursive:true});
async function sources(dir=root,prefix=''){let rows=[];for(const e of await fs.readdir(dir,{withFileTypes:true})){const rel=prefix+e.name;assert.equal(e.isSymbolicLink(),false);if(e.isDirectory()){if(!['runs','.local'].includes(e.name))rows.push(...await sources(path.join(dir,e.name),rel+'/'));}else if(!['validation.json','manifest.json','freeze.json'].includes(rel)){const b=await fs.readFile(path.join(dir,e.name));rows.push({path:rel,bytes:b.length,sha256:hash(b)});}}return rows.sort((a,b)=>a.path.localeCompare(b.path));}
const before=await sources();for(const r of before){const target=path.join(out,'source',r.path+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});await fs.copyFile(path.join(root,r.path),target,fs.constants.COPYFILE_EXCL);}await fs.writeFile(path.join(out,'source-before.json'),JSON.stringify(before,null,2)+'\n',{flag:'wx'});
const files=process.argv.slice(3);assert.ok(files.length);const args=['--test','--test-reporter=tap','--test-concurrency=1',...files],env={...process.env,NOTES_REVIEW_OUTPUT:pathToFileURL(path.join(root,'.local/observations/')).href};delete env.NODE_TEST_CONTEXT;await fs.mkdir(path.join(root,'.local/observations'),{recursive:true});
const result=await new Promise(resolve=>{const p=spawn(process.execPath,args,{cwd:root,env,windowsHide:true,stdio:['ignore','pipe','pipe']}),stdout=[],stderr=[];let bytes=0,problem=null;const timer=setTimeout(()=>{problem='Focused owned suite180s limit';p.kill();},180000);for(const [name,stream]of[['stdout',p.stdout],['stderr',p.stderr]])stream.on('data',b=>{bytes+=b.length;if(bytes>8*1024*1024){problem='Captured output exceeds8MiB';p.kill();}else(name==='stdout'?stdout:stderr).push(b);});p.once('error',e=>problem=e.message);p.once('close',(code,signal)=>{clearTimeout(timer);resolve({code,signal,problem,stdout:Buffer.concat(stdout),stderr:Buffer.concat(stderr)});});});
await fs.writeFile(path.join(out,'stdout.txt'),result.stdout);await fs.writeFile(path.join(out,'stderr.txt'),result.stderr);const after=await sources();await fs.writeFile(path.join(out,'source-after.json'),JSON.stringify(after,null,2)+'\n');for(const name of await fs.readdir(path.join(root,'.local/observations'))){const b=await fs.readFile(path.join(root,'.local/observations',name));assert.ok(b.length<=8*1024*1024);await fs.mkdir(path.join(out,'observations'),{recursive:true});await fs.writeFile(path.join(out,'observations',name),b);}
const text=result.stdout.toString(),counts=Object.fromEntries(['tests','pass','fail','skipped','cancelled'].map(n=>[n,Number(new RegExp('^# '+n+' (\\d+)$','m').exec(text)?.[1]??NaN)]));assert.ok(Object.values(counts).every(Number.isFinite));const receipt={schema:'rea-notes-publication-fix-focused-run/v1',at:new Date().toISOString(),node:process.version,args,exitCode:result.code,problem:result.problem,counts,sourceStable:JSON.stringify(before)===JSON.stringify(after),before,after,stdoutSha256:hash(result.stdout),stderrSha256:hash(result.stderr)};await fs.writeFile(path.join(out,'validation.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({run:name,exit:result.code,...counts,sourceStable:receipt.sourceStable}));if(result.code||!receipt.sourceStable||result.problem)process.exitCode=1;
