import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import fs from 'node:fs/promises';
import path from 'node:path';
import {spawn} from 'node:child_process';
const script=import.meta.filename,work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab'),studio=path.join(lab,'products/rea-studio'),publicRoot=path.join(studio,'apps/backup/results/pack-aggregation-followup');
const run=path.join(work,'backup-pack-integration-runs',new Date().toISOString().replaceAll(':','-')),sha=b=>createHash('sha256').update(b).digest('hex');
await fs.mkdir(run,{recursive:true});
const save=async(n,b)=>{const p=path.join(run,n);await fs.mkdir(path.dirname(p),{recursive:true});await fs.writeFile(p,b,{flag:'wx'});};
const preservationBytes=await fs.readFile(path.join(publicRoot,'preservation-manifest.json'));assert.equal(sha(preservationBytes),'77228c9ebbac44fa66f5eac9adab810038da21b46c57749098dec9ed4daa32e0');const preservation=JSON.parse(preservationBytes);
async function authenticatePreservation(){for(const e of preservation.snapshots){const b=await fs.readFile(path.join(publicRoot,e.path));assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256);}for(const e of preservation.copies){const b=await fs.readFile(path.join(lab,e.path));assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256);}}
await authenticatePreservation();
const names=['server.mjs','catalog.mjs','package.json','scripts/test-all.mjs','scripts/verify-development.mjs'];
for(const dir of ['apps/backup','lib'])for(const e of await fs.readdir(path.join(studio,dir),{withFileTypes:true}))if(e.isFile()&&/\.(mjs|json|md)$/.test(e.name))names.push(dir+'/'+e.name);names.sort();
const fingerprint=async p=>{const b=await fs.readFile(path.join(studio,p));return {path:p,bytes:b.length,sha256:sha(b)};};const before=await Promise.all(names.map(fingerprint));
for(const e of before)await save('source/'+e.path+'.snapshot',await fs.readFile(path.join(studio,e.path)));
const runnerBytes=await fs.readFile(script);await save('verify-backup-pack-integration.mjs.snapshot',runnerBytes);
const runtimeSHA=sha(await fs.readFile(process.execPath)),startedAtUtc=new Date().toISOString(),env={...process.env};delete env.NODE_TEST_CONTEXT;
const selectedTests=names.filter(p=>p.endsWith('.test.mjs')),args=['--test','--test-concurrency=1','--test-reporter=tap',...selectedTests];
const result=await new Promise(resolve=>{const c=spawn(process.execPath,args,{cwd:studio,env,shell:false,windowsHide:true,stdio:['ignore','pipe','pipe']}),out=[],err=[];let ob=0,eb=0,failure=null;const stop=reason=>{failure??=reason;c.kill('SIGKILL');};for(const [stream,parts,key,cap]of[[c.stdout,out,'out',16*1024*1024],[c.stderr,err,'err',4*1024*1024]])stream.on('data',b=>{const used=key==='out'?ob:eb,take=Math.max(0,Math.min(cap-used,b.length));parts.push(Buffer.from(b.subarray(0,take)));if(key==='out')ob+=take;else eb+=take;if(take<b.length)stop('retained log limit');});c.on('error',e=>failure??=e.message);const timer=setTimeout(()=>stop('900-second owned test child deadline'),900000);c.on('close',(exitCode,signal)=>{clearTimeout(timer);resolve({pid:c.pid,exitCode,signal,failure,stdout:Buffer.concat(out),stderr:Buffer.concat(err)});});});
const completedAtUtc=new Date().toISOString();await save('stdout.txt',result.stdout);await save('stderr.txt',result.stderr);
const text=result.stdout.toString(),summary=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(n=>[n,Number(text.match(new RegExp('^# '+n+' (\\d+)$','m'))?.[1]??-1)]));const durationMs=Number(text.match(/^# duration_ms ([\d.]+)$/m)?.[1]??-1),after=await Promise.all(names.map(fingerprint));
await save('source-before.json',JSON.stringify(before,null,2)+'\n');await save('source-after.json',JSON.stringify(after,null,2)+'\n');
const attempt={schema:'rea-backup-pack-integration-attempt/v1',startedAtUtc,completedAtUtc,summary,durationMs,exitCode:result.exitCode,signal:result.signal,failure:result.failure,sourceStable:JSON.stringify(before)===JSON.stringify(after),before,after,arguments:args,runtime:{version:process.version,platform:process.platform,sha256:runtimeSHA}};
await save('attempt.json',JSON.stringify(attempt,null,2)+'\n');assert.deepEqual(after,before);assert.equal(result.exitCode,0);assert.equal(result.failure,null);assert.ok(summary.tests>54);assert.equal(summary.pass,summary.tests);for(const key of ['fail','cancelled','skipped','todo'])assert.equal(summary[key],0);
const markers=name=>[...text.matchAll(new RegExp('^# (\\{\"'+name+'\":.+\\})$','gm'))].map(m=>JSON.parse(m[1])[name]);
const packPolicy=markers('nativePackPolicyObservation'),host=markers('nativePackHostObservation'),smallMutation=markers('nativeSmallMutationObservation'),ownership=markers('packOperationOwnershipObservations'),mutationFixture=markers('nativeMutationFixture');
assert.equal(packPolicy.filter(o=>o.phase==='first-snapshot').length,3);for(const o of packPolicy.filter(o=>o.phase==='first-snapshot')){assert.equal(o.allStorageHeaderPayloadAndIndexVerified,true);assert.equal(o.dataPacks,1);assert.equal(o.uniqueDataBlobs,2);assert.equal(o.dataRows.length,2);}assert.equal(packPolicy.filter(o=>o.phase==='repeat-snapshot').length,4);for(const o of packPolicy.filter(o=>o.phase==='repeat-snapshot')){assert.equal(o.addedDataPacks,0);assert.equal(o.addedDataRows,0);}
assert.equal(host.length,1);assert.equal(host[0].restartPersistence,true);assert.equal(host[0].exactDataPackAndRowDedup,true);assert.equal(host[0].httpRestoreBytesAndMtime,true);assert.equal(host[0].originalRestoreBytes,true);assert.equal(host[0].commands.length,2);assert.equal(smallMutation.length,2);assert.equal(ownership.length,1);assert.equal(ownership[0].length,17);assert.equal(mutationFixture.length,1);assert.equal(mutationFixture[0].sha256,'30ef6132bb13a7945b1f5c5d8155ccc607a315f1fc5272f7f560b3bac491c366');
await authenticatePreservation();assert.equal(sha(await fs.readFile(script)),sha(runnerBytes));assert.equal(sha(await fs.readFile(process.execPath)),runtimeSHA);
const receipt={schema:'rea-backup-pack-integration-validation/v1',startedAtUtc,completedAtUtc,summary,durationMs,exitCode:0,sourceStable:true,implementationFingerprints:before,selectedTests,observations:{packPolicy,host,smallMutation,ownership:ownership[0],mutationFixture},runnerSHA256:sha(runnerBytes),runtime:attempt.runtime,arguments:args,preservationSHA256:sha(preservationBytes),adaptation:{runtimeChanged:true,packAggregationIntegrated:true,dataPackTargetBytes:16777216,overlapRejectedBeforeMutation:true,sourceMutationFixtureOnly:'4 MiB+1 to owned deterministic24 MiB+1, preserving generic authenticated structure/dedup and all original check/restore assertions',existingOriginalCheckRestoreAssertionsRetained:true},limits:{childDeadlineMs:900000,stdoutBytes:16777216,stderrBytes:4194304,selectedSourceInventoryOnly:true,rootChildKillOnlyNoDescendantIsolationClaim:true,cooperativeTrustedLocalOriginals:true},fullParity:false,universalSuperiority:false,performanceCompared:false};
await save('validation.json',JSON.stringify(receipt,null,2)+'\n');
const publicRun=path.join(publicRoot,'integration-runs',path.basename(run));await fs.mkdir(publicRun,{recursive:true});
async function walk(dir,prefix=''){const entries=[];for(const e of await fs.readdir(dir,{withFileTypes:true})){const p=prefix?prefix+'/'+e.name:e.name;if(e.isDirectory())entries.push(...await walk(path.join(dir,e.name),p));else entries.push(p);}return entries;}
const retained=[];for(const n of (await walk(run)).sort()){const b=await fs.readFile(path.join(run,n)),p=path.join(publicRun,n);await fs.mkdir(path.dirname(p),{recursive:true});await fs.writeFile(p,b,{flag:'wx'});retained.push({path:'integration-runs/'+path.basename(run)+'/'+n,bytes:b.length,sha256:sha(b)});}
const receiptBytes=await fs.readFile(path.join(run,'validation.json'));await fs.writeFile(path.join(publicRoot,'integration-validation.json'),receiptBytes,{flag:'wx'});const runManifest={schema:'rea-backup-pack-integration-run-preservation/v1',recordedAtUtc:new Date().toISOString(),retained,receiptSHA256:sha(receiptBytes),runPath:'integration-runs/'+path.basename(run),exactCopies:true};const runBytes=JSON.stringify(runManifest,null,2)+'\n';await fs.writeFile(path.join(publicRoot,'integration-run-manifest.json'),runBytes,{flag:'wx'});
console.log(JSON.stringify({summary,durationMs,sourceFiles:before.length,sourceStable:true,packPolicyObservations:packPolicy.length,ownershipCases:ownership[0].length,hostOriginalExecutions:2,smallMutationCases:2,manifestSHA256:sha(runBytes),receiptSHA256:sha(receiptBytes)}));
