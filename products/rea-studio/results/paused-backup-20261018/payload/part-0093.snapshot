// Read-only two-job focused evidence collection; captured source is never executed.
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import {spawnSync} from 'node:child_process';
import {createHash} from 'node:crypto';
const RUN='PENDING_RUN',HEAD='PENDING_HEAD',ATTEMPT='1';
const JOBS={finite:'PENDING_FINITE_JOB',browser:'PENDING_BROWSER_JOB'};
const READER='unpack-notes36-installed-PENDING-v1.py',READER_BYTES='PENDING_READER_BYTES',READER_SHA256='PENDING_READER_SHA256';
assert(/^\d+$/.test(RUN)&&/^[0-9a-f]{40}$/.test(HEAD)&&Object.values(JOBS).every(value=>/^\d+$/.test(value))&&new Set(Object.values(JOBS)).size===2&&Number.isSafeInteger(READER_BYTES)&&/^[0-9a-f]{64}$/.test(READER_SHA256),'UNBOUND template refuses before filesystem, credentials or API');
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab'),repo='/repos/Ginderlax/rea-research-lab';
const sha=bytes=>createHash('sha256').update(bytes).digest('hex'),identity=bytes=>({bytes:bytes.length,sha256:sha(bytes)});
const jobNames={finite:'finite-twenty-one-file-selection',browser:'eight-real-chromium-scenarios'};
async function exists(file){try{await fs.lstat(file);return true;}catch(error){if(error.code==='ENOENT')return false;throw error;}}
async function regular(file,maximum){const stat=await fs.lstat(file);assert(stat.isFile()&&!stat.isSymbolicLink()&&stat.size<=maximum);const bytes=await fs.readFile(file);assert.equal(bytes.length,stat.size);return bytes;}
const credential=spawnSync('git',['credential','fill'],{cwd:lab,env:{...process.env,GIT_TERMINAL_PROMPT:'0',GCM_INTERACTIVE:'Never'},input:'protocol=https\nhost=github.com\n\n',encoding:'utf8',windowsHide:true,timeout:20000,maxBuffer:128*1024});assert.equal(credential.status,0,'Saved GitHub authentication unavailable');
const fields=Object.fromEntries(credential.stdout.split('\n').filter(line=>line.includes('=')).map(line=>{const at=line.indexOf('=');return[line.slice(0,at),line.slice(at+1)];}));assert(fields.password);
const headers={Accept:'application/vnd.github+json','User-Agent':'REA-committed-Notes36-focused-backup','X-GitHub-Api-Version':'2022-11-28',Authorization:'Bearer '+fields.password};
async function response(endpoint,maximum,allowed=[200]){assert(endpoint.startsWith(repo+'/'));const reply=await fetch('https://api.github.com'+endpoint,{headers,signal:AbortSignal.timeout(60000)});assert(allowed.includes(reply.status),'Read-only GitHub GET failed');const length=Number(reply.headers.get('content-length'));assert(!length||length<=maximum);let count=0;const chunks=[];for await(const chunk of reply.body){count+=chunk.length;assert(count<=maximum);chunks.push(chunk);}return{status:reply.status,bytes:Buffer.concat(chunks)};}
const initial=await Promise.all(['run','jobs','artifacts'].map(async kind=>{const {bytes}=await response(repo+'/actions/runs/'+RUN+(kind==='run'?'':'/'+kind),512*1024);return{kind,bytes,value:JSON.parse(bytes)};}));
const [run,jobs,artifacts]=initial.map(row=>row.value);assert.equal(String(run.id),RUN);assert.equal(String(run.run_attempt),ATTEMPT);assert.equal(run.head_sha,HEAD);assert.equal(run.head_branch,'codex/rea-cloud-recovery-20261015');assert.equal(run.repository.full_name,'Ginderlax/rea-research-lab');assert.equal(run.path,'.github/workflows/notes-new-todo-installed-cloud.yml');assert(['push','workflow_dispatch'].includes(run.event));assert.equal(jobs.total_count,2);assert.equal(jobs.jobs.length,2);
const selected={};for(const role of ['finite','browser']){const matches=jobs.jobs.filter(job=>String(job.id)===JOBS[role]);assert.equal(matches.length,1);const job=matches[0];assert.equal(job.name,jobNames[role]);assert.equal(String(job.run_id),RUN);assert.equal(job.head_sha,HEAD);assert(job.labels.includes('windows-2022'));selected[role]=job;}
const terminal=run.status==='completed'&&Object.values(selected).every(job=>job.status==='completed');
const folder=path.join(work,'cloud-verification-backups','run-'+RUN);await fs.mkdir(folder,{recursive:true});const control=path.join(folder,'notes36-installed-control-plane-'+(terminal?'completed-':'observation-')+new Date().toISOString().replace(/[:.]/g,'-'));await fs.mkdir(control);
const metadata=[];for(const row of initial){const file=path.join(control,row.kind+'.json');await fs.writeFile(file,row.bytes,{flag:'wx'});assert.deepEqual(await fs.readFile(file),row.bytes);metadata.push({kind:row.kind,path:file,...identity(row.bytes)});}
const summary={schema:'rea-notes36-installed-readonly-collection/v1',collectedAtUtc:new Date().toISOString(),runId:RUN,headSHA:HEAD,runAttempt:ATTEMPT,runStatus:run.status,runConclusion:run.conclusion,jobs:Object.fromEntries(Object.entries(selected).map(([role,job])=>[role,{jobId:String(job.id),status:job.status,conclusion:job.conclusion}])),metadata,roles:[],bothAccepted:false,localCandidateExecutions:0,localProductExecutions:0,localTests:0,localBuilds:0,localSyntaxChecks:0,localBrowserExecutions:0,installationJournalAuthenticated:false,countsCombinedAcrossRoles:false,fullParity:false,superiority:false};
if(!terminal){summary.collectionState='Nonterminal raw API snapshot only; no completed artifact/source/behavior acceptance.';await fs.writeFile(path.join(control,'nonterminal-observation.json'),JSON.stringify(summary,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(summary));}
else{
 async function saveApi(kind,endpoint,maximum){const {bytes}=await response(endpoint,maximum),value=JSON.parse(bytes),file=path.join(control,kind+'.json');await fs.writeFile(file,bytes,{flag:'wx'});assert.deepEqual(await fs.readFile(file),bytes);summary.metadata.push({kind,path:file,...identity(bytes)});return value;}
 const commit=await saveApi('commit',repo+'/git/commits/'+HEAD,512*1024);assert.equal(commit.sha,HEAD);assert(/^[0-9a-f]{40}$/.test(commit.tree.sha));const tree=await saveApi('tree',repo+'/git/trees/'+commit.tree.sha+'?recursive=1',16*1024*1024);assert.equal(tree.sha,commit.tree.sha);assert.equal(tree.truncated,false);
 assert.equal(artifacts.total_count,artifacts.artifacts.length);assert(artifacts.artifacts.length<=2);const artifactNames=new Set();for(const artifact of artifacts.artifacts){assert(!artifactNames.has(artifact.name));artifactNames.add(artifact.name);assert(['finite','browser'].some(role=>artifact.name==='notes36-installed-'+role+'-'+RUN+'-'+ATTEMPT));assert.equal(String(artifact.workflow_run.id),RUN);assert.equal(artifact.workflow_run.head_sha,HEAD);}
 const reader=path.join(work,READER),readerBytes=await regular(reader,256*1024);assert.equal(readerBytes.length,READER_BYTES);assert.equal(sha(readerBytes),READER_SHA256);
 for(const role of ['finite','browser']){
  const job=selected[role],roleSummary={role,jobId:JOBS[role],jobConclusion:job.conclusion,accepted:false};summary.roles.push(roleSummary);
  const logged=await response(repo+'/actions/jobs/'+JOBS[role]+'/logs',4*1024*1024,[200,404,410]);const logFile=path.join(control,'job-'+JOBS[role]+'-logs'+(logged.status===200?'.txt':'-unavailable.json'));await fs.writeFile(logFile,logged.bytes,{flag:'wx'});assert.deepEqual(await fs.readFile(logFile),logged.bytes);roleSummary.rawJobLog={path:logFile,httpStatus:logged.status,...identity(logged.bytes),available:logged.status===200};
  const matches=artifacts.artifacts.filter(artifact=>artifact.name==='notes36-installed-'+role+'-'+RUN+'-'+ATTEMPT);assert(matches.length<=1);
  if(!matches.length){roleSummary.evidenceState='No artifact for this actual terminal role; raw API/log availability retained without backup or acceptance claim.';continue;}
  const artifact=matches[0];assert.equal(job.runner_group_name,'GitHub Actions');assert.equal(artifact.expired,false);assert(Number.isSafeInteger(artifact.id)&&artifact.id>0&&artifact.size_in_bytes>0&&artifact.size_in_bytes<=16*1024*1024);assert(/^sha256:[0-9a-f]{64}$/.test(artifact.digest));
  const expected=artifact.digest.slice(7),zip=path.join(folder,'artifact-'+artifact.id+'.zip');if(!await exists(zip)){const {bytes}=await response(repo+'/actions/artifacts/'+artifact.id+'/zip',16*1024*1024);assert.equal(bytes.length,artifact.size_in_bytes);assert.equal(sha(bytes),expected);await fs.writeFile(zip,bytes,{flag:'wx'});}const zipped=await regular(zip,16*1024*1024);assert.equal(zipped.length,artifact.size_in_bytes);assert.equal(sha(zipped),expected);roleSummary.artifact={artifactId:String(artifact.id),path:zip,...identity(zipped)};
  const report=path.join(folder,'artifact-'+artifact.id+'-notes36-installed-reader-v1','local-notes36-installed-backup-verification.json');
  if(!await exists(report)){
   const child=spawnSync('C:/Users/evanh/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/python.exe',[reader,zip,expected,role,RUN,HEAD,control],{encoding:'utf8',windowsHide:true,timeout:120000,maxBuffer:4*1024*1024});const stdout=Buffer.from(child.stdout??''),stderr=Buffer.from(child.stderr??'');for(const[kind,bytes]of [['stdout',stdout],['stderr',stderr]])await fs.writeFile(path.join(control,role+'-reader-'+kind+'.txt'),bytes,{flag:'wx'});roleSummary.backupReaderInvocation={reader:READER,...identity(readerBytes),exitCode:child.status,signal:child.signal??null,error:child.error?{name:child.error.name,code:child.error.code??null}:null,stdout:identity(stdout),stderr:identity(stderr)};
   if(child.status!==0){roleSummary.evidenceState='Original uploaded ZIP retained; data-only reader failed. No readable completeness or acceptance claim.';continue;}
  }
  const verified=JSON.parse(await regular(report,4*1024*1024));assert.equal(verified.runId,RUN);assert.equal(verified.sourceCommit,HEAD);assert.equal(verified.role,role);assert.equal(verified.artifactSHA256,expected);assert.equal(verified.allCRCAndBytesReadable,true);assert(Array.isArray(verified.files)&&verified.files.length<=2500);assert.equal(typeof verified.recordedContractPassed,'boolean');
  roleSummary.backupVerification={path:report,...identity(await fs.readFile(report))};roleSummary.readabilityVerified=true;roleSummary.readableFileCount=verified.files.length;roleSummary.recordedContractPassed=verified.recordedContractPassed;roleSummary.evidenceConsistencyErrors=verified.evidenceConsistencyErrors;roleSummary.actualProductTests=verified.attempt?.productTests??null;
  if(verified.recordedContractPassed){assert.equal(verified.attempt.status,'passed');assert.equal(verified.attempt.productTests,role==='finite'?111:8);}
  roleSummary.accepted=job.conclusion==='success'&&logged.status===200&&verified.recordedContractPassed===true;
 }
 summary.bothAccepted=run.conclusion==='success'&&summary.roles.length===2&&summary.roles.every(row=>row.accepted===true);
 summary.collectionState='Separate finite/browser raw bytes and acceptance results retained. bothAccepted requires actual run plus both jobs and both strict reader contracts; no counts are added.';
 const payload=JSON.stringify(summary,null,2)+'\n',file=path.join(control,'notes36-installed-collection-summary-v1.json');await fs.writeFile(file,payload,{flag:'wx'});assert.deepEqual(JSON.parse(await fs.readFile(file,'utf8')),summary);console.log(JSON.stringify(summary));
}
"""Portable ZIP/source evidence reader only. Never imports or executes product code.
This pending-identity template MUST be versioned to an exact completed run first.
"""
import hashlib,io,json,re,stat,struct,sys,tarfile,traceback,zipfile,zlib
if not __debug__:raise RuntimeError("All backup assertions are mandatory; optimization refused")
from pathlib import Path
RUN='PENDING_ACTUAL_RUN_ID'
HEAD='PENDING_COMMITTED_HEAD'
JOBS={'finite':'PENDING_FINITE_JOB_ID','browser':'PENDING_BROWSER_JOB_ID'}
assert re.fullmatch(r'[0-9]+',RUN) and re.fullmatch(r'[0-9a-f]{40}',HEAD) and all(re.fullmatch(r'[0-9]+',value)for value in JOBS.values())and len(set(JOBS.values()))==2,'Unbound template refuses before files or API access'
WORK=Path(__file__).resolve().parent;LAB=WORK.parent/'outputs/rea-research-lab'
source=Path(sys.argv[1]).resolve();expected=sys.argv[2];ROLE=sys.argv[3]
assert ROLE in ('finite','browser') and len(sys.argv)==7 and sys.argv[4:6]==[RUN,HEAD]
CONTROL=Path(sys.argv[6]).resolve();assert CONTROL.is_relative_to(source.parent)and CONTROL.parent==source.parent and CONTROL.name.startswith('notes36-installed-control-plane-')
assert source.is_relative_to((WORK/'cloud-verification-backups').resolve()) and source.parent.name=='run-'+RUN
assert re.fullmatch(r'[0-9a-f]{64}',expected)
sha=lambda b:hashlib.sha256(b).hexdigest()
identity=lambda b:{'bytes':len(b),'sha256':sha(b)}
pin=lambda r:{k:r[k]for k in ('bytes','sha256')}
PREFIX='products/rea-studio/'
BUNDLE=PREFIX+'experiments/notes-new-todo/bundle.json'
HELPER='products/rea-studio/scripts/verify-notes36-installed-cloud.mjs'
DECLARATION='products/rea-studio/results/notes36-source-transition-20261016/current-source-declaration.json'
COLLECTOR='products/rea-studio/scripts/verify-notes36-cloud.mjs'
WORKFLOW='.github/workflows/notes-new-todo-installed-cloud.yml'
SPEC='products/rea-studio/browser-tests/notes-new-todo.spec.mjs'
