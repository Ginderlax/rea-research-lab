    },
    {
      "id": "grafana.candidate.8c09ad4b96dfd8d53fc0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Require email validation before sign up completes or when updating a user email address. Default is `false`.",
      "headingPath": [
