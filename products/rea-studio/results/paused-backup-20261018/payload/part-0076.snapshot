          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.82dc6ffb2f4ac941106e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In conjunction with **Group by**, you can set a positive number in the **Limit** input to limit the maximum number of time series returned by the data source.",
      "headingPath": [
        "Query profile data",
        "Pyroscope query editor",
        "Query options"
      ],
      "source": {
        "path": "docs/sources/datasources/pyroscope/query-editor/index.md",
        "gitBlobSha": "f610ea6b5c725af436b9ddfad56ce462b258b8f0",
        "sha256": "c2bb15fd3956e70aee467819618adca7470b3f5b2a1f9f22afee217306b82382",
        "lineStart": 129,
