import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';
const root=path.dirname(fileURLToPath(import.meta.url)),stage=path.resolve(root,'../notes-trash-next'),hash=b=>createHash('sha256').update(b).digest('hex');
const fp=async file=>{const b=await fs.readFile(file);return{path:file,bytes:b.length,sha256:hash(b)};};
const manifest=JSON.parse(await fs.readFile(path.join(stage,'preservation-manifest.json')));for(const row of manifest.records){const actual=await fp(path.join(stage,row.path));if(actual.bytes!==row.bytes||actual.sha256!==row.sha256)throw new Error('Stage mutated '+row.path);}
const client=await fs.readFile(path.join(stage,'products/rea-studio/apps/notes/client.mjs'),'utf8'),old=await fs.readFile(path.join(stage,'baseline/products/rea-studio/apps/notes/client.mjs.snapshot'),'utf8');
const save=text=>text.slice(text.indexOf('  async function saveNote()'),text.indexOf('  save.onclick'));
if(save(client)!==save(old))throw new Error('Pre-existing classification must be reconsidered');
for(const p of['original/LICENSE.snapshot','SOURCE-CONTRACTS.md','license-and-special-id-provenance.json']){const out=path.join(root,'source-baseline',p+'.snapshot');await fs.mkdir(path.dirname(out),{recursive:true});await fs.copyFile(path.join(stage,p),out);}
const obs=JSON.parse(await fs.readFile(path.join(root,'failures/bounds-expectation-v1/observations.json'))),helper=obs.find(o=>o.case==='held-out released restore');
const sources=(JSON.parse(await fs.readFile(path.join(root,'source-before.json'))));
const receipt={schema:'rea-notebook-trash-independent-finite-review/v1',completedAt:new Date().toISOString(),status:'frozen-findings-parent-coordinated',productionModified:false,candidateModified:false,requirementsModified:false,stage:{root:'work/notes-trash-next',manifest:await fp(path.join(stage,'preservation-manifest.json')),receipt:await fp(path.join(stage,'trash-validation.final.json')),authenticatedArtifacts:325,unchangedBeforeAfter:true},runs:[{path:'run.json',tests:7,pass:4,applicationFailures:2,harnessExpectationFailures:1,exitCode:1,sourceStable:true},{path:'bounds-corrected/run.json',tests:1,pass:1,fail:0,skipped:0,exitCode:0,sourceStable:true,scope:'Only corrected bounds assertion; initial failure retained'}],findings:[{id:'NOTES-TRASH-REVIEW-01',priority:1,contract:'Enabled-field draft preservation across late Save after notebook trash',source:'client.mjs saveNote/accept',classification:'Pre-existing Save publisher; new cascade interaction',baselineSaveFunctionExactEqual:true,trace:'failures/bounds-expectation-v1/observations.json',unresolved:true},{id:'NOTES-TRASH-REVIEW-02',priority:2,contract:'Snapshot new notebook mutation input before public-entry await',source:'server.mjs notebook-trash/restore -> exclusive',classification:'In-process request alias; HTTP request sharing not claimed',trace:'failures/bounds-expectation-v1/observations.json',unresolved:true}],originalEvidence:{tag:'v3.6.14',commit:'7e2765a3857754d12dbadea442b60ceaf9d4b23d',license:'AGPL-3.0-or-later',exactSlices:helper.bindings.length,newContexts:1,newTopLevelRestoreExecutions:1,newMatchedItemProjections:helper.matchedItemProjections,newMatchedScalarFields:helper.matchedScalarFields,fullApplicationExecutions:0,originalDatabaseExecutions:0,originalGUIExecutions:0,scope:helper.scope,priorAuthorCountsSeparate:true},candidateEvidence:{domModelCases:3,newHostProcesses:0,newBrowserChecks:0,fileBackedReopenCases:1,processRestartClaim:false,failedCommitCase:1,boundsCases:2},sources,limits:{fullProductParity:false,securityParity:false,superiority:false,memoryIsolation:false,distributedTransaction:false,timingOrMemoryMeasurements:false},cleanup:{ownedTemporaryStateRemovedByTest:true,ownedHosts:0,ownedBrowserTabs:0}};
await fs.writeFile(path.join(root,'review-validation.json'),JSON.stringify(receipt,null,2)+'\n');
async function inventory(dir){const out=[];for(const e of await fs.readdir(dir,{withFileTypes:true})){if(dir===root&&['review-manifest.json','freeze.json'].includes(e.name))continue;const p=path.join(dir,e.name);if(e.isDirectory())out.push(...await inventory(p));else{const r=await fp(p);out.push({...r,path:path.relative(root,p).replaceAll('\\','/')});}}return out;}
const records=(await inventory(root)).sort((a,b)=>a.path.localeCompare(b.path));await fs.writeFile(path.join(root,'review-manifest.json'),JSON.stringify({schema:'rea-strict-review-preservation/v1',strict:true,excluded:['review-manifest.json','freeze.json'],records},null,2)+'\n');const freeze={schema:'rea-finite-independent-review-freeze/v1',completedAt:new Date().toISOString(),receipt:await fp(path.join(root,'review-validation.json')),manifest:{...await fp(path.join(root,'review-manifest.json')),count:records.length},immutableStage:true};await fs.writeFile(path.join(root,'freeze.json'),JSON.stringify(freeze,null,2)+'\n');console.log(JSON.stringify(freeze));
