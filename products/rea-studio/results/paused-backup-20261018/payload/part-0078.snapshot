    {
      "id": "grafana.candidate.e6b74745060686292760",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana supports the following time units: `s (seconds)`, `m (minutes)`, `h (hours)`, `d (days)`, `w (weeks)`, `M (months)`, `Q (quarters)` and `y (years)`.",
      "headingPath": [
        "Use dashboards",
        "Set dashboard time range",
        "Time units and relative ranges"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/use-dashboards/index.md",
        "gitBlobSha": "f755d0704ca4e884c68952e657ea8401c4f893ae",
        "sha256": "c18dbe51e51f8d1aa1d443bef92b9422b5748258e6c053bcbee34eb3289ab0fb",
        "lineStart": 237,
        "lineEnd": 237,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/dashboards/use-dashboards/index.md#L237-L237"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
