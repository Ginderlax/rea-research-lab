    {
      "id": "grafana.candidate.a89ab058ff59ead2a480",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For more information about real-time streaming, refer to [Grafana Live documentation](../../setup-grafana/set-up-grafana-live/).",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Grafana OSS features",
        "Real-time streaming"
      ],
      "source": {
