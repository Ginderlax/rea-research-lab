        "sha256": "0149bcb00d079050a094ddb9bace1bde360efead88bd7cff979538dbd3130f77",
        "lineStart": 282,
        "lineEnd": 282,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v9-4.md#L282-L282"
      },
      "applicability": {
