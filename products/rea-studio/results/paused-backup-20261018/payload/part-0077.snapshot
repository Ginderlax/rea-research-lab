    {
      "id": "grafana.candidate.885672a45b5e8939c3c4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set the default start of the week, valid values are: `saturday`, `sunday`, `monday` or `browser` to use the browser locale to define the first day of the week. Default is `browser`.",
      "headingPath": [
