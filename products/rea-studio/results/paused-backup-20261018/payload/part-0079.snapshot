    {
      "id": "grafana.candidate.7bb5daa9ce5e895d2308",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The new alert rule detail view has a new look and feel with helpful metadata at the top. The namespace and group are shown in the breadcrumb navigation. This is interactive and can be used to filter rules by namespace or group. The rest of the alert detail content is split up into tabs:",
      "headingPath": [
        "What’s new in Grafana v11.0",
        "Alerting",
        "Alert detail view redesign"
      ],
      "source": {
