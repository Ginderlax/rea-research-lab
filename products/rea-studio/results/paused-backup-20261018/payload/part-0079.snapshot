    },
    {
      "id": "grafana.candidate.47c25ceaa71311a5805f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now add buttons to your canvas visualizations. Buttons can be configured to call an API endpoint. This pushes Grafana's capabilities to new heights, allowing you to create interactive dashboards that can be used to control external systems.",
      "headingPath": [
        "What’s new in Grafana v10.2",
        "Dashboards and visualizations",
        "Create interactive buttons in canvas visualizations"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-2.md",
