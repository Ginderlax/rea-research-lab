import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import {spawn} from 'node:child_process';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),name=process.argv[2];assert.ok(['prepare-stage.mjs','audit-source.mjs','run-readiness.mjs'].includes(name));const sha=data=>createHash('sha256').update(data).digest('hex'),source=await fs.readFile(path.join(here,name)),stem='action-'+name.replace('.mjs','')+'-'+Date.now(),start=new Date().toISOString();await fs.mkdir(path.join(here,'results'),{recursive:true});await fs.writeFile(path.join(here,'results',stem+'.source.mjs.snapshot'),source,{flag:'wx'});const child=spawn(process.execPath,[path.join(here,name)],{windowsHide:true,stdio:['ignore','pipe','pipe']}),out=[],err=[];let bytes=0,killed=false;const timeout=setTimeout(()=>{killed=true;child.kill();},120000);for(const [stream,parts]of [[child.stdout,out],[child.stderr,err]])stream.on('data',data=>{bytes+=data.length;if(bytes>4*1024*1024){killed=true;child.kill();}else parts.push(data);});const result=await new Promise(resolve=>{child.once('error',error=>resolve({exitCode:null,error:error.message}));child.once('close',(exitCode,signal)=>resolve({exitCode,signal}));});clearTimeout(timeout);const stdout=Buffer.concat(out),stderr=Buffer.concat(err);for(const [suffix,data]of [['.stdout.txt',stdout],['.stderr.txt',stderr]])await fs.writeFile(path.join(here,'results',stem+suffix),data,{flag:'wx'});const receipt={name,start,end:new Date().toISOString(),...result,killed,sourceSHA256:sha(source),sourceAfterSHA256:sha(await fs.readFile(path.join(here,name))),stdoutSHA256:sha(stdout),stderrSHA256:sha(stderr),newMeasurementRun:false};assert.equal(receipt.sourceSHA256,receipt.sourceAfterSHA256);await fs.writeFile(path.join(here,'results',stem+'.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({...receipt,stdout:stdout.toString(),stderr:stderr.toString()}));if(result.exitCode!==0)process.exitCode=1;
