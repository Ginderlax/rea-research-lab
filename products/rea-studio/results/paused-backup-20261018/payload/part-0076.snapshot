    {
      "id": "grafana.candidate.bb1d92e38c8e9ecddb99",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Starting with Grafana v13.2, the Jaeger data source is a standalone plugin, preinstalled in both Grafana OSS and Enterprise. This lets the data source receive updates independently of Grafana releases. Grafana automatically checks the plugin catalog and installs the latest version on each server restart.",
      "headingPath": [
        "Jaeger data source",
        "Plugin updates"
      ],
      "source": {
        "path": "docs/sources/datasources/jaeger/_index.md",
        "gitBlobSha": "a69a5228c6c30f48e16b8ca420274bdfbee8b755",
        "sha256": "4d284b9c332d13dfcbf8e8c25cdfe2bcdc86cd3aa1ff1737ddbb9ee6c6cfb6c3",
        "lineStart": 48,
        "lineEnd": 48,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/jaeger/_index.md#L48-L48"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
