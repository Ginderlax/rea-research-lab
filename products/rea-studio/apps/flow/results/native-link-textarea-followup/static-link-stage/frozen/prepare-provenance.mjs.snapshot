import fs from 'node:fs/promises';import path from'node:path';import os from'node:os';import{createHash}from'node:crypto';import{fileURLToPath}from'node:url';import assert from'node:assert/strict';
const own=path.dirname(fileURLToPath(import.meta.url)),lab=path.resolve(own,'../../outputs/rea-research-lab'),cache=path.join(lab,'.local/flow-original'),sha=b=>createHash('sha256').update(b).digest('hex');
const acquisition=JSON.parse(await fs.readFile(path.join(own,'acquisition.json'),'utf8')),baseline=JSON.parse(await fs.readFile(path.join(own,'source-before.json'),'utf8'));
const authority=[];for(const row of baseline){const current=await fs.readFile(path.join(lab,row.path)),before=await fs.readFile(path.join(own,'before',row.path.replace('products/rea-studio/','')+'.snapshot'));assert.equal(current.length,row.bytes);assert.equal(sha(current),row.sha256);assert(current.equals(before));authority.push({...row,unchanged:true});}
const original=[];for(const p of acquisition.packages)for(const row of p.sources){const bytes=await fs.readFile(path.join(own,row.snapshot)),installed=await fs.readFile(path.join(cache,'node_modules',p.name,row.path));assert.equal(bytes.length,row.bytes);assert.equal(sha(bytes),row.sha256);assert(bytes.equals(installed));original.push({package:p.name,version:p.version,...row,lineCount:bytes.toString().split('\n').length});}
const verificationPaths=['@node-red/nodes/core/common/20-inject.js','@node-red/nodes/core/function/15-change.js','@node-red/util/lib/util.js','@node-red/runtime/lib/nodes/Node.js','node-red-node-test-helper/index.js','node-red/lib/red.js','@node-red/editor-api/lib/index.js','@node-red/editor-api/lib/editor/comms.js','node-red-node-test-helper/LICENSE','node-red-node-test-helper/package.json'];
const auxiliary=[];for(const file of verificationPaths){const bytes=await fs.readFile(path.join(cache,'node_modules',file)),snapshot='verification-source/'+file+'.snapshot';await fs.mkdir(path.dirname(path.join(own,snapshot)),{recursive:true});try{await fs.writeFile(path.join(own,snapshot),bytes,{flag:'wx'});}catch(error){if(error.code!=='EEXIST')throw error;assert(bytes.equals(await fs.readFile(path.join(own,snapshot))));}auxiliary.push({cachePath:'node_modules/'+file,snapshot,bytes:bytes.length,sha256:sha(bytes),binding:'Existing integrity-locked installed oracle cache; additional exact bytes recorded before final campaign, no extra independent archive acquisition claimed.'});}
const nodeBytes=await fs.readFile(process.execPath),orphans=[];for(const name of['original-v1','original-v3','original-v4']){const journalPath=path.join(own,'runs',name,'observations/link-runtime-journal.json');let directory;if(name==='original-v1')directory='C:/Users/evanh/AppData/Local/Temp/rea-link-original-runtime-8Tb0Lr';else directory=JSON.parse(await fs.readFile(journalPath,'utf8')).observations.find(x=>x.directory)?.directory;if(directory){assert.equal(path.dirname(path.resolve(directory)),path.resolve(os.tmpdir()));assert(path.basename(directory).startsWith('rea-link-original-runtime-'));const entries=await fs.readdir(directory,{withFileTypes:true});orphans.push({attempt:name,directory,exists:true,entries:entries.map(e=>({name:e.name,directory:e.isDirectory()})),cleanup:'Not attempted again: automatic approval review rejected recursive cleanup as blocked by policy. Retained pending; process/host already exited on prior fatal failure.'});}}
await fs.writeFile(path.join(own,'source-provenance.json'),JSON.stringify({schema:'rea-flow-static-link-source-provenance/v1',at:new Date().toISOString(),productionBaseline:authority,officialSources:original,verificationAuxiliary:auxiliary,acquisition:{path:'acquisition.json',bytes:(await fs.readFile(path.join(own,'acquisition.json'))).length,sha256:sha(await fs.readFile(path.join(own,'acquisition.json')))},node:{version:process.version,path:process.execPath,bytes:nodeBytes.length,sha256:sha(nodeBytes)},originalScope:{compiler:'Unmodified released util.parseConfig; compare its rewritten live configuration rather than pre-rewrite allNodes copy.',handlers:'Actual released60-link registration/constructors/input callbacks with minimal owned registration/event host.',fullRuntime:'Original Node-RED/test-helper flow compiler and handlers; Debug nodes replaced by output observers; fixed supplied message IDs and rich Buffer/Date objects compared exactly before JSON receipt encoding.',adapters:['Explicit absolute locked oracle cache, avoiding copied historical comparator relative path.','Plain child removes inherited NODE_TEST_CONTEXT; no node:test module imported into full original helper process.','Only original public initializer arguments receive owned temporary userDir. Editor endpoints may initialize internally; original editor/browser/GUI executions are zero.','Debug nodes replaced by ordinary test-helper observers;30ms await is scheduling settlement, no timing measurement.'],countsPerAcceptedCampaign:{compilerFixtures:9,handlerCases:7,fullRuntimeFlows:8,originalChildProcesses:1,originalEphemeralHosts:1,originalGUI:0,originalEditor:0,benchmarks:0}},license:'Apache-2.0; complete selected publisher licenses and test-helper license retained. Own source-assisted application has no original runtime dependency.',orphanTemporaryDirectories:orphans,fullParity:false,universalSuperiority:false},null,2)+'\n');
console.log(JSON.stringify({baseline:authority.length,official:original.length,verificationAuxiliary:auxiliary.length,orphanDirectories:orphans.length,allEmpty:orphans.every(x=>!x.entries.length)}));
