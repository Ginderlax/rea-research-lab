import fs from'node:fs/promises';import path from'node:path';import{createHash}from'node:crypto';import{spawn}from'node:child_process';import assert from'node:assert/strict';import{unescapeTapJson}from'./tap-observations.mjs';
const root=import.meta.dirname,app='products/rea-studio/apps/vault/',sha=b=>createHash('sha256').update(b).digest('hex'),prior=JSON.parse(await fs.readFile(path.join(root,'prior-regression-provenance.json'))),tests=[...prior.files.filter(e=>e.path.endsWith('.test.mjs')).map(e=>e.path),...['recycle.test.mjs','recycle-server.test.mjs','recycle-ui.test.mjs','recycle-http.test.mjs','recycle-original.test.mjs'].map(e=>app+e)],exe=path.resolve(root,'../../outputs/rea-research-lab/projects/07-keepass/artifacts/portable/KeePass.exe');
assert.equal(sha(await fs.readFile(exe)),'04d29636c393f0c1fc99ff739295494be3adefded93271e44591e8e300225a5a');for(const e of prior.files)assert.equal(sha(await fs.readFile(path.join(root,e.path))),e.sha256,'Accepted prior test/helper changed');
const provenance=JSON.parse(await fs.readFile(path.join(root,'source-provenance.json'))),baseline=JSON.parse(await fs.readFile(path.join(root,'baseline-validation.json')));
const sourceNames=[...(await fs.readdir(path.join(root,app))).filter(n=>/\.(mjs|ps1)$/.test(n)).map(n=>app+n),'products/rea-studio/server.mjs','products/rea-studio/catalog.mjs','products/rea-studio/lib/storage.mjs','products/rea-studio/public/studio.mjs','products/rea-studio/public/index.html','products/rea-studio/public/style.css','record-candidate.mjs','tap-observations.mjs','prior-regression-provenance.json','source-provenance.json','contract-evidence.json','baseline-validation.json','README.md','NOTICE.md',...provenance.files.map(e=>e.path)];
async function external(){const production=[];for(const e of baseline.files.filter(e=>!e.kind)){const b=await fs.readFile(path.resolve(root,'../../outputs/rea-research-lab',e.path));assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256,'Accepted production runtime changed');production.push(e);}const carrier=await fs.readFile(path.resolve(root,provenance.sourceCarrier));assert.equal(carrier.length,provenance.archive.bytes);assert.equal(sha(carrier),provenance.archive.sha256);for(const e of provenance.files){const b=await fs.readFile(path.join(root,e.path));assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256);}return{productionRuntime:production,originalExe:{bytes:(await fs.stat(exe)).size,sha256:sha(await fs.readFile(exe))},originalSource:{bytes:carrier.length,sha256:sha(carrier)}};}
const run=path.join(root,'runs','candidate-'+new Date().toISOString().replaceAll(':','-'));await fs.mkdir(run,{recursive:true});async function capture(snapshot){const result=[];for(const n of sourceNames.sort()){const b=await fs.readFile(path.join(root,n));result.push({path:n,bytes:b.length,sha256:sha(b)});if(snapshot){const dest=path.join(run,'sources',n+'.snapshot');await fs.mkdir(path.dirname(dest),{recursive:true});await fs.writeFile(dest,b);}}return result;}
const before=await capture(true),externalBefore=await external();await fs.writeFile(path.join(run,'source-before.json'),JSON.stringify(before,null,2)+'\n');const env={...process.env,REA_KEEPASS_EXE:exe};delete env.NODE_TEST_CONTEXT;
const p=spawn(process.execPath,['--test','--test-reporter=tap',...tests],{cwd:root,env,windowsHide:true,stdio:['ignore','pipe','pipe']}),chunks={stdout:[],stderr:[]},sizes={stdout:0,stderr:0};let problem;const stop=value=>{problem??=value;p.kill()},timer=setTimeout(()=>stop('Child180-second deadline'),180000);for(const name of['stdout','stderr'])p[name].on('data',b=>{sizes[name]+=b.length;if(sizes[name]>(name==='stdout'?8:2)*1024*1024)stop('Child '+name+' capture exceeds bound');else chunks[name].push(b)});p.once('error',e=>problem??=e.message);const code=await new Promise(r=>p.once('close',r));clearTimeout(timer);
const stdout=Buffer.concat(chunks.stdout),stderr=Buffer.concat(chunks.stderr);await fs.writeFile(path.join(run,'stdout.txt'),stdout);await fs.writeFile(path.join(run,'stderr.txt'),stderr);const after=await capture(false),externalAfter=await external();assert.deepEqual(externalBefore,externalAfter);await fs.writeFile(path.join(run,'source-after.json'),JSON.stringify(after,null,2)+'\n');const raw=stdout.toString(),number=n=>Number(new RegExp('^# '+n+' (\\d+)$','m').exec(raw)?.[1]??NaN),details=[];
function marker(label){const prefix='# '+label+' ',lines=raw.split(/\r?\n/),indices=lines.flatMap((l,i)=>l.startsWith(prefix)?[i]:[]);assert.equal(indices.length,1,label);let joined='';for(let i=indices[0];i<lines.length&&i<indices[0]+2048;i++){const l=lines[i];if(i===indices[0])joined+=l.slice(prefix.length);else{if(!l.startsWith('# ')||l.startsWith('# Subtest:'))break;joined+=l.slice(2);}assert(joined.length<=1024*1024);try{return JSON.parse(unescapeTapJson(joined))}catch{}}throw new Error('Invalid marker '+label);}
let originalLoads=0,hostProcesses=0;try{for(const[label,name]of[['REA_KEEPASS_HISTORY_ORIGINAL','prior-history-original'],['REA_KEEPASS_HISTORY_HTTP','prior-history-http'],['REA_KEEPASS_HISTORY_UNKNOWN','prior-history-unknown'],['REA_RECYCLE_ORIGINAL','recycle-original'],['REA_RECYCLE_HTTP','recycle-http']]){const m=marker(label),location=path.resolve(m.detail);assert(location.startsWith(path.join(root,'.local')+path.sep));const b=await fs.readFile(location);assert(b.length<=8*1024*1024);const value=JSON.parse(b),loads=m.assemblyLoads??m.originalProcessExecutions??0;originalLoads+=loads;hostProcesses+=m.hostProcesses??0;await fs.writeFile(path.join(run,name+'.json'),b);details.push({label,path:name+'.json',bytes:b.length,sha256:sha(b),assemblyLoads:loads,hostProcesses:m.hostProcesses??0});}}catch(e){problem??='Observation collection: '+e.message;}
const receipt={schema:'rea-keepass-recycle-stage-candidate-run/v1',completed:new Date().toISOString(),code,problem:problem??null,tests:number('tests'),pass:number('pass'),fail:number('fail'),skipped:number('skipped'),cancelled:number('cancelled'),sourceBefore:before,sourceAfter:after,externalBefore,externalAfter,sourceStable:JSON.stringify(before)===JSON.stringify(after),priorAcceptedGroups:41,newGroups:27,original:{assemblyLoads:originalLoads,priorHistoryAssemblyLoads:24,recycleAssemblyLoads:14,GUI:0,fullProductExecutions:0,releaseSha256:sha(await fs.readFile(exe)),scope:'Original library/private static helper executed in authenticated processes. Delete/restore orchestration and deterministic clock assignments are source-composed fixture operations;4.1 feature/default4.0 cases separately asserted.'},candidate:{actualSharedHostProcesses:hostProcesses,priorHistoryHostProcesses:5,recycleHostProcesses:4,browserExecutions:0,newDOMElementGroups:4},observations:details,normalTestsWriteAppResults:false,productionEdited:false,fullProductParity:false,securityParity:false,superiority:false,limits:{deadlineMs:180000,stdoutCap:8*1024*1024,stderrCap:2*1024*1024,cleanup:'Owned direct child termination only; no race-free Windows descendant isolation or hard I/O deadlines claimed.'}};await fs.writeFile(path.join(run,'validation.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({run,...receipt,sourceBefore:undefined,sourceAfter:undefined}));assert(receipt.sourceStable);assert.equal(code,0);assert(!problem,problem);assert.equal(receipt.tests,68);assert.equal(receipt.pass,68);assert.equal(receipt.fail,0);assert.equal(receipt.skipped,0);assert.equal(receipt.cancelled,0);assert.equal(originalLoads,38);assert.equal(hostProcesses,9);
