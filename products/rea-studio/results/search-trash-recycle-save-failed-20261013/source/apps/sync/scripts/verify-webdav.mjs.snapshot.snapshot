import fs from 'node:fs/promises';
import path from 'node:path';
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {execFile} from 'node:child_process';
import {promisify} from 'node:util';
import {fileURLToPath} from 'node:url';
const execute=promisify(execFile),app=fileURLToPath(new URL('../',import.meta.url)),digest=bytes=>createHash('sha256').update(bytes).digest('hex'),checkpoint='64238267b332bb3a8ac5435a613a596a06311f59',checkedAt=new Date().toISOString();
const names=[];async function walk(prefix=''){for(const entry of await fs.readdir(path.join(app,prefix),{withFileTypes:true})){const name=prefix+entry.name;if(entry.isDirectory()){if(name!=='results')await walk(name+'/');}else names.push(name);}}await walk();names.sort();
async function fingerprints(){return Object.fromEntries(await Promise.all(names.map(async file=>[file,digest(await fs.readFile(path.join(app,file)))])));}
const before=await fingerprints(),hostPaths=['../../server.mjs','../../catalog.mjs','../../lib/storage.mjs'],hostFingerprint=async()=>Object.fromEntries(await Promise.all(hostPaths.map(async file=>[file,digest(await fs.readFile(path.join(app,file)))]))),hostBefore=await hostFingerprint();
const historicalNames=['native-verification.json','filter-verification.json','comparison-verification.json','transfer-verification.json','source-verification.json','bounded-workloads.json'],historical=Object.fromEntries(await Promise.all(historicalNames.map(async file=>[file,digest(await fs.readFile(path.join(app,'results',file)))])));assert.equal(historical['native-verification.json'],'d321232634c7956605837dbbf71583d27e48b7a4d925b302cddf7627af6e9f95');
const stageBytes=await fs.readFile(path.join(app,'results/webdav-staged-validation.json')),stage=JSON.parse(stageBytes);assert.equal(digest(stageBytes),'236271539e3316532f972e50834fab7f348d8e8c7653bf700d6a632b59ef45dd');
const stagedSource=[];for(const [file,sha256]of Object.entries(stage.sources)){const preserved='results/webdav-staged-source/'+file;assert.equal(digest(await fs.readFile(path.join(app,preserved))),sha256);stagedSource.push({originalStageFile:file,preserved,sha256});}
const stagedReceipts={};for(const [original,file]of Object.entries({'primitive-oracle-receipt.json':'webdav-staged-primitive.json','transfer-oracle-receipt.json':'webdav-staged-transfer.json','resource-receipt.json':'webdav-staged-resources.json'})){const bytes=await fs.readFile(path.join(app,'results',file));assert.equal(digest(bytes),stage.receipts[original].sha256);stagedReceipts[file]={sha256:digest(bytes),bytes:bytes.length};}
const manifestBytes=await fs.readFile(path.join(app,'webdav-source-references.json')),manifest=JSON.parse(manifestBytes),officialRecords=[];
for(const file of manifest.files){const bytes=await fs.readFile(path.join(app,'results/webdav-official-sources',file.path));assert.equal(digest(bytes),file.sha256);assert.equal(bytes.length,file.bytes);const response=await fetch(file.url);assert.ok(response.ok,file.url);const fresh=Buffer.from(await response.arrayBuffer());assert.equal(digest(fresh),file.sha256);officialRecords.push({path:file.path,sha256:file.sha256,bytes:bytes.length,preserved:'results/webdav-official-sources/'+file.path,freshOfficialBytesVerified:true});}
assert.equal(officialRecords.length,16);assert.equal(manifest.contracts.length,29);for(const contract of manifest.contracts){const source=officialRecords.find(x=>x.path===contract.source.path);assert.equal(source.sha256,contract.source.sha256);assert.ok(contract.source.startLine>0 && contract.source.endLine>=contract.source.startLine);}
const sourceReceipt={schemaVersion:1,checkedAt:new Date().toISOString(),manifestSHA256:digest(manifestBytes),sourceCommit:manifest.sourceCommit,contracts:29,officialRecords,allPassed:true};await fs.writeFile(path.join(app,'results/webdav-source-verification.json'),JSON.stringify(sourceReceipt,null,2)+'\n');
const testFiles=names.filter(file=>!file.includes('/') && file.endsWith('.test.mjs')),steps=[];
for(const args of [['--test','--test-reporter=tap',...testFiles],['scripts/webdav-oracle-basic.mjs'],['scripts/webdav-oracle-transfer.mjs'],['scripts/webdav-resource-probes.mjs']]){const started=Date.now(),result=await execute(process.execPath,args,{cwd:app,windowsHide:true,timeout:120000,maxBuffer:4*1024*1024}),step={args,milliseconds:Date.now()-started,exitCode:0,stdoutSHA256:digest(Buffer.from(result.stdout)),stderrSHA256:digest(Buffer.from(result.stderr))};if(args[0]==='--test')for(const key of ['tests','pass','fail','skipped','cancelled']){const match=new RegExp('^# '+key+' (\\d+)$','m').exec(result.stdout);assert.ok(match,key);step[key]=Number(match[1]);}steps.push(step);console.log(JSON.stringify(step));}
const after=await fingerprints(),hostAfter=await hostFingerprint();assert.deepEqual(after,before,'App source changed during verification.');assert.deepEqual(hostAfter,hostBefore,'Shared host source changed during verification.');for(const [file,sha256]of Object.entries(historical))assert.equal(digest(await fs.readFile(path.join(app,'results',file))),sha256,'Historical evidence changed.');
assert.equal(steps[0].tests,72);assert.equal(steps[0].pass,72);assert.equal(steps[0].fail+steps[0].skipped+steps[0].cancelled,0);
const receipts={};for(const file of ['webdav-primitive-verification.json','webdav-transfer-verification.json','webdav-resources.json','webdav-source-verification.json']){const bytes=await fs.readFile(path.join(app,'results',file)),value=JSON.parse(bytes);receipts[file]={sha256:digest(bytes),bytes:bytes.length};if(value.sourceSHA256)for(const [source,sha256]of Object.entries(value.sourceSHA256))assert.equal(after[source],sha256,'Integrated receipt source drift '+source);}
const originalProofBytes=await fs.readFile(path.join(app,'results/webdav-artifact-source-binding.json'));assert.equal(digest(originalProofBytes),'cca09b9277f0e0d7339e254d2dbeeae6c11a1f362b9021d18e7fbc3e8ca77251');
const integrationMapping=[['dav-xml.mjs','dav-xml.mjs','Unchanged staged XML contract.'],['webdav.mjs','webdav.mjs','Unchanged staged client contract.'],['dav-comparison.mjs','dav-comparison.mjs','Unchanged staged generic comparison contract.'],['dav-input.mjs','dav-input.mjs','Unchanged staged complete-input validator.'],['native-filters.mjs','native-filters.mjs','Unchanged existing newly written local filter library.'],['dav-transfer.mjs','dav-transfer.mjs','Adds cancellation of active client scope on disposal.'],['dav-actions.mjs','dav-actions.mjs','Adds cancellation of active list/capability client on disposal.'],['client-webdav-snippet.mjs','client.mjs','Embeds UI into existing client and rejects delayed stale preview responses.'],['fixture-server.mjs','scripts/webdav-fixture.mjs','Unchanged independent HTTP/DAV fixture, relocated for verification only.'],['oracle-basic.mjs','scripts/webdav-oracle-basic.mjs','Verification-only imports/output/fingerprint paths adjusted for integrated app.'],['oracle-transfer.mjs','scripts/webdav-oracle-transfer.mjs','Verification-only imports/output/fingerprint paths adjusted for integrated app.'],['resource-probes.mjs','scripts/webdav-resource-probes.mjs','Verification-only imports/output/fingerprint paths adjusted for integrated app.']].map(([staged,current,change])=>({staged,current,stagedSHA256:stage.sources[staged],currentSHA256:after[current],change}));
const provenance={schemaVersion:1,checkedAt:new Date().toISOString(),historicalCheckpoint:checkpoint,unchangedHistoricalReceipts:historical,stagedAggregate:{path:'results/webdav-staged-validation.json',sha256:digest(stageBytes),tests:29},stagedSource,stagedReceipts,integrationMapping,originalArchiveSourceBinding:{path:'results/webdav-artifact-source-binding.json',sha256:digest(originalProofBytes)},reviewProvenance:[{reviewer:'Parent coordinator',finding:'Dispatch before old Sync queue; shared host had another credential-retaining serialization chain.',resolution:'Integrated direct/busy dispatcher plus separately coordinated shared-host bypass, tested over actual HTTP.'},{reviewer:'Integration owner',finding:'Delayed preview result could outlive settings edits; service disposal needed active scope cancellation.',resolution:'Revision-bound DOM result plus active client cancellation, with focused regressions.'}],runtimeRunsOriginalOrVendorCode:false,priorProjectReconstructionReadOrImported:false,allDocumentedFeaturesEnumerated:false,fullProductComplete:false,universalSuperiorityEstablished:false};await fs.writeFile(path.join(app,'results/webdav-provenance.json'),JSON.stringify(provenance,null,2)+'\n');receipts['webdav-provenance.json']={sha256:digest(Buffer.from(JSON.stringify(provenance,null,2)+'\n'))};
const value={schemaVersion:1,checkedAt,completedAt:new Date().toISOString(),scope:'Integrated generic WebDAV client/local-to-remote transfer, actual host HTTP and semantic DOM checks; separate historical local evidence preserved.',sourceFiles:after,hostDependenciesAtTest:hostAfter,testRun:{tests:72,pass:72,fail:0,skipped:0,cancelled:0,legacyRegressionTests:35,newWebDAVTests:37,files:testFiles},oracle:{primitiveScenarios:4,comparisonProfiles:128,comparisonDecisions:1408,heldOutFilteredTransferFolders:8,authenticatedOriginalExecutions:274},officialSourceFiles:16,sourceContracts:29,receipts,historicalEvidenceAtCheckpoint:checkpoint,steps,comparisonOfSpeedOrResourcesToOriginal:false,browserVerification:'Parent-owned, pending separately; semantic DOM tests are not rendered browser QA.',runtimeRunsOriginalOrVendorCode:false,allFixturesSynthetic:true,allDocumentedFeaturesEnumerated:false,fullProductComplete:false,universalSuperiorityEstablished:false};await fs.writeFile(path.join(app,'results/webdav-validation.json'),JSON.stringify(value,null,2)+'\n');console.log(JSON.stringify({receipt:'results/webdav-validation.json',sha256:digest(Buffer.from(JSON.stringify(value,null,2)+'\n')),tests:72,newWebDAVTests:37,originalExecutions:274,hostSHA256:hostAfter['../../server.mjs']}));
