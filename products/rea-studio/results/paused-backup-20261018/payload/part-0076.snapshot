    {
      "id": "grafana.candidate.e1ed8725893d6e67781f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Parca returns a separate time series for each label combination, allowing you to quickly identify spikes in the value of scraped profiles and zoom in to a particular time range for further investigation.",
      "headingPath": [
        "Parca query editor",
        "Metrics query results"
      ],
      "source": {
        "path": "docs/sources/datasources/parca/query-editor/index.md",
