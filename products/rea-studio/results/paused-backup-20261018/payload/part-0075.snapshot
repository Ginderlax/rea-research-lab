    },
    {
      "id": "grafana.candidate.84efc97d48541c00c1aa",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Defines the threshold condition. It returns only series whose error rate is higher than 20% of spans. Alternatively, you can set this threshold as a Grafana Alerting expression in the UI.",
      "headingPath": [
        "Examples of trace-based alerts",
        "Alerting on span metrics",
        "Detect high error rate"
