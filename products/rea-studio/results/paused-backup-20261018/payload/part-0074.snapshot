    {
      "id": "grafana.candidate.4e4c683aee6871182ba3",
      "syntaxRole": "list-item",
      "sourceText": "- The `edit` permission allows users to query the data source, edit the data source’s configuration and delete the data source.",
      "headingPath": [
        "Data source management",
        "Data source permissions"
      ],
      "source": {
