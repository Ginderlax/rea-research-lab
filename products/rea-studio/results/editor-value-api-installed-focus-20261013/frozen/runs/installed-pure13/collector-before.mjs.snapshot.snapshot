// Owned correctness/evidence recorder. It invokes only the installed pure test.
import fs from 'node:fs/promises';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { createHash } from 'node:crypto';
import { spawn } from 'node:child_process';
import assert from 'node:assert/strict';

const stage=path.dirname(fileURLToPath(import.meta.url)),workspace=path.resolve(stage,'../..'),repo=path.join(workspace,'outputs/rea-research-lab');
const publicPrefix='products/rea-studio/apps/editor/results/position-range-selection-followup/';
const nodeSHA='b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3';
const hostBefore='807a473ec0334f60dfd58f2df8901c722f1bd4eb1d64c62d9ba1ea65c2b6b55f',hostAfter='85fe09b1b52a1d91e9d09c85d99c6e768ac4b793f5d7694a1760a4c0560a0a94';
const id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),json=v=>Buffer.from(JSON.stringify(v,null,2)+'\n');
const safe=p=>typeof p==='string'&&p&&p.length<=1200&&!p.includes('\\')&&!path.posix.isAbsolute(p)&&p.split('/').every(x=>x&&x!=='.'&&x!=='..');
const counters={fileReads:0,bytesRead:0};
async function read(root,p,expected){assert(safe(p),p);const at=path.resolve(root,...p.split('/'));assert(at.startsWith(root+path.sep));const s=await fs.lstat(at);assert(s.isFile()&&!s.isSymbolicLink()&&s.size<=128*1024*1024,p);const real=await fs.realpath(at);assert(real.startsWith(await fs.realpath(root)+path.sep));const b=await fs.readFile(at);counters.fileReads++;counters.bytesRead+=b.length;assert.equal(b.length,s.size,p);if(expected)assert.deepEqual(id(b),{bytes:expected.bytes,sha256:expected.sha256},p);return b;}
async function save(p,b){assert(safe(p));await fs.mkdir(path.dirname(path.join(stage,p)),{recursive:true});await fs.writeFile(path.join(stage,p),b,{flag:'wx'});}
async function walk(root,prefix=''){const out=[];for(const e of(await fs.readdir(root,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){assert(!e.isSymbolicLink());const p=prefix+e.name;if(e.isDirectory())out.push(...await walk(path.join(root,e.name),p+'/'));else{assert(e.isFile());out.push(p);}}return out;}
const rows=m=>Array.isArray(m.inventory)?m.inventory:Object.entries(m.inventory).map(([path,r])=>({path,...r}));
const roots={base:path.join(workspace,'work/editor-value-api-publication-plan-next'),override:path.join(workspace,'work/editor-value-api-guide-proposal-next'),review:path.join(workspace,'work/editor-position-range-selection-correction-independent-review'),notesPlan:path.join(workspace,'work/notes-inline-publication-plan-next')};
const authorities=[['base','freeze-manifest.json',57,'0322b822798739f44b4d719a8a7d61647465532c19277c1523cc98af04b5ee9b'],['override','freeze-manifest.json',14,'08b546c762589b233c5edbca116f8caa7e1a5feb291f379ad34d6111622fefc8']];
const aliases=[],authority=[];
for(const [name,file,count,sha]of authorities){const b=await read(roots[name],file);assert.equal(id(b).sha256,sha);const m=JSON.parse(b);assert.equal(rows(m).length,count);assert.equal(m.strict,true);assert.deepEqual((await walk(roots[name])).sort(),[...rows(m).map(r=>r.path),file].sort());for(const r of rows(m))await read(roots[name],r.path,r);authority.push({name,file,...id(b),count});const prefix=publicPrefix+(name==='base'?'publication-plan':'guide-proposal')+'/frozen/';for(const r of [...rows(m),{path:file,...id(b)}])aliases.push({path:prefix+r.path+'.snapshot',...id(await read(roots[name],r.path,r)),sourceRoot:'work/'+path.basename(roots[name]),sourcePath:r.path});await save('authority/'+name+'-manifest.json.snapshot',b);}
const mapBytes=await read(roots.base,'public-preservation-map.json');assert.equal(id(mapBytes).sha256,'0d1dc7cd81e6844dc5b2196e58bba966ec327371eb4c97d5fc6c48e806ed5f03');const map=JSON.parse(mapBytes);assert.equal(map.pathRecords,402);assert.equal(map.payload.length,402);assert.equal(new Set(map.payload.map(r=>r.sha256)).size,166);for(const r of map.payload)aliases.push({path:r.publicPath,bytes:r.bytes,sha256:r.sha256,sourceRoot:r.sourceRoot,sourcePath:r.sourcePath});assert.equal(aliases.length,475);assert.equal(new Set(aliases.map(r=>r.path)).size,475);await save('authority/accepted-public-map.json.snapshot',mapBytes);await save('expected-public475.json',json(aliases));
for(const epoch of map.epochs){const found=map.payload.find(r=>r.epoch===epoch.id&&r.sourcePath===epoch.manifest);assert(found);assert.equal(found.sha256,epoch.sha256);const m=JSON.parse(await read(repo,found.publicPath,found));const want=[...rows(m).map(r=>r.path),epoch.manifest].sort();assert.deepEqual(map.payload.filter(r=>r.epoch===epoch.id).map(r=>r.sourcePath).sort(),want);for(const r of rows(m)){const mapped=map.payload.find(x=>x.epoch===epoch.id&&x.sourcePath===r.path);assert(mapped);assert.deepEqual({bytes:mapped.bytes,sha256:mapped.sha256},{bytes:r.bytes,sha256:r.sha256});}}
const proposalBytes=await read(roots.override,'live-copy-list.json');const proposal=JSON.parse(proposalBytes);assert.equal(proposal.newPaths,4);assert.equal(proposal.replacements,0);assert.equal(proposal.proposals.length,4);await save('authority/final-live-copy-list.json.snapshot',proposalBytes);
const baselineBytes=await read(roots.review,'current-before.json');const baseline=JSON.parse(baselineBytes);assert.equal(baseline.length,31);const reviewManifest=JSON.parse(await read(roots.review,'review-manifest.json'));const baselineRecord=rows(reviewManifest).find(r=>r.path==='current-before.json');assert(baselineRecord);assert.deepEqual(id(baselineBytes),{bytes:baselineRecord.bytes,sha256:baselineRecord.sha256});assert.equal(id(await read(roots.review,'review-manifest.json')).sha256,'7eb5f10cca861c1ac31b2e6362df8c33d49a1c02f6f0f59c38cd7549cb2aba27');await save('authority/old-current31.json.snapshot',baselineBytes);
const oldHostRecord=rows(reviewManifest).find(r=>r.path==='current-source/products/rea-studio/server.mjs.snapshot');const oldHost=await read(roots.review,oldHostRecord.path,oldHostRecord);assert.equal(id(oldHost).sha256,hostBefore);await save('authority/old-host807.mjs.snapshot',oldHost);
const notesManifestBytes=await read(roots.notesPlan,'freeze-manifest.json');assert.equal(id(notesManifestBytes).sha256,'ab0bccd1aaf43da7b932193a0991531659b2e5017b72c28933b37bcc7ddcf3ae');const reqRecord=rows(JSON.parse(notesManifestBytes)).find(r=>r.path==='requirements-identity-reference.json');const reqBytes=await read(roots.notesPlan,reqRecord.path,reqRecord);const req=JSON.parse(reqBytes);await save('authority/requirements159-232-reference.json.snapshot',reqBytes);
const installationBytes=await read(workspace,'work/editor-sketch-reviewed-installation-next/installation.json');const installation=JSON.parse(installationBytes);assert.equal(installation.schema,'rea-reviewed-editor-sketch-production-installation/v1');for(const r of aliases){const installed=installation.copies.find(x=>x.path===r.path);assert(installed,r.path);assert.deepEqual({bytes:installed.bytes,sha256:installed.sha256},{bytes:r.bytes,sha256:r.sha256});}await save('authority/root-installation.json.snapshot',installationBytes);
const seven=[...proposal.proposals.map(r=>r.destination),'products/rea-studio/apps/editor/README.md','products/rea-studio/server.mjs','products/rea-studio/package.json'];assert.equal(new Set(seven).size,7);
const snapshot=async()=>{
 const readStart={...counters};const publicRows=[];for(const r of aliases){assert(safe(r.path)&&r.path.startsWith(publicPrefix)&&!r.path.split('/').includes('.local'));const b=await read(repo,r.path,r);assert.deepEqual(Buffer.from(b.toString('utf8')),b);assert(!/^(MZ|PK)/.test(b.subarray(0,2).toString('latin1')));publicRows.push({path:r.path,...id(b)});}
 const current31=[];for(const old of baseline){const b=await read(repo,old.path),current=id(b);if(old.path==='products/rea-studio/server.mjs')assert.deepEqual(current,{bytes:7840,sha256:hostAfter});else assert.deepEqual(current,{bytes:old.bytes,sha256:old.sha256});current31.push({path:old.path,historical:{bytes:old.bytes,sha256:old.sha256},current,historicalUnchanged:current.sha256===old.sha256});}
 const additions=[];for(const r of proposal.proposals){const b=await read(repo,r.destination,r.after);additions.push({path:r.destination,...id(b)});}
 const source=[];for(const p of seven)source.push({path:p,...id(await read(repo,p))});
 let sourceCount=0;const capabilities=new Set(),registries=[];for(const r of req.registries){const b=await read(repo,r.path),j=JSON.parse(b);const sources=j.sources.map(s=>({id:s.id,sha256:s.sha256}));const ids=r.path.endsWith('system-products.json')?j.products.flatMap(p=>p.capabilities.map(c=>c.id)):r.path.endsWith('workspace-products.json')?j.capabilities.map(c=>c.id):j.baselineProducts.flatMap(p=>p.requirements.map(c=>c.id));assert.deepEqual(sources,r.sources);assert.deepEqual(ids,r.capabilityIDs);sourceCount+=sources.length;for(const id of ids)capabilities.add(id);registries.push({path:r.path,sources,capabilityIDs:ids});}assert.equal(sourceCount,159);assert.equal(capabilities.size,232);
 const newHost=await read(repo,'products/rea-studio/server.mjs');let prefix=0;while(prefix<oldHost.length&&oldHost[prefix]===newHost[prefix])prefix++;let suffix=0;while(suffix<oldHost.length-prefix&&oldHost[oldHost.length-1-suffix]===newHost[newHost.length-1-suffix])suffix++;const deleted=oldHost.subarray(prefix,oldHost.length-suffix),inserted=newHost.subarray(prefix,newHost.length-suffix);assert.equal(deleted.length,0);assert.equal(inserted.length,99);assert(Buffer.concat([oldHost.subarray(0,prefix),inserted,oldHost.subarray(prefix)]).equals(newHost));
 const hostTransition={old:id(oldHost),current:id(newHost),offset:prefix,removedBytes:0,insertedBytes:99,insertedUTF8:inserted.toString(),classification:'Separate root-authorized static-route host change, not API class runtime change',hostExecuted:false};
 const collector=id(await read(stage,'run.mjs'));const node=id(await fs.readFile(process.execPath));assert.equal(node.sha256,nodeSHA);
 return {publicRows,current31,additions,source,registries,sourceIDSHAPairs:sourceCount,capabilityIDs:capabilities.size,hostTransition,collector,node,nodeVersion:process.version,readOperations:counters.fileReads-readStart.fileReads,bytesRead:counters.bytesRead-readStart.bytesRead};
};
await fs.mkdir(path.join(stage,'runs/installed-pure13'),{recursive:true});const run='runs/installed-pure13';
const before=await snapshot();await save(run+'/source-before.json',json(before));for(const r of before.source)await save(run+'/source-before/'+r.path+'.snapshot',await read(repo,r.path,r));await save(run+'/collector-before.mjs.snapshot',await read(stage,'run.mjs',before.collector));await save(run+'/node-provenance.json',json({path:process.execPath,version:process.version,...before.node,nativeProgramBytesCopied:false}));
const testPath='products/rea-studio/apps/editor/position-range-selection.test.mjs',testSource=(await read(repo,testPath)).toString();assert(!/node:fs|node:vm|typescript|original-oracle|process\.env|writeFile/.test(testSource));
const args=['--max-old-space-size=128','--test','--test-reporter=tap',testPath],env={...process.env};for(const k of ['NODE_TEST_CONTEXT','NODE_OPTIONS','NODE_V8_COVERAGE'])delete env[k];
let stdout=[],stderr=[],outBytes=0,errBytes=0,limit=null,spawnError=null;const started=new Date().toISOString(),child=spawn(process.execPath,args,{cwd:repo,env,windowsHide:true,stdio:['ignore','pipe','pipe']});
const stop=reason=>{limit??=reason;child.kill();};const timer=setTimeout(()=>stop('child-deadline30s'),30000);function collect(b,which){if(which==='out'){const remaining=1048576-outBytes;if(remaining>0)stdout.push(b.subarray(0,remaining));outBytes+=b.length;if(outBytes>1048576)stop('stdout1MiB');}else{const remaining=1048576-errBytes;if(remaining>0)stderr.push(b.subarray(0,remaining));errBytes+=b.length;if(errBytes>1048576)stop('stderr1MiB');}}
child.stdout.on('data',b=>collect(b,'out'));child.stderr.on('data',b=>collect(b,'err'));const result=await new Promise(resolve=>{child.on('error',e=>{spawnError=String(e);});child.on('close',(code,signal)=>resolve({code,signal}));});clearTimeout(timer);const ob=Buffer.concat(stdout),eb=Buffer.concat(stderr);await save(run+'/stdout.txt',ob);await save(run+'/stderr.txt',eb);
const after=await snapshot();await save(run+'/source-after.json',json(after));const stable={...before,readOperations:0,bytesRead:0};assert.deepEqual({...after,readOperations:0,bytesRead:0},stable);assert.deepEqual(id(await read(workspace,'work/editor-sketch-reviewed-installation-next/installation.json')),id(installationBytes));
const summary={};for(const name of ['tests','pass','fail','skipped','cancelled']){const found=[...ob.toString().matchAll(new RegExp('^# '+name+' (\\d+)$','gm'))];assert.equal(found.length,1,name);summary[name]=Number(found[0][1]);}
const acceptance=result.code===0&&result.signal===null&&spawnError===null&&limit===null&&summary.tests===13&&summary.pass===13&&summary.fail===0&&summary.skipped===0&&summary.cancelled===0;
await save('validation.json',json({schema:'rea-installed-editor-value-api-focused-record/v1',started,finished:new Date().toISOString(),installedPureAcceptance:acceptance,sourceStable:true,summary,child:{pid:child.pid,argv:args,...result,spawnError,limit,removedEnvironmentKeys:['NODE_TEST_CONTEXT','NODE_OPTIONS','NODE_V8_COVERAGE']},node:before.node,nodeVersion:before.nodeVersion,currentNamedSourceSnapshots:7,publicAliasesExact:475,currentFourAdditionsExact:4,originalEditor24Unchanged:true,historical31UnchangedPaths:30,historical31Changes:1,hostTransition:before.hostTransition,sourceIDSHAPairs:159,capabilityIDs:232,wholeCurrentRegistryEqualityClaim:false,raw:{stdout:id(ob),stderr:id(eb),observedStdoutBytes:outBytes,observedStderrBytes:errBytes},bounds:{directChildDeadlineMs:30000,stdoutMaxBytes:1048576,stderrMaxBytes:1048576,oldSpaceMiB:128,hardRSS:false,raceFreeDescendantIsolation:false,fingerprintIOHardDeadline:false},operations:{authorityScopes:authority,childCommands:1,applicationTestFileCommands:1,originalLibraryExecutions:0,originalProgramExecutions:0,hosts:0,browsers:0,benchmarks:0,...counters},scope:'Developer-consumable three-class value API only; current Editor client/extension host not bound to this module.',originalAppParity:0,fullProductParity:false,securityEquivalence:false,superiority:false,rootInstallationRecord:id(installationBytes),authorityPathsPreserved:true}));
await save('README.md',Buffer.from('This finite production-path correctness record executes exactly one installed pure API test file, with no original library/GUI, host/browser or benchmarks. It authenticates475 published API aliases, the four additions, unchanged24 Editor files/README, and159 source ID/SHA pairs plus232 capability IDs. The historical31 ledger has exactly one explicitly reconstructed99-byte shared host insertion807→85fe; the host is not executed here. Seven current source snapshots and exact collector/Node provenance, raw outputs and source-before/after observations are preserved. The prior source-composed VM campaigns remain historical and are not added to the observed13 groups. Full app parity is0; this is a developer foundation. Root owns publication. Direct-child/log/old-space bounds do not provide hard RSS, fingerprint I/O deadlines or race-free Windows descendant isolation.\n'));
const inventory={};let bytes=0;for(const p of await walk(stage)){const b=await read(stage,p);inventory[p]=id(b);bytes+=b.length;}await save('freeze-manifest.json',json({schema:'rea-installed-editor-value-api-focused-strict-freeze/v1',at:new Date().toISOString(),strict:true,selfExcluded:true,files:Object.keys(inventory).length,bytes,receiptSHA256:inventory['validation.json'].sha256,inventory}));
process.stdout.write(JSON.stringify({acceptance,summary,files:Object.keys(inventory).length,receipt:inventory['validation.json'],manifest:id(await read(stage,'freeze-manifest.json')),publicAliases:475,currentSnapshots:7,sourceStable:true})+'\n');
assert(acceptance,'Finite installed pure13 acceptance failed; source/raw/freeze retained');
