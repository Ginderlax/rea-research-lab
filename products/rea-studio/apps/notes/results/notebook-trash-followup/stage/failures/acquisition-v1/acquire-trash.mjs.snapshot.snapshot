import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const own=path.dirname(fileURLToPath(import.meta.url)),commit='7e2765a3857754d12dbadea442b60ceaf9d4b23d',files=['packages/lib/services/trash/index.ts','packages/lib/services/trash/index.test.ts','packages/lib/services/trash/restoreItems.ts','packages/lib/services/trash/restoreItems.test.ts','packages/lib/services/trash/getTrashFolderId.ts','packages/lib/services/trash/isTrashableItem.ts','readme/apps/trash.md','packages/lib/BaseModel.ts'];const records=[];
for(const p of files){const url='https://raw.githubusercontent.com/laurent22/joplin/'+commit+'/'+p,response=await fetch(url);assert.equal(response.status,200,p);const b=Buffer.from(await response.arrayBuffer()),target='original/'+p+'.snapshot';await fs.mkdir(path.dirname(path.join(own,target)),{recursive:true});await fs.writeFile(path.join(own,target),b,{flag:'wx'});records.push({path:target,url,bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});}
await fs.writeFile(path.join(own,'trash-source-provenance.json'),JSON.stringify({schema:'rea-joplin-released-trash-source/v1',acquiredAt:new Date().toISOString(),release:'Joplin Desktop3.6.14',commit,sourceAssisted:true,fullOriginalAppExecuted:false,records},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({sources:records.length,records},null,2));
