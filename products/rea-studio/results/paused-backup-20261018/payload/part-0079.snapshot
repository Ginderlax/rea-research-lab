    {
      "id": "grafana.candidate.b763df25ee901e9ac88f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can switch to a data source-managed alert rule if your data source is configured to support alert rule creation (Ruler API enabled). By default, the alert rule type is Grafana-managed.",
      "headingPath": [
        "What’s new in Grafana v10.1",
        "Alerting",
        "Alert rules",
        "Alert rule types"
      ],
