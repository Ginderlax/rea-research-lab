import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';
const here=path.dirname(fileURLToPath(import.meta.url)),fp=async name=>{const data=await fs.readFile(path.join(here,name));return {path:name,bytes:data.length,sha256:createHash('sha256').update(data).digest('hex')};};
const receipt={inspectedAt:new Date().toISOString(),method:'Rendered both one-page PDFs with bundled Poppler at100dpi; directly viewed both returned PNGs.',files:await Promise.all(['visual-qa/timing-ranges.png','visual-qa/memory-ranges-and-signed-deltas.png'].map(fp)),allSevenRowsLegible:true,titlesAxesLegendsFootersLegible:true,noObservedClippingOrOverlap:true,allPlottedMinMaxValuesWithinAxes:true,signedValuesUnclipped:true,figureGenerationReceiptRemainsExact:true,newMeasurementRun:false};await fs.writeFile(path.join(here,'visual-inspection.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
