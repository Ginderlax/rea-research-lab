      "syntaxRole": "table-row",
      "sourceText": "| color         | string/number | Can be used to specify a single color instead of using the `arc__` fields to specify color sections. It can be either a string which should then be an acceptable HTML color string or it can be a number in which case the behavior depends on `field.config.color.mode` setting. This can be for example used to create gradient colors controlled by the field value. |",
      "headingPath": [
        "Node graph",
        "Data API",
        "Nodes data frame structure"
      ],
