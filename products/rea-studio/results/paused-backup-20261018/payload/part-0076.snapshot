      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.72387726f7d441bab428",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Replace `<API_TOKEN>` with a valid Grafana API token, `<GRAFANA_URL>` with your Grafana instance URL, and `<DATASOURCE_ID>` with the numeric ID of the data source. Set `queryCachingTTL` to the desired cache duration in seconds.",
      "headingPath": [
        "Troubleshoot MySQL data source issues",
        "Other common issues",
        "Query caching can't be enabled on a provisioned data source"
      ],
      "source": {
