    },
    {
      "id": "grafana.candidate.620e8437fdd81a3fdc3d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can also update these parameters in the [image rendering configuration](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/setup-grafana/image-rendering/#configuration).",
      "headingPath": [
        "Share dashboards and panels",
        "Share panels",
        "Share an internal link",
        "Query string parameters for server-side rendered images"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/share-dashboards-panels/_index.md",
