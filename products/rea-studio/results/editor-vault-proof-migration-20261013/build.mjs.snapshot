 ['function read(p, expected, inert=false){const at=location(p),', 'function rawRead(p, expected, inert=false){const at=location(p),'],
 ['function json(p,expected){return JSON.parse(read(p,expected,true));}', 'const migration=createEditorVaultProofMigration(rawRead);function read(p,expected,inert=false){return rawRead(migration.resolve(p,expected)??p,expected,inert);}function json(p,expected){return JSON.parse(read(p,expected,true));}'],
 ["function finish(){for(const [p,id]of seen)read(p,id);", "function finish(){for(const [p,id]of seen)rawRead(p,id);"]
]);
