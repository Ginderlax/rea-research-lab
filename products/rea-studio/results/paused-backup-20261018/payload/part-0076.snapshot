    {
      "id": "grafana.candidate.61c3c2e4e6c5c59bee46",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Alert queries can't contain template variables. Grafana evaluates alert rules on the backend without dashboard context, so variables like `$hostname` or `$environment` aren't resolved.",
      "headingPath": [
