    {
      "id": "grafana.candidate.a6a56ac80df16108a342",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If Users use the same email address in Okta that they use with other authentication providers (such as Grafana.com), you need to do additional configuration to ensure that the users are matched correctly. Please refer to the [Using the same email address to login with different identity providers](../#using-the-same-email-address-to-login-with-different-identity-providers) documentation for more information.",
      "headingPath": [
        "Configure Okta OIDC authentication"
      ],
      "source": {
