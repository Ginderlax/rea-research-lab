import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const base=path.resolve(import.meta.dirname,'..'),root=path.join(base,'work/sketch-layout-precision-next'),prior=path.join(base,'work/sketch-alignment-next'),lab=path.join(base,'outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),bad='runs/2026-10-13T02-44-35.918Z',good='runs/2026-10-13T02-44-57.759Z',layout='products/rea-studio/apps/sketch/layout.mjs';
function read(n){return fs.readFileSync(path.join(root,n));}function json(n){return JSON.parse(read(n));}
const before=json(bad+'/source-before.json'),failedAfter=json(bad+'/source-after.json'),after=json(good+'/source-after.json'),successfulBefore=json(good+'/source-before.json');assert.deepEqual(before,failedAfter);assert.deepEqual(after,successfulBefore);assert.equal(before.length,56);assert.equal(after.length,56);const deltas=before.filter(r=>after.find(s=>s.path===r.path)?.sha256!==r.sha256);assert.deepEqual(deltas.map(r=>r.path),[layout]);
for(const r of after){const b=read(r.path);assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);}const old=fs.readFileSync(path.join(prior,layout),'utf8'),now=read(layout).toString('utf8'),oldBox=old.match(/^function box\(shapes\).*$/m)[0],newBox=now.match(/^function box\(shapes\).*$/m)[0];assert.equal(now.replace(newBox,oldBox).replace("import {validateScene,selectGroup} from './core.mjs';","import {bounds,validateScene,selectGroup} from './core.mjs';").replace('// Keep direct extrema: rebuilding an endpoint from a rounded width changes\n// fractional distribution coordinates, including signed lines and freehand.\n',''),old);
const fa=json(bad+'/attempt-validation.json'),sa=json(good+'/attempt-validation.json');assert.equal(fa.exitCode,1);assert.equal(fa.summary.tests,30);assert.equal(fa.summary.pass,28);assert.equal(fa.summary.fail,2);assert.equal(sa.exitCode,0);assert.equal(sa.summary.tests,30);assert.equal(sa.summary.pass,30);assert.equal(sa.summary.fail,0);for(const k of ['cancelled','skipped','todo'])assert.equal(sa.summary[k],0);
const pairCounts=[];for(const [label,total,failedExact]of[['review24-replay',24,23],['seed671ea912-250',2000,1755]]){const negative=json(bad+'/observations/precision/'+label+'.json'),positive=json(good+'/observations/precision/'+label+'.json');assert.equal(negative.pairs,total);assert.equal(negative.exactPairs,failedExact);assert.equal(positive.pairs,total);assert.equal(positive.exactPairs,total);assert.equal(positive.numericToleranceApplied,false);assert.deepEqual(negative.source,positive.source);pairCounts.push({label,pairs:total,baselineExact:failedExact,correctedExact:total});}
const legacy=json(good+'/observations/original-actions.json');assert.equal(legacy.pairedScenesAndActions,1944);const baseline=json('source-baseline.json');for(const r of baseline){assert.equal(sha(fs.readFileSync(path.join(lab,r.path))),r.sha256);assert.equal(sha(read('baseline/'+r.path+'.snapshot')),r.sha256);}
const changes={schema:'rea-sketch-layout-precision-runtime-change/v1',path:layout,before:{bytes:Buffer.byteLength(old),sha256:sha(Buffer.from(old))},after:{bytes:read(layout).length,sha256:sha(read(layout))},removedImport:'bounds',beforeBox:oldBox,afterBox:newBox,onlyRuntimeFileChanged:true,inverseReconstructs277CandidateExactly:true,coreBoundsUnchanged:true,testsAndOracleUnchangedBetweenRuns:true,reason:'Use direct coordinate extrema rather than reconstructing max from min plus rounded extent; preserves exact literal original helper arithmetic on disclosed unrotated point-bounds fixtures.'};fs.writeFileSync(path.join(root,'runtime-change.json'),JSON.stringify(changes,null,2)+'\n',{flag:'wx'});
const receipt={schema:'rea-sketch-layout-precision-correction-validation/v1',at:new Date().toISOString(),authorFiniteAcceptance:true,independentCorrectionAcceptance:false,priorCandidateManifest:'4684a6dffad102c461531476d4c24ad8b8eb5783b226aad9bbf82e2b81e0f2c7',independentNegativeManifest:'fed8216fa2a85da04ea0d2a16750f1fbb3891959f122272adb05222019f85559',baseline:{run:bad,summary:fa.summary,sourceFiles:56,sourceStable:true,pairCounts},current:{run:good,summary:sa.summary,sourceFiles:56,sourceStable:true,pairCounts},existingAuthorCorpus:1944,fractionalCorpus:2024,totalOriginalSceneActionPairsPerSuccessfulCampaign:3968,newIndependentHeldOutAcceptance:false,oraclePreparationsPerCampaign:3,selectedSourceSlicesPerPreparation:7,uniqueSourceUnitsPerPreparation:5,vmEvaluationsPerCampaign:3,originalHelperCallsPerSuccessfulCampaign:{align:2976,distribute:992},ownedUnrotatedPointBoundsAndOtherDependencies:true,exactOriginalMutationBodies:true,numericNormalization:false,inverseReconstruction:true,productionBaseline14Unchanged:true,productionWrites:0,browserAcceptance:false,originalGUI:0,benchmarks:0,fullParity:false,superiority:false};fs.writeFileSync(path.join(root,'validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
fs.writeFileSync(path.join(root,'README.md'),'# Sketch layout precision correction\n\nThe unchanged independent review found a last-bit horizontal distribution difference on fractional signed-line geometry. This separate correction preserves its111-file negative epoch and the prior277-file candidate by immutable authority references. The old implementation is reproduced in a source-stable30-test run:28 pass and2 fail. Its24 fractional review packets have23 exact outcomes; a new250-scene fractional corpus has1,755 exact outcomes out of2,000. All packets and raw logs remain unchanged.\n\nChanging only layout.mjs to aggregate direct minima/maxima fixes both corpora. A second source-stable30/30 run has no skipped/cancelled/todo checks,56 exact source files and3,968 exact original-helper pairs:1,944 existing author pairs +24 review diagnostic replays +2,000 newly authored seeded fractional pairs. Replaying independent fixtures is not fresh independent acceptance. Exact original helper/mutation bodies run in three bounded preparation VMs per campaign with disclosed owned unrotated geometry/binding/clock/random/scene/elbow dependencies. The correction reverses to the prior runtime exactly; core geometry/hit/render bounds stay unchanged.\n\nCurrent production14 baseline files remain exact. Actual browser, independent correction review, integration, full renderer/native binding/rotation/originalGUI and speed/resource/usability/reliability comparisons are pending. The complete-products goal remains open.\n',{flag:'wx'});fs.copyFileSync(import.meta.filename,path.join(root,'freeze-collector.mjs.snapshot'),fs.constants.COPYFILE_EXCL);
function inventory(dir=root,rel=''){return fs.readdirSync(dir,{withFileTypes:true}).flatMap(e=>{assert.ok(!e.isSymbolicLink());const n=rel?rel+'/'+e.name:e.name;if(e.isDirectory())return inventory(path.join(dir,e.name),n);const b=fs.readFileSync(path.join(dir,e.name));return[{path:n,bytes:b.length,sha256:sha(b)}];}).sort((a,b)=>a.path.localeCompare(b.path));}const records=inventory(),manifest={schema:'rea-sketch-layout-precision-correction-freeze/v1',at:new Date().toISOString(),files:records.length,totalBytes:records.reduce((n,r)=>n+r.bytes,0),records};const b=Buffer.from(JSON.stringify(manifest,null,2)+'\n');fs.writeFileSync(path.join(root,'freeze-manifest.json'),b,{flag:'wx'});console.log(JSON.stringify({records:records.length,totalBytes:manifest.totalBytes,manifestSHA256:sha(b),validationSHA256:sha(read('validation.json')),runtime:changes.after,tests:30,helperPairs:3968}));
