    {
      "id": "grafana.candidate.4d2c19c3bdc9a58f2ddd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Optional path to JSON key file associated with a Google service account to authenticate and authorize. If no value is provided it tries to use the [application default credentials](https://cloud.google.com/docs/authentication/production#finding_credentials_automatically). Service Account keys can be created and downloaded from https://console.developers.google.com/permissions/serviceaccounts.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[external_image_storage.gcs]`",
        "`key_file`"
      ],
      "source": {
