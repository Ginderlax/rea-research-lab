    {
      "id": "grafana.candidate.5764b5c48c3eb23ce69f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Whether to allow `http://` repository URLs together with a configured token. Because this sends the token in cleartext on every Git operation, it's rejected by default. Intended for local and development use only. It's also implicitly allowed when `app_mode = development`. Default is `false`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[provisioning]`",
        "`allow_insecure`"
      ],
      "source": {
