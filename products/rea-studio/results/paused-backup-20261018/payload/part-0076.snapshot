    {
      "id": "grafana.candidate.0c67bf227489325c15eb",
      "syntaxRole": "list-item",
      "sourceText": "- **Direction** - Determines the search order. **Backward** is a backward search starting at the end of the time range. **Forward** is a forward search starting at the beginning of the time range. The default is **Backward**.",
      "headingPath": [
        "Loki query editor",
        "Options"
