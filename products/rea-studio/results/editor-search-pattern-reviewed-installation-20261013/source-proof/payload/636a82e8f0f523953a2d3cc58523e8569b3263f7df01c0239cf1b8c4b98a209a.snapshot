// Preserve exact pre-fix test/source evidence; apply only declared narrow deltas.
import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const root=import.meta.dirname,app='candidate/products/rea-studio/apps/editor',sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)}),deltas=[];async function keep(p,b){const q=path.join(root,p);await fs.mkdir(path.dirname(q),{recursive:true});await fs.writeFile(q,b,{flag:'wx'});}
for(const n of['native-model-before.stdout.txt','native-model-before.stderr.txt'])await keep('negative-model/'+n+'.snapshot',await fs.readFile(path.join(root,n)));await keep('negative-model/textarea-navigation.ui.test.mjs.snapshot',await fs.readFile(path.join(root,app,'textarea-navigation.ui.test.mjs')));
async function transform(name,before,after,label){const file=path.join(root,app,name),raw=await fs.readFile(file),text=raw.toString();assert.equal(text.split(before).length,2,label);const next=Buffer.from(text.replace(before,after));deltas.push({file:app+'/'+name,label,before,idBefore:id(raw),after,idAfter:id(next),occurrences:1});await fs.writeFile(file,next);}
const helper=`function textareaSelection(content,start,end,value) {
  if(typeof content!=='string'||typeof value!=='string'||!Number.isSafeInteger(start)||!Number.isSafeInteger(end)||start<0||end<start||end>content.length)return null;
  // Native textarea.value folds CRLF and bare CR to LF. Saved revisions and
  // source offsets still describe the exact raw saved string.
  if(content.replace(/\\r\\n?/g,'\\n')!==value)return null;
  const interior=index=>{if(index===0||index===content.length)return false;const a=content.charCodeAt(index-1),b=content.charCodeAt(index);return a===13&&b===10||a>=0xd800&&a<=0xdbff&&b>=0xdc00&&b<=0xdfff;};
  if(interior(start)||interior(end))return null;
  let normalizedStart=start,normalizedEnd=end;
  for(let i=0;i<end;i++)if(content.charCodeAt(i)===13&&content.charCodeAt(i+1)===10){if(i<start)normalizedStart--;normalizedEnd--;i++;}
  return {start:normalizedStart,end:normalizedEnd};
}
`;
await transform('client.mjs','export async function render(root, api) {',helper+'export async function render(root, api) {','Insert trusted fixed-normalization + linear offset adapter; no new import/static route');
await transform('client.mjs','          editor.focus();editor.setSelectionRange(match.start,match.end);state.textContent=',"          const selection=textareaSelection(item.content,match.start,match.end,editor.value);\n          if(!selection){state.textContent='The saved result does not match the text shown or its positions. Save or reopen the file, then search again.';return;}\n          editor.focus();editor.setSelectionRange(selection.start,selection.end);state.textContent=",'Preserve previous revision/draft/generation guards and add exact shown-text/valid-interval guard before DOM selection');
await transform('search-pattern.ui.test.mjs',"this.attributes={};this.value='';", "this.attributes={};this._value='';",'Native textarea fixture stores private normalized value');
await transform('search-pattern.ui.test.mjs',"this.selectionStart=this.selectionEnd=0;}append", "this.selectionStart=this.selectionEnd=0;}get value(){return this._value;}set value(v){const value=this.tagName==='textarea'?String(v).replace(/\\r\\n?/g,'\\n'):String(v);if(value!==this._value){this._value=value;if(this.tagName==='textarea')this.selectionStart=this.selectionEnd=value.length;}}append",'Declared fixture adapter: native CRLF/bare-CR normalization and changed-value caret reset');
await transform('search-pattern.ui.test.mjs',"assert.equal(editor.selectionStart,12);assert.equal(editor.selectionEnd,20);", "assert.equal(editor.selectionStart,11);assert.equal(editor.selectionEnd,19);",'Correct first CRLF normalized DOM endpoints; saved/source result body unchanged');
let file=path.join(root,app,'search-pattern.ui.test.mjs'),raw=await fs.readFile(file),old=raw.toString(),needle="assert.equal(editor.value,'🧪cat cats\\r\\nnext cat\\n');",replacement="assert.equal(editor.value,'🧪cat cats\\nnext cat\\n');";assert.equal(old.split(needle).length-1,3);let next=Buffer.from(old.replaceAll(needle,replacement));await fs.writeFile(file,next);deltas.push({file:app+'/search-pattern.ui.test.mjs',label:'Three explicit textarea-value assertions use normalized LF; disk content assertion retains CRLF',before:needle,after:replacement,occurrences:3,idBefore:id(raw),idAfter:id(next)});
await keep('correction-deltas.json',Buffer.from(JSON.stringify({sourceAssisted:false,scope:'Narrow client coordinate fix and declared DOM-model correction, no backend/pattern/worker changes; inverse applies reverse substitutions in reverse order.',rows:deltas,old573AndOld78BodiesHistorical:true},null,2)+'\n'));console.log(JSON.stringify({clientSubstitutions:2,declaredFixtureSubstitutions:6,productionWrites:0,originalCalls:0}));
