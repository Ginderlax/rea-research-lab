MAX_ARCHIVE=32*1024*1024
MAX_RAW_TOTAL=64*1024*1024
MAX_MEMBER=24*1024*1024
def pin(raw):return {'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()}
def canonical(value):return json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode('utf-8')
def safe(name):
 assert isinstance(name,str)and name and not re.search(r'[\\:\x00-\x1f\x7f]',name)and not name.startswith('/')
 assert all(p not in ('','.','..')for p in name.split('/'));return name
def no_link(p):
 for part in [p,*p.parents]:
  try:s=part.lstat()
  except FileNotFoundError:continue
  assert not stat.S_ISLNK(s.st_mode)and not getattr(s,'st_file_attributes',0)&getattr(stat,'FILE_ATTRIBUTE_REPARSE_POINT',0x400),str(part)
 return p
def read(p,limit=MAX_MEMBER):
 no_link(p);s=p.stat();assert stat.S_ISREG(s.st_mode)and s.st_size<=limit
 b=p.read_bytes();assert len(b)==s.st_size;return b
def json_bytes(raw):
 def pairs(rows):
  result={}
  for k,v in rows:assert k not in result,'Duplicate JSON key';result[k]=v
  return result
 return json.loads(raw.decode('utf-8-sig'),object_pairs_hook=pairs,parse_constant=lambda value:(_ for _ in ()).throw(ValueError(value)))
def json_file(p):return json_bytes(read(p,64*1024*1024))
def same_pin(raw,row):assert pin(raw)=={k:row[k]for k in ('bytes','sha256')}
def rows_map(rows):
 assert isinstance(rows,list);result={}
 for row in rows:
  name=safe(row['path']);assert name not in result;assert type(row['bytes'])is int and row['bytes']>=0 and re.fullmatch(r'[0-9a-f]{64}',row['sha256']);result[name]=row
 return result
def sha_object(raw):return hashlib.sha1(b'blob '+str(len(raw)).encode()+b'\0'+raw).hexdigest()
def eligible(name):
 parts=PurePosixPath(safe(name)).parts
 return bool(parts and not any(p in ('.local','node_modules')for p in parts[:-1])and(parts[0]in ['apps','lib','public','scripts','tests']or name in ['server.mjs','catalog.mjs','package.json'])and re.search(r'\.(mjs|json|html|css|ps1)$',name))
def same_attempt(value,tested):
 assert value['GITHUB_RUN_ID']==RUN and value['GITHUB_RUN_ATTEMPT']==str(ATTEMPT)and value['GITHUB_SHA']==tested and value['GITHUB_REPOSITORY']==REPOSITORY
def api_tree(value,tree_sha):
 assert value['sha']==tree_sha and value['truncated']is False and isinstance(value['tree'],list)
 found={}
 for row in value['tree']:
  name=safe(row['path']);assert name not in found;found[name]=row
 return found
def unpack(raw,destination):
 destination.mkdir(exist_ok=False);records=[];names=set();casefold=set()
 with zipfile.ZipFile(io.BytesIO(raw))as archive:
  entries=archive.infolist();assert len(entries)<=3000 and sum(e.file_size for e in entries)<=MAX_RAW_TOTAL
  for e in entries:
   name=e.filename[:-1]if e.is_dir()else e.filename;safe(name)
   assert e.filename not in names and e.filename.casefold()not in casefold
   names.add(e.filename);casefold.add(e.filename.casefold())
   assert not e.flag_bits&1 and not stat.S_ISLNK(e.external_attr>>16)and 0<=e.file_size<=MAX_MEMBER
   p=destination.joinpath(*PurePosixPath(name).parts);assert p.resolve().is_relative_to(destination.resolve());no_link(p)
   if e.is_dir():p.mkdir(parents=True,exist_ok=True);continue
   data=archive.read(e);assert len(data)==e.file_size and zlib.crc32(data)&0xffffffff==e.CRC
   p.parent.mkdir(parents=True,exist_ok=True)
   with p.open('xb')as stream:stream.write(data)
   assert read(p)==data;records.append({'path':e.filename,**pin(data)})
 return records
