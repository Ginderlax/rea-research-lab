import fs from 'node:fs/promises';import path from 'node:path';import {spawnSync} from 'node:child_process';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const here=import.meta.dirname,root=path.resolve(here,'../editor-search-path-fix-next'),sha=bytes=>createHash('sha256').update(bytes).digest('hex'),fp=async file=>{const bytes=await fs.readFile(file);return{bytes:bytes.length,sha256:sha(bytes)};};
const manifestBytes=await fs.readFile(path.join(root,'freeze-manifest.json')),manifest=JSON.parse(manifestBytes);assert.equal(sha(manifestBytes),'d071d370be094646a4738de79adadca9c28d794de53dfb940604f5d52d056edf');assert.equal(Object.keys(manifest.inventory).length,126);async function authenticate(){for(const [name,row] of Object.entries(manifest.inventory))assert.deepEqual(await fp(path.join(root,name)),row);assert.ok((await fs.readFile(path.join(root,'freeze-manifest.json'))).equals(manifestBytes));}await authenticate();
const snapshots=[];for(const name of [...Object.keys(manifest.inventory),'freeze-manifest.json']){const bytes=await fs.readFile(path.join(root,name)),relative='preserved/accepted126/'+name.replaceAll('node_modules','synthetic-excluded-dependency')+'.snapshot';await fs.mkdir(path.dirname(path.join(here,relative)),{recursive:true});await fs.writeFile(path.join(here,relative),bytes,{flag:'wx'});snapshots.push({sourcePath:path.join(root,name),path:relative,bytes:bytes.length,sha256:sha(bytes)});}
const name='held-save.test.mjs',source=await fp(path.join(here,name)),start=new Date().toISOString(),child=spawnSync(process.execPath,['--test','--test-reporter=tap',path.join(here,name)],{encoding:'utf8',windowsHide:true,timeout:60000,maxBuffer:2*1024*1024}),stdout=child.stdout??'',stderr=child.stderr??'';for(const [name,bytes] of [['tests.stdout.txt',stdout],['tests.stderr.txt',stderr]])await fs.writeFile(path.join(here,name),bytes,{flag:'wx'});const counts=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(key=>[key,Number(stdout.match(new RegExp('^# '+key+' (\\d+)$','m'))?.[1])]));await authenticate();assert.deepEqual(await fp(path.join(here,name)),source);const receipt={schema:'rea-editor-save-independent-negative-review/v1',checkedAt:new Date().toISOString(),candidateManifestSHA256:sha(manifestBytes),candidateFiles:126,candidateSourceBeforeAfterStable:true,test:{name,source,start,end:new Date().toISOString(),exitCode:child.status,signal:child.signal,error:child.error?.message,counts,stdout:{path:'tests.stdout.txt',...await fp(path.join(here,'tests.stdout.txt'))},stderr:{path:'tests.stderr.txt',...await fp(path.join(here,'tests.stderr.txt'))}},snapshots,heldAfterRealSaveCommit:true,syntheticFailedSaveControlDidNotCommit:true,actualClientAndHandleModules:true,actualBrowser:false,originalEngineExecutions:0,measurementsOrProfiles:false,productionChanged:false,acceptance:false};await fs.writeFile(path.join(here,'review-observations.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:'negative observations retained',counts,childExitCode:child.status,sourceStable:true,snapshots:snapshots.length}));assert.equal(child.signal,null);assert.equal(counts.cancelled,0);assert.equal(counts.skipped,0);
