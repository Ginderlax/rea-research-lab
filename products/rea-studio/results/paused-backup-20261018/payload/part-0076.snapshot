    {
      "id": "grafana.candidate.8205e5b3796ed396710f",
      "syntaxRole": "table-row",
      "sourceText": "| `$__time(dateColumn)`                     | Renames the column to `time`. Example: `dateColumn AS \"time\"`. Use for native date/time columns.                                                                                                              |",
      "headingPath": [
        "PostgreSQL query editor",
        "Macros",
        "Time-series macros"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/query-editor/_index.md",
