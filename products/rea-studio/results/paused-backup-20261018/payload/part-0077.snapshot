    {
      "id": "grafana.candidate.bf290bf696e97508e9e0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For the `login_logo` option, Grafana recommends using SVG files that are 48 pixels by 48 pixels or smaller. You also don't need to use the `url()` function for `login_logo`.",
      "headingPath": [
        "Configure custom branding"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/configure-custom-branding/index.md",
        "gitBlobSha": "626068ce514684ffda01cbb550ec0d7bfca40775",
