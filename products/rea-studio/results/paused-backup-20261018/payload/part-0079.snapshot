    {
      "id": "grafana.candidate.32fc0500c2e5e94a2ae0",
      "syntaxRole": "table-row",
      "sourceText": "| Symbol | Allows you to choose the symbol, icon, or graphic to aid in providing additional visual context to your data. Choose from assets that are included with Grafana such as simple symbols or the Unicon library. You can also specify a URL containing an image asset. The image must be a scalable vector graphic (SVG). |",
      "headingPath": [
        "Geomap",
        "Configuration options",
        "Map layers options",
        "Markers layer"
      ],
      "source": {
