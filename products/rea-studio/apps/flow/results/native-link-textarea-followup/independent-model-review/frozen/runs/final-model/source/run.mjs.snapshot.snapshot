import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{spawn}from'node:child_process';
const own=import.meta.dirname,base=path.resolve(own,'../..'),out=path.join(own,'runs/final-model'),sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)});fs.mkdirSync(out,{recursive:true});
const authority=JSON.parse(fs.readFileSync(path.join(own,'authority-before.json'))),files=['run.mjs','independent.test.mjs','fixture.mjs','replay/normalization-ui.test.mjs','source/browser28-seed.json.snapshot'],source=files.map(p=>({root:'owned-review',path:p,...id(fs.readFileSync(path.join(own,p)))}));for(const r of authority)assert.deepEqual(id(fs.readFileSync(path.join(base,r.root,r.path))),{bytes:r.bytes,sha256:r.sha256});
fs.writeFileSync(path.join(out,'source-before.json'),JSON.stringify({authority,reviewSources:source},null,2)+'\n',{flag:'wx'});for(const p of files){const at=path.join(out,'source',p+'.snapshot');fs.mkdirSync(path.dirname(at),{recursive:true});fs.writeFileSync(at,fs.readFileSync(path.join(own,p)),{flag:'wx'});}
const binary=fs.readFileSync(process.execPath);assert.equal(sha(binary),'b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3');fs.writeFileSync(path.join(out,'node-provenance.json'),JSON.stringify({path:process.execPath,version:process.version,...id(binary),originalProgram:false},null,2)+'\n',{flag:'wx'});
const started=new Date().toISOString(),observations=path.join(out,'observations');fs.mkdirSync(observations);const env={...process.env,FLOW_LINK_OBSERVATIONS:observations};delete env.NODE_TEST_CONTEXT;const args=['--test',path.join(own,'replay/normalization-ui.test.mjs'),path.join(own,'independent.test.mjs')];
const child=spawn(process.execPath,args,{cwd:own,env,windowsHide:true,shell:false,stdio:['ignore','pipe','pipe']});let stdout=Buffer.alloc(0),stderr=Buffer.alloc(0),failure=null;const limit=2*1024*1024,deadline=setTimeout(()=>{failure={type:'deadline',milliseconds:20000};child.kill();},20000);function collect(which,b){const prior=which==='stdout'?stdout:stderr;if(prior.length+b.length>limit){failure={type:'output-cap',stream:which,bytes:prior.length+b.length};child.kill();return;}if(which==='stdout')stdout=Buffer.concat([prior,b]);else stderr=Buffer.concat([prior,b]);}child.stdout.on('data',b=>collect('stdout',b));child.stderr.on('data',b=>collect('stderr',b));child.on('error',e=>failure={type:'spawn',name:e.name,message:e.message});const exit=await new Promise(r=>child.on('close',(code,signal)=>r({code,signal})));clearTimeout(deadline);
fs.writeFileSync(path.join(out,'stdout.txt'),stdout,{flag:'wx'});fs.writeFileSync(path.join(out,'stderr.txt'),stderr,{flag:'wx'});const summary={};for(const k of ['tests','pass','fail','cancelled','skipped','todo']){const m=stdout.toString().match(new RegExp('^# '+k+' (\\d+)$','m'));assert(m,'Missing TAP '+k);summary[k]=Number(m[1]);}
for(const r of authority)assert.deepEqual(id(fs.readFileSync(path.join(base,r.root,r.path))),{bytes:r.bytes,sha256:r.sha256});for(const r of source)assert.deepEqual(id(fs.readFileSync(path.join(own,r.path))),{bytes:r.bytes,sha256:r.sha256});fs.writeFileSync(path.join(out,'source-after.json'),JSON.stringify({authority,reviewSources:source},null,2)+'\n',{flag:'wx'});
const result={schema:'rea-flow-textarea-independent-model-run/v1',startedAt:started,finishedAt:new Date().toISOString(),exit,failure,summary,sourceStable:true,authorityRows:authority.length,ownedSources:source.length,stdout:id(stdout),stderr:id(stderr),replayGroups:14,freshReviewerGroups:10,originalExecutions:0,browserExecutions:0,httpHosts:0,productionWrites:0,qualifier:'Actual candidate client/MemoryStore handler via native-normalizing model. Programmatic edits while disabled are defensive only. Blob text assertions do not prove browser downloads.',fullProductParity:false};fs.writeFileSync(path.join(out,'run.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(result));if(exit.code!==0||failure||summary.fail||summary.cancelled||summary.skipped||summary.todo)process.exitCode=1;
