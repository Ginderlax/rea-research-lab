    {
      "id": "grafana.candidate.d70bdeddaa61b9521dad",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Optional: Choose any tags to use in the query. Click **Add tag** to add a tag mapping.",
      "headingPath": [
        "Configure trace to metrics correlation",
        "Set up custom queries"
      ],
      "source": {
        "path": "docs/sources/datasources/tempo/configure-tempo-data-source/configure-trace-to-metrics.md",
        "gitBlobSha": "3a874f96d0fd6bc3d0ed6847f9cf1e6fda46c416",
        "sha256": "07a34143f831f7b56fc90f88ad40803b34f7d385a85ec30be2c12ba376c15cae",
        "lineStart": 83,
        "lineEnd": 83,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/tempo/configure-tempo-data-source/configure-trace-to-metrics.md#L83-L83"
      },
