    {
      "id": "grafana.candidate.1b8429c447b1b3eea4d0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The new navigation is gradually rolling out to all users on Grafana Cloud. If you’re using Grafana Open Source and Enterprise, you can enable this feature using the `topnav` [feature toggle](../../setup-grafana/configure-grafana/#feature_toggles).",
