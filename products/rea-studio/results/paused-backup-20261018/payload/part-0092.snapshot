${lib_declarations}
${lib_dir_declarations}

py.extension_module('${modulename}',
                     [
${source_list},
                     fortranobject_c
                     ],
                     include_directories: [
                     inc_np,
${inc_list}
                     ],
                     objects: [
${obj_list}
                     ],
                     dependencies : [
                     py_dep,
                     quadmath_dep,
${dep_list}
${lib_list}
${lib_dir_list}
                     ],
${fortran_args}
                     install : true)
