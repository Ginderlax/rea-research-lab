    {
      "id": "grafana.candidate.005d283c890f25c601f4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Rendering a flame graph over a large time range requires the Pyroscope backend to merge many profiles, which increases query time and memory use. Large or high-cardinality ranges can exceed request timeouts before a result returns.",
      "headingPath": [
