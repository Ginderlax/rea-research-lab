import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const root=import.meta.dirname,sha=b=>createHash('sha256').update(b).digest('hex'),identity=b=>({bytes:b.length,sha256:sha(b)}),rows=[];async function walk(folder=''){for(const e of(await fs.readdir(path.join(root,folder),{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const p=folder?folder+'/'+e.name:e.name;if(e.isSymbolicLink())throw Error('Freeze refuses link '+p);if(e.isDirectory())await walk(p);else if(e.isFile()&&p!=='freeze-manifest.json'){const b=await fs.readFile(path.join(root,p));rows.push({path:p,...identity(b)});}else if(!e.isFile())throw Error('Freeze refuses non-file '+p);}}await walk();
const current=JSON.parse(await fs.readFile(path.join(root,'candidate-final-sources.json')));for(const r of current.rows)assert.deepEqual(identity(await fs.readFile(path.join(root,r.path))),{bytes:r.bytes,sha256:r.sha256});const manifest={schema:'rea-editor-pattern-candidate-freeze/v1',frozenAt:new Date().toISOString(),inventory:rows,payloadCount:rows.length,payloadBytes:rows.reduce((n,r)=>n+r.bytes,0),source39Stable:true,containsNoOriginalExecutableOrArchive:true,scope:'Exact work-only candidate, beforeimages, complete official MIT source, selected helper/engine logs, original divergences, all failed attempts and owned synthetic fixtures. No current Studio/public/registry mutations; independent acceptance pending.'};const b=Buffer.from(JSON.stringify(manifest,null,2)+'\n');await fs.writeFile(path.join(root,'freeze-manifest.json'),b,{flag:'wx'});for(const r of rows)assert.deepEqual(identity(await fs.readFile(path.join(root,r.path))),{bytes:r.bytes,sha256:r.sha256});const discovered=[];async function census(folder=''){for(const e of await fs.readdir(path.join(root,folder),{withFileTypes:true})){const p=folder?folder+'/'+e.name:e.name;if(e.isDirectory())await census(p);else if(e.isFile())discovered.push(p);else throw Error('Unsupported freeze entry');}}await census();assert.deepEqual(discovered.filter(p=>p!=='freeze-manifest.json').sort(),rows.map(r=>r.path).sort());const validation=await fs.readFile(path.join(root,'validation.json'));console.log(JSON.stringify({payloads:rows.length,payloadBytes:manifest.payloadBytes,manifest:{bytes:b.length,sha256:sha(b)},validation:identity(validation),strictAfterAuthenticated:true}));
