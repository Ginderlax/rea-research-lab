    {
      "id": "grafana.candidate.f773dd366dc62fb385c7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Because the forecast is stored in the `grafanacloud-ml-metrics` Prometheus data source, you can use the forecast metrics directly in alert rules to detect:",
      "headingPath": [
        "Alerting on forecasts",
        "Seasonal forecast with Grafana Cloud Machine Learning"
