    },
    {
      "id": "grafana.candidate.62d1e3e91157ffc097de",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This approach ensures that a schema exists even when one query returns no data.",
      "headingPath": [
        "SQL expressions",
        "Known limitations",
        "Schema changes and missing data",
        "Example: Handling Prometheus no data"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/sql-expressions/index.md",
