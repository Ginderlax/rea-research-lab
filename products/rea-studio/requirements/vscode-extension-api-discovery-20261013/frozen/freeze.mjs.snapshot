await write('validation.json',receipt);
const excluded=['preservation-manifest.json','freeze.json'],publicPaths=(await walk()).filter(p=>!p.startsWith('.local/')&&!excluded.includes(p)),records=await Promise.all(publicPaths.map(fp));
for(const r of records){const b=await fs.readFile(path.join(root,r.path));if(b.subarray(0,2).toString()==='MZ'||b.subarray(0,4).equals(Buffer.from('504b0304','hex'))||b.subarray(0,2).equals(Buffer.from('1f8b','hex'))||b.subarray(0,8).equals(Buffer.from('03d9a29a67fb4bb5','hex')))throw new Error('Native/archive payload in public subset '+r.path);}
await write('preservation-manifest.json',{schema:'rea-strict-source-discovery-public-preservation/v1',strict:true,excluded:['.local/**',...excluded],publicArtifacts:records.length,records,fullSourceRedistribution:'Exact Microsoft MIT notice retained; this inventory is one declaration file, not full product documentation discovery.',localOnlyCache:await fp('local-only-cache.json')});
await write('freeze.json',{at:new Date().toISOString(),manifest:await fp('preservation-manifest.json'),receipt:await fp('validation.json'),artifacts:records.length,localOnlyFiles:local.length,ownedProcessesRunning:0});console.log(JSON.stringify({publicArtifacts:records.length,localOnlyFiles:local.length,manifest:await fp('preservation-manifest.json'),receipt:await fp('validation.json')}));
