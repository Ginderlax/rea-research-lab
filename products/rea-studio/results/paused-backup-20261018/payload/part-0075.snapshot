        "lineStart": 48,
        "lineEnd": 48,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/examples/multi-dimensional-alerts.md#L48-L48"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.d4aab18ff505d8f618c8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This pattern is common in dynamic environments when monitoring a group of components like multiple CPUs, containers, or per-host availability. Instead of defining individual alert rules or aggregated alerts, you alert on _each dimension_ — so you can detect particular issues and include that level of detail in notifications.",
      "headingPath": [
        "Example of multi-dimensional alerts on time series data"
      ],
      "source": {
        "path": "docs/sources/alerting/examples/multi-dimensional-alerts.md",
        "gitBlobSha": "bf496b32b55a4738ca06289b54503b871254f5b5",
        "sha256": "f21763e80362a75476569617eba5511fd7c01c1a8367feff70e1f1c3b293cb5e",
