        "lineStart": 60,
        "lineEnd": 60,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/tempo/configure-tempo-data-source/configure-trace-to-metrics.md#L60-L60"
      },
