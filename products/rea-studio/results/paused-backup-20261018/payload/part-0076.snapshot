    {
      "id": "grafana.candidate.411893c632505ff9f5f7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This document provides troubleshooting information for common errors you may encounter when using the PostgreSQL data source in Grafana.",
