    {
      "id": "grafana.candidate.bfdbaf957d9e020242e1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "With Graphite data sources, you can only create query variables. Grafana supports three specific query types for Graphite-based variables:",
