import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import {start} from '../../server.mjs';
import {handle,dispose,webdavServiceLimits} from './server.mjs';
import {fixtureServer} from './scripts/webdav-fixture.mjs';
const auth={type:'basic',username:'synthetic-user',password:'synthetic-only-password'};
test('real host HTTP WebDAV approvals, exact retention, restart status and expired volatile plan',async()=>{
  const dataDir=await fs.mkdtemp(path.join(os.tmpdir(),'rea-dav-host-')),fixture=await fixtureServer({seed:{'out/replace.txt':'old','out/extra.txt':'remove','out/excluded.tmp':'keep'},auth});let host=await start({port:0,dataDir});
  const call=async(action,input={},expected=200)=>{const response=await fetch(`${host.url}/api/sync/${action}`,{method:'POST',headers:{'Content-Type':'application/json','x-rea-token':host.token},body:JSON.stringify(input)}),value=await response.json();assert.equal(response.status,expected,value.error);return value.result??value;};
  try{await call('putFile',{path:'dav/source/replace.txt',content:'replacement'});await call('putFile',{path:'dav/source/sub/new.txt',content:'new'});const settings={endpoint:fixture.endpoint,auth},input={...settings,source:'dav/source',destination:'out',mode:'sync',filters:{exclude:['*.tmp']}},preview=await call('webdav-plan',input);assert.deepEqual(preview.counts,{copy:2,remove:1,mkdir:1});assert.equal(fixture.entries.get('out/replace.txt').bytes.toString(),'old');await call('webdav-apply',{...settings,token:preview.token,confirm:true},400);const result=await call('webdav-apply',{...settings,token:preview.token,confirm:true,allowDeletes:true});assert.equal(result.status,'completed');assert.equal(fixture.entries.get('out/replace.txt').bytes.toString(),'replacement');assert.equal(fixture.entries.get('out/excluded.tmp').bytes.toString(),'keep');assert.ok(!fixture.entries.has('out/extra.txt'));const workspace=path.join(dataDir,'sync','workspace'),history=path.join(workspace,...result.retainedAt.split('/')),manifest=JSON.parse(await fs.readFile(path.join(history,'manifest.json'),'utf8'));assert.deepEqual(manifest.retained.map(x=>x.path),['replace.txt','extra.txt']);assert.equal((await fs.readFile(path.join(history,manifest.retained[0].bytes))).toString(),'old');assert.ok(!JSON.stringify(manifest).includes(auth.password));const pending=await call('webdav-plan',input);await host.close();host=await start({port:0,dataDir});assert.deepEqual((await call('webdav-status')).lastResult,result);await call('webdav-apply',{...settings,token:pending.token,confirm:true,allowDeletes:true},400);assert.equal((await call('webdav-status')).cache.plans,0);const response=await fetch(`${host.url}/apps/sync/client.mjs`);assert.equal(response.status,200);assert.match(await response.text(),/webdav-controls/);}finally{await host.close();await fixture.close();await fs.rm(dataDir,{recursive:true,force:true});}
});
test('Sync dispatcher bypasses old queue, refuses concurrent credential requests and disposer cancels scope',async()=>{
  const root=await fs.mkdtemp(path.join(os.tmpdir(),'rea-dav-dispose-')),fixture=await fixtureServer({auth}),workspace={root};let entered;const ready=new Promise(resolve=>entered=resolve);fixture.failures.set('PROPFIND ',{run(){entered();}});
  try{const pending=handle({action:'webdav-list',input:{endpoint:fixture.endpoint,auth},workspace});await ready;await assert.rejects(handle({action:'webdav-list',input:{endpoint:fixture.endpoint,auth},workspace}),/already running/);assert.equal(fixture.requests.length,1);dispose(workspace);await assert.rejects(pending,/closed/);fixture.failures.clear();assert.equal((await handle({action:'webdav-status',input:{},workspace})).cache.plans,0);}finally{dispose(workspace);await fixture.close();await fs.rm(root,{recursive:true,force:true});}
});
test('workspace service instances have a global bound and release on disposal',async()=>{
  const roots=[];try{for(let i=0;i<=webdavServiceLimits.workspaces;i++)roots.push(await fs.mkdtemp(path.join(os.tmpdir(),'rea-dav-cap-')));for(const root of roots.slice(0,-1))await handle({action:'webdav-status',input:{},workspace:{root}});await assert.rejects(handle({action:'webdav-status',input:{},workspace:{root:roots.at(-1)}}),/service limit/);dispose({root:roots[0]});assert.equal((await handle({action:'webdav-status',input:{},workspace:{root:roots.at(-1)}})).cache.plans,0);}finally{for(const root of roots){dispose({root});await fs.rm(root,{recursive:true,force:true});}}
});
test('real HTTP host immediately rejects a second credential-bearing WebDAV request',async()=>{
  const dataDir=await fs.mkdtemp(path.join(os.tmpdir(),'rea-dav-http-busy-')),fixture=await fixtureServer({auth}),host=await start({port:0,dataDir});let entered,release;const ready=new Promise(resolve=>entered=resolve);fixture.failures.set('PROPFIND ',{run(req,res){release=()=>{res.writeHead(207,{'Content-Type':'application/xml'});res.end(fixture.xml(['']));};entered();}});
  const settings={endpoint:fixture.endpoint,auth},send=(controller)=>fetch(`${host.url}/api/sync/webdav-list`,{method:'POST',headers:{'Content-Type':'application/json','x-rea-token':host.token},body:JSON.stringify(settings),signal:controller?.signal});let first,second,timer;
  try{first=send();await ready;const controller=new AbortController(),bounded=new Promise((_,reject)=>{timer=setTimeout(()=>{controller.abort();reject(Error('Second HTTP request remained queued.'));},1200);});second=await Promise.race([send(controller),bounded]);clearTimeout(timer);assert.equal(second.status,400);assert.match((await second.json()).error,/already running/);assert.equal(fixture.requests.length,1);release();release=null;assert.equal((await first).status,200);}finally{clearTimeout(timer);release?.();if(first)await first.catch(()=>{});await host.close();await fixture.close();await fs.rm(dataDir,{recursive:true,force:true});}
});
