    },
    {
      "id": "grafana.candidate.7cf31a3e4a9cac7fd979",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now use the `hidden_users` configuration setting to hide specific users in the UI. For example, this feature can be used to hide users that are used for automation purposes.",
      "headingPath": [
        "What's new in Grafana v7.4",
        "Grafana OSS features",
        "Hide users in UI"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-4.md",
