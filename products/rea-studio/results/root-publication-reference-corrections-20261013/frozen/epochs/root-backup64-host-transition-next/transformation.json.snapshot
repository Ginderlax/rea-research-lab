      "before": "// The455 checkpoint remains historical when subsequent reviewed runtime/docs change.",
      "after": "function backup64SourceFingerprint(entry){if(entry.path!=='products/rea-studio/server.mjs')return currentPublicFingerprint(entry,'Current64 aggregate Backup source');safeRecordPath(entry.path);assert.equal(entry.bytes,7741);assert.equal(entry.sha256,'807a473ec0334f60dfd58f2df8901c722f1bd4eb1d64c62d9ba1ea65c2b6b55f');const transition=followupEvidence.editorHostTransition;assert.equal(transition.path,entry.path);assert.deepEqual(transition.before,{bytes:entry.bytes,sha256:entry.sha256});assert.equal(transition.addedStaticMapLineBytes,99);assert.equal(transition.historical3baHostAndInverseExact,true);const live=readFileSync(join(root,entry.path));assert.equal(live.length,transition.after.bytes);assert.equal(sha(live),transition.after.sha256);const prefix='products/rea-studio/results/milestones/search-trash-recycle-save-3baecf4e-20261013',mb=readFileSync(join(root,prefix,'snapshot-manifest.json'));assert.equal(sha(mb),'d969655ed6d1e73f925147c277261b38333e2d095b18a486f2c7c2a7700689ff');const m=JSON.parse(mb),rows=m.sourceSnapshots.filter(r=>r.sourcePath===entry.path);assert.equal(rows.length,1);const r=rows[0];safeRecordPath(r.snapshotPath);assert.ok(r.snapshotPath.startsWith('products/rea-studio/results/search-trash-recycle-save-combined-20261013/source/'));assert.equal(r.bytes,entry.bytes);assert.equal(r.sha256,entry.sha256);const old=readFileSync(join(root,r.snapshotPath));assert.equal(old.length,entry.bytes);assert.equal(sha(old),entry.sha256);}\n// The455 checkpoint remains historical when subsequent reviewed runtime/docs change."
