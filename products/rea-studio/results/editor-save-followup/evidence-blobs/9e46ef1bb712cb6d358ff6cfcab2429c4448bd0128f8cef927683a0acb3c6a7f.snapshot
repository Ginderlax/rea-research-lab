  "correctionContracts": [
    "Captured successful write updates saved baseline/revision/bytes while retaining current draft text",
    "Per-document pending flag refuses duplicate save requests without disabling typing or other documents",
    "Success and error publication require mounted view and original document object ownership",
    "Background settlement preserves the currently selected document status",
    "Closed/reopened documents cannot accept an old item response",
    "Direct Save captures declared primitive revision before any await or exclusive queue"
  ],
