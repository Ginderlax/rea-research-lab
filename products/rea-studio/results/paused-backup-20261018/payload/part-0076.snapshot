    {
      "id": "grafana.candidate.5ef307e8bcb2add13f93",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana ships with built-in support for [Grafana Tempo](https://grafana.com/docs/tempo/<TEMPO_VERSION>/), a high-volume, minimal-dependency distributed tracing backend from Grafana Labs. Use the Tempo data source to search and visualize traces, correlate traces with logs, metrics, and profiles, and monitor service dependencies with the Service Graph.",
      "headingPath": [
        "Tempo data source"
      ],
      "source": {
        "path": "docs/sources/datasources/tempo/_index.md",
        "gitBlobSha": "7c03858ab3df421ee64f3dbdfccb545d8c6f9c12",
        "sha256": "0ced3fd920091e08392cbe0ecead4c9ea9baa8dd1f4bb00b62719ea82cfc99c3",
        "lineStart": 81,
        "lineEnd": 82,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/tempo/_index.md#L81-L82"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.d36eeaedab958453d5a0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Grafana Cloud users:** Grafana Cloud includes [Grafana Cloud Traces](https://grafana.com/docs/grafana-cloud/send-data/traces/), a pre-configured tracing data source backed by Tempo. You can use Grafana Cloud Traces to query traces without additional setup. Use the Tempo data source when you need to connect to a self-managed Tempo instance or require custom configuration such as trace correlations.",
      "headingPath": [
        "Tempo data source"
      ],
      "source": {
        "path": "docs/sources/datasources/tempo/_index.md",
        "gitBlobSha": "7c03858ab3df421ee64f3dbdfccb545d8c6f9c12",
