      "before": "disposed=true;generation++;current=null;selected='';linkConnections=[];",
      "after": "disposed=true;generation++;draftRevision++;rawDraft=null;current=null;selected='';linkConnections=[];"
    }
  ],
  "inverseExact": true,
  "scope": "Native view only. Raw decoded backing, HTML CR-only comparison, source-aware captured Save/Export/Import/validation/node/link publication and disposal. Static compiler/runtime/server/shared host unchanged."
