const sourceBefore=await fingerprints(here,sourceNames),runDirectory=await fs.mkdtemp(path.join(here,'synthetic-run-'));await fs.mkdir(path.join(runDirectory,'sources'));
for(const row of sourceBefore){const output=path.join(runDirectory,'sources',row.path);await fs.mkdir(path.dirname(output),{recursive:true});await fs.writeFile(output,await fs.readFile(path.join(here,row.path)),{flag:'wx'});}
const startedAtUtc=new Date().toISOString(),checks=[];
