    {
      "id": "grafana.candidate.cdd422c40179c125831c",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Optional: Change **Span start time shift** and **Span end time shift**. The placeholders show `-2m` (start) and `2m` (end), which are applied if you leave the fields empty.",
      "headingPath": [
        "Configure trace to metrics correlation",
        "Set up a basic configuration"
      ],
