    },
    {
      "id": "grafana.candidate.a5beb0c6b1cbaa93d71d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now use GitHub OAuth2 to map users or teams to specific [Grafana organization roles](../../administration/roles-and-permissions/#organization-roles) by using `role_attribute_path` configuration option. Grafana will use [JMESPath](https://jmespath.org/examples.html) for path lookup and role mapping. For more information, see the [documentation](../../setup-grafana/configure-access/configure-authentication/github/#map-roles).",
      "headingPath": [
        "What's new in Grafana v9.1",
        "OSS",
        "Auth and security",
        "Organization role mapping for GitHub OAuth2 authentication"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-1.md",
        "gitBlobSha": "7f2b514efd5a050fef62ef5f9f55cac366248b28",
