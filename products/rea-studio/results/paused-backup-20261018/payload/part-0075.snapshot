    },
    {
      "id": "grafana.candidate.bff02cf04b60e83e6355",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can find the supported public data sources in the [Grafana Plugins directory](/grafana/plugins/data-source-plugins/?features=alerting). For step-by-step instructions, see [Configure Grafana-managed alert rules](ref:configure-grafana-alerts).",
      "headingPath": [
        "Alert rules",
