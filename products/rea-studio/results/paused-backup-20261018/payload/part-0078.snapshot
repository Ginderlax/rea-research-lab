    },
    {
      "id": "grafana.candidate.5a729fadf37445733618",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When used together, tracing and profiling provide a powerful tool for understanding system and application performance.",
      "headingPath": [
        "Profiling",
        "Combined power of tracing and profiling"
      ],
      "source": {
        "path": "docs/sources/shared/datasources/pyroscope-profile-tracing-intro.md",
        "gitBlobSha": "22358a1fa1178a49e3a4feb62e5e285977087047",
        "sha256": "5c005f268c2bb0afac0e461303eac024af2901e25dbf4e960b58f2c6aea828c1",
        "lineStart": 96,
        "lineEnd": 96,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/shared/datasources/pyroscope-profile-tracing-intro.md#L96-L96"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
