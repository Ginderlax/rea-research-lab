import fs from 'node:fs/promises';import path from 'node:path';import {spawnSync} from 'node:child_process';import assert from 'node:assert/strict';
import {here,sha,fp,authenticate,preserveCurrent} from './source-binding.mjs';
const before=await authenticate(),preserved=await preserveCurrent();
const oldTest=await fs.readFile(path.resolve(here,'../editor-search-independent-review/held-search.test.mjs'),'utf8');assert.equal(sha(oldTest),'67dcbdc42446c94686c1fa003297b588e2541167156947042d4f6ddb80303362');const currentTest=oldTest.replaceAll('../editor-search-next/','../editor-search-path-fix-next/');await fs.writeFile(path.join(here,'held-current.test.mjs'),currentTest,{flag:'wx'});
const fixedRoot=path.resolve(here,'../editor-search-fix-next/products/rea-studio/apps/editor'),currentRoot=path.resolve(here,'../editor-search-path-fix-next/products/rea-studio/apps/editor'),fixedClient=await fs.readFile(path.join(fixedRoot,'client.mjs')),currentClient=await fs.readFile(path.join(currentRoot,'client.mjs'));assert.ok(fixedClient.equals(currentClient));
const fixedServer=await fs.readFile(path.join(fixedRoot,'server.mjs'),'utf8'),currentServer=await fs.readFile(path.join(currentRoot,'server.mjs'),'utf8'),oldFunction=fixedServer.match(/function relative\(value\) \{[\s\S]*?\n\}\n/)?.[0];assert.ok(oldFunction);const inverse=currentServer.replace("import { editorRelativePath as relative } from './file-path.mjs';\n",'').replace('async function exclusive(key, operation) {',oldFunction+'async function exclusive(key, operation) {');assert.equal(inverse,fixedServer,'Shared import must reconstruct exact earlier server source');
const records=[];for(const name of ['held-current.test.mjs','path-boundaries.test.mjs','fresh-ui.test.mjs']){const source=await fp(path.join(here,name)),start=new Date().toISOString(),child=spawnSync(process.execPath,['--test','--test-reporter=tap',path.join(here,name)],{encoding:'utf8',windowsHide:true,timeout:60000,maxBuffer:2*1024*1024}),stdout=child.stdout??'',stderr=child.stderr??'',stem='observations-'+name+'-'+Date.now();for(const [suffix,bytes] of [['.stdout.txt',stdout],['.stderr.txt',stderr]])await fs.writeFile(path.join(here,stem+suffix),bytes,{flag:'wx'});const counts=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(key=>[key,Number(stdout.match(new RegExp('^# '+key+' (\\d+)$','m'))?.[1])]));records.push({name,source,start,end:new Date().toISOString(),exitCode:child.status,signal:child.signal,error:child.error?.message,counts,stdout:{path:stem+'.stdout.txt',...await fp(path.join(here,stem+'.stdout.txt'))},stderr:{path:stem+'.stderr.txt',...await fp(path.join(here,stem+'.stderr.txt'))}});assert.deepEqual(await fp(path.join(here,name)),source);}
const after=await authenticate();assert.deepEqual(after,before);for(const row of preserved)assert.deepEqual(await fp(path.join(here,row.path)),{bytes:row.bytes,sha256:row.sha256});const receipt={schema:'rea-editor-path-independent-test-review/v1',checkedAt:new Date().toISOString(),before,after,sourceStable:true,preserved,heldBodiesExactExceptImport:true,clientBytesExactEarlierFixed:true,serverImportInverseExactEarlierFixed:true,fixedClientSHA256:sha(fixedClient),records,tests:records.reduce((sum,row)=>sum+row.counts.tests,0),pass:records.reduce((sum,row)=>sum+row.counts.pass,0),fail:records.reduce((sum,row)=>sum+row.counts.fail,0),actualClientModules:true,actualReadSaveSearchHandlers:true,finiteElementModel:true,actualBrowser:false,productionChanged:false,originalWorkbenchParity:false,newTimingMemoryOrProfilerRuns:0};await fs.writeFile(path.join(here,'test-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({tests:receipt.tests,pass:receipt.pass,fail:receipt.fail,sourceStable:true,records:records.map(({name,counts,exitCode,error})=>({name,counts,exitCode,error}))}));if(receipt.fail||records.some(row=>row.exitCode!==0))process.exitCode=1;
