    {
      "id": "grafana.candidate.2adca733cf032fa2b260",
      "syntaxRole": "list-item",
      "sourceText": "- Permissions `settings:read` and `settings:write` with scope `settings:auth.saml:*` that allow you to read and update SAML authentication settings, which are granted by `fixed:authentication.config:writer` role. By default, this role is granted to Grafana server administrator in self-hosted instances and to Organization admins in Grafana Cloud instances.",
      "headingPath": [
