    {
      "id": "grafana.candidate.631de1ccb9eb11dbc573",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Dashboard definitions can get unwieldy as more panels and configurations are added to them. There are a number of open source tools available to make it easier to manage dashboard definitions:",
      "headingPath": [
        "Introduction",
        "Summary"
      ],
      "source": {
        "path": "docs/sources/tutorials/provision-dashboards-and-data-sources/index.md",
        "gitBlobSha": "0dfc09eadb6c15b140a27ba0f790c01aebc1bce2",
