import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const root=import.meta.dirname,old=path.resolve(root,'../keepass-recycle-next'),review=path.resolve(root,'../keepass-recycle-independent-review'),hash=b=>createHash('sha256').update(b).digest('hex'),app='products/rea-studio/apps/vault/';
async function fp(file){const b=await fs.readFile(file);return{bytes:b.length,sha256:hash(b)};}
const oldManifest=JSON.parse(await fs.readFile(path.join(old,'manifest.json'))),reviewManifest=JSON.parse(await fs.readFile(path.join(review,'review-manifest.json')));assert.equal((await fp(path.join(old,'manifest.json'))).sha256,'769523b00c626762f18aec86ee8df8f1bb317ff4bbc8147a09a03af44161c100');assert.equal((await fp(path.join(review,'review-manifest.json'))).sha256,'f7e3a29b6ee8dc756b96de43473123f9b3d30f7926d1b536909ab2ea46b55815');assert.equal((await fp(path.join(review,'review-validation.json'))).sha256,'6f142bc4a2c6e7df42b00bc23d586924684cbb768ff326f40434382a3d52d36c');
for(const [folder,manifest]of[[old,oldManifest],[review,reviewManifest]])for(const row of manifest.records??manifest.files){const file=path.resolve(folder,row.path);assert(file.startsWith(folder+path.sep));const a=await fp(file);assert.equal(a.bytes,row.bytes,row.path);assert.equal(a.sha256,row.sha256,row.path);}
await fs.mkdir(path.join(root,'prior-independent-binding'),{recursive:true});for(const p of['review-manifest.json','review-validation.json'])await fs.copyFile(path.join(review,p),path.join(root,'prior-independent-binding',p+'.snapshot'));
const baseline=JSON.parse(await fs.readFile(path.join(root,'baseline.json'))),runName='runs/final-local-frontend',run=JSON.parse(await fs.readFile(path.join(root,runName,'validation.json')));assert.equal(run.tests,38);assert.equal(run.pass,38);assert.equal(run.fail,0);assert.equal(run.skipped,0);assert.equal(run.cancelled,0);assert.equal(run.code,0);assert.equal(run.problem,null);assert(run.sourceStable&&run.productionFiveUnchanged&&run.old546AuthenticatedBeforeAfter);
for(const r of run.sourceBefore){const a=await fp(path.join(root,r.path));assert.equal(a.sha256,r.sha256,'Final-tested bytes changed '+r.path);assert.equal(a.bytes,r.bytes);}for(const r of baseline.productionBaseline){const a=await fp(r.path);assert.equal(a.sha256,r.sha256);assert.equal(a.bytes,r.bytes);}
const runtime=[];for(const p of['client.mjs','server.mjs','recycle.mjs','kdbx.mjs','history.mjs','xml.mjs']){const a=await fp(path.join(root,app,p)),b=await fp(path.join(old,app,p));runtime.push({path:app+p,...a,priorSha256:b.sha256,unchanged:p!=='client.mjs'});if(p!=='client.mjs')assert.deepEqual(a,b);}
const before=await fs.readFile(path.join(old,app,'client.mjs'),'utf8'),after=await fs.readFile(path.join(root,app,'client.mjs'),'utf8'),from='await list();if(viewCurrent())await binList();',to='await list();if(binCurrent())await binList();';assert.equal(before.split(from).length,3);assert.equal(after,before.replaceAll(from,to));assert.equal((await fp(path.join(root,'regression/bin-boundaries.test.mjs'))).sha256,'c095a6eadde6805eac2f7b50806f695aa95aa2794f8d86d5024aa7a80653354a');
const originalHelper=await fs.readFile(path.join(root,'prior-independent-failures/ui-helper.mjs.snapshot'),'utf8'),helper=await fs.readFile(path.join(root,'regression/ui-helper.mjs'),'utf8');assert.equal(helper,originalHelper.replace('../keepass-recycle-next/products/rea-studio/apps/vault/','../products/rea-studio/apps/vault/'));
async function inventory(dir){const result=[];for(const e of await fs.readdir(dir,{withFileTypes:true})){if(dir===root&&['.local','manifest.json','freeze.json'].includes(e.name))continue;const p=path.join(dir,e.name);if(e.isDirectory())result.push(...await inventory(p));else result.push({path:path.relative(root,p).replaceAll('\\','/'),...await fp(p)});}return result;}
let rows=await inventory(root),magic=[];for(const r of rows){const b=await fs.readFile(path.join(root,r.path));if(b.subarray(0,2).toString()==='MZ'||b.subarray(0,2).toString()==='PK')magic.push(r.path);}assert.equal(magic.length,0);
const receipt={schema:'rea-vault-recycle-bin-generation-fix-validation/v1',completedAt:new Date().toISOString(),status:'frozen-awaiting-independent-ui-review',productionModified:false,earlierFrozenEvidenceModified:false,change:{module:app+'client.mjs',from,to,occurrences:2,applicationChangesOutsideTheseGuards:false,newBinInteractionCounter:false},runtime,sourceBoundRun:{path:runName,validation:await fp(path.join(root,runName,'validation.json')),tests:38,pass:38,fail:0,skipped:0,cancelled:0,sourceStable:true,sourceFingerprintCount:run.sourceBefore.length,scope:run.scope,originalAssemblyLoads:0,actualHTTPHosts:0,actualBrowserChecks:0},caseAccounting:{previousHistorySelectionDraftLifecycleGroups:25,previousRecycleDOMGroups:4,unchangedIndependentBinBoundaryBodies:5,newFrontendControlGroups:4,reviewerOriginalFailuresReplayedPassing:3,reviewerExistingControlsReplayedPassing:2},baseline:{stageRoot:'work/keepass-recycle-next',strictArtifactCount:546,manifestSha256:baseline.previousStage.manifestSha256,receiptSha256:baseline.previousStage.receiptSha256,productionFiveUnchanged:true,oldStageAuthenticatedBeforeAfter:true,preservation:'Exact manifest reference and selected snapshots; not a recursive historical copy or rebasing',historicalOriginalAssemblyLoads:38,historicalActualHostProcesses:9,historicalTests:68,historicalEvidenceNotCurrentClientBehavior:true},independentReview:{root:'work/keepass-recycle-independent-review',manifestSha256:'f7e3a29b6ee8dc756b96de43473123f9b3d30f7926d1b536909ab2ea46b55815',receiptSha256:'6f142bc4a2c6e7df42b00bc23d586924684cbb768ff326f40434382a3d52d36c',artifactCount:61,currentCandidateReviewPending:true,oldReviewOriginalAndBrowserCountsNotNew:false},preservedFailures:[{path:'prior-independent-failures',scope:'Exact independently failed three UI assertions plus two controls'},{path:'failures/preparation-v1',scope:'Directory-as-file copy setup failure; tool-console transcription'},{path:'failures/same-generation-setup-v1',scope:'Owned active-card row selector mistake; tool-console transcription'},{path:'runs/guard-only-same-generation',scope:'Invalid stale-token preview premise before safety assertion; exact raw/source0/1'},{path:'runs/old546-same-generation',scope:'Same invalid diagnostic against exact original-stage client; exact raw/source0/1'}],interruption:{path:'INTERRUPTED-ATTEMPT.json',incompleteAttempt:true,implementationFailureInvented:false,actualPlatformErrorTimeUnknown:true},licensing:{sourceAssistedOriginal:'KeePass 2.61.1',license:'GPL-2.0-or-later',bindings:'prior-stage-binding/NOTICE.md.snapshot and immutable original-stage source/license manifest',nativeOriginalCarriersCopied:0,firstBytesMZorPKFiles:magic.length},limits:{fullProductParity:false,securityParity:false,superiority:false,originalGUIExecutions:0,newTimingOrMemoryMeasurements:false,defaultKdbx40PreviousParentLossAndConditional41RetentionUnchanged:true,entryOnlyScopeUnchanged:true},cleanup:{ownedChildrenHostsBrowserRunning:0,stageLocalSyntheticObservationsExcludedFromFrozenPublicInventory:true}};
await fs.writeFile(path.join(root,'validation.json'),JSON.stringify(receipt,null,2)+'\n');rows=(await inventory(root)).sort((a,b)=>a.path.localeCompare(b.path));await fs.writeFile(path.join(root,'manifest.json'),JSON.stringify({schema:'rea-strict-stage-preservation/v1',strict:true,excluded:['.local/**','manifest.json','freeze.json'],records:rows},null,2)+'\n');const freeze={schema:'rea-vault-interface-fix-stage-freeze/v1',frozenAt:new Date().toISOString(),receipt:{path:'validation.json',...await fp(path.join(root,'validation.json'))},manifest:{path:'manifest.json',count:rows.length,...await fp(path.join(root,'manifest.json'))},runtime,sourceExecutableTestDocReceiptFrozen:true,ownedProcessesHostsBrowserRunning:0};await fs.writeFile(path.join(root,'freeze.json'),JSON.stringify(freeze,null,2)+'\n');console.log(JSON.stringify(freeze));
