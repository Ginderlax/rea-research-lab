    {
      "id": "grafana.candidate.05afc4437e16dd6f59e4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Native histograms are stable in Prometheus since v3.8.0. Your span metric generator may therefore create classic histograms for latency span metrics, either `traces_span_metrics_duration_seconds` or `traces_spanmetrics_latency`.",
