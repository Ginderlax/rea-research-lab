    },
    {
      "id": "grafana.candidate.61ab6309f0690ad53729",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This feature simplifies your options for configuring where your notifications are sent when an alert rule fires. Choose an existing contact point directly from within the alert rule creation form without the need to label match notification policies.  You can also set optional muting, grouping, and timing settings directly in the alert rule.",
      "headingPath": [
        "What’s new in Grafana v10.4",
        "Alerting",
        "Simplified Alert Notification Routing"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-4.md",
