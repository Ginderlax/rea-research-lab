import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const work=import.meta.dirname,workspace=path.dirname(work),lab=path.join(workspace,'outputs/rea-research-lab'),own=path.join(work,'editor-vault-installation-preservation-next'),prefix='products/rea-studio/results/editor-vault-reviewed-production-installation-20261013',sha=b=>createHash('sha256').update(b).digest('hex');await fs.mkdir(own,{recursive:false});const records=[],copied=[],used=new Set(),inputs=[];
function safe(p){assert(typeof p==='string'&&p&&!path.isAbsolute(p)&&!/[\\:\x00-\x1f]/.test(p)&&p.split('/').every(s=>s&&s!=='.'&&s!=='..'));}
async function read(root,p,r){safe(p);const b=await fs.readFile(path.join(root,p));if(r){assert.equal(b.length,r.bytes,p);assert.equal(sha(b),r.sha256,p);}inputs.push({root,p,bytes:b.length,sha256:sha(b)});return b;}
async function retain(role,root,p,target,r,reused=false){safe(target);const b=await read(root,p,r);assert(b.length<=32*1024*1024);assert(Buffer.from(b.toString()).equals(b));if(reused){const publicB=await read(lab,target,r??{bytes:b.length,sha256:sha(b)});assert.deepEqual(publicB,b);}else{assert(!used.has(target));await fs.mkdir(path.dirname(path.join(lab,target)),{recursive:true});await fs.writeFile(path.join(lab,target),b,{flag:'wx'});used.add(target);copied.push(target);}records.push({role,sourceRoot:path.relative(workspace,root).replaceAll('\\','/'),sourcePath:p,publicPath:target,bytes:b.length,sha256:sha(b),reused});}
async function names(root,p=''){const out=[];for(const e of await fs.readdir(path.join(root,p),{withFileTypes:true})){assert(!e.isSymbolicLink());const n=p?p+'/'+e.name:e.name;if(e.isDirectory())out.push(...await names(root,n));else out.push(n);}return out.sort();}
const planSpecs=[['editor','editor-pattern-root-installation-plan-next','b5e21ff4810e0b92d066a72deeb8bb41538aed48e499a4bcd8774f8322b81996',637],['vault','vault-group-publication-plan-next','8a575dd9610bf71a6b81169314d45b023aaff96f629a9648d4af9df5222d9521',325]];
for(const[role,folder,pin,count]of planSpecs){const root=path.join(work,folder),mb=await read(root,'manifest.json');assert.equal(sha(mb),pin);const rows=JSON.parse(mb).inventory;assert.equal(rows.length,count);assert.deepEqual(await names(root),[...rows.map(r=>r.path),'manifest.json'].sort());const plan=JSON.parse(await read(root,'installation-plan.json'));for(const r of rows)await retain('plan-'+role,root,r.path,r.path.startsWith('source-proof/')?plan.publicSourcePrefix+r.path.slice('source-proof'.length):prefix+'/plans/'+role+'/'+r.path+'.snapshot',r,r.path.startsWith('source-proof/'));await retain('plan-'+role,root,'manifest.json',prefix+'/plans/'+role+'/manifest.json.snapshot',{bytes:mb.length,sha256:pin});}
const reviewRoot=path.join(work,'vault-group-publication-plan-independent-review'),reviewMb=await read(reviewRoot,'review-manifest.json');assert.equal(sha(reviewMb),'76acdbe2099ff04afff90e7ed19f2d94ef2328ccdacc13c6ea14e8e4b376cca5');const reviewRows=JSON.parse(reviewMb).inventory;assert.equal(reviewRows.length,111);for(const r of reviewRows)await retain('independent-plan-review',reviewRoot,r.path,prefix+'/independent-review/'+r.path+'.snapshot',r);await retain('independent-plan-review',reviewRoot,'review-manifest.json',prefix+'/independent-review/review-manifest.json.snapshot',{bytes:reviewMb.length,sha256:sha(reviewMb)});
const installedRoot=path.join(work,'editor-vault-reviewed-installation-next'),installation=JSON.parse(await read(installedRoot,'installation.json'));assert.equal(installation.installed.length,30);assert.equal(installation.productionWrites,30);assert.equal(installation.copies.length,946);for(const r of installation.installed)await read(lab,r.destination,r.after);for(const r of installation.copies)await read(lab,r.path,r);for(const n of await names(installedRoot))await retain('root-installation',installedRoot,n,prefix+'/'+n);
const metadataRoot=path.join(work,'editor-vault-checkpoint-preparation-next'),baseline=JSON.parse(await read(metadataRoot,'baseline.json'));assert.equal(baseline.rows.length,6);for(const r of baseline.rows)await retain('prior-f0-metadata',metadataRoot,r.beforePath,prefix+'/before-metadata/'+r.path+'.snapshot',r);for(const n of['baseline.json','collector.mjs.snapshot'])await retain('prior-f0-metadata',metadataRoot,n,prefix+'/metadata-baseline/'+n+'.snapshot');
const record={schema:'rea-editor-vault-root-installation-preservation/v1',at:new Date().toISOString(),records,aliases:records.length,newPublicFiles:copied.length,reusedSourceProofPaths:records.filter(r=>r.reused).length,liveInstalledPaths:30,sourceProofPayloadAndMaps:946,plans:[{payloads:637,manifestSHA256:planSpecs[0][2]},{payloads:325,manifestSHA256:planSpecs[1][2]}],reviewPayloads:111,reviewManifestSHA256:sha(reviewMb),allCopiesExact:true,allSourcesStableBeforeAfter:true,originalExecutableBytesPublic:0,privateTokensPublic:0,oldReceiptsRebound:false,installationBehaviorExecutions:0,currentCombinedSuite:'Root separately running; later immutable current-source receipt required.',fullParity:false,universalSuperiority:false};
await fs.writeFile(path.join(own,'record.json'),JSON.stringify(record,null,2)+'\n',{flag:'wx'});await fs.copyFile(import.meta.filename,path.join(own,'collector.mjs.snapshot'));await retain('root-preservation',own,'collector.mjs.snapshot',prefix+'/preservation-collector.mjs.snapshot');for(const r of inputs){const b=await fs.readFile(path.join(r.root,r.p));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);}record.records=records;record.aliases=records.length;record.newPublicFiles=copied.length;const final=Buffer.from(JSON.stringify(record,null,2)+'\n');await fs.mkdir(path.join(lab,prefix),{recursive:true});await fs.writeFile(path.join(lab,prefix,'preservation-manifest.json'),final,{flag:'wx'});await fs.writeFile(path.join(own,'publication.json'),JSON.stringify({prefix,manifestBytes:final.length,manifestSHA256:sha(final),aliases:records.length,newPublicFiles:copied.length,reusedSourceProofPaths:946,sourceStable:true},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({prefix,manifestSHA256:sha(final),aliases:records.length,newPublicFiles:copied.length,reused:946}));
