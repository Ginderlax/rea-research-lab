      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.a45db52dca66cec9f2e0",
      "syntaxRole": "list-item",
      "sourceText": "- **Explain query**: Describes what your query does, including its interpreted meaning.",
      "headingPath": [
        "SQL expressions",
        "Grafana Assistant integration"
      ],
      "source": {
