    },
    {
      "id": "grafana.candidate.db9b748d1be8611b58ec",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can control permissions for library panels using [role-based access control (RBAC)](ref:rbac). RBAC provides a standardized way of granting, changing, and revoking access when it comes to viewing and modifying Grafana resources, such as dashboards, reports, and administrative settings.",
      "headingPath": [
        "Manage library panels",
        "Role-based access control"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/build-dashboards/manage-library-panels/index.md",
        "gitBlobSha": "26935779dabb66e8ca5da67dc9af0ff03b224522",
        "sha256": "a4c545447b9d566161f10bed237ebb51b09ef28e113519690c6f0e1aa902c4be",
        "lineStart": 37,
        "lineEnd": 37,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/dashboards/build-dashboards/manage-library-panels/index.md#L37-L37"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
