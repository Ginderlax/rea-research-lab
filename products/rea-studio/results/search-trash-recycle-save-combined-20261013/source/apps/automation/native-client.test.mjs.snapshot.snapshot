import test from 'node:test';
import assert from 'node:assert/strict';
import {createRequire} from 'node:module';
import {renderNative} from './native-client.mjs';
import {nativeExample} from './native-example.mjs';
import {handleNative,disposeNative} from './native-server.mjs';
import {verifyOriginalIntegrity} from './original-harness.mjs';
await verifyOriginalIntegrity();
const{JSDOM}=createRequire(new URL('../../../../.local/automation-original/package.json',import.meta.url))('jsdom');
async function dom(t,override){const window=new JSDOM('<body><main></main></body>',{url:'http://127.0.0.1:4310'}).window,original=new Map(['document','location'].map(key=>[key,Object.getOwnPropertyDescriptor(globalThis,key)]));for(const key of original.keys())Object.defineProperty(globalThis,key,{value:window[key],writable:true,configurable:true});const map=new Map(),workspace={},store={async get(key,fallback=null){return structuredClone(map.has(key)?map.get(key):fallback);},async set(key,value){map.set(key,structuredClone(value));}},calls=[],api=async(action,input={})=>{calls.push({action,input:structuredClone(input)});if(override)return override(action,input,()=>handleNative({action,input,store,workspace}));return handleNative({action,input,store,workspace});},root=window.document.querySelector('main');t.after(async()=>{await disposeNative(workspace);window.close();for(const[key,descriptor]of original)if(descriptor)Object.defineProperty(globalThis,key,descriptor);else delete globalThis[key];await verifyOriginalIntegrity();});return{window,root,api,calls,map,button:text=>[...root.querySelectorAll('button')].find(button=>button.textContent===text),status:()=>root.querySelector('[role=status]').textContent};}
async function until(predicate){for(let count=0;count<250;count++){if(predicate())return;await new Promise(done=>setTimeout(done,5));}throw new Error('Native editor did not settle');}
function control(root,label){return[...root.querySelectorAll('label')].find(value=>value.firstChild.textContent===label)?.querySelector('input,textarea,select');}

test('native editor imports unknown JSON, preserves metadata on rename/connections, and runs the saved revision through Wait',async t=>{
 const d=await dom(t);await renderNative(d.root,d.api);const document=nativeExample();document.nodes[1].customMeta={keep:'café 😀'};document.connections['Manual Trigger'].main[0][0].extra='retain';document.nodes.push({id:'future',name:'Unconnected vendor node',type:'vendor.future',typeVersion:100,position:[2000,0],parameters:{future:{keep:true}}});const json=d.root.querySelector('details textarea');json.value=JSON.stringify(document);d.button('Apply native JSON').click();await until(()=>d.status().startsWith('Imported'));assert.equal(JSON.parse(json.value).nodes.at(-1).type,'vendor.future');d.root.querySelector('[aria-label="Edit Edit Fields"]').dispatchEvent(new d.window.MouseEvent('click',{bubbles:true}));await until(()=>control(d.root,'Node name').value==='Edit Fields');control(d.root,'Node name').value='Renamed Set';d.button('Apply node changes').click();await until(()=>d.status().startsWith('Node updated'));const changed=JSON.parse(json.value);assert.deepEqual(changed.nodes[1].customMeta,{keep:'café 😀'});assert.equal(changed.connections['Manual Trigger'].main[0][0].node,'Renamed Set');assert.equal(changed.connections['Manual Trigger'].main[0][0].extra,'retain');assert.ok(changed.connections['Renamed Set']);d.button('Save native workflow').click();await until(()=>d.status()==='Saved revision 1');const name=control(d.root,'Native workflow name');name.value='Unsaved name';name.dispatchEvent(new d.window.Event('input'));d.button('Run saved native revision').click();await until(()=>d.status()==='Execution completed');const start=d.calls.find(value=>value.action==='native-start');assert.ok(start);const history=await d.api('native-history',{id:start.input.id});assert.equal(history.runs.at(-1).revision,1);assert.equal(history.runs.at(-1).outputs.Finished[0][0].json.finished,true);assert.equal(JSON.parse(json.value).name,'Unsaved name');
});
test('native editor rejects stale node selection after replacing JSON instead of modifying a different node',async t=>{
 const d=await dom(t);await renderNative(d.root,d.api);d.root.querySelector('[aria-label="Edit Edit Fields"]').dispatchEvent(new d.window.MouseEvent('click',{bubbles:true}));await until(()=>control(d.root,'Node name').value==='Edit Fields');const replacement=nativeExample();replacement.nodes[1].name='Different';replacement.connections['Manual Trigger'].main[0][0].node='Different';replacement.connections.Different=replacement.connections['Edit Fields'];delete replacement.connections['Edit Fields'];d.root.querySelector('details textarea').value=JSON.stringify(replacement);d.button('Apply native JSON').click();await until(()=>d.status().startsWith('Imported'));const before=d.calls.length;d.button('Apply node changes').click();await until(()=>d.status().includes('Choose a current node'));assert.equal(d.calls.length,before);assert.equal(JSON.parse(d.root.querySelector('details textarea').value).nodes[1].name,'Different');
});
test('native editor ignores an older asynchronous saved-workflow response when selection changes',async t=>{
 let release;const gate=new Promise(done=>release=done);let delayedId='';const d=await dom(t,async(action,input,normal)=>{if(action==='native-get'&&input.id===delayedId)await gate;return normal();});const first=await d.api('native-save',{workflow:nativeExample()}),secondDocument=nativeExample();secondDocument.name='Second';const second=await d.api('native-save',{workflow:secondDocument});delayedId=first.record.id;await renderNative(d.root,d.api);const picker=d.root.querySelector('.row select');picker.value=first.record.id;picker.dispatchEvent(new d.window.Event('change'));picker.value=second.record.id;picker.dispatchEvent(new d.window.Event('change'));await until(()=>control(d.root,'Native workflow name').value==='Second');release();await new Promise(done=>setTimeout(done,20));assert.equal(control(d.root,'Native workflow name').value,'Second');assert.equal(picker.value,second.record.id);
});
