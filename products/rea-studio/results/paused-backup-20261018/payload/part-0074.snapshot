    },
    {
      "id": "grafana.candidate.ca8540fd6eca29b17638",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Changes that you make to basic roles impact the role definition for all [organizations](/docs/grafana/<GRAFANA_VERSION>/administration/organization-management/) in the Grafana instance. For example, when you add the `fixed:users:writer` role's permissions to the viewer basic role, all viewers in any org in the Grafana instance can create users within that org.",
      "headingPath": [
        "Plan your RBAC rollout strategy",
        "When to modify basic roles or create custom roles"
      ],
      "source": {
        "path": "docs/sources/administration/roles-and-permissions/access-control/plan-rbac-rollout-strategy/index.md",
