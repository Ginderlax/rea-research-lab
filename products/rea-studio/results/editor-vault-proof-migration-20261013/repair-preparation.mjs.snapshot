import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';const here=import.meta.dirname,old=path.join(here,'failed-preparation');await fs.mkdir(old,{recursive:false});for(const n of['prepare.mjs','preparation.stdout.txt','preparation.stderr.txt'])await fs.writeFile(path.join(old,n+'.snapshot'),await fs.readFile(path.join(here,n)),{flag:'wx'});for(const n of['authority','after-image','before-image']){const from=path.resolve(here,n),to=path.resolve(old,n);assert.equal(path.dirname(from),here);assert.equal(path.dirname(to),old);assert.ok(to.startsWith(here+path.sep));await fs.rename(from,to);}let s=await fs.readFile(path.join(here,'prepare.mjs'),'utf8');const before="else sourceRoot=spec.root;assert.ok(destination.startsWith('products/rea-studio/apps/'+spec.label+'/'));const b=await fs.readFile(path.join(workspace,sourceRoot,sourcePath));",after="else sourceRoot=spec.root;assert.ok(destination.startsWith('products/rea-studio/apps/'+spec.label+'/'));let resolvedSourcePath=sourcePath;if(spec.label==='vault'&&r.sourceRoot!=='this-plan'){resolvedSourcePath='source-proof/payload/'+after.sha256+'.snapshot';assert.ok(m.inventory.some(x=>x.path===resolvedSourcePath&&x.bytes===after.bytes&&x.sha256===after.sha256),'Exact Vault plan payload identity');}const b=await fs.readFile(path.join(workspace,sourceRoot,resolvedSourcePath));";assert.equal(s.split(before).length,2);s=s.replace(before,after);s=s.replace('sourceRoot,sourcePath,sourcePlan:spec.root','sourceRoot,sourcePath:resolvedSourcePath,originalDeclaredSource:sourcePath,sourcePlan:spec.root');await fs.writeFile(path.join(here,'prepare.mjs'),s);await fs.writeFile(path.join(old,'failure.json'),JSON.stringify({sourceOnly:true,cause:'Guessed Vault sources lived directly in plan products/... paths. Actual strict325 inventory stores exact runnable bytes under source-proof/payload/{SHA}.snapshot. Correction resolves that exact SHA/byte-bound entry; declared original path retained.',apps:0,tests:0,originals:0,productionWrites:0},null,2)+'\n',{flag:'wx'});
