    {
      "id": "grafana.candidate.7c203f0e9a8234fa051f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Move alert rules and library panels out of the folder **before** you delete it. Deleting a folder deletes everything it contains, and Git Sync does not recreate alerts or library panels.",
      "headingPath": [
        "Add non-provisioned resources from Grafana",
