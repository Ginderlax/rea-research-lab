    {
      "id": "grafana.candidate.b4e715eec753da1e32a5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use this transformation to combine the results from multiple queries (combining on a passed join field or the first time column) into one result, and drop rows where a successful join cannot occur. This is not optimized for large Time Series datasets.",
      "headingPath": [
        "Transform data",
        "Transformation functions",
        "Join by field",
        "Inner join (for Time Series or SQL-like data)"
      ],
