    },
    {
      "id": "grafana.candidate.367bb4172d86170b73ad",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When an alerting condition is met, the alert instance enters the **Pending** state. It remains in this state while any alerting condition is met during the configured pending period. After the pending period has elapsed, the alert transitions to the state corresponding to the last evaluation.",
      "headingPath": [
        "Alert rule evaluation",
        "Pending period"
      ],
      "source": {
        "path": "docs/sources/alerting/fundamentals/alert-rule-evaluation/_index.md",
