          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.0baa6630c7fc07679f91",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "`gcx` works across all environments for Grafana OSS, Enterprise, and Cloud. **Use `gcx` to work with AI agents**.",
      "headingPath": [
        "Introduction to the Grafana CLI"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/grafana-cli/_index.md",
        "gitBlobSha": "a27410d273fdfa4b845f6698b69ba3527bdb0fd8",
