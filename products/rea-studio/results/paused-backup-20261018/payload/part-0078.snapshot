    {
      "id": "grafana.candidate.2bdf4c07f69c2966e14f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Scope, namespace and path can only have ASCII alphanumeric symbols (A-Z, a-z, 0-9), `_` (underscore) and `-` (dash) at the moment. The path part can additionally have `/`, `.` and `=` symbols. The meaning of scope, namespace and path is context-specific.",
      "headingPath": [
        "Set up Grafana Live",
        "Grafana Live channel",
        "Channel structure"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/set-up-grafana-live.md",
