import fs from 'node:fs/promises';import path from 'node:path';import{createHash}from'node:crypto';import{spawn}from'node:child_process';import assert from'node:assert/strict';
const root=import.meta.dirname,sha=b=>createHash('sha256').update(b).digest('hex'),app='products/rea-studio/apps/vault/',sources=['client.mjs','server.mjs','history.mjs','kdbx.mjs','xml.mjs','recycle.mjs','recycle.test.mjs','recycle-server.test.mjs'].map(n=>app+n);
const run=path.join(root,'runs','native-'+new Date().toISOString().replaceAll(':','-')),before=[];await fs.mkdir(run,{recursive:true});for(const n of sources){const b=await fs.readFile(path.join(root,n));before.push({path:n,bytes:b.length,sha256:sha(b)});const dest=path.join(run,'sources',n+'.snapshot');await fs.mkdir(path.dirname(dest),{recursive:true});await fs.writeFile(dest,b);}await fs.writeFile(path.join(run,'source-before.json'),JSON.stringify(before,null,2)+'\n');
const env={...process.env};delete env.NODE_TEST_CONTEXT;const child=spawn(process.execPath,['--test',app+'recycle.test.mjs',app+'recycle-server.test.mjs'],{cwd:root,env,windowsHide:true,stdio:['ignore','pipe','pipe']}),out=[],err=[];let size=0,problem;const timer=setTimeout(()=>{problem='Child deadline90seconds';child.kill();},90000);for(const[name,stream]of[['stdout',child.stdout],['stderr',child.stderr]])stream.on('data',b=>{size+=b.length;if(size>4*1024*1024){problem='Combined child capture exceeds4MiB';child.kill();}else(name==='stdout'?out:err).push(b)});const code=await new Promise((resolve,reject)=>{child.once('error',reject);child.once('close',resolve)});clearTimeout(timer);const stdout=Buffer.concat(out),stderr=Buffer.concat(err);await fs.writeFile(path.join(run,'stdout.txt'),stdout);await fs.writeFile(path.join(run,'stderr.txt'),stderr);const after=await Promise.all(sources.map(async n=>{const b=await fs.readFile(path.join(root,n));return{path:n,bytes:b.length,sha256:sha(b)}}));const text=stdout.toString(),number=name=>Number(new RegExp('^# '+name+' (\\d+)$','m').exec(text)?.[1]??NaN);const receipt={schema:'rea-keepass-recycle-focused-native-run/v1',completed:new Date().toISOString(),code,problem:problem??null,sourceBefore:before,sourceAfter:after,sourceStable:JSON.stringify(before)===JSON.stringify(after),tests:number('tests'),pass:number('pass'),fail:number('fail'),skipped:number('skipped'),cancelled:number('cancelled'),originalExecutions:0,actualHTTPHostStarts:0,scope:'Native core and encrypted in-memory server contracts only; future original/HTTP/browser campaigns remain separate.'};await fs.writeFile(path.join(run,'validation.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({run,...receipt,sourceBefore:undefined,sourceAfter:undefined}));assert.equal(receipt.sourceStable,true);assert.equal(code,0);assert(!problem);
