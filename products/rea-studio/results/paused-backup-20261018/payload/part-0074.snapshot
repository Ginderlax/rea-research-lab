    },
    {
      "id": "grafana.candidate.b901f1d650ade4a4ef7e",
      "syntaxRole": "table-row",
      "sourceText": "| `displayName` | Human-friendly text that is displayed in the UI. Role display name cannot be longer than 190 ASCII-based characters. For fixed roles, the display name is shown as specified. If you do not set a display name the display name replaces `':'` (a colon) with `' '` (a space).                                                                                                                                       |",
      "headingPath": [
        "Create custom RBAC roles",
        "Create custom roles using file-based provisioning"
      ],
      "source": {
