const old='c17c205049ce74e449dc1ce08cbd1c875410d7d5',oldFixture=JSON.parse(await fs.readFile(path.join(root,'products/rea-studio/apps/notes/fixtures/pinned-joplin.json')));for(const source of oldFixture.sources){const bytes=await fetchSave(`https://raw.githubusercontent.com/laurent22/joplin/${old}/${source.path}`,'historical-serializer/'+source.path);if(hash(bytes)!==source.sha256)throw new Error('Historical original serializer bytes changed.');}
await fs.writeFile(path.join(root,'source-provenance.json'),JSON.stringify({schema:'rea-joplin-notebook-source-provenance/v1',acquiredAt:new Date().toISOString(),sourceRelease:{tag,commit,edition:'Joplin Desktop',packageVersion:desktop.version,publishedAt:release.published_at,releaseUrl:release.html_url,releaseId:release.id,fullApplicationExecuted:false},sources:rows,failedOptionalAcquisitions:failures,historicalSerializer:{commit:old,scope:'Four existing serialization methods only; separate renderer/source-head scope, not equated with Desktop 3.6.14.'},license:'Exact official LICENSE retained; source is used only in finite isolated tests and behavioral study, no original implementation is a runtime wrapper.'},null,2)+'\n');console.log(JSON.stringify({release:tag,commit,acquiredSources:rows.length,optionalFailures:failures.length}));
