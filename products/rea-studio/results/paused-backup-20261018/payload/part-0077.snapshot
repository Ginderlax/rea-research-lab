    {
      "id": "grafana.candidate.9ddaede099d85de49d89",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you downloaded and installed InfluxDB on your local machine, then use the [Quick Start](https://docs.influxdata.com/influxdb/v2.0/write-data/#quick-start-for-influxdb-oss) feature to visualize InfluxDB metrics.",
