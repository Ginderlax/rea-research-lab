    },
    {
      "id": "grafana.candidate.484e991c740f7f9fc04f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "How long to capture traces after Grafana starts, expressed as a duration such as `10m`. Default value is `10m`. The value must be greater than `0`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[tracing.opentelemetry.file]`",
        "`capture_duration`"
