    {
      "id": "grafana.candidate.547a07bc7e119e5a9db0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Consider the following guidelines when you determine if you should modify basic roles or create custom roles.",
      "headingPath": [
        "Plan your RBAC rollout strategy",
        "When to modify basic roles or create custom roles"
      ],
