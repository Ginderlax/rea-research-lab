    {
      "id": "grafana.candidate.38d6c31ca5a232012ae3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The builder lets you run the most common queries in as few clicks as possible. You don't need to know the underlying query language or database architecture to use it.",
      "headingPath": [
        "Write TraceQL queries using Search"
      ],
      "source": {
        "path": "docs/sources/shared/datasources/tempo-search-traceql.md",
        "gitBlobSha": "d03861b60591a727be044f7326a7410c7b3db237",
