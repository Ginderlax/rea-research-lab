def gitbound(name,data):assert name in tree and modes[name]in(b'100644',b'100755')and hashlib.sha1(b'blob '+str(len(data)).encode()+b'\0'+data).hexdigest()==tree[name],name
def mapping(rows):
 assert isinstance(rows,list);d={r['path']:pin(r)for r in rows};assert len(d)==len(rows);return d
def context_proof():
 global tree,modes
 def context(name,maximum):
  p=safe(CONTROL,name);assert p.is_file()and p.stat().st_size<=maximum;raw=p.read_bytes();return json.loads(raw.decode('utf-8-sig')),identity(raw)
 run,run_pin=context('run.json',1048576);jobs,jobs_pin=context('jobs.json',1048576);artifacts,artifacts_pin=context('artifacts.json',1048576)
 commit,commit_pin=context('commit.json',1048576);tree_api,tree_pin=context('tree.json',16*1024*1024)
 assert str(run['id'])==RUN and run['head_sha']==HEAD and run['run_attempt']==1 and run['event']=='push'and run['head_branch']=='codex/rea-cloud-recovery-20261015'and run['path']==WORKFLOW and run['repository']['full_name']=='Ginderlax/rea-research-lab'
 assert jobs['total_count']==len(jobs['jobs'])==2 and len({str(r['id'])for r in jobs['jobs']})==2
 for role,job_id in JOBS.items():
  selected=[r for r in jobs['jobs']if str(r['id'])==job_id];assert len(selected)==1;job=selected[0]
  assert str(job['run_id'])==RUN and job['head_sha']==HEAD and job['name']==('finite-twenty-one-file-selection'if role=='finite'else'eight-real-chromium-scenarios')and 'windows-2022'in job['labels']and job['runner_group_name']=='GitHub Actions'
 assert artifacts['total_count']==len(artifacts['artifacts'])and len(artifacts['artifacts'])<=2
 roles={}
 for row in artifacts['artifacts']:
  matching=[role for role in JOBS if row['name']=='notes36-installed-'+role+'-'+RUN+'-1'];assert len(matching)==1 and matching[0]not in roles;roles[matching[0]]=row
 assert ROLE in roles;artifact=roles[ROLE];assert source.name=='artifact-'+str(artifact['id'])+'.zip'and artifact['expired']is False and str(artifact['workflow_run']['id'])==RUN and artifact['workflow_run']['head_sha']==HEAD and artifact['size_in_bytes']==len(raw)and artifact['digest']=='sha256:'+expected
 assert commit['sha']==HEAD and tree_api['sha']==commit['tree']['sha']and tree_api['truncated']is False and len(tree_api['tree'])<=100000
 tree={};modes={}
 for row in tree_api['tree']:
  if row['type']=='blob':
   assert row['path']not in tree and re.fullmatch(r'[0-9a-f]{40}',row['sha']);tree[row['path']]=row['sha'];modes[row['path']]=row['mode'].encode()
 result['rawControlContext']={'run':run_pin,'jobs':jobs_pin,'artifacts':artifacts_pin,'commit':commit_pin,'tree':tree_pin,'runStatus':run['status'],'runConclusion':run['conclusion'],'jobStatus':next(r for r in jobs['jobs']if str(r['id'])==JOBS[ROLE])['status'],'jobConclusion':next(r for r in jobs['jobs']if str(r['id'])==JOBS[ROLE])['conclusion'],'actualTreeSHA':tree_api['sha'],'portableRawGitContext':True}

