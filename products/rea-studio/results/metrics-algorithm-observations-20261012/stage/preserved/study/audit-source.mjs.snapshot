import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {here,sha,authenticateOriginal} from './authenticate-original.mjs';
const preservation=JSON.parse(await fs.readFile(path.join(here,'preservation.json'))),manifestBytes=await fs.readFile(path.join(here,'memory-preflight.control.json')),manifest=JSON.parse(manifestBytes),authority=await authenticateOriginal();assert.deepEqual(authority,manifest.authority);
const copied=[];for(const row of preservation.copies){const bytes=await fs.readFile(path.join(here,row.path)),source=await fs.readFile(path.join(row.sourceRoot,row.sourcePath));assert.equal(sha(bytes),row.sha256);assert.equal(bytes.length,row.bytes);assert.ok(bytes.equals(source),row.path);copied.push(row.path);}
for(const row of preservation.adaptations){const original=await fs.readFile(path.join(here,'preserved/process-control-baseline',row.path),'utf8');let expected=original.replaceAll('candidate-module-control.mjs','candidate-algorithm.mjs').replaceAll('selector-control.mjs','selector-algorithm.mjs');if(row.path==='harness.test.mjs')expected=expected.replace(String.raw`/import \{ singlePercentile \} from '\.\/selector-control\.mjs';/`,String.raw`/import \{ singlePercentile, preparePercentileValues \} from '\.\/selector-algorithm\.mjs';/`);if(row.path==='benchmark.mjs')expected=expected.replace('prospectiveSourceLayoutHypothesis:true','prospectiveSourceLayoutHypothesis:false,prospectiveAlgorithmHypothesis:true');assert.equal(sha(original),row.baselineSHA256);assert.equal(sha(expected),row.currentSHA256);assert.equal(await fs.readFile(path.join(here,row.path),'utf8'),expected);}
const candidateManifest=JSON.parse(await fs.readFile(path.join(here,'preserved/algorithm/freeze-manifest.json'))),candidateRoot=path.resolve(here,'../metrics-selector-algorithm-next');let candidateBytes=0;for(const[name,row]of Object.entries(candidateManifest.inventory)){const bytes=await fs.readFile(path.join(candidateRoot,name));assert.equal(sha(bytes),row.sha256,name);assert.equal(bytes.length,row.bytes,name);candidateBytes+=bytes.length;}
assert.equal(sha(await fs.readFile(preservation.productionPath)),preservation.productionSHA256);
const oldManifest=JSON.parse(await fs.readFile(path.join(here,'preserved/previous-memory-preflight.control.json')));assert.deepEqual(manifest.expectedFiles,oldManifest.expectedFiles);assert.deepEqual(manifest.limits,oldManifest.limits);assert.equal(manifest.expectedMetadataSHA256,oldManifest.expectedMetadataSHA256);assert.equal(manifest.canonicalSourceSHA256,oldManifest.canonicalSourceSHA256);assert.equal(manifest.workloadSourceSHA256,oldManifest.workloadSourceSHA256);
for(const fixture of Object.values(manifest.expectedFiles)){assert.equal(sha(await fs.readFile(path.join(here,fixture.path))),fixture.sha256);assert.equal(sha(await fs.readFile(path.join(here,fixture.inputPath))),fixture.inputFileSHA256);}
const entry=await fs.readFile(manifest.implementations.candidate.entry,'utf8'),helper=await fs.readFile(path.join(here,'selector-algorithm.mjs'),'utf8');assert.equal((entry.match(/^import /gm)??[]).length,1);assert.match(entry,/import \{ singlePercentile, preparePercentileValues \} from '\.\/selector-algorithm\.mjs';/);assert.equal((helper.match(/^import /gm)??[]).length,0);assert.equal((entry.match(/\bimport\s*\(/g)??[]).length,0);assert.equal((helper.match(/\bimport\s*\(/g)??[]).length,0);
const provenance=JSON.parse(await fs.readFile(path.join(here,'original-provenance.json')));for(const row of provenance.originalCopies){assert.equal(sha(await fs.readFile(path.join(here,row.path))),row.sha256);assert.equal(sha(await fs.readFile(row.source)),row.sha256);}for(const row of provenance.archives)assert.equal(sha(await fs.readFile(row.source)),row.sha256);assert.equal(provenance.originalCopies.length,6);assert.equal(provenance.archives.length,2);
const correctness=manifest.correctnessProvenanceOnly;assert.equal(sha(await fs.readFile(path.join(here,correctness.path))),correctness.sha256);assert.equal(correctness.inputs,66);assert.equal(correctness.notAMeasurementWorkload,true);assert.equal(Object.keys(manifest.expectedFiles).length,7);
const sourceHashes={};for(const name of ['candidate-algorithm.mjs','selector-algorithm.mjs','candidate-baseline.mjs','memory-worker.mjs','timing-worker.mjs','watch-owned-process.ps1','memory-runner.mjs','timing-runner.mjs','benchmark.mjs','canonical.mjs','workloads.mjs','authenticate-original.mjs','memory-preflight.control.json','summary.mjs'])sourceHashes[name]=sha(await fs.readFile(path.join(here,name)));
const receipt={schemaVersion:1,checkedAt:new Date().toISOString(),status:'passed',manifestSHA256:sha(manifestBytes),all88CandidateFilesVerifiedUnchanged:true,candidateBytes,selectedCopiesVerified:copied,exactControllerAdaptations:preservation.adaptations,sourceHashes,actualOriginalRuntimeFiles:6,originalArchiveIdentities:provenance.archives,oldSevenWorkloadAnd14FixtureIdentitiesExact:true,new66FixtureCorrectnessOnly:true,nativeImportGraphExact:true,measuredWorkerObserverLoopAndLifecycleSourcesExactFromPriorStage:true,productionSHA256:preservation.productionSHA256,timingMeasurementRun:false,memoryMeasurementRun:false,profileRun:false,scope:'Source authentication and static control/graph inspection only; not measurement branch execution or machine/resource isolation proof.'};await fs.writeFile(path.join(here,'results/source-binding-audit.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:'passed',candidateFiles:88,actualOriginalFiles:6,archives:2,fixtures:14,measurementRun:false}));
