    { name: 'archiveint.dll', bytes: 1482752, sha256: 'ca36efd61b33586e4cee69513bf3dcc8d20b65f37bd6495d5d82eb15833b5824' },
  ], transitions, provenance: provenance.map(row => row.path), payloads };
const bytes = Buffer.from(JSON.stringify(bundle, null, 2) + '\n'); fs.writeFileSync(path.join(target, 'bundle.json'), bytes, { flag: 'wx' });
