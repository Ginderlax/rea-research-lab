    {
      "id": "grafana.candidate.240dd3cacdf2fe4611e7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This transformation has two steps. First, specify one or more fields by which to group the data. This groups all the same values of those fields together, as if you sorted them. For instance, if you group by the Server ID field, Grafana groups the data this way:",
      "headingPath": [
        "Transform data",
