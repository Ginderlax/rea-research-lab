        "lineEnd": 124,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/auth-proxy/index.md#L124-L124"
      },
      "applicability": {
