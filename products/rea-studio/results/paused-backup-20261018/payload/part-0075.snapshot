    {
      "id": "grafana.candidate.1c2d1f58f0131956f9eb",
      "syntaxRole": "table-row",
      "sourceText": "| Wrong AWS region                                 | Verify the default region in the data source configuration matches where your resources are located.                                                                                                                                                                                                                                                                                                                                  |",
      "headingPath": [
        "Troubleshoot Amazon CloudWatch data source issues",
        "Authentication errors",
        "\"Access Denied\" or \"Not authorized to perform this operation\""
      ],
      "source": {
