for(const r of alias.records){safe(r.publicPath,true);assert(r.publicPath.startsWith('products/rea-studio/'));assert(r.publicPath.endsWith('.snapshot'));safe(r.sourceRoot);safe(r.sourcePath);const key=r.epoch+'|'+r.sourceRoot+'|'+r.sourcePath;assert(!sourceKeys.has(key));sourceKeys.add(key);const original=read(path.join(base,r.sourceRoot),r.sourcePath,r),preserved=r.reusedExistingPublic?read(repo,r.publicPath,r):read(stage,'source-proof/payload/'+r.sha256+'.snapshot',r);assert.deepEqual(original,preserved);assert(!(preserved[0]===77&&preserved[1]===90));assert(!(preserved[0]===80&&preserved[1]===75));assert(!(preserved[0]===31&&preserved[1]===139));assert.notEqual(r.sha256,originalCarriers.sha256);publicLocations.add(r.publicPath);if(preserved[0]===255&&preserved[1]===216&&preserved[2]===255)headers.jpeg++;else if(preserved[0]===137&&preserved.subarray(1,4).toString()==='PNG')headers.png++;else{new TextDecoder('utf8',{fatal:true}).decode(preserved);headers.utf8++;}if(!r.reusedExistingPublic)assert(alias.newPayloads.some(p=>p.path===r.publicPath&&p.bytes===r.bytes&&p.sha256===r.sha256));}
const exclusionChecks=[];for(const r of alias.excluded){assert.equal(r.public,false);assert(r.sourcePath.split('/').includes('.local'));assert(!alias.records.some(p=>p.sourceRoot===r.sourceRoot&&p.sourcePath===r.sourcePath));const root=path.join(base,r.sourceRoot),exists=fs.existsSync(path.join(root,r.sourcePath));if(exists)read(root,r.sourcePath,r);exclusionChecks.push({...r,currentlyExists:exists,publicBytesCopied:false});}check('all1230 original-to-public aliases exact;398 new aliases dedup234;832 public reuse;59 explicit local exclusions');
const current=json(stage,'current-before.json');assert.equal(current.rows.length,57);for(const r of current.rows)read(repo,r.path,r);assert.equal(plan.rows.length,16);assert.equal(plan.rows.filter(r=>r.operation==='REPLACE').length,4);assert.equal(plan.rows.filter(r=>r.operation==='ADD').length,12);const targets=new Set(),inverseRows=[];for(const r of plan.rows){safe(r.target,true);assert(r.target.startsWith('products/rea-studio/apps/vault/')&&!targets.has(r.target));targets.add(r.target);const b=read(stage,r.source,r.after);if(r.before)read(repo,r.target,r.before);else assert(!fs.existsSync(path.join(repo,r.target)));assert.equal(r.adapterExecuted,false);if(r.sourceAuthority){const source=read(path.join(base,r.sourceAuthority.root),r.sourceAuthority.path,r.sourceAuthority.original),edits=adapters.changes.filter(c=>c.destination===r.target);assert.equal(edits.length,r.adaptations);let inverse=b.toString(),forward=source.toString();for(const e of edits){assert.equal(e.occurrences,1);assert.equal(forward.split(e.before).length-1,1);forward=forward.replace(e.before,e.after);}for(const e of [...edits].reverse()){assert.equal(inverse.split(e.after).length-1,1);inverse=inverse.replace(e.after,e.before);}assert.deepEqual(Buffer.from(forward),b);assert.deepEqual(Buffer.from(inverse),source);inverseRows.push({target:r.target,changes:edits.length,inverseExact:true,executed:false});}save('source/proposed/'+path.posix.basename(r.target)+'.snapshot',b);}assert.equal(inverseRows.length,13);assert.equal(adapters.changes.length,11);
for(const d of docs.changes){const b=read(stage,d.path,d.afterIdentity),before=read(stage,'initial-documentation/'+path.posix.basename(d.path)+'.snapshot',d.beforeIdentity);assert.equal(before.toString().split(d.before).length-1,1);assert.equal(before.toString().replace(d.before,d.after),b.toString());assert.equal(b.toString().replace(d.after,d.before),before.toString());}assert.equal(docs.changes.length,3);check('16 app-only rows4replace12add/57 current gates;13 exact source inverses11 substitutions;three exact doc inverses');
