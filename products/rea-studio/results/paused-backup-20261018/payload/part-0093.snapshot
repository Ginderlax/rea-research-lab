const digest=bytes=>createHash('sha256').update(bytes).digest('hex'),session=new Session();session.connect();
const post=(method,params={})=>new Promise((resolve,reject)=>session.post(method,params,(error,result)=>error?reject(error):resolve(result)));
const specs={smallStandard:{n:100,reducers:['mean','min','max','sum','delta'],iterations:200000},largeStandard:{n:25000,reducers:['mean','min','max','sum','delta'],iterations:3000},singlePercentile:{n:25000,reducers:['p95'],iterations:300}};
await fs.mkdir(path.join(here,'profiles'),{recursive:true});const summaries=[];
await post('Profiler.enable');await post('Profiler.setSamplingInterval',{interval:100});
for(const [caseName,spec]of Object.entries(specs)){
  const values=Array.from({length:spec.n},(_,i)=>i%23===0?null:((i*7879)%7919)-3959.25),field=()=>({name:'synthetic',type:'number',config:{nullValueMode:'connected'},values,state:{}});
  for(let i=0;i<100;i++)module.reduceField({field:field(),reducers:spec.reducers});
  await post('Profiler.start');let result;
  for(let i=0;i<spec.iterations;i++)result=module.reduceField({field:field(),reducers:spec.reducers});
  const {profile}=await post('Profiler.stop'),output=path.join(here,'profiles',`${label}-${caseName}.cpuprofile`);
  await fs.writeFile(output,JSON.stringify(profile));
  const nodes=new Map(profile.nodes.map(node=>[node.id,node])),counts=new Map();
  for(const id of profile.samples??[]){const node=nodes.get(id),key=`${node?.callFrame.functionName||'(anonymous)'} @ ${node?.callFrame.url||'(runtime)'}:${(node?.callFrame.lineNumber??-1)+1}`;counts.set(key,(counts.get(key)??0)+1);}
  summaries.push({caseName,iterations:spec.iterations,samples:profile.samples?.length??0,topSampledFrames:[...counts].sort((a,b)=>b[1]-a[1]).slice(0,12),outputSHA256:digest(Buffer.from(JSON.stringify(result))),profileFile:path.relative(here,output),profileSHA256:digest(Buffer.from(JSON.stringify(profile)))});
}
session.disconnect();
const report={schemaVersion:1,candidate,sourceSHA256:digest(await fs.readFile(candidate)),checkedAt:new Date().toISOString(),summaries,scope:'Exploratory source profiling during concurrent development. Sampling locates work; no paired timing or performance improvement claim.',formalPairedTiming:false};
