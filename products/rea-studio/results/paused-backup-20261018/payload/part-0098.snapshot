"""Four-file source/data correction only; no candidate import or execution."""
import datetime, hashlib, json, pathlib

BASE = pathlib.Path(r'C:\Users\evanh\Documents\Codex\2026-10-12\go')
REPO = BASE / 'outputs/rea-research-lab'
STAGE = BASE / 'work/vault-empty-bin-hosted-next'
OLD = STAGE / 'versions/original-hash-module-r5'
PUBLIC = STAGE / 'public-candidate'
HELPER = 'products/rea-studio/experiments/vault-empty-bin/after/products/rea-studio/apps/vault/bin-empty-oracle.ps1.snapshot'
BUNDLE = 'products/rea-studio/experiments/vault-empty-bin/bundle.json'
COMPOSER = 'products/rea-studio/scripts/compose-vault-empty-bin-cloud.mjs'
COLLECTOR = 'products/rea-studio/scripts/verify-cloud.mjs'
PATHS = [HELPER, BUNDLE, COMPOSER, COLLECTOR]

def ident(path):
    content = path.read_bytes()
    return {'bytes': len(content), 'sha256': hashlib.sha256(content).hexdigest()}

def text(path):
    return path.read_bytes().decode('utf-8')

def write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(value.encode('utf-8'))

def writejson(path, value):
    write(path, json.dumps(value, indent=2, ensure_ascii=False) + '\n')

def replace_exact(value, before, after, count=1):
    if value.count(before) != count:
        raise ValueError('Unexpected source anchor count: ' + before[:100])
    return value.replace(before, after)

before = {name: ident(OLD / 'public-candidate' / name) for name in PATHS}
for name in PATHS:
    if ident(REPO / name) != before[name]:
        raise ValueError('Committed r5 source epoch mismatch: ' + name)

helper = text(OLD / 'public-candidate' / HELPER)
old_hash = '$digest=(Get-FileHash -LiteralPath $oracle -Algorithm SHA256).Hash.ToLowerInvariant()'
new_hash = '''$hashStream=$null;$hashAlgorithm=$null
try{
  $hashStream=[IO.File]::OpenRead($oracle)
  $hashAlgorithm=[Security.Cryptography.SHA256]::Create()
  $digest=[BitConverter]::ToString($hashAlgorithm.ComputeHash($hashStream)).Replace('-','').ToLowerInvariant()
}finally{
  if($null -ne $hashAlgorithm){$hashAlgorithm.Dispose()}
  if($null -ne $hashStream){$hashStream.Dispose()}
}'''
helper = replace_exact(helper, old_hash, new_hash)
write(PUBLIC / HELPER, helper)
write(STAGE / 'candidate/products/rea-studio/apps/vault/bin-empty-oracle.ps1', helper)
helper_after = ident(PUBLIC / HELPER)

bundle = text(OLD / 'public-candidate' / BUNDLE)
bundle = replace_exact(bundle, '"bytes": ' + str(before[HELPER]['bytes']), '"bytes": ' + str(helper_after['bytes']), 2)
bundle = replace_exact(bundle, before[HELPER]['sha256'], helper_after['sha256'], 2)
write(PUBLIC / BUNDLE, bundle)
bundle_after = ident(PUBLIC / BUNDLE)

for name in [COMPOSER, COLLECTOR]:
    source = text(OLD / 'public-candidate' / name)
    old_pin = json.dumps(before[BUNDLE], separators=(',', ':'))
    new_pin = json.dumps(bundle_after, separators=(',', ':'))
    source = replace_exact(source, old_pin, new_pin)
    write(PUBLIC / name, source)

delta = [{'path': name, 'mode': 'replace-exact-committed-inert-payload-or-tooling', 'before': before[name], 'after': ident(PUBLIC / name)} for name in PATHS]
overall = json.loads(text(OLD / 'change-authority.json'))
overall['status'] = 'r6-original-hash-source-correction-unexecuted-independent-delta-review-pending'
overall['atUtc'] = datetime.datetime.now(datetime.timezone.utc).isoformat()
overall['baselineGitCommitObservedDuringFinalFiling'] = '63014920a81d3d28108bdbde35731774a332462b'
for row in overall['files']:
    if row['path'] in PATHS:
        row['before'] = before[row['path']]
        row['after'] = ident(PUBLIC / row['path'])
        row['mode'] = 'replace-exact-committed-inert-payload-or-tooling'
overall['publicBytes'] = sum(ident(path)['bytes'] for path in PUBLIC.rglob('*') if path.is_file())
overall['originalHashModuleR5PriorEpoch'] = {'path': 'work/vault-empty-bin-hosted-next/versions/original-hash-module-r5', 'authority': ident(OLD / 'change-authority.json'), 'preservedPublicFiles': 17, 'wholePriorStageExceptOlderVersionTreePreserved': True}
overall['originalHashR6Correction'] = {'changedPublicFiles': 4, 'changedApplicationRuntimePayloads': 0, 'changedTestAssertions': 0, 'changedTestRoster': 0, 'changedServerCompatibilityBehavior': 0, 'target': HELPER, 'before': before[HELPER], 'after': helper_after, 'implementation': '.NET SHA256 streaming File.OpenRead/ComputeHash; algorithm and stream disposed in finally; pinned executable digest still required before assembly load', 'powershellCompatibilityTarget': 'Windows PowerShell5', 'localExecution': False, 'hostedAcceptance': False}
overall['sourceAuthoringNotes'].append('r6 root-directed fix after actual Vault233 attempt: Windows PowerShell child lacks Get-FileHash. Only helper digest acquisition is changed to .NET streaming SHA256; same executable pin and all comparison assertions,27 new groups,45 test-file roster and r5 server payload unchanged. Four public files refresh helper/bundle/hardpins; no local execution.')
overall['nextAction'] = 'Root independent exact-four-file review, source-only copy/commit and fresh hosted replay. Prior failed233 receipt remains immutable; four original comparisons were not reached in that attempt.'
writejson(STAGE / 'change-authority.json', overall)

authority = {
