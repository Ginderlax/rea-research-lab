// Source-line declaration census, not a claim of exhaustive behavioral testing.
import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const root=path.dirname(fileURLToPath(import.meta.url)),hash=b=>createHash('sha256').update(b).digest('hex'),acquisition=JSON.parse(await fs.readFile(path.join(root,'acquisition.json'))),declaration=await fs.readFile(path.join(root,'source/vscode.d.ts.snapshot')),lines=declaration.toString().split('\n'),candidateText=await fs.readFile(path.join(root,'position-range-selection.mjs'),'utf8'),candidateLines=candidateText.split('\n'),contracts=[],classes=[];
for(const name of['Position','Range','Selection']){
 const classStart=lines.findIndex(l=>l.includes('export class '+name+(name==='Selection'?' extends Range':''))),classEnd=lines.findIndex((l,i)=>i>classStart&&l==='\t}');assert.ok(classStart>=0&&classEnd>classStart);const sourcePath='source/src/vs/workbench/api/common/extHostTypes/'+name.toLowerCase()+'.ts.snapshot',record=acquisition.records.find(r=>r.path===sourcePath),sourceLines=(await fs.readFile(path.join(root,sourcePath),'utf8')).split('\n'),candidateStart=candidateLines.findIndex(l=>l.startsWith('export class '+name)),candidateEnd=candidateLines.findIndex((l,i)=>i>candidateStart&&l==='}');
 classes.push({name,extends:name==='Selection'?'Range':null,declaration:{path:'source/vscode.d.ts.snapshot',sha256:hash(declaration),startLine:classStart+1,endLine:classEnd+1},implementationSource:record});let ordinal=0;
 for(let i=classStart+1;i<classEnd;i++){
  const m=/^\t\t(?:(readonly)\s+)?(\w+)(?:\??:|\()/.exec(lines[i]);if(!m)continue;const member=m[2],start=i;while(!/^\t\t[^\t].*;\s*$/.test(lines[i])){i++;assert.ok(i<classEnd);}const end=i,raw=lines.slice(start,end+1).join('\n'),signature=raw.replace(/\/\*\*[\s\S]*?\*\//g,'').replace(/\s+/g,' ').trim(),sourcePattern=new RegExp('^\\t(?:(?:static|public)\\s+)?(?:get\\s+)?'+member+'\\b'),sourceLocations=sourceLines.flatMap((l,k)=>sourcePattern.test(l)?[{line:k+1,text:l.trim()}]:[]),candidatePattern=new RegExp('^  (?:get\\s+)?'+member+'\\b'),candidateLocations=candidateLines.flatMap((l,k)=>k>=candidateStart&&k<=candidateEnd&&candidatePattern.test(l)?[{line:k+1,text:l.trim()}]:[]);assert.ok(sourceLocations.length,member);assert.ok(candidateLocations.length,member);
  const nestedOptionFields=lines.slice(start,end+1).flatMap((l,k)=>/^\t\t\t\w+\?:/.test(l)?[{line:start+k+1,declaration:l.trim()}]:[]);
  contracts.push({id:name+'.'+member+'.'+(++ordinal),class:name,member,signature,readonlyDeclared:Boolean(m[1]),declaration:{path:'source/vscode.d.ts.snapshot',sha256:hash(declaration),startLine:start+1,endLine:end+1},nestedOptionFields,source:{path:sourcePath,sha256:record.sha256,locations:sourceLocations},candidate:{path:'position-range-selection.mjs',sha256:hash(candidateText),locations:candidateLocations},acceptance:'Implemented; finite original differential evidence in runs/author/original-comparisons.json; universal correctness unproven'});
 }
}
assert.equal(contracts.length,30);assert.deepEqual(Object.fromEntries(classes.map(c=>[c.name,contracts.filter(r=>r.class===c.name).length])),{Position:13,Range:12,Selection:5});assert.equal(contracts.flatMap(r=>r.nestedOptionFields).length,6);const result={schema:'rea-editor-value-api-declaration-contracts/v1',release:acquisition.release,commit:acquisition.commit,classes,documentedDeclarationEntries:30,nestedOptionFields:6,selectionInheritedRangeContractEntries:10,selectionInheritedRangeDistinctNames:9,contracts,notInDocumentedDeclarationCensus:['Original static Min/Max/isPosition/of/isRange/isSelection helpers','JSON/debug methods','Legacy ES5 call/apply compatibility','Internal field descriptors'],declarationCompletenessForTheseThreeClasses:true,semanticExhaustiveness:false,wholeExtensionApiCoverage:false};await fs.writeFile(path.join(root,'contracts.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({classes:3,entries:contracts.length,nestedOptionFields:6,sourceOriginalExecutions:0}));
