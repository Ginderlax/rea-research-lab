    {
      "id": "grafana.candidate.a6c0e7cf09ce6560ac6d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A dashboard bundle contains a `panels/<id>-<title>/` directory holding those files for each panel, plus a `manifest.json` recording when the bundle was generated, how many panels ran, and the data sources, sizes, and any errors for each panel.",
      "headingPath": [
        "Generate a data source diagnostic bundle",
        "What the bundle contains"
      ],
      "source": {
        "path": "docs/sources/troubleshooting/generate-diagnostic-bundle/index.md",
        "gitBlobSha": "71d7487f37cac3bf9f5110f1ad1851bb422e5d23",
        "sha256": "10ff5aefbde9d04ff889df9d370654a8bc798e11efc768dce9d4a319fc43270d",
        "lineStart": 106,
        "lineEnd": 106,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/troubleshooting/generate-diagnostic-bundle/index.md#L106-L106"
      },
      "applicability": {
