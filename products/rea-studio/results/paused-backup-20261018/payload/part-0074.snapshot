    {
      "id": "grafana.candidate.fc864b52b3f5ef5cd3d6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Some data sources, like Prometheus or SQL databases, live on private networks or behind fire wall rules that are not accessible by Grafana Cloud. If your Grafana OSS/Enterprise instance was hosted on the same network as your data source, you might find that Grafana Cloud cannot connect to all of the same data sources that Grafana OSS/Enterprise could access.",
      "headingPath": [
        "Migrate from Grafana OSS/Enterprise to Grafana Cloud manually",
        "Migrate Grafana resources",
        "Migrate dashboards, folders, data sources, library panels, and alert rules using Grizzly",
        "Fill in data source credentials",
        "(Optional) Configure Private Data Source Connect (PDC)"
      ],
      "source": {
        "path": "docs/sources/administration/migration-guide/manually-migrate-to-grafana-cloud.md",
        "gitBlobSha": "ec67ca7782261b3d96c30c162036cf6fe27e88b5",
        "sha256": "c9d95a24ed04bfff932d37d3bc549d6e090c208de06681aefa008a7d06eef4b7",
        "lineStart": 222,
        "lineEnd": 222,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/migration-guide/manually-migrate-to-grafana-cloud.md#L222-L222"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": []
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
