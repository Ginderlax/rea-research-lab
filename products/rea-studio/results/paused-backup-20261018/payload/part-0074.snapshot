    },
    {
      "id": "grafana.candidate.7785d495e34f004af53e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you've allowed loading of an unsigned plugin, then Grafana writes a warning message to the server log:",
      "headingPath": [
        "Plugin signatures",
        "Allow unsigned plugins"
      ],
      "source": {
