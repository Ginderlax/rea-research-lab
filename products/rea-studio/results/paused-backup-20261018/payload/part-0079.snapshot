    {
      "id": "grafana.candidate.a630bd4d71790bbaf533",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The number of nodes shown at a given time is limited to maintain a reasonable visualization performance. Nodes that are not currently visible are hidden behind clickable markers that show an approximate number of hidden nodes that are connected by a particular edge. You can click on the marker to expand the graph around that node.",
      "headingPath": [
        "Node graph",
        "Node graph navigation",
        "Hidden nodes"
      ],
      "source": {
