    },
    {
      "id": "grafana.candidate.4b2031f604acb6f0f689",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A variable is a placeholder for a value that you can use in dashboard queries, panel titles, links, and other dashboard elements. When you change the value of a variable, Grafana updates every dashboard element that uses that variable.",
      "headingPath": [
        "Variables"
      ],
