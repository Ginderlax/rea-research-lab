    },
    {
      "id": "grafana.candidate.00dd49c1a55c022532a5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can provision the Elasticsearch data source using [Terraform](https://www.terraform.io/) with the [Grafana Terraform provider](https://registry.terraform.io/providers/grafana/grafana/latest/docs).",
      "headingPath": [
