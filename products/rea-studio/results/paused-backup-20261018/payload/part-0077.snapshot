    },
    {
      "id": "grafana.candidate.d284062ea6d5ad5d5adf",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set to `true` to disable the sign out link in the side menu. This is useful if you use `auth.proxy`. Default is `false`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[auth]`",
        "`disable_signout_menu`"
