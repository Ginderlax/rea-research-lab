    {
      "id": "grafana.candidate.89db04076f933d1179a1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You cannot use an external ID for the Grafana Assume Role authentication provider.",
      "headingPath": [
        "Configure AWS authentication",
        "Assume a role",
        "Use an external ID"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/aws-authentication/index.md",
