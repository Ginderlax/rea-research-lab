import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const own=import.meta.dirname,file=path.join(own,'candidate/products/rea-studio/apps/flow/client.mjs'),before=await fs.readFile(file,'utf8'),sha=b=>createHash('sha256').update(b).digest('hex'),edits=[];
function replace(old,next){assert.equal(beforeWorking.split(old).length-1,1,old);beforeWorking=beforeWorking.replace(old,next);edits.push({before:old,after:next});}let beforeWorking=before;
replace('generation = 0,linkConnections=[],disposed=false;','generation = 0,linkConnections=[],disposed=false,rawDraft=null,draftRevision=0;');
replace("  const viewCurrent=()=>!disposed&&section.parentElement===root;",`  const viewCurrent=()=>!disposed&&section.parentElement===root;
  // HTML textarea values normalize CRLF and bare CR, retaining other Unicode.
  const textareaText=value=>String(value).replace(/\\r\\n?/g,'\\n');
  function setNativeText(raw){text.value=raw;rawDraft={raw,display:text.value};draftRevision++;}
  const draftText=()=>rawDraft&&rawDraft.display===text.value?rawDraft.raw:text.value;
  const captureDraft=()=>({epoch:generation,revision:draftRevision,text:draftText(),display:text.value,name:name.value});
  const sameDraft=capture=>viewCurrent()&&capture.epoch===generation&&capture.revision===draftRevision&&capture.display===text.value&&capture.text===draftText()&&capture.name===name.value;
  text.addEventListener('input',()=>draftRevision++);name.addEventListener('input',()=>draftRevision++);`);
replace("  function nodes() { const parsed = JSON.parse(text.value); return Array.isArray(parsed) ? parsed : parsed.flows; }","  function nodes() { const parsed = JSON.parse(draftText()); return Array.isArray(parsed) ? parsed : parsed.flows; }");
replace("    const document = JSON.parse(text.value), list = Array.isArray(document) ? document : document.flows;","    const document = JSON.parse(draftText()), list = Array.isArray(document) ? document : document.flows;");
replace("    text.value = JSON.stringify(document, null, 2); status.textContent = 'Draft changed; save and deploy to run the new revision.';","    setNativeText(JSON.stringify(document, null, 2)); status.textContent = 'Draft changed; save and deploy to run the new revision.';");
replace("    const epoch = generation, draft = text.value; const result = await api('native-validate', { text: draft });\n    if (!viewCurrent()||epoch !== generation || draft !== text.value) return;","    const capture=captureDraft(); const result = await api('native-validate', { text: capture.text });\n    if (!sameDraft(capture)) return;");
replace('name.value = current.name; text.value = current.text; await preview();','name.value = current.name; setNativeText(current.text); await preview();');
replace("const epoch=++generation; const source = file.files[0]; if (!source) return; if (source.size > 4 * 1024 * 1024) throw new Error('Native JSON file exceeds 4 MiB'); const imported=await source.text();if(!viewCurrent()||epoch!==generation)return;text.value=imported; name.value = source.name.replace(/\\.json$/i, '').slice(0, 120) || 'Native flow';", "const beforeImport=captureDraft(),epoch=++generation; const source = file.files[0]; if (!source) return; if (source.size > 4 * 1024 * 1024) throw new Error('Native JSON file exceeds 4 MiB'); const sourceName=source.name,imported=await source.text();if(!viewCurrent()||epoch!==generation)return;if(beforeImport.revision!==draftRevision||beforeImport.display!==text.value||beforeImport.name!==name.value){status.textContent='Import response ignored; newer draft input remains.';return;}setNativeText(imported); name.value = sourceName.replace(/\\.json$/i, '').slice(0, 120) || 'Native flow';");
replace("current = (await api('native-save', { id: current?.id, name: name.value, text: text.value })).flow; await refreshList(); await preview(); status.textContent = 'Native draft saved';", "const capture=captureDraft(),id=current?.id;const saved=await api('native-save',{id,name:capture.name,text:capture.text});if(capture.epoch!==generation)return;current=saved.flow;if(sameDraft(capture))rawDraft={raw:saved.flow.text,display:text.value};await refreshList();await preview();status.textContent=sameDraft(capture)?'Native draft saved':'Captured native draft saved; newer draft input remains.';");
