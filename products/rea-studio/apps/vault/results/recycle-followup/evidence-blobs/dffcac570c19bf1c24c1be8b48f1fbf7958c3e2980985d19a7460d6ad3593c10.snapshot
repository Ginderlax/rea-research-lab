ce,path.join(run,'prior-ui-observations',e.name),{recursive:true});}catch(err){if(err.code!=='ENOENT')throw err;}}}catch(e){if(e.code!=='ENOENT')throw e;}await fs.writeFile(path.join(run,'validation.json'),JSON.stringify(record,null,2)+'\n');console.log(JSON.stringify({...record,sourceBefore:undefined,sourceAfter:undefined,run}));process.exitCode=code;
