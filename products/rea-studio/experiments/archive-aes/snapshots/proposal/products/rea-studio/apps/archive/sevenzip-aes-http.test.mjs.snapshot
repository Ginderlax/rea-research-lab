import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs/promises';import path from'node:path';import os from'node:os';import{randomBytes,createHash}from'node:crypto';import{start}from'../../server.mjs';import{handle}from'./server.mjs';import{createWorkspace}from'../../lib/storage.mjs';
const sha=b=>createHash('sha256').update(b).digest('hex'),observations=[];
async function fixture(t,label){const dir=await fs.mkdtemp(path.join(os.tmpdir(),'rea-sevenzip-aes-'));let host=await start({port:0,dataDir:dir});const rows=[];t.after(async()=>{await host.close();assert.equal(path.dirname(dir),path.resolve(os.tmpdir()));assert(path.basename(dir).startsWith('rea-sevenzip-aes-'));await fs.rm(dir,{recursive:true,force:true});observations.push({label,normalClose:true,ownedTempRemoved:true,rows});});return{dir,workspace:path.join(dir,'archive/workspace'),restart:async()=>{await host.close();host=await start({port:0,dataDir:dir});},call:async(action,input,status=200)=>{const r=await fetch(`${host.url}/api/archive/${action}`,{method:'POST',headers:{'content-type':'application/json','x-rea-token':host.token},body:JSON.stringify(input)}),b=await r.json();rows.push({action,status:r.status,containsPasswordKey:JSON.stringify(b).includes('"password"')});assert.equal(r.status,status,b.error);if(typeof input.password==='string'&&input.password.length)assert.equal(JSON.stringify(b).includes(input.password),false);return b.result??b;}};}
test('real HTTP encrypted create/list/test/extract and restart retain exact files and persist no password records',async t=>{const f=await fixture(t,'restart'),password=randomBytes(24).toString('base64url')+'λ😀',contents='Synthetic HTTP encrypted file λ😀\n'.repeat(200);await f.call('putFile',{path:'source/data.txt',content:contents});await fs.mkdir(path.join(f.workspace,'source/empty'));for(const header of[false,true]){const archive=`encrypted-${header}.7z`,created=await f.call('create',{format:'sevenzip',source:'source',output:archive,compression:'lzma2',solid:true,encodedHeader:true,encryptHeaders:header,password});assert.equal(created.encrypted,true);assert.equal(created.headerEncrypted,header);const listed=await f.call('list',{path:archive,password});assert.equal(listed.headerEncrypted,header);assert.equal(listed.entries.find(e=>e.name==='data.txt').encrypted,true);assert.equal(JSON.stringify(listed).includes('"data"'),false);await f.call('test',{path:archive,password:'different-'+password},400);await f.call('extract',{path:archive,password:'different-'+password,destination:`bad-${header}`,confirm:true},400);await assert.rejects(fs.stat(path.join(f.workspace,`bad-${header}`)),/ENOENT/);await f.call('extract',{path:archive,password,destination:`out-${header}`,confirm:true});assert.equal(sha(await fs.readFile(path.join(f.workspace,`out-${header}/data.txt`))),sha(Buffer.from(contents)));await f.call('extract',{path:archive,password,destination:`out-${header}`,confirm:true},400);await f.call('create',{format:'sevenzip',source:'source',output:archive,password},400);}await f.restart();assert.equal((await f.call('test',{path:'encrypted-true.7z',password})).verified,true);await f.call('extract',{path:'encrypted-true.7z',password,destination:'after-restart',confirm:true});assert.equal(await fs.readFile(path.join(f.workspace,'after-restart/data.txt'),'utf8'),contents);async function scan(dir){for(const e of await fs.readdir(dir,{withFileTypes:true})){const p=path.join(dir,e.name);if(e.isDirectory())await scan(p);else{const b=await fs.readFile(p);assert.equal(b.includes(Buffer.from(password)),false);assert.equal(b.includes(Buffer.from(password,'utf16le')),false);}}}await scan(f.dir);assert.equal((await fs.readdir(f.workspace)).some(n=>n.includes('.partial-')),false);});
test('HTTP password/method/deadline refusals leave no destination or archive and preserve existing source',async t=>{const f=await fixture(t,'bounds'),password=randomBytes(24).toString('base64url');await f.call('putFile',{path:'source/a',content:'owned'});for(const [name,input]of[['zip',{format:'zip',password}],['missing',{format:'sevenzip',encryptHeaders:true}],['empty',{format:'sevenzip',password:''}],['long',{format:'sevenzip',password:'x'.repeat(129)}],['steps',{format:'sevenzip',password,maxSteps:0}],['time',{format:'sevenzip',password,maxTimeMs:0}]]){const output=name+(name==='zip'?'.zip':'.7z');await f.call('create',{source:'source',output,...input},400);await assert.rejects(fs.stat(path.join(f.workspace,output)),/ENOENT/);}assert.equal(await fs.readFile(path.join(f.workspace,'source/a'),'utf8'),'owned');});
test('direct queued caller mutation cannot replace captured password/path/output or encryption intent',async t=>{const dir=await fs.mkdtemp(path.join(os.tmpdir(),'rea-sevenzip-aes-'));t.after(async()=>{assert.equal(path.dirname(dir),path.resolve(os.tmpdir()));await fs.rm(dir,{recursive:true,force:true});});const workspace=await createWorkspace(path.join(dir,'workspace')),password=randomBytes(24).toString('base64url'),call=(action,input)=>handle({action,input,workspace});await call('putFile',{path:'source/a',content:'captured'});const blocker=call('putFile',{path:'source/b',content:'queue preceding write'}),input={source:'source',output:'captured.7z',format:'sevenzip',compression:'store',password,encryptHeaders:true},pending=call('create',input);input.password+='changed';input.output='changed.7z';input.encryptHeaders=false;await blocker;await pending;assert.equal((await call('test',{path:'captured.7z',password})).headerEncrypted,true);await assert.rejects(call('test',{path:'captured.7z',password:input.password}),/CRC|7z:/);await assert.rejects(fs.stat(path.join(workspace.root,'changed.7z')),/ENOENT/);});
test.after(async()=>{const out=process.env.ARCHIVE_AES_OBSERVATIONS;if(out){await fs.mkdir(out,{recursive:true});await fs.writeFile(path.join(out,'http.json'),JSON.stringify({schema:'rea-sevenzip-aes-http-observations/v1',hostStarts:3,cases:observations,originalExecutions:0,browserExecutions:0,credentialsRetained:false},null,2)+'\n');}});
