      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.fed5b949468b77f75ef7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you don't want user organizations and roles to be synchronized with the IdP, you can use the `skip_org_role_sync` configuration option.",
      "headingPath": [
        "Configure role sync for SAML"
      ],
