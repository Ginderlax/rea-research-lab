// Test-only oracle. Application code never evaluates or imports vendor source.
import { readFile, mkdir, writeFile } from 'node:fs/promises';
import { createHash } from 'node:crypto'; import { runInNewContext } from 'node:vm'; import { fileURLToPath, pathToFileURL } from 'node:url'; import assert from 'node:assert/strict';
import { exportExcalidraw, importExcalidraw, example } from './core.mjs'; import { nativeFixture } from './fixtures.mjs';
const archive = new URL('../../../../outputs/rea-research-lab/projects/04-excalidraw/artifacts/package.tgz', import.meta.url);
const bundle = new URL('../../../../outputs/rea-research-lab/projects/04-excalidraw/artifacts/package/dist/dev/chunk-4FTI6OG3.js', import.meta.url);
const expectedArchive = 'b280d4b364b65cba264c5aa4e7435cc2ce6421eabbbef9765a56997a0fadf534';
const expectedBundle = '3cfe278cb537fde73b42bbd4697b392946517d3dc02d3f3cf8487d8476f63ba2';
const digest = bytes => createHash('sha256').update(bytes).digest('hex');
export async function runOracle() {
  const archiveBytes = await readFile(archive), bytes = await readFile(bundle); assert.equal(digest(archiveBytes), expectedArchive, 'Pinned original package archive changed'); assert.equal(digest(bytes), expectedBundle, 'Pinned original bundle changed');
  const source = bytes.toString('utf8'), slices = [];
  function block(name, closing = '\n};') { const start = source.indexOf(`var ${name} = `); assert.ok(start >= 0, `Original declaration absent: ${name}`); const end = source.indexOf(closing, start); assert.ok(end > start, `Original declaration end absent: ${name}`); const text = source.slice(start, end + closing.length); slices.push({ name, byteStart: Buffer.byteLength(source.slice(0, start)), sha256: digest(text) }); return text; }
  function line(name) { const start = source.indexOf(`var ${name} = `), end = source.indexOf(';', start); assert.ok(start >= 0 && end > start); const text = source.slice(start, end + 1); slices.push({ name, byteStart: Buffer.byteLength(source.slice(0, start)), sha256: digest(text) }); return text; }
  const declarations = [block('EXPORT_DATA_TYPES'), block('VERSIONS'), line('EXPORT_SOURCE'), block('APP_STATE_STORAGE_CONF', '\n});'), block('_clearAppStateForStorage'), block('cleanAppStateForExport'), block('filterOutDeletedFiles'), block('isLinearElementType'), block('isLinearElement'), block('isFreeDrawElementType'), block('isFreeDrawElement'), block('isInvisiblySmallElement'), block('isArrowElement'), block('isElbowArrow'), block('getSizeFromPoints'), block('getNormalizedDimensions'), block('repairBinding'), block('restoreElementWithProperties'), block('restoreElement'), line('getNonDeletedElements2'), block('_clearElements', '\n);'), line('clearElementsForExport'), block('serializeAsJSON'), block('isValidExcalidrawData')];
  const original = runInNewContext(`${declarations.join('\n')}\n({ isValidExcalidrawData, isInvisiblySmallElement, restoreElement, serializeAsJSON })`, { window: { location: { origin: 'https://excalidraw.com' } }, DEFAULT_ELEMENT_PROPS: Object.freeze({}) }, { timeout: 2000 });
  // Fully specified fixtures avoid default-property, font-measurement, binding repair,
  // fractional ordering and renderer environment dependencies. No helper is replaced.
  const scene = structuredClone(example); scene.shapes.push({ id: 'freehand', type: 'freedraw', x: 100, y: 230, w: 60, h: 30, stroke: '#334455', points: [[0, 0], [30, -10], [60, 20]] });
  const exported = exportExcalidraw(scene); assert.equal(original.isValidExcalidrawData(exported), true); assert.equal(original.isValidExcalidrawData({ type: 'wrong', elements: [] }), false);
  // This demonstrates that the original predicate is only an envelope check.
  assert.equal(original.isValidExcalidrawData({ type: 'excalidraw', elements: [{ arbitrary: true }] }), true);
  const restored = exported.elements.map(element => original.restoreElement(element)); assert.equal(restored.length, 6);
  for (let i = 0; i < restored.length; i++) { assert.ok(restored[i]); for (const key of ['id', 'type', 'x', 'y', 'width', 'height']) assert.equal(restored[i][key], exported.elements[i][key]); if (exported.elements[i].points) assert.deepEqual(JSON.parse(JSON.stringify(restored[i].points)), exported.elements[i].points); }
  const serialized = JSON.parse(original.serializeAsJSON(exported.elements, exported.appState, exported.files, 'local')); assert.equal(original.isValidExcalidrawData(serialized), true); assert.deepEqual(exportExcalidraw(importExcalidraw(serialized)), serialized);
  const native = nativeFixture(); const nativeSerialized = JSON.parse(original.serializeAsJSON(native.elements, native.appState, native.files, 'local')); assert.equal(nativeSerialized.elements.some(e => e.id === 'deleted'), false); assert.deepEqual(exportExcalidraw(importExcalidraw(nativeSerialized)), nativeSerialized);
  const imported = importExcalidraw(native); imported.shapes.find(s => s.id === 'box').x += 10; const edited = exportExcalidraw(imported).elements.find(e => e.id === 'box'), restoredEdited = original.restoreElement(edited); assert.equal(restoredEdited.x, edited.x); assert.deepEqual(JSON.parse(JSON.stringify(restoredEdited.customData)), edited.customData);
  const dot = exportExcalidraw({ name: 'Dot', shapes: [{ id: 'dot', type: 'freedraw', x: 0, y: 0, w: 0, h: 0, points: [[0, 0]] }] }).elements[0]; assert.equal(original.isInvisiblySmallElement(dot), false); assert.ok(original.restoreElement(dot));
  const implementation = {}; for (const file of ['core.mjs', 'server.mjs', 'client.mjs', 'fixtures.mjs']) implementation[file] = digest(await readFile(new URL(file, import.meta.url)));
  return { schema: 'rea-sketch-original-oracle/v1', checkedAt: new Date().toISOString(), status: 'passed', original: { package: '@excalidraw/excalidraw', version: '0.18.1', releaseCommit: 'a2ec2889babf7d2295469c6d90ebe77fae57df84', packageArchiveSha256: expectedArchive, developmentBundleSha256: expectedBundle }, implementationSha256: implementation, helpers: slices, assertions: { envelopeAccepted: true, envelopeRejectsWrongType: true, envelopeAcceptsInvalidElementThereforeNotFullValidation: true, originalIndividualElementRestoration: { count: restored.length, types: [...new Set(restored.map(e => e.type))] }, originalSerializerRoundtrip: true, originalSerializerFixtureWithImagesAndUnknownMetadataRoundtrip: true, editedRectangleOriginalRestoration: true, newFreehandDotSurvivesOriginalSmallElementPredicate: true }, limitations: ['Individual restoreElement and local serializeAsJSON helpers exercised in isolation; full restoreElements/restoreAppState/import UI and renderer were not exercised.', 'Fully specified synthetic elements only; missing-field defaults, legacy migrations, binding repair, fonts, fractional indices and broad real-world scenes remain untested.', 'Original envelope predicate is permissive and is not element validation.', 'Unsupported imported elements are preserved as inert records, not rendered or editable.', 'No complete feature parity or superiority conclusion.'] };
}
if (process.argv[1] && pathToFileURL(process.argv[1]).href === import.meta.url) { const receipt = await runOracle(); const directory = new URL('./results/', import.meta.url); await mkdir(directory, { recursive: true }); await writeFile(new URL('excalidraw-compatibility.json', directory), JSON.stringify(receipt, null, 2) + '\n'); console.log(`Pinned Excalidraw oracle passed: ${receipt.assertions.originalIndividualElementRestoration.count} original element restorations; original local serializer roundtrips. Receipt: ${fileURLToPath(new URL('excalidraw-compatibility.json', directory))}`); }
