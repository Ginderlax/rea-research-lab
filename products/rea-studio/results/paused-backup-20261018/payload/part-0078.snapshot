    {
      "id": "grafana.candidate.494b8ab68e177d627996",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "SQL expressions integrates alerting and recording rules, allowing you to define complex conditions and metrics using standard SQL queries. The system processes your query results and automatically creates alert instances or recorded metrics based on the returned data structure.",
      "headingPath": [
        "SQL expressions",
        "Alerting and recording rules"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/sql-expressions/index.md",
