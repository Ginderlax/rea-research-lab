    {
      "id": "grafana.candidate.90e4d01504d26acdb03a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Allows users to create panels directly from within explore.",
      "headingPath": [
        "What's new in Grafana v8.5",
        "OSS",
        "Experimental Explore to Dashboard workflow"
      ],
      "source": {
