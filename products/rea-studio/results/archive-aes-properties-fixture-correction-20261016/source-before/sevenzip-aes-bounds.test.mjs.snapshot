import test from'node:test';import assert from'node:assert/strict';import{randomBytes}from'node:crypto';import{read7z,write7z,encodeNumber,crc32,LIMITS}from'./sevenzip.mjs';import{createAesContext,makeAesProperties}from'./sevenzip-aes.mjs';import{OperationBudget}from'./operation-budget.mjs';
const b=n=>Buffer.from([n]),u=n=>{const x=Buffer.alloc(4);x.writeUInt32LE(n);return x;},n=encodeNumber,j=a=>Buffer.concat(a);
function envelope(packed,next){const start=Buffer.alloc(20);start.writeBigUInt64LE(BigInt(packed.length));start.writeBigUInt64LE(BigInt(next.length),8);start.writeUInt32LE(crc32(next),16);return j([Buffer.from('377abcaf271c0004','hex'),u(crc32(start)),start,packed,next]);}
function fixture({packed,properties,size,crc=null,name='owned.bin',method='06f10701'}){const names=j([b(0),Buffer.from(name+'\0','utf16le')]),next=j([b(1),b(4),b(6),n(0),n(1),b(9),n(packed.length),b(0),b(7),b(11),n(1),b(0),n(1),b(0x24),Buffer.from(method,'hex'),n(properties.length),properties,b(12),n(size),...(crc===null?[]:[b(10),b(1),u(crc)]),b(0),b(8),b(0),b(0),b(5),n(1),b(17),n(names.length),names,b(0),b(0)]);return envelope(packed,next);}
test('independent ordinary folder fixture enforces AES alignment, properties, file/expansion/path and missing-digest limits before output',()=>{const password=randomBytes(24).toString('base64url'),properties=makeAesProperties({cyclesPower:4}),plain=Buffer.from('owned plaintext'),context=createAesContext(password),packed=context.encrypt(plain,{properties}).packed;context.close();const base={packed,properties,size:plain.length,crc:crc32(plain)};assert.deepEqual(read7z(fixture(base),{password})[0].data,plain);assert.throws(()=>read7z(fixture({...base,packed:packed.subarray(1)}),{password}),/ciphertext.*size mismatch/);assert.throws(()=>read7z(fixture({...base,size:17}),{password}),/ciphertext.*size mismatch/);const costly=Buffer.from(properties);costly[0]=(costly[0]&192)|21;assert.throws(()=>read7z(fixture({...base,properties:costly}),{password}),/KDF cycles/);assert.throws(()=>read7z(fixture({...base,properties:properties.subarray(1)}),{password}),/properties/);assert.throws(()=>read7z(fixture({...base,size:LIMITS.file+1}),{password}),/file size/);assert.throws(()=>read7z(fixture({...base,size:LIMITS.total+1}),{password}),/bound/);assert.throws(()=>read7z(fixture({...base,crc:null})),/needs recorded unpacked CRC/);assert.throws(()=>read7z(fixture({...base,name:'../outside'}),{password}),/unsafe path/);assert.throws(()=>read7z(fixture({...base,method:'03030103'}),{password}),/unsupported coder/);for(let cut=1;cut<33;cut++)assert.throws(()=>read7z(fixture(base).subarray(0,-cut),{password}),/bounds|truncated|size/);});
test('CRC is corruption detection, not authentication: controlled IV tamper plus rebuilt CRC changes plaintext without re-encryption',()=>{const password=randomBytes(24).toString('base64url'),plain=Buffer.from('owned bytes'),properties=makeAesProperties({cyclesPower:4}),context=createAesContext(password),packed=context.encrypt(plain,{properties}).packed;context.close();assert.deepEqual(read7z(fixture({packed,properties,size:plain.length,crc:crc32(plain)}),{password})[0].data,plain);const modifiedProperties=Buffer.from(properties),modifiedPlain=Buffer.from(plain);modifiedProperties[modifiedProperties.length-16]^=1;modifiedPlain[0]^=1;assert.deepEqual(read7z(fixture({packed,properties:modifiedProperties,size:plain.length,crc:crc32(modifiedPlain)}),{password})[0].data,modifiedPlain);});
test('aggregate KDF budget spans separate encrypted read/write operations and deterministic small guards refuse work',()=>{const password=randomBytes(24).toString('base64url'),files=[{name:'a',data:Buffer.from('budget')}],measured=new OperationBudget({maxTimeMs:60000});const archive=write7z(files,{method:'copy',password,encryptHeaders:true,operationBudget:measured});const writerWork=measured.steps;read7z(archive,{password,operationBudget:measured});assert(measured.steps>writerWork);const shared=new OperationBudget({maxTimeMs:60000,maxSteps:measured.steps-1}),written=write7z(files,{method:'copy',password,encryptHeaders:true,operationBudget:shared});assert.throws(()=>read7z(written,{password,operationBudget:shared}),/step budget/);assert.throws(()=>write7z(files,{password,maxSteps:100}),/step budget/);assert.throws(()=>read7z(archive,{password,maxSteps:100}),/step budget/);assert.throws(()=>read7z(archive,{password,maxTimeMs:0}),/elapsed-time/);});
