const sameAttempt=value=>{assert.deepEqual(value.execution,helper.execution());assert.equal(value.sourceCommit,process.env.GITHUB_SHA);};
function toolingProof(){assert.equal(tooling.length,12);let bytes=0;for(const row of tooling){const content=committed(row.path,row);bytes+=content.length;assert(bytes<=8*1024*1024);}return{paths:tooling.map(row=>({...row})),readFiles:12,fileLimit:12,readBytes:bytes,byteLimit:8*1024*1024,selfSource:{path:self,...identity(committed(self)),GitBound:true}};}
function captureTooling(proof){for(const row of proof.paths)writeBytes('tooling-source/'+row.path+'.snapshot',committed(row.path,row));}
let composition,before,child=null,stopActive=null,interrupted=null;
const stopHandlers=new Map(['SIGINT','SIGTERM'].map(signal=>[signal,()=>{interrupted=signal;stopActive?.('collector-'+signal);} ]));for(const[signal,handler]of stopHandlers)process.on(signal,handler);
const quietPipe=()=>{};for(const stream of[process.stdout,process.stderr])stream.on('error',quietPipe);
async function run(arguments_,milliseconds,label,environment={}){
 const outFd=fs.openSync(path.join(evidence,role+'-stdout.txt'),'wx'),errFd=fs.openSync(path.join(evidence,role+'-stderr.txt'),'wx'),eventsFd=fs.openSync(path.join(evidence,role+'-events.jsonl'),'wx');
 const result={label,command:[process.execPath,...arguments_],startedAtUtc:new Date().toISOString(),exitCode:null,signal:null,closeObserved:false,spawnError:null,stopReason:null,stdoutBytes:0,stderrBytes:0,droppedOutputBytes:0};record.children.push(result);
 let sequence=0,deadline,forced,progress;
 const event=(kind,value={})=>fs.writeSync(eventsFd,JSON.stringify({sequence:++sequence,atUtc:new Date().toISOString(),kind,...value})+'\n');
 try{
  const outcome=await new Promise(resolve=>{let finished=false;const finish=(code,signal,closed)=>{if(finished)return;finished=true;clearTimeout(deadline);clearTimeout(forced);clearInterval(progress);resolve({code,signal,closed});};
   stopActive=reason=>{if(result.stopReason)return;result.stopReason=reason;event('stop-requested',{reason,pid:child?.pid??null});if(child?.pid&&child.exitCode===null){const killed=spawnSync('taskkill',['/PID',String(child.pid),'/T','/F'],{shell:false,windowsHide:true,timeout:10000,stdio:'ignore'});if(killed.status!==0)child.kill('SIGKILL');}forced=setTimeout(()=>{child?.stdout?.destroy();child?.stderr?.destroy();finish(null,null,false);},5000);};
   const env={...process.env,...environment};delete env.NODE_TEST_CONTEXT;child=spawn(process.execPath,arguments_,{cwd:role==='finite'?studio:tools,env,shell:false,windowsHide:true,stdio:['ignore','pipe','pipe']});result.pid=child.pid??null;event('child-started',{pid:result.pid});
   for(const[kind,stream,fd,consoleStream,cap]of[['stdout',child.stdout,outFd,process.stdout,16*1024*1024],['stderr',child.stderr,errFd,process.stderr,4*1024*1024]]){stream.on('data',bytes=>{const key=kind+'Bytes',take=Math.min(bytes.length,Math.max(0,cap-result[key]));if(take){fs.writeSync(fd,bytes.subarray(0,take));consoleStream.write(bytes.subarray(0,take));result[key]+=take;}result.droppedOutputBytes+=bytes.length-take;if(bytes.length>take)stopActive('output-bound');});stream.on('error',error=>{event('pipe-error',{kind,message:error.message});stopActive('pipe-error');});}
   child.on('error',error=>{result.spawnError={name:error.name,message:error.message,code:error.code??null};event('spawn-error',result.spawnError);});child.on('close',(code,signal)=>finish(code,signal,true));deadline=setTimeout(()=>stopActive('deadline'),milliseconds);progress=setInterval(()=>{event('progress',{pid:result.pid,stdoutBytes:result.stdoutBytes,stderrBytes:result.stderrBytes});for(const fd of[outFd,errFd,eventsFd])fs.fsyncSync(fd);},10000);
  });Object.assign(result,{exitCode:outcome.code,signal:outcome.signal,closeObserved:outcome.closed,completedAtUtc:new Date().toISOString()});event('child-closed',result);
 }finally{stopActive=null;child=null;clearTimeout(deadline);clearTimeout(forced);clearInterval(progress);for(const fd of[outFd,errFd,eventsFd]){fs.fsyncSync(fd);fs.closeSync(fd);}}
 assert.equal(interrupted,null);assert.equal(result.exitCode,0);assert.equal(result.signal,null);assert.equal(result.closeObserved,true);assert.equal(result.spawnError,null);assert.equal(result.stopReason,null);assert.equal(result.droppedOutputBytes,0);return result;
}
function finiteResults(){
 const raw=read('finite-stdout.txt').toString('utf8'),summary={};for(const key of['tests','pass','fail','cancelled','skipped','todo']){const rows=[...raw.matchAll(new RegExp('^# '+key+' (\\d+)\\r?$','gm'))];assert.equal(rows.length,1);summary[key]=Number(rows[0][1]);}assert.deepEqual(summary,{tests:111,pass:111,fail:0,cancelled:0,skipped:0,todo:0});
 const b=composition.bundle;for(const group of[...b.oldNamedGroupsRequired,...b.newNamedGroupsRequired])assert.equal(raw.split(/\r?\n/).filter(line=>line==='# Subtest: '+group).length,1,'Every old/new required named group must run once: '+group);
 const observations=raw.split(/\r?\n/).filter(line=>line.startsWith('# {')).map(line=>{try{return JSON.parse(line.slice(2));}catch{return null;}}).filter(Boolean),one=key=>{const rows=observations.filter(row=>Object.hasOwn(row,key));assert.equal(rows.length,1,key);return rows[0][key];};
 const old=one('notesTodoOriginalComparisons');assert.equal(old.sourceSha256,b.historicalOriginalDependencies[0].sha256);assert.equal(old.conversionComparisons,16);assert.equal(old.completionComparisons,4);assert.equal(old.clock,1790000000123);assert.deepEqual(old.bindings.map(row=>row.name),['changeNoteType','toggleTodoCompleted']);for(const key of['originalFullApplicationExecutions','originalDatabaseExecutions','originalGuiSessions'])assert.equal(old[key],0);
 const parent=one('notesNewTodoOriginalHelperComparisons');assert.equal(parent.sourceCommit,'7e2765a3857754d12dbadea442b60ceaf9d4b23d');assert.equal(parent.comparisons,4);assert.deepEqual(parent.comparedFields,['parent_id','is_todo']);assert.deepEqual(parent.fieldsAdapter,['parent_id','is_todo','adapterSentinel']);assert.equal(parent.dueAndCompletionZerosAreCandidateOnlyChecks,true);assert.deepEqual(parent.sourcePins,{note:[45302,'5f1a200dc970179ad6fd193f7ffc47f09f88261cff8f893ccc793517ebbe9647'],base:[26960,'c0a19f6d2d689cc75de99e4ba57058ec02f9171c5b5b3c739aa45d11d5920fde']});assert.deepEqual(parent.bindings.map(row=>[row.owner,row.name]),[['BaseModel','new'],['Note','new'],['Note','newTodo']]);
 const command=one('notesNewTodoOriginalCommandComparisons');assert.equal(command.sourceCommit,parent.sourceCommit);assert.equal(command.comparisons,2);assert.deepEqual(command.comparedArguments,['body','isTodo']);assert.equal(command.delegatedCommand,'newNote');assert.equal(command.actualNewNoteCommandExecuted,false);assert.equal(command.originalProvisionalSaveExecuted,false);assert.deepEqual(command.commandSource,{bytes:591,sha256:'218a695d94fafb17d1650dc0601ca4c684628c9a1a6c923887d73937211aef6f'});assert.deepEqual(command.newNoteSource,{bytes:1341,sha256:'f5f0e9f3a5f9f2188b99c51778dbb88e5d99d3ab6e2cf0ae0ec879cdb99c0eed'});assert(/^[0-9a-f]{64}$/.test(command.runtimeFactorySliceSha256));
 for(const row of[parent,command]){assert.equal(row.countsAddedToTestGroups,false);for(const key of['originalDatabaseExecutions','originalGuiExecutions','originalFullApplicationExecutions'])assert.equal(row[key],0);}for(const row of[...old.bindings,...parent.bindings])assert(/^[0-9a-f]{64}$/.test(row.sha256)&&Number.isInteger(row.startLine)&&Number.isInteger(row.endLine)&&row.endLine>=row.startLine);
 const delivery=one('notesTodoActualHttpModuleDelivery');assert.equal(delivery.unchangedPublicModuleBoundary,true);assert.equal(delivery.actualBrowserExecution,false);assert.deepEqual(delivery.client,identity(helper.readSource('products/rea-studio/apps/notes/client.mjs')));assert.deepEqual(delivery.delivered.map(row=>row.path),['/apps/notes/markdown.mjs','/apps/notes/core.mjs']);for(const row of delivery.delivered)assert.deepEqual(pin(row),identity(helper.readSource('products/rea-studio'+row.path)));
 const result={schema:'rea-Notes-new-todo-finite-observations/v1',execution:helper.execution(),sourceCommit:process.env.GITHUB_SHA,summary,fixedFiles:b.fixedTests,oldNamedGroupsObserved:23,newNamedGroupsObserved:19,separateComparisonCounts:b.separateComparisonCounts,existingOriginalHelper:old,newParentAndTypeOriginalHelpers:parent,newDesktopCommandArguments:command,actualHttpModuleDelivery:delivery,originalFullApplicationExecutions:0,originalDatabaseExecutions:0,originalGuiExecutions:0,browserExecutions:0,fullParity:false,superiority:false};write('new-todo-finite-observations.json',result);return result;
}
function png(bytes){assert.equal(bytes.subarray(0,8).toString('hex'),'89504e470d0a1a0a');let at=8,count=0,end=false;const crc=data=>{let value=0xffffffff;for(const byte of data){value^=byte;for(let bit=0;bit<8;bit++)value=(value>>>1)^((value&1)?0xedb88320:0);}return(value^0xffffffff)>>>0;};while(at<bytes.length){assert(at+12<=bytes.length);const size=bytes.readUInt32BE(at);assert(size<=2*1024*1024&&at+12+size<=bytes.length);const type=bytes.subarray(at+4,at+8).toString('ascii');assert.equal(bytes.readUInt32BE(at+8+size),crc(bytes.subarray(at+4,at+8+size)));if(count++===0){assert.equal(type,'IHDR');assert.equal(size,13);assert.equal(bytes.readUInt32BE(at+8),1440);assert.equal(bytes.readUInt32BE(at+12),1100);}at+=12+size;if(type==='IEND'){assert.equal(size,0);end=true;break;}}assert(end&&at===bytes.length);return{width:1440,height:1100,CRCVerified:true,...identity(bytes)};}
function tar(bytes){assert(bytes.length>=1024&&bytes.length%512===0);const rows=new Map();let at=0;while(at+512<=bytes.length){const h=bytes.subarray(at,at+512);if(h.every(byte=>byte===0)){assert(at+1024<=bytes.length&&bytes.subarray(at).every(byte=>byte===0));return rows;}let sum=0;for(let i=0;i<512;i++)sum+=i>=148&&i<156?32:h[i];assert.equal(sum,parseInt(h.subarray(148,156).toString('ascii').replace(/\0.*$/,'' ).trim(),8));const name=h.subarray(0,100).toString('utf8').replace(/\0.*$/,'');helper.safe(name);assert([0,48].includes(h[156]));assert(!rows.has(name));const size=parseInt(h.subarray(124,136).toString('ascii').replace(/\0.*$/,'').trim()||'0',8);assert(Number.isSafeInteger(size)&&size>=0&&size<=8*1024*1024&&at+512+size<=bytes.length);rows.set(name,bytes.subarray(at+512,at+512+size));assert(rows.size<=2000);at+=512+Math.ceil(size/512)*512;}throw new Error('Missing TAR terminator');}
function browserResults(){
 const report=json('playwright-results.json'),specs=[],visit=suite=>{specs.push(...(suite.specs??[]));for(const nested of suite.suites??[])visit(nested);};for(const suite of report.suites)visit(suite);assert.deepEqual(report.errors,[]);assert.equal(specs.length,8);const roster=JSON.parse(committed('products/rea-studio/browser-tests/notes-new-todo-roster.json',tooling[5]));assert.deepEqual(specs.map(row=>row.title).sort(),[...roster].sort());for(const spec of specs){assert.equal(spec.ok,true);assert.equal(spec.tests.length,1);const item=spec.tests[0];assert.equal(item.status,'expected');assert.equal(item.results.length,1);assert.equal(item.results[0].status,'passed');assert.equal(item.results[0].retry,0);}assert.deepEqual([report.stats.expected,report.stats.unexpected,report.stats.skipped,report.stats.flaky],[8,0,0,0]);
