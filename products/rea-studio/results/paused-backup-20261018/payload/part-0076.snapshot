    {
      "id": "grafana.candidate.1717bf9b41de0414c1ac",
      "syntaxRole": "list-item",
      "sourceText": "- **Counter max**: Set this to the maximum value your counter can reach before wrapping. For 64-bit counters, use `18446744073709551615`. For 32-bit counters, use `4294967295`.",
      "headingPath": [
        "OpenTSDB query editor",
        "Rate section",
        "Counter settings"
      ],
      "source": {
