    {
      "id": "grafana.candidate.34a07a216eccbc9e2a31",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Specify the number of decimals Grafana includes in the rendered value. If you leave this field empty, Grafana automatically truncates the number of decimals based on the value. For example 1.1234 displays as 1.12 and 100.456 displays as 100.",
