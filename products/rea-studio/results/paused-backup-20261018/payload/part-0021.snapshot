  assert.equal(repeatProducer.split(repeatStart).length, 2); assert.equal(repeatProducer.split(repeatEnd).length, 2);
  const repeatScript = new vm.Script(repeatProducer.slice(repeatProducer.indexOf(repeatStart), repeatProducer.indexOf(repeatEnd)) + '\\npublicationRepeatProjection', { filename: 'exact-reviewed-publication-repeat-clock-control.mjs' });
  const repeatProject = repeatScript.runInNewContext({ assert, Date, structuredClone }, { timeout: 1000 });
  const repeatPrefix = '${publicPrefix}failed-run/';
  function repeatInput(filename, expected) { const bytes = read(repeatPrefix + filename + '.snapshot'); same(bytes, expected); return bytes; }
