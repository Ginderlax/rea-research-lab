    {
      "id": "grafana.candidate.0dfe221aaf0e2a79ecb1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "All rows with the same value of Server ID are grouped together. Optionally, you can add a count of how may values fall in the selected group.",
      "headingPath": [
        "Transform data",
        "Transformation functions",
        "Group by"
      ],
      "source": {
