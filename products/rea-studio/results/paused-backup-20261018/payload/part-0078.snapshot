      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.56461068cee98bbe5ad7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The default Grafana database is SQLite, which stores its data in a single file on disk. To back up this file, copy it to your backup repository.",
