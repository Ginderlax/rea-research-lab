    },
    {
      "id": "grafana.candidate.a1cbfb39fb371540ed47",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For a complete list of supported integrations and more details about contact points, refer to [Configure contact points](ref:configure-contact-points).",
      "headingPath": [
        "Contact points"
      ],
      "source": {
        "path": "docs/sources/alerting/fundamentals/notifications/contact-points.md",
        "gitBlobSha": "ea2d5aa183da0a3bde6bf1e1aeb5a0b176617493",
