    {
      "id": "grafana.candidate.87d2c1604c40003474fc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This token caching behavior is a known issue that has received code fixes in recent Grafana releases. If you're experiencing this on an older Grafana version, upgrading may resolve it. Check the [Grafana changelog](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/whatsnew/) for relevant fixes.",
      "headingPath": [
        "Troubleshoot Prometheus data source issues",
        "Authentication errors",
        "OAuth token expiration errors (GCP and Azure)"
      ],
      "source": {
        "path": "docs/sources/datasources/prometheus/troubleshooting/index.md",
        "gitBlobSha": "8e50ee5b80f0d882f5c254bfa20a82f2a9d1c982",
        "sha256": "5d62682b47e6f29d1a4603953a8584079c2b939a9feca62c15b80a8307623e18",
