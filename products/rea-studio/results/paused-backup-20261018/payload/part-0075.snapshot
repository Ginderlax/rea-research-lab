    {
      "id": "grafana.candidate.208df68ec481e16d9d3f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The search input accepts a structured `key:value` syntax. The key on the left of the colon is the filter type, and the value on the right is what you want to match. Use quotation marks around values that contain spaces, for example `rule:\"High CPU usage\"`.",
