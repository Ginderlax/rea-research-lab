text=text.replace("import {once} from 'node:events';","import {once} from 'node:events';\nimport {start} from '../../server.mjs';\nimport {createStore} from '../../lib/storage.mjs';");const marker="test('app JSON persistence retains partial joins across HTTP host restart and cancellation prevents the joined effect'";assert.ok(text.includes(marker));text=text.slice(0,text.indexOf(marker));
text+=`const hostObservations=[];
async function sharedFixture(t){
 const folder=await fs.mkdtemp(path.join(os.tmpdir(),'rea-routing-production-')),hosts=[];
 async function open(){const instance=await start({port:0,dataDir:folder});let closed=false;const host={...instance,async api(action,input={}){const response=await fetch(instance.url+'/api/automation/'+action,{method:'POST',headers:{'content-type':'application/json','x-rea-token':instance.token},body:JSON.stringify(input)}),body=await response.json();if(!response.ok)throw new Error(body.error??'HTTP '+response.status);return body.result;},async close(){if(closed)return;closed=true;await instance.close();}};hosts.push(host);return host;}
 t.after(async()=>{await Promise.allSettled(hosts.map(host=>host.close()));const absolute=path.resolve(folder);assert.equal(path.dirname(absolute),path.resolve(os.tmpdir()));assert.ok(path.basename(absolute).startsWith('rea-routing-production-'));await fs.rm(absolute,{recursive:true,force:true});});
 return{folder,open,store:await createStore(path.join(folder,'automation','records'))};
}
test('app JSON persistence retains partial joins across shared HTTP host restart and cancellation prevents the joined effect',async t=>{
 const f=await sharedFixture(t);let requests=0;const endpoint=createServer((req,res)=>{requests++;res.writeHead(200,{'content-type':'application/json'});res.end('{"synthetic":true}');});endpoint.listen(0,'127.0.0.1');await once(endpoint,'listening');t.after(()=>new Promise(done=>{endpoint.closeAllConnections();endpoint.close(done);}));
 const document=branchWorkflow('append',.08);document.nodes.push(node('httpRequest','Effect',{url:'http://127.0.0.1:'+endpoint.address().port,options:{timeout:1000}}));document.connections.Merge={main:[[target('Effect')]]};document.connections.Effect={main:[[target('Finish')]]};
 let current=await f.open();const{record}=await current.api('native-save',{workflow:document}),{run}=await current.api('native-run',{id:record.id}),key='automation.native.run.'+run.id;assert.equal(run.status,'waiting');assert.equal((await f.store.get(key)).joins.Merge[0][0].json.left,1);assert.equal(Object.hasOwn(run,'joins'),false);assert.equal(Object.hasOwn(run,'waitingRoute'),false);assert.equal(requests,0);
 for(const name of ['native-client','native-example'])assert.equal((await fetch(current.url+'/apps/automation/'+name+'.mjs')).status,200);for(const name of ['native-server','routing','routing-original-harness'])assert.equal((await fetch(current.url+'/apps/automation/'+name+'.mjs')).status,404);
 await current.close();await new Promise(done=>setTimeout(done,95));current=await f.open();await current.api('native-list');let ended;for(let i=0;i<100;i++){ended=(await current.api('native-status',{id:record.id,runId:run.id})).run;if(ended.status==='completed')break;await new Promise(done=>setTimeout(done,5));}assert.equal(ended.status,'completed');assert.equal(ended.id,run.id);assert.equal(ended.trace.filter(step=>step.node==='Merge').length,1);assert.equal(requests,2);assert.deepEqual((await f.store.get(key)).joins,{});
 const another=await current.api('native-run',{id:record.id});assert.equal(another.run.status,'waiting');assert.equal((await current.api('native-cancel',{id:record.id,runId:another.run.id})).run.status,'cancelled');await current.close();current=await f.open();await current.api('native-list');await new Promise(done=>setTimeout(done,95));assert.equal((await current.api('native-status',{id:record.id,runId:another.run.id})).run.status,'cancelled');assert.equal((await current.api('native-history',{id:record.id})).runs.find(r=>r.id===another.run.id).status,'cancelled');assert.equal(requests,2);const history=await current.api('native-history',{id:record.id});assert.ok(history.runs.every(run=>!Object.hasOwn(run,'joins')&&!Object.hasOwn(run,'waitingRoute')));hostObservations.push({name:'shared-host-join-wait-restart-cancellation',sameRunId:true,mergeExecutions:ended.trace.filter(step=>step.node==='Merge').length,downstreamRequests:requests,completedAndCancelledHistory:true,publicBuffersOmitted:true,terminalBuffersCleared:true,staticRoutesBounded:true});
});
test('shared HTTP recovery rejects an injected unreachable preserved node before scheduling any downstream effect',async t=>{
 const f=await sharedFixture(t);let effects=0;const endpoint=createServer((req,res)=>{effects++;res.end('{}');});endpoint.listen(0,'127.0.0.1');await once(endpoint,'listening');t.after(()=>new Promise(done=>{endpoint.closeAllConnections();endpoint.close(done);}));
 const document=branchWorkflow();document.nodes.push({...node('httpRequest','Disconnected',{url:'http://127.0.0.1:'+endpoint.address().port,options:{timeout:1000}}),typeVersion:99});const state=persisted(document);state.status='waiting';state.waitUntil=new Date().toISOString();state.pending=[{node:'Disconnected',items:[item({})]}];await f.store.set('automation.native.jobs',[state.id]);await f.store.set('automation.native.run.'+state.id,JSON.parse(JSON.stringify(state)));const host=await f.open(),response=await fetch(host.url+'/api/automation/native-list',{method:'POST',headers:{'content-type':'application/json','x-rea-token':host.token},body:'{}'});assert.equal(response.status,400);assert.match((await response.json()).error,/persisted invocation/);await new Promise(done=>setTimeout(done,30));assert.equal(effects,0);assert.equal((await f.store.get('automation.native.run.'+state.id)).status,'waiting');hostObservations.push({name:'shared-host-unreachable-import-preflight',httpStatus:400,downstreamRequests:effects,persistedRecordUnchanged:true});
});
test.after(()=>console.log(JSON.stringify({automationRoutingHostObservations:{scope:'Actual shared host and disk store with own temporary folders and loopback endpoints; finite restart/preflight/cancel checks.',observations:hostObservations}})));
`;
await fs.writeFile(filename,text);console.log(JSON.stringify({adapted:'routing.test.mjs',sharedHost:'../../server.mjs',testGroups:(text.match(/test\('/g)||[]).length}));
import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';
const here=path.dirname(fileURLToPath(import.meta.url)),base=path.resolve(here,'../..'),app=path.join(base,'outputs/rea-research-lab/products/rea-studio/apps/automation');let text=await fs.readFile(path.join(base,'work/automation-routing-next/README.md'),'utf8');
text=text.replace('# Native n8n routing stage','# Native n8n routing compatibility');text=text.replace('This isolated stage adds Switch 3.4 and Merge 3.2 to the existing bounded native Manual Trigger / Set / If / HTTP Request / Wait runtime. It is prepared for review and integration; production Automation and the previous stages were not edited. The candidate runs original implementation code. Released n8n modules are used only by the authenticated test harness.','Automation implements Switch 3.4 and Merge 3.2 alongside its bounded native Manual Trigger / Set / If / HTTP Request / Wait runtime. The application executes its own source-assisted implementation. Released n8n modules execute only inside the authenticated test harness, and are never the application runtime. Full product parity remains false.');text=text.replace('[Original manifest](original-manifest.json) identifies the retained nodes-base archive and 202 exact files, including its license.','[Original manifest](routing-original-manifest.json) identifies 202 exact entries: 201 selected source/package/license files and the nodes-base archive retained locally. The public preservation stores source as non-executable snapshots and excludes that archive.');text=text.replace('[Source option inventory](source-option-inventory.json)','[Source option inventory](routing-source-option-inventory.json)');text=text.replace('[recorded separately](ui-observations.json)','[recorded separately](results/routing-source-study/stage/ui-observations.json)');text=text.replace('The staged editor','The native editor').replace('the staged connection controls','the connection controls');text=text.replace('The [validation receipt](validation.json) separates exact output comparisons, error-presence comparisons, dangerous-key rejections, array-representation rejections, helper/block executions and application tests. `node run-focused.mjs` preserves the exact tested sources, raw logs, original observations and pre/post fingerprints in a new run folder. It also repeats two frozen original-source probes without executing a node: that validator accepts a disconnected unsupported node in `pending`, and state creation chooses a disabled Manual Trigger if it appears before the enabled trigger used by preflight. Staging rejects the injected continuation before HTTP scheduling and selects the same enabled trigger for creation, validation and resume. The failing baseline/stage evidence remains preserved; the historical checkpoint has not silently changed.','The [production integration receipt](results/routing-validation.json) separates exact output comparisons, error-presence comparisons, dangerous-key rejections, array-representation rejections, helper/block executions and application tests. `node scripts/verify-automation-routing.mjs` from the Studio directory records exact tested sources, raw logs, original observations and pre/post fingerprints in a new results folder. Original differential tests themselves write detailed synthetic observations only under the ignored local oracle folder and emit a small hash/count marker. The focused verifier then preserves those outputs. The historical source validator accepted a disconnected unsupported node in `pending`, and state creation selected a disabled first Manual Trigger; exact failing sources/probes remain preserved. Current creation and continuation validation use the same preflighted enabled Manual graph. The actual shared-host recovery test rejects unreachable imported pending state before HTTP scheduling.');text=text.replace('The preserved prior suite is adapted only for import destinations and a minimal stage host; it does not revalidate shared host routing.','The production suite runs the existing 31 native regression groups unchanged, plus 13 routing groups and 12 released-original groups. The routing persistence tests use the actual shared host and disk store, re-open that host, retain one run ID, execute Merge once, and issue exactly two downstream fixture requests. A separately cancelled Wait remains cancelled after another restart; unreachable imported state rejects with zero downstream requests. Only synthetic owned temporary files and loopback HTTP endpoints are used.');text=text.replace('under `failures/` and `runs/`','under [the preservation record](results/routing-source-study/preservation-manifest.json)');text=text.replace('The browser evidence predates the final enabled-trigger selection correction','The preserved historical stage browser evidence predates the final enabled-trigger selection correction');text=text.replace('the final focused tests cover the corrected runtime, HTTP recovery, Wait/restart and the disabled-trigger regression.','the production focused tests cover the corrected runtime, shared HTTP recovery, Wait/restart and the disabled-trigger regression. A fresh production browser validation is separate parent-owned evidence.');await fs.writeFile(path.join(app,'ROUTING.md'),text);
let readme=await fs.readFile(path.join(app,'README.md'),'utf8');readme=readme.replace('Manual Trigger, Edit Fields (Set), If, HTTP Request and Wait','Manual Trigger, Edit Fields (Set), If, HTTP Request, Wait, Switch 3.4 and Merge 3.2');readme+='\n## Native Switch and Merge routing\n\nThe native JSON editor can add Switch 3.4 and Merge 3.2 nodes, choose explicit source output and target input ports, and remove an exact connection. Switch supports bounded rules and integer routing; Merge supports bounded append, position, field, Cartesian and wait-for-all branch selection. Join queues survive durable Wait/restart and remain private in public runs/history. Unsupported versions/options/expressions preflight before execution. See [ROUTING.md](ROUTING.md) for exact contracts, preserved original sources, deliberate safety/JSON representation deviations and remaining product gaps. The [focused integration receipt](results/routing-validation.json) records current source-bound application checks and independently executed released modules/helpers; these are distinct from the historical native-core receipt and from complete n8n deployment or scheduler parity.\n';await fs.writeFile(path.join(app,'README.md'),readme);
let comparison=await fs.readFile(path.join(app,'NATIVE-SOURCE-COMPARISON.md'),'utf8');comparison+='\n## Subsequent Switch/Merge integration\n\nThe earlier native-core evidence in this document remains historical. Current Automation additionally supports the bounded Switch 3.4 and Merge 3.2 slice described in [ROUTING.md](ROUTING.md), with all documented released version families and unsupported options enumerated in [routing-contracts.json](routing-contracts.json). The public [strict preservation manifest](results/routing-source-study/preservation-manifest.json) authenticates the pre-integration 25-file production baseline, 29 staged source fingerprints, every exact source/failure/log/receipt in 15 stage runs, 201 selected released package/source/license bytes and the stage browser evidence. The original vendor archive stays local; the runnable application imports no vendor node implementation.\n\nThe fresh [routing integration receipt](results/routing-validation.json) binds source hashes to actual application/shared-host tests and original comparisons. Switch invokes the authenticated released execute method and expression/filter/cleanup/schema helpers. Merge invokes complete released mode helpers with explicit static parameters and fallbacks, rather than its full class/router/default schema. Seven exact core enqueue-method calls and four extracted waiting-input-drain executions are separate helper observations, not whole released scheduler executions. There are 1,812 exact output comparisons, ten rejection-presence matches, three dangerous-property deviations and 48 non-index-array representation deviations; the latter 61 are not counted as exact matches. Error text/class equality and whole-product parity are not established.\n';await fs.writeFile(path.join(app,'NATIVE-SOURCE-COMPARISON.md'),comparison);
let contracts=JSON.parse(await fs.readFile(path.join(app,'routing-contracts.json'),'utf8'));contracts.status='Production integrated bounded slice; focused source-bound app/shared-host/original helper evidence in results/routing-validation.json. Full parity false.';contracts.sourceInventory='routing-source-option-inventory.json:118 static released parameter definitions; dynamic spreads/filter generated schemas excluded explicitly';contracts.ui='Native editor supports Switch/Merge creation, source-output/target-input selection and exact connection removal. Historical stage browser evidence is preserved separately; fresh production browser evidence is parent-owned.';await fs.writeFile(path.join(app,'routing-contracts.json'),JSON.stringify(contracts,null,2)+'\n');console.log('Current scoped documentation prepared.');
