import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {loadGeometryOracle} from './geometry-oracle.mjs';
import {createHash} from 'node:crypto';
import {validateScene,bounds,diamondPoints,hitShape,svg,importExcalidraw,exportExcalidraw,History,groupSelection,selectGroup} from './core.mjs';
import {nativeFixture} from './fixtures.mjs';
import {handle} from './server.mjs';
import {createStore} from '../../lib/storage.mjs';
const appRoot=fileURLToPath(new URL('./',import.meta.url)),observationRoot=path.resolve(process.env.REA_SKETCH_OBSERVATION_DIR||path.join(appRoot,'.local/observations')),scratchRoot=path.join(appRoot,'.local/test-fixtures');await fs.mkdir(scratchRoot,{recursive:true});const {oracle,directCalls,provenance}=await loadGeometryOracle(),plain=value=>JSON.parse(JSON.stringify(value)),comparisons=[];
const shape=(id,type,extra={})=>({id,type,x:40,y:60,w:100,h:80,stroke:'#263238',fill:type==='line'?'none':'#e0f2fe',strokeWidth:2,...extra}),scene=shapes=>({name:'Geometry subset',shapes,view:{x:25,y:25,zoom:1}});

test('signed line validation/bounds/hit/SVG preserve all endpoint directions',()=>{
 for(const [w,h]of [[100,60],[-100,60],[100,-60],[-100,-60],[0,-60],[-100,0],[0,0],[0.125,-0.125]]){const input=shape('line','line',{w,h}),safe=validateScene(scene([input])).shapes[0];assert.equal(safe.x,input.x);assert.equal(safe.y,input.y);assert.equal(safe.w,w);assert.equal(safe.h,h);assert.deepEqual(bounds(safe),{x:Math.min(input.x,input.x+w),y:Math.min(input.y,input.y+h),w:Math.abs(w),h:Math.abs(h)});assert.equal(hitShape(safe,input.x+w/2,input.y+h/2,0),true);assert.equal(hitShape(safe,input.x+1000,input.y+1000,6),false);const output=svg(scene([safe]));assert.match(output,new RegExp(`x2="${input.x+w}" y2="${input.y+h}"`));assert.doesNotMatch(output,/<path|<polygon/);const native=exportExcalidraw(scene([safe])).elements[0],size=plain(oracle.getSizeFromPoints(native.points)),restored=plain(oracle.restoreElement(native));assert.deepEqual(size,{width:Math.abs(w),height:Math.abs(h)});assert.equal(restored.type,'line');for(const key of ['x','y','width','height','points','startArrowhead','endArrowhead'])assert.deepEqual(restored[key],native[key]);comparisons.push({kind:'line-restoration',w,h,native,restored,exact:true});}
});
test('diamond vertices match the unchanged pinned helper for bounded normal dimensions',()=>{
 for(const [w,h]of [[1,1],[2,2],[3,5],[100,80],[101,79],[2.1,3.9],[99.75,44.5],[-100,-80]]){const input=shape('diamond','diamond',{w,h}),safe=validateScene(scene([input])).shapes[0],expected=plain(oracle.getDiamondPoints({width:safe.w,height:safe.h}));const pairs=[];for(let i=0;i<expected.length;i+=2)pairs.push([safe.x+expected[i],safe.y+expected[i+1]]);assert.deepEqual(diamondPoints(safe),pairs);assert.deepEqual(bounds(safe),{x:Math.min(input.x,input.x+w),y:Math.min(input.y,input.y+h),w:Math.abs(w),h:Math.abs(h)});const native=exportExcalidraw(scene([safe])).elements[0],restored=plain(oracle.restoreElement(native));for(const key of ['type','x','y','width','height'])assert.equal(restored[key],native[key]);comparisons.push({kind:'diamond-helper-restoration',w,h,pairs,exactForNormalDimensions:true});}
});
test('diamond hit tests reject box corners, include interior/edges and handle degeneracy',()=>{
 const d=shape('d','diamond',{x:0,y:0,w:100,h:60});assert.equal(hitShape(d,50,30,0),true);assert.equal(hitShape(d,0,0,0),false);assert.equal(hitShape(d,100,60,0),false);assert.equal(hitShape(d,51,0,0),true);assert.equal(hitShape(d,51,-1,1),true);assert.equal(hitShape(d,51,-2,1),false);assert.equal(hitShape(shape('d','diamond',{x:10,y:20,w:0,h:0}),10,20,0),true);assert.equal(hitShape(shape('d','diamond',{x:10,y:20,w:0,h:0}),11,20,0),false);const small=shape('d','diamond',{w:0.25,h:0.5});for(const [x,y]of diamondPoints(small)){assert.ok(x>=small.x&&x<=small.x+small.w);assert.ok(y>=small.y&&y<=small.y+small.h);}const output=svg(scene([d]));assert.match(output,/<polygon points="51,0 100,31 51,60 0,31"/);assert.doesNotMatch(output,/<path/);
});
test('native line/diamond no-change roundtrip preserves all unknown document/element fields',()=>{
 const native=nativeFixture(),geometry=exportExcalidraw(scene([shape('plain-line','line',{w:-100,h:-30}),shape('plain-diamond','diamond')]));geometry.elements[0].points=[[10,20],[-90,-10]];geometry.elements[0].x=30;geometry.elements[0].y=40;for(const element of geometry.elements){element.customData={unknown:['retain',42],html:'<script>inert</script>'};element.futureGeometryFlag={retain:true};element.groupIds=['geometry-group'];}native.elements.push(...geometry.elements);const imported=importExcalidraw(native);assert.equal(imported.shapes.length,7);assert.deepEqual(exportExcalidraw(imported),native);assert.deepEqual(exportExcalidraw(validateScene(plain(imported))),native);const line=imported.shapes.find(item=>item.id==='plain-line');assert.deepEqual({x:line.x,y:line.y,w:line.w,h:line.h},{x:40,y:60,w:-100,h:-30});line.x+=25;line.y-=5;const edited=exportExcalidraw(imported).elements.find(item=>item.id===line.id);assert.deepEqual(edited.points,[[0,0],[-100,-30]]);assert.equal(edited.x,65);assert.equal(edited.y,55);assert.equal(edited.width,100);assert.equal(edited.height,30);assert.deepEqual(edited.customData,native.elements.at(-2).customData);assert.deepEqual(edited.futureGeometryFlag,{retain:true});assert.equal(edited.version,2);assert.equal(plain(oracle.restoreElement(edited)).x,65);
});
test('negative imported diamond geometry edits canonicalize once and style-only edits preserve raw geometry',()=>{
 const document=exportExcalidraw(scene([shape('d','diamond')]));Object.assign(document.elements[0],{x:100,y:80,width:-100,height:-60,customData:{keep:true}});const imported=importExcalidraw(document),d=imported.shapes[0];assert.deepEqual({x:d.x,y:d.y,w:d.w,h:d.h},{x:0,y:20,w:100,h:60});assert.deepEqual(exportExcalidraw(imported),document);d.stroke='#ff0000';const styled=exportExcalidraw(imported).elements[0];assert.equal(styled.width,-100);assert.equal(styled.x,100);d.x+=10;d.y-=5;const edited=exportExcalidraw(imported).elements[0];assert.deepEqual({x:edited.x,y:edited.y,width:edited.width,height:edited.height},{x:10,y:15,width:100,height:60});assert.deepEqual(edited.customData,{keep:true});const restored=plain(oracle.restoreElement(edited));assert.equal(restored.x,10);assert.equal(restored.y,15);assert.equal(restored.width,100);
});
test('curved/bound/rotated/locked and oversized geometry stays opaque; line heads warn',()=>{
 const doc=exportExcalidraw(scene([shape('multi','line'),shape('bound-line','line'),shape('rotated-diamond','diamond'),shape('locked-diamond','diamond'),shape('huge','diamond'),shape('headed','line')]));doc.elements[0].points=[[0,0],[30,40],[100,80]];doc.elements[1].startBinding={elementId:'huge',focus:0,gap:1};doc.elements[2].angle=0.1;doc.elements[3].locked=true;doc.elements[4].width=2000000;doc.elements[5].endArrowhead='bar';const imported=importExcalidraw(doc);assert.deepEqual(imported.shapes.map(item=>item.id),['headed']);assert.deepEqual(exportExcalidraw(imported),doc);assert.ok(imported.importWarnings.some(message=>message.includes('line arrowheads')));assert.equal(imported.importWarnings.filter(message=>message.includes('without editable rendering')).length,5);
});
test('line and diamond group/history plus original local serializer preserve native geometry',()=>{
 const native=exportExcalidraw(scene([shape('l','line',{w:-20,h:30}),shape('d','diamond'),shape('ink','freedraw',{points:[[0,0],[10,20]]})])),imported=importExcalidraw(native),history=new History();history.checkpoint(imported);groupSelection(imported,['l','d'],'shared-group');assert.deepEqual(selectGroup(imported.shapes,'l'),['l','d']);imported.shapes.find(item=>item.id==='l').x+=10;const changed=exportExcalidraw(imported),serialized=JSON.parse(oracle.serializeAsJSON(changed.elements,changed.appState,changed.files,'local'));assert.deepEqual(exportExcalidraw(importExcalidraw(serialized)),serialized);assert.deepEqual(exportExcalidraw(history.undo(imported)),native);comparisons.push({kind:'original-local-serialization',elementTypes:serialized.elements.map(item=>item.type),preservingRoundtrip:true});
});
test('real disk save/reopen keeps line/diamond native values and SVG projection',async()=>{
 const folder=await fs.mkdtemp(path.join(scratchRoot,'fixture-persistence-')),store=await createStore(path.join(folder,'records')),native=exportExcalidraw(scene([shape('l','line',{w:-100,h:30}),shape('d','diamond')]));native.extraNativeField={retained:true};const imported=await handle({action:'importExcalidraw',input:{document:native},store}),saved=await handle({action:'save',input:{scene:imported.scene},store}),reopened=await createStore(path.join(folder,'records'));assert.deepEqual((await handle({action:'exportExcalidraw',input:{id:saved.scene.id},store:reopened})).document,native);const output=(await handle({action:'svg',input:{id:saved.scene.id},store:reopened})).svg;assert.match(output,/<polygon/);assert.match(output,/<line/);
});
test.after(async()=>{assert.deepEqual(directCalls,{getDiamondPoints:8,getSizeFromPoints:8,getNormalizedDimensions:0,restoreElement:18,serializeAsJSON:1});await fs.mkdir(observationRoot,{recursive:true});await fs.writeFile(path.join(observationRoot,`geometry-observations-${process.pid}.json`),JSON.stringify({schema:'rea-sketch-geometry-original-subset/v2',checkedAtUtc:new Date().toISOString(),original:provenance.original,unchangedHelpers:provenance.unchangedTestOnlyHelpers,comparisons,directCalls,directCallTotal:Object.values(directCalls).reduce((a,b)=>a+b,0),limits:'Finite fully specified original helper fixtures; zero mocked helper bodies and no full original renderer/UI/binding repair. Tiny diamond clamp is intentionally different.'},null,2)+'\n');console.log('SKETCH_GEOMETRY_OBSERVATIONS '+JSON.stringify({comparativeContexts:comparisons.length,directCalls,totalDirectCalls:Object.values(directCalls).reduce((a,b)=>a+b,0)}));});
