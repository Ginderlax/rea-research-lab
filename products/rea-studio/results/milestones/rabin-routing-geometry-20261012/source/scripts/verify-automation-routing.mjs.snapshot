import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import {spawnSync} from 'node:child_process';
import assert from 'node:assert/strict';

const studio=path.dirname(path.dirname(fileURLToPath(import.meta.url))),lab=path.resolve(studio,'../..'),app=path.join(studio,'apps/automation'),results=path.join(app,'results'),hash=bytes=>createHash('sha256').update(bytes).digest('hex');
const preservationPath=path.join(results,'routing-source-study/preservation-manifest.json'),preservationBytes=await fs.readFile(preservationPath),preservation=JSON.parse(preservationBytes),prefix='apps/automation/results/routing-source-study/';
assert.equal(preservation.schema,'rea-automation-routing-preservation/v1');assert.equal(preservation.baselineFiles,25);assert.equal(preservation.stageFingerprints,29);assert.equal(preservation.historicalRunFolders,15);assert.equal(preservation.selectedOriginalPublicFiles,201);
async function verifyPreservation(){assert.equal(hash(await fs.readFile(preservationPath)),hash(preservationBytes));for(const row of preservation.entries){assert.ok(row.snapshot.startsWith(prefix)&&!row.snapshot.includes('..')&&!row.snapshot.includes('\\'));const bytes=await fs.readFile(path.join(studio,row.snapshot));assert.equal(bytes.length,row.bytes);assert.equal(hash(bytes),row.sha256,row.snapshot);}}
await verifyPreservation();
const sourceNames=(await fs.readdir(app)).filter(name=>/\.(?:mjs|json|md|txt)$/.test(name)).map(name=>'apps/automation/'+name).concat(['server.mjs','catalog.mjs','lib/storage.mjs','scripts/verify-automation-routing.mjs']).sort();
async function fingerprint(){return Promise.all(sourceNames.map(async name=>{const bytes=await fs.readFile(path.join(studio,name));return{path:name,bytes:bytes.length,sha256:hash(bytes)};}));}
const before=await fingerprint(),runName=new Date().toISOString().replaceAll(':','-'),run=path.join(results,'routing-runs',runName);await fs.mkdir(path.join(run,'source'),{recursive:true});
for(const row of before){const target=path.join(run,'source',row.path+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,await fs.readFile(path.join(studio,row.path)),{flag:'wx'});}
await fs.writeFile(path.join(run,'source-before.json'),JSON.stringify(before,null,2)+'\n',{flag:'wx'});
function command(label,args){const value=spawnSync(process.execPath,args,{cwd:studio,encoding:'utf8',timeout:60000,maxBuffer:8*1024*1024,windowsHide:true});return{label,exitCode:value.status,error:value.error?.message??null,stdout:value.stdout??'',stderr:value.stderr??''};}
const commands=[];commands.push(command('native-original-regressions',['--test','--test-concurrency=1','--test-reporter=tap','apps/automation/routing.test.mjs','apps/automation/routing-original.test.mjs','apps/automation/native.test.mjs','apps/automation/native-http.test.mjs','apps/automation/native-server.test.mjs']));commands.push(command('prior-editor-regressions',['--test','--test-reporter=tap','apps/automation/native-client.test.mjs']));
for(const name of ['native.mjs','routing.mjs','native-server.mjs','native-client.mjs','native-example.mjs','routing-original-harness.mjs'])commands.push(command('syntax-'+name,['--check','apps/automation/'+name]));
for(const row of commands){await fs.writeFile(path.join(run,row.label+'.stdout.txt'),row.stdout,{flag:'wx'});await fs.writeFile(path.join(run,row.label+'.stderr.txt'),row.stderr,{flag:'wx'});}
const after=await fingerprint(),sourceStable=JSON.stringify(before)===JSON.stringify(after);await fs.writeFile(path.join(run,'source-after.json'),JSON.stringify(after,null,2)+'\n',{flag:'wx'});await verifyPreservation();
const summaries=commands.map(row=>({label:row.label,exitCode:row.exitCode,error:row.error,tests:Number(row.stdout.match(/^# tests (\d+)$/m)?.[1]??0),pass:Number(row.stdout.match(/^# pass (\d+)$/m)?.[1]??0),fail:Number(row.stdout.match(/^# fail (\d+)$/m)?.[1]??0),cancelled:Number(row.stdout.match(/^# cancelled (\d+)$/m)?.[1]??0),skipped:Number(row.stdout.match(/^# skipped (\d+)$/m)?.[1]??0),todo:Number(row.stdout.match(/^# todo (\d+)$/m)?.[1]??0),stdoutSha256:hash(row.stdout),stderrSha256:hash(row.stderr)}));
const initial={createdAt:new Date().toISOString(),sourceStable,before,after,commands:summaries,preservationManifestSha256:hash(preservationBytes)};await fs.writeFile(path.join(run,'run.json'),JSON.stringify(initial,null,2)+'\n',{flag:'wx'});assert.ok(sourceStable,'Source changed during focused run');for(const row of summaries){assert.equal(row.exitCode,0,row.label);assert.equal(row.fail+row.cancelled+row.skipped+row.todo,0,row.label);}assert.equal(summaries[0].tests,56);assert.equal(summaries[0].pass,56);assert.equal(summaries[1].tests,3);assert.equal(summaries[1].pass,3);
// Decode the actual Node TAP layer once after joining bounded contiguous chunks.
function marker(stdout,label){const lines=stdout.split(/\r?\n/),start=lines.findIndex(line=>line.startsWith('# {"'+label+'":'));assert.ok(start>=0,'Missing marker '+label);let encoded='';for(let n=start;n<lines.length&&n<start+4096;n++){if(!lines[n].startsWith('# ')||lines[n].startsWith('# Subtest:'))break;encoded+=lines[n].slice(2);assert.ok(encoded.length<=1024*1024);let decoded='';try{for(let index=0;index<encoded.length;index++){if(encoded[index]!=='\\'){decoded+=encoded[index];continue;}const next=encoded[++index];assert.ok(next==='\\'||next==='#');decoded+=next;}const value=JSON.parse(decoded);assert.ok(Object.hasOwn(value,label));return value[label];}catch{}}throw new Error('Incomplete marker '+label);}
const original=marker(commands[0].stdout,'automationRoutingOriginalObservations'),host=marker(commands[0].stdout,'automationRoutingHostObservations'),ownOriginalRoot=path.join(lab,'.local/automation-routing-original/observations'),relative=path.relative(ownOriginalRoot,path.resolve(original.path));assert.ok(relative&&!path.isAbsolute(relative)&&relative!=='..'&&!relative.startsWith('..'+path.sep));assert.match(relative,/^run-[^\\/]+[\\/]original-results\.json$/);const detailed=await fs.readFile(original.path);assert.equal(detailed.length,original.bytes);assert.equal(hash(detailed),original.sha256);const parsed=JSON.parse(detailed);assert.deepEqual(parsed.observations,original.observations);assert.deepEqual(parsed.counts,original.counts);assert.deepEqual(original.counts,{exactOutputMatches:1812,rejectionOutcomeMatches:10,deliberateSafetyDeviations:3,boundedRepresentationDeviations:48});assert.equal(original.observations.switchNodeExecutions,114);assert.equal(original.observations.mergeModeExecutions,1759);assert.equal(original.observations.coreEnqueueHelperExecutions,7);assert.equal(original.observations.corePartialDrainExecutions,4);await fs.writeFile(path.join(run,'original-results.json'),detailed,{flag:'wx'});assert.equal(host.observations.length,2);assert.equal(host.observations[0].downstreamRequests,2);assert.equal(host.observations[1].downstreamRequests,0);
const stageReceipt=JSON.parse(await fs.readFile(path.join(results,'routing-source-study/stage/validation.json'))),priorAccounting=[...commands[0].stdout.matchAll(/^# Original comparison accounting: (.+)$/gm)].map(match=>JSON.parse(match[1])),receipt={schema:'rea-automation-routing-integration-validation/v1',completedAtUtc:new Date().toISOString(),runtime:process.version,platform:process.platform,sourceStable,summary:{nativeAndOriginal:56,passed:56,failed:0,skipped:0,priorEditorRegressions:3},commands:summaries,implementationFingerprints:after,preservationManifest:{path:'apps/automation/results/routing-source-study/preservation-manifest.json',sha256:hash(preservationBytes),entries:preservation.entries.length,stageReceiptSha256:preservation.stageReceiptSha256,baselineFiles:25,stageFingerprints:29,historicalRunFolders:15,originalSelectedPublicFiles:201,archiveLocalOnly:true},original:{...original,publicObservation:path.relative(studio,path.join(run,'original-results.json')).replaceAll('\\','/'),binding:'n8n/n8n-workflow/n8n-core/n8n-nodes-base 2.16.0',sourceCommit:stageReceipt.sourceCommit,archives:stageReceipt.original.archives,sharedDependencyFiles:4350,ownManifestEntries:202,authenticatedBeforeAndAfter:true,nodeAndModeExecutions:1873,countsAreSeparateFromTestGroups:true,errorEquality:'Presence only; class/text/code equality not claimed',serializedObservationLimit:'JSON raw observations normalize undefined and signed zero; exact output assertions execute in memory with retained source.',fullReleasedSchedulerExecutions:0,fullReleasedServerExecutions:0},priorRegressionComparisonAccounting:priorAccounting,sharedHostEvidence:host,historicalBrowserEvidence:{observation:'apps/automation/results/routing-source-study/stage/ui-observations.json',sourceBinding:stageReceipt.browserEvidence.sourceBinding,uiModulesMatchCurrent:true,freshProductionBrowser:false,scope:stageReceipt.browserEvidence.scope},findingsAndCorrections:stageReceipt.findingsAndCorrections,deliberateDeviations:stageReceipt.intentionalDeviations,remainingGaps:stageReceipt.remainingGaps,runPath:path.relative(studio,run).replaceAll('\\','/'),limits:'Existing bounded manual acyclic core plus Switch 3.4/Merge 3.2 only. Unknown documents preserved; reachable unsupported versions/options, ambiguous fan-in and malformed resume queues reject. No credentials/providers, general expressions, SQL, binary items, full scheduler/server/editor/product parity or production security/performance superiority.',fullParity:false,securityCertified:false,performanceSuperiority:false};
await fs.writeFile(path.join(run,'validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});await fs.writeFile(path.join(results,'routing-validation.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({sourceStable,tests:56,editorTests:3,original:original.observations,counts:original.counts,receipt:'apps/automation/results/routing-validation.json',sha256:hash(JSON.stringify(receipt,null,2)+'\n')}));
