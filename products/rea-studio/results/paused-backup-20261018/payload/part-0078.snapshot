    },
    {
      "id": "grafana.candidate.b33f0257e4d16831a9e7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can configure query frequency and data collection limits in the panel's data source options. Grafana supports up to 26 queries per panel.",
      "headingPath": [
        "Query and transform data",
        "About queries"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/_index.md",
