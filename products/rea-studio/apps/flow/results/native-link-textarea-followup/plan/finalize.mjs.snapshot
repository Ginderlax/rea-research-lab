save('README.md','Source-only Flow publication/install proposal. Complete six frozen epochs map830 payload/manifest/freeze aliases at the public prefix in public-source-map.json. Nineteen app-only paths:five replacements/fourteen additions. Runtime is exact corrected197; two default-cache/child-forwarding substitutions and two seed-path substitutions are inverse-verified, assertions unchanged. Five documentation overlays preserve source/license notices and finite stage/model/real-browser distinctions. Root must independently review/install and execute current-layout proofs. No shared host, registry, root script or production/public writes. All failures, original source/licenses and historical root/browser/model epochs remain exact. Two compressed official carriers remain local-only. Full ignored dependency/generated trees are not claimed inventoried. No originals/tests/hosts/browser/benchmark executions by this planner. See evidence-scopes.json for separate57/75/24/7/8negative/12corrected counts and remaining real-browser gaps.\n');
function files(p=''){const out=[];for(const d of fs.readdirSync(path.join(own,p),{withFileTypes:true})){assert(!d.isSymbolicLink());const n=p?p+'/'+d.name:d.name;if(d.isDirectory())out.push(...files(n));else if(n!=='manifest.json')out.push(n);}return out;}const inventory=files().sort().map(p=>{const b=fs.readFileSync(path.join(own,p));assert(b.length<=32*1024*1024);assert(!(b[0]===77&&b[1]===90));assert(!(b[0]===80&&b[1]===75));assert(!(b[0]===31&&b[1]===139));new TextDecoder('utf8',{fatal:true}).decode(b);return{path:p,...id(b)};});const freeze=Buffer.from(JSON.stringify({schema:'rea-flow-static-link-textarea-publication-plan-strict-freeze/v1',at:new Date().toISOString(),strict:true,inventory,files:inventory.length,productionWrites:0,sourceOnly:true,selectedIncomingPublicAliases:830,proposedLivePaths:19,independentAcceptancePending:true},null,2)+'\n');save('manifest.json',freeze);console.log(JSON.stringify({files:inventory.length,manifest:id(freeze),validation:id(fs.readFileSync(path.join(own,'validation.json'))),map:id(fs.readFileSync(path.join(own,'public-source-map.json'))),proposals:id(fs.readFileSync(path.join(own,'installation-proposals.json'))),rows:830,live:19,sourceOnly:true}));
