import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
const root=path.dirname(fileURLToPath(import.meta.url)),hash=b=>createHash('sha256').update(b).digest('hex'),runs=(await fs.readdir(path.join(root,'runs'))).sort(),latest=runs.at(-1),validationPath=`runs/${latest}/validation.json`,validationBytes=await fs.readFile(path.join(root,validationPath)),validation=JSON.parse(validationBytes);
if(validation.exitCode!==0||!validation.sourceStable||!validation.productionStable||validation.counts.fail!==0)throw new Error('Latest run did not pass/stay stable');
for(const row of validation.sourceFingerprints)if(hash(await fs.readFile(path.join(root,row.path)))!==row.sha256)throw new Error(`Later source bytes ${row.path}`);
const baseline=JSON.parse(await fs.readFile(path.join(root,'production-baseline.json')));for(const row of baseline.files)if(hash(await fs.readFile(path.join(baseline.repository,row.path)))!==row.sha256)throw new Error(`Production changed ${row.path}`);
const original=JSON.parse(await fs.readFile(path.join(root,`runs/${latest}/original-observations.json`))).packAggregationOriginalObservations;
const commands=original.flatMap(c=>c.commands),files=validation.sourceFingerprints.filter(row=>/restic(?:-data-pack|-pack-snapshot|-compression-review)?(?:\.test)?\.mjs$/.test(row.path));
const receipt={schema:'rea-restic-pack-aggregation-stage-validation/v1',frozenAt:new Date().toISOString(),stageOnly:true,productionIntegrated:false,run:{path:validationPath,sha256:hash(validationBytes),...validation.counts,sourceStable:validation.sourceStable,productionStable:validation.productionStable},sourceFingerprints:validation.sourceFingerprints,candidateFiles:files,productionBaseline:{path:'production-baseline.json',sha256:hash(await fs.readFile(path.join(root,'production-baseline.json'))),files:baseline.files.length,exactBytesUnchanged:true},original:{version:'restic 0.19.1',commit:'6aa3a516ce654808a1f28f9fa21e9b7c8e6e90bf',provenance:'source-provenance.json',newPositiveExchangeCases:7,nativeWriterProfiles:6,originalCreatedMultiBlobCases:1,newAuthenticatedExecutions:commands.length,nonzero:commands.filter(c=>c.exitCode!==0).length,fixtureIdentityRecords:original.reduce((n,c)=>n+c.fixtureFiles.length,0),scope:'Finite owned original check/read/restore + native inspect/check/restore/append. Existing compression/Rabin oracle records remain separate in raw output.'},failures:{setupRun:'runs/2026-10-12T21-14-55.185Z',setupCounts:{pass:58,fail:1},missingLegacyFixtureCorrected:true,actualRecordBudgetReproduction:'failures/record-bound-initial.stdout.txt',recordBudgetSource:'failures/record-bound-runtime-before.mjs.snapshot',behavior:'Unique blob-map count allowed a snapshot beyond loaded index-record budget; reopening rejected. New admission tracks actual index rows plus pending unique data rows.'},limits:{fileBytes:64*1024*1024,metadataDocumentBytes:16*1024*1024,dataPackTargetBytes:16*1024*1024,dataPackRecords:4096,snapshotBytes:512*1024*1024,readPackBytes:96*1024*1024,indexRows:100000,indexedPacks:4096,cooperativeMilliseconds:120000},sourceAssisted:true,originalRuntimeWrapper:false,licensing:'Exact BSD-2-Clause source notice and original files retained.',fullFeatureParity:false,securityParity:false,performanceParity:false,gaps:['Sequential in-memory data batching; original concurrent selection, streaming/merging/randomization differ.','Tree packs remain one tree per pack.','No remote backend, native prune/repair/retention, full metadata/CLI behavior.','Cooperative guards cannot preempt synchronous work or blocked I/O; native HTTP cancellation remains absent.','Aborted captures may leave completed immutable unreferenced packs; warnings expose failed owned temp/lock cleanup.','Peak copies/cache/KDF exceed the pack output target; no process memory isolation or timings.']};
await fs.writeFile(path.join(root,'stage-validation.json'),JSON.stringify(receipt,null,2)+'\n');
const entries=[];async function walk(relative=''){for(const item of await fs.readdir(path.join(root,relative),{withFileTypes:true})){const name=relative?`${relative}/${item.name}`:item.name;if(['.local','projects'].includes(name.split('/')[0])||name==='freeze-manifest.json')continue;if(item.isDirectory())await walk(name);else if(item.isFile()){const bytes=await fs.readFile(path.join(root,name));entries.push({path:name,bytes:bytes.length,sha256:hash(bytes)});}else throw new Error('Non-regular preservation entry '+name);}}await walk();entries.sort((a,b)=>a.path.localeCompare(b.path));
await fs.writeFile(path.join(root,'freeze-manifest.json'),JSON.stringify({schema:'rea-restic-pack-aggregation-preservation/v1',entries,excluded:['projects/ (local original release oracle binary copies)','freeze-manifest.json (self-reference)'],sourceStable:true,productionStable:true},null,2)+'\n');
console.log(JSON.stringify({receiptSha256:hash(await fs.readFile(path.join(root,'stage-validation.json'))),manifestSha256:hash(await fs.readFile(path.join(root,'freeze-manifest.json'))),artifacts:entries.length,counts:validation.counts,candidateFiles:files,originalExecutions:commands.length}));
