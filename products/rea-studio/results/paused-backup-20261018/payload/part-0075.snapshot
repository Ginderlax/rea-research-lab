    {
      "id": "grafana.candidate.b3f045934d699ec0c2e5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To check the configured webhooks, go to **Administration > General > Provisioning** and click the **View** link for your GitHub repository.",
      "headingPath": [
