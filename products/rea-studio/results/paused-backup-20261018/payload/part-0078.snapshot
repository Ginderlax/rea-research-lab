    {
      "id": "grafana.candidate.6ce4d82fae9a0ba6e665",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The panel inspect view, which you can open via the panel menu, helps you understand and troubleshoot your panels. You can inspect the raw data for any Grafana panel, export that data to a comma-separated values (CSV) file, view query requests, and export panel and data JSON.",
      "headingPath": [
        "The panel inspect view"
      ],
      "source": {
