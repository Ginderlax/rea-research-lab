    {
      "id": "grafana.candidate.c787d4c92b757a9c2f1e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you receive an error like `input data must be a wide series but got ...` when trying to alert on a query, make sure that your query returns valid numeric data that can be output to a Time series panel.",
      "headingPath": [
