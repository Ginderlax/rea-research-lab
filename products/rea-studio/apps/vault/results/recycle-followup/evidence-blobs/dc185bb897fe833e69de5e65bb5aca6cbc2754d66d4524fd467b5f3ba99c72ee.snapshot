import fs from 'node:fs/promises';
import os from 'node:os';
import path from 'node:path';
import assert from 'node:assert/strict';
const {start}=await import(new URL('../keepass-recycle-next/products/rea-studio/server.mjs',import.meta.url)),dir=await fs.mkdtemp(path.join(os.tmpdir(),'rea-recycle-browser-review-')),host=await start({port:0,dataDir:dir});
const call=async(action,input={})=>{const response=await fetch(host.url+'/api/vault/'+action,{method:'POST',headers:{'content-type':'application/json','x-rea-token':host.token},body:JSON.stringify(input)});const body=await response.json();assert.equal(response.status,200,body.error);return body.result;};
const master='owned browser review master';await call('create',{password:master});const A=(await call('save',{title:'Review A',group:'Previous',password:'synthetic-A-original',notes:'owned initial notes'})).id,B=(await call('save',{title:'Review B',group:'Other',password:'synthetic-B-only',notes:'owned B notes'})).id;await call('save',{id:A,title:'Review A',group:'Previous',password:'synthetic-A-current',notes:'owned newer notes'});
await fs.writeFile(new URL('browser-host.json',import.meta.url),JSON.stringify({startedAt:new Date().toISOString(),url:host.url,port:new URL(host.url).port,dataDir:dir,pid:process.pid,fixtureIds:{A,B},fixtureMaster:master,sourceStage:'work/keepass-recycle-next',ownedSyntheticOnly:true},null,2)+'\n',{flag:'wx'});console.log('READY '+host.url);let closed=false;async function close(){if(closed)return;closed=true;await host.close();assert.equal(path.dirname(dir),path.resolve(os.tmpdir()));assert.ok(path.basename(dir).startsWith('rea-recycle-browser-review-'));await fs.rm(dir,{recursive:true,force:true});console.log('CLOSED owned fixture removed');process.exit(0);}process.stdin.setEncoding('utf8');process.stdin.on('data',text=>{if(text.includes('close'))close();});for(const signal of ['SIGINT','SIGTERM'])process.on(signal,close);
