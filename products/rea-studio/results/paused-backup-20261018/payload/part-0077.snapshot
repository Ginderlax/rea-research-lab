    {
      "id": "grafana.candidate.1325ee9c0dc20fda1eac",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Redirect to correct domain if the host header does not match the domain. Prevents DNS rebinding attacks. Default is `false`.",
