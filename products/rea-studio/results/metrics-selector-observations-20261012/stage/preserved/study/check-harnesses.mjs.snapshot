import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {spawnSync} from 'node:child_process';import {here,sha} from './authenticate-original.mjs';
const names=['check-harnesses.mjs','harness.test.mjs','memory-runner.mjs','memory-worker.mjs','timing-runner.mjs','timing-worker.mjs','benchmark.mjs','canonical.mjs','workloads.mjs','authenticate-original.mjs','watch-owned-process.ps1','parse-observer.ps1','memory-preflight.control.json','candidate-module-control.mjs','selector-control.mjs','candidate-baseline.mjs'],before={},steps=[];for(const name of names)before[name]=sha(await fs.readFile(path.join(here,name)));
const tasks=[{name:'harness-tests',args:['--test',path.join(here,'harness.test.mjs')]},{name:'memory-correctness-only',args:[path.join(here,'memory-runner.mjs'),'--check-only','unused','control']},{name:'timing-correctness-only',args:[path.join(here,'timing-runner.mjs'),'--check-only','unused']}];
for(const task of tasks){const start=new Date().toISOString(),child=spawnSync(process.execPath,task.args,{encoding:'utf8',timeout:60000,maxBuffer:4*1024*1024,windowsHide:true}),stdout=child.stdout??'',stderr=child.stderr??'',stem='harness-'+task.name+'-'+Date.now();await fs.writeFile(path.join(here,'results',stem+'.stdout.txt'),stdout,{flag:'wx'});await fs.writeFile(path.join(here,'results',stem+'.stderr.txt'),stderr,{flag:'wx'});steps.push({name:task.name,start,end:new Date().toISOString(),exitCode:child.status,error:child.error?.message,stdout:{path:'results/'+stem+'.stdout.txt',sha256:sha(stdout)},stderr:{path:'results/'+stem+'.stderr.txt',sha256:sha(stderr)}});if(child.status!==0)break;}
const after={};for(const name of names)after[name]=sha(await fs.readFile(path.join(here,name)));assert.deepEqual(after,before);const receipt={schemaVersion:1,checkedAt:new Date().toISOString(),status:steps.length===tasks.length&&steps.every(row=>row.exitCode===0)?'passed':'failed',steps,sourceHashesBefore:before,sourceHashesAfter:after,timingMeasurementRun:false,memoryMeasurementRun:false,measurementBranchExecutionTested:false,scope:'Authorization/canonical/module-graph guards, observer syntax and single fresh+cached-read correctness per fixed input. No measured warmup/transient/retained loops, memory snapshots or observer execution.'};await fs.writeFile(path.join(here,'results/harness-readiness.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:receipt.status,steps:steps.length,measurementRun:false}));if(receipt.status!=='passed')process.exitCode=1;
