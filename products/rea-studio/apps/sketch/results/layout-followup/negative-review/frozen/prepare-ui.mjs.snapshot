import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,source=await fs.readFile(path.resolve(here,'../sketch-alignment-next/layout-ui-fixture.mjs')),sha=b=>createHash('sha256').update(b).digest('hex');const text=source.toString(),adapted=text.replace("from './products/rea-studio/apps/sketch/client.mjs'","from '../sketch-alignment-next/products/rea-studio/apps/sketch/client.mjs'").replace("from './products/rea-studio/apps/sketch/server.mjs'","from '../sketch-alignment-next/products/rea-studio/apps/sketch/server.mjs'");assert.notEqual(text,adapted);assert.equal(adapted.split('\n').slice(2).join('\n'),text.split('\n').slice(2).join('\n'));await fs.writeFile(path.join(here,'ui-fixture.mjs'),adapted,{flag:'wx'});await fs.writeFile(path.join(here,'prepared-versions/author-ui-fixture.mjs.snapshot'),source,{flag:'wx'});await fs.writeFile(path.join(here,'ui-adapter.json'),JSON.stringify({source:'work/sketch-alignment-next/layout-ui-fixture.mjs',sourceSHA256:sha(source),adaptedSHA256:sha(adapted),changes:'Only two candidate runtime import paths; all DOM-model and in-memory real server/store behavior retained. Fresh test bodies independently authored.',actualBrowser:false,realServerHandle:true,persistence:'Owned in-memory store; no HTTP or disk host.'},null,2)+'\n',{flag:'wx'});
