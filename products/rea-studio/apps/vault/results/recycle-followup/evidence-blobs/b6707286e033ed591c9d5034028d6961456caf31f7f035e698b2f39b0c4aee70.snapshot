import test,{after}from'node:test';import assert from'node:assert/strict';import fs from'node:fs/promises';import path from'node:path';import{randomBytes}from'node:crypto';
import{original,temp,password,observations}from'./recycle-harness.mjs';import{importKdbx,exportKdbx,materializeKdbxDocument,decodeKdbxDate}from'./kdbx.mjs';import{recycleView,deleteRecycleEntry,restoreRecycleEntry}from'./recycle.mjs';import{nodes,one,text}from'./xml.mjs';
const entryId='11111111-2222-3333-4444-555555555555',clock='2025-01-02T03:04:05Z';
const id=value=>{const h=Buffer.from(value,'base64').toString('hex');return h.slice(0,8)+'-'+h.slice(8,12)+'-'+h.slice(12,16)+'-'+h.slice(16,20)+'-'+h.slice(20)},zero='00000000-0000-0000-0000-000000000000';
// Released XML writes inherited Nullable<bool> group settings as empty text.
const inherited=value=>['','null'].includes(value)?null:value==='True';
function native(data){const xml=materializeKdbxDocument(data),meta=one(xml,'Meta'),root=one(xml,'Root'),groups=[],entries=[];function visit(group,parent){const groupId=id(text(one(group,'UUID'))),times=one(group,'Times');groups.push({id:groupId,parent,name:text(one(group,'Name')),auto:inherited(text(one(group,'EnableAutoType'))),search:inherited(text(one(group,'EnableSearching'))),icon:Number(text(one(group,'IconID'))),expanded:text(one(group,'IsExpanded'))==='True',access:decodeKdbxDate(text(one(times,'LastAccessTime'))),usage:text(one(times,'UsageCount'))||'0'});for(const e of nodes(group,'Entry')){const t=one(e,'Times'),fields={};for(const s of nodes(e,'String')){const value=one(s,'Value');fields[text(one(s,'Key'))]={value:text(value),protected:value.attrs.Protected==='True'};}entries.push({id:id(text(one(e,'UUID'))),parent:groupId,previous:one(e,'PreviousParentGroup')?id(text(one(e,'PreviousParentGroup'))):zero,modified:decodeKdbxDate(text(one(t,'LastModificationTime'))),access:decodeKdbxDate(text(one(t,'LastAccessTime'))),location:decodeKdbxDate(text(one(t,'LocationChanged'))),usage:text(one(t,'UsageCount'))||'0',history:nodes(one(e,'History'),'Entry').length,fields});}for(const g of nodes(group,'Group'))visit(g,groupId);}visit(one(root,'Group'),null);return{enabled:text(one(meta,'RecycleBinEnabled'))==='True',binUuid:id(text(one(meta,'RecycleBinUUID'))),groups,entries,deleted:nodes(one(root,'DeletedObjects'),'DeletedObject').map(d=>({id:id(text(one(d,'UUID'))),time:decodeKdbxDate(text(one(d,'DeletionTime')))}))};}
function compare(data,value){const actual=native(data);for(const key of['enabled','binUuid','groups','entries','deleted'])assert.deepEqual(actual[key],value[key],key);}
async function originalOp(dir,file,operation){return original(dir,{mode:'read',database:file,operations:[{id:entryId,now:clock,...operation}]});}
async function originalReadsNative(dir,data,expected){const file=path.join(dir,'candidate-final.kdbx');await fs.writeFile(file,await exportKdbx(data,{password},{kdf:'aes',rounds:100}));const value=await original(dir,{mode:'read',database:file});compare(data,value);assert.deepEqual(value.entries,expected.entries);assert.deepEqual(value.deleted,expected.deleted);}
after(async()=>{const out=path.resolve(import.meta.dirname,'../../../..','.local/original-comparisons.json');await fs.writeFile(out,JSON.stringify({observations,assemblyLoads:observations.filter(e=>e.value).length,actualOriginalCalls:observations.filter(e=>e.value).map(e=>e.value.calls),sourceComposedOrchestration:true,deterministicClockAssignments:true,originalGUI0:true,scope:'Exact compared representation uses explicitly deterministic temporal fixture assignments; initial actual released defaults are retained separately. Full dialog/event/timing behavior is not compared.'},null,2)+'\n');console.log('REA_RECYCLE_ORIGINAL '+JSON.stringify({assemblyLoads:observations.filter(e=>e.value).length,detail:out}));});
test('actual release helper/library lifecycle matches native delete/previous-parent recovery/purge and original reader opens candidate output',async t=>{const dir=await temp(t),file=path.join(dir,'original.kdbx'),seed=await original(dir,{mode:'create',database:file});assert.equal(seed.defaults.enabled,true);assert.equal(seed.defaults.collapse,false);assert.equal(seed.defaults.trashIcon,43);let data=await importKdbx(await fs.readFile(file),{password});compare(data,seed);const key=randomBytes(32),a=recycleView(data,key).entries[0],deleted=await originalOp(dir,file,{action:'delete'});assert.equal(deleted.binInitial.icon,43);assert.equal(deleted.binInitial.auto,false);assert.equal(deleted.binInitial.search,false);assert.equal(deleted.binInitial.expanded,true);data=deleteRecycleEntry(data,entryId,a.recycleRevision,key,{confirm:true,now:clock,binId:deleted.binUuid}).data;compare(data,deleted);const r=recycleView(data,key,{bin:true}).entries[0],restored=await originalOp(dir,file,{action:'restore'});data=restoreRecycleEntry(data,entryId,r.recycleRevision,key,{confirm:true,now:clock}).data;compare(data,restored);const active=recycleView(data,key).entries[0],purged=await originalOp(dir,file,{action:'delete',permanent:true});data=deleteRecycleEntry(data,entryId,active.recycleRevision,key,{confirm:true,permanent:true,now:clock}).data;compare(data,purged);await originalReadsNative(dir,data,purged);});
for(const[title,enabled,permanent]of[['explicit permanent override',true,true],['disabled original recycle setting',false,false]])test('released tombstones match native '+title,async t=>{const dir=await temp(t),file=path.join(dir,'original.kdbx');await original(dir,{mode:'create',database:file,enabled});const data=await importKdbx(await fs.readFile(file),{password}),key=randomBytes(32),r=recycleView(data,key).entries[0],expected=await originalOp(dir,file,{action:'delete',permanent}),actual=deleteRecycleEntry(data,entryId,r.recycleRevision,key,{confirm:true,permanent,now:clock}).data;compare(actual,expected);await originalReadsNative(dir,actual,expected);});
