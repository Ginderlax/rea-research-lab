 record.notesInstalled={...proof.receipt,sourceCommit:record.repositoryCommit,allNotesFiles:32,exactAfterTargets:8,allNotesGitBound:true,sourceMutationPerformed:false,installationPerformedByCollector:false,productionInstallationReceiptVerified:false,separatePostcheckRequired:true,postcheckReceipt:'notes-installed-postrun-source-check.json',fullDevelopmentReceiptEmitted:false,frozenReadmeIsProposalEpoch:true};
 return{targets:new Set(),status:[],mode:'notes-todo-installed',module,authentication:proof.authentication,bundle:proof.bundle};
