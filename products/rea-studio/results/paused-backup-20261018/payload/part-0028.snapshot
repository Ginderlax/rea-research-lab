// Exact public evidence/document copying. No product, test, verifier or browser runs.
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import {createHash} from 'node:crypto';
import {spawnSync} from 'node:child_process';
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab');
const capsuleStage=path.join(work,'notes-new-todo-r5-cloud-pass-public-20261016-next'),docsStage=path.join(work,'notes-new-todo-r5-current-docs-next');
const prefix='products/rea-studio/results/notes-new-todo-r5-cloud-pass-20261016',base='89e00f66c2249a50c701404accede7565094304e';
const backup=path.join(work,'cloud-recovery-20261015/new-todo-r5-success-and-docs-reviewed-copy');
const identity=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});
function read(root,name){assert(name&&!/[\\:\x00-\x1f\x7f]/.test(name)&&!name.startsWith('/')&&name.split('/').every(p=>p&&p!=='.'&&p!=='..'));let f=root;for(const p of name.split('/')){f=path.join(f,p);assert(!fs.lstatSync(f).isSymbolicLink());}assert(fs.lstatSync(f).isFile());return fs.readFileSync(f);}
function git(...args){const r=spawnSync('git',['-C',lab,...args],{shell:false,windowsHide:true,timeout:30000,maxBuffer:2*1024*1024});assert.equal(r.status,0,r.stderr.toString());return r.stdout.toString('utf8').trimEnd();}
const[peerName,peerSize,peerDigest]=process.argv.slice(2);assert(/^[a-z0-9-]+\.json$/.test(peerName??'')&&/^[0-9]+$/.test(peerSize??'')&&/^[0-9a-f]{64}$/.test(peerDigest??''),'Bind the exact reviewed current-documents peer before use');
