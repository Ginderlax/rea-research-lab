    {
      "id": "grafana.candidate.feb6493305837c8e6671",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana organizes queries, expressions, and transformations into rows, each with its own card and editor pane. Queries and expressions are identified with a letter (A, B, C, and so on) by default.",
      "headingPath": [
        "Query and transform data",
        "Navigate the query editor"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/_index.md",
