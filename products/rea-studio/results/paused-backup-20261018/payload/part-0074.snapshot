    {
      "id": "grafana.candidate.18a737feaa04418b41c0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Compared to API keys, service accounts have limited scopes that provide more security. For more information on the benefits of service accounts, refer to [service account benefits](ref:service-accounts-benefits).",
      "headingPath": [
        "Migrate API keys to service account tokens"
      ],
      "source": {
