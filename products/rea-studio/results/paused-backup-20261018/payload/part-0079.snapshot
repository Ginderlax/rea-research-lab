    {
      "id": "grafana.candidate.ff22d22781ef96c8cd11",
      "syntaxRole": "table-row",
      "sourceText": "| Line style          | Choose from:<ul><li>**Solid**</li><li>**Dash** - Select the length and gap for the line dashes. Default dash spacing is 10, 10.</li><li>**Dots** - Select the gap for the dot spacing. Default dot spacing is 0, 10.</li></ul> |",
      "headingPath": [
        "Table",
        "Configuration options",
        "Cell options",
        "Sparkline"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/table/index.md",
