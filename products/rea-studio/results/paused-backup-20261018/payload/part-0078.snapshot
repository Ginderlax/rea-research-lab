        "lineStart": 102,
        "lineEnd": 102,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/upgrade-guide/upgrade-v10.0/index.md#L102-L102"
      },
      "applicability": {
