import test from 'node:test';import assert from 'node:assert/strict';import {randomUUID} from 'node:crypto';
import {render}from'./client.mjs';import{handle,dispose}from'./server.mjs';
import{Element,descendants,button,field,openEntry,deferred}from'./ui-fixture.mjs';
async function fixture(t,wrap){const workspace={root:'recycle-ui-'+randomUUID()},store={value:null,get:async()=>structuredClone(store.value),set:async(k,v)=>{store.value=structuredClone(v)}},call=(action,input={})=>handle({action,input,workspace,store}),requests=[];await call('create',{password:'Synthetic recycle UI master'});const A=(await call('save',{title:'A',group:'Parent',password:'A secret',notes:'A notes'})).id,B=(await call('save',{title:'B',password:'B secret',notes:'B notes'})).id;
 globalThis.document={createElement:tag=>new Element(tag)};const root=new Element('main'),cleanup=await render(root,(action,input)=>{requests.push({action,id:input?.id});return wrap?wrap(action,input,()=>call(action,input)):call(action,input)});t.after(()=>{cleanup();dispose(workspace);delete globalThis.document});return{root,store,call,A,B,cleanup,requests};}
async function trash(root){await openEntry(root,'A');field(root,'Confirm entry deletion').checked=true;await button(root,'Delete entry').click();await button(root,'Show recycle bin').click();}
test('actual client deletion/readonly masked preview/confirmed previous-group recovery and permanent purge use separate bin controls',async t=>{const f=await fixture(t);await trash(f.root);assert.equal((await f.call('list')).entries.length,1);await button(f.root,'Preview recycled entry').click();const secret=field(f.root,'Recycled password');assert.equal(secret.type,'password');assert.equal(secret.readOnly,true);assert.equal(secret.value,'A secret');await button(f.root,'Restore recycled entry').click();assert.equal((await f.call('recycleList')).entries.length,1,'Unconfirmed restore must refuse.');field(f.root,'Confirm restoring this entry to its previous group').checked=true;await button(f.root,'Restore recycled entry').click();assert.equal((await f.call('list')).entries.length,2);assert.equal((await f.call('read',{id:f.A})).entry.group,'Parent');await trash(f.root);field(f.root,'Confirm permanent deletion of this recycled entry').checked=true;await button(f.root,'Permanently delete recycled entry').click();assert.equal((await f.call('recycleList')).entries.length,0);assert.equal((await f.call('list')).entries.length,1);});
test('late bin preview cannot expose secrets after Close bin or disposed view',async t=>{let armed=false;const arrived=deferred(),release=deferred(),f=await fixture(t,async(action,input,real)=>{const value=await real();if(action==='recycleRead'&&!armed){armed=true;arrived.resolve();await release.promise;}return value});await trash(f.root);const pending=button(f.root,'Preview recycled entry').click();await arrived.promise;await button(f.root,'Close recycle bin').click();release.resolve();await pending;assert(!descendants(f.root).some(e=>e.value==='A secret'));await button(f.root,'Show recycle bin').click();const a=deferred(),b=deferred();let gate=false;const root=new Element('main'),cleanup=await render(root,async(action,input)=>{const value=await f.call(action,input);if(action==='recycleRead'&&!gate){gate=true;a.resolve();await b.promise;}return value});await button(root,'Show recycle bin').click();const held=button(root,'Preview recycled entry').click();await a.promise;cleanup();b.resolve();await held;assert(!descendants(root).some(e=>e.value==='A secret'));});
test('held recovery response preserves another enabled editor draft and never changes its save identity',async t=>{const arrived=deferred(),release=deferred(),f=await fixture(t,async(action,input,real)=>{const value=await real();if(action==='recycleRestore'){arrived.resolve();await release.promise;}return value});await trash(f.root);field(f.root,'Confirm restoring this entry to its previous group').checked=true;const pending=button(f.root,'Restore recycled entry').click();await arrived.promise;await openEntry(f.root,'B');field(f.root,'Notes').value='B newer draft';release.resolve();await pending;assert.equal(field(f.root,'Title').value,'B');assert.equal(field(f.root,'Notes').value,'B newer draft');await button(f.root,'Save encrypted entry').click();assert.equal(f.requests.filter(e=>e.action==='save').at(-1).id,f.B);assert.equal((await f.call('read',{id:f.B})).entry.notes,'B newer draft');assert.equal((await f.call('read',{id:f.A})).entry.password,'A secret');});
test('late first bin list cannot replace a newer generation after a second show request',async t=>{let first=true;const arrived=deferred(),release=deferred(),f=await fixture(t,async(action,input,real)=>{const value=await real();if(action==='recycleList'&&first){first=false;arrived.resolve();await release.promise;}return value});await openEntry(f.root,'A');field(f.root,'Confirm entry deletion').checked=true;await button(f.root,'Delete entry').click();const old=button(f.root,'Show recycle bin').click();await arrived.promise;await button(f.root,'Show recycle bin').click();field(f.root,'Confirm permanent deletion of this recycled entry').checked=true;await button(f.root,'Permanently delete recycled entry').click();release.resolve();await old;assert(!descendants(f.root).some(e=>e.tagName==='strong'&&e.textContent==='A'));assert.equal((await f.call('recycleList')).entries.length,0);});
