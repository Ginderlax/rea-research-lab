import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import{createHash}from'node:crypto';
const work=import.meta.dirname,bundle=path.join(work,'keepass-history-production-integration-bundle-ready'),stage=path.join(work,'keepass-recycle-next'),app='products/rea-studio/apps/vault/',sha=b=>createHash('sha256').update(b).digest('hex');await fs.mkdir(stage);
const receiptBytes=await fs.readFile(path.join(bundle,'integration-validation.json'));assert.equal(sha(receiptBytes),'68d8ff9eefa9b56ecbb86b5d1fd74cd33861cd2bc82aa3713a0c098d63f642ab');const receipt=JSON.parse(receiptBytes),files=[];
for(const e of receipt.runtime){const b=await fs.readFile(path.join(bundle,e.path));assert.equal(sha(b),e.sha256);for(const dest of[e.path,'baseline/'+path.basename(e.path)+'.snapshot']){await fs.mkdir(path.dirname(path.join(stage,dest)),{recursive:true});await fs.writeFile(path.join(stage,dest),b,{flag:'wx'});}files.push({...e});}
for(const n of['server.mjs','lib/storage.mjs','lib/catalog.mjs','public/client.mjs','public/index.html','public/style.css']){const p='products/rea-studio/'+n,b=await fs.readFile(path.join(bundle,p));await fs.mkdir(path.dirname(path.join(stage,p)),{recursive:true});await fs.writeFile(path.join(stage,p),b,{flag:'wx'});files.push({path:p,bytes:b.length,sha256:sha(b),kind:'shared-host-validation-copy'});}
for(const n of['next-contracts.json','source-study.json','NOTES.md','docs-validation.json','docs-manifest.json','docs-freeze.json']){const b=await fs.readFile(path.join(work,'keepass-history-docs-next',n));await fs.mkdir(path.join(stage,'source-study'),{recursive:true});await fs.writeFile(path.join(stage,'source-study',n+'.snapshot'),b,{flag:'wx'});}
await fs.writeFile(path.join(stage,'baseline-validation.json'),JSON.stringify({schema:'rea-keepass-recycle-native-baseline/v1',created:new Date().toISOString(),sourceBundleReceiptSha256:sha(receiptBytes),files,nativeRuntimeFiles:5,runtimeBaselineByteIdentical:true,originalExecutions:0,runtimeTests:0,productionEdited:false,stageOnly:true},null,2)+'\n',{flag:'wx'});await fs.writeFile(path.join(stage,'prepare.mjs'),await fs.readFile(import.meta.filename),{flag:'wx'});console.log(JSON.stringify({stage,nativeRuntimeFiles:5,files:files.length,testsExecuted:0}));
