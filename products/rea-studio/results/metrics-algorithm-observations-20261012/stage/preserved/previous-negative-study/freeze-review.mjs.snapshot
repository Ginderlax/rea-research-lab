import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),source=path.resolve(here,'../metrics-selector-measurement-next'),sha=bytes=>createHash('sha256').update(bytes).digest('hex'),receiptName='measurement-validation.json',manifestName='freeze-manifest.json';
const fp=async file=>{const bytes=await fs.readFile(file);return {bytes:bytes.length,sha256:sha(bytes)};};
async function inventory(dir,base=dir){const result={};for(const row of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const file=path.join(dir,row.name),relative=path.relative(base,file).replaceAll('\\','/');if(relative==='.local'||base===here&&[receiptName,manifestName].includes(relative))continue;assert.ok(!row.isSymbolicLink());if(row.isDirectory())Object.assign(result,await inventory(file,base));else {assert.ok(row.isFile());result[relative]=await fp(file);}}return result;}
async function authenticateStudy(){const preservation=JSON.parse(await fs.readFile(path.join(here,'study-preservation.json')));assert.deepEqual(await inventory(source),preservation.sourceInventory);for(const copy of preservation.copies)assert.deepEqual(await fp(path.join(here,copy.path)),{bytes:copy.bytes,sha256:copy.sha256});return preservation;}
const median=values=>[...values].sort((a,b)=>a-b)[Math.floor(values.length/2)];
async function verifyRecomputed(summary){
  const paired=JSON.parse(await fs.readFile(path.join(here,'preserved/study/results/paired-control-1791843146458.json'))),memory=JSON.parse(await fs.readFile(path.join(here,'preserved/study/results/memory-observations-control-1791843441822.json')));
  assert.equal(paired.records.length,147);assert.equal(memory.samples.length,147);
  for(const row of summary.timingSummary)for(const role of ['original','baseline','candidate']){const values=paired.records.filter(item=>item.implementation===role&&item.caseName===row.caseName).sort((a,b)=>a.runNumber-b.runNumber).map(item=>item.result.millisecondsPerCall),record=row.millisecondsPerCall[role];assert.deepEqual(values,record.values);assert.equal(median(values),record.median);assert.equal(Math.min(...values),record.min);assert.equal(Math.max(...values),record.max);}
  for(const row of summary.memorySignedPerChildRows){const item=memory.samples.find(item=>item.implementation===row.implementation&&item.caseName===row.caseName&&item.runNumber===row.runNumber),cp=name=>item.result.checkpoints.find(value=>value.name===name);assert.ok(item);assert.equal(row.metrics['retained-heapUsed-signedBytes'],cp('retainedAfterGC').heapUsed-cp('beforeRetention').heapUsed);assert.equal(row.metrics['released-heapUsed-signedBytes'],cp('releasedAfterGC').heapUsed-cp('beforeRetention').heapUsed);assert.equal(row.metrics.observedPeakRSSBytes,item.ownedPIDObserver.peakRSS);}
}
if(process.argv.includes('--verify-only')){const frozen=JSON.parse(await fs.readFile(path.join(here,receiptName)));assert.deepEqual(await inventory(here),frozen.inventory);await authenticateStudy();await verifyRecomputed(JSON.parse(await fs.readFile(path.join(here,'recomputed-summary.json'))));const manifest=JSON.parse(await fs.readFile(path.join(here,manifestName)));for(const row of manifest.entries)assert.deepEqual(await fp(path.join(here,row.path)),{bytes:row.bytes,sha256:row.sha256});assert.equal((await fp(path.join(here,receiptName))).sha256,manifest.receiptSHA256);console.log(JSON.stringify({status:'passed',receiptSHA256:manifest.receiptSHA256,manifestSHA256:(await fp(path.join(here,manifestName))).sha256,files:manifest.entries.length,readOnly:true}));}
else {
  const preservation=await authenticateStudy(),summary=JSON.parse(await fs.readFile(path.join(here,'recomputed-summary.json')));assert.equal(summary.status,'authenticated and recomputed; candidate retained without integration');await verifyRecomputed(summary);
  const figure=JSON.parse(await fs.readFile(path.join(here,'figure-validation.json')));assert.equal(figure.summarySHA256,(await fp(path.join(here,'recomputed-summary.json'))).sha256);for(const row of figure.files)assert.deepEqual(await fp(path.join(here,row.path)),{bytes:row.bytes,sha256:row.sha256});
  const attempts=[];for(const name of(await fs.readdir(here)).filter(name=>/^(?:recompute|figure)-attempt-\d+\.json$/.test(name)).sort()){const row=JSON.parse(await fs.readFile(path.join(here,name))),stem=name.slice(0,-'.json'.length),kind=name.startsWith('figure')?'figure':'recompute';for(const [suffix,digest]of [[kind==='figure'?'.source.py.snapshot':'.source.mjs.snapshot',row.sourceSHA256??row.sourceBeforeSHA256],['.stdout.txt',row.stdoutSHA256],['.stderr.txt',row.stderrSHA256]])assert.equal((await fp(path.join(here,stem+suffix))).sha256,digest);attempts.push({path:name,...await fp(path.join(here,name)),kind,exitCode:row.exitCode,startedAt:row.startedAt,finishedAt:row.finishedAt});}
  assert.equal(attempts.length,4);assert.equal(attempts.filter(row=>row.exitCode===1).length,2);
  const negativeSignedValues=summary.memorySignedPerChildRows.reduce((sum,row)=>sum+Object.entries(row.metrics).filter(([key,value])=>key.endsWith('signedBytes')&&value<0).length,0),negativePairedValues=summary.memorySummary.reduce((sum,row)=>sum+Object.values(row.candidateComparedWith).reduce((sub,metrics)=>sub+Object.values(metrics).reduce((n,metric)=>n+metric.pairedDifferenceBytes.values.filter(value=>value<0).length,0),0),0);
  assert.ok(negativeSignedValues>0&&negativePairedValues>0);const current=await inventory(here),firstTiming='preserved/study/results/timing-attempt-1791843146474.json',pairedTiming='preserved/study/results/paired-control-1791843146458.json',memoryReceipt='preserved/study/results/memory-observations-control-1791843441822.json';
  const receipt={schema:'rea-metrics-selector-measured-review/v1',frozenAt:new Date().toISOString(),status:'authenticated source-stable measured study; candidate retained without integration',sourceStage:'../metrics-selector-measurement-next',readinessReceiptSHA256:summary.readinessReceipt.sha256,manifestSHA256:summary.manifestSHA256,candidate:summary.candidate,originalSourceBindings:summary.originalSourceBindings,runtime:summary.runtime,currentMetricsProductionSourcesUnchanged:summary.currentProductionSourcesAuthenticatedUnchanged,counts:summary.counts,measuredReceiptBindings:Object.fromEntries(await Promise.all([firstTiming,pairedTiming,memoryReceipt].map(async name=>[name,await fp(path.join(here,name))]))),independentSummary:{path:'recomputed-summary.json',...await fp(path.join(here,'recomputed-summary.json'))},timingAndMemoryRecomputed:true,allMedianRangesOriginalAndBaselineComparisonsRetained:true,negativeSignedChildMetricValues:negativeSignedValues,negativePairedMetricValues:negativePairedValues,negativeValuesClipped:false,windows:summary.windows,sourceStudyFiles:preservation.sourceFiles,preservedExactSourceAndLogFiles:preservation.preservedFiles,preservedBytes:preservation.preservedBytes,sourceStudyBeforeAfterStable:true,publicationExcludedArchives:preservation.publicationExcludedArchives,generatedLocalFixtureExcluded:true,priorFailureAndCensoring:summary.failureAndCensoring,consolidationAndRenderingAttempts:attempts,initialDirectFailureConsoleLogsNotSeparatelyCaptured:true,identicalFailedSourceReplayAndRawLogsPreserved:true,figures:figure,fullCorrectnessRerun:false,newMeasuredRunsDuringConsolidation:0,fullCorrectnessHistoricalSourceReceiptSHA256:summary.historicalFullSemanticReceiptSHA256,rejection:summary.rejection,publicProductionCandidateProposalPrepared:false,bothModulesPreservedAsRejectedStudyEvidence:true,ownedProcessesCompleted:true,productionOrOldStageSourceEdited:false,productionIntegrated:false,performanceParityEstablished:false,universalSuperiorityEstablished:false,fullProductComplete:false,inventory:current};
  await fs.writeFile(path.join(here,receiptName),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});assert.deepEqual(await inventory(here),current);
  const entries=Object.entries(current).map(([name,row])=>({path:name,...row})),receiptRecord=await fp(path.join(here,receiptName));entries.push({path:receiptName,...receiptRecord});const manifest={schema:'rea-metrics-selector-measured-review-freeze/v1',receiptSHA256:receiptRecord.sha256,entries:entries.sort((a,b)=>a.path.localeCompare(b.path)),files:entries.length,aggregateBytes:entries.reduce((sum,row)=>sum+row.bytes,0),publicationExcludedArchives:preservation.publicationExcludedArchives,sourceOnlyRejectedStudyEvidence:true,productionIntegrated:false};await fs.writeFile(path.join(here,manifestName),JSON.stringify(manifest,null,2)+'\n',{flag:'wx'});
  console.log(JSON.stringify({receipt:path.join(here,receiptName),receiptSHA256:receiptRecord.sha256,manifest:path.join(here,manifestName),manifestSHA256:(await fp(path.join(here,manifestName))).sha256,files:entries.length,bytes:manifest.aggregateBytes,counts:summary.counts,negativeSignedValues,negativePairedValues,candidateIntegrated:false}));
}
