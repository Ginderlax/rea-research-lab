import test from 'node:test';
import assert from 'node:assert/strict';
import {zstdDecompressSync} from 'node:zlib';
import {createDataPackWriter,DATA_BLOB_MAX,DATA_PACK_TARGET} from './restic-data-pack.mjs';
import {hash,randomKey,open} from './restic-crypto.mjs';
function decoded(pack,key){assert.equal(hash(pack.bytes),pack.id);const length=pack.bytes.readUInt32LE(pack.bytes.length-4),header=open(key,pack.bytes.subarray(pack.bytes.length-4-length,-4));const entries=[];let offset=0;for(let pos=0;pos<header.length;){const type=header[pos],width=type===2?41:37,length=header.readUInt32LE(pos+1),uncompressed_length=type===2?header.readUInt32LE(pos+5):0,id=header.subarray(pos+(type===2?9:5),pos+width).toString('hex');let bytes=open(key,pack.bytes.subarray(offset,offset+length));if(uncompressed_length)bytes=zstdDecompressSync(bytes,{maxOutputLength:uncompressed_length});assert.equal(hash(bytes),id);entries.push({id,type:'data',offset,length,...(uncompressed_length?{uncompressed_length}:{})});offset+=length;pos+=width;}assert.equal(offset,pack.bytes.length-4-length);assert.deepEqual(entries,pack.blobs);return entries;}
for(const version of [1,2])test(`v${version} buffers multiple authenticated blobs with exact contiguous index/header rows`,async()=>{const key=randomKey(),packs=[],writer=createDataPackWriter({key,version,commit:async p=>packs.push(p)}),a=Buffer.from('unique first '.repeat(100)),b=Buffer.from('unique second '.repeat(100));assert.equal(await writer.save(a),hash(a));assert.equal(await writer.save(b),hash(b));assert.equal(packs.length,0);assert.equal(writer.count,2);await writer.flush();assert.equal(packs.length,1);assert.equal(decoded(packs[0],key).length,2);assert.equal(writer.count,0);assert.ok(packs[0].bytes.length<DATA_PACK_TARGET);});
test('pending deduplication is verified and caller memory cannot alter queued or committed data',async()=>{const key=randomKey(),packs=[],writer=createDataPackWriter({key,version:2,commit:async p=>packs.push(p)}),source=Buffer.from('private source '.repeat(100)),copy=Buffer.from(source),id=await writer.save(source);assert.equal(await writer.save(copy),id);source.fill(0);copy.fill(1);assert.equal(writer.count,1);await writer.flush();assert.deepEqual(decoded(packs[0],key).map(e=>e.id),[id]);});
test('size and record boundaries split packs without a partial or empty header',async()=>{const key=randomKey(),packs=[],writer=createDataPackWriter({key,version:1,target:256,commit:async p=>packs.push(p)});for(let i=0;i<8;i++)await writer.save(Buffer.alloc(70,i));await writer.flush();assert.equal(packs.length,8);for(const pack of packs){assert.ok(pack.bytes.length<=256);assert.equal(decoded(pack,key).length,1);}await writer.flush();assert.equal(packs.length,8);});
test('failed commit poisons the writer and drops owned pending buffers without reissuing a commit',async()=>{const key=randomKey(),primary=new Error('owned synthetic commit failure');let calls=0;const writer=createDataPackWriter({key,version:1,commit:async()=>{calls++;throw primary;}});await writer.save(Buffer.from('owned'));await assert.rejects(writer.flush(),e=>e===primary);assert.equal(writer.count,0);await assert.rejects(writer.save(Buffer.from('again')),e=>e===primary);await assert.rejects(writer.flush(),e=>e===primary);assert.equal(calls,1);});
test('deadline/cancellation guard rejects before a pack commit and dispose releases pending state',async()=>{const controller=new AbortController();let calls=0;const writer=createDataPackWriter({key:randomKey(),version:1,guard:()=>{if(controller.signal.aborted)throw controller.signal.reason;},commit:async()=>{calls++;}});await writer.save(Buffer.from('owned pending'));controller.abort(new Error('owned cancel'));await assert.rejects(writer.flush(),/owned cancel/);assert.equal(calls,0);writer.dispose();assert.equal(writer.count,0);});
test('data input types and 8 MiB bound reject before copying or committing',async()=>{let calls=0;const writer=createDataPackWriter({key:randomKey(),version:1,commit:async()=>{calls++;}});for(const input of [new Uint8Array(1),{length:Number.MAX_SAFE_INTEGER},[1,2,3],Buffer.alloc(DATA_BLOB_MAX+1)])await assert.rejects(writer.save(input),/8 MiB/);assert.equal(writer.count,0);assert.equal(calls,0);});
