      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.7308e11b60da603fda69",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Security hardening enables you to apply additional security, which can help stop certain vulnerabilities from being exploited by a malicious attacker.",
      "headingPath": [
        "Configure security hardening"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md",
        "gitBlobSha": "3d53e64d215efc829e6827f523ce8947fa777722",
        "sha256": "a854d8317e4a2fc51bb82f7a31ee6438dc48f45d8ae483e504521c35e34c73df",
        "lineStart": 15,
        "lineEnd": 15,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md#L15-L15"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.8e054cb6530e7f84d953",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "These settings are available in the [grafana.ini configuration file](../../configure-grafana/#configuration-file-location). To apply changes to the configuration file, restart the Grafana server.",
      "headingPath": [
        "Configure security hardening"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md",
        "gitBlobSha": "3d53e64d215efc829e6827f523ce8947fa777722",
        "sha256": "a854d8317e4a2fc51bb82f7a31ee6438dc48f45d8ae483e504521c35e34c73df",
        "lineStart": 18,
        "lineEnd": 18,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md#L18-L18"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.2965b3d3d407f00666de",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If Grafana uses HTTPS, you can further secure the cookie that the system uses to authenticate access to the web UI. By applying additional security to the cookie, you might mitigate certain attacks that result from an attacker obtaining the cookie value.",
      "headingPath": [
        "Configure security hardening",
        "Additional security for cookies"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md",
        "gitBlobSha": "3d53e64d215efc829e6827f523ce8947fa777722",
        "sha256": "a854d8317e4a2fc51bb82f7a31ee6438dc48f45d8ae483e504521c35e34c73df",
        "lineStart": 23,
        "lineEnd": 23,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md#L23-L23"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.93eea6496447de6a9c94",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana must use HTTPS for the following configurations to work properly.",
      "headingPath": [
        "Configure security hardening",
        "Additional security for cookies"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md",
        "gitBlobSha": "3d53e64d215efc829e6827f523ce8947fa777722",
        "sha256": "a854d8317e4a2fc51bb82f7a31ee6438dc48f45d8ae483e504521c35e34c73df",
        "lineStart": 26,
        "lineEnd": 26,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md#L26-L26"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b88d23ecb7350df19cd3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To provide mitigation against some MITM attacks, add the `Secure` attribute to the cookie that is used to authenticate users. This attribute forces users only to send the cookie over a valid HTTPS secure connection.",
      "headingPath": [
        "Configure security hardening",
        "Additional security for cookies",
        "Add a secure attribute to cookies"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md",
        "gitBlobSha": "3d53e64d215efc829e6827f523ce8947fa777722",
        "sha256": "a854d8317e4a2fc51bb82f7a31ee6438dc48f45d8ae483e504521c35e34c73df",
        "lineStart": 31,
        "lineEnd": 31,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md#L31-L31"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.17e5843784ff6318adc9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To mitigate almost all CSRF-attacks, set the _cookie_samesite_ option to `strict`. This setting prevents clients from sending the cookie in requests that are made cross-site, but only from the site that creates the cookie.",
      "headingPath": [
        "Configure security hardening",
        "Additional security for cookies",
        "Add a SameSite attribute to cookies"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md",
        "gitBlobSha": "3d53e64d215efc829e6827f523ce8947fa777722",
        "sha256": "a854d8317e4a2fc51bb82f7a31ee6438dc48f45d8ae483e504521c35e34c73df",
        "lineStart": 43,
        "lineEnd": 43,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md#L43-L43"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.8f39b485a3bb105d6205",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By setting the SameSite attribute to \"strict,\" only the user clicks within a Grafana instance work. The default option, \"lax,\" does not produce this behavior.",
      "headingPath": [
        "Configure security hardening",
        "Additional security for cookies",
        "Add a SameSite attribute to cookies"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md",
        "gitBlobSha": "3d53e64d215efc829e6827f523ce8947fa777722",
        "sha256": "a854d8317e4a2fc51bb82f7a31ee6438dc48f45d8ae483e504521c35e34c73df",
        "lineStart": 54,
        "lineEnd": 54,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md#L54-L54"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.5af5c2bc70b225c71458",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you want to use OAuth/SAML for login, it is necessary to configure this attribute as `lax`.",
      "headingPath": [
        "Configure security hardening",
        "Additional security for cookies",
        "Add a SameSite attribute to cookies"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md",
        "gitBlobSha": "3d53e64d215efc829e6827f523ce8947fa777722",
        "sha256": "a854d8317e4a2fc51bb82f7a31ee6438dc48f45d8ae483e504521c35e34c73df",
        "lineStart": 56,
        "lineEnd": 56,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md#L56-L56"
      },
      "applicability": {
