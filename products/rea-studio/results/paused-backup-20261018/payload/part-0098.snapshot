const product = join(lab, 'products/rea-studio'), revision = 'f40f0cc82baddf00d59065a14034ddfb5f82e77f';
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
const json = path => JSON.parse(readFileSync(path, 'utf8'));
const save = (path, value) => writeFileSync(path, JSON.stringify(value, null, 2) + '\n');
const historical = join(product, 'results/milestones/native-exchange-20261012'); mkdirSync(historical, { recursive: true });
for (const name of ['development-validation.json', 'sequence-comparison.json', 'editor-comparison.json', 'browser-compatibility-verification.json']) {
  const run = spawnSync('git', ['show', `${revision}:products/rea-studio/results/${name}`], { cwd: lab, maxBuffer: 16 * 1024 * 1024 }); assert.equal(run.status, 0); writeFileSync(join(historical, name), run.stdout);
}
const priorBrowser = json(join(historical, 'browser-compatibility-verification.json')); priorBrowser.source_revision = revision; priorBrowser.evidence_status = 'Historical native-exchange browser run against the exact recorded Git revision; current interface checks are in browser-execution-verification.json.'; save(join(product, 'results/browser-compatibility-verification.json'), priorBrowser);
priorBrowser.historical_source_snapshots = [];
for (const entry of priorBrowser.implementation_fingerprints) if (sha(readFileSync(join(lab, entry.path))) !== entry.sha256) {
  const relative = entry.path.slice('products/rea-studio/'.length), snapshot = join(historical, 'source', relative); mkdirSync(join(snapshot, '..'), { recursive: true });
  const run = spawnSync('git', ['show', `${revision}:${entry.path}`], { cwd: lab, maxBuffer: 16 * 1024 * 1024 }); assert.equal(run.status, 0); assert.equal(sha(run.stdout), entry.sha256); writeFileSync(snapshot, run.stdout);
  priorBrowser.historical_source_snapshots.push({path:entry.path,snapshot_path:'products/rea-studio/results/milestones/native-exchange-20261012/source/'+relative,sha256:entry.sha256});
}
save(join(product, 'results/browser-compatibility-verification.json'), priorBrowser);
let milestone = readFileSync(join(product, 'NATIVE-EXCHANGE-MILESTONE.md'), 'utf8');
milestone = milestone.replace('Recorded on 12 October 2026.', `Historical milestone from revision ${revision}, recorded on 12 October 2026. Current progress is in [the execution and archive milestone](EXECUTION-ARCHIVE-MILESTONE.md).`);
for (const name of ['development-validation.json', 'sequence-comparison.json', 'editor-comparison.json', 'browser-compatibility-verification.json']) milestone = milestone.replaceAll(`](results/${name})`, `](results/milestones/native-exchange-20261012/${name})`);
milestone = milestone.replace('The other six applications retain their previously implemented local workflows.', 'At this historical revision, the other six applications retained their previously implemented local workflows.');
writeFileSync(join(product, 'NATIVE-EXCHANGE-MILESTONE.md'), milestone);
const requirements = join(product, 'requirements'), index = json(join(requirements, 'INDEX.json'));
for (const registry of index.registries) {
  const location = join(requirements, registry.file), record = json(location);
  const rows = registry.file === 'workspace-products.json' ? record.localImplementationEvidence : registry.file === 'visual-products.json' ? record.baselineProducts.flatMap(row => row.implementationFiles ?? []) : record.products.flatMap(row => row.local_implementation_evidence ?? []);
  for (const entry of rows) { const bytes = readFileSync(join(lab, entry.path)); entry.sha256 = sha(bytes); if (entry.bytes !== undefined) entry.bytes = bytes.length; }
  const updates = {
    'grafana.timeseries': ['partial', 'Saved-frame and local CSV line previews with exact data tables; full original visual/temporal contract remains open.'],
    'grafana.panel-types': ['partial', 'Local text/table/stat/time-series previews; remaining imported types are retained without rendering.'],
    'grafana.dashboard-model': ['partial', 'Whole JSON/unchanged byte retention for Classic/API-envelope/V1 and retention-only V2; supported panel/layout/settings edits and separate local bindings.'],
    'grafana.variables': ['partial', 'Custom/textbox/constant variable selection and simple text interpolation; full query/repetition/formatter semantics remain open.'],
    'n8n.execution.history': ['partial', 'Bounded asynchronous run histories, node/attempt traces, statuses, duration, cancellation and interrupted-restart markers; original data/retention/filter semantics unverified.'],
    'n8n.logic.subworkflows': ['partial', 'Saved local workflow calls in all/each modes with cycle/depth budgets; native n8n item-linking/extraction semantics remain open.'],
    'n8n.logic.wait': ['partial', 'Cancellable local delays up to 60000 ms; durable wait/resume and webhook resume are absent.'],
    'n8n.logic.errors': ['partial', 'Per-node stop/continue/error-output, bounded retries and failure traces; dedicated original error workflows and retry-data contracts remain open.'],
    'n8n.nodes.integrations': ['inventory-required', 'Generic bounded HTTP requests support methods, JSON/raw bodies, headers/query, redirects, response modes, timeout/retry and ephemeral credential references. Full bundled integration operations remain uninventoried/unimplemented.']
  };
  const capabilities = record.capabilities ?? record.baselineProducts?.flatMap(p => p.requirements) ?? record.products.flatMap(p => p.capabilities);
  for (const entry of capabilities) if (updates[entry.id]) [entry.status, entry.implementation] = updates[entry.id];
  if (registry.file === 'system-products.json') {
    const scopes = {
      '7Z.FORMAT.ZIP.001': 'Bounded classic ZIP/ZIP64 store/DEFLATE with signed/unsigned streaming descriptors, CP437/Unicode path extras and timestamps; original7za/.NET comparisons cover recorded fixtures.',
      '7Z.FORMAT.OTHERWRITE.001': 'Bounded TAR/PAX and GZIP/TAR.GZ creation; XZ, BZIP2, WIM and complete format options remain absent.',
      '7Z.FORMAT.OTHERREAD.001': 'Bounded TAR/PAX/GNU longname, GZIP/TAR.GZ and ZIP/ZIP64 reading; complete original format catalog remains absent.',
      '7Z.COMMAND.ADD.001': 'Create new ZIP/ZIP64/TAR/TAR.GZ/GZIP with applicable compression level/comment/layout controls; original add/update CLI contract remains absent.',
      '7Z.COMMAND.LISTTEST.001': 'ZIP/GZIP content CRC and size verification, TAR header-checksum/structure checks; native CLI listing and full-format failures remain unverified.',
      '7Z.METADATA.001': 'Source ZIP NTFS timestamps, TAR/PAX modification/access timestamps, GZIP modification time and file/directory time restoration; permissions/ACLs/ADS and creation-date restoration remain absent.'
    };
    for (const entry of capabilities) if (scopes[entry.id]) { entry.current_app_status = 'implemented-local-subset'; entry.current_app_scope = scopes[entry.id]; }
  }
  const additions = registry.file === 'workspace-products.json' ? ['apps/metrics/core.mjs', 'apps/metrics/grafana.test.mjs', 'apps/metrics/grafana.integration.test.mjs'] : registry.file === 'visual-products.json' ? ['apps/automation/engine.mjs', 'apps/automation/execution.test.mjs'] : ['apps/archive/zip.mjs', 'apps/archive/zip.test.mjs', 'apps/archive/tar.mjs', 'apps/archive/gzip.mjs', 'apps/archive/formats.test.mjs'];
  const destination = registry.file === 'workspace-products.json' ? record.localImplementationEvidence : registry.file === 'visual-products.json' ? record.baselineProducts.find(p => p.app === 'automation').implementationFiles : (record.products.find(p => p.application === 'archive').local_implementation_evidence ??= []);
  for (const path of additions) { const full = 'products/rea-studio/' + path; if (rows.some(entry => entry.path === full)) continue; const bytes = readFileSync(join(lab, full)); destination.push({ path: full, bytes: bytes.length, sha256: sha(bytes), scope: 'Current implemented subset; no full-product parity assertion.' }); }
  registry.local_implementation_fingerprints = rows.length + additions.filter(path => !rows.some(entry => entry.path === 'products/rea-studio/' + path)).length;
  save(location, record);
}
