    },
    {
      "id": "grafana.candidate.d4197aa094518c923840",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "How the operation behaves with data depends on if it is a number or time series data.",
      "headingPath": [
        "Write expression queries",
