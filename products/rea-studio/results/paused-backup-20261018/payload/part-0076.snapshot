    },
    {
      "id": "grafana.candidate.401c7652e5fe10566e0f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To avoid both problems, use the `sqlstring` format option. It handles escaping and quoting in a single step, so you don't add your own quotes around the variable:",
      "headingPath": [
        "MySQL template variables",
        "Use variables in queries",
        "Use explicit quoting for string variables"
      ],
      "source": {
        "path": "docs/sources/datasources/mysql/template-variables/index.md",
        "gitBlobSha": "8b4e9af927fd60ebb0f752a26f1b5318eb25a81f",
        "sha256": "782e0b5075e4a5b068515118097fb27d9b7924eba557b77b504f55d9b64978c9",
        "lineStart": 139,
        "lineEnd": 139,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/mysql/template-variables/index.md#L139-L139"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
