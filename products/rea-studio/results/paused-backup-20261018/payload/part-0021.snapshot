def pin(b,r):assert ident(b)=={k:r[k]for k in('bytes','sha256')}
def constant(blob,name):text=blob.decode('utf-8-sig');start=text.index('=',text.index('const '+name))+1;return json.JSONDecoder().raw_decode(text[start:].lstrip())[0]
