    {
      "id": "grafana.candidate.06bb1be6c1c09ea21a6d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Ensure that the Redirect URI is the complete HTTP address that you use to access Grafana via your browser, but with the appended path of `/login/gitlab`.",
