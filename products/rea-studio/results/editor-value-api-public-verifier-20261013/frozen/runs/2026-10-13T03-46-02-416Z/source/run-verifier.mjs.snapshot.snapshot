import fs from'node:fs/promises';import {readFileSync}from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{verifyEditorValueApiFollowups,verifyEditorValueApiProofBytes,assertEditorValueApiAliasRows,assertEditorValueApiPublicPath,assertEditorValueApiScope}from'./verify-editor-value-api-followups.mjs';
const here=import.meta.dirname,repo=path.resolve(here,'../../outputs/rea-research-lab'),run='runs/'+new Date().toISOString().replace(/[:.]/g,'-'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});
const save=async(p,b)=>{await fs.mkdir(path.dirname(path.join(here,p)),{recursive:true});await fs.writeFile(path.join(here,p),b,{flag:'wx'});},json=v=>Buffer.from(JSON.stringify(v,null,2)+'\n');
const source=['verify-editor-value-api-followups.mjs','run-verifier.mjs'],before=[];for(const p of source){const b=await fs.readFile(path.join(here,p));before.push({path:p,...id(b)});await save(run+'/source/'+p+'.snapshot',b);}await save(run+'/source-before.json',json(before));const node=id(await fs.readFile(process.execPath));assert.equal(node.sha256,'b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3');await save(run+'/node-provenance.json',json({path:process.execPath,version:process.version,...node,binaryCopied:false}));
const buffers=new Map(),pool=new Map(),observations=[],log=[];let actual=null,memory=null,error=null;
function io(map){return{read(p){assert(map.has(p),'Unknown in-memory path '+p);return map.get(p);},list(prefix){return[...map.keys()].filter(p=>p.startsWith(prefix));},finish(){return{sourceOnlyMemoryMock:true};}};}
function negative(name,body){let caught;try{body();}catch(e){caught=e;}assert(caught instanceof Error,'Negative guard did not reject '+name);observations.push({name,rejected:true,errorName:caught.name,errorCode:caught.code??null,errorMessage:caught.message,stack:String(caught.stack).slice(0,16384)});log.push('PASS '+name);}
try{
 actual=verifyEditorValueApiFollowups(repo,{onFile:r=>{const b=readFileSync(path.join(repo,...r.path.split('/')));assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});if(!pool.has(r.sha256))pool.set(r.sha256,b);buffers.set(r.path,pool.get(r.sha256));}});log.push('PASS actual public filesystem source proof');assert.equal(actual.publicApiAliases,475);assert.equal(actual.pureInstalledEvidence.pass,13);await save(run+'/actual-public-validation.json',json(actual));
 memory=verifyEditorValueApiProofBytes(io(buffers));log.push('PASS bounded in-memory source baseline');
 const focus='products/rea-studio/results/editor-value-api-installed-focus-20261013/frozen/',prefix='products/rea-studio/apps/editor/results/position-range-selection-followup/';const aliases=JSON.parse(buffers.get(focus+'expected-public475.json.snapshot')),scope=JSON.parse(buffers.get(prefix+'publication-plan/frozen/validation.json.snapshot'));
 negative('duplicate public alias',()=>{const r=structuredClone(aliases);r[1]=structuredClone(r[0]);assertEditorValueApiAliasRows(r);});
 negative('path traversal',()=>assertEditorValueApiPublicPath(prefix+'../outside.snapshot'));
 negative('private directory segment',()=>assertEditorValueApiPublicPath(prefix+'accepted-author319/.local/file.snapshot'));
 negative('unmapped public alias prefix',()=>{const r=structuredClone(aliases);r[0].path=prefix+'unmapped/file.snapshot';assertEditorValueApiAliasRows(r);});
 negative('mandatory current runtime byte mismatch',()=>{const map=new Map(buffers),p='products/rea-studio/apps/editor/position-range-selection.mjs';map.set(p,Buffer.concat([map.get(p),Buffer.from('\n// changed\n')]));verifyEditorValueApiProofBytes(io(map));});
 negative('truncated official source snapshot',()=>{const map=new Map(buffers),p=prefix+'accepted-author319/source/src/vs/workbench/api/common/extHostTypes/position.ts.snapshot.snapshot',b=map.get(p);assert(b);map.set(p,b.subarray(0,b.length-1));verifyEditorValueApiProofBytes(io(map));});
 negative('scope promoted to full product parity',()=>assertEditorValueApiScope({...scope,fullProductParity:true}));
 negative('extra helper count promoted',()=>assertEditorValueApiScope({...scope,constructibleHelpersOutsideDenominator:7}));
 negative('raw installed test summary altered',()=>{const map=new Map(buffers),p=focus+'runs/installed-pure13/stdout.txt.snapshot',b=map.get(p);assert(b);map.set(p,Buffer.from(b.toString().replace('# tests 13','# tests 12')));verifyEditorValueApiProofBytes(io(map));});
 negative('unmapped file inside a strict epoch',()=>{const map=new Map(buffers);map.set(prefix+'accepted-author319/unmapped.snapshot',Buffer.from('source-only synthetic extra file\n'));verifyEditorValueApiProofBytes(io(map));});
 assert.equal(observations.length,10);
}catch(e){error={name:e.name,message:e.message,stack:String(e.stack),code:e.code??null};log.push('FAIL '+e.message);await save(run+'/failure.txt',Buffer.from(String(e.stack)+'\n'));}
const after=[];for(const p of source){const b=await fs.readFile(path.join(here,p));after.push({path:p,...id(b)});}assert.deepEqual(after,before);await save(run+'/source-after.json',json(after));await save(run+'/guard-observations.json',json(observations));await save(run+'/collector-stdout.txt',Buffer.from(log.join('\n')+'\n'));await save(run+'/collector-stderr.txt',Buffer.from(error?error.stack+'\n':''));await save(run+'/selected-memory-identities.json',json([...buffers].map(([path,b])=>({path,...id(b)}))));
const result={schema:'rea-editor-value-api-public-proof-module-campaign/v1',sourceOnly:true,actualFilesystemAccepted:error===null,inMemoryBaselineAccepted:memory!==null,negativeGuardsExpected:10,negativeGuardsObserved:observations.length,negativeGuardsRejected:observations.filter(r=>r.rejected).length,sourceStable:true,module:before[0],collector:before[1],node,nodeVersion:process.version,error,actualSummary:actual,memory:{selectedFiles:buffers.size,uniqueBufferHashes:pool.size,bytes:[...pool.values()].reduce((a,b)=>a+b.length,0),privateFilesystemMirrorWrites:0,bytesWrittenToSourceResults:0},newApplicationTestCommands:0,newOriginalExecutions:0,newBrowserExecutions:0,newHostExecutions:0,fullSuiteCommands:0,benchmarks:0,productionWrites:0,fullProductParity:false,securityEquivalence:false,superiority:false};await save(run+'/validation.json',json(result));process.stdout.write(JSON.stringify({run,accepted:error===null,negativeGuards:observations.length,actualFiles:actual?.authenticatedFiles,module:before[0],error:error?{name:error.name,message:error.message.slice(0,1024),fullRaw:'failure.txt'}:null})+'\n');if(error)throw new Error('Source-only module campaign failed; exact source/raw retained under '+run);
await save('validation.json',json({schema:'rea-editor-value-api-public-proof-module-validation/v1',sourceOnly:true,publicInterface:'verifyEditorValueApiFollowups(root,{onFile}={}) synchronous, current checks mandatory',run,...result}));
await save('README.md',Buffer.from('This work-only source-verification proposal is installed by root as scripts/verify-editor-value-api-followups.mjs. verifyEditorValueApiFollowups(root,{onFile}={}) is synchronous and always checks current additions/24 original Editor files plus the explicit31 host transition. onFile receives one bounded path/byte/SHA record per authenticated file. It requires only public snapshots and current repository source, never local work/native binaries/compiler/oracle prerequisites. The helper verifyEditorValueApiProofBytes accepts owned in-memory read/list interfaces solely for source-only negative controls; the default filesystem function cannot disable current verification. Public strict319+81+57+14=475 aliases, focus26+manifest27 and failed12+manifest13 are exact; the corrected guide-proposal prefix is explicit, with the original failed prefix and one-string adapter retained. Generic root preservation wrappers remain root verifier scope. The old3ba capsule SHA binds original807 host bytes; exactly99 inserted bytes reconstruct85fe. Source-only159 ID/SHA and232 capability projection is compared without an old whole-registry hash claim. Historical22 replay,9 fresh/58 differential and observed installed13 records remain separate; this verifier executes none. Ten memory negative guards reject duplicate/traversal/private/unmapped paths, mandatory-current/source corruption, scope/helper inflation, raw-test changes and unmapped strict files. Selected byte fixtures stay in memory; no private full-repository mirror or native carrier is generated. All ownership writes are under this work stage; application/original/browser/host/full-suite/benchmark commands are0. Source-proof acceptance authenticates evidence and current identities; it does not establish full extension-host/client compatibility, app parity, security equivalence or superiority. Root owns integration/publication.\n'));
async function walk(root,prefix=''){const out=[];for(const e of(await fs.readdir(root,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){assert(!e.isSymbolicLink());const p=prefix+e.name;if(e.isDirectory())out.push(...await walk(path.join(root,e.name),p+'/'));else{assert(e.isFile());out.push(p);}}return out;}
const inventory={};let bytes=0;for(const p of await walk(here)){const b=await fs.readFile(path.join(here,p));inventory[p]=id(b);bytes+=b.length;}const manifest=json({schema:'rea-editor-value-api-public-proof-module-strict-freeze/v1',strict:true,selfExcluded:true,files:Object.keys(inventory).length,bytes,receiptSHA256:inventory['validation.json'].sha256,inventory});await save('freeze-manifest.json',manifest);process.stdout.write(JSON.stringify({files:Object.keys(inventory).length,manifest:id(manifest),receipt:inventory['validation.json']})+'\n');
