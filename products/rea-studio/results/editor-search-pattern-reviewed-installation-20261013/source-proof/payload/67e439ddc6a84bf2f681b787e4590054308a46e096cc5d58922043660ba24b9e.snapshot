import fs from'node:fs/promises';import path from'node:path';import{createHash}from'node:crypto';import{prepareEditorPatternPlan}from'./plan.mjs';const root=import.meta.dirname,workspace=path.resolve(root,'../..'),hash=b=>createHash('sha256').update(b).digest('hex');const before=await fs.readFile(path.join(root,'plan.mjs')),startedAt=new Date().toISOString(),plan=await prepareEditorPatternPlan({workspaceRoot:workspace});async function write(name,value){await fs.writeFile(path.join(root,name),JSON.stringify(value,null,2)+'\n',{flag:'wx'});}await write('public-preservation-map.json',plan.publicMap);await write('public-copy-list.json',plan.publicCopies);await write('excluded-generated-fixture-census.json',plan.excludedFixtures);await write('live-install-copy-list.json',plan.installation);await write('current31-before-images.json',plan.currentBeforeImages);await write('current39-after-proposal.json',plan.currentAfterSources);await write('source-and-license-binding.json',{author:plan.author,officialFiles:plan.officialMITFiles,pinnedDeclarations:plan.pinnedSearchDeclarations,license:plan.license,authorityBoundary:plan.authorityBoundary});const after=await fs.readFile(path.join(root,'plan.mjs'));if(!before.equals(after))throw Error('Planning module changed');const receipt={...plan,publicMap:undefined,publicCopies:undefined,excludedFixtures:undefined,installation:undefined,currentBeforeImages:undefined,currentAfterSources:undefined,officialMITFiles:undefined,pinnedSearchDeclarations:undefined,startedAt,endedAt:new Date().toISOString(),module:{bytes:before.length,sha256:hash(before)},moduleStable:true,sourceOnlyPassed:true};await write('plan-validation.json',receipt);console.log(JSON.stringify({sourceOnlyPassed:true,counts:plan.rawCounts,installation:plan.installation.length,before31:plan.currentBeforeImages.length,after39:plan.currentAfterSources.length,authorStrict574:true,productionWrites:0,publicWrites:0,tests:0,originalCalls:0,browserCalls:0}));
