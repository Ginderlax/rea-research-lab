import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import {loadParser} from './parser-loader.mjs';
const root=import.meta.dirname,sha=b=>createHash('sha256').update(b).digest('hex'),paths=['comment-census.mjs','parser-loader.mjs','source/vscode.d.ts.snapshot','results/api-inventory.json'];
const capture=()=>Promise.all(paths.map(async p=>{const b=await fs.readFile(path.join(root,p));return{path:p,bytes:b.length,sha256:sha(b)};}));const before=await capture(),source=await fs.readFile(path.join(root,'source/vscode.d.ts.snapshot')),text=source.toString(),i=JSON.parse(await fs.readFile(path.join(root,'results/api-inventory.json'))),ts=await loadParser();if(sha(source)!==i.source.sha256)throw new Error('Source mismatch');
const scanner=ts.createScanner(ts.ScriptTarget.Latest,false,ts.LanguageVariant.Standard,text),records=[];let tokens=0;for(let kind=scanner.scan();kind!==ts.SyntaxKind.EndOfFileToken;kind=scanner.scan()){if(++tokens>200000)throw new Error('Scanner token bound');if(kind!==ts.SyntaxKind.SingleLineCommentTrivia&&kind!==ts.SyntaxKind.MultiLineCommentTrivia)continue;const start=scanner.getTokenPos(),end=scanner.getTextPos(),value=text.slice(start,end);records.push({kind:ts.SyntaxKind[kind],isJSDocSourceForm:value.startsWith('/**'),utf16Start:start,utf16End:end,utf8Start:Buffer.byteLength(text.slice(0,start)),utf8End:Buffer.byteLength(text.slice(0,end)),sha256:sha(Buffer.from(value)),publicJSDocAttachmentIDs:[]});}
const map=new Map(records.map(r=>[r.utf16Start+':'+r.utf16End,r]));for(const d of i.declarations)for(const c of d.documentation){const r=map.get(c.span.utf16Start+':'+c.span.utf16End);if(!r||r.sha256!==c.span.sha256)throw new Error('Documentation comment span missing from scanner');r.publicJSDocAttachmentIDs.push(d.id);}
const after=await capture();if(JSON.stringify(before)!==JSON.stringify(after))throw new Error('Source mutation');
const receipt={schema:'rea-vscode-api-source-comment-census/v1',at:new Date().toISOString(),source:i.source,parserVersion:ts.version,scannerCalls:1,astParseCalls:0,scannerTokens:tokens,sourceComments:records.length,sourceJSDocForms:records.filter(r=>r.isJSDocSourceForm).length,publicJSDocAttachmentCount:records.reduce((n,r)=>n+r.publicJSDocAttachmentIDs.length,0),uniquePublicJSDocComments:records.filter(r=>r.publicJSDocAttachmentIDs.length).length,unattachedToPublicInventory:records.filter(r=>!r.publicJSDocAttachmentIDs.length).length,commentLocationsExact:true,sourceStable:true,before,after,originalProgramExecutions:0,scope:'AST-attached public JSDoc references are cross-checked against independently scanned raw source comments. Plain/private/unattached comments remain separate source records; no automatic documentation inheritance or atomic prose extraction.',records};await fs.writeFile(path.join(root,'results/source-comment-census.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({...receipt,before:undefined,after:undefined,records:undefined}));
