    {
      "id": "grafana.candidate.e611774aef6860d85bdd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Alerts and alert notifications should provide key information to help alert responders and incident participants understand what happened in their system and how to respond.",
      "headingPath": [
        "Monitor alerts"
      ],
      "source": {
        "path": "docs/sources/alerting/monitor-status/_index.md",
        "gitBlobSha": "f8c0e147d45a78a4e20fb96557c280e1ade12b55",
        "sha256": "fa0172ed55405dbb0bcbadc02cf28c37a8dc145b3123f2c0620a8da8836afe1a",
        "lineStart": 32,
        "lineEnd": 32,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/monitor-status/_index.md#L32-L32"
      },
      "applicability": {
