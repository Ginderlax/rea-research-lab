        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/configure-custom-branding/index.md#L92-L92"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
