    },
    {
      "id": "grafana.candidate.3ec9885ba548b63d5561",
      "syntaxRole": "list-item",
      "sourceText": "- The `target_datasource_uid` specifies which Prometheus-compatible data source to write the results to. If not specified, the default data source configured in `[recording_rules].default_datasource_uid` is used.",
      "headingPath": [
        "Grafana-managed endpoints",
        "Alert rules",
        "Example Response:",
        "Recording rules"
      ],
      "source": {
