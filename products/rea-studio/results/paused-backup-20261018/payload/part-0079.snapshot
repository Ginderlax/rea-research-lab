    {
      "id": "grafana.candidate.6c23209206ad8dd55844",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In node graphs, some data fields may have pre-configured data links. To add a different data link in those cases, use a [field override](#field-overrides).",
      "headingPath": [
