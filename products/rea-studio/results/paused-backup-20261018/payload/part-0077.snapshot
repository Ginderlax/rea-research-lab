    {
      "id": "grafana.candidate.ed598a5106f5abb7841e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When storing cache data in-memory, this setting defines how often a background process cleans up stale data from the in-memory cache. More frequent \"garbage collection\" can keep memory usage from climbing but will increase CPU usage.",
      "headingPath": [
        "Configure Grafana Enterprise",
        "[caching.memory]",
        "gc_interval"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md",
        "gitBlobSha": "51174e643296aefdf7f2a277d5fe604eeb1d2300",
