import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import {here} from './harness.mjs';
const sha=b=>createHash('sha256').update(b).digest('hex'),bind=async name=>{const b=await fs.readFile(path.join(here,name));return {path:name,bytes:b.length,sha256:sha(b)}};
const run=JSON.parse(await fs.readFile(path.join(here,'runs/selection-fixed-final/validation.json')));if(!run.sourceStable||run.tests.pass!==28||run.tests.fail||run.tests.skipped||run.originalProcessExecutions!==24||run.hostProcesses!==5)throw new Error('Unexpected corrected run.');
const old=JSON.parse(await fs.readFile(path.join(here,'correction-baseline.json')));if(old.oldFiles.length!==181)throw new Error('Unexpected old preservation count.');for(const f of old.oldFiles){const b=await fs.readFile(path.join(here,old.preservationPrefix,f.path+old.suffix));if(b.length!==f.bytes||sha(b)!==f.sha256)throw new Error('Old preserved artifact changed '+f.path)}
const original=JSON.parse(await fs.readFile(path.join(here,'preserved-original-stage/history-validation.final.json.snapshot')));const candidates=run.sourceBefore.filter(f=>['client.mjs','history.mjs','server.mjs','kdbx.mjs','xml.mjs'].includes(f.path));for(const f of candidates.filter(f=>f.path!=='client.mjs'))if(f.sha256!==original.sourceBindings.candidate.find(v=>v.path===f.path).sha256)throw new Error('Unintended native implementation change '+f.path);
const detail=path.join(here,'runs/selection-fixed-final/selection-observations');await fs.mkdir(detail);const selection=[];for(const name of ['restore-selection-observation.json',...await fs.readdir(path.join(here,'.local/observations/selection-boundaries')).then(names=>names.map(n=>'selection-boundaries/'+n))]){const bytes=await fs.readFile(path.join(here,'.local/observations',name)),dest=path.join(detail,name);await fs.mkdir(path.dirname(dest),{recursive:true});await fs.writeFile(dest,bytes);selection.push(await bind('runs/selection-fixed-final/selection-observations/'+name))}
const receipt={schema:'rea-stage-keepass-selection-correction-final/v1',completed:new Date().toISOString(),scope:'Separate stage-only correction of stale asynchronous editor/history/list publication; original181 freeze/independent failures remain historical.',focused:await bind('runs/selection-fixed-final/validation.json'),counts:run.tests,sourceStable:run.sourceStable,sourceBefore:run.sourceBefore,sourceAfter:run.sourceAfter,externalBefore:run.externalBefore,externalAfter:run.externalAfter,candidateSources:candidates,historyAndServerImplementationUnchanged:true,originalAccounting:original.originalAccounting,originalAssemblyExecutions:24,stagedHostProcesses:5,DOMElementModelGroups:12,browserExecutions:0,originalGuiExecutions:0,selectionGroups:{originalIndependentWrongEntryBodyWithPathAdapter:1,exactIndependentBoundaryBodies:6,additionalHeldOpenClosedPreviewOlderSearch:3},selectionObservations:selection,independentTestBindings:{original:'e6e28c97c3236afea08989e57b25f8f185adce6f8014e77bb18e51c8fb4eaeb1',originalSixBoundaries:'8a0d8e4198907563e55d61d9115bb8f0d2045c6af2822a05f025d6df96f13a53',originalBodiesPreserved:true,fixtureAdaptations:'Own stage default +owned .local observation output only; test bodies retained. Original wrong-entry case additionally changes import/output paths and observation scope label.'},oldEvidence:{original181ManifestSha256:old.oldStageManifestSha256,original181Authenticated:true,originalReceipt:await bind('preserved-original-stage/history-validation.final.json.snapshot'),copiedOldWorkingReceipts:'Historical copies only; correction receipt/run names are distinct.',independentFailures:'Exact saved files under independent-failure/. No old review source or result was modified.'},changeSummary:['Captured identity and view/editor/selection generation checked before assigning global selected after every asynchronous open/restore read.','History generation and row attachment checked before exposing preview or restoration result.','Captured IDs for save/delete/TOTP; stale completion cannot clear a different editor/draft.','Per-view list generations preserve newest result without changing active editor.','Session epoch suppresses idle timer rearming after a pre-lock read completes.'],limits:original.boundsAndLimits,claims:{productionChanged:false,fullProductParity:false,securityParity:false,superiority:false,vendorRuntimeInCandidate:false,independentPostFixReviewPending:true}};await fs.writeFile(path.join(here,'selection-validation.final.json'),JSON.stringify(receipt,null,2));
const files=[];async function walk(dir,rel=''){for(const e of await fs.readdir(dir,{withFileTypes:true})){const name=rel?rel+'/'+e.name:e.name;if(['selection-preservation-manifest.json','selection-freeze.json'].includes(name)||name==='.local/observations'||name==='.local/oracle-probe')continue;if(e.isSymbolicLink())throw new Error('Unexpected link');if(e.isDirectory())await walk(path.join(dir,e.name),name);else files.push(await bind(name))}}await walk(here);files.sort((a,b)=>a.path.localeCompare(b.path,'en'));await fs.writeFile(path.join(here,'selection-preservation-manifest.json'),JSON.stringify({schema:'rea-keepass-selection-correction-preservation/v1',count:files.length,files,strictInventory:true,excludedMutableDirectories:['.local/observations','.local/oracle-probe'],metadataExclusions:['selection-preservation-manifest.json','selection-freeze.json']},null,2));const freeze={schema:'rea-keepass-selection-correction-freeze/v1',frozen:new Date().toISOString(),receipt:await bind('selection-validation.final.json'),manifest:await bind('selection-preservation-manifest.json'),allExecutableTestDocsAndEvidenceFrozen:true,productionChanged:false};await fs.writeFile(path.join(here,'selection-freeze.json'),JSON.stringify(freeze,null,2));console.log(JSON.stringify(freeze));
