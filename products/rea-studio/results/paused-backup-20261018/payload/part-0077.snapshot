    {
      "id": "grafana.candidate.22feae00b3b7bf501a8f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For SQL data sources (MySql, Postgres, MSSQL) you can override the default maximum number of open connections (default: 100). The value configured in data source settings is preferred over the default value.",
