assert attempt['status']=='failed' and attempt['sourceCommit']=='e77bb17e8c1943baf1502a9bfeb83a62cf4f9d7c' and attempt['phases']==[]
assert attempt.get('controls') is None and not (E/'controls.json').exists()
started=[r for r in events if r['type']=='control-started'];passed=[r for r in events if r['type']=='control-passed']
assert len(started)==122 and len(passed)==121 and started[-1]['name']=='three-fixed-followup-verifier-epochs'
assert len({r['name'] for r in passed})==121 and any(r['name']=='notes-exact-reader-intermediate-epochs' and r['passed'] for r in passed)
assert events[-1]['type']=='terminal' and events[-1]['status']=='failed' and events[-1]['failure']==attempt['failure']
assert attempt['failure']['message']=="Expected values to be strictly equal:\n+ actual - expected\n\n+ '"+alias+"'\n- null\n"
