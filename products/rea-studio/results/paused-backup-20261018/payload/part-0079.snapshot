      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For more information, refer to [Reporting docs](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/visualizations/dashboards/create-reports/).",
      "headingPath": [
