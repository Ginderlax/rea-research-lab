    {
      "id": "grafana.candidate.7a52c387e69588d27353",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To build a query, select a scenario from the **Scenario** drop-down. The query editor updates to show fields specific to that scenario. Click **Run queries** or use the keyboard shortcut to execute.",
      "headingPath": [
        "TestData query editor"
      ],
      "source": {
        "path": "docs/sources/datasources/testdata/query-editor/index.md",
