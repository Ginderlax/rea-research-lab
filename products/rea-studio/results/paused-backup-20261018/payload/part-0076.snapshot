    },
    {
      "id": "grafana.candidate.71dfb52adf7289c30678",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Because PromQL doesn't natively return start/end time pairs, range annotations with Prometheus are limited to scenarios where you have separate metrics for start and end times (for example, via recording rules or custom metrics pushed to `Pushgateway`). For most use cases, point annotations (using the examples in this page) are the practical approach.",
      "headingPath": [
        "Prometheus annotations",
        "Range annotations"
      ],
      "source": {
        "path": "docs/sources/datasources/prometheus/annotations/index.md",
        "gitBlobSha": "9ee656cf2ba84b4fe09125c4d6b8121107706928",
        "sha256": "e3ddbaf259ebb52d2ebe8435a190380b808795fe707fbeb216c167e351e4644d",
        "lineStart": 208,
        "lineEnd": 208,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/prometheus/annotations/index.md#L208-L208"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.f5d77b53768c1a700106",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If your annotations aren't appearing or you encounter errors, refer to [Troubleshoot Prometheus data source issues](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/prometheus/troubleshooting/#annotation-errors).",
      "headingPath": [
        "Prometheus annotations",
        "Range annotations"
      ],
      "source": {
