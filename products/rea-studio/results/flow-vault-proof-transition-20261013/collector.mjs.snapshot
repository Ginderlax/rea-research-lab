import fs from 'node:fs/promises';
import path from 'node:path';
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {pathToFileURL} from 'node:url';
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab'),own=path.join(work,'flow-vault-proof-transition-next');
const sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)});
const prefix='products/rea-studio/results/flow-vault-proof-transition-20261013';
const plans=[{name:'flow',folder:'flow-static-link-textarea-publication-plan-next',pin:'7fe69cfdd42a44716e31c07b3a65a2ee29634e105acfdb35865bc4e9beb5d7a4',count:83,file:'installation-proposals.json',key:'proposals',rows:19},{name:'vault',folder:'vault-group-edit-installation-plan-next',pin:'08ba0c57de6456c8cb5c508be318703a1c55977dc0c9d7f4bd6b5271f513d99d',count:291,file:'installation-plan.json',key:'rows',rows:16}];
async function safeRead(base,p){assert(typeof p==='string'&&!p.startsWith('/')&&!/[\\:\x00-\x1f]/.test(p));assert(p.split('/').every(s=>s&&s!=='.'&&s!=='..'));let at=base;for(const s of p.split('/')){at=path.join(at,s);assert(!(await fs.lstat(at)).isSymbolicLink());}const b=await fs.readFile(at);assert(b.length<=32*1024*1024);return b;}
async function authenticatePlan(p){const base=path.join(work,p.folder),b=await safeRead(base,'manifest.json');assert.equal(sha(b),p.pin);const j=JSON.parse(b);assert.equal(j.inventory.length,p.count);const names=new Set();for(const r of j.inventory){assert(!names.has(r.path));names.add(r.path);assert.deepEqual(id(await safeRead(base,r.path)),{bytes:r.bytes,sha256:r.sha256});}return{id:id(b),inventory:j.inventory};}
const authorities=[];for(const p of plans)authorities.push(await authenticatePlan(p));
assert.equal(await fs.stat(own).then(()=>true,()=>false),false);await fs.mkdir(own);
async function save(p,b){const f=path.join(own,p);await fs.mkdir(path.dirname(f),{recursive:true});await fs.writeFile(f,b,{flag:'wx'});}
await save('collector.mjs.snapshot',await fs.readFile(import.meta.filename));
await save('preparation-read-diagnostics.json',Buffer.from(JSON.stringify({sourceOnly:true,rawToolOutputNotCaptured:true,ownErrors:[{kind:'read-path-guess',paths:['scripts/verify-development-proof.mjs','scripts/verify-api-client-proof.mjs','work/vault-group-edit-installation-plan-next/public-source-map.json','work/vault-group-edit-installation-plan-next/source-proof/public-source-map.json'],effect:'Read-only commands reported missing guessed files. Subsequent actual inventories identified scripts/editor-vault-proof-migration.mjs and source-proof/preservation-manifest.json.'},{kind:'inline-inspection-syntax',effect:'An extra closing parenthesis prevented an inline read-only Node inspection from parsing. A saved inspection file completed successfully.'}],productFailureClaimed:false,productionWrites:0},null,2)+'\n'));
const oldPath='scripts/editor-vault-proof-migration.mjs',old=await safeRead(lab,oldPath);assert.equal(sha(old),'69449058df56a5841d4a0dafc2d88603f3022a71cec6f7363ec3751f0ffef5a2');await save('before/'+oldPath+'.snapshot',old);
const match=old.toString().match(/const fixed=(\{[\s\S]*?\});\r?\nconst sha=/);assert(match);const fixed=JSON.parse(match[1]);
const sources=[],nextAuthorities=[],virtual=new Map(),publicRows=[];
async function authorityCopy(name,b){await save(name,b);const publicPath=prefix+'/'+name;virtual.set(publicPath,b);publicRows.push({sourcePath:name,publicPath,...id(b)});return{path:publicPath,...id(b)};}
for(const [i,p] of plans.entries()){
 const b=await safeRead(path.join(work,p.folder),p.file),j=JSON.parse(b);assert.equal(j[p.key].length,p.rows);
 const declaration=await authorityCopy('authority/'+p.name+'-installation.json.snapshot',b);nextAuthorities.push({...declaration,name:p.name,key:p.key,rows:p.rows,sourceManifest:authorities[i].id,sourceManifestFiles:p.count});
 for(const r of j[p.key]){const destination=r.destination??r.target,source=r.sourcePath??r.source;assert(destination.startsWith('products/rea-studio/apps/'+p.name+'/'));const candidate=await safeRead(path.join(work,p.folder),source);assert.deepEqual(id(candidate),r.after);if(r.before)assert.deepEqual(id(await safeRead(lab,destination)),r.before);else assert.equal(await fs.stat(path.join(lab,destination)).then(()=>true,()=>false),false);sources.push({path:destination,before:r.before,after:r.after,plan:p.name});virtual.set(destination,candidate);}
}
assert.equal(sources.length,35);assert.equal(new Set(sources.map(r=>r.path)).size,35);const routes=[];
for(const r of sources.filter(r=>r.before)){const b=await safeRead(lab,r.path),a=await authorityCopy('application-before/'+r.path+'.snapshot',b);routes.push({...r,historicalPath:a.path});}
assert.equal(routes.length,9);assert.equal(routes.filter(r=>r.plan==='vault').length,4);
const historical937Path='products/rea-studio/results/editor-vault-combined-20261013/preservation-manifest.json',historical937Bytes=await safeRead(lab,historical937Path);assert.equal(sha(historical937Bytes),'e1c9211ca4cd302faf4e819077e5809d01539091cc8fc541fbccfde428a0b80b');const historical937=JSON.parse(historical937Bytes);
assert.equal(historical937.summary.pass,937);assert.equal(historical937.sourceFiles,737);assert.equal(historical937.snapshots.length,753);assert.equal(historical937.fullProductParity,false);assert.equal(historical937.universalSuperiority,false);
const oldDevelopmentRow=historical937.snapshots.find(r=>r.sourcePath==='results/development-validation.json');assert(oldDevelopmentRow);assert.deepEqual(id(await safeRead(lab,'products/rea-studio/results/development-validation.json')),{bytes:oldDevelopmentRow.bytes,sha256:oldDevelopmentRow.sha256});
const selectedHistorical937=[];for(const sourcePath of ['source-before.json.snapshot','source-after.json.snapshot','attempt-validation.json.snapshot','results/development-validation.json']){const r=historical937.snapshots.find(r=>r.sourcePath===sourcePath);assert(r);const p='products/rea-studio/results/editor-vault-combined-20261013/'+r.path;assert.deepEqual(id(await safeRead(lab,p)),{bytes:r.bytes,sha256:r.sha256});selectedHistorical937.push({sourcePath,path:p,bytes:r.bytes,sha256:r.sha256});}
const currentStatus=await safeRead(lab,'products/rea-studio/STATUS.json');assert.equal(JSON.parse(currentStatus).complete_replacement_products,0);const statusAlias=await authorityCopy('metadata-before/products/rea-studio/STATUS.json.snapshot',currentStatus);
const next={schema:'rea-fixed-flow-vault-proof-transition/v1',sources,routes,authorities:nextAuthorities,historical937:{path:historical937Path,...id(historical937Bytes),sourceFiles:737,snapshots:753,tests:937,selected:selectedHistorical937,statusBefore:statusAlias},scope:{sourceOnly:true,namedRoutesOnly:true,applicationExecutions:0,originalExecutions:0,browserExecutions:0,benchmarks:0,fullParity:false,universalSuperiority:false}};
let text=old.toString();const adaptations=[];
function replaceOnce(before,after,name){assert.equal(text.split(before).length-1,1,name);text=text.replace(before,after);adaptations.push({name,before,after});}
replaceOnce('const sha=b=>',`const next=${JSON.stringify(next,null,2)};\nconst sha=b=>`,'fixed explicit next identities');
replaceOnce("assert(seen.size<=100&&total<=16*1024*1024,'Transition aggregate bound');","assert(seen.size<=160&&total<=16*1024*1024,'Transition aggregate bound');",'bounded additional source authentication');
replaceOnce(" for(const r of fixed.sources)read(r.path,r.after);read(fixed.sharedHost.path,fixed.sharedHost);",` const nextRoutes=new Map(next.routes.map(r=>[r.path,r]));assert.equal(nextRoutes.size,9);assert.equal(next.sources.length,35);assert.equal(new Set(next.sources.map(r=>r.path)).size,35);
 for(const authority of next.authorities){const declaration=JSON.parse(read(authority.path,authority)),rows=declaration[authority.key];assert.equal(rows.length,authority.rows);assert.deepEqual(rows.map(r=>({path:r.destination??r.target,before:r.before,after:r.after,plan:authority.name})),next.sources.filter(r=>r.plan===authority.name));}
 let movedEarlierSources=0;for(const r of fixed.sources){const route=nextRoutes.get(r.path);if(route){same(r.after,route.before,'Exact second transition '+r.path);read(route.historicalPath,route.before);movedEarlierSources++;}else read(r.path,r.after);}assert.equal(movedEarlierSources,4);
 for(const r of next.sources)read(r.path,r.after);for(const r of next.routes)read(r.historicalPath,r.before);read(fixed.sharedHost.path,fixed.sharedHost);
 const previous=JSON.parse(read(next.historical937.path,next.historical937));assert.equal(previous.sourceFiles,737);assert.equal(previous.snapshots.length,753);assert.equal(previous.summary.tests,937);assert.equal(previous.summary.pass,937);assert.equal(previous.summary.fail+previous.summary.skipped+previous.summary.cancelled+previous.summary.todo,0);assert.equal(previous.sourceStable,true);assert.equal(previous.fullProductParity,false);assert.equal(previous.universalSuperiority,false);
 const previousSelected=new Map(next.historical937.selected.map(r=>[r.sourcePath,r]));for(const r of next.historical937.selected){const original=previous.snapshots.find(s=>s.sourcePath===r.sourcePath);assert(original);same(original,r,'Fixed937 selected alias');assert.equal(r.path,'products/rea-studio/results/editor-vault-combined-20261013/'+original.path);read(r.path,r);}
 const previousJSON=n=>JSON.parse(read(previousSelected.get(n).path,previousSelected.get(n))),priorBefore=previousJSON('source-before.json.snapshot'),priorAfter=previousJSON('source-after.json.snapshot'),priorAttempt=previousJSON('attempt-validation.json.snapshot'),priorDevelopment=previousJSON('results/development-validation.json');assert.deepEqual(priorBefore,priorAfter);assert.equal(priorBefore.length,737);assert.equal(priorAttempt.exitCode,0);assert.equal(priorAttempt.sourceStable,true);assert.deepEqual(priorAttempt.summary,previous.summary);assert.deepEqual(priorDevelopment.summary,previous.summary);assert.equal(previous.developmentValidationSHA256,previousSelected.get('results/development-validation.json').sha256);
 for(const r of next.routes.filter(r=>r.path.endsWith('.mjs'))){const original=priorBefore.find(s=>'products/rea-studio/'+s.path===r.path);assert(original);same(original,r.before,'Previous937 source transition');}
 const priorStatus=JSON.parse(read(next.historical937.statusBefore.path,next.historical937.statusBefore));assert.equal(priorStatus.goal_status,'active');assert.equal(priorStatus.complete_replacement_products,0);assert.equal(priorStatus.source_stable_combined_checks.pass,937);assert.equal(priorStatus.source_stable_combined_checks.source_fingerprints,737);`,'prior after aliases and mandatory current union plus historical937');
replaceOnce(" function resolveHistorical(p,r){safe(p);const row=sourceRoutes.get(p),v=verifierRoutes.get(p);if(!row&&!v)return null;assert(r,'Named transition requires an explicit expected identity: '+p);const id=expected(r);if(id.bytes===(row??v).after.bytes&&id.sha256===(row??v).after.sha256)return null;same(id,(row??v).before,'No unlisted historical identity allowed: '+p);return (row??v).historicalPath;}"," function resolveHistorical(p,r){safe(p);const newer=nextRoutes.get(p),row=sourceRoutes.get(p),v=verifierRoutes.get(p);if(!newer&&!row&&!v)return null;assert(r,'Named transition requires an explicit expected identity: '+p);const id=expected(r);if(newer){if(id.bytes===newer.after.bytes&&id.sha256===newer.after.sha256)return null;if(id.bytes===newer.before.bytes&&id.sha256===newer.before.sha256)return newer.historicalPath;if(!row&&!v)throw new Error('No unlisted historical identity allowed: '+p);}const older=row??v;if(!newer&&id.bytes===older.after.bytes&&id.sha256===older.after.sha256)return null;same(id,older.before,'No unlisted historical identity allowed: '+p);return older.historicalPath;}",'only explicitly listed old and latest routes');
replaceOnce("namedSourceRoutes:8,old720ChangedCodeRoutes:6,docsOutside720:2,currentInstalledSourcesMandatory:30,", "namedSourceRoutes:13,old720ChangedCodeRoutes:9,docsOutside720:4,currentInstalledSourcesMandatory:61,latestInstalledSourcesMandatory:35,unchangedEarlierInstalledSourcesMandatory:26,historicalEarlierInstalledAfterSourcesAuthenticated:4,latestBeforeImagesMandatory:9,historical937NotCurrentAcceptance:true,historical937SelectedSnapshots:4,",'accurate source epoch summary');
let inverse=text;for(const a of adaptations.toReversed()){assert.equal(inverse.split(a.after).length-1,1,a.name+' inverse');inverse=inverse.replace(a.after,a.before);}assert.equal(inverse,old.toString());
const candidate=Buffer.from(text);await save('candidate/'+oldPath,candidate);await save('exact-adaptations.json',Buffer.from(JSON.stringify(adaptations,null,2)+'\n'));await save('fixed-next-identities.json',Buffer.from(JSON.stringify(next,null,2)+'\n'));await save('public-copy-list.json',Buffer.from(JSON.stringify({prefix,records:publicRows},null,2)+'\n'));
const module=await import(pathToFileURL(path.join(own,'candidate',oldPath)).href);
const rawRead=p=>virtual.has(p)?Buffer.from(virtual.get(p)):fsSyncRead(p);
function fsSyncRead(p){return readFileSync(path.join(lab,p));}
const accepted=module.createEditorVaultProofMigration(rawRead),summary=accepted.summary();assert.equal(summary.currentInstalledSourcesMandatory,61);assert.equal(summary.latestBeforeImagesMandatory,9);assert.equal(summary.historical937NotCurrentAcceptance,true);
const checks=[];function check(name,fn){fn();checks.push({name,passed:true});}
check('35 latest live files mandatory',()=>{for(const r of sources){const bad=Buffer.from(virtual.get(r.path));if(bad.length)bad[0]^=1;else bad.push?.(1);assert.throws(()=>module.createEditorVaultProofMigration(p=>p===r.path?bad:rawRead(p)));}});
check('9 before identities mapped exactly and no current remapping',()=>{for(const r of routes){assert.equal(accepted.resolve(r.path,r.before),r.historicalPath);assert.equal(accepted.resolve(r.path,r.after),null);assert.throws(()=>accepted.resolve(r.path,{bytes:r.before.bytes,sha256:'0'.repeat(64)}));assert.throws(()=>accepted.resolve(r.path));}});
check('older eight route identities remain exact',()=>{for(const r of fixed.routes){assert.equal(accepted.resolve(r.path,r.before),r.historicalPath);assert.throws(()=>accepted.resolve(r.path,{bytes:r.before.bytes,sha256:'f'.repeat(64)}));}});
check('nine before images mandatory',()=>{for(const r of routes){const b=Buffer.from(virtual.get(r.historicalPath));b[0]^=1;assert.throws(()=>module.createEditorVaultProofMigration(p=>p===r.historicalPath?b:rawRead(p)));}});
check('unknown paths not remapped and unsafe rejected',()=>{assert.equal(accepted.resolve('products/rea-studio/apps/unknown/x.mjs',{bytes:0,sha256:'0'.repeat(64)}),null);for(const p of ['../x','/x','work/x','a\\b','a/../b'])assert.throws(()=>accepted.resolve(p,{bytes:0,sha256:'0'.repeat(64)}));});
check('seen source mutations rejected on summary reread',()=>{let changed=false;const instance=module.createEditorVaultProofMigration(p=>{const b=rawRead(p);if(changed&&p===sources[0].path)b[0]^=1;return b;});changed=true;assert.throws(()=>instance.summary());});
check('historical metadata not current acceptance',()=>{assert.equal(sha(accepted.historicalMetadata('development')),fixed.metadata.development.sha256);assert.equal(sha(accepted.historicalMetadata('status')),fixed.metadata.status.sha256);assert.throws(()=>accepted.historicalMetadata('arbitrary'));});
for(const p of plans)await authenticatePlan(p);for(const r of sources){if(r.before)assert.deepEqual(id(await safeRead(lab,r.path)),r.before);else assert.equal(await fs.stat(path.join(lab,r.path)).then(()=>true,()=>false),false);}
const validation={schema:'rea-flow-vault-proof-transition-preparation/v1',at:new Date().toISOString(),sourceOnly:true,candidate:{path:oldPath,before:id(old),after:id(candidate)},exactInverse:true,applicationSourceChanges:0,latestPlans:plans.map((p,i)=>({name:p.name,manifestSHA256:p.pin,files:p.count,rows:p.rows})),latestPlanReviewsRequiredBeforeInstallation:true,summary,checks,modelVirtualReadsOnly:true,applicationExecutions:0,originalExecutions:0,browserExecutions:0,benchmarks:0,oldReceiptsRebound:false,fullParity:false,universalSuperiority:false};
await save('validation.json',Buffer.from(JSON.stringify(validation,null,2)+'\n'));console.log(JSON.stringify(validation));
import {readFileSync} from 'node:fs';
