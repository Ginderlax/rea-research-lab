import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';import {spawn} from 'node:child_process';import {pathToFileURL} from 'node:url';
const root=import.meta.dirname,studio=path.join(root,'products/rea-studio'),kind=process.argv[2],hash=b=>createHash('sha256').update(b).digest('hex');assert(['negative','fixed','focused'].includes(kind));
const run=path.join(root,'runs',kind+'-'+new Date().toISOString().replaceAll(':','-'));await fs.mkdir(run,{recursive:true});const save=async(n,b)=>{const p=path.join(run,n);await fs.mkdir(path.dirname(p),{recursive:true});await fs.writeFile(p,b,{flag:'wx'});};const json=async(n,v)=>save(n,JSON.stringify(v,null,2)+'\n');
const sourceNames=(await fs.readdir(path.join(studio,'apps/notes'),{withFileTypes:true})).filter(r=>r.isFile()).map(r=>'apps/notes/'+r.name);for(const r of await fs.readdir(path.join(studio,'apps/notes/fixtures'),{withFileTypes:true}))if(r.isFile())sourceNames.push('apps/notes/fixtures/'+r.name);sourceNames.push('server.mjs','catalog.mjs','lib/storage.mjs');sourceNames.sort();
const fingerprints=()=>Promise.all(sourceNames.map(async n=>{const b=await fs.readFile(path.join(studio,n));return{path:n,bytes:b.length,sha256:hash(b)};}));const before=await fingerprints();await json('source-before.json',before);for(const r of before)await save('source/'+r.path+'.snapshot',await fs.readFile(path.join(studio,r.path)));await save('runner.mjs.snapshot',await fs.readFile(import.meta.filename));
const single='notebook-confirmation-cancel-open-note.ui.test.mjs',selected=kind==='focused'?['app.test.mjs','app.integration.test.mjs','jex.test.mjs','notebooks.test.mjs','notebooks.integration.test.mjs','notebook-trash.test.mjs','notebook-trash.integration.test.mjs','notebook-trash.ui.test.mjs','notebook-trash-review.test.mjs','notebook-trash-publication-boundaries.test.mjs','notebook-trash-fresh-boundaries.test.mjs','notebook-confirmation.ui.test.mjs',single]:[single],args=['--test','--test-concurrency=1','--test-reporter=tap',...selected.map(n=>'apps/notes/'+n)],env={...process.env,NOTES_REVIEW_OUTPUT:pathToFileURL(path.join(run,'observations')+path.sep).href};delete env.NODE_TEST_CONTEXT;const startedAt=new Date().toISOString();
const result=await new Promise(resolve=>{const p=spawn(process.execPath,args,{cwd:studio,env,shell:false,windowsHide:true,stdio:['ignore','pipe','pipe']}),raw={stdout:[],stderr:[]},sizes={stdout:0,stderr:0};let failure=null;for(const[n,cap]of[['stdout',8*1024*1024],['stderr',2*1024*1024]])p[n].on('data',b=>{const take=Math.max(0,Math.min(b.length,cap-sizes[n]));raw[n].push(b.subarray(0,take));sizes[n]+=take;if(take!==b.length){failure??='retained output cap';p.kill('SIGKILL');}});const timer=setTimeout(()=>{failure??='240-second child deadline';p.kill('SIGKILL');},240000);p.on('error',e=>failure??=e.message);p.on('close',(exitCode,signal)=>{clearTimeout(timer);resolve({pid:p.pid??null,exitCode,signal,failure,stdout:Buffer.concat(raw.stdout),stderr:Buffer.concat(raw.stderr)});});});
await save('stdout.txt',result.stdout);await save('stderr.txt',result.stderr);const after=await fingerprints();await json('source-after.json',after);const tap=result.stdout.toString(),summary=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(n=>[n,Number(tap.match(new RegExp('^# '+n+' (\\d+)$','m'))?.[1]??-1)])),receipt={schema:'rea-notes-cancel-open-note-correction-attempt/v1',kind,startedAt,completedAt:new Date().toISOString(),arguments:args,summary,sourceFiles:before.length,sourceStable:JSON.stringify(before)===JSON.stringify(after),sourceBefore:before,sourceAfter:after,runtime:{version:process.version,sha256:hash(await fs.readFile(process.execPath))},pid:result.pid,exitCode:result.exitCode,signal:result.signal,failure:result.failure,raw:{stdout:{path:'stdout.txt',bytes:result.stdout.length,sha256:hash(result.stdout)},stderr:{path:'stderr.txt',bytes:result.stderr.length,sha256:hash(result.stderr)}},originalWholeProgramExecutions:0,originalGUISessions:0,sourceHelperAccounting:kind==='focused'?'Replayed bounded Joplin helper cases; exact observed helper accounting must be derived separately before acceptance.':'No original library or source-helper invocation in this one-case UI/backend model.',actualBrowserExecutions:0,benchmarks:0,productionModified:false,fullProductParity:false,universalSuperiority:false};await json('attempt.json',receipt);console.log(JSON.stringify({run:run,kind,summary,sourceFiles:before.length,sourceStable:receipt.sourceStable,exitCode:result.exitCode}));assert.equal(result.failure,null);assert.equal(receipt.sourceStable,true);assert.equal(summary.skipped+summary.cancelled+summary.todo,0);if(kind==='negative'){assert.equal(result.exitCode,1);assert.equal(summary.tests,1);assert.equal(summary.fail,1);}else{assert.equal(result.exitCode,0);assert.equal(summary.tests,kind==='focused'?69:1);assert.equal(summary.pass,summary.tests);}
