    },
    {
      "id": "grafana.candidate.92a554d7b90d4f2a332d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Team-based Label-Based Access Control (LBAC) for the Prometheus data source requires the backend to be **Grafana Cloud Metrics (Mimir)** or **Grafana Enterprise Metrics (GEM)**. LBAC doesn't work with external Prometheus-compatible endpoints such as Google Managed Prometheus, self-managed Prometheus, or Thanos. The LBAC enforcement relies on Mimir-specific HTTP headers that other backends don't support.",
      "headingPath": [
        "Configure the Prometheus data source",
        "Configuration options",
        "Performance"
      ],
      "source": {
        "path": "docs/sources/datasources/prometheus/configure/_index.md",
        "gitBlobSha": "a1a3fd736210bc04f6d5396f44fbd51007b0b737",
        "sha256": "8f55c60524f648dcca948fcbb550ecdf916cf54bf2cc152f1e84db0d2c51c35b",
        "lineStart": 158,
        "lineEnd": 158,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/prometheus/configure/_index.md#L158-L158"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.f3718fc373cf372ead7c",
      "syntaxRole": "list-item",
      "sourceText": "- **Cache level** - Sets the browser caching level for editor queries. Options: `Low`, `Medium`, `High`, or `None`. Higher cache settings are recommended for high-cardinality data sources.",
      "headingPath": [
        "Configure the Prometheus data source",
        "Configuration options",
        "Performance"
      ],
      "source": {
        "path": "docs/sources/datasources/prometheus/configure/_index.md",
