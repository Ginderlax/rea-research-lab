    {
      "id": "grafana.candidate.19c207d1ec91ef3de412",
      "syntaxRole": "list-item",
      "sourceText": "- `-p <host-port>:<container-port>` (`--publish`) publish a container's port(s) to the host, allowing you to reach the container's port via a host port. In this case, we can reach the container's port `3000` via the host's port `3000`",
      "headingPath": [
        "Run Grafana Docker image",
        "Run Grafana via Docker CLI"
      ],
      "source": {
