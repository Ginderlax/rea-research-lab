      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss",
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.ffb968d9d12a5d5bd036",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For example, if you're using GitHub App to authenticate, the connection represents the app installation. Grafana uses this connection to authenticate with GitHub, create access tokens, and authorize repository access on your behalf.",
      "headingPath": [
        "Git Sync key concepts",
        "Key Git Sync components",
        "Git Sync connection resource"
      ],
