    {
      "id": "grafana.candidate.7484e2f88acc3a94e1f0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Ceil rounds the number up to the nearest integer value. For example, `ceil(3.123)` returns 4.",
      "headingPath": [
