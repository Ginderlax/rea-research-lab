      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.18b2ce6eea2e96d0a310",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana Enterprise is a commercial edition of Grafana that includes additional features not found in the open source version.",
      "headingPath": [
        "Grafana Enterprise"
      ],
      "source": {
        "path": "docs/sources/introduction/grafana-enterprise.md",
        "gitBlobSha": "e38a5224ae017dd1425773dd44ad264a1b93350e",
