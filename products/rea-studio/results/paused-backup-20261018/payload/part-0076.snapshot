      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.198d8bf5f2f9144e1a30",
      "syntaxRole": "table-row",
      "sourceText": "| `$__timeGroup(<column>)`      | Groups results by a time interval using `date_bin()` with `$__interval`. Column must be a timestamp.                                                                                                |",
      "headingPath": [
        "InfluxDB query editor",
        "SQL query editor",
        "Macros"
      ],
      "source": {
