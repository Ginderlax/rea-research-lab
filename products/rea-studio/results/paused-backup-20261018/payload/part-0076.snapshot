    {
      "id": "grafana.candidate.f1ca86b8218fd3febce8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When querying Graphite metrics in Grafana, you can choose between using an **expanded** or **non-expanded** query:",
      "headingPath": [
        "Graphite template variables",
        "Use other query variables",
        "Compare expanded and non-expanded metric search results"
      ],
      "source": {
