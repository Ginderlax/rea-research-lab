    {
      "id": "grafana.candidate.173d52dcb3e009b618a4",
      "syntaxRole": "list-item",
      "sourceText": "- Permissions to list, grant, and revoke roles to teams are removed.",
      "headingPath": [
        "Manage RBAC roles",
        "Update role permissions",
