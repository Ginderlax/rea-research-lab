        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/as-code/observability-as-code/git-sync/scenarios/testing-sandboxes.md#L176-L176"
      },
      "applicability": {
        "status": "unresolved-no-explicit-oss-products-label",
        "products": []
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.bcd39e12185837d5c77e",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Develop in the sandbox instance (synced to the sandbox branch with the `write` workflow).",
      "headingPath": [
        "Testing sandboxes with Git Sync",
        "Promote a sandbox to main",
        "Option 3: Promote through a separate instance or path"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/git-sync/scenarios/testing-sandboxes.md",
