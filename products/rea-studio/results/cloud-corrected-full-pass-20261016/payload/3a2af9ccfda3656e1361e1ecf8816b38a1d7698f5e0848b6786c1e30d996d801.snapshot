import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import {spawnSync} from 'node:child_process';
import {createHash} from 'node:crypto';
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab');
const run=process.argv[2],reader=process.argv[4]??'none';let expectedJob=process.argv[3];
assert(['38824829652','38824829904','38824829929','38824835014','38824834990','38824834967','38824835008','38824834964','38824834985','38826463509','38826463567','38826470332','38826470331','38826463539','38826470337','38826470338','38826470348','38826470376','38828050485','38828050456','38828050454','38828050473','38828050461','38828050460','38828044782','38903252563','38903745255','38903745166','38903745664','38903745245','38903745096','38903745075','38903738181','38903258061','38903258223','38903258144','38903258032','38903258022','38903258107','38905581634','38905581957','38905581818','38905581840','38905581709','38905573339','38907053651','38907054140','38907053817','38907053566','38907053655','38907042178','38907306502','38907306675','38907306490','38907306445','38907306659','38908773029','38908773120','38908773135','38908772822','38908772777','38911251888','38911252546','38911251837','38911252713','38911251916','38911241479'].includes(run));assert(expectedJob==='auto'||/^\d+$/.test(expectedJob));assert(['audit','full','publication','browser','archive-browser','none'].includes(reader));
const hash=b=>createHash('sha256').update(b).digest('hex');
async function exists(p){try{await fs.access(p);return true;}catch(e){if(e.code==='ENOENT')return false;throw e;}}
const credential=spawnSync('git',['credential','fill'],{cwd:lab,env:{...process.env,GIT_TERMINAL_PROMPT:'0',GCM_INTERACTIVE:'Never'},input:'protocol=https\nhost=github.com\n\n',encoding:'utf8',windowsHide:true,timeout:20000});assert.equal(credential.status,0,'Saved authentication unavailable');const fields=Object.fromEntries(credential.stdout.split('\n').filter(x=>x.includes('=')).map(x=>{const i=x.indexOf('=');return[x.slice(0,i),x.slice(i+1)];}));assert(fields.password);
const headers={Accept:'application/vnd.github+json','User-Agent':'REA-cloud-verification','X-GitHub-Api-Version':'2022-11-28',Authorization:'Bearer '+fields.password};
const folder=path.join(work,'cloud-verification-backups','run-'+run);let control=path.join(folder,'control-plane-evidence');
if(await exists(path.join(control,'run.json'))){const prior=JSON.parse(await fs.readFile(path.join(control,'run.json'),'utf8'));if(prior.status!=='completed')control=path.join(folder,'control-plane-evidence-observation-'+new Date().toISOString().replace(/[:.]/g,'-'));}
await fs.mkdir(control,{recursive:true});
const records=await Promise.all(['run','jobs','artifacts'].map(async kind=>{const target=path.join(control,kind+'.json');let bytes;if(await exists(target))bytes=await fs.readFile(target);else{const endpoint='https://api.github.com/repos/Ginderlax/rea-research-lab/actions/runs/'+run+(kind==='run'?'':'/'+kind);const response=await fetch(endpoint,{headers,signal:AbortSignal.timeout(60000)});assert.equal(response.status,200);bytes=Buffer.from(await response.arrayBuffer());assert(bytes.length<=512*1024);JSON.parse(bytes);await fs.writeFile(target,bytes,{flag:'wx'});}return{kind,path:target,bytes:bytes.length,sha256:hash(bytes),value:JSON.parse(bytes)};}));
const [actual,jobs,artifacts]=records.map(x=>x.value);assert.equal(String(actual.id),run);assert.equal(actual.head_branch,'codex/rea-cloud-recovery-20261015');if(["38911251888","38911252546","38911251837","38911252713","38911251916","38911241479"].includes(run))assert.equal(actual.head_sha,'016ecd175c0700d1a94d5219af6719989a4a6e45');if(expectedJob==='auto'){assert.equal(jobs.jobs.length,1);expectedJob=String(jobs.jobs[0].id);}const job=jobs.jobs.find(j=>String(j.id)===expectedJob);assert(job);assert(job.labels.includes('windows-2022'));assert.equal(job.runner_group_name,'GitHub Actions');
const summary={schema:'rea-readonly-completed-run-collection/v1',collectedAt:new Date().toISOString(),runId:run,jobId:expectedJob,headSHA:actual.head_sha,runStatus:actual.status,runConclusion:actual.conclusion,jobConclusion:job.conclusion,metadata:records.map(({value,...r})=>r),artifacts:[],localProductExecutions:0,localTests:0,localBuilds:0};
if(actual.status!=='completed'){console.log(JSON.stringify({...summary,collectionState:'Nonterminal snapshot; no artifact completion claimed.'}));process.exit(0);}
function helper(...args){const result=spawnSync(process.execPath,[path.join(work,'rea-cloud-github.mjs'),...args],{encoding:'utf8',windowsHide:true,timeout:180000,maxBuffer:3*1024*1024});assert.equal(result.status,0,result.stderr);return JSON.parse(result.stdout);}
const log=path.join(work,'cloud-verification-backups','job-'+expectedJob,'logs.txt');if(!await exists(log))helper('logs',expectedJob);const logBytes=await fs.readFile(log);summary.rawJobLog={path:log,bytes:logBytes.length,sha256:hash(logBytes)};
for(const artifact of artifacts.artifacts){const digest=artifact.digest?.replace(/^sha256:/,'');assert(/^[0-9a-f]{64}$/.test(digest));assert.equal(artifact.expired,false);const zip=path.join(folder,'artifact-'+artifact.id+'.zip');if(!await exists(zip))helper('download',String(artifact.id),run);const raw=await fs.readFile(zip);assert.equal(raw.length,artifact.size_in_bytes);assert.equal(hash(raw),digest);
 const verificationFile=path.join(folder,'artifact-'+artifact.id,reader==='archive-browser'?'local-archive-browser-backup-verification.json':reader==='browser'?'local-browser-backup-verification.json':'local-backup-verification.json');
 if(reader!=='none'&&!await exists(verificationFile)){const selected=reader==='publication'?'unpack-publication-attempt.py':reader==='archive-browser'?'unpack-archive-browser-cloud-attempt.py':reader==='browser'?'unpack-browser-cloud-attempt.py':'unpack-cloud-attempt.py';const args=reader==='audit'?[path.join(work,'unpack-proof-delivery-audit.py'),zip,digest,run,actual.head_sha]:[path.join(work,selected),zip,digest];const result=spawnSync('C:/Users/evanh/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/python.exe',args,{encoding:'utf8',windowsHide:true,timeout:120000,maxBuffer:4*1024*1024});assert.equal(result.status,0,result.stderr);}
 const row={artifactId:artifact.id,bytes:raw.length,sha256:digest,path:zip,readabilityVerified:reader!=='none'};if(reader!=='none'){const v=JSON.parse(await fs.readFile(verificationFile,'utf8'));assert.equal(v.allCRCAndBytesReadable,true);row.localBackupVerification=verificationFile;row.readableFileCount=v.files.length;row.audit=v.audit;row.attempts=v.attempts;row.attempt=v.attempt;row.controls=v.controls;}summary.artifacts.push(row);
}
const summaryFile=path.join(folder,reader==='none'?'collection-download-summary.json':'collection-summary.json');if(!await exists(summaryFile))await fs.writeFile(summaryFile,JSON.stringify(summary,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(summary));
