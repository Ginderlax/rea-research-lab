import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import {createHash} from 'node:crypto';
import {createRequire} from 'node:module';
import {pathToFileURL} from 'node:url';
const work=import.meta.dirname,stage=path.join(work,'metrics-wrapper-diagnosis-next'),out=path.join(work,'metrics-wrapper-root-independent-review'),sha=b=>createHash('sha256').update(b).digest('hex');await fs.mkdir(out,{recursive:true});
await fs.writeFile(path.join(out,'collector.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});const frozenBytes=await fs.readFile(path.join(stage,'freeze-manifest.json'));assert.equal(sha(frozenBytes),'55eea122f303d283c04338d9808859eff7f473dd0139df7c9259ad230a19281d');const frozen=JSON.parse(frozenBytes);assert.equal(frozen.entries.length,86);assert.equal(frozen.receiptSHA256,'7ffee009de87619862896553cab68d7c2284010d81cac0a1a537da195406fdc6');
async function authenticate(){const seen=new Set();for(const e of frozen.entries){assert.ok(!e.path.startsWith('/')&&!e.path.includes('\\')&&!e.path.split('/').includes('..'));assert.ok(!seen.has(e.path));seen.add(e.path);const b=await fs.readFile(path.join(stage,e.path));assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256);}}
await authenticate();const candidateBytes=await fs.readFile(path.join(stage,'candidate-wrapper.mjs')),baselineBytes=await fs.readFile(path.join(stage,'candidate-baseline.mjs'));assert.equal(sha(candidateBytes),'b3feba481b9ceaad6dce4dfca0c2e264b1e1dcfbb2499192e74b48ef92baace0');assert.equal(sha(baselineBytes),'9269cf8c32be9bf2c075b67019e82e41272d9495f0321fefc17b2c5695a91371');const text=candidateBytes.toString(),inverted=text.replace("import { singlePercentile } from './selector-algorithm.mjs';\n",'').replace('    if (!shared) return singlePercentile(id, field, ignore, zero);\n','');assert.equal(inverted,baselineBytes.toString(),'Only the two declared additions are permitted.');
const {authenticateOriginal}=await import(pathToFileURL(path.join(stage,'authenticate-original.mjs'))),authority=await authenticateOriginal(),original=createRequire(authority.entry)(authority.entry),candidate=await import(pathToFileURL(path.join(stage,'candidate-wrapper.mjs')));
let seed=0x6d9e42aa;const next=()=>{seed^=seed<<13;seed^=seed>>>17;seed^=seed<<5;return seed>>>0;};const cases=[['root-dense-257',Array.from({length:257},()=>((next()%50003)-25001)/16)],['root-descending-ties',Array.from({length:1025},(_,i)=>Math.floor((1025-i)/7)/32)],['root-saw',Array.from({length:9991},(_,i)=>(i%127-63)/8)],['root-equal',Array(513).fill(0.0625)],['root-signed-zero',[0,-0,0,-0,4,null]],['root-sparse',Object.assign(Array(9),{1:0,3:7,7:2})],['root-coercion',['18',true,false,null,-9,2,'3']],['root-nonfinite',[Infinity,-Infinity,NaN,3,null]],['root-empty',[]]];
const reducerSets=[['p31'],['p92'],['p1','p31','p57','p92'],['p92','p92'],['mean','sum','min','max','delta','p92'],['avg','count','first','last'],['unknown','p31'],[]],observations=[];let packetCalls=0,directRegistryCalls=0,cacheSubsetCalls=0;
for(const[name,values]of cases){for(const mode of ['null','connected','null as zero'])for(const reducers of reducerSets){const make=()=>({type:'number',config:{nullValueMode:mode},values:values.slice(),state:{calcs:{unrelated:'root-fresh-wrapper-review'}}}),a=make(),b=make(),expected=original.reduceField({field:a,reducers}),actual=candidate.reduceField({field:b,reducers});assert.deepEqual(actual,expected,`${name}/${mode}/${reducers}`);assert.deepEqual(b.state,a.state);assert.deepEqual(b.values,values);packetCalls++;const subset=['p31'];assert.deepEqual(candidate.reduceField({field:b,reducers:subset}),original.reduceField({field:a,reducers:subset}));assert.deepEqual(b.state,a.state);cacheSubsetCalls++;}for(const[id,ignore,zero]of ['p1','p31','p57','p92'].flatMap(id=>[[id,false,false],[id,true,false],[id,false,true]])){const a={type:'number',config:{},values:values.slice()},b={type:'number',config:{},values:values.slice()};assert.deepEqual(candidate.fieldReducers.get(id).reduce(b,ignore,zero),original.fieldReducers.get(id).reduce(a,ignore,zero),`${name}/${id}/${ignore}/${zero}`);assert.deepEqual(b.values,values);directRegistryCalls++;}observations.push({name,samples:values.length,inputSHA256:sha(Buffer.from(JSON.stringify(values)))});}
await authenticate();const receipt={schema:'rea-metrics-wrapper-root-independent-review/v1',checkedAtUtc:new Date().toISOString(),passed:true,stageManifestSHA256:sha(frozenBytes),stageReceiptSHA256:frozen.receiptSHA256,authenticatedStageArtifacts:86,sourceStable:true,candidateSHA256:sha(candidateBytes),baselineSHA256:sha(baselineBytes),inverseDeclaredChangesReconstructBaseline:true,originalAuthority:authority,newCorpusSeed:'0x6d9e42aa',newCorpora:cases.length,originalPacketCalls:packetCalls,originalCacheSubsetCalls:cacheSubsetCalls,originalDirectRegistryCalls:directRegistryCalls,observations,inputStateAndArrayMutationChecked:true,ordinaryObjectsAndPrimitiveArraysOnly:true,arbitraryProxyGetterBehaviorVerified:false,newTimingMemoryOrProfilerRuns:0,productionChanged:false,fullCorrectness:false,fullPerformanceParity:false,universalSuperiority:false};await fs.writeFile(path.join(out,'review-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({passed:true,stageArtifacts:86,packetCalls,cacheSubsetCalls,directRegistryCalls,productionChanged:false}));
