  "runtimeFindings": [],
  "documentaryFindings": [
    {
      "reportedBy": "/root",
      "independentlyCorroborated": true,
      "path": "SOURCE-CONTRACTS.json",
      "contract": "KP.RECYCLE.EMPTY.001",
      "issue": "Initial wording includes refusal of an invalid root target as a provisional original contract, but pinned PwGroup.FindGroup returns this when its own UUID matches. MainForm EmptyRecycleBin does not show a separate root exclusion.",
      "source": "KeePassLib/PwGroup.cs:875–890, same complete-file d9b67e identity; MainForm_Functions.cs:5308–5344",
      "requiredQualification": "Separate original UUID lookup/missing-bin behavior from the candidate safer root-bin refusal policy; add FindGroup line span and declare the policy deviation.",
      "runtimeChangeRequired": false,
      "status": "Parent requested a forthcoming doc-only revision; this review preserves the initial181f epoch and does not pre-approve unknown revised bytes."
    }
  ],
  "observations": [
    "Native model materializes/parses a private XML tree. The separate empty-bin HMAC domain covers normalized complete XML and attachment graph plus exact bin UUID; literal true confirmation and exact current token precede mutation.",
    "Needed tombstones count descendant groups plus active entries, excluding retained bin and history versions; capacity and one canonical UTC clock validate before XML edits. Direct entries precede recursive child objects and child group postorder.",
    "Existing tombstones, normalized bin/settings/outside subtree and attachment table remain. One candidate operation time versus released per-group UTC capture is explicitly disclosed; no unadapted original parity is claimed.",
    "Server actions use captured plain input and existing per-workspace serialization. Changed staged data is encrypted/persisted before same-session publication; failed writes keep current session untouched and an already-empty result performs no backend rewrite.",
    "UI checks current row/view/panel generations, group/entry effects and entry/group drafts before mutation. Mutation invalidates entry/bin reads, preview refresh invalidates old confirmation, and failed persistence leaves a fresh unchecked preview necessary.",
    "Preview API exposes names/title/username/URL/counts, not passwords/notes/history/attachment payloads. Existing input scrub and view disposal guards are reused; no whole-memory or comparative security claim follows.",
    "Authored tests source-read as nine native, five encrypted-server/queue and six DOM-model groups. Held DOM fixture responses occur after actual candidate server results, with owned cleanup; they are not real browser evidence."
  ],
  "nonblockingCoverageGaps": [
    {
      "area": "server",
      "gap": "No newly authored test disposes/locks the same session during a held encrypted store write. The same-session publish guard appears correct by source; an explicit hosted regression would establish this path."
    },
