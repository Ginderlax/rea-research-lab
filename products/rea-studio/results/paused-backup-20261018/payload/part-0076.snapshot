    },
    {
      "id": "grafana.candidate.871a1bc9f835c5817ab7",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Install the private CA certificate on the PDC agent host's system trust store.",
      "headingPath": [
        "Troubleshoot Microsoft SQL Server data source issues",
