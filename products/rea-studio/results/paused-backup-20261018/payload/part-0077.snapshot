    {
      "id": "grafana.candidate.76a0c0ac93a7cd7a6b1c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By using Team Sync, you can map teams from your GitHub organization to teams within Grafana. This will automatically assign users to the appropriate teams. Teams for each user are synchronized when the user logs in.",
      "headingPath": [
        "Configure GitHub OAuth authentication",
