import fs from 'node:fs/promises';import path from 'node:path';import {spawn} from 'node:child_process';import {createHash} from 'node:crypto';
const root=import.meta.dirname,old=path.resolve(root,'../keepass-recycle-next'),run=path.join(root,'runs','old546-same-generation'),hash=b=>createHash('sha256').update(b).digest('hex');await fs.mkdir(run,{recursive:true});
async function auth(){const b=await fs.readFile(path.join(old,'manifest.json'));if(hash(b)!=='769523b00c626762f18aec86ee8df8f1bb317ff4bbc8147a09a03af44161c100')throw new Error('Old manifest');const m=JSON.parse(b);for(const r of m.records??m.files){const b=await fs.readFile(path.join(old,r.path));if(b.length!==r.bytes||hash(b)!==r.sha256)throw new Error('Old changed '+r.path);}}
await auth();const helper=(await fs.readFile(path.join(root,'prior-independent-failures/ui-helper.mjs.snapshot'),'utf8')).replace('../keepass-recycle-next/products/rea-studio/apps/vault/','../../../keepass-recycle-next/products/rea-studio/apps/vault/');await fs.writeFile(path.join(run,'ui-helper.mjs'),helper);await fs.copyFile(path.join(root,'regression/same-generation-preview.test.mjs'),path.join(run,'same-generation-preview.test.mjs'));const sources=[];for(const name of['client.mjs','server.mjs','recycle.mjs','kdbx.mjs','history.mjs','xml.mjs']){const b=await fs.readFile(path.join(old,'products/rea-studio/apps/vault',name));await fs.writeFile(path.join(run,name+'.snapshot'),b);sources.push({path:'work/keepass-recycle-next/products/rea-studio/apps/vault/'+name,bytes:b.length,sha256:hash(b)});}await fs.writeFile(path.join(run,'source-before.json'),JSON.stringify(sources,null,2)+'\n');
const env={...process.env};delete env.NODE_TEST_CONTEXT;const p=spawn(process.execPath,['--test','--test-reporter=tap',path.join(run,'same-generation-preview.test.mjs')],{windowsHide:true,env,stdio:['ignore','pipe','pipe']}),logs={stdout:[],stderr:[]};let problem=null,total=0;const timer=setTimeout(()=>{problem='deadline';p.kill()},30000);for(const k of['stdout','stderr'])p[k].on('data',b=>{total+=b.length;if(total>2*1024*1024){problem='capture';p.kill()}else logs[k].push(b)});p.on('error',e=>problem=e.message);const code=await new Promise(r=>p.on('close',r));clearTimeout(timer);for(const k of['stdout','stderr'])await fs.writeFile(path.join(run,k+'.txt'),Buffer.concat(logs[k]));await auth();await fs.writeFile(path.join(run,'validation.json'),JSON.stringify({completedAt:new Date().toISOString(),code,problem,stage546AuthenticatedBeforeAfter:true,originalExecutions:0,hostProcesses:0,scope:'Existing-source held-out reproduction using exact frozen cd5005 client/backend; copied unchanged new body and explicit helper path-only retarget',sources},null,2)+'\n');console.log(JSON.stringify({run,code,problem,stage546Stable:true}));process.exitCode=code;
