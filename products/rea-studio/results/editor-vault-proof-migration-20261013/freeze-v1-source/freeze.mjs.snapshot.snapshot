function files(p='',out=[]){for(const d of readdirSync(resolve(stage,p),{withFileTypes:true})){assert(!d.isSymbolicLink());const n=p?p+'/'+d.name:d.name;if(d.isDirectory())files(n,out);else{assert(d.isFile());out.push(n);assert(out.length<=60000);}}return out;}
