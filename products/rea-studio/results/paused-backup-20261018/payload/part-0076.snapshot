    {
      "id": "grafana.candidate.204bb54d419189015664",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Starting with Grafana 13.2, the MySQL data source is a standalone plugin, preinstalled in both Grafana OSS and Grafana Enterprise. This enables more frequent updates independent of Grafana releases. Grafana automatically checks the plugin catalog and installs the latest version on each server restart.",
      "headingPath": [
        "MySQL data source",
        "Plugin updates"
      ],
      "source": {
        "path": "docs/sources/datasources/mysql/_index.md",
        "gitBlobSha": "9fde1a8eb2e0ada1e068ae413626e582048b8d0e",
        "sha256": "f7763603b332bcc5b6da2b09f1b7d3b999d0b0988dbf23b7747c56d1e0902fae",
