    },
    {
      "id": "grafana.candidate.88a63b9cbb0765623b95",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In this example, the user has been granted the role of an `Editor`. The role assigned is based on the value of the property `role`, which must be a valid Grafana role such as `Admin`, `Editor`, `Viewer` or `None`.",
      "headingPath": [
        "Configure Generic OAuth authentication",
        "Configure generic OAuth authentication client using the Grafana configuration file",
        "Configure role mapping",
        "Role mapping examples",
        "Map user organization role"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/generic-oauth/index.md",
        "gitBlobSha": "996494cdc76551860001d5497ab4650b4563badf",
        "sha256": "93bacfb30c084c7dd0e225675e875cd091c4a0ef7a5053c330ccb6c9cd367d87",
        "lineStart": 280,
        "lineEnd": 280,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/generic-oauth/index.md#L280-L280"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.17daaf2748c768049cef",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In the following more complex example, the user has been granted the `Admin` role. This is because they are a member of the `admin` group of their OAuth2 provider. If the user was a member of the `editor` group, they would be granted the `Editor` role, otherwise `Viewer`.",
      "headingPath": [
        "Configure Generic OAuth authentication",
        "Configure generic OAuth authentication client using the Grafana configuration file",
        "Configure role mapping",
        "Role mapping examples",
        "Map user organization role"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/generic-oauth/index.md",
        "gitBlobSha": "996494cdc76551860001d5497ab4650b4563badf",
        "sha256": "93bacfb30c084c7dd0e225675e875cd091c4a0ef7a5053c330ccb6c9cd367d87",
        "lineStart": 298,
        "lineEnd": 299,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/generic-oauth/index.md#L298-L299"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
