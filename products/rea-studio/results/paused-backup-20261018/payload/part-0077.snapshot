    {
      "id": "grafana.candidate.4420a19a7cd4e6659b93",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This feature is available for both for OAuth and SAML. Ensure that after fixing the issue, you remove the parameter or revert the configuration to re-enable the automatic login feature, if desired.",
      "headingPath": [
        "Configure authentication",
        "Extended authentication settings",
        "Avoid automatic login",
        "How to use"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/_index.md",
