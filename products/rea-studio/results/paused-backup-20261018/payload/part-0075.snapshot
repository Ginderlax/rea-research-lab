      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.a18a000fe053df4991bf",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Each data source comes with a _query editor_, which formulates custom queries according to the source's structure. After you add and configure a data source, you can use it as an input for many operations, including:",
      "headingPath": [
        "Data sources"
      ],
