    {
      "id": "grafana.candidate.fd0a15e4fe511541f915",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Alert rules require queries that return numeric data that Grafana can evaluate against a threshold. Wrap a Loki log query in a LogQL metric function, such as `rate` or `count_over_time`, to produce numeric time series.",
      "headingPath": [
        "Loki alerting",
        "Supported queries for alerting"
      ],
      "source": {
        "path": "docs/sources/datasources/loki/alerting/index.md",
