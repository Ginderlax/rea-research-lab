    },
    {
      "id": "grafana.candidate.a83e05d5cd82ba45fe2f",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Set the callback URL for your GitHub OAuth app to `http://<my_grafana_server_name_or_ip>:<grafana_server_port>/login/github`.",
      "headingPath": [
        "Configure GitHub OAuth authentication",
        "Configure GitHub authentication client using the Grafana configuration file",
        "Configure GitHub authentication"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/github/index.md",
        "gitBlobSha": "d2e6241054e4dfdceaf82864b39f2c01b645d35b",
        "sha256": "e3144b4bb1bc579850a537917ef83ed365c13e124ab10db7f6446154676a14c4",
        "lineStart": 91,
        "lineEnd": 91,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/github/index.md#L91-L91"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b30e8e8b1a62ade05fb2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Ensure that the callback URL is the complete HTTP address that you use to access Grafana via your browser, but with the appended path of `/login/github`.",
      "headingPath": [
        "Configure GitHub OAuth authentication",
        "Configure GitHub authentication client using the Grafana configuration file",
        "Configure GitHub authentication"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/github/index.md",
        "gitBlobSha": "d2e6241054e4dfdceaf82864b39f2c01b645d35b",
