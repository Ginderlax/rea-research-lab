import fs from'node:fs/promises';import path from'node:path';import{fileURLToPath}from'node:url';import{createHash}from'node:crypto';import assert from'node:assert/strict';
const own=path.dirname(fileURLToPath(import.meta.url)),workspace=path.resolve(own,'../..'),sha=b=>createHash('sha256').update(b).digest('hex'),finalName='final-attachment-focused-v3';
const baseline=JSON.parse(await fs.readFile(path.join(own,'baseline-source.json'),'utf8'));const productionAfter=[];for(const r of baseline.files){const b=await fs.readFile(path.join(workspace,r.source));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);const frozen=await fs.readFile(path.join(own,r.destination));assert.ok(b.equals(frozen));productionAfter.push({...r});}
const authority=JSON.parse(await fs.readFile(path.join(own,'authority-baseline.json'),'utf8'));for(const row of [authority.originalExe,...authority.originalSource,...authority.manual]){const b=await fs.readFile(path.join(workspace,row.source));assert.equal(b.length,row.bytes);assert.equal(sha(b),row.sha256);if(row.destination)assert.ok(b.equals(await fs.readFile(path.join(own,row.destination))));}
const contracts=JSON.parse(await fs.readFile(path.join(own,'contract-map.json'),'utf8')),archive=await fs.readFile(path.join(workspace,contracts.sourceArchive.path));assert.equal(sha(archive),contracts.sourceArchive.sha256);assert.equal(archive.length,contracts.sourceArchive.bytes);
const run=JSON.parse(await fs.readFile(path.join(own,'runs',finalName,'run.json'),'utf8'));assert.equal(run.exit.code,0);assert.equal(run.sourceStable,true);const stdout=await fs.readFile(path.join(own,'runs',finalName,'stdout.txt'),'utf8'),counts=Object.fromEntries(['tests','pass','fail','skipped'].map(k=>[k,Number(stdout.match(new RegExp('ℹ '+k+' (\\d+)'))?.[1])]));assert.deepEqual(counts,{tests:67,pass:67,fail:0,skipped:0});for(const r of run.before){const b=await fs.readFile(path.join(own,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);assert.ok(b.equals(await fs.readFile(path.join(own,'runs',finalName,'source',path.basename(r.path)+'.snapshot'))));}
const original=JSON.parse(await fs.readFile(path.join(own,'runs',finalName,'observations/group-original.json'),'utf8'));assert.equal(original.length,15);const originalCalls={};for(const r of original){assert.equal(r.exit.code,0);assert.equal(r.assemblyLoads,1);assert.equal(r.value.calls.assemblyLoads,1);for(const[k,v]of Object.entries(r.value.calls))originalCalls[k]=(originalCalls[k]??0)+v;}assert.equal(originalCalls.originalGUI,0);assert.equal(originalCalls.originalProgram,0);
const testCensus=[];for(const name of run.tests){const b=await fs.readFile(path.join(own,'products/rea-studio/apps/vault',name)),definitions=(b.toString().match(/\btest\s*\(/g)||[]).length;const additionalParameterizedExecutions=['recycle-boundaries.test.mjs','recycle-controls.test.mjs'].includes(name)?1:0;if(additionalParameterizedExecutions)assert.ok(b.toString().includes("for(const operation of ['restore','purge'])test("));testCensus.push({name,staticTestCalls:definitions,additionalParameterizedExecutions,definitions:definitions+additionalParameterizedExecutions,bytes:b.length,sha256:sha(b),epoch:name.startsWith('group-')?'new group':'unchanged prior regression'});}assert.equal(testCensus.reduce((n,r)=>n+r.definitions,0),67);
const attempts=[];for(const n of(await fs.readdir(path.join(own,'runs'))).sort()){const p=path.join(own,'runs',n,'run.json');try{const value=JSON.parse(await fs.readFile(p,'utf8')),out=await fs.readFile(path.join(own,'runs',n,'stdout.txt'),'utf8');let loads=0;try{loads=JSON.parse(await fs.readFile(path.join(own,'runs',n,'observations/group-original.json'),'utf8')).reduce((n,r)=>n+r.assemblyLoads,0)}catch(e){if(e.code!=='ENOENT')throw e;}attempts.push({name:n,run:{bytes:(await fs.readFile(p)).length,sha256:sha(await fs.readFile(p))},sourceStable:value.sourceStable,exit:value.exit,tests:Number(out.match(/ℹ tests (\d+)/)?.[1]),pass:Number(out.match(/ℹ pass (\d+)/)?.[1]),fail:Number(out.match(/ℹ fail (\d+)/)?.[1]),originalAssemblyLoads:loads});}catch(e){if(e.code!=='ENOENT')throw e;}}
const ledger={schema:'rea-keepass-group-failure-ledger/v1',entries:[{attempt:'initial direct native run',result:'7pass/1fail',raw:'Original tool output was not redirected; exact source-preserved replay native-v1-exact-replay retains the same failure.',classification:'Owned fixture passed textual ISO instead of native encoded DeletionTime; no candidate runtime change.'},{attempt:'native-v1-exact-replay',result:'7pass/1fail',classification:'Exact replay of native timestamp fixture error; corrected fixture uses encodeKdbxDate.'},{attempt:'bounds-v3',result:'9pass/2fail',classification:'Fixture helper projected duplicate UUID before intended assertion; deep fixture exceeded existing256-char path before intended XML depth test. Corrected construction preserves early rejection and reaches desired boundary.'},{attempt:'final-attachment-focused',result:'60pass/7fail',classification:'Owned comparison assumed an absent entry Binaries container; no candidate runtime change.'},{attempt:'final-attachment-focused-v2',result:'66pass/1fail',classification:'Owned attachment fixture invented Entry/Binaries nesting. Original writer/read source uses direct Entry/Binary. Original ignored the unknown container; native preserves unknown XML by design. Corrected direct Binary+Ref fixture passes both.'},{attempt:'metadata/preparation',result:'Two rejected patch anchors; no bytes changed by those rejected calls.',classification:'Partial import-line and guessed README heading did not match; inspected exact line before successful patch.'},{attempt:'first freeze source-census accounting',result:'Metadata assertion65 static calls vs67 actual tests; no validation/manifest written.',classification:'Two existing restore/purge loops each expand one test call into two tests. Preserve old finalizer exact; new metadata explicitly counts static65+parameterized2. No behavior rerun/rebinding.'},{attempt:'test-count planning',result:'Anticipated61 vs actual65 before attachment additions',classification:'Anchored line counting missed four same-line prior test definitions. Actual source census/transcript count is67 final =29new+38prior. Earlier messages/attempts remain unchanged.'}],candidateRuntimeFailuresConfirmed:0,fixtureFailuresNotReclassifiedAsProductFailures:true,postHocPerformanceThresholdChanges:0};await fs.writeFile(path.join(own,'failure-ledger.json'),JSON.stringify(ledger,null,2)+'\n');
const appPrefix='products/rea-studio/apps/vault/';const changed=run.before.filter(r=>{const base=baseline.files.find(b=>b.destination==='baseline/apps/vault/'+path.basename(r.path)+'.snapshot');return base&&base.sha256!==r.sha256;});const added=run.before.filter(r=>!baseline.files.some(b=>b.destination==='baseline/apps/vault/'+path.basename(r.path)+'.snapshot'));
const payloadProblems=[];async function scan(dir,relative=''){for(const e of await fs.readdir(dir,{withFileTypes:true})){const p=relative?relative+'/'+e.name:e.name;if(e.name==='.local'||p==='manifest.json'||p==='freeze.json')continue;if(e.isDirectory())await scan(path.join(dir,e.name),p);else{const b=await fs.readFile(path.join(dir,e.name));if(/\.(?:exe|dll|zip|7z|kdbx|tar|gz|zst)$/i.test(p)||b.subarray(0,2).equals(Buffer.from('MZ'))||b.subarray(0,2).equals(Buffer.from('PK')))payloadProblems.push(p);}}}await scan(own);assert.deepEqual(payloadProblems,[]);
const receipt={schema:'rea-keepass-group-candidate-validation/v1',createdAt:new Date().toISOString(),candidatePath:path.relative(workspace,own).replaceAll('\\','/'),finalRun:'runs/'+finalName+'/run.json',finalRunSHA256:sha(await fs.readFile(path.join(own,'runs',finalName,'run.json'))),counts,newGroupChecks:29,unchangedPriorRegressionChecks:38,testCensus,implementationFingerprints:run.before,productionBaseline:baseline,productionAfter,production46FilesUnchanged:true,originalAuthority:authority,originalSourceArchiveAfter:{bytes:archive.length,sha256:sha(archive)},changedExisting:changed,addedSourceFiles:added,original:{childProcesses:original.length,assemblyLoads:original.length,calls:originalCalls,scope:'Actual pinned managed release library/private helpers; source-composed MainForm group orchestration; disclosed synthetic UUID/clock adapters; GUI/full program0. Fields compared exactly without tolerance; broader original behavior not claimed.'},attempts,sourceStable:true,finalCollector:run.collector,sourceProvenance:'source-provenance.json',contractMap:'contract-map.json',failureLedger:'failure-ledger.json',bounds:{combinedXMLAndAttachmentBase64:8388608,groups:10000,entries:10000,tombstones:10000,xmlNodes:100000,xmlDepth:64,nativeGroupDepth:63,projectedGroupPathCharacters:256,commandInputBytes:12582912,commandInputDepth:64,commandInputNodes:100000},acceptance:{authorFiniteTests:true,independentReview:false,productionInstalled:false,actualBrowser:false,actualHTTPHost:false,originalGUI:false,fullFeatureParity:false,superiority:false},limits:['Closed active entry editor and clear draft before group effects; newer new-entry typing remains enabled.','Previous-parent restore subset only; no automatic fallback/general move/whole-bin empty/group create-edit-tags.','Original MaxDepth126 exceeds local native63/XML64/path256; unused bin expiry timestamp differs with Expiresfalse.','Original default-feature4.0 save can lose group previous parent; conditional4.1 retains it.','Unknown XML retained by candidate; original comparison only named metadata/history/binary fields.','No process memory isolation, blocked-IO deadline preemption or crash-atomicity/full-security/performance claim.'],payloadScan:{noNativeArchiveExecutableOrKDBXBytes:true,localDirectoriesExcluded:true,problems:payloadProblems},cleanup:{focusedNodeChildExit:0,originalChildrenAllExited:true,ownedTempCleanupsPassed:true,hostsStarted:0,browserTabsOpened:0,user4311Touched:false},repositoryWrites:0,registryWrites:0,historical159Sources232CapabilitiesUnchangedByCandidate:true};await fs.writeFile(path.join(own,'validation.json'),JSON.stringify(receipt,null,2)+'\n');
const inventory=[];async function walk(dir,relative=''){for(const e of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const p=relative?relative+'/'+e.name:e.name;if(e.name==='.local'||p==='manifest.json'||p==='freeze.json')continue;if(e.isDirectory())await walk(path.join(dir,e.name),p);else{const b=await fs.readFile(path.join(dir,e.name));inventory.push({path:p,bytes:b.length,sha256:sha(b)});}}}await walk(own);const manifest={schema:'rea-keepass-group-strict-preservation/v1',createdAt:new Date().toISOString(),pathsAreStrict:true,files:inventory.length,inventory,excluded:['.local/**','manifest.json','freeze.json'],originalBinariesCopied:false};const mb=Buffer.from(JSON.stringify(manifest,null,2)+'\n');await fs.writeFile(path.join(own,'manifest.json'),mb);const vb=await fs.readFile(path.join(own,'validation.json')),frozen={schema:'rea-keepass-group-candidate-freeze/v1',manifest:{path:'manifest.json',bytes:mb.length,sha256:sha(mb),records:inventory.length},validation:{path:'validation.json',bytes:vb.length,sha256:sha(vb)},frozenAt:new Date().toISOString(),appSourceFrozen:true,acceptancePendingIndependentReview:true};await fs.writeFile(path.join(own,'freeze.json'),JSON.stringify(frozen,null,2)+'\n');console.log(JSON.stringify({...frozen,sourceFiles:run.before.length,changed:changed.map(r=>({path:r.path,sha256:r.sha256,bytes:r.bytes})),originalCalls,tests:counts}));
