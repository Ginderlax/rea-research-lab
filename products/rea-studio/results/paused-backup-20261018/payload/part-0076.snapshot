        "lineStart": 79,
        "lineEnd": 79,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/loki/template-variables/index.md#L79-L79"
      },
      "applicability": {
