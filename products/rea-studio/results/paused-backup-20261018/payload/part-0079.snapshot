    {
      "id": "grafana.candidate.d75cec17cfba8c6ada74",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For Generic OAuth and Okta, you can configure the claim (using the `org_attribute_path` setting) that contains the organizations which the user belongs to. Other OAuth providers use the same attribute for organization mapping that is used for group mapping: Entra ID (previously Azure AD), GitLab and Google use the current user’s Groups, and GitHub uses the user’s Teams.",
      "headingPath": [
        "What’s new in Grafana v11.2",
        "Authentication and authorization",
        "Map org-specific user roles from your OAuth provider"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-2.md",
        "gitBlobSha": "ceccf569bb3670f6d3ae8c4db9fa3befbb8ef80a",
        "sha256": "e3947d9db32859fc717703f21b781da2366f7e2bda8dcfaeb51f1812ec5a1342",
        "lineStart": 255,
        "lineEnd": 255,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-2.md#L255-L255"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.68db37afd0c25faa31bc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To configure organization mapping for your instance, please check the documentation for the OAuth provider you are using in the [Grafana documentation](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-access/configure-authentication/). You can find an example of how to configure organization mapping on each OAuth provider page under the **Org roles mapping example** section.",
      "headingPath": [
        "What’s new in Grafana v11.2",
        "Authentication and authorization",
        "Map org-specific user roles from your OAuth provider"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-2.md",
