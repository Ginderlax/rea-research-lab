    },
    {
      "id": "grafana.candidate.356369c7b53a8d3650f7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana OSS and Grafana Enterprise users must store notification history in Loki. Set `enabled = true` in the `[unified_alerting.notification_history]` section and configure the connection to Loki. Refer to [Before you begin](#before-you-begin).",
      "headingPath": [
        "View notification history"
      ],
      "source": {
