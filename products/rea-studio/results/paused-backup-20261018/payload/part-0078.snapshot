        "lineEnd": 188,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/upgrade-guide/when-to-upgrade/index.md#L188-L188"
      },
      "applicability": {
