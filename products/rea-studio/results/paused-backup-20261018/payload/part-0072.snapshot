base=Path('C:/Users/evanh/Documents/Codex/2026-10-12/go');w=base/'work';repo=base/'outputs/rea-research-lab'
stage=w/'notes-new-todo-r2-next';candidate=stage/'candidate';previous=w/'notes-installed-tooling-phase3-r4-next'
pin=lambda b:{'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
p=candidate/'products/rea-studio/apps/notes/client.mjs';b=p.read_bytes()
a=b'    saveBusy=true;save.disabled=true;refreshTodo();'
