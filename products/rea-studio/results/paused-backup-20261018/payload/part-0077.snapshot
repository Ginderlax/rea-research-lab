    {
      "id": "grafana.candidate.84fa45872bb9e3c6e201",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Any configuration changes made through the Grafana user interface (UI) will take precedence over settings specified in the Grafana configuration file or through environment variables. This means that if you modify any configuration settings in the UI, they will override any corresponding settings set via environment variables or defined in the configuration file.",
      "headingPath": [
        "Configure SCIM provisioning",
        "Configure SCIM using the Grafana user interface"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-scim-provisioning/_index.md",
