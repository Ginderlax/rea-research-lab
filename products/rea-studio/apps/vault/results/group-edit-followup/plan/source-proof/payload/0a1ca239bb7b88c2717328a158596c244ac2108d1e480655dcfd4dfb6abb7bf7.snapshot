import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs/promises';import path from'node:path';import{mount,button,field,groupRow,click,type,walk,observations,deferred,ids}from'./ui-fixture.mjs';
test('fresh group edit preserves unknown fields/history and literal Unicode markup through encrypted reload with new revision',async t=>{
 const u=await mount(t,'native-edit-reload');const groups=(await u.direct('recycleGroupList',{bin:false})).groups,target=groups.find(g=>g.id===ids.target),entryBefore=(await u.direct('read',{id:ids.a})).entry;
 const notes='Own & <literal> 日本語\nline2',name='Selected & <literal>';await u.direct('groupSave',{id:target.id,revision:target.recycleRevision,name,notes});const changed=(await u.direct('recycleGroupList',{bin:false})).groups.find(g=>g.id===target.id);assert.equal(changed.name,name);assert.notEqual(changed.recycleRevision,target.recycleRevision);await assert.rejects(u.direct('groupSave',{id:target.id,revision:target.recycleRevision,name:'Stale',notes:'Stale'}),/selection changed/);const entryAfter=(await u.direct('read',{id:ids.a})).entry;assert.equal(entryAfter.id,entryBefore.id);assert.equal(entryAfter.password,entryBefore.password);assert(entryAfter.group.includes(name));const history=(await u.direct('historyList',{id:ids.a})).revisions;assert.equal(history.length,1);await u.direct('lock');await u.direct('unlock',{password:u.pass});const fresh=(await u.direct('recycleGroupList',{bin:false})).groups.find(g=>g.id===target.id),read=await u.direct('recycleGroupRead',{id:fresh.id,revision:fresh.recycleRevision});assert.equal(read.group.name,name);assert.equal(read.group.notes,notes);const document=(await u.direct('exportEncrypted')).document;assert(!JSON.stringify(document).includes(notes));observations.push({name:'native-edit-reload-proof',entryIdentityRetained:true,historyCount:history.length,name,notes,staleTokenRejected:true,encryptedReload:true});
});
test('fresh queued Create captures name/notes before await and rejects accessor inputs without calling getters',async t=>{
 const u=await mount(t,'queued-immutable-input'),parent=(await u.direct('recycleGroupList',{bin:false})).groups.find(g=>g.id===ids.target);const originalGet=u.store.get.bind(u.store),started=deferred(),release=deferred();let first=true;u.store.get=async(...args)=>{const result=await originalGet(...args);if(first){first=false;started.resolve();await release.promise;}return result;};const pendingStatus=u.direct('status');await started.promise;const input={id:parent.id,revision:parent.recycleRevision,name:'Captured child',notes:'Captured notes'},creating=u.direct('groupCreate',input);input.name='Changed after call';input.notes='Changed after call';release.resolve();await pendingStatus;const result=await creating;u.store.get=originalGet;const child=(await u.direct('recycleGroupList',{bin:false})).groups.find(g=>g.id===result.id),details=await u.direct('recycleGroupRead',{id:child.id,revision:child.recycleRevision});assert.equal(child.name,'Captured child');assert.equal(details.group.notes,'Captured notes');let getterCalls=0;const accessor={id:child.id,revision:child.recycleRevision,notes:'No write'};Object.defineProperty(accessor,'name',{enumerable:true,get(){getterCalls++;return'Accessor';}});await assert.rejects(u.direct('groupSave',accessor),/accessors/);assert.equal(getterCalls,0);observations.push({name:'queued-immutable-input-proof',newId:result.id,capturedName:child.name,capturedNotes:details.group.notes,getterCalls});
});
test('fresh pending group Save clears recycled preview and entry list before a real response, retaining newer New-entry draft',async t=>{
 const u=await mount(t,'entry-bin-invalidation');const active=(await u.direct('list')).entries.find(e=>e.id===ids.c);await u.direct('delete',{id:active.id,revision:active.recycleRevision,confirm:true});await click(button(u.root,'Search'));await click(button(u.root,'Show recycle bin'));await click(button(groupRow(u.root,'C'),'Preview recycled entry'));assert(field(u.root,'Recycled password').readOnly);await click(button(u.root,'Show groups'));await click(button(groupRow(u.root,'Selected'),'Edit group details'));await type(field(u.root,'Group notes'),'Submitted group change');const held=u.hold('groupSave'),saving=click(button(u.root,'Save group details'));await held.started.promise;assert(!walk(u.root).some(n=>n.tagName==='LABEL'&&n._text==='Recycled password'));assert(!walk(u.root).some(n=>n.tagName==='STRONG'&&n.textContent==='A'));await type(field(u.root,'Title'),'Newer entry survives');await type(field(u.root,'Password'),'Owned newer draft secret');held.release.resolve();await saving;assert.equal(field(u.root,'Title').value,'Newer entry survives');assert.equal(field(u.root,'Password').value,'Owned newer draft secret');
});
test('fresh group Save first active-list await retains enabled notes draft and dirty refresh refuses',async t=>{
 const u=await mount(t,'group-save-first-list');await click(button(u.root,'Show groups'));await click(button(groupRow(u.root,'Selected'),'Edit group details'));await type(field(u.root,'Group notes'),'Committed text');const held=u.hold('list'),saving=click(button(u.root,'Save group details'));await held.started.promise;await type(field(u.root,'Group notes'),'Newer unsaved notes');held.release.resolve();await saving;assert.equal(field(u.root,'Group notes').value,'Newer unsaved notes');const calls=u.calls.filter(c=>c.action==='recycleGroupList').length;await click(button(u.root,'Show groups'));assert.equal(u.calls.filter(c=>c.action==='recycleGroupList').length,calls);assert.equal(field(u.root,'Group notes').value,'Newer unsaved notes');
});
test('fresh disposal during held committed group response clears drafts and cannot publish later',async t=>{
 const u=await mount(t,'disposed-group-response');await click(button(u.root,'Show groups'));await click(button(groupRow(u.root,'Selected'),'Edit group details'));await type(field(u.root,'Group notes'),'Submitted text');const held=u.hold('groupSave'),saving=click(button(u.root,'Save group details'));await held.started.promise;const notes=field(u.root,'Group notes');u.cleanup();u.host.replaceChildren();held.release.resolve();await saving;assert.equal(notes.value,'');assert.equal(u.root.parentElement,null);const calls=u.calls.filter(c=>c.action==='list').length;assert.equal(calls,1,'Only initial list request should execute before disposed response returns');
});
test.after(async()=>{if(process.env.VAULT_GROUP_REVIEW_OUTPUT)await fs.writeFile(path.join(process.env.VAULT_GROUP_REVIEW_OUTPUT,'observations.json'),JSON.stringify(observations,null,2)+'\n',{flag:'wx'});});
