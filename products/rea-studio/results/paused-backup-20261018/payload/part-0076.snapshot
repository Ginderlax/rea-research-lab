    {
      "id": "grafana.candidate.a45adeb408949c64ed49",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When working with traces, especially those comprising a vast number of spans, pinpointing specific spans of interest can be a daunting task. This is where span filtering comes in. Located above the trace timeline viewer, the **Filters** bar lets you refine the spans displayed based on specific criteria. Whether you're looking to identify spans from a certain service, those exceeding a particular duration, or spans tagged with specific attributes, span filtering streamlines the process.",
      "headingPath": [
        "Span filters"
      ],
      "source": {
        "path": "docs/sources/datasources/tempo/span-filters.md",
