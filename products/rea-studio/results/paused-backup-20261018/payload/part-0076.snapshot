    {
      "id": "grafana.candidate.cea7944438201253e3a5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Solution:** Ensure the `description` field is populated when creating annotations in OpenTSDB. Grafana displays the `description` field as the annotation text.",
      "headingPath": [
        "OpenTSDB annotations",
        "Troubleshoot annotation issues",
        "Annotation text is empty"
