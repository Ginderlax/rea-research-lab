    },
    {
      "id": "grafana.candidate.4ad0394f018219fb241b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Node graphs, at minimum, require a data frame describing the edges of the graph. By default, node graphs compute the nodes and any stats based on this data frame. Optionally a second data frame describing the nodes can be sent when you need to show more node-specific metadata. Grafana recognizes node graph frames when `frame.meta.preferredVisualisationType = 'nodeGraph'`, when the frame name or `refId` is `nodes` or `edges`, or when a frame contains an `id` field.",
      "headingPath": [
        "Node graph",
        "Data API"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/node-graph/index.md",
        "gitBlobSha": "7c586f93fdc1eaff30c91e430394f51a121e7775",
        "sha256": "f0da5170934666563792a7b39628b17cd29c47bc87bd6f21ff69e7d6bdebf1a4",
