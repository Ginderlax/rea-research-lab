// Lightweight filing of an already verified hosted Notes backup. No product, test, build or browser execution.
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import { createHash } from 'node:crypto';
import { gzipSync, gunzipSync } from 'node:zlib';
const work = import.meta.dirname, lab = path.resolve(work, '../outputs/rea-research-lab');
const stage = path.join(work, 'cloud-notes-todo-first-pass-public-20261016-r2-next'), publicRoot = path.join(stage, 'public-candidate');
const prefix = 'products/rea-studio/results/cloud-notes-todo-first-pass-20261016', target = path.join(publicRoot, prefix);
const run = '38903252258', job = '116980427162', artifactId = '12047197582', head = '1d6fd83d6e40453e6db96420de15baf7eca50fa0';
const digest = 'ea18255d9915633c5fcdbc1676a9912a66ab5a6efdaa70be2bd17dad40726185';
const runFolder = path.join(work, 'cloud-verification-backups/run-' + run), backup = path.join(runFolder, 'artifact-' + artifactId), evidence = path.join(backup, 'readable-evidence');
const sha = bytes => createHash('sha256').update(bytes).digest('hex'), identity = bytes => ({ bytes: bytes.length, sha256: sha(bytes) });
function safe(name) { assert(typeof name === 'string' && name && !/[\\:\x00-\x1f\x7f]/.test(name) && !name.startsWith('/') && name.split('/').every(part => part && part !== '.' && part !== '..')); return name; }
function read(base, name) { safe(name); let at = base; for (const part of name.split('/')) { at = path.join(at, part); assert(!fs.lstatSync(at).isSymbolicLink()); } const stat = fs.lstatSync(at); assert(stat.isFile() && stat.size <= 12 * 1024 * 1024); const bytes = fs.readFileSync(at); assert.equal(bytes.length, stat.size); return bytes; }
assert(!fs.existsSync(stage)); assert(!fs.existsSync(path.join(lab, prefix)));
const verifiedBytes = read(backup, 'local-notes-todo-backup-verification.json'), verified = JSON.parse(verifiedBytes);
assert.equal(verified.schema, 'rea-local-notes-todo-cloud-attempt-backup/v1'); assert.equal(verified.artifactSHA256, digest); assert.equal(verified.allCRCAndBytesReadable, true); assert.equal(verified.files.length, 408); assert.equal(verified.localProductExecutions, 0);
const archive = fs.readFileSync(backup + '.zip'); assert.equal(sha(archive), digest); assert.equal(archive.length, 1625861); assert.equal(archive.length, verified.archiveBytes);
const files = new Map(); for (const row of verified.files) { safe(row.path); assert(!files.has(row.path)); files.set(row.path, row); const file = path.join(evidence, row.path), stat = fs.lstatSync(file); assert(stat.isFile() && !stat.isSymbolicLink()); assert.equal(stat.size, row.bytes); }
function artifact(name) { const bytes = read(evidence, name), expected = files.get(name); assert(expected); assert.deepEqual(identity(bytes), { bytes: expected.bytes, sha256: expected.sha256 }); return bytes; }
const attempt = JSON.parse(artifact('attempt-validation.json')); assert.equal(attempt.schema, 'rea-cloud-development-attempt/v1'); assert.equal(attempt.scope, 'notes-todo-experiment'); assert.equal(attempt.status, 'passed'); assert.equal(attempt.phase, 'terminal');
assert.equal(attempt.repositoryCommit, head); assert.equal(attempt.executionEnvironment, 'github-hosted'); assert.equal(attempt.runtime.version, 'v24.16.0'); assert.equal(attempt.runtime.platform, 'win32');
assert.equal(attempt.environment.GITHUB_RUN_ID, run); assert.equal(attempt.environment.GITHUB_SHA, head); assert.equal(attempt.environment.GITHUB_RUN_ATTEMPT, '1'); assert.equal(attempt.environment.GITHUB_REF, 'refs/heads/codex/rea-cloud-recovery-20261015');
assert.deepEqual(attempt.summary, { tests: 92, pass: 92, fail: 0, cancelled: 0, skipped: 0, todo: 0, duration_ms: 2734.6427 }); assert.deepEqual(attempt.failures, []); assert.equal(attempt.failure, null); assert.equal(attempt.exitCode, 0); assert.equal(attempt.signal, null); assert.equal(attempt.childCloseObserved, true);
assert.equal(attempt.sourceFiles, 779); assert.equal(attempt.sourceSnapshotFiles, 357); assert.equal(attempt.sourceStable, true); assert.equal(attempt.sourceCapturedBeforeExecution, true); assert.equal(attempt.selectedTestFiles.length, 17);
assert.equal(attempt.output.droppedOutputBytes, 0); assert.equal(attempt.output.retainedOutputTruncated, false); assert.equal(attempt.historicalReceiptsRebound, false); assert.equal(attempt.historicalDevelopmentReceiptOverwritten, false); assert.equal(attempt.fullFeatureParityEstablished, false); assert.equal(attempt.universalSuperiorityEstablished, false);
const before = artifact('source-before.json'); assert.deepEqual(before, artifact('source-after.json')); const census = JSON.parse(before); assert.equal(census.length, 779);
const snapshots = JSON.parse(artifact('source-snapshot-manifest.json')); assert.equal(snapshots.files.length, 357);
const omitted = [...files.values()].filter(row => row.path.startsWith('source/')).map(row => ({ sourcePath: row.path, bytes: row.bytes, sha256: row.sha256 })); assert.equal(omitted.length, 357);
for (const row of snapshots.files) { const actual = files.get(row.path), active = census.find(entry => entry.path === row.sourcePath); assert(actual && active); assert.equal(row.bytes, actual.bytes); assert.equal(row.sha256, actual.sha256); assert.equal(active.bytes, row.bytes); assert.equal(active.sha256, row.sha256); }
const observations = JSON.parse(artifact('notes-todo-observations.json')); assert.equal(observations.schema, 'rea-notes-todo-finite-observations/v1'); assert.equal(observations.authoredNewGroupsObserved, 23); assert.equal(observations.originalHelperComparisons, 20); assert.equal(observations.countsAddedToTestGroups, false); assert.equal(observations.originalFullApplicationExecutions, 0);
assert.equal(observations.original.conversionComparisons, 16); assert.equal(observations.original.completionComparisons, 4); assert.equal(observations.original.sourceSha256, '5f1a200dc970179ad6fd193f7ffc47f09f88261cff8f893ccc793517ebbe9647'); assert.equal(observations.original.originalDatabaseExecutions, 0); assert.equal(observations.original.originalGuiSessions, 0);
assert.deepEqual(attempt.notesTodoFiniteObservations, { authoredNewGroupsObserved: 23, originalHelperComparisons: 20, countsAddedToTestGroups: false, actualHttpModuleDeliveryVerified: true, originalFullApplicationExecutions: 0, browserExecutions: 0 });
const existingReaderAttempt = verified.attempts[0]; assert.equal(Object.keys(existingReaderAttempt.authoredNewGroupOccurrences).length, 23); assert(Object.values(existingReaderAttempt.authoredNewGroupOccurrences).every(n => n === 1)); assert.equal(existingReaderAttempt.actualHttpDeliveryObservations.length, 1);
const delivery = existingReaderAttempt.actualHttpDeliveryObservations[0]; assert.equal(delivery.actualBrowserExecution, false); assert.equal(delivery.unchangedPublicModuleBoundary, true); assert.equal(delivery.delivered.length, 2);
assert.equal(attempt.notesTodoOverlay.gitBaselineEligibleActiveFiles, 350); assert.equal(attempt.notesTodoOverlay.gitBaselineEligibleActiveBytesAuthenticated, true); assert.equal(attempt.notesTodoOverlay.gitWorkingTreeMatchesOverlayAfter, true); assert.equal(attempt.notesTodoOverlay.productionInstalled, false);
const compositionBytes = artifact('notes-todo-composition.json'), composition = JSON.parse(compositionBytes), post = JSON.parse(artifact('notes-todo-postrun-source-check.json'));
assert.equal(composition.sourceCommit, head); assert.equal(composition.currentTargets.length, 8); assert.equal(composition.productionInstalled, false); assert.equal(composition.baselineGitCommit, head);
assert.equal(post.schema, 'rea-notes-todo-hosted-postrun-source-check/v1'); assert.equal(post.status, 'passed'); assert.equal(post.phase, 'verify-after'); assert.equal(post.sourceStable, true); assert.equal(post.checkedTargets, 8); assert.equal(post.compositionSHA256, sha(compositionBytes)); assert.deepEqual(post.currentTargets, composition.currentTargets); assert.equal(post.productionInstalled, false);
for (const row of [composition, post]) { assert.equal(row.execution.RUNNER_ENVIRONMENT, 'github-hosted'); assert.equal(row.execution.GITHUB_RUN_ID, run); assert.equal(row.execution.GITHUB_SHA, head); }
const workflow = JSON.parse(artifact('notes-todo-workflow-attempt.json')); assert.equal(workflow.schema, 'rea-cloud-notes-todo-workflow-attempt/v1'); assert.equal(workflow.runId, run); assert.equal(workflow.sourceCommit, head); assert.equal(workflow.runnerEnvironment, 'github-hosted'); assert.equal(workflow.productionInstalled, false);
for (const key of ['checkoutOutcome', 'compositionOutcome', 'testOutcome', 'postcheckOutcome', 'statusBeforePackaging']) assert.equal(workflow[key], 'success');
const collectionBytes = read(runFolder, 'collection-summary.json'), collection = JSON.parse(collectionBytes); assert.equal(collection.runId, run); assert.equal(collection.jobId, job); assert.equal(collection.headSHA, head); assert.equal(collection.runConclusion, 'success'); assert.equal(collection.artifacts[0].artifactId, Number(artifactId));
const metadata = {};
for (const kind of ['run', 'jobs', 'artifacts']) metadata[kind] = JSON.parse(read(runFolder, 'control-plane-evidence/' + kind + '.json'));
assert.equal(String(metadata.run.id), run); assert.equal(metadata.run.head_sha, head); assert.equal(metadata.run.status, 'completed'); assert.equal(metadata.run.conclusion, 'success'); assert.equal(metadata.run.event, 'push'); assert.equal(metadata.jobs.jobs.length, 1); assert.equal(String(metadata.jobs.jobs[0].id), job); assert.equal(metadata.jobs.jobs[0].runner_group_name, 'GitHub Actions'); assert(metadata.jobs.jobs[0].labels.includes('windows-2022')); assert.equal(metadata.artifacts.artifacts[0].digest, 'sha256:' + digest);
fs.mkdirSync(path.join(target, 'payload'), { recursive: true }); const records = [], objects = new Map();
const credentials = /\b(?:ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,}|AKIA[0-9A-Z]{16})\b|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----/;
function save(role, raw, origin) { safe(role); assert(!records.some(row => row.sourcePath === role)); assert(!credentials.test(raw.toString('utf8'))); const decoded = identity(raw); let stored = raw, encoding = 'identity'; if (raw.length > 65536) { const gzip = gzipSync(raw, { level: 9 }); if (gzip.length < raw.length * .85) { assert.deepEqual(gunzipSync(gzip), raw); stored = gzip; encoding = 'gzip'; } } const storedIdentity = identity(stored), name = 'payload/' + decoded.sha256 + (encoding === 'gzip' ? '.gz.snapshot' : '.snapshot'); if (!objects.has(name)) { fs.writeFileSync(path.join(target, name), stored, { flag: 'wx' }); assert.deepEqual(read(target, name), stored); objects.set(name, storedIdentity); } records.push({ sourcePath: role, path: name, ...decoded, storage: { encoding, ...storedIdentity }, origin }); }
const retained = [...files.keys()].filter(name => !name.startsWith('source/')); assert.equal(retained.length, 51);
for (const name of retained) save('artifact/' + name, artifact(name), 'Exact uploaded non-source-subtree artifact role');
save('local/local-notes-todo-backup-verification.json', verifiedBytes, 'Complete ZIP/CRC/readability and Notes-specific recorded evidence reader receipt');
save('local/collection-summary.json', collectionBytes, 'Completed read-only API/log/artifact collection binding');
save('wrapper/job-' + job + '.txt', read(path.join(work, 'cloud-verification-backups/job-' + job), 'logs.txt'), 'Actual GitHub-hosted wrapper log');
for (const kind of ['run', 'jobs', 'artifacts']) save('control-plane/' + kind + '.json', read(runFolder, 'control-plane-evidence/' + kind + '.json'), 'Raw authenticated GitHub REST response');
for (const name of ['unpack-notes-todo-cloud-attempt.py', 'collect-readonly-notes-run-1245.mjs']) save('readers/' + name, read(work, name), 'Backup-only source, never executed as product code');
save('readers/preservation-collector.mjs', fs.readFileSync(import.meta.filename), 'Exact work-only filing implementation');
const manifest = { schema: 'rea-hosted-notes-todo-first-pass-preservation/v1', createdAtUtc: new Date().toISOString(), status: 'passed-finite-notes-contracts',
 runId: run, runAttempt: 1, jobId: job, runURL: metadata.run.html_url, sourceCommit: head, branchHead: head, testedReference: attempt.environment.GITHUB_REF, artifactId, artifactSHA256: digest, artifactArchiveBytes: archive.length,
 summary: attempt.summary, selectedTestFiles: attempt.selectedTestFiles, selectedFileCount: 17, authoredNewGroups: 23, authoredNewGroupOccurrences: existingReaderAttempt.authoredNewGroupOccurrences,
 originalHelperComparisons: 20, originalConversionComparisons: 16, originalCompletionComparisons: 4, comparisonsAddedToTestGroups: false, original: observations.original,
 actualHTTPModuleDelivery: delivery, realBrowserExecutions: 0, fullOriginalApplicationExecutions: 0, originalDatabaseExecutions: 0, originalGuiSessions: 0,
 candidateWorkflowScope: 'Existing saved-note conversion, completion/reopening, due metadata, five combined filters, persistence, revisions/history, imported JEX/resource retention, real HTTP delivery and held-response DOM ownership. Due metadata does not provide alarms.',
 applicationRuntimeOverlayTargets: 3, runtimeExistingTargets: 2, runtimeNewTargets: 1, documentationOverlayTargets: 1, newTestTargets: 4, exactEightHostedTargets: composition.currentTargets, compositionSHA256: sha(compositionBytes), independentPostrunSourceCheck: 'passed',
 sourceFiles: 779, sourceStable: true, sourceCapturedBeforeExecution: true, activeSourceSnapshotsInVerifiedLocalBackup: 357, unchangedGitBaselineActiveFilesAuthenticated: 350,
 completeReadableLocalBackupVerified: true, localReadableFiles: files.size, retainedArtifactFiles: retained.length, publicSourceSnapshotPayloads: 0, omittedSourceSnapshotPayloads: omitted,
 omissionScope: 'Only artifact source/ active snapshot payloads are omitted publicly, each with exact bytes/SHA retained here and in the source snapshot manifest. Complete readable payloads remain in the verified local backup. All51 other artifact roles, including bounded source overlay before/after/bundle and original helper source/license files, remain recoverable exactly.',
 records, uniquePublicObjects: objects.size, storedPayloadBytes: [...objects.values()].reduce((sum, value) => sum + value.bytes, 0), allCopiesExact: true, allStorageDecodesExact: true,
 productionInstalled: false, fullDevelopmentSuiteAcceptance: false, historicalReceiptsRebound: false, oldReceiptsRewritten: false, originalHelperComparisonIsFullApplicationParity: false, fullFeatureParityEstablished: false, superiorityEstablished: false,
 localProductExecutions: 0, localTests: 0, localBuilds: 0, localBrowserExecutions: 0,
 acceptanceScope: 'An actual GitHub-hosted Windows run passed92/92 finite Notes tests across17 files on a reviewed eight-target experimental source composition, with23 new test groups and20 separately counted comparisons against two exact released Joplin3.6.14 helpers. HTTP module byte equality, same-attempt779-file source stability,350 unaffected Git-bound active files and a separate eight-target source postcheck passed. These are finite experimental results; the new Notes sources are not production installed. DOM fixture tests do not establish real browser acceptance; helper execution does not establish Joplin database, GUI, full application, security, performance or every documented-feature parity.' };
const manifestBytes = Buffer.from(JSON.stringify(manifest, null, 2) + '\n'); fs.writeFileSync(path.join(target, 'preservation-manifest.json'), manifestBytes, { flag: 'wx' });
const readme = '# Notes to-do: first hosted finite pass\n\n' + manifest.acceptanceScope + '\n\nThe tested feature covers saved-note conversion, completion/reopening, due metadata, five filters, history and persistent JEX state. Due metadata does not provide alarms.\n\nEvery uploaded non-source artifact role is preserved. Each record lists decoded bytes/SHA and storage bytes/SHA. Read identity storage directly; decompress gzip storage and authenticate the decoded identity. Omitted source/ snapshots retain all identities and complete readable local copies. No old receipt is rebound, and the experimental sources remain uninstalled.\n';
fs.writeFileSync(path.join(target, 'README.md'), readme, { flag: 'wx' });
const rows = []; function inventory(folder) { for (const item of fs.readdirSync(folder, { withFileTypes: true })) { assert(!item.isSymbolicLink()); const file = path.join(folder, item.name); if (item.isDirectory()) inventory(file); else rows.push({ path: path.relative(publicRoot, file).split(path.sep).join('/'), ...identity(fs.readFileSync(file)) }); } } inventory(publicRoot);
const totalBytes = rows.reduce((sum, row) => sum + row.bytes, 0); assert(totalBytes <= 2 * 1024 * 1024); assert(rows.length <= 80); assert(records.filter(row => row.sourcePath.startsWith('artifact/')).length === retained.length);
for (const row of records) { const stored = read(target, row.path); assert.deepEqual(identity(stored), { bytes: row.storage.bytes, sha256: row.storage.sha256 }); assert.deepEqual(identity(row.storage.encoding === 'gzip' ? gunzipSync(stored) : stored), { bytes: row.bytes, sha256: row.sha256 }); }
const authority = { schema: 'rea-work-only-notes-todo-first-pass-copy-authority/v1', createdAtUtc: new Date().toISOString(), publicCandidate: publicRoot, targetPrefix: prefix, mode: 'new-directory-only', filingRevision: 2, priorCapsulePreserved: 'work/cloud-notes-todo-first-pass-public-20261016-next', collectorProvenanceCorrectionOnly: true, runId: run, jobId: job, artifactId, sourceCommit: head, files: rows.length, bytes: totalBytes, rows,
 manifest: identity(manifestBytes), logicalRoles: records.length, retainedArtifactFiles: retained.length, omittedActiveSnapshots: 357, fullLocalReadableFiles: 408, sourceCensusFiles: 779, summary: attempt.summary, originalHelperComparisonsSeparate: 20, originalHelperExecutionsQualified: true, productionInstalled: false,
 allPublicStoredAndDecodedObjectsReadBackExact: true, priorBackupReaderReused: true, backupVerificationBasis: 'Existing full ZIP/CRC/Notes reader receipt reused. All non-source artifact bytes are re-read/hash-bound; every stored and decoded public role is read back. Omitted source rows use prior reader exact identity validation and current path/type/size checks, without rerunning product/tests or duplicate bulk source hashing.',
 activeFilesWritten: 0, activeApplicationEdits: 0, gitMutations: 0, localProductExecutions: 0, localTests: 0, localBuilds: 0, independentReviewPending: true };
const authorityBytes = Buffer.from(JSON.stringify(authority, null, 2) + '\n'); fs.writeFileSync(path.join(stage, 'copy-authority.json'), authorityBytes, { flag: 'wx' }); console.log(JSON.stringify({ stage, prefix, files: rows.length, bytes: totalBytes, logicalRoles: records.length, authority: identity(authorityBytes), manifest: identity(manifestBytes), activeFilesWritten: 0, localProductExecutions: 0 }));
