      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "[Documentation](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/dashboards/manage-dashboards/#create-a-dashboard-folder)",
      "headingPath": [
        "What’s new in Grafana v11.3",
