    },
    {
      "id": "grafana.candidate.c61d9e5996e2d9970205",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can explore a similar [alert example in Grafana Play](https://play.grafana.org/alerting/grafana/qp_rec_ratio_below_predicted/view?tab=query&tech=docs&pg=alerting-examples&plcmt=callout-tip&cta=forecast-outside-range-alert-example).",
      "headingPath": [
        "Alerting on forecasts",
