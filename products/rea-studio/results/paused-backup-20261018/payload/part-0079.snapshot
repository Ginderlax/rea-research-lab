    {
      "id": "grafana.candidate.38c7fa5f4ac0f11b4f0d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Note: **datasources:query** is still required to preview an alert rule, regardless of alert rules and folders permissions.",
      "headingPath": [
        "What’s new in Grafana v11.1",
        "Alerting",
        "Removes requirement of datasources:query permission for reading rules"
