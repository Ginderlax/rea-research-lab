    {
      "id": "grafana.candidate.6e730e6b08a0f01b7866",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In this example, the alert query uses the upper forecast bound (`yhat_upper`) rather than the central prediction. This accounts for prediction uncertainty and provides a more conservative capacity-planning signal.",
