import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';import {collect} from './independent-decoder.mjs';
const here=path.dirname(fileURLToPath(import.meta.url)),base=path.resolve(here,'../..'),stage=path.join(base,'work/backup-rabin-fixed-next'),app=path.join(base,'outputs/rea-research-lab/products/rea-studio/apps/backup'),hash=x=>createHash('sha256').update(x).digest('hex'),json=async p=>JSON.parse(await fs.readFile(p,'utf8'));
const baseline=await json(path.join(here,'baseline-manifest.json')),recorder=await json(path.join(here,'recorder-baseline-manifest.json')),accepted=await json(path.join(here,'baseline/accepted-review.json'));
for(const row of [...baseline.files,...recorder.files])assert.equal(hash(await fs.readFile(path.join(here,row.path))),row.sha256,'Preserved bytes '+row.path);
for(const row of accepted.sourceFingerprints)assert.equal(hash(await fs.readFile(path.join(stage,row.path))),row.sha256,'Accepted stage '+row.path);
const exactPairs=[['capture-file.mjs','capture-rabin-file.mjs'],['rabin.mjs','rabin.mjs'],['rabin.test.mjs','rabin.test.mjs'],['apps/backup/restic-crypto.mjs','restic-crypto.mjs'],['apps/backup/restic-kdf-policy.mjs','restic-kdf-policy.mjs']];
const matches=[];for(const [before,after] of exactPairs){const s=await fs.readFile(path.join(stage,before)),p=await fs.readFile(path.join(app,after));assert.deepEqual(p,s);matches.push({stage:before,production:after,bytes:p.length,sha256:hash(p),kind:'exact bytes'});}
const compressionStage=await fs.readFile(path.join(stage,'apps/backup/restic-compression.mjs'),'utf8'),compressionProduction=await fs.readFile(path.join(app,'restic-compression.mjs'),'utf8');assert.equal(compressionProduction,compressionStage.replace('// in source-provenance.json; its BSD-2-Clause notice is retained in references.','// in results/compression-source-study/stage/source-provenance.json;\n// its BSD-2-Clause notice is retained beside the original source.'));matches.push({stage:'apps/backup/restic-compression.mjs',production:'restic-compression.mjs',bytes:Buffer.byteLength(compressionProduction),sha256:hash(compressionProduction),kind:'exact after documented provenance comment-only adaptation'});
const candidate=await fs.readFile(path.join(stage,'apps/backup/restic.mjs'),'utf8'),actual=await fs.readFile(path.join(app,'restic.mjs'),'utf8');assert.equal(actual,candidate.replace("from '../../capture-file.mjs'","from './capture-rabin-file.mjs'"));matches.push({stage:'apps/backup/restic.mjs',production:'restic.mjs',bytes:Buffer.byteLength(actual),sha256:hash(actual),kind:'exact after one recorded import substitution'});
const storage=await fs.readFile(path.resolve(app,'../../lib/storage.mjs'));assert.equal(hash(storage),accepted.sourceFingerprints.find(x=>x.path==='lib/storage.mjs').sha256);matches.push({stage:'lib/storage.mjs',production:'../../lib/storage.mjs',bytes:storage.length,sha256:hash(storage),kind:'exact bytes'});
const imports=[];for(const name of ['restic.mjs','capture-rabin-file.mjs','rabin-original-compare.mjs','rabin-original.test.mjs','restic-rabin-snapshot.test.mjs','restic-rabin-lifecycle.test.mjs','restic-rabin-deadline.test.mjs']){const src=await fs.readFile(path.join(app,name),'utf8');for(const [,relative] of src.matchAll(/(?:from\s*|import\s*)['"]([^'"]+)['"]/g)){if(!relative.startsWith('.'))continue;const target=path.resolve(app,relative);assert.ok((await fs.stat(target)).isFile());imports.push({file:name,relative,target});}}
const artifacts=path.resolve(app,'../../../../projects/09-restic/artifacts');for(const [file,sha256] of [['restic_0.19.1_windows_amd64.zip','da948ad707ed690426473aaba2046cd61f8f90f6f0e7dab6be0d5796531de67d'],['unpacked/restic_0.19.1_windows_amd64.exe','b0dd1fd21eea5d8fe1325f55f7118213c21f36de8a261e04c0624a5ab9fd7830']])assert.equal(hash(await fs.readFile(path.join(artifacts,file))),sha256);
const reconstructed=[];for(const name of ['first47','latest47','final47']){const raw=await fs.readFile(path.join(here,name==='final47'?'baseline/final47/rabin-integration.stdout.txt':'baseline/raw/'+name+'.stdout.txt'),'utf8'),boundary=collect(raw,'rabinBoundaryOriginalObservations'),snapshot=collect(raw,'rabinSnapshotOriginalObservations'),lifecycle=collect(raw,'rabinLifecycleObservations'),deadline=collect(raw,'rabinDeadlineObservations');await fs.writeFile(path.join(here,'reconstructed-'+name+'.json'),JSON.stringify({boundary,snapshot,lifecycle,deadline},null,2)+'\n',{flag:'wx'});reconstructed.push({raw:name,bytes:Buffer.byteLength(raw),sha256:hash(raw),tests:Number(raw.match(/^# tests (\d+)$/m)?.[1]),pass:Number(raw.match(/^# pass (\d+)$/m)?.[1]),fail:Number(raw.match(/^# fail (\d+)$/m)?.[1]),boundaryKeys:Object.keys(boundary),boundaryFiles:boundary.comparisons?.length,boundaryCommands:boundary.commands?.length,snapshotCommands:Array.isArray(snapshot)?snapshot.length:snapshot.observations?.length,lifecycleCases:lifecycle.observations.length,deadlineCases:(deadline.observations??deadline.cases).length,boundaryFragmentLines:raw.split(/\r?\n/).filter(x=>x.startsWith('# ')).map(x=>x.length).sort((a,b)=>b-a).slice(0,4)});}
const stable=[];for(const row of baseline.files.filter(x=>x.path.startsWith('baseline/production/'))){assert.equal(hash(await fs.readFile(row.source)),row.sha256);stable.push({path:path.basename(row.source),bytes:row.bytes,sha256:row.sha256});}
const report={schema:'rea-rabin-production-independent-review/v1',createdAt:new Date().toISOString(),scope:'Finite source/import/oracle-artifact identity review and retained TAP reconstruction only. No Backup behavior, original command, timing or memory comparison rerun.',acceptedStageFingerprintsVerified:accepted.sourceFingerprints.length,acceptedFiniteSlice:accepted.acceptedFiniteSlice,implementationComparisons:matches,imports,originalArtifactsAuthenticatedWithoutExecution:true,reconstructed,productionSourceFingerprints:stable,sourceBytesStable:true,recorderBaselineFingerprints:recorder.files,findings:[{id:'tap-hash-escape',status:'reported to root; production behavior unaffected',details:'Actual Node TAP reporter escapes # separately; baseline recorder decodes only doubled backslashes and rejects synthetic JSON containing #. Exact old decoder and failed synthetic observation preserved.'}],limitations:['The four finite historical logs are historical executions, not fresh behavioral executions by this reviewer.','Accepted restic/native cryptographic bounds and OS race limitations remain; no security certification or universal parity claim.','Fixture cleanup validates own lexical temporary parent/prefix, not atomic filesystem isolation against a hostile process. Setup failures before after-hook installation can leave a synthetic owned temporary folder.','Process-local fs/Date.now hooks are restored in finally; per-file child test execution isolates them. This does not exercise every real kernel failure or signal boundary.','Full source-bound production validation is root-owned and was still running during this review. Current mutable result files were not treated as source.'],fullParity:false,securityCertified:false,performanceSuperiority:false};await fs.writeFile(path.join(here,'integration-review.json'),JSON.stringify(report,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({verifiedStageFiles:report.acceptedStageFingerprintsVerified,implementationMatches:matches.length,productionStable:stable.length,reconstructed}));
