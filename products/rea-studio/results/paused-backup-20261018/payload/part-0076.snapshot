    {
      "id": "grafana.candidate.86e8c57e5f386b696ffb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Units are automatically mapped from Parca to Grafana formats: `nanoseconds` displays as `ns` and `count` displays as a short number.",
      "headingPath": [
