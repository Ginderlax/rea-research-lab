    {
      "id": "grafana.candidate.51a3ac4021ae76d9386b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Sets the minimum interval to enforce between rule evaluations. The default value is `10s` which equals the scheduler interval. Rules are adjusted if they are less than this value or if they are not multiple of the scheduler interval (10s). Higher values can help with resource management as Grafana schedules fewer evaluations over time.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[unified_alerting]`",
        "`min_interval`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
