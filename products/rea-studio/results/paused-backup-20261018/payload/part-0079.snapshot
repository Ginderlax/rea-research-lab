    },
    {
      "id": "grafana.candidate.69ddf909d947b9f7984b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For more information, refer to the [documentation](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/panels-visualizations/query-transform-data/transform-data/#transpose).",
      "headingPath": [
        "What’s new in Grafana v11.2",
        "Dashboards and visualizations",
        "Transformation updates"
      ],
      "source": {
