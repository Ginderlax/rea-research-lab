    {
      "id": "grafana.candidate.1b14e4d903e29bfdfa43",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you want to learn more, in detail, about all the improvements we've made, don't miss our blog post.",
      "headingPath": [
        "What’s new in Grafana v11.0",
        "Dashboards and visualizations",
        "Scenes powered Dashboards",
        "Known limitations"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-0.md",
