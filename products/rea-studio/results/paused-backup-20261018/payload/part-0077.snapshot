        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.7b618190ec9fc3f9d041",
      "syntaxRole": "table-row",
      "sourceText": "| `oauth_skip_org_role_update_sync` | `skip_org_role_sync` | Resulting Org Role                                                                                                                  | Modifiable |",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[auth]`",
