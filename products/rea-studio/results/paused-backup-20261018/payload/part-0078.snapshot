    {
      "id": "grafana.candidate.512b97440f7340e4eb5d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you set the legend placement to **Right**, the **Width** option becomes available. Leave the field empty to allow Grafana to automatically set the legend width or enter a value in the field.",
      "headingPath": [
        "Configure a legend",
        "Legend options",
        "Width"
      ],
