    {
      "id": "grafana.candidate.dcfcff6cff72eedc48d9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Replace `<PASSWORD>` with your database password. When using a Unix socket, set `url` to the socket directory path. Don't include a port number.",
      "headingPath": [
