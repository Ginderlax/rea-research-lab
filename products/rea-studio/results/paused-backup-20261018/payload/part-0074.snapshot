    {
      "id": "grafana.candidate.8e3c8638b0fe8eb12929",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If a plugin is unsigned, then Grafana neither loads nor starts it. Grafana also writes an error message to the server log:",
      "headingPath": [
        "Plugin signatures",
        "How does verification work?",
        "What happens if a plugin is not signed?"
      ],
      "source": {
