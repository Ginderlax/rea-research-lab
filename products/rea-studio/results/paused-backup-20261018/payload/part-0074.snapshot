    },
    {
      "id": "grafana.candidate.17151528eb61c7270eb6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can specify the following permissions to dashboards and folders.",
      "headingPath": [
        "Roles and permissions",
        "Dashboard permissions"
      ],
      "source": {
        "path": "docs/sources/administration/roles-and-permissions/_index.md",
