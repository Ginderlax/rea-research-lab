import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash}from'node:crypto';
const root=import.meta.dirname,id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});
const audit=JSON.parse(await fs.readFile(path.join(root,'runs/final/review-validation.json'))),finding=JSON.parse(await fs.readFile(path.join(root,'findings.json')));
const receipt={schema:'rea-notes-inline-publication-finite-independent-review/v1',at:new Date().toISOString(),status:'base-plan-accepted-addendum-byte-integrity-accepted-one-metadata-correction-required',sourceOnly:true,applicationTests:0,originalExecutions:0,browserExecutions:0,hosts:0,benchmarks:0,productionWrites:0,registryWrites:0,publishedCopies:0,sourceStable: audit.sourceStable,exactPinnedPlan162:'ab0bccd1aaf43da7b932193a0991531659b2e5017b72c28933b37bcc7ddcf3ae',exactPinnedAddendum17:'697af388815ed18acacdfebf69dd58eb6ddb601c84722e0ba2185401afaa9aff',baseAccounting:audit.baseAccounting,addendumAccounting:audit.addendumAccounting,finalIncomingPublicRecords:818,additionalAddendumPublicRecords:18,totalProspectivePublicRecords:836,installationProposals:8,sixReplacementsTwoAdditions:true,historical34BeforeImagesExact:true,current28Unchanged:true,sourceIDSHAPairs:159,capabilityIDs:232,sourcePrerequisites:31,noticeAliasBytes:543,byteAuditReceipt:{path:'runs/final/review-validation.json',...id(await fs.readFile(path.join(root,'runs/final/review-validation.json')))},findings: finding.sourceOnlyMetadataFindings,ownCollectorFailures:1,sourceOnlyValidatorAttempts:2,fullProductParity:false,securityEquivalence:false,superiority:false};
await fs.writeFile(path.join(root,'review-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
async function walk(prefix=''){const r=[];for(const e of(await fs.readdir(path.join(root,prefix),{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const p=prefix+e.name;if(p==='review-manifest.json')continue;assert.equal(e.isSymbolicLink(),false);if(e.isDirectory())r.push(...await walk(p+'/'));else{assert.ok(e.isFile());r.push({path:p,...id(await fs.readFile(path.join(root,p)))});}}return r;}
const rows=await walk();await fs.writeFile(path.join(root,'review-manifest.json'),JSON.stringify({schema:'rea-notes-inline-publication-independent-strict-freeze/v1',at:new Date().toISOString(),strict:true,selfExcluded:true,files:rows.length,totalBytes:rows.reduce((n,r)=>n+r.bytes,0),receiptSHA256:id(await fs.readFile(path.join(root,'review-validation.json'))).sha256,inventory:Object.fromEntries(rows.map(r=>[r.path,{bytes:r.bytes,sha256:r.sha256}]))},null,2)+'\n',{flag:'wx'});for(const r of rows)assert.deepEqual(id(await fs.readFile(path.join(root,r.path))),{bytes:r.bytes,sha256:r.sha256});console.log(JSON.stringify({files:rows.length,receipt:id(await fs.readFile(path.join(root,'review-validation.json'))),manifest:id(await fs.readFile(path.join(root,'review-manifest.json')))}));
