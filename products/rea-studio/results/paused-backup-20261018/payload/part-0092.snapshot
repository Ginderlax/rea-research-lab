    ('fn', 'signature'),
    [
        (np.ma.nonzero, "(a)"),
        (np.ma.anomalies, "(a, axis=None, dtype=None)"),
        (np.ma.cumsum, "(a, axis=None, dtype=None, out=None)"),
        (np.ma.compress, "(condition, a, axis=None, out=None)"),
    ]
)
def test_frommethod_signature(fn, signature):
