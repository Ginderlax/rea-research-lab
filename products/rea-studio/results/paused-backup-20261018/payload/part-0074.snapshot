    {
      "id": "grafana.candidate.2570ba67c8e1daba3eac",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If not carefully configured, inhibition rules can silently suppress alerts and make issues harder to detect. Consider [silences](ref:shared-silences) or [mute timings](ref:mute-timings) for most suppression use cases.",
      "headingPath": [
        "Configure inhibition rules"
      ],
      "source": {
        "path": "docs/sources/alerting/configure-notifications/inhibition-rules.md",
        "gitBlobSha": "3030f57a20ca73738b38302be6ed815ab5155afb",
