import assert from 'node:assert/strict';
import {spawnSync} from 'node:child_process';
import {readFileSync,writeFileSync,mkdirSync} from 'node:fs';
import {createHash} from 'node:crypto';
import {join} from 'node:path';
const lab=join(import.meta.dirname,'../outputs/rea-research-lab'),out=join(lab,'products/rea-studio/results/historical-vault-exchange-readme-20261012'),sha=b=>createHash('sha256').update(b).digest('hex'),revision='a56332e9ddb6413cb33c580be137743a748fd5f9',source='products/rea-studio/apps/vault/README.md';
const r=spawnSync('git',['show',revision+':'+source],{cwd:lab,timeout:10000,maxBuffer:1024*1024});assert.equal(r.status,0);assert.equal(r.stdout.length,5526);assert.equal(sha(r.stdout),'87e0452bd55cd32de491037b25e61f876c9f1c0f27bc8c3d65d3d935a1aabbe6');
const receipt=readFileSync(join(lab,'products/rea-studio/apps/vault/compatibility-evidence.json'));assert.equal(sha(receipt),'895cb736a9b285bfd0c541b6f76a4dc577aca88675be38e3bab9d2a8be105aee');const entry=JSON.parse(receipt).implementationFingerprints.find(e=>e.path===source);assert.equal(entry.sha256,sha(r.stdout));assert.equal(entry.bytes,r.stdout.length);
mkdirSync(out,{recursive:true});const snapshots=[];for(const [sourcePath,p,b]of [[source,'README.md.snapshot',r.stdout],['collector/preserve-vault-exchange-readme.mjs','preserve-vault-exchange-readme.mjs.snapshot',readFileSync(import.meta.filename)]]){writeFileSync(join(out,p),b,{flag:'wx'});snapshots.push({sourcePath,path:p,bytes:b.length,sha256:sha(b)});}
const manifest={schema:'rea-vault-exchange-readme-preservation/v1',recordedAtUtc:new Date().toISOString(),sourceRevision:revision,gitBlobSHA1:createHash('sha1').update(`blob ${r.stdout.length}\0`).update(r.stdout).digest('hex'),snapshots,historicalReceiptSHA256:sha(receipt),sourceIdentityMatchesHistorical18Receipt:true,currentDocumentationRebound:false,currentRuntimeRebound:false,newBehavioralExecutions:0,allSnapshotsInert:true,fullProductParity:false,universalSuperiority:false};const b=Buffer.from(JSON.stringify(manifest,null,2)+'\n');writeFileSync(join(out,'preservation-manifest.json'),b,{flag:'wx'});console.log(JSON.stringify({count:2,sha256:sha(b),sourceSHA256:sha(r.stdout)}));
