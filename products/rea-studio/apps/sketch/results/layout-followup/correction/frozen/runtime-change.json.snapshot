  "beforeBox": "function box(shapes){const boxes=shapes.map(bounds),minX=Math.min(...boxes.map(b=>b.x)),minY=Math.min(...boxes.map(b=>b.y)),maxX=Math.max(...boxes.map(b=>b.x+b.w)),maxY=Math.max(...boxes.map(b=>b.y+b.h));return {minX,minY,maxX,maxY,midX:(minX+maxX)/2,midY:(minY+maxY)/2,width:maxX-minX,height:maxY-minY};}",
  "afterBox": "function box(shapes){const boxes=shapes.map(s=>{const xs=s.type==='freedraw'?s.points.map(p=>s.x+p[0]):[s.x,s.x+s.w],ys=s.type==='freedraw'?s.points.map(p=>s.y+p[1]):[s.y,s.y+s.h];return {minX:Math.min(...xs),minY:Math.min(...ys),maxX:Math.max(...xs),maxY:Math.max(...ys)};}),minX=Math.min(...boxes.map(b=>b.minX)),minY=Math.min(...boxes.map(b=>b.minY)),maxX=Math.max(...boxes.map(b=>b.maxX)),maxY=Math.max(...boxes.map(b=>b.maxY));return {minX,minY,maxX,maxY,midX:(minX+maxX)/2,midY:(minY+maxY)/2,width:maxX-minX,height:maxY-minY};}",
