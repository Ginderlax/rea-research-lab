    {
      "id": "grafana.candidate.6ae20780e4b71a2add18",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Every Grafana instance exposes an HTTP API, used by the Grafana frontend to manage resources like saving dashboards, creating users, updating data sources, deleting alerts, and more. You can use the HTTP API to programmatically access or manage resources from your Grafana instance.",
      "headingPath": [
        "Grafana HTTP API reference guide"
      ],
      "source": {
        "path": "docs/sources/developer-resources/api-reference/http-api/_index.md",
        "gitBlobSha": "1bc3e4e7b4f058a4d9007d3dabea172e2b3ea247",
        "sha256": "b8310203f9c3ce8e218987e5dd5399cef5118c58b8da2684feed8de1d3cd8bac",
        "lineStart": 26,
        "lineEnd": 26,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/developer-resources/api-reference/http-api/_index.md#L26-L26"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss",
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.640ec6d4d0ca48982afd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you need to manage or access other resources from your [Grafana Cloud Stack](https://grafana.com/docs/grafana-cloud/account-management/cloud-stacks/), refer to the [Grafana Cloud API](https://grafana.com/docs/grafana-cloud/developer-resources/api-reference/cloud-api/) instead.",
      "headingPath": [
        "Grafana HTTP API reference guide"
      ],
      "source": {
        "path": "docs/sources/developer-resources/api-reference/http-api/_index.md",
        "gitBlobSha": "1bc3e4e7b4f058a4d9007d3dabea172e2b3ea247",
        "sha256": "b8310203f9c3ce8e218987e5dd5399cef5118c58b8da2684feed8de1d3cd8bac",
