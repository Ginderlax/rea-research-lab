        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/configure-notifications/inhibition-rules.md#L139-L139"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
