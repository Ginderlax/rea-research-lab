import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import {spawn} from 'node:child_process';
const own=path.dirname(fileURLToPath(import.meta.url)),stage=path.resolve(process.env.VAULT_REVIEW_STAGE??path.join(own,'../keepass-history-selection-fix-next')),sha=b=>createHash('sha256').update(b).digest('hex'),names=['history.mjs','server.mjs','client.mjs','kdbx.mjs','xml.mjs'];
async function fingerprints(){return Promise.all(names.map(async name=>({path:name,sha256:sha(await fs.readFile(path.join(stage,name)))})));}
const before=await fingerprints(),output=path.join(own,'runs/initial-policy');await fs.mkdir(output,{recursive:true});
const child=spawn(process.execPath,['--test','--test-concurrency=1',path.join(own,'preexisting-draft.test.mjs')],{cwd:own,windowsHide:true,env:{...process.env,VAULT_REVIEW_STAGE:stage,VAULT_REVIEW_OUTPUT:path.join(own,'observations/initial-policy')},stdio:['ignore','pipe','pipe']});
let stdout='',stderr='';child.stdout.on('data',p=>stdout+=p);child.stderr.on('data',p=>stderr+=p);const timer=setTimeout(()=>child.kill(),20000);const exitCode=await new Promise((resolve,reject)=>{child.once('error',reject);child.once('close',resolve)});clearTimeout(timer);await fs.writeFile(path.join(output,'stdout.txt'),stdout);await fs.writeFile(path.join(output,'stderr.txt'),stderr);const after=await fingerprints();
const original='C:/Users/evanh/Documents/Codex/2026-10-12/go/work/keepass-history-next/source/KeePass/Forms/PwEntryForm.cs',bytes=await fs.readFile(original);await fs.mkdir(path.join(own,'source'),{recursive:true});await fs.writeFile(path.join(own,'source/PwEntryForm.cs.snapshot'),bytes);
const counts=Object.fromEntries(['tests','pass','fail','skipped','cancelled'].map(n=>[n,Number(new RegExp(`(?:ℹ|#) ${n} (\\d+)`).exec(stdout)?.[1]??-1)]));const receipt={schema:'rea-independent-keepass-dirty-restore-review/v1',exitCode,counts,sourceStable:JSON.stringify(before)===JSON.stringify(after),stage,sourceFingerprints:before,originalSource:{path:original,sha256:sha(bytes),lines:[[1070,1071],[1485,1491],[2139,2145]]},scope:'One owned synthetic main-editor dirty-before-request safety probe against actual frozen client/server with a DOM element model, not a native GUI or HTTP loss observation',harnessReadFailure:{path:'apps/vault/client.mjs',reason:'Wrong initial assumed layout; actual candidate client.mjs is at stage root; no file changes or test results from that read'},inputs:await Promise.all(['preexisting-draft.test.mjs','ui-fixture.mjs','run-policy.mjs'].map(async name=>({path:name,sha256:sha(await fs.readFile(path.join(own,name)))})))};await fs.writeFile(path.join(output,'validation.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify(receipt));if(exitCode||!receipt.sourceStable)process.exitCode=1;
