import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab'),own=path.join(work,'vault-requirement-binding-correction-next'),sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)});await fs.mkdir(own);
const installation=await fs.readFile(path.join(work,'editor-vault-reviewed-installation-next/installation.json'));assert.equal(sha(installation),'89c6f2f0b5c81becc957506d590ead6c7cd550e33e8519f0ff2c3c77ec2d253d');const installed=JSON.parse(installation).proposals;
const changes=[],audit=[],identities=[],all=[];for(const file of ['workspace-products.json','visual-products.json','system-products.json']){const relative='products/rea-studio/requirements/'+file,b=await fs.readFile(path.join(lab,relative)),j=JSON.parse(b);await fs.writeFile(path.join(own,file+'.before.snapshot'),b,{flag:'wx'});const local=file==='workspace-products.json'?j.localImplementationEvidence:file==='visual-products.json'?j.baselineProducts.flatMap(p=>p.implementationFiles??[]):j.products.flatMap(p=>p.local_implementation_evidence??[]),capabilities=file==='workspace-products.json'?j.capabilities:file==='visual-products.json'?j.baselineProducts.flatMap(p=>p.requirements):j.products.flatMap(p=>p.capabilities);identities.push(...j.sources.map(s=>({registry:file,id:s.id,sha256:s.sha256})));all.push(...capabilities.map(c=>({registry:file,id:c.id})));for(const e of local){const actual=id(await fs.readFile(path.join(lab,e.path))),matches=e.sha256===actual.sha256&&(e.bytes===undefined||e.bytes===actual.bytes);audit.push({registry:file,path:e.path,expected:{bytes:e.bytes??null,sha256:e.sha256},actual,matches});if(!matches){assert.equal(file,'system-products.json');assert(/^products\/rea-studio\/apps\/vault\/(client|server|recycle)\.mjs$/.test(e.path));const p=installed.find(p=>p.destination===e.path);assert(p);assert.deepEqual(p.before,{bytes:e.bytes,sha256:e.sha256});assert.deepEqual(p.after,actual);changes.push({path:e.path,before:{bytes:e.bytes,sha256:e.sha256},after:actual});e.bytes=actual.bytes;e.sha256=actual.sha256;}}
if(file==='system-products.json')await fs.writeFile(path.join(own,'system-products.json.after.snapshot'),JSON.stringify(j,null,2)+'\n',{flag:'wx'});}
assert.equal(changes.length,3);assert.equal(identities.length,159);assert.equal(all.length,232);
const readmePath='products/rea-studio/requirements/README.md',readme=await fs.readFile(path.join(lab,readmePath)),needle='adds installed finite evidence and refreshes four reviewed implementation-byte references.';assert.equal(readme.toString().split(needle).length-1,1);const next=readme.toString().replace(needle,'adds installed finite evidence and refreshes seven reviewed implementation-byte references: four Editor and three Vault paths.');await fs.writeFile(path.join(own,'requirements-README.md.before.snapshot'),readme,{flag:'wx'});await fs.writeFile(path.join(own,'requirements-README.md.after.snapshot'),next,{flag:'wx'});
const proposals=[{path:'products/rea-studio/requirements/system-products.json',before:id(await fs.readFile(path.join(own,'system-products.json.before.snapshot'))),after:id(await fs.readFile(path.join(own,'system-products.json.after.snapshot'))),source:'system-products.json.after.snapshot'},{path:readmePath,before:id(readme),after:id(Buffer.from(next)),source:'requirements-README.md.after.snapshot'}];
const source737=JSON.parse(await fs.readFile(path.join(work,'editor-vault-suite-runs/2026-10-13T05-22-11.249Z/source-before.json')));assert.equal(source737.length,737);for(const r of source737)assert.deepEqual(id(await fs.readFile(path.join(lab,'products/rea-studio',r.path))),{bytes:r.bytes,sha256:r.sha256});assert(!source737.some(r=>r.path.startsWith('requirements/')));
await fs.writeFile(path.join(own,'first-publication-failure.stderr.txt.snapshot'),await fs.readFile(path.join(work,'editor-vault-checkpoint-publication-v1.stderr.txt')),{flag:'wx'});await fs.writeFile(path.join(own,'installation-authority.json.snapshot'),installation,{flag:'wx'});await fs.writeFile(path.join(own,'original-source-identities.json'),JSON.stringify(identities,null,2)+'\n',{flag:'wx'});await fs.writeFile(path.join(own,'capability-identities.json'),JSON.stringify(all,null,2)+'\n',{flag:'wx'});await fs.writeFile(path.join(own,'audit.json'),JSON.stringify({at:new Date().toISOString(),sourceOnly:true,proposals,changedLocalEvidence:changes,allLocalEvidence:audit,originalSourceIdentities:159,capabilityIDs:232,applicationSourcesUnchanged:737,developmentReceiptSHA256:sha(await fs.readFile(path.join(lab,'products/rea-studio/results/development-validation.json'))),originalRuntimeExecutions:0,productionWrites:0,publicationCommitted:false},null,2)+'\n',{flag:'wx'});await fs.writeFile(path.join(own,'collector.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});
const inventory=[];for(const name of(await fs.readdir(own)).sort()){const b=await fs.readFile(path.join(own,name));inventory.push({path:name,...id(b)});}const mb=Buffer.from(JSON.stringify({schema:'rea-vault-requirement-binding-correction-plan/v1',inventory},null,2)+'\n');await fs.writeFile(path.join(own,'manifest.json'),mb,{flag:'wx'});console.log(JSON.stringify({proposals:2,changedLocalEvidence:3,allLocalEvidence:audit.length,applicationSourcesUnchanged:737,manifestSHA256:sha(mb)}));
