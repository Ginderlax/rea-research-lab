      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.e3649e3468bf857f63df",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The previous Search interface is now deprecated and will be removed in a future release. We recommend that you start using the new editor as soon as possible and migrate existing dashboards.",
      "headingPath": [
        "What’s new in Grafana v10.1",
        "Data sources",
        "Tempo Search powered by TraceQL"
      ],
      "source": {
