import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),sha=data=>createHash('sha256').update(data).digest('hex'),median=v=>[...v].sort((a,b)=>a-b)[Math.floor(v.length/2)],stats=v=>({samples:v.length,median:median(v),min:Math.min(...v),max:Math.max(...v),values:v}),records={};
for(const [name,root,receipt,digest]of [['previous','../metrics-selector-measurement-next','results/paired-control-1791843146458.json',''],['latest','../metrics-algorithm-measurement-next','results/paired-control-1791846775389.json','a24647644314c004342886b06a366edebc52b681c8b30a256d7397af7c26e40a']]){const base=path.resolve(here,root),data=await fs.readFile(path.join(base,receipt));if(digest)assert.equal(sha(data),digest);const parsed=JSON.parse(data),publishedSummary=JSON.parse(await fs.readFile(path.join(here,'preserved/'+(name==='previous'?'previous':'latest')+'-summary.json')));assert.equal(parsed.records.length,147);assert.deepEqual(parsed.sourceHashesBefore,parsed.sourceHashesAfter);const rows=[],rawBindings=[];
for(const record of parsed.records){assert.equal(record.exitCode,0);const bytes=await fs.readFile(path.join(base,record.stdout.path));assert.equal(sha(bytes),record.stdout.sha256);assert.deepEqual(JSON.parse(bytes),record.result);rawBindings.push({sourcePath:record.stdout.path,bytes:bytes.length,sha256:sha(bytes)});rows.push({run:record.runNumber,case:record.caseName,role:record.implementation,wallMillisecondsPerCall:record.result.millisecondsPerCall,cpuMillisecondsPerCall:record.result.cpuMicroseconds/1000/record.result.iterations,elapsedWallMilliseconds:record.result.elapsedMilliseconds,cpuMicroseconds:record.result.cpuMicroseconds,warmup:record.result.warmup,iterations:record.result.iterations,start:record.start,end:record.completedAt});}
const grouped=[];for(const caseName of ['smallStandard','largeStandard','singlePercentile','allPercentiles','allCalculations','constructedPercentile','adversarialFallbackPercentile']){const per={};for(const role of ['original','baseline','candidate']){const list=rows.filter(r=>r.case===caseName&&r.role===role).sort((a,b)=>a.run-b.run);assert.equal(list.length,7);per[role]={wall:stats(list.map(r=>r.wallMillisecondsPerCall)),cpu:stats(list.map(r=>r.cpuMillisecondsPerCall))};const expected=publishedSummary.timingSummary.find(r=>r.caseName===caseName).millisecondsPerCall[role];assert.deepEqual(per[role].wall.values,expected.values);}
grouped.push({case:caseName,perImplementation:per,baselineRangeWidthPercent:100*(per.baseline.wall.max-per.baseline.wall.min)/per.baseline.wall.median,candidateRangeWidthPercent:100*(per.candidate.wall.max-per.candidate.wall.min)/per.candidate.wall.median,candidateVsBaselineRatioOfMediansPercent:100*(per.candidate.wall.median/per.baseline.wall.median-1),candidateVsBaselinePairedWallPercent:stats(per.candidate.wall.values.map((v,i)=>100*(v/per.baseline.wall.values[i]-1)))});}
records[name]={pairedReceipt:{sourceRoot:base,sourcePath:receipt,bytes:data.length,sha256:sha(data)},sourceHashes:parsed.sourceHashesBefore,rows,rawBindings,grouped,measurementExecutedByThisAnalysis:false};await fs.writeFile(path.join(here,'preserved/'+name+'-paired-receipt.json'),data,{flag:'wx'});}
const comparison=records.latest.grouped.map(row=>{const old=records.previous.grouped.find(r=>r.case===row.case);return {case:row.case,baselineCrossWindowMedianChangePercent:100*(row.perImplementation.baseline.wall.median/old.perImplementation.baseline.wall.median-1),originalCrossWindowMedianChangePercent:100*(row.perImplementation.original.wall.median/old.perImplementation.original.wall.median-1),scope:'Descriptive reuse of prior measurements from distinct windows; not a controlled new comparative study or causal adjustment.'};});
const result={schema:'rea-metrics-recorded-wrapper-diagnostics/v1',checkedAt:new Date().toISOString(),records,crossWindowDescriptiveControls:comparison,newTimedComparativeStudy:false,profileExecuted:false,noCausalAttribution:true,cpuDiagnostics:'Child process CPU deltas include process threads; CPU time is not wall time and does not identify GC, compiler transitions, machine contention, or causation.',shortMultiSelectionLoop:'Both allPercentiles and allCalculations use2 warmups and3 measured iterations per child; this alone does not demonstrate stabilized compiler state.',frozenTrialsUnmodified:true};await fs.writeFile(path.join(here,'recorded-diagnostics.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:'recomputed recorded data only',childrenAuthenticated:294,wrapperStudyNotExecuted:true,selectedControls:records.latest.grouped.filter(r=>['smallStandard','allPercentiles','allCalculations'].includes(r.case)).map(({case:caseName,baselineRangeWidthPercent,candidateRangeWidthPercent,candidateVsBaselineRatioOfMediansPercent,candidateVsBaselinePairedWallPercent})=>({caseName,baselineRangeWidthPercent,candidateRangeWidthPercent,candidateVsBaselineRatioOfMediansPercent,pairedMedian:candidateVsBaselinePairedWallPercent.median})),crossWindowControls:comparison}));
