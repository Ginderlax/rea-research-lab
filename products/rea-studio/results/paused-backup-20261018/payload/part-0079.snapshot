    {
      "id": "grafana.candidate.8b6139c9aaf72d7fbb8e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Time series visualizations are the default way to show the variations of a set of data values over time. Each data point is matched to a timestamp and this _time series_ is displayed as a graph. The visualization can render series as lines, points, or bars and it's versatile enough to display almost any type of [time-series data](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/fundamentals/timeseries/).",
      "headingPath": [
        "Time series"
      ],
      "source": {
