    {
      "id": "grafana.candidate.dece7cb51e090eec9c07",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana displays a list of fields returned by the query, allowing you to perform the following actions:",
      "headingPath": [
        "Transform data",
        "Transformation functions",
        "Organize fields by name",
        "Transforming fields"
      ],
