assert sum(x=='A'for x in expected.values())==95 and sum(x=='M'for x in expected.values())==4
protected=v['protectedRows'];assert len(protected)==len({r['path']for r in protected})==46
pb=batch(BEFORE,[r['path']for r in protected]);pa=batch(AFTER,[r['path']for r in protected])
for r in protected:assert ident(pb[r['path']])==ident(pa[r['path']])==ident(read(R/r['path']))=={k:r[k]for k in('bytes','sha256')}
assert len([r for r in protected if r['path'].startswith('products/rea-studio/apps/notes/')])==32
for name,pin in [('authorities/capsule.json',v['capsuleAuthority']),('authorities/documentation.json',v['documentationAuthority']),('authorities/documentation-peer.json',{k:v['documentationPeer'][k]for k in('bytes','sha256')})]:assert ident(read(D/name))==pin
