    {
      "id": "grafana.candidate.de6616795489d790decb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If `validate_id_token` is set to `true`, you must configure `jwk_set_url`. Authentication will fail if the JWK Set URL is not provided or if the ID token signature cannot be verified.",
      "headingPath": [
        "Configure Google OAuth authentication",
        "Configure Google authentication client using the Grafana configuration file",
        "Enable Google OAuth in Grafana",
        "Configure JWT ID token validation"
      ],
