    },
    {
      "id": "grafana.candidate.c84ad118a4bc9b8f7d25",
      "syntaxRole": "procedural-step",
      "sourceText": "3. Merge the pull request. The instance syncing `main` picks up the promoted dashboards on its next sync.",
      "headingPath": [
        "Testing sandboxes with Git Sync",
        "Promote a sandbox to main",
        "Option 1: Open a pull request from the sandbox branch (recommended)"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/git-sync/scenarios/testing-sandboxes.md",
        "gitBlobSha": "ab0b5a5c579a3ec986a716a3d624f56b3e79cf67",
        "sha256": "54a70c21506a3344e822c1438cb3767384a14cf4fac3e250aa75aab4d11c67cc",
        "lineStart": 158,
        "lineEnd": 158,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/as-code/observability-as-code/git-sync/scenarios/testing-sandboxes.md#L158-L158"
      },
      "applicability": {
        "status": "unresolved-no-explicit-oss-products-label",
        "products": []
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.615c68cccd53166a179f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This keeps a full review and audit trail for everything that reaches `main`, and is the recommended path when `main` feeds production.",
      "headingPath": [
        "Testing sandboxes with Git Sync",
        "Promote a sandbox to main",
        "Option 1: Open a pull request from the sandbox branch (recommended)"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/git-sync/scenarios/testing-sandboxes.md",
        "gitBlobSha": "ab0b5a5c579a3ec986a716a3d624f56b3e79cf67",
        "sha256": "54a70c21506a3344e822c1438cb3767384a14cf4fac3e250aa75aab4d11c67cc",
        "lineStart": 160,
        "lineEnd": 160,
