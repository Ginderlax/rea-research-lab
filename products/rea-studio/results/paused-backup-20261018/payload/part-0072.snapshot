    if (!response.ok) throw new Error(`Reference acquisition returned ${response.status}.`);
    const bytes = Buffer.from(await response.arrayBuffer());
    writeFileSync(join(root, 'artifacts/references', `${name}.txt`), bytes);
    if (name === 'license') writeFileSync(join(root, 'UPSTREAM-LICENSE.txt'), bytes);
    referenceRecords.push({ name, url, bytes: bytes.length, sha256: createHash('sha256').update(bytes).digest('hex'), retrieved_at_utc: new Date().toISOString(), role: name === 'license' ? 'upstream attribution' : 'source-assisted reference; not independently derived by REA' });
  }
  writeFileSync(join(root, 'reference-manifest.json'), JSON.stringify(referenceRecords, null, 2));
  const summary = {
