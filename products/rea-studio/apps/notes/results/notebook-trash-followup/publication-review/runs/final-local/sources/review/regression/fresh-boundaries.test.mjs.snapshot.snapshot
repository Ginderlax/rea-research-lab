import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';
import {ui,gate,find,memory} from './ui-fixture.mjs';
const observations=[];
test('programmatic field changes without input events are retained after older Save and persist to the committed ID',async t=>{const g=gate();let hold=false;const f=await ui(t,async({action})=>{if(action==='save'&&hold){g.enter();await g.held;}});await f.open();hold=true;const pending=f.click(f.byText('Save note'));await g.started;f.byLabel('Note title').value='Programmatic owned title';f.byLabel('Markdown note').value='Programmatic owned body';f.byLabel('Note tags').value='source, held';f.byLabel('Notebook').value=f.parent;hold=false;g.release();await pending;assert.equal(f.byLabel('Markdown note').value,'Programmatic owned body');assert.equal(f.byLabel('Note title').value,'Programmatic owned title');assert.equal(f.byText('Save note').disabled,false);await f.click(f.byText('Save note'));const row=f.read().notes[f.note.id];assert.equal(row.body,'Programmatic owned body');assert.equal(row.notebookId,f.parent);assert.deepEqual(row.tags,['source','held']);assert.equal(row.revision,3);observations.push({case:'signature without input event',passed:true,sameID:row.id===f.note.id});});
test('new-note Save with a later draft uses its committed identity for the following Save',async t=>{const g=gate();let hold=false;const f=await ui(t,async({action})=>{if(action==='save'&&hold){g.enter();await g.held;}});await f.click(f.byText('New note'));f.type(f.byLabel('Note title'),'Owned initial title');f.type(f.byLabel('Markdown note'),'Owned initial body');hold=true;const pending=f.click(f.byText('Save note'));await g.started;f.type(f.byLabel('Note title'),'Owned later title');f.type(f.byLabel('Markdown note'),'Owned later body');hold=false;g.release();await pending;assert.equal(f.byLabel('Markdown note').value,'Owned later body');const before=Object.values(f.read().notes).find(n=>n.id!==f.note.id);assert.equal(before.title,'Owned initial title');await f.click(f.byText('Save note'));const rows=Object.values(f.read().notes);assert.equal(rows.length,2);const after=rows.find(n=>n.id===before.id);assert.equal(after.title,'Owned later title');assert.equal(after.body,'Owned later body');assert.equal(after.revision,2);observations.push({case:'new-note identity after held Save',passed:true});});
test('late second refresh response cannot republish an older search after a newer query',async t=>{const g=gate();let hold=false;const f=await ui(t,async({action})=>{if(action==='notebook-list'&&hold){hold=false;g.enter();await g.held;}});await f.api('save',{title:'Other unique note',body:'Owned other content',notebookId:f.child});f.byLabel('Search notes').value='A note';hold=true;const older=f.click(f.byText('Search'));await g.started;f.byLabel('Search notes').value='Other unique';await f.click(f.byText('Search'));assert.ok(find(f.root,n=>n.tagName==='button'&&n.textContent.startsWith('Other unique note ·')));assert.equal(find(f.root,n=>n.tagName==='button'&&n.textContent.startsWith('A note ·')),null);g.release();await older;assert.ok(find(f.root,n=>n.tagName==='button'&&n.textContent.startsWith('Other unique note ·')));assert.equal(find(f.root,n=>n.tagName==='button'&&n.textContent.startsWith('A note ·')),null);observations.push({case:'held second refresh search',passed:true});});
test('both new lifecycle requests capture confirmation and revision before a held queue resumes',async()=>{const f=memory();const a=await f.call('notebook-create',{title:'A',revision:0});const request={id:a.notebook.id,revision:a.revision,confirmed:true},pending=f.call('notebook-trash',request);request.revision=-1;request.confirmed=false;await pending;let tree=await f.call('notebook-list');assert.equal(tree.notebooks[0].trashed,true);const restore={id:a.notebook.id,revision:tree.revision,confirmed:true},again=f.call('notebook-restore',restore);restore.id='invalid';restore.revision=-1;restore.confirmed=false;await again;tree=await f.call('notebook-list');assert.equal(tree.notebooks[0].trashed,false);observations.push({case:'captured lifecycle primitives',passed:true});});
test.after(async()=>{const folder=new URL(process.env.NOTES_REVIEW_OUTPUT??'./observations/',import.meta.url);await fs.mkdir(folder,{recursive:true});await fs.writeFile(new URL('fresh-boundaries.json',folder),JSON.stringify(observations,null,2)+'\n');});
