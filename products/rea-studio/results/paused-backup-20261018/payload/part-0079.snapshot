    {
      "id": "grafana.candidate.21c3f3da236bde8fe723",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can adjust connections, adding angles to them, to fit the canvas you're working in. When you move connected elements, the connection resizes to fit the space.",
