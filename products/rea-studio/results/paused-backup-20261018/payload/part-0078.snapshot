    },
    {
      "id": "grafana.candidate.4c6a4d422f80321ae71c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Live currently does not support Redis Sentinel. We recommend using a Redis Cluster for high-availability via a k8s helm chart such as the Bitnami Redis chart which has values to provision a Redis Cluster. Grafana Live can then be pointed to the `redis-headless` service.",
      "headingPath": [
        "Set up Grafana Live",
        "Configure Grafana Live HA setup",
        "Configure Redis Live engine"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/set-up-grafana-live.md",
        "gitBlobSha": "0aa7adff7477bf1c9cc08fa8d9bf3408b5a587b2",
        "sha256": "6a26e75e2110d530ee4277995d1c57bed1fd7312df4d2c2e40d2e5bafd3b9eab",
        "lineStart": 269,
        "lineEnd": 269,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/set-up-grafana-live.md#L269-L269"
      },
      "applicability": {
