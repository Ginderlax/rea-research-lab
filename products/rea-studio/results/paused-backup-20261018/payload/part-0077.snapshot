    {
      "id": "grafana.candidate.47e98ef9971fd1d5f1e6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When setting up SAML authentication with Entra ID, you may encounter issues with Graph API calls. This can happen if the Entra ID application is not properly configured to allow Graph API access.",
