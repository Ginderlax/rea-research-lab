    {
      "id": "grafana.candidate.c33557192b2d66be2213",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can also see in the previous image that the mathematical functions, **Mean** and **Max**, haven't been applied to the text field in the table. Only the **Last** function has been applied to that field.",
      "headingPath": [
