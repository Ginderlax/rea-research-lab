    {
      "id": "grafana.candidate.5903c7368198bbdd1802",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Alerting requires queries that return numeric data, which CloudWatch Logs supports. For example, you can enable alerts through the use of the `stats` command.",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Query CloudWatch Logs",
        "Create queries for alerting"
      ],
      "source": {
