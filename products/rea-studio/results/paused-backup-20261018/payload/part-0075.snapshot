    },
    {
      "id": "grafana.candidate.e998f78350f685b0b793",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The data source supports the `equals`, `not equals`, and `starts with` operators as detailed in the [Monitor Metrics API documentation](https://docs.microsoft.com/en-us/rest/api/monitor/metrics/list).",
      "headingPath": [
        "Azure Monitor query editor",
