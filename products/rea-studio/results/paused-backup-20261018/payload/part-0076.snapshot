    {
      "id": "grafana.candidate.0ed610beb08b98b0a603",
      "syntaxRole": "list-item",
      "sourceText": "- **Expanded queries** (using the `expand()` function) return the **full metric paths** that match your query.",
      "headingPath": [
        "Graphite template variables",
        "Use other query variables",
        "Compare expanded and non-expanded metric search results"
      ],
      "source": {
