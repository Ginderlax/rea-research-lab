import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
const work=import.meta.dirname,stage=path.join(work,'notes-notebooks-next'),adapter=path.join(work,'notes-notebooks-production-adapter'),sha=b=>createHash('sha256').update(b).digest('hex');
const manifestBytes=await fs.readFile(path.join(stage,'strict-manifest.json'));if(sha(manifestBytes)!=='825f8881734b845a8fac1c3fd26696dc0bf0ee79cc67a02cd6cd3c779d2f5c')throw new Error('Stage manifest identity changed.');const entries=JSON.parse(manifestBytes).entries;if(entries.length!==283)throw new Error('Unexpected stage count.');
const receiptBytes=await fs.readFile(path.join(stage,'stage-validation.json'));if(sha(receiptBytes)!=='588dec534d9994a7ecccfa76930ad3a0cc363b5e90ca7562e1d280217c63d7f8')throw new Error('Stage receipt identity changed.');
await fs.mkdir(adapter,{recursive:false});const appRoot=path.join(adapter,'products/rea-studio/apps/notes'),study=path.join(appRoot,'results/notebooks-followup/stage'),preserved=[];await fs.mkdir(study,{recursive:true});
for(const entry of entries){if(!entry.path||entry.path.includes('\\')||entry.path.startsWith('/')||entry.path.split('/').includes('..'))throw new Error('Unsafe stage entry.');const source=path.join(stage,entry.path),bytes=await fs.readFile(source);if(bytes.length!==entry.bytes||sha(bytes)!==entry.sha256)throw new Error('Stage artifact changed: '+entry.path);const relative=entry.path+'.snapshot',target=path.join(study,relative);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,bytes);preserved.push({originalPath:entry.path,preservedPath:relative,bytes:entry.bytes,sha256:entry.sha256});if(entry.path.startsWith('products/')){const live=path.join(adapter,entry.path);await fs.mkdir(path.dirname(live),{recursive:true});await fs.writeFile(live,bytes)}}
await fs.writeFile(path.join(study,'strict-manifest.json.snapshot'),manifestBytes);await fs.writeFile(path.join(appRoot,'results/notebooks-followup/preservation-manifest.json'),JSON.stringify({schema:'rea-notebook-production-adapter-preservation/v1',originalManifestSha256:sha(manifestBytes),originalReceiptSha256:sha(receiptBytes),stagePrefix:'stage/',count:283,files:preserved,manifestCarrier:{path:'stage/strict-manifest.json.snapshot',bytes:manifestBytes.length,sha256:sha(manifestBytes)}},null,2));
const oraclePath=path.join(appRoot,'notebook-original-oracle.mjs'),oldOracle=await fs.readFile(oraclePath,'utf8');let oracle=oldOracle;for(const [before,after] of [["new URL('../../../../',import.meta.url)","new URL('./results/notebooks-followup/stage/',import.meta.url)"],["new URL('source-provenance.json',root)","new URL('source-provenance.json.snapshot',root)"],["new URL(record.path,root)","new URL(record.path+'.snapshot',root)"],["new URL('license-and-special-id-provenance.json',root)","new URL('license-and-special-id-provenance.json.snapshot',root)"],["new URL(special.path,root)","new URL(special.path+'.snapshot',root)"]]){if(!oracle.includes(before))throw new Error('Missing exact oracle adaptation '+before);oracle=oracle.replace(before,after)}await fs.writeFile(oraclePath,oracle);
const readmePath=path.join(appRoot,'README.md'),oldReadme=await fs.readFile(readmePath,'utf8');const readme=oldReadme.replace("see the isolated stage's NOTICE and source provenance before redistributing the study.","see the [preserved study notice](results/notebooks-followup/stage/NOTICE.md.snapshot), [source provenance](results/notebooks-followup/stage/source-provenance.json.snapshot) and [license/reserved-ID provenance](results/notebooks-followup/stage/license-and-special-id-provenance.json.snapshot) before redistributing the study.");if(readme===oldReadme)throw new Error('README adaptation did not apply.');await fs.writeFile(readmePath,readme);
const changed=[{path:'products/rea-studio/apps/notes/notebook-original-oracle.mjs',oldSha256:sha(oldOracle),newSha256:sha(oracle),edits:'Five path-only substitutions; method extraction/runtime semantics untouched.'},{path:'products/rea-studio/apps/notes/README.md',oldSha256:sha(oldReadme),newSha256:sha(readme),edits:'Actual app-relative notice/provenance links only.'}];await fs.writeFile(path.join(adapter,'adaptations.json'),JSON.stringify({schema:'rea-notebook-production-adapter-diff/v1',changed,implementationChanged:false,testSemanticsChanged:false,all283OriginalBytesPreserved:true},null,2));
await fs.mkdir(path.join(adapter,'prior-root-review'));for(const [source,name] of [['review-notes-notebooks.mjs','review-notes-notebooks.mjs.snapshot'],['notes-notebooks-root-review/review-validation.json','review-validation.json.snapshot'],['notes-notebooks-root-review.stdout.txt','stdout.txt.snapshot'],['notes-notebooks-root-review.stderr.txt','stderr.txt.snapshot']])await fs.copyFile(path.join(work,source),path.join(adapter,'prior-root-review',name));await fs.copyFile(import.meta.filename,path.join(adapter,'prepare-notes-notebooks-adapter.mjs'));
console.log(JSON.stringify({adapter,preserved:preserved.length,changed}));
