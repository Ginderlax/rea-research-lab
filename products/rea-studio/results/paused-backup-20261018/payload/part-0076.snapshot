      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To optionally customize the default series name formatting, refer to [Standard options definitions](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/panels-visualizations/configure-standard-options/#display-name).",
      "headingPath": [
