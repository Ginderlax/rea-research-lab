    {
      "id": "grafana.candidate.186ebd629128b88728dd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The Pyroscope data source interpolates template variables in only some parts of the query editor. The following table lists which fields support variables.",
