        "provider_observation_limit": "69 provider registrations and option names were enumerated from the verified Windows binary with --config NUL. This is not an exhaustive provider-capability/alias/platform catalog and makes no live-service test claim."
      },
      "capabilities": [
        {
          "id": "RCLONE.CONFIG.001",
          "documented_capability": "Compatible configuration and remote definitions",
          "source_ids": [
            "rclone.cmd.config",
            "rclone.docs"
          ],
          "current_app_status": "not-implemented",
          "current_app_scope": "No rclone configuration/import, remote definitions or encrypted config support.",
          "evidence": [],
          "acceptance_checks": [
            "Implement version-bound configuration, environment/flag precedence and migration contracts."
          ],
          "original_release_comparison": "not-yet-established-for-this-capability",
          "completion_gate": "not-passed"
        },
        {
          "id": "RCLONE.PROVIDER.001",
          "documented_capability": "Registered backends and provider-specific capabilities",
          "source_ids": [
            "rclone.overview",
            "rclone.docs"
          ],
          "current_app_status": "not-implemented",
          "current_app_scope": "Only application-local folders exist; no remote provider is implemented.",
          "evidence": [],
          "acceptance_checks": [
            "Expand all 69 registered providers observed in the pinned Windows binary into option/feature requirements.",
            "Resolve aliases, platform-specific providers and documentation-only/deprecated entries; registry membership is not a provider-feature inventory."
          ],
          "original_release_comparison": "not-yet-established-for-this-capability",
          "completion_gate": "not-passed"
        },
        {
          "id": "RCLONE.COPY.001",
          "documented_capability": "Copy and copyto semantics",
          "source_ids": [
            "rclone.cmd.copy"
          ],
          "current_app_status": "implemented-local-subset",
          "current_app_scope": "Local copy with explicit conflict review and bounded sizes.",
          "evidence": [
            {
              "path": "products/rea-studio/apps/sync/app.test.mjs",
              "test_case": "dry runs write nothing and copy faithfully preserves binary files and empty directories"
            },
            {
              "path": "products/rea-studio/apps/sync/app.integration.test.mjs",
              "test_case": "HTTP persisted operations across host restart"
            }
          ],
          "acceptance_checks": [
            "Match original directory/file selection, destination interpretation, metadata, filtering and comparison flags."
          ],
          "original_release_comparison": "not-yet-established-for-this-capability",
          "completion_gate": "not-passed"
        },
        {
          "id": "RCLONE.SYNC.001",
          "documented_capability": "One-way synchronization and deletion policies",
          "source_ids": [
            "rclone.cmd.sync"
          ],
          "current_app_status": "implemented-local-subset",
          "current_app_scope": "Reviewed local mirroring removes target-only files; extra directories remain.",
          "evidence": [
            {
              "path": "products/rea-studio/apps/sync/app.test.mjs",
              "test_case": "mirror removal requires separate approval and two-way additions work in both directions"
            },
            {
              "path": "products/rea-studio/apps/sync/app.integration.test.mjs",
              "test_case": "HTTP persisted operations across host restart"
            }
          ],
          "acceptance_checks": [
            "Compare original sync deletion ordering, safety flags, backups and failures under every documented policy."
          ],
          "original_release_comparison": "not-yet-established-for-this-capability",
          "completion_gate": "not-passed"
        },
        {
          "id": "RCLONE.BISYNC.001",
          "documented_capability": "Bidirectional synchronization and recovery semantics",
