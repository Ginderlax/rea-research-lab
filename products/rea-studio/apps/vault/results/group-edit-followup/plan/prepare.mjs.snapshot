const docs={};docs['GROUP-EDIT.md']=readFileSync(resolve(work,'vault-group-edit-next/products/rea-studio/apps/vault/GROUP-EDIT.md'),'utf8').replace('This local WORK candidate adds child-group creation and editing of group name and notes. It extends the separately preserved native recursive group recycle candidate. It has not been installed into production or published.','This reviewed subset adds child-group creation and editing of group name and notes to the existing native group recycle workflow. The source-only installation proposal is separate from the immutable author885 and corrected137 epochs.');docs['GROUP-EDIT.md']+='\n## Corrected publication boundary and finite acceptance\n\nThe corrected client29f99c9132286e93ffdcc26105daa9d4209591b4aedad438cc6830841f227908 rechecks enabled name/notes values after the final group-list response. Newer drafts retain their mounted controls and adopt the saved native UUID/current MAC before subsequent Save; an acknowledged effective draft is cleared. A loaded list avoids a second unchecked await. Four substitutions invert exactly to the historical885 client.\n\n[Source-proof map](results/group-edit-followup/source-proof/preservation-manifest.json) preserves author885, negative78, corrected137, independent55, historical HTTP21/browser21 and corrected browser24 as distinct epochs. Independent15 consists of exact11 replay plus four additional controls; it is not a blind held-out campaign. The corrected normal browser records9 finite ordinary-response observations and13 stable source identities, with owned host/tab/data cleanup. Its browser campaign did not exercise held late-list responses; those boundaries use the independent real-client/backend model. Earlier22 original managed-assembly loads remain historical; installation adapters have not been executed by the publication-plan author. Root must run the installed source-bound selection after approval.\n';docs['GROUP-EDIT-NOTICE.md']=readFileSync(resolve(work,'vault-group-edit-next/products/rea-studio/apps/vault/GROUP-EDIT-NOTICE.md'),'utf8').replace('`source-study/selected/Docs/License.txt.snapshot` in this candidate','[the exact full GPL license]('+sources.find(r=>r.upstreamPath==='Docs/License.txt').publicPath.replace('products/rea-studio/apps/vault/','')+') in the public source-proof payload').replace("this candidate's public-safe preservation inventory","the source-only public preservation inventory");
let readme=readFileSync(resolve(repo,'products/rea-studio/apps/vault/README.md'),'utf8');assert(readme.includes('general group rename/reordering/management UI'));readme=readme.replace('general group rename/reordering/management UI','group moving/reordering, icon/tags/expiry/inheritance settings and general group management');const intro='Group creation and name/notes editing extend this bounded workflow. See [GROUP-EDIT.md](GROUP-EDIT.md) and [GROUP-EDIT-NOTICE.md](GROUP-EDIT-NOTICE.md) for source contracts, final-response draft guards, finite corrected model/browser evidence, GPL source identities and unsupported settings. Earlier343 and885 source epochs remain historical.\n\n';readme=readme.replace('This application supplies a real encrypted local vault workflow.',intro+'This application supplies a real encrypted local vault workflow.');docs['README.md']=readme;
