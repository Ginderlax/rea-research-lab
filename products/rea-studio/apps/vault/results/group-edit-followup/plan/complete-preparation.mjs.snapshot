const originalRecords=JSON.parse(readFileSync(resolve(repo,'products/rea-studio/results/editor-vault-reviewed-production-installation-20261013/preservation-manifest.json')));assert.equal(id(readFileSync(resolve(repo,'products/rea-studio/results/editor-vault-reviewed-production-installation-20261013/preservation-manifest.json'))).sha256,'3f810b748bfee60e396df83b668face23e52645871fcfcded3a4074445ce86d5');const reusable=new Map(originalRecords.records.map(r=>[key(r),r.publicPath])),payload=new Map(),records=[],authority=[],excluded=[];
function walk(root,p='',out=[]){for(const d of readdirSync(resolve(root,p),{withFileTypes:true})){assert(!d.isSymbolicLink());const n=p?p+'/'+d.name:d.name;if(d.isDirectory())walk(root,n,out);else out.push(n);}return out;}
for(const [epoch,folder,file,pin,count,qualification]of epochs){const root=resolve(work,folder),raw=readFileSync(resolve(root,file));assert.equal(id(raw).sha256,pin);const manifest=JSON.parse(raw);assert.equal(manifest.inventory.length,count);const names=new Set(manifest.inventory.map(r=>r.path)),extra=walk(root).filter(p=>!names.has(p)&&p!==file&&p!=='freeze.json');assert(extra.every(p=>manifest.excluded?.includes('.local/**')&&p.split('/').includes('.local')||manifest.excludedPrivate?.includes(p)));for(const p of extra)excluded.push({epoch,sourceRoot:'work/'+folder,sourcePath:p,...id(readFileSync(resolve(root,p))),public:false,reason:manifest.excludedPrivate?.includes(p)?'Explicit private browser session-control file; excluded bytes':'Declared .local fixtures outside historical885 inventory; excluded bytes, not denominator additions'});const rows=[...manifest.inventory,{path:file,...id(raw)}];if(existsSync(resolve(root,'freeze.json')))rows.push({path:'freeze.json',...id(readFileSync(resolve(root,'freeze.json')))});for(const r of rows){const b=readFileSync(resolve(root,r.path));assert(b.length<=32*1024*1024);assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});const publicPath=reusable.get(key(r))??'products/rea-studio/apps/vault/results/group-edit-followup/source-proof/payload/'+r.sha256+'.snapshot',reusedExistingPublic=reusable.has(key(r));if(reusedExistingPublic)assert.deepEqual(id(readFileSync(resolve(repo,publicPath))),id(b));else{assert.deepEqual(id(readFileSync(resolve(here,'source-proof/payload',r.sha256+'.snapshot'))),id(b));payload.set(r.sha256,{path:publicPath,bytes:r.bytes,sha256:r.sha256});}records.push({epoch,sourceRoot:'work/'+folder,sourcePath:r.path,bytes:r.bytes,sha256:r.sha256,publicPath,reusedExistingPublic,qualification});}authority.push({epoch,folder,file,manifest:id(raw),frozenPayloads:count,qualifiedAliases:rows.length,extraSelfSidecars:rows.length-count-1,excludedExtras:extra.length,qualification});}
j('source-proof/preservation-manifest.json',{schema:'rea-vault-group-edit-qualified-source-preservation/v1',epochs:authority,records,newUniquePublicPayloads:payload.size,newPayloads:[...payload.values()],reusedAliases:records.filter(r=>r.reusedExistingPublic).length,excluded,privateSessionControlBytesPublic:0,originalExecutableBytesPublic:0,originalArchiveBytesPublic:0,allDistinctEpochsPreserved:true,fullParity:false,superiority:false});
const paths=['system-products.json','workspace-products.json','visual-products.json'].map(n=>'products/rea-studio/requirements/'+n),registries=paths.map(path=>{const raw=readFileSync(resolve(repo,path)),v=JSON.parse(raw),capabilityIDs=v.capabilities?.map(c=>c.id)??v.products?.flatMap(p=>p.capabilities.map(c=>c.id))??v.baselineProducts.flatMap(p=>p.requirements.map(c=>c.id));return{path,...id(raw),sources:v.sources.map(r=>({id:r.id,sha256:r.sha256})),capabilityIDs};});assert.equal(registries.reduce((n,r)=>n+r.sources.length,0),159);assert.equal(new Set(registries.flatMap(r=>r.capabilityIDs)).size,232);j('requirements-binding.json',{registries,sourceSHAIDPairs:159,capabilityIDs:232,implementationMetadataNotChanged:true});
