    {
      "id": "grafana.candidate.7c3d1e901d1f0466ba62",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Wrap the matcher in quotation marks when the key or value contains spaces or special characters, for example `label:\"team=~fe.*devs\"`.",
      "headingPath": [
        "View alert rules",
