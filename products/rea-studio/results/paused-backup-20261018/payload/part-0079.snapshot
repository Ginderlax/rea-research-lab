    {
      "id": "grafana.candidate.0962dcfa9f85ed45f799",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now scroll the content of a tooltip, which allows you to view long lists. This is currently supported in the time series, candlestick, and trend visualizations. We'll add more improvements to the scrolling functionality in a future version.",
      "headingPath": [
        "What’s new in Grafana v10.4",
        "Dashboards and visualizations",
        "Tooltip improvements"
