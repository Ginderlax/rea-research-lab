import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
export const here=import.meta.dirname,sha=bytes=>createHash('sha256').update(bytes).digest('hex');
export async function fp(file){const bytes=await fs.readFile(file);return{bytes:bytes.length,sha256:sha(bytes)};}
export const epochs=[['editor-search-next','44e8efd72f09c7cc5caa598f43dbe099dd73982477249ecfed2fddfb2a26a7a6',140],['editor-search-fix-next','b858a4cf15312f962bf0ac5ba2fd6b6c17466248ff1394c727a49ee0e665e9ef',124],['editor-search-path-fix-next','d071d370be094646a4738de79adadca9c28d794de53dfb940604f5d52d056edf',126],['vscode-original-acquisition-record','b592b223568ddc0736f9b6a9509b6eecbf9832b14e361cf31dcbf71878a636ec',14]];
async function names(root,folder='',rows=[]){for(const entry of await fs.readdir(path.join(root,folder),{withFileTypes:true})){const name=folder?folder+'/'+entry.name:entry.name;assert.ok(!entry.isSymbolicLink());if(entry.isDirectory())await names(root,name,rows);else rows.push(name);}return rows;}
export async function authenticate(){const result=[];for(const [name,digest,count] of epochs){const root=path.resolve(here,'../'+name),bytes=await fs.readFile(path.join(root,'freeze-manifest.json'));assert.equal(sha(bytes),digest);const manifest=JSON.parse(bytes),rows=Array.isArray(manifest.inventory)?manifest.inventory.map(({path,...row})=>[path,row]):Object.entries(manifest.inventory);assert.equal(rows.length,count);assert.deepEqual((await names(root)).sort(),[...rows.map(([name])=>name),'freeze-manifest.json'].sort());for(const [name,row] of rows)assert.deepEqual(await fp(path.join(root,name)),row);result.push({stage:name,files:count,manifestSHA256:digest});}const prior=path.resolve(here,'../editor-search-independent-review');assert.equal((await fp(path.join(prior,'freeze-manifest.json'))).sha256,'84e518fd347712e0602ca87920a3d4404410e36fe85ace6f86b7dbcc1bf13b3b');assert.equal((await fp(path.join(prior,'review-validation.json'))).sha256,'fde4f3434e0ad03fa55a00b32b0b45560677a9d04fdadcb0897d3aa4c7557e9c');assert.equal((await fp(path.join(prior,'provenance-validation.corrected.json'))).sha256,'04bf79b55eb55fe439832fe644c37a98ba22058502c0185635a26cb3e106866c');return result;}
export async function preserveCurrent(){const root=path.resolve(here,'../editor-search-path-fix-next'),manifest=JSON.parse(await fs.readFile(path.join(root,'freeze-manifest.json'))),rows=[];for(const name of [...Object.keys(manifest.inventory),'freeze-manifest.json']){const bytes=await fs.readFile(path.join(root,name)),relative='preserved/current/'+name.replaceAll('node_modules','synthetic-excluded-dependency')+'.snapshot';await fs.mkdir(path.dirname(path.join(here,relative)),{recursive:true});await fs.writeFile(path.join(here,relative),bytes,{flag:'wx'});rows.push({sourcePath:path.join(root,name),path:relative,bytes:bytes.length,sha256:sha(bytes)});}for(const name of ['review-validation.json','freeze-manifest.json','provenance-validation.corrected.json']){const sourcePath=path.resolve(here,'../editor-search-independent-review/'+name),bytes=await fs.readFile(sourcePath),relative='preserved/prior-review/'+name+'.snapshot';await fs.mkdir(path.dirname(path.join(here,relative)),{recursive:true});await fs.writeFile(path.join(here,relative),bytes,{flag:'wx'});rows.push({sourcePath,path:relative,bytes:bytes.length,sha256:sha(bytes)});}return rows;}
