    },
    {
      "id": "grafana.candidate.560d48f749f670d5d7a4",
      "syntaxRole": "list-item",
      "sourceText": "- [Timing options](#timing-options) determine when and how often to send the notification.",
      "headingPath": [
        "Group alert notifications",
        "Group notifications"
      ],
      "source": {
        "path": "docs/sources/alerting/fundamentals/notifications/group-alert-notifications.md",
