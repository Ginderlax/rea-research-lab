    {
      "id": "grafana.candidate.b0e4084a7a3a9dab1a62",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We recommend that you remove transformations that you don't need. When you delete a transformation, you remove the data from the visualization.",
