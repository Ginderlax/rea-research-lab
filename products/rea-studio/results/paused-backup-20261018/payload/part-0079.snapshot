    {
      "id": "grafana.candidate.117a521bd0a1e1290f8e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This Grafana release includes the following authentication updates.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Grafana OSS features",
        "Authentication updates"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-0.md",
