    {
      "id": "grafana.candidate.fdf3f3e826d6abdeea40",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**High availability:** if you run two or more Grafana instances, configure a Redis session store or enable sticky sessions at the load balancer to prevent users from being signed out between requests. Refer to [Set up Grafana for high availability](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/setup-grafana/set-up-for-high-availability/).",
      "headingPath": [
        "Install Grafana",
        "Hardware recommendations",
        "Deployment tiers",
        "Medium"
      ],
