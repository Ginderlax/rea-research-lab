import fs from'node:fs/promises';import path from'node:path';import os from'node:os';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{spawn}from'node:child_process';
import{searchWorkspace,disposeSearch}from'../editor-search-pattern-next/candidate/products/rea-studio/apps/editor/workspace-search.mjs';import{patternWorkerState}from'../editor-search-pattern-next/candidate/products/rea-studio/apps/editor/search-pattern-session.mjs';import{createWorkspace}from'../editor-search-pattern-next/candidate/products/rea-studio/lib/storage.mjs';
const here=import.meta.dirname,work=path.resolve(here,'../..'),stage=path.resolve(here,'../editor-search-pattern-next'),run='runs/original-'+new Date().toISOString().replace(/[:.]/g,'-'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),json=v=>Buffer.from(JSON.stringify(v,null,2)+'\n');
async function save(p,b){await fs.mkdir(path.dirname(path.join(here,p)),{recursive:true});await fs.writeFile(path.join(here,p),b,{flag:'wx'});}
const cases=[
 {id:'escaped-bracket-Unicode-word',query:'[\\w\\]]+',originalPattern:'[\\w\\]]+',content:'] é中 a\u0301 [ x\u200c 7\u0662\r\n'},
 {id:'Unicode-decimal-boundary',query:'\\d{2}\\b',originalPattern:'\\d{2}\\b',content:'12x ٣٤ ４５ # 12\r\n'},
 {id:'common-Unicode-whitespace',query:'\\s+',originalPattern:'\\s+',content:'x\t x\u00a0x\u2009x  x\r\n'},
 {id:'literal-whole-word-Unicode-neighbors',query:'beta',originalPattern:'\\bbeta\\b',wholeWord:true,useRegex:false,content:'beta 𠀀beta βbeta beta\u0301 beta\u200d !beta? beta_\r\n'},
 {id:'Unicode-case-alternation',query:'(?:Ω|K|é)+',originalPattern:'(?:Ω|K|é)+',matchCase:false,content:'Ω ω K k K é É Œ\r\n'},
 {id:'bare-CR-vs-CRLF-final-anchor',query:'^B$',originalPattern:'^B$',content:'A\rB\rC\r\nB\r\nB\r'},
 {id:'adjacent-empty-with-astral',query:'A|(?=.)',originalPattern:'A|(?=.)',content:'😀A😀\r\n😀Z\n'},
 {id:'all-boundary-positions',query:'\\b|\\B',originalPattern:'\\b|\\B',content:'😀_a\u0301\r\n😀Z\n\n'},
];
const manifestBytes=await fs.readFile(path.join(stage,'freeze-manifest.json'));assert.equal(id(manifestBytes).sha256,'7f975ae3f7a0827f5b9ade231bd121c5b4028f17d88758455fd680962ff0f878');const manifest=JSON.parse(manifestBytes);assert.equal(manifest.inventory.length,573);
async function authenticate(){const out=[];for(const r of manifest.inventory){const b=await fs.readFile(path.join(stage,r.path));assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256},r.path);out.push({path:r.path,...id(b)});}assert.equal(id(await fs.readFile(path.join(stage,'freeze-manifest.json'))).sha256,id(manifestBytes).sha256);return out;}
const before=await authenticate();await save(run+'/author-before.json',json(before));const source=await fs.readFile(new URL(import.meta.url));await save(run+'/review-source.mjs.snapshot',source);await save(run+'/cases-before.json',json(cases));
const engineBytes=await fs.readFile(path.join(stage,'original-engine.json'));const engine=JSON.parse(engineBytes);const exe=path.join(work,...engine.path.split('/'));assert.equal(engine.identity.sha256,'ba5105e5c9d2beb2af7b64d53d782a780f1d53e2a5e331d9ac71b06348cb533c');assert.deepEqual(id(await fs.readFile(exe)),{bytes:5440824,sha256:engine.identity.sha256});await save(run+'/engine-provenance.json.snapshot',engineBytes);await save(run+'/node-provenance.json',json({path:process.execPath,version:process.version,...id(await fs.readFile(process.execPath)),binaryCopied:false}));
const temp=await fs.mkdtemp(path.join(os.tmpdir(),'rea-original-pattern-review-')),workspaces=[],commands=[],pairs=[];
async function original(label,args){assert.deepEqual(id(await fs.readFile(exe)),{bytes:5440824,sha256:engine.identity.sha256});let out=[],err=[],outBytes=0,errBytes=0,limit=null,spawnError=null;const child=spawn(exe,args,{cwd:temp,windowsHide:true,stdio:['ignore','pipe','pipe']}),stop=r=>{limit??=r;child.kill();},timer=setTimeout(()=>stop('original10s'),10000);child.stdout.on('data',b=>{outBytes+=b.length;if(outBytes<=262144)out.push(b);else stop('stdout256KiB');});child.stderr.on('data',b=>{errBytes+=b.length;if(errBytes<=65536)err.push(b);else stop('stderr64KiB');});const exit=await new Promise(resolve=>{child.on('error',e=>spawnError=String(e));child.on('close',(code,signal)=>resolve({code,signal}));});clearTimeout(timer);const stdout=Buffer.concat(out),stderr=Buffer.concat(err);await save(run+'/original/'+label+'.stdout.txt',stdout);await save(run+'/original/'+label+'.stderr.txt',stderr);assert.equal(limit,null);assert.equal(spawnError,null);assert.equal(exit.signal,null);assert.deepEqual(id(await fs.readFile(exe)),{bytes:5440824,sha256:engine.identity.sha256});commands.push({label,args,...exit,pid:child.pid,limit,spawnError,stdout:id(stdout),stderr:id(stderr)});return{stdout,stderr,...exit};}
function spans(stdout,content){const bytes=Buffer.from(content),rows=[];for(const line of stdout.toString().split('\n').filter(Boolean)){const j=JSON.parse(line);if(j.type!=='match')continue;const data=j.data;assert(typeof data.lines.text==='string');const rowBytes=Buffer.from(data.lines.text);for(const s of data.submatches){const start=data.absolute_offset+s.start,end=data.absolute_offset+s.end;rows.push({line:data.line_number,column:rowBytes.subarray(0,s.start).toString().length+1,endColumn:rowBytes.subarray(0,s.end).toString().length+1,start:bytes.subarray(0,start).toString().length,end:bytes.subarray(0,end).toString().length});}}return rows;}
let error=null;
try{
 const version=await original('version',['--version']);assert.equal(version.code,0);assert(version.stdout.toString().includes('ripgrep 15.0.0'));
 for(let i=0;i<cases.length;i++){const c=cases[i],root=path.join(temp,'case-'+i);await fs.mkdir(root);const ws=await createWorkspace(root);workspaces.push(ws);const file=await ws.resolve('fixture.txt');await fs.writeFile(file,c.content);const args=['--json','--no-config','--no-ignore','--no-ignore-global','--crlf','--engine','auto',c.matchCase===false?'--ignore-case':'--case-sensitive','--regexp',c.originalPattern,file];const originalResult=await original(c.id,args);assert([0,1].includes(originalResult.code));const originalRows=spans(originalResult.stdout,c.content),candidate=await searchWorkspace(ws,{query:c.query,useRegex:c.useRegex??true,wholeWord:c.wholeWord??false,matchCase:c.matchCase??true});const candidateRows=candidate.matches.map(({line,column,endColumn,start,end})=>({line,column,endColumn,start,end}));const exact=JSON.stringify(candidateRows)===JSON.stringify(originalRows);pairs.push({id:c.id,options:{query:c.query,useRegex:c.useRegex??true,wholeWord:c.wholeWord??false,matchCase:c.matchCase??true},originalPattern:c.originalPattern,candidateRows,originalRows,exact,candidateIncomplete:candidate.truncated,candidateReasons:candidate.limitReasons});assert.equal(patternWorkerState().active,0);}
 const invalidRoot=path.join(temp,'invalid');await fs.mkdir(invalidRoot);const ws=await createWorkspace(invalidRoot);workspaces.push(ws);const file=await ws.resolve('fixture.txt');await fs.writeFile(file,'owned invalid-pattern fixture\n');const invalid=await original('invalid-pattern',['--json','--no-config','--no-ignore','--crlf','--engine','auto','--regexp','(',file]);assert.equal(invalid.code,2);let rejected;try{await searchWorkspace(ws,{query:'(',useRegex:true});}catch(e){rejected={message:e.message,code:e.code};}assert(rejected);await save(run+'/invalid-presence.json',json({originalExit:2,candidate:rejected,exactErrorTextClaim:false}));
}catch(e){error={name:e.name,message:e.message,stack:String(e.stack)};await save(run+'/failure.txt',Buffer.from(String(e.stack)+'\n'));}
finally{for(const ws of workspaces)await disposeSearch(ws);assert.equal(patternWorkerState().active,0);const absolute=path.resolve(temp);assert(absolute.startsWith(path.resolve(os.tmpdir())+path.sep)&&path.basename(absolute).startsWith('rea-original-pattern-review-'));await fs.rm(absolute,{recursive:true,force:true});}
const after=await authenticate();assert.deepEqual(after,before);await save(run+'/author-after.json',json(after));assert(source.equals(await fs.readFile(new URL(import.meta.url))));await save(run+'/comparisons.json',json(pairs));await save(run+'/original-commands.json',json(commands));const exact=pairs.filter(r=>r.exact),different=pairs.filter(r=>!r.exact);await save(run+'/validation.json',json({schema:'rea-editor-pattern-independent-original-campaign/v1',sourceStable:true,author573Unchanged:true,candidateGroups:pairs.length,exactGroups:exact.length,unequalGroups:different.map(r=>r.id),exactOriginalPositions:exact.reduce((n,r)=>n+r.originalRows.length,0),originalEngineCommands:commands.length,originalSearchCommands:commands.filter(r=>r.label!=='version').length,originalVersionCommands:commands.filter(r=>r.label==='version').length,originalSourceHelperCalls:0,originalConversionCalls:0,originalNativeWorkbench:0,originalGUI:0,browsers:0,hosts:0,error,syntheticTempGone:true,originalBinaryOnlyIndependentOracle:true,originalBinaryCopied:false,sourceOnlyManualPatternBoundary:'Selected one-file engine arguments; manually supplied whole-word beta pattern matches pinned helper contract, but no original search service or helper execution is claimed.',originalErrorPresenceComparisons:1,exactOriginalErrorTextComparisons:0,engineDifferencesNotSilentlyMatched:true,fullProductParity:false,securityEquivalence:false,superiority:false}));process.stdout.write(JSON.stringify({run,groups:pairs.length,exactGroups:exact.length,unequalGroups:different.map(r=>r.id),originalCommands:commands.length,error})+'\n');assert.equal(error,null,'Independent original campaign collector failed; exact source/raw retained');
