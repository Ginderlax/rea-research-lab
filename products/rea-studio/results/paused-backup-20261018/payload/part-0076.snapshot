    {
      "id": "grafana.candidate.2f7de7663347397b2bee",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Azure Entra Password is not a recommended authentication mechanism as it requires configuration using a single users password. Consider an alternative authentication method such as current user authentication or app registration.",
      "headingPath": [
        "Configure the Microsoft SQL Server data source",
        "Configure the data source in the UI",
        "Azure Entra Password"
