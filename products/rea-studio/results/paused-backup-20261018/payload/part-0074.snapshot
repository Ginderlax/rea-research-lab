    },
    {
      "id": "grafana.candidate.21cb42229a6e68cc5d8f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Switch to the `grafana-onprem` context and use the pull command to fetch the resources you want to migrate:",
      "headingPath": [
        "Migrate from Grafana OSS/Enterprise to Grafana Cloud manually",
        "Migrate Grafana resources",
        "Migrate dashboards, folders, data sources, library panels, and alert rules using Grizzly",
        "Export existing resources"
      ],
      "source": {
        "path": "docs/sources/administration/migration-guide/manually-migrate-to-grafana-cloud.md",
