import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import assert from 'node:assert/strict';
import {summarizeSigned,pairedDifferences} from '../metrics-wrapper-measurement-next/summary.mjs';
const here=path.dirname(fileURLToPath(import.meta.url)),summary=JSON.parse(await fs.readFile(path.join(here,'recomputed-summary.json'))),roles=['original','baseline','candidate'];
let checkedStatistics=0,checkedPairs=0,maxPercentageRoundoff=0;
function checkPercentages(left,right){assert.equal(left.length,right.length);for(let i=0;i<left.length;i++){if(left[i]===null||right[i]===null){assert.equal(left[i],right[i]);continue;}const delta=Math.abs(left[i]-right[i]);maxPercentageRoundoff=Math.max(maxPercentageRoundoff,delta);assert.ok(delta<=512*Number.EPSILON*Math.max(1,Math.abs(left[i]),Math.abs(right[i])),'Equivalent percentage formulas differ beyond floating-point roundoff.');}}
function checkStats(record){const prospective=summarizeSigned(record.values,7);for(const key of ['samples','median','min','max'])assert.equal(record[key],prospective[key]);assert.equal(prospective.complete,true);checkedStatistics++;}
for(const row of summary.timingSummary){for(const role of roles)checkStats(row.millisecondsPerCall[role]);for(const reference of ['baseline','original']){const independent=row.candidateComparedWith[reference],prospective=pairedDifferences(row.millisecondsPerCall.candidate.values,row.millisecondsPerCall[reference].values,7);assert.deepEqual(independent.pairedDifferenceMilliseconds.values,prospective.rows.map(row=>row.difference));checkPercentages(independent.pairedRatioPercent.values,prospective.rows.map(row=>row.percentChange));checkedPairs+=7;}}
for(const row of summary.memorySummary){for(const role of roles)for(const record of Object.values(row.metricsByImplementation[role]))checkStats(record);for(const reference of ['baseline','original'])for(const [metric,independent]of Object.entries(row.candidateComparedWith[reference])){const prospective=pairedDifferences(row.metricsByImplementation.candidate[metric].values,row.metricsByImplementation[reference][metric].values,7);assert.deepEqual(independent.pairedDifferenceBytes.values,prospective.rows.map(row=>row.difference));assert.deepEqual(independent.pairedPercentChange.values,prospective.rows.map(row=>row.percentChange));assert.equal(independent.pairedPercentChange.missingOrUnavailable,prospective.rows.filter(row=>row.percentChange===null).length);checkedPairs+=7;}}
const esc=value=>'"'+String(value===null?'null':value).replaceAll('"','""')+'"',csv=rows=>rows.map(row=>row.map(esc).join(',')).join('\n')+'\n',write=async(name,value)=>fs.writeFile(path.join(here,name),value,{flag:'wx'});
const timing=[['case','implementation','median_ms','min_ms','max_ms','samples','all_values_ms']],timingPaired=[['case','control','run','candidate_ms','control_ms','signed_difference_ms','signed_percent_change']],memory=[['case','implementation','metric','median_bytes','min_bytes','max_bytes','samples','all_values_bytes']],memoryPaired=[['case','control','metric','run','candidate_bytes','control_bytes','signed_difference_bytes','signed_percent_change']],perChild=[['case','implementation','run','pid','metric','signed_or_absolute_bytes']];
for(const row of summary.timingSummary){for(const role of roles){const stat=row.millisecondsPerCall[role];timing.push([row.caseName,role,stat.median,stat.min,stat.max,stat.samples,JSON.stringify(stat.values)]);}for(const reference of ['baseline','original'])for(let run=0;run<7;run++)timingPaired.push([row.caseName,reference,run,row.millisecondsPerCall.candidate.values[run],row.millisecondsPerCall[reference].values[run],row.candidateComparedWith[reference].pairedDifferenceMilliseconds.values[run],row.candidateComparedWith[reference].pairedRatioPercent.values[run]]);}
for(const row of summary.memorySummary){for(const role of roles)for(const [metric,stat]of Object.entries(row.metricsByImplementation[role]))memory.push([row.caseName,role,metric,stat.median,stat.min,stat.max,stat.samples,JSON.stringify(stat.values)]);for(const reference of ['baseline','original'])for(const [metric,stat]of Object.entries(row.candidateComparedWith[reference]))for(let run=0;run<7;run++)memoryPaired.push([row.caseName,reference,metric,run,row.metricsByImplementation.candidate[metric].values[run],row.metricsByImplementation[reference][metric].values[run],stat.pairedDifferenceBytes.values[run],stat.pairedPercentChange.values[run]]);}
for(const row of summary.memorySignedPerChildRows)for(const [metric,value]of Object.entries(row.metrics))perChild.push([row.caseName,row.implementation,row.runNumber,row.pid,metric,value]);
const artifacts={'timing-summary.csv':timing,'timing-paired.csv':timingPaired,'memory-summary.csv':memory,'memory-paired.csv':memoryPaired,'memory-per-child.csv':perChild};for(const [name,rows]of Object.entries(artifacts))await write(name,csv(rows));
const copies=summary.preservation.copies;await write('preservation-copylist.csv',csv([['source_path','inert_path','bytes','sha256'],...copies.map(row=>[row.sourcePath,row.path,row.bytes,row.sha256])]));
const f=value=>value===null?'unavailable':Number(value).toFixed(6),percent=value=>f(value)+'%',mib=value=>f(value/1048576),range=stat=>'['+f(stat.min)+', '+f(stat.max)+']';
let table='Every row uses all seven recorded repetitions. A positive change means candidate is higher/slower. Medians of paired changes and changes of medians answer different questions. Ranges are observations, not confidence intervals.\n\n';
table+='| Workload | Original median ms | Baseline median ms | Candidate median ms | Change of medians vs baseline | Median paired change | Slower pairs | Native ranges overlap |\n|---|---:|---:|---:|---:|---:|---:|---|\n';
for(const row of summary.timingSummary){const comparison=row.candidateComparedWith.baseline;table+='| '+[row.caseName,...roles.map(role=>f(row.millisecondsPerCall[role].median)),percent(comparison.medianRatioPercent),percent(comparison.pairedRatioPercent.median),comparison.candidateSlowerPairs+'/7',String(comparison.observedRanges.overlap)].join(' | ')+' |\n';}
table+='\n| Workload | Baseline timing range ms | Candidate timing range ms | Paired change range % | Change of medians vs original % |\n|---|---:|---:|---:|---:|\n';for(const row of summary.timingSummary)table+='| '+[row.caseName,range(row.millisecondsPerCall.baseline),range(row.millisecondsPerCall.candidate),range(row.candidateComparedWith.baseline.pairedRatioPercent),f(row.candidateComparedWith.original.medianRatioPercent)].join(' | ')+' |\n';
table+='\nLifetime RSS includes the entire child. Polled RSS is a separate100ms diagnostic and can miss peaks. The complete20 memory metrics, signed pairs and zero-control null percentages are in the CSV files.\n\n| Workload | Original lifetime RSS median MiB | Baseline lifetime RSS median MiB | Candidate lifetime RSS median MiB | Median paired lifetime difference MiB | Native lifetime ranges overlap |\n|---|---:|---:|---:|---:|---|\n';
for(const row of summary.memorySummary)table+='| '+[row.caseName,...roles.map(role=>mib(row.metricsByImplementation[role].lifetimePeakRSSBytes.median)),mib(row.candidateComparedWith.baseline.lifetimePeakRSSBytes.pairedDifferenceBytes.median),String(row.candidateComparedWith.baseline.lifetimePeakRSSBytes.observedRanges.overlap)].join(' | ')+' |\n';
table+='\n| Workload | Original polled RSS median MiB | Baseline polled RSS median MiB | Candidate polled RSS median MiB | Median paired polled difference MiB |\n|---|---:|---:|---:|---:|\n';for(const row of summary.memorySummary)table+='| '+[row.caseName,...roles.map(role=>mib(row.metricsByImplementation[role].observedPeakRSSBytes.median)),mib(row.candidateComparedWith.baseline.observedPeakRSSBytes.pairedDifferenceBytes.median)].join(' | ')+' |\n';
await write('TABLES.md',table);
const rootWrapper=JSON.parse(await fs.readFile(path.join(here,'preserved/independent-reviews/metrics-wrapper-root-independent-review/review-validation.json.snapshot'))),rootReady=JSON.parse(await fs.readFile(path.join(here,'preserved/independent-reviews/metrics-wrapper-readiness-independent-review/review-validation.json.snapshot')));assert.equal(rootWrapper.passed,true);assert.equal(rootReady.status,'PASS_NO_AUTHENTICATION_BLOCKER');assert.equal(rootWrapper.candidateSHA256,summary.candidate.entrySHA256);assert.equal(rootReady.candidate.helperSHA256,summary.candidate.helperSHA256);assert.equal(rootReady.readinessSHA256,summary.readinessReceipt.sha256);assert.equal(rootWrapper.authenticatedStageArtifacts,86);assert.equal(rootReady.stageArtifacts,2426);
const small=summary.timingSummary.find(row=>row.caseName==='smallStandard'),allp=summary.timingSummary.find(row=>row.caseName==='allPercentiles'),single=summary.memorySummary.find(row=>row.caseName==='singlePercentile');
await write('README.md',`This is the frozen wrapper-only measurement review. Candidate remains unaccepted and production unchanged. Entry ${summary.candidate.entrySHA256} and helper ${summary.candidate.helperSHA256} are both required; baseline ${summary.candidate.baselineSHA256} remains exact. The candidate restores baseline wrapper/standard/multi-selection bodies with only the declared helper import and shared-absent single-percentile dispatch. Source layout/JIT attribution remains a hypothesis. No retuning, new measurements, profiler or full correctness campaign occurred during this consolidation.\n\nTiming ran exactly147 children in the authorized window2026-10-12T23:58:13Z through explicit closure2026-10-13T00:05:01Z. Actual measured series23:58:45.080Z–00:00:18.749Z lasted93.669s; outer controller lasted93.741s, within the conservative5–8minute reservation. Memory ran exactly147 fresh single-implementation children after separate authorization00:05:01Z and before explicit closure00:09:53Z. Its actual00:05:14.119Z–00:09:20.778Z interval lasted246.659s, within the10–15minute reservation. Root and both other agents paused tests/scans/writes/builds/browsers/profilers; root preview sessions54824/54899/59765/54465 stayed idle. User port4311 and unrelated Windows/user activity were uncontrolled. Coordination messages are trusted session evidence, not a machine-isolation attestation.\n\nAll seven workloads,14 input/expectation files, seeds, role rotation and seven repetitions remain fixed. Three single-p95 timings have disjoint lower observed ranges than both controls. All-percentile median is${percent(allp.candidateComparedWith.baseline.medianRatioPercent)} relative to baseline, with overlapping ranges; median paired change is${percent(allp.candidateComparedWith.baseline.pairedRatioPercent)}, and${allp.candidateComparedWith.baseline.candidateSlowerPairs}/7pairs are slower. This is a finite new sign change from the earlier public negative study, not proof of wrapper/compiler causation. Small-standard's median changes${percent(small.candidateComparedWith.baseline.medianRatioPercent)}, while its median paired change is${percent(small.candidateComparedWith.baseline.pairedRatioPercent)}; both are retained. Standard and multi-selection ranges overlap baseline. No statistical confidence, universal nonregression or posthoc numeric acceptance threshold is introduced.\n\nPositive memory values remain visible. Single-p95 candidate lifetime RSS median${mib(single.metricsByImplementation.candidate.lifetimePeakRSSBytes.median)}MiB exceeds baseline${mib(single.metricsByImplementation.baseline.lifetimePeakRSSBytes.median)}MiB, though its separate polled median is lower. Small/large standard and all-percentile lifetime medians also exceed baseline. Lifetime maximum, polled maximum and checkpoints are different metrics. Each memory worker loads one implementation; original loads six actual CJS files, baseline one native ESM module, candidate both native modules. Cache rereads and shared serializer pressure remain included.\n\nThe CSVs contain every timing sample, every paired timing change, all20 memory metrics for all roles/cases, every signed memory child value and paired difference. ${summary.counts.negativeSignedMemoryChildValues}negative signed child values,${summary.counts.negativePairedMemoryMetricValues}negative paired values and${summary.counts.unavailableMemoryPairedPercentages}zero-control percentages remain explicit; unavailable percentages are null. Signed percentages use the signed control and are not allocation-efficiency ratios. Retained-minus-beforeRetention, released-minus-warmBase and historical released-minus-beforeRetention are all retained. Release deltas do not prove leaks.\n\nNo measured child failed, was censored, killed or hit a declared limit. All raw294 timing logs and588 memory/observer logs plus five aggregate/attempt files are preserved. There are1,323 timing and1,311,282 memory output/cache comparisons in those saved records and1,835 matching numeric-PID observer samples. Actual original source bytes, both archive identities, Node binary identity and readiness2426 were authenticated before/after. Archives/native executable remain local, not copied. Observer nominal100ms polling and checkpoint RSS can miss peaks;256MiB old-space and512MiB sampled RSS are not an OS hard sandbox. Memory has120s child deadlines and no outer hard watchdog; numeric PID matching is not process-start/PID-reuse or descendant ownership proof.\n\nExact inert snapshots preserve full wrapper86+manifest, the selected new readiness/source/14 fixtures, both root independent proofs and their source/stdout, all887 new observation artifacts and the two public history manifests. Root wrapper review separately made216 original packet,216 subset-cache and108 direct-registry calls on nine new corpora. The prior finite2,910,751 reducer campaign includes48,240 cache comparisons and adds14,240 helper comparisons; held-out campaigns and metadata failures remain exact frozen86 provenance. The inherited66-input fixture remains correctness-only. No arbitrary Proxy/getter or universal input proof is claimed.\n\nThe full prior2217/1042 public negative-study trees are referenced by their exact preservation manifests at commit455ab6c46461981e6e4331ba5612d5362bf4ad22. Their already copied2218 subtree in readiness was authenticated before/after but deliberately not recopied here. Their raw failures and earlier source identities remain public unchanged. Current readiness's automatically captured metadata RangeError/retry and wrapper86's two captured metadata-failure replays plus two lookup errors remain preserved, with their original provenance. No new consolidation action failed.\n\nFull-product completeness, full parity, universal correctness/superiority, full performance nonregression, candidate integration and performance acceptance remain false. This source-only package preserves evidence for independent review; it does not authorize publication or production integration.\n`);
await write('analysis-validation.json',JSON.stringify({schema:'rea-metrics-wrapper-summary-crosscheck/v1',checkedAt:new Date().toISOString(),status:'passed',checkedStatistics,checkedPairs,maxPercentageRoundoff,equivalentTimingPercentageFormulasTolerance:'512*Number.EPSILON*max(1,abs(left),abs(right)); summary arithmetic equivalence only, not a performance acceptance threshold.',allSevenTimingAndMemoryRows:true,csvDataRows:Object.fromEntries(Object.entries(artifacts).map(([name,rows])=>[name,rows.length-1])),rootWrapperAndReadinessBindingsVerified:true,newReducerCalls:0,newMeasurements:false,allSignedValuesAndNullZeroControlPercentagesRetained:true},null,2)+'\n');
console.log(JSON.stringify({status:'tables and CSVs saved; prospective pure summary cross-check passed',checkedStatistics,checkedPairs,csvRows:Object.fromEntries(Object.entries(artifacts).map(([name,rows])=>[name,rows.length-1]))}));
