    },
    {
      "id": "grafana.candidate.1711cd587c1ce1fc0588",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If a dashboard has the **Browser Time** setting, the reports generated from that dashboard use the time zone of the Grafana server. As a result, this time zone might not match the time zone of users creating or receiving the report. If you want to use a specific time zone, save the dashboard with a fixed time zone instead of **Browser Time**",
      "headingPath": [
        "Create and manage reports",
        "Create a report",
        "2. Schedule",
        "Time zone"
      ],
      "source": {
