    },
    {
      "id": "grafana.candidate.31f06e1c3e9fe09f4ccc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We'll use the Raspberry Pi Imager to flash the operating system image to the SD card. You download the imager directly from the official Raspberry Pi website and it's available for Ubuntu Linux, macOS, and Windows.",
      "headingPath": [
        "Introduction",
        "Set up your Raspberry Pi",
        "Download and install Raspberry Pi Imager"
      ],
