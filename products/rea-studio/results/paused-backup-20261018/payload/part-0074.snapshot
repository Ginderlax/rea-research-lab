    {
      "id": "grafana.candidate.b8c8df738d115e0aabfc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "An organization is an entity that helps you isolate users and resources such as dashboards, annotations, and data sources from each other. Their purpose is to provide completely separate experiences, which look like multiple instances of Grafana, within a single instance. Multiple organizations are easier and cheaper to manage than multiple instances of Grafana.",
      "headingPath": [
        "Manage organizations",
        "About organizations"
      ],
      "source": {
        "path": "docs/sources/administration/organization-management/index.md",
        "gitBlobSha": "621374d48845d4f1120a80744b4612cb52ab81b8",
        "sha256": "92f17c222a0fa35516725a7df029cc1bf47617e2989466c88e61a245f70fb79d",
        "lineStart": 26,
        "lineEnd": 26,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/organization-management/index.md#L26-L26"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.6b14de56394f8e56891a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Users, configuration settings, and Grafana Enterprise licenses are shared between organizations. Other resources, like dashboards, data sources, annotations, folders, Teams, and Alerts, are isolated within each organization and cannot be easily shared with another organization.",
      "headingPath": [
        "Manage organizations",
        "About organizations"
      ],
      "source": {
        "path": "docs/sources/administration/organization-management/index.md",
        "gitBlobSha": "621374d48845d4f1120a80744b4612cb52ab81b8",
