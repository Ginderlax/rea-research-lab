    },
    {
      "id": "grafana.candidate.3f9c2263f41896d44f6f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Sets API paths to be accessible between plugins using the POST verb. If the value is empty, you can only pass remote requests through the proxy. If the value is set, you can also send authenticated POST requests to the local server. You typically use this to enable backend communication between plugins.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[security]`",
        "`actions_allow_post_url`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
