    {
      "id": "grafana.candidate.cd417d399c20fc1e2637",
      "syntaxRole": "procedural-step",
      "sourceText": "1. For multi-tenant setups on a single Tempo instance, consider using the `X-Scope-OrgID` header instead of separate data sources. Refer to [Multi-tenancy](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/tempo/configure-tempo-data-source/) for configuration details.",
      "headingPath": [
        "Troubleshoot Tempo data source issues",
        "Other common issues",
        "Switching between multiple Tempo instances"
      ],
      "source": {
