import fs from 'node:fs';
import path from 'node:path';
import {spawnSync} from 'node:child_process';
const rea=path.resolve('outputs/rea-backup-2026-10-12/runtime/node_modules/rea-agents/scripts/rea.mjs');
for(const [dir,label] of [['04-excalidraw','Dn'],['05-joplin','parseResourceUrl'],['06-node-red','applyRule']]){
 const root=path.resolve('outputs/rea-research-lab/projects',dir),ev=path.join(root,'artifacts/evidence');
 const analysis=JSON.parse(fs.readFileSync(path.join(ev,'analysis.json'))),sg=analysis.normalized_result.semantic_graph;
 const fn=sg.nodes.find(n=>n.kind==='function'&&n.label===label);
 const pname=dir==='04-excalidraw'?'e':dir==='05-joplin'?'url':'property';
 const candidates=sg.nodes.filter(n=>n.function_node_id===fn.node_id&&n.kind==='parameter'&&n.label===pname);
 const seed=candidates[0],direction='forward-influence';
 for(const name of ['semantic.json','semantic-request.json'])fs.copyFileSync(path.join(ev,name),path.join(ev,'return-seed-'+name));
 const request={application:analysis,query:{seed:{kind:'semantic-node',node_id:seed.node_id},direction}};
 fs.writeFileSync(path.join(ev,'semantic-request.json'),JSON.stringify(request));
 const r=spawnSync(process.execPath,['--max-old-space-size=512','--max-semi-space-size=4',rea,'trace-javascript-semantics',path.join(ev,'semantic-request.json'),'--json'],{encoding:'utf8',maxBuffer:50*1024*1024});
 fs.writeFileSync(path.join(ev,'semantic.json'),r.stdout??'');fs.writeFileSync(path.join(ev,'semantic.stderr.txt'),r.stderr??'');
 if(r.status!==0)throw Error(r.stderr);
 const sem=JSON.parse(r.stdout),st=sem.normalized_result,summary=JSON.parse(fs.readFileSync(path.join(root,'rea-evidence-summary.json')));
 summary.semanticEvidenceId=sem.evidence_id;summary.semanticTrace={seedFunction:label,seedNodeId:seed.node_id,seedKind:seed.kind,direction,status:st.status,nodeCount:st.nodes.length,relationCount:st.relations.length,unknownCount:st.unknowns.length,coverage:st.coverage,summary:st.summary,limitations:st.limitations};
 fs.writeFileSync(path.join(root,'rea-evidence-summary.json'),JSON.stringify(summary,null,2));
 console.log(dir,sem.evidence_id,st.nodes.length,st.relations.length,st.unknowns.length);
}
"""Lightweight local backup verification only; no product/test code is executed."""
import sys,json,zipfile,hashlib,re,stat
from pathlib import Path
source=Path(sys.argv[1]).resolve(); expected=sys.argv[2]; base=Path(__file__).resolve().parent/'cloud-verification-backups'
assert source.is_relative_to(base.resolve()) and source.is_file()
digest=lambda b:hashlib.sha256(b).hexdigest()
raw=source.read_bytes();assert digest(raw)==expected,'Downloaded artifact digest mismatch'
folder=source.parent/source.stem;folder.mkdir(exist_ok=False)
def unpack(archive,destination):
    destination.mkdir(parents=True,exist_ok=True); records=[]
    with zipfile.ZipFile(archive) as z:
        assert len(z.infolist())<=3000
        assert sum(e.file_size for e in z.infolist())<=64*1024*1024
        for e in z.infolist():
            name=e.filename;assert not name.startswith(('/', '\\')) and '\\' not in name and ':' not in name
            assert all(p not in ('..','.') for p in Path(name).parts)
            assert not stat.S_ISLNK(e.external_attr>>16)
            target=(destination/name).resolve();assert target.is_relative_to(destination.resolve())
            if e.is_dir():target.mkdir(parents=True,exist_ok=True);continue
            assert e.file_size<=24*1024*1024
            data=z.read(e);assert len(data)==e.file_size
            target.parent.mkdir(parents=True,exist_ok=True)
            with target.open('xb') as f:f.write(data)
            records.append({'path':name,'bytes':len(data),'sha256':digest(data)})
    return records
outer=unpack(source,folder/'downloaded-contents'); archives=[p for p in (folder/'downloaded-contents').rglob('*.zip')]
assert len(archives)==1,'Expected one portable evidence archive'
evidence=folder/'readable-evidence'; files=unpack(archives[0],evidence)
result={'schema':'rea-local-cloud-evidence-backup/v1','artifact':str(source),'artifactSHA256':expected,'archiveBytes':len(raw),'portableEvidenceArchive':str(archives[0]),'readableEvidence':str(evidence),'files':files,'allCRCAndBytesReadable':True,'localProductExecutions':0,'localBuilds':0,'localTests':0,'currentProductAcceptance':False,'scope':'Actual downloaded portable artifact contents only; no universal chat or remote-work capture claim.'}
attempt=evidence/'attempt-validation.json'
if attempt.exists():
    a=json.loads(attempt.read_text(encoding='utf-8-sig'));result['attempt']={k:a.get(k) for k in ('status','scope','repositoryCommit','runtime','summary','sourceFiles','sourceStable','sourceSnapshotFiles','startedAtUtc','completedAtUtc','executionEnvironment')}
    before=json.loads((evidence/'source-before.json').read_text());after=json.loads((evidence/'source-after.json').read_text());assert before==after and len(before)==a['sourceFiles'] and a['sourceStable']
    m=json.loads((evidence/'source-snapshot-manifest.json').read_text());assert len(m['files'])==a['sourceSnapshotFiles']
    for r in m['files']:
        p=(evidence/r['path']).resolve();assert p.is_relative_to(evidence.resolve());b=p.read_bytes();assert len(b)==r['bytes'] and digest(b)==r['sha256']
    stdout=(evidence/'stdout.txt').read_text(encoding='utf-8')
    for k in ('tests','pass','fail','cancelled','skipped','todo','duration_ms'):
        values=re.findall(r'^# '+k+r' (\d+(?:\.\d+)?)\r?$',stdout,re.M);assert values and float(values[-1])==a['summary'][k]
    assert a['status']=='passed' and a['scope']=='flow-vault' and a['summary']['tests']==a['summary']['pass']
    assert sum(a['summary'][k] for k in ('fail','cancelled','skipped','todo'))==0
    result['currentProductAcceptance']=True;result['acceptanceScope']='Finite selected Flow and Vault contracts on the recorded hosted source epoch only.'
    result['sourceSnapshotsVerified']=len(m['files']);result['fullParity']=False;result['superiority']=False
    result['windowsTarReadiness']=json.loads((evidence/'windows-tar-readiness.json').read_text(encoding='utf-8-sig'))
else:result['evidenceState']='No test receipt exists; available artifact may be empty after pre-test workflow failure.'
(folder/'local-backup-verification.json').write_text(json.dumps(result,indent=2)+'\n',encoding='utf-8')
print(json.dumps({k:v for k,v in result.items() if k!='files'}))
"""Exact installed Notes92/8 backup reader; no product code is imported/executed."""
import gzip,hashlib,io,json,re,stat,struct,subprocess,sys,tarfile,zipfile,zlib
from pathlib import Path
RUN='38917424088'
HEAD='362bda055ac4cf7201b2d6a75a2b30dc6fedb578'
source=Path(sys.argv[1]).resolve();expected=sys.argv[2];ROLE=sys.argv[3]
assert ROLE in ('finite','browser') and sys.argv[4:]==[RUN,HEAD]
WORK=Path(__file__).resolve().parent;LAB=WORK.parent/'outputs/rea-research-lab'
assert source.is_relative_to((WORK/'cloud-verification-backups').resolve()) and source.parent.name=='run-'+RUN
sha=lambda b:hashlib.sha256(b).hexdigest()
identity=lambda b:{'bytes':len(b),'sha256':sha(b)}
pin=lambda r:{k:r[k] for k in ('bytes','sha256')}
raw=source.read_bytes();assert len(raw)<=16*1024*1024 and sha(raw)==expected
folder=source.parent/source.stem;folder.mkdir(exist_ok=False)
def safe(root,name):
    assert isinstance(name,str) and name and not re.search(r'[\\:\x00-\x1f\x7f]',name) and not name.startswith('/')
    assert all(p not in ('','.','..') for p in name.split('/'))
    target=(root/name).resolve();assert target.is_relative_to(root.resolve()) and not target.is_symlink();return target
def unpack(archive,destination,file_limit,byte_limit,individual_limit):
    destination.mkdir(parents=True,exist_ok=False);records=[];names=set()
    with zipfile.ZipFile(archive) as z:
        entries=z.infolist();assert len(entries)<=file_limit and sum(r.file_size for r in entries)<=byte_limit
        for row in entries:
            assert row.filename not in names;names.add(row.filename);assert not stat.S_ISLNK(row.external_attr>>16)
            target=safe(destination,row.filename.rstrip('/'))
            if row.is_dir():target.mkdir(parents=True,exist_ok=True);continue
            assert row.file_size<=individual_limit;data=z.read(row);assert len(data)==row.file_size
            target.parent.mkdir(parents=True,exist_ok=True)
            with target.open('xb') as out:out.write(data)
            assert target.read_bytes()==data
            records.append({'path':row.filename,**identity(data),'zipCRC32':format(row.CRC,'08x')})
    return records
outer=unpack(source,folder/'downloaded-contents',4,16*1024*1024,15*1024*1024)
assert len(outer)==1 and outer[0]['path']=='rea-notes-installed-'+ROLE+'-'+RUN+'-1.zip'
archive=folder/'downloaded-contents'/outer[0]['path'];evidence=folder/'readable-evidence'
files=unpack(archive,evidence,2500,96*1024*1024,8*1024*1024)
def content(name):
    p=safe(evidence,name);assert p.is_file() and p.stat().st_size<=8*1024*1024;return p.read_bytes()
def load(name):return json.loads(content(name).decode('utf-8-sig'))
def png(data):
    assert data[:8]==bytes.fromhex('89504e470d0a1a0a');offset=8;dimensions=None;ended=False
    while offset+12<=len(data):
        length=int.from_bytes(data[offset:offset+4],'big');kind=data[offset+4:offset+8];end=offset+12+length;assert end<=len(data)
        payload=data[offset+8:offset+8+length];assert zlib.crc32(kind+payload)&0xffffffff==int.from_bytes(data[offset+8+length:end],'big')
        if kind==b'IHDR':assert offset==8 and length==13;dimensions=struct.unpack('>II',payload[:8])
        offset=end
        if kind==b'IEND':assert length==0 and offset==len(data);ended=True;break
    assert ended and dimensions==(1440,1100)
