    {
      "id": "grafana.candidate.ab85ad21caf9a15c0af9",
      "syntaxRole": "list-item",
      "sourceText": "- Exactly one numeric column - **_required_**. This contains the value that triggers alerts or gets recorded. The query fails if it returns no numeric column or more than one.",
      "headingPath": [
        "SQL expressions",
        "Alerting and recording rules"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/sql-expressions/index.md",
