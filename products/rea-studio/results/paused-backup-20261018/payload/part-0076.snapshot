    {
      "id": "grafana.candidate.61497184012b76f7d7ab",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Combined traces and profiles let you see granular line-level detail when available for a trace span. This allows you to pinpoint the exact function that's causing a bottleneck in your application as well as a specific request.",
      "headingPath": [
        "Pyroscope data source",
        "Visualize traces and profiles data using Trace to profiles"
