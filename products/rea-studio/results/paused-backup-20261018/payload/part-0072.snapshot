from pathlib import Path
import datetime
import hashlib
import json
import shutil

work = Path(__file__).resolve().parent
base = work / "full-archive-baseline-20261012"
snapshot = base / "inventory"
snapshot.mkdir(exist_ok=True)
for name in ["full-archive-feature-inventory.json", "full-archive-feature-inventory.md", "build-full-archive-inventory.py", "verify-archive-inventory.py", "full-archive-inventory-verification.json"]:
    shutil.copy2(work / name, snapshot / name)
records = []
for path in sorted(base.rglob("*")):
    if not path.is_file() or path == base / "backup-manifest.json":
        continue
    content = path.read_bytes()
    records.append({
        "relative_path": path.relative_to(base).as_posix(),
        "bytes": len(content),
        "sha256": hashlib.sha256(content).hexdigest(),
    })
manifest = {
    "schema_version": 1,
    "created_at_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "release": "26.04",
    "scope": "Original packages, complete/Extra/SDK binary and source trees, manuals, licenses, acquisition/registry records, inventory snapshot and offline instructions.",
    "excluded": ["backup-manifest.json itself; its SHA-256 is in the external verification receipt"],
    "files": records,
    "file_count": len(records),
    "bytes": sum(r["bytes"] for r in records),
}
destination = base / "backup-manifest.json"
destination.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
print(json.dumps({"files": len(records), "bytes": manifest["bytes"], "manifest_sha256": hashlib.sha256(destination.read_bytes()).hexdigest()}))
