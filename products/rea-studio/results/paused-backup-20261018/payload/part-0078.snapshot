          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.88c72d05606d56b9be51",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If any invalid formatting option is specified, then `glob` is the default/fallback option.",
      "headingPath": [
