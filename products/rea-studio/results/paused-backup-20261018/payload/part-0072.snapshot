const attempt=json(path.join(run,'attempt-validation.json')),db=fs.readFileSync(path.join(studio,'results/development-validation.json')),dev=JSON.parse(db),before=json(path.join(run,'source-before.json')),after=json(path.join(run,'source-after.json'));
assert.equal(attempt.schema,'rea-flow-vault-suite-attempt/v1');assert.equal(attempt.exitCode,0);assert.equal(attempt.failure,null);assert.equal(attempt.signal,null);assert.equal(attempt.sourceStable,true);assert.equal(dev.source_bytes_stable_across_run,true);assert.equal(dev.full_feature_parity_established,false);assert.equal(dev.universal_superiority_established,false);assert.deepEqual(before,after);assert.deepEqual(attempt.summary,dev.summary);assert.equal(attempt.summary.tests,attempt.summary.pass);assert(attempt.summary.tests>937);assert.equal(attempt.summary.fail+attempt.summary.skipped+attempt.summary.cancelled+attempt.summary.todo,0);assert.equal(attempt.sourceFiles,before.length);assert.equal(dev.source_files.length,before.length);assert(before.length>737);assert.deepEqual(attempt.runtime,{version:'v24.16.0',sha256:'b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3'});
for(const r of before){const b=fs.readFileSync(path.join(studio,r.path));assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});assert(b.equals(fs.readFileSync(path.join(run,'source',r.path+'.snapshot'))));}
const installed=json(path.join(work,'flow-vault-reviewed-installation-next/installation.json'));assert.equal(installed.installed.length,36);assert.equal(installed.applicationPaths,35);assert.equal(installed.oldReceiptsRebound,false);for(const r of installed.installed)assert.deepEqual(id(fs.readFileSync(path.join(lab,r.destination))),r.after);
const installationPath='results/flow-vault-reviewed-installation-20261013/preservation-manifest.json',installationBytes=fs.readFileSync(path.join(studio,installationPath)),installationManifest=JSON.parse(installationBytes);assert.equal(installationManifest.latestApplicationPaths,35);assert.equal(installationManifest.rootProofTransitionPaths,1);assert.equal(installationManifest.oldReceiptsRebound,false);for(const r of installationManifest.records)assert.deepEqual(id(fs.readFileSync(path.join(lab,r.path))),{bytes:r.bytes,sha256:r.sha256});
const registryNames=['workspace-products.json','visual-products.json','system-products.json'],registries=registryNames.map(n=>json(path.join(studio,'requirements',n))),projection=(j,n)=>({sources:j.sources.map(s=>({id:s.id,sha256:s.sha256})),capabilities:n==='system-products.json'?j.products.flatMap(p=>p.capabilities.map(c=>c.id)):n==='workspace-products.json'?j.capabilities.map(c=>c.id):j.baselineProducts.flatMap(p=>p.requirements.map(c=>c.id))}),original=registries.map((j,i)=>projection(j,registryNames[i])),refreshed=[];
let localReferences=0;for(const [i,j]of registries.entries()){const rows=i===0?j.localImplementationEvidence:i===1?j.baselineProducts.flatMap(p=>p.implementationFiles??[]):j.products.flatMap(p=>p.local_implementation_evidence??[]);for(const r of rows){localReferences++;const actual=id(fs.readFileSync(path.join(lab,r.path)));if(actual.bytes===r.bytes&&actual.sha256===r.sha256)continue;const authority=installed.installed.find(a=>a.destination===r.path);assert(authority?.before,'Unapproved implementation reference transition '+r.path);assert.deepEqual({bytes:r.bytes,sha256:r.sha256},authority.before);assert.deepEqual(actual,authority.after);refreshed.push({registry:registryNames[i],path:r.path,before:authority.before,after:actual});Object.assign(r,actual);}}
assert.equal(localReferences,251);assert(refreshed.length>0);assert(new Set(refreshed.map(r=>r.path)).size<=9);const sourcePairs=original.reduce((n,j)=>n+j.sources.length,0),capabilityIds=original.reduce((n,j)=>n+j.capabilities.length,0);assert.equal(sourcePairs,159);assert.equal(capabilityIds,232);
