import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import {spawn} from 'node:child_process';
const root=import.meta.dirname,run=path.join(root,'runs',process.argv[2]??new Date().toISOString().replaceAll(':','-')),hash=b=>createHash('sha256').update(b).digest('hex');await fs.mkdir(run,{recursive:true});
const selected=process.argv.slice(3),tests=selected.length?selected:['regression/bin-boundaries.test.mjs','regression/same-generation-preview.test.mjs'];
async function capture(){const names=['products/rea-studio/apps/vault/client.mjs','products/rea-studio/apps/vault/server.mjs','products/rea-studio/apps/vault/recycle.mjs','products/rea-studio/apps/vault/kdbx.mjs','products/rea-studio/apps/vault/history.mjs','products/rea-studio/apps/vault/xml.mjs','regression/ui-helper.mjs','record-regression.mjs',...tests];return Promise.all([...new Set(names)].map(async p=>{const b=await fs.readFile(path.join(root,p));return{path:p,bytes:b.length,sha256:hash(b)};}));}
const before=await capture();for(const r of before){const out=path.join(run,'sources',r.path+'.snapshot');await fs.mkdir(path.dirname(out),{recursive:true});await fs.copyFile(path.join(root,r.path),out);}await fs.writeFile(path.join(run,'source-before.json'),JSON.stringify(before,null,2)+'\n');
const env={...process.env};delete env.NODE_TEST_CONTEXT;const p=spawn(process.execPath,['--test','--test-reporter=tap','--test-concurrency=1',...tests],{cwd:root,windowsHide:true,env,stdio:['ignore','pipe','pipe']}),chunks={stdout:[],stderr:[]},size={stdout:0,stderr:0};let problem=null;const timer=setTimeout(()=>{problem='60-second deadline';p.kill();},60000);for(const k of['stdout','stderr'])p[k].on('data',b=>{size[k]+=b.length;if(size[k]>4*1024*1024){problem='output cap';p.kill();}else chunks[k].push(b);});p.on('error',e=>problem=e.message);const code=await new Promise(r=>p.on('close',r));clearTimeout(timer);const stdout=Buffer.concat(chunks.stdout),stderr=Buffer.concat(chunks.stderr);await fs.writeFile(path.join(run,'stdout.txt'),stdout);await fs.writeFile(path.join(run,'stderr.txt'),stderr);const after=await capture();await fs.writeFile(path.join(run,'source-after.json'),JSON.stringify(after,null,2)+'\n');const raw=stdout.toString(),number=n=>Number(new RegExp('^# '+n+' (\\d+)$','m').exec(raw)?.[1]??NaN),record={code,problem,tests:number('tests'),pass:number('pass'),fail:number('fail'),skipped:number('skipped'),cancelled:number('cancelled'),sourceStable:JSON.stringify(before)===JSON.stringify(after),sourceBefore:before,sourceAfter:after,originalExecutions:0,newHostProcesses:0,browserChecks:0,scope:'Actual candidate client/server through owned DOM model and deterministic held transport; no original/HTTP/GUI execution.'};await fs.mkdir(path.join(run,'observations'),{recursive:true});for(const e of await fs.readdir(path.join(root,'regression/observations')))await fs.copyFile(path.join(root,'regression/observations',e),path.join(run,'observations',e));await fs.writeFile(path.join(run,'validation.json'),JSON.stringify(record,null,2)+'\n');console.log(JSON.stringify({...record,sourceBefore:undefined,sourceAfter:undefined,run}));process.exitCode=code;
