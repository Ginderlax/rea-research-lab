// Work-only exact proof-module proposal; no installed proof or application call.
import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const here=import.meta.dirname,workspace=path.resolve(here,'../..'),source=path.join(workspace,'work/sketch-layout-source-plan-independent-review'),sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)});
async function write(p,v){const q=path.join(here,p);await fs.mkdir(path.dirname(q),{recursive:true});await fs.writeFile(q,Buffer.isBuffer(v)?v:JSON.stringify(v,null,2)+'\n',{flag:'wx'});}
async function tree(d,p=''){const out=[];for(const e of await fs.readdir(d,{withFileTypes:true})){assert.equal(e.isSymbolicLink(),false);const name=p+e.name;if(e.isDirectory())out.push(...await tree(path.join(d,e.name),name+'/'));else{assert.ok(e.isFile());out.push(name);}}return out.sort();}
const mb=await fs.readFile(path.join(source,'freeze-manifest.json'));assert.equal(sha(mb),'dd196558e07a7568d0424dff0a610a1b18627d0bee0b56c0cbbaad90f6f080c7');const manifest=JSON.parse(mb);assert.equal(manifest.inventory.length,44);assert.deepEqual(await tree(source),[...manifest.inventory.map(r=>r.path),'freeze-manifest.json'].sort());const rows=[...manifest.inventory,{path:'freeze-manifest.json',...id(mb)}],prefix='products/rea-studio/results/sketch-layout-reviewed-installation-20261013/source-plan-independent-review/frozen',aliases=[];
for(const r of rows){const b=await fs.readFile(path.join(source,r.path));assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});aliases.push({source:'work/sketch-layout-source-plan-independent-review/'+r.path,originalPath:r.path,destination:prefix+'/'+r.path+'.snapshot',bytes:r.bytes,sha256:r.sha256,transformation:'Exact frozen bytes; one .snapshot suffix; no historical rebinding.'});}
await write('review-public-copy-list.json',{schema:'rea-sketch-layout-independent-review-public-map/v1',files:45,records:aliases,physicalDedupAllowed:false,sourceReviewManifest:id(mb),outsideCore832:true});await write('review-source-before.json',{strict44AndManifestExact:true,manifest:id(mb),rows});
for(const filename of ['proof-verifier.mjs','public-proof-loader.mjs'])await write('proposed/scripts/sketch-layout-proof/'+filename,await fs.readFile(path.join(source,filename)));
const installed=JSON.parse(await fs.readFile(path.join(source,'proof-dataset.json')));assert.equal(installed.aliases.length,832);assert.equal(installed.current.length,10);assert.equal(sha(await fs.readFile(path.join(source,'proof-dataset.json'))),'5ab5d2fdbea33dc3712c66050a47097170caef5bed7e7bf8fd22bc1637efffc7');
await write('prepare-validation.json',{schema:'rea-sketch-layout-root-proof-proposal-preparation/v1',sourceReview44AndManifestExact:true,reviewAliases45:aliases,exactLoaderAndVerifierCopied:true,dataset832Current10Unchanged:true,sourceOnly:true,installedProofNotYetExecuted:true,applicationOrOriginalOrBrowserExecutions0:true,productionWrites0:true});console.log(JSON.stringify({workOnlyPrepared:true,reviewAliases45:true,modulesExact2:true,datasetUnchanged:true,installedProofExecuted:false}));
