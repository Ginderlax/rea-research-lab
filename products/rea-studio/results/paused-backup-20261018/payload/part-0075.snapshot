        "sha256": "40f628b968dfea7505d678fab42d587cb94c26022292423de09a2034dbad018c",
        "lineStart": 196,
        "lineEnd": 196,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/guides/alerting-on-forecasts.md#L196-L196"
      },
      "applicability": {
        "status": "excluded-by-paid-or-hosted-section-heading",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ],
        "restriction": "Alerting on forecasts > Seasonal forecast with Grafana Cloud Machine Learning > Alert when the actual state is outside the forecast > Alert only on unexpectedly high values"
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.63d750a51a801328e4f6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Adaptive alerts** are useful when a signal varies over time and a fixed threshold would miss meaningful deviations or generate alerts during normal changes in behavior.",
      "headingPath": [
        "Alerting on forecasts",
        "Seasonal forecast with Grafana Cloud Machine Learning",
        "Alert when the actual state is outside the forecast",
        "Alert only on unexpectedly high values"
      ],
