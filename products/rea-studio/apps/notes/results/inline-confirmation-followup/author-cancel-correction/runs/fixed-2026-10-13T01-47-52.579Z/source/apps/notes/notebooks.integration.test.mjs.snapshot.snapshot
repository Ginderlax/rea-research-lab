import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import {start} from '../../server.mjs';
import {readJex} from './jex.mjs';
test('notebook identity tree operations and note moves persist through actual HTTP host cold restarts and JEX export',async t=>{const root=await fs.mkdtemp(path.join(os.tmpdir(),'rea-notebook-http-stage-'));let host=await start({port:0,dataDir:root});t.after(async()=>{await host.close();assert.equal(path.dirname(root),path.resolve(os.tmpdir()));assert.ok(path.basename(root).startsWith('rea-notebook-http-stage-'));await fs.rm(root,{recursive:true,force:true});});const request=async(action,input={},expected=200)=>{const response=await fetch(`${host.url}/api/notes/${action}`,{method:'POST',headers:{'content-type':'application/json','x-rea-token':host.token},body:JSON.stringify(input)}),body=await response.json();assert.equal(response.status,expected,body.error);return body.result??body;};let tree=await request('notebook-list');tree=await request('notebook-create',{revision:tree.revision,title:'Parent'});const parent=tree.notebook.id;tree=await request('notebook-create',{revision:tree.revision,title:'Child',parentId:parent});const child=tree.notebook.id;let note=await request('save',{title:'HTTP organized',notebookId:child,body:'Identity and hierarchy remain persisted.'});const attached=await request('attachment-add',{id:note.id,revision:note.revision,filename:'owned.txt',mime:'text/plain',base64:Buffer.from('owned HTTP attachment').toString('base64')});note=attached.note;tree=await request('notebook-list');const stale=tree.revision;tree=await request('notebook-rename',{revision:tree.revision,id:parent,title:'Renamed parent'});await request('notebook-move',{revision:stale,id:child,parentId:''},400);await host.close();host=await start({port:0,dataDir:root});note=await request('get',{id:note.id});assert.equal(note.notebookId,child);assert.equal(note.notebook,'Renamed parent / Child');tree=await request('notebook-list');tree=await request('notebook-move',{revision:tree.revision,id:child,parentId:''});note=await request('get',{id:note.id});assert.equal(note.notebook,'Child');const moved=await request('note-move',{id:note.id,revision:note.revision,organizationRevision:tree.revision,notebookId:parent});await host.close();host=await start({port:0,dataDir:root});note=await request('get',{id:moved.note.id});assert.equal(note.notebookId,parent);assert.equal((await request('list',{notebookId:parent})).total,1);assert.equal((await request('list',{notebookId:child})).total,0);assert.equal(Buffer.from((await request('attachment-get',{noteId:note.id,id:attached.attachment.id})).base64,'base64').toString(),'owned HTTP attachment');const archive=await request('jex-export'),parsed=readJex(Buffer.from(archive.base64,'base64'));assert.equal(parsed.records.get(note.id.replaceAll('-','')).props.parent_id,parent);assert.equal(parsed.records.get(child).props.parent_id,'');console.log(JSON.stringify({notebookHttpObservation:{privateEphemeralHost:true,hostRestarts:2,parentId:parent,childId:child,noteId:note.id,attachmentSha256:attached.attachment.sha256,exportSha256:archive.sha256,identityFilterVerified:true}}));});
