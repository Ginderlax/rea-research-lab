// Source-only completion and pinned metadata controls; no behavior replay.
import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';
import {hash,authenticateBytes} from './proof-verifier.mjs';import {parsePinnedDataset} from './public-proof-loader.mjs';
const here=import.meta.dirname,workspace=path.resolve(here,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),id=b=>({bytes:b.length,sha256:hash(b)});
async function out(p,v){await fs.mkdir(path.dirname(path.join(here,p)),{recursive:true});await fs.writeFile(path.join(here,p),Buffer.isBuffer(v)?v:JSON.stringify(v,null,2)+'\n',{flag:'wx'});}
const dataset=await fs.readFile(path.join(here,'proof-dataset.json')),pin=hash(dataset);assert.equal(parsePinnedDataset(dataset,pin).aliases.length,832);assert.throws(()=>parsePinnedDataset(Buffer.concat([dataset,Buffer.from(' ')]),pin));assert.throws(()=>parsePinnedDataset(dataset,'0'.repeat(64)));await out('pinned-loader-controls.json',{dataset:id(dataset),positivePinnedParse:true,changedByteRejected:true,wrongAuthorityDigestRejected:true,installedPublicVerificationExecuted:false,newBehaviorExecuted:false});
const live=JSON.parse(await fs.readFile(path.join(workspace,'work/sketch-layout-publication-plan/live-install-copy-list.json'))),rows=[];
for(const r of live.records){if(r.mode==='replace'){const b=await fs.readFile(path.join(repo,r.destination));authenticateBytes(b,r.prior);await out('current-before/'+path.posix.basename(r.destination)+'.snapshot',b);rows.push({destination:r.destination,prior:r.prior,proposed:{bytes:r.bytes,sha256:r.sha256},beforeImage:'current-before/'+path.posix.basename(r.destination)+'.snapshot'});}else{await assert.rejects(fs.readFile(path.join(repo,r.destination)),{code:'ENOENT'});rows.push({destination:r.destination,absentBefore:true,proposed:{bytes:r.bytes,sha256:r.sha256},beforeImage:null});}}
const baseline=JSON.parse(await fs.readFile(path.join(workspace,'work/sketch-layout-publication-plan/external-baseline14.json'))).rows;for(const r of baseline){authenticateBytes(await fs.readFile(path.join(repo,r.path)),r);authenticateBytes(await fs.readFile(path.join(workspace,'work/sketch-layout-publication-plan/baseline/'+r.path+'.snapshot')),r);}
await out('installation-boundary.json',{appRows8:rows,currentBefore14:baseline,baselineImages14:'Exact plan43 baseline/{currentPath}.snapshot included in832publicproof; all14 current bytes reauthenticated at independent completion.',sharedHostBefore:'sources/shared-host-before.mjs.snapshot',sharedHostProposed:'sources/shared-host-proposed.mjs.snapshot',sharedRouteTestProposed:'sources/shared-route.test.mjs.snapshot',proposedHostTestAbsentBefore:true,rootOwnsCopiesAndActualCurrentRun:true,actualInstalledAcceptance:false});
const observations=JSON.parse(await fs.readFile(path.join(here,'source-after.json')));for(const e of observations){const m=await fs.readFile(path.join(workspace,e.root,e.manifest));authenticateBytes(m,e.manifestIdentity);for(const r of e.records)authenticateBytes(await fs.readFile(path.join(workspace,e.root,r.path)),r);}
await out('completion-validation.json',{schema:'rea-sketch-layout-independent-source-review-completion/v1',at:new Date().toISOString(),strictSevenEpochsStillExact:true,sourceOnlyPlanRouteAcceptance:true,sourceOnlyOwnBrowserRecordConsistency:true,recorded14Groups68DOM20HTTP5API9JPEG:true,downloadFileAccepted:false,rootRouteNotBrowserHost:true,appBefore8AndCurrent14Exact:true,proofDataset832Aliases10Current:id(dataset),pinnedLoaderGuards2Rejected:true,publicInstallationOrBehaviorRun:false,appOrOriginalOrBrowserExecutions0:true,productionWrites0:true});
console.log(JSON.stringify({sourceOnlyAccepted:true,proofDatasetSHA256:pin,before8And14Exact:true,stagesStillExact:true,appExecutions0:true}));
