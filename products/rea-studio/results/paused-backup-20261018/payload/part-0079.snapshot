    {
      "id": "grafana.candidate.4086ea7a2782d42dcbea",
      "syntaxRole": "list-item",
      "sourceText": "- Navigation: We’ve improved our keyboard navigation support in our main navbar, added focus states, and removed keyboard traps.",
      "headingPath": [
        "What's new in Grafana v8.4",
        "OSS",
        "Ease of use",
        "Accessibility improvements"
      ],
      "source": {
