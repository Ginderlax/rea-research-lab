    {
      "id": "grafana.candidate.c43914acf26c495a35bc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Microsoft SQL Server (MSSQL) is one of the most widely used relational databases for business applications, analytics, and operational workloads. The MSSQL data source lets you query your existing SQL Server instance directly from Grafana, with no data migration required.",
      "headingPath": [
        "Microsoft SQL Server data source"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/_index.md",
        "gitBlobSha": "2093ac7d941f6e4cac1dc71b31cf99009c00f952",
        "sha256": "b55cf05938640b5fa5ac0fa2c4a3e67d412760501a0cf6f15f84c637a98ff596",
        "lineStart": 26,
        "lineEnd": 26,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/mssql/_index.md#L26-L26"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.55613751652ca840ecdf",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The data source ships with Grafana out of the box. It's preinstalled in both Grafana OSS and Grafana Enterprise, so there's nothing for you to install. Starting with Grafana 13.2, it's packaged as a standalone plugin that updates independently of Grafana releases. Refer to [Plugin updates](#plugin-updates) for details.",
      "headingPath": [
        "Microsoft SQL Server data source"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/_index.md",
        "gitBlobSha": "2093ac7d941f6e4cac1dc71b31cf99009c00f952",
        "sha256": "b55cf05938640b5fa5ac0fa2c4a3e67d412760501a0cf6f15f84c637a98ff596",
        "lineStart": 28,
        "lineEnd": 28,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/mssql/_index.md#L28-L28"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.2f943ed1704bcbedd85f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can connect to Microsoft SQL Server 2012 or newer, Azure SQL Database, and Azure SQL Managed Instance.",
      "headingPath": [
        "Microsoft SQL Server data source"
      ],
      "source": {
