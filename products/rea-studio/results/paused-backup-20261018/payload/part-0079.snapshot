    },
    {
      "id": "grafana.candidate.2bf0b331060b9943b655",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana Alerting is now compatible with AWS Aurora, but does not provide technical support for it.",
      "headingPath": [
        "What's new in Grafana v9.4",
        "Alerting",
        "Alerting: administration",
        "Compatibility with AWS Aurora"
      ],
      "source": {
