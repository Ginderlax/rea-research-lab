    {
      "id": "grafana.candidate.e02d8d3585769a7af2e7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If Grafana is running on a Google Compute Engine (GCE) virtual machine, when you [configure a GCE Default Service Account](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/google-cloud-monitoring/google-authentication/#use-gce-default-service-account), you must also grant that service account access to the \"Cloud Monitoring API\" scope.",
