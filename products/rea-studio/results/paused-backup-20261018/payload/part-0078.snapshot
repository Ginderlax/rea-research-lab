    {
      "id": "grafana.candidate.3ecf3fd684f67136388d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Let's mix things up a bit for example two and leave our imaginary manufacturing plant. Imagine you're an assistant to the great Dr. Emmett Brown from Back to the Future, and Doc has tasked you with the following challenge: \"I want an alert sent to me every time both conditions for time travel are met: when the velocity of a vehicle reaches 88 miles per hour and an object generates 1.21 jigowatts of electricity.\"",
      "headingPath": [
        "How to create Grafana alerts with InfluxDB and the Flux query language",
        "Example 2: how to create a Grafana alert from two queries and two conditions"
      ],
      "source": {
        "path": "docs/sources/tutorials/create-alerts-from-flux-queries/index.md",
        "gitBlobSha": "ff67f50b26681d3dc7d4d8e7eb10e4620c9488c3",
        "sha256": "48b344a4b7311941040db4785da4177ce4cd0dcaccadd5ebdd24c843c328bc40",
        "lineStart": 100,
        "lineEnd": 100,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/tutorials/create-alerts-from-flux-queries/index.md#L100-L100"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
