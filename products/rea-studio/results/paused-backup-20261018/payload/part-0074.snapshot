    {
      "id": "grafana.candidate.632beb5e40702bcacd19",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "It can take the system up to one hour to clear the license. After the system clears the license, you can apply the same license to another Grafana Enterprise instance.",
      "headingPath": [
        "Transfer your AWS Marketplace Grafana Enterprise license"
