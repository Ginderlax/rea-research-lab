  "completionGates": [
    {
      "id": "baseline-identity",
      "status": "open",
      "passCondition": "Acquire and fingerprint exact complete-product binaries or services; resolve component-to-product and edition/platform identity without inferred version equivalence."
    },
    {
      "id": "documentation-closure",
      "status": "open",
      "passCondition": "Review every applicable document, API member, linked contract, configuration, integration, edition and platform; record every operation and behavior, classify all exclusions explicitly, and obtain independent completeness review."
    },
    {
      "id": "functional-parity",
      "status": "open",
      "passCondition": "Execute independent acceptance cases against original and replacement for every closed capability; exercise errors, boundary cases, persistence, concurrency, security, accessibility and platform behavior."
    },
    {
      "id": "comparative-superiority",
      "status": "open",
      "passCondition": "Run predeclared controlled benchmarks for every accepted comparison dimension; document environment, uncertainty, failures and tradeoffs. No universal superiority conclusion from selected successes."
    },
    {
      "id": "release",
      "status": "open",
      "passCondition": "Ship all products with reproducible builds, migration and operational documentation, full acceptance evidence and unresolved defects disclosed."
    }
  ],
