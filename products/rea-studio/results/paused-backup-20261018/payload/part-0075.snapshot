    {
      "id": "grafana.candidate.df4f02f88be6093fe8e1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Memberlist is the preferred option for high availability. Use Redis only in environments where direct communication between Grafana servers is not possible, such as when TCP or UDP ports are blocked.",
      "headingPath": [
        "Configure high availability",
        "Enable alerting high availability using Redis"
