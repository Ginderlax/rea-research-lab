    {
      "id": "grafana.candidate.d1fe42e46169568b0bae",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "After you configure the data source, select **Save & test** to verify the connection. When the connection is successful, Grafana displays a **Data source is working** message. If the test fails, Grafana displays the error returned by the Pyroscope backend. For help resolving connection errors, refer to [Troubleshoot the Pyroscope data source](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/pyroscope/troubleshooting/).",
      "headingPath": [
        "Configure the Pyroscope data source",
        "Verify the connection"
      ],
