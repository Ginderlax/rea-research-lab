    {
      "id": "grafana.candidate.4c0212128a6d7e6c313e",
      "syntaxRole": "list-item",
      "sourceText": "- **Level field name** - The field that contains log level or severity information. When specified, Grafana uses this field to determine the log level and color-code each log line. If the log doesn't have a level field, Grafana tries to match the content against [supported expressions](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/explore/logs-integration/#log-level). If Grafana can't determine the log level, it displays as unknown.",
      "headingPath": [
        "Configure the Elasticsearch data source",
        "Additional settings",
        "Logs"
      ],
      "source": {
