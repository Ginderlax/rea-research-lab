          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.56f5cfacaeeec4ced94d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Using **Group by**, you can group metric data by a specified label. You can use multiple labels to group by.",
      "headingPath": [
        "Query profile data",
        "Pyroscope query editor",
        "Query options"
      ],
      "source": {
        "path": "docs/sources/datasources/pyroscope/query-editor/index.md",
        "gitBlobSha": "f610ea6b5c725af436b9ddfad56ce462b258b8f0",
        "sha256": "c2bb15fd3956e70aee467819618adca7470b3f5b2a1f9f22afee217306b82382",
        "lineStart": 126,
        "lineEnd": 127,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/pyroscope/query-editor/index.md#L126-L127"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
