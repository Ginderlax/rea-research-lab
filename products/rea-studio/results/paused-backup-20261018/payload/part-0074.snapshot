    },
    {
      "id": "grafana.candidate.ef5da94045e8ca32eb1e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you are ready to start using your alert rules and notifications from your Grafana Cloud instance, run the migration again with `alert_rules_state = unchanged`.",
      "headingPath": [
        "Grafana Cloud Migration Assistant",
        "Resource migration details",
        "Grafana Alerting resources",
        "Prevent duplicated alert notifications"
      ],
      "source": {
        "path": "docs/sources/administration/migration-guide/cloud-migration-assistant.md",
        "gitBlobSha": "442319790c30aac80b12ee1e579187566be3e281",
        "sha256": "7e1c09762a6e6cc44729911ca49674305883dafcfb5554aad53f88b1db6722d0",
        "lineStart": 222,
        "lineEnd": 222,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/migration-guide/cloud-migration-assistant.md#L222-L222"
      },
