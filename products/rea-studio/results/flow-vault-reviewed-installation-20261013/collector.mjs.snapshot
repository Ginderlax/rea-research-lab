async function sourceBytes(r){const key=r.sourceRoot+'/'+r.sourcePath,qualified=ownedLocalSources.find(s=>s.sourceRoot+'/'+s.sourcePath===key);if(!qualified)return read(base,key);assert.deepEqual({sourceRoot:r.sourceRoot,sourcePath:r.sourcePath,publicPath:r.publicPath,bytes:r.bytes,sha256:r.sha256},qualified);assert.equal(r.reusedExistingPublic,false);assert.equal(r.epoch,'author885');const b=await read(authorities[1].root,'source-proof/payload/'+qualified.sha256+'.snapshot');assert.deepEqual(id(b),{bytes:qualified.bytes,sha256:qualified.sha256});return b;}
const flowMap=JSON.parse(await read(authorities[0].root,'public-source-map.json')),vaultMap=JSON.parse(await read(authorities[1].root,'source-proof/preservation-manifest.json'));assert.equal(flowMap.records.length,830);assert.equal(vaultMap.records.length,1230);assert.equal(vaultMap.newPayloads.length,234);
for(const [i,m]of[[0,flowMap],[1,vaultMap]]){const publicPaths=new Map();for(const r of m.records){safe(r.sourceRoot);assert(r.sourceRoot.startsWith('work/'));safe(r.publicPath);assert(r.publicPath.endsWith('.snapshot'));const b=await sourceBytes(r);assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});if(r.reusedExistingPublic)assert.deepEqual(id(await read(lab,r.publicPath)),{bytes:r.bytes,sha256:r.sha256});else assert(r.publicPath.startsWith(stages[i].publicPrefix+'/'));const prior=publicPaths.get(r.publicPath);if(prior)assert.deepEqual(prior,id(b));else publicPaths.set(r.publicPath,id(b));}maps.push({stage:i,map:m,unique:publicPaths.size});}
const oldCensus=JSON.parse(await read(lab,'products/rea-studio/results/editor-vault-combined-20261013/source-before.json.snapshot'));assert.equal(oldCensus.length,737);for(const r of oldCensus)assert.deepEqual(id(await read(lab,'products/rea-studio/'+r.path)),{bytes:r.bytes,sha256:r.sha256});
const reviews=[];for(const s of stages){const arg=process.argv.indexOf('--'+s.name+'-review');assert(arg>=0&&process.argv[arg+1],'Missing independent '+s.name+' review');const value=process.argv[arg+1],parts=value.split('@');assert.equal(parts.length,2);const [folder,pin]=parts;assert(/^[0-9a-f]{64}$/.test(pin));safe(folder);const b=await read(work,folder+'/manifest.json');assert.equal(sha(b),pin);const j=JSON.parse(b);assert(Array.isArray(j.inventory)&&j.inventory.length>0);for(const r of j.inventory)assert.deepEqual(id(await read(path.join(work,folder),r.path)),{bytes:r.bytes,sha256:r.sha256});reviews.push({name:s.name,folder,pin,bytes:b,manifest:j});}
assert(process.argv.includes('--install'),'Root explicitly selects --install after reviewing all three receipts.');
assert.equal(await fs.stat(own).then(()=>true,()=>false),false);for(const s of stages)assert.equal(await fs.stat(path.join(lab,s.publicPrefix)).then(()=>true,()=>false),false);assert.equal(await fs.stat(path.join(lab,globalPrefix)).then(()=>true,()=>false),false);await fs.mkdir(own);
async function ownSave(p,b){safe(p);const f=path.join(own,p);await fs.mkdir(path.dirname(f),{recursive:true});await fs.writeFile(f,b,{flag:'wx'});}
await ownSave('collector.mjs.snapshot',await fs.readFile(import.meta.filename));const metadataPaths=['README.md','products/rea-studio/README.md','products/rea-studio/STATUS.json','products/rea-studio/results/development-validation.json','products/rea-studio/requirements/workspace-products.json','products/rea-studio/requirements/system-products.json','products/rea-studio/requirements/visual-products.json','products/rea-studio/requirements/README.md'];const beforeMetadata=[];
for(const p of metadataPaths){const b=await read(lab,p);await ownSave('before-metadata/'+p+'.snapshot',b);beforeMetadata.push({path:p,...id(b)});}
for(const r of [...latest,proofRow])if(r.before)await ownSave('before-images/'+r.destination+'.snapshot',await read(lab,r.destination));
const publicRows=[];async function publish(p,b,source){safe(p);const f=path.join(lab,p);await fs.mkdir(path.dirname(f),{recursive:true});await fs.writeFile(f,b,{flag:'wx'});assert.deepEqual(id(await read(lab,p)),id(b));publicRows.push({source,path:p,...id(b)});}
const copied=new Set();for(const {map:m}of maps)for(const r of m.records)if(!r.reusedExistingPublic&&!copied.has(r.publicPath)){const b=await sourceBytes(r);assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});await publish(r.publicPath,b,r.sourceRoot+'/'+r.sourcePath);copied.add(r.publicPath);}
for(const [i,s]of stages.entries()){const a=authorities[i];for(const r of a.manifest.inventory){const p=s.publicPrefix+'/plan/'+r.path+(r.path.endsWith('.snapshot')?'':'.snapshot');if(i===2){const proofPublic=proofPrefix+'/'+r.path+(r.path.endsWith('.snapshot')?'':'.snapshot');await publish(proofPublic,await read(a.root,r.path),'work/'+s.folder+'/'+r.path);}else await publish(p,await read(a.root,r.path),'work/'+s.folder+'/'+r.path);}
 await publish(s.publicPrefix+'/plan-manifest.json.snapshot',a.bytes,'work/'+s.folder+'/manifest.json');
 const localRows=publicRows.filter(r=>r.path.startsWith(s.publicPrefix+'/')),receipt={schema:'rea-reviewed-flow-vault-app-source-preservation/v1',stage:s.name,strictPlanSHA256:s.pin,strictPlanFiles:s.files,publicRows:localRows,sourceAliases:i===0?flowMap.records.length:i===1?vaultMap.records.length:12,allCopiesExact:true,allCopiesInert:true,applicationExecutions:0,originalExecutions:0,browserExecutions:0,fullParity:false,superiority:false};await publish(s.publicPrefix+'/preservation-manifest.json',Buffer.from(JSON.stringify(receipt,null,2)+'\n'),'root source preservation');}
for(const review of reviews){for(const r of review.manifest.inventory)await publish(globalPrefix+'/independent-review/'+review.name+'/'+r.path+(r.path.endsWith('.snapshot')?'':'.snapshot'),await read(path.join(work,review.folder),r.path),'work/'+review.folder+'/'+r.path);await publish(globalPrefix+'/independent-review/'+review.name+'/manifest.json.snapshot',review.bytes,'work/'+review.folder+'/manifest.json');}
const installed=[];for(const r of [...latest,proofRow]){const b=await read(path.join(work,r.sourceRoot),r.sourcePath);assert.deepEqual(id(b),r.after);if(r.before)assert.deepEqual(id(await read(lab,r.destination)),r.before);else assert.equal(await fs.stat(path.join(lab,r.destination)).then(()=>true,()=>false),false);await fs.mkdir(path.dirname(path.join(lab,r.destination)),{recursive:true});await fs.writeFile(path.join(lab,r.destination),b,{flag:r.before?'w':'wx'});assert.deepEqual(id(await read(lab,r.destination)),r.after);installed.push(r);}
for(const s of stages)await auth(s.folder,s.pin,s.files);for(const r of beforeMetadata)assert.deepEqual(id(await read(lab,r.path)),{bytes:r.bytes,sha256:r.sha256});const changed=new Set(latest.filter(r=>r.before).map(r=>r.destination));let priorUnchanged=0;for(const r of oldCensus){const p='products/rea-studio/'+r.path;if(changed.has(p))continue;assert.deepEqual(id(await read(lab,p)),{bytes:r.bytes,sha256:r.sha256});priorUnchanged++;}assert.equal(priorUnchanged,731);
const m=await import(pathToFileURL(path.join(lab,'scripts/editor-vault-proof-migration.mjs')).href);const sourceProof=m.createEditorVaultProofMigrationFromRoot(lab).summary();assert.equal(sourceProof.currentInstalledSourcesMandatory,61);
const receipt={schema:'rea-reviewed-flow-vault-root-installation/v1',at:new Date().toISOString(),installed,applicationPaths:35,applicationReplacements:9,applicationAdditions:26,proofModuleReplacements:1,original737UnchangedCodeSources:731,beforeMetadata,independentReviews:reviews.map(r=>({name:r.name,folder:r.folder,manifestSHA256:r.pin,files:r.manifest.inventory.length})),sourceProof,sourceOnly:true,applicationOriginalBrowserBenchmarkExecutions:0,newFullSuiteRequired:true,newSuiteSummaryPreclaimed:false,oldReceiptsRebound:false,fullParity:false,superiority:false};await ownSave('installation.json',Buffer.from(JSON.stringify(receipt,null,2)+'\n'));
async function preserveOwn(p=''){for(const e of(await fs.readdir(path.join(own,p),{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const n=p?p+'/'+e.name:e.name;assert(!e.isSymbolicLink());if(e.isDirectory())await preserveOwn(n);else await publish(globalPrefix+'/'+n+(n.endsWith('.snapshot')?'':'.snapshot'),await read(own,n),'work/'+path.basename(own)+'/'+n);}}await preserveOwn();
const preservation={schema:'rea-reviewed-flow-vault-installation-preservation/v1',at:new Date().toISOString(),records:publicRows,publicCopies:publicRows.length,logicalSourceAliases:2060,latestApplicationPaths:35,rootProofTransitionPaths:1,allCopiesExact:true,allCopiesInertExceptPreservationMaps:true,oldReceiptsRebound:false,newFullSuiteRequired:true,fullParity:false,superiority:false};const pb=Buffer.from(JSON.stringify(preservation,null,2)+'\n');await fs.writeFile(path.join(lab,globalPrefix,'preservation-manifest.json'),pb,{flag:'wx'});console.log(JSON.stringify({installed:36,publicCopies:publicRows.length,sourceProof,preservationSHA256:sha(pb)}));
