    {
      "id": "grafana.candidate.46e6cdb6a03d07a2c2f1",
      "syntaxRole": "table-row",
      "sourceText": "| **Unsupported**  | The resource is **not** supported and **cannot** be managed with Git Sync. | Not applicable.                                                                                 |",
