    {
      "id": "grafana.candidate.44b945be12139dd55995",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, the Grafana log level is set to `INFO`, but you can increase the log level to `DEBUG` mode when you want to reproduce a problem.",
