    },
    {
      "id": "grafana.candidate.03496991655bb99630e5",
      "syntaxRole": "table-row",
      "sourceText": "| `$__interval`                 | An interval string that corresponds to the Grafana calculated interval based on the time range of the active time selection, such as `interval '5 second'`.                                         |",
      "headingPath": [
        "InfluxDB query editor",
        "SQL query editor",
        "Macros"
      ],
      "source": {
        "path": "docs/sources/datasources/influxdb/query-editor/index.md",
        "gitBlobSha": "7a8d334025a46bda1f449a23dd9329b013ede772",
        "sha256": "be6cf3ca29657e90dbf63cbcf347d7c4de22c3067a88eee5098651919ccd8640",
        "lineStart": 165,
        "lineEnd": 165,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/influxdb/query-editor/index.md#L165-L165"
      },
      "applicability": {
