    {
      "id": "grafana.candidate.1ab6bfffc5874f721102",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The `$timeFilter` variable returns the currently selected time range as an expression. For example, the time range interval `Last 7 days` expression is `time > now() - 7d`.",
      "headingPath": [
        "Global variables",
        "`$timeFilter` or `$__timeFilter`"
      ],
      "source": {
