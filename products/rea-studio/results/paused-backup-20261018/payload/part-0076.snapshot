    {
      "id": "grafana.candidate.a34cb026da03362aa528",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Enable **Counter** when your metric can reset to zero (for example, after a service restart). The counter settings help OpenTSDB calculate correct rates across resets:",
      "headingPath": [
        "OpenTSDB query editor",
        "Rate section",
        "Counter settings"
      ],
      "source": {
        "path": "docs/sources/datasources/opentsdb/query-editor/index.md",
