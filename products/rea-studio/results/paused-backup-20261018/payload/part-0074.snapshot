    },
    {
      "id": "grafana.candidate.c689c4ff10b682958c9e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The **Role** option on the Permissions tab is limited to the basic roles **Viewer**, **Editor**, and **Admin**. Custom roles and fixed RBAC roles don't appear in this list. To grant access to users who have custom or fixed roles, assign the permission to the user, service account, or team. You can also grant `datasources:query` through [role-based access control](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/administration/roles-and-permissions/access-control/).",
      "headingPath": [
        "Data source management",
        "Data source permissions",
        "Assign data source permissions to users, service accounts, teams, or basic roles"
      ],
      "source": {
        "path": "docs/sources/administration/data-source-management/_index.md",
