    },
    {
      "id": "grafana.candidate.e09b20063c812ca70913",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Each data source provisioning config file contains a _manifest_ that specifies the desired state of a set of provisioned data sources.",
      "headingPath": [
        "Introduction",
