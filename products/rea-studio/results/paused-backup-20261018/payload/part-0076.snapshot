    },
    {
      "id": "grafana.candidate.68f7664acd6dd5f67d01",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana supports two syntaxes for using variables in queries:",
      "headingPath": [
        "PostgreSQL template variables",
        "Use variables in queries"
      ],
      "source": {
