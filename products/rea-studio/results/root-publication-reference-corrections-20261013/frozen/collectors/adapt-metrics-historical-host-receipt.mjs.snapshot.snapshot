import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {createHash}from'node:crypto';
const base=path.resolve(import.meta.dirname,'..'),lab=path.join(base,'outputs/rea-research-lab'),owned=path.join(base,'work/root-metrics-historical-host-transition-next'),target=path.join(lab,'scripts/verify-records.mjs'),sha=b=>createHash('sha256').update(b).digest('hex');fs.mkdirSync(owned,{recursive:true});
const before=fs.readFileSync(target);assert.equal(sha(before),'edcc34690d3d27a000cad52dbd945ef9e20d7f1985aaf26e428dcc22f6c6cbff');fs.writeFileSync(path.join(owned,'verify-records.before.mjs.snapshot'),before,{flag:'wx'});
for(const n of['stdout','stderr'])fs.copyFileSync(path.join(base,`work/notes-layout-value-api-records.${n}.txt`),path.join(owned,`failed-publication-check.${n}.txt`),fs.constants.COPYFILE_EXCL);
const receiptPath='products/rea-studio/results/metrics-algorithm-observations-20261012/preservation-manifest.json',receiptBytes=fs.readFileSync(path.join(lab,receiptPath));assert.equal(sha(receiptBytes),'57d49c9109a10d602aaa41bf8c848cebe6a97fb9a849b4e3e05635f8ca395a9f');
const record=JSON.parse(receiptBytes),rows=Object.entries(record.currentBaselineSourceBindingsBefore);assert.equal(rows.length,8);assert.deepEqual(record.currentBaselineSourceBindingsBefore,record.currentBaselineSourceBindingsAfter);const mismatches=rows.filter(([n,e])=>sha(fs.readFileSync(path.join(lab,'products/rea-studio',n)))!==e.sha256);assert.equal(mismatches.length,1);assert.equal(mismatches[0][0],'server.mjs');assert.deepEqual(mismatches[0][1],{bytes:7741,sha256:'807a473ec0334f60dfd58f2df8901c722f1bd4eb1d64c62d9ba1ea65c2b6b55f'});
const changes=[
 ["currentPublicFingerprint({...e,path:'products/rea-studio/'+n},'Unchanged measured Metrics baseline');", "namedHistoricalHostFingerprint({...e,path:'products/rea-studio/'+n},'Measured Metrics nonhost current baseline');"],
 ["webdav_host_dependencies: { current_nonhost_rows:2, historical_host_rows:1 },", "webdav_host_dependencies: { current_nonhost_rows:2, historical_host_rows:1 }, metrics_algorithm_baseline: { current_nonhost_rows:7, historical_host_rows:1 },"],
];let source=before.toString();for(const[a,b]of changes){assert.equal(source.split(a).length,2);source=source.replace(a,b);}let inverse=source;for(const[a,b]of [...changes].reverse())inverse=inverse.replace(b,a);assert.ok(Buffer.from(inverse).equals(before));const after=Buffer.from(source);fs.writeFileSync(target,after);fs.writeFileSync(path.join(owned,'verify-records.after.mjs.snapshot'),after,{flag:'wx'});
const receipt={schema:'rea-metrics-historical-host-transition/v1',at:new Date().toISOString(),before:{bytes:before.length,sha256:sha(before)},after:{bytes:after.length,sha256:sha(after)},changes:changes.map(([before,after])=>({before,after})),inverseExact:true,originalReceipt:{path:receiptPath,bytes:receiptBytes.length,sha256:sha(receiptBytes)},originalReceiptRebound:false,historicalHostRows:1,otherCurrentRows:7,originalMeasurementsRerun:0,productionAlgorithmChanged:false,appWrites:0};fs.writeFileSync(path.join(owned,'transformation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({after:receipt.after,historicalHostRows:1,otherCurrentRows:7,appWrites:0}));
