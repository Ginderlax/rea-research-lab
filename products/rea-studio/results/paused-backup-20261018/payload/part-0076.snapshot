    {
      "id": "grafana.candidate.0924ff136bdb6fede29b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana uses this setting to determine which API endpoints and features to enable. For example, when set to Mimir, Grafana uses regular expression-optimized label queries that significantly improve autocomplete and variable loading performance for large metric sets.",
      "headingPath": [
        "Configure the Prometheus data source",
        "Configuration options",
        "Performance"
      ],
      "source": {
        "path": "docs/sources/datasources/prometheus/configure/_index.md",
        "gitBlobSha": "a1a3fd736210bc04f6d5396f44fbd51007b0b737",
        "sha256": "8f55c60524f648dcca948fcbb550ecdf916cf54bf2cc152f1e84db0d2c51c35b",
        "lineStart": 155,
        "lineEnd": 155,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/prometheus/configure/_index.md#L155-L155"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
