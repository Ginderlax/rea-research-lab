    {
      "id": "grafana.candidate.5fe329fdd725c57dcde8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you want to learn more, in detail, about all the improvements we've made, don't miss our blog post.",
      "headingPath": [
        "What’s new in Grafana v11.3",
        "Scenes-powered Dashboards are generally available",
        "Known limitations"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-3.md",
        "gitBlobSha": "5eb55341a0458eac320b2317223af815e066d128",
        "sha256": "42f0fbcea86ed7f49f166bc9b279b95673f27c4ef505737f7b54ede18c391332",
        "lineStart": 71,
        "lineEnd": 71,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-3.md#L71-L71"
      },
