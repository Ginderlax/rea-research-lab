    {
      "id": "grafana.candidate.8211e476c37e6d18e36a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "These timers reduce the number of notifications sent. By delaying the delivery of notifications, incoming alerts can be grouped into just one notification instead of many.",
      "headingPath": [
        "Group alert notifications",
        "Timing options"
      ],
      "source": {
        "path": "docs/sources/alerting/fundamentals/notifications/group-alert-notifications.md",
