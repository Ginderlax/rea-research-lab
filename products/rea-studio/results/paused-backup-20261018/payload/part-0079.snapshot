    {
      "id": "grafana.candidate.277432195d8624ddf5f8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Time series visualizations require time-series data—a sequence of measurements, ordered in time, and formatted as a table—where every row in the table represents one individual measurement at a specific time. Learn more about [time-series data](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/fundamentals/timeseries/).",
      "headingPath": [
        "Time series",
        "Supported data formats"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/time-series/index.md",
        "gitBlobSha": "8976033fcc91c988399af6db19be0955c7a447ef",
