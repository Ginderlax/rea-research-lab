    {
      "id": "grafana.candidate.6b704dc3ce9db3fbde7f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The alert rule that you are about to create is meant to monitor web traffic page views. The objective is to explore what an alert instance is and how to leverage routing individual alert instances by using label matchers and notification policies.",
