        "lineStart": 175,
        "lineEnd": 175,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/influxdb/template-variables/index.md#L175-L175"
      },
      "applicability": {
