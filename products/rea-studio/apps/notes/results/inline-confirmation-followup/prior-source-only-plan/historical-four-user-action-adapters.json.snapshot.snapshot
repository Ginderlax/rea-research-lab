  {
    "path": "products/rea-studio/apps/notes/notebook-trash.ui.test.mjs",
    "beforeSha256": "ff478b802a5687a1fb6175a8cbff9fc4970b3d76a045435d57ed15a299985ffe",
    "afterSha256": "d00d0e84abaf6e18f3626f49e4eb7c29929e834542dc469370aeff5077e480a9",
    "before": "import test from 'node:test';\nimport assert from 'node:assert/strict';\nimport {render} from './client.mjs';\nimport {handle} from './server.mjs';\nclass Element{constructor(tag){this.tagName=tag;this.children=[];this.attributes={};this.value='';this.textContent='';this.disabled=false;this.checked=false;}append(...nodes){this.children.push(...nodes);}replaceChildren(...nodes){this.children=[...nodes];}insertBefore(node,before){const n=this.children.indexOf(before);this.children.splice(n<0?this.children.length:n,0,node);}setAttribute(k,v){this.attributes[k]=v;}getAttribute(k){return this.attributes[k];}get options(){return this.children;}focus(){}}\nfunction find(root,predicate){if(predicate(root))return root;for(const child of root.children){const result=find(child,predicate);if(result)return result;}return null;}\nasync function setup(t){const previous={document:globalThis.document,window:globalThis.window};globalThis.document={createElement:tag=>new Element(tag),createTextNode:text=>Object.assign(new Element('#text'),{textContent:text})};let confirmed=false,prompts=[];globalThis.window={confirm:text=>{prompts.push(text);return confirmed;}};t.after(()=>{globalThis.document=previous.document;globalThis.window=previous.window;});let saved={schema:2,notes:{},records:{},resources:{}};const store={get:async()=>structuredClone(saved),set:async(k,v)=>{saved=structuredClone(v);},list:async()=>[]},calls=[];const api=async(action,input={})=>{calls.push({action,input:structuredClone(input)});return handle({action,input,store});};let tree=await api('notebook-create',{revision:0,title:'Parent'});const parent=tree.notebook.id;tree=await api('notebook-create',{revision:tree.revision,parentId:parent,title:'Child'});await api('save',{title:'Owned note',notebookId:tree.notebook.id,body:'Saved body'});const root=new Element('root');await render(root,api);return{root,api,calls,parent,read:()=>structuredClone(saved),confirm:value=>{confirmed=value;},prompts};}\ntest('actual staged client confirms notebook cascade, allows management of trash, restores and keeps dirty drafts',async t=>{const f=await setup(t),manage=find(f.root,n=>n.attributes['aria-label']==='Manage notebook'),trash=find(f.root,n=>n.textContent==='Move notebook to trash'),restore=find(f.root,n=>n.textContent==='Restore notebook');manage.value=f.parent;manage.onchange();const before=f.calls.length;await trash.onclick();assert.equal(f.calls.slice(before).some(c=>c.action==='notebook-trash'),false);assert.match(f.prompts.at(-1),/all its subnotebooks/);f.confirm(true);await trash.onclick();assert.equal(Object.values(f.read().notes)[0].deletedAt!==null,true);assert.equal(manage.options.find(o=>o.value===f.parent).disabled,false);await restore.onclick();assert.equal(Object.values(f.read().notes)[0].deletedAt,null);assert.match(f.prompts.at(-1),/including notes trashed separately/);const body=find(f.root,n=>n.attributes['aria-label']==='Markdown note');body.value='private dirty draft';body.oninput();const requests=f.calls.length;await trash.onclick();assert.equal(f.calls.length,requests);assert.equal(body.value,'private dirty draft');assert.equal(find(f.root,n=>n.attributes.role==='status').textContent,'Save your draft before changing notebook organization.');});\ntest('held notebook operation disables selection/editor controls and refuses duplicate requests until one commit',async t=>{const f=await setup(t),manage=find(f.root,n=>n.attributes['aria-label']==='Manage notebook'),trash=find(f.root,n=>n.textContent==='Move notebook to trash');manage.value=f.parent;manage.onchange();f.confirm(true);let release,entered;const pending=new Promise(r=>release=r),started=new Promise(r=>entered=r); // Hold actual transport response after its server commit.\n const original=trash.onclick; // Client closure uses api; rerender with a held adapter while the owned state remains exact.\n let held=true;await render(f.root,async(action,input)=>{const value=await f.api(action,input);if(action==='notebook-trash'&&held){entered();await pending;}return value;});const chosen=find(f.root,n=>n.attributes['aria-label']==='Manage notebook'),button=find(f.root,n=>n.textContent==='Move notebook to trash');chosen.value=f.parent;chosen.onchange();const first=button.onclick();await started;assert.equal(chosen.disabled,true);assert.equal(find(f.root,n=>n.attributes['aria-label']==='Markdown note').disabled,true);await button.onclick();assert.equal(f.calls.filter(c=>c.action==='notebook-trash').length,1);held=false;release();await first;assert.equal(chosen.disabled,false);assert.equal(find(f.root,n=>n.attributes['aria-label']==='Markdown note').disabled,false);});\n",
    "after": "import test from 'node:test';import assert from 'node:assert/strict';\nimport {ui,gate,find} from './notebook-trash-review-fixture.mjs';\n// Candidate UI adapter: explicitly Cancel/Confirm the actual in-page controls.\n// The baseline bodies and native-dialog expectations remain inert in baseline/.\ntest('actual staged client confirms notebook cascade, allows management of trash, restores and keeps dirty drafts',async t=>{\n const f=await ui(t);f.manage();const before=f.calls.length,pending=f.click(f.byText('Move notebook to trash')),dialog=find(f.root,n=>n.attributes.role==='alertdialog');assert.match(dialog.children[1].textContent,/all its subnotebooks/);await f.click(find(dialog,n=>n.textContent==='Cancel'));await pending;assert.equal(f.calls.slice(before).some(c=>c.action==='notebook-trash'),false);\n await f.confirmNotebook('Move notebook to trash');assert.equal(Object.values(f.read().notes)[0].deletedAt!==null,true);assert.equal(f.byLabel('Manage notebook').options.find(o=>o.value===f.parent).disabled,false);\n const restored=f.click(f.byText('Restore notebook')),restoreDialog=find(f.root,n=>n.attributes.role==='alertdialog');assert.match(restoreDialog.children[1].textContent,/including notes trashed separately/);await f.click(find(restoreDialog,n=>n.textContent==='Confirm restore notebook'));await restored;assert.equal(Object.values(f.read().notes)[0].deletedAt,null);\n const body=f.byLabel('Markdown note');body.value='private dirty draft';body.oninput();const requests=f.calls.length;await f.click(f.byText('Move notebook to trash'));assert.equal(f.calls.length,requests);assert.equal(body.value,'private dirty draft');assert.equal(find(f.root,n=>n.attributes.role==='status').textContent,'Save your draft before changing notebook organization.');\n});\ntest('held notebook operation disables selection/editor controls and refuses duplicate requests until one commit',async t=>{\n const g=gate();let held=true;const f=await ui(t,async({action})=>{if(action==='notebook-trash'&&held){g.enter();await g.held;}});f.manage();const first=f.confirmNotebook('Move notebook to trash');await g.started;\n assert.equal(f.byLabel('Manage notebook').disabled,true);assert.equal(f.byLabel('Markdown note').disabled,true);await f.byText('Move notebook to trash').onclick();assert.equal(f.calls.filter(c=>c.action==='notebook-trash').length,1);held=false;g.release();await first;assert.equal(f.byLabel('Manage notebook').disabled,false);assert.equal(f.byLabel('Markdown note').disabled,false);\n});\n",
    "scope": "Two prior semantic bodies retargeted to explicit Cancel/Confirm DOM actions and the common synthetic fixture; old native prompt assertions become visible scope assertions. Baseline Owned note fixture title becomes A note."
  }
]
