    {
      "id": "grafana.candidate.33ac6922babbf2f549a9",
      "syntaxRole": "table-row",
      "sourceText": "| Option       | Description                                                                                                                                                                                                                                                                                                                                                             |",
      "headingPath": [
        "Add variables",
        "Add an interval variable"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/variables/add-template-variables.md",
        "gitBlobSha": "4457b936a9bfd014008fb8f048e6298c3d09adf4",
