    {
      "id": "grafana.candidate.9d0eb314fc49fa6da9f4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set the option detailed below to true to hide sign-out menu link. Useful if you use an auth proxy or JWT authentication.",
      "headingPath": [
        "Configure authentication",
