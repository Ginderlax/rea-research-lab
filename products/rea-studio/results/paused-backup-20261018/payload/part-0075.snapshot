    {
      "id": "grafana.candidate.7872170d4b4ff391f783",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To set up Git Sync and synchronize your Grafana dashboards and folders with a GitHub repository, follow these steps:",
