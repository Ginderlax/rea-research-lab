    {
      "id": "grafana.candidate.651a13317a152ce3a1ce",
      "syntaxRole": "table-row",
      "sourceText": "| `api_url`                    | Yes      | Yes                | Endpoint used to obtain GitHub user information compatible with [OpenID UserInfo](https://connect2id.com/products/server/docs/api/userinfo).                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          | `https://api.github.com/user`                 |",
      "headingPath": [
