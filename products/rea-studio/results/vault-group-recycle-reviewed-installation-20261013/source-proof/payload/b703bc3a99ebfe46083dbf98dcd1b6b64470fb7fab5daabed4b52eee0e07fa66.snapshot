import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';const root=process.cwd(),stage=path.join(root,'work/root-backup64-host-transition-next'),own=path.join(root,'work/root-backup64-host-transition-independent-review');fs.mkdirSync(own,{recursive:true});const sha=b=>createHash('sha256').update(b).digest('hex'),t=JSON.parse(fs.readFileSync(path.join(stage,'transformation.json'))),before=fs.readFileSync(path.join(stage,'verify-records.before.mjs.snapshot')),after=fs.readFileSync(path.join(stage,'verify-records.after.mjs.snapshot')),live=fs.readFileSync(path.join(root,'outputs/rea-research-lab/scripts/verify-records.mjs'));for(const [b,e]of[[before,t.before],[after,t.after]]){assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256)}assert.ok(after.equals(live));let inverse=after.toString();for(const c of [...t.changes].reverse()){assert.equal(inverse.split(c.after).length,2);inverse=inverse.replace(c.after,c.before)}assert.ok(Buffer.from(inverse).equals(before));const helper=t.changes[0].after;assert.ok(helper.includes("if(entry.path!=='products/rea-studio/server.mjs')return currentPublicFingerprint"));assert.ok(helper.includes("assert.equal(transition.historical3baHostAndInverseExact,true)"));assert.ok(helper.includes("assert.equal(sha(live),transition.after.sha256)"));assert.ok(helper.includes("d969655ed6d1e73f925147c277261b38333e2d095b18a486f2c7c2a7700689ff"));const receipt={schema:'rea-backup64-host-transition-independent-source-review/v1',at:new Date().toISOString(),before:t.before,after:t.after,inverseExact:true,changes:2,onlySharedServerHistorical:true,allOtherSourceRowsUseUnchangedCurrentGuard:true,authenticated3baCapsuleRequired:true,currentHostPinSuppliedByPriorStrictEditorTransition:true,observedNoBlockingSourceFlaw:true,appTests:0,original:0,browser:0,benchmark:0,repoWrites:0,limit:'Read-only transform and guard review, not root verifier rerun.'};const bytes=Buffer.from(JSON.stringify(receipt,null,2)+'\n');fs.writeFileSync(path.join(own,'review-validation.json'),bytes);fs.writeFileSync(path.join(own,'review-manifest.json'),JSON.stringify({schema:'rea-strict-independent-review/v1',inventory:[{path:'review-validation.json',bytes:bytes.length,sha256:sha(bytes)}]},null,2)+'\n');console.log(JSON.stringify({receipt:sha(bytes),after:sha(after),inverseExact:true,noBlocker:true}));
