    {
      "id": "grafana.candidate.1b55c12e648bbce198e5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To limit access to authenticated users who are members of one or more tenants, set `allowed_organizations` to a _comma-_ or _space-separated_ list of tenant IDs. You can find tenant IDs on the Azure portal under **Microsoft Entra ID -> Overview**.",
      "headingPath": [
        "Configure Microsoft Entra ID OAuth authentication",
        "Configure the Entra ID authentication client using the Grafana configuration file",
        "Configure allowed tenants"
      ],
      "source": {
