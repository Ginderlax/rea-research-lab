import fs from 'node:fs/promises';import path from 'node:path';import{fileURLToPath}from'node:url';import{createHash}from'node:crypto';import{spawn}from'node:child_process';
const own=path.dirname(fileURLToPath(import.meta.url)),[name,...tests]=process.argv.slice(2),app=path.join(own,'products/rea-studio/apps/vault');if(!/^[a-z0-9-]+$/.test(name??'')||!tests.length)throw new Error('Owned run name/tests required.');
const out=path.join(own,'runs',name);await fs.mkdir(out,{recursive:true});const sha=b=>createHash('sha256').update(b).digest('hex');
async function census(snapshot){const rows=[];for(const n of(await fs.readdir(app,{withFileTypes:true})).filter(e=>e.isFile()).map(e=>e.name).sort()){const b=await fs.readFile(path.join(app,n));rows.push({path:'products/rea-studio/apps/vault/'+n,bytes:b.length,sha256:sha(b)});if(snapshot){const p=path.join(out,'source',n+'.snapshot');await fs.mkdir(path.dirname(p),{recursive:true});await fs.writeFile(p,b);}}return rows;}
const collectorBytes=await fs.readFile(fileURLToPath(import.meta.url));await fs.mkdir(path.join(out,'source'),{recursive:true});await fs.writeFile(path.join(out,'source','run.mjs.snapshot'),collectorBytes);
const before=await census(true),startedAt=new Date().toISOString(),env={...process.env,REA_KEEPASS_EXE:path.resolve(own,'../../outputs/rea-research-lab/projects/07-keepass/artifacts/portable/KeePass.exe'),GROUP_OBSERVATIONS:path.join(out,'observations'),VAULT_REVIEW_OUTPUT:path.join(out,'observations/prior-ui')};await fs.mkdir(env.GROUP_OBSERVATIONS,{recursive:true});const child=spawn(process.execPath,['--test','--test-concurrency=1',...tests.map(t=>path.join(app,t))],{windowsHide:true,env}),chunks={stdout:[],stderr:[]},sizes={stdout:0,stderr:0};let problem;const timer=setTimeout(()=>{problem='Owned finite run exceeded180s.';child.kill()},180000);for(const channel of ['stdout','stderr'])child[channel].on('data',b=>{sizes[channel]+=b.length;if(sizes[channel]>4*1024*1024){problem='Capture exceeds4MiB per stream.';child.kill()}else chunks[channel].push(b)});const exit=await new Promise(resolve=>child.on('close',(code,signal)=>resolve({code,signal})));clearTimeout(timer);const after=await census(false);for(const channel of ['stdout','stderr'])await fs.writeFile(path.join(out,channel+'.txt'),Buffer.concat(chunks[channel]));const receipt={schema:'rea-keepass-group-focused-attempt/v1',name,startedAt,finishedAt:new Date().toISOString(),tests,exit,problem:problem??null,before,after,sourceStable:JSON.stringify(before)===JSON.stringify(after),sizes,collector:{path:'run.mjs',bytes:collectorBytes.length,sha256:sha(collectorBytes)},limits:{deadlineMs:180000,perStreamBytes:4194304},observationDestination:env.GROUP_OBSERVATIONS};await fs.writeFile(path.join(out,'run.json'),JSON.stringify(receipt,null,2)+'\n');process.stdout.write(Buffer.concat(chunks.stdout));process.stderr.write(Buffer.concat(chunks.stderr));console.log(JSON.stringify({name,sourceStable:receipt.sourceStable,exit}));process.exitCode=exit.code??1;
