import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{spawn}from'node:child_process';const base=path.resolve(import.meta.dirname,'..'),owned=path.join(base,'work/sketch-layout-installed-focus-next'),studio=path.join(base,'outputs/rea-research-lab/products/rea-studio'),sha=b=>createHash('sha256').update(b).digest('hex');const run=path.join(owned,'runs',new Date().toISOString().replaceAll(':','-'));await fs.mkdir(run,{recursive:true});async function save(n,b){const p=path.join(run,n);await fs.mkdir(path.dirname(p),{recursive:true});await fs.writeFile(p,b,{flag:'wx'});}async function json(n,v){await save(n,JSON.stringify(v,null,2)+'\n');}async function names(root,rel=''){const out=[];for(const e of await fs.readdir(path.join(root,rel),{withFileTypes:true})){assert.ok(!e.isSymbolicLink());if(e.isDirectory()&&['results','.local','node_modules'].includes(e.name))continue;const n=rel?rel+'/'+e.name:e.name;if(e.isDirectory())out.push(...await names(root,n));else out.push(n);}return out.sort();}
const sourceNames=[...(await names(path.join(studio,'apps/sketch'))).map(n=>'apps/sketch/'+n),'server.mjs','catalog.mjs','lib/storage.mjs','tests/sketch-layout-static-route.test.mjs'].sort();async function fingerprints(){return Promise.all(sourceNames.map(async n=>{const b=await fs.readFile(path.join(studio,n));return{path:n,bytes:b.length,sha256:sha(b)};}));}const before=await fingerprints();await json('source-before.json',before);for(const r of before)await save('source/'+r.path+'.snapshot',await fs.readFile(path.join(studio,r.path)));await save('runner.mjs.snapshot',await fs.readFile(import.meta.filename));const selected=['app.test.mjs','geometry.test.mjs','geometry-client.test.mjs','client.test.mjs','layout.test.mjs','layout-ui.test.mjs','precision.test.mjs','vendor-oracle.test.mjs'].map(n=>'apps/sketch/'+n);selected.push('tests/sketch-layout-static-route.test.mjs');for(const n of selected)await fs.access(path.join(studio,n));const args=['--test','--test-concurrency=1','--test-reporter=tap',...selected],env={...process.env,REA_LAYOUT_OBSERVATIONS:path.join(run,'observations/layout-original-actions.json'),REA_LAYOUT_PRECISION_OBSERVATIONS:path.join(run,'observations/precision')};delete env.NODE_TEST_CONTEXT;const startedAt=new Date().toISOString();console.log(JSON.stringify({phase:'started',run,sourceFiles:before.length,testFiles:selected.length}));const r=await new Promise(resolve=>{const p=spawn(process.execPath,args,{cwd:studio,env,shell:false,windowsHide:true,stdio:['ignore','pipe','pipe']}),parts={stdout:[],stderr:[]},sizes={stdout:0,stderr:0};let failure=null;for(const [n,cap]of[['stdout',8*1024*1024],['stderr',2*1024*1024]])p[n].on('data',b=>{const take=Math.max(0,Math.min(b.length,cap-sizes[n]));parts[n].push(b.subarray(0,take));sizes[n]+=take;if(take!==b.length){failure??='retained output cap';p.kill('SIGKILL');}});const t=setTimeout(()=>{failure??='240-second deadline';p.kill('SIGKILL');},240000);p.on('error',e=>failure??=e.message);p.on('close',(exitCode,signal)=>{clearTimeout(t);resolve({pid:p.pid,exitCode,signal,failure,stdout:Buffer.concat(parts.stdout),stderr:Buffer.concat(parts.stderr)});});});await save('stdout.txt',r.stdout);await save('stderr.txt',r.stderr);const after=await fingerprints();await json('source-after.json',after);const raw=r.stdout.toString(),summary=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo','duration_ms'].map(n=>[n,Number(raw.match(new RegExp('^# '+n+' ([\\d.]+)$','m'))?.[1]??-1)])),receipt={schema:'rea-sketch-layout-installed-focus/v1',startedAt,finishedAt:new Date().toISOString(),sourceFiles:before.length,sourceStable:JSON.stringify(before)===JSON.stringify(after),sourceBefore:before,sourceAfter:after,arguments:args,summary,runtime:{version:process.version,sha256:sha(await fs.readFile(process.execPath))},exitCode:r.exitCode,signal:r.signal,failure:r.failure,pid:r.pid,raw:{stdout:{path:'stdout.txt',bytes:r.stdout.length,sha256:sha(r.stdout)},stderr:{path:'stderr.txt',bytes:r.stderr.length,sha256:sha(r.stderr)}},originalSourceHelpersExecuted:'Bounded selected layout helpers and pinned existing vendor components; exact accounting must derive from retained observations/raw before qualification.',wholeOriginalApplicationExecutions:0,originalRendererExecutions:0,browserExecutions:0,benchmarks:0,productionModified:false,fullParity:false,universalSuperiority:false};await json('attempt.json',receipt);console.log(JSON.stringify({run,summary,sourceFiles:before.length,sourceStable:receipt.sourceStable,exitCode:r.exitCode}));assert.equal(r.failure,null);assert.equal(r.exitCode,0);assert.equal(receipt.sourceStable,true);assert.equal(summary.tests,summary.pass);assert.equal(summary.fail+summary.skipped+summary.cancelled+summary.todo,0);
