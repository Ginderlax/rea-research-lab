await fs.writeFile(path.join(here,'production-baseline-manifest.json'),JSON.stringify({schema:'rea-sketch-collector-production-baseline/v1',createdAt:new Date().toISOString(),geometryReceiptSha256:hash(await fs.readFile(path.join(here,'baseline/apps/sketch/results/geometry-validation.json'))),files,scope:'Explicit current implementation/docs/test/helper/storage and historical compatibility receipt paths only. No broad results inventory or rebind; additions by independent root preservation are excluded.'},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({preserved:files.length}));
