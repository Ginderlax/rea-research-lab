import fs from 'node:fs/promises';import path from 'node:path';import {spawnSync} from 'node:child_process';import {here,sha} from './authenticate-original.mjs';
const source=await fs.readFile(path.join(here,'freeze-stage.mjs')),stem='freeze-attempt-'+Date.now();await fs.writeFile(path.join(here,'preserved',stem+'.source.mjs'),source,{flag:'wx'});
const startedAt=new Date().toISOString(),child=spawnSync(process.execPath,[path.join(here,'freeze-stage.mjs')],{encoding:'utf8',timeout:60000,maxBuffer:1024*1024,windowsHide:true});
await fs.writeFile(path.join(here,'results',stem+'.stdout.txt'),child.stdout??'');await fs.writeFile(path.join(here,'results',stem+'.stderr.txt'),child.stderr??'');const receipt={schemaVersion:1,startedAt,completedAt:new Date().toISOString(),exitCode:child.status,signal:child.signal,error:child.error?.message,sourceSHA256:sha(source),stdoutSHA256:sha(child.stdout??''),stderrSHA256:sha(child.stderr??''),scope:'Freeze authentication attempt only. First identical failure appeared in tool console; this captured replay preserves its actual source/output before any fix. No candidate or measurement execution.'};await fs.writeFile(path.join(here,'results',stem+'.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({stem,...receipt}));
