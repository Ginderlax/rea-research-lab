    {
      "id": "grafana.candidate.986f9408dd687bdbdbf2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Using complex regular expressions in either type can affect browser performance when processing large volumes of logs. Use simpler patterns when possible.",
