    },
    {
      "id": "grafana.candidate.5f24927be71e06a83657",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana supports the current version of the following browsers. Older versions of these browsers might not be supported, so you should always upgrade to the latest browser version when using Grafana.",
      "headingPath": [
        "Install Grafana",
        "Supported web browsers"
      ],
