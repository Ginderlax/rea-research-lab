    },
    {
      "id": "grafana.candidate.5bf9f0e3d1178573c51e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can set the **Alignment Period** field to group a metric by time if you've chosen an aggregation.",
      "headingPath": [
        "Google Cloud Monitoring query editor",
        "Query metrics",
        "Align data",
        "Define the alignment period"
      ],
      "source": {
        "path": "docs/sources/datasources/google-cloud-monitoring/query-editor/index.md",
