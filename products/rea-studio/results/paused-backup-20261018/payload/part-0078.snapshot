    {
      "id": "grafana.candidate.0bccedd827535ecdcabf",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Install the license key as normal. For more information on installing your license key, refer to [Add your license to a Grafana instance](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/administration/enterprise-licensing/#step-2-add-your-license-to-a-grafana-instance).",
      "headingPath": [
