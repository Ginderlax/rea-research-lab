import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),b=await fs.readFile(path.join(here,'collect.mjs'));let t=b.toString();const needle='draft-boundaries.test.mjs';assert.equal(t.split(needle).length-1,2);t=t.replaceAll(needle,'adjacent.test.mjs');const out=Buffer.from(t);await fs.writeFile(path.join(here,'collect-adjacent.mjs'),out,{flag:'wx'});await fs.writeFile(path.join(here,'adjacent-collector-adapter.json'),JSON.stringify({before:id(b),after:id(out),selectionOnlySubstitution:{before:needle,after:'adjacent.test.mjs',occurrences:2},firstFailureSourcesUnchanged:true},null,2)+'\n',{flag:'wx'});
