# Version Conversion Support
# These are used from converting from version 1
# to version 2 or vice-versa.


def _flipDict(d: dict[K, V]) -> dict[V, K]:
    flipped = {}
    for key, value in list(d.items()):
        flipped[value] = key
    return flipped


