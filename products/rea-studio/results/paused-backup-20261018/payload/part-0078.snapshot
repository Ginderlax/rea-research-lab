    {
      "id": "grafana.candidate.d5ca59112a3537a4a8b9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Before we can install Grafana, you first need to set up your Raspberry Pi.",
      "headingPath": [
        "Introduction",
        "Set up your Raspberry Pi"
      ],
      "source": {
        "path": "docs/sources/tutorials/install-grafana-on-raspberry-pi/index.md",
