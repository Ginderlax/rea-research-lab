    {
      "id": "grafana.candidate.dee218d3b66375c800be",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This new transformation can help eliminate the need for multiple queries to the same datasource with different WHERE clauses when graphing multiple series.",
