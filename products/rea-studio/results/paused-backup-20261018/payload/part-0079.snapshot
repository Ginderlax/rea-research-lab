    {
      "id": "grafana.candidate.ac2c1287149f21486c75",
      "syntaxRole": "list-item",
      "sourceText": "- **Layered** - Default. Creates a predictable and orderly layout, especially useful for service graphs.",
      "headingPath": [
        "Node graph",
        "Configuration options",
        "Node graph options",
        "Layout algorithm"
      ],
      "source": {
