      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c346a65148c56e610e2e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The [custom payload option](ref:custom-payload-webhook) in the webhook contact point allows you to customize the payload of webhook notifications using a custom template.",
      "headingPath": [
        "Notification template examples",
        "Custom JSON payload"
      ],
      "source": {
        "path": "docs/sources/alerting/configure-notifications/template-notifications/examples.md",
        "gitBlobSha": "f44ada3c4bf2cbd8bb3541714231e6d910f8e923",
        "sha256": "2e6cc529503bea16404932fec29b5fea613b7e5454ac177a89d97904a07e417f",
        "lineStart": 534,
        "lineEnd": 534,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/configure-notifications/template-notifications/examples.md#L534-L534"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
