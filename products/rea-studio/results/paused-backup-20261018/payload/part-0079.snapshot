    {
      "id": "grafana.candidate.b7fdca541b9769629d5f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Trend visualizations require at least two numeric fields. The x-field must use ascending numeric values. If the values aren't ascending, Grafana shows an error. When multiple frames or queries exist, you should use a [join transformation](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/visualizations/panels-visualizations/query-transform-data/transform-data/) on the x-fields to produce a single frame.",
      "headingPath": [
        "Trend"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/trend/index.md",
        "gitBlobSha": "3640977e8d0eef595b523c449cc0e86c189bc924",
