import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {here,sha,authenticateOriginal} from './authenticate-original.mjs';
const receiptName='stage-validation.json',manifestName='freeze-manifest.json',fp=async file=>{const data=await fs.readFile(file);return {bytes:data.length,sha256:sha(data)};},read=async name=>JSON.parse(await fs.readFile(path.join(here,name)));
async function inventory(base=here,dir=base){const result={};for(const row of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const file=path.join(dir,row.name),relative=path.relative(base,file).replaceAll('\\','/');if(base===here&&[receiptName,manifestName].includes(relative))continue;assert.ok(!row.isSymbolicLink());if(row.isDirectory())Object.assign(result,await inventory(base,file));else {assert.ok(row.isFile());result[relative]=await fp(file);}}return result;}
const preparation=await read('preparation.json'),authority=await authenticateOriginal(),execution=await read('results/correctness-1791848448609.json'),differential=await read('results/candidate-wrapper.json'),selection=await read('results/candidate-wrapper-selection-heldout.json'),standard=await read('results/candidate-wrapper-standard-heldout.json'),controls=await read('results/wrapper-controls.json'),diagnostics=await read('recorded-diagnostics.json');
assert.equal((await fp(preparation.production.path)).sha256,'9269cf8c32be9bf2c075b67019e82e41272d9495f0321fefc17b2c5695a91371');assert.equal((await fp(path.join(here,'candidate-wrapper.mjs'))).sha256,'b3feba481b9ceaad6dce4dfca0c2e264b1e1dcfbb2499192e74b48ef92baace0');assert.equal((await fp(path.join(here,'selector-algorithm.mjs'))).sha256,'de334c498bb286c640661d8a3df05794fb66ebb02a3629231f18dbcb3c9bd58c');
assert.equal((await fp(path.join(here,'preserved/latest-summary.json'))).sha256,'e1bd043ecf79c7b878c4a5be76cd1f4b4b38d721435f555b35eee3cde8b92029');assert.equal((await fp(path.join(here,'preserved/previous-summary.json'))).sha256,'18a5373363c0103dc54e25cd9deccc8254ebabfbf1e4f775343295c6d81bd78f');assert.equal((await fp(path.join(here,'preserved/latest-paired-receipt.json'))).sha256,'a24647644314c004342886b06a366edebc52b681c8b30a256d7397af7c26e40a');assert.equal((await fp(path.join(here,'preserved/previous-paired-receipt.json'))).sha256,'181e42fc5080fa511d5fc3a0dd803a12216a1ed09ed88a1e99b2e416a739114c');
for(const copy of preparation.copies){const expected={bytes:copy.bytes,sha256:copy.sha256};assert.deepEqual(await fp(path.join(here,copy.path)),expected);assert.deepEqual(await fp(path.join(copy.sourceRoot,copy.sourcePath)),expected);}
const priorManifest=await read('preserved/prior-algorithm-freeze.json');assert.equal((await fp(path.join(here,'preserved/prior-algorithm-freeze.json'))).sha256,'4ba611ee5cf9d9c1e8e6a8b210dae381f17e1e7f75820700c519067201c221dd');assert.equal(Object.keys(priorManifest.inventory).length,88);for(const [name,record]of Object.entries(priorManifest.inventory))assert.deepEqual(await fp(path.join(here,'../metrics-selector-algorithm-next',name)),record);
for(const [name,record]of Object.entries(diagnostics.records)){assert.equal((await fp(path.join(here,'preserved/'+name+'-paired-receipt.json'))).sha256,record.pairedReceipt.sha256);for(const raw of record.rawBindings)assert.deepEqual(await fp(path.join(record.pairedReceipt.sourceRoot,raw.sourcePath)),{bytes:raw.bytes,sha256:raw.sha256});assert.equal(record.rawBindings.length,147);}
assert.equal(execution.status,'passed');assert.deepEqual(execution.sourceHashesBefore,execution.sourceHashesAfter);for(const [name,digest]of Object.entries(execution.sourceHashesBefore))assert.equal((await fp(path.join(here,name))).sha256,digest);for(const record of execution.records){assert.equal(record.exitCode,0);assert.equal(record.killed,false);assert.equal((await fp(path.join(here,record.stdoutPath))).sha256,record.stdoutSHA256);assert.equal((await fp(path.join(here,record.stderrPath))).sha256,record.stderrSHA256);const snapshot=record.stdoutPath.replace('.stdout.txt','.source.mjs.snapshot');assert.equal((await fp(path.join(here,snapshot))).sha256,record.sourceSHA256);}
for(const row of [differential,selection,standard,controls])assert.equal(row.status,'passed');assert.equal(differential.comparisons,2910751);assert.equal(differential.standardHelperComparisons,14240);assert.equal(differential.cacheComparisons,48240);assert.equal(selection.comparisons,3888);assert.equal(selection.registryComparisons,864);assert.equal(standard.reducerComparisons,9600);assert.equal(standard.helperComparisons,1920);assert.equal(standard.mutationComparisons,24);assert.equal(controls.packetChecks,63);assert.equal(controls.dispatchChecks,8);
const baseline=await fs.readFile(path.join(here,'candidate-baseline.mjs'),'utf8'),candidate=await fs.readFile(path.join(here,'candidate-wrapper.mjs'),'utf8');assert.equal(candidate.replace(preparation.changes.import+'\n','').replace(preparation.changes.onlySpecialBodyInsertion+'\n',''),baseline);
if(process.argv.includes('--verify-only')){const receipt=await read(receiptName),manifest=await read(manifestName);assert.deepEqual(await inventory(),receipt.inventory);for(const row of manifest.entries)assert.deepEqual(await fp(path.join(here,row.path)),{bytes:row.bytes,sha256:row.sha256});assert.equal((await fp(path.join(here,receiptName))).sha256,manifest.receiptSHA256);console.log(JSON.stringify({status:'passed',readOnly:true,files:manifest.entries.length,receiptSHA256:manifest.receiptSHA256,manifestSHA256:(await fp(path.join(here,manifestName))).sha256}));}
else {const current=await inventory(),provenance=await read('preserved/original-provenance.json');for(const archive of provenance.archives)assert.deepEqual(await fp(archive.source),{bytes:archive.bytes,sha256:archive.sha256});const receipt={schema:'rea-metrics-wrapper-correctness-stage/v1',frozenAt:new Date().toISOString(),status:'source-stable finite correctness passed; performance cause unresolved',candidate:preparation.candidate,productionBaseline:preparation.production,exactBaselineBodyBindings:preparation.bodyBindings,inverseSubstitutionReconstructsBaseline:true,selectorHelperChanged:false,authority,originalArchives:provenance.archives,runtime:provenance.authority?{version:process.version,execPath:process.execPath,executableSHA256:(await fp(process.execPath)).sha256}:null,prior88AlgorithmAuthenticatedUnchanged:true,fullCampaignReused:true,fullCampaignIsNewIndependentCorpus:false,inheritedDriverIndependenceWordingScope:'Historical generator independence wording is retained in the exact copied driver/output; this stage regenerates the same existing356 inputs and seeds, not a newly independent corpus.',correctnessBoundElapsedDiagnostic:{elapsedMilliseconds:differential.bounded.elapsedMs,purpose:differential.bounded.purpose,notTimedComparativeStudy:true},correctnessExecution:{path:'results/correctness-1791848448609.json',...await fp(path.join(here,'results/correctness-1791848448609.json')),sourceStable:true,childProcesses:4,failedChildren:0},counts:{reducers:2910751,standardHelpers:14240,cacheIncludedInReducers:48240,heldoutSelection:3888,directRegistry:864,heldoutStandard:9600,heldoutStandardHelpers:1920,mutationAlias:24,fixedFixturePackets:63,dispatchControls:8,reusedRecordedTimingChildren:294},semanticComparisonFailures:0,recordedObservations:{path:'recorded-diagnostics.json',...await fp(path.join(here,'recorded-diagnostics.json')),readOnlyReuse:true},diagnosis:{latestMeasuredMultiSelectionWrapperChanged:true,arithmeticUnchanged:true,variationInUnchangedControlMedians:true,causalContributionEstablished:false,measuredRegressionRetained:true},futureMeasurementPlan:'DIAGNOSIS-PLAN.md',futureHarnessReady:false,newTimedComparativeStudies:0,newMemoryMeasurements:0,profilerRuns:0,externalBinaryArchivesCopied:false,productionChanged:false,priorFrozenStudiesChanged:false,selectedForIntegration:false,performanceAcceptance:false,fullPerformanceNonRegressionEstablished:false,universalCorrectnessEstablished:false,universalSuperiorityEstablished:false,fullParityEstablished:false,fullProductComplete:false,inventory:current};await fs.writeFile(path.join(here,receiptName),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});assert.deepEqual(await inventory(),current);const receiptRecord=await fp(path.join(here,receiptName)),entries=Object.entries(current).map(([name,row])=>({path:name,...row}));entries.push({path:receiptName,...receiptRecord});const manifest={schema:'rea-metrics-wrapper-correctness-freeze/v1',receiptSHA256:receiptRecord.sha256,entries:entries.sort((a,b)=>a.path.localeCompare(b.path)),files:entries.length,aggregateBytes:entries.reduce((sum,row)=>sum+row.bytes,0),excludes:[manifestName],timedComparativeStudyRun:false,memoryMeasurementRun:false,profileRun:false,productionChanged:false};await fs.writeFile(path.join(here,manifestName),JSON.stringify(manifest,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:receipt.status,files:entries.length,bytes:manifest.aggregateBytes,receiptSHA256:receiptRecord.sha256,manifestSHA256:(await fp(path.join(here,manifestName))).sha256,candidate:preparation.candidate,counts:receipt.counts}));}
