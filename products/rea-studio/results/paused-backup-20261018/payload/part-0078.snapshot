    },
    {
      "id": "grafana.candidate.cedc3831077f2fc3b018",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "![The Search query builder](/media/docs/grafana/data-sources/tempo/query-editor/tempo-ds-query-search-v11.png)",
