    {
      "id": "grafana.candidate.5a807d50886541fc05bf",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The most common and reliable way to create Prometheus annotations. Prometheus automatically generates an `ALERTS` metric for all configured alerting rules.",
      "headingPath": [
        "Prometheus annotations",
        "Example annotation queries",
        "Alert-based annotations using `ALERTS`"
      ],
      "source": {
        "path": "docs/sources/datasources/prometheus/annotations/index.md",
