    {
      "id": "grafana.candidate.1e38bc411d9ad33139f7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can define and configure the data source in YAML files as part of the Grafana provisioning system. For more information about provisioning, and for available configuration options, refer to [Provisioning Grafana](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/administration/provisioning/).",
      "headingPath": [
        "Configure the Elasticsearch data source",
        "Provision the data source"
      ],
      "source": {
