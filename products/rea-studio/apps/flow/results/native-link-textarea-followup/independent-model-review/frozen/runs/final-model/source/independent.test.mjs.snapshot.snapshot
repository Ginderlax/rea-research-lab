import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs/promises';import path from'node:path';import{fixture,linkScene}from'./fixture.mjs';
const seed=JSON.parse(await fs.readFile(new URL('./source/browser28-seed.json.snapshot',import.meta.url),'utf8')),observations=[];const norm=s=>s.replace(/\r\n?/g,'\n');
async function owned(label,options,body){const f=await fixture(options);try{await body(f);}finally{f.release();const blobs=[];for(const blob of f.downloads)blobs.push(await blob.text());observations.push({label,calls:f.calls,blobs,text:f.field('Native Node-RED flow JSON')?.value,name:f.field('Native flow name')?.value,section:f.section.textContent,qualifier:'Actual client+MemoryStore handler, native-normalizing DOM model. Disabled mutations explicit programmatic probes; not browser/user typing evidence.'});await f.close();}}
test.after(async()=>{const out=process.env.FLOW_LINK_OBSERVATIONS;assert(out);await fs.mkdir(out,{recursive:true});await fs.writeFile(path.join(out,'independent.json'),JSON.stringify({observations,originalExecutions:0,actualBrowser:0,httpHosts:0},null,2)+'\n',{flag:'wx'});});
function input(field,value){field.value=value;return field.fire('input',{programmatic:true});}
test('fresh mixed endings+astral unknown metadata loaded Save and Blob Export preserve decoded raw source exactly',async()=>{const doc=linkScene();doc.vendor={emoji:'😀',lineSep:'A\u2028B',combining:'e\u0301',future:{values:['\r','\n','\r\n']}};const raw=JSON.stringify(doc,null,2).replace(/\n/g,(_,i)=>i%3===0?'\r\n':i%3===1?'\r':'\n')+'\r\n';await owned('fresh-mixed-raw',{rawText:raw},async f=>{await f.load();assert.equal(f.field('Native Node-RED flow JSON').value,norm(raw));await input(f.field('Native flow name'),'mixed raw owned');await f.button('Save native draft').click();const save=f.calls.filter(c=>c.action==='native-save').at(-1);assert.equal(save.input.text,raw);await f.button('Export Node-RED JSON').click();assert.equal(await f.downloads[0].text(),raw);assert.deepEqual(JSON.parse(await f.downloads[0].text()),doc);await f.button('Deploy native flow').click();assert.equal(f.calls.filter(c=>c.action==='native-deploy').length,1);});});
test('fresh raw imported array with CR endings remains raw after Save Export and normalization-only deployment',async()=>{const raw=JSON.stringify(linkScene().flows,null,1).replaceAll('\n','\r')+'\r';await owned('fresh-import-array',{},async f=>{await f.load();const file=f.field('Import Node-RED flow file');file.files=[{name:'owned-array.json',size:Buffer.byteLength(raw),text:async()=>raw}];await file.fire('change');assert.equal(f.field('Native Node-RED flow JSON').value,norm(raw));await f.button('Save native draft').click();assert.equal(f.calls.filter(c=>c.action==='native-save').at(-1).input.text,raw);await f.button('Export Node-RED JSON').click();assert.equal(await f.downloads[0].text(),raw);await f.button('Deploy native flow').click();assert.equal(f.calls.filter(c=>c.action==='native-deploy').length,1);});});
test('fresh Save second list await cannot replace programmatic text+name drafts; actual write captured once',async()=>{let armed=false;await owned('fresh-save-second',{rawText:seed.text,hold:a=>armed&&a==='native-list'},async f=>{await f.load();armed=true;const pending=f.button('Save native draft').click();try{await f.held;const field=f.field('Native Node-RED flow JSON'),name=f.field('Native flow name');assert.equal(field.disabled,true);assert.equal(name.disabled,true);const next=JSON.stringify({...seed.document,fresh:'after list await'});await input(field,next);await input(name,'newer pending name');f.release();await pending;assert.equal(field.value,next);assert.equal(name.value,'newer pending name');assert.equal(f.calls.filter(c=>c.action==='native-save').length,1);assert.equal(f.calls.filter(c=>c.action==='native-save')[0].input.text,seed.text);await f.button('Deploy native flow').click();assert.equal(f.calls.filter(c=>c.action==='native-deploy').length,0);await f.button('Save native draft').click();assert.equal(f.calls.filter(c=>c.action==='native-save').at(-1).input.text,next);assert.equal(f.calls.filter(c=>c.action==='native-save').at(-1).input.name,'newer pending name');}finally{f.release();await pending;}});});
test('fresh Save third preview await suppresses stale diagram publication over a newer programmatic draft',async()=>{let armed=false;await owned('fresh-save-third',{rawText:seed.text,hold:a=>armed&&a==='native-validate'},async f=>{await f.load();armed=true;const field=f.field('Native Node-RED flow JSON'),pending=f.button('Save native draft').click();try{await f.held;assert.equal(field.disabled,true);const next=JSON.stringify({flows:[{id:'new-tab',type:'tab'}],newer:'preview boundary'});await input(field,next);f.release();await pending;assert.equal(field.value,next);assert.equal(f.calls.filter(c=>c.action==='native-save').length,1);assert.match(f.section.textContent,/newer draft input remains/);await f.button('Validate native flow').click();assert.equal(f.calls.filter(c=>c.action==='native-validate').at(-1).input.text,next);}finally{f.release();await pending;}});});
test('fresh same-value name input revision blocks held Export even though normalized source and filename return unchanged',async()=>{let armed=false;await owned('fresh-name-revision',{rawText:seed.text,hold:a=>armed&&a==='native-validate'},async f=>{await f.load();armed=true;const pending=f.button('Export Node-RED JSON').click();try{await f.held;const name=f.field('Native flow name'),original=name.value;assert.equal(name.disabled,true);await input(name,original+' changed');await input(name,original);f.release();await pending;assert.equal(f.downloads.length,0);await f.button('Export Node-RED JSON').click();assert.equal(await f.downloads[0].text(),seed.text);}finally{f.release();await pending;}});});
test('fresh export guards filename value without relying on input events or a changed document',async()=>{let armed=false;await owned('fresh-name-no-event',{rawText:seed.text,hold:a=>armed&&a==='native-validate'},async f=>{await f.load();armed=true;const pending=f.button('Export Node-RED JSON').click();try{await f.held;const name=f.field('Native flow name');assert.equal(name.disabled,true);name.value='programmatic filename change';f.release();await pending;assert.equal(f.downloads.length,0);assert.equal(name.value,'programmatic filename change');await f.button('Export Node-RED JSON').click();assert.equal(f.downloads.length,1);assert.equal(await f.downloads[0].text(),seed.text);}finally{f.release();await pending;}});});
test('fresh held File.text retains its captured filename and ignores a newer programmatic name-only edit',async()=>{await owned('fresh-import-name',{},async f=>{await f.load();let ready,release;const started=new Promise(r=>ready=r),loaded=new Promise(r=>release=r),source={name:'captured.json',size:Buffer.byteLength(seed.text),text:async()=>{ready();return loaded;}};const file=f.field('Import Node-RED flow file');file.files=[source];const pending=file.fire('change');try{await started;const name=f.field('Native flow name'),oldText=f.field('Native Node-RED flow JSON').value;assert.equal(name.disabled,true);await input(name,'newer existing name');source.name='later-mutated-source-name.json';release(seed.text);await pending;assert.equal(name.value,'newer existing name');assert.equal(f.field('Native Node-RED flow JSON').value,oldText);assert.match(f.section.textContent,/newer draft input remains/);}finally{release(seed.text);await pending;}});});
test('fresh disabled normal input cannot revise a pending captured operation; all native controls restore after response',async()=>{let armed=false;await owned('fresh-disabled-qualification',{rawText:seed.text,hold:a=>armed&&a==='native-validate'},async f=>{await f.load();armed=true;const field=f.field('Native Node-RED flow JSON'),pending=f.button('Export Node-RED JSON').click();try{await f.held;assert.equal(field.disabled,true);await field.fire('input');f.release();await pending;assert.equal(f.downloads.length,1);assert.equal(await f.downloads[0].text(),seed.text);for(const control of f.section.querySelectorAll('button,input,select,textarea'))assert.equal(control.disabled,false);assert.equal(f.section.getAttribute('aria-busy'),'false');}finally{f.release();await pending;}});});
test('fresh dirty content/Unicode/whitespace all refuse Deploy but a normalized unchanged raw baseline deploys',async()=>{await owned('fresh-dirty',{rawText:seed.text},async f=>{await f.load();const field=f.field('Native Node-RED flow JSON'),base=field.value;for(const value of [' '+base,base.replace('Static Out','Static Out 😀'),base.replace('Static Out','Static Out\u2028')]){assert.notEqual(value,base);await input(field,value);await f.button('Deploy native flow').click();assert.equal(f.calls.filter(c=>c.action==='native-deploy').length,0);assert.match(f.section.textContent,/Save the edited draft/);}await input(field,base);await f.button('Deploy native flow').click();assert.equal(f.calls.filter(c=>c.action==='native-deploy').length,1);});});
test('fresh disposal while Save list is held leaves committed source intact and no old preview/Export request escapes',async()=>{let armed=false;await owned('fresh-dispose-second',{rawText:seed.text,hold:a=>armed&&a==='native-list'},async f=>{await f.load();armed=true;const field=f.field('Native Node-RED flow JSON'),exportButton=f.button('Export Node-RED JSON'),pending=f.button('Save native draft').click();try{await f.held;f.dispose();const calls=f.calls.length;f.release();await pending;assert.equal(field.value,'');assert.equal(f.section.children.length,0);assert.equal(f.calls.length,calls);await exportButton.click();assert.equal(f.calls.length,calls);assert.equal(f.downloads.length,0);assert.equal(f.calls.filter(c=>c.action==='native-save').length,1);assert.equal(f.calls.filter(c=>c.action==='native-save')[0].input.text,seed.text);}finally{f.release();await pending;}});});
