    {
      "id": "grafana.candidate.73e7b04885ed8baacbcf",
      "syntaxRole": "table-row",
      "sourceText": "| Host URL      | The IP address/hostname and optional port of your PostgreSQL instance. The default PostgreSQL port is `5432`. For IPv6 addresses, use the format `[::1]:5432`. To connect through a Unix socket, enter the socket directory path (for example, `/var/run/postgresql`). |",
      "headingPath": [
        "Configure the PostgreSQL data source",
        "PostgreSQL configuration options"
      ],
      "source": {
