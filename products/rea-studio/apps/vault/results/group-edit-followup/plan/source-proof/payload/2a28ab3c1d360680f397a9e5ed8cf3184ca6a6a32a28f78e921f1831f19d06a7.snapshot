import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const here=import.meta.dirname,work=path.resolve(here,'..'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),json=v=>Buffer.from(JSON.stringify(v,null,2)+'\n');async function save(p,b){await fs.writeFile(path.join(here,p),b,{flag:'wx'});}const run='runs/focused-2026-10-13T05-49-08-603Z',focused=JSON.parse(await fs.readFile(path.join(here,run,'validation.json')));assert(focused.accepted&&focused.sourceStable&&focused.refsStable);assert.deepEqual(focused.totals,{tests:34,pass:34,fail:0,skipped:0,cancelled:0,todo:0});
const delta=JSON.parse(await fs.readFile(path.join(here,'client-deltas.json'))),before=await fs.readFile(path.join(here,'authority/client885.mjs.snapshot')),client=await fs.readFile(path.join(here,'products/rea-studio/apps/vault/client.mjs'));assert.deepEqual(id(client),delta.after);let inverse=client.toString();for(const d of[...delta.deltas].reverse()){assert.equal(inverse.split(d.after).length-1,1);inverse=inverse.replace(d.after,d.before);}assert(Buffer.from(inverse).equals(before));
const backend=[];for(const p of['server.mjs','recycle.mjs','history.mjs','kdbx.mjs','xml.mjs']){const a=await fs.readFile(path.join(here,'products/rea-studio/apps/vault',p)),b=await fs.readFile(path.join(work,'vault-group-edit-next/products/rea-studio/apps/vault',p));assert(a.equals(b));backend.push({path:'products/rea-studio/apps/vault/'+p,...id(a)});}
const references=[];for(const[name,file,pin,count]of[['vault-group-edit-next','manifest.json','52a88d027dc910c3ef8723e80690aef98dacdc9c98d43902192663ca43799ff4',885],['vault-group-edit-independent-review','review-manifest.json','65dbe05edf39e3625833f828fcad760b577d6fb0f3c4b6d8826379b6b1dbbc93',78]]){const raw=await fs.readFile(path.join(work,name,file));assert.equal(id(raw).sha256,pin);const m=JSON.parse(raw);assert.equal(m.inventory.length,count);for(const r of m.inventory)assert.deepEqual(id(await fs.readFile(path.join(work,name,r.path))),{bytes:r.bytes,sha256:r.sha256});references.push({folder:name,file,...id(raw),payloads:count});}
const study=JSON.parse(await fs.readFile(path.join(here,'source-study.json')));assert.equal(study.sources.length,17);assert.equal(study.license,'GPL-2.0-or-later');for(const r of study.sources)assert.deepEqual(id(await fs.readFile(path.join(here,r.path))),{bytes:r.bytes,sha256:r.sha256});
const replay=JSON.parse(await fs.readFile(path.join(here,'replay-adapters.json')));for(const r of replay.rows){assert.deepEqual(id(await fs.readFile(path.join(here,'regression',r.path))),r.after);assert.deepEqual(id(await fs.readFile(path.join(work,'vault-group-edit-independent-review',r.path))),r.before);}const scopes=focused.results.map(r=>({name:r.name,file:r.file,scope:r.scope,counts:r.counts}));
await save('validation.json',json({schema:'rea-vault-group-edit-late-draft-correction/v1',at:new Date().toISOString(),status:'frozen-author-correction-awaiting-independent-acceptance',client:{path:'products/rea-studio/apps/vault/client.mjs',...id(client)},old885Client:id(before),runtimeSubstitutions:4,inverseExact:true,backendFiveExact:backend,copiedSourceFiles:93,fullCandidateAndSelectedSourceStudyCopiedWithoutRecursiveHistory:true,references,focused:{path:run+'/validation.json',...id(await fs.readFile(path.join(here,run,'validation.json'))),totals:focused.totals,sourceRows:focused.sourceRows,sourceStable:true,scopes},oldIndependent11BodiesUnchanged:true,fixtureImportsOnly:4,newAuthorControls:8,oldIndependentRegressionsReplayed:11,prior343RegressionsReplayed:15,sourceLicenseFiles17Exact:true,GPLLicenseRetained:true,declaredHistoricalOriginalLoads:22,newOriginalExecutions:0,originalCodeImportedByApplication:false,nativeBrowserAcceptance:false,actualHTTPHostCampaigns:0,independentCorrectionAcceptance:false,ownedNodeChildrenExited:true,ownedTempCleanupPassed:true,productionWrites:0,oldStageWrites:0,fullProductParity:false,securityEquivalence:false,universalSuperiority:false,limitations:['DOM-model current client/server checks, not native browser or shared-host current acceptance.','Source-assisted selected name/notes editing; other group settings remain unsupported.','The old885 original22/rootHTTP3/rootBrowser8 receipts remain bound to their prior exact sources.','External transport/list failure recovery beyond the tested persistence failure/retry and generation boundaries is not complete product parity.']}));
const inventory=[],excluded=[];async function walk(dir,prefix=''){for(const e of await fs.readdir(dir,{withFileTypes:true})){assert(!e.isSymbolicLink());const p=prefix+e.name;if(e.isDirectory())await walk(path.join(dir,e.name),p+'/');else{assert(e.isFile());const b=await fs.readFile(path.join(dir,e.name)),r={path:p,...id(b)};if(p.split('/').includes('.local'))excluded.push(r);else inventory.push(r);}}}await walk(here);inventory.sort((a,b)=>a.path.localeCompare(b.path));assert(!inventory.some(r=>r.path==='manifest.json'||r.path==='freeze.json'));for(const r of inventory){const b=await fs.readFile(path.join(here,r.path));assert(Buffer.from(b.toString('utf8')).equals(b));assert(!/^(4d5a|7f454c46|504b0304|1f8b|377abcaf271c|03d9a29a|28b52ffd)/.test(b.subarray(0,8).toString('hex')),r.path+' carrier');}
await save('manifest.json',json({schema:'rea-vault-group-edit-late-draft-correction-strict-freeze/v1',files:inventory.length,inventory,excluded:['.local/**','manifest.json','freeze.json'],excludedGenerated:excluded,originalNativeCarriersCopied:false}));await save('freeze.json',json({schema:'rea-vault-group-edit-late-draft-correction-freeze/v1',manifest:{path:'manifest.json',...id(await fs.readFile(path.join(here,'manifest.json')))},validation:{path:'validation.json',...id(await fs.readFile(path.join(here,'validation.json')))},frozen:true,client:id(client),independentAcceptancePending:true}));process.stdout.write(JSON.stringify({payloads:inventory.length,localOnlyGenerated:excluded.length,manifest:id(await fs.readFile(path.join(here,'manifest.json'))),validation:id(await fs.readFile(path.join(here,'validation.json'))),client:id(client),tests:34,source99Stable:true,originals0:true,productionWrites:0})+'\n');
