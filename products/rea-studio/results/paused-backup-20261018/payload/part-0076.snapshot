    {
      "id": "grafana.candidate.a7888c41154431e308a8",
      "syntaxRole": "procedural-step",
      "sourceText": "1. The span might be shorter than the sampling interval of the profiler. Span profiling is most effective on spans longer than 20ms.",
      "headingPath": [
        "Configure Trace to profiles",
        "Troubleshoot trace to profiles",
        "Button appears but no profile data is shown"
