    {
      "id": "grafana.candidate.7bc7567678c53f1bb158",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Logs Insights for the CloudWatch data source does not support query caching due to the way logs are requested from AWS.",
