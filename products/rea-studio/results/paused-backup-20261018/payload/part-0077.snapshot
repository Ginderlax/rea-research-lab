        "lineStart": 544,
        "lineEnd": 544,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md#L544-L544"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.9d2a712511459265d5a9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To disable the maximum, set this value to `0`.",
      "headingPath": [
        "Configure Grafana Enterprise",
        "[caching.memory]",
        "max_size_mb"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md",
        "gitBlobSha": "51174e643296aefdf7f2a277d5fe604eeb1d2300",
