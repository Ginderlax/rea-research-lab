    },
    {
      "id": "grafana.candidate.d21b65ac2aee171cdd2f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Add an operator and value for a key to add it as a filter or select the **Group by** checkbox to set a group by dimension. You can use a key for both a filter and a group by.",
      "headingPath": [
        "Filter and group by controls",
        "Add filters and group by controls"
      ],
