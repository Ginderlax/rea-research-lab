    {
      "id": "grafana.candidate.8df8c2894a0e89a0b89a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Because the **Label** and **Label value** query types require a profile type, and **Label value** also requires a label, you can chain these variables so that each one depends on the previous selection.",
      "headingPath": [
        "Pyroscope template variables",
