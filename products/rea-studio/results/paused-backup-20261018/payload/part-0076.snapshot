    {
      "id": "grafana.candidate.01411364ac2bc5ef5d1b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Setting the database for this data source **does not deny access to other databases**. The InfluxDB query syntax allows switching the database in the query. For example: `SHOW MEASUREMENTS ON _internal` or `SELECT * FROM \"_internal\"..\"database\" LIMIT 10`",
      "headingPath": [
        "Configure the InfluxDB data source",
        "Configuration options",
        "Database settings"
