    {
      "id": "grafana.candidate.b045b2210b5d4d9b805e",
      "syntaxRole": "list-item",
      "sourceText": "- If you manually wrap a variable in quotes (for example, `WHERE name = '$myvar'`) and Grafana also applies its own quoting, the value gets double-quoted (for example, `''30''` instead of `'30'`). This intentional quoting behavior was restored in Grafana 11.3.",
      "headingPath": [
        "MySQL template variables",
        "Use variables in queries",
        "Use explicit quoting for string variables"
      ],
      "source": {
        "path": "docs/sources/datasources/mysql/template-variables/index.md",
        "gitBlobSha": "8b4e9af927fd60ebb0f752a26f1b5318eb25a81f",
        "sha256": "782e0b5075e4a5b068515118097fb27d9b7924eba557b77b504f55d9b64978c9",
        "lineStart": 137,
        "lineEnd": 137,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/mysql/template-variables/index.md#L137-L137"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
