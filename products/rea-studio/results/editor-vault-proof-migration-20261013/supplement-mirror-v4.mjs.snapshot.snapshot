import assert from 'node:assert/strict';import {readFileSync,writeFileSync,readdirSync,lstatSync,mkdirSync,existsSync,linkSync} from 'node:fs';import {resolve,dirname} from 'node:path';import {createHash} from 'node:crypto';
const stage=import.meta.dirname,root=resolve(stage,'../../outputs/rea-research-lab'),mirror=resolve(stage,'private-proof-layout-v3'),label=process.argv[2];assert(label&&/^[a-z0-9-]+$/.test(label));const records=[],sha=b=>createHash('sha256').update(b).digest('hex');let bytes=0;
function put(p){if(existsSync(resolve(mirror,p)))return;const source=resolve(root,p),stat=lstatSync(source);assert(stat.isFile()&&!stat.isSymbolicLink()&&stat.size<=32*1024*1024);assert(records.length<1200&&bytes+stat.size<=64*1024*1024);const b=readFileSync(source);mkdirSync(dirname(resolve(mirror,p)),{recursive:true});linkSync(source,resolve(mirror,p));records.push({path:p,bytes:b.length,sha256:sha(b)});bytes+=b.length;}
function visit(p){for(const d of readdirSync(resolve(root,p),{withFileTypes:true})){assert(!d.isSymbolicLink());const n=p+'/'+d.name;if(d.isDirectory())visit(n);else put(n);}}
for(const n of readdirSync(resolve(root,'products/rea-studio'),{withFileTypes:true}))if(n.isFile())put('products/rea-studio/'+n.name);
visit('products/rea-studio/tests');
for(const name of ['verify-notes-inline-followups.mjs','verify-notes-vault-followups.mjs']){const text=readFileSync(resolve(stage,'candidate/scripts',name),'utf8');for(const m of text.matchAll(/['"](products\/rea-studio\/results\/[^'"]+)['"]/g)){const p=m[1].replace(/\/$/,'');if(existsSync(resolve(root,p))){if(lstatSync(resolve(root,p)).isDirectory())visit(p);else put(p);}}}
const capsule='products/rea-studio/results/notes-layout-value-api-combined-20261013',m=JSON.parse(readFileSync(resolve(root,capsule,'preservation-manifest.json'))),before=m.snapshots.find(r=>r.sourcePath==='source-before.json.snapshot');assert(before);const old720=JSON.parse(readFileSync(resolve(root,capsule,before.path)));assert.equal(old720.length,720);for(const r of old720)put('products/rea-studio/'+r.path);
writeFileSync(resolve(stage,'mirror-supplement-'+label+'.json'),JSON.stringify({sourceOnly:true,at:new Date().toISOString(),newFiles:records.length,bytes,records,bounds:{files:1200,bytes:64*1024*1024,perFile:32*1024*1024},noExistingFilesModified:true,appExecutions:0},null,2)+'\n');console.log(JSON.stringify({sourceOnly:true,newFiles:records.length,bytes}));
