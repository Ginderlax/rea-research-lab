    {
      "id": "grafana.candidate.235327a0ad2f9779d2ff",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To convert and import them into a Grafana instance, you can use the `mimirtool rules load` command:",
      "headingPath": [
        "Import data source-managed rules to Grafana-managed rules",
        "Import rules with command-line tools",
