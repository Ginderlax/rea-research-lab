 syntax and existing record consistency; this does not rerun the original behavioral experiments or development tests."}
"""Independent selected backup byte audit only; executes no candidate/product."""
import gzip
import hashlib
import io
import json
import re
import zipfile
from pathlib import Path

work = Path(__file__).resolve().parent
stage = work / 'cloud-archive-installed-corrected-bounds-success-20261016-next'
candidate = stage / 'public-candidate'
sha = lambda b: hashlib.sha256(b).hexdigest()
pin = lambda b: {'bytes': len(b), 'sha256': sha(b)}
authority_bytes = (stage / 'copy-authority.json').read_bytes()
assert pin(authority_bytes) == {'bytes': 30804, 'sha256': '788e313580257c034cb7c68120890061e7f3e651f6f71ed6f19b300c73b3383a'}
authority = json.loads(authority_bytes)
assert authority['files'] == len(authority['rows']) == 81
assert authority['sourceCommit'] == '016ecd175c0700d1a94d5219af6719989a4a6e45'
seen = set()
for row in authority['rows']:
    assert row['before'] is None and row['path'] not in seen
    seen.add(row['path'])
    assert pin((candidate / row['path']).read_bytes()) == row['after']
actual_paths = {str(p.relative_to(candidate)).replace('\\', '/') for p in candidate.rglob('*') if p.is_file()}
assert actual_paths == seen
capsules = []
for descriptor in authority['capsules']:
    prefix = candidate / descriptor['prefix']
    manifest_bytes = (prefix / 'preservation-manifest.json').read_bytes()
    assert pin(manifest_bytes) == descriptor['manifest']
    manifest = json.loads(manifest_bytes)
    assert manifest['sourceCommit'] == authority['sourceCommit'] and manifest['historicalReceiptsRebound'] is False
    assert manifest['fullParity'] is False and manifest['superiority'] is False and manifest['countsAggregatedAcrossJobs'] is False
    roles = {}
    gzip_roles = 0
    for row in manifest['records']:
        assert row['sourcePath'] not in roles
        stored = (prefix / row['path']).read_bytes()
        assert pin(stored) == {k: row['storage'][k] for k in ('bytes', 'sha256')}
        if row['storage']['encoding'] == 'gzip':
            with gzip.GzipFile(fileobj=io.BytesIO(stored)) as stream:
                decoded = stream.read(8 * 1024 * 1024 + 1)
                assert len(decoded) <= 8 * 1024 * 1024 and stream.read(1) == b''
            gzip_roles += 1
        else:
            assert row['storage']['encoding'] == 'identity'
            decoded = stored
        assert pin(decoded) == {k: row[k] for k in ('bytes', 'sha256')}
        roles[row['sourcePath']] = decoded
    raw_zip = roles['portable-artifact/complete-github-artifact.zip']
    assert sha(raw_zip) == manifest['artifactSHA256'] and len(raw_zip) == manifest['artifactArchiveBytes']
    verified = json.loads(roles['local/local-installed-archive-backup-verification.json'])
    expected = {row['path']: {k: row[k] for k in ('bytes', 'sha256')} for row in verified['files']}
    with zipfile.ZipFile(io.BytesIO(raw_zip)) as outer:
        assert len(outer.infolist()) == 1
        nested = outer.read(outer.infolist()[0])
    native_program_headers, native_program_names, recovered = [], [], {}
    with zipfile.ZipFile(io.BytesIO(nested)) as inner:
        for item in inner.infolist():
            if item.is_dir():
                continue
            value = inner.read(item)  # Independent full CRC/readability check.
            recovered[item.filename] = pin(value)
            if value.startswith((b'MZ', b'\x7fELF')):
                native_program_headers.append(item.filename)
            if re.search(r'\.(exe|dll|pdb)$', item.filename, re.I):
                native_program_names.append(item.filename)
    assert recovered == expected and len(recovered) == manifest['localReadableFiles']
    assert native_program_headers == native_program_names == []
    direct = [key for key in roles if key.startswith('artifact/')]
    assert len(direct) == manifest['retainedArtifactFiles']
    for key in direct:
        assert pin(roles[key]) == recovered[key.removeprefix('artifact/')]
    raw_api = {key: json.loads(value) for key, value in roles.items() if key.startswith('control-plane/')}
    assert raw_api['control-plane/run.json']['head_sha'] == authority['sourceCommit']
    assert raw_api['control-plane/run.json']['id'] == 38911241646 and raw_api['control-plane/run.json']['run_attempt'] == 1
    assert raw_api['control-plane/run.json']['status'] == 'completed' and raw_api['control-plane/run.json']['conclusion'] == 'success'
    assert len(raw_api['control-plane/jobs.json']['jobs']) == 2
    capsules.append({'role': descriptor['role'], 'manifest': pin(manifest_bytes), 'decodedRoles': len(roles),
        'gzipRoleReadbacks': gzip_roles, 'allInnerFilesCRCAndHashMatched': len(recovered),
        'directArtifactRolesByteMatched': len(direct), 'vendorNativeProgramHeaders': native_program_headers,
        'vendorNativeProgramNames': native_program_names, 'countsAggregated': False})
source_files = []
for name in ('unpack-installed-archive-run-38911241646.py', 'collect-installed-archive-38911241646.mjs',
             'verify-installed-archive-native-run-38911241646.py', 'preserve-installed-archive-corrected-bounds-success-20261016.mjs'):
    source_files.append({'path': 'work/' + name, **pin((work / name).read_bytes()), 'completeSourceRead': True})
result = {'schema': 'rea-independent-installed-Archive-success-capsule-review/v1', 'reviewer': '/root/notes_review_1245',
    'authority': {'path': 'work/cloud-archive-installed-corrected-bounds-success-20261016-next/copy-authority.json', **pin(authority_bytes)},
    'decision': 'No blocker found in complete source review and independent portable byte readback for this exact two-scope capsule.',
    'sourceFilesRead': source_files, 'candidateFilesHashMatched': 81, 'candidateBytes': authority['bytes'],
    'capsules': capsules, 'totalDecodedRoles': sum(c['decodedRoles'] for c in capsules),
    'totalInnerFilesCRCAndHashMatched': sum(c['allInnerFilesCRCAndHashMatched'] for c in capsules),
    'finite161AndOverlappingTargeted3SeparatelyQualified': True,
    'reviewScope': 'Source review and selected actual raw metadata/full ZIP/gzip byte recoverability only; no candidate/product/test/browser execution.',
    'recordedAcceptance': 'Finite161 on corrected committed sources; separately repeated3 overlap those161. Separate actual browser6; no cross-job aggregation.',
    'limits': ['Backup review does not execute or establish new behavior.', 'Encrypted7Z contents are not decrypted locally.',
