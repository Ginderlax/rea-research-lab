    {
      "id": "grafana.candidate.ffaea9c556c17b00a8de",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you're migrating from InfluxDB 1.x or 2.x to InfluxDB 3.x, InfluxData recommends adopting SQL as your query language. Refer to InfluxData's [migration guide](https://docs.influxdata.com/influxdb3/cloud-serverless/guides/migrate-data/) for help transitioning your data and queries.",
      "headingPath": [
        "Configure the InfluxDB data source",
        "Before you begin"
      ],
      "source": {
