    {
      "id": "grafana.candidate.a3c6c5a5a71b850e9b25",
      "syntaxRole": "list-item",
      "sourceText": "- **Safe strong typing:** Everything in the SDK is strongly typed. This gives you autocompletion in your IDE, catches mistakes early, and helps ensure you're always using valid configuration values.",
      "headingPath": [
        "Get started with the Grafana Foundation SDK",
        "Grafana Foundation SDK overview"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/foundation-sdk/_index.md",
