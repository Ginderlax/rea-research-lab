    {
      "id": "grafana.candidate.c4f84ef120d3d859fd86",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In Strict mode the input series is processed as is. If any values in the series are non-numeric (null, NaN or +\\-Inf), NaN is returned.",
