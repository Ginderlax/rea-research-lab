replace('export function verifyFollowupRecords(root){',`export function verifyFollowupRecords(root){
 const notesInlineVerification=verifyNotesInlineFollowups(root),notesInlineResolver=notesInlineVerification.resolveHistorical;
 const checkpointPrefix='products/rea-studio/results/milestones/search-trash-recycle-save-3baecf4e-20261013',checkpointBytes=readFileSync(join(root,checkpointPrefix,'snapshot-manifest.json'));assert.equal(sha(checkpointBytes),'d969655ed6d1e73f925147c277261b38333e2d095b18a486f2c7c2a7700689ff');const historicalCheckpoint=JSON.parse(checkpointBytes);assert.equal(historicalCheckpoint.commit,'3baecf4e69fa731afbbb69efc1d4c8c88fdb0ec7');assert.equal(historicalCheckpoint.sourceSnapshots.length,709);assert.equal(historicalCheckpoint.metadataSnapshots.length,14);assert.equal(historicalCheckpoint.oldReceiptsRebound,false);const historicalRows=new Map([...historicalCheckpoint.sourceSnapshots,...historicalCheckpoint.metadataSnapshots].map(r=>[r.sourcePath,r]));assert.equal(historicalRows.size,723);assert.deepEqual(files(join(root,checkpointPrefix)).sort(),[...historicalCheckpoint.metadataSnapshots.map(r=>r.snapshotPath.slice(checkpointPrefix.length+1)),'snapshot-manifest.json'].sort());
 function historical3baBytes(destination,expected){safe(destination);const r=historicalRows.get(destination);assert.ok(r,'Missing immutable3ba record: '+destination);if(expected){assert.equal(r.bytes,expected.bytes);assert.equal(r.sha256,expected.sha256);}safe(r.snapshotPath);assert.ok(r.snapshotPath.startsWith(checkpointPrefix+'/')||r.snapshotPath.startsWith('products/rea-studio/results/search-trash-recycle-save-combined-20261013/source/'));const b=readFileSync(join(root,r.snapshotPath));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);return b;}
 const notesInstallPrefix='products/rea-studio/results/notes-inline-reviewed-production-installation-20261013',notesInstallBytes=readFileSync(join(root,notesInstallPrefix,'preservation-manifest.json'));assert.equal(sha(notesInstallBytes),'91dd415221faaa7f32909b5495a847a51d7fd4de1a08ee8df94d3b3906d5073e');const notesInstall=JSON.parse(notesInstallBytes);assert.equal(notesInstall.schema,'rea-notes-inline-reviewed-installation-public-preservation/v1');assert.equal(notesInstall.copies.length,109);assert.equal(notesInstall.corePublicAliases,868);assert.equal(notesInstall.installedFiles,8);assert.equal(notesInstall.originalReceiptsRebound,false);const notesInstallPaths=new Set();for(const r of notesInstall.copies){safe(r.path);assert.ok(r.path.endsWith('.snapshot'));assert.ok(!notesInstallPaths.has(r.path));notesInstallPaths.add(r.path);const b=readFileSync(join(root,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);}assert.deepEqual(files(join(root,notesInstallPrefix)).sort(),[...notesInstall.copies.filter(r=>r.path.startsWith(notesInstallPrefix+'/')).map(r=>r.path.slice(notesInstallPrefix.length+1)),'preservation-manifest.json'].sort());
 const notesRootApproval=JSON.parse(readFileSync(join(root,notesInstallPrefix,'root-installation/frozen/installation-approval.json.snapshot')));assert.equal(notesRootApproval.acceptance,true);assert.equal(notesRootApproval.independentReviewsRemainUnmodified,true);const notesRootInstallation=JSON.parse(readFileSync(join(root,notesInstallPrefix,'root-installation/frozen/installation.json.snapshot')));assert.equal(notesRootInstallation.installed.length,8);assert.equal(notesRootInstallation.copies.length,836);assert.equal(notesRootInstallation.unchangedHistoricalInstalledPaths,28);assert.equal(notesRootInstallation.oldHistorical34ReceiptRebound,false);assert.equal(notesRootInstallation.allInputSourcesStableBeforeAfter,true);assert.equal(notesRootInstallation.installedBehaviorTestsExecuted+notesRootInstallation.originalHelpersExecuted+notesRootInstallation.browserExecutions,0);for(const r of notesRootInstallation.installed){const b=readFileSync(join(root,r.destination));assert.equal(b.length,r.after.bytes);assert.equal(sha(b),r.after.sha256);}
`);
replace("for(const r of installed.installed){safe(r.destination);const b=readFileSync(join(root,r.destination));assert.equal(b.length,r.after.bytes);assert.equal(sha(b),r.after.sha256);}","for(const r of installed.installed){safe(r.destination);const resolution=notesInlineResolver(r.destination,r.after);assert.ok(resolution);const b=readFileSync(join(root,resolution.historicalPath));assert.equal(b.length,r.after.bytes);assert.equal(sha(b),r.after.sha256);}");
replace("const current=readFileSync(join(root,'products/rea-studio',r.path));assert.equal(current.length,r.bytes);assert.equal(sha(current),r.sha256);","historical3baBytes('products/rea-studio/'+r.path,r);");
