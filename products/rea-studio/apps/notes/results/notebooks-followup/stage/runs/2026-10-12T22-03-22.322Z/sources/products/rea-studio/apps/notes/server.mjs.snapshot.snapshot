import { randomUUID, randomBytes, createHash } from 'node:crypto';
import { promises as fs } from 'node:fs';
import { decodeBase64, MAX_ARCHIVE, MAX_RESOURCE, digest, readJex, serializeRecord, writeTar, resourceName, isJoplinId } from './jex.mjs';
import {ensureOrganization,bindNotebook,organizationList,changeNotebook,checkOrganizationRevision} from './notebooks.mjs';

const stateKey = 'notes-state-v2', legacyPrefix = 'notes-note-';
let queue = Promise.resolve();
const uuid = () => randomBytes(16).toString('hex');
const stableId = text => createHash('sha256').update(text).digest('hex').slice(0, 32);
function validId(value) { if (typeof value !== 'string' || !(isJoplinId(value) || /^[a-f0-9-]{36}$/.test(value))) throw new Error('Choose a valid note ID.'); return value; }
function text(value, name, limit) { if (typeof value !== 'string' || value.length > limit || value.includes('\0')) throw new Error(`${name} must be text no longer than ${limit} characters.`); return value; }
function label(value, name, limit) { const result = text(value, name, limit); if (/[\r\n]/.test(result)) throw new Error(`${name} must stay on a single line so JEX export can preserve it.`); return result; }
function tags(value) { if (!Array.isArray(value) || value.length > 50) throw new Error('Use at most 50 tags.'); return [...new Set(value.map(item => label(item, 'Tag', 100).trim()).filter(Boolean))]; }
async function exclusive(operation) { const previous = queue; let release; queue = new Promise(resolve => { release = resolve; }); await previous; try { return await operation(); } finally { release(); } }
async function state(store) {
  const saved = await store.get(stateKey, null); if (saved) return ensureOrganization(structuredClone(saved));
  const notes = Object.create(null);
  for (const key of await store.list(legacyPrefix)) { const note = await store.get(key, null); if (note) notes[note.id] = note; }
  return ensureOrganization({ schema: 2, notes: { ...notes }, records: {}, resources: {} });
}
function get(s, id) { const note = s.notes[validId(id)]; if (!note) throw new Error('Note does not exist.'); return note; }
function checkRevision(note, value) { if (!Number.isInteger(value) || value !== note.revision) throw new Error('Note changed since it was opened. Reopen it before saving; your draft is preserved.'); }
function summary(note, query = '') { const at = query ? note.body.toLowerCase().indexOf(query.toLowerCase()) : 0, start = Math.max(0, at - 40); const { body, history, joplin, ...rest } = note; return { ...rest, preview: body.slice(start, start + 180), characters: body.length, historyCount: history.length }; }
function historical(note) { const { revision, title, body, tags, notebook, notebookId, updatedAt } = note; return { revision, title, body, tags, notebook, notebookId, updatedAt }; }
function edited(note, changes) { const time=new Date().toISOString();return { ...note, ...changes, metadataEdited:true, updatedAt:time,userUpdatedAt:time, revision: note.revision + 1, history: [...note.history, historical(note)].slice(-20) }; }
function folderPath(records, id) { if (!id) return 'Imported'; const r = records[id]; return r.props.parent_id ? folderPath(records, r.props.parent_id) + ' / ' + r.title : r.title; }
function iso(value) { return value || '1970-01-01T00:00:00.000Z'; }
function exportId(note) { return note.joplin?.props.id ?? note.id.replaceAll('-', ''); }
function newRecord(type, id, title, time) { return { type, ...(type === 6 ? {} : { title }), props: { id, created_time: time, updated_time: time, user_created_time: time, user_updated_time: time, encryption_cipher_text: '', encryption_applied: '0', type_: String(type) } }; }
function noteResources(s, note) { const ids = new Set([...note.body.matchAll(/:\/([a-f0-9]{32})(?![a-f0-9])/gi)].map(match => match[1].toLowerCase())); return [...ids].filter(id => s.resources[id]).map(id => { const r = s.records[id]; return { id, title: r.title, filename: r.props.filename || r.title || id, mime: r.props.mime, bytes: s.resources[id].bytes, sha256: s.resources[id].sha256 }; }); }
function binaryPath(workspace, resource) { if (!workspace?.resolve) throw new Error('This action requires the confined note workspace.'); return workspace.resolve(`attachments/${resource.id}-${resource.sha256}.bin`); }
async function resourceBytes(workspace, resource) { const bytes = await fs.readFile(binaryPath(workspace, resource)); if (bytes.length !== resource.bytes || digest(bytes) !== resource.sha256) throw new Error('Attachment integrity check failed; refusing damaged export/download.'); return bytes; }
async function writeResources(workspace, resources) {
  if (!resources.length) return [];
  if (!workspace?.resolve) throw new Error('This action requires the confined note workspace.');
  await fs.mkdir(workspace.resolve('attachments'), { recursive: true }); const created = [];
  try {
    for (const r of resources) {
      const filename = binaryPath(workspace, r);
      try { await fs.writeFile(filename, r.data, { flag: 'wx', mode: 0o600 }); created.push(filename); }
      catch (error) { if (error.code !== 'EEXIST') throw error; const existing = await fs.readFile(filename); if (digest(existing) !== r.sha256) throw new Error('Existing attachment bytes conflict.'); }
    }
    return created;
  } catch (error) { for (const file of created) await fs.unlink(file).catch(() => {}); throw error; }
}
async function commitWithResources(store, workspace, s, resources) {
  const created = await writeResources(workspace, resources);
  try { await store.set(stateKey, s); } catch (error) { for (const file of created) await fs.unlink(file).catch(() => {}); throw error; }
}

export async function handle({ action, input = {}, store, workspace }) {
  if (action === 'list') {
    const s = await state(store), search = text(input.search ?? '', 'Search', 500).trim().toLowerCase(), tokens = search.split(/\s+/).filter(Boolean), notes = Object.values(s.notes);
    const visible = notes.filter(note => Boolean(note.deletedAt) === Boolean(input.trash) && (!input.notebook || note.notebook === input.notebook) && (!input.notebookId || note.notebookId === input.notebookId) && (!input.tag || note.tags.includes(input.tag)) && tokens.every(token => `${note.title}\n${note.body}\n${note.tags.join(' ')}\n${note.notebook}`.toLowerCase().includes(token))).sort((a, b) => b.updatedAt.localeCompare(a.updatedAt));
    return { notes: visible.map(note => summary(note, tokens[0])), tags: [...new Set(notes.filter(note => !note.deletedAt).flatMap(note => note.tags))].sort(), notebooks: [...new Set(notes.filter(note => !note.deletedAt).map(note => note.notebook))].sort(), total: visible.length };
  }
  if(action==='notebook-list')return organizationList(await state(store));
  if(['notebook-create','notebook-rename','notebook-move'].includes(action))return exclusive(async()=>{const s=await state(store),title=action==='notebook-move'?undefined:label(input.title,'Notebook title',200).trim();if(action!=='notebook-move'&&!title)throw new Error('Give the notebook a title.');const result=changeNotebook(s,{...input,title,action},new Date().toISOString());await store.set(stateKey,s);return result;});
  if(action==='note-move')return exclusive(async()=>{const s=await state(store),note=get(s,input.id);checkRevision(note,input.revision);checkOrganizationRevision(s,input.organizationRevision);if(note.deletedAt)throw new Error('Restore this note before moving it.');if(typeof input.notebookId!=='string')throw new Error('Choose a valid notebook ID.');const selected=bindNotebook(s,note,{notebookId:input.notebookId}),now=new Date().toISOString(),updated={...selected,revision:note.revision+1,updatedAt:now,userUpdatedAt:note.userUpdatedAt??note.updatedAt,history:[...note.history,historical(note)].slice(-20)};if(updated.joplin)updated.joplin={...updated.joplin,props:{...updated.joplin.props,parent_id:updated.notebookId,updated_time:now,is_conflict:'0',conflict_original_id:'',deleted_time:'0'}};s.notes[note.id]=updated;s.organization.revision++;await store.set(stateKey,s);return{note:updated,...organizationList(s)};});
  if (action === 'get') return get(await state(store), input.id);
  if (action === 'link-target') {
    if (!isJoplinId(input.id)) throw new Error('Internal links need an exact 32-hex Joplin ID.');
    const s = await state(store), note = Object.values(s.notes).find(item => exportId(item) === input.id);
    if (note) return { kind: 'note', note };
    if (s.resources[input.id]) {
      if (!input.noteId) throw new Error('Save the source note before downloading an internal attachment link.');
      const source = get(s, input.noteId), resource = noteResources(s, source).find(item => item.id === input.id);
      if (!resource) throw new Error('This attachment is not linked by the saved source note. Save the draft containing the link first.');
      return { kind: 'resource', id: resource.id, noteId: source.id, filename: resource.filename };
    }
    if (s.records[input.id]) throw new Error('This internal item type is unsupported. Only local notes and attachments can be opened.');
    throw new Error('The linked note or attachment does not exist in this local collection.');
  }
  if (action === 'save') return exclusive(async () => {
    const s = await state(store), existing = input.id ? get(s, input.id) : null;
    if (existing) { if (existing.deletedAt) throw new Error('Restore this note before editing.'); checkRevision(existing, input.revision); }
    else if (input.revision !== undefined && input.revision !== 0) throw new Error('New notes start at revision zero.');
    const inputTitle = text(input.title, 'Title', 300), title = existing?.title === inputTitle ? inputTitle : label(inputTitle, 'Title', 300).trim(); if (!title && !existing) throw new Error('Give the note a title.');
    const inputNotebook = text(input.notebook ?? 'Notes', 'Notebook', 200), notebook = existing?.notebook === inputNotebook ? inputNotebook : label(inputNotebook, 'Notebook', 200).trim() || 'Notes';
    const cleanTags = existing && JSON.stringify(input.tags) === JSON.stringify(existing.tags) ? existing.tags : tags(input.tags ?? []);
    const changes = { title, body: text(input.body ?? '', 'Note', 200_000), notebook, tags: cleanTags }, now = new Date().toISOString();
    const draft = existing ? edited(existing, changes) : { id: randomUUID(), ...changes, createdAt: now, updatedAt: now, revision: 1, deletedAt: null, history: [] };
    const selection={...input,notebook};if(existing&&input.notebook!==undefined&&input.notebookId===existing.notebookId&&input.notebook!==existing.notebook)delete selection.notebookId;
    const note=bindNotebook(s,draft,selection);
    s.notes[note.id] = note; await store.set(stateKey, s); return note;
  });
  if (action === 'delete' || action === 'restore') return exclusive(async () => {
    const s = await state(store), note = get(s, input.id); checkRevision(note, input.revision);
    const time=new Date().toISOString(),updated = { ...note, metadataEdited:true,userUpdatedAt:time, deletedAt: action === 'delete' ? time : null, updatedAt:time, revision: note.revision + 1 };
    s.notes[note.id] = updated; await store.set(stateKey, s); return updated;
  });
  if (action === 'history-restore') return exclusive(async () => {
    const s = await state(store), note = get(s, input.id); checkRevision(note, input.revision); if (note.deletedAt) throw new Error('Restore this note before restoring a version.');
    const version = note.history.find(item => item.revision === input.historyRevision); if (!version) throw new Error('Historical version does not exist.');
    const draft=edited(note,{title:version.title,body:version.body,tags:version.tags,notebook:version.notebook});const updated=bindNotebook(s,draft,{notebook:version.notebook,...(version.notebookId!==undefined?{notebookId:version.notebookId}:{})});s.notes[note.id]=updated;await store.set(stateKey,s);return updated;
  });
  if (action === 'export') {
    const s = await state(store);
    if (input.id) { const note = get(s, input.id); return { filename: `${note.title.replace(/[^a-z0-9_-]+/gi, '-').slice(0, 80) || 'note'}.md`, mime: 'text/markdown;charset=utf-8', content: `# ${note.title}\n\n${note.body}\n` }; }
    return { filename: 'rea-notes.json', mime: 'application/json', content: JSON.stringify({ schema: 'rea-notes/v1', exportedAt: new Date().toISOString(), notes: Object.values(s.notes).filter(note => input.includeTrash || !note.deletedAt) }, null, 2), warning: 'Legacy JSON export excludes resource binaries and is not a complete backup. Use JEX for attachments and Joplin metadata.' };
  }
  if (action === 'import-markdown') return handle({ action: 'save', input: { title: input.title, body: text(input.content, 'Markdown', 200_000), notebook: input.notebook ?? 'Imported', tags: input.tags ?? [] }, store, workspace });
  if (action === 'import-bundle') return exclusive(async () => {
    if (typeof input.content !== 'string' || input.content.length > 5_000_000) throw new Error('Bundle must be JSON text no larger than 5 million characters.');
    let bundle; try { bundle = JSON.parse(input.content); } catch { throw new Error('Bundle is not valid JSON.'); }
    if (bundle?.schema !== 'rea-notes/v1' || !Array.isArray(bundle.notes) || bundle.notes.length > 1000) throw new Error('Expected a rea-notes/v1 bundle with at most 1,000 notes.');
    const now = new Date().toISOString(), s = await state(store);
    const notes = bundle.notes.map(source => {
      if (!source || typeof source !== 'object') throw new Error('Each imported note must be an object.');
      if (source.joplin || /:\/[a-f0-9]{32}/i.test(source.body ?? '')) throw new Error('JSON cannot preserve Joplin metadata or resource links. Import a complete JEX instead.');
      const title = label(source.title, 'Title', 300).trim(); if (!title) throw new Error('Imported notes need titles.');
      return { id: randomUUID(), title, body: text(source.body ?? '', 'Body', 200_000), notebook: label(source.notebook ?? 'Imported', 'Notebook', 200).trim() || 'Imported', tags: tags(source.tags ?? []), createdAt: now, updatedAt: now, revision: 1, deletedAt: null, history: [] };
    });
    for (const note of notes) s.notes[note.id] = note; ensureOrganization(s);await store.set(stateKey, s); return { imported: notes.length, ids: notes.map(note => note.id) };
  });
  if (action === 'jex-import') return exclusive(async () => {
    const imported = readJex(decodeBase64(input.base64, MAX_ARCHIVE, 'JEX archive')), s = await state(store);
    const existingIds = new Set([...Object.keys(s.records), ...Object.values(s.notes).map(exportId)]);
    for (const id of imported.records.keys()) if (existingIds.has(id)) throw new Error(`JEX ID collision: ${id}. Existing items are never overwritten or silently remapped.`);
    const merged = { ...s.records, ...Object.fromEntries(imported.records) }, added = [];
    for (const [id, r] of imported.records) if (r.type === 1) {
      const cleanTags = [...new Set([...imported.records.values()].filter(tag => tag.type === 6 && tag.props.note_id === id).map(tag => imported.records.get(tag.props.tag_id).title))];
      if (cleanTags.length > 50 || cleanTags.some(tag => tag.length > 100)) throw new Error('Imported note exceeds the supported tag limits.');
      const notebook = folderPath(merged, r.props.parent_id); if (notebook.length > 200) throw new Error('Notebook display path exceeds 200 characters.');
      const deleted = Number(r.props.deleted_time || 0); if (!Number.isSafeInteger(deleted) || deleted < 0 || deleted > 8.64e15) throw new Error('Invalid deleted timestamp.');
      s.notes[id] = { id, title: r.title, body: r.body, notebook, tags: cleanTags, createdAt: iso(r.props.created_time), updatedAt: iso(r.props.updated_time), revision: 1, deletedAt: deleted ? new Date(deleted).toISOString() : null, history: [], joplin: { ...r, originalNotebook: notebook } }; added.push(id);
    }
    s.records = merged;ensureOrganization(s);s.organization.revision++;
    const resources = [...imported.resources].map(([id, r]) => ({ id, sha256: r.sha256, bytes: r.bytes.length, data: r.bytes, name: r.name }));
    for (const r of resources) { const { data, ...metadata } = r; s.resources[r.id] = metadata; }
    await commitWithResources(store, workspace, s, resources);
    return { imported: added.length, ids: added, notebooks: [...imported.records.values()].filter(r => r.type === 2).length, tags: [...imported.records.values()].filter(r => r.type === 5).length, attachments: resources.length, identityPolicy: 'preserved', historyImported: false };
  });
  if (action === 'attachment-list') { const s = await state(store); return { attachments: noteResources(s, get(s, input.id)) }; }
  if (action === 'attachment-get') {
    const s = await state(store), note = get(s, input.noteId), resource = noteResources(s, note).find(r => r.id === input.id); if (!resource) throw new Error('Attachment is not referenced by this note.');
    const bytes = await resourceBytes(workspace, s.resources[resource.id]); return { ...resource, base64: bytes.toString('base64'), filename: resource.filename, mime: resource.mime || 'application/octet-stream' };
  }
  if (action === 'attachment-add') return exclusive(async () => {
    const s = await state(store), note = get(s, input.id); checkRevision(note, input.revision); if (note.deletedAt) throw new Error('Restore this note before attaching files.');
    const filename = text(input.filename, 'Filename', 255); if (!filename || /[\x00-\x1f\x7f/\\]/.test(filename)) throw new Error('Attachment needs a safe filename.');
    const mime = text(input.mime || 'application/octet-stream', 'MIME type', 100); if (!/^[a-z0-9.+-]+\/[a-z0-9.+-]+$/i.test(mime)) throw new Error('Invalid MIME type.');
    const bytes = decodeBase64(input.base64, MAX_RESOURCE, 'Attachment'), id = uuid(), now = new Date().toISOString(), extension = /\.([A-Za-z0-9_-]{1,20})$/.exec(filename)?.[1] ?? '';
    const r = newRecord(4, id, filename, now); Object.assign(r.props, { mime, filename, file_extension: extension, size: String(bytes.length), encryption_blob_encrypted: '0' });
    const resource = { id, sha256: digest(bytes), bytes: bytes.length, name: resourceName(r) }, label = filename.replaceAll('\\', '\\\\').replaceAll('[', '\\[').replaceAll(']', '\\]');
    const body = text(note.body + `\n\n[${label}](:/${id})`, 'Note', 200_000), updated = edited(note, { body }); s.records[id] = r; s.resources[id] = resource; s.notes[note.id] = updated;
    await commitWithResources(store, workspace, s, [{ ...resource, data: bytes }]); return { note: updated, attachment: noteResources(s, updated).find(item => item.id === id) };
  });
  if (action === 'jex-export') {
    const s = await state(store), records = new Map(Object.entries(s.records).filter(([, r]) => r.type !== 1 && r.type !== 6)), time = new Date().toISOString(), active = Object.values(s.notes).filter(note => input.includeTrash || !note.deletedAt);
    const insert = r => { const previous = records.get(r.props.id); if (previous && JSON.stringify(previous) !== JSON.stringify(r)) throw new Error('Generated metadata ID collision.'); records.set(r.props.id, r); return r.props.id; };
    for (const note of active) {
      const id = exportId(note); let parentId = note.notebookId;
      if (parentId===undefined) {
        parentId = stableId('REA notebook:' + note.notebook); const folder = records.get(parentId);
        if (folder && (folder.type !== 2 || folder.title !== note.notebook)) throw new Error('Notebook ID collision.');
        if (!folder) { const folderRecord = newRecord(2, parentId, note.notebook, time); folderRecord.props.parent_id = ''; insert(folderRecord); }
      }
      const r = note.joplin ? structuredClone(note.joplin) : newRecord(1, id, note.title, note.createdAt); delete r.originalNotebook; r.title = note.title; r.body = note.body; r.props.parent_id = parentId;
      if (!note.joplin || note.metadataEdited) { r.props.updated_time = note.updatedAt; r.props.user_updated_time = note.userUpdatedAt??note.updatedAt; r.props.deleted_time = String(note.deletedAt ? Date.parse(note.deletedAt) : 0); }
      if (!note.joplin) Object.assign(r.props, { is_todo: '0', is_conflict: '0', todo_due: '0', todo_completed: '0', latitude: '0.00000000', longitude: '0.00000000', altitude: '0.0000', author: '', source_url: '', markup_language: '1' });
      if (records.has(id)) throw new Error('Note identity collides with another item.'); records.set(id, r);
      for (const tagTitle of note.tags) {
        const originalLinks = Object.values(s.records).filter(link => link.type === 6 && link.props.note_id === id && s.records[link.props.tag_id]?.title === tagTitle);
        if (originalLinks.length) { for (const link of originalLinks) insert(link); continue; }
        const matches = [...records.values()].filter(tag => tag.type === 5 && tag.title === tagTitle); if (matches.length > 1) throw new Error('Ambiguous tag identity; refusing silent tag merging.');
        const tagId = matches[0]?.props.id ?? stableId('REA tag:' + tagTitle); if (!matches.length) insert(newRecord(5, tagId, tagTitle, time));
        const relation = newRecord(6, stableId('REA relation:' + id + ':' + tagId), undefined, time); Object.assign(relation.props, { note_id: id, tag_id: tagId }); insert(relation);
      }
    }
    const files = new Map(); for (const [id, r] of records) files.set(id + '.md', serializeRecord(r));
    for (const [id, metadata] of Object.entries(s.resources)) { if (!records.has(id)) throw new Error('Resource metadata is missing.'); files.set(resourceName(records.get(id)), await resourceBytes(workspace, metadata)); }
    const archive = writeTar(files); readJex(archive);
    return { filename: 'rea-notes.jex', mime: 'application/x-tar', base64: archive.toString('base64'), bytes: archive.length, sha256: digest(archive), notes: active.length, records: records.size, attachments: Object.keys(s.resources).length, warning: 'JEX preserves supported current items and metadata. Local saved-version history is not part of Joplin JEX.' };
  }
  throw new Error(`Unknown notes action: ${action}`);
}
