    {
      "id": "grafana.candidate.dcd7eb7f181526cee13a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This example shows how to define an alert rule that detects when operations handled by a service become slow.",
      "headingPath": [
        "Examples of trace-based alerts",
        "Alerting on span metrics",
        "Detect slow span operations"
