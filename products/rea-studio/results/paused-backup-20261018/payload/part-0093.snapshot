import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { readFileSync, writeFileSync, mkdirSync, existsSync } from 'node:fs';
import { join, posix } from 'node:path';
import { spawnSync } from 'node:child_process';
const root='C:/Users/evanh/Documents/Codex/2026-10-12/go/outputs/rea-research-lab', product='products/rea-studio/';
const destination=product+'results/milestones/native-core-20261012/';
const revision='50155ea79ca43fd38842619e9acab7c0ea1976b0';
const sha=bytes=>createHash('sha256').update(bytes).digest('hex');
const read=path=>JSON.parse(readFileSync(join(root,path),'utf8'));
assert.equal(spawnSync('git',['rev-parse','HEAD'],{cwd:root,encoding:'utf8'}).stdout.trim(),revision);
assert.ok(!existsSync(join(root,destination,'snapshot-manifest.json')),'Native core snapshot already exists; do not replace it.');
const paths=[
 product+'results/development-validation.json',product+'results/browser-native-core-verification.json',
 product+'apps/flow/results/native-original-comparison.json',product+'apps/metrics/results/native-calculations-verification.json',
 product+'apps/backup/native-validation.json',product+'apps/archive/zstd-validation.json',product+'NATIVE-CORE-MILESTONE.md'
];
const sources=new Map();
const add=entry=>{ const path=posix.normalize(entry.path); assert.ok(!path.startsWith('../')&&!path.startsWith('/')); const bytes=readFileSync(join(root,path)); assert.equal(sha(bytes),entry.sha256,`Before-mutation source mismatch: ${path}`); if(sources.has(path))assert.equal(sources.get(path).sha256,entry.sha256); sources.set(path,{path,sha256:entry.sha256,bytes:bytes.length}); };
for(const entry of read(paths[0]).source_files)add({...entry,path:product+entry.path});
const browser=read(paths[1]); for(const entry of [...browser.implementation_fingerprints,...browser.screenshots])add(entry);
for(const[path,sha256]of Object.entries(read(paths[2]).implementationSha256))add({path:product+'apps/flow/'+path,sha256});
const metrics=read(paths[3]); add({path:product+'apps/metrics/'+metrics.implementationFile,sha256:metrics.implementationSha256});
for(const[path,sha256]of Object.entries(read(paths[4]).frozenHashes))add({path:product+'apps/backup/'+path,sha256});
for(const entry of read(paths[5]).implementation_and_fixture_fingerprints)add(entry);
const snapshot=(path,subfolder)=>{ const bytes=readFileSync(join(root,path)),relative=path.slice(product.length); const snapshot_path=destination+subfolder+relative+(/\.md$/.test(path)?'.snapshot':''); mkdirSync(join(root,snapshot_path,'..'),{recursive:true}); writeFileSync(join(root,snapshot_path),bytes,{flag:'wx'});return{path,snapshot_path,bytes:bytes.length,sha256:sha(bytes)}; };
const receipts=paths.map(path=>snapshot(path,'receipts/'));
const source_snapshots=[...sources.keys()].sort().map(path=>snapshot(path,'source/'));
writeFileSync(join(root,destination,'snapshot-manifest.json'),JSON.stringify({schema:'rea-native-core-checkpoint-snapshot/v1',recorded_at:new Date().toISOString(),source_revision:revision,receipts,source_snapshots,scope:'Exact published checkpoint receipts and their implementation/proof bytes; historical tests stay attributed to this revision after future development.',full_feature_parity_established:false,universal_superiority_established:false},null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({revision,receipts:receipts.length,sources:source_snapshots.length}));
