$ErrorActionPreference='Stop'
$taskBase=Split-Path -Parent $MyInvocation.MyCommand.Path
$authorityPath=Join-Path $taskBase 'change-authority.json'
$oldAuthorityBytes=[IO.File]::ReadAllBytes($authorityPath)
$oldAuthoritySHA=(Get-FileHash -Algorithm SHA256 -LiteralPath $authorityPath).Hash.ToLower()
if($oldAuthoritySHA -ne '3b2f92b9553958b4c48e5b8712ae1128145c95bf8c14eb74c26a8da7daec09af'){throw 'Wrong frozen r3 authority'}
$authority=[Text.Encoding]::UTF8.GetString($oldAuthorityBytes)|ConvertFrom-Json
$publicBase=Join-Path $taskBase 'public-candidate'
$savedBase=Join-Path $taskBase 'versions/compatibility-r3'
if(Test-Path -LiteralPath $savedBase){throw 'Preserved r3 already exists'}
[IO.Directory]::CreateDirectory($savedBase)|Out-Null
foreach($row in $authority.files){
  $source=Join-Path $publicBase $row.path
  $sha=(Get-FileHash -Algorithm SHA256 -LiteralPath $source).Hash.ToLower()
  if((Get-Item -LiteralPath $source).Length -ne $row.after.bytes -or $sha -ne $row.after.sha256){throw ('Wrong preserved source '+$row.path)}
  $target=Join-Path (Join-Path $savedBase 'public-candidate') $row.path
  [IO.Directory]::CreateDirectory((Split-Path -Parent $target))|Out-Null
  if(Test-Path -LiteralPath $target){throw 'Cannot overwrite preserved source'}
  Copy-Item -LiteralPath $source -Destination $target
}
