    {
      "id": "grafana.candidate.db366e15299bf220de69",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Legend options control the series names and statistics that appear under or to the right of the graph. For more information about the legend, refer to [Configure a legend](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/panels-visualizations/configure-legend/).",
      "headingPath": [],
      "source": {
        "path": "docs/sources/shared/visualizations/legend-options-1.md",
        "gitBlobSha": "720bd14c9b69e169768c69fb210c93bc2241ca44",
