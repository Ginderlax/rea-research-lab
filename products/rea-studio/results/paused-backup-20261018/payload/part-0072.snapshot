// Backup-only filing of an actual terminal full-suite failure. No product/candidate import/test/build.
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import { createHash } from 'node:crypto';
import { gzipSync, gunzipSync } from 'node:zlib';
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab');
const run='38932318510',head='d24db80660e2af640882ad48c01174b27ffcda51',tested='5f23f782a7224aaacdce89edfe21eb7e3a565831';
const stage=path.join(work,'cloud-full1100-native-metadata-failure-public-20261016-next'),publicRoot=path.join(stage,'public-candidate'),prefix='products/rea-studio/results/cloud-full1100-native-metadata-failure-20261016',target=path.join(publicRoot,prefix),runRoot=path.join(work,'cloud-verification-backups/run-'+run);
const id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});
function safe(n){assert(typeof n==='string'&&n&&!/[\\:\x00-\x1f\x7f]/.test(n)&&!n.startsWith('/')&&n.split('/').every(p=>p&&p!=='.'&&p!=='..'));return n;}
function read(base,n){safe(n);let f=base;for(const part of n.split('/')){f=path.join(f,part);assert(!fs.lstatSync(f).isSymbolicLink());}const stat=fs.lstatSync(f);assert(stat.isFile()&&stat.size<=12*1024*1024);const b=fs.readFileSync(f);assert.equal(b.length,stat.size);return b;}
const collectionBytes=read(runRoot,'collection-summary.json'),collection=JSON.parse(collectionBytes);assert.equal(collection.runId,run);assert.equal(collection.headSHA,head);assert.equal(collection.runStatus,'completed');assert.equal(collection.runConclusion,'failure');assert.equal(collection.jobConclusion,'failure');assert.equal(collection.artifacts.length,1);
const job=collection.jobId,selectedArtifact=collection.artifacts[0],artifactId=String(selectedArtifact.artifactId),digest=selectedArtifact.sha256;assert(/^\d+$/.test(job)&&/^\d+$/.test(artifactId)&&/^[0-9a-f]{64}$/.test(digest));assert.equal(selectedArtifact.readabilityVerified,true);assert.equal(job,'117079121814');assert.equal(artifactId,'12060237203');assert.equal(digest,'ca987428cb9f3d9d0f0b7baa329f3259fff75e9ac03a61d047fab7ebb6c1c674');assert.equal(selectedArtifact.bytes,1727060);
const backup=path.join(runRoot,'artifact-'+artifactId),evidenceRoot=path.join(backup,'readable-evidence'),verificationBytes=read(backup,'local-backup-verification.json'),verification=JSON.parse(verificationBytes);
assert.equal(verification.schema,'rea-local-cloud-attempt-backup/v1');assert.equal(verification.artifactSHA256,digest);assert.equal(verification.allCRCAndBytesReadable,true);assert.equal(verification.files.length,431);
const zip=fs.readFileSync(backup+'.zip');assert.equal(id(zip).sha256,digest);assert.equal(zip.length,verification.archiveBytes);assert.equal(zip.length,selectedArtifact.bytes);
const files=new Map();for(const row of verification.files){safe(row.path);assert(!files.has(row.path));files.set(row.path,row);const stat=fs.lstatSync(path.join(evidenceRoot,row.path));assert(stat.isFile()&&!stat.isSymbolicLink()&&stat.size===row.bytes);}
function evidence(n){const b=read(evidenceRoot,n),row=files.get(n);assert(row);assert.deepEqual(id(b),{bytes:row.bytes,sha256:row.sha256});return b;}
const attempt=JSON.parse(evidence('attempt-validation.json'));assert.equal(attempt.schema,'rea-cloud-development-attempt/v1');assert.equal(attempt.scope,'full-oracle-experiment');assert.equal(attempt.status,'failed');assert.equal(attempt.phase,'terminal');assert.equal(attempt.repositoryCommit,tested);
assert.equal(attempt.summary.tests,1100);assert.equal(attempt.summary.pass,1098);assert.equal(attempt.summary.fail,2);for(const k of ['cancelled','skipped','todo'])assert.equal(attempt.summary[k],0);assert(Number.isFinite(attempt.summary.duration_ms)&&attempt.summary.duration_ms>0);
assert.deepEqual(attempt.failures,['test process exit code 1','Every selected check must pass']);assert.equal(attempt.failure,'test process exit code 1; Every selected check must pass');assert.equal(attempt.childCloseObserved,true);assert.equal(attempt.exitCode,1);assert.equal(attempt.signal,null);assert.equal(attempt.output.droppedOutputBytes,0);assert.equal(attempt.output.retainedOutputTruncated,false);
assert.equal(attempt.sourceFiles,798);assert.equal(attempt.sourceSnapshotFiles,374);assert.equal(attempt.sourceStable,true);assert.equal(attempt.sourceCapturedBeforeExecution,true);assert.equal(attempt.executionEnvironment,'github-hosted');assert.equal(attempt.runtime.version,'v24.16.0');assert.equal(attempt.runtime.platform,'win32');
for(const value of [attempt.environment]){assert.equal(value.GITHUB_RUN_ID,run);assert.equal(value.GITHUB_RUN_ATTEMPT,'1');assert.equal(value.GITHUB_SHA,tested);assert.equal(value.GITHUB_REPOSITORY,'Ginderlax/rea-research-lab');assert.equal(value.RUNNER_ENVIRONMENT,'github-hosted');assert.equal(value.RUNNER_OS,'Windows');}
assert.equal(attempt.environment.GITHUB_REF,'refs/pull/1/merge');assert.equal(attempt.historicalDevelopmentReceiptOverwritten,false);assert.equal(attempt.fullFeatureParityEstablished,false);assert.equal(attempt.universalSuperiorityEstablished,false);
const beforeBytes=evidence('source-before.json');assert.deepEqual(beforeBytes,evidence('source-after.json'));const before=JSON.parse(beforeBytes);assert.equal(before.length,798);assert.equal(new Set(before.map(r=>r.path)).size,798);
