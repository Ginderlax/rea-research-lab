import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';
const own=path.dirname(fileURLToPath(import.meta.url)),stage=path.resolve(own,'../keepass-history-selection-fix-next'),old=path.resolve(own,'../keepass-history-independent-review'),sha=bytes=>createHash('sha256').update(bytes).digest('hex');async function fp(name){const bytes=await fs.readFile(path.join(own,name));return{path:name,bytes:bytes.length,sha256:sha(bytes)};}
const baseline=JSON.parse(await fs.readFile(path.join(own,'baseline-validation.json'))),manifest=JSON.parse(await fs.readFile(path.join(stage,'selection-preservation-manifest.json')));for(const row of manifest.files)if(sha(await fs.readFile(path.join(stage,row.path)))!==row.sha256)throw new Error('Corrected stage mutated: '+row.path);const oldManifest=JSON.parse(await fs.readFile(path.join(old,'review-manifest.json')));for(const row of oldManifest.files)if(sha(await fs.readFile(path.join(old,row.path)))!==row.sha256)throw new Error('Old review artifact mutated: '+row.path);
const passes=JSON.parse(await fs.readFile(path.join(own,'runs/rechecks/validation.json'))),failures=JSON.parse(await fs.readFile(path.join(own,'runs/same-editor/validation.json')));if(passes.counts.tests!==7||passes.counts.pass!==7||passes.exitCode!==0||!passes.sourceStable||failures.counts.tests!==2||failures.counts.fail!==2||failures.exitCode!==1||!failures.sourceStable)throw new Error('Reviewed counts differ.');
const restore=JSON.parse(await fs.readFile(path.join(own,'boundary-observations/same-editor-restore-draft.json'))),save=JSON.parse(await fs.readFile(path.join(own,'boundary-observations/same-editor-save-draft.json')));if(restore.observation.notesDisabledWhilePending||save.observation.notesDisabledWhilePending||restore.observation.after.notes!=='A content'||save.observation.after.notes!=='')throw new Error('Reported same-editor reproduction changed.');
const receipt={schema:'rea-independent-keepass-selection-correction-review/v1',createdAt:new Date().toISOString(),status:'FROZEN_REVIEW_WITH_NEW_FINDING',authorReceipt:baseline.authorReceipt,authorManifest:baseline.authorManifest,authorAll546ArtifactsUnchangedAfterReview:true,old101ReviewArtifactsUnchanged:true,candidateFingerprints:passes.sourceFingerprints,originalSevenUnchangedSafetyBodies:{counts:passes.counts,sourceStable:true,receipt:await fp('runs/rechecks/validation.json'),result:'Earlier wrong-entry restore/late-lock resurrection and ordinary-save other-editor loss no longer reproduce; three former positive controls continue passing.'},additionalSameEditorDiagnostics:{counts:failures.counts,sourceStable:true,receipt:await fp('runs/same-editor/validation.json')},findings:[{id:'KVH-REVIEW-SAME-EDITOR-DRAFT',priority:'P2',source:'client.mjs',sourceSha256:'157e34dfaa5dce136f4225aa04dcfcd7f69d8a4880c4c42b657c265adaa3ebfd',trigger:'Hold the completed Restore or Save transport response, type a new Notes draft into the same still-enabled editor after request capture, then release the response.',actual:'Restore rebuilds the editor from the historical Notes value; Save rebuilds a blank New entry editor. In each case the newly typed draft disappears.',expected:'Disable editor inputs during that mutation, or capture/track their draft state and preserve changes made after request capture before replacing the editor.',reasonExistingFixInsufficient:'View/selection/editor generations do not change when values are typed in the same editor.',reproductions:['boundary-observations/same-editor-restore-draft.json','boundary-observations/same-editor-save-draft.json'],scope:'Actual authenticated fixed client/server, synthetic encrypted in-memory store and owned DOM model with deterministic delayed response. No actual HTTP loss or original GUI execution claim.',saveBoundaryPreExisting:true,restoreBoundaryNew:true}],originalExecutionsByReviewer:0,actualBrowserExecutions:0,browserDeferredReason:'Review found enabled-editor draft loss; actual browser review deferred to the final corrected candidate rather than accepting this source.',productionOrAuthorStageEdited:false,fullProductParity:false,securityOrSuperiorityClaim:false};await fs.writeFile(path.join(own,'review-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});const files=[];async function walk(directory){for(const entry of await fs.readdir(directory,{withFileTypes:true})){if(directory===own&&['.local','review-manifest.json'].includes(entry.name))continue;const full=path.join(directory,entry.name);if(entry.isDirectory())await walk(full);else files.push(await fp(path.relative(own,full).replaceAll('\\','/')));}}await walk(own);files.sort((a,b)=>a.path.localeCompare(b.path));await fs.writeFile(path.join(own,'review-manifest.json'),JSON.stringify({schema:'rea-independent-keepass-correction-review-strict-manifest/v1',files,count:files.length},null,2)+'\n',{flag:'wx'});for(const row of files)if((await fp(row.path)).sha256!==row.sha256)throw new Error('Own review source changed.');console.log(JSON.stringify({receipt:await fp('review-validation.json'),manifest:await fp('review-manifest.json'),artifacts:files.length,earlierRegressionsPassed:7,newSameEditorFailures:2,authorSourceUnchanged:true}));
