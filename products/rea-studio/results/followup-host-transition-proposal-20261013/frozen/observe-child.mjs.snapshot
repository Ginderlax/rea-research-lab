import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{spawnSync}from'node:child_process';const here=import.meta.dirname,repo=path.resolve(here,'../../outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),p=path.join(repo,'scripts/verify-editor-save-followup.mjs'),before=await fs.readFile(p);assert.equal(before.length,6745);assert.equal(sha(before),'4b93961b46b79fe901eafcfc3e1eda564803b60a12be411feb58350da604f001');const r=spawnSync(process.execPath,[p],{cwd:repo,encoding:'utf8',windowsHide:true,timeout:60000,maxBuffer:1024*1024});await fs.mkdir(path.join(here,'observations'),{recursive:true});await fs.writeFile(path.join(here,'observations/child-default.stdout.txt'),r.stdout??'',{flag:'wx'});await fs.writeFile(path.join(here,'observations/child-default.stderr.txt'),r.stderr??'',{flag:'wx'});assert.equal(r.status,0,r.stderr);assert.equal(sha(await fs.readFile(p)),sha(before));const result=JSON.parse(r.stdout);assert.equal(result.schema,'rea-editor-save-public-followup-verification/v1');assert.equal(result.passed,true);assert.equal(result.requireCurrent,false);assert.equal(result.liveSourceMatch,false);assert.deepEqual(result.liveMismatches,[{path:'products/rea-studio/server.mjs',testedSha256:'807a473ec0334f60dfd58f2df8901c722f1bd4eb1d64c62d9ba1ea65c2b6b55f',liveSha256:'85fe09b1b52a1d91e9d09c85d99c6e768ac4b793f5d7694a1760a4c0560a0a94'}]);await fs.writeFile(path.join(here,'observations/child-default.json'),JSON.stringify({at:new Date().toISOString(),argv:[p],exitCode:r.status,signal:r.signal,spawnError:r.error??null,source:{bytes:before.length,sha256:sha(before)},output:result,behavioralTestsExecuted:0,originalExecutions:0,observedMismatchIncludesBytes:false,callerMustAuthenticateByteLengths:true},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(result));
