    },
    {
      "id": "grafana.candidate.44be57c9d2b5907f9e0e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We are pleased to announce our very first version of our data source plugin for AWS X-Ray. You can use this plugin to visualize traces, look at analytics tables, and see insight summaries. For more information, refer to the [X-Ray data source](/grafana/plugins/grafana-x-ray-datasource) plugin page.",
      "headingPath": [
        "What's new in Grafana v7.2",
        "What's new in other parts of the Grafana ecosystem",
        "X-Ray data source plugin"
      ],
