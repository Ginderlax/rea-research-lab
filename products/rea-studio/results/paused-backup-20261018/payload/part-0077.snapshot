    {
      "id": "grafana.candidate.21642cb4bb58bce83f3d",
      "syntaxRole": "table-row",
      "sourceText": "| Beta  | `v1beta1`  | More stable than alpha, but may still have some changes                     | For non-critical use     | No                  |",
      "headingPath": [
        "The new HTTP API structure in Grafana",
        "Understand the components",
        "Version (`<version>`)"
      ],
      "source": {
