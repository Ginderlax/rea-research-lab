const originalCarriers=json(stage,'original-carrier-prerequisite.json'),publicLocations=new Set(),sourceKeys=new Set(),epochChecks=[],headers={jpeg:0,png:0,utf8:0},newAliases=alias.records.filter(r=>!r.reusedExistingPublic),reused=alias.records.filter(r=>r.reusedExistingPublic);assert.equal(reused.length,832);assert.equal(newAliases.length,398);
for(const epoch of alias.epochs){const root=path.join(base,'work',epoch.folder),oldmb=read(root,epoch.file,epoch.manifest),old=JSON.parse(oldmb);assert.equal(old.inventory.length,epoch.frozenPayloads);for(const r of old.inventory)read(root,r.path,r);const rows=alias.records.filter(r=>r.epoch===epoch.epoch);assert.equal(rows.length,epoch.qualifiedAliases);const names=new Set(rows.map(r=>r.sourcePath));for(const r of old.inventory)assert(names.has(r.path));assert(names.has(epoch.file));assert.equal(names.size,rows.length);epochChecks.push({epoch:epoch.epoch,manifest:epoch.manifest,payloads:old.inventory.length,aliasRows:rows.length,allStrictPayloadPathsMapped:true,qualification:epoch.qualification});}
