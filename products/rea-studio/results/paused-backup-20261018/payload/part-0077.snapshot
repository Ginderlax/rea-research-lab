    {
      "id": "grafana.candidate.da0ba5cdbf97aebb68ca",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The maximum expiration depends on your AWS credential type: IAM user credentials support up to 7 days, IAM role or STS credentials are limited to the session duration (typically 1–12 hours), and instance profile credentials are limited to 6 hours.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[external_image_storage.s3]`",
        "`presigned_url_expiration`"
      ],
      "source": {
