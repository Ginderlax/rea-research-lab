import fs from 'node:fs/promises';
import path from 'node:path';
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {inflateRawSync} from 'node:zlib';
import {fileURLToPath} from 'node:url';
const own=fileURLToPath(new URL('./',import.meta.url)),stage=fileURLToPath(new URL('../keepass-recycle-next/',import.meta.url));
const hash=b=>createHash('sha256').update(b).digest('hex'),read=rel=>fs.readFile(path.join(stage,rel)),json=async rel=>JSON.parse(await read(rel));
const before=JSON.parse(await fs.readFile(path.join(own,'stage-before.json'))),manifest=await json('manifest.json');
for(const row of manifest.files){const b=await read(row.path);assert.deepEqual({bytes:b.length,sha256:hash(b)},{bytes:row.bytes,sha256:row.sha256},row.path);}
async function inventory(dir=stage,prefix=''){let out=[];for(const entry of await fs.readdir(dir,{withFileTypes:true})){assert.equal(entry.isSymbolicLink(),false);const rel=prefix+entry.name;if(entry.isDirectory())out.push(...await inventory(path.join(dir,entry.name),rel+'/'));else if(!['manifest.json','freeze.json'].includes(rel))out.push(rel);}return out;}
assert.deepEqual((await inventory()).sort(),manifest.files.map(r=>r.path).sort());assert.equal(hash(await read('manifest.json')),before.manifest.sha256);assert.equal(hash(await read('validation.json')),before.validation.sha256);
const provenance=await json('source-provenance.json'),archivePath=fileURLToPath(new URL('../keepass-history-next/.local/KeePass-2.61.1-Source.zip',import.meta.url)),archive=await fs.readFile(archivePath);
assert.equal(archive.length,provenance.archive.bytes);assert.equal(hash(archive),provenance.archive.sha256);
let end=-1;for(let i=archive.length-22;i>=Math.max(0,archive.length-65557);i--)if(archive.readUInt32LE(i)===0x06054b50&&i+22+archive.readUInt16LE(i+20)===archive.length){end=i;break;}assert.ok(end>=0);assert.equal(archive.readUInt16LE(end+10),provenance.archive.census);
let offset=archive.readUInt32LE(end+16),selected=0;for(let i=0;i<provenance.archive.census;i++){assert.equal(archive.readUInt32LE(offset),0x02014b50);const n=archive.readUInt16LE(offset+28),extra=archive.readUInt16LE(offset+30),comment=archive.readUInt16LE(offset+32),name=archive.subarray(offset+46,offset+46+n).toString('utf8'),row=provenance.files.find(r=>r.upstreamPath===name);if(row){const local=archive.readUInt32LE(offset+42);assert.equal(archive.readUInt32LE(local),0x04034b50);const start=local+30+archive.readUInt16LE(local+26)+archive.readUInt16LE(local+28),packed=archive.subarray(start,start+archive.readUInt32LE(offset+20)),method=archive.readUInt16LE(offset+10),bytes=method===0?packed:method===8?inflateRawSync(packed,{maxOutputLength:row.bytes}):null;assert.ok(bytes);assert.equal(bytes.length,row.bytes);assert.equal(hash(bytes),row.sha256);selected++;}offset+=46+n+extra+comment;}assert.equal(selected,16);
const releasePath=fileURLToPath(new URL('../../outputs/rea-research-lab/projects/07-keepass/artifacts/portable/KeePass.exe',import.meta.url)),exe=await fs.readFile(releasePath);assert.equal(hash(exe),'04d29636c393f0c1fc99ff739295494be3adefded93271e44591e8e300225a5a');
const run='runs/candidate-2026-10-13T00-12-34.132Z/',parts=[];for(const name of ['prior-history-original.json','prior-history-http.json','prior-history-unknown.json']){const obj=await json(run+name);assert.equal(obj.observations.length,obj.originalProcessExecutions);for(const o of obj.observations){assert.equal(o.result.code,0);assert.deepEqual(JSON.parse(o.result.stdout),o.value);}parts.push({name,actualProcesses:obj.observations.length,successfulReleasedHelperResults:obj.observations.length});}
const recycle=await json(run+'recycle-original.json');let calls={};for(const o of recycle.observations){assert.equal(o.code,0);assert.equal(o.assemblyLoaded,true);assert.ok(o.stderr.includes('REA_RECYCLE_ASSEMBLY_LOADED_2_61_1'));assert.deepEqual(JSON.parse(o.stdout),o.value);for(const [name,count]of Object.entries(o.value.calls))calls[name]=(calls[name]||0)+count;}assert.equal(recycle.observations.length,14);assert.equal(calls.assemblyLoads,14);assert.equal(calls.sourceComposedDelete,5);assert.equal(calls.sourceComposedRestore,1);assert.equal(calls.clockAssignments,17);assert.equal(calls.touch,2);assert.equal(calls.ensureBin,2);assert.equal(calls.originalGUI,0);assert.equal(parts.reduce((n,r)=>n+r.actualProcesses,0)+14,38);
assert.equal(recycle.observations[12].value.savedVersion,262144);assert.equal(recycle.observations[12].value.entries[0].previous,'00000000-0000-0000-0000-000000000000');assert.equal(recycle.observations[13].value.savedVersion,262145);assert.equal(recycle.observations[13].value.entries[0].previous,'00000000-0000-0000-0000-000000000003');
const failures=await json('failure-ledger.json');for(const row of failures.runs){const b=await read(row.run+'/validation.json');assert.equal(hash(b),row.receiptSha256);if(row.run.includes('/original-')){const observations=JSON.parse(await read(row.run+'/recycle-original.json')).observations;const actual=observations.filter(o=>o.assemblyLoaded||o.stderr?.includes('REA_RECYCLE_ASSEMBLY_LOADED_2_61_1')).length;assert.equal(actual,row.actualAssemblyLoads,row.run);}}
const ownedOriginal=[];for(const name of ['seed','nested-restore','candidate-read','nested-purge']){const obj=JSON.parse(await fs.readFile(path.join(own,'observations/original',name+'.json')));assert.equal(obj.code,0);assert.equal(obj.assemblyLoaded,true);assert.equal(obj.releaseSha256,hash(exe));assert.ok(obj.stderr.includes('REA_RECYCLE_ASSEMBLY_LOADED_2_61_1'));ownedOriginal.push({name,calls:JSON.parse(obj.stdout).calls,observationSha256:hash(await fs.readFile(path.join(own,'observations/original',name+'.json')))});}
const result={schema:'rea-keepass-recycle-independent-final-source-audit/v1',checkedAt:new Date().toISOString(),stage:before.stage,validation:before.validation,manifest:before.manifest,strictInventory:true,all546ArtifactsUnchanged:true,runtime:before.runtime,sourceArchive:{path:archivePath,bytes:archive.length,sha256:hash(archive),centralDirectoryEntries:1381,selectedExactFromArchive:16},release:{path:releasePath,bytes:exe.length,sha256:hash(exe)},authorFinalOriginal:{priorParts:parts,recycleActual14:calls,totalAssemblyProcesses:38,originalGUI:0,default4_0PreviousParentDropped:true,conditional4_1PreviousParentRetained:true},historicalRunIdentities:failures.runs.length,failedReflectionCountCorrectionRetained:true,ownOriginal:{processes:4,observations:ownedOriginal,originalGUI:0},candidateModified:false,productionModified:false};
await fs.writeFile(path.join(own,'stage-after.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({pass:true,stageArtifacts:546,sourceEntries:1381,selectedExact:16,authorAssembly:38,ownAssembly:4,allStageBytesUnchanged:true}));
