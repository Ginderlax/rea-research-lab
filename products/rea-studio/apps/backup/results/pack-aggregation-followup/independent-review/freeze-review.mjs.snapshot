import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),main=path.resolve(here,'../restic-pack-aggregation-next'),adapter=path.resolve(here,'../restic-pack-production-adapter-next'),sha=b=>createHash('sha256').update(b).digest('hex'),receipt='review-validation.json';
const fp=async file=>{const bytes=await fs.readFile(file);return {bytes:bytes.length,sha256:sha(bytes)};};
async function inventory(dir=here){const result={};for(const row of (await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const file=path.join(dir,row.name),relative=path.relative(here,file).replaceAll('\\','/');if(relative===receipt)continue;assert.ok(!row.isSymbolicLink());if(row.isDirectory())Object.assign(result,await inventory(file));else {assert.ok(row.isFile());result[relative]=await fp(file);}}return result;}
if(process.argv.includes('--verify-only')){const frozen=JSON.parse(await fs.readFile(path.join(here,receipt)));assert.deepEqual(await inventory(),frozen.inventory);console.log(JSON.stringify({status:'passed',sha256:sha(await fs.readFile(path.join(here,receipt))),files:Object.keys(frozen.inventory).length,readOnly:true}));}
else {
 const authentication=JSON.parse(await fs.readFile(path.join(here,'authentication.json'))),observation=JSON.parse(await fs.readFile(path.join(here,'overlap-observation.json')));assert.equal(authentication.status,'passed');assert.equal(observation.reproduced,true);
 for(const [root,name,digest]of [[main,'stage-validation.json',authentication.authenticatedInventories[0].receiptSHA256],[adapter,'adapter-validation.json',authentication.authenticatedInventories[1].receiptSHA256]])assert.equal((await fp(path.join(root,name))).sha256,digest);
 for(const [root,entry]of [[main,authentication.authenticatedInventories[0]],[adapter,authentication.authenticatedInventories[1]]]){
  assert.equal((await fp(path.join(root,'freeze-manifest.json'))).sha256,entry.manifestSHA256);const manifest=JSON.parse(await fs.readFile(path.join(root,'freeze-manifest.json')));for(const row of manifest.entries)assert.deepEqual(await fp(path.join(root,row.path)),{bytes:row.bytes,sha256:row.sha256});
 }
 const oldBaseline=JSON.parse(await fs.readFile(path.join(main,'production-baseline.json')));for(const row of authentication.mainHistoricalBaseline37)assert.deepEqual(await fp(path.join(oldBaseline.repository,row.path)),row.current);
 await fs.mkdir(path.join(here,'preserved'),{recursive:true});
 for(const [root,relative,target]of [[main,'stage-validation.json','main-stage-validation.json'],[main,'freeze-manifest.json','main-freeze-manifest.json'],[main,'production-baseline.json','main-production-baseline.json'],[adapter,'adapter-validation.json','adapter-validation.json'],[adapter,'freeze-manifest.json','adapter-freeze-manifest.json'],[main,'products/rea-studio/apps/backup/restic-data-pack.mjs','restic-data-pack.c68d.mjs.snapshot'],[main,'products/rea-studio/apps/backup/restic.mjs','restic.e668.mjs.snapshot']])await fs.writeFile(path.join(here,'preserved',target),await fs.readFile(path.join(root,relative)),{flag:'wx'});
 const attempts=[];for(const name of (await fs.readdir(here)).filter(n=>/^overlap-attempt-\d+\.json$/.test(n))){const row=JSON.parse(await fs.readFile(path.join(here,name)));assert.equal(row.exitCode,0);assert.equal(row.sourceBefore,row.sourceAfter);assert.equal(row.sourceBefore,(await fp(path.join(here,'overlap-reproduction.mjs'))).sha256);for(const side of ['stdout','stderr'])assert.deepEqual(await fp(path.join(here,row[side].path)),{bytes:row[side].bytes,sha256:row[side].sha256});attempts.push({path:name,...row});}assert.equal(attempts.length,1);
 const current=await inventory(),output={schemaVersion:1,checkedAt:new Date().toISOString(),status:'frozen independent review with concrete finding',authenticatedInventories:authentication.authenticatedInventories.map(({entries,...row})=>row),
  authentication:await fp(path.join(here,'authentication.json')),newBehavioralReproductions:1,attempts,findings:[{id:'exported-writer-overlap-loss',reproduced:true,helperSHA256:authentication.candidateFiles.dataPack.sha256,observation:await fp(path.join(here,'overlap-observation.json')),currentApplicationLossDemonstrated:false,requestedRepairStage:'../restic-pack-operation-guard-next',scope:'Current snapshot calls are serialized; exported-helper overlap must reject/serialize before mutation.'}],
  currentRootNativeTestSHA256:authentication.currentRootGenericNativeTestSHA256,historicalNativeTestSHA256:authentication.historicalMainNativeTestSHA256,stagedBatchNativeTestSHA256:authentication.stagedBatchNativeTestSHA256,currentRootGenericHelperSHA256:authentication.currentAndStagedRootPolicyHelperSHA256,
  historicalTestsAuthenticated:{main:66,adapter:33},thoseSuitesRerunThisReview:false,sourceBeforeAfterStable:true,oldEvidenceOrProductionChanged:false,originalRuntimeExecutions:0,timingMeasurementRun:false,memoryMeasurementRun:false,inventory:current,fullProductComplete:false,universalSuperiorityEstablished:false};
 const bytes=JSON.stringify(output,null,2)+'\n';await fs.writeFile(path.join(here,receipt),bytes,{flag:'wx'});assert.deepEqual(await inventory(),current);console.log(JSON.stringify({path:path.join(here,receipt),sha256:sha(bytes),files:Object.keys(current).length,findings:1,currentApplicationLossDemonstrated:false}));
}
