    {
      "id": "grafana.candidate.7d5475281083861a3002",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When a signal follows recurring patterns, such as daily or weekly traffic cycles, a linear forecast cannot accurately represent its future behavior.",
      "headingPath": [
        "Alerting on forecasts",
        "Seasonal forecast with Grafana Cloud Machine Learning"
      ],
      "source": {
        "path": "docs/sources/alerting/guides/alerting-on-forecasts.md",
