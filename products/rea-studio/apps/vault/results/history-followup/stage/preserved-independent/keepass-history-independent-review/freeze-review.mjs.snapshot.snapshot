await fs.writeFile(path.join(own,'review-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});const files=[];async function walk(directory){for(const entry of await fs.readdir(directory,{withFileTypes:true})){if(directory===own&&['.local','review-manifest.json'].includes(entry.name))continue;const target=path.join(directory,entry.name);if(entry.isDirectory())await walk(target);else files.push(await fp(path.relative(own,target).replaceAll('\\','/')));}}await walk(own);files.sort((a,b)=>a.path.localeCompare(b.path));await fs.writeFile(path.join(own,'review-manifest.json'),JSON.stringify({schema:'rea-independent-keepass-review-strict-manifest/v1',files,count:files.length,scope:'Every owned review artifact except .local synthetic mutable data and this manifest.'},null,2)+'\n',{flag:'wx'});for(const row of files)if((await fp(row.path)).sha256!==row.sha256)throw new Error('Owned review artifact changed during freeze.');console.log(JSON.stringify({receipt:await fp('review-validation.json'),manifest:await fp('review-manifest.json'),artifacts:files.length,findings:findings.length,tests:7,passingControls:3,failedSafetyAssertions:4,authorAndProductionUnchanged:true}));
