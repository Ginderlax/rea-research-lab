    {
      "id": "grafana.candidate.620bb8334da0753096a2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can configure the alert list panel with various visualization options and filters to control how alerts are displayed. For more details, refer to the [Alert list documentation](ref:alert-list-panel).",
