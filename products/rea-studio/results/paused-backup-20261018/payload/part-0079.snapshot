    {
      "id": "grafana.candidate.803ad1f8b927d45aaa5e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A new standard field color scheme option has been added. This new option will provide a unified way for all new panels to specify how colors should be assigned. For more information, refer to [Apply color to series and fields](../../panels-visualizations/configure-standard-options/#color-scheme).",
