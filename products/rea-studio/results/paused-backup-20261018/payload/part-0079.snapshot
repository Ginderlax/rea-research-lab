    {
      "id": "grafana.candidate.cc242c90e1901abfed75",
      "syntaxRole": "table-row",
      "sourceText": "| Show values                      | This controls whether values are shown. Values are shown on top or to the left of bars. Choose from: <ul><li>**Auto** Values will be shown if there is space.</li><li>**Always** Always show values.</li><li>**Never** Never show values.</li></ul>                                                               |",
      "headingPath": [
        "Bar chart",
        "Configuration options",
        "Bar chart options"
      ],
