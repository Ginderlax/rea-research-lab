import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import {createHash} from 'node:crypto';
const work=import.meta.dirname,stage=path.join(work,'metrics-wrapper-measurement-next'),out=path.join(work,'metrics-wrapper-readiness-independent-review'),sha=b=>createHash('sha256').update(b).digest('hex'),read=n=>fs.readFile(path.join(stage,n)),json=async n=>JSON.parse(await read(n));await fs.mkdir(out,{recursive:true});await fs.writeFile(path.join(out,'authenticate.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});
const receiptBytes=await read('readiness-validation.json'),manifestBytes=await read('freeze-manifest.json'),preflightBytes=await read('memory-preflight.control.json');assert.equal(sha(receiptBytes),'705c4540bb54ef37e6b396ed9082aaf7ffe4d944b362b03ac85bd0d76ec3c32c');assert.equal(sha(manifestBytes),'6bb39d2051d18147987ff2028d349b219f279d48216159ff00f5d7f2bc7858c3');assert.equal(sha(preflightBytes),'4ef9d10a58ef0d58600e389ce82b2774f347a61c7ccfd5c8ac4152001b404438');const manifest=JSON.parse(manifestBytes),receipt=JSON.parse(receiptBytes),preflight=JSON.parse(preflightBytes);assert.equal(manifest.files,2426);assert.equal(Object.keys(manifest.inventory).length,2426);assert.equal(manifest.receiptSHA256,sha(receiptBytes));assert.deepEqual(manifest.inventory,receipt.inventory);
let total=0;async function authenticate(){for(const[n,e]of Object.entries(manifest.inventory)){assert.ok(n&&!n.startsWith('/')&&!n.includes('\\')&&!n.split('/').includes('..'));const b=await read(n);assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256);}}await authenticate();for(const e of Object.values(manifest.inventory))total+=e.bytes;assert.equal(total,80500003);assert.equal(total,manifest.aggregateBytes);
const previous=JSON.parse(await fs.readFile(path.join(work,'metrics-algorithm-measurement-next/memory-preflight.control.json')));assert.deepEqual(preflight.expectedFiles,previous.expectedFiles);assert.equal(preflight.expectedMetadataSHA256,previous.expectedMetadataSHA256);assert.equal(preflight.canonicalSourceSHA256,previous.canonicalSourceSHA256);assert.equal(preflight.workloadSourceSHA256,previous.workloadSourceSHA256);const fixtures=[];for(const[n,e]of Object.entries(preflight.expectedFiles))for(const[p,digest,size]of [[e.inputPath,e.inputFileSHA256,e.inputBytes],[e.path,e.sha256,e.bytes]]){const b=await read(p);assert.equal(sha(b),digest);assert.equal(b.length,size);fixtures.push({workload:n,path:p,bytes:b.length,sha256:digest});}assert.equal(fixtures.length,14);
const originals=[];for(const[p,digest]of Object.entries(receipt.authority.files)){const b=await fs.readFile(p);assert.equal(sha(b),digest);originals.push({path:p,bytes:b.length,sha256:digest});}assert.equal(originals.length,6);const archives=[];for(const e of receipt.publicationExcludedLocalOriginalArchives){const b=await fs.readFile(e.source);assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256);archives.push({source:e.source,bytes:b.length,sha256:e.sha256});}assert.equal(archives.length,2);const runtimeBytes=await fs.readFile(receipt.runtime.execPath);assert.equal(sha(runtimeBytes),'b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3');
for(const[n,digest]of [['candidate-wrapper.mjs','b3feba481b9ceaad6dce4dfca0c2e264b1e1dcfbb2499192e74b48ef92baace0'],['selector-algorithm.mjs','de334c498bb286c640661d8a3df05794fb66ebb02a3629231f18dbcb3c9bd58c'],['candidate-baseline.mjs','9269cf8c32be9bf2c075b67019e82e41272d9495f0321fefc17b2c5695a91371']])assert.equal(sha(await read(n)),digest);
assert.deepEqual(preflight.limits,{samplesPerWorkloadAndImplementation:7,childWallSeconds:120,childOldSpaceMiB:256,childRSSMiB:512,stdoutBytes:4194304});assert.equal(receipt.prospective.timingChildren,147);assert.equal(receipt.prospective.isolatedMemoryChildren,147);assert.equal(receipt.prospective.fixedWorkloads,7);assert.equal(receipt.prospective.repetitions,7);assert.equal(receipt.prospective.unchangedAllPercentilesWarmup,2);assert.equal(receipt.prospective.unchangedAllPercentilesIterations,3);assert.equal(receipt.prospective.noPosthocThreshold,true);for(const gate of ['timingMeasurementRun','memoryMeasurementRun','profileRun','measurementBranchExecutionTested','machineLevelIsolationEstablished','productionChanged','selectedForIntegration','performanceAcceptance','fullPerformanceNonRegressionEstablished','universalCorrectnessEstablished','universalSuperiorityEstablished','fullParityEstablished','fullProductComplete'])assert.equal(receipt[gate],false);
await authenticate();assert.ok((await read('freeze-manifest.json')).equals(manifestBytes));const result={schema:'rea-independent-metrics-wrapper-readiness-authentication/v1',checkedAtUtc:new Date().toISOString(),status:'PASS_NO_AUTHENTICATION_BLOCKER',stageArtifacts:2426,aggregateBytes:total,readinessSHA256:sha(receiptBytes),freezeManifestSHA256:sha(manifestBytes),preflightSHA256:sha(preflightBytes),allBeforeAfterSourceBytesMatch:true,fixtures,sevenSpecsAndMetadataExactlyMatchPrior:true,originals,archives,runtimeSHA256:sha(runtimeBytes),candidate:receipt.candidate,sourceAssessment:{timing:'Unchanged60s/2MiB child and600s/4MiB controller bounds; three roles rotate,147 sequential children.',memory:'120s child/256MiB oldspace/512MiB sampled RSS; one implementation per child. No outer hard watchdog, job-object isolation, process-start/PID-reuse or unsampled peak proof.',signedDeltas:'Keep every signed child and paired delta; zero controls unavailable; prospective censoring includes failures and limits.',fullCorrectness:'Only byte authentication here; prior finite86 campaign and nine new root corpora are separate provenance.',coordination:'Root and other agents must explicitly pause and each fresh timing/memory window must be authorized and closed; background Windows/user activity remains uncontrolled.'},newTests:0,newReducerCalls:0,newTimingMemoryOrProfilerRuns:0,productionChanged:false,fullProductParity:false,universalSuperiority:false};const b=Buffer.from(JSON.stringify(result,null,2)+'\n');await fs.writeFile(path.join(out,'review-validation.json'),b,{flag:'wx'});console.log(JSON.stringify({status:result.status,artifacts:2426,fixtures:14,originalFiles:6,archives:2,receiptSHA256:sha(b),sourceStable:true}));
