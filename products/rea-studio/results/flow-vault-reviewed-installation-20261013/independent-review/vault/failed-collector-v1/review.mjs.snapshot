import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const own=import.meta.dirname,base=path.resolve(own,'../..'),stage=path.join(base,'work/vault-group-edit-installation-plan-next'),repo=path.join(base,'outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)}),seen=new Map(),checks=[];
function safe(p,publicPath=false){assert(typeof p==='string'&&p&&p.length<=4096&&!/[\\:\x00-\x1f\x7f]/.test(p)&&!p.startsWith('/'));assert(p.split('/').every(s=>s&&s!=='.'&&s!=='..'&&(!publicPath||!['.local','work','node_modules'].includes(s))));return p;}
function read(root,p,e){safe(p);let at=root;for(const s of p.split('/')){at=path.join(at,s);assert(!fs.lstatSync(at).isSymbolicLink());}const stat=fs.statSync(at);assert(stat.isFile()&&stat.size<=32*1024*1024);const b=fs.readFileSync(at),r=id(b);assert.equal(b.length,stat.size);if(e)assert.deepEqual(r,{bytes:e.bytes,sha256:e.sha256},p);const key=root+'|'+p;if(seen.has(key))assert.deepEqual(seen.get(key).identity,r);else seen.set(key,{root:path.relative(base,root).replaceAll('\\','/'),path:p,identity:r});return b;}const json=(root,p,e)=>JSON.parse(read(root,p,e));function save(p,b){const at=path.join(own,p);fs.mkdirSync(path.dirname(at),{recursive:true});fs.writeFileSync(at,b,{flag:'wx'});}function check(name){checks.push({name,passed:true});}
