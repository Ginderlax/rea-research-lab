}
manifest_path = PREFIX + 'preservation-manifest.json'
writejson(CAND / manifest_path, declaration)
transition = {
    'path': DOC,
    'before': declaration['before'],
    'after': declaration['after'],
    'beforeImage': declaration['beforeImage'],
    'oldMigration': declaration['oldMigration'],
    'manifest': {'path': manifest_path, **ident(CAND / manifest_path)}
}
migration = text(REPO / MIGRATION)
migration = once(migration, 'export function createEditorVaultProofMigration(rawRead)', 'const groupEditDocumentTransition=' + json.dumps(transition, indent=2) + ';\nexport function createEditorVaultProofMigration(rawRead)')
old_read_start = ' function read(p,r){safe(p);const b=rawRead(p);'
new_read_start = " function read(p,r){safe(p);if(p===groupEditDocumentTransition.path){assert(r,'Named GROUP-EDIT document read requires explicit identity');const requested=expected(r);if(requested.bytes===groupEditDocumentTransition.before.bytes&&requested.sha256===groupEditDocumentTransition.before.sha256)p=groupEditDocumentTransition.beforeImage.path;else same(requested,groupEditDocumentTransition.after,'No unlisted GROUP-EDIT document read identity allowed');}const b=rawRead(p);"
migration = once(migration, old_read_start, new_read_start)
declaration_read = " const groupEditDocumentDeclaration=JSON.parse(read(groupEditDocumentTransition.manifest.path,groupEditDocumentTransition.manifest));assert.equal(groupEditDocumentDeclaration.schema,'rea-vault-group-edit-document-link-transition/v1');assert.equal(groupEditDocumentDeclaration.sourceOnly,true);assert.equal(groupEditDocumentDeclaration.immutableNextSourcesAndAuthoritiesRewritten,false);assert.equal(groupEditDocumentDeclaration.arbitraryFallback,false);assert.equal(groupEditDocumentDeclaration.genericPathAlias,false);assert.equal(groupEditDocumentDeclaration.oldReceiptsRewritten,false);assert.equal(groupEditDocumentDeclaration.target,groupEditDocumentTransition.path);same(groupEditDocumentDeclaration.before,groupEditDocumentTransition.before,'Exact GROUP-EDIT document before identity');same(groupEditDocumentDeclaration.after,groupEditDocumentTransition.after,'Exact GROUP-EDIT document after identity');assert.deepEqual(groupEditDocumentDeclaration.records,[groupEditDocumentTransition.beforeImage,groupEditDocumentTransition.oldMigration]);for(const r of groupEditDocumentDeclaration.records)read(r.path,r);read(groupEditDocumentTransition.path,groupEditDocumentTransition.after);\n"
migration = once(migration, ' const manifest=JSON.parse(read(fixed.installation.manifest.path,fixed.installation.manifest));', declaration_read + ' const manifest=JSON.parse(read(fixed.installation.manifest.path,fixed.installation.manifest));')
resolve_start = ' function resolveHistorical(p,r){\n  safe(p);'
resolve_after = " function resolveHistorical(p,r){\n  safe(p);if(p===groupEditDocumentTransition.path){assert(r,'Named GROUP-EDIT document transition requires explicit identity');const requested=expected(r);if(requested.bytes===groupEditDocumentTransition.after.bytes&&requested.sha256===groupEditDocumentTransition.after.sha256)return null;if(requested.bytes===groupEditDocumentTransition.before.bytes&&requested.sha256===groupEditDocumentTransition.before.sha256)return groupEditDocumentTransition.beforeImage.path;throw new Error('No unlisted GROUP-EDIT document historical identity allowed');}"
migration = once(migration, resolve_start, resolve_after)
migration = once(migration, 'namedSourceRoutes:15,old720ChangedCodeRoutes:11,docsOutside720:4,', 'namedSourceRoutes:16,old720ChangedCodeRoutes:11,docsOutside720:5,groupEditDocumentCurrentSourceMandatory:1,groupEditDocumentHistoricalRoute:1,groupEditDocumentLinkOnlyTransition:true,')
migration = once(migration, 'priorMigrationSourceMandatory:6,', 'priorMigrationSourceMandatory:7,')
write(CAND / MIGRATION, migration)

producer = text(REPO / PRODUCER)
old_pin, new_pin = ident(REPO / MIGRATION), ident(CAND / MIGRATION)
producer = once(producer, "'" + MIGRATION + "': [" + str(old_pin['bytes']) + ", '" + old_pin['sha256'] + "']", "'" + MIGRATION + "': [" + str(new_pin['bytes']) + ", '" + new_pin['sha256'] + "']")
write(CAND / PRODUCER, producer)

controls = text(REPO / CONTROLS)
fragment = """  const groupEditDoc = 'products/rea-studio/apps/vault/GROUP-EDIT.md';
  const groupEditDocBefore = __BEFORE__, groupEditDocAfter = __AFTER__;
  positive('group-edit-document-exact-before-after-identities', () => { const scope = migration.summary(); assert.equal(scope.groupEditDocumentCurrentSourceMandatory, 1); assert.equal(scope.groupEditDocumentHistoricalRoute, 1); assert.equal(migration.resolve(groupEditDoc, groupEditDocAfter), null); assert.equal(migration.resolve(groupEditDoc, groupEditDocBefore), '__BEFORE_IMAGE__'); same(read(groupEditDoc), groupEditDocAfter); });
  negative('group-edit-document-unlisted-identity', () => migration.resolve(groupEditDoc, { bytes: 1, sha256: '0'.repeat(64) }), 'one exact GROUP-EDIT document before and after identity');
  negative('group-edit-document-missing-identity', () => migration.resolve(groupEditDoc), 'explicit expected identity is mandatory for the named document');
  negative('group-edit-document-mandatory-current-byte-change', () => createEditorVaultProofMigration(name => name === groupEditDoc ? flip(read(name)) : read(name)), 'new current document remains mandatory while immutable next.sources reads exact preserved before');
"""
fragment = fragment.replace('__BEFORE__', json.dumps(declaration['before'], separators=(',', ':'))).replace('__AFTER__', json.dumps(declaration['after'], separators=(',', ':'))).replace('__BEFORE_IMAGE__', before_image)
controls = once(controls, '  assert.equal(rows.length, 76);', fragment + '  assert.equal(rows.length, 80);')
write(CAND / CONTROLS, controls)

files = []
for path in sorted(CAND.rglob('*')):
    if path.is_file():
        name = path.relative_to(CAND).as_posix()
        files.append({'path': name, 'mode': 'replace-exact' if (REPO / name).is_file() else 'add-exact', 'before': ident(REPO / name) if (REPO / name).is_file() else None, 'after': ident(path)})
