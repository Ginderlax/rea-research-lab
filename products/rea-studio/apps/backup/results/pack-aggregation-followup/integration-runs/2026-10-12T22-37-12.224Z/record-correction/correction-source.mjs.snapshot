import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import {createHash} from 'node:crypto';
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab'),directory=path.join(lab,'products/rea-studio/apps/backup/results/pack-aggregation-followup'),sha=b=>createHash('sha256').update(b).digest('hex');
const beforeBytes=await fs.readFile(path.join(directory,'integration-validation.json'));assert.equal(sha(beforeBytes),'d3d8df025eb9de145b3585d19d42e5199f112da7d2de382fb8d3f04a4a14aebc');const before=JSON.parse(beforeBytes);assert.deepEqual(before.selectedTests,before.arguments.slice(4));assert.equal(before.arguments[3],'apps/backup/native.test.mjs');assert.equal(before.arguments.slice(3).length,6);
const oldManifestBytes=await fs.readFile(path.join(directory,'integration-run-manifest.json'));assert.equal(sha(oldManifestBytes),'74084c13cf59f9b2d236feca1e51efc718b0464a1822bc1a2114600a1fe0b6a8');const oldManifest=JSON.parse(oldManifestBytes);assert.equal(oldManifest.retained.length,51);for(const e of oldManifest.retained){const b=await fs.readFile(path.join(directory,e.path));assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256);}
const prefix=oldManifest.runPath+'/record-correction/',source=await fs.readFile(import.meta.filename),after=structuredClone(before);after.selectedTests=after.arguments.slice(3);after.metadataCorrection={correctedAtUtc:new Date().toISOString(),field:'selectedTests',previousReceiptSHA256:sha(beforeBytes),previousRunManifestSHA256:sha(oldManifestBytes),reason:'The original complete argument array retained all six test files; the derived selectedTests list incorrectly started at index4 instead of3.',behaviourOrCountsChanged:false,behaviourTestsRerun:false,sourceSHA256:sha(source)};
const retained=[...oldManifest.retained];async function retain(n,b){const p=prefix+n;await fs.mkdir(path.dirname(path.join(directory,p)),{recursive:true});await fs.writeFile(path.join(directory,p),b,{flag:'wx'});retained.push({path:p,bytes:b.length,sha256:sha(b)});}
await retain('previous-validation.json.snapshot',beforeBytes);await retain('previous-run-manifest.json.snapshot',oldManifestBytes);await retain('correction-source.mjs.snapshot',source);const afterBytes=Buffer.from(JSON.stringify(after,null,2)+'\n');await retain('validation.json',afterBytes);for(const e of after.implementationFingerprints)assert.equal(sha(await fs.readFile(path.join(lab,'products/rea-studio',e.path))),e.sha256);
const nextManifestBytes=Buffer.from(JSON.stringify({...oldManifest,retained,receiptSHA256:sha(afterBytes),receiptPath:prefix+'validation.json',metadataSelectionCorrection:true},null,2)+'\n');await fs.writeFile(path.join(directory,'integration-validation.json'),afterBytes);await fs.writeFile(path.join(directory,'integration-run-manifest.json'),nextManifestBytes);console.log(JSON.stringify({tests:64,pass:64,selectedTestFiles:after.selectedTests.length,sourceFiles:42,retained:retained.length,receiptSHA256:sha(afterBytes),runManifestSHA256:sha(nextManifestBytes),behaviourOrCountsChanged:false,behaviourTestsRerun:false}));
