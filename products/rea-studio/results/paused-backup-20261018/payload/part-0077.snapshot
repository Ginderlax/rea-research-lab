    {
      "id": "grafana.candidate.85e08e04ea5223668bc9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The duration in time a user invitation remains valid before expiring. This setting should be expressed as a duration. Examples: 6h (hours), 2d (days), 1w (week). Default is `24h` (24 hours). The minimum supported duration is `15m` (15 minutes).",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[users]`",
        "`user_invite_max_lifetime_duration`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
