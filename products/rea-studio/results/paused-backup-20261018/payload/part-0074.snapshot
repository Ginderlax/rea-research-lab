    {
      "id": "grafana.candidate.713b7b06b8e18f1a8be8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The response includes all permissions granted to that role, including plugin-specific actions. Plugin actions typically use `None` for their scope because they operate at the organization level.",
      "headingPath": [
        "Grafana RBAC permission actions and scopes",
        "Discover plugin actions"
      ],
      "source": {
