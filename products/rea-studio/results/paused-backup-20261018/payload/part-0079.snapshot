    },
    {
      "id": "grafana.candidate.ecb2632934ccabc9a360",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can use Public Dashboards to make a given dashboard available to anyone on the internet without needing to sign in. In Grafana v9.3, we have introduced a new screen where you can manage all of your public dashboards. From here, you can view a list of all of the public dashboards in your Grafana instance, navigate to the underlying dashboard, see if it is enabled, link out to the public version of the dashboard, or update the public dashboard's configuration. You can see a public dashboard's configuration if you have view access to the dashboard itself, and you can edit its configuration if you have the Admin or Server Admin role or the \"Public Dashboard writer\" role if you are using RBAC in Grafana Enterprise or Cloud Advanced.",
      "headingPath": [
        "What's new in Grafana v9.3",
        "Public dashboards improvements",
        "Manage all of your public dashboards in one place"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-3.md",
        "gitBlobSha": "acf11473ed5777a12056a218dd89128f81813beb",
        "sha256": "64900ffbe97db576e8db0598932deb044076d62fbd415d6bfd717f2d4b707209",
        "lineStart": 78,
        "lineEnd": 78,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v9-3.md#L78-L78"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.6039988f0c667ff2c9e0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To check out this new screen and configure your public dashboards, navigate to **Dashboards > Public Dashboards**.",
      "headingPath": [
        "What's new in Grafana v9.3",
        "Public dashboards improvements",
        "Manage all of your public dashboards in one place"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-3.md",
