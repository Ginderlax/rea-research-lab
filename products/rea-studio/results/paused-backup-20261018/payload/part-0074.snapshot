    {
      "id": "grafana.candidate.9883ca618cf5c12923f7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Plugin signature verification, also known as _signing_, is a security measure to make sure plugins haven't been tampered with. Upon loading, Grafana checks to see if a plugin is signed or unsigned when inspecting and verifying its digital signature.",
      "headingPath": [
        "Plugin signatures"
      ],
