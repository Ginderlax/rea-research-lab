    {
      "id": "grafana.candidate.fd09eaad7007b5ee31b5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Click a node and select either **Show in Grid layout** or **Show in Graph layout**, depending on the current layout of the visualization:",
      "headingPath": [
        "Node graph",
        "Node graph navigation",
        "Switch layouts"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/node-graph/index.md",
