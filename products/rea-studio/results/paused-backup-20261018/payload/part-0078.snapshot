    {
      "id": "grafana.candidate.b32cdd40f2713f09b939",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you're experiencing backend performance problems, such as high memory or CPU usage, please refer to [Configure profiling and tracing to troubleshoot Grafana](../setup-grafana/configure-grafana/configure-tracing/).",
