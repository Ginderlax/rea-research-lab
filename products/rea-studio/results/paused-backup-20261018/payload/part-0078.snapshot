        "sha256": "f821b02e2b87c25ad95fd5dee78a7973144d794c06fd2c6fcad576ccf23ed53d",
        "lineStart": 251,
        "lineEnd": 251,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/panels-visualizations/query-transform-data/sql-expressions/index.md#L251-L251"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
