    },
    {
      "id": "grafana.candidate.1fd1fbc8a6cbe93a8bfa",
      "syntaxRole": "table-row",
      "sourceText": "| `$__timeFilter()`               | Filters the results to the time range of the dashboard. Example: `TimeGenerated >= datetime(2018-06-05T18:09:58.907Z) and TimeGenerated <= datetime(2018-06-05T20:09:58.907Z)`.                                                                                                                                                                                                                                                                                                |",
      "headingPath": [
        "Azure Monitor query editor",
        "Query Azure Monitor Logs",
        "Use macros in Logs queries"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/query-editor/index.md",
        "gitBlobSha": "7e9d70541f1e4e273a619ba9e62b5958327ea3ee",
        "sha256": "06c986577af5c0ca3965b3815e378dc6ecf5d82a71accceca9354c5baeafb011",
        "lineStart": 294,
        "lineEnd": 294,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/azure-monitor/query-editor/index.md#L294-L294"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.81739d5f1ce0b2748d79",
      "syntaxRole": "table-row",
      "sourceText": "| `$__timeFilter(datetimeColumn)` | Like `$__timeFilter()`, but specifies a custom field to filter on.                                                                                                                                                                                                                                                                                                                                                                                                             |",
      "headingPath": [
        "Azure Monitor query editor",
        "Query Azure Monitor Logs",
        "Use macros in Logs queries"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/query-editor/index.md",
        "gitBlobSha": "7e9d70541f1e4e273a619ba9e62b5958327ea3ee",
        "sha256": "06c986577af5c0ca3965b3815e378dc6ecf5d82a71accceca9354c5baeafb011",
        "lineStart": 295,
        "lineEnd": 295,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/azure-monitor/query-editor/index.md#L295-L295"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
