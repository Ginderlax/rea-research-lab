    {
      "id": "grafana.candidate.b482fa2ecee38f380cd9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Select **Begin synchronization** to start the process. After this one time step, all future updates are automatically saved to the local file path and provisioned back to the instance.",
      "headingPath": [
        "Set up file provisioning",
