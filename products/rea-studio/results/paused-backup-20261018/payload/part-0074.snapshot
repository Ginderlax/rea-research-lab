    },
    {
      "id": "grafana.candidate.cc53c27dc21d97e9cf8b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Service accounts only work in the organization they are created for. If you have the same task that is needed for multiple organizations, create service accounts in each organization.",
      "headingPath": [
        "Service accounts",
        "When to use service accounts",
        "Service account limitations"
      ],
      "source": {
        "path": "docs/sources/administration/service-accounts/_index.md",
