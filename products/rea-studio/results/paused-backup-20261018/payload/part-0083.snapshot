"""Independent byte/ZIP backup audit only; no product or candidate execution."""
import sys,json,hashlib,zipfile,gzip,io,stat,re
from pathlib import Path
work=Path(__file__).resolve().parent
stage=work/'cloud-notes-installed-success-20261016-next'
candidate=stage/'public-candidate'
digest=lambda b:hashlib.sha256(b).hexdigest()
pin=lambda b:{'bytes':len(b),'sha256':digest(b)}
def safe(n):
    assert isinstance(n,str) and n and not re.search(r'[\\:\x00-\x1f\x7f]',n)
    assert not n.startswith('/') and all(p and p not in ('.','..') for p in n.split('/'))
    return n
def read(base,n):
    p=base/safe(n)
    assert p.is_relative_to(base) and p.is_file() and not p.is_symlink() and p.stat().st_size<=12*1024*1024
    return p.read_bytes()
authority_raw=(stage/'copy-authority.json').read_bytes();authority=json.loads(authority_raw)
assert len(authority_raw)==35050 and digest(authority_raw).startswith('fb186500')
assert authority['files']==98 and authority['bytes']==5591044
expected_paths=set()
for row in authority['rows']:
    p=safe(row['path']);assert p not in expected_paths;expected_paths.add(p)
    assert row['before'] is None and pin(read(candidate,p))==row['after']
actual_paths={str(p.relative_to(candidate)).replace('\\','/') for p in candidate.rglob('*') if p.is_file()}
assert expected_paths==actual_paths and len(expected_paths)==98
def unzip(raw,expected_count):
    rows={}
    with zipfile.ZipFile(io.BytesIO(raw)) as z:
        assert len(z.infolist())<=1100 and sum(i.file_size for i in z.infolist())<=32*1024*1024
        for i in z.infolist():
            assert not stat.S_ISLNK(i.external_attr>>16)
            if i.is_dir():safe(i.filename.rstrip('/'));continue
            name=safe(i.filename);assert name.casefold() not in {p.casefold() for p in rows}
            assert i.file_size<=8*1024*1024
            content=z.read(i);assert len(content)==i.file_size
            rows[name]=content
    assert len(rows)==expected_count
    return rows
reports=[];total_roles=0;total_members=0;decoded_bytes=0;stored_gzip=0
for descriptor,member_count,artifact in zip(authority['capsules'],[449,495],['12052862392','12052757885']):
    prefix=safe(descriptor['prefix']);base=candidate/prefix
    manifest_raw=read(base,'preservation-manifest.json');assert pin(manifest_raw)==descriptor['manifest']
    manifest=json.loads(manifest_raw);assert manifest['runId']=='38917424088' and str(manifest['artifactId'])==artifact
    assert manifest['sourceCommit']==manifest['testedGitCommit']=='362bda055ac4cf7201b2d6a75a2b30dc6fedb578'
    roles={}
    for row in manifest['records']:
        role=safe(row['sourcePath']);assert role not in roles
        stored=read(base,row['path']);assert pin(stored)=={'bytes':row['storage']['bytes'],'sha256':row['storage']['sha256']}
        assert row['storage']['encoding'] in ('identity','gzip')
        if row['storage']['encoding']=='gzip':
            stored_gzip+=1
            with gzip.GzipFile(fileobj=io.BytesIO(stored)) as g:raw=g.read(12*1024*1024+1)
            assert len(raw)<=12*1024*1024
        else:raw=stored
        assert pin(raw)=={'bytes':row['bytes'],'sha256':row['sha256']}
        roles[role]=raw;decoded_bytes+=len(raw)
    assert len(roles)==descriptor['records'];total_roles+=len(roles)
    rawzip=roles['portable-artifact/complete-github-artifact.zip']
    assert len(rawzip)==manifest['artifactArchiveBytes'] and digest(rawzip)==manifest['artifactSHA256']
    original=read(work/'cloud-verification-backups'/'run-38917424088','artifact-'+artifact+'.zip')
    assert rawzip==original
    outer=unzip(rawzip,1);innername,innerzip=next(iter(outer.items()));assert innername.endswith('.zip')
    members=unzip(innerzip,member_count);total_members+=len(members)
    local_report=json.loads(roles['local/local-installed-notes-backup-verification-v2.json'])
    assert local_report['allCRCAndBytesReadable'] is True and local_report['recordedContractPassed'] is True
    assert len(local_report['files'])==member_count
    listed={r['path']:r for r in local_report['files']};assert set(listed)==set(members)
    for name,raw in members.items():assert pin(raw)=={'bytes':listed[name]['bytes'],'sha256':listed[name]['sha256']}
    retained={n[len('artifact/'):]:raw for n,raw in roles.items() if n.startswith('artifact/')}
    assert len(retained)==descriptor['retainedArtifactFiles']
    for name,raw in retained.items():assert name in members and raw==members[name]
    omitted=manifest['sourceSnapshotIdentitiesInsideCompleteZip']
    assert len(omitted)==descriptor['sourceSnapshotsInsideCompleteZip']
    omitted_names=set()
    for row in omitted:
        name=safe(row['sourcePath']);assert name not in omitted_names;omitted_names.add(name)
        assert name in members and pin(members[name])=={'bytes':row['bytes'],'sha256':row['sha256']}
    assert set(retained).isdisjoint(omitted_names) and set(retained)|omitted_names==set(members)
    reports.append({'role':descriptor['role'],'manifest':pin(manifest_raw),'records':len(roles),'artifactMembers':len(members),'retainedDirectArtifactRoles':len(retained),'sourceRolesRecoverableInsideCompleteZip':len(omitted),'completeZIP':pin(rawzip),'everyZIPCRCAndHashMatched':True})
