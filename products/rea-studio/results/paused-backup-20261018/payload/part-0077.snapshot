    {
      "id": "grafana.candidate.b9073e92fe48dc67836a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The length of time that Grafana maintains idle connections before closing them. Default is `90` seconds. For more information, refer to the [`Transport.IdleConnTimeout`](https://golang.org/pkg/net/http/#Transport.IdleConnTimeout) documentation.",
      "headingPath": [
        "Configure Grafana",
