        "sha256": "40a1d463d9e4ed934cc589acc91dd3389003b006f1e2c5413c162996faf92d1a",
        "lineStart": 141,
        "lineEnd": 141,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-1.md#L141-L141"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.2e8e30564df625d367ae",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To learn more, refer to our [Create and manage reports documentation](../../dashboards/create-reports/).",
      "headingPath": [
        "What’s new in Grafana v10.1",
        "Dashboards and visualizations",
        "Activate draft reports"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-1.md",
        "gitBlobSha": "1cce8d3829f244debae74e6d7e86f19383fbe67b",
        "sha256": "40a1d463d9e4ed934cc589acc91dd3389003b006f1e2c5413c162996faf92d1a",
        "lineStart": 143,
        "lineEnd": 143,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-1.md#L143-L143"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
