import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const here=import.meta.dirname,workspace=path.resolve(here,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)}),prefix='products/rea-studio/results/editor-vault-proof-migration-20261013';async function keep(p,b){const q=path.join(here,p);await fs.mkdir(path.dirname(q),{recursive:true});await fs.writeFile(q,Buffer.isBuffer(b)?b:JSON.stringify(b,null,2)+'\n',{flag:'wx'});}
const plans=[{label:'editor',root:'work/editor-pattern-root-installation-plan-next',pin:'b5e21ff4810e0b92d066a72deeb8bb41538aed48e499a4bcd8774f8322b81996',count:637},{label:'vault',root:'work/vault-group-publication-plan-next',pin:'8a575dd9610bf71a6b81169314d45b023aaff96f629a9648d4af9df5222d9521',count:325}],definitions=[],live=[];
for(const spec of plans){const folder=path.join(workspace,spec.root),mb=await fs.readFile(path.join(folder,'manifest.json'));assert.equal(sha(mb),spec.pin);const m=JSON.parse(mb);assert.equal(m.schema,'rea-strict-work-review/v1');assert.equal(m.inventory.length,spec.count);const names=[];async function walk(p=''){for(const e of await fs.readdir(path.join(folder,p),{withFileTypes:true})){assert.equal(e.isSymbolicLink(),false);const n=p?p+'/'+e.name:e.name;if(e.isDirectory())await walk(n);else{assert.ok(e.isFile());names.push(n);}}}await walk();assert.deepEqual(names.sort(),[...m.inventory.map(r=>r.path),'manifest.json'].sort());for(const r of m.inventory)assert.deepEqual(id(await fs.readFile(path.join(folder,r.path))),{bytes:r.bytes,sha256:r.sha256});await keep('authority/'+spec.label+'-plan-manifest.json.snapshot',mb);const pb=await fs.readFile(path.join(folder,'installation-plan.json'));await keep('authority/'+spec.label+'-installation-plan.json.snapshot',pb);const plan=JSON.parse(pb);definitions.push({...spec,manifest:id(mb),installationPlan:id(pb)});for(const r of plan.rows){const destination=r.livePath??r.target,before=r.before??r.expectedBefore??null,after=r.after??{bytes:r.bytes,sha256:r.sha256},sourcePath=r.sourcePath??r.source;let sourceRoot;if(spec.label==='editor')sourceRoot=r.sourceRoot==='this-plan'?spec.root:r.sourceRoot;else sourceRoot=spec.root;assert.ok(destination.startsWith('products/rea-studio/apps/'+spec.label+'/'));let resolvedSourcePath=sourcePath;if(spec.label==='vault'&&r.sourceRoot!=='this-plan'){resolvedSourcePath='source-proof/payload/'+after.sha256+'.snapshot';assert.ok(m.inventory.some(x=>x.path===resolvedSourcePath&&x.bytes===after.bytes&&x.sha256===after.sha256),'Exact Vault plan payload identity');}const b=await fs.readFile(path.join(workspace,sourceRoot,resolvedSourcePath));assert.deepEqual(id(b),after);await keep('after-image/'+destination+'.snapshot',b);if(before){const old=await fs.readFile(path.join(repo,destination));assert.deepEqual(id(old),before);await keep('before-image/'+destination+'.snapshot',old);}else await assert.rejects(fs.lstat(path.join(repo,destination)),e=>e.code==='ENOENT');live.push({path:destination,before,after,sourceRoot,sourcePath:resolvedSourcePath,originalDeclaredSource:sourcePath,sourcePlan:spec.root});}}
assert.equal(live.length,30);const replacements=live.filter(r=>r.before);assert.equal(replacements.length,8);
const combined='products/rea-studio/results/notes-layout-value-api-combined-20261013',cmBytes=await fs.readFile(path.join(repo,combined,'preservation-manifest.json'));assert.equal(sha(cmBytes),'1826eba75ba777edbe69bdb44874a0827dbf684e9305ea49f51af134549b7004');const cm=JSON.parse(cmBytes);assert.equal(cm.sourceFiles,720);assert.equal(cm.snapshots.length,727);await keep('authority/f0-847-capsule-manifest.json.snapshot',cmBytes);const old720Row=cm.snapshots.find(r=>r.sourcePath==='source-before.json.snapshot');const old720=JSON.parse(await fs.readFile(path.join(repo,combined,old720Row.path)));assert.equal(old720.length,720);await keep('authority/f0-720-before.json.snapshot',Buffer.from(JSON.stringify(old720,null,2)+'\n'));
const api='products/rea-studio/apps/editor/results/position-range-selection-followup/accepted-independent81/current-source/',routes=[];for(const r of replacements){const relative=r.path.slice('products/rea-studio/'.length),image=cm.snapshots.find(s=>s.sourcePath==='source/'+relative+'.snapshot');let alias,authority;if(image){assert.deepEqual({bytes:image.bytes,sha256:image.sha256},r.before);alias=combined+'/'+image.path;authority='fixed-f0-847-source-capsule';}else if(r.path.endsWith('/editor/SEARCH.md')){alias=api+r.path+'.snapshot.snapshot';authority='existing-fixed-API81-source';}else{assert.equal(r.path,'products/rea-studio/apps/vault/README.md');alias=prefix+'/before-images/'+r.path+'.snapshot';authority='new-fixed-Vault-README-before-image';}if(authority!=='new-fixed-Vault-README-before-image')assert.deepEqual(id(await fs.readFile(path.join(repo,alias))),r.before);routes.push({...r,historicalPath:alias,authority,affectedInOld720:old720.some(x=>'products/rea-studio/'+x.path===r.path)});}assert.equal(routes.filter(r=>r.affectedInOld720).length,6);
const devPath='products/rea-studio/results/development-validation.json',dev=await fs.readFile(path.join(repo,devPath));assert.equal(sha(dev),cm.developmentValidationSHA256);const dj=JSON.parse(dev);assert.equal(dj.summary.tests,847);assert.equal(dj.source_files.length,720);await keep('before-image/'+devPath+'.snapshot',dev);
