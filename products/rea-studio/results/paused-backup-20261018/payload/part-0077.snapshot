    },
    {
      "id": "grafana.candidate.336410425dbf8db0c77f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This setting is also important if you have a reverse proxy in front of Grafana that exposes it through a sub-path.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[server]`",
        "`root_url`"
      ],
      "source": {
