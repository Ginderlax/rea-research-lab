import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const own=import.meta.dirname,workspace=path.resolve(own,'../..'),lab=path.join(workspace,'outputs/rea-research-lab'),candidate=path.join(workspace,'work/flow-native-link-next'),sha=b=>createHash('sha256').update(b).digest('hex');async function verify(){const b=await fs.readFile(path.join(candidate,'manifest.json'));assert.equal(sha(b),'0a03866476a81f83762bdfc10d65be639c24f25778b6c03fdac5b9ee906bea5d');const m=JSON.parse(b);assert.equal(m.files,457);for(const r of m.inventory){const bytes=await fs.readFile(path.join(candidate,r.path));assert.equal(bytes.length,r.bytes);assert.equal(sha(bytes),r.sha256);}return{records:m.inventory.length,manifestSHA256:sha(b)};}const before=await verify(),sources=[];
for(const [origin,base,name]of [...['server.mjs','catalog.mjs','lib/storage.mjs','public/index.html','public/studio.mjs','public/style.css'].map(n=>['current-public-shared-host',path.join(lab,'products/rea-studio'),n]),...['client','server','core','native','native-link','native-regex-worker'].map(n=>['frozen-flow457-candidate',path.join(candidate,'candidate/products/rea-studio'),'apps/flow/'+n+'.mjs'])]){const source=path.join(base,name),b=await fs.readFile(source),target=path.join(own,'host',name);if(name==='server.mjs')assert.equal(sha(b),'85fe09b1b52a1d91e9d09c85d99c6e768ac4b793f5d7694a1760a4c0560a0a94');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b,{flag:'wx'});sources.push({origin,source:path.relative(workspace,source).replaceAll('\\','/'),materialized:path.relative(own,target).replaceAll('\\','/'),bytes:b.length,sha256:sha(b)});}const collector=await fs.readFile(path.join(own,'host.mjs'));sources.push({origin:'new-owned-flow-browser-collector',source:path.relative(workspace,path.join(own,'host.mjs')).replaceAll('\\','/'),materialized:'host.mjs',bytes:collector.length,sha256:sha(collector)});assert.equal(sources.length,13);await fs.writeFile(path.join(own,'source-before.json'),JSON.stringify(sources,null,2)+'\n',{flag:'wx'});
const document={rev:'opaque publisher revision',vendor:{untouched:['Flow static-link fixture',17],nativeMetadata:true},flows:[{id:'tab',type:'tab',label:'Owned static links'},{id:'start',type:'inject',z:'tab',name:'Owned manual Inject',props:[],x:120,y:120,wires:[['out']]},{id:'out',type:'link out',z:'tab',name:'Static Out',links:[],x:340,y:120,wires:[['physical-debug']],opaque:{originalOption:['retained',true]}},{id:'in',type:'link in',z:'tab',name:'Static In',links:['out'],x:540,y:120,wires:[['virtual-debug']]},{id:'virtual-debug',type:'debug',z:'tab',name:'Virtual Debug',active:true,tosidebar:true,complete:'true',x:780,y:120,wires:[]},{id:'physical-debug',type:'debug',z:'tab',name:'Overwritten physical Debug',active:true,tosidebar:true,complete:'true',x:780,y:280,wires:[]}]},text='\r\n'+JSON.stringify(document,null,3)+'\r\n';await fs.writeFile(path.join(own,'seed.json'),JSON.stringify({name:'Owned static Link In/Out fixture',text,document,synthetic:true},null,2)+'\n',{flag:'wx'});await fs.writeFile(path.join(own,'expected-info.json'),JSON.stringify({schema:'rea-flow-browser-seed-expectations/v1',initialCompiledConnections:[{source:'out',target:'in'}],initialPhysicalWiresRetained:[['physical-debug']],initialOutgoingList:[],initialIncomingList:['out'],initialRawTextSHA256:sha(text),initiallyDeployed:false,afterDisconnectBothListsEmpty:true,afterConnectBothListsContainPair:true,expectedSuccessfulDebugNode:'virtual-debug',expectedAbsentDebugNode:'physical-debug',expectedLinkOutEvent:'node:out',originalExecutions:0,preparedBrowserAcceptance:false},null,2)+'\n',{flag:'wx'});
const after=await verify();for(const row of sources){const primary=await fs.readFile(path.join(workspace,row.source)),copy=await fs.readFile(path.join(own,row.materialized));assert.equal(sha(primary),row.sha256);assert(primary.equals(copy));}await fs.writeFile(path.join(own,'source-after-preparation.json'),JSON.stringify(sources,null,2)+'\n',{flag:'wx'});const guide=await fs.readFile(path.join(workspace,'work/root-vault-group-edit-browser-review-next/host.mjs'));await fs.writeFile(path.join(own,'collector-provenance.json'),JSON.stringify({schema:'rea-flow-browser-collector-provenance/v1',kind:'Newly authored Flow collector; conceptual lifecycle pattern only, no textual before→after adapter claimed.',guidance:{path:'work/root-vault-group-edit-browser-review-next/host.mjs',bytes:guide.length,sha256:sha(guide)},borrowedVaultDiagnosticFacts:0,host:{bytes:collector.length,sha256:sha(collector)},preparationDiagnostic:'Optional read-only attempted root-flow-link-independent-review-v2/review-validation.json was absent; no candidate/app/host execution. Browser preparation relies directly on immutable457 and exact current runtime/shell sources.'},null,2)+'\n',{flag:'wx'});
await fs.writeFile(path.join(own,'preparation-validation.json'),JSON.stringify({schema:'rea-root-flow-browser-host-preparation/v1',at:new Date().toISOString(),before,after,sources:13,sourceStable:true,preparedOnly:true,hostStarted:false,browserStarted:false,appExecutions:0,originalExecutions:0,productionWrites:0,user4311Touched:false,sharedHostSHA256:'85fe09b1b52a1d91e9d09c85d99c6e768ac4b793f5d7694a1760a4c0560a0a94',transportBridge:false,handlerSubstitutions:0,collector:{bytes:collector.length,sha256:sha(collector)},independentAcceptance:false,browserAcceptance:false},null,2)+'\n',{flag:'wx'});
async function inventory(dir,prefix=''){const rows=[];for(const e of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){if(!prefix&&e.name==='preparation-manifest.json')continue;const p=prefix?prefix+'/'+e.name:e.name;if(e.isDirectory())rows.push(...await inventory(path.join(dir,e.name),p));else{const b=await fs.readFile(path.join(dir,e.name));assert(!(b[0]===77&&b[1]===90));assert(!(b[0]===80&&b[1]===75));rows.push({path:p,bytes:b.length,sha256:sha(b)});}}return rows;}const rows=await inventory(own),manifest=Buffer.from(JSON.stringify({schema:'rea-root-flow-browser-preparation-strict/v1',files:rows.length,preparedOnly:true,inventory:rows},null,2)+'\n');await fs.writeFile(path.join(own,'preparation-manifest.json'),manifest,{flag:'wx'});console.log(JSON.stringify({preparedOnly:true,files:rows.length,manifestSHA256:sha(manifest),collectorSHA256:sha(collector),sourceRoster:13,hostStarted:false,browserStarted:false}));
