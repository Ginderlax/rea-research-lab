    {
      "id": "grafana.candidate.5130ae83061430572abd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use the improved State history view to get insight into how your alert instances behave over time. View information on when a state change occurred, what the previous state was, the current state, any other alert instances that changed their state at the same time, as well as what the query value was that triggered the change.",
      "headingPath": [
        "What’s new in Grafana v10.0",
        "Alerting",
        "State history view"
      ],
      "source": {
