    {
      "id": "grafana.candidate.22709c46b45b705ef633",
      "syntaxRole": "list-item",
      "sourceText": "- Ensure a consistent schema: If possible, configure your query to always return columns, even when no data is present.",
      "headingPath": [
        "SQL expressions",
