import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
const stage=path.dirname(fileURLToPath(import.meta.url)),repo=path.resolve(stage,'../../outputs/rea-research-lab'),hash=bytes=>createHash('sha256').update(bytes).digest('hex'),files=[];
async function collect(relative){for(const entry of await fs.readdir(path.join(repo,relative),{withFileTypes:true})){const name=relative+'/'+entry.name;if(entry.isDirectory())await collect(name);else files.push(name);}}
await collect('products/rea-studio/apps/notes');files.push('products/rea-studio/lib/storage.mjs','products/rea-studio/server.mjs','products/rea-studio/catalog.mjs','products/rea-studio/requirements/workspace-products.json');
const rows=[];for(const relative of files){const bytes=await fs.readFile(path.join(repo,relative)),target=path.join(stage,relative),snapshot=path.join(stage,'baseline',relative+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});await fs.mkdir(path.dirname(snapshot),{recursive:true});await fs.writeFile(snapshot,bytes,{flag:'wx'});if(!relative.includes('/requirements/'))await fs.writeFile(target,bytes,{flag:'wx'});rows.push({path:relative,source:path.join(repo,relative),bytes:bytes.length,sha256:hash(bytes),role:relative.includes('/requirements/')?'Read-only requirement selection baseline':relative.endsWith('oracle-verification.json')?'Exact historical 22-check serializer receipt':'Exact production baseline'});}
const requirements=JSON.parse(await fs.readFile(path.join(repo,'products/rea-studio/requirements/workspace-products.json')));const selected=[];function visit(value){if(!value||typeof value!=='object')return;if(value.id==='joplin.notebooks')selected.push(value);for(const child of Object.values(value))visit(child);}visit(requirements);await fs.writeFile(path.join(stage,'selected-requirements.json'),JSON.stringify({selectedId:'joplin.notebooks',occurrences:selected},null,2)+'\n');await fs.writeFile(path.join(stage,'baseline.json'),JSON.stringify({schema:'rea-notes-notebooks-baseline/v1',createdAt:new Date().toISOString(),sources:rows},null,2)+'\n');console.log(JSON.stringify({baselineFiles:rows.length,selectedContract:'joplin.notebooks'}));
