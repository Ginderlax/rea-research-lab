    {
      "id": "grafana.candidate.b5480768e3b685c29703",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you need a data source you can edit in the UI, add another data source manually that connects to the same backend, then manage it independently of the provisioned data source:",
