    {
      "id": "grafana.candidate.832c65d09f6688993774",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To disable query caching for an entire Grafana instance, set the `enabled` flag to `false` in the `caching` section of [Configure Grafana Enterprise](../../setup-grafana/configure-grafana/enterprise-configuration/#caching). You will no longer see the Cache tab on any data sources, and no data source queries will be cached.",
      "headingPath": [
        "Data source management",
        "Query and resource caching",
        "Disable query caching"
      ],
