    },
    {
      "id": "grafana.candidate.3e68e63f3ea52c673dc1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can pan the panel time range left and right, and zoom it and in and out. This, in turn, changes the dashboard time range.",
