// Work-only release/source preparation. No application or original execution.
import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const here=import.meta.dirname,workspace=path.resolve(here,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),hash=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:hash(b)});
async function keep(p,v){const q=path.join(here,p);await fs.mkdir(path.dirname(q),{recursive:true});await fs.writeFile(q,Buffer.isBuffer(v)?v:JSON.stringify(v,null,2)+'\n',{flag:'wx'});}
const app='products/rea-studio/apps/editor',paths=(await fs.readdir(path.join(repo,app),{withFileTypes:true})).filter(e=>e.isFile()&&/\.(mjs|md)$/.test(e.name)).map(e=>app+'/'+e.name).sort();paths.push('products/rea-studio/lib/storage.mjs','products/rea-studio/server.mjs','products/rea-studio/catalog.mjs');const before=[];
for(const p of paths){const b=await fs.readFile(path.join(repo,p));before.push({path:p,...id(b)});await keep('baseline/'+p+'.snapshot',b);await keep('candidate/'+p,b);}await keep('production-before.json',{at:new Date().toISOString(),rows:before,scope:'All top-level Editor mjs/md plus three explicitly selected host/storage/catalog files; no recursive results/cache/vendor scan.'});
const histories=[['editor-search-next','freeze-manifest.json'],['editor-search-fix-next','freeze-manifest.json'],['editor-search-path-fix-next','freeze-manifest.json'],['editor-save-fix-next','freeze-manifest.json'],['editor-save-correction-independent-review','freeze-manifest.json']],history=[];
for(const[folder,name]of histories){const b=await fs.readFile(path.join(workspace,'work',folder,name));history.push({root:'work/'+folder,manifest:name,...id(b),payloadsNotRecopied:true,historicalBytesNotModified:true});await keep('history/'+folder+'.manifest.snapshot',b);}await keep('history-identities.json',{rows:history,scope:'Exact historical manifest identities retained; full prior stages remain in place/public proof. No new claim of full payload reauthentication or fresh prior behavior execution.'});
const acquisition='work/vscode-original-acquisition-record',mb=await fs.readFile(path.join(workspace,acquisition,'freeze-manifest.json')),m=JSON.parse(mb);assert.equal(m.inventory.length,14);for(const r of m.inventory){const b=await fs.readFile(path.join(workspace,acquisition,r.path));assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});}const validation=await fs.readFile(path.join(workspace,acquisition,'validation.json'));assert.equal(hash(validation),'6e93be73c9fdc10d011272fbbd6a2c5219c01efda0ff614e201b59f821bf028d');await keep('original-acquisition-manifest.snapshot',mb);await keep('original-acquisition-validation.snapshot',validation);
const original='work/original-products/vscode/1.140.0/unpacked',engineRelative='07f806f999/resources/app/node_modules.asar.unpacked/@vscode/ripgrep-universal/bin/win32-x64/rg.exe',inventory=JSON.parse(await fs.readFile(path.join(workspace,acquisition,'unpacked-source-before.json'))),engineRecord=inventory.find(r=>r.path===engineRelative);assert.ok(engineRecord);const engine=await fs.readFile(path.join(workspace,original,engineRelative));assert.deepEqual(id(engine),{bytes:engineRecord.bytes,sha256:engineRecord.sha256});await keep('original-engine.json',{release:'1.140.0',commit:'07f806f999227108933c2e30515b26eecc1fda74',path:original+'/'+engineRelative,identity:engineRecord,version:'ripgrep15.0.0 rev3a612f88b8',versionSource:'Prior authenticated recorded engine invocation, not newly executed in preparation.',acquisitionManifest:id(mb),acquisitionValidation:id(validation),archiveIdentity:{bytes:355156158,sha256:'52f47072473375767d63ea5be9ffb96a3092124223fe5ce036834a299715014e'},archiveHashRecomputedNow:false,originalRuntimeCopied:false,originalInvocations0:true});
const commit='07f806f999227108933c2e30515b26eecc1fda74',files=['src/vs/workbench/services/search/node/ripgrepTextSearchEngine.ts','src/vs/base/common/strings.ts','src/vs/workbench/services/search/common/search.ts','src/vs/workbench/services/search/common/searchExtTypes.ts','LICENSE.txt'],fetched=[];
for(const sourcePath of files){const url='https://raw.githubusercontent.com/microsoft/vscode/'+commit+'/'+sourcePath,r=await fetch(url,{signal:AbortSignal.timeout(30000)});assert.equal(r.status,200,url);const b=Buffer.from(await r.arrayBuffer());assert.ok(b.length<=512*1024);const destination='official-source/'+sourcePath+'.snapshot';await keep(destination,b);fetched.push({sourcePath,url,destination,status:r.status,...id(b),lines:b.toString().split('\n').length});}await keep('official-source-provenance.json',{release:'Visual Studio Code1.140.0',commit,fetched,license:'MIT',runtimeImportsOriginalSources:false,sourceAssisted:true,wholeProductParity:false});
for(const r of before)assert.deepEqual(id(await fs.readFile(path.join(repo,r.path))),{bytes:r.bytes,sha256:r.sha256});await keep('preparation-validation.json',{at:new Date().toISOString(),productionSourceRows:before.length,currentBytesStable:true,historyManifestRows:history.length,acquisition14AndManifestAuthenticated:true,selectedOriginalEngineBytesAuthenticated:true,fetchedOfficialFiles:5,originalInvocations:0,candidateExecutions:0,browser:0,benchmark:0,productionWrites:0});console.log(JSON.stringify({prepared:true,currentRows:before.length,officialFiles5:true,originalInvocations0:true}));
