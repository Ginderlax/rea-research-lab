    {
      "id": "grafana.candidate.862f7f57a3600de554a7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The default, called \"cloud monitoring auto\", uses GCP Google Cloud Monitoring's default groupings. These enable you to compare graphs in Grafana with graphs in the Google Cloud Monitoring UI.",
