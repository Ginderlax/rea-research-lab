        "lineStart": 39,
        "lineEnd": 39,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/dashboards/variables/variable-syntax.md#L39-L39"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
