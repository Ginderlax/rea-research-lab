    {
      "id": "grafana.candidate.c56912b11532aec2bb39",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Optional. If tracking with RudderStack is enabled, you can provide a custom URL to load the SDK for destinations running in device mode. This setting is only valid for RudderStack version 1.1 and higher.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[analytics]`",
