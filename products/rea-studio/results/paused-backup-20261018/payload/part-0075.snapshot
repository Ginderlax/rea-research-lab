    {
      "id": "grafana.candidate.b50d017ab328807fa076",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The **Error** state is triggered when the alert rule fails to evaluate its query or queries successfully.",
      "headingPath": [
        "No Data and Error states",
        "`Error` state"
      ],
      "source": {
        "path": "docs/sources/alerting/fundamentals/alert-rule-evaluation/nodata-and-error-states.md",
        "gitBlobSha": "f2f978a5edf34654e0b6cfc6238773eb52ed2854",
