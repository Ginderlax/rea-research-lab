    {
      "id": "grafana.candidate.89652be01e79f46a6d4e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Sometimes your data is too noisy to quickly grasp what's going on. A common way to address this issue is to calculate the moving mean, or moving average, to filter out some of that noise. Luckily, many data sources already support calculating the moving mean, but when the support is lacking or you're not well versed in the query language, until now, you were stuck with the noise.",
      "headingPath": [
        "What’s new in Grafana v10.3",
        "Dashboards and visualizations",
        "Moving average and trend lines using transformations",
        "Moving average\\*"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-3.md",
        "gitBlobSha": "e43fdcd331e25519da2fbdea223ad59ec4f7ad4c",
        "sha256": "0e1c94c3c83b280306b5bf6a8543bb3a2707c17132691f3d48d3818f08b029c7",
        "lineStart": 85,
        "lineEnd": 85,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-3.md#L85-L85"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.f5438da645702be3f353",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By selecting the **Window functions** mode and using **Mean** as the calculation for the **Add field from calculation** transformation, Grafana adds a field with the moving mean for your selected field.",
      "headingPath": [
        "What’s new in Grafana v10.3",
        "Dashboards and visualizations",
        "Moving average and trend lines using transformations",
        "Moving average\\*"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-3.md",
