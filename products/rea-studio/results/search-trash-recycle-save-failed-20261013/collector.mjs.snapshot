import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const base=path.resolve(import.meta.dirname,'..'),run=path.join(base,'work/search-trash-recycle-save-suite-runs/2026-10-13T01-22-45.832Z'),folder=path.join(base,'outputs/rea-research-lab/products/rea-studio/results/search-trash-recycle-save-failed-20261013'),sha=b=>createHash('sha256').update(b).digest('hex'),json=p=>JSON.parse(fs.readFileSync(p));
assert.equal(fs.existsSync(folder),false);const before=json(path.join(run,'source-before.json')),after=json(path.join(run,'source-after.json')),receipt=json(path.join(run,'attempt-validation.json')),old=new Map(before.map(r=>[r.path,r]));
assert.equal(before.length,709);assert.equal(after.length,710);assert.deepEqual(receipt.summary,{tests:811,pass:810,fail:1,cancelled:0,skipped:0,todo:0,duration_ms:555738.4391});assert.equal(receipt.exitCode,1);assert.equal(receipt.sourceStable,false);
const added=after.filter(r=>!old.has(r.path));assert.equal(added.length,1);assert.equal(added[0].path,'scripts/verify-editor-save-followup.mjs');assert.equal(added[0].sha256,'00c25f3c8dade731d5a60595126bd49a93fec8b9ce395a9c3f529c5896f1634f');for(const r of after.filter(r=>old.has(r.path)))assert.deepEqual(r,old.get(r.path));
const snapshots=[];function save(n,b,sourcePath=n){const p=path.join(folder,n);fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,b,{flag:'wx'});snapshots.push({sourcePath,path:n,bytes:b.length,sha256:sha(b)});}
for(const r of before){const n='source/'+r.path+'.snapshot',b=fs.readFileSync(path.join(run,n));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);save(n+'.snapshot',b,n);}
for(const n of ['runner.mjs.snapshot','source-before.json','source-after.json','stdout.txt','stderr.txt','attempt-validation.json'])save(n+'.snapshot',fs.readFileSync(path.join(run,n)),n);
const transient=fs.readFileSync(path.join(base,'work/editor-save-public-verifier-check/misplaced-verifier.mjs.snapshot'));assert.equal(sha(transient),added[0].sha256);save('transient-after-only/scripts/verify-editor-save-followup.mjs.snapshot',transient,'transient-after-only/scripts/verify-editor-save-followup.mjs');
const diagnostic={schema:'rea-failed-suite-source-census-diagnostic/v1',at:new Date().toISOString(),testFailure:{path:'apps/vault/app.integration.test.mjs',line:47,expected:0,actual:1,interpretation:'Prior permanent-delete expectation conflicts with newly implemented entry recycling; independent targeted reproduction and corrected data-retention assertions are separate follow-up evidence.',accepted:false},sourceCensus:{before:709,after:710,unchangedEnrolledBeforeAfter:709,added,transientFileWasTest:false,creationMetadataRecord:'../editor-save-public-verifier-20261013/frozen/misplaced-source-filesystem-metadata.json.snapshot',removedAfterExactPreservation:true,correctedExclusiveRootVerifier:'../../../scripts/verify-editor-save-followup.mjs'},behavioralRunAccepted:false,developmentReceiptOverwritten:false,fullProductParity:false,universalSuperiority:false};save('diagnostic.json.snapshot',Buffer.from(JSON.stringify(diagnostic,null,2)+'\n'),'diagnostic.json');save('collector.mjs.snapshot',fs.readFileSync(import.meta.filename),'collector.mjs');
assert.equal(snapshots.length,718);const record={schema:'rea-failed-search-trash-recycle-save-suite-preservation/v1',at:new Date().toISOString(),snapshots,summary:receipt.summary,sourceFilesBefore:709,sourceFilesAfter:710,sourceStable:false,unchangedEnrolledSourceFiles:709,behavioralRunAccepted:false,sourceCapturedBeforeExecution:true,sourceSnapshotsInert:true,fullProductParity:false,universalSuperiority:false};const mb=Buffer.from(JSON.stringify(record,null,2)+'\n');fs.writeFileSync(path.join(folder,'preservation-manifest.json'),mb,{flag:'wx'});console.log(JSON.stringify({snapshots:snapshots.length,sha256:sha(mb),accepted:false}));
