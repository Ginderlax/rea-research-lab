import test,{after}from'node:test';import assert from'node:assert/strict';import fs from'node:fs/promises';import path from'node:path';import *as candidate from'../editor-position-range-selection-fix-next/position-range-selection.mjs';import{original,oracleTelemetry}from'./oracle.mjs';
const control=await original({label:'unmodified-script-descriptor-control'}),strict=await original({label:'fresh-source-module-strict-library',strictModule:true}),observations=[],counts={originalDispatches:0,candidateDispatches:0,exactPairs:0,unequalPairs:0};
function encode(v){if(v===undefined)return{special:'undefined'};if(typeof v==='number'&&Object.is(v,-0))return{special:'-0'};if(typeof v==='number'&&!Number.isFinite(v))return{special:String(v)};if(Array.isArray(v))return v.map(encode);if(v&&typeof v==='object')return Object.fromEntries(Object.entries(v).map(([k,x])=>[k,encode(x)]));return v;}
const state=v=>{const keys=['line','character','start','end','anchor','active','isEmpty','isSingleLine','isReversed'],out={};for(const k of keys)if(k in v){const x=v[k];out[k]=x&&typeof x==='object'?{line:x.line,character:x.character}:x;}return out;};
function pair(label,fn,{errorTypeOnly=false}={}){const rows={};for(const[role,api]of[['original',strict.api],['candidate',candidate]]){counts[role+'Dispatches']++;try{rows[role]={ok:true,value:encode(fn(api))};}catch(e){rows[role]={ok:false,error:{name:e.name,message:e.message}};}}const compared=errorTypeOnly?Object.fromEntries(Object.entries(rows).map(([k,r])=>[k,r.ok?r:{ok:false,error:{name:r.error.name}}])):rows;let exact=true;try{assert.deepEqual(compared.candidate,compared.original);}catch{exact=false;}counts[exact?'exactPairs':'unequalPairs']++;observations.push({label,...rows,comparison:errorTypeOnly?'Error rejection type only; engine raw labels retained':'Exact value/library error',exact});assert.deepEqual(compared.candidate,compared.original,label);}
function describeDescriptor(d){return d?Object.fromEntries(Object.entries(d).map(([k,v])=>[k,typeof v==='function'?{type:'function',name:v.name,length:v.length}:typeof v==='object'&&v!==null?{type:'object'}:v])):null;}
const args=t=>t==='Position'?[12,17]:[12,17,4,29];
test('source-module strictness preserves released helper descriptors while the script-only control is disclosed',()=>{for(const type of['Position','Range','Selection'])for(const mode of['call','apply']){const a=control.api[type][mode],b=strict.api[type][mode],c=candidate[type][mode];observations.push({label:'strictness control '+type+'.'+mode,nonstrictOwnKeys:Reflect.ownKeys(a),strictOwnKeys:Reflect.ownKeys(b),candidateOwnKeys:Reflect.ownKeys(c)});assert(Object.hasOwn(a,'arguments'));assert(!Object.hasOwn(b,'arguments'));assert(!Object.hasOwn(c,'arguments'));}});
test('six regular helpers expose exact constructibility/property/name/length/prototype descriptors',()=>{for(const type of['Position','Range','Selection'])for(const mode of['call','apply'])pair('helper descriptors '+type+'.'+mode,a=>{const T=a[type],f=T[mode];return{typeProperty:describeDescriptor(Object.getOwnPropertyDescriptor(T,mode)),keys:Reflect.ownKeys(f).map(String),descriptors:Object.fromEntries(Reflect.ownKeys(f).map(k=>[String(k),describeDescriptor(Object.getOwnPropertyDescriptor(f,k))])),prototypeConstructor:f.prototype.constructor===f};});});
test('fresh Reflect.construct helper calls use captured receiver constructor even with different helper newTarget',()=>{for(const type of['Position','Range','Selection'])for(const mode of['call','apply'])pair('construct distinct newTarget '+type+'.'+mode,a=>{const T=a[type];function ReceiverTarget(){}ReceiverTarget.prototype=Object.create(T.prototype);ReceiverTarget.prototype.constructor=ReceiverTarget;function HelperNewTarget(){}const receiver={constructor:ReceiverTarget,owned:true},input=mode==='call'?[receiver,...args(type)]:[receiver,args(type)],v=Reflect.construct(T[mode],input,HelperNewTarget);return{value:state(v),receiverTarget:v instanceof ReceiverTarget,helperNewTarget:v instanceof HelperNewTarget,base:v instanceof T,receiverKeys:Object.keys(receiver),fields:Object.keys(v)};});});
test('ES5 call/apply supports a subclass chain without mutating original receiver',()=>{for(const type of['Position','Range','Selection'])for(const mode of['call','apply'])pair('ES5 subclass chain '+type+'.'+mode,a=>{const T=a[type];function Child(){return mode==='call'?T.call(this,...args(type)):T.apply(this,args(type));}Child.prototype=Object.create(T.prototype);Child.prototype.constructor=Child;function GrandChild(){const receiver=this;const value=Child.call(this);return{value,receiver};}GrandChild.prototype=Object.create(Child.prototype);GrandChild.prototype.constructor=GrandChild;const {value,receiver}=new GrandChild();return{state:state(value),grandChild:value instanceof GrandChild,child:value instanceof Child,base:value instanceof T,receiverUnmodified:Object.keys(receiver).length===0,valueIsReceiver:value===receiver};});});
test('Reflect.apply and Function.prototype.call ignore helper this and retain closure target',()=>{for(const type of['Position','Range','Selection'])for(const mode of['call','apply'])pair('helper this binding '+type+'.'+mode,a=>{const T=a[type],receiver={constructor:T},params=mode==='call'?[receiver,...args(type)]:[receiver,args(type)],v=Reflect.apply(T[mode],{constructor:function Irrelevant(){}},params),w=Function.prototype.call.call(T[mode],null,...params);return{value:state(v),second:state(w),base:v instanceof T&&w instanceof T};});});
test('array-like apply arguments preserve length/index read order and constructor getter effects',()=>{for(const type of['Position','Range','Selection'])pair('array-like apply '+type,a=>{const log=[],values=args(type),receiver={get constructor(){log.push('constructor');return a[type];}},list={get length(){log.push('length');return values.length;}};values.forEach((v,i)=>Object.defineProperty(list,i,{get(){log.push('index'+i);return v;}}));const value=a[type].apply(receiver,list);return{state:state(value),log};});});
test('empty argument and malformed receiver/newTarget cases retain exact rejection type and source state',()=>{for(const type of['Position','Range','Selection'])for(const mode of['call','apply']){pair('empty helper '+type+'.'+mode,a=>state(a[type][mode]()));for(const constructor of[{},()=>{},null])pair('invalid constructor '+type+'.'+mode+' '+String(constructor),a=>{const receiver={constructor};return state(mode==='call'?a[type].call(receiver,...args(type)):a[type].apply(receiver,args(type)));},{errorTypeOnly:true});}for(const mode of['call','apply'])pair('null receiver '+mode,a=>a.Position[mode](null),{errorTypeOnly:true});});
test('native subclass newTarget fields shadow inherited setters and preserve ordinary helper-created instances',()=>{for(const type of['Position','Range','Selection'])pair('subclass own fields '+type,a=>{const T=a[type],field=type==='Position'?'_line':'_start';class Child extends T{}Object.defineProperty(Child.prototype,field,{set(){throw Error('Owned setter must be shadowed');},configurable:true});const v=T.apply({constructor:Child},args(type));return{state:state(v),child:v instanceof Child,descriptor:describeDescriptor(Object.getOwnPropertyDescriptor(v,field))};});});
test('documented accessor descriptors and inherited Selection methods preserve return types and aliases',()=>{pair('accessor census',a=>Object.fromEntries(['Position','Range','Selection'].map(type=>[type,Object.fromEntries(Object.getOwnPropertyNames(a[type].prototype).filter(k=>Object.getOwnPropertyDescriptor(a[type].prototype,k).get).map(k=>[k,describeDescriptor(Object.getOwnPropertyDescriptor(a[type].prototype,k))]))])));pair('selection inherited returns',a=>{const s=new a.Selection(21,4,19,12),r=new a.Range(18,0,22,0),same=s.with(),union=s.union(r),intersection=s.intersection(r),changed=s.with(new a.Position(17,0));return{state:state(s),same:same===s,unionIsOther:union===r,intersectionIsRange:intersection instanceof a.Range,intersectionIsSelection:intersection instanceof a.Selection,changedKind:changed.constructor.name,changed:state(changed),contains:s.contains(new a.Position(20,0))};});});
after(async()=>{const target=process.env.EDITOR_API_REVIEW_OUTPUT;assert(target);await fs.mkdir(target,{recursive:true});await fs.writeFile(path.join(target,'comparisons.json'),JSON.stringify({counts,oracleTelemetry,observations,rawReadonlyEngineLabelEquivalence:false,sourceModuleStrictnessExplicit:true,originalWorkbench:0,originalExtensionHost:0,originalGUI:0,benchmarks:0},null,2)+'\n',{flag:'wx'});console.log('FRESH_EDITOR_API '+JSON.stringify(counts));});
