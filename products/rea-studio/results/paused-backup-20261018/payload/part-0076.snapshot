    },
    {
      "id": "grafana.candidate.0325294b6e059c4c2958",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To reduce the repetition of selecting and removing the same labels when examining multiple log context windows, Grafana stores your selected labels and applies them to each open context window. This lets you navigate through various log context windows without having to reapply your filters.",
      "headingPath": [
        "Loki query editor",
        "Create a log query",
        "Show log context"
      ],
      "source": {
