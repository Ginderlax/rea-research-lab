    {
      "id": "grafana.candidate.600b3fd1d2ded4b2893b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If an alert rule changes (except for updates to annotations, the evaluation interval, or other internal fields), its alert instances reset to the **Normal** state, and update accordingly during the next evaluation.",
      "headingPath": [
        "Alert rule evaluation",
        "Alerting lifecycle"
      ],
      "source": {
        "path": "docs/sources/alerting/fundamentals/alert-rule-evaluation/_index.md",
