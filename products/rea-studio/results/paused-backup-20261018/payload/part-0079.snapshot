    {
      "id": "grafana.candidate.bdb718f5d2b9719f0c31",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can also create annotations in the new Time series panel bringing it closer to parity with the legacy Graph panel. To learn more, refer to the [time series panel](../../panels-visualizations/visualizations/time-series/).",
      "headingPath": [
        "What's new in Grafana v8.1",
        "Annotation panel",
        "Time series panel updates"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-1.md",
