    {
      "id": "grafana.candidate.f852558522c37915b2ae",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A team is a group of users within an organization that have common dashboard and data source permission needs. For example, instead of assigning five users access to the same dashboard, you can create a team that consists of those users and assign dashboard permissions to the team. A user can belong to multiple teams.",
      "headingPath": [
        "Roles and permissions",
        "Teams and permissions"
      ],
