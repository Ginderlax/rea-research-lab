import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import fs from 'node:fs/promises';
import path from 'node:path';
import {spawn} from 'node:child_process';
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab'),studio=path.join(lab,'products/rea-studio'),publicRoot=path.join(studio,'apps/notes/results/notebooks-followup'),run=path.join(work,'notes-notebooks-production-runs',new Date().toISOString().replaceAll(':','-')),sha=b=>createHash('sha256').update(b).digest('hex');await fs.mkdir(run,{recursive:true});
const manifestBytes=await fs.readFile(path.join(publicRoot,'preservation-manifest.json'));assert.equal(sha(manifestBytes),'972d6a3b06ddf435bd9cdbae156458002d48d7d6484c368a74aec8a8f7ab1549');const manifest=JSON.parse(manifestBytes);
async function authenticate(){for(const e of manifest.snapshots){const b=await fs.readFile(path.join(publicRoot,e.path));assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256);}for(const e of manifest.copies){const b=await fs.readFile(path.join(lab,e.path));assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256);}}
await authenticate();
const heldOriginal=await fs.readFile(path.join(work,'notes-notebooks-production-adapter/held-review.mjs'),'utf8'),oldPrefix="const work=import.meta.dirname,stage=work,out=path.join(work,'.local/root-held-review')",nextPrefix="const work=import.meta.dirname,stage=path.resolve(work,'../outputs/rea-research-lab'),out=path.join(work,'notes-notebooks-production-held-review')";assert.equal(heldOriginal.split(oldPrefix).length,2);const held=heldOriginal.replace(oldPrefix,nextPrefix).replace('productionChanged:false','productionIntegrationAlreadyInstalled:true,productionModulesImported:true');assert.equal(held.slice(held.indexOf('function gate()'),held.indexOf('const observations=')),heldOriginal.slice(heldOriginal.indexOf('function gate()'),heldOriginal.indexOf('const observations=')));const heldPath=path.join(work,'notes-notebooks-production-held-review.mjs');await fs.writeFile(heldPath,held,{flag:'wx'});await fs.writeFile(path.join(run,'held-adaptation.json'),JSON.stringify({historicalSourceSHA256:sha(Buffer.from(heldOriginal)),productionSourceSHA256:sha(Buffer.from(held)),scenarioBodiesUnchanged:true,pathAndScopeOnly:true},null,2)+'\n');await fs.writeFile(path.join(run,'held-review.mjs.snapshot'),held);
const names=['server.mjs','catalog.mjs','package.json','lib/storage.mjs','public/studio.mjs','public/style.css'];for(const e of await fs.readdir(path.join(studio,'apps/notes'),{withFileTypes:true}))if(e.isFile()&&/\.(mjs|md|json)$/.test(e.name))names.push('apps/notes/'+e.name);names.sort();const fingerprint=async p=>{const b=await fs.readFile(path.join(studio,p));return{path:p,bytes:b.length,sha256:sha(b)};},before=await Promise.all(names.map(fingerprint));for(const e of before){const target=path.join(run,'source',e.path+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,await fs.readFile(path.join(studio,e.path)),{flag:'wx'});}
const runnerBytes=await fs.readFile(import.meta.filename);await fs.writeFile(path.join(run,'verify-notes-notebooks-integration.mjs.snapshot'),runnerBytes);const runtimeSHA=sha(await fs.readFile(process.execPath)),startedAtUtc=new Date().toISOString();
async function child(label,args){const env={...process.env};delete env.NODE_TEST_CONTEXT;const result=await new Promise(resolve=>{const c=spawn(process.execPath,args,{cwd:studio,env,shell:false,windowsHide:true,stdio:['ignore','pipe','pipe']}),out=[],err=[];let failure=null,ob=0,eb=0;const stop=reason=>{failure??=reason;c.kill('SIGKILL');};for(const[s,parts,key,cap]of[[c.stdout,out,'out',8*1024*1024],[c.stderr,err,'err',2*1024*1024]])s.on('data',b=>{const count=key==='out'?ob:eb,take=Math.max(0,Math.min(cap-count,b.length));parts.push(b.subarray(0,take));if(key==='out')ob+=take;else eb+=take;if(take<b.length)stop('retained-output-limit');});c.on('error',e=>failure??=e.message);const timer=setTimeout(()=>stop('180-second owned child deadline'),180000);c.on('close',(exitCode,signal)=>{clearTimeout(timer);resolve({exitCode,signal,failure,stdout:Buffer.concat(out),stderr:Buffer.concat(err)});});});await fs.writeFile(path.join(run,label+'.stdout.txt'),result.stdout);await fs.writeFile(path.join(run,label+'.stderr.txt'),result.stderr);assert.equal(result.failure,null);assert.equal(result.exitCode,0,result.stderr.toString()+result.stdout.toString());return result;}
const selectedTests=['app.test.mjs','app.integration.test.mjs','jex.test.mjs','notebooks.test.mjs','notebooks.integration.test.mjs'].map(n=>'apps/notes/'+n),focused=await child('focused',['--test','--test-concurrency=1','--test-reporter=tap',...selectedTests]),raw=focused.stdout.toString(),summary=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(n=>[n,Number(raw.match(new RegExp('^# '+n+' (\\d+)$','m'))?.[1]??-1)]));assert.deepEqual(summary,{tests:28,pass:28,fail:0,cancelled:0,skipped:0,todo:0});await child('held',[heldPath]);const heldBytes=await fs.readFile(path.join(work,'notes-notebooks-production-held-review/review-validation.json')),heldReceipt=JSON.parse(heldBytes);assert.equal(heldReceipt.independentHeldPersistenceCases,2);assert.equal(heldReceipt.productionModulesImported,true);assert.equal(heldReceipt.sourceBytesStable,true);await fs.writeFile(path.join(run,'held-validation.json'),heldBytes);
const after=await Promise.all(names.map(fingerprint));await fs.writeFile(path.join(run,'source-before.json'),JSON.stringify(before,null,2)+'\n');await fs.writeFile(path.join(run,'source-after.json'),JSON.stringify(after,null,2)+'\n');assert.deepEqual(after,before);await authenticate();assert.equal(sha(await fs.readFile(import.meta.filename)),sha(runnerBytes));assert.equal(sha(await fs.readFile(process.execPath)),runtimeSHA);
const receipt={schema:'rea-notebook-production-integration-validation/v1',startedAtUtc,completedAtUtc:new Date().toISOString(),summary,durationMs:Number(raw.match(/^# duration_ms ([\d.]+)$/m)?.[1]??-1),selectedTests,sourceStable:true,implementationFingerprints:before,runnerSHA256:sha(runnerBytes),runtime:{version:process.version,platform:process.platform,sha256:runtimeSHA},preservationSHA256:sha(manifestBytes),additionalHeldPersistenceCases:2,heldReceiptSHA256:sha(heldBytes),scenarioBodiesUnchanged:true,originalAccounting:{exactComparisons:26,additionalOriginalMoveContractExecutions:2,originalMethodContexts:3,originalFullApplicationExecutions:0,originalDatabaseExecutions:0,originalGuiExecutions:0,fixedClockAndMemoryPersistenceStubs:true},normalTestsWriteAppResults:false,historicalJoplin22ReceiptRebound:false,fullProductParity:false,universalSuperiority:false};const receiptBytes=JSON.stringify(receipt,null,2)+'\n';await fs.writeFile(path.join(run,'validation.json'),receiptBytes);
const retained=[];async function walk(dir,relative=''){for(const e of await fs.readdir(dir,{withFileTypes:true})){const p=relative?relative+'/'+e.name:e.name;if(e.isDirectory())await walk(path.join(dir,e.name),p);else{const b=await fs.readFile(path.join(run,p)),target=path.join(publicRoot,'integration-runs',path.basename(run),p);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b,{flag:'wx'});retained.push({path:'integration-runs/'+path.basename(run)+'/'+p,bytes:b.length,sha256:sha(b)});}}}await walk(run);await fs.writeFile(path.join(publicRoot,'integration-validation.json'),receiptBytes,{flag:'wx'});const runManifest=JSON.stringify({schema:'rea-notebook-production-run-preservation/v1',retained,receiptSHA256:sha(Buffer.from(receiptBytes)),exactCopies:true},null,2)+'\n';await fs.writeFile(path.join(publicRoot,'integration-run-manifest.json'),runManifest,{flag:'wx'});console.log(JSON.stringify({summary,additionalHeldPersistenceCases:2,sourceFiles:before.length,sourceStable:true,receiptSHA256:sha(Buffer.from(receiptBytes)),runManifestSHA256:sha(Buffer.from(runManifest))}));
