    {
      "id": "grafana.candidate.30b1c3945ac07bd582af",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Verify the API token in the PDC agent configuration is valid. If the token has expired or been deleted, generate a new one from your PDC connection page in Grafana Cloud and update the agent configuration.",
      "headingPath": [
        "Troubleshoot InfluxDB data source issues",
        "Connection errors",
        "PDC connection stops working after certificate renewal fails"
