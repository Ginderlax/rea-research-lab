import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const base=path.resolve(import.meta.dirname,'..'),root=path.join(base,'work/sketch-layout-static-route-next'),lab=path.join(base,'outputs/rea-research-lab/products/rea-studio'),candidate=path.join(base,'work/sketch-layout-precision-next/products/rea-studio'),sha=b=>createHash('sha256').update(b).digest('hex');assert.ok(!fs.existsSync(root));fs.mkdirSync(root,{recursive:true});const copied=[];for(const [source,n]of[[lab,'server.mjs'],[lab,'catalog.mjs'],[lab,'lib/storage.mjs'],[candidate,'apps/sketch/client.mjs'],[candidate,'apps/sketch/core.mjs'],[candidate,'apps/sketch/layout.mjs']]){const b=fs.readFileSync(path.join(source,n)),p=path.join(root,'products/rea-studio',n);fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,b,{flag:'wx'});copied.push({path:'products/rea-studio/'+n,source:n,role:source===lab?'current-production':'immutable-candidate188',bytes:b.length,sha256:sha(b)});}fs.mkdirSync(path.join(root,'products/rea-studio/tests'),{recursive:true});fs.writeFileSync(path.join(root,'source-before-prepare.json'),JSON.stringify(copied,null,2)+'\n',{flag:'wx'});fs.copyFileSync(import.meta.filename,path.join(root,'prepare-collector.mjs.snapshot'),fs.constants.COPYFILE_EXCL);console.log(JSON.stringify({root,sourceFiles:6,productionWrites:0}));
