import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,repo=path.resolve(here,'../../outputs/rea-research-lab'),p='products/rea-studio/STATUS.json',b=await fs.readFile(path.join(repo,p)),record=JSON.parse(b);assert.equal(record.current_milestone_record,'NOTES-LAYOUT-VALUE-API-MILESTONE.md');assert.equal(record.source_stable_combined_checks.pass,847);assert.equal(record.source_stable_combined_checks.source_fingerprints,720);const out=path.join(here,'before-image',p+'.snapshot');await fs.mkdir(path.dirname(out),{recursive:true});await fs.writeFile(out,b,{flag:'wx'});await fs.writeFile(path.join(here,'historical-status-before.json'),JSON.stringify({path:p,bytes:b.length,sha256:createHash('sha256').update(b).digest('hex'),publicPath:'products/rea-studio/results/editor-vault-proof-migration-20261013/before-images/'+p+'.snapshot',historicalF0StatusOnly:true,newCurrentStatusMustBeValidatedSeparately:true,cyclicAfterStatusPin:false},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({historicalF0Status847720Retained:true,bytes:b.length,sha256:createHash('sha256').update(b).digest('hex'),productionWrites:0}));
