    },
    {
      "id": "grafana.candidate.16bf848bc4166b75d08d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "All Grafana users can now use the latest release of [Terraform's Grafana provider](https://registry.terraform.io/providers/grafana/grafana/latest/docs) (version 1.31.1+) to provision [user and team access to service accounts](../../administration/service-accounts/#manage-users-and-teams-permissions-for-a-service-account-in-grafana).",
      "headingPath": [
        "What's new in Grafana v9.3",
        "Users and access",
        "RBAC with Terraform: Extended support for provisioning permissions"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-3.md",
        "gitBlobSha": "acf11473ed5777a12056a218dd89128f81813beb",
        "sha256": "64900ffbe97db576e8db0598932deb044076d62fbd415d6bfd717f2d4b707209",
        "lineStart": 212,
        "lineEnd": 212,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v9-3.md#L212-L212"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.1c890afb0c0893e1360e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This allows full management of service accounts through Terraform - from creating a service account and allowing users to access it to assigning roles to the service account and generating service account tokens.",
      "headingPath": [
        "What's new in Grafana v9.3",
        "Users and access",
        "RBAC with Terraform: Extended support for provisioning permissions"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-3.md",
        "gitBlobSha": "acf11473ed5777a12056a218dd89128f81813beb",
        "sha256": "64900ffbe97db576e8db0598932deb044076d62fbd415d6bfd717f2d4b707209",
        "lineStart": 214,
        "lineEnd": 214,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v9-3.md#L214-L214"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.cca73d9a1a8ecb6177e2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana Enterprise and Cloud Pro and Advanced users can now provision [access to data sources](../../administration/data-source-management/#data-source-permissions) for Grafana's `Viewer`, `Editor`, and `Admin` basic roles, as well as assign `Edit` permission.",
      "headingPath": [
        "What's new in Grafana v9.3",
        "Users and access",
        "RBAC with Terraform: Extended support for provisioning permissions"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-3.md",
