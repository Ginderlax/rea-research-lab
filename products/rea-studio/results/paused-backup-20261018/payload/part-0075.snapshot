    {
      "id": "grafana.candidate.cb46734c61db5aaa9109",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, **No Data** triggers an alert to indicate a potential problem.",
      "headingPath": [
        "Handle missing data in Grafana Alerting",
