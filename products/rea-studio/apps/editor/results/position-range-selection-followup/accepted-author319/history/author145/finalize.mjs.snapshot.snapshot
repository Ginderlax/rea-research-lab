// Authentication and evidence consolidation only; never imports either runtime.
import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const root=path.dirname(fileURLToPath(import.meta.url)),workspace=path.resolve(root,'../..'),hash=b=>createHash('sha256').update(b).digest('hex');
async function identity(p){const b=await fs.readFile(p);return{bytes:b.length,sha256:hash(b)};}
async function read(p){return JSON.parse(await fs.readFile(path.join(root,p)));}
async function write(p,v){await fs.writeFile(path.join(root,p),JSON.stringify(v,null,2)+'\n',{flag:'wx'});}
const acquisition=await read('acquisition.json'),contracts=await read('contracts.json'),attempts=[];
for(let n=1;n<=3;n++){
 const prefix='.local/attempt-0'+n+'/',a=await read(prefix+'attempt.json'),before=await read(prefix+'source-before.json'),after=await read(prefix+'source-after.json');assert.deepEqual(after,before);assert.equal(a.sourceStable,true);for(const s of before){const copy=await identity(path.join(root,prefix,'source-before',s.path+'.snapshot'));assert.deepEqual(copy,{bytes:s.bytes,sha256:s.sha256});}
 const raw=await identity(path.join(root,prefix,'original-comparisons.json'));assert.equal(raw.sha256,a.observation.sha256);assert.equal(raw.bytes,a.observation.bytes);for(const name of['stdout','stderr'])assert.deepEqual(await identity(path.join(root,prefix,name+'.txt')),a[name]);attempts.push({path:prefix+'attempt.json',identity:await identity(path.join(root,prefix,'attempt.json')),tap:a.tap,sourceFiles:a.sourceFiles,sourceStable:true,observations:{path:prefix+'original-comparisons.json',...raw},counts:a.observation.counts,runtime:a.runtime,limitsHit:a.limit,started:a.started,finished:a.finished});
}
assert.deepEqual(attempts[2].tap,{tests:9,pass:9,fail:0,skipped:0});const finalSource=await read('.local/attempt-03/source-before.json'),runtimeFiles=['position-range-selection.mjs','original-oracle.mjs','packet.mjs','compatibility.test.mjs','run.mjs'];for(const p of runtimeFiles){const r=finalSource.find(s=>s.path===p);assert.ok(r);assert.deepEqual(await identity(path.join(root,p)),{bytes:r.bytes,sha256:r.sha256});}for(const a of attempts)assert.equal((await read('.local/'+path.basename(path.dirname(a.path))+'/source-before.json')).find(r=>r.path==='position-range-selection.mjs').sha256,finalSource.find(r=>r.path==='position-range-selection.mjs').sha256);
for(const r of acquisition.records)assert.deepEqual(await identity(path.join(root,r.path)),{bytes:r.bytes,sha256:r.sha256});const shipped=await fs.readFile(path.join(root,'source/shipped-vscode.d.ts.snapshot')),official=await fs.readFile(path.join(root,'source/vscode.d.ts.snapshot'));assert.equal(hash(shipped.toString('utf8').replace(/\r\n/g,'\n')),hash(official));assert.deepEqual(await identity(path.join(workspace,acquisition.shippedDeclaration.sourcePath)),{bytes:acquisition.shippedDeclaration.bytes,sha256:acquisition.shippedDeclaration.sha256});
const prior=path.join(workspace,'work/vscode-original-acquisition-record'),priorManifest=await identity(path.join(prior,'freeze-manifest.json'));assert.equal(priorManifest.sha256,'b592b223568ddc0736f9b6a9509b6eecbf9832b14e361cf31dcbf71878a636ec');const old=JSON.parse(await fs.readFile(path.join(prior,'freeze-manifest.json')));assert.equal(old.files,14);assert.equal(old.inventory.length,14);for(const r of old.inventory){assert.ok(!path.isAbsolute(r.path)&&!r.path.split(/[\\/]/).includes('..'));assert.deepEqual(await identity(path.join(prior,r.path)),{bytes:r.bytes,sha256:r.sha256});}assert.deepEqual(await identity(path.join(root,'authority/original-acquisition-freeze.json.snapshot')),priorManifest);
assert.deepEqual(await identity(attempts[2].runtime.path),{bytes:attempts[2].runtime.bytes,sha256:attempts[2].runtime.sha256});const detail=await read('.local/attempt-03/original-comparisons.json'),errorCount=detail.observations.flatMap(r=>r.original.rows).filter(r=>r.error).length,readonly=detail.observations.flatMap(r=>r.original.rows).filter(r=>r.name.includes('.readonly ')&&r.error).length;assert.equal(readonly,5);assert.equal(contracts.documentedDeclarationEntries,30);assert.equal(contracts.nestedOptionFields,6);
const controls={schema:'rea-editor-value-api-source-authentication/v1',recordedAt:new Date().toISOString(),currentAcquisitionRecords:10,shippedDeclaration:{...acquisition.shippedDeclaration,currentExactBytesAuthenticated:true},priorOriginalAcquisition:{path:'work/vscode-original-acquisition-record/freeze-manifest.json',...priorManifest,strictPayloadsAuthenticated:14,receipt:await identity(path.join(prior,'validation.json')),archiveAndNativeExeFreshlyRead:false,authorityBoundary:'The prior acquisition record binds archive/native/tree/signature/CLI identities. This pass authenticates its complete fourteen evidence payloads, the current shipped declaration and current official source snapshots, not a fresh archive extraction or signature check.'},runtimeCurrentMatchesFinalAttempt:true,testedFiles:await Promise.all(runtimeFiles.map(async p=>({path:p,...await identity(path.join(root,p))}))),sourceAcrossAttemptsCandidateUnchanged:true};await write('final-source-authentication.json',controls);
const failures=[{path:'failures/acquisition-manifest-shape',category:'Acquisition collector shape assumption',originalSourceBodiesEvaluated:0,originalDispatchAttempts:0},{path:'failures/oracle-angle-assertion',category:'Node type stripping does not accept angle assertion syntax',originalSourceBodiesEvaluated:2,originalDispatchAttempts:0},{path:'.local/attempt-01',category:'Verifier cross-realm array prototype mismatch',testPass:4,testFail:5,originalDispatchAttempts:654},{path:'.local/attempt-02',category:'V8 readonly receiver error label depends on VM realm',testPass:8,testFail:1,originalDispatchAttempts:45112},{path:'failures/contracts-nested-options',category:'Declaration census stopped at inner optional-field semicolon',originalSourceBodiesEvaluated:0,originalDispatchAttempts:0}];await write('failure-ledger.json',{schema:'rea-editor-value-api-failures/v1',failures,originalRuntimeCandidateChanges:0,retainedEveryKnownFailedAttempt:true});
const totalDispatch=attempts.reduce((n,a)=>n+a.counts.originalDirectApiAttempts,0),receipt={schema:'rea-editor-position-range-selection-validation/v1',recordedAt:new Date().toISOString(),release:acquisition.release,commit:acquisition.commit,candidate:await identity(path.join(root,'position-range-selection.mjs')),sourceAcquisition:{path:'acquisition.json',...await identity(path.join(root,'acquisition.json'))},declarations:{path:'contracts.json',...await identity(path.join(root,'contracts.json')),classes:3,directEntries:30,nestedOptionFields:6,inheritedRangeEntriesOnSelection:12},focused:attempts[2],allAttempts:attempts,rawOriginalErrorsInFinalPackets:errorCount,readonlyEngineReceiverLabelsNormalizedForComparison:readonly,comparisonNormalization:['Fresh verification-realm arrays for cross-VM values','Only readonly getter-assignment TypeError receiver label: raw observations retain exact original/candidate text'],originalInvocationAccounting:{successfulComposedOraclePreparations:4,failedComposedOraclePreparations:1,successfulSourceLibraryUnitEvaluations:22,successfulVmScriptEvaluations:26,focusedOriginalDirectActionDispatchAttempts:totalDispatch,focusedCandidateDirectActionDispatchAttempts:totalDispatch,successfulSmoke:{stdout:'oracle-smoke.stdout.txt',stderr:'oracle-smoke.stderr.txt',knownDirectActions:4,actions:['Position constructor','Position.toJSON','Selection constructor','Selection.isReversed property probe'],inlineInvocationSourceNotSeparatelyRetained:true},nativeVsCodeExecutableExecutions:0,workbenchExecutions:0,extensionHostExecutions:0,countsAreTransitiveCallCensus:false,qualification:'All three test attempts use five original source-library units and six VM evaluations per preparation. The successful raw smoke uses the same five/six, and the failed type-strip preparation successfully evaluates only errors and ES5 helper. Harness counts are explicit dispatched actions and grouped probes, not nested constructors/getters, runtime/OS process census or full host