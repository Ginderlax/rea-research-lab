    {
      "id": "grafana.candidate.7a7b8b875b40e6d0e492",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The Grafana Foundation SDK is a set of tools, types, and libraries that let you define Grafana dashboards and resources using strongly typed code. By writing your dashboards as code, you can:",
      "headingPath": [
        "Get started with the Grafana Foundation SDK"
