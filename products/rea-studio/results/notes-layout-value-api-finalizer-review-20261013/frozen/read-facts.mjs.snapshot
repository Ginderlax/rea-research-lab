import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,workspace=path.resolve(here,'../..'),lab=path.join(workspace,'outputs/rea-research-lab'),studio=path.join(lab,'products/rea-studio'),sha=b=>createHash('sha256').update(b).digest('hex');function decode(relative){const b=fs.readFileSync(path.join(studio,relative));return{path:'products/rea-studio/'+relative,bytes:b.length,sha256:sha(b),value:JSON.parse(b)};}function published(prefix,source){const m=decode(prefix+'/preservation-manifest.json'),row=m.value.copies.find(r=>r.sourcePath===source);assert(row,source);const b=fs.readFileSync(path.join(studio,prefix,row.path));assert.equal(b.length,row.bytes);assert.equal(sha(b),row.sha256);return{path:'products/rea-studio/'+prefix+'/'+row.path,bytes:b.length,sha256:sha(b),value:JSON.parse(b)};}const facts={notesBrowser:decode('apps/notes/results/inline-confirmation-followup/corrected-browser/validation.json.snapshot'),sketchBrowser:decode('apps/sketch/results/layout-followup/browser/frozen/validation.json.snapshot'),sketchBrowserSources:decode('apps/sketch/results/layout-followup/browser/frozen/source-before.json.snapshot'),sketchFocus:published('results/sketch-layout-installed-focus-20261013','integration-validation.json'),apiFocus:published('results/editor-value-api-installed-focus-20261013','validation.json'),installation:published('results/editor-sketch-reviewed-production-installation-20261013','installation.json')};fs.writeFileSync(path.join(here,'source-facts.json'),JSON.stringify(facts,null,2)+'\n',{flag:'wx'});const script=fs.readFileSync(path.join(workspace,'work/finalize-notes-layout-value-api-checkpoint.mjs'));fs.writeFileSync(path.join(here,'finalizer-reviewed.mjs.snapshot'),script,{flag:'wx'});fs.writeFileSync(path.join(here,'finalizer-source.json'),JSON.stringify({path:'work/finalize-notes-layout-value-api-checkpoint.mjs',bytes:script.length,sha256:sha(script),executed:false},null,2)+'\n',{flag:'wx'});function brief(v,d=0){if(Array.isArray(v))return{arrayLength:v.length};if(v&&typeof v==='object'){if(d>2)return{keys:Object.keys(v)};return Object.fromEntries(Object.entries(v).map(([k,x])=>[k,brief(x,d+1)]));}return v;}console.log(JSON.stringify({sketchFocus:brief(facts.sketchFocus.value),api:{summary:facts.apiFocus.value.summary,sourceStable:facts.apiFocus.value.sourceStable},install:{copies:facts.installation.value.copies.length,installed:facts.installation.value.installed.length,newFiles:facts.installation.value.newProductionFiles,replacements:facts.installation.value.existingReplacements},finalizerSHA256:sha(script)},null,2));
