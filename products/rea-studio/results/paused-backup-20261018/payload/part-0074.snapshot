    {
      "id": "grafana.candidate.00407a033d1e866b3460",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "With the Grafana Helm chart, you can install plugins using one of the methods described in this section. All the YAML snippets install v1.9.0 of the Grafana OnCall App plugin and the Redis data source plugin. When installation is complete you'll get a confirmation message indicating that the plugins were successfully installed.",
      "headingPath": [
        "Install a plugin",
        "Install plugins using the Grafana Helm chart"
      ],
      "source": {
        "path": "docs/sources/administration/plugin-management/plugin-install.md",
