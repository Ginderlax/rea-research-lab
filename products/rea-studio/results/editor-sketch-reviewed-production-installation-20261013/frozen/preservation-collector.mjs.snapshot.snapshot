import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const base=path.resolve(import.meta.dirname,'..'),lab=path.join(base,'outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex');
function files(root,rel=''){return fs.readdirSync(path.join(root,rel),{withFileTypes:true}).flatMap(e=>{assert.ok(!e.isSymbolicLink());const n=rel?rel+'/'+e.name:e.name;assert.ok(!/[\\:\x00-\x1f]/.test(n)&&n.split('/').every(s=>s&&s!=='.'&&s!=='..'));return e.isDirectory()?files(root,n):[n];}).sort();}
const specs=[{folder:'sketch-layout-source-plan-independent-review',manifest:'freeze-manifest.json',pin:'dd196558e07a7568d0424dff0a610a1b18627d0bee0b56c0cbbaad90f6f080c7',count:44,prefix:'products/rea-studio/results/sketch-layout-reviewed-installation-20261013/source-plan-independent-review'},{folder:'editor-value-api-publication-independent-review',manifest:'review-manifest.json',pin:'f3625783c5adf2f0a685b31362569add53c0597b1f5635380c63b441fd3752e0',count:12,prefix:'products/rea-studio/results/editor-value-api-publication-independent-review-20261013'},{folder:'editor-sketch-reviewed-installation-next',prefix:'products/rea-studio/results/editor-sketch-reviewed-production-installation-20261013'}];const out=[];
for(const s of specs){const source=path.join(base,'work',s.folder);let rows,originalManifest=null;if(s.manifest){const b=fs.readFileSync(path.join(source,s.manifest));assert.equal(sha(b),s.pin);const m=JSON.parse(b),raw=m.inventory??m.records;rows=Array.isArray(raw)?raw:Object.entries(raw).map(([path,r])=>({path,...r}));assert.equal(rows.length,s.count);assert.deepEqual(files(source),[...rows.map(r=>r.path),s.manifest].sort());originalManifest={sourcePath:s.manifest,bytes:b.length,sha256:s.pin};rows=[...rows,{path:s.manifest,bytes:b.length,sha256:s.pin}];}else{assert.equal(fs.existsSync(path.join(source,'preservation-source-manifest.json')),false);rows=files(source).map(p=>{const b=fs.readFileSync(path.join(source,p));return{path:p,bytes:b.length,sha256:sha(b)};});const self=fs.readFileSync(import.meta.filename);fs.writeFileSync(path.join(source,'preservation-collector.mjs.snapshot'),self,{flag:'wx'});rows.push({path:'preservation-collector.mjs.snapshot',bytes:self.length,sha256:sha(self)});originalManifest=null;}
assert.equal(fs.existsSync(path.join(lab,s.prefix,'preservation-manifest.json')),false);const copies=[];for(const r of rows){const b=fs.readFileSync(path.join(source,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);assert.ok(!(b[0]===0x4d&&b[1]===0x5a)&&!(b[0]===0x50&&b[1]===0x4b));const n='frozen/'+r.path+'.snapshot',dest=path.join(lab,s.prefix,n);fs.mkdirSync(path.dirname(dest),{recursive:true});fs.writeFileSync(dest,b,{flag:'wx'});copies.push({sourcePath:r.path,path:n,bytes:r.bytes,sha256:r.sha256});}
for(const r of rows){const b=fs.readFileSync(path.join(source,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);}const record={schema:'rea-frozen-followup-public-subset/v1',at:new Date().toISOString(),sourceStage:s.folder,originalFrozenArtifacts:s.count??rows.length,originalManifest,excludedLocalCarriers:[],publicSnapshots:copies.length,allSourceBytesStableBeforeAfter:true,allPublicCopiesExact:true,allSnapshotsInert:true,wholeStagePublic:true,productionInstallations:s.count?0:14,behavioralExecutions:0,originalExecutions:0,browserExecutions:0,fullProductParity:false,universalSuperiority:false,copies};const b=Buffer.from(JSON.stringify(record,null,2)+'\n');fs.writeFileSync(path.join(lab,s.prefix,'preservation-manifest.json'),b,{flag:'wx'});out.push({prefix:s.prefix,copies:copies.length,manifestSHA256:sha(b)});}
console.log(JSON.stringify(out));
