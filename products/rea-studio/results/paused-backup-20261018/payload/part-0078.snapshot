    {
      "id": "grafana.candidate.b154a89ee4f7da38b82e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Explore automatically detects some incorrectly escaped sequences in log lines, such as newlines (`\\n`, `\\r`) or tabs (`\\t`). When it detects such sequences, Explore provides an **Escape newlines** option.",
      "headingPath": [
