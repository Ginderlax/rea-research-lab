    {
      "id": "grafana.candidate.f1afbe09a6b9996f7c35",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Mode `clustered` makes sure that only a maximum of browsers or incognito pages can execute concurrently.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[plugin.grafana-image-renderer]`",
        "`rendering_mode`"
      ],
      "source": {
