    },
    {
      "id": "grafana.candidate.10da06f90f35b1b8a2c4",
      "syntaxRole": "list-item",
      "sourceText": "- Multiple applications use the same permissions, but you want to audit or manage their actions separately.",
      "headingPath": [
        "Plan your IAM integration strategy",
        "Access to external systems",
        "Service accounts",
        "Service account tokens"
      ],
      "source": {
