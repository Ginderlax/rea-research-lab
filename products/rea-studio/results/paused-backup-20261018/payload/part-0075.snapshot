    {
      "id": "grafana.candidate.b19a6aa80d19225c5171",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Public repositories**: Anyone can view the repository contents, including dashboard configurations and any data or queries they contain. Only use public repositories if your dashboards contain no sensitive information.",
