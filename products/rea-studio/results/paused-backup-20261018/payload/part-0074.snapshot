    },
    {
      "id": "grafana.candidate.e2cac2dc528edf20f1b2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana's provisioning system considers any set of characters after an `$` a variable name.",
      "headingPath": [
        "Provision Grafana",
        "Use environment variables",
        "Use of the special character `$`"
      ],
