    {
      "id": "grafana.candidate.84e4d5d2595c4fc938b2",
      "syntaxRole": "list-item",
      "sourceText": "- Check the time range of your dashboard. If your dashboard has a longer time range, such as a week, then you really don't need automated refreshing and you should disable it.",
      "headingPath": [
        "Troubleshoot dashboards",
        "Dashboard refresh rate issues"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/troubleshoot-dashboards/index.md",
