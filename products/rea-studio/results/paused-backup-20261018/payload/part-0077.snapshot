    {
      "id": "grafana.candidate.6dbfb2101182f326dc25",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**macOS:** The default SQLite database is located at `/usr/local/var/lib/grafana`",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[paths]`",
        "`data`"
      ],
