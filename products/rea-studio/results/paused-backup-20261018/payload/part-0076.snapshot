    {
      "id": "grafana.candidate.87b1b2f20dc6ad0ed775",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "TraceQL queries that compare multiple spansets may not correctly return all traces in a cross-tenant query. For instance,",
      "headingPath": [
        "Query tracing data",
        "Cross-tenant TraceQL queries"
      ],
      "source": {
        "path": "docs/sources/datasources/tempo/query-editor/_index.md",
