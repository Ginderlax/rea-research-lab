import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),candidateRoot=path.resolve(here,'../metrics-wrapper-diagnosis-next'),mixedRoot=path.resolve(here,'../metrics-algorithm-measurement-review-next'),old=path.resolve(here,'../metrics-algorithm-measurement-next'),sha=data=>createHash('sha256').update(data).digest('hex'),fp=async file=>{const data=await fs.readFile(file);return {bytes:data.length,sha256:sha(data)};};
const safe=(root,name)=>{const file=path.resolve(root,name),relative=path.relative(root,file);assert.ok(relative&&!path.isAbsolute(relative)&&relative!=='..'&&!relative.startsWith('..'+path.sep));return file;},copies=[];
const preparedClock=await fs.readFile(path.join(here,'memory-preflight.control.json')).then(data=>JSON.parse(data).checkedAt).catch(error=>{if(error.code!=='ENOENT')throw error;return new Date().toISOString();});
const originalClock=await fs.readFile(path.join(here,'original-provenance.json')).then(data=>JSON.parse(data).checkedAt).catch(error=>{if(error.code!=='ENOENT')throw error;return preparedClock;});
async function writeExact(file,data){try{await fs.writeFile(file,data,{flag:'wx'});}catch(error){if(error.code!=='EEXIST')throw error;assert.equal(sha(await fs.readFile(file)),sha(data),'Existing preparation bytes must be exact; never overwrite.');}}
await fs.mkdir(path.join(here,'results'),{recursive:true});
async function copy(root,name,target,expected){const data=await fs.readFile(safe(root,name));if(expected)assert.deepEqual({bytes:data.length,sha256:sha(data)},expected);const file=safe(here,target);await fs.mkdir(path.dirname(file),{recursive:true});await writeExact(file,data);copies.push({sourceRoot:root,sourcePath:name,path:target,bytes:data.length,sha256:sha(data)});return data;}
async function preserve(root,manifestSHA,expectedFiles,prefix){const manifestBytes=await fs.readFile(safe(root,'freeze-manifest.json'));assert.equal(sha(manifestBytes),manifestSHA);const manifest=JSON.parse(manifestBytes);assert.ok(Array.isArray(manifest.entries));assert.equal(manifest.entries.length,expectedFiles);const all=[...manifest.entries,{path:'freeze-manifest.json',bytes:manifestBytes.length,sha256:manifestSHA}],records=[];for(const row of all){assert.ok(!/\.(tgz|exe)$/i.test(row.path));await copy(root,row.path,prefix+'/'+row.path+'.snapshot',{bytes:row.bytes,sha256:row.sha256});records.push(copies.at(-1));}for(const row of all)assert.deepEqual(await fp(safe(root,row.path)),{bytes:row.bytes,sha256:row.sha256});return {sourceRoot:root,manifestSHA256:manifestSHA,inventoryFiles:expectedFiles,totalIncludingManifest:all.length,sourceBeforeAfterStable:true,copies:records};}
const wrapper=await preserve(candidateRoot,'55eea122f303d283c04338d9808859eff7f473dd0139df7c9259ad230a19281d',86,'preserved/wrapper-correctness-stage'),mixed=await preserve(mixedRoot,'ee5683f780ab14007ef8731b07663dc32a1494b8f1b2ec0b43f0f8988ba0308d',2217,'preserved/latest-mixed-study');
const proofBytes=await fs.readFile(safe(candidateRoot,'stage-validation.json'));assert.equal(sha(proofBytes),'7ffee009de87619862896553cab68d7c2284010d81cac0a1a537da195406fdc6');const proof=JSON.parse(proofBytes);assert.equal(proof.semanticComparisonFailures,0);assert.equal(proof.correctnessExecution.childProcesses,4);assert.equal(proof.correctnessExecution.failedChildren,0);
const oldReadinessBytes=await fs.readFile(safe(old,'readiness-validation.json'));assert.equal(sha(oldReadinessBytes),'b6a3faf96d8fcc48158742892e74f2923c8931b25aa84ce00615a3439aee1c2b');const oldReadiness=JSON.parse(oldReadinessBytes);for(const [name,row]of Object.entries(oldReadiness.inventory))assert.deepEqual(await fp(safe(old,name)),row);const oldManifestBytes=await fs.readFile(safe(old,'memory-preflight.control.json'));assert.equal(sha(oldManifestBytes),'fa24a42a8a0c60ce7cf832390e23e0197d7301379203ff302f0a807c2c027b67');const oldManifest=JSON.parse(oldManifestBytes),adaptations=[];
for(const name of ['canonical.mjs','authenticate-original.mjs','workloads.mjs','memory-worker.mjs','timing-worker.mjs','watch-owned-process.ps1','parse-observer.ps1','summary.mjs','summary.test.mjs'])await copy(old,name,name,oldReadiness.inventory[name]);
for(const name of ['memory-runner.mjs','timing-runner.mjs','benchmark.mjs','check-harnesses.mjs','harness.test.mjs','run-readiness.mjs']){const original=(await copy(old,name,'preserved/process-control-baseline/'+name,oldReadiness.inventory[name])).toString();let current=original.replaceAll('candidate-algorithm.mjs','candidate-wrapper.mjs');if(name==='harness.test.mjs'){const before=String.raw`/import \{ singlePercentile, preparePercentileValues \} from '\.\/selector-algorithm\.mjs';/`,after=String.raw`/import \{ singlePercentile \} from '\.\/selector-algorithm\.mjs';/`;assert.ok(current.includes(before));current=current.replace(before,after);}if(name==='benchmark.mjs'){assert.ok(current.includes('prospectiveAlgorithmHypothesis:true'));current=current.replace('prospectiveAlgorithmHypothesis:true','prospectiveAlgorithmHypothesis:false,prospectiveWrapperHypothesis:true');}await writeExact(safe(here,name),current);adaptations.push({path:name,baselineSHA256:sha(original),currentSHA256:sha(current),changes:'Candidate entry filename; exact one-export import assertion; hypothesis annotation only. Operation/measurement loops, schedule, lifecycle, limits and observer unchanged.'});}
for(const name of ['candidate-baseline.mjs','candidate-wrapper.mjs','selector-algorithm.mjs','preserved/sources.json'])await copy(candidateRoot,name,name);
assert.equal((await fp(safe(here,'candidate-wrapper.mjs'))).sha256,proof.candidate.sha256);assert.equal((await fp(safe(here,'selector-algorithm.mjs'))).sha256,proof.candidate.helperSHA256);assert.equal((await fp(safe(here,'candidate-baseline.mjs'))).sha256,proof.productionBaseline.sha256);
await copy(old,'memory-preflight.control.json','preserved/previous-memory-preflight.control.json',oldReadiness.inventory['memory-preflight.control.json']);await copy(old,'readiness-validation.json','preserved/previous-readiness-validation.json',{bytes:oldReadinessBytes.length,sha256:sha(oldReadinessBytes)});
for(const fixture of Object.values(oldManifest.expectedFiles)){await copy(old,fixture.inputPath,fixture.inputPath,{bytes:fixture.inputBytes,sha256:fixture.inputFileSHA256});await copy(old,fixture.path,fixture.path,{bytes:fixture.bytes,sha256:fixture.sha256});}
const correctnessName='preserved/correctness-provenance/algorithm-budget.graph.jsonl';await copy(old,oldManifest.correctnessProvenanceOnly.path,correctnessName,{bytes:4961892,sha256:'f5cc3c4486a3728c9f568251a86ea80c3866ec62c4d454dcafffc989232e43ae'});
const executionBytes=await fs.readFile(safe(candidateRoot,proof.correctnessExecution.path));assert.equal(sha(executionBytes),proof.correctnessExecution.sha256);const execution=JSON.parse(executionBytes);assert.equal(execution.status,'passed');assert.deepEqual(execution.sourceHashesBefore,execution.sourceHashesAfter);assert.equal(execution.sourceHashesBefore['candidate-wrapper.mjs'],proof.candidate.sha256);assert.equal(execution.sourceHashesBefore['selector-algorithm.mjs'],proof.candidate.helperSHA256);assert.ok(execution.records.every(row=>row.exitCode===0&&!row.killed));
const binding={schemaVersion:1,status:'passed',candidate:{entrySHA256:proof.candidate.sha256,helperSHA256:proof.candidate.helperSHA256,baselineSHA256:proof.productionBaseline.sha256},bothNativeModulesBoundBeforeAndAfter:true,failedAcceptanceAttempts:0,sourceStageReceipt:'preserved/wrapper-correctness-stage/stage-validation.json.snapshot',sourceStageReceiptSHA256:sha(proofBytes),sourceStageManifestSHA256:wrapper.manifestSHA256,acceptanceRecords:[{path:'preserved/wrapper-correctness-stage/'+proof.correctnessExecution.path+'.snapshot',sha256:proof.correctnessExecution.sha256}],counts:proof.counts,metadataPreparationErrorsRetainedSeparately:true,fullCampaignReused:true,scope:'Derived guard-shaped binding from authenticated frozen86 wrapper stage and exact four-process correctness receipt; no new full campaign during readiness and no independence claim.'};await fs.mkdir(path.join(here,'preserved'),{recursive:true});await writeExact(safe(here,'preserved/wrapper-binding.json'),JSON.stringify(binding,null,2)+'\n');
const {authenticateOriginal}=await import('./authenticate-original.mjs'),authority=await authenticateOriginal();assert.deepEqual(authority,oldManifest.authority);const runtime={execPath:process.execPath,version:process.version,platform:process.platform,arch:process.arch,versions:process.versions,executableSHA256:sha(await fs.readFile(process.execPath))};assert.deepEqual(runtime,oldManifest.runtime);
const originalCopies=[];for(const [source,digest]of Object.entries(authority.files)){const data=await fs.readFile(source);assert.equal(sha(data),digest);const target='preserved/original-runtime/'+path.basename(source);await fs.mkdir(path.dirname(safe(here,target)),{recursive:true});await writeExact(safe(here,target),data);originalCopies.push({source,path:target,bytes:data.length,sha256:digest});}
const originalProvenance=JSON.parse(await fs.readFile(safe(old,'original-provenance.json')));for(const row of originalProvenance.archives)assert.deepEqual(await fp(row.source),{bytes:row.bytes,sha256:row.sha256});await writeExact(safe(here,'original-provenance.json'),JSON.stringify({schemaVersion:1,checkedAt:originalClock,authority,originalCopies,archives:originalProvenance.archives,originalSourcesAreEvidenceOnly:true,timingMeasurementRun:false,memoryMeasurementRun:false},null,2)+'\n');
const entry=safe(here,'candidate-wrapper.mjs'),helper=safe(here,'selector-algorithm.mjs'),baseline=safe(here,'candidate-baseline.mjs'),implementations={original:authority,baseline:{entry:baseline,format:'esm',files:{[baseline]:proof.productionBaseline.sha256}},candidate:{entry,format:'esm',files:{[entry]:proof.candidate.sha256,[helper]:proof.candidate.helperSHA256},nativeImportGraph:{[entry]:[helper],[helper]:[]}}};
const bindingBytes=await fs.readFile(safe(here,'preserved/wrapper-binding.json')),manifest={...oldManifest,checkedAt:preparedClock,authority,runtime,implementations,fullSemanticReceipt:'preserved/wrapper-binding.json',fullSemanticReceiptSHA256:sha(bindingBytes),selectorSemanticBinding:'Authenticated frozen86 wrapper candidate, exact full/held-out/cache/dispatch correctness and unchanged finite selector helper; hypothesis only, no new full replay in readiness.',correctnessProvenanceOnly:{...oldManifest.correctnessProvenanceOnly,path:correctnessName},warmupCallsExecuted:0,transientCallsExecuted:0,retentionCallsExecuted:0,timingMeasurementRun:false,memoryMeasurementRun:false,profileRun:false,performanceEstablished:false,selectedForIntegration:false};assert.deepEqual(manifest.expectedFiles,oldManifest.expectedFiles);assert.deepEqual(manifest.limits,oldManifest.limits);await writeExact(safe(here,'memory-preflight.control.json'),JSON.stringify(manifest,null,2)+'\n');
assert.deepEqual(await fp(proof.productionBaseline.path),{bytes:proof.productionBaseline.bytes,sha256:proof.productionBaseline.sha256});
for(const [name,row]of Object.entries(oldReadiness.inventory))assert.deepEqual(await fp(safe(old,name)),row);
const preservation={schemaVersion:1,createdAt:new Date().toISOString(),wrapperStage:wrapper,latestMixedStudy:mixed,copies,adaptations,candidateReceiptSHA256:sha(proofBytes),candidateManifestSHA256:wrapper.manifestSHA256,oldReadinessSHA256:sha(oldReadinessBytes),oldManifestSHA256:sha(oldManifestBytes),productionPath:proof.productionBaseline.path,productionSHA256:proof.productionBaseline.sha256,exactSevenWorkloadsAnd14Files:true,new66CorrectnessFixtureNotAWorkload:true,oldFrozenStagesSourceStable:true,timingMeasurementRun:false,memoryMeasurementRun:false,profileRun:false};await fs.writeFile(safe(here,'preservation.json'),JSON.stringify(preservation,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:'prepared',frozenWrapperSnapshotFiles:87,mixedStudySnapshotFiles:2218,activeSourceAndFixtureCopies:copies.length-87-2218,manifestSHA256:sha(await fs.readFile(safe(here,'memory-preflight.control.json'))),measurementRun:false}));
