import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';import os from 'node:os';import path from 'node:path';
import{render}from'./client.mjs';import{handle}from'./server.mjs';import{createWorkspace}from'../../lib/storage.mjs';
class Element{constructor(tag){this.tagName=tag;this.children=[];this.attributes={};this.value='';this.textContent='';this.disabled=false;this.checked=false;this.style={};this.selectionStart=0;this.selectionEnd=0;}append(...nodes){this.children.push(...nodes);}prepend(...nodes){this.children.unshift(...nodes);}replaceChildren(...nodes){this.children=[...nodes];}insertBefore(node,before){const index=this.children.indexOf(before);this.children.splice(index<0?this.children.length:index,0,node);}setAttribute(name,value){this.attributes[name]=value;}focus(){this.focused=true;}setSelectionRange(start,end){this.selectionStart=start;this.selectionEnd=end;}setRangeText(value,start,end){this.value=this.value.slice(0,start)+value+this.value.slice(end);this.selectionStart=this.selectionEnd=start+value.length;}}
const all=root=>[root,...root.children.flatMap(all)],field=(root,label)=>all(root).find(node=>node.attributes['aria-label']===label),button=(root,text)=>all(root).find(node=>node.tagName==='button'&&node.textContent===text),deferred=()=>{let resolve;const promise=new Promise(r=>resolve=r);return{promise,resolve};};
async function fixture(t,wrapper){const rootDir=await fs.mkdtemp(path.join(os.tmpdir(),'rea-search-ui-')),workspace=await createWorkspace(path.join(rootDir,'workspace'));await fs.writeFile(workspace.resolve('a.txt'),'🧪needle\n');await fs.writeFile(workspace.resolve('b.txt'),'second needle\n');const previous={document:globalThis.document,window:globalThis.window};globalThis.document={createElement:tag=>new Element(tag)};globalThis.window={confirm:()=>false};const root=new Element('main'),calls=[],real=async(action,input)=>action==='gitStatus'?{initialized:false}:handle({action,input,workspace}),api=async(action,input)=>{calls.push({action,input:structuredClone(input)});return wrapper?wrapper(action,input,()=>real(action,input)):real(action,input);},cleanup=await render(root,api);t.after(async()=>{cleanup();globalThis.document=previous.document;globalThis.window=previous.window;assert.equal(path.dirname(rootDir),path.resolve(os.tmpdir()));assert.ok(path.basename(rootDir).startsWith('rea-search-ui-'));await fs.rm(rootDir,{recursive:true,force:true});});return{root,workspace,cleanup,calls};}
const search=async root=>{field(root,'Find in saved files').value='needle';await button(root,'Search saved files').onclick();};
test('actual client opens saved results at UTF-16 positions while a dirty existing draft is retained',async t=>{const f=await fixture(t);await search(f.root);await button(f.root,'a.txt:1:3').onclick();const editor=field(f.root,'File contents');assert.equal(editor.value,'🧪needle\n');assert.equal(editor.selectionStart,2);assert.equal(editor.selectionEnd,8);editor.value='private unsaved draft';editor.oninput();await button(f.root,'a.txt:1:3').onclick();assert.equal(editor.value,'private unsaved draft');assert.match(all(f.root).find(node=>node.attributes.role==='status'&&/draft was retained/.test(node.textContent)).textContent,/snapshot/);assert.equal(await fs.readFile(f.workspace.resolve('a.txt'),'utf8'),'🧪needle\n');});
test('changing search options while a response is held invalidates results and re-enables the button',async t=>{const arrived=deferred(),release=deferred();let hold=true;const f=await fixture(t,async(action,input,real)=>{const data=await real();if(action==='search'&&hold){arrived.resolve();await release.promise;}return data;});const pending=search(f.root);await arrived.promise;field(f.root,'Find in saved files').value='second';field(f.root,'Find in saved files').oninput();release.resolve();await pending;assert.equal(field(f.root,'Workspace search results').children.length,0);assert.equal(button(f.root,'Search saved files').disabled,false);hold=false;await button(f.root,'Search saved files').onclick();assert.ok(button(f.root,'b.txt:1:1'));assert.equal(button(f.root,'a.txt:1:3'),undefined);});
test('disposed search views do not publish a held response',async t=>{const arrived=deferred(),release=deferred(),f=await fixture(t,async(action,input,real)=>{const data=await real();if(action==='search'){arrived.resolve();await release.promise;}return data;});const pending=search(f.root);await arrived.promise;f.cleanup();release.resolve();await pending;assert.equal(field(f.root,'Workspace search results').children.length,0);});
test('a new enabled draft cannot be overwritten by an earlier held search-result read',async t=>{const arrived=deferred(),release=deferred(),f=await fixture(t,async(action,input,real)=>{const data=await real();if(action==='read'&&input.path==='a.txt'){arrived.resolve();await release.promise;}return data;});await search(f.root);const pending=button(f.root,'a.txt:1:3').onclick();await arrived.promise;field(f.root,'Relative file path').value='a.txt';await button(f.root,'New file').onclick();const editor=field(f.root,'File contents');editor.value='newer unsaved draft';editor.oninput();release.resolve();await pending;assert.equal(editor.value,'newer unsaved draft');assert.equal(editor.selectionStart,0);assert.equal(await fs.readFile(f.workspace.resolve('a.txt'),'utf8'),'🧪needle\n');});
test('an earlier held result read cannot replace a later selected file',async t=>{const arrived=deferred(),release=deferred(),f=await fixture(t,async(action,input,real)=>{const data=await real();if(action==='read'&&input.path==='a.txt'){arrived.resolve();await release.promise;}return data;});await search(f.root);const pending=button(f.root,'a.txt:1:3').onclick();await arrived.promise;await button(f.root,'b.txt:1:8').onclick();release.resolve();await pending;assert.equal(field(f.root,'File contents').value,'second needle\n');assert.equal(field(f.root,'File contents').selectionStart,7);});
test('a changed disk revision is opened without applying stale result positions',async t=>{const f=await fixture(t);await search(f.root);await fs.writeFile(f.workspace.resolve('a.txt'),'changed on disk\n');await button(f.root,'a.txt:1:3').onclick();assert.equal(field(f.root,'File contents').value,'changed on disk\n');assert.equal(field(f.root,'File contents').selectionStart,0);assert.ok(all(f.root).some(node=>/current draft was retained/.test(node.textContent)));});
test('changed query options prevent an older result read from opening its file or replacing the current draft',async t=>{const arrived=deferred(),release=deferred(),f=await fixture(t,async(action,input,real)=>{const data=await real();if(action==='read'&&input.path==='a.txt'){arrived.resolve();await release.promise;}return data;});field(f.root,'Relative file path').value='b.txt';await button(f.root,'Open file').onclick();await search(f.root);const pending=button(f.root,'a.txt:1:3').onclick();await arrived.promise;field(f.root,'Find in saved files').value='second';field(f.root,'Find in saved files').oninput();const editor=field(f.root,'File contents');editor.value='B draft retained after query change';editor.oninput();release.resolve();await pending;assert.equal(editor.value,'B draft retained after query change');assert.equal(field(f.root,'Workspace search results').children.length,0);});
test('a newer completed search prevents an earlier result read from changing the active file',async t=>{const arrived=deferred(),release=deferred(),f=await fixture(t,async(action,input,real)=>{const data=await real();if(action==='read'&&input.path==='a.txt'){arrived.resolve();await release.promise;}return data;});field(f.root,'Relative file path').value='b.txt';await button(f.root,'Open file').onclick();await search(f.root);const pending=button(f.root,'a.txt:1:3').onclick();await arrived.promise;field(f.root,'Find in saved files').value='second';await button(f.root,'Search saved files').onclick();release.resolve();await pending;assert.equal(field(f.root,'File contents').value,'second needle\n');assert.ok(button(f.root,'b.txt:1:1'));});
