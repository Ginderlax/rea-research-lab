import fs from'node:fs/promises';import path from'node:path';import{fileURLToPath}from'node:url';import{createHash}from'node:crypto';
const own=path.dirname(fileURLToPath(import.meta.url)),sha=b=>createHash('sha256').update(b).digest('hex'),prior=JSON.parse(await fs.readFile(path.join(own,'authority/source-provenance.json.snapshot'),'utf8')),sources=[];
for(const row of prior.files){const b=await fs.readFile(path.join(own,row.path));if(b.length!==row.bytes||sha(b)!==row.sha256)throw new Error('Selected prior source mismatch '+row.path);sources.push({path:row.path,upstreamPath:row.upstreamPath,bytes:b.length,sha256:sha(b)})}
const groupForm='source-study/selected/KeePass/Forms/GroupForm.cs.snapshot',b=await fs.readFile(path.join(own,groupForm));if(b.length!==9171||sha(b)!=='6f541e74d722e24f3ae401a4b2b752f402f48df1d2541dc0e54f22c3a727c610')throw new Error('New original GroupForm mismatch');sources.push({path:groupForm,upstreamPath:'KeePass/Forms/GroupForm.cs',bytes:b.length,sha256:sha(b)});
const manual=JSON.parse(await fs.readFile(path.join(own,'manual-study/manual-contracts.json.snapshot'),'utf8'));function find(obj){if(obj&&typeof obj==='object'){if(Object.values(obj).includes('KPM2611-GROUP-CREATE'))return obj;for(const value of Object.values(obj)){const r=find(value);if(r)return r}}}const contract=find(manual);if(!contract)throw new Error('Preserved manual group creation record missing');
const value={schema:'rea-vault-group-edit-source-study/v1',release:'2.61.1',createdAt:new Date().toISOString(),license:'GPL-2.0-or-later',selectedUniqueSourceFiles:sources.length,sources,manualCreateContract:contract,contracts:[{source:'KeePass/Forms/MainForm.cs',lines:[1356,1380],symbol:'OnGroupAdd',behavior:'Constructor(true,true,New Group,Folder), attach for inherited settings; on OK expand parent; cancel removes newly added group.'},{source:'KeePass/Forms/GroupForm.cs',lines:[210,241],symbol:'OnBtnOK',behavior:'Touch(true,false), raw Name and Notes assignments; remaining editable source settings are preserved but not exposed by this subset.'},{source:'KeePassLib/PwGroup.cs',lines:[306,343,547,568,1277,1302],symbols:['constructors','Touch','AddGroup'],behavior:'Native UUID/time construction, inherited nullable settings and Folder default, selected-only access/modification/uint64 usage touch; ownership append without location update.'},{source:'KeePassLib/Serialization/KdbxFile.Write.cs',lines:[487,519],symbol:'StartGroup',behavior:'Released native metadata field/default encodings.'}],comparisonScope:'Actual pinned managed constructor/AddGroup/Touch and KDBX open/save, source-composed name/notes and explicit synthetic clock/UUID assignments. GroupForm GUI events/full program0; no unrestricted editor equivalence.',unsupported:['icons','parent moves','tags','Auto-Type/search settings','expiry settings','custom data editing','templates','full editor','full parity','universal comparative superiority'],originalCarriersCopied:false};await fs.writeFile(path.join(own,'source-study.json'),JSON.stringify(value,null,2)+'\n');console.log(JSON.stringify({sourceFiles:sources.length,manualContract:'KPM2611-GROUP-CREATE'}));
