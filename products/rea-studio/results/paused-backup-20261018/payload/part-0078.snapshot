    {
      "id": "grafana.candidate.c8fcbb2f3d88d3d41cb3",
      "syntaxRole": "list-item",
      "sourceText": "- Recording rules do not support `condition`, `noDataState`, `execErrState`, or `notification_settings` fields.",
