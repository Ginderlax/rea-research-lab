    },
    {
      "id": "grafana.candidate.61a7c52542db4fcb1aff",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "After you add the variable, a filter bar appears at the top of the dashboard. Viewers can add filters by selecting a label, operator (`=`, `!=`, `=~`, `!~`), and value. Grafana automatically applies these filters to **all** Prometheus queries on the dashboard.",
      "headingPath": [
        "Prometheus template variables",
        "Filters variable"
