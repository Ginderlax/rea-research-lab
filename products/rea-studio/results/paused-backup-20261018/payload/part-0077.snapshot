        "sha256": "b225f8d5068b6e330e18c0916c7295be963d055af907c0790708a7bbd383b7af",
        "lineStart": 211,
        "lineEnd": 211,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/_index.md#L211-L211"
      },
      "applicability": {
        "status": "unresolved-no-explicit-oss-products-label",
        "products": []
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.6418764c21e2c566d999",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana provides many ways to authenticate users. Some authentication integrations also enable syncing user permissions and org memberships.",
      "headingPath": [
        "Configure authentication"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/_index.md",
        "gitBlobSha": "4eaeb6c9573c12f36370a29ae5cde9ef8903af26",
        "sha256": "c0d14f6586dd5c3329bd35640260ccf0154fa243faff94f744821a626f330ebe",
        "lineStart": 19,
        "lineEnd": 19,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/_index.md#L19-L19"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.e633bc26511ce55b11a3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The following table shows all supported authentication methods and the features available for them. [Team sync](../configure-team-sync/), [active sync](enhanced-ldap/#active-ldap-synchronization), and [SAML](saml/) are available in Grafana Enterprise and Grafana Cloud. They aren't available in Grafana open source.",
      "headingPath": [
        "Configure authentication"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/_index.md",
        "gitBlobSha": "4eaeb6c9573c12f36370a29ae5cde9ef8903af26",
        "sha256": "c0d14f6586dd5c3329bd35640260ccf0154fa243faff94f744821a626f330ebe",
        "lineStart": 21,
        "lineEnd": 21,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/_index.md#L21-L21"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.ff2a72ebfda594724ac0",
      "syntaxRole": "table-row",
      "sourceText": "| Authentication method                | Multi Org Mapping | Enforce Sync | Role Mapping | Grafana Admin Mapping | Team Sync | Allowed groups | Active Sync | Skip OrgRole Sync | Auto Login | Single Logout | SCIM support |",
      "headingPath": [
        "Configure authentication"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/_index.md",
        "gitBlobSha": "4eaeb6c9573c12f36370a29ae5cde9ef8903af26",
