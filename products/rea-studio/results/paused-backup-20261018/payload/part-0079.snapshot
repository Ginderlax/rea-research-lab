    },
    {
      "id": "grafana.candidate.c8371ec241d5b7515a0e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Table view was created to help facilitate ease of use in a point and click UI, as opposed to datasource specific query language formatting options, like loki's line_format.",
