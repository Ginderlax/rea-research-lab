import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const here=import.meta.dirname,stage=path.resolve(here,'../editor-search-pattern-next'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),json=v=>Buffer.from(JSON.stringify(v,null,2)+'\n');
async function save(p,b){await fs.mkdir(path.dirname(path.join(here,p)),{recursive:true});await fs.writeFile(path.join(here,p),b,{flag:'wx'});}async function tree(root,prefix=''){const out=[];for(const e of(await fs.readdir(root,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){assert(!e.isSymbolicLink());const p=prefix+e.name;if(e.isDirectory())out.push(...await tree(path.join(root,e.name),p+'/'));else{assert(e.isFile());out.push(p);}}return out;}
const manifestBytes=await fs.readFile(path.join(stage,'freeze-manifest.json'));assert.equal(id(manifestBytes).sha256,'7f975ae3f7a0827f5b9ade231bd121c5b4028f17d88758455fd680962ff0f878');const m=JSON.parse(manifestBytes);assert.equal(m.inventory.length,573);assert.deepEqual((await tree(stage)).sort(),[...m.inventory.map(r=>r.path),'freeze-manifest.json'].sort());const authority=[];for(const r of m.inventory){const b=await fs.readFile(path.join(stage,r.path));assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});authority.push({path:r.path,...id(b)});}await save('author-after-final.json',json(authority));await save('author-manifest.json.snapshot',manifestBytes);
const browser='runs/browser-2026-10-13T04-21-26-695Z';const oldSources=JSON.parse(await fs.readFile(path.join(here,browser,'source-before.json'))),after=[];for(const r of oldSources){const b=await fs.readFile(r.path.startsWith('file:')?new URL(r.path):r.path);after.push({...r,...id(b)});}assert.deepEqual(after,oldSources);await save(browser+'/source-after-external.json',json(after));assert.deepEqual(JSON.parse(await fs.readFile(path.join(here,browser,'author-before.json'))),authority);await save(browser+'/author-after-external.json',json(authority));
