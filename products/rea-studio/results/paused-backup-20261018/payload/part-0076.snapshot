    {
      "id": "grafana.candidate.f571cd59acd9ae903198",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Grant the Cloud Monitoring permissions needed to run queries. How you grant them depends on whether you use service account impersonation:",
      "headingPath": [
        "Google authentication",
        "Use Workload Identity Federation",
        "Configure Google Cloud"
      ],
