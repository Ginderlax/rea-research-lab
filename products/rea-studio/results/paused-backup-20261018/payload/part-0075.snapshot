    {
      "id": "grafana.candidate.d606fb794bd3af898269",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In contact points, you can select notification templates to customize the notification messages sent.",
      "headingPath": [
        "Manage notification templates"
      ],
      "source": {
        "path": "docs/sources/alerting/configure-notifications/template-notifications/manage-notification-templates.md",
