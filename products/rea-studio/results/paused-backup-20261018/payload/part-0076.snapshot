    {
      "id": "grafana.candidate.fa9030f14f1a9d7ba25f",
      "syntaxRole": "table-row",
      "sourceText": "| **Version**               | Select your Graphite version from the drop-down. This controls which functions are available in the Graphite query editor. Use `1.1.x` for Grafana Cloud Graphite.                                                                          |",
      "headingPath": [
