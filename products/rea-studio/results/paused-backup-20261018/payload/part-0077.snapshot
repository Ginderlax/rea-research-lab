    {
      "id": "grafana.candidate.c1c16badc14bb602c131",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The TLS Handshake requires a minimum TLS version. The available options are TLS1.2 and TLS1.3. If you do not specify a version, the system uses TLS1.2.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
