    },
    {
      "id": "grafana.candidate.6e4581021715f9785e62",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "These fields expand the log query time window around the span's start and end timestamps. A span's timestamps are precise to the millisecond, but log lines are often written slightly before or after the span boundary. The default value of `0` can return no logs if timestamps don't align exactly. A common starting point is `-2s` for start shift and `2s` for end shift.",
      "headingPath": [
        "Configure trace to logs correlation",
        "Configure the Tempo data source"
      ],
      "source": {
        "path": "docs/sources/datasources/tempo/configure-tempo-data-source/configure-trace-to-logs.md",
        "gitBlobSha": "79b27dac6a84e3f457842a932b3a17ddb32c8024",
        "sha256": "4d7afd408b01ca0c2aa1c730ba09ae552d1706bd6b64758bccbbe6576f533f78",
        "lineStart": 59,
        "lineEnd": 62,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/tempo/configure-tempo-data-source/configure-trace-to-logs.md#L59-L62"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.1d7d8f4a1cf70aabf1cf",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can increase this value for spans that represent slow or batch operations, for example `5s`.",
      "headingPath": [
        "Configure trace to logs correlation",
        "Configure the Tempo data source"
      ],
      "source": {
        "path": "docs/sources/datasources/tempo/configure-tempo-data-source/configure-trace-to-logs.md",
