    {
      "id": "grafana.candidate.202a13be3f9463f424d5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Telegram messages are limited to 4096 UTF-8 characters. If you use a `parse_mode` other than `None`, truncation may result in an invalid message, causing the notification to fail. For longer messages, we recommend using an alternative contact method.",
