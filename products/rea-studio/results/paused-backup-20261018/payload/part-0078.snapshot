    {
      "id": "grafana.candidate.dc8c8af6eb173c084f0c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "With Explore, you can efficiently monitor, troubleshoot, and respond to incidents by analyzing your logs and identifying the root causes. It also helps you to correlate logs with other telemetry signals such as metrics, traces or profiles, by viewing them side-by-side.",
      "headingPath": [
        "Logs in Explore"
      ],
      "source": {
        "path": "docs/sources/visualizations/explore/logs-integration.md",
        "gitBlobSha": "b7571ffd9ad594743a288d44864ef8345da24da3",
        "sha256": "b0f79a39962e882c64be93fe96137f34e336b4f6ad92fc5cdbdbfb84e3fa0a96",
        "lineStart": 28,
        "lineEnd": 28,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/explore/logs-integration.md#L28-L28"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.d80154b388f3d30b800d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The results of log queries display as individual log lines and as a graph showing the logs volume for the selected time period.",
      "headingPath": [
        "Logs in Explore"
      ],
      "source": {
        "path": "docs/sources/visualizations/explore/logs-integration.md",
        "gitBlobSha": "b7571ffd9ad594743a288d44864ef8345da24da3",
