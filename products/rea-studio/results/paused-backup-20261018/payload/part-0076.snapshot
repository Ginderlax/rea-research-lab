    },
    {
      "id": "grafana.candidate.c7930c7ef55f72225e8e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana recommends that you use the latest available service pack for optimal compatibility.",
      "headingPath": [
        "Configure the Microsoft SQL Server data source",
        "Configure the data source in the UI",
        "Diagnose connection issues"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/configure/index.md",
