assert(!fs.existsSync(stage));assert(!fs.existsSync(path.join(lab,prefix)));fs.mkdirSync(path.join(target,'payload'),{recursive:true});const records=[],objects=new Map(),credentials=/\b(?:ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,}|AKIA[0-9A-Z]{16})\b|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----/;
function save(role,raw){safe(role);assert(!records.some(r=>r.sourcePath===role));assert(!credentials.test(raw.toString('utf8')));let stored=raw,encoding='identity';if(raw.length>65536){const compressed=gzipSync(raw,{level:9});if(compressed.length<raw.length*.85){assert.deepEqual(gunzipSync(compressed),raw);stored=compressed;encoding='gzip';}}const rawPin=id(raw),storedPin=id(stored),name='payload/'+rawPin.sha256+(encoding==='gzip'?'.gz.snapshot':'.snapshot');if(!objects.has(name)){fs.writeFileSync(path.join(target,name),stored,{flag:'wx'});assert.deepEqual(read(target,name),stored);objects.set(name,storedPin);}records.push({sourcePath:role,path:name,...rawPin,storage:{encoding,...storedPin}});}
for(const n of retained)save('artifact/'+n,evidence(n));save('local/local-backup-verification.json',verificationBytes);save('local/collection-summary.json',collectionBytes);save('wrapper/job-'+job+'.txt',read(path.join(work,'cloud-verification-backups/job-'+job),'logs.txt'));for(const kind of ['run','jobs','artifacts'])save('control-plane-completed/'+kind+'.json',metadata[kind].bytes);
