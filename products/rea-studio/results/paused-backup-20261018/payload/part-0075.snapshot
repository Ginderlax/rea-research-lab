    {
      "id": "grafana.candidate.a5264c8f55df45a18bf7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Refer to [Git Sync permissions](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/as-code/observability-as-code/git-sync/permissions-grafana) to understand and set up permissions in Git Sync.",
