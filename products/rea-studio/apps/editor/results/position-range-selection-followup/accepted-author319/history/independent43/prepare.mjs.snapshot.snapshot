import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {root,stage,authenticate,parser,hash} from './authority.mjs';
const before=await authenticate();await fs.mkdir(path.join(root,'source'),{recursive:true});
for(const p of ['freeze-manifest.json','validation.json','acquisition.json','contracts.json','contracts.mjs','position-range-selection.mjs','original-oracle.mjs','packet.mjs','compatibility.test.mjs','README.md','NOTICE.md','source/vscode.d.ts.snapshot','source/LICENSE.txt.snapshot','source/package.json.snapshot','source/commit.json.snapshot','source/shipped-vscode.d.ts.snapshot','source/src/vs/base/common/errors.ts.snapshot',...['es5ClassCompat','position','range','selection'].map(n=>'source/src/vs/workbench/api/common/extHostTypes/'+n+'.ts.snapshot')]){const dest=path.join(root,'source',p+'.snapshot');await fs.mkdir(path.dirname(dest),{recursive:true});await fs.copyFile(path.join(stage,p),dest);}
const acquisition=JSON.parse(await fs.readFile(path.join(stage,'acquisition.json')));assert.equal(acquisition.release,'1.140.0');assert.equal(acquisition.commit,'07f806f999227108933c2e30515b26eecc1fda74');assert.equal(acquisition.records.length,10);for(const r of acquisition.records){assert.match(r.url,/^https:\/\/(?:raw\.githubusercontent\.com\/microsoft\/vscode|api\.github\.com\/repos\/microsoft\/vscode)\//);const b=await fs.readFile(path.join(stage,r.path));assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);}
const declaration=await fs.readFile(path.join(stage,'source/vscode.d.ts.snapshot'),'utf8'),shipped=await fs.readFile(path.join(stage,'source/shipped-vscode.d.ts.snapshot'),'utf8');assert.equal(shipped.replaceAll('\r\n','\n'),declaration);const commit=JSON.parse(await fs.readFile(path.join(stage,'source/commit.json.snapshot')));assert.equal(commit.sha,acquisition.commit);assert.equal(JSON.parse(await fs.readFile(path.join(stage,'source/package.json.snapshot'))).version,acquisition.release);
const ts=await parser(),ast=ts.createSourceFile('vscode.d.ts',declaration,ts.ScriptTarget.Latest,true,ts.ScriptKind.TS);assert.equal(ast.parseDiagnostics.length,0);const selected=[];function visit(n){if(ts.isClassDeclaration(n)&&['Position','Range','Selection'].includes(n.name?.text))selected.push(n);ts.forEachChild(n,visit);}visit(ast);assert.equal(selected.length,3);
const author=JSON.parse(await fs.readFile(path.join(stage,'contracts.json'))),direct=[],options=[];
for(const node of selected)for(const [i,member]of node.members.entries()){
 const name=ts.isConstructorDeclaration(member)?'constructor':member.name.getText(ast),start=member.getStart(ast),end=member.end,text=declaration.slice(start,end),lines={startLine:ast.getLineAndCharacterOfPosition(start).line+1,endLine:ast.getLineAndCharacterOfPosition(end).line+1};
 const id=node.name.text+'.'+name+'.'+(i+1),entry={id,class:node.name.text,member:name,kind:ts.SyntaxKind[member.kind],start,end,utf16Length:end-start,sha256:hash(Buffer.from(text)),signature:text.replace(/\/\*\*[\s\S]*?\*\//g,'').replace(/\s+/g,' ').trim(),...lines};direct.push(entry);const recorded=author.contracts.find(r=>r.id===id);assert.ok(recorded);assert.equal(recorded.signature,entry.signature);assert.equal(recorded.declaration.startLine,lines.startLine);assert.equal(recorded.declaration.endLine,lines.endLine);assert.equal(recorded.declaration.sha256,hash(Buffer.from(declaration)));
 function nested(n){if(ts.isTypeLiteralNode(n))for(const p of n.members){assert.ok(ts.isPropertySignature(p));options.push({parentId:id,name:p.name.getText(ast),optional:Boolean(p.questionToken),start:p.getStart(ast),end:p.end,sha256:hash(Buffer.from(p.getText(ast)))});}ts.forEachChild(n,nested);}nested(member);
}
assert.equal(direct.length,30);assert.deepEqual(Object.fromEntries(selected.map(c=>[c.name.text,c.members.length])),{Position:13,Range:12,Selection:5});assert.equal(options.length,6);assert.ok(options.every(r=>r.optional));
const inherited=direct.filter(r=>r.class==='Range'&&r.member!=='constructor');assert.equal(inherited.length,10);assert.equal(new Set(inherited.map(r=>r.member)).size,9);
const audit={schema:'rea-editor-independent-declaration-audit/v1',at:new Date().toISOString(),before,release:acquisition.release,commit:acquisition.commit,officialRecords:acquisition.records,directEntries:30,options:6,inheritedRangeNonConstructorEntries:10,inheritedRangeDistinctMemberNames:9,records:direct,optionRecords:options,inheritedEntries:inherited.map(r=>({selection:'Selection',inheritedFrom:r.id})),findings:[{id:'EDITOR-INHERITANCE-DENOMINATOR-01',severity:'P2 evidence/accounting',authorClaim:12,actualNonConstructorEntries:10,actualDistinctNames:9,reason:'The two Range constructors are not inherited declaration members. Selection has two direct constructor overload declarations already counted in its five entries.',authorFiles:['contracts.json','contracts.mjs','README.md','validation.json'],runtimeDefectClaim:false},{id:'EDITOR-AUTHOR-CORPUS-LABEL-01',severity:'scope correction',authorLabel:'held-out',independentHeldOutClaimAccepted:false,reason:'All 240 pairs belong to the same author test program and verification campaigns. No independent held-out provenance is shown; this is a separately seeded/shaped author corpus.',runtimeDefectClaim:false}],oracleReview:{sourceLibraryUnits:5,vmEvaluations:6,completeClassBodies:3,exactDecoratorBody:1,illegalArgumentSlice:1,typeAssertionTokensErased:6,moduleComposition:true,originalExtensionHost:false,originalWorkBench:false,normalization:'Only five readonly assignment TypeError receiver labels may be normalized by the author assertion; raw errors remain retained. No explicit library message normalization.',author986PacketsNotReplayed:true},license:{path:'source/LICENSE.txt.snapshot',sha256:'9480271317925265e806a9a196aaa33410a962fa9d4d1e248a4a5187bc8c9df9',license:'MIT',fullNoticeCopied:true},nonGoals:['This d.ts and three value classes do not establish complete workbench/manual/extension API parity.','The review uses its own differential corpus and serializer; the author packet/corpus is not imported or replayed.'],initialDiscoveryMistakes:['Read manifest.json instead of the existing freeze-manifest.json','Looked for an absent parser-provenance.json; actual parser provenance is in prior acquisition/local-only-cache records'],delegationAttempt:'Independent audit delegation was attempted but the four-agent thread limit rejected spawning; no child agent or child execution was created.'};
await fs.writeFile(path.join(root,'declaration-audit.json'),JSON.stringify(audit,null,2)+'\n');assert.deepEqual(await authenticate(),before);console.log(JSON.stringify({strict145Authenticated:true,nodeSHA256:before.node.sha256,directEntries:30,optionFields:6,inheritedEntries:10,distinctInheritedNames:9,confirmedAccountingFindings:1}));
