import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs/promises';import os from'node:os';import path from'node:path';import{randomBytes,createHash}from'node:crypto';import{fileURLToPath}from'node:url';import{spawn}from'node:child_process';
import{exportKdbx,materializeKdbxDocument,decodeKdbxDate}from'./kdbx.mjs';import{createNativeGroup,editNativeGroup}from'./recycle.mjs';import{one,nodes,text,put}from'./xml.mjs';import{fixture,attachmentFixture,edit,ids,now,restoreNow,selection}from'./group-fixture.mjs';
const here=path.dirname(fileURLToPath(import.meta.url)),password='Owned synthetic group original master',oracle=process.env.REA_KEEPASS_EXE??path.resolve(here,'../../../..','projects/07-keepass/artifacts/portable/KeePass.exe'),observationRoot=process.env.GROUP_EDIT_OBSERVATIONS??path.join(os.tmpdir(),'rea-group-edit-original-observations-'+process.pid),observations=[],sha=b=>createHash('sha256').update(b).digest('hex'),newId='30000000-0000-0000-0000-000000000001';// Original bytes are authenticated at each bounded test invocation; default observations are owned temporary output.
const id=b64=>{const h=Buffer.from(b64||Buffer.alloc(16).toString('base64'),'base64').toString('hex');return h.slice(0,8)+'-'+h.slice(8,12)+'-'+h.slice(12,16)+'-'+h.slice(16,20)+'-'+h.slice(20)};
function ownRows(data){const xml=materializeKdbxDocument(data),groups=[],entries=[];function visit(g,parentId){const gid=id(text(one(g,'UUID'))),t=one(g,'Times'),inherit=n=>{const v=text(one(g,n));return !v||v==='null'?null:v==='True'};groups.push({id:gid,parentId,name:text(one(g,'Name')),notes:text(one(g,'Notes')),iconId:Number(text(one(g,'IconID'))||'48'),customIcon:id(text(one(g,'CustomIconUUID'))),expanded:text(one(g,'IsExpanded'))==='True',enableAutoType:inherit('EnableAutoType'),enableSearching:inherit('EnableSearching'),defaultSequence:text(one(g,'DefaultAutoTypeSequence')),lastTopVisible:id(text(one(g,'LastTopVisibleEntry'))),previous:id(text(one(g,'PreviousParentGroup'))),created:decodeKdbxDate(text(one(t,'CreationTime'))),access:decodeKdbxDate(text(one(t,'LastAccessTime'))),modified:decodeKdbxDate(text(one(t,'LastModificationTime'))),location:decodeKdbxDate(text(one(t,'LocationChanged'))),expiry:decodeKdbxDate(text(one(t,'ExpiryTime'))),expires:text(one(t,'Expires'))==='True',usage:text(one(t,'UsageCount'))||'0'});for(const e of nodes(g,'Entry')){const row=data.entries.find(r=>r.id===id(text(one(e,'UUID')))),times=one(e,'Times');entries.push({id:row.id,parentId:gid,title:row.title,password:row.password,created:decodeKdbxDate(text(one(times,'CreationTime'))),modified:decodeKdbxDate(text(one(times,'LastModificationTime'))),history:nodes(one(e,'History'),'Entry').map(h=>{const fields=new Map(nodes(h,'String').map(s=>[text(one(s,'Key')),text(one(s,'Value'))]));return{title:fields.get('Title'),password:fields.get('Password'),modified:decodeKdbxDate(text(one(one(h,'Times'),'LastModificationTime')))}}),binaries:nodes(e,'Binary').map(b=>{const binary=data.kdbx.binaries[Number(one(b,'Value').attrs.Ref)];return{name:text(one(b,'Key')),base64:binary.dataBase64,protected:binary.protected}})});}for(const child of nodes(g,'Group'))visit(child,gid)}visit(one(one(xml,'Root'),'Group'),null);return{groups,entries}}
async function original(t,data,operations,{save=false}={}){assert.equal(sha(await fs.readFile(oracle)),'04d29636c393f0c1fc99ff739295494be3adefded93271e44591e8e300225a5a');const directory=await fs.mkdtemp(path.join(os.tmpdir(),'rea-group-edit-original-'));t.after(async()=>{assert.equal(path.dirname(directory),path.resolve(os.tmpdir()));assert(path.basename(directory).startsWith('rea-group-edit-original-'));await fs.rm(directory,{recursive:true,force:true});});const buffer=await exportKdbx(data,{password},{kdf:'aes',rounds:100,compression:false}),database=path.join(directory,'synthetic.kdbx'),config={oracle,database,password,operations,save};await fs.writeFile(database,buffer);await fs.writeFile(path.join(directory,'config.json'),JSON.stringify(config));const env={...process.env};delete env.NODE_TEST_CONTEXT;const child=spawn('powershell.exe',['-NoProfile','-NonInteractive','-File',path.join(here,'group-edit-oracle.ps1'),'-Config',path.join(directory,'config.json')],{windowsHide:true,env}),chunks={stdout:[],stderr:[]},sizes={stdout:0,stderr:0};let problem;const timer=setTimeout(()=>{problem='Original comparison exceeded30s';child.kill()},30000);for(const channel of['stdout','stderr'])child[channel].on('data',b=>{sizes[channel]+=b.length;if(sizes[channel]>1024*1024){problem='Original1MiB capture limit';child.kill()}else chunks[channel].push(b)});const exit=await new Promise(r=>child.on('close',(code,signal)=>r({code,signal})));clearTimeout(timer);const raw=Object.fromEntries(['stdout','stderr'].map(c=>[c,Buffer.concat(chunks[c]).toString()]));let value;try{value=JSON.parse(raw.stdout.trim())}catch{}observations.push({input:{bytes:buffer.length,sha256:sha(buffer),kdbxVersion:buffer.readUInt32LE(8)},config:{...config,password:'owned synthetic value omitted',database:'owned temporary synthetic.kdbx'},exit,problem:problem??null,raw,value:value??null,assemblyLoads:(raw.stderr.match(/REA_GROUP_EDIT_ASSEMBLY_LOADED_2_61_1/g)||[]).length});await fs.mkdir(observationRoot,{recursive:true});await fs.writeFile(path.join(observationRoot,'group-edit-original.json'),JSON.stringify(observations,null,2)+'\n');assert.equal(exit.code,0,raw.stderr);assert.equal(problem,undefined);assert(value,'Valid actual managed original observation required.');return value;}
function candidate(data,operations){const key=randomBytes(32);for(const op of operations){const row=selection(data,key,op.id),fields={name:op.name,notes:op.notes};data=(op.action==='create'?createNativeGroup(data,op.id,row.recycleRevision,key,fields,{now:op.now,groupId:op.groupId}):editNativeGroup(data,op.id,row.recycleRevision,key,fields,{now:op.now})).data;}return data;}
function compare(data,value){const own=ownRows(data);assert.deepEqual(value.groups,own.groups);assert.deepEqual(value.entries,own.entries);}
test('actual constructor/AddGroup/Touch modified without parents matches selected create defaults and untouched inheritance',async t=>{const data=edit(fixture(),x=>{const parent=nodes(nodes(one(one(x,'Root'),'Group'),'Group')[0],'Group')[0];put(parent,'IsExpanded','False');put(parent,'EnableAutoType','False');put(parent,'EnableSearching','False')}),operations=[{action:'create',id:ids.target,groupId:newId,name:'Created & <node> 🗂',notes:'Owned new group notes',now}],value=await original(t,data,operations);compare(candidate(data,operations),value);assert.equal(value.calls.newGroupConstructor,1);assert.equal(value.calls.touchModifiedNoParents,1);assert.equal(value.calls.addGroup,1);assert.equal(value.calls.originalGUI,0);});
test('actual Touch and name/notes assignments match ancestor rename and preserved descendant history/binaries',async t=>{const data=attachmentFixture(),operations=[{action:'edit',id:ids.target,name:'Renamed exact',notes:'Owned line one\r\nline two',now}],value=await original(t,data,operations);compare(candidate(data,operations),value);assert.equal(value.calls.touchModifiedNoParents,1);assert.equal(value.calls.binaryRead,1);assert.equal(value.calls.addGroup,0);});
test('actual selected subset accepts root, empty, whitespace and duplicate names without normalization',async t=>{for(const [id,name]of[[ids.root,'Renamed root'],[ids.target,''],[ids.target,'  literal name  '],[ids.target,'Other']]){const data=fixture(),operations=[{action:'edit',id,name,notes:'Exact notes',now}],value=await original(t,data,operations);compare(candidate(data,operations),value);}});
test('candidate name/notes/create KDBX is read and saved by actual original with history and protected attachments',async t=>{const data=attachmentFixture(),operations=[{action:'create',id:ids.target,groupId:newId,name:'Empty persisted child',notes:'Owned persisted notes',now},{action:'edit',id:ids.target,name:'Persisted renamed',notes:'Owned simple notes',now:restoreNow}],changed=candidate(data,operations),value=await original(t,changed,[],{save:true});compare(changed,value);assert.equal(value.calls.saveDatabase,1);assert.equal(value.calls.openDatabase,2);assert.equal(value.calls.binaryRead,1);});
