// Source-only payload package rehearsal. No candidate/generator/application execution.
import fs from'node:fs/promises';import path from'node:path';import os from'node:os';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const root=import.meta.dirname,workspace=path.resolve(root,'../..'),hash=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:hash(b)}),copies=JSON.parse(await fs.readFile(path.join(root,'public-copy-list.json'))),map=JSON.parse(await fs.readFile(path.join(root,'public-preservation-map.json'))),excluded=JSON.parse(await fs.readFile(path.join(root,'excluded-generated-fixture-census.json'))),packageRoot=await fs.mkdtemp(path.join(os.tmpdir(),'rea-pattern-public-source-')),rows=[];let passed=false;
try{
 for(const row of copies){assert.ok(!path.isAbsolute(row.publicPath)&&!row.publicPath.split('/').some(x=>x==='..'||x==='.local'||x==='work'||x==='artifacts'||x==='tooling'||x==='node_modules'));const b=await fs.readFile(path.join(workspace,row.sourceRoot,row.sourcePath));assert.deepEqual(id(b),{bytes:row.bytes,sha256:row.sha256});const destination=path.join(packageRoot,row.publicPath);assert.ok(path.relative(packageRoot,destination)&&!path.relative(packageRoot,destination).startsWith('..'));await fs.mkdir(path.dirname(destination),{recursive:true});await fs.writeFile(destination,b,{flag:'wx'});}
 const publicOnly=async sourcePath=>{const row=map.find(x=>x.sourcePath===sourcePath);assert.ok(row,'Reconstruction input must resolve through PUBLIC map: '+sourcePath);const b=await fs.readFile(path.join(packageRoot,row.publicPath));assert.deepEqual(id(b),{bytes:row.bytes,sha256:row.sha256});return{value:JSON.parse(b),publicPath:row.publicPath,...id(b)};};
 for(const row of excluded){const input=await publicOnly(row.reconstruction.input),name=path.basename(row.sourcePath);let value;if(row.reconstruction.kind==='synthetic original-engine input')value=input.value.results.find(x=>x.name===path.basename(name,'.txt')).content;else if(row.reconstruction.kind==='generated committed synthetic fixture mirror')value=input.value[name==='a.txt'?'diskA':'diskB'];else if(row.reconstruction.kind==='deterministic generated comparison input mirror')value=input.value.files[name];else throw Error('Unknown exact reconstruction case');assert.equal(typeof value,'string');const b=Buffer.from(value);assert.deepEqual(id(b),{bytes:row.bytes,sha256:row.sha256});const generator=map.find(x=>x.sourcePath===row.reconstruction.generator);assert.ok(generator,'Generator source must also be PUBLIC mapped');const gb=await fs.readFile(path.join(packageRoot,generator.publicPath));assert.deepEqual(id(gb),{bytes:generator.bytes,sha256:generator.sha256});rows.push({sourcePath:row.sourcePath,expected:{bytes:row.bytes,sha256:row.sha256},actual:id(b),publicInput:{path:input.publicPath,bytes:input.bytes,sha256:input.sha256},publicGenerator:{path:generator.publicPath,bytes:generator.bytes,sha256:generator.sha256},excludedPhysicalFileReadDuringReconstruction:false});}
 passed=true;
}finally{const absolute=path.resolve(packageRoot);assert.equal(path.dirname(absolute),path.resolve(os.tmpdir()));assert.ok(path.basename(absolute).startsWith('rea-pattern-public-source-'));await fs.rm(absolute,{recursive:true,force:true});}
const receipt={schema:'rea-editor-pattern-public-source-reconstruction/v1',at:new Date().toISOString(),passed,uniqueMaterializedPublicPayloads:copies.length,sourceMapRows:map.length,reconstructedExcludedFixtures:rows.length,all82Exact:true,inputsAndGeneratorsResolvedOnlyThroughPublicMap:true,excludedPhysicalFixtureReadsDuringReconstruction:0,originalGeneratorExecutions:0,applicationExecutions:0,tests:0,originalEngineCalls:0,browserCalls:0,benchmarks:0,temporaryPackageRemoved:true,rows};await fs.writeFile(path.join(root,'public-reconstruction-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({passed,publicPayloads:copies.length,excludedFixturesExact:rows.length,excludedPhysicalReads:0,applicationCalls:0,temporaryPackageRemoved:true}));
