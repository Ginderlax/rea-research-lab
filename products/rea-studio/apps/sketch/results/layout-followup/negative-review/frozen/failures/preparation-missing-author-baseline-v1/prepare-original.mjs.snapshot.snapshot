import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,stage=path.resolve(here,'../sketch-alignment-next'),repo=path.resolve(here,'../../outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),provenanceBytes=await fs.readFile(path.join(stage,'source-provenance.json')),provenance=JSON.parse(provenanceBytes),baselineBytes=await fs.readFile(path.join(stage,'source-baseline.json')),baseline=JSON.parse(baselineBytes),rows=[];assert.equal(provenance.release,'@excalidraw/excalidraw 0.18.1');assert.equal(provenance.commit,'a2ec2889babf7d2295469c6d90ebe77fae57df84');assert.equal(provenance.fetched.length,7);assert.equal(baseline.length,14);for(const r of provenance.fetched){const b=await fs.readFile(path.join(stage,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);const target=path.join(here,r.path);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b,{flag:'wx'});rows.push({path:r.path,bytes:b.length,sha256:sha(b),sourcePath:r.sourcePath,url:r.url,scope:'Pinned source-only; no candidate execution'});}for(const r of baseline){const b=await fs.readFile(path.join(stage,'baseline',r.path+'.snapshot'));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);const current=await fs.readFile(path.join(repo,r.path));assert.equal(sha(current),r.sha256);assert.equal(current.length,r.bytes);const rel='baseline/'+r.path+'.snapshot',target=path.join(here,rel);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b,{flag:'wx'});rows.push({path:rel,bytes:b.length,sha256:sha(b),currentPath:r.path});}await fs.writeFile(path.join(here,'source-provenance.json.snapshot'),provenanceBytes,{flag:'wx'});await fs.writeFile(path.join(here,'source-baseline.json.snapshot'),baselineBytes,{flag:'wx'});await fs.writeFile(path.join(here,'original-baseline-authentication.json'),JSON.stringify({schema:'rea-sketch-alignment-independent-original-baseline/v1',at:new Date().toISOString(),release:provenance.release,commit:provenance.commit,originalSourceFiles:7,currentProductionBaseline:14,originalMetadataSHA256:sha(provenanceBytes),baselineMetadataSHA256:sha(baselineBytes),candidateRuntimeRead:false,candidateExecuted:false,originalAppOrGUIExecuted:false,rows},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({authenticatedOriginal7:true,currentBaseline14Exact:true,candidateExecuted:false}));
