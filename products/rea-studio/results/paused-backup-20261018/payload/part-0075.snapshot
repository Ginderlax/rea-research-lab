    },
    {
      "id": "grafana.candidate.0fff6710c188e77c65ff",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Make sure your Git server supports protocol v2 over HTTPS. Some providers, like Azure DevOps, only use v1 and are therefore not compatible with Git Sync.",
      "headingPath": [
        "Usage and performance limitations",
        "Compatible Git providers",
        "The Pure Git repository type"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/git-sync/usage-limits.md",
        "gitBlobSha": "259bfe6ffcef787e176c67fcf3b490f8ca9e966e",
        "sha256": "0cc8f7958ef6206b1f6ae32efdb03081375fab9f7c98f50e4b61847ff95c95ac",
        "lineStart": 157,
        "lineEnd": 157,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/as-code/observability-as-code/git-sync/usage-limits.md#L157-L157"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss",
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.f01be8339f5b5c933f9e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "However, Pure Git doesn't include any features that require provider APIs, such as webhook-driven instant sync, automated PR comments, or deep links to source files.",
      "headingPath": [
        "Usage and performance limitations",
        "Compatible Git providers",
        "The Pure Git repository type"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/git-sync/usage-limits.md",
        "gitBlobSha": "259bfe6ffcef787e176c67fcf3b490f8ca9e966e",
        "sha256": "0cc8f7958ef6206b1f6ae32efdb03081375fab9f7c98f50e4b61847ff95c95ac",
        "lineStart": 161,
        "lineEnd": 161,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/as-code/observability-as-code/git-sync/usage-limits.md#L161-L161"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss",
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.ae8a7011925e05493d42",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If your Git provider is GitHub, GitHub Enterprise (Server and Cloud), GitLab, or Bitbucket, use the enhanced integration. Enhanced integrations understand the platform you're using, allowing workflows that feel native: automated pull request comments with dashboard previews, instant webhook-based sync, or direct navigation from Grafana to source files in your provider's UI.",
      "headingPath": [
        "Usage and performance limitations",
        "Compatible Git providers",
        "Enhanced integrations: GitHub, GitHub Enterprise, GitLab, Bitbucket"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/git-sync/usage-limits.md",
        "gitBlobSha": "259bfe6ffcef787e176c67fcf3b490f8ca9e966e",
        "sha256": "0cc8f7958ef6206b1f6ae32efdb03081375fab9f7c98f50e4b61847ff95c95ac",
        "lineStart": 165,
        "lineEnd": 165,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/as-code/observability-as-code/git-sync/usage-limits.md#L165-L165"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
          "enterprise",
          "oss",
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.aaca8f52ed62ff7e013a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The GitLab and Bitbucket integrations are only available in Grafana Enterprise and Grafana Cloud. While they're less developed for the moment, expect continued improvements around pull request workflows, linking, and sync behavior.",
      "headingPath": [
        "Usage and performance limitations",
        "Compatible Git providers",
        "Enhanced integrations: GitHub, GitHub Enterprise, GitLab, Bitbucket"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/git-sync/usage-limits.md",
        "gitBlobSha": "259bfe6ffcef787e176c67fcf3b490f8ca9e966e",
        "sha256": "0cc8f7958ef6206b1f6ae32efdb03081375fab9f7c98f50e4b61847ff95c95ac",
        "lineStart": 169,
        "lineEnd": 169,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/as-code/observability-as-code/git-sync/usage-limits.md#L169-L169"
      },
      "applicability": {
        "status": "conditional-or-paid-restriction-requires-review",
        "products": [
          "enterprise",
          "oss",
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b65a58ecc53298cbd4ac",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Git Sync only supports dashboards and folders**. Alerts, data sources, panels and other resources are not supported yet.",
      "headingPath": [
        "Usage and performance limitations",
        "Resource support and compatibility"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/git-sync/usage-limits.md",
        "gitBlobSha": "259bfe6ffcef787e176c67fcf3b490f8ca9e966e",
        "sha256": "0cc8f7958ef6206b1f6ae32efdb03081375fab9f7c98f50e4b61847ff95c95ac",
        "lineStart": 173,
        "lineEnd": 173,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/as-code/observability-as-code/git-sync/usage-limits.md#L173-L173"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss",
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.7530915e2c57cf846c60",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you're a Grafana Cloud user, you can check the [Grafana roadmap portal](https://grafana.ideas.aha.io/ideas) to learn about future improvements.",
      "headingPath": [
        "Usage and performance limitations",
        "Resource support and compatibility"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/git-sync/usage-limits.md",
        "gitBlobSha": "259bfe6ffcef787e176c67fcf3b490f8ca9e966e",
        "sha256": "0cc8f7958ef6206b1f6ae32efdb03081375fab9f7c98f50e4b61847ff95c95ac",
        "lineStart": 175,
        "lineEnd": 175,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/as-code/observability-as-code/git-sync/usage-limits.md#L175-L175"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
          "enterprise",
          "oss",
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.f6a5e624e0465c221dc8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you're using Git Sync in Grafana OSS or Grafana Enterprise, some supported resources might be in an incompatible data format. If this happens, syncing will be blocked. Compatibility issues will be fixed with an upcoming migration tool.",
      "headingPath": [
        "Usage and performance limitations",
        "Resource support and compatibility",
        "Resource compatibility"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/git-sync/usage-limits.md",
