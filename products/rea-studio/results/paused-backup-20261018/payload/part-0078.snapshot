    {
      "id": "grafana.candidate.8bb08c9444e5d7a433e8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you create a user they are granted the Viewer role by default, which means that they won't be able to make any changes to any of the resources in Grafana. That's ok for now, you'll grant more user permissions by adding users to _teams_ in the next step.",
      "headingPath": [
        "Introduction",
        "Add users",
        "Exercise",
        "Add users"
      ],
      "source": {
        "path": "docs/sources/tutorials/create-users-and-teams/index.md",
        "gitBlobSha": "b4d26c5ebe0a4fc9e3c13c5a9d873002b60aab96",
        "sha256": "c404cd2baa7f66c89a89539fb3349df10be4835e43107d19776559ee6c21bde1",
        "lineStart": 83,
        "lineEnd": 83,
