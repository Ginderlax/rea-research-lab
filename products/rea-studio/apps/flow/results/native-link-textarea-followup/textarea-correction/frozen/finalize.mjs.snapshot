import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const own=import.meta.dirname,workspace=path.resolve(own,'../..'),old=path.join(workspace,'work/flow-native-link-next'),browser=path.join(workspace,'work/root-flow-link-browser-review-next'),sha=b=>createHash('sha256').update(b).digest('hex');async function json(dir,name){return JSON.parse(await fs.readFile(path.join(dir,name),'utf8'));}async function fp(file){const b=await fs.readFile(file);return{bytes:b.length,sha256:sha(b)};}async function authenticate(dir,expected){const bytes=await fs.readFile(path.join(dir,'manifest.json'));assert.equal(sha(bytes),expected);const manifest=JSON.parse(bytes);for(const row of manifest.inventory)assert.deepEqual(await fp(path.join(dir,row.path)),{bytes:row.bytes,sha256:row.sha256});return{path:path.relative(workspace,dir).replaceAll('\\','/'),records:manifest.inventory.length,manifestSHA256:sha(bytes)};}
const beforeAuthorities=await json(own,'source-authority.json'),oldAfter=await authenticate(old,'0a03866476a81f83762bdfc10d65be639c24f25778b6c03fdac5b9ee906bea5d'),browserAfter=await authenticate(browser,'bae3c0a14e33e8bdd083a86046c6f1e15c455805d4d8e24f899ba0d0793c5f2b');assert.equal(oldAfter.records,beforeAuthorities.baseline.records);assert.equal(browserAfter.records,beforeAuthorities.actualBrowser.records);const candidateBefore=await json(own,'candidate-before.json'),sourceProvenance=await json(old,'source-provenance.json');for(const row of sourceProvenance.productionBaseline)assert.deepEqual(await fp(path.join(workspace,'outputs/rea-research-lab',row.path)),{bytes:row.bytes,sha256:row.sha256});
const final=await json(own,'runs/final-focus/run.json'),negative=await json(own,'runs/normalization-v1-old-client/run.json');assert.equal(final.exit.code,0);assert.equal(final.sourceStable,true);assert.equal(final.before.length,32);assert.deepEqual(final.before,final.after);for(const r of final.after)assert.deepEqual(await fp(path.join(own,'candidate',r.path)),{bytes:r.bytes,sha256:r.sha256});const out=await fs.readFile(path.join(own,'runs/final-focus/stdout.txt'),'utf8');for(const [label,n]of Object.entries({tests:75,pass:75,fail:0,skipped:0,cancelled:0,todo:0}))assert.match(out,new RegExp('ℹ '+label+' '+n+'(?:\\r?\\n|$)'));assert.equal(negative.exit.code,1);assert.equal(negative.sourceStable,true);const oldOut=await fs.readFile(path.join(own,'runs/normalization-v1-old-client/stdout.txt'),'utf8');assert.match(oldOut,/ℹ tests 14/);assert.match(oldOut,/ℹ pass 5/);assert.match(oldOut,/ℹ fail 9/);const test='products/rea-studio/apps/flow/normalization-ui.test.mjs',fixture='products/rea-studio/apps/flow/normalization-ui-fixture.mjs';assert.equal(negative.before.find(x=>x.path===test).sha256,final.after.find(x=>x.path===test).sha256);assert.equal(negative.before.find(x=>x.path===fixture).sha256,final.after.find(x=>x.path===fixture).sha256);assert.equal(negative.before.find(x=>x.path.endsWith('/client.mjs')).sha256,'20b82b290fff7485cade95a45ed982bcfcfe1656721282c4ed2265553d8e2b8d');
const changed=final.after.filter(row=>candidateBefore.some(old=>old.path===row.path&&old.sha256!==row.sha256));assert.deepEqual(changed.map(x=>x.path).sort(),['products/rea-studio/apps/flow/client.mjs','products/rea-studio/apps/flow/README.md','products/rea-studio/apps/flow/NATIVE-FLOWS.md','products/rea-studio/apps/flow/NATIVE-LINKS.md'].sort());for(const row of candidateBefore.filter(x=>/apps\/flow\/(?:server|core|native|native-link|native-regex-worker)\.mjs$/.test(x.path)))assert.equal(final.after.find(x=>x.path===row.path).sha256,row.sha256);
const transformation=await json(own,'client-transformation.json'),client=await fs.readFile(path.join(own,'candidate/products/rea-studio/apps/flow/client.mjs'),'utf8');let inverse=client;for(const e of [...transformation.edits].reverse()){assert.equal(inverse.split(e.after).length-1,1);inverse=inverse.replace(e.after,e.before);}assert.equal(sha(inverse),transformation.before.sha256);assert.equal(Buffer.byteLength(inverse),transformation.before.bytes);assert.equal(sha(client),transformation.after.sha256);
await fs.mkdir(path.join(own,'proposed-live'),{recursive:true});const adapters=[];for(const name of['normalization-ui.test.mjs','normalization-boundaries.test.mjs']){const source=await fs.readFile(path.join(own,'candidate/products/rea-studio/apps/flow',name),'utf8'),beforeURL="../../../../../authority/browser28-seed.json.snapshot",afterURL='./fixtures/normalization-seed.json';assert.equal(source.split(beforeURL).length-1,1);const next=source.replace(beforeURL,afterURL);assert.equal(next.replace(afterURL,beforeURL),source);await fs.writeFile(path.join(own,'proposed-live',name),next);adapters.push({file:name,source:await fp(path.join(own,'candidate/products/rea-studio/apps/flow',name)),proposal:await fp(path.join(own,'proposed-live',name)),edits:[{before:beforeURL,after:afterURL}],inverseExact:true,sourceOnly:true,executed:false,assertionBodiesUnchanged:true});}await fs.writeFile(path.join(own,'installed-test-adapters.json'),JSON.stringify({schema:'rea-flow-native-source-layout-test-adapters/v1',adapters,scope:'Only seed JSON path. Actual installed acceptance pending; no original body/assertion changes.'},null,2)+'\n');
const runtime=await json(own,'runs/final-focus/observations/link-runtime-journal.json'),handlers=await json(own,'runs/final-focus/observations/link-original.json'),http=await json(own,'runs/final-focus/observations/link-http.json');assert.equal(runtime.observations.filter(x=>x.kind==='released-full-runtime').length,8);assert(runtime.observations.at(-1).tempRemoved);assert.equal(handlers.observations.filter(x=>x.kind==='released-compiler').length,9);assert.equal(handlers.observations.filter(x=>x.kind==='released-handler').length,7);assert.equal(http.observations.reduce((n,x)=>n+x.hostStarts,0),5);assert(http.observations.every(x=>x.hostClosed&&x.tempRemoved));
const runs=[];for(const name of['normalization-v1-old-client','normalization-v2-corrected','normalization-v3-adjacent','final-focus']){const r=await json(own,'runs/'+name+'/run.json');assert.equal(r.sourceStable,true);const text=await fs.readFile(path.join(own,'runs',name,'stdout.txt'),'utf8'),counts={};for(const label of['tests','pass','fail','skipped','cancelled','todo'])counts[label]=Number(new RegExp('ℹ '+label+' (\\d+)').exec(text)[1]);runs.push({name,path:'runs/'+name+'/run.json',...await fp(path.join(own,'runs',name,'run.json')),counts,exit:r.exit,sourceFiles:r.before.length});}
await fs.writeFile(path.join(own,'failure-ledger.json'),JSON.stringify({schema:'rea-flow-native-text-normalization-failure-ledger/v1',runs,initial:{cases:14,pass:5,fail:9,clientSHA256:transformation.before.sha256,testAndFixtureExactToPassingReplay:true},classification:{actualBrowser:'Frozen old457 normal Chrome campaign8 observations7positive/1CRLF false-dirty Deploy failure; source/root actual seed authenticated, no corrected browser acceptance claimed.',nativeModel:'Actual client/real in-memory handle with CRLF/bareCR→LF textarea value setter. Confirms raw deploy/export/import/save defects.',programmatic:'Held Export/File.text/newer input and same-value revisions are explicitly programmatic field changes while native controls disabled; not real user typing or download delivery.'},prior457Failures:'Retained at immutable old457 via strict reference; no recursive recopy or receipt rebind.',thresholdChanges:[],originalCrashInheritedHistoricalOnly:true,productionWrites:0},null,2)+'\n');
await fs.writeFile(path.join(own,'README.md'),`# Frozen native Flow textarea correction\n\nSeparate WORK-only epoch; immutable457 and actual-browser28 remain exact. Only client runtime changed from457, plus documentation and new test/fixture payloads. Actual root seed1812UTF8bytes SHAa3dfefae54ddcdee0f1a86a900cadfacf3a147a02e34c63915b6825a4080fa19.\n\nInitial normalizing DOM corpus14=5pass9fail on old20b8; identical14test/helper bytes pass after correction. Four fresh adjacent source-publication controls pass. Final focused75/75, source32stable; earlier57 runner cases and original9compiler/7handler/8full-runtime fixtures rerun, not added as independent unique coverage. NewHTTP3/fivehoststarts plus existing baselineHTTP/twostarts stay separate; originalplainchild1/host1 normalcleanup. No active ownedhosts/tabs; originalGUI0, benchmark0.\n\nRaw decoded backing preserves unchanged loaded/imported CRLF/bareCR across validation/Save/Export. Deploy compares only CR normalization with saved text. Real edits still refuse. Export refuses newer unvalidated source/name/revision/view; Save retains newer programmatic input across both responses; File.text/node/link publication checks capture identities. Closing scrubs controls and releases backing. Native controls remain disabled during operations; programmatic probe scope and Blob-versus-download limits explicit. UTF8 decode/BOM/malformed-byte caveats remain, not binary-file preservation.\n\nclient-transformation.json has16inverse-exact native-only substitutions; all static compiler/native/server/core/regex/sharedhost bytes match457. installed-test-adapters.json is a source-only, unexecuted seed-path proposal; old cache-path adapter still applies for original tests on future installation. Staging-only docs require root disclosed production wording/public proof link update before installation. Independent/current normal-browser acceptance pending. No production/public/global-runner edits, fullparity false.\n`);
const receipt={schema:'rea-flow-native-textarea-source-correction-validation/v1',at:new Date().toISOString(),sourceOnlyProductionScope:true,productionWrites:0,finalRun:{path:'runs/final-focus/run.json',...await fp(path.join(own,'runs/final-focus/run.json')),tests:75,pass:75,fail:0,skipped:0,cancelled:0,todo:0,sourceFiles:32,sourceStable:true},candidateSources:final.after,client:transformation.after,inverseExactClientSubstitutions:16,changedExistingCandidateFiles:changed,staticBackendFiveUnchanged:true,sharedHostUnchanged:true,productionBaseline18Unchanged:true,authorities:{before:beforeAuthorities,after:{baseline:oldAfter,browser:browserAfter}},negative14:{run:runs[0],testSHA256:negative.before.find(x=>x.path===test).sha256,fixtureSHA256:negative.before.find(x=>x.path===fixture).sha256,unchangedBodies:true,oldClientSHA256:transformation.before.sha256,corrected14AllPass:true},freshAdjacentCases:4,originalCurrent:{compilerFixtures:9,handlerCases:7,fullRuntimeFlows:8,plainChildProcesses:1,helperHosts:1,normalCleanup:true,originalGUI:0,originalEditor:0},newHTTP:{runnerCases:3,hostStarts:5,restarts:2,normalCleanup:true},baselineHTTP:{runnerCase:1,hostStarts:2,separate:true},browser:{historical28Unchanged:true,priorObservations:8,priorPass:7,priorFail:1,currentCorrectedExecutions:0,currentCorrectedAccepted:false},sourceSemantics:{rawDecodedBacking:true,CRLFAndBareCRDisplayNormalized:true,otherUnicodeNotNormalized:true,unchangedSaveAndExportRaw:true,editedDraftUsesActualNormalizedDisplay:true,loadedRawDeploymentRevision:true,sourceAwareCaptureGuards:true,programmaticDisabledFieldCasesQualified:true,actualFileDownloadDelivery:false,memoryIsolation:false,blockedIOPreemption:false},installedPathAdapters:{path:'installed-test-adapters.json',...await fp(path.join(own,'installed-test-adapters.json')),sourceOnly:true,executed:false},allPriorReceiptsRebound:false,independentAcceptance:false,productionAcceptance:false,fullParity:false,universalSuperiority:false};await fs.writeFile(path.join(own,'validation.json'),JSON.stringify(receipt,null,2)+'\n');
async function inventory(dir,prefix=''){const rows=[];for(const e of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){if(e.name==='.local'||!prefix&&['manifest.json','freeze.json'].includes(e.name))continue;const p=prefix?prefix+'/'+e.name:e.name;if(e.isDirectory())rows.push(...await inventory(path.join(dir,e.name),p));else{const b=await fs.readFile(path.join(dir,e.name));assert(!(b[0]===77&&b[1]===90));assert(!(b[0]===80&&b[1]===75));assert(!(b[0]===31&&b[1]===139));assert(!/\.(exe|dll|zip|7z|tgz|tar|gz)$/i.test(p));new TextDecoder('utf8',{fatal:true}).decode(b);rows.push({path:p,bytes:b.length,sha256:sha(b)});}}return rows;}const rows=await inventory(own);await fs.writeFile(path.join(own,'manifest.json'),JSON.stringify({schema:'rea-flow-native-textarea-correction-preservation/v1',files:rows.length,inventory:rows,exclusions:['.local generated private observations only','manifest/freeze self binding'],noNativeArchivesOrExecutables:true,noDotLocalPayload:true},null,2)+'\n');const r=await fp(path.join(own,'validation.json')),m=await fp(path.join(own,'manifest.json'));await fs.writeFile(path.join(own,'freeze.json'),JSON.stringify({schema:'rea-flow-native-textarea-correction-freeze/v1',at:new Date().toISOString(),files:rows.length,receipt:{path:'validation.json',...r},manifest:{path:'manifest.json',...m},sourceFrozen:true},null,2)+'\n');console.log(JSON.stringify({files:rows.length,receipt:r,manifest:m,client:transformation.after,negativeTestSHA256:receipt.negative14.testSHA256,negativeFixtureSHA256:receipt.negative14.fixtureSHA256}));
