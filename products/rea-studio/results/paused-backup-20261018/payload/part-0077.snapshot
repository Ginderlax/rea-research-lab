    {
      "id": "grafana.candidate.397ffb4b4977be94a8ba",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The table format is a _long_ formatted time series, also called _tall_. It has repeated time stamps, and repeated values in Location. In this case, we have two time series in the set that would be identified as `Temp {Location=LGA}` and `Temp {Location=BOS}`.",
      "headingPath": [
        "Time series dimensions",
        "Multiple dimensions in table format",
        "Single dimension"
      ],
      "source": {
