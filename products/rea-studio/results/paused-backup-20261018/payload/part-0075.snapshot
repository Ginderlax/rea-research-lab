      "id": "grafana.candidate.a564b43b3865c3dd61a7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "An alert instance is considered **stale** if the alert rule query returns data but its dimension (or series) has disappeared for a number of consecutive evaluation intervals (2 by default).",
      "headingPath": [
        "Stale alert instances"
      ],
      "source": {
