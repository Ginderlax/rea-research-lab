    },
    {
      "id": "grafana.candidate.a8d6da46c21d244a9c86",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you create a service account, you can associate one or more access tokens with it. Create multiple tokens for the same service account if:",
