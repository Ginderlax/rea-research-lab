    {
      "id": "grafana.candidate.7253f73fb00daecb65b6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The size of the message queue used to broadcast alerts from the primary instance to other instances in single-node evaluation mode. Increase this value if you have many alert rules and see broadcast messages being dropped. The default value is `200`. Only used when `ha_single_node_evaluation` is `true`.",
      "headingPath": [
