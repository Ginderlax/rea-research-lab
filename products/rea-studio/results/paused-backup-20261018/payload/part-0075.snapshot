    {
      "id": "grafana.candidate.2deab69ee768ea8adcf4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The Azure Monitor data source can query data from Azure Monitor Metrics and Logs, the Azure Resource Graph, and Application Insights Traces. Each source has its own specialized query editor.",
