import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const base=path.resolve(import.meta.dirname,'..'),source=path.join(base,'work/notes-inline-production-focus-next'),lab=path.join(base,'outputs/rea-research-lab'),prefix='products/rea-studio/results/notes-inline-installed-focus-20261013',run='runs/focused-2026-10-13T02-50-29.551Z',sha=b=>createHash('sha256').update(b).digest('hex');function inventory(root=source,rel=''){return fs.readdirSync(root,{withFileTypes:true}).flatMap(e=>{assert.ok(!e.isSymbolicLink());const n=rel?rel+'/'+e.name:e.name;if(e.isDirectory())return inventory(path.join(root,e.name),n);const b=fs.readFileSync(path.join(root,e.name));return[{path:n,bytes:b.length,sha256:sha(b)}];}).sort((a,b)=>a.path.localeCompare(b.path));}const attempt=JSON.parse(fs.readFileSync(path.join(source,run,'attempt.json')));assert.equal(attempt.summary.tests,69);assert.equal(attempt.summary.pass,69);assert.equal(attempt.summary.fail+attempt.summary.skipped+attempt.summary.cancelled+attempt.summary.todo,0);assert.deepEqual(attempt.sourceBefore,attempt.sourceAfter);assert.equal(attempt.sourceFiles,30);assert.equal(attempt.exitCode,0);assert.equal(attempt.runtime.sha256,'b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3');for(const r of attempt.sourceBefore){const b=fs.readFileSync(path.join(lab,'products/rea-studio',r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);}const stdout=fs.readFileSync(path.join(source,run,'stdout.txt'),'utf8'),parseMarker=key=>{const lines=stdout.split(/\r?\n/).filter(l=>l.startsWith('# {')&&l.includes('"'+key+'"'));assert.equal(lines.length,1);return JSON.parse(lines[0].slice(2))[key];},trash=parseMarker('notebookTrashOriginal'),organization=parseMarker('notebookOriginalObservations');assert.equal(trash.topLevelOriginalExecutions,13);assert.equal(trash.matchedItemProjections,73);assert.equal(trash.displayComparisons,6);assert.equal(organization.length,2);assert.equal(organization[0].nestingComparisons,20);assert.equal(organization[0].pathComparisons,4);assert.equal(organization[0].originalMoveContractExecutions,2);assert.equal(organization[1].originalMoveExecutions,2);const evidence={schema:'rea-notes-installed-inline-focus-acceptance/v1',at:new Date().toISOString(),finiteAcceptance:true,run,summary:attempt.summary,sourceFiles:30,sourceStable:true,exactClient:'90886819feef847847fcae8c442e0a401a1146a7a4aa1fd862a54b5e01f41da9',actualCurrentLayout:true,recordedBeforeFutureSketchSharedHostRoute:true,originalHelpers:{topLevelCalls:41,organizationCalls:28,trashCalls:13,nestingComparisons:20,pathComparisons:4,smokeMoveCalls:2,projectionMoveCalls:2,trashItemProjections:73,trashItemProjectionFields:365,displayComparisons:6,wholeOriginalApp:false,originalGUI:0,ownedDatabaseClockAndOtherAdapters:true},browserRuns:0,benchmarks:0,independentNewReview:false,fullParity:false,superiority:false};fs.writeFileSync(path.join(source,'integration-validation.json'),JSON.stringify(evidence,null,2)+'\n',{flag:'wx'});fs.copyFileSync(import.meta.filename,path.join(source,'preservation-collector.mjs.snapshot'),fs.constants.COPYFILE_EXCL);const records=inventory(),m={schema:'rea-notes-installed-inline-focus-strict-freeze/v1',at:new Date().toISOString(),records,files:records.length,bytes:records.reduce((n,r)=>n+r.bytes,0)},mb=Buffer.from(JSON.stringify(m,null,2)+'\n');fs.writeFileSync(path.join(source,'freeze-manifest.json'),mb,{flag:'wx'});const excluded=[],copies=[];for(const r of [...records,{path:'freeze-manifest.json',bytes:mb.length,sha256:sha(mb)}]){const b=fs.readFileSync(path.join(source,r.path));if(r.path===run+'/source/apps/notes/fixtures/pinned-joplin.jex.snapshot'){assert.equal(r.bytes,9728);assert.equal(r.sha256,'044885c906ba7d8cb97a95fbdd6bc2323ba31a3c301e7ed1d6e592acec8944af');excluded.push({sourcePath:r.path,bytes:r.bytes,sha256:r.sha256,reason:'Exact reproducible native JEX fixture retained locally, not published.'});continue;}assert.ok(!(b[0]===0x4d&&b[1]===0x5a)&&!(b[0]===0x50&&b[1]===0x4b));const n='frozen/'+r.path+'.snapshot',p=path.join(lab,prefix,n);assert.equal(fs.existsSync(p),false);fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,b,{flag:'wx'});copies.push({sourcePath:r.path,path:n,bytes:r.bytes,sha256:r.sha256});}assert.equal(excluded.length,1);const p={schema:'rea-frozen-followup-public-subset/v1',at:new Date().toISOString(),sourceStage:'notes-inline-production-focus-next',originalFrozenArtifacts:records.length,originalManifest:{sourcePath:'freeze-manifest.json',bytes:mb.length,sha256:sha(mb)},excludedLocalCarriers:excluded,publicSnapshots:copies.length,allSourceBytesStableBeforeAfter:true,allPublicCopiesExact:true,allSnapshotsInert:true,fullProductParity:false,universalSuperiority:false,copies},b=Buffer.from(JSON.stringify(p,null,2)+'\n');fs.writeFileSync(path.join(lab,prefix,'preservation-manifest.json'),b,{flag:'wx'});console.log(JSON.stringify({records:records.length,publicSnapshots:copies.length,excludedLocalJEX:1,originalManifest:sha(mb),publicManifest:sha(b),validationSHA256:sha(fs.readFileSync(path.join(source,'integration-validation.json'))),currentInstalledTests:69}));
