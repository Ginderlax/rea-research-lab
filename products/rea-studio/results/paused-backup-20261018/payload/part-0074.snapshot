    {
      "id": "grafana.candidate.6eb0e50f0c5b78cdedff",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, a user can query any data source in an organization, even if the data source is not linked to the user's dashboards.",
