import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';
const root=path.dirname(fileURLToPath(import.meta.url)),stage=path.resolve(root,'../keepass-history-next'),sha=bytes=>createHash('sha256').update(bytes).digest('hex'),expected={receipt:'64b0fa2b89ee0541ad7593109dab6a36a8a55c4f132f36669dbf7c4a2f8ed15f',manifest:'9b9383f3722113d0f4e5228f2360d8eea93653efc2b69f1571a01cace862bcbd'};
const receiptBytes=await fs.readFile(path.join(stage,'history-validation.final.json')),manifestBytes=await fs.readFile(path.join(stage,'preservation-manifest.json'));if(sha(receiptBytes)!==expected.receipt||sha(manifestBytes)!==expected.manifest)throw new Error('Author freeze receipt mismatch.');const receipt=JSON.parse(receiptBytes),manifest=JSON.parse(manifestBytes),files=[];
for(const row of manifest.files){const resolved=path.resolve(stage,row.path);if(!resolved.startsWith(stage+path.sep))throw new Error('Invalid author manifest path.');const bytes=await fs.readFile(resolved);if(bytes.length!==row.bytes||sha(bytes)!==row.sha256)throw new Error('Author stage mutated: '+row.path);files.push({...row});}
for(const name of ['history-validation.final.json','preservation-manifest.json','freeze.json','history.mjs','server.mjs','client.mjs','kdbx.mjs','xml.mjs','README.md','ui.test.mjs','history.test.mjs','http.test.mjs','unknown-time.test.mjs','history-oracle.ps1','harness.mjs']){const bytes=await fs.readFile(path.join(stage,name));const target=path.join(root,'candidate-baseline',name+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,bytes,{flag:'wx'});}
await fs.writeFile(path.join(root,'candidate-baseline-validation.json'),JSON.stringify({schema:'rea-independent-keepass-candidate-baseline/v1',createdAt:new Date().toISOString(),authorReceipt:{path:'history-validation.final.json',sha256:expected.receipt},authorManifest:{path:'preservation-manifest.json',sha256:expected.manifest,count:manifest.count},allAuthorFilesAuthenticated:files.length===manifest.count,files,candidateFingerprints:receipt.sourceBindings.candidate,candidateNotMutated:true},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({authorFilesAuthenticated:files.length,candidate:receipt.sourceBindings.candidate}));
