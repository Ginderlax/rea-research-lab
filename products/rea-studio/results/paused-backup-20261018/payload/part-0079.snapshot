    {
      "id": "grafana.candidate.4ca68167d601b1079c02",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We are excited to announce support for cross-account querying in Metric Insights query builder for AWS Cloudwatch Plugin. This enables building SQL queries to monitor across multiple accounts in the same region in AWS Cloudwatch.",
      "headingPath": [
        "What’s new in Grafana v11.2",
        "Data sources",
        "Cloudwatch Metric Insights cross account observability support"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-2.md",
