import {readFile,writeFile,mkdir} from 'node:fs/promises';
import {createHash} from 'node:crypto';
import {spawnSync} from 'node:child_process';
import {fileURLToPath} from 'node:url';
import assert from 'node:assert/strict';
const root=new URL('./',import.meta.url),hash=value=>createHash('sha256').update(value).digest('hex'),paths=['rabin.mjs','rabin.test.mjs','restic-crypto.mjs','source-provenance.json','references/chunker.go','references/polynomials.go','references/chunker_test.go','references/LICENSE'],fingerprints=[];
for(const name of paths){const bytes=await readFile(new URL(name,root)),target=new URL(`historical-prototype/${name}`,root);await mkdir(new URL('.',target),{recursive:true});await writeFile(target,bytes);fingerprints.push({path:name,bytes:bytes.length,sha256:hash(bytes)});}
const run=spawnSync(process.execPath,['--test','--test-reporter=tap','rabin.test.mjs'],{cwd:fileURLToPath(root),encoding:'utf8',timeout:30000,maxBuffer:MiB()});await writeFile(new URL('historical-prototype/prototype-tests.stdout.txt',root),run.stdout);await writeFile(new URL('historical-prototype/prototype-tests.stderr.txt',root),run.stderr);assert.equal(run.status,0,run.stderr);assert.match(run.stdout,/# tests 3/);assert.match(run.stdout,/# pass 3/);for(const value of fingerprints)assert.equal(hash(await readFile(new URL(value.path,root))),value.sha256);const provenance=JSON.parse(await readFile(new URL('source-provenance.json',root)));for(const value of provenance.references)assert.equal(hash(await readFile(new URL(value.path,root))),value.sha256);await writeFile(new URL('historical-prototype/prototype-validation.json',root),JSON.stringify({schema:'rea-rabin-historical-prototype/v1',checkedAtUtc:new Date().toISOString(),summary:{tests:3,pass:3,fail:0,skipped:0,cancelled:0},fingerprints,stdoutSha256:hash(run.stdout),stderrSha256:hash(run.stderr),sourceBytesStableAcrossRun:true},null,2)+'\n');console.log(JSON.stringify({tests:3,pass:3,fingerprints:fingerprints.length}));
function MiB(){return 1024*1024;}
