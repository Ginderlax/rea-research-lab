    {
      "id": "grafana.candidate.de7b4e6845b6dfe3ac74",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use time series queries for values that change over time, usually for graph visualizations such as the Time series panel. Each query should return at least a `datetime` column and numeric value column. The result must also be sorted in ascending order by the `datetime` column.",
      "headingPath": [
        "Azure Monitor query editor",
        "Query Azure Monitor Logs",
        "Logs query examples"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/query-editor/index.md",
