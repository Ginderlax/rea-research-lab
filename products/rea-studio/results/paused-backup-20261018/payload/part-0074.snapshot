    {
      "id": "grafana.candidate.37e1a23e13980ea50941",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In addition to mapping field values to shorter variable names, more correlation variables can be created by applying transformations to existing fields",
      "headingPath": [
        "Correlation",
        "Target query",
        "Correlation Variables"
      ],
      "source": {
        "path": "docs/sources/administration/correlations/correlation-configuration/index.md",
