import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{spawnSync}from'node:child_process';import{pathToFileURL}from'node:url';const base=path.resolve(import.meta.dirname,'..'),lab=path.join(base,'outputs/rea-research-lab'),owned=path.join(base,'work/root-notes-layout-api-proof-integration-next'),sha=b=>createHash('sha256').update(b).digest('hex');const names=['verify-records','verify-followup-records','verify-notes-vault-followups','verify-editor-save-followup','verify-notes-inline-followups','verify-sketch-layout-followups','verify-editor-value-api-followups','verify-notes-layout-value-api-checkpoint'].map(n=>'scripts/'+n+'.mjs');names.push('scripts/sketch-layout-proof/public-proof-loader.mjs','scripts/sketch-layout-proof/proof-verifier.mjs');const fingerprint=()=>names.map(n=>{const b=fs.readFileSync(path.join(lab,n));return{path:n,bytes:b.length,sha256:sha(b)};}),before=fingerprint();fs.writeFileSync(path.join(owned,'root-source-before.json'),JSON.stringify(before,null,2)+'\n',{flag:'wx'});for(const r of before){const p=path.join(owned,'current-root-source',r.path+'.snapshot');fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,fs.readFileSync(path.join(lab,r.path)),{flag:'wx'});}fs.copyFileSync(import.meta.filename,path.join(owned,'actual-root-proof-collector.mjs.snapshot'),fs.constants.COPYFILE_EXCL);const code="const {verifyFollowupRecords}=await import("+JSON.stringify(pathToFileURL(path.join(lab,'scripts/verify-followup-records.mjs')).href)+");console.log(JSON.stringify(verifyFollowupRecords("+JSON.stringify(lab)+")));",started=new Date().toISOString(),p=spawnSync(process.execPath,['--input-type=module','--eval',code],{cwd:lab,encoding:null,timeout:120000,maxBuffer:2*1024*1024,windowsHide:true,shell:false});fs.writeFileSync(path.join(owned,'actual-root-proof.stdout.txt'),p.stdout??Buffer.alloc(0),{flag:'wx'});fs.writeFileSync(path.join(owned,'actual-root-proof.stderr.txt'),p.stderr??Buffer.alloc(0),{flag:'wx'});const after=fingerprint();fs.writeFileSync(path.join(owned,'root-source-after.json'),JSON.stringify(after,null,2)+'\n',{flag:'wx'});assert.equal(p.status,0,(p.stderr??Buffer.alloc(0)).toString());assert.deepEqual(before,after);const lines=p.stdout.toString().trim().split(/\r?\n/);assert.equal(lines.length,1,'Direct import emits one parent record');const result=JSON.parse(lines[0]);assert.equal(result.notesLayoutValueApiCheckpoint.currentCombinedTests,847);assert.equal(result.notesLayoutValueApiCheckpoint.currentCombinedSources,720);assert.equal(result.editorHostTransition.onlyEditorSaveLiveMismatch,true);const record={schema:'rea-root-notes-layout-api-proof-integration-validation/v1',started,finished:new Date().toISOString(),sourceOnly:true,sourceFiles:10,sourceStable:true,currentProofMandatory:true,currentCombinedTests:847,currentCombinedSources:720,directImportJSONRecords:1,childExit:p.status,parentChanges:9,raw:{stdout:{bytes:p.stdout.length,sha256:sha(p.stdout)},stderr:{bytes:p.stderr.length,sha256:sha(p.stderr)}},originalExecutions:0,applicationExecutions:0,browserExecutions:0,fullParity:false,superiority:false};fs.writeFileSync(path.join(owned,'actual-root-proof-validation.json'),JSON.stringify(record,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(record));
