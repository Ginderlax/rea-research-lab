    {
      "id": "grafana.candidate.e5c74efdb15846a341c5",
      "syntaxRole": "list-item",
      "sourceText": "- Unlike API keys, service account tokens are not associated with a specific user, which means that applications can be authenticated even if a Grafana user is deleted.",
      "headingPath": [
        "Service accounts",
        "When to use service accounts",
        "Service account benefits"
      ],
