import {createHash,randomBytes} from 'node:crypto';
import {isJoplinId} from './jex.mjs';

export const NOTEBOOK_DEPTH=64,NOTEBOOK_PATH=200,NOTEBOOK_RECORDS=2000;
export const CONFLICT_NOTEBOOK_ID='c04f1c7c04f1c7c04f1c7c04f1c7c04f';
const idForTitle=title=>createHash('sha256').update('REA notebook:'+title).digest('hex').slice(0,32);
export function folderRecord(id,title,time,parentId=''){return{type:2,title,props:{id,parent_id:parentId,created_time:time,updated_time:time,user_created_time:time,user_updated_time:time,encryption_cipher_text:'',encryption_applied:'0',type_:'2'}};}
export function notebookAncestors(records,id){const ancestors=[],seen=new Set();while(id){if(!isJoplinId(id)||seen.has(id))throw new Error('Notebook hierarchy contains an invalid ID or cycle.');seen.add(id);if(seen.size>NOTEBOOK_DEPTH)throw new Error('Notebook depth exceeds 64.');const record=records[id];if(record?.type!==2)throw new Error('Notebook parent does not exist.');ancestors.unshift(record);id=record.props.parent_id??'';}return ancestors;}
export function notebookPath(records,id){const result=notebookAncestors(records,id).map(record=>record.title).join(' / ');if(result.length>NOTEBOOK_PATH)throw new Error('Notebook display path exceeds 200 characters.');return result;}
function localFolder(records,id){if(id===CONFLICT_NOTEBOOK_ID)throw new Error('Reserved conflict notebook organization is outside this local subset.');for(const record of notebookAncestors(records,id))if(record.props.id===CONFLICT_NOTEBOOK_ID||record.props.share_id||Number(record.props.deleted_time??0))throw new Error('Shared, reserved or trashed notebook organization is outside this local subset.');}
export function canNest(records,id,parentId){if(id===parentId||id===CONFLICT_NOTEBOOK_ID||parentId===CONFLICT_NOTEBOOK_ID)return false;if(records[id]?.type!==2)throw new Error('Notebook does not exist.');if(!parentId)return true;let cursor=parentId;const seen=new Set();while(cursor){if(cursor===id)return false;if(seen.has(cursor)||seen.size>=NOTEBOOK_DEPTH)throw new Error('Notebook hierarchy contains a cycle or excessive depth.');seen.add(cursor);const folder=records[cursor];if(folder?.type!==2)throw new Error('Target notebook does not exist.');cursor=folder.props.parent_id??'';}return true;}
function validate(s){const folders=Object.values(s.records).filter(record=>record.type===2);if(folders.length>NOTEBOOK_RECORDS||Object.keys(s.records).length>NOTEBOOK_RECORDS)throw new Error('Notebook/raw-record count exceeds 2,000.');for(const folder of folders)notebookPath(s.records,folder.props.id);return folders;}
function flatFolder(s,title,time){const id=idForTitle(title),record=s.records[id];if(record&&(record.type!==2||record.title!==title||record.props.parent_id))throw new Error('Generated notebook ID conflicts with retained metadata.');if(!record){s.records[id]=folderRecord(id,title,time);s.organization.revision++;}return id;}
export function ensureOrganization(s){s.records??={};s.organization??={revision:0};if(!Number.isSafeInteger(s.organization.revision)||s.organization.revision<0)throw new Error('Notebook organization revision is invalid.');for(const note of Object.values(s.notes)){if(note.metadataEdited===undefined)note.metadataEdited=Boolean(note.joplin&&note.revision>1);if(note.notebookId===undefined)note.notebookId=note.joplin?.originalNotebook===note.notebook?(note.joplin.props.parent_id??''):flatFolder(s,note.notebook,note.createdAt);note.notebook=note.notebookId?notebookPath(s.records,note.notebookId):'Imported';}validate(s);return s;}
export function bindNotebook(s,note,input){let id;if(input.notebookId!==undefined){id=input.notebookId;if(typeof id!=='string'||(id&&!isJoplinId(id)))throw new Error('Choose a valid notebook ID.');if(id&&s.records[id]?.type!==2)throw new Error('Notebook does not exist.');if(id!==note.notebookId)localFolder(s.records,id);}else if(note.notebookId!==undefined&&(note.notebookId?notebookPath(s.records,note.notebookId):'Imported')===input.notebook)id=note.notebookId;else id=flatFolder(s,input.notebook,note.createdAt);return{...note,notebookId:id,notebook:id?notebookPath(s.records,id):'Imported'};}
export function organizationList(s){const folders=validate(s),counts=new Map();for(const note of Object.values(s.notes))if(!note.deletedAt)counts.set(note.notebookId,(counts.get(note.notebookId)??0)+1);const rows=folders.map(record=>({id:record.props.id,title:record.title,parentId:record.props.parent_id??'',path:notebookPath(s.records,record.props.id),depth:notebookAncestors(s.records,record.props.id).length,notes:counts.get(record.props.id)??0,editable:notebookAncestors(s.records,record.props.id).every(record=>record.props.id!==CONFLICT_NOTEBOOK_ID&&!record.props.share_id&&!Number(record.props.deleted_time??0))}));rows.sort((a,b)=>a.path.localeCompare(b.path)||a.id.localeCompare(b.id));return{revision:s.organization.revision,notebooks:rows};}
export function checkOrganizationRevision(s,revision){if(!Number.isSafeInteger(revision)||revision!==s.organization.revision)throw new Error('Notebooks changed since they were loaded. Refresh before changing their organization.');}
function updatePaths(s){for(const note of Object.values(s.notes)){const next=note.notebookId?notebookPath(s.records,note.notebookId):'Imported';if(next===note.notebook)continue;const{revision,title,body,tags,notebook,notebookId,updatedAt}=note;note.history=[...note.history,{revision,title,body,tags,notebook,notebookId,updatedAt}].slice(-20);note.revision++;note.notebook=next;}}
export function changeNotebook(s,{action,id,title,parentId='',revision},time){checkOrganizationRevision(s,revision);if(action==='notebook-create'){if(typeof parentId!=='string'||(parentId&&!isJoplinId(parentId)))throw new Error('Choose a valid parent notebook ID.');if(parentId&&s.records[parentId]?.type!==2)throw new Error('Parent notebook does not exist.');localFolder(s.records,parentId);do{id=randomBytes(16).toString('hex');}while(s.records[id]||Object.values(s.notes).some(note=>(note.joplin?.props.id??note.id.replaceAll('-',''))===id));s.records[id]=folderRecord(id,title,time,parentId);}else{if(!isJoplinId(id)||s.records[id]?.type!==2)throw new Error('Notebook does not exist.');const original=s.records[id];localFolder(s.records,id);if(action==='notebook-rename'){s.records[id]={...original,title,props:{...original.props,updated_time:time,user_updated_time:time}};}else{if(typeof parentId!=='string'||(parentId&&!isJoplinId(parentId)))throw new Error('Choose a valid parent notebook ID.');localFolder(s.records,parentId);if(!canNest(s.records,id,parentId))throw new Error('Cannot move notebook to itself or its descendant.');s.records[id]={...original,props:{...original.props,parent_id:parentId,updated_time:time}};}}
 validate(s);updatePaths(s);s.organization.revision++;return{...organizationList(s),notebook:organizationList(s).notebooks.find(row=>row.id===id)};
}
