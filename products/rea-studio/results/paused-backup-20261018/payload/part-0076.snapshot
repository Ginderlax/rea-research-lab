    {
      "id": "grafana.candidate.0b66cb639ab4082469e1",
      "syntaxRole": "table-row",
      "sourceText": "| MySQL has `require_secure_transport` enabled or AWS RDS Proxy enforces TLS | Enable **With CA Cert** or **Skip TLS Verification** in the data source configuration. Either option establishes a TLS connection.                                                           |",
      "headingPath": [
        "Troubleshoot MySQL data source issues",
        "Connection errors",
        "TLS/SSL connection failures"
      ],
      "source": {
        "path": "docs/sources/datasources/mysql/troubleshooting/index.md",
