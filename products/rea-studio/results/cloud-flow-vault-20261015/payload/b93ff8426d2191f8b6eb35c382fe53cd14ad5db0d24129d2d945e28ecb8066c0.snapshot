import test from'node:test';import assert from'node:assert/strict';import{randomUUID}from'node:crypto';import{render}from'./client.mjs';import{handle,dispose}from'./server.mjs';import{Element,descendants,button,field,deferred}from'./ui-fixture.mjs';
async function fixture(t,wrap){const workspace={root:'owned-active-list-'+randomUUID()},store={value:null,get:async()=>structuredClone(store.value),set:async(k,v)=>{store.value=structuredClone(v)}},api=(action,input={})=>handle({action,input,store,workspace}),requests=[];await api('create',{password:'Owned synthetic active list master'});const A=(await api('save',{title:'Active A',group:'Parent/Selected',password:'Synthetic A'})).id,C=(await api('save',{title:'Other C',group:'Other',password:'Synthetic C'})).id;globalThis.document={createElement:tag=>new Element(tag)};const root=new Element('main'),cleanup=await render(root,(action,input)=>{requests.push({action,id:input?.id});return wrap?wrap(action,input,()=>api(action,input)):api(action,input)});t.after(()=>{cleanup();dispose(workspace);delete globalThis.document});return{root,store,api,requests,A,C};}
const rows=root=>descendants(root).filter(n=>n.tagName==='strong'&&['Active A','Other C'].includes(n.textContent)).map(n=>n.textContent);
function group(root){const r=descendants(root).find(e=>e.tagName==='section'&&e.children.some(c=>c.tagName==='strong'&&c.textContent==='Selected'));assert(r);return r;}
async function command(root,confirm=true){await button(root,'Show groups').click();const r=group(root);field(r,'Confirm recycle group and descendants').checked=confirm;return button(r,'Recycle group and descendants');}
const editor=root=>descendants(root).find(e=>e.tagName==='section'&&e.children.some(c=>c.tagName==='h3'&&c.textContent==='New entry'));
test('Search during held committed recursive effect issues no read; internal completion restores only current rows and retains newer draft',async t=>{const entered=deferred(),release=deferred();t.after(()=>release.resolve());const f=await fixture(t,async(a,i,real)=>{const r=await real();if(a==='recycleGroupDelete'){entered.resolve();await release.promise;}return r}),control=await command(f.root),pending=control.click();await entered.promise;assert.deepEqual(rows(f.root),[]);const count=f.requests.length;await button(f.root,'Search').click();assert.equal(f.requests.length,count);const title=field(editor(f.root),'Title');title.value='New draft after real commit';title.listeners.get('input')();release.resolve();await pending;assert.deepEqual(rows(f.root),['Other C']);assert.equal(title.value,'New draft after real commit');assert.equal(field(editor(f.root),'Title'),title);});
test('failed recursive write leaves rows cleared until explicit Search, then fresh group reconfirmation retries same backend identity',async t=>{const f=await fixture(t),before=structuredClone(f.store.value),entered=deferred(),release=deferred();t.after(()=>release.resolve());const set=f.store.set;let failed=true;f.store.set=async(k,v)=>{if(failed){entered.resolve();await release.promise;throw new Error('Owned failed active-list persistence')}return set(k,v)};const control=await command(f.root),pending=control.click();await entered.promise;assert.deepEqual(rows(f.root),[]);const count=f.requests.length;await button(f.root,'Search').click();assert.equal(f.requests.length,count);release.resolve();await pending;assert.deepEqual(f.store.value,before);assert.deepEqual(rows(f.root),[]);await button(f.root,'Search').click();assert.deepEqual(rows(f.root),['Active A','Other C']);failed=false;await(await command(f.root)).click();assert.deepEqual((await f.api('list')).entries.map(e=>e.id),[f.C]);assert.equal(f.requests.filter(r=>r.action==='recycleGroupDelete').length,2);});
test('unconfirmed and dirty recursive refusals do not clear active rows or disable ordinary Search',async t=>{const f=await fixture(t),control=await command(f.root,false);await control.click();assert.deepEqual(rows(f.root),['Active A','Other C']);const count=f.requests.length;await button(f.root,'Search').click();assert.equal(f.requests.length,count+1);const title=field(editor(f.root),'Title');title.value='Retained unsaved draft';title.listeners.get('input')();field(group(f.root),'Confirm recycle group and descendants').checked=true;await control.click();assert.deepEqual(rows(f.root),['Active A','Other C']);assert.equal(title.value,'Retained unsaved draft');assert.equal(f.requests.filter(r=>r.action==='recycleGroupDelete').length,0);});
