import fs from'node:fs/promises';import path from'node:path';import os from'node:os';import{createHash,randomBytes}from'node:crypto';import{createServer}from'node:http';import{pathToFileURL}from'node:url';import assert from'node:assert/strict';
const here=import.meta.dirname,workspace=path.resolve(here,'../..'),stage=path.resolve(here,'../editor-search-pattern-next'),repo=path.join(workspace,'outputs/rea-research-lab'),run='runs/browser-'+new Date().toISOString().replace(/[:.]/g,'-'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),json=v=>Buffer.from(JSON.stringify(v,null,2)+'\n');
async function save(p,b){await fs.mkdir(path.dirname(path.join(here,p)),{recursive:true});await fs.writeFile(path.join(here,p),b,{flag:'wx'});}const manifestBytes=await fs.readFile(path.join(stage,'freeze-manifest.json'));assert.equal(id(manifestBytes).sha256,'7f975ae3f7a0827f5b9ade231bd121c5b4028f17d88758455fd680962ff0f878');const manifest=JSON.parse(manifestBytes);async function author(){const rows=[];for(const r of manifest.inventory){const b=await fs.readFile(path.join(stage,r.path));assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});rows.push({path:r.path,...id(b)});}return rows;}const authorBefore=await author();await save(run+'/author-before.json',json(authorBefore));
const named=[['candidate-client',path.join(stage,'candidate/products/rea-studio/apps/editor/client.mjs')],['production-client',path.join(repo,'products/rea-studio/apps/editor/client.mjs')],['candidate-server',path.join(stage,'candidate/products/rea-studio/apps/editor/server.mjs')],['production-server',path.join(repo,'products/rea-studio/apps/editor/server.mjs')],['candidate-workspace-search',path.join(stage,'candidate/products/rea-studio/apps/editor/workspace-search.mjs')],['production-workspace-search',path.join(repo,'products/rea-studio/apps/editor/workspace-search.mjs')],['candidate-worker',path.join(stage,'candidate/products/rea-studio/apps/editor/search-pattern-worker.mjs')],['candidate-session',path.join(stage,'candidate/products/rea-studio/apps/editor/search-pattern-session.mjs')],['candidate-helper',path.join(stage,'candidate/products/rea-studio/apps/editor/search-pattern.mjs')],['host',new URL(import.meta.url)]];const sources=[];const clients={};for(const[name,p]of named){const b=await fs.readFile(p);sources.push({name,path:String(p),...id(b)});await save(run+'/source/'+name+'.mjs.snapshot',b);if(name.endsWith('-client'))clients[name.split('-')[0]]=b;}await save(run+'/source-before.json',json(sources));
const candidate=await import(pathToFileURL(path.join(stage,'candidate/products/rea-studio/apps/editor/server.mjs')).href),production=await import(pathToFileURL(path.join(repo,'products/rea-studio/apps/editor/server.mjs')).href),storage=await import(pathToFileURL(path.join(stage,'candidate/products/rea-studio/lib/storage.mjs')).href);
const temp=await fs.mkdtemp(path.join(os.tmpdir(),'rea-editor-browser-review-')),ws=await storage.createWorkspace(temp),content='😀 lead\r\nneedle here\r\nsecond needle\r\n';await fs.writeFile(await ws.resolve('fixture.txt'),content);await save(run+'/synthetic-fixture.json',json({content,bytes:Buffer.byteLength(content),sha256:id(Buffer.from(content)).sha256,owned:true}));const token=randomBytes(24).toString('hex'),calls=[],captures=[];let port,closed=false;
const html=variant=>`<!doctype html><html><head><meta charset="utf-8"><title>Owned Editor ${variant} review</title><style>body{font:16px sans-serif;max-width:1000px;margin:auto}textarea{width:95%}button,input{margin:4px}</style></head><body><main id="editor"></main><pre id="selection-proof">No selection observed</pre><script type="module">import{render}from'/${variant}-client.mjs';const session=await(await fetch('/session')).json();const api=async(action,input={})=>{const r=await fetch('/api/${variant}/'+action,{method:'POST',headers:{'content-type':'application/json','x-review-token':session.token},body:JSON.stringify(input)});const j=await r.json();if(!r.ok)throw Error(j.error);return j;};await render(document.getElementById('editor'),api);document.addEventListener('selectionchange',()=>{const t=document.querySelector('textarea[aria-label="File contents"]');if(!t||t.selectionStart===t.selectionEnd)return;const observation={variant:'${variant}',value:t.value,selectionStart:t.selectionStart,selectionEnd:t.selectionEnd,selected:t.value.slice(t.selectionStart,t.selectionEnd)};document.getElementById('selection-proof').textContent=JSON.stringify(observation);fetch('/capture',{method:'POST',headers:{'content-type':'application/json','x-review-token':session.token},body:JSON.stringify(observation)});});</script></body></html>`;
const server=createServer(async(req,res)=>{try{if(req.headers.host!==`127.0.0.1:${port}`||!['127.0.0.1','::ffff:127.0.0.1'].includes(req.socket.remoteAddress))throw Error('Owned loopback host only');const url=new URL(req.url,`http://127.0.0.1:${port}`);const reply=(code,value,type='application/json')=>{res.writeHead(code,{'content-type':type,'cache-control':'no-store','x-content-type-options':'nosniff'});res.end(type==='application/json'?JSON.stringify(value):value);};if(req.method==='GET'&&['/candidate','/production'].includes(url.pathname)){return reply(200,html(url.pathname.slice(1)),'text/html; charset=utf-8');}if(req.method==='GET'&&url.pathname==='/session')return reply(200,{token});const file=/^\/(candidate|production)-client\.mjs$/.exec(url.pathname);if(req.method==='GET'&&file)return reply(200,clients[file[1]],'text/javascript; charset=utf-8');if(req.method!=='POST'||req.headers['x-review-token']!==token)return reply(404,{error:'Unknown owned review route'});let chunks=[],bytes=0;for await(const chunk of req){bytes+=chunk.length;if(bytes>65536)throw Error('Owned request cap');chunks.push(chunk);}const input=JSON.parse(Buffer.concat(chunks));if(url.pathname==='/capture'){captures.push(input);return reply(200,{recorded:true});}const api=/^\/api\/(candidate|production)\/(list|read|search|save|gitStatus)$/.exec(url.pathname);if(!api)return reply(404,{error:'Owned bounded actions only'});const[,variant,action]=api;const data=action==='gitStatus'?{initialized:false}:await (variant==='candidate'?candidate:production).handle({action,input,workspace:ws});calls.push({variant,action,input:structuredClone(input),response:structuredClone(data),gitStatusStub:action==='gitStatus'});return reply(200,data);}catch(e){res.writeHead(500,{'content-type':'application/json'});res.end(JSON.stringify({error:e.message}));}});
await new Promise(resolve=>server.listen(0,'127.0.0.1',resolve));port=server.address().port;await save(run+'/host-binding.json',json({port,candidateClient:sources.find(s=>s.name==='candidate-client'),productionClient:sources.find(s=>s.name==='production-client'),sharedStudioHostUsed:false,boundedOwnedHTTPBridge:true,gitStatusStubbed:true,sessionTokenPersisted:false,scope:'Actual unchanged client modules and list/read/search/save server handlers in a native browser; not complete Studio host or original GUI.'}));process.stdout.write(JSON.stringify({ready:true,url:`http://127.0.0.1:${port}/candidate`,productionURL:`http://127.0.0.1:${port}/production`,run})+'\n');
async function stop(){if(closed)return;closed=true;server.closeAllConnections();await new Promise(resolve=>server.close(resolve));await candidate.dispose(ws);const after=await author();assert.deepEqual(after,authorBefore);await save(run+'/author-after.json',json(after));const sourceAfter=[];for(const[name,p]of named){const b=await fs.readFile(p);sourceAfter.push({name,path:String(p),...id(b)});}assert.deepEqual(sourceAfter,sources);await save(run+'/source-after.json',json(sourceAfter));await save(run+'/api-calls.json',json(calls));await save(run+'/native-selections.json',json(captures));const absolute=path.resolve(temp);assert(absolute.startsWith(path.resolve(os.tmpdir())+path.sep)&&path.basename(absolute).startsWith('rea-editor-browser-review-'));await fs.rm(absolute,{recursive:true,force:true});await save(run+'/validation.json',json({schema:'rea-editor-pattern-independent-native-textarea-host/v1',sourceStable:true,author573Unchanged:true,sourceFiles:sources.length,actualBrowserObservers:captures.length,requests:calls.length,closed:true,tempGone:true,candidateWrites:0,productionWrites:0,originalGUI:0,originalNativeCalls:0,sharedStudioHostUsed:false,gitStatusStubbed:true,sessionTokenPersisted:false,fullProductParity:false,superiority:false}));process.stdout.write(JSON.stringify({stopped:true,run,captures:captures.length,calls:calls.length,sourceStable:true})+'\n');process.exitCode=0;process.stdin.pause();}
process.stdin.setEncoding('utf8');process.stdin.on('data',text=>{if(text.includes('stop'))stop().catch(e=>{process.stderr.write(String(e.stack)+'\n');process.exitCode=1;server.closeAllConnections();server.close();});});process.on('SIGTERM',()=>stop());process.on('SIGINT',()=>stop());
