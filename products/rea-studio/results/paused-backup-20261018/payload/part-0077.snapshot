    {
      "id": "grafana.candidate.9452b9d7b02f2f02ae96",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you enable anonymous access in Grafana, any visitor or user can use Grafana as a Viewer without signing in. This section lists the security implications of enabling Anonymous access.",
