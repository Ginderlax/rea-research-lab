async function authenticate(){const out=[];for(const[epoch,root,name,pin,count,key]of definitions){const mb=await read(root+'/'+name);assert.equal(hash(mb),pin);const m=JSON.parse(mb),r=m[key],records=Array.isArray(r)?r:Object.entries(r).map(([p,v])=>({path:p,...v}));assert.equal(records.length,count);assert.deepEqual(await tree(path.join(workspace,root)),[...records.map(r=>r.path),name].sort());for(const r of records){safeRelative(r.path);authenticateBytes(await read(root+'/'+r.path),r);}out.push({epoch,root,manifest:name,manifestIdentity:id(mb),records:records.map(r=>({path:r.path,bytes:r.bytes,sha256:r.sha256})),payloads:count});}return out;}
