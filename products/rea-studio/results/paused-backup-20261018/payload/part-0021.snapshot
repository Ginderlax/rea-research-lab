    elif role=='tested-source/verify-notes-new-todo-cloud.mjs.snapshot':originals[role]=git(['show',HEAD+':'+PREFIX+'scripts/verify-notes-new-todo-cloud.mjs'])
    assert decoded==originals[role],role
assert set(decoded_roles)==set(originals) and len(decoded_roles)==119 and len(objects)==m['uniquePublicObjects']==101
assert sum(zip_counts.values())==1110 and sum(source_counts.values())==1042 and sum(nonsource_counts.values())==68
assert m['accepted111Or8'] is False and m['sourceStable'] is True and m['productionInstalled'] is False and m['historicalReceiptsRebound'] is False
assert m['observedFinite']=={'tests':111,'pass':107,'fail':4,'cancelled':0,'skipped':0,'todo':0}
assert m['observedBrowser']=={'tests':8,'passed':7,'failed':1,'skipped':0,'flaky':0,'retries':0}
