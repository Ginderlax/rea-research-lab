    {
      "id": "grafana.candidate.2b4986193e1fc42b8725",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Branch protection can enforce various controls such as requiring pull requests before merging, setting reviewer approval requirements, running automated validation checks, preventing force pushes, and restricting who can push directly to protected branches.",
      "headingPath": [
        "Configure Git repository protection",
        "Protect your branch"
      ],
