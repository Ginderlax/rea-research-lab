    {
      "id": "grafana.candidate.3160948f76bea8862cf0",
      "syntaxRole": "table-row",
      "sourceText": "| Width | Set a fixed width of the axis. By default, Grafana dynamically calculates the width of an axis.<br></br>By setting the width of the axis, data whose axes types are different can share the same display proportions. This makes it easier to compare more than one graph’s worth of data because the axes are not shifted or stretched within visual proximity of each other. |",
      "headingPath": [
        "Bar chart",
        "Configuration options",
        "Axis"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/bar-chart/index.md",
