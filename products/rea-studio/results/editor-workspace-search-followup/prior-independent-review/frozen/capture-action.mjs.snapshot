import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import {spawnSync} from 'node:child_process';import assert from 'node:assert/strict';
const here=import.meta.dirname,name=process.argv[2],sha=bytes=>createHash('sha256').update(bytes).digest('hex');assert.ok(/^[a-z][a-z.-]*\.mjs$/.test(name));const bytes=await fs.readFile(path.join(here,name)),stem='action-'+name.slice(0,-4)+'-'+Date.now();await fs.writeFile(path.join(here,stem+'.source.mjs.snapshot'),bytes,{flag:'wx'});const start=new Date().toISOString(),args=[...(name.endsWith('.test.mjs')?['--test']:[]),path.join(here,name)],child=spawnSync(process.execPath,args,{encoding:'utf8',windowsHide:true,timeout:120000,maxBuffer:4*1024*1024}),stdout=child.stdout??'',stderr=child.stderr??'';for(const [suffix,value]of [['.stdout.txt',stdout],['.stderr.txt',stderr]])await fs.writeFile(path.join(here,stem+suffix),value,{flag:'wx'});const receipt={name,start,end:new Date().toISOString(),exitCode:child.status,signal:child.signal,error:child.error?.message,sourceSHA256:sha(bytes),stdoutSHA256:sha(stdout),stderrSHA256:sha(stderr),newTimingMemoryOrProfilerRun:false};await fs.writeFile(path.join(here,stem+'.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});process.stdout.write(stdout);process.stderr.write(stderr);process.exitCode=child.status??1;
