        "sha256": "78f3473345c7acf1680b5e482fdc29c61c6d73576e857090bae5239629ed0887",
        "lineStart": 431,
        "lineEnd": 431,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/mssql/configure/index.md#L431-L431"
      },
      "applicability": {
