    {
      "id": "grafana.candidate.c6594b04f29b7ddbd163",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The frequency of updating a user's last seen time. This setting should be expressed as a duration. Examples: 1h (hour), 15m (minutes) Default is `15m` (15 minutes). The minimum supported duration is `5m` (5 minutes). The maximum supported duration is `1h` (1 hour).",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[users]`",
        "`last_seen_update_interval`"
      ],
      "source": {
