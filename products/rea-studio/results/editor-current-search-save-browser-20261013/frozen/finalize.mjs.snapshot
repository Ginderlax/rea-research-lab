import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const here=import.meta.dirname,workspace=path.resolve(here,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),fp=async p=>{const b=await fs.readFile(p);return{bytes:b.length,sha256:sha(b)}},read=async n=>JSON.parse(await fs.readFile(path.join(here,n))),save=(n,v)=>fs.writeFile(path.join(here,n),JSON.stringify(v,null,2)+'\n',{flag:'wx'});
const before=await read('source-before.json'),after=await read('source-after.json');assert.equal(before.length,31);assert.deepEqual(before,after);for(const r of before){assert.deepEqual(await fp(path.join(repo,r.path)),{bytes:r.bytes,sha256:r.sha256});assert.deepEqual(await fp(path.join(here,r.clone)),{bytes:r.bytes,sha256:r.sha256});}
const shell=before.filter(r=>r.path.startsWith('products/rea-studio/public/'));assert.equal(shell.length,3);await save('shared-shell-identities.json',shell);const hostRows=before.filter(r=>['products/rea-studio/server.mjs','products/rea-studio/catalog.mjs','products/rea-studio/lib/storage.mjs'].includes(r.path));assert.equal(hostRows.length,3);await save('shared-host-identities.json',hostRows);
const anchors=[{path:'work/editor-save-focused-integration-next/validation.json',sha256:'f4edee0afc7d40a169576ae9b87fe9d4c9227a1ea355ef19c80fa273b26eee25'},{path:'work/editor-save-focused-integration-next/freeze-manifest.json',sha256:'b45f1b6b4c5acfc918bc1fd13a4ca6c0886b7e0b1a04c87c986aa0d74646bc73'},{path:'outputs/rea-research-lab/products/rea-studio/results/editor-save-followup/prior-search-installation/installation.json.snapshot',sha256:'6fce8ca3c3614000b897885ceb64896c659b67879199f2f6f0e963011a8f2057'},{path:'outputs/rea-research-lab/products/rea-studio/results/editor-workspace-search-followup/path-correction/frozen/freeze-manifest.json.snapshot',sha256:'d071d370be094646a4738de79adadca9c28d794de53dfb940604f5d52d056edf'},{path:'outputs/rea-research-lab/products/rea-studio/results/editor-workspace-search-followup/path-correction/frozen/validation.json.snapshot',sha256:'62a30543071d2962d2e978fd880d23840b9e797d788087cd9d6776ef1d3b183e'}];for(const r of anchors)assert.equal((await fp(path.join(workspace,r.path))).sha256,r.sha256);
const steps=await read('browser-steps.json'),get=n=>{const row=steps.find(r=>r.label===n);assert(row,n);return row.visible;},checks=[];function check(name,fn){fn();checks.push({name,passed:true});}
check('saved-file literal search and exact position',()=>{assert.match(get('basic-search').statuses[0],/^3 matches in 2 files/);assert.deepEqual([get('open-search-result').editor.selectionStart,get('open-search-result').editor.selectionEnd],[6,12]);});
check('saved search result retains existing dirty draft',()=>{assert.equal(get('saved-search-result-preserves-dirty-draft').editor.value,get('dirty-a-draft-before-search-result').editor.value);assert.match(get('saved-search-result-preserves-dirty-draft').statuses.at(-1),/current draft was retained/);});
check('duplicate pending Save shortcuts retain editable newer draft',()=>{const a=get('newer-a-draft-and-duplicate-save-keys');assert.equal(a.editor.disabled,false);assert.equal(a.saveEnabled,false);assert.match(a.statuses.at(-1),/still saving/);});
check('A completion preserves active B draft and contextual status',()=>{assert.deepEqual(get('b-draft-before-a-response'),get('a-response-does-not-publish-into-b'));assert.equal(get('return-to-retained-a-newer-draft').editor.value,'Owned A newer draft two\nneedle retained after Save\n');assert.match(get('save-retained-a-draft-again').statuses.at(-1),/^Saved owned-a.txt/);});
check('close/reopen document identity suppresses old Save publisher',()=>{assert.deepEqual(get('reopened-a-typed-before-old-save-response'),get('old-save-response-ignores-reopened-a-document'));assert.equal(get('close-clean-a-pending-tab').editor.value,'Owned B draft while A response held\n');assert.match(get('save-reopened-a-draft').statuses.at(-1),/^Saved owned-a.txt/);});
check('whole-view disposal protects fresh view from late committed response',()=>{assert.equal(get('dispose-old-editor-through-navigation').editor,null);assert.equal(get('fresh-view-reads-committed-a-four').editor.value,'Owned A committed before view disposal four\n');assert.deepEqual(get('fresh-view-newer-draft-before-old-response'),get('late-disposed-save-response-ignores-fresh-view'));assert.match(get('fresh-view-draft-save-succeeds').statuses.at(-1),/^Saved owned-a.txt/);});
const final=await read('observation-before-close.json'),first=await read('observation-save-a-held.json'),duplicate=await read('observation-duplicate-save-held.json'),host=await read('host.json');const saves=final.forwarded.filter(r=>r.method==='POST'&&r.url==='/api/editor/save');assert.equal(saves.length,6);assert.equal(final.forwarded.length,22);assert.equal(final.actualCalls.length,24);assert.equal(final.actualCalls.filter(r=>r.phase==='seed').length,2);assert.equal(final.actualCalls.filter(r=>r.phase==='browser').length,22);assert.deepEqual(final.actualCalls.filter(r=>r.phase==='browser').map(r=>[r.method,r.url,r.status]),final.forwarded.map(r=>[r.method,r.url,r.upstreamStatus]));assert.equal(final.holdRecords.length,3);assert.equal(final.held,null);assert.equal(final.armed,null);
check('three holds authenticate real committed disk; duplicate keys add zero Save requests',()=>{assert.equal(first.forwarded.filter(r=>r.url==='/api/editor/save').length,1);assert.equal(duplicate.forwarded.filter(r=>r.url==='/api/editor/save').length,1);assert.equal(first.forwarded.length,duplicate.forwarded.length);assert.deepEqual(final.holdRecords.map(r=>r.label),['save-a-switch','save-a-close','save-a-dispose']);for(const r of final.holdRecords){assert.equal(r.committedBeforeHold,true);assert.equal(r.status,200);assert.equal(sha(Buffer.from(r.disk.content)),r.disk.sha256);assert.equal(r.disk.sha256,r.response.revision);assert.equal(r.disk.content,r.response.content);assert(r.releasedAt);}});
check('all six real Save writes use expected captured revision chain and bounded synthetic final files',()=>{const texts=['Owned A captured Save one\nneedle browser draft\n','Owned A newer draft two\nneedle retained after Save\n','Owned A newer draft two\nneedle retained after Save\n','Owned reopened A newer draft three\n','Owned A committed before view disposal four\n','Owned fresh-view A draft six retained\n'];for(let i=0;i<saves.length;i++){assert.equal(saves[i].savedRequest.path,'owned-a.txt');assert.equal(saves[i].savedRequest.content,texts[i]);assert.equal(saves[i].upstreamStatus,200);assert(saves[i].deliveredAt);const expected=i===0?host.initial['owned-a.txt']:texts[i-1];assert.equal(saves[i].savedRequest.revision,sha(Buffer.from(expected)));}assert.equal(final.files['owned-a.txt'].content,texts.at(-1));assert.equal(final.files['owned-b.txt'].content,host.initial['owned-b.txt']);});
for(const r of final.forwarded){assert.equal(r.transforms.host.from,new URL(host.relayOrigin).host);assert.equal(r.transforms.host.to,new URL(host.actualHost).host);if(r.transforms.origin){assert.equal(r.transforms.origin.from,host.relayOrigin);assert.equal(r.transforms.origin.to,host.actualHost);}assert.equal(r.bodyBytes,r.transforms.contentLength);}const non200=final.forwarded.filter(r=>r.upstreamStatus!==200).map(r=>({url:r.url,status:r.upstreamStatus}));assert.deepEqual(non200,[{url:'/favicon.ico',status:404},{url:'/apps/notes/client.mjs',status:503}]);
const cleanup=await read('cleanup.json'),tab=await read('tab-cleanup.json');assert.equal(cleanup.actualHostClosed,true);assert.equal(cleanup.relayClosed,true);assert.equal(cleanup.tempDataRemoved,true);assert.equal(cleanup.source31AndControllerStable,true);assert.equal(tab.closeResolved,true);
await save('accounting.json',{currentSource31:true,sharedShell3:shell.map(r=>r.path),sharedHost3:hostRows.map(r=>r.path),browserCampaigns:1,semanticCheckGroups:checks.length,checks,browserSaveRequests:6,seedSaveRequests:2,committedHeldSaveResponses:3,browserForwardedRequests:22,actualHostRequests:24,browserSearchRequests:final.forwarded.filter(r=>r.url==='/api/editor/search').length,actualHostCountExactlySeedPlusForwarded:true,expectedFixtureNon200:non200,headerNormalizationFixtureOnly:true,noProxySecurityClaim:true,originalPreparedComparatorContextsExecutedNow:0,rootShorthandClarification:'Earlier search12 meant historical prepared-comparator contexts, not12 current source files. No twelve-source subset was generated or used for acceptance.',historicalEpochsNotRebound:true});
