    {
      "id": "grafana.candidate.3a05fec5d15cac03ea19",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For more information, refer to [Reporting](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/visualizations/dashboards/create-reports/#customize-template-variables).",
      "headingPath": [
        "What's new in Grafana v7.5",
        "Enterprise features",
        "Use template variable in reports"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-5.md",
        "gitBlobSha": "1f762193f381b785ad3976e03c8d01c40a0022d5",
        "sha256": "16b32d97207c71fd11291c626f8e3a3697a2a6efe831270739f398e87132cc21",
        "lineStart": 138,
        "lineEnd": 138,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v7-5.md#L138-L138"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
