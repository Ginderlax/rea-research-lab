    {
      "id": "grafana.candidate.8dc62dbc5317cf342cb5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When a Logs query uses the **Logs** result format, Grafana truncates the results to 30,000 rows to prevent the browser tab from crashing, because the logs visualization renders every row at once. When truncation happens, Grafana returns the first 30,000 rows along with a notice that the limit was reached.",
      "headingPath": [
        "Azure Monitor query editor",
        "Query Azure Monitor Logs",
        "Logs result row limit"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/query-editor/index.md",
