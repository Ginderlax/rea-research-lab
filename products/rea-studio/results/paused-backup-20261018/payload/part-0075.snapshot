    {
      "id": "grafana.candidate.50cf18eecfbb08312cc9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Git Sync is bidirectional, and syncs a repository resource with your Grafana instance. You can modify provisioned resources both from the Grafana UI or from the synced GitHub repository, and changes will be reflected in both places:",
      "headingPath": [
        "Git Sync key concepts",
        "How does Git Sync behave?"
      ],
