    {
      "id": "grafana.candidate.e0d304ca99bb494bed8c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana records a notification event each time it attempts to send a notification to a contact point for a group of alerts. Both firing and resolved notifications are recorded, so you'll see a complete delivery history even when an alert has already recovered.",
      "headingPath": [
        "View notification history"
      ],
      "source": {
        "path": "docs/sources/alerting/monitor-status/view-notification-history.md",
