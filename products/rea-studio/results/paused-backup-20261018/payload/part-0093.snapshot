 const parent=one('notesNewTodoOriginalHelperComparisons');assert.equal(parent.sourceCommit,'7e2765a3857754d12dbadea442b60ceaf9d4b23d');assert.equal(parent.comparisons,4);assert.deepEqual(parent.comparedFields,['parent_id','is_todo']);assert.deepEqual(parent.fieldsAdapter,['parent_id','is_todo','adapterSentinel']);assert.equal(parent.dueAndCompletionZerosAreCandidateOnlyChecks,true);assert.deepEqual(parent.sourcePins,{note:[45302,'5f1a200dc970179ad6fd193f7ffc47f09f88261cff8f893ccc793517ebbe9647'],base:[26960,'c0a19f6d2d689cc75de99e4ba57058ec02f9171c5b5b3c739aa45d11d5920fde']});assert.deepEqual(parent.bindings.map(row=>[row.owner,row.name]),[['BaseModel','new'],['Note','new'],['Note','newTodo']]);
