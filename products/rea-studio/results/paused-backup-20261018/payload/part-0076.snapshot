    },
    {
      "id": "grafana.candidate.9efd8f6ef6079c3efd09",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When a variable includes the **All** option (enabled in variable settings), you need to handle the case where the user selects \"All\" differently from individual selections.",
      "headingPath": [
        "Microsoft SQL Server template variables",
        "Handle the \"All\" option in SQL queries"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/template-variables/index.md",
