    {
      "id": "grafana.candidate.21fde6e340dbbf144343",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The label is an optional string to include on each packet and stream. It uniquely identifies the cluster and prevents cross-communication issues when sending gossip messages in an environment with multiple clusters.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[unified_alerting]`",
        "`ha_label`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
