    {
      "id": "grafana.candidate.9b62ae9925ba0f44bb37",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "After all permissions have been added, the Azure authentication section in Grafana must be updated. The `scopes` section must be updated to include the `.default` scope to ensure that a token with access to all APIs declared on the App Registration is requested by Grafana. After updated the scopes value should equal: `.default openid email profile`.",
      "headingPath": [
        "Configure the Microsoft SQL Server data source",
        "Configure the data source in the UI",
        "Azure Entra ID (formerly Azure AD) Authentication",
        "Current User authentication"
      ],
      "source": {
