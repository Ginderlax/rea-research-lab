      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.6922347a371a5c9983ec",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Introduces a new landing page that helps you get started quickly with Alerting. It also provides you with at a glance information on how Alerting works and a video to introduce you to key concepts.",
      "headingPath": [
        "What's new in Grafana v9.4",
        "Alerting",
        "Alerting: administration",
        "Alerting landing page"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-4.md",
