import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab'),stage=path.join(work,'vault-requirement-binding-correction-v2-next'),reviewFolder=path.join(work,'vault-requirement-binding-independent-review'),prefix='products/rea-studio/results/vault-requirement-binding-correction-20261013',dest=path.join(lab,prefix),sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)});
async function authority(folder,pin,count){const b=await fs.readFile(path.join(folder,'manifest.json'));assert.equal(sha(b),pin);const m=JSON.parse(b);assert.equal(m.inventory.length,count);for(const r of m.inventory){assert(!r.path.includes('..')&&!r.path.includes('\\')&&!path.isAbsolute(r.path));assert.deepEqual(id(await fs.readFile(path.join(folder,r.path))),{bytes:r.bytes,sha256:r.sha256});}return{b,m};}
const planPin='6d05393de6a4932a1fd150d10beba6fc77af36e4678c840aff8bf587ca4d7bdf',reviewPin='a4cd0b3bcef624dac42f3ee1e452725ed31d799b5ed14e85f9a04f07cab88748',plan=await authority(stage,planPin,12),review=await authority(reviewFolder,reviewPin,20),receipt=JSON.parse(await fs.readFile(path.join(reviewFolder,'review-validation.json')));assert.equal(receipt.metadataPlanAccepted,true);assert.equal(receipt.finiteSourceOnlyAcceptance,true);assert.equal(receipt.productionWrites,0);
const audit=JSON.parse(await fs.readFile(path.join(stage,'audit.json')));assert.equal(audit.changedLocalEvidence.length,4);assert.equal(audit.proposals.length,2);for(const r of audit.proposals){assert(['products/rea-studio/requirements/system-products.json','products/rea-studio/requirements/README.md'].includes(r.path));assert.deepEqual(id(await fs.readFile(path.join(lab,r.path))),r.before);assert.deepEqual(id(await fs.readFile(path.join(stage,r.source))),r.after);}
const sources=JSON.parse(await fs.readFile(path.join(work,'editor-vault-suite-runs/2026-10-13T05-22-11.249Z/source-before.json')));assert.equal(sources.length,737);async function apps(){for(const r of sources)assert.deepEqual(id(await fs.readFile(path.join(lab,'products/rea-studio',r.path))),{bytes:r.bytes,sha256:r.sha256});}await apps();assert.equal(sha(await fs.readFile(path.join(lab,'products/rea-studio/results/development-validation.json'))),audit.developmentReceiptSHA256);
await fs.mkdir(dest);const rows=[];async function save(n,b,sourcePath){const p=path.join(dest,n);await fs.mkdir(path.dirname(p),{recursive:true});await fs.writeFile(p,b,{flag:'wx'});rows.push({path:n,sourcePath,...id(b)});}
for(const [role,folder,a]of [['plan',stage,plan],['independent-review',reviewFolder,review]]){for(const r of a.m.inventory)await save(role+'/'+r.path+'.snapshot',await fs.readFile(path.join(folder,r.path)),'work/'+path.basename(folder)+'/'+r.path);await save(role+'/manifest.json.snapshot',a.b,'work/'+path.basename(folder)+'/manifest.json');}
const failed=path.join(work,'vault-requirement-binding-correction-next');for(const name of(await fs.readdir(failed)).sort())await save('first-failed-recorder/'+name+'.snapshot',await fs.readFile(path.join(failed,name)),'work/vault-requirement-binding-correction-next/'+name);
for(const r of audit.proposals){await fs.writeFile(path.join(lab,r.path),await fs.readFile(path.join(stage,r.source)));assert.deepEqual(id(await fs.readFile(path.join(lab,r.path))),r.after);}await apps();await authority(stage,planPin,12);await authority(reviewFolder,reviewPin,20);
const installation={at:new Date().toISOString(),metadataOnly:true,installed:audit.proposals,changedLocalEvidence:4,originalSourceIdentities:159,capabilityIDs:232,allLocalEvidence:251,applicationSourcesUnchanged:737,planSHA256:planPin,independentReviewSHA256:reviewPin,newAppOriginalBrowserBenchmarkExecutions:0,firstRecorderFault:'Initial whitelist omitted README; no production writes.',secondRecorderFault:'Console summary hardcoded three; source assertion and audit array four are authoritative.',oldReceiptsRebound:false};await save('root-installation.json.snapshot',Buffer.from(JSON.stringify(installation,null,2)+'\n'),'root-installation.json');await save('root-installation-collector.mjs.snapshot',await fs.readFile(import.meta.filename),'work/'+path.basename(import.meta.filename));const mb=Buffer.from(JSON.stringify({schema:'rea-vault-requirement-binding-public-preservation/v1',sourceOnly:true,snapshots:rows,metadataWrites:2,applicationSourcesUnchanged:737,behaviorReexecuted:false,oldReceiptsRebound:false},null,2)+'\n');await fs.writeFile(path.join(dest,'preservation-manifest.json'),mb,{flag:'wx'});console.log(JSON.stringify({metadataWrites:2,localRefsCorrected:4,snapshots:rows.length,manifestSHA256:sha(mb),applicationSourcesUnchanged:737}));
