// Strict source-only final consolidation and freeze; imports only own proof utility.
import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {EPOCHS,PUBLIC_PREFIX,identity,readBounded,authenticateEpoch,same,classify,safeRelative} from './notes-inline-provenance.mjs';
const root=import.meta.dirname,workspace=path.resolve(root,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),json=async p=>JSON.parse(await readBounded(root,p));async function write(p,v){await fs.writeFile(path.join(root,p),JSON.stringify(v,null,2)+'\n',{flag:'wx'});}
const before=await json('authentication-before.json'),after=await json('authentication-after.json');assert.deepEqual(before.epochs,after.epochs);for(let i=0;i<EPOCHS.length;i++)assert.deepEqual(await authenticateEpoch(workspace,EPOCHS[i]),before.epochs[i]);const map=await json('public-preservation-map.json'),ex=await json('local-exclusions.json'),live=await json('live-copy-list.json'),baseline=await json('installation-before34.json');assert.equal(map.payload.length,569);assert.equal(ex.excluded.length,9);assert.equal(live.proposals.length,8);assert.equal(baseline.length,34);const publicSeen=new Set();for(const r of map.payload){safeRelative(r.publicPath,true);assert.ok(!publicSeen.has(r.publicPath));publicSeen.add(r.publicPath);const b=await readBounded(path.join(workspace,r.sourceRoot),r.sourcePath,r);assert.equal(classify(b,r.sourcePath).publishable,true);}for(const r of ex.excluded){const b=await readBounded(path.join(workspace,r.sourceRoot),r.sourcePath,r);assert.equal(classify(b,r.sourcePath).publishable,false);assert.equal(r.sha256,'044885c906ba7d8cb97a95fbdd6bc2323ba31a3c301e7ed1d6e592acec8944af');}for(const r of live.proposals){await readBounded(root,r.proposalPath,r.after);await readBounded(path.join(workspace,r.sourceRoot),r.sourcePath,r.sourceIdentity);}for(const r of baseline){await readBounded(repo,r.path,r);await readBounded(root,r.snapshot,r);}const req=await json('requirements-identity-reference.json');assert.equal(req.sourceIdentities159Unchanged,true);assert.equal(req.capabilityIds232Unchanged,true);for(const r of req.registries)await readBounded(repo,r.path,r);
