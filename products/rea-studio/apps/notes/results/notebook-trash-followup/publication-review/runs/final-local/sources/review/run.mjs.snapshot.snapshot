import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import {spawn} from 'node:child_process';
const root=import.meta.dirname,hash=b=>createHash('sha256').update(b).digest('hex'),baseline=JSON.parse(await fs.readFile(path.join(root,'baseline.json'))),run=path.join(root,'runs',process.argv[2]??'fresh-final');await fs.mkdir(run,{recursive:true});
async function authenticate(){for(const r of baseline.references){const folder=path.resolve(root,r.root),b=await fs.readFile(path.join(folder,r.manifest));if(hash(b)!==r.sha256)throw new Error('Manifest changed');const m=JSON.parse(b);for(const row of m.records??m.files){const b=await fs.readFile(path.join(folder,row.path));if(b.length!==row.bytes||hash(b)!==row.sha256)throw new Error('Changed '+r.root+'/'+row.path);}}}
const tests=['regression/review.test.mjs','regression/publication-boundaries.test.mjs','regression/fresh-boundaries.test.mjs'];async function capture(){const paths=[...baseline.snapshots.map(p=>({folder:path.resolve(root,'../notes-trash-publication-fix-next'),path:p})),...[...tests,'regression/ui-fixture.mjs','run.mjs'].map(p=>({folder:root,path:p}))];return Promise.all(paths.map(async r=>{const b=await fs.readFile(path.join(r.folder,r.path));return{...r,bytes:b.length,sha256:hash(b)};}));}
await authenticate();const before=await capture();for(const r of before){const location=path.join(run,'sources',r.folder===root?'review':'candidate',r.path+'.snapshot');await fs.mkdir(path.dirname(location),{recursive:true});await fs.copyFile(path.join(r.folder,r.path),location);}await fs.writeFile(path.join(run,'source-before.json'),JSON.stringify(before,null,2)+'\n');
const env={...process.env,NOTES_REVIEW_OUTPUT:new URL('./runs/'+path.basename(run)+'/observations/',import.meta.url).href};delete env.NODE_TEST_CONTEXT;const p=spawn(process.execPath,['--test','--test-reporter=tap','--test-concurrency=1',...tests],{cwd:root,env,windowsHide:true,stdio:['ignore','pipe','pipe']}),logs={stdout:[],stderr:[]},sizes={stdout:0,stderr:0};let problem=null;const timer=setTimeout(()=>{problem='60-second deadline';p.kill()},60000);for(const k of['stdout','stderr'])p[k].on('data',b=>{sizes[k]+=b.length;if(sizes[k]>4*1024*1024){problem='capture cap';p.kill()}else logs[k].push(b)});p.on('error',e=>problem=e.message);const code=await new Promise(r=>p.on('close',r));clearTimeout(timer);for(const k of['stdout','stderr'])await fs.writeFile(path.join(run,k+'.txt'),Buffer.concat(logs[k]));const after=await capture();await authenticate();await fs.writeFile(path.join(run,'source-after.json'),JSON.stringify(after,null,2)+'\n');const raw=Buffer.concat(logs.stdout).toString(),num=n=>Number(new RegExp('^# '+n+' (\\d+)$','m').exec(raw)?.[1]??NaN),receipt={completedAt:new Date().toISOString(),code,problem,tests:num('tests'),pass:num('pass'),fail:num('fail'),skipped:num('skipped'),cancelled:num('cancelled'),sourceStable:JSON.stringify(before)===JSON.stringify(after),all866ArtifactsAuthenticatedBeforeAfter:true,originalApplicationExecutions:0,originalGUIExecutions:0,actualHostProcesses:0,browserChecks:0,sources:before};await fs.writeFile(path.join(run,'validation.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({...receipt,sources:undefined,run}));process.exitCode=code;
