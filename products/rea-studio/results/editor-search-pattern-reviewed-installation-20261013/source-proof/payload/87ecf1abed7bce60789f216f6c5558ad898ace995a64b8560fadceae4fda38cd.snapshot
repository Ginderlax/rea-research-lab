// New correction epoch. Earlier author573/plan44 stay immutable and fully retained.
import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const root=import.meta.dirname,workspace=path.resolve(root,'../..'),sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)}),epochs=[['author573','work/editor-search-pattern-next','7f975ae3f7a0827f5b9ade231bd121c5b4028f17d88758455fd680962ff0f878',573],['plan44','work/editor-search-pattern-publication-plan','480b15c9c47c095b70d972b550312ead3e075efe62bd8c502a008bbde9dfb3fb',44]],kept=[];async function keep(p,b){const q=path.join(root,p);await fs.mkdir(path.dirname(q),{recursive:true});await fs.writeFile(q,b,{flag:'wx'});}
for(const[epoch,folder,pin,count]of epochs){const sourceRoot=path.join(workspace,folder),mb=await fs.readFile(path.join(sourceRoot,'freeze-manifest.json'));assert.equal(sha(mb),pin);const m=JSON.parse(mb);assert.equal(m.inventory.length,count);const names=[];async function walk(f=''){for(const e of await fs.readdir(path.join(sourceRoot,f),{withFileTypes:true})){assert.equal(e.isSymbolicLink(),false);const p=f?f+'/'+e.name:e.name;if(e.isDirectory())await walk(p);else{assert.ok(e.isFile());names.push(p);}}}await walk();assert.deepEqual(names.sort(),[...m.inventory.map(r=>r.path),'freeze-manifest.json'].sort());for(const row of[...m.inventory,{path:'freeze-manifest.json',...id(mb)}]){const b=await fs.readFile(path.join(sourceRoot,row.path));assert.deepEqual(id(b),{bytes:row.bytes,sha256:row.sha256});await keep('history/'+epoch+'/'+row.path+'.snapshot',b);}kept.push({epoch,sourceRoot:folder,payloads:count,manifest:{bytes:mb.length,sha256:pin},copiedRows:count+1,originalBytesUnchanged:true});}
const final=JSON.parse(await fs.readFile(path.join(workspace,'work/editor-search-pattern-next/candidate-final-sources.json'))).rows;for(const row of final){const b=await fs.readFile(path.join(workspace,'work/editor-search-pattern-next',row.path));assert.deepEqual(id(b),{bytes:row.bytes,sha256:row.sha256});await keep(row.path,b);await keep('before-image/'+row.path+'.snapshot',b);}await keep('preparation-validation.json',Buffer.from(JSON.stringify({at:new Date().toISOString(),epochs:kept,candidate39Copied:true,appExecutions:0,originalCalls:0,browserCalls:0,benchmark:0,productionWrites:0,authorization:'Root explicitly authorized new correction epoch after confirmed actual Chrome finding; earlier wait-for-negative-pin superseded, exact negative proof will be appended/authenticated before freeze.'},null,2)+'\n'));console.log(JSON.stringify({historyPayloads617AndTwoManifests:true,candidate39Copied:true,appCalls:0,productionWrites:0}));
