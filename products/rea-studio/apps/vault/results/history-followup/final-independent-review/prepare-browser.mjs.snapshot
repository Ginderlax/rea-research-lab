import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath,pathToFileURL} from 'node:url';import {createHash} from 'node:crypto';
const own=path.dirname(fileURLToPath(import.meta.url)),stage=path.resolve(own,'../keepass-history-draft-fix-next'),source=path.resolve(own,'../keepass-history-selection-fix-next/host'),host=path.join(own,'host'),sha=b=>createHash('sha256').update(b).digest('hex');
const authenticated=JSON.parse(await fs.readFile(path.join(own,'baseline-validation.json'),'utf8'));for(const e of authenticated.candidateFingerprints){if(sha(await fs.readFile(path.join(stage,e.path)))!==e.sha256)throw new Error('Candidate changed before browser setup');}
const mapping=[];for(const name of ['server.mjs','catalog.mjs','lib/storage.mjs','public/index.html','public/studio.mjs','public/style.css']){const bytes=await fs.readFile(path.join(source,name)),target=path.join(host,name);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,bytes);mapping.push({source:path.join(source,name),target:name,sha256:sha(bytes),transformation:'exact retained shared-host bytes'});}
await fs.mkdir(path.join(host,'apps/vault'),{recursive:true});const client=await fs.readFile(path.join(stage,'client.mjs'));await fs.writeFile(path.join(host,'apps/vault/client.mjs'),client);mapping.push({source:path.join(stage,'client.mjs'),target:'apps/vault/client.mjs',sha256:sha(client),transformation:'exact frozen candidate client'});
const adapter=`import {handle as originalHandle,dispose} from ${JSON.stringify(pathToFileURL(path.join(stage,'server.mjs')).href)};\nexport {dispose};\nlet gate;\nexport function arm(action){if(gate)throw new Error('A gate is already armed');let release;gate={action,promise:new Promise(resolve=>release=resolve),release:()=>release()};}\nexport function release(){gate?.release();gate=undefined;}\nexport async function handle(context){const result=await originalHandle(context);if(gate?.action===context.action){const captured=gate;process.stdout.write('OWNED_GATE_HELD '+context.action+'\\n');await captured.promise;}return result;}\n`;
await fs.writeFile(path.join(host,'apps/vault/server.mjs'),adapter);mapping.push({source:path.join(stage,'server.mjs'),target:'apps/vault/server.mjs',sha256:sha(Buffer.from(adapter)),transformation:'Explicit owned preview adapter imports exact real server; optional post-result response gate for synthetic browser probes only; no application source edits'});
await fs.mkdir(path.join(own,'browser-proof'),{recursive:true});await fs.writeFile(path.join(own,'browser-proof/source-binding.json'),JSON.stringify({schema:'rea-independent-vault-preview-source-binding/v1',candidateFingerprints:authenticated.candidateFingerprints,mapping,scope:'Owned ephemeral private preview using retained shared-host bytes, exact candidate client and explicit runtime-import/test-only response gate adapter; other applications unused'},null,2)+'\n');console.log('Owned browser preview source prepared.');
