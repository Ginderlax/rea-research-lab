import test from 'node:test';import assert from 'node:assert/strict';import {fixture,deferred,button,field,openEntry,descendants} from './ui-fixture.mjs';
test('a held Open A read cannot replace a later Open B editor or redirect its save',async t=>{
 const arrived=deferred(),release=deferred();let first=true;const f=await fixture(t,'late-open-a',async(action,input,real)=>{const result=await real();if(action==='read'&&first){first=false;arrived.resolve();await release.promise}return result});const pending=openEntry(f.root,'Entry A');await arrived.promise;await openEntry(f.root,'Entry B');field(f.root,'Notes').value='B own draft';release.resolve();await pending;assert.equal(field(f.root,'Title').value,'Entry B');assert.equal(field(f.root,'Notes').value,'B own draft');await button(f.root,'Save encrypted entry').click();assert.equal(f.requests.filter(r=>r.action==='save').at(-1).id,f.B);assert.equal((await f.call('read',{id:f.A})).entry.password,'A second');f.observation.safeVisibleEntryAndSave=true;
});
test('closing history while its preview is held prevents late secret publication',async t=>{
 const arrived=deferred(),release=deferred(),f=await fixture(t,'close-held-preview',async(action,input,real)=>{const result=await real();if(action==='historyRead'){arrived.resolve();await release.promise}return result});await openEntry(f.root,'Entry A');await button(f.root,'Show entry history').click();const pending=button(f.root,'View this version').click();await arrived.promise;await button(f.root,'Close history').click();release.resolve();await pending;assert.equal(descendants(f.root).some(n=>n.value==='A original'),false);assert.equal(descendants(f.root).some(n=>n.tagName==='label'&&n.ownText==='Previous password'),false);assert.equal(field(f.root,'Password').value,'A second');f.observation.closedPreviewDidNotRepublishSecret=true;
});
test('an older search response cannot replace newer search results or a new editor draft',async t=>{
 const arrived=deferred(),release=deferred();let hold=false,once=true;const f=await fixture(t,'older-list-response',async(action,input,real)=>{const result=await real();if(action==='list'&&hold&&once){once=false;arrived.resolve();await release.promise}return result});await openEntry(f.root,'Entry A');hold=true;field(f.root,'Search entries').value='Entry A';const pending=button(f.root,'Search').click();await arrived.promise;const searchButton=button(f.root,'Search');searchButton.disabled=false;field(f.root,'Search entries').value='Entry B';await searchButton.click();await button(f.root,'New entry').click();field(f.root,'Title').value='New draft';release.resolve();await pending;const titles=descendants(f.root).filter(n=>n.tagName==='strong').map(n=>n.textContent);assert.deepEqual(titles,['Entry B']);assert.equal(field(f.root,'Title').value,'New draft');f.observation.latestSearchAndEditorPreserved=true;
});
