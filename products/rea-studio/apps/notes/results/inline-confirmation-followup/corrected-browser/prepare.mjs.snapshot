import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const here=import.meta.dirname,workspace=path.resolve(here,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),studio=path.join(repo,'products/rea-studio'),sha=b=>createHash('sha256').update(b).digest('hex'),write=(n,v)=>fs.writeFile(path.join(here,n),JSON.stringify(v,null,2)+'\n',{flag:'wx'});
async function inventory(dir,name,expected){const bytes=await fs.readFile(path.join(dir,name));assert.equal(sha(bytes),expected);const m=JSON.parse(bytes),records=m.inventory??Object.fromEntries(m.records.map(r=>[r.path,r]));for(const[p,r]of Object.entries(records)){const b=await fs.readFile(path.join(dir,p));assert.deepEqual({bytes:b.length,sha256:sha(b)},{bytes:r.bytes,sha256:r.sha256},p);}async function walk(d,p=''){const rows=[];for(const e of await fs.readdir(d,{withFileTypes:true})){const n=p+e.name;if(e.isDirectory())rows.push(...await walk(path.join(d,e.name),n+'/'));else rows.push(n);}return rows;}assert.deepEqual((await walk(dir)).sort(),[...Object.keys(records),name].sort());return {directory:path.relative(workspace,dir).replaceAll('\\','/'),manifest:name,sha256:expected,files:m.files,receipt:sha(await fs.readFile(path.join(dir,dir.endsWith('independent-review')?'review-validation.json':'validation.json')))};}
const authorities=[await inventory(path.join(workspace,'work/notes-inline-cancel-no-read-next'),'freeze-manifest.json','5fcb71d9abddbbc6d0077da9cbbe0808b7be5ff4d66ce94a747f311ab6a3d7bb'),await inventory(path.join(workspace,'work/notes-inline-cancel-no-read-independent-review'),'review-manifest.json','dc5263f7197b2004f839ff53a9e2fceb96c265ae85002f9f9f2151fd38235198')];
const accepted=JSON.parse(await fs.readFile(path.join(workspace,'work/notes-inline-cancel-no-read-independent-review/review-validation.json')));assert.equal(authorities[1].receipt,'de13cff74b6842ac6849761d4421b3ed75ce7cb36034baa9b1ffbf7df6f82c6c');const runtime=new Map(accepted.runtime.map(r=>[r.path,r]));const paths=['server.mjs','catalog.mjs','lib/storage.mjs','public/index.html','public/studio.mjs','public/style.css',...['client','server','jex','markdown','notebooks','notebook-trash'].map(n=>'apps/notes/'+n+'.mjs')],rows=[];
for(const rel of paths){const original=rel==='apps/notes/client.mjs'?path.join(workspace,'work/notes-inline-cancel-no-read-next/products/rea-studio',rel):path.join(studio,rel),b=await fs.readFile(original);if(rel.startsWith('apps/notes/')){const r=runtime.get(path.basename(rel));assert.deepEqual({bytes:b.length,sha256:sha(b)},{bytes:r.bytes,sha256:r.sha256});}const target=path.join(here,'studio',rel);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b,{flag:'wx'});rows.push({path:rel,original:path.relative(workspace,original).replaceAll('\\','/'),bytes:b.length,sha256:sha(b),clone:'studio/'+rel});}
await write('source-before.json',rows);await write('authority-before.json',authorities);const b=await fs.readFile(path.join(studio,'apps/notes/client.mjs'));await write('production-client-baseline.json',{path:'products/rea-studio/apps/notes/client.mjs',bytes:b.length,sha256:sha(b),notUsedByBrowser:true});const attachment=Buffer.from('Owned Notes attachment roundtrip\nUTF-8: café\nBinary tail: \0\u0001\u0002\n','utf8');await fs.writeFile(path.join(here,'owned-attachment.txt'),attachment,{flag:'wx'});await write('fixture.json',{attachment:{path:'owned-attachment.txt',bytes:attachment.length,sha256:sha(attachment)},syntheticOnly:true});console.log(JSON.stringify({sourceFiles:rows.length,authorities,attachmentBytes:attachment.length}));
