assert.equal(correction.currentTarget, 'products/rea-studio/apps/archive/sevenzip-aes-bounds.test.mjs');
assert.equal(correction.freshFiniteIncludesCorrectedBoundsGroups, 3); assert.equal(correction.targeted3OverlapFiniteSelection, true);
const gitCorrection = spawnSync('git', ['-C', repository, 'show', commit + ':' + correctionPath], { shell: false, windowsHide: true, timeout: 30000, maxBuffer: 2 * 1024 * 1024 }); assert.equal(gitCorrection.status, 0); assert.deepEqual(correctionBytes, gitCorrection.stdout);
