    {
      "id": "grafana.candidate.be971e3c280764b102e3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Similarly, the `rules sync` command can import and update Grafana-managed alert rules.",
      "headingPath": [
