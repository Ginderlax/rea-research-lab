        "lineEnd": 89,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-2.md#L89-L89"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
