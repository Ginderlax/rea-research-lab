    {
      "id": "grafana.candidate.c00184b1d2d4d559435b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use this transformation to merge multiple results into a single table, enabling the consolidation of data from different queries.",
      "headingPath": [
        "Transform data",
        "Transformation functions",
        "Join by field"
      ],
      "source": {
