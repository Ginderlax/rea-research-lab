import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,dest=path.join(here,'failed-preparation');await fs.mkdir(dest,{recursive:false});for(const n of['prepare.mjs','preparation.stdout.txt','preparation.stderr.txt'])await fs.writeFile(path.join(dest,n+'.snapshot'),await fs.readFile(path.join(here,n)),{flag:'wx'});const from=path.resolve(here,'studio'),to=path.resolve(dest,'studio');assert.equal(path.dirname(from),here);assert.equal(path.dirname(to),dest);assert.ok(to.startsWith(here+path.sep));await fs.rename(from,to);const rows=[];async function walk(folder=''){for(const e of await fs.readdir(path.join(to,folder),{withFileTypes:true})){assert.equal(e.isSymbolicLink(),false);const p=folder?folder+'/'+e.name:e.name;if(e.isDirectory())await walk(p);else{const b=await fs.readFile(path.join(to,p));rows.push({path:p,bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});}}}await walk();await fs.writeFile(path.join(dest,'failure.json'),JSON.stringify({cause:'Wrong shell name styles.css, actual current style.css; preparation failed after41 copies. No app import/host/browser/test executed.',partialSourceRows:rows.length,rows,sourceOnly:true},null,2)+'\n',{flag:'wx'});let s=await fs.readFile(path.join(here,'prepare.mjs'),'utf8');assert.equal(s.split('public/styles.css').length,2);s=s.replace('public/styles.css','public/style.css');await fs.writeFile(path.join(here,'prepare.mjs'),s);
