import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const base=path.resolve(import.meta.dirname,'..'),old=path.join(base,'work/sketch-alignment-next'),review=path.join(base,'work/sketch-alignment-independent-review'),root=path.join(base,'work/sketch-layout-precision-next'),sha=b=>createHash('sha256').update(b).digest('hex');
function inventory(dir,rel=''){return fs.readdirSync(path.join(dir,rel),{withFileTypes:true}).flatMap(e=>{assert.ok(!e.isSymbolicLink());const n=rel?rel+'/'+e.name:e.name;return e.isDirectory()?inventory(dir,n):[{path:n,bytes:fs.statSync(path.join(dir,n)).size,sha256:sha(fs.readFileSync(path.join(dir,n)))}];}).sort((a,b)=>a.path.localeCompare(b.path));}
function strict(dir,name,pin,count){const b=fs.readFileSync(path.join(dir,name));assert.equal(sha(b),pin);const rows=JSON.parse(b).records;assert.equal(rows.length,count);for(const r of rows){const x=fs.readFileSync(path.join(dir,r.path));assert.equal(x.length,r.bytes);assert.equal(sha(x),r.sha256);}assert.deepEqual(inventory(dir).map(r=>r.path).sort(),[...rows.map(r=>r.path),name].sort());return{path:name,bytes:b.length,sha256:pin,records:rows};}
const oldAuth=strict(old,'freeze-manifest.json','4684a6dffad102c461531476d4c24ad8b8eb5783b226aad9bbf82e2b81e0f2c7',277),reviewAuth=strict(review,'review-manifest.json','fed8216fa2a85da04ea0d2a16750f1fbb3891959f122272adb05222019f85559',111);
assert.ok(!fs.existsSync(root));fs.mkdirSync(root,{recursive:true});const source=JSON.parse(fs.readFileSync(path.join(old,'runs/2026-10-13T02-26-58.846Z/source-before.json')));assert.equal(source.length,53);
for(const r of source){const b=fs.readFileSync(path.join(old,r.path));assert.equal(sha(b),r.sha256);const p=path.join(root,r.path);fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,b,{flag:'wx'});}
fs.writeFileSync(path.join(root,'authority.json'),JSON.stringify({schema:'rea-sketch-layout-precision-correction-authority/v1',at:new Date().toISOString(),oldCandidate:oldAuth,independentNegative:reviewAuth,copiedActiveSourceRecords:53,sourceChangesBeforeBaseline:0,originalExecutedAtPreparation:0,productionWrites:0,preparationReadFailures:[{path:'work/sketch-alignment-next/layout.mjs',reason:'Root read guessed top-level runtime path; correct runtime is products/rea-studio/apps/sketch/layout.mjs; no write or execution'},{path:'work/sketch-alignment-next/original/packages/excalidraw/distribute.ts.snapshot',reason:'Root read used workspace-relative work path while cwd was lab; subsequent absolute workspace context read succeeded; no write or execution'}]},null,2)+'\n',{flag:'wx'});
fs.copyFileSync(import.meta.filename,path.join(root,'prepare-collector.mjs.snapshot'),fs.constants.COPYFILE_EXCL);
console.log(JSON.stringify({root,copiedSourceRecords:53,oldCandidateArtifacts:277,independentNegativeArtifacts:111,productionWrites:0}));
