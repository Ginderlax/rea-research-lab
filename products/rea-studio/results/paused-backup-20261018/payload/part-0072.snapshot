 const files=fs.readdirSync(root).filter(file=>file.endsWith('.mjs'));
 for(const file of files){const check=spawnSync(process.execPath,['--check',path.join(root,file)],{encoding:'utf8'});if(check.status!==0)throw Error(file+': '+check.stderr);}
 const published=fs.readdirSync(root).filter(file=>fs.statSync(path.join(root,file)).isFile());
 const missing=['REPORT.md','study.json','claim-ledger.json','NOTICE.md','LICENSE','provenance.json','rea-evidence-summary.json','reconstruction.mjs','reproduce.mjs','test-results.json'].filter(file=>!published.includes(file));
 if(missing.length)throw Error('Missing outputs: '+missing);
 console.log(JSON.stringify({project:name,scriptsSyntaxChecked:files.length,status:study.status,differential:study.tests.differentialComparisons,invariants:study.tests.modelInvariants,failed:result.failed,reportBytes:Buffer.byteLength(report)}));
}
