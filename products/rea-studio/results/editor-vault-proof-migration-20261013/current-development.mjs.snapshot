import assert from 'node:assert/strict';import {readFileSync,writeFileSync,lstatSync,realpathSync} from 'node:fs';import {resolve,relative,sep} from 'node:path';import {createHash} from 'node:crypto';
const stage=import.meta.dirname,root=realpathSync(resolve(stage,'../../outputs/rea-research-lab')),sha=b=>createHash('sha256').update(b).digest('hex'),seen=new Map();let total=0;
function read(p,id){assert(typeof p==='string'&&p.length>0&&!/[\\:\x00-\x1f]/.test(p)&&p.split('/').every(s=>s&&s!=='.'&&s!=='..'));let at=root;for(const s of p.split('/')){at=resolve(at,s);assert(!lstatSync(at).isSymbolicLink());}const rel=relative(root,realpathSync(at));assert(rel&&rel!=='..'&&!rel.startsWith('..'+sep));const stat=lstatSync(at);assert(stat.isFile()&&stat.size<=32*1024*1024);const b=readFileSync(at),r={bytes:b.length,sha256:sha(b)};if(id){if(id.bytes!==undefined)assert.equal(r.bytes,id.bytes,p);assert.equal(r.sha256,id.sha256,p);}if(seen.has(p))assert.deepEqual(r,seen.get(p));else{seen.set(p,r);total+=b.length;assert(seen.size<=1700&&total<=512*1024*1024);}return b;}
const devPath='products/rea-studio/results/development-validation.json',devBytes=read(devPath,{bytes:137063,sha256:'333303c8bd8cd131da3f01e1414b0fba92bc321b2b63f178ab91d138b2bcfa44'}),dev=JSON.parse(devBytes);assert.equal(dev.summary.tests,937);assert.equal(dev.summary.pass,937);for(const k of ['fail','cancelled','skipped','todo'])assert.equal(dev.summary[k],0);assert.equal(dev.source_files.length,737);for(const r of dev.source_files)read('products/rea-studio/'+r.path,r);
const prefix='products/rea-studio/results/editor-vault-combined-20261013',mb=read(prefix+'/preservation-manifest.json',{sha256:'e1c9211ca4cd302faf4e819077e5809d01539091cc8fc541fbccfde428a0b80b'}),manifest=JSON.parse(mb),rs=manifest.snapshots??manifest.records;assert(Array.isArray(rs)&&rs.length===753);const unique=new Set();for(const r of rs){const p=r.publicPath??prefix+'/'+r.path;assert(!unique.has(p));unique.add(p);read(p,r);}
const statusPath='products/rea-studio/STATUS.json',status=JSON.parse(read(statusPath,{bytes:11536,sha256:'1f6eec5b4a171713ed42374cd1fd5b3878e1cfe891173394e4cd20cf4396df4b'}));assert.equal(status.current_milestone_record,'EDITOR-PATTERN-VAULT-GROUP-MILESTONE.md');assert.equal(status.goal_status,'active');assert.equal(status.complete_replacement_products,0);
for(const [p,r]of seen)read(p,r);const result={schema:'rea-editor-vault-current-development-source-only/v1',at:new Date().toISOString(),summary:dev.summary,currentSourceFiles:737,currentSourceFingerprintsChecked:737,currentDevelopment:{path:devPath,...seen.get(devPath)},currentStatus:{path:statusPath,...seen.get(statusPath)},current753Capsule:{path:prefix+'/preservation-manifest.json',...seen.get(prefix+'/preservation-manifest.json')},capsuleSnapshots:753,sourceBeforeAfterStable:true,authenticatedFiles:seen.size,authenticatedBytes:total,observedSources:[...seen].map(([path,r])=>({path,...r})),appTestsRerun:false,originalExecutions:0,browsers:0,benchmarks:0,interpretation:'Separate finite current937/737 source authentication; historical847 remains its exact beforemetadata/capsule. No dev/status hash is embedded in the migration verifier after-body, avoiding cyclic future metadata pins.'};writeFileSync(resolve(stage,'current-development-validation.json'),JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify({sourceOnly:true,currentTests:937,currentSources:737,all753Snapshots:true,sourceStable:true,authenticated:seen.size}));
