    {
      "id": "grafana.candidate.b8da82131392fb2558db",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Firing (and resolved) alert instances are sent for notifications, either directly to a contact point or through notification policies for more flexibility.",
