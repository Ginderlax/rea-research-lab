    },
    {
      "id": "grafana.candidate.116c52041dbe17418efd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Click **Manage private data source connect** to go to your PDC connection page, where you'll find your PDC configuration details.",
      "headingPath": [
        "Configure the InfluxDB data source",
        "Configuration options",
        "Private data source connect"
      ],
      "source": {
        "path": "docs/sources/datasources/influxdb/configure/_index.md",
