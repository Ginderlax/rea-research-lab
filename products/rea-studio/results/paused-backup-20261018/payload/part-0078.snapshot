    {
      "id": "grafana.candidate.f69e84f13667079cba82",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Log context is a feature that displays additional lines of context surrounding a log entry that matches a specific search query. This helps in understanding the context of the log entry and is similar to the `-C` parameter in the `grep` command.",
