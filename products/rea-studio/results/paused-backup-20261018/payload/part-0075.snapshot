    {
      "id": "grafana.candidate.a9937b3eec7376b5bdd6",
      "syntaxRole": "table-row",
      "sourceText": "| `allowed_auth_providers`            | Specifies which authentication providers are allowed for the CloudWatch data source as a comma-separated list. The default is `default,keys,credentials`: `default` (AWS SDK Default), `keys` (Access and secret key), and `credentials` (Credentials file). The `ec2_iam_role` (EC2 IAM role) provider is also available but isn't enabled by default.                                                                                         |",
      "headingPath": [
        "Configure the Amazon CloudWatch data source",
        "Configure the data source in the UI",
        "Configure the data source with grafana.ini"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/configure/index.md",
        "gitBlobSha": "55de406ecf9d9059613bbf9035604a180127e1c5",
        "sha256": "503d730eec9d66ae219c4ba63e6a3284727b034befb2f41af9502edd47cea32e",
        "lineStart": 352,
        "lineEnd": 352,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/aws-cloudwatch/configure/index.md#L352-L352"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.2ef9cf08c9476317e8d6",
      "syntaxRole": "table-row",
      "sourceText": "| `assume_role_enabled`               | Allows you to disable `assume role (ARN)` in the CloudWatch data source. The assume role (ARN) is enabled by default in open source Grafana.                                                                                                                                                                                                                                                                                                    |",
      "headingPath": [
        "Configure the Amazon CloudWatch data source",
        "Configure the data source in the UI",
        "Configure the data source with grafana.ini"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/configure/index.md",
        "gitBlobSha": "55de406ecf9d9059613bbf9035604a180127e1c5",
