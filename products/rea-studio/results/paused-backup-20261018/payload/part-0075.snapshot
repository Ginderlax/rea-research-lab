    {
      "id": "grafana.candidate.2aa76eddbd869b5c167b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Labels are essential for scaling your alerting setup. They define metadata like `severity`, `team`, `category`, or `environment`, which you can use for alert routing.",
      "headingPath": [
        "Example of dynamic labels in alert instances"
