    },
    {
      "id": "grafana.candidate.f14b457676f04a880149",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The command palette has been updated to provide a more efficient way to navigate Grafana. You can now search and access all pages and recent dashboards, making it easier to perform tasks without taking your hands off the keyboard.",
      "headingPath": [
        "What's new in Grafana v9.4",
        "Search and navigation",
        "Command palette enhancements"
      ],
      "source": {
