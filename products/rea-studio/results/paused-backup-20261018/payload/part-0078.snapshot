    },
    {
      "id": "grafana.candidate.e7d3edb82d2c20bdbd31",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For self-managed Grafana (both Enterprise and OSS), the support for versions follows these rules:",
      "headingPath": [
        "Strategies for upgrading your self-managed Grafana instance",
        "What to know about version support"
      ],
