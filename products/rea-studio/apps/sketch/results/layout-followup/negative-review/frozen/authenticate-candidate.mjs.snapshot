import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,stage=path.resolve(here,'../sketch-alignment-next'),sha=b=>createHash('sha256').update(b).digest('hex'),write=(n,v)=>fs.writeFile(path.join(here,n),JSON.stringify(v,null,2)+'\n',{flag:'wx'}),mb=await fs.readFile(path.join(stage,'freeze-manifest.json'));assert.equal(sha(mb),'4684a6dffad102c461531476d4c24ad8b8eb5783b226aad9bbf82e2b81e0f2c7');const manifest=JSON.parse(mb);assert.equal(manifest.files,277);for(const r of manifest.records){const b=await fs.readFile(path.join(stage,r.path));assert.deepEqual({bytes:b.length,sha256:sha(b)},{bytes:r.bytes,sha256:r.sha256},r.path);}async function walk(d,p=''){const out=[];for(const e of await fs.readdir(d,{withFileTypes:true})){if(e.isDirectory())out.push(...await walk(path.join(d,e.name),p+e.name+'/'));else out.push(p+e.name);}return out;}assert.deepEqual((await walk(stage)).sort(),[...manifest.records.map(r=>r.path),'freeze-manifest.json'].sort());const receipt=await fs.readFile(path.join(stage,'validation.json'));assert.equal(sha(receipt),'8e806650afe7211d03658acf254a19751b57ac554b8ef299c0a3f3fb58d256ab');const provenanceBytes=await fs.readFile(path.join(stage,'source-provenance.json')),provenance=JSON.parse(provenanceBytes);assert.equal(provenance.fetched.length,8);await fs.mkdir(path.join(here,'candidate'),{recursive:true});for(const[n,b]of[['freeze-manifest.json',mb],['validation.json',receipt],['source-provenance.json',provenanceBytes]])await fs.writeFile(path.join(here,'candidate',n+'.snapshot'),b,{flag:'wx'});const originalAdded=provenance.fetched.find(r=>r.sourcePath==='packages/excalidraw/element/mutateElement.ts'),bytes=await fs.readFile(path.join(stage,originalAdded.path));assert.equal(sha(bytes),originalAdded.sha256);await fs.mkdir(path.dirname(path.join(here,originalAdded.path)),{recursive:true});await fs.writeFile(path.join(here,originalAdded.path),bytes,{flag:'wx'});const rows=manifest.records.filter(r=>r.path.startsWith('products/rea-studio/')&&!r.path.includes('/results/'));for(const r of rows){const target=path.join(here,'candidate-source',r.path+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,await fs.readFile(path.join(stage,r.path)),{flag:'wx'});}await write('candidate-before.json',{at:new Date().toISOString(),stage:'work/sketch-alignment-next',manifestSHA256:sha(mb),receiptSHA256:sha(receipt),files:277,originalSourceFiles:8,originalAdded,sourceRows:rows,candidateExecuted:false,missingBaselineStorageNowPreserved:true});console.log(JSON.stringify({candidate277Authenticated:true,original8:true,selectedSourceRows:rows.length,candidateExecuted:false}));
