    {
      "id": "grafana.candidate.b75fd3eda557ad899008",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can also use **Random Walk (with error)**, which returns valid data alongside an error, to test how the alerting engine handles partial failures.",
      "headingPath": [
        "TestData alerting",
        "Test error and no-data conditions",
        "Errors"
      ],
      "source": {
