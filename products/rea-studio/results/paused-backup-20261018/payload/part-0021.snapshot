base = {row['path']: row for row in audit['sourceInputs']}
for name in ('scripts/verify-records.mjs', 'scripts/editor-vault-proof-migration.mjs', 'scripts/verify-followup-records.mjs',
             'scripts/verify-cloud-publication.mjs', 'scripts/publication-integrity-controls.mjs'):
