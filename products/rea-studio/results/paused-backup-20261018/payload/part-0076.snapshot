    {
      "id": "grafana.candidate.ecb2cc2d48f9729cff2e",
      "syntaxRole": "table-row",
      "sourceText": "| `$__timeGroup(dateColumn,'5m')`           | Replaces the value with an expression suitable for use in a `GROUP BY` clause. Example: `floor(extract(epoch from dateColumn)/300)*300`. With TimescaleDB: `time_bucket('300s', dateColumn)`.                 |",
      "headingPath": [
        "PostgreSQL query editor",
        "Macros",
        "Time-series macros"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/query-editor/_index.md",
        "gitBlobSha": "da418c753c9813f78e1d4eed64e0946e46a50b3e",
        "sha256": "039487ccd5bee34210f2a93dfc270b66e758127ff361f491daa43c2203030f7f",
        "lineStart": 83,
        "lineEnd": 83,
