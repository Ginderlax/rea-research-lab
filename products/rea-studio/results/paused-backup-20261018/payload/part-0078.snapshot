    {
      "id": "grafana.candidate.1b19950773f95b118c7a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "is_nan takes a number or a series and returns `1` for `NaN` values and `0` for other values. For example `is_nan($A)`. This function exists because `NaN` is not equal to `NaN`.",
      "headingPath": [
        "Write expression queries",
        "About expressions",
        "Operations",
