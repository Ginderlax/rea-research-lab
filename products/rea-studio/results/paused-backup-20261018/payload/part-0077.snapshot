    {
      "id": "grafana.candidate.7257425e595e98f4c76e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This option sets the default UI language if a supported IETF language tag like `en-US` is available. If set to `detect`, the default UI language is determined by browser preference. The default is `en-US`.",
