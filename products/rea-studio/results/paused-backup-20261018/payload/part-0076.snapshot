    {
      "id": "grafana.candidate.aa4fafd0ac1085a53c95",
      "syntaxRole": "table-row",
      "sourceText": "| **Graphite backend type** | Select the Graphite backend type. Choosing `Metrictank` enables additional features like query processing metadata. (`Metrictank` is a multi-tenant time series engine compatible with Graphite.) Use `Default` for Grafana Cloud Graphite. |",
      "headingPath": [
        "Configure the Graphite data source",
        "Configuration options in the UI"
      ],
      "source": {
        "path": "docs/sources/datasources/graphite/configure/index.md",
        "gitBlobSha": "04a919dc05f03c2f2ea382b7f4ad2c434201bfec",
