// Test tooling only. Exact released AGPL-3.0-or-later slices execute with owned
// in-memory database/load/save adapters and a fixed clock, not the Joplin app.
import fs from 'node:fs/promises';
import vm from 'node:vm';
import {createHash} from 'node:crypto';
import {stripTypeScriptTypes} from 'node:module';
const root=new URL('../../../../',import.meta.url),hash=b=>createHash('sha256').update(b).digest('hex');
export async function originalTrash({folders,notes,time}){
 const manifests=await Promise.all(['prior-source-provenance.json','trash-source-provenance.json'].map(async p=>JSON.parse(await fs.readFile(new URL(p,root))))),sources=manifests.flatMap(m=>m.sources??m.records),bindings=[],calls=[];
 async function slice(path,start,end){const record=sources.find(r=>r.url.endsWith('/'+path));if(!record)throw new Error('Missing original '+path);const bytes=await fs.readFile(new URL(record.path,root));if(hash(bytes)!==record.sha256)throw new Error('Original changed: '+path);const text=bytes.toString(),a=text.indexOf(start),b=text.indexOf(end,a+start.length);if(a<0||b<0)throw new Error('Invalid slice boundaries');let source=text.slice(a,b).trimEnd();if(start.startsWith('public static'))source=source.slice(0,source.lastIndexOf('}')+1);bindings.push({path,originalPath:record.path,url:record.url,sourceSha256:record.sha256,startLine:text.slice(0,a).split('\n').length,endLine:text.slice(0,a+source.length).split('\n').length,sliceSha256:hash(source)});return source;}
 const folderPath='packages/lib/models/Folder.ts',notePath='packages/lib/models/Note.ts',folderMethods=[];
 for(const [name,next]of [['notes','noteIds'],['noteIds','subFolderIds'],['subFolderIds','noteCount'],['batchDelete','conflictFolderTitle'],['childrenIds','expandTree']])folderMethods.push(await slice(folderPath,'public static async '+name+'(',next==='conflictFolderTitle'?'public static '+next+'(':'public static async '+next+'('));
 const noteMethod=await slice(notePath,'public static async batchDelete(','public static async permanentlyDeleteMessage('),saveMethod=await slice('packages/lib/BaseModel.ts','public static saveQuery(','public static userSideValidation('),restoreSource=await slice('packages/lib/services/trash/restoreItems.ts','const restoreItems =','export default restoreItems;'),displaySource=await slice('packages/lib/services/trash/index.ts','export const getDisplayParentId =','export const getDisplayParentTitle =');
 const folderRows=new Map(folders.map(r=>[r.id,structuredClone(r)])),noteRows=new Map(notes.map(r=>[r.id,structuredClone(r)])),clone=r=>r&&structuredClone(r);
 const context=vm.createContext({time:{unixMs:()=>time},Date:class extends Date{static now(){return time;}},Database:{updateQuery:(table,values,where)=>({table,values,where})},getTrashFolderId:()=> 'de1e7ede1e7ede1e7ede1e7ede1e7ede',ActionLogger:{from:()=>({addDescription(){}})},ItemChange:{TYPE_UPDATE:2,TYPE_DELETE:3,add(){}},checkObjectHasProperties:(r,keys)=>{for(const key of keys)if(!(key in r))throw new Error('Missing '+key);},getRestoreFolder:()=>{throw new Error('Special restore folder outside compared subset');},ModelType:{Note:1,Folder:2}});
 const compile=text=>vm.runInContext(stripTypeScriptTypes(text),context);
 const BaseModel=compile('class BaseModel {\n'+saveMethod+'\n};BaseModel;');context.BaseModel=BaseModel;BaseModel.TYPE_NOTE=1;
 const Folder=compile('class Folder extends BaseModel {\n'+folderMethods.join('\n')+'\n};Folder;');context.Folder=Folder;
 const Note=compile('class Note extends BaseModel {\n'+noteMethod+'\n};Note;');context.Note=Note;
 for(const [model,rows,table]of [[Folder,folderRows,'folders'],[Note,noteRows,'notes']]){model.byIds=async ids=>ids.map(id=>clone(rows.get(id))).filter(Boolean);model.loadItemsByIds=model.byIds;model.load=async id=>clone(rows.get(id));model.preview=model.load;model.tableName=()=>table;model.fieldNames=()=>[...new Set([...rows.values()].flatMap(row=>Object.keys(row)))];model.hasField=key=>model.fieldNames().includes(key);model.dispatch=()=>{};model.save=async(value,options={})=>{const query=model.saveQuery(clone(value),{isNew:false,autoTimestamp:true,...options});calls.push({kind:'saveQuery',model:table,query:clone(query),options:clone(options)});const row={...rows.get(value.id),...clone(query.modObject)};rows.set(row.id,row);return row;};}
 const select=(sql,params)=>{const rows=sql.includes('FROM folders')?folderRows:sql.includes('FROM notes')?noteRows:null;if(!rows||!sql.includes('parent_id = ?')||params.length!==1)throw new Error('Unsupported original SQL: '+sql);return[...rows.values()].filter(r=>r.parent_id===params[0]&&(!sql.includes('deleted_time = 0')||!r.deleted_time)&&(!sql.includes('is_conflict = 0')||!r.is_conflict)).map(clone);};
 Folder.selectFields=()=>'*';Folder.modelSelectAll=async(sql,params)=>select(sql,params);Folder.db=()=>({selectAll:async(sql,params)=>select(sql,params)});
 Note.escapeIdsForSql=ids=>ids.map(id=>"'"+id+"'").join(',');Note.db=()=>({exec:async query=>{const ids=[...query.sql.matchAll(/'([a-f0-9]{32})'/g)].map(m=>m[1]);if(!query.sql.includes('UPDATE notes')||!query.sql.includes('deleted_time = ?')||!ids.length||![2,3].includes(query.params.length))throw new Error('Unsupported original update');calls.push({kind:'noteUpdateSql',ids,query:clone(query)});for(const id of ids){const row=noteRows.get(id);if(row)noteRows.set(id,{...row,deleted_time:query.params[0],updated_time:query.params[1],...(query.params.length===3?{parent_id:query.params[2]}:{})});}}});
 const restoreItems=compile(restoreSource+';restoreItems;'),getDisplayParentId=compile(displaySource.replace('export ','')+';getDisplayParentId;');
 return{Folder,Note,restoreItems,getDisplayParentId,folderRows,noteRows,calls,bindings,scope:'Exact released helper slices; owned in-memory SQL/load/save adapters and fixed clock. No released database, desktop, sync, shared authorization or application executable execution.'};
}
