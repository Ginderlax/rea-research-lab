    {
      "id": "grafana.candidate.4b8d0af40e8cf42a115a",
      "syntaxRole": "list-item",
      "sourceText": "- **Reusing queries to reduce costs:** Improve efficiency by reusing the same query across similar alert rules and dashboards.",
      "headingPath": [
