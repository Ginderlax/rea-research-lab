    {
      "id": "grafana.candidate.de933a23fab2b237b767",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "An LBAC rule is a `logql` query that filters logs or metrics based on labels. Each rule operates independently as its own filter, separate from other rules within a team.",
      "headingPath": [
        "Create LBAC for data source rule",
        "Before you begin",
        "LBAC rule"
      ],
      "source": {
        "path": "docs/sources/administration/data-source-management/teamlbac/create-teamlbac-rules/index.md",
