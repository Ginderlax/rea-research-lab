    },
    {
      "id": "grafana.candidate.843d1cfd682f8a26f0c6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you have thousands (or millions) of Prometheus metrics, it can be hard to find the exact one you're looking for. Enable feature toggle `prometheusMetricEncyclopedia` to replace the basic metric select dropdown in the Prometheus query builder with a paginated and searchable metric _encyclopedia_.",
      "headingPath": [
        "What's new in Grafana v9.5",
        "Prometheus performance and usability improvements",
        "Prometheus metric encyclopedia"
      ],
      "source": {
