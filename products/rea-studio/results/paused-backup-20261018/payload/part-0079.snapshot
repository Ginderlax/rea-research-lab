    },
    {
      "id": "grafana.candidate.96b66813609cc0927f11",
      "syntaxRole": "table-row",
      "sourceText": "| Value display | Choose a value display mode:<ul><li>**Value color** - Value color is determined by value.</li><li>**Text color** - Value color is default text color.</li><li>**Hidden** - Values are hidden.</li></ul> |",
      "headingPath": [
        "Bar gauge",
        "Configuration options",
        "Bar gauge options"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/bar-gauge/index.md",
