    {
      "id": "grafana.candidate.1edac12ff4d73a55a333",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The **Base** value represents minus infinity. By default, it's set to the color green, which is generally the “good” color.",
      "headingPath": [
        "Configure thresholds",
        "Thresholds options",
        "Threshold value"
