const cases=[],n=25000;
cases.push(['organ-pipe',Array.from({length:n},(_,i)=>i<n/2?i+0.125:n-i+0.125)]);
cases.push(['alternating-ends',Array.from({length:n},(_,i)=>i%2? n-Math.floor(i/2):Math.floor(i/2))]);
