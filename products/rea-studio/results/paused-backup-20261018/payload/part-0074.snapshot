    {
      "id": "grafana.candidate.55c826b149a536efa3cc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Clicking **Unsilence** ends the silence immediately, which is the only way to end a silence before its configured end time. Silences cannot be permanently deleted manually.",
      "headingPath": [
        "Configure silences",
        "Remove silences"
      ],
