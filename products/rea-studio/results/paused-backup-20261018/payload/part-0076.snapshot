    {
      "id": "grafana.candidate.9ef0974ca1c257e390c7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When **Manage alerts via Alerting UI** is enabled in the Prometheus data source configuration, Grafana fetches and displays alerting rules defined in Prometheus. These appear in the Alerting UI alongside Grafana-managed rules but are marked as data source-managed.",
      "headingPath": [
        "Prometheus alerting",
        "View data source-managed rules"
      ],
      "source": {
        "path": "docs/sources/datasources/prometheus/alerting/index.md",
        "gitBlobSha": "e69dbca4761d655d38dedb0f31723b55544cc771",
        "sha256": "9fbd02d532e4f3f69b6a33cf37499ff66969256513cda97768e0be208e052bad",
        "lineStart": 61,
        "lineEnd": 61,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/prometheus/alerting/index.md#L61-L61"
      },
      "applicability": {
