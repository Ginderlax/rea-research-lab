    },
    {
      "id": "grafana.candidate.28c1b18b018776141a97",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Dashboards, when accessed by users with the Viewer role, are now using the Scenes library. Those users shouldn't see any difference in the dashboards apart from two small changes to the user interface (UI): the variables UI has slightly changed and the time picker is now part of the dashboard container.",
      "headingPath": [
        "What’s new in Grafana v11.0",
        "Dashboards and visualizations",
        "Scenes for viewers"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-0.md",
        "gitBlobSha": "718032fb1fcee4d964da6aa4e9da332a64bf509a",
        "sha256": "4ac4a4d84503349934037643cc351a7722532a4c4189aab283838810ba2f6731",
        "lineStart": 124,
        "lineEnd": 124,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-0.md#L124-L124"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c01be82e49aa8464f99e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Others of you want subfolders in order to create nested layers of permissions, where teams have access at different levels that reflect their organization’s hierarchy.",
      "headingPath": [
        "What’s new in Grafana v11.0",
        "Dashboards and visualizations",
        "Subfolders"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-0.md",
