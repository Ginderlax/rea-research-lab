    assert steps['all-other-owned-requests-and-attachment-response-drained']<=steps['fault-ownership-entered']<=steps['unchanged-host-returned-real-filesystem400']<=steps['restored-exact-original-bytes-verified']<=steps['unchanged-actual400-delivered-after-restoration']
canon=bykind['new-task-unsaved-validation-and-explicit-retry'];assert canon['ordinaryDraftMutationRequests']==0 and canon['actualEmptyTitleStatus']==400 and canon['firstRevision']==1 and canon['initialHistoryLength']==0 and canon['canonicalBaselineRevision']==2 and canon['canonicalBaselineMetadataEdited']
assert canon['unrelatedRawNoteBefore']==canon['unrelatedRawNoteAfter']
