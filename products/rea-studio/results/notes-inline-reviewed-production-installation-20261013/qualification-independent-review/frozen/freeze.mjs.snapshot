import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const root=import.meta.dirname,workspace=path.resolve(root,'../..'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});
const old=[];for(const [dir,name,digest]of [['notes-inline-publication-plan-independent-review','review-manifest.json','e1fd6f5b68e91a18bab40c018379e2603270bb8837e733fb2fb40b76dc2c9b44'],['notes-inline-publication-plan-next','freeze-manifest.json','ab0bccd1aaf43da7b932193a0991531659b2e5017b72c28933b37bcc7ddcf3ae'],['notes-inline-publication-plan-browser-next','freeze-manifest.json','697af388815ed18acacdfebf69dd58eb6ddb601c84722e0ba2185401afaa9aff']]){const base=path.join(workspace,'work',dir),b=await fs.readFile(path.join(base,name));assert.equal(id(b).sha256,digest);const j=JSON.parse(b);for(const [p,r]of Object.entries(j.inventory)){assert.deepEqual(id(await fs.readFile(path.join(base,p))),{bytes:r.bytes,sha256:r.sha256});}old.push({directory:dir,manifest:name,...id(b),strictPayloads:Object.keys(j.inventory).length,allPayloadBytesExact:true});}await fs.writeFile(path.join(root,'prior-frozen-authentication.json'),JSON.stringify(old,null,2)+'\n',{flag:'wx'});
async function walk(p=''){const rows=[];for(const e of(await fs.readdir(path.join(root,p),{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const n=p+e.name;if(n==='review-manifest.json')continue;assert.equal(e.isSymbolicLink(),false);if(e.isDirectory())rows.push(...await walk(n+'/'));else {assert.ok(e.isFile());rows.push({path:n,...id(await fs.readFile(path.join(root,n)))});}}return rows;}const rows=await walk(),receipt=id(await fs.readFile(path.join(root,'review-validation.json')));await fs.writeFile(path.join(root,'review-manifest.json'),JSON.stringify({schema:'rea-notes-browser-qualification-independent-strict-freeze/v1',strict:true,selfExcluded:true,at:new Date().toISOString(),files:rows.length,totalBytes:rows.reduce((n,r)=>n+r.bytes,0),receiptSHA256:receipt.sha256,inventory:Object.fromEntries(rows.map(r=>[r.path,{bytes:r.bytes,sha256:r.sha256}]))},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({files:rows.length,receipt,manifest:id(await fs.readFile(path.join(root,'review-manifest.json')))}));
