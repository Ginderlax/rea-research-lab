    },
    {
      "id": "grafana.candidate.c2ca96304a9e8d21f73e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana server CLI allows you to temporarily override certain Grafana default settings. Except for `--help` and `--version`, most global options are only used by developers.",
      "headingPath": [
        "Administer Grafana with the Grafana server CLI",
        "Global options"
      ],
      "source": {
        "path": "docs/sources/administration/cli.md",
        "gitBlobSha": "416b1c243352c61d2447711805b69c7a80874917",
