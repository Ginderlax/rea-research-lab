const manifestRaw=Buffer.from(JSON.stringify(manifest,null,2)+'\n');write(prefix+'/preservation-manifest.json',manifestRaw);
const prose=`# Source-bound native metadata diagnostic\n\n[Hosted run ${RUN}](${run.html_url}) on committed source ${HEAD} passes the five unchanged checks in two original Archive files. All78 uploaded members, including70 source snapshots and two raw worker traces, remain recoverable from exact public outer and inner ZIPs. All70 sources match actual Git before and after execution; raw APIs/logs, the complete Git tree/commit, approved backup templates and exact run-binding lineage remain retained.\n\nSix observed native callbacks succeed with no native errors: the integration worker records4419.2207ms and five app-worker calls record346.3084–374.8336ms. The original15000ms native deadline,64MiB buffer and every test assertion remain unchanged. The dependency is instrumented, so these observations are not an uninstrumented performance comparison, a reliability fix or a full-suite rerun.\n\nThe [earlier D24 full-suite failure](../cloud-full1100-native-metadata-failure-20261016/preservation-manifest.json) remains confirmed1098/1100 with two native-metadata refusals. This diagnostic did not reproduce them. Their original child error was redacted; the historical cause remains unobserved. Neither this five-check pass nor another full-suite pass retroactively resolves that uncertainty.\n\nThe manifest separates byte retention, source authentication, native observations and five-check acceptance. Original worker elapsed values and outer command UTC clocks are preserved with their actual attribution. No runtime correction, deadline extension, retry, historical receipt rebinding, product parity or superiority is claimed. Local product/test/build/syntax executions are zero.\n`;
write(prefix+'/README.md',Buffer.from(prose));
const rows=[...objects].map(([file,value])=>({path:file,...value})).concat([{path:prefix+'/preservation-manifest.json',...identity(manifestRaw)},{path:prefix+'/README.md',...identity(Buffer.from(prose))}]).sort((a,b)=>a.path.localeCompare(b.path));const total=rows.reduce((sum,row)=>sum+row.bytes,0);assert(rows.length<=100&&total<=8*1024*1024);for(const row of rows)same(fs.readFileSync(path.join(candidate,row.path)),row);
