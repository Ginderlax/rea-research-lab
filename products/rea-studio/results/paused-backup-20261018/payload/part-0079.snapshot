    {
      "id": "grafana.candidate.8c779221d68b2c94815b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The candlestick visualization is based on the time series visualization, and it can visualize additional data dimensions beyond open, high, low, close, and volume. The **Include** and **Ignore** options allow it to visualize other included data such as simple moving averages, Bollinger bands and more, using the same styles and configurations available in the [time series](ref:time-series-visualization) visualization.",
      "headingPath": [
        "Candlestick",
        "Configuration options",
        "Candlestick options",
        "Additional fields"
      ],
