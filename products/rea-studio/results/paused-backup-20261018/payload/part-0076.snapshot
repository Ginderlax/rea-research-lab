    {
      "id": "grafana.candidate.cfe872b994b8cbc2c244",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This method of authentication doesn't inherently support all backend functionality as a user's credentials won't be in scope. Affected functionality includes alerting, reporting, and recorded queries. Also, note that query and resource caching is disabled by default for data sources using current user authentication.",
      "headingPath": [
        "Configure the Microsoft SQL Server data source",
        "Configure the data source in the UI",
        "Azure Entra ID (formerly Azure AD) Authentication",
        "Current User authentication"
      ],
