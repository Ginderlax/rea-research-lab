function png(bytes){assert.equal(bytes.subarray(0,8).toString('hex'),'89504e470d0a1a0a');let at=8,count=0,end=false;const crc=data=>{let value=0xffffffff;for(const byte of data){value^=byte;for(let bit=0;bit<8;bit++)value=(value>>>1)^((value&1)?0xedb88320:0);}return(value^0xffffffff)>>>0;};while(at<bytes.length){assert(at+12<=bytes.length);const size=bytes.readUInt32BE(at);assert(size<=2*1024*1024&&at+12+size<=bytes.length);const type=bytes.subarray(at+4,at+8).toString('ascii');assert.equal(bytes.readUInt32BE(at+8+size),crc(bytes.subarray(at+4,at+8+size)));if(count++===0){assert.equal(type,'IHDR');assert.equal(size,13);assert.equal(bytes.readUInt32BE(at+8),1440);assert.equal(bytes.readUInt32BE(at+12),1100);}at+=12+size;if(type==='IEND'){assert.equal(size,0);end=true;break;}}assert(end&&at===bytes.length);return{width:1440,height:1100,CRCVerified:true,...identity(bytes)};}
function tar(bytes){assert(bytes.length>=1024&&bytes.length%512===0);const rows=new Map();let at=0;while(at+512<=bytes.length){const h=bytes.subarray(at,at+512);if(h.every(byte=>byte===0)){assert(at+1024<=bytes.length&&bytes.subarray(at).every(byte=>byte===0));return rows;}let sum=0;for(let i=0;i<512;i++)sum+=i>=148&&i<156?32:h[i];assert.equal(sum,parseInt(h.subarray(148,156).toString('ascii').replace(/\0.*$/,'' ).trim(),8));const name=h.subarray(0,100).toString('utf8').replace(/\0.*$/,'');helper.safe(name);assert([0,48].includes(h[156]));assert(!rows.has(name));const size=parseInt(h.subarray(124,136).toString('ascii').replace(/\0.*$/,'').trim()||'0',8);assert(Number.isSafeInteger(size)&&size>=0&&size<=8*1024*1024&&at+512+size<=bytes.length);rows.set(name,bytes.subarray(at+512,at+512+size));assert(rows.size<=2000);at+=512+Math.ceil(size/512)*512;}throw new Error('Missing TAR terminator');}
function browserResults(){
 const report=json('playwright-results.json'),specs=[],visit=suite=>{specs.push(...(suite.specs??[]));for(const nested of suite.suites??[])visit(nested);};for(const suite of report.suites)visit(suite);assert.deepEqual(report.errors,[]);assert.equal(specs.length,8);const roster=JSON.parse(committed('products/rea-studio/browser-tests/notes-new-todo-roster.json',tooling[5]));assert.deepEqual(specs.map(row=>row.title).sort(),[...roster].sort());for(const spec of specs){assert.equal(spec.ok,true);assert.equal(spec.tests.length,1);const item=spec.tests[0];assert.equal(item.status,'expected');assert.equal(item.results.length,1);assert.equal(item.results[0].status,'passed');assert.equal(item.results[0].retry,0);}assert.deepEqual([report.stats.expected,report.stats.unexpected,report.stats.skipped,report.stats.flaky],[8,0,0,0]);
 const observation=json('browser-observation.json');assert.deepEqual(observation,{schema:'rea-cloud-real-browser-observation/v1',browser:'chromium',channel:'chromium',version:'156.0.8078.4',realBrowserFixtureCreated:true,retries:0});const workers=fs.readdirSync(evidence).filter(name=>/^browser-observation-process-[0-9]+\.json$/.test(name));assert.equal(workers.length,1);const worker=json(workers[0]);assert.equal(worker.schema,'rea-cloud-notes-new-todo-browser-worker-observation/v1');assert.deepEqual(worker.execution,helper.execution());assert.equal(workers[0],'browser-observation-process-'+worker.pid+'.json');assert(Number.isSafeInteger(worker.pid)&&worker.pid>0);assert.deepEqual(worker.observation,observation);assert.deepEqual(worker.sourcePins,installation.declaration.currentNotesSources.map(row=>({path:row.path.slice('products/rea-studio/'.length),...pin(row)})));
 const names=fs.readdirSync(evidence).filter(name=>/^case-.*\.json$/.test(name));assert.equal(names.length,8);const cases=names.map(name=>({name,value:json(name)}));assert.deepEqual(cases.map(row=>row.value.title).sort(),[...roster].sort());const screenshots=[],downloads=[],records=[],holds=[],faults=[],accepted=[];
 const kinds=['new-task-unsaved-validation-and-explicit-retry','native-discard-cancel-and-new-note-kind-reset','new-task-commit-held-native-duplicate-and-newer-draft','new-task-editor-ownership-after-actual-commit','new-task-disposal-after-actual-first-commit','new-task-postcommit-genuine-list400-newer-draft','new-task-committed-save-refresh-failure-explicit-recovery','new-task-actual-jex-native-tar-and-resource-download'];
