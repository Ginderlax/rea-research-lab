    {
      "id": "grafana.candidate.9cd9582ae94764cf7e82",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Each data source's **query editor** provides a customized user interface that helps you write queries that take advantage of its unique capabilities. You use a data source's query editor when you create queries in [dashboard panels](ref:query-transform-data) or [Explore](ref:explore).",
      "headingPath": [
        "Data sources",
        "Query editors"
      ],
      "source": {
