    },
    {
      "id": "grafana.candidate.7ceec00411032ac4c106",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Our email sharing feature allows you to easily share your public dashboards and make them visible only with specific individuals. When you add their email addresses, they receive a one-time link to access the dashboard. This provides you with greater control over who can view your public dashboards.",
      "headingPath": [
        "What’s new in Grafana v10.0",
        "Public dashboards",
        "Email sharing for public dashboards"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-0.md",
        "gitBlobSha": "744b2d1230211f70aa6158231d9505e732ac0315",
        "sha256": "dd311853975cca7ef6ad474588f832614dd9c445856343920d238a1ddf183739",
        "lineStart": 243,
        "lineEnd": 243,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-0.md#L243-L243"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.cd203fd967c2cd499306",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We've also added a **Public dashboard users** tab in **Administration > Users** where you can view a list of users who have accessed your public dashboards by way of email sharing.",
      "headingPath": [
        "What’s new in Grafana v10.0",
        "Public dashboards",
        "Email sharing for public dashboards"
      ],
      "source": {
