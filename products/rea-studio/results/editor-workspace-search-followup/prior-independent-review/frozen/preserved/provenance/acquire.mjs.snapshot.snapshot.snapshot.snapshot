import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import {createHash} from 'node:crypto';
import {Readable,Transform} from 'node:stream';
import {pipeline} from 'node:stream/promises';
import {createWriteStream} from 'node:fs';
const root=path.join(import.meta.dirname,'original-products/vscode/1.140.0'),url='https://update.code.visualstudio.com/api/versions/1.140.0/win32-x64-archive/stable',sha=b=>createHash('sha256').update(b).digest('hex');await fs.mkdir(root,{recursive:true});const response=await fetch(url,{signal:AbortSignal.timeout(30000)});assert.equal(response.status,200);const metadataBytes=Buffer.from(await response.text()),metadata=JSON.parse(metadataBytes);assert.equal(metadata.productVersion,'1.140.0');assert.equal(metadata.version,'07f806f999227108933c2e30515b26eecc1fda74');assert.equal(metadata.sha256hash,'52f47072473375767d63ea5be9ffb96a3092124223fe5ce036834a299715014e');assert.equal(new URL(metadata.url).hostname,'vscode.download.prss.microsoft.com');await fs.writeFile(path.join(root,'microsoft-update-metadata.json'),metadataBytes,{flag:'wx'});await fs.writeFile(path.join(root,'acquire.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});
const startedAtUtc=new Date().toISOString(),download=await fetch(metadata.url,{signal:AbortSignal.timeout(600000)});assert.equal(download.status,200);assert.ok(download.body);const digest=createHash('sha256'),sha1=createHash('sha1');let bytes=0,lastProgress=0;const count=new Transform({transform(chunk,encoding,callback){bytes+=chunk.length;if(bytes>512*1024*1024)return callback(new Error('Original archive exceeds512MiB download bound.'));digest.update(chunk);sha1.update(chunk);if(bytes-lastProgress>=32*1024*1024){lastProgress=bytes;console.log(JSON.stringify({downloadedMiB:Math.floor(bytes/1024/1024)}));}callback(null,chunk);}}),temporary=path.join(root,'VSCode-win32-x64-1.140.0.zip.partial');
await pipeline(Readable.fromWeb(download.body),count,createWriteStream(temporary,{flags:'wx'}),{signal:AbortSignal.timeout(600000)});const actualSHA256=digest.digest('hex'),actualSHA1=sha1.digest('hex');assert.equal(actualSHA256,metadata.sha256hash);assert.equal(actualSHA1,metadata.hash);const archive=path.join(root,'VSCode-win32-x64-1.140.0.zip');await fs.rename(temporary,archive);const receipt={schema:'rea-complete-vscode-original-acquisition/v1',startedAtUtc,completedAtUtc:new Date().toISOString(),productVersion:metadata.productVersion,productCommit:metadata.version,publisherMetadataURL:url,publisherMetadataSHA256:sha(metadataBytes),archiveURL:metadata.url,archive:archive,bytes,sha256:actualSHA256,sha1:actualSHA1,publisherDigestsMatched:true,archiveRemainsLocal:true,installedIntoUserEditor:false,originalBehaviorExecutions:0,fullOriginalDocumentationBinding:false,monacoStudyRebound:false,fullReplacementParity:false,universalSuperiority:false};await fs.writeFile(path.join(root,'acquisition.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(receipt));
