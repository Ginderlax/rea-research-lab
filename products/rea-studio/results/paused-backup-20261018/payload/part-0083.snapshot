priorities=[
 {'rank':1,'gap':'ZSTD standalone and ZIP method 93 decoding; TAR.ZST dispatch',
  'why':'The manual and both complete/Extra registries advertise ZSTD decoding. The current Node 24.16.0 runtime exposes ZSTD decompression APIs. This makes ZSTD a promising small next codec integration; bounds and frame handling still need implementation.',
  'candidate':'not implemented',
  'acceptance':['Generate a deterministic ZSTD fixture with an independent encoder; run the pinned complete 7z.exe t/x and compare extracted SHA-256.','Exercise ordinary, checksummed, concatenated and skippable frames, truncation and output limits; add ZIP method 93 and TAR.ZST routing fixtures.'],
  'qualification':'Runtime API presence is feasibility evidence. The documented original ZSTD contract is decompression only.'},
 {'rank':2,'gap':'Streaming and worker isolation with cancellation and progress',
  'why':'The current modules use synchronous codecs and buffer whole containers. The app has 16 MiB per-file and 64 MiB archive output bounds. Original console contracts include stdin/stdout, threads, progress and CPU/memory controls.',
  'candidate':'missing beyond bounded in-memory operations',
  'acceptance':['While compressing a large synthetic fixture, issue a small independent list/health request; measure response latency and cancellation completion.','Measure peak RSS and elapsed time across increasing sizes, entry counts and concurrent workspaces; verify bytes and destination state after cancellation.']},
 {'rank':3,'gap':'BZIP2 and TAR.BZ2 creation and extraction',
  'why':'BZIP2 is in the complete and Extra creation sets. It requires a bounded codec implementation beyond the current Node zlib APIs.',
  'candidate':'not implemented',
  'acceptance':['Cross-generate BZIP2 and TAR.BZ2 using the pinned complete 7z.exe and a second implementation; compare restored SHA-256.','Exercise multiblock and concatenated streams, CRC failures, empty input, truncated blocks and memory limits.']},
 {'rank':4,'gap':'XZ/LZMA2 and raw LZMA decoding',
  'why':'These formats have complete/Extra documentation and SDK APIs. Establishing these codecs also enables a later 7z implementation.',
  'candidate':'not implemented',
  'acceptance':['Compare streams from the pinned complete product and SDK with CRC32, CRC64 and SHA-256 checks and documented filters.','Exercise concatenated XZ streams, corrupt blocks/indexes/footers, dictionary sizes, end markers and allocator limits.']},
 {'rank':5,'gap':'7z container, LZMA/LZMA2, solid blocks and compressed headers',
  'why':'The core product format remains absent. A reduced SDK decoder is a starting reference; it does not establish complete-product support.',
  'candidate':'not implemented',
  'acceptance':['Build a matrix of solid/nonsolid archives, compressed headers, empty files, UTF-16 names and multiple folders/codecs; compare original list/t/x results.','Verify header/data CRCs, selective extraction, solid-block caching and memory limits. Test encryption as a separate capability.']},
 {'rank':6,'gap':'Archive update, delete and rename; conflict decisions',
  'why':'The original a/u/d/rn commands and GUI update modes have per-file timestamp/content states and overwrite choices. The app currently creates archives and extracts to new folders.',
  'candidate':'missing',
  'acceptance':['Execute update states p/q/r/x/y/z/w with actions 0/1/2/3 on disposable archives; compare members, bytes and dates.','Interrupt staged updates and final commits; prove the original archive survives and partial new output is identifiable after restart.']},
 {'rank':7,'gap':'Selective extraction, filename encodings and metadata',
  'why':'Include/exclude rules, recursion, case modes, code pages, timestamp precision and filesystem metadata have separate original contracts. The app has partial names/timestamps and strict Windows path validation.',
  'candidate':'partial names/timestamps; selection and most metadata absent',
  'acceptance':['Build wildcard, list-file, recursion, case and code-page matrices against the original; compare exact selected member names.','Test DOS local time, Unix and NTFS precisions, creation time and permissions separately. Links, NTFS streams and ACLs need an explicit supported-platform policy.']},
 {'rank':8,'gap':'Measured performance and failure recovery',
  'why':'Current small round trips do not establish speed, compression ratio or scale. The manual performance table compares 7-Zip 9.35 and cannot be used as a 26.04 threshold.',
  'candidate':'unmeasured',
  'acceptance':['Freeze a synthetic corpus containing redundant text, incompressible binary, executable-like data, many tiny files and Unicode metadata; record hashes.','Run paired warm/cold create/extract/list/test trials with exact versions/options, compression ratio, elapsed time, CPU, peak RSS and progress latency. Inject disk-full, read failures and interruption; report each format separately.']},
 {'rank':9,'gap':'Passwords, encryption, SFX, volumes and remaining handlers',
  'why':'The original documents 7z/ZIP encryption, passwords, self-extracting archives and volumes. The complete product also has many image, filesystem, installer and RAR readers.',
  'candidate':'missing',
  'acceptance':['Test correct/wrong/missing passwords, encrypted headers and corruption using independent fixtures.','Exercise volume boundaries and missing segments; test SFX packaging in disposable folders. Bind each remaining format to its actual edition and decoding methods.']},
 {'rank':10,'gap':'Windows File Manager, GUI dialogs, shell integration and localization',
  'why':'The complete installer and GUI source/manual are now preserved. Original GUI and shell behavior have not been exercised. The app uses a different web interface.',
  'candidate':'native GUI/shell compatibility absent; some app workflows overlap',
  'acceptance':['Use an isolated Windows profile to verify each documented menu, shortcut, dialog, setting and persistence result. Do not register shell extensions in the user profile.','Compare the documented language scope with the exact shipped language files and exercise fallback. Source/manual binding alone cannot pass GUI behavior.']}
]
manual_pages=sum(1 for p in (BASE/'manual').rglob('*.htm'))
receipt={
 'schema_version':1,
 'created_at_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),
 'purpose':'Documented 7-Zip 26.04 feature inventory for the complete Windows product, Extra console/DLL editions and LZMA SDK. The frozen app and shared requirements were not edited.',
 'scope_and_completeness':{
  'html_manual_pages':manual_pages,'manual_coverage':page_coverage,
  'technical_sdk_documents':technical_docs,
  'selected_current_sdk_headers':['7z.h','7zTypes.h','LzmaDec.h','LzmaEnc.h','Lzma2Dec.h','Lzma2Enc.h','Xz.h','XzEnc.h'],
  'atomic_contract_count':len(contracts),'categories':dict(counts),
  'rule':'One atom per functional table row, expanded format direction or keyboard modifier, option declaration, list statement, paragraph sentence, syntax block, SDK technical/API statement, selected current SDK declaration or executed registry row. Repeated appearances are retained. Raw examples are indexed separately.',
  'limits':[
   'Every extracted English manual page and the seven SDK technical documents is indexed under the stated atomization rule. This is a documented-corpus inventory, not an enumeration of every source-code path, exported ABI, configuration combination or input.',
   'A table row or dependent clause may still contain more than one test condition. Its exact source text and line range remain available for further semantic splitting.',
   'Selected current SDK headers and complete-product entry points corroborate interface bindings. Other source files are backed up but have not been individually converted to contracts.',
   'Legacy document versions are explicit. Package version 26.04 alone does not settle conflicts between an older statement and current source.',
   'Acceptance ideas remain pending unless listed in executed_checks. GUI, shell integration, per-feature performance and broad format conformance remain unexercised.']},
 'release_binding':{
  'release':'26.04','release_date':'2026-10-05','release_url':release['html_url'],
  'release_metadata':fp(BASE/'release-26.04.json'),'acquired_assets':acquired,
  'new_complete_product_binding':'The official Windows x64 installer and complete source package are preserved and match publisher SHA-256 digests. The installer was extracted; it was not installed.',
  'complete_binaries':binding_binaries,
  'manual_identical_to_extra':{'sha256':'162e92f24258f36c24c1907505e7cf8a1f981684d180c9e8d1e35a7bb3c1eb6f','finding':'The same compiled manual ships in the complete installer and Extra package. This does not expand the Extra runtime format set.'},
  'existing_study_scope':'projects/08-7zip studies property exports from Extra 26.04 x64 7za.dll. It does not reconstruct compression/decompression or the complete GUI product.',
  'edition_rules':[
   'The complete Windows 7z.exe + 7z.dll supplies the complete registered format set. File Manager 7zFM.exe, GUI command program 7zG.exe and shell DLLs have separate interfaces.',
   'Extra 7za.exe is a standalone console with a reduced format set and the shared command syntax. Extra 7za.dll/7zxa.dll support the 7z format only.',
   'SDK 7zr is further reduced. The C 7z decoder, C APIs, SFX samples and source codecs have separate contracts from the complete GUI product.',
   'The complete Windows x64, Extra x64 and SDK x64 i commands were executed. Other Extra/SDK architecture files are preserved without execution.',
   'Linux/macOS source portability is documented. Their 26.04 binary packages were not acquired or exercised here; release metadata lists those and the other complete Windows architecture assets.']},
 'current_candidate':{
  'snapshot_files':candidate_sources,
  'observed_scope':'Bounded ZIP/ZIP64 store + DEFLATE, TAR/PAX/GNU long names, TAR.GZ and GZIP; UTF-8/CP437/Unicode Path ZIP names; selected timestamps; create/list/test/extract in the local web workspace.',
  'status_rule':'Partial app workflow overlap does not mark an original CLI/GUI/SDK contract passing. Supported formats remain bounded partial support.',
  'frozen_app_mutated':False,'shared_requirements_mutated':False},
 'prioritized_next_work':priorities,'sources':sources,'source_examples':examples,'contracts':contracts,
 'executed_checks':[
  {'check':'SHA-256 against release publisher digests','result':'All five preserved top-level assets match: three newly downloaded packages and two copied existing official assets.','inputs':[a['name'] for a in acquired]},
  {'check':'Original extraction','result':'Complete source, SDK source, complete installer and CHM extracted successfully; no product installation.','logs':['extract-full-source-retry.txt','extract-sdk-source-retry.txt','extract-full-product-x64-retry.txt','extract-manual.txt']},
  {'check':'Original i command','result':'Complete x64, Extra x64 and SDK x64 returned exit 0. Registry outputs are preserved; registry presence does not prove decoding correctness.','outputs':['original-full-x64-info.txt','original-extra-x64-info.txt','original-sdk-x64-info.txt']},
  {'check':'Runtime feasibility','result':'Node 24.16.0 exposes zstdDecompressSync and streaming ZSTD APIs. No ZSTD app feature was implemented.'}],
 'failed_attempts':[
  {'action':'Initial source/SDK/installer extraction','result':'Exit 7 because PowerShell split -o from its path. Parenthesizing the concatenated argument fixed the retry. Both initial and successful logs are preserved.'},
  {'action':'First inventory generation','result':'UTF-8 decoding failed for a legacy SDK document. The generator now falls back to Windows-1252 without changing original bytes.'}],
 'offline_backup':{
  'directory':str(BASE),'guide':str(BASE/'OFFLINE-BACKUP.md'),
  'manifest':str(BASE/'backup-manifest.json'),'verifier':str(BASE/'verify-backup.py'),
  'coverage':'Original release packages, complete/Extra/SDK binaries, complete and SDK sources, compiled and extracted English manual, licenses, official download/SDK pages, release metadata, acquisition records and original registry outputs.',
  'limitations':'This is a local directory outside the tracked repository. No independent cloud copy, installation replay or complete GUI conformance is claimed.'}
}
(WORK/'full-archive-feature-inventory.json').write_text(json.dumps(receipt,ensure_ascii=False,indent=2)+'\n',encoding='utf-8')

def esc(text):return text.replace('|','\\|').replace('\n',' ')
tick=chr(96)
md=[
 '# Full archive feature inventory â€” original 7-Zip 26.04','',
 f'Generated {receipt["created_at_utc"]}. This inventory contains {len(contracts):,} source-backed atoms from {manual_pages} English manual pages, seven SDK technical documents, package readmes, selected current source declarations and the executed complete/Extra/SDK registries. The JSON preserves release, edition, platform, hashes, line ranges, candidate status and executable acceptance ideas.','',
 'The official complete Windows x64 installer, complete sources and LZMA SDK were downloaded and matched publisher SHA-256 values. Existing official Extra and 7zr assets were copied into this independent baseline and matched the same release metadata. The installer was extracted without installation. Project 08 previously studied only a reduced Extra DLL property export.','',
 'The complete installer and Extra package contain identical 7-zip.chm bytes. Their shared manual is broader than the Extra engine. Complete 7z.exe + 7z.dll, Extra 7za.exe, Extra 7za.dll/7zxa.dll, SDK 7zr and the SDK C decoder are distinct bindings. Original GUI and shell behavior remain unexercised.','',
 '## Provenance and offline backup','',
 '| Original asset | SHA-256 |','| --- | --- |']
for a in acquired:md.append(f'| {a["name"]} | {tick}{a["sha256"]}{tick} |')
md += [
 '',f'Backup instructions: [OFFLINE-BACKUP.md]({(BASE/"OFFLINE-BACKUP.md").as_posix()}). The manifest fingerprints all preserved files; its verifier works offline. The baseline is outside the tracked repository. No cloud copy is claimed.','',
 '## Coverage and qualifications','',
 receipt['scope_and_completeness']['rule'],'',
 'This covers the documented corpus under that rule. It does not claim all undocumented code paths, ABI declarations or option combinations have been enumerated. Some rows and dependent clauses require finer test-case splitting. Licensing, acknowledgements and history files are preserved; they do not add functional acceptance atoms.','',
 'Older embedded documents need adjudication against current source: 7zC identifies 9.35, lzma identifies 24.07 and 7zFormat identifies 18.06. The manual performance table compares 7-Zip 9.35 and WinRAR 5.20. It does not establish 26.04 performance.','',
 '| Category | Atoms |','| --- | --- |']
for category,count in sorted(counts.items()):md.append(f'| {category} | {count} |')
md += ['','## Prioritized next work','']
for item in priorities:
    md += [f'{item["rank"]}. **{item["gap"]}.** {item["why"]}',f'   Acceptance: {" ".join(item["acceptance"])}','']
md += [
 '## Recorded checks','',
 'Five original asset hashes match publisher digests. Original extraction succeeded. The complete x64, Extra x64 and SDK x64 registry commands returned exit 0. The current Node runtime exposes ZSTD APIs. These are acquisition, binding and feasibility checks; no GUI conformance run or performance comparison was performed.','',
 '## Atomic documented inventory','',
 'Each row links to the exact preserved source and starting line. Ending lines, SHA-256, edition/platform binding, candidate status and acceptance ideas are in the JSON. An atom is a documented statement, source declaration or advertised registry entry; its presence is not a recorded passing test.','']
grouped=collections.defaultdict(list)
for c in contracts:grouped[c['source']['id']].append(c)
for s in sources:
    if not grouped[s['id']]:continue
    label=Path(s['path']).relative_to(BASE).as_posix() if Path(s['path']).is_relative_to(BASE) else s['path']
    md += [f'### {label}','',f'SHA-256 {tick}{s["sha256"]}{tick}. Edition: {s["edition"]}.','',
           '| ID | Context | Documented statement | Candidate status | Source line |',
           '| --- | --- | --- | --- | --- |']
    for c in grouped[s['id']]:
        src=c['source']
        md.append(f'| {c["id"]} | {esc(c["section"])} | {esc(c["contract"])} | {esc(c["candidate_status"])} | [L{src["line_start"]}]({Path(src["path"]).as_posix()}:{src["line_start"]}) |')
    md.append('')
(WORK/'full-archive-feature-inventory.md').write_text('\n'.join(md)+'\n',encoding='utf-8')
print(json.dumps({'contracts':len(contracts),'sources':len(sources),'categories':dict(counts),'inventory_json':fp(WORK/'full-archive-feature-inventory.json'),'inventory_md':fp(WORK/'full-archive-feature-inventory.md')}))
