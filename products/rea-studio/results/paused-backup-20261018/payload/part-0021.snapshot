put(prefix+'verifier-before/verify-cloud-browser.mjs.snapshot',raw(browser_path))
put(prefix+'phase12-authority.json.snapshot',phase12_bytes)
for name in ('verify-cloud-publication.mjs','publication-integrity-controls.mjs'):
    put(prefix+'verifier-before/phase12-'+name+'.snapshot',(previous/'candidate/scripts'/name).read_bytes())

# Extend the existing single envelope. The Notes proof keeps its own52 paths;
# these four exact tooling pins form a separately named4-source capture group.
producer_path='scripts/verify-cloud-publication.mjs'
producer=(previous/'candidate'/producer_path).read_bytes().decode()
tooling={helper_path:[helper_pin['bytes'],helper_pin['sha256']],workflow_path:[workflow_pin['bytes'],workflow_pin['sha256']],generic_path:[generic_pin['bytes'],generic_pin['sha256']],browser_path:[browser_pin['bytes'],browser_pin['sha256']]}
producer=once(producer,'const NOTES_REVIEWED=', 'const NOTES_INSTALLED_TOOLING='+json.dumps(tooling,indent=2).replace('\n','\r\n')+';\r\nconst NOTES_REVIEWED=')
producer=once(producer,"  const notesEnvelope=Buffer.from(JSON.stringify({schema:'rea-closed-Notes-source-proof-envelope/v1'", "  assert.equal(Object.keys(NOTES_INSTALLED_TOOLING).length,4);for(const[name,[bytes,sha256]]of Object.entries(NOTES_INSTALLED_TOOLING)){assert.ok(tracked.has(name));const content=fs.readFileSync(publicFile(name));assert.deepEqual(identity(content),{bytes,sha256});assert.ok(content.length<=256*1024);notesBytes+=content.length;assert.ok(notesRows.length<64&&notesBytes<=8*1024*1024);notesRows.push({path:name,...identity(content),base64:content.toString('base64'),group:'installed-Notes-tooling'});}assert.equal(notesRows.length,56);\r\n  const notesEnvelope=Buffer.from(JSON.stringify({schema:'rea-closed-Notes-source-proof-envelope/v1'")
producer=once(producer,"sourceFiles:52,rawSourceBytes:notesBytes,decoded:","sourceFiles:56,proofSourceFiles:52,installedToolingSourceFiles:4,rawSourceBytes:notesBytes,decoded:")
(candidate/producer_path).write_bytes(producer.encode())
producer_pin=pin(producer.encode())
controls_path='scripts/publication-integrity-controls.mjs'
controls=(previous/'candidate'/controls_path).read_bytes().decode()
previous_producer=pin((previous/'candidate'/producer_path).read_bytes())
controls=once(controls,js(previous_producer),js(producer_pin))
(candidate/controls_path).write_bytes(controls.encode())

scope_doc='''# Committed Notes acceptance: source proposal

The exact eight Notes application afterimages remain those tested in the recorded92-group source-composition run and8-case Chromium campaign. Their README deliberately retains its original prospective/unexecuted/not-installed proposal wording. It is a frozen source epoch, not a current installation status statement. No README source epoch is changed by this proposal.

The new two-job workflow authenticates all32 committed Notes files and all8 exact after pins. It then requires the unchanged17-file Notes roster,92 actual groups,23 new group names and20 separately counted released-Joplin helper comparisons. The separate Chromium job reuses the exact8-case spec, requiring4 genuine successful-response holds,2 actual downloads,8 PNGs and8 complete owned cleanup records. Every other eligible active source must match its committed Git blob. Independent always source postchecks remain required after a started check, including failures.

The collectors perform no source installation and do not authenticate an installer receipt. An actual source-copy journal and fresh cloud run URLs must be filed separately after reviewed copy and commit. At source-authoring time no new installed workflow has executed, no fresh installed acceptance is claimed, and no original full application/GUI, full suite, security, parity or superiority result is established. All previous92/8/937 and other historical records retain their original source scope.

The two old experimental workflows keep manual entry points while their automatic triggers retire. Their exact beforeimages are preserved. Old experimental source contracts and the pinned8-case browser bundle are unchanged; its former workflow hash remains historical context. The installed helper independently binds the new workflow. All work is still a reviewable source proposal until exact root copy and fresh verified cloud evidence.
'''
put(prefix+'INSTALLED-ACCEPTANCE.md',scope_doc.encode())
rows=[]
for p in sorted(candidate.rglob('*')):
    if not p.is_file():continue
    name=str(p.relative_to(candidate)).replace('\\','/')
    rows.append({'path':name,'before':pin(raw(name)) if (repo/name).is_file() else None,'after':pin(p.read_bytes())})
authority={'schema':'rea-Notes-installed-source-and-tooling-authority/v1','baseCommit':'016ecd175c0700d1a94d5219af6719989a4a6e45','phase12Authority':pin(phase12_bytes),
 'candidateRoot':str(candidate),'files':rows,'candidateFiles':len(rows),'candidateBytes':sum(r['after']['bytes'] for r in rows),
 'applicationTargetsUnchanged':8,'allCurrentNotesFilesRequired':32,'eligibleNotesSources':30,'fixedNotesTestFiles':17,'expectedFiniteGroups':92,'newGroupNamesRequired':23,'originalHelperComparisonsSeparate':20,
 'realBrowserCases':8,'realResponseHolds':4,'actualBrowserDownloads':2,'completeOwnedCleanups':8,'PNGs':8,'genuineHttp400Conflicts':1,
 'NotesProofGroupPaths':52,'NotesProofGroupLimit':64,'separateInstalledToolingCaptureSources':4,'singleEnvelopeTotalSourceFiles':56,'publicationArtifactPredictedFiles':92,'publicationArtifactMaximumFiles':96,
 'common159Maximum160Unchanged':True,'Archive94Maximum96Unchanged':True,'publicationControlsPlanned':208,'oldExperimentalAutomaticTriggersRetired':2,'oldExperimentalManualEntriesRetained':2,
 'genericCollectorBeforeImagePreserved':{'bytes':82635,'sha256':'bc6236e5a253e3260dcdea40962affd031411bf033edf30a32cc58fa522f3450'},
 'speculativeGenericHistoricalResolverAliasesAdded':0,'sourceAuthoringOnly':True,'activeRepositoryWrites':0,'gitMutations':0,'localProductExecutions':0,'localTests':0,'localSyntaxChecks':0,'localBuilds':0,'localBrowserExecutions':0,
 'freshCloudAcceptanceClaimed':False,'actualSourceInstallationPerformedByAuthor':False,'frozenApplicationReadmeRemainsProposalEpoch':True,'fullParity':False,'superiority':False}
save_json(stage/'change-authority.json',authority)
print(json.dumps({'authority':str(stage/'change-authority.json'),**pin((stage/'change-authority.json').read_bytes()),'candidateFiles':len(rows),'candidateBytes':authority['candidateBytes'],'helper':helper_pin,'generic':generic_pin,'browser':browser_pin,'producer':producer_pin}))
"""Source/file authoring only. Never imports/tests/builds candidate JavaScript."""
import hashlib
import json
import re
from pathlib import Path

work=Path(__file__).resolve().parent
repo=work.parent/'outputs/rea-research-lab'
previous=work/'notes-installed-source-proof-phase12-next'
stage=work/'notes-installed-tooling-phase3-r2-next'
candidate=stage/'candidate'
candidate.mkdir(parents=True,exist_ok=False)
sha=lambda b:hashlib.sha256(b).hexdigest()
pin=lambda b:{'bytes':len(b),'sha256':sha(b)}
raw=lambda p:(repo/p).read_bytes()
txt=lambda p:raw(p).decode('utf-8')
js=lambda v:json.dumps(v,separators=(',',':'))
save_json=lambda p,v:p.write_text(json.dumps(v,indent=2)+'\n',encoding='utf-8')
def once(s,a,b):
    assert s.count(a)==1,a[:120]
    return s.replace(a,b)
def put(p,data):
    target=candidate/p
    target.parent.mkdir(parents=True,exist_ok=True)
    with target.open('xb') as f:f.write(data)
    return pin(data)
phase12_bytes=(previous/'change-authority.json').read_bytes()
assert pin(phase12_bytes)=={'bytes':12211,'sha256':'2fa1c7435a085fd45c9a61b9563561b99be4578134b0815082257249bf6513c2'}
phase12=json.loads(phase12_bytes)
for row in phase12['files']:
    data=(previous/'candidate'/row['path']).read_bytes()
    assert pin(data)==row['after']
    put(row['path'],data)

workflow_path='.github/workflows/notes-installed-cloud.yml'
header='''name: Committed Notes tasks acceptance

on:
  workflow_dispatch:
  push:
    branches: [codex/rea-cloud-recovery-20261015]
    paths:
      - '.github/workflows/notes-installed-cloud.yml'
      - 'products/rea-studio/apps/notes/**'
      - 'products/rea-studio/experiments/notes-todo/**'
      - 'products/rea-studio/experiments/notes-todo-browser/**'
      - 'products/rea-studio/scripts/verify-notes-installed-cloud.mjs'
      - 'products/rea-studio/scripts/verify-cloud.mjs'
      - 'products/rea-studio/scripts/verify-cloud-browser.mjs'
      - 'products/rea-studio/scripts/verify-notes-todo-browser-cloud.mjs'
      - 'products/rea-studio/browser-tests/**'
      - 'products/rea-studio/server.mjs'
      - 'products/rea-studio/catalog.mjs'
      - 'products/rea-studio/lib/**'
      - 'products/rea-studio/public/**'
      - 'products/rea-studio/package.json'

permissions:
  contents: read
concurrency:
  group: notes-installed-${{ github.ref }}
  cancel-in-progress: false

jobs:
'''
common='''    runs-on: windows-2022
    timeout-minutes: 30
    env:
      CI: 'true'
    steps:
      - name: Enable long research paths
        shell: pwsh
        run: git config --global core.longpaths true
      - name: Check out exact committed source
        id: checkout
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
          fetch-depth: 1
      - name: Select pinned Node runtime
        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '24.16.0'
          architecture: x64
          check-latest: false
      - name: Select owned evidence outside source paths
        shell: pwsh
        run: |
          $evidence=Join-Path $env:RUNNER_TEMP ('rea-notes-installed-__ROLE__-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT)
          New-Item -ItemType Directory -Path $evidence|Out-Null
          'REA_NOTES_INSTALLED_EVIDENCE='+$evidence|Out-File -FilePath $env:GITHUB_ENV -Encoding utf8 -Append
__BROWSER_ENV__
'''
before='''      - name: Authenticate all32 committed Notes files and eight exact afterimages
        id: sourcebefore
        shell: pwsh
        run: node products/rea-studio/scripts/verify-notes-installed-cloud.mjs --phase before --evidence "$env:REA_NOTES_INSTALLED_EVIDENCE"
'''
finite='''      - name: Execute unchanged seventeen-file Notes roster on committed sources
        id: verify
        shell: pwsh
        run: |
          $manifest=Join-Path $env:REA_NOTES_INSTALLED_EVIDENCE 'notes-installed-source-check.json'
          $output=Join-Path $env:REA_NOTES_INSTALLED_EVIDENCE 'verification'
          node products/rea-studio/scripts/verify-cloud.mjs --scope notes-todo-installed --output "$output" --installed-manifest "$manifest" --timeout-ms 1200000
'''
browser_acquire='''      - name: Acquire locked Chromium tooling on the clean committed checkout
        id: acquire
        shell: pwsh
        run: node products/rea-studio/scripts/verify-cloud-browser.mjs --phase acquire --evidence "$env:REA_NOTES_INSTALLED_EVIDENCE"
'''
browser='''      - name: Execute eight unchanged real Chromium Notes scenarios
        id: verify
        shell: pwsh
        run: |
          $manifest=Join-Path $env:REA_NOTES_INSTALLED_EVIDENCE 'notes-installed-source-check.json'
          node products/rea-studio/scripts/verify-cloud-browser.mjs --phase verify --evidence "$env:REA_NOTES_INSTALLED_EVIDENCE" --scope notes-todo-installed --installed-manifest "$manifest"
'''
after='''      - name: Independently authenticate all32 Notes files after every started source check
        id: sourceafter
        if: always() && steps.sourcebefore.outcome != '' && steps.sourcebefore.outcome != 'skipped'
        shell: pwsh
        run: node products/rea-studio/scripts/verify-notes-installed-cloud.mjs --phase after --evidence "$env:REA_NOTES_INSTALLED_EVIDENCE"
'''
browser_after='''      - name: Independently recheck every eligible browser Git blob after failures too
        id: browserpost
        if: always() && steps.sourcebefore.outcome != '' && steps.sourcebefore.outcome != 'skipped'
        shell: pwsh
        run: |
          $manifest=Join-Path $env:REA_NOTES_INSTALLED_EVIDENCE 'notes-installed-source-check.json'
          node products/rea-studio/scripts/verify-cloud-browser.mjs --phase postcheck --evidence "$env:REA_NOTES_INSTALLED_EVIDENCE" --scope notes-todo-installed --installed-manifest "$manifest"
'''
package='''      - name: Package bounded complete success or failure evidence
        id: evidence
        if: always()
        shell: pwsh
        run: |
          $evidence=$env:REA_NOTES_INSTALLED_EVIDENCE
          if(-not $evidence){$evidence=Join-Path $env:RUNNER_TEMP ('rea-notes-installed-__ROLE__-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT)}
          New-Item -ItemType Directory -Path $evidence -Force|Out-Null
          @{schema='rea-Notes-installed-workflow-attempt/v1';role='__ROLE__';sourceCommit=$env:GITHUB_SHA;runId=$env:GITHUB_RUN_ID;runAttempt=$env:GITHUB_RUN_ATTEMPT;runnerEnvironment=$env:RUNNER_ENVIRONMENT;checkoutOutcome='${{ steps.checkout.outcome }}';acquisitionOutcome='${{ steps.acquire.outcome }}';sourceBeforeOutcome='${{ steps.sourcebefore.outcome }}';verificationOutcome='${{ steps.verify.outcome }}';sourceAfterOutcome='${{ steps.sourceafter.outcome }}';browserPostcheckOutcome='${{ steps.browserpost.outcome }}';sourceOverlay=$false;installationPerformedByWorkflow=$false;productionInstallationReceiptAuthenticated=$false;historicalReceiptsRebound=$false;frozenReadmeIsProposalEpoch=$true;fullParity=$false;superiority=$false}|ConvertTo-Json -Depth 6|Set-Content -LiteralPath (Join-Path $evidence 'installed-workflow-attempt.json') -Encoding utf8
          $files=@(Get-ChildItem -LiteralPath $evidence -File -Recurse)
          $rawBytes=($files|Measure-Object Length -Sum).Sum
          $bounded=$files.Count -le 2500 -and $rawBytes -le 96*1024*1024 -and @($files|Where-Object {$_.Length -gt 8*1024*1024}).Count -eq 0
          $archive=Join-Path $env:RUNNER_TEMP ('rea-notes-installed-__ROLE__-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT+'.zip')
          Add-Type -AssemblyName System.IO.Compression.FileSystem
          if($bounded){[IO.Compression.ZipFile]::CreateFromDirectory($evidence,$archive,[IO.Compression.CompressionLevel]::Optimal,$false)}
          $archiveBytes=if($bounded){(Get-Item -LiteralPath $archive).Length}else{$null}
          if(-not $bounded -or $archiveBytes -gt 15*1024*1024){
            $fallback=Join-Path $env:RUNNER_TEMP ('rea-notes-installed-incomplete-__ROLE__-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT)
            New-Item -ItemType Directory -Path $fallback|Out-Null
            foreach($file in Get-ChildItem -LiteralPath $evidence -File){if($file.Length -le 1024*1024){Copy-Item -LiteralPath $file.FullName -Destination (Join-Path $fallback $file.Name)}}
            @{schema='rea-cloud-evidence-storage-failure/v1';status='failed';role='__ROLE__';completeEvidenceUploaded=$false;sourceSnapshotsUploaded=$false;rawLogsComplete=$false;rawFiles=$files.Count;rawBytes=$rawBytes;archiveBytes=$archiveBytes;rawFileLimit=2500;rawByteLimit=96*1024*1024;individualByteLimit=8*1024*1024;zipLimit=15*1024*1024;reason='Complete Notes evidence exceeded a fixed bound; fallback is not portable acceptance.'}|ConvertTo-Json|Set-Content -LiteralPath (Join-Path $fallback 'storage-failure.json') -Encoding utf8
            $archive=Join-Path $env:RUNNER_TEMP ('rea-notes-installed-incomplete-__ROLE__-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT+'.zip')
            [IO.Compression.ZipFile]::CreateFromDirectory($fallback,$archive,[IO.Compression.CompressionLevel]::Optimal,$false)
            if((Get-Item -LiteralPath $archive).Length -le 15*1024*1024){'artifact_path='+$archive|Out-File -FilePath $env:GITHUB_OUTPUT -Encoding utf8 -Append}
            throw 'Complete Notes evidence exceeded a fixed bound; fallback is explicitly incomplete.'
          }
          'artifact_path='+$archive|Out-File -FilePath $env:GITHUB_OUTPUT -Encoding utf8 -Append
      - name: Preserve complete evidence or explicit incomplete failure record
        if: always() && steps.evidence.outputs.artifact_path != ''
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: notes-installed-__ROLE__-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ steps.evidence.outputs.artifact_path }}
          if-no-files-found: error
          compression-level: 0
          retention-days: 1
'''
finite_job='  finite-seventeen-file-selection:\n'+common.replace('__ROLE__','finite').replace('__BROWSER_ENV__','')+before+finite+after+package.replace('__ROLE__','finite')
browser_env="          'REA_BROWSER_EVIDENCE='+$evidence|Out-File -FilePath $env:GITHUB_ENV -Encoding utf8 -Append\n          'PLAYWRIGHT_BROWSERS_PATH='+(Join-Path $env:RUNNER_TEMP ('rea-notes-installed-playwright-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT))|Out-File -FilePath $env:GITHUB_ENV -Encoding utf8 -Append"
browser_job='  eight-real-chromium-scenarios:\n'+common.replace('__ROLE__','browser').replace('__BROWSER_ENV__',browser_env)+browser_acquire+before+browser+after+browser_after+package.replace('__ROLE__','browser')
workflow=(header+finite_job+'\n'+browser_job).replace('\n','\r\n').encode()
workflow_pin=put(workflow_path,workflow)

audit=json.loads((work/'notes-installation-dependency-audit-next/dependency-audit-r3.json').read_text())
helper_path='products/rea-studio/scripts/verify-notes-installed-cloud.mjs'
helper=(work/'notes-installed-helper.fragment.mjs').read_text()
index_path='products/rea-studio/apps/notes/results/todo-followup/publication-index.json'
index_bytes=(candidate/index_path).read_bytes()
helper=helper.replace('__CURRENT_SOURCES__',js(audit['proposedInstalledNotesSourceCensus'])).replace('__INDEX_SOURCE__',js({'path':index_path,**pin(index_bytes)})).replace('__WORKFLOW_SOURCE__',js({'path':workflow_path,**workflow_pin}))
helper_pin=put(helper_path,helper.replace('\n','\r\n').encode())
generic_path='products/rea-studio/scripts/verify-cloud.mjs'
generic=txt(generic_path)
generic=once(generic,"'vault-empty-bin-experiment', 'notes-todo-experiment'].includes(options.scope), 'Use a supported explicit cloud verification scope'","'vault-empty-bin-experiment', 'notes-todo-experiment', 'notes-todo-installed'].includes(options.scope), 'Use a supported explicit cloud verification scope'")
generic=once(generic,"assert(['windows-path-installed', 'archive-aes-installed'].includes(options.scope) || !options.installedManifest","assert(['windows-path-installed', 'archive-aes-installed', 'notes-todo-installed'].includes(options.scope) || !options.installedManifest")
generic=once(generic,"if (options.scope === 'notes-todo-experiment') assert(!options.bootstrapManifest,","if (['notes-todo-experiment','notes-todo-installed'].includes(options.scope)) assert(!options.bootstrapManifest,")
generic=once(generic,"'notes-todo-composition.json.snapshot', 'notes-todo-bundle.json.snapshot'","'notes-installed-source-check.json.snapshot', 'notes-todo-composition.json.snapshot', 'notes-todo-bundle.json.snapshot'")
generic=once(generic,"  acceptanceScope: options.scope === 'archive-aes-installed' ?", "  acceptanceScope: options.scope === 'notes-todo-installed' ? 'Fixed17-file Notes roster and92 groups on clean committed32-file Notes sources and8 exact after pins. All23 new names and20 original helper comparisons remain separate, actual HTTP delivery and every other active Git blob are required. Independent always source postcheck is separate. No source installation by collector, original full application/GUI, browser, full-suite, security, parity or superiority acceptance; frozen README describes the reviewed proposal epoch.' : options.scope === 'archive-aes-installed' ?")
generic=once(generic,"  if (options.scope === 'notes-todo-experiment') {", "  if (['notes-todo-experiment','notes-todo-installed'].includes(options.scope)) {")
fragment=(work/'notes-installed-generic-phase.fragment.txt').read_text().replace('__INSTALLED_HELPER_PIN__',js(helper_pin)).replace('\n','\r\n')
generic=once(generic,'async function verifyArchiveInstalled() {',fragment+'\r\nasync function verifyArchiveInstalled() {')
generic=once(generic,'notesTodo = null, archiveInstalled = null;','notesTodo = null, notesInstalled = null, archiveInstalled = null;')
generic=once(generic,"  if (options.scope === 'notes-todo-experiment') notesTodo = verifyNotesTodoComposition();", "  if (options.scope === 'notes-todo-experiment') notesTodo = verifyNotesTodoComposition();\r\n  if (options.scope === 'notes-todo-installed') { notesTodo = await verifyNotesTodoInstalled(); notesInstalled = notesTodo; }")
generic=once(generic,"      if (notesTodo) { assert(summary.tests >= 23); verifyNotesTodoResults(notesTodo); }", "      if (notesTodo) { assert(summary.tests >= 23); if(notesInstalled)assert.equal(summary.tests,92,'Installed Notes must execute exactly92 groups in the fixed17-file roster'); verifyNotesTodoResults(notesTodo); }")
generic=once(generic,'\n  if (notesTodo) {', '\n  if (notesTodo && !notesInstalled) {')
generic=once(generic,"  record.status = receivedSignal ? 'interrupted'", "  if(notesInstalled){try{assert.deepEqual(visibleGitStatus(),[]);const proof=notesInstalled.module.verifyInstalledNotesReceipt(options.installedManifest,path.dirname(output));assert.deepEqual(proof.authentication,notesInstalled.authentication);assert.equal(readGit(['rev-parse','HEAD']).toString('utf8').trim(),record.repositoryCommit);assert.equal(record.repositoryCommit,process.env.GITHUB_SHA);record.notesInstalled.allCommittedSourcesStableAfter=true;if(!options.sourceOnly){record.notesLegacyObservation=preserveNotesLegacyObservation();if(!record.failures.length)assert.equal(record.notesLegacyObservation.present,true);}}catch(error){failure('Installed Notes source/evidence postcheck: '+error.message);}}\r\n  record.status = receivedSignal ? 'interrupted'")
generic_pin=put(generic_path,generic.encode())

browser_path='products/rea-studio/scripts/verify-cloud-browser.mjs'
browser_source=txt(browser_path)
browser_source=once(browser_source,"const explicitScope = args.length === 8, notesScope = explicitScope && args[5] === 'notes-todo-experiment';", "const explicitScope = args.length === 8, notesInstalledScope = explicitScope && args[5] === 'notes-todo-installed', notesScope = explicitScope && ['notes-todo-experiment','notes-todo-installed'].includes(args[5]);")
browser_source=once(browser_source,"['archive-aes-experiment', 'archive-aes-installed', 'notes-todo-experiment'].includes(args[5])", "['archive-aes-experiment', 'archive-aes-installed', 'notes-todo-experiment', 'notes-todo-installed'].includes(args[5])")
browser_source=once(browser_source,"archiveInstalledScope ? '--installed-manifest' : '--overlay-manifest'", "(archiveInstalledScope || notesInstalledScope) ? '--installed-manifest' : '--overlay-manifest'")
browser_source=once(browser_source,"(notesScope ? 'rea-cloud-notes-browser-postrun-source-check/v1' :", "(notesInstalledScope ? 'rea-cloud-Notes-installed-browser-postrun-source-check/v1' : notesScope ? 'rea-cloud-notes-browser-postrun-source-check/v1' :")
browser_source=once(browser_source,"  scope: notesScope ?", "  scope: notesInstalledScope ? 'Eight unchanged real Chromium Notes cases on clean committed32-file Notes sources and8 exact after pins. Requires full six-directory Git census, independent always Notes/browser postchecks, four actual response holds, two raw downloads, eight PNGs and eight complete cleanups. No source overlay, original full application/GUI, full-suite, security, parity or superiority acceptance; frozen README remains proposal-epoch documentation.' : notesScope ?")
fragment=(work/'notes-installed-browser-phase.fragment.txt').read_text().replace('__INSTALLED_HELPER_PIN__',js(helper_pin))
fragment=fragment.replace(' const proof=installed.verifyInstalledNotesReceipt(args[7],evidence);',' const proof=installed.verifyInstalledNotesReceipt(args[7],evidence);notesProof=proof;notesModule=installed;')
browser_source=once(browser_source,'async function verifyNotesBrowserPhase() {',fragment.replace('\n','\r\n')+'\r\nasync function verifyNotesBrowserPhase() {\r\n  if(notesInstalledScope)return verifyInstalledNotesBrowserPhase();')
browser_source=once(browser_source,"if (notesScope) { assert.deepEqual(notesModule.verifyNotesBrowserComposition(args[7]).receipt, notesProof.receipt);", "if(notesInstalledScope){assert.deepEqual(notesModule.verifyInstalledNotesReceipt(args[7],evidence).receipt,notesProof.receipt);record.sourceAuthentication=notesModule.authenticateInstalledNotesCensus(after,notesProof);} else if (notesScope) { assert.deepEqual(notesModule.verifyNotesBrowserComposition(args[7]).receipt, notesProof.receipt);")
browser_pin=put(browser_path,browser_source.encode())

prefix='products/rea-studio/results/notes-todo-source-transition-20261016/'
for name in ('notes-todo-cloud.yml','notes-todo-browser-cloud.yml'):
    p='.github/workflows/'+name
    old=raw(p)
    put(prefix+'workflow-before/'+name+'.snapshot',old)
    body=old.decode()
    start=body.index('  push:')
    end=body.index('\r\npermissions:',start)
    body=body[:start]+body[end:]
    put(p,body.encode())
put(prefix+'verifier-before/verify-cloud-browser.mjs.snapshot',raw(browser_path))
put(prefix+'phase12-authority.json.snapshot',phase12_bytes)
for name in ('verify-cloud-publication.mjs','publication-integrity-controls.mjs'):
    put(prefix+'verifier-before/phase12-'+name+'.snapshot',(previous/'candidate/scripts'/name).read_bytes())

# Extend the existing single envelope. The Notes proof keeps its own52 paths;
# these four exact tooling pins form a separately named4-source capture group.
producer_path='scripts/verify-cloud-publication.mjs'
producer=(previous/'candidate'/producer_path).read_bytes().decode()
tooling={helper_path:[helper_pin['bytes'],helper_pin['sha256']],workflow_path:[workflow_pin['bytes'],workflow_pin['sha256']],generic_path:[generic_pin['bytes'],generic_pin['sha256']],browser_path:[browser_pin['bytes'],browser_pin['sha256']]}
producer=once(producer,'const NOTES_REVIEWED=', 'const NOTES_INSTALLED_TOOLING='+json.dumps(tooling,indent=2).replace('\n','\r\n')+';\r\nconst NOTES_REVIEWED=')
producer=once(producer,"  const notesEnvelope=Buffer.from(JSON.stringify({schema:'rea-closed-Notes-source-proof-envelope/v1'", "  assert.equal(Object.keys(NOTES_INSTALLED_TOOLING).length,4);for(const[name,[bytes,sha256]]of Object.entries(NOTES_INSTALLED_TOOLING)){assert.ok(tracked.has(name));const content=fs.readFileSync(publicFile(name));assert.deepEqual(identity(content),{bytes,sha256});assert.ok(content.length<=256*1024);notesBytes+=content.length;assert.ok(notesRows.length<64&&notesBytes<=8*1024*1024);notesRows.push({path:name,...identity(content),base64:content.toString('base64'),group:'installed-Notes-tooling'});}assert.equal(notesRows.length,56);\r\n  const notesEnvelope=Buffer.from(JSON.stringify({schema:'rea-closed-Notes-source-proof-envelope/v1'")
producer=once(producer,"sourceFiles:52,rawSourceBytes:notesBytes,decoded:","sourceFiles:56,proofSourceFiles:52,installedToolingSourceFiles:4,rawSourceBytes:notesBytes,decoded:")
(candidate/producer_path).write_bytes(producer.encode())
producer_pin=pin(producer.encode())
controls_path='scripts/publication-integrity-controls.mjs'
controls=(previous/'candidate'/controls_path).read_bytes().decode()
previous_producer=pin((previous/'candidate'/producer_path).read_bytes())
controls=once(controls,js(previous_producer),js(producer_pin))
(candidate/controls_path).write_bytes(controls.encode())

scope_doc='''# Committed Notes acceptance: source proposal

The exact eight Notes application afterimages remain those tested in the recorded92-group source-composition run and8-case Chromium campaign. Their README deliberately retains its original prospective/unexecuted/not-installed proposal wording. It is a frozen source epoch, not a current installation status statement. No README source epoch is changed by this proposal.

The new two-job workflow authenticates all32 committed Notes files and all8 exact after pins. It then requires the unchanged17-file Notes roster,92 actual groups,23 new group names and20 separately counted released-Joplin helper comparisons. The separate Chromium job reuses the exact8-case spec, requiring4 genuine successful-response holds,2 actual downloads,8 PNGs and8 complete owned cleanup records. Every other eligible active source must match its committed Git blob. Independent always source postchecks remain required after a started check, including failures.

The collectors perform no source installation and do not authenticate an installer receipt. An actual source-copy journal and fresh cloud run URLs must be filed separately after reviewed copy and commit. At source-authoring time no new installed workflow has executed, no fresh installed acceptance is claimed, and no original full application/GUI, full suite, security, parity or superiority result is established. All previous92/8/937 and other historical records retain their original source scope.

The two old experimental workflows keep manual entry points while their automatic triggers retire. Their exact beforeimages are preserved. Old experimental source contracts and the pinned8-case browser bundle are unchanged; its former workflow hash remains historical context. The installed helper independently binds the new workflow. All work is still a reviewable source proposal until exact root copy and fresh verified cloud evidence.
'''
put(prefix+'INSTALLED-ACCEPTANCE.md',scope_doc.encode())
rows=[]
for p in sorted(candidate.rglob('*')):
    if not p.is_file():continue
    name=str(p.relative_to(candidate)).replace('\\','/')
    rows.append({'path':name,'before':pin(raw(name)) if (repo/name).is_file() else None,'after':pin(p.read_bytes())})
authority={'schema':'rea-Notes-installed-source-and-tooling-authority/v1','baseCommit':'016ecd175c0700d1a94d5219af6719989a4a6e45','phase12Authority':pin(phase12_bytes),
 'candidateRoot':str(candidate),'files':rows,'candidateFiles':len(rows),'candidateBytes':sum(r['after']['bytes'] for r in rows),
 'applicationTargetsUnchanged':8,'allCurrentNotesFilesRequired':32,'eligibleNotesSources':30,'fixedNotesTestFiles':17,'expectedFiniteGroups':92,'newGroupNamesRequired':23,'originalHelperComparisonsSeparate':20,
 'realBrowserCases':8,'realResponseHolds':4,'actualBrowserDownloads':2,'completeOwnedCleanups':8,'PNGs':8,'genuineHttp400Conflicts':1,
 'NotesProofGroupPaths':52,'NotesProofGroupLimit':64,'separateInstalledToolingCaptureSources':4,'singleEnvelopeTotalSourceFiles':56,'publicationArtifactPredictedFiles':92,'publicationArtifactMaximumFiles':96,
 'common159Maximum160Unchanged':True,'Archive94Maximum96Unchanged':True,'publicationControlsPlanned':208,'oldExperimentalAutomaticTriggersRetired':2,'oldExperimentalManualEntriesRetained':2,
 'genericCollectorBeforeImagePreserved':{'bytes':82635,'sha256':'bc6236e5a253e3260dcdea40962affd031411bf033edf30a32cc58fa522f3450'},
 'speculativeGenericHistoricalResolverAliasesAdded':0,'sourceAuthoringOnly':True,'activeRepositoryWrites':0,'gitMutations':0,'localProductExecutions':0,'localTests':0,'localSyntaxChecks':0,'localBuilds':0,'localBrowserExecutions':0,
 'freshCloudAcceptanceClaimed':False,'actualSourceInstallationPerformedByAuthor':False,'frozenApplicationReadmeRemainsProposalEpoch':True,'fullParity':False,'superiority':False}
save_json(stage/'change-authority.json',authority)
print(json.dumps({'authority':str(stage/'change-authority.json'),**pin((stage/'change-authority.json').read_bytes()),'candidateFiles':len(rows),'candidateBytes':authority['candidateBytes'],'helper':helper_pin,'generic':generic_pin,'browser':browser_pin,'producer':producer_pin}))
"""Source/file authoring only. Never imports/tests/builds candidate JavaScript."""
import hashlib
import json
import re
from pathlib import Path

work=Path(__file__).resolve().parent
repo=work.parent/'outputs/rea-research-lab'
previous=work/'notes-installed-source-proof-phase12-next'
stage=work/'notes-installed-tooling-phase3-r3-next'
candidate=stage/'candidate'
candidate.mkdir(parents=True,exist_ok=False)
sha=lambda b:hashlib.sha256(b).hexdigest()
pin=lambda b:{'bytes':len(b),'sha256':sha(b)}
raw=lambda p:(repo/p).read_bytes()
txt=lambda p:raw(p).decode('utf-8')
js=lambda v:json.dumps(v,separators=(',',':'))
save_json=lambda p,v:p.write_text(json.dumps(v,indent=2)+'\n',encoding='utf-8')
def once(s,a,b):
    assert s.count(a)==1,a[:120]
    return s.replace(a,b)
def put(p,data):
    target=candidate/p
    target.parent.mkdir(parents=True,exist_ok=True)
    with target.open('xb') as f:f.write(data)
    return pin(data)
phase12_bytes=(previous/'change-authority.json').read_bytes()
assert pin(phase12_bytes)=={'bytes':12211,'sha256':'2fa1c7435a085fd45c9a61b9563561b99be4578134b0815082257249bf6513c2'}
phase12=json.loads(phase12_bytes)
for row in phase12['files']:
    data=(previous/'candidate'/row['path']).read_bytes()
    assert pin(data)==row['after']
    put(row['path'],data)

workflow_path='.github/workflows/notes-installed-cloud.yml'
header='''name: Committed Notes tasks acceptance

on:
  workflow_dispatch:
  push:
    branches: [codex/rea-cloud-recovery-20261015]
    paths:
      - '.github/workflows/notes-installed-cloud.yml'
      - 'products/rea-studio/apps/notes/**'
      - 'products/rea-studio/experiments/notes-todo/**'
      - 'products/rea-studio/experiments/notes-todo-browser/**'
      - 'products/rea-studio/scripts/verify-notes-installed-cloud.mjs'
      - 'products/rea-studio/scripts/verify-cloud.mjs'
      - 'products/rea-studio/scripts/verify-cloud-browser.mjs'
      - 'products/rea-studio/scripts/verify-notes-todo-browser-cloud.mjs'
      - 'products/rea-studio/browser-tests/**'
      - 'products/rea-studio/server.mjs'
      - 'products/rea-studio/catalog.mjs'
      - 'products/rea-studio/lib/**'
      - 'products/rea-studio/public/**'
      - 'products/rea-studio/package.json'

permissions:
  contents: read
concurrency:
  group: notes-installed-${{ github.ref }}
  cancel-in-progress: false

jobs:
'''
common='''    runs-on: windows-2022
    timeout-minutes: 30
    env:
      CI: 'true'
    steps:
      - name: Enable long research paths
        shell: pwsh
        run: git config --global core.longpaths true
      - name: Check out exact committed source
        id: checkout
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
          fetch-depth: 1
      - name: Select pinned Node runtime
        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '24.16.0'
          architecture: x64
          check-latest: false
      - name: Select owned evidence outside source paths
        shell: pwsh
        run: |
          $evidence=Join-Path $env:RUNNER_TEMP ('rea-notes-installed-__ROLE__-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT)
          New-Item -ItemType Directory -Path $evidence|Out-Null
          'REA_NOTES_INSTALLED_EVIDENCE='+$evidence|Out-File -FilePath $env:GITHUB_ENV -Encoding utf8 -Append
__BROWSER_ENV__
'''
before='''      - name: Authenticate all32 committed Notes files and eight exact afterimages
        id: sourcebefore
        shell: pwsh
        run: node products/rea-studio/scripts/verify-notes-installed-cloud.mjs --phase before --evidence "$env:REA_NOTES_INSTALLED_EVIDENCE"
'''
finite='''      - name: Execute unchanged seventeen-file Notes roster on committed sources
        id: verify
        shell: pwsh
        run: |
          $manifest=Join-Path $env:REA_NOTES_INSTALLED_EVIDENCE 'notes-installed-source-check.json'
          $output=Join-Path $env:REA_NOTES_INSTALLED_EVIDENCE 'verification'
          node products/rea-studio/scripts/verify-cloud.mjs --scope notes-todo-installed --output "$output" --installed-manifest "$manifest" --timeout-ms 1200000
'''
browser_acquire='''      - name: Acquire locked Chromium tooling on the clean committed checkout
        id: acquire
        shell: pwsh
        run: node products/rea-studio/scripts/verify-cloud-browser.mjs --phase acquire --evidence "$env:REA_NOTES_INSTALLED_EVIDENCE"
'''
browser='''      - name: Execute eight unchanged real Chromium Notes scenarios
        id: verify
        shell: pwsh
        run: |
          $manifest=Join-Path $env:REA_NOTES_INSTALLED_EVIDENCE 'notes-installed-source-check.json'
          node products/rea-studio/scripts/verify-cloud-browser.mjs --phase verify --evidence "$env:REA_NOTES_INSTALLED_EVIDENCE" --scope notes-todo-installed --installed-manifest "$manifest"
'''
after='''      - name: Independently authenticate all32 Notes files after every started source check
        id: sourceafter
        if: always() && steps.sourcebefore.outcome != '' && steps.sourcebefore.outcome != 'skipped'
        shell: pwsh
        run: node products/rea-studio/scripts/verify-notes-installed-cloud.mjs --phase after --evidence "$env:REA_NOTES_INSTALLED_EVIDENCE"
'''
browser_after='''      - name: Independently recheck every eligible browser Git blob after failures too
        id: browserpost
        if: always() && steps.sourcebefore.outcome != '' && steps.sourcebefore.outcome != 'skipped'
        shell: pwsh
        run: |
          $manifest=Join-Path $env:REA_NOTES_INSTALLED_EVIDENCE 'notes-installed-source-check.json'
          node products/rea-studio/scripts/verify-cloud-browser.mjs --phase postcheck --evidence "$env:REA_NOTES_INSTALLED_EVIDENCE" --scope notes-todo-installed --installed-manifest "$manifest"
'''
package='''      - name: Package bounded complete success or failure evidence
        id: evidence
        if: always()
        shell: pwsh
        run: |
          $evidence=$env:REA_NOTES_INSTALLED_EVIDENCE
          if(-not $evidence){$evidence=Join-Path $env:RUNNER_TEMP ('rea-notes-installed-__ROLE__-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT)}
          New-Item -ItemType Directory -Path $evidence -Force|Out-Null
          @{schema='rea-Notes-installed-workflow-attempt/v1';role='__ROLE__';sourceCommit=$env:GITHUB_SHA;runId=$env:GITHUB_RUN_ID;runAttempt=$env:GITHUB_RUN_ATTEMPT;runnerEnvironment=$env:RUNNER_ENVIRONMENT;checkoutOutcome='${{ steps.checkout.outcome }}';acquisitionOutcome='${{ steps.acquire.outcome }}';sourceBeforeOutcome='${{ steps.sourcebefore.outcome }}';verificationOutcome='${{ steps.verify.outcome }}';sourceAfterOutcome='${{ steps.sourceafter.outcome }}';browserPostcheckOutcome='${{ steps.browserpost.outcome }}';sourceOverlay=$false;installationPerformedByWorkflow=$false;productionInstallationReceiptAuthenticated=$false;historicalReceiptsRebound=$false;frozenReadmeIsProposalEpoch=$true;fullParity=$false;superiority=$false}|ConvertTo-Json -Depth 6|Set-Content -LiteralPath (Join-Path $evidence 'installed-workflow-attempt.json') -Encoding utf8
          $files=@(Get-ChildItem -LiteralPath $evidence -File -Recurse)
          $rawBytes=($files|Measure-Object Length -Sum).Sum
          $bounded=$files.Count -le 2500 -and $rawBytes -le 96*1024*1024 -and @($files|Where-Object {$_.Length -gt 8*1024*1024}).Count -eq 0
          $archive=Join-Path $env:RUNNER_TEMP ('rea-notes-installed-__ROLE__-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT+'.zip')
          Add-Type -AssemblyName System.IO.Compression.FileSystem
          if($bounded){[IO.Compression.ZipFile]::CreateFromDirectory($evidence,$archive,[IO.Compression.CompressionLevel]::Optimal,$false)}
          $archiveBytes=if($bounded){(Get-Item -LiteralPath $archive).Length}else{$null}
          if(-not $bounded -or $archiveBytes -gt 15*1024*1024){
            $fallback=Join-Path $env:RUNNER_TEMP ('rea-notes-installed-incomplete-__ROLE__-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT)
            New-Item -ItemType Directory -Path $fallback|Out-Null
            foreach($file in Get-ChildItem -LiteralPath $evidence -File){if($file.Length -le 1024*1024){Copy-Item -LiteralPath $file.FullName -Destination (Join-Path $fallback $file.Name)}}
            @{schema='rea-cloud-evidence-storage-failure/v1';status='failed';role='__ROLE__';completeEvidenceUploaded=$false;sourceSnapshotsUploaded=$false;rawLogsComplete=$false;rawFiles=$files.Count;rawBytes=$rawBytes;archiveBytes=$archiveBytes;rawFileLimit=2500;rawByteLimit=96*1024*1024;individualByteLimit=8*1024*1024;zipLimit=15*1024*1024;reason='Complete Notes evidence exceeded a fixed bound; fallback is not portable acceptance.'}|ConvertTo-Json|Set-Content -LiteralPath (Join-Path $fallback 'storage-failure.json') -Encoding utf8
            $archive=Join-Path $env:RUNNER_TEMP ('rea-notes-installed-incomplete-__ROLE__-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT+'.zip')
            [IO.Compression.ZipFile]::CreateFromDirectory($fallback,$archive,[IO.Compression.CompressionLevel]::Optimal,$false)
            if((Get-Item -LiteralPath $archive).Length -le 15*1024*1024){'artifact_path='+$archive|Out-File -FilePath $env:GITHUB_OUTPUT -Encoding utf8 -Append}
            throw 'Complete Notes evidence exceeded a fixed bound; fallback is explicitly incomplete.'
          }
          'artifact_path='+$archive|Out-File -FilePath $env:GITHUB_OUTPUT -Encoding utf8 -Append
      - name: Preserve complete evidence or explicit incomplete failure record
        if: always() && steps.evidence.outputs.artifact_path != ''
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: notes-installed-__ROLE__-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ steps.evidence.outputs.artifact_path }}
          if-no-files-found: error
          compression-level: 0
          retention-days: 1
'''
finite_job='  finite-seventeen-file-selection:\n'+common.replace('__ROLE__','finite').replace('__BROWSER_ENV__','')+before+finite+after+package.replace('__ROLE__','finite')
browser_env="          'REA_BROWSER_EVIDENCE='+$evidence|Out-File -FilePath $env:GITHUB_ENV -Encoding utf8 -Append\n          'PLAYWRIGHT_BROWSERS_PATH='+(Join-Path $env:RUNNER_TEMP ('rea-notes-installed-playwright-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT))|Out-File -FilePath $env:GITHUB_ENV -Encoding utf8 -Append"
browser_job='  eight-real-chromium-scenarios:\n'+common.replace('__ROLE__','browser').replace('__BROWSER_ENV__',browser_env)+browser_acquire+before+browser+after+browser_after+package.replace('__ROLE__','browser')
workflow=(header+finite_job+'\n'+browser_job).replace('\n','\r\n').encode()
workflow_pin=put(workflow_path,workflow)

audit=json.loads((work/'notes-installation-dependency-audit-next/dependency-audit-r3.json').read_text())
helper_path='products/rea-studio/scripts/verify-notes-installed-cloud.mjs'
helper=(work/'notes-installed-helper.fragment.mjs').read_text()
index_path='products/rea-studio/apps/notes/results/todo-followup/publication-index.json'
index_bytes=(candidate/index_path).read_bytes()
helper=helper.replace('__CURRENT_SOURCES__',js(audit['proposedInstalledNotesSourceCensus'])).replace('__INDEX_SOURCE__',js({'path':index_path,**pin(index_bytes)})).replace('__WORKFLOW_SOURCE__',js({'path':workflow_path,**workflow_pin}))
helper_pin=put(helper_path,helper.replace('\n','\r\n').encode())
generic_path='products/rea-studio/scripts/verify-cloud.mjs'
generic=txt(generic_path)
generic=once(generic,"'vault-empty-bin-experiment', 'notes-todo-experiment'].includes(options.scope), 'Use a supported explicit cloud verification scope'","'vault-empty-bin-experiment', 'notes-todo-experiment', 'notes-todo-installed'].includes(options.scope), 'Use a supported explicit cloud verification scope'")
generic=once(generic,"assert(['windows-path-installed', 'archive-aes-installed'].includes(options.scope) || !options.installedManifest","assert(['windows-path-installed', 'archive-aes-installed', 'notes-todo-installed'].includes(options.scope) || !options.installedManifest")
generic=once(generic,"if (options.scope === 'notes-todo-experiment') assert(!options.bootstrapManifest,","if (['notes-todo-experiment','notes-todo-installed'].includes(options.scope)) assert(!options.bootstrapManifest,")
generic=once(generic,"'notes-todo-composition.json.snapshot', 'notes-todo-bundle.json.snapshot'","'notes-installed-source-check.json.snapshot', 'notes-todo-composition.json.snapshot', 'notes-todo-bundle.json.snapshot'")
generic=once(generic,"  acceptanceScope: options.scope === 'archive-aes-installed' ?", "  acceptanceScope: options.scope === 'notes-todo-installed' ? 'Fixed17-file Notes roster and92 groups on clean committed32-file Notes sources and8 exact after pins. All23 new names and20 original helper comparisons remain separate, actual HTTP delivery and every other active Git blob are required. Independent always source postcheck is separate. No source installation by collector, original full application/GUI, browser, full-suite, security, parity or superiority acceptance; frozen README describes the reviewed proposal epoch.' : options.scope === 'archive-aes-installed' ?")
generic=once(generic,"  if (options.scope === 'notes-todo-experiment') {", "  if (['notes-todo-experiment','notes-todo-installed'].includes(options.scope)) {")
fragment=(work/'notes-installed-generic-phase.fragment.txt').read_text().replace('__INSTALLED_HELPER_PIN__',js(helper_pin)).replace('\n','\r\n')
generic=once(generic,'async function verifyArchiveInstalled() {',fragment+'\r\nasync function verifyArchiveInstalled() {')
generic=once(generic,'notesTodo = null, archiveInstalled = null;','notesTodo = null, notesInstalled = null, archiveInstalled = null;')
generic=once(generic,"  if (options.scope === 'notes-todo-experiment') notesTodo = verifyNotesTodoComposition();", "  if (options.scope === 'notes-todo-experiment') notesTodo = verifyNotesTodoComposition();\r\n  if (options.scope === 'notes-todo-installed') { notesTodo = await verifyNotesTodoInstalled(); notesInstalled = notesTodo; }")
generic=once(generic,"      if (notesTodo) { assert(summary.tests >= 23); verifyNotesTodoResults(notesTodo); }", "      if (notesTodo) { assert(summary.tests >= 23); if(notesInstalled)assert.equal(summary.tests,92,'Installed Notes must execute exactly92 groups in the fixed17-file roster'); verifyNotesTodoResults(notesTodo); }")
generic=once(generic,'\n  if (notesTodo) {', '\n  if (notesTodo && !notesInstalled) {')
generic=once(generic,"  record.status = receivedSignal ? 'interrupted'", "  if(notesInstalled){try{assert.deepEqual(visibleGitStatus(),[]);const proof=notesInstalled.module.verifyInstalledNotesReceipt(options.installedManifest,path.dirname(output));assert.deepEqual(proof.authentication,notesInstalled.authentication);assert.equal(readGit(['rev-parse','HEAD']).toString('utf8').trim(),record.repositoryCommit);assert.equal(record.repositoryCommit,process.env.GITHUB_SHA);record.notesInstalled.allCommittedSourcesStableAfter=true;if(!options.sourceOnly){record.notesLegacyObservation=preserveNotesLegacyObservation();if(!record.failures.length)assert.equal(record.notesLegacyObservation.present,true);}}catch(error){failure('Installed Notes source/evidence postcheck: '+error.message);}}\r\n  record.status = receivedSignal ? 'interrupted'")
generic_pin=put(generic_path,generic.encode())

browser_path='products/rea-studio/scripts/verify-cloud-browser.mjs'
browser_source=txt(browser_path)
browser_source=once(browser_source,"const explicitScope = args.length === 8, notesScope = explicitScope && args[5] === 'notes-todo-experiment';", "const explicitScope = args.length === 8, notesInstalledScope = explicitScope && args[5] === 'notes-todo-installed', notesScope = explicitScope && ['notes-todo-experiment','notes-todo-installed'].includes(args[5]);")
browser_source=once(browser_source,"['archive-aes-experiment', 'archive-aes-installed', 'notes-todo-experiment'].includes(args[5])", "['archive-aes-experiment', 'archive-aes-installed', 'notes-todo-experiment', 'notes-todo-installed'].includes(args[5])")
browser_source=once(browser_source,"archiveInstalledScope ? '--installed-manifest' : '--overlay-manifest'", "(archiveInstalledScope || notesInstalledScope) ? '--installed-manifest' : '--overlay-manifest'")
browser_source=once(browser_source,"(notesScope ? 'rea-cloud-notes-browser-postrun-source-check/v1' :", "(notesInstalledScope ? 'rea-cloud-Notes-installed-browser-postrun-source-check/v1' : notesScope ? 'rea-cloud-notes-browser-postrun-source-check/v1' :")
browser_source=once(browser_source,"  scope: notesScope ?", "  scope: notesInstalledScope ? 'Eight unchanged real Chromium Notes cases on clean committed32-file Notes sources and8 exact after pins. Requires full six-directory Git census, independent always Notes/browser postchecks, four actual response holds, two raw downloads, eight PNGs and eight complete cleanups. No source overlay, original full application/GUI, full-suite, security, parity or superiority acceptance; frozen README remains proposal-epoch documentation.' : notesScope ?")
fragment=(work/'notes-installed-browser-phase.fragment.txt').read_text().replace('__INSTALLED_HELPER_PIN__',js(helper_pin))
fragment=fragment.replace(' const proof=installed.verifyInstalledNotesReceipt(args[7],evidence);',' const proof=installed.verifyInstalledNotesReceipt(args[7],evidence);notesProof=proof;notesModule=installed;')
browser_source=once(browser_source,'async function verifyNotesBrowserPhase() {',fragment.replace('\n','\r\n')+'\r\nasync function verifyNotesBrowserPhase() {\r\n  if(notesInstalledScope)return verifyInstalledNotesBrowserPhase();')
browser_source=once(browser_source,"if (notesScope) { assert.deepEqual(notesModule.verifyNotesBrowserComposition(args[7]).receipt, notesProof.receipt);", "if(notesInstalledScope){assert.deepEqual(notesModule.verifyInstalledNotesReceipt(args[7],evidence).receipt,notesProof.receipt);record.sourceAuthentication=notesModule.authenticateInstalledNotesCensus(after,notesProof);} else if (notesScope) { assert.deepEqual(notesModule.verifyNotesBrowserComposition(args[7]).receipt, notesProof.receipt);")
browser_pin=put(browser_path,browser_source.encode())

prefix='products/rea-studio/results/notes-todo-source-transition-20261016/'
for name in ('notes-todo-cloud.yml','notes-todo-browser-cloud.yml'):
    p='.github/workflows/'+name
    old=raw(p)
    put(prefix+'workflow-before/'+name+'.snapshot',old)
    body=old.decode()
    start=body.index('  push:')
    end=body.index('permissions:',start)
    body=body[:start]+body[end:]
    put(p,body.encode())
put(prefix+'verifier-before/verify-cloud-browser.mjs.snapshot',raw(browser_path))
put(prefix+'phase12-authority.json.snapshot',phase12_bytes)
for name in ('verify-cloud-publication.mjs','publication-integrity-controls.mjs'):
    put(prefix+'verifier-before/phase12-'+name+'.snapshot',(previous/'candidate/scripts'/name).read_bytes())

# Extend the existing single envelope. The Notes proof keeps its own52 paths;
# these four exact tooling pins form a separately named4-source capture group.
producer_path='scripts/verify-cloud-publication.mjs'
producer=(previous/'candidate'/producer_path).read_bytes().decode()
