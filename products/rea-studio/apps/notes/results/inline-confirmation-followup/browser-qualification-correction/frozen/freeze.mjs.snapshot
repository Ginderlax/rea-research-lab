// Freeze completed source-only preparation outputs; do not execute preparation again.
import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const root=import.meta.dirname,hash=b=>createHash('sha256').update(b).digest('hex'),inventory={};async function walk(dir,rel=''){for(const e of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){assert.equal(e.isSymbolicLink(),false);const name=rel+e.name,p=path.join(dir,e.name);if(e.isDirectory())await walk(p,name+'/');else{assert.ok(e.isFile());assert.notEqual(name,'freeze-manifest.json');const b=await fs.readFile(p);inventory[name]={bytes:b.length,sha256:hash(b)};}}}await walk(root);const vb=await fs.readFile(path.join(root,'validation.json')),v=JSON.parse(vb);assert.equal(v.changedRows,12);assert.equal(v.soleChangedField,'qualification');assert.equal(v.allOtherMapFieldsUnchanged,true);const manifest={schema:'rea-notes-browser-qualification-correction-strict-freeze/v1',at:new Date().toISOString(),files:Object.keys(inventory).length,bytes:Object.values(inventory).reduce((n,r)=>n+r.bytes,0),inventory,selfExcluded:true,validationSHA256:hash(vb),sourceOnly:true,StudioWrites:0,independentAcceptance:false};const b=Buffer.from(JSON.stringify(manifest,null,2)+'\n');await fs.writeFile(path.join(root,'freeze-manifest.json'),b,{flag:'wx'});for(const[p,r]of Object.entries(inventory)){const b=await fs.readFile(path.join(root,p));assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);}console.log(JSON.stringify({files:manifest.files,bytes:manifest.bytes,manifestSHA256:hash(b),validationSHA256:hash(vb),overrideSHA256:inventory['qualification-overrides.json'].sha256,correctedMapSHA256:inventory['public-preservation-map.corrected.json'].sha256,soleChangedField:'qualification',changedRows:12,StudioWrites:0}));
