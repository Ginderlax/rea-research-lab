    {
      "id": "grafana.candidate.d21fd5e9cee4b5247a53",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Most cloud-hosted PostgreSQL services (Amazon RDS, Azure Database for PostgreSQL, Google Cloud SQL) require at minimum `require` mode. If you leave TLS/SSL Mode set to `disable`, the connection may be rejected by the server. Check your cloud provider's documentation for the recommended `sslmode` setting.",
      "headingPath": [
        "Configure the PostgreSQL data source",
        "PostgreSQL configuration options",
        "TLS/SSL mode reference"
      ],
      "source": {
