    {
      "id": "grafana.candidate.6c822aa5105dc750d654",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now filter dashboard annotations to apply annotations to all panels or selected panels, or use them to exclude selected panels.",
      "headingPath": [
        "What’s new in Grafana v10.0",
        "Dashboards and visualizations",
        "Annotation filtering"
      ],
      "source": {
