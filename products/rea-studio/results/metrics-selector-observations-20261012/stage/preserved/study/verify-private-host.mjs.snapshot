import fs from 'node:fs/promises';import path from 'node:path';import {pathToFileURL} from 'node:url';import assert from 'node:assert/strict';import {here,sha} from './authenticate-original.mjs';
const preservation=JSON.parse(await fs.readFile(path.join(here,'preservation.json'))),fixture=path.join(here,'.local/private-host-fixture');await fs.mkdir(fixture,{recursive:true});const copied=[];
for(const name of ['server.mjs','catalog.mjs','lib/storage.mjs','apps/metrics/server.mjs','apps/metrics/client.mjs','apps/metrics/core.mjs']){const row=preservation.production.find(item=>item.path===name),bytes=await fs.readFile(path.join(here,'preserved/production',name+'.snapshot'));assert.equal(sha(bytes),row.sha256);const target=path.join(fixture,name);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,bytes,{flag:'wx'});copied.push({path:name,sha256:sha(bytes)});}
for(const[source,name]of [['candidate-module-control.mjs','native-calculations.mjs'],['selector-control.mjs','selector-control.mjs']]){const bytes=await fs.readFile(path.join(here,source));await fs.writeFile(path.join(fixture,'apps/metrics',name),bytes,{flag:'wx'});copied.push({path:'apps/metrics/'+name,sha256:sha(bytes),prospectiveOnly:true});}
const host=await(await import(pathToFileURL(path.join(fixture,'server.mjs')).href)).start({port:0,dataDir:path.join(fixture,'owned-data')}),records=[];
try{
 for(const[route,status]of [['/apps/metrics/client.mjs',200],['/apps/metrics/core.mjs',200],['/apps/metrics/server.mjs',404],['/apps/metrics/native-calculations.mjs',404],['/apps/metrics/selector-control.mjs',404]]){const response=await fetch(host.url+route);assert.equal(response.status,status);const bytes=Buffer.from(await response.arrayBuffer());records.push({route,status:response.status,bytes:bytes.length,sha256:sha(bytes)});}
 const post=async(action,input)=>{const response=await fetch(host.url+'/api/metrics/'+action,{method:'POST',headers:{'content-type':'application/json','x-rea-token':host.token},body:JSON.stringify(input)});assert.equal(response.status,200);return(await response.json()).result;};
 const catalog=await post('native-calculations',{});assert.equal(catalog.contract,'@grafana/data@13.2.3/reduceField');assert.equal(catalog.calculations.length,124);
 const result=await post('native-reduce',{field:{type:'number',values:[3,1,2,null],config:{nullValueMode:'connected'}},reducers:['p95']});assert.deepEqual(result.result,{p95:3});assert.deepEqual(result.state,{calcs:{p95:3}});
 records.push({action:'native-calculations',count:catalog.calculations.length},{action:'native-reduce',result:result.result,state:result.state});
}finally{await host.close();}
for(const row of copied){const bytes=await fs.readFile(path.join(fixture,row.path));assert.equal(sha(bytes),row.sha256);}
const receipt={schemaVersion:1,checkedAt:new Date().toISOString(),status:'passed',copied,records,scope:'Private product-shaped ignored fixture uses exact production host/client/core/backend server snapshots, with only prospective candidate entry+helper file copies. Actual loopback HTTP confirms helper exists, remains404private, and backend metadata/reduction imports work. No production host/browser/store/module changed; not UI QA or integration.',hostSourceBeforeAndAfterStable:true,backendOnlyModuleRequiresNoBrowserStaticRoute:true,futureBrowserImportWouldRequireExplicitRouteReview:true,ownedHostClosed:true,timingMeasurementRun:false,memoryMeasurementRun:false,performanceEstablished:false};await fs.writeFile(path.join(here,'results/private-host-routing.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:'passed',routes:records.length,helperRemainsPrivate:true}));
