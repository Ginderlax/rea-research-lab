      "id": "grafana.candidate.d0ab2747070da8121469",
      "syntaxRole": "table-row",
      "sourceText": "| Symbol horizontal align | Configures the horizontal alignment of the symbol relative to the data point. Note that the symbol's rotation angle is applied first around the data point, then the horizontal alignment is applied relative to the rotation of the symbol. |",
      "headingPath": [
        "Geomap",
        "Configuration options",
        "Map layers options",
        "Markers layer"
      ],
      "source": {
