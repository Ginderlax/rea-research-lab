// Exact source-only override epoch. Frozen162+17 and all behavior epochs stay inert.
import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';import {applyQualificationOverrides,BASE_MAP_SHA256} from './qualification-override.mjs';
const root=import.meta.dirname,workspace=path.resolve(root,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),hash=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:hash(b)});async function save(p,b){await fs.mkdir(path.dirname(path.join(root,p)),{recursive:true});await fs.writeFile(path.join(root,p),b,{flag:'wx'});}const json=async(p,v)=>save(p,JSON.stringify(v,null,2)+'\n');
const oldRoot=path.join(workspace,'work/notes-inline-publication-plan-next'),proof=await fs.readFile(path.join(oldRoot,'notes-inline-provenance.mjs'));assert.equal(hash(proof),'b4862a18bbf62abff0dd444607dc8ec019db9c7e2e69631f390525e31ab538d1');const {EPOCHS,authenticateEpoch,readBounded}=await import('../notes-inline-publication-plan-next/notes-inline-provenance.mjs');
const prior={id:'prior-source-only-plan',directory:'notes-inline-publication-plan-next',manifest:'freeze-manifest.json',schema:'rea-notes-inline-publication-plan-freeze/v1',count:162,sha256:'ab0bccd1aaf43da7b932193a0991531659b2e5017b72c28933b37bcc7ddcf3ae'},addendum={id:'prior-browser-addendum',directory:'notes-inline-publication-plan-browser-next',manifest:'freeze-manifest.json',schema:'rea-notes-inline-browser-publication-addendum-freeze/v1',count:17,sha256:'697af388815ed18acacdfebf69dd58eb6ddb601c84722e0ba2185401afaa9aff'},browser={id:'corrected-browser',directory:'notes-inline-cancel-no-read-browser-next',manifest:'freeze-manifest.json',schema:'rea-notes-corrected-inline-browser-strict-freeze/v1',count:87,sha256:'402425b29671175caecf368661b21987205087d5fdef3025c06323f94029acfb'};
const epochs=[...EPOCHS,prior,addendum,browser],before=[];for(const e of epochs)before.push(await authenticateEpoch(workspace,e));assert.equal(before.reduce((n,e)=>n+e.payloadFiles,0),832);await json('authentication-before.json',{epochs:before,totalPayloads:832,totalManifests:7,fullClosedEpochsStrictlyAuthenticated:true});
const addRoot=path.join(workspace,'work',addendum.directory),browserRoot=path.join(workspace,'work',browser.directory),baseBytes=await readBounded(addRoot,'public-preservation-map.json');assert.equal(hash(baseBytes),BASE_MAP_SHA256);const base=JSON.parse(baseBytes);assert.equal(base.payload.length,818);const exclusionBytes=await readBounded(addRoot,'local-exclusions.json'),exclusion=JSON.parse(exclusionBytes);assert.equal(exclusion.excluded.length,11);const browserBytes=await readBounded(browserRoot,'validation.json');assert.equal(hash(browserBytes),'5d284a148316c6bac3a30999bf5fa8fe61f0c32e369e2430ab8238d083f1c8bc');const v=JSON.parse(browserBytes);assert.equal(v.finiteBrowserAcceptance,true);assert.equal(v.semanticGroups,8);assert.equal(v.clientSHA256,'90886819feef847847fcae8c442e0a401a1146a7a4aa1fd862a54b5e01f41da9');assert.equal(v.sourceFiles,12);assert.equal(v.sourceStable,true);assert.equal(v.browserCampaigns,1);assert.equal(v.attachment.browserUploadAcceptance,false);assert.equal(v.attachment.permissionChanged,false);assert.equal(v.attachment.downloadEventBridgeTimedOut,true);
for(const[p,from]of[['authority/prior-map.json.snapshot',baseBytes],['authority/prior-exclusions.json.snapshot',exclusionBytes],['authority/browser-validation.json.snapshot',browserBytes],['authority/browser-manifest.json.snapshot',await readBounded(browserRoot,'freeze-manifest.json')],['authority/addendum-manifest.json.snapshot',await readBounded(addRoot,'freeze-manifest.json')],['authority/prior-plan-manifest.json.snapshot',await readBounded(oldRoot,'freeze-manifest.json')],['authority/prior-proof-module.mjs.snapshot',proof]])await save(p,from);
const jpeg=base.payload.filter(r=>r.epoch==='corrected-browser'&&r.actualMediaType==='image/jpeg');assert.equal(jpeg.length,12);const qualification='Exact owned corrected-browser87 JPEG evidence from one finite eight-group Chrome campaign on corrected Notes client SHA-256 90886819feef847847fcae8c442e0a401a1146a7a4aa1fd862a54b5e01f41da9, bound to browser receipt 5d284a148316c6bac3a30999bf5fa8fe61f0c32e369e2430ab8238d083f1c8bc and87-file manifest402425b29671175caecf368661b21987205087d5fdef3025c06323f94029acfb. Preserve exact JPEG bytes and original .png name. Interpret each raster with paired AX/DOM and raw request/relay observations; final-saved may lag, and final-reopened-proof is the final inspected visible proof. Finite corrected-client evidence only: upload acceptance remains false, permissions unchanged and the download-event bridge timeout retained despite exact downloaded-byte verification. This is distinct from historical author214 evidence and adds no new browser execution or whole-product parity.';
const rows=[];for(const r of jpeg){assert.equal(r.sourceRoot,'work/notes-inline-cancel-no-read-browser-next');assert.equal(r.originalFilenameExtensionMismatch,true);assert.equal(r.qualification,'Historical exact author214 browser evidence only; not corrected-client browser acceptance. Preserve exact bytes and original filename even when its suffix mislabels JPEG.');const bytes=await readBounded(path.join(workspace,r.sourceRoot),r.sourcePath,r);assert.equal(bytes.subarray(0,3).toString('hex'),'ffd8ff');rows.push({epoch:r.epoch,sourceRoot:r.sourceRoot,sourcePath:r.sourcePath,publicPath:r.publicPath,bytes:r.bytes,sha256:r.sha256,changedField:'qualification',originalWrongQualification:r.qualification,before:r,after:{...r,qualification}});}
const override={schema:'rea-notes-corrected-browser-qualification-overrides/v1',baseMap:{sourceRoot:'work/'+addendum.directory,path:'public-preservation-map.json',...id(baseBytes)},authority:{correctedClientSHA256:v.clientSHA256,browserReceipt:{path:'work/'+browser.directory+'/validation.json',...id(browserBytes)},browserManifest:{path:'work/'+browser.directory+'/freeze-manifest.json',...id(await readBounded(browserRoot,'freeze-manifest.json'))},semanticGroups:8,sourceFiles:12,actualBrowserCampaigns:1},rows,overriddenRows:12,soleChangedField:'qualification',payloadBytesPathsAndMediaFieldsUnchanged:true,earlierHistoricalQualificationsUnchanged:true,applicationChanges:0,newBrowserExecutions:0};await json('qualification-overrides.json',override);const corrected=applyQualificationOverrides(baseBytes,override);await json('public-preservation-map.corrected.json',corrected);await json('raw-correction-observations.json',{priorMap:id(baseBytes),correctedMap:id(await fs.readFile(path.join(root,'public-preservation-map.corrected.json'))),changedRows:rows.map(r=>({epoch:r.epoch,sourcePath:r.sourcePath,publicPath:r.publicPath,byteIdentity:{bytes:r.bytes,sha256:r.sha256},beforeQualification:r.before.qualification,afterQualification:r.after.qualification,otherFieldsExact:true})),unchangedRows:806,allTopLevelFieldsExact:true,publicRecords:818,localExclusions:11,publicCopiesPerformed:0});
const installed=JSON.parse(await readBounded(oldRoot,'installation-before34.json'));assert.equal(installed.length,34);for(const r of installed)await readBounded(repo,r.path,r);const requirements=JSON.parse(await readBounded(oldRoot,'requirements-identity-reference.json'));for(const r of requirements.registries)await readBounded(repo,r.path,r);await json('current-before-image-bindings.json',{installed34:installed,requirementsUnchangedReference:requirements,installationChanges:0,oldClientC57StillCurrent:true,correctedClient908NotInstalledByThisStage:true});const all=[...base.payload,...exclusion.excluded];assert.equal(all.length,829);for(const r of all)await readBounded(path.join(workspace,r.sourceRoot),r.sourcePath,r);await json('all829-source-map-records-authenticated.json',{rows:all.map(r=>({epoch:r.epoch,sourceRoot:r.sourceRoot,sourcePath:r.sourcePath,publicPath:r.publicPath??null,bytes:r.bytes,sha256:r.sha256,publishable:r.publishable})),publicRecords:818,excludedRecords:11,allAuthenticated:true});
const negatives=[];for(const[name,edit]of[['wrong-base-map',()=>applyQualificationOverrides(Buffer.concat([baseBytes,Buffer.from(' ')]),override)],['duplicate-row',()=>applyQualificationOverrides(baseBytes,{...override,rows:[...override.rows.slice(0,11),override.rows[0]]})],['changed-byte-hash',()=>applyQualificationOverrides(baseBytes,{...override,rows:override.rows.map((r,i)=>i? r:{...r,after:{...r.after,sha256:'0'.repeat(64)}})})],['missing-override',()=>applyQualificationOverrides(baseBytes,{...override,rows:override.rows.slice(0,11)})]]){let rejected=false;try{edit();}catch(e){rejected=true;negatives.push({name,rejected,error:{name:e.name,message:e.message}});}assert.ok(rejected);}await json('source-only-override-guards.json',{negativeGuards:negatives,counts:4,newProductTests:0,newOriginalExecutions:0,newBrowserExecutions:0});
const after=[];for(const e of epochs)after.push(await authenticateEpoch(workspace,e));assert.deepEqual(after,before);for(const r of installed)await readBounded(repo,r.path,r);for(const r of requirements.registries)await readBounded(repo,r.path,r);assert.deepEqual(await readBounded(addRoot,'public-preservation-map.json'),baseBytes);assert.deepEqual(await readBounded(addRoot,'local-exclusions.json'),exclusionBytes);await json('authentication-after.json',{epochs832PayloadsAndSevenManifestsExact:true,map829SourceRecordsExact:true,old162And17Unmodified:true,browser87Unmodified:true,currentInstalled34Exact:true,requirements159SHAAnd232IdsReferencedUnchanged:true,oldMapSHA256:BASE_MAP_SHA256,localExclusionsUnchanged:true,StudioWrites:0});await json('validation.json',{schema:'rea-notes-browser-qualification-correction-validation/v1',at:new Date().toISOString(),sourceOnly:true,priorMap:{...id(baseBytes),sourceRoot:'work/'+addendum.directory,path:'public-preservation-map.json'},override:{path:'qualification-overrides.json',...id(await fs.readFile(path.join(root,'qualification-overrides.json')))},correctedMap:{path:'public-preservation-map.corrected.json',...id(await fs.readFile(path.join(root,'public-preservation-map.corrected.json')))},changedRows:12,unchangedPublicRows:806,publicRecords:818,excludedRecords:11,all829ByteIdentitiesAuthenticated:true,closedEpochPayloads832ExactBeforeAfter:true,soleChangedField:'qualification',allOtherMapFieldsUnchanged:true,wrongQualificationRetainedExactly:true,current34BeforeImagesUnchanged:true,requirements159SHAAnd232IdsUnchanged:true,backendChanges:0,appChanges:0,publicWrites:0,tests:0,originalExecutions:0,GUIExecutions:0,benchmarks:0,productAcceptanceExpanded:false,independentMetadataCorrectionAccepted:false,sourceOnlyNegativeGuards:4,uploadAccepted:false,permissionChanges:false,downloadEventTimeoutRetained:true});console.log(JSON.stringify({changedQualifications:12,unchangedPublicRows:806,publicRecords:818,excluded:11,sourcePathRecordsAuthenticated:829,closedEpochPayloads:832,StudioWrites:0,tests:0,GUI:0,override:id(await fs.readFile(path.join(root,'qualification-overrides.json'))),correctedMap:id(await fs.readFile(path.join(root,'public-preservation-map.corrected.json')))}));
