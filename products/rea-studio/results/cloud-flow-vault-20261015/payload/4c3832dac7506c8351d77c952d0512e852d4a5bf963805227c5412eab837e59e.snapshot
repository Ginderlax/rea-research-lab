import test from 'node:test';
import assert from 'node:assert/strict';
import {createServer} from 'node:http';
import {mkdtemp,rm} from 'node:fs/promises';
import {tmpdir} from 'node:os';
import {join,resolve,relative,isAbsolute} from 'node:path';
import {once} from 'node:events';
import {start} from '../../server.mjs';
import {createStore} from '../../lib/storage.mjs';
import {createExecution,executeNode,preflight,LIMITS} from './native.mjs';
import {handleNative,disposeNative} from './native-server.mjs';

const node=(type,name,parameters={})=>({id:name,name,type:`n8n-nodes-base.${type}`,typeVersion:{manualTrigger:1,set:3.4,if:2.3,httpRequest:4.4,wait:1.1}[type],position:[0,0],parameters});
function workflow(nodes){const all=[node('manualTrigger','Manual'),...nodes];return{name:'Synthetic native workflow',nodes:all,connections:Object.fromEntries(all.slice(0,-1).map((value,index)=>[value.name,{main:[[{node:all[index+1].name,type:'main',index:0}]]}])),settings:{executionOrder:'v1'},meta:{preserve:'Unicode café 😀'}};}
const set=(name='Set')=>node('set',name,{assignments:{assignments:[{name:'finished',value:true,type:'boolean'}]},includeOtherFields:true});
async function fixture(t){
 const folder=await mkdtemp(join(tmpdir(),'rea-native-automation-')),hosts=[];
 async function open(){const host=await start({port:0,dataDir:folder});hosts.push(host);return{...host,async api(action,input={}){const response=await fetch(`${host.url}/api/automation/${action}`,{method:'POST',headers:{'content-type':'application/json','x-rea-token':host.token},body:JSON.stringify(input)});const result=await response.json();if(!response.ok)throw new Error(result.error??`HTTP ${response.status}`);return result.result;}};}
 t.after(async()=>{await Promise.allSettled(hosts.map(host=>host.close()));const absolute=resolve(folder),root=resolve(tmpdir()),rel=relative(root,absolute);assert.ok(rel&&!isAbsolute(rel)&&!rel.startsWith('..')&&rel.startsWith('rea-native-automation-'));await rm(absolute,{recursive:true,force:true});});
 return{folder,open,store:await createStore(join(folder,'automation','records'))};
}
async function endpoint(t){const seen=[],timers=new Set();const server=createServer((req,res)=>{seen.push(req.url);const send=()=>{res.writeHead(req.url==='/failure'?422:200,{'content-type':'application/json','set-cookie':'synthetic-private-cookie'});res.end(JSON.stringify({value:9,token:'synthetic-private-token'}));};if(req.url==='/slow'){const timer=setTimeout(()=>{timers.delete(timer);send();},200);timers.add(timer);}else send();});server.listen(0,'127.0.0.1');await once(server,'listening');t.after(()=>new Promise(done=>{for(const timer of timers)clearTimeout(timer);server.closeAllConnections();server.close(done);}));return{url:`http://127.0.0.1:${server.address().port}`,seen};}
async function terminal(api,id,runId){for(let count=0;count<200;count++){const{run}=await api('native-status',{id,runId});if(!['ready','running','waiting'].includes(run.status))return run;await new Promise(done=>setTimeout(done,5));}throw new Error('Synthetic native execution did not finish');}
function controlledStore(t){
 const values=new Map(),workspace={},gates=[];let armed;
 const capture=(value)=>structuredClone(value),store={async get(key,fallback=null){const value=capture(values.has(key)?values.get(key):fallback);if(armed?.kind==='get'&&armed.matches(key,value)){const gate=armed;armed=null;gate.enter();await gate.promise;}return value;},async set(key,value){const saved=capture(value);if(armed?.kind==='set'&&armed.matches(key,saved)){const gate=armed;armed=null;gate.enter();await gate.promise;}values.set(key,saved);}},api=(action,input)=>handleNative({action,input,store,workspace});
 function hold(kind,matches){assert.equal(armed,undefined);let enter,release;const entered=new Promise(done=>enter=done),promise=new Promise(done=>release=done);const gate={kind,matches,enter,release,entered,promise};armed=gate;gates.push(gate);return gate;}
 t.after(async()=>{for(const gate of gates)gate.release();await disposeNative(workspace);});return{values,store,workspace,api,hold};
}
const turn=()=>new Promise(done=>setImmediate(done));

test('native app HTTP saves exact imported metadata and revisions across restart and refuses stale edits',async t=>{
 const f=await fixture(t),first=await f.open(),document=workflow([set()]);document.nodes.push({...node('future','Unconnected'),typeVersion:99,parameters:{vendorOption:{keep:[1,2]}}});
 const{record}=await first.api('native-save',{workflow:document});assert.deepEqual(record.workflow,document);assert.equal(record.revision,1);await first.close();const second=await f.open();const loaded=await second.api('native-get',{id:record.id});assert.deepEqual(loaded.record,record);assert.equal(loaded.preflight.executable,true);
 const changed=structuredClone(document);changed.name='Changed';const updated=await second.api('native-save',{id:record.id,expectedRevision:1,workflow:changed});assert.equal(updated.record.revision,2);await assert.rejects(second.api('native-save',{id:record.id,expectedRevision:1,workflow:document}),/revision changed/);const{run}=await second.api('native-run',{id:record.id});assert.equal(run.status,'completed');assert.equal(run.revision,2);assert.equal(run.outputs.Set[0][0].json.finished,true);
});
test('native Wait persists real continuation, resumes after restart API bootstrap, and performs its downstream HTTP effect once',async t=>{
 const f=await fixture(t),remote=await endpoint(t),first=await f.open(),document=workflow([node('wait','Wait',{resume:'timeInterval',amount:0.15,unit:'seconds'}),node('httpRequest','HTTP',{url:remote.url,options:{timeout:1000}}),set()]);
 const{record}=await first.api('native-save',{workflow:document}),{run}=await first.api('native-run',{id:record.id});assert.equal(run.status,'waiting');assert.equal(remote.seen.length,0);await first.close();await new Promise(done=>setTimeout(done,180));assert.equal(remote.seen.length,0);const second=await f.open();await second.api('native-list');const finished=await terminal(second.api,record.id,run.id);assert.equal(finished.status,'completed');assert.equal(remote.seen.length,1);assert.equal(finished.outputs.Set[0][0].json.finished,true);assert.equal(finished.outputs.HTTP[0][0].json.token,'[redacted]');const history=await second.api('native-history',{id:record.id});assert.equal(history.runs.length,1);assert.equal(history.runs[0].status,'completed');assert.doesNotMatch(JSON.stringify(history),/synthetic-private-cookie|synthetic-private-token/);
});
test('native durable wait cancellation persists and prevents later effects, including restart',async t=>{
 const f=await fixture(t),remote=await endpoint(t),host=await f.open(),document=workflow([node('wait','Wait',{resume:'timeInterval',amount:0.05,unit:'seconds'}),node('httpRequest','HTTP',{url:remote.url,options:{timeout:1000}})]);const{record}=await host.api('native-save',{workflow:document}),{run}=await host.api('native-run',{id:record.id});const cancelled=await host.api('native-cancel',{id:record.id,runId:run.id});assert.equal(cancelled.run.status,'cancelled');await host.close();const restarted=await f.open();await restarted.api('native-list');await new Promise(done=>setTimeout(done,80));assert.equal(remote.seen.length,0);assert.equal((await restarted.api('native-status',{id:record.id,runId:run.id})).run.status,'cancelled');
});
test('native active HTTP cancellation and host shutdown record distinct failure traces without automatic replay',async t=>{
 const f=await fixture(t),remote=await endpoint(t),host=await f.open(),document=workflow([node('httpRequest','HTTP',{url:`${remote.url}/slow`,options:{timeout:1000}})]);const{record}=await host.api('native-save',{workflow:document});
 const started=await host.api('native-start',{id:record.id});for(let count=0;remote.seen.length<1&&count<100;count++)await new Promise(done=>setTimeout(done,2));const cancelled=await host.api('native-cancel',{id:record.id,runId:started.run.id});assert.equal(cancelled.run.status,'cancelled');assert.equal(cancelled.run.error.code,'NATIVE_CANCELLED');assert.equal(cancelled.run.trace.at(-1).status,'cancelled');
 const another=await host.api('native-start',{id:record.id});for(let count=0;remote.seen.length<2&&count<100;count++)await new Promise(done=>setTimeout(done,2));await host.close();const restarted=await f.open();await restarted.api('native-list');const interrupted=(await restarted.api('native-status',{id:record.id,runId:another.run.id})).run;assert.equal(interrupted.status,'interrupted');assert.equal(interrupted.error.code,'NATIVE_INTERRUPTED');assert.equal(remote.seen.length,2);
});
test('native failed HTTP status records node/code trace; known unsupported downstream config preflights before requests',async t=>{
 const f=await fixture(t),remote=await endpoint(t),host=await f.open(),http=node('httpRequest','HTTP',{url:`${remote.url}/failure`,options:{timeout:1000}});const{record}=await host.api('native-save',{workflow:workflow([http])});const{run}=await host.api('native-run',{id:record.id});assert.equal(run.status,'failed');assert.equal(run.error.code,'NATIVE_HTTP_STATUS');assert.equal(run.error.node,'HTTP');assert.equal(run.trace.at(-1).status,'failed');
 for(const bad of [node('set','Bad',{mode:'raw',jsonOutput:'{"__proto__.polluted":true}'}),node('httpRequest','Bad',{url:remote.url,sendHeaders:true,headerParameters:{parameters:[{name:'Authorization',value:'synthetic'}]},options:{timeout:1000}})]){const{record:invalid}=await host.api('native-save',{workflow:workflow([http,bad])});const before=remote.seen.length;await assert.rejects(host.api('native-run',{id:invalid.id}),/Unsafe|Credential|Unsafe or/);assert.equal(remote.seen.length,before);}
});
test('native restart rejects malformed durable continuation before any downstream effects',async t=>{
 const f=await fixture(t),remote=await endpoint(t),document=workflow([node('httpRequest','HTTP',{url:remote.url,options:{timeout:1000}})]),run={...createExecution(document),workflowId:'synthetic',revision:1,status:'waiting',waitUntil:new Date().toISOString(),pending:[{node:'Missing',items:[{json:{}}]}]};await f.store.set('automation.native.jobs',[run.id]);await f.store.set(`automation.native.run.${run.id}`,run);const host=await f.open();await assert.rejects(host.api('native-list'),/Invalid persisted invocation/);assert.equal(remote.seen.length,0);
});
test('native item/request/array/aggregate preparation bounds reject without issuing partial HTTP effects',async t=>{
 const remote=await endpoint(t),http=node('httpRequest','HTTP',{url:remote.url,options:{timeout:1000}});await assert.rejects(executeNode(http,Array.from({length:501},()=>({json:{}}))),/500 HTTP/);assert.equal(remote.seen.length,0);const setNode=node('set','Set',{assignments:{assignments:[{name:'value',type:'string',value:'x'.repeat(1024*1024-200)}]}});await assert.rejects(executeNode(setNode,Array.from({length:10},()=>({json:{}}))),/execution byte limit/);for(const name of ['a["60000"]','a[10000]'])assert.equal(preflight(workflow([node('set','Set',{assignments:{assignments:[{name,type:'number',value:1}]}})])).executable,false);assert.equal(LIMITS.items,10000);
});
test('native public actions capture caller input before awaits and returned records cannot mutate shared MemoryStore state',async t=>{
 const values=new Map(),store={async get(key,fallback=null){return values.has(key)?values.get(key):fallback;},async set(key,value){values.set(key,value);}},workspace={synthetic:true},api=(action,input)=>handleNative({action,input,store,workspace});t.after(()=>disposeNative(workspace));
 const document=workflow([set()]),expected=structuredClone(document),pending=api('native-save',{workflow:document});document.name='Mutated caller name';document.nodes[1].parameters.assignments.assignments[0].value=false;const{record}=await pending;assert.deepEqual(record.workflow,expected);record.workflow.nodes[1].parameters.assignments.assignments[0].value=false;const first=await api('native-get',{id:record.id});assert.equal(first.record.workflow.nodes[1].parameters.assignments.assignments[0].value,true);first.record.workflow.nodes[1].parameters.assignments.assignments[0].value=false;const{run}=await api('native-run',{id:record.id});assert.equal(run.outputs.Set[0][0].json.finished,true);const history=await api('native-history',{id:record.id});history.runs[0].status='Caller-mutated';assert.equal((await api('native-history',{id:record.id})).runs[0].status,'completed');
});
test('host serves only native public editor/example modules while execution and oracle modules remain private',async t=>{
 const f=await fixture(t),host=await f.open();for(const file of ['native-client.mjs','native-example.mjs']){const response=await fetch(`${host.url}/apps/automation/${file}`);assert.equal(response.status,200,file);assert.match(response.headers.get('content-type'),/javascript/);assert.ok((await response.text()).length>100);}for(const file of ['native-server.mjs','native.mjs','original-harness.mjs','compare-original.mjs']){const response=await fetch(`${host.url}/apps/automation/${file}`);assert.equal(response.status,404,file);}
});
test('native caps concurrent running/waiting continuations at sixteen and cancellation releases capacity',async t=>{
 const map=new Map(),workspace={},store={async get(key,fallback=null){return structuredClone(map.has(key)?map.get(key):fallback);},async set(key,value){map.set(key,structuredClone(value));}},api=(action,input)=>handleNative({action,input,store,workspace});t.after(()=>disposeNative(workspace));const{record}=await api('native-save',{workflow:workflow([node('wait','Wait',{resume:'timeInterval',amount:60,unit:'seconds'})])}),runs=[];
 for(let count=0;count<16;count++)runs.push((await api('native-run',{id:record.id})).run);await assert.rejects(api('native-run',{id:record.id}),/concurrent execution count exceeds 16/);assert.equal(map.get('automation.native.jobs').length,16);await api('native-cancel',{id:record.id,runId:runs[0].id});assert.equal((await api('native-run',{id:record.id})).run.status,'waiting');
});
test('native restart classifies a ready checkpoint as interrupted and does not initiate its HTTP request',async t=>{
 const f=await fixture(t),remote=await endpoint(t),run={...createExecution(workflow([node('httpRequest','HTTP',{url:remote.url,options:{timeout:1000}})])),workflowId:'synthetic',revision:1};await f.store.set('automation.native.jobs',[run.id]);await f.store.set(`automation.native.run.${run.id}`,run);const host=await f.open();await host.api('native-list');const result=(await host.api('native-status',{id:'synthetic',runId:run.id})).run;assert.equal(result.status,'interrupted');assert.equal(remote.seen.length,0);
});
test('native cancellation during held Wait persistence survives a due timer, repeated cancellation and history reads', {timeout:5000},async t=>{
 const f=controlledStore(t),remote=await endpoint(t),{record}=await f.api('native-save',{workflow:workflow([node('wait','Wait',{resume:'timeInterval',amount:0.01,unit:'seconds'}),node('httpRequest','HTTP',{url:remote.url,options:{timeout:1000}})])}),gate=f.hold('set',(key,value)=>key.startsWith('automation.native.run.')&&value.status==='waiting'),{run}=await f.api('native-start',{id:record.id});await gate.entered;
 await assert.rejects(f.api('native-cancel',{id:'wrong-workflow',runId:run.id}),/not found/);const first=f.api('native-cancel',{id:record.id,runId:run.id}),second=f.api('native-cancel',{id:record.id,runId:run.id}),earlyHistory=f.api('native-history',{id:record.id});await new Promise(done=>setTimeout(done,25));assert.equal(remote.seen.length,0);gate.release();assert.equal((await first).run.status,'cancelled');assert.equal((await second).run.status,'cancelled');await earlyHistory;
 await new Promise(done=>setTimeout(done,20));assert.equal(remote.seen.length,0);assert.equal((await f.api('native-history',{id:record.id})).runs[0].status,'cancelled');await disposeNative(f.workspace);await f.api('native-list');assert.equal((await f.api('native-status',{id:record.id,runId:run.id})).run.status,'cancelled');assert.equal(remote.seen.length,0);
});
test('native timer stale read cannot resume an execution across queued cancellation', {timeout:5000},async t=>{
 const f=controlledStore(t),remote=await endpoint(t),{record}=await f.api('native-save',{workflow:workflow([node('wait','Wait',{resume:'timeInterval',amount:0.03,unit:'seconds'}),node('httpRequest','HTTP',{url:remote.url,options:{timeout:1000}})])}),{run}=await f.api('native-run',{id:record.id}),gate=f.hold('get',(key,value)=>key===`automation.native.run.${run.id}`&&value.status==='waiting');await gate.entered;const pending=f.api('native-cancel',{id:record.id,runId:run.id});await turn();gate.release();assert.equal((await pending).run.status,'cancelled');await turn();assert.equal(remote.seen.length,0);assert.equal((await f.api('native-history',{id:record.id})).runs[0].status,'cancelled');
});
test('native status stale read and cancellation serialize before a resumed node can issue HTTP', {timeout:5000},async t=>{
 const f=controlledStore(t),remote=await endpoint(t),{record}=await f.api('native-save',{workflow:workflow([node('wait','Wait',{resume:'timeInterval',amount:60,unit:'seconds'}),node('httpRequest','HTTP',{url:remote.url,options:{timeout:1000}})])}),{run}=await f.api('native-run',{id:record.id});f.values.get(`automation.native.run.${run.id}`).waitUntil=new Date(Date.now()-1).toISOString();const gate=f.hold('get',(key)=>key===`automation.native.run.${run.id}`),status=f.api('native-status',{id:record.id,runId:run.id});await gate.entered;const pending=f.api('native-cancel',{id:record.id,runId:run.id});await turn();gate.release();await status;assert.equal((await pending).run.status,'cancelled');assert.equal(remote.seen.length,0);assert.equal((await f.api('native-status',{id:record.id,runId:run.id})).run.status,'cancelled');
});
test('native cancellation held in durable read prevents a due timer from beginning a new active request', {timeout:5000},async t=>{
 const f=controlledStore(t),remote=await endpoint(t),{record}=await f.api('native-save',{workflow:workflow([node('wait','Wait',{resume:'timeInterval',amount:0.03,unit:'seconds'}),node('httpRequest','HTTP',{url:remote.url,options:{timeout:1000}})])}),{run}=await f.api('native-run',{id:record.id}),gate=f.hold('get',(key)=>key===`automation.native.run.${run.id}`),pending=f.api('native-cancel',{id:record.id,runId:run.id});await gate.entered;await new Promise(done=>setTimeout(done,60));assert.equal(remote.seen.length,0);gate.release();assert.equal((await pending).run.status,'cancelled');await turn();assert.equal(remote.seen.length,0);
});
test('native dispose during held Wait persistence leaves one resumable continuation or preserves requested cancellation', {timeout:5000},async t=>{
 const remote=await endpoint(t);
 for(const cancelRequested of [false,true]){const f=controlledStore(t),{record}=await f.api('native-save',{workflow:workflow([node('wait','Wait',{resume:'timeInterval',amount:0,unit:'seconds'}),node('httpRequest','HTTP',{url:remote.url,options:{timeout:1000}})])}),gate=f.hold('set',(key,value)=>key.startsWith('automation.native.run.')&&value.status==='waiting'),{run}=await f.api('native-start',{id:record.id});await gate.entered;const before=remote.seen.length,pending=cancelRequested?f.api('native-cancel',{id:record.id,runId:run.id}):null;await turn();const shutdown=disposeNative(f.workspace);await turn();gate.release();if(pending)assert.equal((await pending).run.status,'cancelled');await shutdown;assert.equal(remote.seen.length,before);await f.api('native-list');const ended=await terminal(f.api,record.id,run.id);assert.equal(ended.status,cancelRequested?'cancelled':'completed');assert.equal(remote.seen.length,before+(cancelRequested?0:1));assert.equal((await f.api('native-history',{id:record.id})).runs[0].status,ended.status);await disposeNative(f.workspace);}
});
test('native final history read waits for held terminal history publication and shutdown drains it', {timeout:5000},async t=>{
 const f=controlledStore(t),{record}=await f.api('native-save',{workflow:workflow([set()])}),gate=f.hold('set',(key,value)=>key===`automation.native.history.${record.id}`&&value.at(-1).status==='completed'),{run}=await f.api('native-start',{id:record.id});await gate.entered;assert.equal((await f.api('native-status',{id:record.id,runId:run.id})).run.status,'completed');let returned=false;const history=f.api('native-history',{id:record.id}).then(value=>{returned=true;return value;}),cancellation=f.api('native-cancel',{id:record.id,runId:run.id});await turn();assert.equal(returned,false);const shutdown=disposeNative(f.workspace);await turn();assert.equal(returned,false);gate.release();assert.equal((await history).runs[0].status,'completed');assert.equal((await cancellation).run.status,'completed');await shutdown;await f.api('native-list');assert.equal((await f.api('native-status',{id:record.id,runId:run.id})).run.status,'completed');
});
test('native queued start cannot execute after disposal while its initial durable write is held', {timeout:5000},async t=>{
 const f=controlledStore(t),remote=await endpoint(t),{record}=await f.api('native-save',{workflow:workflow([node('httpRequest','HTTP',{url:remote.url,options:{timeout:1000}})])}),gate=f.hold('set',(key,value)=>key.startsWith('automation.native.run.')&&value.status==='ready'),pending=f.api('native-start',{id:record.id});await gate.entered;const rejected=assert.rejects(pending,/session is closed/),shutdown=disposeNative(f.workspace);await turn();gate.release();await rejected;await shutdown;assert.equal(remote.seen.length,0);await f.api('native-list');const [runId]=f.values.get('automation.native.jobs');assert.equal((await f.api('native-status',{id:record.id,runId})).run.status,'interrupted');assert.equal(remote.seen.length,0);
});
test('native rejected queued requests do not poison shutdown or cancel a different workflow continuation', {timeout:5000},async t=>{
 const f=controlledStore(t),remote=await endpoint(t),{record}=await f.api('native-save',{workflow:workflow([node('wait','Wait',{resume:'timeInterval',amount:60,unit:'seconds'}),node('httpRequest','HTTP',{url:remote.url,options:{timeout:1000}})])}),{run}=await f.api('native-run',{id:record.id});await assert.rejects(f.api('native-cancel',{id:'wrong-workflow',runId:run.id}),/not found/);assert.equal((await f.api('native-status',{id:record.id,runId:run.id})).run.status,'waiting');await assert.rejects(f.api('native-save',{id:record.id,expectedRevision:0,workflow:record.workflow}),/revision changed/);await assert.doesNotReject(disposeNative(f.workspace));assert.equal(remote.seen.length,0);f.values.get(`automation.native.run.${run.id}`).waitUntil=new Date(Date.now()-1).toISOString();await f.api('native-list');assert.equal((await terminal(f.api,record.id,run.id)).status,'completed');assert.equal(remote.seen.length,1);
});
