  if line.startswith('# {'):
   try:observations.append(json.loads(line[2:]))
   except json.JSONDecodeError:pass
 def one(key):
  values=[r[key]for r in observations if key in r];assert len(values)==1;return values[0]
 old=one('notesTodoOriginalComparisons');parent=one('notesNewTodoOriginalHelperComparisons');command=one('notesNewTodoOriginalCommandComparisons');delivery=one('notesTodoActualHttpModuleDelivery')
 assert old['sourceSha256']==bundle['historicalOriginalDependencies'][0]['sha256']and old['conversionComparisons']==16 and old['completionComparisons']==4 and old['clock']==1790000000123
 assert parent['comparisons']==4 and parent['comparedFields']==['parent_id','is_todo']and parent['fieldsAdapter']==['parent_id','is_todo','adapterSentinel']and parent['dueAndCompletionZerosAreCandidateOnlyChecks']is True
 assert parent['sourcePins']=={'note':[45302,'5f1a200dc970179ad6fd193f7ffc47f09f88261cff8f893ccc793517ebbe9647'],'base':[26960,'c0a19f6d2d689cc75de99e4ba57058ec02f9171c5b5b3c739aa45d11d5920fde']}
 assert [[r['owner'],r['name']]for r in parent['bindings']]==[['BaseModel','new'],['Note','new'],['Note','newTodo']]
 assert parent['sourceCommit']==command['sourceCommit']=='7e2765a3857754d12dbadea442b60ceaf9d4b23d'and command['comparisons']==2 and command['comparedArguments']==['body','isTodo']and command['delegatedCommand']=='newNote'and command['actualNewNoteCommandExecuted']is False and command['originalProvisionalSaveExecuted']is False
 for row in(parent,command):
  assert row['countsAddedToTestGroups']is False
  for k in('originalDatabaseExecutions','originalGuiExecutions','originalFullApplicationExecutions'):assert row[k]==0
 for k in('originalFullApplicationExecutions','originalDatabaseExecutions','originalGuiSessions'):assert old[k]==0
 assert delivery['unchangedPublicModuleBoundary']is True and delivery['actualBrowserExecution']is False and delivery['client']==identity(content('active-source/apps/notes/client.mjs.snapshot'))
 assert[r['path']for r in delivery['delivered']]==['/apps/notes/markdown.mjs','/apps/notes/core.mjs']
 for row in delivery['delivered']:assert pin(row)==identity(content('active-source'+row['path']+'.snapshot'))
 stored=load('notes36-finite-observations.json');assert stored==attempt['finite']and stored['summary']==summary and stored['execution']==execution and stored['sourceCommit']==HEAD and stored['fixedFiles']==bundle['fixedTests']and stored['oldNamedGroupsObserved']==23 and stored['newNamedGroupsObserved']==19 and stored['separateComparisonCounts']==bundle['separateComparisonCounts']
 assert stored['existingOriginalHelper']==old and stored['newParentAndTypeOriginalHelpers']==parent and stored['newDesktopCommandArguments']==command and stored['actualHttpModuleDelivery']==delivery
 return {'fixedFiles':21,'passedGroups':111,'oldNames':23,'newNames':19,'separateOriginalComparisons':bundle['separateComparisonCounts'],'actualHTTPModuleDelivery':True,'stderrBytes':len(content('finite-stderr.txt'))}
