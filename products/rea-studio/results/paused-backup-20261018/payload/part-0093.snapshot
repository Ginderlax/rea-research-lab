nonSource=sorted(set(filetable)-set(expected));assert nonSource==sorted(['source-before.json','source-after.json','diagnostic-attempt.json','workflow-attempt.json','stdout.txt','stderr.txt',*[row['path']for row in report['qualifiedNativeObservations']]])
