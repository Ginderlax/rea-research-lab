import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import fs from 'node:fs/promises';
import path from 'node:path';
const work=import.meta.dirname,source=path.join(work,'metrics-algorithm-measured-independent-audit'),target=path.resolve(work,'../outputs/rea-research-lab/products/rea-studio/results/metrics-algorithm-independent-audit-20261012'),sha=b=>createHash('sha256').update(b).digest('hex');
await fs.mkdir(target,{recursive:true});const snapshots=[];
for(const n of (await fs.readdir(source)).sort()){const b=await fs.readFile(path.join(source,n)),p=n+'.snapshot';await fs.writeFile(path.join(target,p),b,{flag:'wx'});snapshots.push({sourcePath:n,path:p,bytes:b.length,sha256:sha(b)});}
assert.equal(snapshots.length,6);assert.equal(snapshots.find(e=>e.sourcePath==='audit-validation.json').sha256,'3b8150485117fb9018fc6a4d8c7ad68f0dfa0f07f1fa659c1edd6067a358c7f2');
const attemptSource=await fs.readFile(path.join(work,'preserve-packs-notebooks-history-suite.mjs'));
await fs.writeFile(path.join(target,'initial-parent-preserver.mjs.snapshot'),attemptSource,{flag:'wx'});snapshots.push({sourcePath:'../preserve-packs-notebooks-history-suite.mjs',path:'initial-parent-preserver.mjs.snapshot',bytes:attemptSource.length,sha256:sha(attemptSource)});
const notice=Buffer.from('The suite preservation completed before the parent script failed with ENOENT for the audit file freeze-manifest.json. The actual frozen audit file is freeze.json. This is a parent preservation path error, not an audit, behavior or measurement failure. Tool output was observed in the chat; no separately captured raw stderr was produced. The suite files were not rewritten or rerun. This separate recorder copies the six existing frozen audit files exactly.\n');
await fs.writeFile(path.join(target,'parent-preservation-correction.txt.snapshot'),notice,{flag:'wx'});snapshots.push({sourcePath:'parent-preservation-correction.txt',path:'parent-preservation-correction.txt.snapshot',bytes:notice.length,sha256:sha(notice)});
const own=await fs.readFile(import.meta.filename);await fs.writeFile(path.join(target,'corrected-preserver.mjs.snapshot'),own,{flag:'wx'});snapshots.push({sourcePath:'../preserve-metrics-algorithm-independent-audit.mjs',path:'corrected-preserver.mjs.snapshot',bytes:own.length,sha256:sha(own)});
const manifest={schema:'rea-metrics-algorithm-independent-audit-preservation/v1',recordedAtUtc:new Date().toISOString(),snapshots,auditReceiptSHA256:'3b8150485117fb9018fc6a4d8c7ad68f0dfa0f07f1fa659c1edd6067a358c7f2',auditStrictManifestSHA256:'7054600c8b3b0b778334a14a39cf1138bdcd97a0d2afc48679603007a2c4ec41',auditFreezeSHA256:'334eb103479f770afdd79d2940ac5019cb76febba6f941a2d1f6bc28e5f688fe',candidateSelectedForIntegration:false,measurementReruns:0,allSnapshotsInert:true,fullProductParity:false,universalSuperiority:false};const b=Buffer.from(JSON.stringify(manifest,null,2)+'\n');await fs.writeFile(path.join(target,'preservation-manifest.json'),b,{flag:'wx'});console.log(JSON.stringify({files:snapshots.length,sha256:sha(b)}));
