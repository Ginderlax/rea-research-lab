for (const [source,target] of [['source','source/inside'],['source','SOURCE'],['../source','target'],['source','.rea-backup/target'],['source','.REA-SYNC-HISTORY/target'],['source','target:stream'],['source','nul'],['source','target.']]) test(`unsafe paths rejected: ${source} ‚Üí ${target}`,async t => {
