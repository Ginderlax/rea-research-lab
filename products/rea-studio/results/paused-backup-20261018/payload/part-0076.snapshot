    },
    {
      "id": "grafana.candidate.7b9a183a9d8437cb8ee6",
      "syntaxRole": "list-item",
      "sourceText": "- The **Rate** option aligns and converts data points to a rate per time series.",
      "headingPath": [
        "Google Cloud Monitoring query editor",
        "Query metrics",
        "Configure pre-processing options"
      ],
      "source": {
        "path": "docs/sources/datasources/google-cloud-monitoring/query-editor/index.md",
        "gitBlobSha": "35f2bbc8926a6d131f4d3cbcb6a6184dabccd704",
        "sha256": "5bd24c0a5753f11d9c5d6296eadff38bbc9734793a5e4cc55da2cb6fe1d87ef1",
        "lineStart": 96,
        "lineEnd": 96,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/google-cloud-monitoring/query-editor/index.md#L96-L96"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.e81f59eeb97544aa3978",
      "syntaxRole": "list-item",
      "sourceText": "- The **Delta** option aligns data points by their delta (difference) per time series.",
      "headingPath": [
        "Google Cloud Monitoring query editor",
        "Query metrics",
        "Configure pre-processing options"
      ],
      "source": {
        "path": "docs/sources/datasources/google-cloud-monitoring/query-editor/index.md",
