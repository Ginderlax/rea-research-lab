    {
      "id": "grafana.candidate.af3953f855f5fe33a0a7",
      "syntaxRole": "table-row",
      "sourceText": "| Effects | Other styling choices you can apply to your gauge include: <ul><li>**Gradient** - Color transitions are represented with gradients for color schemes where the gauge color differs by value. This effect is on by default.</li><li>**Bar glow** - Adds a glowing shadow outside the gauge bar.</li><li>**Center glow** - The color representing the current gauge value is visible in the center of the gauge.</li></ul> |",
      "headingPath": [
        "Gauge",
