import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
const work=import.meta.dirname,source=path.join(work,'keepass-history-draft-independent-review'),out=path.join(work,'keepass-history-production-adapter-review-preservation'),adapter=path.join(work,'keepass-history-production-adapter'),prefix='products/rea-studio/apps/vault/results/history-followup/final-independent-review',sha=b=>createHash('sha256').update(b).digest('hex');
const manifestBytes=await fs.readFile(path.join(source,'review-manifest.json')),receiptBytes=await fs.readFile(path.join(source,'review-validation.json'));assert.equal(sha(manifestBytes),'26aa8c0588d740fa6edc164a70d37642204ae0b2fab17a6a839fc1e002aaa9d7');assert.equal(sha(receiptBytes),'5f529c2497a237f8af210c28df117d836f17ba65f42e909dc302bd39576434d0');const manifest=JSON.parse(manifestBytes),files=manifest.files??manifest.entries;assert.equal(files.length,82);const adapterReceipt=await fs.readFile(path.join(adapter,'adapter-validation.json')),adapterManifest=await fs.readFile(path.join(adapter,'adapter-manifest.json'));assert.equal(sha(adapterReceipt),'333489f32316708416e751fc53db2853f926619907038f6ed552ae0ecf8453e5');assert.equal(sha(adapterManifest),'c9ea75292133e63bb3be1c2275ad8143f2d1129faf36e884c9da2fea2dce9516');
await fs.mkdir(out,{recursive:false});const mappings=[];for(const e of files){assert.ok(e.path&&!e.path.startsWith('/')&&!e.path.includes('\\')&&!e.path.split('/').includes('..'));const b=await fs.readFile(path.join(source,e.path));assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256,e.path);assert.equal(/\.(zip|exe|dll)(\.snapshot)*$/.test(e.path),false,'Unexpected local carrier in public review');const target=prefix+'/'+e.path+'.snapshot';await fs.mkdir(path.dirname(path.join(out,target)),{recursive:true});await fs.writeFile(path.join(out,target),b);mappings.push({originalPath:e.path,preservedPath:target,bytes:e.bytes,sha256:e.sha256});}for(const name of ['review-manifest.json','freeze.json'])await fs.copyFile(path.join(source,name),path.join(out,prefix,name+'.snapshot'));
await fs.copyFile(import.meta.filename,path.join(out,'preserve-keepass-final-review-for-adapter.mjs'));await fs.writeFile(path.join(out,'README.md'),'# Frozen final independent Vault review preservation\n\nAll82 reviewer-owned artifacts are exact inert app-relative snapshots. The independent review passed11 unchanged safety/control cases and actual private browser Save/Restore held-response, dirty Restore refusal, normal restoration, export and restart checks on the frozen stage. Reviewer original-runtime executions were0. It remains bound to the author stage1454 and client1d3920, not rebased onto the later adapter tests. The production adapter separately passed41+11 author-run layout checks against byte-identical runtime and the actual copied shared host. No production or frozen adapter bytes were changed by this preservation.\n\nOriginal source remains subject to GPL-2.0-or-later; upstream source/license attribution is retained in the separate history-followup study. No complete product parity, original GUI execution or comparative superiority is claimed.\n');
const record={schema:'rea-vault-production-adapter-final-independent-review-preservation/v1',preservedAt:new Date().toISOString(),reviewerArtifactCount:82,mappings,originalManifestSha256:sha(manifestBytes),originalReceiptSha256:sha(receiptBytes),originalBrowserReceiptSha256:'90789c37a8b9216645b313002331c78ed40a3bf71328fcc0eac77504b4567d73',boundHistoricalAuthorStageManifestSha256:'52e8294fd06887d49b76f315a67d4aa05e4fcfc9744ab4e96de94763872389b5',runtimeClientSha256:'1d392037160c2cdca8c53e0ab807d5215964cd00c248360e5c00532f3ba00bed',laterAdapterReceiptSha256:sha(adapterReceipt),laterAdapterManifestSha256:sha(adapterManifest),oldReviewRebound:false,productionChanged:false,frozenAdapterChanged:false,reviewerOriginalExecutions:0,fullProductParity:false,securityParity:false,superiority:false};await fs.writeFile(path.join(out,'review-preservation.json'),JSON.stringify(record,null,2)+'\n');assert.equal(sha(await fs.readFile(path.join(adapter,'adapter-validation.json'))),sha(adapterReceipt));assert.equal(sha(await fs.readFile(path.join(adapter,'adapter-manifest.json'))),sha(adapterManifest));
const entries=[];async function walk(relative=''){for(const e of await fs.readdir(path.join(out,relative),{withFileTypes:true})){const n=relative?relative+'/'+e.name:e.name;if(e.isDirectory())await walk(n);else{const b=await fs.readFile(path.join(out,n));entries.push({path:n,bytes:b.length,sha256:sha(b)});}}}await walk();entries.sort((a,b)=>a.path.localeCompare(b.path,'en'));const strict={schema:'rea-vault-final-independent-public-preservation-strict/v1',count:entries.length,files:entries,metadataExclusions:['preservation-manifest.json','freeze.json'],strictInventory:true};await fs.writeFile(path.join(out,'preservation-manifest.json'),JSON.stringify(strict,null,2)+'\n');const freeze={schema:'rea-vault-final-independent-review-preservation-freeze/v1',frozenAt:new Date().toISOString(),count:entries.length,receiptSha256:sha(await fs.readFile(path.join(out,'review-preservation.json'))),manifestSha256:sha(await fs.readFile(path.join(out,'preservation-manifest.json'))),productionChanged:false,adapterChanged:false};await fs.writeFile(path.join(out,'freeze.json'),JSON.stringify(freeze,null,2)+'\n');console.log(JSON.stringify(freeze));
