    {
      "id": "grafana.candidate.f1e29256a50f4b39e068",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can re-encrypt data keys encrypted with a specific key encryption key (KEK). This allows you to either re-encrypt existing data keys with a new KEK version or to re-encrypt them with a completely different KEK.",
      "headingPath": [
        "Configure database encryption",
        "Operational work",
        "Re-encrypt data keys"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-database-encryption/_index.md",
        "gitBlobSha": "936ab7c1d208cbcd86c66db25b399c78675a122b",
