    {
      "id": "grafana.candidate.4610e6551e7616a0d2bf",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you use file provisioning, you can upgrade and update the routes at the same time.",
      "headingPath": [
        "What’s new in Grafana v11.0",
        "Dashboards and visualizations",
        "Subfolders"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-0.md",
        "gitBlobSha": "718032fb1fcee4d964da6aa4e9da332a64bf509a",
        "sha256": "4ac4a4d84503349934037643cc351a7722532a4c4189aab283838810ba2f6731",
        "lineStart": 154,
        "lineEnd": 154,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-0.md#L154-L154"
      },
