          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.321a4ae552534a7c96eb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you use TraceQL with regular expressions in your Grafana dashboards and you want the unanchored behavior, update the queries to use the unanchored version, such as `{ span.foo =~ \".*bar.*\"}`.",
      "headingPath": [
        "Before you begin",
        "Use autocomplete to write queries",
        "Anchored regular expressions"
