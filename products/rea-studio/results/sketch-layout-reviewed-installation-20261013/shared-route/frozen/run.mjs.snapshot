import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{spawnSync}from'node:child_process';const root=import.meta.dirname,kind=process.argv[2];assert.ok(['baseline-fixed-test','corrected'].includes(kind));const run=path.join(root,'runs',kind+'-'+new Date().toISOString().replaceAll(':','-'));fs.mkdirSync(run,{recursive:true});const sha=b=>createHash('sha256').update(b).digest('hex');function files(dir=root,rel=''){return fs.readdirSync(dir,{withFileTypes:true}).flatMap(e=>{assert.ok(!e.isSymbolicLink());const n=rel?rel+'/'+e.name:e.name;if(!rel&&e.name==='runs')return[];if(e.isDirectory())return files(path.join(dir,e.name),n);const b=fs.readFileSync(path.join(dir,e.name));return[{path:n,bytes:b.length,sha256:sha(b)}];}).sort((a,b)=>a.path.localeCompare(b.path));}const before=files();for(const r of before){const p=path.join(run,'source',r.path+'.snapshot');fs.mkdirSync(path.dirname(p),{recursive:true});fs.copyFileSync(path.join(root,r.path),p,fs.constants.COPYFILE_EXCL);}const startedAt=new Date().toISOString(),r=spawnSync(process.execPath,['--test','--test-reporter=tap','tests/sketch-layout-static-route.test.mjs'],{cwd:path.join(root,'products/rea-studio'),encoding:'utf8',windowsHide:true,timeout:60000,maxBuffer:1024*1024});fs.writeFileSync(path.join(run,'stdout.txt'),r.stdout??'',{flag:'wx'});fs.writeFileSync(path.join(run,'stderr.txt'),r.stderr??'',{flag:'wx'});const after=files(),summary=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(n=>[n,Number((r.stdout??'').match(new RegExp('^# '+n+' (\\d+)$','m'))?.[1]??-1)])),record={schema:'rea-sketch-layout-static-route-attempt/v1',kind,startedAt,endedAt:new Date().toISOString(),before,after,sourceStable:JSON.stringify(before)===JSON.stringify(after),runtime:{version:process.version,sha256:sha(fs.readFileSync(process.execPath))},exitCode:r.status,error:r.error?String(r.error):null,summary,ownedHttpInstances:2,originalExecutions:0,browserExecutions:0,productionWrites:0,fullParity:false};fs.writeFileSync(path.join(run,'attempt.json'),JSON.stringify(record,null,2)+'\n',{flag:'wx'});assert.deepEqual(before,after);assert.equal(r.error,undefined);assert.equal(summary.tests,2);assert.equal(summary.skipped+summary.cancelled+summary.todo,0);assert.equal(r.status,kind==='corrected'?0:1);assert.equal(summary.pass,kind==='corrected'?2:1);console.log(JSON.stringify({run,summary,sourceFiles:before.length,sourceStable:true}));
