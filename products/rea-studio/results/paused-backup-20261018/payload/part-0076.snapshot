    {
      "id": "grafana.candidate.c927bbc554a96b63d9ed",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This query uses the selected value of the `$app` variable to dynamically filter the metric path. The variable `$app` contains one or more application names and `servers.*` matches all servers for the given application.",
      "headingPath": [
        "Graphite template variables",
        "Use other query variables",
        "Compare expanded and non-expanded metric search results"
      ],
      "source": {
        "path": "docs/sources/datasources/graphite/template-variables/index.md",
