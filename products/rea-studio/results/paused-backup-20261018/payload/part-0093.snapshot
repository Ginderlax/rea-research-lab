    async function listFault(title, holdResponse) {
      const entered = deferred(), released = deferred(), finished = deferred(); let used = false;
      const gate = { entered: entered.promise, release: released.resolve, finished: finished.promise, used: () => used };
      if (holdResponse) holds.push(gate); else released.resolve();
      await page.route(instance.url + '/api/notes/list', async route => {
        if (used) return route.continue(); used = true;
        const row = { kind: 'actual-host-list400-after-owned-filesystem-read-fault', title, handlerMocked: false, responseRewritten: false, heldAfterRestore: holdResponse, steps: [] };
        faults.push(row); let response, body, original, backup, moved = false, directory = false;
        const stamp = name => row.steps.push({ name, atUtc: new Date().toISOString() });
        try {
          original = await disk(); const saved = Object.values(original.state.notes).find(note => note.title === title);
          assert(saved && saved.revision === 1 && saved.todo.isTodo && saved.history.length === 0);
          row.noteId = saved.id; row.committedRevision = saved.revision; row.originalCommittedState = original.identity;
          // accept(note) starts attachment-list before list refresh. Wait for its
          // real response and every other owned request to finish before rename.
          await bounded((async () => {
            for (;;) {
              const attachment = responses.find(item => item.path === '/api/notes/attachment-list' && item.status === 200 && JSON.parse(item.postData).id === saved.id);
              if (attachment && [...pending].every(request => request === route.request()) && responseTasks.size === 0) break;
              await new Promise(resolve => setTimeout(resolve, 10));
            }
          })(), 5000, 'Prior attachment-list and other owned requests did not finish before fault');
          stamp('all-other-owned-requests-and-attachment-response-drained');
          assert.equal(pending.size, 1); assert(pending.has(route.request()));
          backup = ownership('notes/records/new-todo-owned-fault-original.json');
          assert.equal(await fs.stat(backup).then(() => true, error => { if(error.code === 'ENOENT') return false; throw error; }), false);
          const originalStat = await fs.lstat(stateFilename); assert(originalStat.isFile() && !originalStat.isSymbolicLink());
          assert((await fs.readFile(stateFilename)).equals(original.bytes));
          activeDiskFault = { heldRequest: route.request() }; stamp('fault-ownership-entered');
          await fs.rename(stateFilename, backup); moved = true; stamp('committed-state-renamed-to-owned-sibling');
          await fs.mkdir(stateFilename); directory = true; stamp('empty-directory-installed-at-owned-state-file');
          response = await route.fetch({ timeout: 15000 }); body = await response.body();
          assert.equal(response.status(), 400); assert(body.length <= 2048);
          const parsed = JSON.parse(body); assert.equal(typeof parsed.error, 'string'); assert(/^(EISDIR|EPERM|EACCES): /.test(parsed.error));
          row.actualStatus = response.status(); row.actualError = parsed.error; row.actualBody = metadata(body); stamp('unchanged-host-returned-real-filesystem400');
          expectedHttpFailures.push({ path: '/api/notes/list', status: 400, errorMessage: parsed.error, observed: false });
        } catch(error) { entered.reject(error); throw error; }
        finally {
          try {
            if (directory) { const item = await fs.lstat(stateFilename); assert(item.isDirectory() && !item.isSymbolicLink()); assert.deepEqual(await fs.readdir(stateFilename), []); assert.equal(stateFilename, ownership('notes/records/notes-state-v2.json')); await fs.rmdir(stateFilename); stamp('owned-empty-directory-removed-without-recursion'); }
            if (moved) { assert((await fs.readFile(backup)).equals(original.bytes)); await fs.rename(backup, stateFilename); stamp('original-state-restored'); assert((await fs.readFile(stateFilename)).equals(original.bytes)); row.restoredState = metadata(await fs.readFile(stateFilename)); assert.deepEqual(row.restoredState, row.originalCommittedState); stamp('restored-exact-original-bytes-verified'); }
            activeDiskFault = null; row.restoreCompletedBeforeResponseDelivery = moved && directory; assert(row.restoreCompletedBeforeResponseDelivery);
          } catch(error) { errors.push({ type: 'owned-fault-restore-failure', message: error.message }); entered.reject(error); finished.resolve(); throw error; }
        }
        try {
          entered.resolve({ noteId: row.noteId, revision: row.committedRevision, error: row.actualError, originalState: row.originalCommittedState });
          await released.promise; stamp('actual-response-release-requested');
          assert.deepEqual((await disk()).identity, row.originalCommittedState);
          await route.fulfill({ response }); stamp('unchanged-actual400-delivered-after-restoration');
        } finally { finished.resolve(); }
      });
      return gate;
    }

test('committed New to-do save reports refresh failure separately and preserves a newer draft across a held rejected list reply', async t => {
  const g = gate(); let rejectNext = false, hold = false;
  const f = await ui(t, async ({ action }) => {
    if (action === 'list' && rejectNext) {
      rejectNext = false;
      if (hold) { g.enter(); await g.held; }
      throw new Error('Synthetic list response rejected after saved state committed');
    }
  });
  await f.click(f.byText('New to-do')); typeDraft(f, 'First committed task'); rejectNext = true;
  await f.click(f.byText('Save note'));
  const first = created(f).find(note => note.title === 'First committed task'); assert.ok(first); assert.equal(first.revision, 1); assert.equal(todoState(first).isTodo, true);
  assert.match(status(f).textContent, /Saved revision 1\. Could not refresh the note list:/);
  await f.click(f.byText('New to-do')); typeDraft(f, 'Second committed task', 'Body already committed'); rejectNext = true; hold = true;
  const pending = f.click(f.byText('Save note')); await g.started;
  const second = created(f).find(note => note.title === 'Second committed task'); assert.ok(second); assert.equal(second.revision, 1); assert.equal(second.body, 'Body already committed');
  f.type(f.byLabel('Markdown note'), 'Newer unsaved body while accepted list response is held'); const ownedStatus = status(f).textContent;
  g.release(); await pending;
  assert.equal(status(f).textContent, ownedStatus); assert.match(ownedStatus, /Unsaved draft/); assert.equal(f.byLabel('Markdown note').value, 'Newer unsaved body while accepted list response is held'); assert.equal(f.byText('Save note').disabled, false);
  await f.click(f.byText('Save note')); const final = f.read().notes[second.id];
  assert.equal(saves(f).at(-1).input.id, second.id); assert.equal(saves(f).at(-1).input.revision, 1); assert.equal('newTodo' in saves(f).at(-1).input, false);
  assert.equal(final.revision, 2); assert.equal(final.body, 'Newer unsaved body while accepted list response is held'); assert.equal(todoState(final).isTodo, true); assert.equal(created(f).length, 2);
});
# New To-do: next independent Notes source epoch

This proposal starts from the exact reviewed Notes R4 source authority. Its12 candidate files contain two runtime replacements, a README addition, four new test files, four attributed upstream source/document/license snapshots and a bounded source contract. It changes no active repository, existing test, source proof, result, collector, workflow, requirement registry or historical receipt.

The released reference is Joplin Desktop3.6.14 at commit7e2765a3857754d12dbadea442b60ceaf9d4b23d. The pinned documentation offers New to-do above the desktop list. The desktop command delegates newNote(body,true), and the latter uses a valid selected folder and provisional save before selection/sort. Note.newTodo preserves the supplied parent and sets its type. The newly retrieved desktop command bytes were authenticated against their exact pinned GUI Git tree blob IDs. Existing retained Note/BaseModel bytes and the retained to-do documentation/license are independently pinned.

The candidate explicitly keeps New to-do unsaved until Save. This differs from the original provisional lifecycle. A single first commit contains note text, notebook binding and open task fields with revision1 and empty history. Only creation accepts an optional Boolean newTodo flag. Existing-note requests must omit it; their saved-note controls retain their existing APIs. Caller text/type/tag fields are captured before waiting for the state queue. Failed writes publish no partial note or notebook and allow explicit retry.

The UI adds New to-do beside New note. It keeps ordinary discard confirmation, visibly labels the unsaved task type, and requires a saved item before due/completion/attachment operations. Save prevents duplicate submissions while typing remains possible. A real committed response cannot replace a newer draft, a new editor or a disposed view. Later saves of the retained body use the returned ID/revision and omit the creation flag. Failures likewise respect editor ownership. Existing filters and updated-time sorting do not change; selected-folder/default-folder behavior is a disclosed candidate policy rather than an original enabled-condition parity claim.

The18 authored groups comprise6 API/state groups,7 simulated-DOM UI groups,3 actual-HTTP/restart/JEX groups and2 isolated original-source groups. The latter plan4 parent/type comparisons using three exact model methods over an explicitly declared field adapter, plus2 desktop command argument comparisons. Adapter defaults, Joplin database/provisional persistence, full command registration, enabled-context evaluation and the original GUI are not executed. Candidate zero due/completion defaults are checked without claiming the narrow original constructor initialized those fields itself. These comparison counts are never added to test-group counts.

Before any hosted execution, independently review the complete sources and exact contract. A future source bundle must declare7 application transitions (client/server/README replaced, four tests added),21 fixed Notes files and110 planned groups while preserving the current92/8/32-source installed epoch. It must preserve all17 existing test files and the current original20 comparisons unchanged. Do not copy this proposal over installed sources or relax their current32-file/8-target helper. Compose a separately pinned future source epoch, authenticate every other source against the committed baseline, retain independent source postchecks, and use supported standard hosted Windows/Node24.16 execution.

A fresh real-browser campaign remains a separate requirement: draft creation without transport, first committed save and later body save, genuine enabled-control timing holds, failed persistence and explicit retry, new editor/disposal ownership, actual JEX/resource downloads and owned cleanup. These four new test files contain simulated-DOM UI checks, not a new Chromium acceptance claim. The previous8 real-browser cases retain their actual source epoch.

After new finite/browser acceptance and independent evidence readback, assess a closed source-transition proof that preserves both historical Notes source epochs before considering installation. Shared collectors, source-group limits and publication controls must receive separate reviewed future changes; this proposal alters none. Sorting documentation ambiguity, alarms, sync, accessibility and full product parity remain open.
