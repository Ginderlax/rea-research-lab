    {
      "id": "grafana.candidate.6459f360197b79ecf831",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Sharing your dashboard externally could result in a large number of queries to the data sources used by your dashboard. This can be mitigated by using the Enterprise [caching](ref:caching) and/or rate limiting features.",
      "headingPath": [
        "Externally shared dashboards"
      ],
