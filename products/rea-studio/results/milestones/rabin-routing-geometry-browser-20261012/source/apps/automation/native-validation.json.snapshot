  "cancellationAndQueueCorrection": {
    "finding": "A cancellation during a held Wait checkpoint returned waiting and left a durable resumable continuation. A rejected queued stale save could also poison shutdown queue draining.",
    "originalFailedProbe": {
      "sha256": "2befe1b84c3df51a5f54ffd077c2a89e404f89a0861b3db5d3782875f28b651e",
      "observations": {
        "before": "waiting",
        "cancelReturned": "waiting",
        "persisted": "waiting"
      }
    },
    "historicalSource": {
      "path": "native-server.mjs",
      "sha256": "fa4758a0f74048dc6745413431e471845d994ab658ba158ea96fd3d2d6fe4ebd",
      "bytes": 8847,
      "sourceSnapshot": "import {randomUUID} from 'node:crypto';\nimport {importWorkflow,preflight,createExecution,advanceExecution,validateExecution,NativeError,redact,bounded,LIMITS} from './native.mjs';\nconst sessions=new WeakMap(),live=new Set(),index='automation.native.index',jobs='automation.native.jobs';\nfunction id(value){if(typeof value!=='string'||!/^[A-Za-z0-9_-]{1,80}$/.test(value))throw new Error('Invalid native identifier');return value;}\nfunction publicRun(run){const{workflow,pending,activeNode,...result}=run;delete result.activeMs;const clean=redact(result);try{bounded(clean,LIMITS.executionBytes,{undefinedValues:true});}catch{clean.outputs={};clean.outputsLimited=true;}return clean;}\nfunction queue(state,operation){const next=state.queue.catch(()=>{}).then(operation);state.queue=next;return next;}\nasync function persist(state,run){bounded(run,LIMITS.executionBytes,{undefinedValues:true});await queue(state,async()=>{let stored=run;if(['completed','failed','cancelled','interrupted'].includes(run.status)){const visible=publicRun(run);stored={...run,outputs:visible.outputs,trace:visible.trace};try{bounded(stored,LIMITS.executionBytes,{undefinedValues:true});}catch{stored.outputs={};stored.outputsLimited=true;}}await state.store.set(`automation.native.run.${run.id}`,stored);const key=`automation.native.history.${run.workflowId}`,previous=await state.store.get(key,[]);let history=[...previous.filter(value=>value.id!==run.id),publicRun(run)].slice(-50);while(history.length>1&&Buffer.byteLength(JSON.stringify(history))>12*1024*1024)history.shift();await state.store.set(key,history);});}\nfunction schedule(state,run){if(state.closed||run.status!=='waiting')return;const delay=Date.parse(run.waitUntil)-Date.now();if(!Number.isFinite(delay)||delay>LIMITS.waitMs+1000)throw new Error('Invalid persisted wait interval');clearTimeout(state.timers.get(run.id));const timer=setTimeout(async()=>{state.timers.delete(run.id);if(state.closed)return;try{const fresh=await state.store.get(`automation.native.run.${run.id}`,null);if(fresh?.status==='waiting')begin(state,fresh);}catch(error){state.errors.set(run.id,error.message);}},Math.max(0,delay));timer.unref?.();state.timers.set(run.id,timer);}\nfunction begin(state,run){validateExecution(run);if(state.running.has(run.id))return state.running.get(run.id);clearTimeout(state.timers.get(run.id));state.timers.delete(run.id);const controller=new AbortController(),active={run,controller};state.running.set(run.id,active);active.promise=(async()=>{try{const check=preflight(run.workflow);if(!check.executable)throw new Error('Persisted workflow no longer passes native preflight');await advanceExecution(run,{signal:controller.signal,checkpoint:value=>persist(state,value)});if(run.status==='waiting')schedule(state,run);return publicRun(run);}catch(error){run.status='failed';run.error={code:'NATIVE_PERSISTENCE',message:error.message};run.pending=[];try{await persist(state,run);}catch{}return publicRun(run);}finally{state.running.delete(run.id);if(run.status!=='waiting')state.openRuns.delete(run.id);}})();return active;}\nasync function session(store,workspace){let state=sessions.get(store);if(!state){state={store,workspace,queue:Promise.resolve(),running:new Map(),timers:new Map(),errors:new Map(),openRuns:new Set(),closed:false};sessions.set(store,state);live.add(state);state.ready=(async()=>{const runIds=await store.get(jobs,[]);if(!Array.isArray(runIds)||runIds.length>1000)throw new Error('Invalid native execution index');for(const runId of runIds){const run=await store.get(`automation.native.run.${id(runId)}`,null);if(!run)continue;validateExecution(run);if(run.id!==runId)throw new Error('Persisted execution ID mismatch');if(run.status==='waiting'){if(state.openRuns.size>=16)throw new Error('Native concurrent execution count exceeds 16');state.openRuns.add(run.id);schedule(state,run);}else if(run.status==='running'||run.status==='ready'){run.status='interrupted';run.error={code:'NATIVE_INTERRUPTED',message:'Host ended during a node operation; effects are not automatically replayed'};run.pending=[];await persist(state,run);}}})();}await state.ready;return state;}\nexport async function handleNative({action,input={},store,workspace}){\n input=structuredClone(bounded(input,LIMITS.documentBytes+4096,{undefinedValues:true}));\n const state=await session(store,workspace);if(state.closed)throw new Error('Native execution session is closed');\n if(action==='native-list'){const ids=await store.get(index,[]);if(!Array.isArray(ids)||ids.length>1000)throw new Error('Invalid native workflow index');const workflows=[];for(const value of ids){const record=await store.get(`automation.native.workflow.${id(value)}`,null);if(record)workflows.push({id:record.id,revision:record.revision,name:record.workflow.name,updatedAt:record.updatedAt});}return{workflows};}\n if(action==='native-save')return queue(state,async()=>{const workflow=importWorkflow(input.workflow),workflowId=input.id?id(input.id):randomUUID(),key=`automation.native.workflow.${workflowId}`,previous=await store.get(key,null);if(previous&&input.expectedRevision!==previous.revision)throw new Error('Native workflow revision changed; reload before saving');if(!previous&&input.expectedRevision!==undefined&&input.expectedRevision!==0)throw new Error('Native workflow does not exist');const indexed=await store.get(index,[]);if(!Array.isArray(indexed)||(!previous&&indexed.length>=1000))throw new Error('Native saved workflow count exceeds 1,000');const record={id:workflowId,revision:(previous?.revision??0)+1,workflow,updatedAt:new Date().toISOString()};await store.set(key,record);const ids=await store.get(index,[]);if(!ids.includes(workflowId))await store.set(index,[...ids,workflowId]);return{record:structuredClone(record),preflight:preflight(workflow)};});\n if(action==='native-get'){const value=await store.get(`automation.native.workflow.${id(input.id)}`,null);if(!value)throw new Error('Native workflow not found');const record=structuredClone(value);return{record,preflight:preflight(record.workflow)};}\n if(action==='native-validate')return preflight(input.workflow);\n if(action==='native-history'){await state.queue;return{runs:structuredClone(await store.get(`automation.native.history.${id(input.id)}`,[]))};}\n if(action==='native-start'||action==='native-run'){const record=await store.get(`automation.native.workflow.${id(input.id)}`,null);if(!record)throw new Error('Native workflow not found');const run={...createExecution(record.workflow),workflowId:record.id,revision:record.revision};await queue(state,async()=>{const ids=await store.get(jobs,[]);if(!Array.isArray(ids)||ids.length>=1000)throw new Error('Native saved execution count exceeds 1,000; no automatic state deletion is available');if(state.openRuns.size>=16)throw new Error('Native concurrent execution count exceeds 16');state.openRuns.add(run.id);try{await store.set(`automation.native.run.${run.id}`,run);await store.set(jobs,[...ids,run.id]);}catch(error){state.openRuns.delete(run.id);throw error;}});const active=begin(state,run);return{run:action==='native-run'?await active.promise:publicRun(run)};}\n if(action==='native-status'){const runId=id(input.runId),active=state.running.get(runId);let run=active?.run??await store.get(`automation.native.run.${runId}`,null);if(!run||run.workflowId!==id(input.id))throw new Error('Native execution not found');if(state.errors.has(runId))throw new Error(state.errors.get(runId));if(!active&&run.status==='waiting'&&Date.parse(run.waitUntil)<=Date.now())run=begin(state,run).run;return{run:publicRun(run)};}\n if(action==='native-cancel'){const runId=id(input.runId),active=state.running.get(runId);const run=active?.run??await store.get(`automation.native.run.${runId}`,null);if(!run||run.workflowId!==id(input.id))throw new Error('Native execution not found');if(active){active.controller.abort(new NativeError('Execution cancelled','NATIVE_CANCELLED'));return{run:await active.promise};}if(run.status!=='waiting')throw new Error('Native execution is not active');clearTimeout(state.timers.get(runId));state.timers.delete(runId);state.openRuns.delete(runId);run.status='cancelled';run.pending=[];delete run.waitUntil;run.finishedAt=new Date().toISOString();await persist(state,run);return{run:publicRun(run)};}\n throw new Error('Unknown native Automation action');\n}\nexport async function disposeNative(workspace){for(const state of [...live])if(!workspace||state.workspace===workspace){state.closed=true;for(const timer of state.timers.values())clearTimeout(timer);state.timers.clear();for(const active of state.running.values())active.controller.abort(new NativeError('Host shutdown interrupted execution','NATIVE_INTERRUPTED'));await Promise.allSettled([...state.running.values()].map(value=>value.promise));await state.queue;live.delete(state);sessions.delete(state.store);}}\n"
    },
    "historicalTests": {
      "path": "native-server.test.mjs",
      "sha256": "3eb0a36afde47b986377556435eb453f5e719f1bd607f1aa6be6a8932c131231",
      "bytes": 13654,
      "sourceSnapshot": "import test from 'node:test';\nimport assert from 'node:assert/strict';\nimport {createServer} from 'node:http';\nimport {mkdtemp,rm} from 'node:fs/promises';\nimport {tmpdir} from 'node:os';\nimport {join,resolve,relative,isAbsolute} from 'node:path';\nimport {once} from 'node:events';\nimport {start} from '../../server.mjs';\nimport {createStore} from '../../lib/storage.mjs';\nimport {createExecution,executeNode,preflight,LIMITS} from './native.mjs';\nimport {handleNative,disposeNative} from './native-server.mjs';\n\nconst node=(type,name,parameters={})=>({id:name,name,type:`n8n-nodes-base.${type}`,typeVersion:{manualTrigger:1,set:3.4,if:2.3,httpRequest:4.4,wait:1.1}[type],position:[0,0],parameters});\nfunction workflow(nodes){const all=[node('manualTrigger','Manual'),...nodes];return{name:'Synthetic native workflow',nodes:all,connections:Object.fromEntries(all.slice(0,-1).map((value,index)=>[value.name,{main:[[{node:all[index+1].name,type:'main',index:0}]]}])),settings:{executionOrder:'v1'},meta:{preserve:'Unicode café 😀'}};}\nconst set=(name='Set')=>node('set',name,{assignments:{assignments:[{name:'finished',value:true,type:'boolean'}]},includeOtherFields:true});\nasync function fixture(t){\n const folder=await mkdtemp(join(tmpdir(),'rea-native-automation-')),hosts=[];\n async function open(){const host=await start({port:0,dataDir:folder});hosts.push(host);return{...host,async api(action,input={}){const response=await fetch(`${host.url}/api/automation/${action}`,{method:'POST',headers:{'content-type':'application/json','x-rea-token':host.token},body:JSON.stringify(input)});const result=await response.json();if(!response.ok)throw new Error(result.error??`HTTP ${response.status}`);return result.result;}};}\n t.after(async()=>{await Promise.allSettled(hosts.map(host=>host.close()));const absolute=resolve(folder),root=resolve(tmpdir()),rel=relative(root,absolute);assert.ok(rel&&!isAbsolute(rel)&&!rel.startsWith('..')&&rel.startsWith('rea-native-automation-'));await rm(absolute,{recursive:true,force:true});});\n return{folder,open,store:await createStore(join(folder,'automation','records'))};\n}\nasync function endpoint(t){const seen=[],timers=new Set();const server=createServer((req,res)=>{seen.push(req.url);const send=()=>{res.writeHead(req.url==='/failure'?422:200,{'content-type':'application/json','set-cookie':'synthetic-private-cookie'});res.end(JSON.stringify({value:9,token:'synthetic-private-token'}));};if(req.url==='/slow'){const timer=setTimeout(()=>{timers.delete(timer);send();},200);timers.add(timer);}else send();});server.listen(0,'127.0.0.1');await once(server,'listening');t.after(()=>new Promise(done=>{for(const timer of timers)clearTimeout(timer);server.closeAllConnections();server.close(done);}));return{url:`http://127.0.0.1:${server.address().port}`,seen};}\nasync function terminal(api,id,runId){for(let count=0;count<200;count++){const{run}=await api('native-status',{id,runId});if(!['ready','running','waiting'].includes(run.status))return run;await new Promise(done=>setTimeout(done,5));}throw new Error('Synthetic native execution did not finish');}\n\ntest('native app HTTP saves exact imported metadata and revisions across restart and refuses stale edits',async t=>{\n const f=await fixture(t),first=await f.open(),document=workflow([set()]);document.nodes.push({...node('future','Unconnected'),typeVersion:99,parameters:{vendorOption:{keep:[1,2]}}});\n const{record}=await first.api('native-save',{workflow:document});assert.deepEqual(record.workflow,document);assert.equal(record.revision,1);await first.close();const second=await f.open();const loaded=await second.api('native-get',{id:record.id});assert.deepEqual(loaded.record,record);assert.equal(loaded.preflight.executable,true);\n const changed=structuredClone(document);changed.name='Changed';const updated=await second.api('native-save',{id:record.id,expectedRevision:1,workflow:changed});assert.equal(updated.record.revision,2);await assert.rejects(second.api('native-save',{id:record.id,expectedRevision:1,workflow:document}),/revision changed/);const{run}=await second.api('native-run',{id:record.id});assert.equal(run.status,'completed');assert.equal(run.revision,2);assert.equal(run.outputs.Set[0][0].json.finished,true);\n});\ntest('native Wait persists real continuation, resumes after restart API bootstrap, and performs its downstream HTTP effect once',async t=>{\n const f=await fixture(t),remote=await endpoint(t),first=await f.open(),document=workflow([node('wait','Wait',{resume:'timeInterval',amount:0.15,unit:'seconds'}),node('httpRequest','HTTP',{url:remote.url,options:{timeout:1000}}),set()]);\n const{record}=await first.api('native-save',{workflow:document}),{run}=await first.api('native-run',{id:record.id});assert.equal(run.status,'waiting');assert.equal(remote.seen.length,0);await first.close();await new Promise(done=>setTimeout(done,180));assert.equal(remote.seen.length,0);const second=await f.open();await second.api('native-list');const finished=await terminal(second.api,record.id,run.id);assert.equal(finished.status,'completed');assert.equal(remote.seen.length,1);assert.equal(finished.outputs.Set[0][0].json.finished,true);assert.equal(finished.outputs.HTTP[0][0].json.token,'[redacted]');const history=await second.api('native-history',{id:record.id});assert.equal(history.runs.length,1);assert.equal(history.runs[0].status,'completed');assert.doesNotMatch(JSON.stringify(history),/synthetic-private-cookie|synthetic-private-token/);\n});\ntest('native durable wait cancellation persists and prevents later effects, including restart',async t=>{\n const f=await fixture(t),remote=await endpoint(t),host=await f.open(),document=workflow([node('wait','Wait',{resume:'timeInterval',amount:0.05,unit:'seconds'}),node('httpRequest','HTTP',{url:remote.url,options:{timeout:1000}})]);const{record}=await host.api('native-save',{workflow:document}),{run}=await host.api('native-run',{id:record.id});const cancelled=await host.api('native-cancel',{id:record.id,runId:run.id});assert.equal(cancelled.run.status,'cancelled');await host.close();const restarted=await f.open();await restarted.api('native-list');await new Promise(done=>setTimeout(done,80));assert.equal(remote.seen.length,0);assert.equal((await restarted.api('native-status',{id:record.id,runId:run.id})).run.status,'cancelled');\n});\ntest('native active HTTP cancellation and host shutdown record distinct failure traces without automatic replay',async t=>{\n const f=await fixture(t),remote=await endpoint(t),host=await f.open(),document=workflow([node('httpRequest','HTTP',{url:`${remote.url}/slow`,options:{timeout:1000}})]);const{record}=await host.api('native-save',{workflow:document});\n const started=await host.api('native-start',{id:record.id});for(let count=0;remote.seen.length<1&&count<100;count++)await new Promise(done=>setTimeout(done,2));const cancelled=await host.api('native-cancel',{id:record.id,runId:started.run.id});assert.equal(cancelled.run.status,'cancelled');assert.equal(cancelled.run.error.code,'NATIVE_CANCELLED');assert.equal(cancelled.run.trace.at(-1).status,'cancelled');\n const another=await host.api('native-start',{id:record.id});for(let count=0;remote.seen.length<2&&count<100;count++)await new Promise(done=>setTimeout(done,2));await host.close();const restarted=await f.open();await restarted.api('native-list');const interrupted=(await restarted.api('native-status',{id:record.id,runId:another.run.id})).run;assert.equal(interrupted.status,'interrupted');assert.equal(interrupted.error.code,'NATIVE_INTERRUPTED');assert.equal(remote.seen.length,2);\n});\ntest('native failed HTTP status records node/code trace; known unsupported downstream config preflights before requests',async t=>{\n const f=await fixture(t),remote=await endpoint(t),host=await f.open(),http=node('httpRequest','HTTP',{url:`${remote.url}/failure`,options:{timeout:1000}});const{record}=await host.api('native-save',{workflow:workflow([http])});const{run}=await host.api('native-run',{id:record.id});assert.equal(run.status,'failed');assert.equal(run.error.code,'NATIVE_HTTP_STATUS');assert.equal(run.error.node,'HTTP');assert.equal(run.trace.at(-1).status,'failed');\n for(const bad of [node('set','Bad',{mode:'raw',jsonOutput:'{\"__proto__.polluted\":true}'}),node('httpRequest','Bad',{url:remote.url,sendHeaders:true,headerParameters:{parameters:[{name:'Authorization',value:'synthetic'}]},options:{timeout:1000}})]){const{record:invalid}=await host.api('native-save',{workflow:workflow([http,bad])});const before=remote.seen.length;await assert.rejects(host.api('native-run',{id:invalid.id}),/Unsafe|Credential|Unsafe or/);assert.equal(remote.seen.length,before);}\n});\ntest('native restart rejects malformed durable continuation before any downstream effects',async t=>{\n const f=await fixture(t),remote=await endpoint(t),document=workflow([node('httpRequest','HTTP',{url:remote.url,options:{timeout:1000}})]),run={...createExecution(document),workflowId:'synthetic',revision:1,status:'waiting',waitUntil:new Date().toISOString(),pending:[{node:'Missing',items:[{json:{}}]}]};await f.store.set('automation.native.jobs',[run.id]);await f.store.set(`automation.native.run.${run.id}`,run);const host=await f.open();await assert.rejects(host.api('native-list'),/Invalid persisted invocation/);assert.equal(remote.seen.length,0);\n});\ntest('native item/request/array/aggregate preparation bounds reject without issuing partial HTTP effects',async t=>{\n const remote=await endpoint(t),http=node('httpRequest','HTTP',{url:remote.url,options:{timeout:1000}});await assert.rejects(executeNode(http,Array.from({length:501},()=>({json:{}}))),/500 HTTP/);assert.equal(remote.seen.length,0);const setNode=node('set','Set',{assignments:{assignments:[{name:'value',type:'string',value:'x'.repeat(1024*1024-200)}]}});await assert.rejects(executeNode(setNode,Array.from({length:10},()=>({json:{}}))),/execution byte limit/);for(const name of ['a[\"60000\"]','a[10000]'])assert.equal(preflight(workflow([node('set','Set',{assignments:{assignments:[{name,type:'number',value:1}]}})])).executable,false);assert.equal(LIMITS.items,10000);\n});\ntest('native public actions capture caller input before awaits and returned records cannot mutate shared MemoryStore state',async t=>{\n const values=new Map(),store={async get(key,fallback=null){return values.has(key)?values.get(key):fallback;},async set(key,value){values.set(key,value);}},workspace={synthetic:true},api=(action,input)=>handleNative({action,input,store,workspace});t.after(()=>disposeNative(workspace));\n const document=workflow([set()]),expected=structuredClone(document),pending=api('native-save',{workflow:document});document.name='Mutated caller name';document.nodes[1].parameters.assignments.assignments[0].value=false;const{record}=await pending;assert.deepEqual(record.workflow,expected);record.workflow.nodes[1].parameters.assignments.assignments[0].value=false;const first=await api('native-get',{id:record.id});assert.equal(first.record.workflow.nodes[1].parameters.assignments.assignments[0].value,true);first.record.workflow.nodes[1].parameters.assignments.assignments[0].value=false;const{run}=await api('native-run',{id:record.id});assert.equal(run.outputs.Set[0][0].json.finished,true);const history=await api('native-history',{id:record.id});history.runs[0].status='Caller-mutated';assert.equal((await api('native-history',{id:record.id})).runs[0].status,'completed');\n});\ntest('host serves only native public editor/example modules while execution and oracle modules remain private',async t=>{\n const f=await fixture(t),host=await f.open();for(const file of ['native-client.mjs','native-example.mjs']){const response=await fetch(`${host.url}/apps/automation/${file}`);assert.equal(response.status,200,file);assert.match(response.headers.get('content-type'),/javascript/);assert.ok((await response.text()).length>100);}for(const file of ['native-server.mjs','native.mjs','original-harness.mjs','compare-original.mjs']){const response=await fetch(`${host.url}/apps/automation/${file}`);assert.equal(response.status,404,file);}\n});\ntest('native caps concurrent running/waiting continuations at sixteen and cancellation releases capacity',async t=>{\n const map=new Map(),workspace={},store={async get(key,fallback=null){return structuredClone(map.has(key)?map.get(key):fallback);},async set(key,value){map.set(key,structuredClone(value));}},api=(action,input)=>handleNative({action,input,store,workspace});t.after(()=>disposeNative(workspace));const{record}=await api('native-save',{workflow:workflow([node('wait','Wait',{resume:'timeInterval',amount:60,unit:'seconds'})])}),runs=[];\n for(let count=0;count<16;count++)runs.push((await api('native-run',{id:record.id})).run);await assert.rejects(api('native-run',{id:record.id}),/concurrent execution count exceeds 16/);assert.equal(map.get('automation.native.jobs').length,16);await api('native-cancel',{id:record.id,runId:runs[0].id});assert.equal((await api('native-run',{id:record.id})).run.status,'waiting');\n});\ntest('native restart classifies a ready checkpoint as interrupted and does not initiate its HTTP request',async t=>{\n const f=await fixture(t),remote=await endpoint(t),run={...createExecution(workflow([node('httpRequest','HTTP',{url:remote.url,options:{timeout:1000}})])),workflowId:'synthetic',revision:1};await f.store.set('automation.native.jobs',[run.id]);await f.store.set(`automation.native.run.${run.id}`,run);const host=await f.open();await host.api('native-list');const result=(await host.api('native-status',{id:'synthetic',runId:run.id})).run;assert.equal(result.status,'interrupted');assert.equal(remote.seen.length,0);\n});\n"
    },
