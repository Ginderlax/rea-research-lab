    {
      "id": "grafana.candidate.bd4621b8f2668f36f58e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This query counts the number of log lines with a status code that is not 200 (OK), then sum the result set by message type using an **instant query** and the time interval indicated in brackets. It uses the LogQL pattern parser to add a new label called `message` that contains the level, method, url, and status from the log line.",
      "headingPath": [
        "How to create alert rules with log data",
        "Create an alert rule",
        "Define query and alert condition"
      ],
