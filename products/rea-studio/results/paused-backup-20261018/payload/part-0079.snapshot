    {
      "id": "grafana.candidate.a6820f754499c75b0ca1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This transformation allows you to manipulate and analyze geospatial data, enabling operations such as creating lines between points, calculating spatial properties, and more.",
      "headingPath": [
        "Transform data",
        "Transformation functions",
        "Spatial"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/transform-data/index.md",
        "gitBlobSha": "9cd072609170b1783ea50740845dd11e18b0fede",
        "sha256": "73ae12b953aaf13c6df7b5a072cc18677d57c977343a108001752487a81b2800",
        "lineStart": 1468,
        "lineEnd": 1468,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/panels-visualizations/query-transform-data/transform-data/index.md#L1468-L1468"
      },
