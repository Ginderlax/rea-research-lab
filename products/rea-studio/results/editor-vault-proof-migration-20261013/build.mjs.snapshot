const installationPrefix='products/rea-studio/results/editor-vault-reviewed-production-installation-20261013',pb=readFileSync(resolve(repo,installationPrefix,'preservation-manifest.json')),pm=JSON.parse(pb);assert.equal(sha(pb),'3f810b748bfee60e396df83b668face23e52645871fcfcded3a4074445ce86d5');assert.equal(pm.records.length,1098);
const rec=pm.records.find(r=>r.sourcePath==='installation.json');assert(rec);const ib=readFileSync(resolve(repo,rec.publicPath));assert.deepEqual(fp(ib),{bytes:rec.bytes,sha256:rec.sha256});const install=JSON.parse(ib);assert.equal(install.installed.length,30);
const routes=acq.routes8.map(r=>({...r,historicalPath:r.path.endsWith('apps/vault/README.md')?installationPrefix+'/before-images/'+r.path+'.snapshot':r.historicalPath}));
const metadata={development:{...acq.historicalDevelopment,historicalPath:installationPrefix+'/before-metadata/'+acq.historicalDevelopment.path+'.snapshot'},status:{...JSON.parse(readFileSync(resolve(stage,'historical-status-before.json'))).record}};
// Read actual capture schema; its identity is fixed before the new suite writes.
const statusPath='products/rea-studio/STATUS.json',statusBytes=readFileSync(resolve(stage,'before-image',statusPath+'.snapshot'));metadata.status={path:statusPath,...fp(statusBytes),historicalPath:installationPrefix+'/before-metadata/'+statusPath+'.snapshot'};
const verifiers=acq.verifierBefore.map(r=>({path:r.path,before:{bytes:r.bytes,sha256:r.sha256},after:fp(readFileSync(resolve(stage,'candidate',r.path))),historicalPath:r.publicBeforePath}));
const records={schema:'rea-editor-vault-explicit-proof-transition/v1',installation:{manifest:{path:installationPrefix+'/preservation-manifest.json',...fp(pb)},record:{path:rec.publicPath,...fp(ib)},records:1098,installed:30},sources:acq.liveRows.map(r=>({path:r.path,before:r.before,after:r.after})),routes,sharedHost:acq.currentHost,metadata,verifiers,oldCapsule:acq.oldCapsule,scope:{historical847NotCurrentAcceptance:true,historical78NotCurrentAcceptance:true,namedMigrationsOnly:true,applicationExecutions:0,originalExecutions:0,browserExecutions:0,benchmarks:0,fullParity:false}};
writeFileSync(resolve(stage,'transition-records.json'),JSON.stringify(records,null,2)+'\n');
const template=readFileSync(resolve(stage,'module-template.mjs'),'utf8');writeFileSync(resolve(stage,'candidate/scripts/editor-vault-proof-migration.mjs'),template.replace('/*FIXED_RECORDS*/null',JSON.stringify(records,null,2)));
writeFileSync(resolve(stage,'verifier-transformations.json'),JSON.stringify({schema:'rea-editor-vault-exact-verifier-transformations/v1',changes,verifiers},null,2)+'\n');
console.log(JSON.stringify({sourceOnly:true,plans637And325AuthenticatedByPreparation:true,installedRows:30,namedRoutes:routes.length,old720Affected:routes.filter(r=>r.affectedInOld720).length,verifiers:verifiers.length,substitutions:changes.length,module:fp(readFileSync(resolve(stage,'candidate/scripts/editor-vault-proof-migration.mjs'))),newAppExecutions:0}));

