      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.0ae2920781faa48b3fce",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can see a list of users with accounts in your Grafana organization. If necessary, you can use the search field to filter the list.",
      "headingPath": [
        "Manage users in an organization",
        "View a list of organization users"
      ],
      "source": {
