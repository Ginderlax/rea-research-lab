import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),sha=b=>createHash('sha256').update(b).digest('hex');
const source=await fs.readFile(path.join(here,'candidate-module-control.mjs'),'utf8');
assert.equal(sha(source),'33574a99fd21029a7b564b1d9316c2b6d7389641c6b607d6bea61dc022457dd3');
const oldImport="import { singlePercentile } from './selector-control.mjs';",nextImport="import { singlePercentile, preparePercentileValues } from './selector-algorithm.mjs';";
const oldTail='for (const { id } of queue) if (!Object.hasOwn(result, id) && specialIds.has(id)) Object.assign(result, special(id, field, ignore, zero, shared));';
const nextTail=`for (const { id } of queue) if (!Object.hasOwn(result, id) && specialIds.has(id)) {
    if (id[0] === 'p') {
      const sorted = shared.percentiles ||= preparePercentileValues(field, ignore, zero);
      result[id] = sorted[Math.round((sorted.length - 1) * (Number(id.slice(1)) / 100))];
    } else Object.assign(result, special(id, field, ignore, zero, shared));
  }`;
assert.equal(source.split(oldImport).length,2);assert.equal(source.split(oldTail).length,2);
const candidate=source.replace(oldImport,nextImport).replace(oldTail,nextTail);
assert.equal(candidate.replace(nextImport,oldImport).replace(nextTail,oldTail),source);
await fs.writeFile(path.join(here,'candidate-algorithm.mjs'),candidate,{flag:'wx'});
const section=(text,start,end)=>text.slice(text.indexOf(start),text.indexOf(end,text.indexOf(start)));
const preservedSections={};for(const [label,start,end]of [['standard','export function doStandardCalcs','function special'],['special','function special','const specialIds'],['registry','const specialIds','/** Matches fixed'],['transport','/** Lossless JSON','\u0000']]){const actual=end==='\u0000'?candidate.slice(candidate.indexOf(start)):section(candidate,start,end),previous=end==='\u0000'?source.slice(source.indexOf(start)):section(source,start,end);assert.equal(actual,previous);preservedSections[label]=sha(actual);}
await fs.writeFile(path.join(here,'candidate-contract.json'),JSON.stringify({schemaVersion:1,checkedAt:new Date().toISOString(),entrySHA256:sha(candidate),helperSHA256:sha(await fs.readFile(path.join(here,'selector-algorithm.mjs'))),previousEntrySHA256:sha(source),preciseTwoEntrySubstitutionsVerified:true,preservedSections,partitionScanBeforeDeterministicMultiplier:2,defaultWorkBudgetMultiplier:64,defaultWorkBudgetConstant:128,timingMeasurementRun:false,memoryMeasurementRun:false,scope:'New helper algorithm and precise multi-percentile assignment dispatch; all other entry bytes remain exact.'},null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({status:'built',entrySHA256:sha(candidate),preservedSections}));
