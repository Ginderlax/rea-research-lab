    {
      "id": "grafana.candidate.2cff69d3a5be4f5e18b5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A library panel is a reusable panel that you can use in any dashboard. When you make a change to a library panel, that change propagates to all instances of where the panel is used. Library panels streamline reuse of panels across multiple dashboards.",
      "headingPath": [
        "Manage library panels"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/build-dashboards/manage-library-panels/index.md",
        "gitBlobSha": "26935779dabb66e8ca5da67dc9af0ff03b224522",
        "sha256": "a4c545447b9d566161f10bed237ebb51b09ef28e113519690c6f0e1aa902c4be",
        "lineStart": 31,
        "lineEnd": 31,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/dashboards/build-dashboards/manage-library-panels/index.md#L31-L31"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.7e5f1664698b37df6716",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can save a library panel in a folder alongside saved dashboards.",
      "headingPath": [
        "Manage library panels"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/build-dashboards/manage-library-panels/index.md",
        "gitBlobSha": "26935779dabb66e8ca5da67dc9af0ff03b224522",
