import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import {createHash} from 'node:crypto';
import {createWebDAV,connection,remotePath,davLimits} from './webdav.mjs';
import {parseXML,parseMultiStatus} from './dav-xml.mjs';
import {createDAVTransfer,transferLimits} from './dav-transfer.mjs';
import {fixtureServer} from './fixture-server.mjs';
const auth={type:'basic',username:'synthetic-user',password:'synthetic-only-password'},digest=bytes=>createHash('sha256').update(bytes).digest('hex');
async function setup(seed={},files={}) {const fixture=await fixtureServer({seed,auth}),root=await fs.mkdtemp(path.join(os.tmpdir(),'rea-dav-test-'));await fs.mkdir(path.join(root,'source'));for(const [name,bytes]of Object.entries(files)){await fs.mkdir(path.dirname(path.join(root,'source',name)),{recursive:true});await fs.writeFile(path.join(root,'source',name),bytes);}const input={endpoint:fixture.endpoint,auth,source:'source',destination:'',mode:'sync'},engine=createDAVTransfer(root);return {fixture,root,input,engine,client:createWebDAV({endpoint:fixture.endpoint,auth}),async close(){engine.close();await fixture.close();await fs.rm(root,{recursive:true,force:true});}};}
test('namespace aware DAV properties ignore vendor and failed propstats',async()=>{const f=await fixtureServer({seed:{'a & b.txt':'hello'}});try{const c=createWebDAV({endpoint:f.endpoint});assert.deepEqual((await c.list()).map(x=>[x.path,x.size,x.type]),[['a & b.txt',5,'file']]);c.close();}finally{await f.close();}});
test('UTF8, entity, nesting, XML document and property contradictions fail closed',()=>{for(const text of ['<!DOCTYPE x [<!ENTITY a SYSTEM "file:///secret">]><x/>','<a>&bad;</a>','<a><b></a>','<a/><b/>','<a>&#0;</a>','<a/ >','<a></ a>','<a>]]></a>','<a xmlns:x="urn:one" xmlns:y="urn:one" x:attr="1" y:attr="2"/>','<a>'+ '<a>'.repeat(33)+'</a>'.repeat(33)+'</a>'])assert.throws(()=>parseXML(Buffer.from(text)));assert.throws(()=>parseXML(Buffer.from([255])));assert.throws(()=>parseMultiStatus(Buffer.from('<d:multistatus xmlns:d="DAV:"><d:response><d:href>/dav/a</d:href><d:propstat><d:status>HTTP/1.1 403 Forbidden</d:status><d:prop><d:resourcetype/></d:prop></d:propstat></d:response></d:multistatus>')));});
test('failed post-upload verification reports that current remote file may have changed',async()=>{const x=await setup({'a.txt':'old'},{'a.txt':'replacement'});try{const p=await x.engine.preview(x.input);x.fixture.failures.set('PUT a.txt',{run(req,res){x.fixture.put('a.txt','wrong bytes');res.writeHead(204);res.end();}});await assert.rejects(x.engine.apply({endpoint:x.input.endpoint,auth,token:p.token}),error=>{assert.match(error.message,/verification/);assert.deepEqual(error.failedOperation,{type:'copy',path:'a.txt',remoteMayHaveChanged:true});return true;});assert.equal(x.fixture.entries.get('a.txt').bytes.toString(),'wrong bytes');}finally{await x.close();}});
test('destination race after retention fails conditional delete and keeps new remote bytes',async()=>{const x=await setup({'extra.txt':'old'},{'a.txt':'new'});try{const p=await x.engine.preview(x.input);x.fixture.failures.set('PUT a.txt',{run(req,res){x.fixture.put('a.txt','new');x.fixture.put('extra.txt','changed during apply');res.writeHead(201);res.end();}});await assert.rejects(x.engine.apply({endpoint:x.input.endpoint,auth,token:p.token,allowDeletes:true}),/412/);assert.equal(x.fixture.entries.get('extra.txt').bytes.toString(),'changed during apply');}finally{await x.close();}});
test('hard-linked local source files are refused before network writes',async()=>{const x=await setup({}, {'a.txt':'safe'});try{await fs.link(path.join(x.root,'source','a.txt'),path.join(x.root,'outside-link.txt'));await assert.rejects(x.engine.preview(x.input),/one link/);assert.ok(!x.fixture.requests.some(x=>x.method==='PUT'));}finally{await x.close();}});
test('endpoint and path inputs refuse credential URLs, ambiguous escapes and portable aliases',()=>{for(const endpoint of ['http://example.com/dav/','https://user:pass@example.com/','https://example.com/?query','https://example.com/a/%2e%2e/','https://example.com/a/%2F/'])assert.throws(()=>connection({endpoint}));for(const p of ['../secret','/absolute','a\\b','CON.txt','ends.','a/%2f.txt'])assert.throws(()=>remotePath(p));assert.equal(connection({endpoint:'https://example.com/dav/'}).endpoint,'https://example.com/dav/');});
test('auth is required afresh and redirects never forward credentials',async()=>{const x=await setup({'old.txt':'old'});try{const c=createWebDAV({endpoint:x.fixture.endpoint});await assert.rejects(c.list(),/401/);x.fixture.failures.set('PROPFIND ',{status:302,headers:{Location:'http://127.0.0.1:1/secret'}});await assert.rejects(x.client.list(),/redirects/);assert.equal(x.fixture.requests.length,2);c.close();}finally{await x.close();}});
test('external, root escaped, duplicate and deeper href responses are rejected',async()=>{const x=await setup({'a.txt':'x'});try{const original=x.fixture.xml(['','a.txt']);for(const body of [original.replace('/dav/a.txt','http://example.invalid/dav/a.txt'),original.replace('/dav/a.txt','/outside/a.txt'),original.replace('/dav/a.txt','/dav/deeper/a.txt'),original.replace('/dav/a.txt','/dav/')]){x.fixture.failures.set('PROPFIND ',{status:207,body});await assert.rejects(x.client.list());}}finally{await x.close();}});
test('conditional read/write/delete reject stale ETags and new-file collisions',async()=>{const x=await setup({'a.txt':'old'});try{const old=await x.client.stat('a.txt');x.fixture.put('a.txt','new');await assert.rejects(x.client.read('a.txt',{expected:old}),/412/);await assert.rejects(x.client.write('a.txt',Buffer.from('oops'),{expected:old}),/412/);await assert.rejects(x.client.remove('a.txt',{expected:old}),/412/);await assert.rejects(x.client.write('a.txt',Buffer.from('oops')),/412/);assert.equal(x.fixture.entries.get('a.txt').bytes.toString(),'new');}finally{await x.close();}});
test('empty-only collection deletion prevents recursive loss',async()=>{const x=await setup({'folder/a.txt':'safe'});try{await assert.rejects(x.client.remove('folder',{collection:true,expected:await x.client.stat('folder',{collection:true})}),/empty/);assert.equal(x.fixture.entries.get('folder/a.txt').bytes.toString(),'safe');}finally{await x.close();}});
test('response byte bound and interruption prevent partial reads',async()=>{const x=await setup();try{x.fixture.failures.set('GET huge',{status:200,headers:{'Content-Length':davLimits.file+1}});await assert.rejects(x.client.read('huge'),/limit/);x.fixture.failures.set('GET interrupted',{run(req,res){res.writeHead(200,{'Content-Length':10});res.write('xx');setTimeout(()=>res.destroy(),5);}});await assert.rejects(x.client.read('interrupted'),/interrupted|aborted|reset/i);}finally{await x.close();}});
test('sync retains exact previous bytes and requires explicit deletion approval',async()=>{const x=await setup({'change.txt':'old','extra.txt':'remove','same.txt':'stay'},{'change.txt':'replacement','same.txt':'else','folder/new.txt':'new'});try{const p=await x.engine.preview(x.input);assert.equal(p.counts.copy,2);assert.equal(p.counts.remove,1);await assert.rejects(x.engine.apply({endpoint:x.input.endpoint,auth,token:p.token}),/approval/);const result=await x.engine.apply({endpoint:x.input.endpoint,auth,token:p.token,allowDeletes:true});assert.equal(x.fixture.entries.get('change.txt').bytes.toString(),'replacement');assert.equal(x.fixture.entries.get('same.txt').bytes.toString(),'stay');assert.ok(!x.fixture.entries.has('extra.txt'));const dir=path.join(x.root,...result.retainedAt.split('/')),manifest=JSON.parse(await fs.readFile(path.join(dir,'manifest.json'),'utf8'));for(const retained of manifest.retained)assert.equal(digest(await fs.readFile(path.join(dir,retained.bytes))),retained.sha256);assert.deepEqual(manifest.retained.map(x=>x.path),['change.txt','extra.txt']);assert.ok(!JSON.stringify(manifest).includes(auth.password));await assert.rejects(x.engine.apply({endpoint:x.input.endpoint,auth,token:p.token,allowDeletes:true}),/consumed/);}finally{await x.close();}});
test('filtered sync keeps excluded remote extras and uses native rule ordering',async()=>{const x=await setup({'extra.tmp':'keep','extra.txt':'remove'},{'keep.txt':'new','skip.tmp':'skip'});try{const p=await x.engine.preview({...x.input,filters:{filter:['- *.tmp','+ **']}});assert.deepEqual(p.operations.filter(x=>x.type!=='mkdir').map(x=>[x.type,x.path]),[['copy','keep.txt'],['remove','extra.txt']]);await x.engine.apply({endpoint:x.input.endpoint,auth,token:p.token,allowDeletes:true});assert.equal(x.fixture.entries.get('extra.tmp').bytes.toString(),'keep');assert.ok(!x.fixture.entries.has('skip.tmp'));}finally{await x.close();}});
test('source content changes with size unchanged invalidate preview',async()=>{const x=await setup({}, {'a.txt':'abc'});try{const p=await x.engine.preview(x.input),filename=path.join(x.root,'source','a.txt'),time=await fs.stat(filename);await fs.writeFile(filename,'xyz');await fs.utimes(filename,time.atime,time.mtime);await assert.rejects(x.engine.apply({endpoint:x.input.endpoint,auth,token:p.token,allowDeletes:true}),/stale/);assert.ok(!x.fixture.requests.some(x=>['PUT','DELETE','MKCOL'].includes(x.method)));}finally{await x.close();}});
test('remote changes, including excluded files, invalidate full inventory before mutation',async()=>{const x=await setup({'exclude.tmp':'abc'},{'new.txt':'new'});try{const p=await x.engine.preview({...x.input,filters:{exclude:['*.tmp']}});x.fixture.put('exclude.tmp','xyz');await assert.rejects(x.engine.apply({endpoint:x.input.endpoint,auth,token:p.token,allowDeletes:true}),/stale/);assert.ok(!x.fixture.entries.has('new.txt'));}finally{await x.close();}});
test('preview response/input mutation cannot rewrite private token-bound plan',async()=>{const x=await setup({'a.txt':'old'},{'a.txt':'replacement'});try{const original={...x.input,comparison:{ignoreTimes:true}},p=await x.engine.preview(original);original.source='outside';p.operations[0].path='outside.txt';p.operations[0].destination.etag='"fake"';p.operations.push({type:'remove',path:'anything'});await x.engine.apply({endpoint:x.input.endpoint,auth,token:p.token,allowDeletes:true});assert.equal(x.fixture.entries.get('a.txt').bytes.toString(),'replacement');assert.ok(!x.fixture.entries.has('outside.txt'));}finally{await x.close();}});
test('complete direct inputs reject unknown/accessor/cyclic/proxy/oversized values before network',async()=>{const x=await setup();try{let getterCalls=0;const getter={...x.input};Object.defineProperty(getter,'auth',{enumerable:true,get(){getterCalls++;throw Error('getter invoked');}});const cycle={...x.input};cycle.filters=cycle;for(const input of [{...x.input,unknown:'x'},getter,cycle,new Proxy(x.input,{}),{...x.input,filters:{exclude:['x'.repeat(128*1024)]}}])await assert.rejects(x.engine.preview(input));assert.equal(getterCalls,0);assert.equal(x.fixture.requests.length,0);}finally{await x.close();}});
test('apply credentials and endpoint are not retained or silently reused',async()=>{const x=await setup({}, {'a.txt':'new'});try{const p=await x.engine.preview(x.input);assert.ok(!JSON.stringify(p).includes(auth.password));await assert.rejects(x.engine.apply({endpoint:x.input.endpoint,token:p.token}),/401/);await assert.rejects(x.engine.apply({endpoint:x.input.endpoint.replace('/dav/','/other/'),auth,token:p.token}),/differs/);await x.engine.apply({endpoint:x.input.endpoint,auth,token:p.token});}finally{await x.close();}});
test('failed PUT preserves old remote bytes and local recovery instead of destructive cleanup',async()=>{const x=await setup({'a.txt':'old'},{'a.txt':'replacement'});try{const p=await x.engine.preview(x.input);x.fixture.failures.set('PUT a.txt',{status:500});let failure;try{await x.engine.apply({endpoint:x.input.endpoint,auth,token:p.token});}catch(error){failure=error;}assert.match(failure.message,/500/);assert.ok(failure.planConsumed);assert.equal(x.fixture.entries.get('a.txt').bytes.toString(),'old');assert.ok(!x.fixture.requests.some(x=>x.method==='DELETE'));const manifest=JSON.parse(await fs.readFile(path.join(x.root,...failure.retainedAt.split('/'),'manifest.json'),'utf8'));assert.equal((await fs.readFile(path.join(x.root,...failure.retainedAt.split('/'),manifest.retained[0].bytes))).toString(),'old');}finally{await x.close();}});
test('partial failure reports completed requests and consumes plan once',async()=>{const x=await setup({}, {'a.txt':'a','b.txt':'b'});try{const p=await x.engine.preview(x.input);x.fixture.failures.set('PUT b.txt',{status:503});await assert.rejects(x.engine.apply({endpoint:x.input.endpoint,auth,token:p.token}),error=>{assert.deepEqual(error.completed,[{type:'copy',path:'a.txt'}]);return true;});assert.equal(x.fixture.entries.get('a.txt').bytes.toString(),'a');assert.ok(!x.fixture.entries.has('b.txt'));await assert.rejects(x.engine.apply({endpoint:x.input.endpoint,auth,token:p.token}),/consumed/);}finally{await x.close();}});
test('weak ETags allow listing but refuse planned destination mutations',async()=>{const x=await setup({'a.txt':'old'},{'a.txt':'replacement'});try{x.fixture.entries.get('a.txt').etag='W/"weak"';assert.equal((await x.client.list())[0].strongETag,false);await assert.rejects(x.engine.preview(x.input),/strong ETags/);assert.ok(!x.fixture.requests.some(x=>x.method==='PUT'));}finally{await x.close();}});
test('plan count eviction and expiry bound retained metadata',async()=>{const x=await setup();let now=1000;const engine=createDAVTransfer(x.root,{clock:()=>now});try{let first;for(let i=0;i<=transferLimits.plans;i++){const p=await engine.preview(x.input);first??=p.token;}assert.equal(engine.cache().plans,transferLimits.plans);assert.ok(engine.cache().bytes<=transferLimits.cacheBytes);await assert.rejects(engine.apply({endpoint:x.input.endpoint,auth,token:first}),/expired/);now+=transferLimits.expiresMilliseconds;assert.equal(engine.cache().plans,0);}finally{engine.close();await x.close();}});
test('OPTIONS reports declared capabilities without asserting condition safety',async()=>{const x=await setup();try{const result=await x.client.capabilities();assert.deepEqual(result.davClasses,['1']);assert.ok(result.methods.includes('PUT'));assert.match(result.warning,/do not prove/);}finally{await x.close();}});
test('client request concurrency is bounded and closing interrupts pending reads',async()=>{const x=await setup();try{let entered;const ready=new Promise(resolve=>entered=resolve);x.fixture.failures.set('GET pending',{run(){entered();}});const pending=x.client.read('pending');await ready;await assert.rejects(x.client.list(),/busy/);x.client.close();await assert.rejects(pending,/closed/);}finally{await x.close();}});
test('source directory junction is refused before traversing outside workspace',async()=>{const x=await setup();try{await fs.mkdir(path.join(x.root,'outside'));await fs.writeFile(path.join(x.root,'outside','secret.txt'),'synthetic outside bytes');await fs.symlink(path.join(x.root,'outside'),path.join(x.root,'source','junction'),'junction');await assert.rejects(x.engine.preview(x.input),/aliases|links/);assert.equal(x.fixture.requests.length,0);}finally{await x.close();}});
test('default DAV namespace and empty strong ETag remain valid protocol encodings',async()=>{const x=await setup({'a.txt':'bytes'});try{x.fixture.entries.get('a.txt').etag='""';const body=x.fixture.xml(['','a.txt']).replace('xmlns:d="DAV:"','xmlns="DAV:"').replaceAll('<d:','<').replaceAll('</d:','</');x.fixture.failures.set('PROPFIND ',{status:207,body});const items=await x.client.list();assert.equal(items[0].strongETag,true);assert.equal(items[0].etag,'""');assert.equal((await x.client.read('a.txt',{expected:items[0]})).toString(),'bytes');}finally{await x.close();}});
test('empty source directory versus remote file is an explicit unsupported collision',async()=>{const x=await setup({'collision':'keep'});try{await fs.mkdir(path.join(x.root,'source','collision'));await assert.rejects(x.engine.preview(x.input),/type collision/);assert.equal(x.fixture.entries.get('collision').bytes.toString(),'keep');assert.ok(!x.fixture.requests.some(x=>['PUT','DELETE','MKCOL'].includes(x.method)));}finally{await x.close();}});
