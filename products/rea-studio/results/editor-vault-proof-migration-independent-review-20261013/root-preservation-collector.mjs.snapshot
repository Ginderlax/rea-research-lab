import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import{createHash}from'node:crypto';
const work=import.meta.dirname,source=path.join(work,'editor-vault-proof-migration-independent-review'),lab=path.resolve(work,'../outputs/rea-research-lab'),prefix='products/rea-studio/results/editor-vault-proof-migration-independent-review-20261013',dest=path.join(lab,prefix);
const pin='ba33ea9ba4c401ad45423f3ce6d2e5adcb477d34bd43251212459a10918ba5f2',sha=b=>createHash('sha256').update(b).digest('hex');
async function verify(){const b=await fs.readFile(path.join(source,'manifest.json'));assert.equal(sha(b),pin);const m=JSON.parse(b);assert.equal(m.inventory.length,74);for(const r of m.inventory){assert(!r.path.includes('..')&&!r.path.includes('\\')&&!path.isAbsolute(r.path));const q=await fs.readFile(path.join(source,r.path));assert.equal(q.length,r.bytes);assert.equal(sha(q),r.sha256);}return{b,m};}
const {b:manifest,m}=await verify(),review=JSON.parse(await fs.readFile(path.join(source,'review-validation.json')));
for(const key of ['migrationAccepted','installerSourceAccepted','finiteSourceOnlyAcceptance','sourceBeforeAfterStable'])assert.equal(review[key],true,key);
assert.equal(review.productionWrites,0);assert.equal(review.checkCount,35);assert(review.checks.every(c=>c.passed));assert.equal(review.findings.length,0);
assert.equal(sha(await fs.readFile(path.join(work,'install-editor-vault-proof-migration.mjs'))),review.installerSHA256);
async function list(dir,p=''){const names=[];for(const e of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){assert(!e.isSymbolicLink());if(e.isDirectory())names.push(...await list(path.join(dir,e.name),p+e.name+'/'));else{assert(e.isFile());names.push(p+e.name);}}return names;}
const names=await list(source);assert.deepEqual(names.filter(n=>n!=='manifest.json').sort(),m.inventory.map(r=>r.path).sort());
await fs.mkdir(dest);const rows=[];async function save(n,b,origin){const p=path.join(dest,n);await fs.mkdir(path.dirname(p),{recursive:true});await fs.writeFile(p,b,{flag:'wx'});rows.push({sourcePath:origin,path:n,bytes:b.length,sha256:sha(b)});}
for(const n of names)await save(n+'.snapshot',await fs.readFile(path.join(source,n)),'work/editor-vault-proof-migration-independent-review/'+n);
await save('root-preservation-collector.mjs.snapshot',await fs.readFile(import.meta.filename),'work/'+path.basename(import.meta.filename));await verify();
const result={schema:'rea-editor-vault-proof-migration-independent-preservation/v1',at:new Date().toISOString(),strictPayloadFiles:74,additionalStrictManifest:1,rootCollector:1,snapshots:rows,sourceManifestSHA256:pin,finiteSourceOnlyAcceptance:true,proofChecks:35,freshRejectionChecks:26,oldReceiptsRebound:false,newAppOriginalBrowserBenchmarkExecutions:0,fullParity:false,universalSuperiority:false};const bytes=Buffer.from(JSON.stringify(result,null,2)+'\n');await fs.writeFile(path.join(dest,'preservation-manifest.json'),bytes,{flag:'wx'});console.log(JSON.stringify({snapshots:rows.length,manifestSHA256:sha(bytes),accepted:true}));
