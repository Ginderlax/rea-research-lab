const publication=JSON.parse(readFileSync(join(root,'.local/rea-studio/development-publication-receipt.json'))),revision=publication.commit;
assert.equal(publication.public,true);assert.equal(publication.development_tests.pass,496);assert.equal(publication.development_tests.skipped,0);
assert.match(revision,/^[0-9a-f]{40}$/);assert.notEqual(revision,'64238267b332bb3a8ac5435a613a596a06311f59');
const git=args=>{const r=spawnSync('git',args,{cwd:root,encoding:'utf8'});assert.equal(r.status,0);return r.stdout.trim();};
assert.equal(git(['rev-parse','HEAD']),revision);assert.equal(git(['status','--porcelain']),'');
const destination=product+'results/milestones/compression-remote-20261012/';assert.ok(!existsSync(join(root,destination,'snapshot-manifest.json')));
const sha=bytes=>createHash('sha256').update(bytes).digest('hex'),read=path=>JSON.parse(readFileSync(join(root,path))),sources=new Map();
const receiptPaths=[product+'results/development-validation.json',product+'results/browser-compression-remote-verification.json',product+'apps/archive/lzma-validation.json',product+'apps/backup/results/compression-validation.json',product+'apps/sync/results/webdav-validation.json',product+'results/metrics-performance-followup/followup.json',product+'COMPRESSION-REMOTE-MILESTONE.md'];
function add(entry){const path=posix.normalize(entry.path);assert.ok(path.startsWith(product)&&!path.includes('\\')&&!path.split('/').includes('..'));const bytes=readFileSync(join(root,path));assert.equal(sha(bytes),entry.sha256,`Snapshot source mismatch: ${path}`);if(entry.bytes!==undefined)assert.equal(bytes.length,entry.bytes);if(sources.has(path))assert.equal(sources.get(path).sha256,entry.sha256);sources.set(path,{path,bytes:bytes.length,sha256:entry.sha256});}
for(const entry of read(receiptPaths[0]).source_files)add({...entry,path:product+entry.path});
for(const entry of [...read(receiptPaths[1]).implementation_fingerprints,...read(receiptPaths[1]).screenshots])add(entry);
for(const[key,entries]of Object.entries(read(receiptPaths[2])))if(key.endsWith('_fingerprints'))for(const entry of entries)add({...entry,path:product+'apps/archive/'+entry.path});
const backup=read(receiptPaths[3]);for(const entry of [...backup.implementationFingerprints,...backup.rawEvidence])add(entry);
const sync=read(receiptPaths[4]);for(const[path,sha256]of Object.entries(sync.sourceFiles))add({path:product+'apps/sync/'+path,sha256});
for(const[path,sha256]of Object.entries(sync.hostDependenciesAtTest))add({path:relative(root,resolve(root,product+'apps/sync/',path)).replaceAll('\\','/'),sha256});
for(const[path,entry]of Object.entries(sync.receipts))add({...entry,path:product+'apps/sync/results/'+path});
const metrics=read(receiptPaths[5]);for(const entry of [...metrics.artifacts,metrics.implementation])add(entry);
function snapshot(path,folder){const bytes=readFileSync(join(root,path)),suffix=/\.(md|zip)$/.test(path)?'.snapshot':'';const snapshot_path=destination+folder+path.slice(product.length)+suffix;mkdirSync(join(root,snapshot_path,'..'),{recursive:true});writeFileSync(join(root,snapshot_path),bytes,{flag:'wx'});return{path,snapshot_path,bytes:bytes.length,sha256:sha(bytes)};}
const receipts=receiptPaths.map(path=>snapshot(path,'receipts/')),source_snapshots=[...sources.keys()].sort().map(path=>snapshot(path,'source/'));
writeFileSync(join(root,destination,'snapshot-manifest.json'),JSON.stringify({schema:'rea-compression-remote-checkpoint-snapshot/v1',recorded_at:new Date().toISOString(),source_revision:revision,receipts,source_snapshots,full_feature_parity_established:false,universal_superiority_established:false,scope:'Exact public 496-test compressed archive/backup/WebDAV checkpoint and source/proof bytes before subsequent integrations.'},null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({revision,receipts:receipts.length,sources:source_snapshots.length}));
