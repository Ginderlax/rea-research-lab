        "lineStart": 37,
        "lineEnd": 38,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/dashboards/variables/advanced-variables.md#L37-L38"
      },
      "applicability": {
