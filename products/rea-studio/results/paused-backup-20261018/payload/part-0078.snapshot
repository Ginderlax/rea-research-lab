    },
    {
      "id": "grafana.candidate.122715602d505391fa67",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The **Search** query builder, located on the **Explore** > **Query type** > **Search** in Grafana, provides drop-down lists and text fields to help you write a query. The selections you make automatically generate a [TraceQL query](/docs/tempo/latest/traceql).",
      "headingPath": [
        "Write TraceQL queries using Search"
      ],
      "source": {
