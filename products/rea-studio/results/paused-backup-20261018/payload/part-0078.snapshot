    {
      "id": "grafana.candidate.df98786a6295554fe9b9",
      "syntaxRole": "table-row",
      "sourceText": "| Classic palette                       | Grafana automatically assigns a color for each field or series based on its order. If the order of a field changes in your query, the color also changes. Useful for graphs, pie charts, and other categorical data visualizations.                                                                                                                                                                         |",
      "headingPath": [
        "Configure standard options",
        "Standard options",
        "Color scheme"
      ],
      "source": {
