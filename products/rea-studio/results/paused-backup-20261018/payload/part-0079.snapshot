    {
      "id": "grafana.candidate.6ed5c37568fdd6c1aa55",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you click **Focus block**, the block, or function, is set to 100% of the flame graph's width and all its child functions are shown with their widths updated relative to the width of the parent function. This makes it easier to drill down into smaller parts of the flame graph.",
      "headingPath": [
