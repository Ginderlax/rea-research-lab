import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{spawn}from'node:child_process';import{createHash}from'node:crypto';
const root=import.meta.dirname,workspace=path.resolve(root,'../..'),app='candidate/products/rea-studio/apps/editor',sha=b=>createHash('sha256').update(b).digest('hex'),run=path.join(root,'runs','focused-'+new Date().toISOString().replaceAll(':','-'));await fs.mkdir(run,{recursive:true});await fs.writeFile(path.join(run,'collector.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});
const selection=['workspace-search.test.mjs','workspace-search.ui.test.mjs','workspace-search-path.test.mjs','workspace-search-review-held.test.mjs','workspace-search-review-path.test.mjs','workspace-search-review-ui.test.mjs','workspace-search.integration.test.mjs','save-review-held.test.mjs','save-review-revision.test.mjs','save-review-adjacent.test.mjs','save-publication.ui.test.mjs','search-pattern.test.mjs','search-pattern.ui.test.mjs','search-pattern.integration.test.mjs'];
const selected=(await fs.readdir(path.join(root,app))).filter(n=>/\.(mjs|md|txt)$/.test(n)).map(n=>app+'/'+n);selected.push('candidate/products/rea-studio/server.mjs','candidate/products/rea-studio/catalog.mjs','candidate/products/rea-studio/lib/storage.mjs');const before=[];for(const p of selected.sort()){const b=await fs.readFile(path.join(root,p));before.push({path:p,bytes:b.length,sha256:sha(b)});const dest=path.join(run,'source-before',p+'.snapshot');await fs.mkdir(path.dirname(dest),{recursive:true});await fs.writeFile(dest,b,{flag:'wx'});}await fs.writeFile(path.join(run,'source-before.json'),JSON.stringify(before,null,2)+'\n',{flag:'wx'});await fs.writeFile(path.join(run,'selection.json'),JSON.stringify({selection,args:['--test','--test-reporter=tap','--test-concurrency=1',...selection.map(n=>app+'/'+n)],scope:'Focused copied historical search/Save and new pattern tests only; no Git/API/diff/full app suite or original calls.'},null,2)+'\n',{flag:'wx'});
const startedAt=new Date().toISOString(),result=await new Promise(resolve=>{const child=spawn(process.execPath,['--test','--test-reporter=tap','--test-concurrency=1',...selection.map(n=>path.join(root,app,n))],{cwd:root,windowsHide:true,shell:false,stdio:['ignore','pipe','pipe']}),out=[],err=[];let bytes=0,failure=null;for(const[s,a]of[[child.stdout,out],[child.stderr,err]])s.on('data',b=>{bytes+=b.length;if(bytes>8*1024*1024){failure??='8MiB combined output limit';child.kill();}else a.push(b);});const timer=setTimeout(()=>{failure??='120second collector deadline';child.kill();},120000);child.on('error',e=>{failure??=e.message;});child.on('close',(code,signal)=>{clearTimeout(timer);resolve({code,signal,failure,stdout:Buffer.concat(out),stderr:Buffer.concat(err)});});});await fs.writeFile(path.join(run,'stdout.txt'),result.stdout,{flag:'wx'});await fs.writeFile(path.join(run,'stderr.txt'),result.stderr,{flag:'wx'});const after=[];for(const r of before){const b=await fs.readFile(path.join(root,r.path));after.push({path:r.path,bytes:b.length,sha256:sha(b)});}await fs.writeFile(path.join(run,'source-after.json'),JSON.stringify(after,null,2)+'\n',{flag:'wx'});const production=JSON.parse(await fs.readFile(path.join(root,'production-before.json')));let productionStable=true;for(const r of production.rows){const b=await fs.readFile(path.join(workspace,'outputs/rea-research-lab',r.path));if(b.length!==r.bytes||sha(b)!==r.sha256)productionStable=false;}const stdout=result.stdout.toString(),totals={};for(const name of['tests','suites','pass','fail','cancelled','skipped','todo']){const m=[...stdout.matchAll(new RegExp('^# '+name+' (\\d+)$','gm'))].at(-1);totals[name]=m?Number(m[1]):null;}const receipt={schema:'rea-editor-pattern-focused/v1',startedAt,endedAt:new Date().toISOString(),selection,sourceRows:before.length,sourceStable:JSON.stringify(before)===JSON.stringify(after),production31Stable:productionStable,exitCode:result.code,signal:result.signal,collectorFailure:result.failure,totals,raw:{stdout:{bytes:result.stdout.length,sha256:sha(result.stdout)},stderr:{bytes:result.stderr.length,sha256:sha(result.stderr)}},originalCalls:0,browserCalls:0,benchmarkCalls:0,productionWrites:0,passed:result.code===0&&!result.failure&&JSON.stringify(before)===JSON.stringify(after)&&productionStable&&totals.fail===0&&totals.skipped===0&&totals.cancelled===0};await fs.writeFile(path.join(run,'validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({run,...receipt}));if(!receipt.passed)process.exitCode=1;
