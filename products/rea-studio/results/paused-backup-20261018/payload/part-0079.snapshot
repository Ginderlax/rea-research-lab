    {
      "id": "grafana.candidate.f9eb055a42b5aeedf2b9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Span filters allow you to work much more efficiently with traces that consist of a large number of spans. Span filters exist above the trace view and allow you to filter the spans that are shown in the trace view. The more filters you add, the more specific the filtered spans.",
      "headingPath": [
        "What’s new in Grafana v10.1",
        "Data sources",
        "Span filtering for traces is GA"
      ],
