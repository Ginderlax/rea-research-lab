    },
    {
      "id": "grafana.candidate.13dba9e9507904f5c6c3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To learn more, refer to [query caching in the Grafana Enterprise docs](/docs/grafana/next/enterprise/query-caching/)",
      "headingPath": [
        "What's new in Grafana v8.4",
