import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const here=import.meta.dirname,workspace=path.resolve(here,'../..'),stage=path.resolve(here,'../notes-inline-confirmation-next'),repo=path.join(workspace,'outputs/rea-research-lab'),hash=b=>createHash('sha256').update(b).digest('hex'),identify=async p=>{const b=await fs.readFile(p);return{bytes:b.length,sha256:hash(b)}},save=(n,v)=>fs.writeFile(path.join(here,n),JSON.stringify(v,null,2)+'\n',{flag:'wx'});
const mb=await fs.readFile(path.join(stage,'freeze-manifest.json'));assert.equal(hash(mb),'347ff80e93076df92144915e16257f92ff7910a78ea175be840b8d3fd829dc16');const manifest=JSON.parse(mb);assert.equal(manifest.files,214);assert.equal(Object.keys(manifest.inventory).length,214);const before=[];for(const[p,r]of Object.entries(manifest.inventory)){assert(!path.isAbsolute(p)&&!p.split('/').includes('..'));assert.deepEqual(await identify(path.join(stage,p)),r,p);before.push({root:'stage',path:p,...r});}before.push({root:'stage',path:'freeze-manifest.json',bytes:mb.length,sha256:hash(mb)});assert.equal((await identify(path.join(stage,'validation.json'))).sha256,'42145b5215d828dfa816a76f801b2c2f610910ca3d5e630131ae5430fd26db23');
for(const ledger of ['baseline-source28.json','baseline-original-source31.json']){const rows=JSON.parse(await fs.readFile(path.join(stage,ledger)));assert.equal(rows.length,ledger.includes('source28')?28:31);for(const r of rows){assert.deepEqual(await identify(path.join(repo,r.path)),{bytes:r.bytes,sha256:r.sha256},r.path);before.push({root:'repo',...r});}}
const app=path.join(stage,'products/rea-studio/apps/notes');await fs.mkdir(path.join(here,'source'),{recursive:true});for(const p of ['client.mjs','server.mjs','notebook-confirmation.ui.test.mjs','notebook-trash-review-fixture.mjs'])await fs.writeFile(path.join(here,'source',p+'.snapshot'),await fs.readFile(path.join(app,p)),{flag:'wx'});
const fixture=await fs.readFile(path.join(app,'notebook-trash-review-fixture.mjs'),'utf8'),fresh=await fs.readFile(path.join(app,'notebook-confirmation.ui.test.mjs'),'utf8'),appImport='../notes-inline-confirmation-next/products/rea-studio/apps/notes/';
const adaptedFixture=fixture.replace("from './client.mjs'",`from '${appImport}client.mjs'`).replace("from './server.mjs'",`from '${appImport}server.mjs'`),adaptedFresh=fresh.replace("from './notebook-trash-review-fixture.mjs'","from './fixture.mjs'").replace("from './client.mjs'",`from '${appImport}client.mjs'`);
assert.notEqual(adaptedFixture,fixture);assert.notEqual(adaptedFresh,fresh);assert.equal(adaptedFresh.slice(adaptedFresh.indexOf('const observations=')),fresh.slice(fresh.indexOf('const observations=')));
await fs.writeFile(path.join(here,'fixture.mjs'),adaptedFixture,{flag:'wx'});await fs.writeFile(path.join(here,'fresh-replay.test.mjs'),adaptedFresh,{flag:'wx'});
await save('adapters.json',{candidateFresh9:{before:await identify(path.join(app,'notebook-confirmation.ui.test.mjs')),after:await identify(path.join(here,'fresh-replay.test.mjs')),changes:'Two imports only; all nine test bodies and after hook exact.'},fixture:{before:await identify(path.join(app,'notebook-trash-review-fixture.mjs')),after:await identify(path.join(here,'fixture.mjs')),changes:'Two runtime imports only; model semantics exact.'},observationsDestination:'NOTES_REVIEW_OUTPUT points to this owned review folder, not the author stage.'});await save('source-before.json',before);await save('preparation.json',{at:new Date().toISOString(),authenticatedStageArtifacts:215,productionBaseline28:true,retainedOriginalSource31:true,originalHelperExecutions:0,productionEdits:0});console.log(JSON.stringify({stageArtifacts:215,productionBaseline:28,originalSource:31,adapters:'imports only'}));
