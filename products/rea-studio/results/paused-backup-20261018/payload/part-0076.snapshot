        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/pyroscope/template-variables/index.md#L33-L33"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
