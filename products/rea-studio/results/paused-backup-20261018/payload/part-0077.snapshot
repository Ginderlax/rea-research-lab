    {
      "id": "grafana.candidate.e60f1850cb92bee7b844",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When overriding the default log path in the configuration file or environment variable file, Grafana still logs to the default log path until it has fully started.",
      "headingPath": [
