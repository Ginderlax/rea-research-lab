    },
    {
      "id": "grafana.candidate.d1732bb842154a09ecdd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana also assigns the user the `Admin` role of the default organization.",
      "headingPath": [
        "Configure Microsoft Entra ID OAuth authentication",
        "Register your application with Microsoft Entra ID",
        "Assign server administrator privileges"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/entraid/index.md",
        "gitBlobSha": "59fb58efe7a59116a30801f34622d72a3c482076",
