    },
    {
      "id": "grafana.candidate.06f89d9406b02bd5bfa1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For more details, please see the example in [Use variables and transformations in a correlation](../use-variables-and-transformations/).",
      "headingPath": [
        "Correlation",
        "Target query",
        "Correlation Variables"
      ],
      "source": {
        "path": "docs/sources/administration/correlations/correlation-configuration/index.md",
        "gitBlobSha": "f01ef51d6708806dc074f63e55f543c0408d633b",
        "sha256": "fb4525128741c7b02cd6822866bed335a5a601af49f7ae89cdb7775390d7a0e1",
        "lineStart": 60,
        "lineEnd": 60,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/correlations/correlation-configuration/index.md#L60-L60"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
