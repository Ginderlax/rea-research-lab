    {
      "id": "grafana.candidate.59e1edc49c314f593102",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "While the first field can be time-based and you can use a bar chart to plot time-series data, for large amounts of time-series data, we recommend that you use the [time series visualization](ref:time-series) and configure it to be displayed as bars.",
      "headingPath": [
        "Bar chart",
        "Supported data formats",
        "Example 2"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/bar-chart/index.md",
