    {
      "id": "grafana.candidate.b21f2f6337d5bfea046b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can also add to this library by exporting one of your own dashboards. For more information, refer to [Share dashboards and panels](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/visualizations/dashboards/share-dashboards-panels/).",
      "headingPath": [
        "Import dashboards",
