const raw=evidence('stdout.txt').toString('utf8');for(const[k,v]of Object.entries(attempt.summary)){const matches=[...raw.matchAll(new RegExp('^# '+k+' (\\d+(?:\\.\\d+)?)\\r?$','gm'))];assert.equal(matches.length,1);assert.equal(Number(matches[0][1]),v);}const failedNames=raw.split(/\r?\n/).filter(s=>/^not ok \d+ - /.test(s));assert.deepEqual(failedNames,['not ok 1 - archive HTTP file creation, ZIP validation and extraction persist through host restarts','not ok 2 - stored and deflated ZIP files preserve binary, UTF-8, empty files and directories']);const failureMessage='Native Windows source metadata is unavailable or invalid; archive creation was refused.';assert(raw.includes(failureMessage));const failuresExcerpt=raw.slice(0,raw.indexOf('# Subtest: ZIP parser validates CRC'));assert(failuresExcerpt.includes('duration_ms: 15798.2349')&&failuresExcerpt.includes('duration_ms: 15590.5217'));const priorFullRoot=path.join(work,'cloud-verification-backups/run-38930461121/artifact-12059751864/readable-evidence');assert.deepEqual(beforeBytes,read(priorFullRoot,'source-before.json'));const priorAttemptBytes=read(priorFullRoot,'attempt-validation.json'),priorAttempt=JSON.parse(priorAttemptBytes);assert.equal(priorAttempt.status,'passed');assert.equal(priorAttempt.summary.tests,1100);assert.equal(priorAttempt.summary.pass,1100);assert.equal(priorAttempt.sourceFiles,798);assert.equal(priorAttempt.sourceStable,true);
const workflow=JSON.parse(evidence('workflow-attempt.json'));assert.equal(workflow.schema,'rea-cloud-full-oracle-workflow-attempt/v1');assert.equal(workflow.runId,run);assert.equal(workflow.runAttempt,'1');assert.equal(workflow.sourceCommit,tested);assert.equal(workflow.runnerEnvironment,'github-hosted');for(const n of ['checkoutOutcome','compositionOutcome','flowVaultOutcome','archiveOutcome','bsdtarOutcome','bsdtarSmokeOutcome','additionalOutcome','oraclePostcheckOutcome'])assert.equal(workflow[n],'success');assert.equal(workflow.testOutcome,'failure');assert.equal(workflow.statusBeforePackaging,'failure');assert.equal(workflow.productAcceptancePreclaimed,false);
