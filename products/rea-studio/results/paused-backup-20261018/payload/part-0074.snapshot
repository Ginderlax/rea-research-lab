        "lineStart": 17,
        "lineEnd": 17,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/user-management/server-user-management/add-remove-user-to-org/index.md#L17-L17"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.3ff6d58bb0f07823ad69",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Add a user to an organization when you want the user to have access to organization resources such as dashboards, data sources, and playlists. A user must belong to at least one organization.",
      "headingPath": [
        "Add or remove a user in an organization",
        "Add a user to an organization"
      ],
      "source": {
        "path": "docs/sources/administration/user-management/server-user-management/add-remove-user-to-org/index.md",
        "gitBlobSha": "b785940f96fccc2066f07370d7379998a9ac9a1f",
