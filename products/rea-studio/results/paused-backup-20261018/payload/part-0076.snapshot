    {
      "id": "grafana.candidate.46e50e8b5764a8b3dec1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The query editor includes a **Generated SQL** link that appears after you run a query while editing a panel. Click this link to view the raw interpolated SQL that Grafana executed, including any macros that were expanded during query processing.",
      "headingPath": [
        "Microsoft SQL Server query editor",
        "Macros",
        "View the interpolated query"
      ],
      "source": {
