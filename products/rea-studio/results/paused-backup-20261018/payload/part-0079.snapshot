    {
      "id": "grafana.candidate.33055b19158cda6a53b0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To help you get started with Grafana, we’ve launched a brand new tutorials platform. We’ll continue to expand the platform with more tutorials, but here are some of the ones you can try out now:",
      "headingPath": [
        "What's new in Grafana v7.0",
        "New tutorials"
