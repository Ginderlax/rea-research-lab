    {
      "id": "grafana.candidate.022677d4d5ffb7982619",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can write raw InfluxQL queries by switching to raw query mode. Click the pencil in the upper right of the query editor to switch modes. When you switch to visual editor mode, any changes made in raw query mode are lost.",
      "headingPath": [
        "InfluxDB query editor",
