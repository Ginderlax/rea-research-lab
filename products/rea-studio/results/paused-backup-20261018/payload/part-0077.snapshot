    {
      "id": "grafana.candidate.66419ffa64e2f9a0703c",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Add `use_refresh_token = true` to `[auth.generic_oauth]` configuration.",
      "headingPath": [
