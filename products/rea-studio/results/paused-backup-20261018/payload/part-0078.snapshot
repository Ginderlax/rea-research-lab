    {
      "id": "grafana.candidate.7e3f9272c3d45877125e",
      "syntaxRole": "table-row",
      "sourceText": "| 3         | Michael | Physics          | PHYS101  | B     |",
      "headingPath": [
        "Transform data",
        "Transformation functions",
        "Join by field",
        "Inner join (for Time Series or SQL-like data)"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/transform-data/index.md",
        "gitBlobSha": "9cd072609170b1783ea50740845dd11e18b0fede",
        "sha256": "73ae12b953aaf13c6df7b5a072cc18677d57c977343a108001752487a81b2800",
        "lineStart": 899,
        "lineEnd": 899,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/panels-visualizations/query-transform-data/transform-data/index.md#L899-L899"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
