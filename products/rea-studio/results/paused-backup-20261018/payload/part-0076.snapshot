        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.86b04cd047c6863fcc09",
      "syntaxRole": "table-row",
      "sourceText": "| `$__timeFrom()`                                        | Returns the start of the current time range. Example: `'2017-04-21T05:01:17Z'`                                                                                                                                                             |",
      "headingPath": [
        "Microsoft SQL Server query editor",
        "Macros"
      ],
      "source": {
