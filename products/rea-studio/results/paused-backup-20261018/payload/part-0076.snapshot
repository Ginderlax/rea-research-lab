    {
      "id": "grafana.candidate.b3e50cac0df166879767",
      "syntaxRole": "table-row",
      "sourceText": "| Option          | Description                                                                                                                                                                                                                |",
      "headingPath": [
        "Query profile data",
        "Pyroscope query editor",
        "Query options"
      ],
      "source": {
        "path": "docs/sources/datasources/pyroscope/query-editor/index.md",
        "gitBlobSha": "f610ea6b5c725af436b9ddfad56ce462b258b8f0",
        "sha256": "c2bb15fd3956e70aee467819618adca7470b3f5b2a1f9f22afee217306b82382",
        "lineStart": 115,
        "lineEnd": 115,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/pyroscope/query-editor/index.md#L115-L115"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
