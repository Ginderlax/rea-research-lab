    {
      "id": "grafana.candidate.d15d3ba96d15c801bd34",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The rule definition must return that single value, either from an instant query or a range query combined with a **Reduce** expression.",
      "headingPath": [
