    {
      "id": "grafana.candidate.7cec363a6898c46cf0c2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The host for the server to listen on. If your machine has more than one network interface, you can use this setting to expose the Grafana service on only one network interface and not have it available on others, such as the loopback interface. An empty value is equivalent to setting the value to `0.0.0.0`, which means the Grafana service binds to all interfaces.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[server]`",
        "`http_addr`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
