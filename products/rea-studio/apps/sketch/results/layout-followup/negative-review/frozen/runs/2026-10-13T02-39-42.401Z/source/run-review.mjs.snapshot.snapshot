import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{spawn}from'node:child_process';
const here=import.meta.dirname,stage=path.resolve(here,'../sketch-alignment-next'),repo=path.resolve(here,'../../outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),tests=process.argv.slice(2);assert(tests.length&&tests.every(x=>/^[\w-]+\.test\.mjs$/.test(x)));const dir=path.join(here,'runs',new Date().toISOString().replace(/[:]/g,'-'));await fs.mkdir(dir,{recursive:true});
async function authenticate(){const mb=await fs.readFile(path.join(stage,'freeze-manifest.json'));assert.equal(sha(mb),'4684a6dffad102c461531476d4c24ad8b8eb5783b226aad9bbf82e2b81e0f2c7');const m=JSON.parse(mb);for(const r of m.records){const b=await fs.readFile(path.join(stage,r.path));assert.equal(b.length,r.bytes,r.path);assert.equal(sha(b),r.sha256,r.path);}const baseline=JSON.parse(await fs.readFile(path.join(here,'source-baseline.json.snapshot')));for(const r of baseline){const b=await fs.readFile(path.join(repo,r.path));assert.equal(b.length,r.bytes,r.path);assert.equal(sha(b),r.sha256,r.path);}return{at:new Date().toISOString(),candidateFiles:m.files,candidateManifestSHA256:sha(mb),productionBaseline14:baseline};}
const before=await authenticate(),ownedFiles=['run-review.mjs','fixtures.mjs','original-oracle.mjs',...tests];if(tests.includes('ui-review.test.mjs'))ownedFiles.push('ui-fixture.mjs');const source=[];for(const p of ownedFiles){const b=await fs.readFile(path.join(here,p));await fs.mkdir(path.dirname(path.join(dir,'source',p+'.snapshot')),{recursive:true});await fs.writeFile(path.join(dir,'source',p+'.snapshot'),b,{flag:'wx'});source.push({path:p,bytes:b.length,sha256:sha(b)});}await fs.writeFile(path.join(dir,'before.json'),JSON.stringify({before,source},null,2)+'\n');const out=await fs.open(path.join(dir,'stdout.txt'),'wx'),err=await fs.open(path.join(dir,'stderr.txt'),'wx'),child=spawn(process.execPath,['--test','--test-concurrency=1',...tests],{cwd:here,env:{...process.env,SKETCH_REVIEW_OBSERVATIONS:path.join(dir,'original-observations.json'),SKETCH_UI_OBSERVATIONS:path.join(dir,'ui-observations.json')},stdio:['ignore',out.fd,err.fd]}),timer=setTimeout(()=>child.kill(),30000),status=await new Promise((resolve,reject)=>{child.once('error',reject);child.once('close',(code,signal)=>resolve({code,signal}));});clearTimeout(timer);await out.close();await err.close();const after=await authenticate();for(const r of source)assert.equal(sha(await fs.readFile(path.join(here,r.path))),r.sha256);const record={schema:'rea-sketch-alignment-independent-run/v1',tests,status,node:process.version,executable:process.execPath,before,after,source,sourceStable:true,originalGUI:0,benchmarks:0,timeoutMs:30000};await fs.writeFile(path.join(dir,'run.json'),JSON.stringify(record,null,2)+'\n');console.log(JSON.stringify({directory:path.relative(here,dir),...status,sourceStable:true}));process.exitCode=status.code??1;
