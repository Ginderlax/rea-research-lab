import fs from 'node:fs';import path from 'node:path';import crypto from 'node:crypto';import assert from 'node:assert/strict';
const base=path.resolve(import.meta.dirname,'..'),lab=path.join(base,'outputs/rea-research-lab'),plan=path.join(base,'work/editor-save-publication-plan'),out=path.join(base,'work/editor-save-production-installation'),prefix='products/rea-studio/results/editor-save-followup';const sha=b=>crypto.createHash('sha256').update(b).digest('hex'),read=p=>JSON.parse(fs.readFileSync(p));
const checked=[],copies=[],installed=[];function exact(p,r){const b=fs.readFileSync(p);assert.equal(b.length,r.bytes,p);assert.equal(sha(b),r.sha256,p);return b;}function remember(p,r){exact(p,r);checked.push({absolute:p,...r});}
function write(p,b){if(fs.existsSync(p)){assert.deepEqual(fs.readFileSync(p),b,p);return;}fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,b,{flag:'wx'});}
function publish(source,r,dest){assert.ok(dest.endsWith('.snapshot'));assert.ok(!dest.split('/').includes('..')&&!dest.split('/').includes('.local'));const b=exact(path.join(source,r.path??r.sourcePath),r);assert.ok(!(b[0]===0x4d&&b[1]===0x5a));assert.ok(!(b[0]===0x50&&b[1]===0x4b));write(path.join(lab,dest),b);copies.push({sourceRoot:path.relative(base,source).replaceAll('\\','/'),sourcePath:r.path??r.sourcePath,path:dest,bytes:b.length,sha256:sha(b)});}
function manifest(root,name,hash,count){const b=fs.readFileSync(path.join(root,name));assert.equal(sha(b),hash);const m=JSON.parse(b);assert.equal(Object.keys(m.inventory).length,count);for(const[n,r]of Object.entries(m.inventory))remember(path.join(root,n),r);remember(path.join(root,name),{bytes:b.length,sha256:sha(b)});return m;}
fs.mkdirSync(out,{recursive:true});
try{
 const pm=manifest(plan,'freeze-manifest.json','3df49c5e2c5b28433876d8cbd759eed74375031d92db8aa43af761fbada32c91',21),map=read(path.join(plan,'selected-file-map.json'));
 for(const[n,r]of Object.entries(pm.inventory))publish(plan,{path:n,...r},`${prefix}/publication-plan/frozen/${n}.snapshot`);const pmb=fs.readFileSync(path.join(plan,'freeze-manifest.json'));publish(plan,{path:'freeze-manifest.json',bytes:pmb.length,sha256:sha(pmb)},`${prefix}/publication-plan/frozen/freeze-manifest.json.snapshot`);
 for(const e of map.epochs)manifest(path.join(base,'work',e.folder),e.manifest.path,e.manifestSha,e.count);
 assert.equal(map.payload.length,516);for(const r of map.payload)publish(path.join(base,r.sourceRoot),r,r.publicPath);assert.equal(new Set(map.payload.map(r=>r.publicPath)).size,174);
 for(const r of map.currentProductionSource)exact(path.join(lab,r.path),r);
 const targets=[...map.install.map(r=>({...r,proposedSource:path.join(base,r.source)})),...map.adapters.map(r=>({...r,existing:null,proposedSource:path.join(plan,r.proposedPath)}))];assert.equal(targets.length,8);
 for(const r of targets){exact(r.proposedSource,r);if(r.sourceIdentity)exact(path.join(base,r.source),r.sourceIdentity);if(r.existing)exact(path.join(lab,r.destination),r.existing);else assert.equal(fs.existsSync(path.join(lab,r.destination)),false);}
 for(const r of targets){const b=exact(r.proposedSource,r);fs.writeFileSync(path.join(lab,r.destination),b);exact(path.join(lab,r.destination),r);installed.push({destination:r.destination,source:r.source,sourceIdentity:r.sourceIdentity??{bytes:r.bytes,sha256:r.sha256},before:r.existing,after:{bytes:r.bytes,sha256:r.sha256},transforms:r.transforms??[],testBodiesUnchanged:r.testBodiesUnchanged??null});}
 for(const r of checked)exact(r.absolute,r);
 const receipt={schema:'rea-editor-reviewed-save-production-installation/v1',at:new Date().toISOString(),acceptedCorrectionManifestSHA256:'1db6423dd0a83f24829145258dee7426b3cd8308453e94066bc828b2389eb4cf',independentReviewManifestSHA256:'e5b770d76577639cdbffbff2df0fb1a2e7f0c6ad28b1407cc668aa9226cef1fa',sourceOnlyPlanManifestSHA256:'3df49c5e2c5b28433876d8cbd759eed74375031d92db8aa43af761fbada32c91',historicalPathRecords:516,uniquePublicEvidenceObjects:174,newObjectsSpecifiedByPlan:101,reusedObjectsSpecifiedByPlan:73,copies,installed,allSourceBytesStableBeforeAfter:true,sourceFingerprintsAuthenticated:checked.length,behaviorTestsRunDuringCopy:0,prospectiveCurrentEditorTests:78,actualSelectorFiles:15,oldPlanProseFileCountDiagnostic:'Frozen21 prose says16; both authenticated selector and test-census contain15.78 registration count unchanged; no behavioral failure.',fullProductParity:false,universalSuperiority:false};
 const rb=Buffer.from(JSON.stringify(receipt,null,2)+'\n');fs.writeFileSync(path.join(out,'installation.json'),rb,{flag:'wx'});fs.copyFileSync(import.meta.filename,path.join(out,'collector.mjs.snapshot'));
 write(path.join(lab,prefix,'production-installation/installation.json.snapshot'),rb);write(path.join(lab,prefix,'production-installation/collector.mjs.snapshot'),fs.readFileSync(import.meta.filename));for(const n of ['installation.json','collector.mjs.snapshot'])write(path.join(lab,prefix,'prior-search-installation',n+'.snapshot'),fs.readFileSync(path.join(base,'work/editor-search-production-installation',n)));
 console.log(JSON.stringify({pass:true,installed:8,epochPathRecords:516,uniqueEvidenceObjects:174,selectorFiles:15,testsRun:0,receiptSHA256:sha(rb)}));
}catch(error){fs.writeFileSync(path.join(out,'failure-'+Date.now()+'.json'),JSON.stringify({at:new Date().toISOString(),error:String(error),stack:error.stack,installed,copies},null,2)+'\n');throw error;}
