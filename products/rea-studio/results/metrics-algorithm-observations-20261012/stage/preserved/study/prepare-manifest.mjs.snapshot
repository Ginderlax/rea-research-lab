import fs from 'node:fs/promises';
import path from 'node:path';
import assert from 'node:assert/strict';
import {here,sha,authenticateOriginal} from './authenticate-original.mjs';
const authority=await authenticateOriginal(),old=JSON.parse(await fs.readFile(path.join(here,'preserved/previous-memory-preflight.control.json'))),bindingBytes=await fs.readFile(path.join(here,'preserved/algorithm-binding.json')),binding=JSON.parse(bindingBytes);
assert.deepEqual(authority.files,old.authority.files);assert.equal(authority.archiveSHA256,old.authority.archiveSHA256);assert.equal(authority.dependencyArchiveSHA256,old.authority.dependencyArchiveSHA256);assert.equal(Object.keys(authority.files).length,6);
const entry=path.join(here,'candidate-algorithm.mjs'),helper=path.join(here,'selector-algorithm.mjs'),baseline=path.join(here,'candidate-baseline.mjs');
assert.equal(sha(await fs.readFile(entry)),binding.candidate.entrySHA256);assert.equal(sha(await fs.readFile(helper)),binding.candidate.helperSHA256);assert.equal(sha(await fs.readFile(baseline)),binding.candidate.baselineSHA256);
const implementations={original:authority,baseline:{entry:baseline,format:'esm',files:{[baseline]:binding.candidate.baselineSHA256}},candidate:{entry,format:'esm',files:{[entry]:binding.candidate.entrySHA256,[helper]:binding.candidate.helperSHA256},nativeImportGraph:{[entry]:[helper],[helper]:[]}}};
const runtime={execPath:process.execPath,version:process.version,platform:process.platform,arch:process.arch,versions:process.versions,executableSHA256:sha(await fs.readFile(process.execPath))};assert.deepEqual(runtime,old.runtime);
for(const fixture of Object.values(old.expectedFiles)){assert.equal(sha(await fs.readFile(path.join(here,fixture.inputPath))),fixture.inputFileSHA256);assert.equal(sha(await fs.readFile(path.join(here,fixture.path))),fixture.sha256);}
assert.equal(sha(await fs.readFile(path.join(here,'canonical.mjs'))),old.canonicalSourceSHA256);assert.equal(sha(await fs.readFile(path.join(here,'workloads.mjs'))),old.workloadSourceSHA256);
const correctnessBytes=await fs.readFile(path.join(here,'preserved/correctness-provenance/algorithm-budget.graph.jsonl'));assert.equal(sha(correctnessBytes),'f5cc3c4486a3728c9f568251a86ea80c3866ec62c4d454dcafffc989232e43ae');assert.equal(correctnessBytes.length,4961892);
const originalCopies=[];for(const[source,digest]of Object.entries(authority.files)){const bytes=await fs.readFile(source);assert.equal(sha(bytes),digest);const target='preserved/original-runtime/'+path.basename(source);await fs.mkdir(path.dirname(path.join(here,target)),{recursive:true});try{await fs.writeFile(path.join(here,target),bytes,{flag:'wx'});}catch(error){if(error.code!=='EEXIST')throw error;assert.equal(sha(await fs.readFile(path.join(here,target))),digest);}originalCopies.push({source,path:target,bytes:bytes.length,sha256:digest});}
const artifactRoot=path.resolve(path.dirname(authority.entry),'../../../..'),archives=[];for(const[name,digest]of [['release.tgz',authority.archiveSHA256],['lodash-4.17.23.tgz',authority.dependencyArchiveSHA256]]){const source=path.join(artifactRoot,name),bytes=await fs.readFile(source);assert.equal(sha(bytes),digest);archives.push({source,bytes:bytes.length,sha256:digest,localOnlyOriginalArchive:true,copiedToStage:false});}
await fs.writeFile(path.join(here,'original-provenance.json'),JSON.stringify({schemaVersion:1,checkedAt:new Date().toISOString(),authority,originalCopies,archives,originalSourcesAreEvidenceOnly:true,timingMeasurementRun:false,memoryMeasurementRun:false},null,2)+'\n',{flag:'wx'});
const manifest={...old,checkedAt:new Date().toISOString(),authority,runtime,implementations,fullSemanticReceipt:'preserved/algorithm-binding.json',fullSemanticReceiptSHA256:sha(bindingBytes),selectorSemanticBinding:'Frozen 88-file algorithm candidate: exact full/held-out/cache/adversarial acceptance and separate root review; no new full replay in measurement readiness.',correctnessProvenanceOnly:{path:'preserved/correctness-provenance/algorithm-budget.graph.jsonl',bytes:correctnessBytes.length,sha256:sha(correctnessBytes),inputs:66,notAMeasurementWorkload:true},originalSourcesPreserved:'original-provenance.json',preflightOnly:true,freshOriginalCalculations:0,originalCachedReads:0,expectedPacketsCopiedFromPriorAuthenticOriginalAndWillBeRechecked:true,warmupCallsExecuted:0,transientCallsExecuted:0,retentionCallsExecuted:0,timingMeasurementRun:false,memoryMeasurementRun:false,profileRun:false,performanceEstablished:false,fullProductComplete:false,universalSuperiorityEstablished:false};
assert.deepEqual(manifest.expectedFiles,old.expectedFiles);assert.deepEqual(manifest.limits,old.limits);
await fs.writeFile(path.join(here,'memory-preflight.control.json'),JSON.stringify(manifest,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:'prepared',cases:Object.keys(manifest.expectedFiles),sourceFiles:Object.fromEntries(Object.entries(implementations).map(([role,row])=>[role,Object.keys(row.files).length])),originalArchiveCopies:0,manifestSHA256:sha(await fs.readFile(path.join(here,'memory-preflight.control.json'))),measurementRun:false}));
