    },
    {
      "id": "grafana.candidate.445829677a8afa88f7be",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When the user selects \"All\", the first condition is true and all rows match. When specific values are selected, the `IN` clause filters normally.",
      "headingPath": [
        "Microsoft SQL Server template variables",
        "Handle the \"All\" option in SQL queries",
        "Pattern: Conditional `WHERE` clause with \"All\""
      ],
