        "lineStart": 36,
        "lineEnd": 36,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/elasticsearch/query-editor/index.md#L36-L36"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
