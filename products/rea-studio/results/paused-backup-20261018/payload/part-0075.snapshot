    },
    {
      "id": "grafana.candidate.a6ea93364e0e44a8312d",
      "syntaxRole": "list-item",
      "sourceText": "- [Previous dashboard previews documentation](https://grafana.com/docs/grafana/v9.5/search/dashboard-previews/)",
      "headingPath": [
        "Breaking changes in Grafana v10.0",
