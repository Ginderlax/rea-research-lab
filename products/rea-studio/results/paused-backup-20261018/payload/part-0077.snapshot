    {
      "id": "grafana.candidate.4904fe13a56a8bcae5b3",
      "syntaxRole": "list-item",
      "sourceText": "- `grafana/grafana-enterprise` is the image to run",
      "headingPath": [
        "Run Grafana Docker image",
        "Run Grafana via Docker CLI"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/installation/docker/index.md",
        "gitBlobSha": "4775409c5b7e8b32342ff84f543f3e11c51aa950",
        "sha256": "d22215b5401d2dbb28e4e78cd75823626dbed0af66963f21c05477a85dc715a9",
        "lineStart": 52,
        "lineEnd": 52,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/installation/docker/index.md#L52-L52"
      },
