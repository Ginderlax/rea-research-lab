import fs from 'node:fs/promises';import {spawn} from 'node:child_process';import {createHash} from 'node:crypto';
const stage=new URL('../notes-trash-next/',import.meta.url),hash=b=>createHash('sha256').update(b).digest('hex');
async function auth(){const m=JSON.parse(await fs.readFile(new URL('preservation-manifest.json',stage)));for(const r of m.records){const b=await fs.readFile(new URL(r.path,stage));if(b.length!==r.bytes||hash(b)!==r.sha256)throw new Error('Stage changed '+r.path);}}
await auth();const startedAt=new Date().toISOString();await fs.mkdir(new URL('./bounds-corrected/',import.meta.url),{recursive:true});
const result=await new Promise((resolve,reject)=>{const env={...process.env,NOTES_REVIEW_OUTPUT:'./bounds-corrected/observations/'};delete env.NODE_TEST_CONTEXT;const c=spawn(process.execPath,['--test','--test-reporter=tap','--test-name-pattern=invalid deep hierarchy',new URL('./review.test.mjs',import.meta.url).pathname.replace(/^\/(\w:)/,'$1')],{windowsHide:true,env,stdio:['ignore','pipe','pipe']});const logs={stdout:[],stderr:[]};const timer=setTimeout(()=>c.kill(),30000);for(const k of['stdout','stderr'])c[k].on('data',b=>logs[k].push(b));c.on('error',reject);c.on('close',(code,signal)=>{clearTimeout(timer);resolve({code,signal,stdout:Buffer.concat(logs.stdout),stderr:Buffer.concat(logs.stderr)});});});
for(const k of['stdout','stderr'])await fs.writeFile(new URL('./bounds-corrected/'+k+'.txt',import.meta.url),result[k]);await auth();await fs.writeFile(new URL('./bounds-corrected/run.json',import.meta.url),JSON.stringify({startedAt,completedAt:new Date().toISOString(),exitCode:result.code,signal:result.signal,stageStable:true,scope:'Only the previously rejected but overly specific bounds assertion rerun; no original helpers and no behavioral replay of other probes.'},null,2)+'\n');console.log(result.stdout.toString());process.exitCode=result.code;
