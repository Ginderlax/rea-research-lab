    {
      "id": "grafana.candidate.dfcc9aefe3a2e9c7eb24",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The pending period is the period in which an alert rule can be in breach of the condition until it fires.",
