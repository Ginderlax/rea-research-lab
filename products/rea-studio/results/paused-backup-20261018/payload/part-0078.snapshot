    {
      "id": "grafana.candidate.a08fde5cfd0bec13149b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you installed Grafana using the `deb` or `rpm` packages, then your configuration file is located at `/etc/grafana/grafana.ini`. This path is specified in the Grafana `init.d` script using `--config` file parameter.",
      "headingPath": [
        "Back up Grafana",
        "Back up the Grafana configuration file"
      ],
      "source": {
