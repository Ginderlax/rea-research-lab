    },
    {
      "id": "grafana.candidate.20f1506b4e37d10c5bf4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana provides a variety of pre-built dashboard templates that you can use to quickly set up visualizations for your data. These dashboards use sample data, which you can replace with your own data, making it easier to get started with monitoring and analysis.",
      "headingPath": [
        "Create dashboards from templates and suggestions",
        "Dashboard templates"
      ],
