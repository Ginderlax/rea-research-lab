a=json.loads(ab);assert a['sourceCommit']==HEAD and a['sourceOnly'] and not a['applicationInstallationPerformed'] and not a['candidateSourcesAuthored']
for r in a['files']:pin(read(B/r['path']),r)
i=json.loads(read(S/'source-inventory.json'));assert i['sourceCommit']==HEAD and i['currentInstalledNotesFiles']==32 and i['futureNotesFiles']==36 and i['futureEligibleNotesFiles']==34
bundle=json.loads(git('products/rea-studio/experiments/notes-new-todo/bundle.json'));assert i['transitions']==bundle['transitions'] and i['baseline32']==bundle['baselineNotesSources'] and i['future36']==bundle['composedNotesSources']
for r in i['baseline32']:pin(git(r['path']),r)
for r in i['protectedSourcePins']:pin(git(r['path']),r)
for r in i['future60Proof']['rows']:
    t=next((t for t in i['transitions']if t['path']==r['path']),None);pin(git(t['afterImage']['path']if t else r['path']),r)
f=i['future60Proof'];assert f['distinctPaths']==len(f['rows'])==len({r['path']for r in f['rows']})==60 and f['rawSourceBytes']==sum(r['bytes']for r in f['rows'])==650028
assert f['fileLimit']==64 and f['aggregateLimit']==8388608 and f['individualLimit']==262144 and f['maxIndividualBytes']<=262144
assert {k:v['rows']for k,v in f['groups'].items()}=={'current36':36,'payload17':17,'historicalOriginalDependencies':2,'sharedHostSources':3,'frozenBundle':1,'frozenWorkflow':1}
old=constant(git('scripts/editor-vault-proof-migration.mjs'),'notesSourceTransition');assert len(old['objects'])==52 and old['objects']==i['legacy52Proof']['objects']
for row in old['objects']:pin(git(row['path']),row['stored'])
assert sum(row['stored']['bytes']for row in old['objects'])==i['legacy52Proof']['rawStoredBytes']==1077301
producer=git('scripts/verify-cloud-publication.mjs');pr=constant(producer,'NOTES_REVIEWED');tools=constant(producer,'NOTES_INSTALLED_TOOLING')
assert set(pr)=={r['path']for r in old['objects']}and len(pr)==52 and len(tools)==4
assert i['legacy56PublicationEnvelope']['tooling']==tools
assert sum(v[0]for v in pr.values())+sum(v[0]for v in tools.values())==i['legacy56PublicationEnvelope']['rawSourceBytes']==1243634
for n,p in {**pr,**tools}.items():assert ident(git(n))=={'bytes':p[0],'sha256':p[1]}
assert len({r['path']for r in old['sources']}|{r['path']for r in bundle['transitions']})==12
wf=bundle['workflow'];assert wf['bytes']==14958 and sum(r['bytes']for r in f['rows']if r['path']!=wf['path'])==635070
