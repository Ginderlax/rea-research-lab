    {
      "id": "grafana.candidate.c8e649ffcd9d854912a6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Data sources added through [provisioning](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/administration/provisioning/#data-sources), and Grafana-managed data sources on Grafana Cloud, are read-only in the UI. You can't change their configuration from the data source settings page, regardless of your data source permissions. This is separate from [data source permissions](#data-source-permissions): no permission level makes a provisioned data source editable in the UI. A read-only data source's settings page shows only a **Test** button instead of **Save & test**.",
      "headingPath": [
        "Data source management",
        "Provisioned data sources"
      ],
      "source": {
        "path": "docs/sources/administration/data-source-management/_index.md",
        "gitBlobSha": "48e0cd06582ded6e67389dc4fe82510ea7271f7b",
