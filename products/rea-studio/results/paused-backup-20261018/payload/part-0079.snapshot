    {
      "id": "grafana.candidate.a164bf4634ff7263c707",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Sometimes profile stacks contain lots of levels with similar repeating items, for example long stacks of framework code that usually isn't of interest but takes up a lot of visual real estate. With this feature, instead of rendering all of the similar items we render only one and allow to expand those collapsed items on demand.",
      "headingPath": [
        "What’s new in Grafana v10.3",
        "Profiles",
        "FlameGraph: Collapsing similar items in the graph\\*"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-3.md",
        "gitBlobSha": "e43fdcd331e25519da2fbdea223ad59ec4f7ad4c",
