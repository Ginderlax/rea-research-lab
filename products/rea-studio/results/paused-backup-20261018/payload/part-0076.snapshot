      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b7a36e4f397a73aec627",
      "syntaxRole": "procedural-step",
      "sourceText": "1. In Explore, use the data source picker in the top bar to switch between configured Tempo data sources.",
      "headingPath": [
        "Troubleshoot Tempo data source issues",
        "Other common issues",
        "Switching between multiple Tempo instances"
      ],
      "source": {
