    {
      "id": "grafana.candidate.600c30e174372d4dcb74",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set the mode of the gradient fill. Fill gradient is based on the line color. To change the color, use the standard [color scheme](ref:color-scheme) field option.",
