    {
      "id": "grafana.candidate.91881f0c996194cee251",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana provides a query editor for Elasticsearch. Elasticsearch queries are in Lucene format. For more information about query syntax, refer to [Lucene query syntax](https://www.elastic.co/guide/en/kibana/current/lucene-query.html) and [Query string syntax](https://www.elastic.co/guide/en/elasticsearch/reference/current/query-dsl-query-string-query.html#query-string-syntax).",
      "headingPath": [
        "Elasticsearch query editor"
      ],
      "source": {
        "path": "docs/sources/datasources/elasticsearch/query-editor/index.md",
        "gitBlobSha": "d0f25c1cab3b4fcd5e05cce9a8f8cfccaf17ea0b",
        "sha256": "dba24f1ec9d38a3676186d27734a8a1f8ecc07be9c656f1bfb2293dcf907c726",
        "lineStart": 27,
        "lineEnd": 28,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/elasticsearch/query-editor/index.md#L27-L28"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.18984c70da31b75719b8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When composing Lucene queries, ensure that you use uppercase boolean operators: `AND`, `OR`, and `NOT`. Lowercase versions of these operators are not supported by the Lucene query syntax.",
      "headingPath": [
        "Elasticsearch query editor"
      ],
      "source": {
        "path": "docs/sources/datasources/elasticsearch/query-editor/index.md",
        "gitBlobSha": "d0f25c1cab3b4fcd5e05cce9a8f8cfccaf17ea0b",
        "sha256": "dba24f1ec9d38a3676186d27734a8a1f8ecc07be9c656f1bfb2293dcf907c726",
        "lineStart": 31,
        "lineEnd": 31,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/elasticsearch/query-editor/index.md#L31-L31"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.aa65e5f41dc1c88e7092",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For general documentation on querying data sources in Grafana, including options and functions common to all query editors, refer to [Query and transform data](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/panels-visualizations/query-transform-data/).",
      "headingPath": [
        "Elasticsearch query editor"
      ],
      "source": {
        "path": "docs/sources/datasources/elasticsearch/query-editor/index.md",
