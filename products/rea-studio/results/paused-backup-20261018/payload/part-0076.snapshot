    {
      "id": "grafana.candidate.fbbf0f918fe0ed4985e5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Cause:** The connection to Tempo timed out before receiving a response. This can happen when network latency is high, Tempo is overloaded, or an intermediary device (load balancer, proxy) terminates the connection before Tempo responds.",
      "headingPath": [
        "Troubleshoot Tempo data source issues",
        "Connection errors",
        "Connection timeout"
      ],
      "source": {
