import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,workspace=path.resolve(here,'../..'),sha=b=>createHash('sha256').update(b).digest('hex'),read=async n=>JSON.parse(await fs.readFile(path.join(here,n))),write=(n,v)=>fs.writeFile(path.join(here,n),JSON.stringify(v,null,2)+'\n',{flag:'wx'}),steps=await read('browser-steps.json'),step=n=>{const r=steps.find(r=>r.label===n);assert(r,n);return r;},obs=async n=>read('observation-'+n+'.json'),final=await obs('before-close'),checks=[];
function check(name,fn){fn();checks.push({name,passed:true});}const sameDraft=(a,b)=>{for(const k of['title','body','tags','notebook'])assert.equal(a.visible[k],b.visible[k],k);},control=(s,name)=>s.visible.controls.find(r=>r.text===name);
check('Actual browser attachment download matches all owned fixture bytes',()=>{});const roundtrip=await read('attachment-roundtrip.json');assert(roundtrip.browserDownloadedFileVerified);assert.equal(roundtrip.bytes,63);assert.equal(sha(await fs.readFile(path.join(here,'downloaded-attachment.txt'))),roundtrip.sha256);
const beforeCancel=await obs('before-cancel'),afterEscape=await obs('after-escape');check('Inline Escape, Tab wrap and restored focus with zero requests',()=>{assert.equal(beforeCancel.forwarded.length,afterEscape.forwarded.length);assert.equal(beforeCancel.persisted.sha256,afterEscape.persisted.sha256);sameDraft(step('before-cancel'),step('after-escape'));assert.equal(step('dialog-tab-to-confirm').visible.focus.text,'Confirm move to trash');assert.equal(step('dialog-tab-to-cancel').visible.focus.text,'Cancel');assert.equal(step('after-escape').visible.focus.text,'Move notebook to trash');assert.deepEqual(step('before-cancel').visible.controls,step('after-escape').visible.controls);assert.equal(step('after-escape').visible.dialogs.length,0);});
const beforeHeld=await obs('before-held-save-cancel'),afterHeld=await obs('after-held-save-cancel');check('Cancel while committed Save response held issues zero reads or mutations',()=>{assert.equal(beforeHeld.forwarded.length,afterHeld.forwarded.length);assert.equal(beforeHeld.persisted.sha256,afterHeld.persisted.sha256);assert.equal(beforeHeld.held,'save-cancel-held');sameDraft(step('save-cancel-held'),step('held-save-after-cancel'));assert(control(step('held-save-after-cancel'),'Download owned-attachment.txt (63 bytes)'));assert.equal(step('held-save-after-cancel').visible.focus.text,'Move notebook to trash');assert.equal(step('released-save-after-cancel').visible.status,'Saved revision 3.');});
check('Dirty organization refuses before requests and retains enabled draft',()=>{sameDraft(step('newer-draft-after-cancel'),step('dirty-guard'));assert.equal(step('dirty-guard').visible.dialogs.length,0);assert.equal(step('dirty-guard').visible.status,'Save your draft before changing notebook organization.');assert.equal(control(step('dirty-guard'),'Save note').disabled,false);assert.equal(final.forwarded.filter(r=>r.action&&Date.parse(r.at)>Date.parse(step('newer-draft-after-cancel').at)&&Date.parse(r.at)<=Date.parse(step('dirty-guard').at)).length,0);});
check('Subsequent browser Saves authenticate revisions and persisted reopen',()=>{const saves=final.forwarded.filter(r=>r.action==='save');assert.equal(saves.length,3);assert.deepEqual(saves.map(r=>r.input.revision),[2,3,6]);assert.deepEqual(saves.map(r=>r.response.result.revision),[3,4,7]);assert.equal(step('saved-after-cancel').visible.status,'Saved revision 4.');assert.equal(step('final-reopened-proof').visible.status,'Opened revision 7.');const persisted=Object.values(final.persisted.state.notes)[0];assert.equal(persisted.revision,7);assert.equal(persisted.deletedAt,null);assert.equal(persisted.body,step('final-reopened-proof').visible.body);assert.equal(Object.keys(final.persisted.state.resources).length,1);});
const trash=await obs('trash-after-duplicate');check('Confirmed Trash commits once; pending duplicate keys remain inert',()=>{assert.equal(trash.persisted.state.notes[Object.keys(trash.persisted.state.notes)[0]].revision,5);assert(final.forwarded.filter(r=>r.action==='notebook-trash').length===1);for(const label of['trash-pending','trash-pending-duplicate-keys']){const dialog=step(label).visible.dialogs[0];assert.equal(dialog.busy,'true');assert(dialog.buttons.every(b=>b.disabled));}assert.equal(trash.held,'trash-held');assert.equal(step('trash-committed').visible.status,'Notebook and descendants moved to trash.');assert(control(step('trash-committed'),'Save note').disabled);});
const restoreCancel=await obs('after-restore-cancel');check('Restore Cancel adds zero API calls and preserves trashed draft, attachment and focus',()=>{assert.equal(trash.persisted.sha256,restoreCancel.persisted.sha256);sameDraft(step('trash-committed'),step('restore-cancelled'));assert.equal(step('restore-cancelled').visible.focus.text,'Restore notebook');assert.deepEqual(step('trash-committed').visible.controls,step('restore-cancelled').visible.controls);assert.equal(final.forwarded.filter(r=>r.action&&Date.parse(r.at)>Date.parse(step('trash-committed').at)&&Date.parse(r.at)<=Date.parse(step('restore-cancelled').at)).length,0);});
const freshBefore=await obs('fresh-before-restore-release'),restoreBefore=await obs('restore-before-dispose');check('Committed Restore, duplicate guard and late response after actual view disposal',()=>{assert.equal(final.forwarded.filter(r=>r.action==='notebook-restore').length,1);assert.equal(restoreBefore.held,'restore-dispose-held');assert.equal(Object.values(restoreBefore.persisted.state.notes)[0].revision,6);assert.equal(Object.values(restoreBefore.persisted.state.notes)[0].deletedAt,null);assert.equal(step('disposed-pending-restore').visible.dialogs.length,0);assert.equal(step('fresh-restored-note').visible.status,'Opened revision 6.');sameDraft(step('fresh-draft-before-old-restore'),step('fresh-draft-after-old-restore'));assert.equal(step('fresh-draft-after-old-restore').visible.status,'Unsaved draft. Save to keep this note.');assert.equal(freshBefore.held,'restore-dispose-held');assert(step('restore-pending').visible.dialogs[0].buttons.every(b=>b.disabled));});
const fixtureBefore=await obs('before-attachment-fixture'),fixtureAfter=await obs('after-attachment-fixture'),fixtureIds=new Set(fixtureAfter.actual.slice(fixtureBefore.actual.length).map(r=>r.id)),browserActual=final.actual.filter(r=>r.phase==='browser'&&!fixtureIds.has(r.id));assert.equal(fixtureIds.size,3);assert.equal(browserActual.length,final.forwarded.length);for(let i=0;i<browserActual.length;i++){assert.equal(browserActual[i].method,final.forwarded[i].method);assert.equal(browserActual[i].url,final.forwarded[i].url);assert.equal(browserActual[i].status,final.forwarded[i].upstreamStatus);}assert.equal(final.holds.length,3);assert(final.holds.every(r=>r.committedBeforeHold&&r.releasedAt));assert.equal(final.held,null);assert.equal(final.armed,null);await write('accounting.json',{semanticGroups:checks.length,checks,actualHostRequests:final.actual.length,initialSeedCalls:3,attachmentFixtureCalls:3,forwardedBrowserCalls:final.forwarded.length,browserAPIRequests:final.forwarded.filter(r=>r.action).length,browserSaveRequests:3,notebookTrashRequests:1,notebookRestoreRequests:1,browserAttachmentGetRequests:1,genuineCommittedHolds:3,allResponsesReleased:true,requests:final.forwarded.map(r=>({id:r.id,url:r.url,status:r.upstreamStatus})),fixtureCallIds:[...fixtureIds],ordinaryTests:0,originalHelpers:0,originalApps:0,benchmarks:0});
const sources=await read('source-before.json');assert.deepEqual(sources,await read('source-after.json'));const authorityBefore=await read('authority-before.json'),authorityAfter=[];for(const row of authorityBefore){const dir=path.join(workspace,row.directory),bytes=await fs.readFile(path.join(dir,row.manifest));assert.equal(sha(bytes),row.sha256);const m=JSON.parse(bytes),records=m.inventory??Object.fromEntries(m.records.map(r=>[r.path,r]));for(const[p,r]of Object.entries(records)){const b=await fs.readFile(path.join(dir,p));assert.deepEqual({bytes:b.length,sha256:sha(b)},{bytes:r.bytes,sha256:r.sha256});}async function walk(d,p=''){const out=[];for(const e of await fs.readdir(d,{withFileTypes:true})){if(e.isDirectory())out.push(...await walk(path.join(d,e.name),p+e.name+'/'));else out.push(p+e.name);}return out;}assert.deepEqual((await walk(dir)).sort(),[...Object.keys(records),row.manifest].sort());authorityAfter.push(row);}await write('authority-after.json',authorityAfter);const baseline=await read('production-client-baseline.json'),productionClient=await fs.readFile(path.join(workspace,'outputs/rea-research-lab',baseline.path));assert.equal(sha(productionClient),baseline.sha256);assert.equal(productionClient.length,baseline.bytes);
const cleanup=await read('cleanup.json'),tab=await read('tab-cleanup.json');assert(cleanup.hostClosed&&cleanup.relayClosed&&cleanup.tempDataRemoved&&cleanup.sourceStable&&tab.closeResolved);const downloaded=await fs.readFile(roundtrip.source),downloadStat=await fs.stat(roundtrip.source);assert.equal(sha(downloaded),roundtrip.sha256);assert.equal(downloadStat.birthtime.toISOString(),roundtrip.createdAt);assert.equal(path.resolve(roundtrip.source),path.resolve('C:/Users/evanh/Downloads/owned-attachment.txt'));await fs.unlink(roundtrip.source);await write('download-cleanup.json',{at:new Date().toISOString(),ownedExactDownloadRemoved:true,path:roundtrip.source,sha256:roundtrip.sha256,creationTimeVerifiedBeforeRemoval:true,evidenceCopyRetained:'downloaded-attachment.txt'});
