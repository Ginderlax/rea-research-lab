    {
      "id": "grafana.candidate.716d29dc812ea9efdad4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Duration filters use the `duration` key with operators such as `=`, `>=`, `<=`, `>`, and `<`. In the visualization, users can toggle **Show all spans** to switch from the filtered view back to all spans.",
      "headingPath": [
        "Traces",
        "Configuration options",
        "Span filters options"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/traces/index.md",
