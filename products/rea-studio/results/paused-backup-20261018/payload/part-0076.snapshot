    {
      "id": "grafana.candidate.d3324735e2744116a462",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use a metric query for alerting, not a plain log query. A log query returns log lines, which Grafana can't evaluate against a threshold.",
