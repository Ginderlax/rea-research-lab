    {
      "id": "grafana.candidate.e126e55e427256d6906b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "As this is a feature currently in development, things may break. If they do, or if you have any other feedback, feel free to [open an issue](https://github.com/grafana/grafana/issues/new/choose).",
      "headingPath": [
        "Configure security hardening",
