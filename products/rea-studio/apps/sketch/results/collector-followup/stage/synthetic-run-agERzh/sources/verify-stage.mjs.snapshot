const result=await runSketchChild({args:['--test','--test-concurrency=1','--test-reporter=tap',path.join(here,'runner.test.mjs')],cwd:here,env:{...process.env,REA_SKETCH_COLLECTOR_REGRESSION_DIR:runDirectory},timeoutMs:30000,stdoutBytes:4*1024*1024,stderrBytes:1024*1024});await fs.writeFile(path.join(runDirectory,'stdout.txt'),result.stdout,{flag:'wx'});await fs.writeFile(path.join(runDirectory,'stderr.txt'),result.stderr,{flag:'wx'});
const summary=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(name=>[name,Number(result.stdout.toString('utf8').match(new RegExp(`^# ${name} (\\d+)$`,'m'))?.[1]??-1)])),sourceAfter=await fingerprints(here,sourceNames),productionAfter=await fingerprints(product,productionNames),sourceBytesStable=JSON.stringify(sourceBefore)===JSON.stringify(sourceAfter),productionBytesUnchanged=JSON.stringify(productionBefore)===JSON.stringify(productionAfter),{stdout,stderr,...execution}=result;
