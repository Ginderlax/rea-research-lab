    {
      "id": "grafana.candidate.82202dbdd026feb735bb",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Enter the same connection settings as the provisioned data source so both point at the same backend. The exact settings depend on the data source type. For a URL-based data source, use the same **URL**.",
      "headingPath": [
        "Data source management",
        "Provisioned data sources",
        "Create an editable copy of a provisioned data source"
      ],
      "source": {
        "path": "docs/sources/administration/data-source-management/_index.md",
