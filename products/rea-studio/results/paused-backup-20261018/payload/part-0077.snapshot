    },
    {
      "id": "grafana.candidate.7e4bc223f160a133bef3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can also use these environment variables to configure `client_authentication`, `client_id`, `client_secret`, `managed_identity_client_id`, and `federated_credential_audience`:",
      "headingPath": [
        "Configure Microsoft Entra ID OAuth authentication",
        "Configure the Entra ID authentication client using the Grafana configuration file",
        "Enable Entra ID OAuth in Grafana"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/entraid/index.md",
        "gitBlobSha": "59fb58efe7a59116a30801f34622d72a3c482076",
        "sha256": "1fa9334110b531d913f725ea2734e69bce32e4da352e7d5a54ddde926605b058",
        "lineStart": 305,
        "lineEnd": 305,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/entraid/index.md#L305-L305"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
