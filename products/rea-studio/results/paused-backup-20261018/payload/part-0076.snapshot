    },
    {
      "id": "grafana.candidate.3883b00efc4e93714d65",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can only use log queries as a source for annotations. Metric queries aren't supported.",
      "headingPath": [
