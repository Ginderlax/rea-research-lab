    {
      "id": "grafana.candidate.c917826d8c51f042afde",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set to `true` to disable [brute force login protection](https://cheatsheetseries.owasp.org/cheatsheets/Authentication_Cheat_Sheet.html#account-lockout). Default is `false`. Login is blocked for five minutes if all login attempts are spent within a 5 minute window.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[security]`",
        "`disable_brute_force_login_protection`"
      ],
      "source": {
