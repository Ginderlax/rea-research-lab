    {
      "id": "grafana.candidate.07945912d4d4f1349d7a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Element snapping and alignment only works when the canvas is not zoomed in.",
      "headingPath": [
