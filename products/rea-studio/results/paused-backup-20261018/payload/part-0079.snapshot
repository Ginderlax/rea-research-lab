    {
      "id": "grafana.candidate.689802eabae272983bb8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you move a connection so that it's almost a right angle or a straight line, the connection snaps into that angle or into a straight line.",
      "headingPath": [
        "Canvas",
        "Connections",
