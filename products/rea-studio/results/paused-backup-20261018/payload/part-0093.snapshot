      "current_app_status": "implemented-local-subset",
      "current_app_scope": "Basic entry fields, group paths and dates are editable; native import/export retains group and entry UUIDs, nested groups, custom strings, history, tags, custom data, public metadata and auto-type settings in preserved XML. New/edited paths create nested export groups, ambiguous duplicate paths reject. Retention does not implement history snapshots, expiration/recycle-bin behavior or group-management UI.",
      "evidence": [
        {
          "path": "products/rea-studio/apps/vault/app.test.mjs",
