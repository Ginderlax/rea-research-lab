    {
      "id": "grafana.candidate.ae6ce63fe19101da8815",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Tags you configure in the Tempo data source must be present in the span's attributes or resources. If a tag has dots in its name, for example, `service.name`, and the Pyroscope data source doesn't allow dots in labels, remap it to a name without dots, for example, `service_name`.",
      "headingPath": [
