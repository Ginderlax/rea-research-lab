    },
    {
      "id": "grafana.candidate.a489efce66548c72ac4a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Currently in development. [Trusted types](https://github.com/w3c/trusted-types/blob/main/explainer.md) is an experimental Javascript API with [limited browser support](https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Content-Security-Policy/trusted-types#browser_compatibility).**",
      "headingPath": [
        "Configure security hardening",
        "Security headers",
        "Enable trusted types"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md",
        "gitBlobSha": "3d53e64d215efc829e6827f523ce8947fa777722",
        "sha256": "a854d8317e4a2fc51bb82f7a31ee6438dc48f45d8ae483e504521c35e34c73df",
        "lineStart": 96,
        "lineEnd": 96,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md#L96-L96"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
