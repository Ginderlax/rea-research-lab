import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const root=import.meta.dirname,hash=b=>createHash('sha256').update(b).digest('hex'),json=n=>JSON.parse(fs.readFileSync(path.join(root,n)));
const negative='runs/negative-2026-10-13T01-47-16.739Z/attempt.json',single='runs/fixed-2026-10-13T01-47-52.579Z/attempt.json',omitted='runs/focused-2026-10-13T01-47-53.074Z/attempt.json',focused='runs/focused-2026-10-13T01-48-28.020Z/attempt.json',n=json(negative),s=json(single),f=json(focused);assert.equal(n.summary.fail,1);assert.equal(s.summary.pass,1);assert.equal(f.summary.pass,69);assert.equal(f.sourceStable,true);
const original=json('prior-authority/baseline-original-source31.json.snapshot');for(const r of original){const b=fs.readFileSync(path.join(root,r.path));assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);}
const receipt={schema:'rea-notes-inline-cancel-no-read-author-correction/v1',at:new Date().toISOString(),status:'finite-correction-author-tests-passed-independent-pending',previousAuthorManifestSHA256:'347ff80e93076df92144915e16257f92ff7910a78ea175be840b8d3fd829dc16',negative:{path:negative,summary:n.summary,sourceStable:n.sourceStable},fixedSingle:{path:single,summary:s.summary,sourceStable:s.sourceStable},failedPrerequisiteRun:{path:omitted,summary:json(omitted).summary,candidateDefectInferred:false},focused:{path:focused,summary:f.summary,sourceStable:f.sourceStable,sourceFiles:30,helperExecutionScope:f.sourceHelperAccounting},sources:f.sourceAfter,originalPrerequisiteFiles:31,originalPrerequisitesExactAfterRun:true,sourceTransform:json('correction.json'),productionModified:false,prior214Modified:false,actualBrowserAcceptance:false,independentAcceptance:false,originalGUISessions:0,benchmarks:0,fullProductParity:false,universalSuperiority:false};fs.writeFileSync(path.join(root,'validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
fs.writeFileSync(path.join(root,'README.md'),'# Notebook Cancel correction\n\nThis isolated follow-up keeps the prior214-artifact in-page confirmation candidate immutable. Independent model and actual browser review found that Cancel with an open saved note performed one unnecessary attachment-list read. No draft loss or notebook mutation was found. This correction treats a declined operation as cancelled and restores the controls without reopening the note or resetting its editor generation.\n\nA new opened-note regression first failed1/1 against the unchanged candidate and passed1/1 after the two explicit source substitutions. The focused69 selection (prior59 + original confirmation9 + new cancellation1) passed with zero skips and30 captured source identities unchanged before/after. It replays bounded Joplin source helpers, not an original application or GUI. Exact helper accounting must be audited separately before acceptance. The first focused run had59pass/10fail because root preparation omitted31 inert original source/provenance prerequisites. Its ENOENT failures, exact source and raw output are preserved; copying the exact31 dependencies repaired the collection without any further runtime/test edit.\n\nOnly client.mjs and the additional one-case test differ from the prior candidate; the earlier seven proposed production files retain their individual mappings. Previous native confirmation failures, candidate tests, independent review and any real-browser receipts belong to their own source epochs. Independent correction review and browser acceptance remain pending. Production is unchanged; full replacements and comparative superiority remain unestablished.\n',{flag:'wx'});console.log(JSON.stringify({authorTests:69,sourceFiles:30,independentPending:true,validationSHA256:hash(fs.readFileSync(path.join(root,'validation.json')))}));
