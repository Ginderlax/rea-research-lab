    },
    {
      "id": "grafana.candidate.6f37dae83bd8d61ae44a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The **History** page also includes an **Alert events** tab for [alert state history](ref:view-alert-state-history).",
      "headingPath": [
        "View notification history"
      ],
      "source": {
