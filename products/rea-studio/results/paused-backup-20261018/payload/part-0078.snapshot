    {
      "id": "grafana.candidate.1c63dd672c0d12dc892b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "As a result, SQL expressions can’t gracefully handle changes in schema or no-data conditions, since these cases violate the static schema model that SQL relies on.",
      "headingPath": [
        "SQL expressions",
        "Known limitations",
        "Schema changes and missing data"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/sql-expressions/index.md",
