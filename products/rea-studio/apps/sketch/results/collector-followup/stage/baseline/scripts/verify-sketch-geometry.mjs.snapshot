import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import {spawn} from 'node:child_process';
import {gunzipSync} from 'node:zlib';
import assert from 'node:assert/strict';
const script=fileURLToPath(import.meta.url),product=path.resolve(path.dirname(script),'..'),repo=path.resolve(product,'../..'),workspace=path.resolve(repo,'../..'),app=path.join(product,'apps/sketch'),stage=path.join(workspace,'work/sketch-geometry-next'),study=path.join(app,'results/geometry-source-study'),digest=bytes=>createHash('sha256').update(bytes).digest('hex');
async function fingerprints(folder,names){return Promise.all(names.map(async name=>{const bytes=await fs.readFile(path.join(folder,name));return{path:name,bytes:bytes.length,sha256:digest(bytes)};}));}
async function inventory(folder,prefix=''){const rows=[];for(const item of await fs.readdir(folder,{withFileTypes:true})){const name=prefix+item.name;if(item.isDirectory())rows.push(...await inventory(path.join(folder,item.name),name+'/'));else{const bytes=await fs.readFile(path.join(folder,item.name));rows.push({path:name,bytes:bytes.length,sha256:digest(bytes)});}}return rows.sort((a,b)=>a.path.localeCompare(b.path));}
async function verifyStudy(){const manifest=JSON.parse(await fs.readFile(path.join(study,'manifest.json'),'utf8'));assert.deepEqual((await inventory(study)).filter(item=>item.path!=='manifest.json'),manifest.files);return manifest;}
async function install(){const receiptBytes=await fs.readFile(path.join(stage,'stage-validation.json'));assert.equal(digest(receiptBytes),'af35be8567f3e60f3f980538d53bcae4f89c7165b19c6f5288b310bda3f0a8f3');const receipt=JSON.parse(receiptBytes),baseline=JSON.parse(await fs.readFile(path.join(stage,'production-baseline-manifest.json'),'utf8'));for(const item of baseline.files)assert.equal(digest(await fs.readFile(path.join(product,item.path))),item.sha256,'Production baseline changed before installation');await fs.mkdir(study);const snapshotMapping=[];const copy=async(source,name,sha)=>{const originalPath=name;name+='.snapshot';snapshotMapping.push({originalPath,snapshotPath:name});assert.ok(!path.isAbsolute(name)&&!name.split(/[\\/]/).includes('..'));const bytes=await fs.readFile(source);if(sha)assert.equal(digest(bytes),sha);const output=path.join(study,name);await fs.mkdir(path.dirname(output),{recursive:true});await fs.writeFile(output,bytes,{flag:'wx'});};for(const item of receipt.sourceFingerprints)await copy(path.join(stage,item.path),'stage-source/'+item.path,item.sha256);for(const item of receipt.evidenceFingerprints)await copy(path.join(stage,item.path),'stage-evidence/'+item.path,item.sha256);for(const item of baseline.files)await copy(path.join(stage,'production-baseline',item.path),'production-before/'+item.path,item.sha256);await copy(path.join(stage,'stage-validation.json'),'stage-evidence/stage-validation.json',digest(receiptBytes));await copy(path.join(stage,'verify-final.stdout.txt'),'stage-evidence/verify-final.stdout.txt');await copy(path.join(stage,'verify-final.stderr.txt'),'stage-evidence/verify-final.stderr.txt');const manifest={schema:'rea-sketch-geometry-source-study/v1',createdAtUtc:new Date().toISOString(),stageReceiptSha256:digest(receiptBytes),snapshotMapping,sourceFiles:receipt.sourceFingerprints.length,productionBaseline:baseline.files,files:await inventory(study),scope:'Exact stage source/evidence/failure history and original production bytes. All executable snapshots remain under results, excluded by existing global test discovery. No vendor archive/bundle/map runtime cache is published here.'};await fs.writeFile(path.join(study,'manifest.json'),JSON.stringify(manifest,null,2)+'\n',{flag:'wx'});await verifyStudy();for(const name of ['core.mjs','client.mjs','geometry.test.mjs','geometry-client.test.mjs'])await fs.copyFile(path.join(stage,'apps/sketch',name),path.join(app,name));
 let geometry=await fs.readFile(path.join(app,'geometry.test.mjs'),'utf8');const start=geometry.indexOf("const stage=fileURLToPath"),end=geometry.indexOf("const shape=",start);assert.ok(start>=0&&end>start);geometry=geometry.slice(0,start)+"const appRoot=fileURLToPath(new URL('./',import.meta.url)),observationRoot=path.resolve(process.env.REA_SKETCH_OBSERVATION_DIR||path.join(appRoot,'.local/observations')),scratchRoot=path.join(appRoot,'.local/test-fixtures');await fs.mkdir(scratchRoot,{recursive:true});const {oracle,directCalls,provenance}=await loadGeometryOracle(),plain=value=>JSON.parse(JSON.stringify(value)),comparisons=[];\n"+geometry.slice(end);geometry=geometry.replace("import {runInNewContext} from 'node:vm';","import {loadGeometryOracle} from './geometry-oracle.mjs';").replace("path.join(stage,'fixture-persistence-')","path.join(scratchRoot,'fixture-persistence-')");const tail=geometry.indexOf('test.after(async()=>');assert.ok(tail>=0);geometry=geometry.slice(0,tail)+"test.after(async()=>{assert.deepEqual(directCalls,{getDiamondPoints:8,getSizeFromPoints:8,getNormalizedDimensions:0,restoreElement:18,serializeAsJSON:1});await fs.mkdir(observationRoot,{recursive:true});await fs.writeFile(path.join(observationRoot,`geometry-observations-${process.pid}.json`),JSON.stringify({schema:'rea-sketch-geometry-original-subset/v2',checkedAtUtc:new Date().toISOString(),original:provenance.original,unchangedHelpers:provenance.unchangedTestOnlyHelpers,comparisons,directCalls,directCallTotal:Object.values(directCalls).reduce((a,b)=>a+b,0),limits:'Finite fully specified original helper fixtures; zero mocked helper bodies and no full original renderer/UI/binding repair. Tiny diamond clamp is intentionally different.'},null,2)+'\\n');console.log('SKETCH_GEOMETRY_OBSERVATIONS '+JSON.stringify({comparativeContexts:comparisons.length,directCalls,totalDirectCalls:Object.values(directCalls).reduce((a,b)=>a+b,0)}));});\n";await fs.writeFile(path.join(app,'geometry.test.mjs'),geometry);
 let legacy=await fs.readFile(path.join(app,'vendor-oracle.mjs'),'utf8');legacy=legacy.replace("import { exportExcalidraw, importExcalidraw, example }", "import { loadPinnedOriginal, oraclePaths } from './geometry-oracle.mjs';\nimport { exportExcalidraw, importExcalidraw, example }");legacy=legacy.replace("const archive = new URL('../../../../projects/04-excalidraw/artifacts/package.tgz', import.meta.url);","const archive = oraclePaths.archive;").replace("const bundle = new URL('../../../../projects/04-excalidraw/artifacts/package/dist/dev/chunk-4FTI6OG3.js', import.meta.url);","const bundle = oraclePaths.bundle;").replace('const archiveBytes = await readFile(archive), bytes = await readFile(bundle);','const {archiveBytes,bundleBytes:bytes} = await loadPinnedOriginal();');legacy=legacy.replace("new URL('./results/', import.meta.url)","new URL('./.local/legacy-observations/', import.meta.url)");await fs.writeFile(path.join(app,'vendor-oracle.mjs'),legacy);
 let legacyTest=await fs.readFile(path.join(app,'vendor-oracle.test.mjs'),'utf8');legacyTest=legacyTest.replace("import { existsSync } from 'node:fs';","import { oracleAvailable } from './geometry-oracle.mjs';").replace("existsSync(new URL('../../../../projects/04-excalidraw/artifacts/package.tgz', import.meta.url))","oracleAvailable()");await fs.writeFile(path.join(app,'vendor-oracle.test.mjs'),legacyTest);
 let readme=await fs.readFile(path.join(stage,'apps/sketch/README.md'),'utf8');readme=readme.replace('Isolated geometry development stage:','Working local canvas editor:').replace(' This stage has not changed the production application.','').replace("this stage's `source-provenance.json` and `THIRD-PARTY-NOTICE.md`","`results/geometry-source-study/stage-source/source-provenance.json` and `THIRD-PARTY-NOTICE.md`").replace('node work/sketch-geometry-next/verify-stage.mjs','node products/rea-studio/scripts/verify-sketch-geometry.mjs').replace('Run the isolated stage from the workspace root:','Run the focused collector from the repository root:');readme+='\nCurrent integration evidence is results/geometry-validation.json. Tests write detailed original observations only to app-owned .local or the collector-selected owned directory, and emit a small stdout count marker. The focused collector publishes results after the source-stable run. Exact staged51-source/failure/license/browser history is under results/geometry-source-study with a strict manifest; the original production compatibility receipt remains historical. Original archive/bundle/source-map bytes are app-local ignored cache only; bootstrap them with the focused collector, which authenticates the official publisher URL/archive SHA and extracted file SHAs. No original runtime is loaded by the editor.\n';await fs.writeFile(path.join(app,'README.md'),readme);await fs.copyFile(path.join(stage,'THIRD-PARTY-NOTICE.md'),path.join(app,'THIRD-PARTY-NOTICE.md'));console.log('Sketch reviewed core/client installed after11-file baseline and strict stage snapshot verification.');}
if(process.argv.includes('--install-stage')){await install();process.exit(0);}
const collectorBefore=digest(await fs.readFile(script));const {originalPins,oraclePaths,oracleDirectory,loadPinnedOriginal}=await import('../apps/sketch/geometry-oracle.mjs');await fs.mkdir(oracleDirectory,{recursive:true});let archive;try{archive=await fs.readFile(oraclePaths.archive);assert.equal(digest(archive),originalPins.archive);}catch(error){if(error.code!=='ENOENT')throw error;try{archive=await fs.readFile(path.join(repo,'projects/04-excalidraw/artifacts/package.tgz'));}catch(error){if(error.code!=='ENOENT')throw error;const response=await fetch('https://registry.npmjs.org/@excalidraw/excalidraw/-/excalidraw-0.18.1.tgz');assert.equal(response.status,200);const rows=[];let count=0;for await(const row of response.body){count+=row.length;assert.ok(count<=40*1024*1024);rows.push(row);}archive=Buffer.concat(rows);}assert.equal(digest(archive),originalPins.archive);await fs.writeFile(oraclePaths.archive,archive);}
const tar=gunzipSync(archive,{maxOutputLength:256*1024*1024}),wanted=new Map([['package/dist/dev/chunk-4FTI6OG3.js','bundle'],['package/dist/dev/chunk-4FTI6OG3.js.map','map']]);for(let offset=0;offset+512<=tar.length&&wanted.size;){const header=tar.subarray(offset,offset+512),name=header.subarray(0,100).toString().replace(/\0.*$/s,''),size=parseInt(header.subarray(124,136).toString().replace(/\0.*$/s,'').trim(),8)||0;if(wanted.has(name)){const key=wanted.get(name),bytes=tar.subarray(offset+512,offset+512+size);assert.equal(digest(bytes),originalPins[key]);await fs.writeFile(oraclePaths[key],bytes);wanted.delete(name);}offset+=512+Math.ceil(size/512)*512;}assert.equal(wanted.size,0);
await loadPinnedOriginal();if(process.argv.includes('--bootstrap-oracle')){console.log('Sketch original 0.18.1 archive, bundle and source map authenticated in ignored app-local cache.');process.exit(0);}const studyManifestBefore=digest(await fs.readFile(path.join(study,'manifest.json'))),studyBaseline=await verifyStudy(),unchangedBaselineNames=['apps/sketch/app.test.mjs','apps/sketch/client.test.mjs','apps/sketch/fixtures.mjs','apps/sketch/server.mjs','apps/sketch/results/excalidraw-compatibility.json','lib/storage.mjs'],unchangedBaseline=await fingerprints(product,unchangedBaselineNames);for(const item of unchangedBaseline){assert.deepEqual(item,studyBaseline.productionBaseline.find(old=>old.path===item.path));}const sourceNames=['core.mjs','client.mjs','server.mjs','fixtures.mjs','app.test.mjs','client.test.mjs','vendor-oracle.mjs','vendor-oracle.test.mjs','geometry-oracle.mjs','geometry.test.mjs','geometry-client.test.mjs','README.md','THIRD-PARTY-NOTICE.md'],before=await fingerprints(app,sourceNames);const observations=await fs.mkdtemp(path.join(app,'.local/collect-')),startedAtUtc=new Date().toISOString();const child=spawn(process.execPath,['--test','--test-concurrency=1','--test-reporter=tap',...['app.test.mjs','client.test.mjs','vendor-oracle.test.mjs','geometry.test.mjs','geometry-client.test.mjs'].map(name=>path.join(app,name))],{cwd:repo,windowsHide:true,env:{...process.env,REA_SKETCH_OBSERVATION_DIR:observations}}),out=[],err=[];child.stdout.on('data',bytes=>out.push(bytes));child.stderr.on('data',bytes=>err.push(bytes));const exitCode=await new Promise(resolve=>child.on('close',resolve)),stdout=Buffer.concat(out),stderr=Buffer.concat(err);await fs.writeFile(path.join(observations,'stdout.txt'),stdout);await fs.writeFile(path.join(observations,'stderr.txt'),stderr);const summary=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(name=>[name,Number(stdout.toString('utf8').match(new RegExp(`^# ${name} (\\d+)$`,'m'))?.[1]??-1)]));assert.equal(exitCode,0);assert.deepEqual(summary,{tests:28,pass:28,fail:0,cancelled:0,skipped:0,todo:0});assert.deepEqual(await fingerprints(app,sourceNames),before);await verifyStudy();const names=(await fs.readdir(observations)).filter(name=>name.startsWith('geometry-observations-'));assert.equal(names.length,1);const geometry=JSON.parse(await fs.readFile(path.join(observations,names[0]),'utf8'));assert.equal(geometry.comparisons.length,17);assert.equal(geometry.directCallTotal,35);const{runOracle}=await import('../apps/sketch/vendor-oracle.mjs'),legacy=await runOracle();assert.deepEqual(await fingerprints(app,sourceNames),before);assert.deepEqual(await fingerprints(product,unchangedBaselineNames),unchangedBaseline);assert.equal(digest(await fs.readFile(script)),collectorBefore);assert.equal(digest(await fs.readFile(path.join(study,'manifest.json'))),studyManifestBefore);const detailed={schema:'rea-sketch-geometry-current-original-evidence/v1',geometry,legacy};await fs.writeFile(path.join(app,'results/geometry-original-observations.json'),JSON.stringify(detailed,null,2)+'\n');await fs.writeFile(path.join(app,'results/geometry-tests.stdout.txt'),stdout);await fs.writeFile(path.join(app,'results/geometry-tests.stderr.txt'),stderr);const receipt={schema:'rea-sketch-geometry-integration-validation/v1',startedAtUtc,completedAtUtc:new Date().toISOString(),summary,runtime:process.version,sourceBytesStableAcrossRun:true,collectorBytesStableAcrossRun:true,reviewedStageReceiptSha256:studyBaseline.stageReceiptSha256,reviewedStageSourceFiles:studyBaseline.sourceFiles,preservedProductionBaselineFiles:studyBaseline.productionBaseline.length,unchangedBaseline,productionTransforms:{runtime:'Exact reviewed stage core.mjs and client.mjs bytes copied without adaptation; server/store unchanged',tests:'Stage tests import production modules; original helpers load authenticated app-local archive/bundle/map and frozen unchanged helper snapshots; direct original calls are counted by external host wrappers',observations:'Normal tests emit a small stdout marker and detailed JSON only in owned .local/temp; the focused collector alone publishes current evidence',history:'Exact prior 11-file baseline and stage 51 sources, failures, license and browser proof retained as inert .snapshot bytes with strict original-to-snapshot inventory'},sourceFingerprints:before,collectorSha256:digest(await fs.readFile(script)),studyManifestSha256:digest(await fs.readFile(path.join(study,'manifest.json'))),originalPins,officialPublisherUrl:'https://registry.npmjs.org/@excalidraw/excalidraw/-/excalidraw-0.18.1.tgz',localOnlyOriginalCache:true,originalComparativeContexts:17,originalDirectCalls:geometry.directCalls,totalDirectOriginalCalls:35,legacyOracleIndividualRestorations:legacy.assertions.originalIndividualElementRestoration.count,evidence:await fingerprints(app,['results/geometry-original-observations.json','results/geometry-tests.stdout.txt','results/geometry-tests.stderr.txt']),limits:['Only finite fully specified helper matrices, no full original UI/renderer/font/binding repair','Sub-pixel/degenerate diamond anchor clamp intentionally differs; interior geometric selection also does not claim original transparent-hit parity','Native unknown records/group/history/freehand behavior preserved within existing bounds','Normal tests write observations only .local; focused collector publishes after passing stable run','No full parity/security/performance claim'],fullFeatureParity:false,productionSecurityVerified:false,universalSuperiority:false};await fs.writeFile(path.join(app,'results/geometry-validation.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({summary,sourceFiles:before.length,originalContexts:17,directCalls:35,receiptSha256:digest(await fs.readFile(path.join(app,'results/geometry-validation.json'))),runtimeSources:before.filter(item=>['core.mjs','client.mjs','server.mjs'].includes(item.path))}));
