    },
    {
      "id": "grafana.candidate.869da615669b051b9766",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In this example, the forecast provides up to 15 days of future prediction data. The maximum function value is used so that the alert fires if the forecast is expected to exceed the threshold at any point during the next 7 days.",
      "headingPath": [
        "Alerting on forecasts",
        "Seasonal forecast with Grafana Cloud Machine Learning",
        "Alert on a future prediction"
      ],
      "source": {
        "path": "docs/sources/alerting/guides/alerting-on-forecasts.md",
