    {
      "id": "grafana.candidate.63ad7c5f7d96f2fc2b01",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Some commands, such as installing or removing plugins, require `sudo` on Linux. If you're on Windows, run Windows PowerShell as Administrator.",
      "headingPath": [
