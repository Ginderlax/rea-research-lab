BEFORE='89e00f66c2249a50c701404accede7565094304e';AFTER='d24db80660e2af640882ad48c01174b27ffcda51'
def read(p):assert p.is_file()and not p.is_symlink(),str(p);return p.read_bytes()
def ident(b):return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def git(*args):return subprocess.run(['git',*args],cwd=R,check=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE).stdout
def batch(commit,names):
    raw=subprocess.run(['git','cat-file','--batch'],cwd=R,input=('\n'.join(commit+':'+p for p in names)+'\n').encode(),check=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE).stdout
    pos=0;out={}
    for p in names:
        end=raw.index(b'\n',pos);h=raw[pos:end].split();assert len(h)==3 and h[1]==b'blob';n=int(h[2]);pos=end+1;out[p]=raw[pos:pos+n];assert len(out[p])==n and raw[pos+n:pos+n+1]==b'\n';pos+=n+1
    assert pos==len(raw);return out
