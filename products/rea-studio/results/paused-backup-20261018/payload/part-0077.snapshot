    {
      "id": "grafana.candidate.e304d5b458de2aac8a4d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana versions 11.1 and below do not support fetching groups from the Graph API endpoint. As a result, users with more than 150 groups will not be able to retrieve their groups. Instead, use the Entra ID connector.",
      "headingPath": [
        "Configure SAML with Microsoft Entra ID"
      ],
