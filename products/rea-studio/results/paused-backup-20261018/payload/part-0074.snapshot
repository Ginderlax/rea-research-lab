    },
    {
      "id": "grafana.candidate.205419c7911f71cd00cf",
      "syntaxRole": "list-item",
      "sourceText": "- The `admin` permission allows users to query and edit the data source, change permissions on the data source and enable or disable query caching for the data source.",
      "headingPath": [
        "Data source management",
        "Data source permissions"
      ],
      "source": {
        "path": "docs/sources/administration/data-source-management/_index.md",
        "gitBlobSha": "48e0cd06582ded6e67389dc4fe82510ea7271f7b",
        "sha256": "087e0c6f2fdd1b21672ed0be96bcf714c87e35ca1887c2f4bb4382f0c4b4bdad",
