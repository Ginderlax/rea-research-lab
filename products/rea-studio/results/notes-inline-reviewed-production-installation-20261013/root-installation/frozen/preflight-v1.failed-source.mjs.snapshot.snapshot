import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const base=path.resolve(import.meta.dirname,'..'),lab=path.join(base,'outputs/rea-research-lab'),plan=path.join(base,'work/notes-inline-publication-plan-next'),addendum=path.join(base,'work/notes-inline-publication-plan-browser-next'),owned=path.join(base,'work/notes-inline-production-installation-next'),prefix='products/rea-studio/apps/notes/results/inline-confirmation-followup/',sha=b=>createHash('sha256').update(b).digest('hex');
function safe(n){assert.ok(typeof n==='string'&&n&&!path.isAbsolute(n)&&!n.includes('\\')&&!n.includes(':')&&n.split('/').every(p=>p&&p!=='.'&&p!=='..'));return n;}
function read(root,n,r){safe(n);const full=path.join(root,n);let p=root;for(const s of n.split('/')){p=path.join(p,s);assert.equal(fs.lstatSync(p).isSymbolicLink(),false);}const b=fs.readFileSync(full);assert.ok(b.length<=32*1024*1024);if(r){assert.equal(b.length,r.bytes,n);assert.equal(sha(b),r.sha256,n);}return b;}
function files(root,rel=''){return fs.readdirSync(path.join(root,rel),{withFileTypes:true}).flatMap(e=>{const n=rel?rel+'/'+e.name:e.name;safe(n);assert.equal(e.isSymbolicLink(),false);if(e.isDirectory())return files(root,n);assert.ok(e.isFile());return[n];});}
function strict(root,name,digest,count){const b=read(root,name);assert.equal(sha(b),digest);const m=JSON.parse(b),rows=Array.isArray(m.records)?m.records:Object.entries(m.inventory).map(([path,r])=>({path,...r}));assert.equal(rows.length,count);assert.deepEqual(files(root).sort(),[...rows.map(r=>r.path),name].sort());for(const r of rows)read(root,r.path,r);return {b,m,rows};}
const planAuth=strict(plan,'freeze-manifest.json','ab0bccd1aaf43da7b932193a0991531659b2e5017b72c28933b37bcc7ddcf3ae',162),addendumAuth=strict(addendum,'freeze-manifest.json','697af388815ed18acacdfebf69dd58eb6ddb601c84722e0ba2185401afaa9aff',17),mapBytes=read(addendum,'public-preservation-map.json'),map=JSON.parse(mapBytes);assert.equal(sha(mapBytes),'ec5839d46fd9ff16e0e752bfac86b850689731b0bfa6a9fb87ffd4d4aaa8c2d7');assert.equal(map.payload.length,829);assert.equal(map.payload.filter(r=>r.publishable).length,818);assert.equal(map.payload.filter(r=>!r.publishable).length,11);assert.equal(map.uniqueByteObjects,330);
for(const e of map.epochs){strict(path.join(base,'work',e.directory),e.manifest,e.manifestIdentity.sha256,e.payloadFiles);}
const observed=[];for(const r of map.payload){assert.ok(r.sourceRoot.startsWith('work/'));safe(r.sourceRoot);safe(r.sourcePath);safe(r.publicPath);assert.ok(r.publicPath.startsWith(prefix)&&r.publicPath.endsWith('.snapshot'));const b=read(path.join(base,r.sourceRoot),r.sourcePath,r);if(r.publishable){assert.ok(!(b[0]===0x4d&&b[1]===0x5a)&&!(b[0]===0x50&&b[1]===0x4b));observed.push({...r});}else if(r.kind==='TAR'){assert.equal(r.bytes,9728);assert.equal(r.sha256,'044885c906ba7d8cb97a95fbdd6bc2323ba31a3c301e7ed1d6e592acec8944af');}else{assert.equal(r.kind,'owned-generated-attachment-fixture');assert.equal(r.bytes,63);assert.equal(r.sha256,'055503b5030e894c9ceaf9b0cd8feb8039569526fe720dc937442be4a82867f3');}}
const live=JSON.parse(read(plan,'live-copy-list.json')),historical=JSON.parse(read(plan,'installation-before34.json'));assert.equal(live.proposals.length,8);assert.equal(historical.installed.length,34);for(const r of historical.installed)read(lab,r.destination,r.after);for(const r of live.proposals){const b=read(plan,r.proposalPath,r.after);read(path.join(base,r.sourceRoot),r.sourcePath,r.sourceIdentity);assert.ok(r.destination.startsWith('products/rea-studio/apps/notes/'));assert.equal(r.backendChange,false);if(r.before)read(lab,r.destination,r.before);else assert.equal(fs.existsSync(path.join(lab,r.destination)),false);}
const validation=JSON.parse(read(addendum,'validation.json'));assert.equal(validation.finiteIndependent22AndActualBrowser8Accepted,true);const review=JSON.parse(read(path.join(base,'work/notes-inline-cancel-no-read-independent-review'),'review-validation.json'));assert.equal(sha(read(path.join(base,'work/notes-inline-cancel-no-read-independent-review'),'review-validation.json')),'de13cff74b6842ac6849761d4421b3ed75ce7cb36034baa9b1ffbf7df6f82c6c');const browser=JSON.parse(read(path.join(base,'work/notes-inline-cancel-no-read-browser-next'),'validation.json'));assert.equal(sha(read(path.join(base,'work/notes-inline-cancel-no-read-browser-next'),'validation.json')),'5d284a148316c6bac3a30999bf5fa8fe61f0c32e369e2430ab8238d083f1c8bc');
fs.mkdirSync(owned,{recursive:true});fs.copyFileSync(import.meta.filename,path.join(owned,process.argv.includes('--install')?'installation-collector.mjs.snapshot':'preflight-collector.mjs.snapshot'),fs.constants.COPYFILE_EXCL);const baseline={schema:'rea-notes-inline-production-preflight/v1',at:new Date().toISOString(),strictPlan162:sha(planAuth.b),strictBrowserAddendum17:sha(addendumAuth.b),sourceEpochs:map.epochs.map(e=>({id:e.id,manifestSHA256:e.manifestIdentity.sha256,payloadFiles:e.payloadFiles})),incomingPathRecords:829,publicRecords:818,excludedLocalCarriers:11,uniquePublicByteObjects:330,installProposals:8,existingReplacements:6,newTests:2,historicalInstalled34Exact:true,backendChanged:false,independentFiniteAccepted:true,currentBrowserFiniteAccepted:true,applicationMutations:0,fullParity:false,superiority:false};
if(!process.argv.includes('--install')){fs.writeFileSync(path.join(owned,'preflight.json'),JSON.stringify(baseline,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(baseline));}
else{
 const acceptedPath=process.argv.find(a=>a.startsWith('--plan-review='))?.slice('--plan-review='.length);assert.ok(acceptedPath,'Independent source-only plan acceptance required before installation');const accepted=JSON.parse(fs.readFileSync(path.resolve(acceptedPath)));assert.equal(accepted.acceptance,true);assert.equal(fs.existsSync(path.join(lab,prefix)),false);
 const copies=[];for(const r of observed){const b=read(path.join(base,r.sourceRoot),r.sourcePath,r),p=path.join(lab,r.publicPath);assert.equal(fs.existsSync(p),false);fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,b,{flag:'wx'});copies.push({sourceRoot:r.sourceRoot,sourcePath:r.sourcePath,path:r.publicPath,bytes:r.bytes,sha256:r.sha256,epoch:r.epoch});}
 for(const r of [...addendumAuth.rows,{path:'freeze-manifest.json',bytes:addendumAuth.b.length,sha256:sha(addendumAuth.b)}]){const b=read(addendum,r.path,r),n=prefix+'browser-publication-plan/frozen/'+r.path+'.snapshot',p=path.join(lab,n);assert.equal(fs.existsSync(p),false);fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,b,{flag:'wx'});copies.push({sourceRoot:'work/notes-inline-publication-plan-browser-next',sourcePath:r.path,path:n,bytes:r.bytes,sha256:r.sha256,epoch:'browser-publication-plan'});}
 for(const r of live.proposals.filter(r=>r.before)){const b=read(lab,r.destination,r.before),n='before-images/'+r.destination+'.snapshot';fs.mkdirSync(path.dirname(path.join(owned,n)),{recursive:true});fs.writeFileSync(path.join(owned,n),b,{flag:'wx'});}
 const installed=[];for(const r of live.proposals){const b=read(plan,r.proposalPath,r.after);fs.mkdirSync(path.dirname(path.join(lab,r.destination)),{recursive:true});fs.writeFileSync(path.join(lab,r.destination),b,{flag:r.before?'w':'wx'});assert.equal(sha(read(lab,r.destination)),r.after.sha256);installed.push({destination:r.destination,before:r.before,after:r.after,sourceRoot:r.sourceRoot,sourcePath:r.sourcePath,runtime:r.runtime});}
 for(const r of map.payload)read(path.join(base,r.sourceRoot),r.sourcePath,r);strict(plan,'freeze-manifest.json',sha(planAuth.b),162);strict(addendum,'freeze-manifest.json',sha(addendumAuth.b),17);for(const r of historical.installed.filter(r=>!live.proposals.some(p=>p.destination===r.destination)))read(lab,r.destination,r.after);const record={...baseline,schema:'rea-notes-inline-production-installation/v1',at:new Date().toISOString(),applicationMutations:8,installed,copies,publicSnapshots:836,allInputSourcesStableBeforeAfter:true,oldHistorical34ReceiptRebound:false,unchangedHistoricalInstalledPaths:28,installedBehaviorTestsExecuted:0,originalHelpersExecuted:0,browserExecutions:0,independentPlanAcceptance:{path:path.resolve(acceptedPath),sha256:sha(fs.readFileSync(path.resolve(acceptedPath)))}};fs.writeFileSync(path.join(owned,'installation.json'),JSON.stringify(record,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({installedFiles:8,publicSnapshots:836,allInputSourcesStable:true,receipt:path.join(owned,'installation.json'),fullParity:false,superiority:false}));
}
