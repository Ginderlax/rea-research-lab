      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.edbfecf8d01c458104cc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set the tenant ID for Loki communication, which is disabled by default. The tenant ID is required to interact with Loki running in [multi-tenant mode](/docs/loki/latest/operations/multi-tenancy/).",
      "headingPath": [
        "Configure Grafana Enterprise",
        "[auditing.logs.loki]",
        "tenant_id"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md",
