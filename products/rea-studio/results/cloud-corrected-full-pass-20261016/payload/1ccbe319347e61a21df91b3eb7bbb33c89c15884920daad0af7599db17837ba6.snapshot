// Backup-only filing after an authenticated terminal cloud pass. No candidate import/test/build.
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import { createHash } from 'node:crypto';
import { gzipSync, gunzipSync } from 'node:zlib';
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab');
const run='38911252546',head='016ecd175c0700d1a94d5219af6719989a4a6e45',tested='b7bb3010fa7f08a45bef8758515f5fbef5566917';
const stage=path.join(work,'cloud-corrected-full-pass-public-20261016-next'),publicRoot=path.join(stage,'public-candidate'),prefix='products/rea-studio/results/cloud-corrected-full-pass-20261016',target=path.join(publicRoot,prefix),runRoot=path.join(work,'cloud-verification-backups/run-'+run);
const id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});
function safe(n){assert(typeof n==='string'&&n&&!/[\\:\x00-\x1f\x7f]/.test(n)&&!n.startsWith('/')&&n.split('/').every(p=>p&&p!=='.'&&p!=='..'));return n;}
function read(base,n){safe(n);let f=base;for(const part of n.split('/')){f=path.join(f,part);assert(!fs.lstatSync(f).isSymbolicLink());}const stat=fs.lstatSync(f);assert(stat.isFile()&&stat.size<=12*1024*1024);const b=fs.readFileSync(f);assert.equal(b.length,stat.size);return b;}
const collectionBytes=read(runRoot,'collection-summary.json'),collection=JSON.parse(collectionBytes);assert.equal(collection.runId,run);assert.equal(collection.headSHA,head);assert.equal(collection.runStatus,'completed');assert.equal(collection.runConclusion,'success');assert.equal(collection.jobConclusion,'success');assert.equal(collection.artifacts.length,1);
const job=collection.jobId,selectedArtifact=collection.artifacts[0],artifactId=String(selectedArtifact.artifactId),digest=selectedArtifact.sha256;assert(/^\d+$/.test(job)&&/^\d+$/.test(artifactId)&&/^[0-9a-f]{64}$/.test(digest));assert.equal(selectedArtifact.readabilityVerified,true);
const backup=path.join(runRoot,'artifact-'+artifactId),evidenceRoot=path.join(backup,'readable-evidence'),verificationBytes=read(backup,'local-backup-verification.json'),verification=JSON.parse(verificationBytes);
assert.equal(verification.schema,'rea-local-cloud-attempt-backup/v1');assert.equal(verification.artifactSHA256,digest);assert.equal(verification.allCRCAndBytesReadable,true);assert.equal(verification.files.length,423);
const zip=fs.readFileSync(backup+'.zip');assert.equal(id(zip).sha256,digest);assert.equal(zip.length,verification.archiveBytes);assert.equal(zip.length,selectedArtifact.bytes);
const files=new Map();for(const row of verification.files){safe(row.path);assert(!files.has(row.path));files.set(row.path,row);const stat=fs.lstatSync(path.join(evidenceRoot,row.path));assert(stat.isFile()&&!stat.isSymbolicLink()&&stat.size===row.bytes);}
function evidence(n){const b=read(evidenceRoot,n),row=files.get(n);assert(row);assert.deepEqual(id(b),{bytes:row.bytes,sha256:row.sha256});return b;}
const attempt=JSON.parse(evidence('attempt-validation.json'));assert.equal(attempt.schema,'rea-cloud-development-attempt/v1');assert.equal(attempt.scope,'full-oracle-experiment');assert.equal(attempt.status,'passed');assert.equal(attempt.phase,'terminal');assert.equal(attempt.repositoryCommit,tested);
assert.equal(attempt.summary.tests,1077);assert.equal(attempt.summary.pass,1077);for(const k of ['fail','cancelled','skipped','todo'])assert.equal(attempt.summary[k],0);assert(Number.isFinite(attempt.summary.duration_ms)&&attempt.summary.duration_ms>0);
assert.deepEqual(attempt.failures,[]);assert.equal(attempt.failure,null);assert.equal(attempt.childCloseObserved,true);assert.equal(attempt.exitCode,0);assert.equal(attempt.signal,null);assert.equal(attempt.output.droppedOutputBytes,0);assert.equal(attempt.output.retainedOutputTruncated,false);
assert.equal(attempt.sourceFiles,789);assert.equal(attempt.sourceSnapshotFiles,366);assert.equal(attempt.sourceStable,true);assert.equal(attempt.sourceCapturedBeforeExecution,true);assert.equal(attempt.executionEnvironment,'github-hosted');assert.equal(attempt.runtime.version,'v24.16.0');assert.equal(attempt.runtime.platform,'win32');
for(const value of [attempt.environment]){assert.equal(value.GITHUB_RUN_ID,run);assert.equal(value.GITHUB_RUN_ATTEMPT,'1');assert.equal(value.GITHUB_SHA,tested);assert.equal(value.GITHUB_REPOSITORY,'Ginderlax/rea-research-lab');assert.equal(value.RUNNER_ENVIRONMENT,'github-hosted');assert.equal(value.RUNNER_OS,'Windows');}
assert.equal(attempt.environment.GITHUB_REF,'refs/pull/1/merge');assert.equal(attempt.historicalDevelopmentReceiptOverwritten,false);assert.equal(attempt.fullFeatureParityEstablished,false);assert.equal(attempt.universalSuperiorityEstablished,false);
const beforeBytes=evidence('source-before.json');assert.deepEqual(beforeBytes,evidence('source-after.json'));const before=JSON.parse(beforeBytes);assert.equal(before.length,789);assert.equal(new Set(before.map(r=>r.path)).size,789);
const tests=before.filter(r=>r.path.endsWith('.test.mjs')&&!r.path.split('/').includes('results')).map(r=>r.path);assert.deepEqual(attempt.selectedTestFiles,tests);assert.deepEqual(attempt.command.slice(4),tests);
