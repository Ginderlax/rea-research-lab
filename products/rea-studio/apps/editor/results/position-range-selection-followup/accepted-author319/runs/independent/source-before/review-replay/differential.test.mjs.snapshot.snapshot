import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';
import * as candidate from '../position-range-selection.mjs';
import {original,oracleTelemetry} from './oracle.mjs';import {root,stage,hash,pins} from './authority.mjs';
const first=await original({label:'fresh-original-realm-A'}),second=await original({label:'fresh-original-realm-B'}),observations=[],counts={originalDispatches:0,candidateDispatches:0,pairedExact:0,pairedUnequal:0,readonlyReceiverLabelComparisons:0};
const api={original:first.api,candidate};
function encode(value,seen=new Set()){if(value===undefined)return{special:'undefined'};if(typeof value==='number'){if(Object.is(value,-0))return{special:'-0'};if(!Number.isFinite(value))return{special:String(value)};return value;}if(typeof value==='bigint')return{special:'bigint',value:String(value)};if(typeof value==='symbol')return{special:'symbol',value:String(value)};if(value===null||typeof value!=='object')return value;if(seen.has(value))return{special:'cycle'};seen.add(value);const out=Array.isArray(value)?Array.from(value,v=>encode(v,seen)):Object.fromEntries(Object.entries(value).map(([k,v])=>[k,encode(v,seen)]));seen.delete(value);return out;}
function call(role,label,fn){counts[role+'Dispatches']++;try{return{ok:true,value:encode(fn())};}catch(e){return{ok:false,error:{name:e.name,message:e.message}};}}
function ctor(role,Type,...args){counts[role+'Dispatches']++;return new Type(...args);}
function pair(label,fn){const expected=call('original',label,()=>fn(first.api,'original')),actual=call('candidate',label,()=>fn(candidate,'candidate'));const equal=JSON.stringify(expected)===JSON.stringify(actual);counts[equal?'pairedExact':'pairedUnequal']++;observations.push({label,original:expected,candidate:actual,exact:equal});assert.deepEqual(actual,expected,label);return actual;}
function position(p){return[p.line,p.character];}function range(r){return r?{start:position(r.start),end:position(r.end),empty:r.isEmpty,single:r.isSingleLine}:null;}function selection(s){return{...range(s),anchor:position(s.anchor),active:position(s.active),reversed:s.isReversed};}
test('fresh text-coordinate fixture and sequential documented transforms retain UTF16 and zero-based values',()=>{
 const text='x\uD83D\uDE80\uD800z',at=text.indexOf('z');assert.equal(at,4);pair('text code-unit coordinate',({Position:P},role)=>{const p=ctor(role,P,11,at),a=p.translate({lineDelta:2,characterDelta:1}),b=a.with({line:9}),c=b.with(undefined,at);return{p:position(p),a:position(a),b:position(b),c:position(c),alias:p.translate()===p,unchanged:p.with({line:p.line})===p,sourceUnchanged:position(p)};});
});
test('independent finite lexicographic comparisons agree with numeric reference and original for boundary-neighbor points',()=>{
 const points=[[2,31],[2,32],[3,0],[3,1],[19,65534],[19,65535],[19,65536],[Number.MAX_SAFE_INTEGER-1,5],[Number.MAX_SAFE_INTEGER,5]];
 for(const a of points)for(const b of points)pair('neighbor comparison '+JSON.stringify([a,b]),({Position:P},role)=>{const p=ctor(role,P,...a),q=ctor(role,P,...b),sign=a[0]===b[0]?Math.sign(a[1]-b[1]):Math.sign(a[0]-b[0]);assert.equal(p.compareTo(q),sign);return[p.isBefore(q),p.isBeforeOrEqual(q),p.isAfter(q),p.isAfterOrEqual(q),p.isEqual(q),p.compareTo(q),P.Min(p,q)===p,P.Max(p,q)===q];});
});
test('touching ranges, gaps, containment and Selection inherited returns preserve aliases and directions',()=>{
 const specs=[[[3,3],[3,17],[3,17],[4,0]],[[7,19],[7,1],[7,3],[7,12]],[[8,2],[8,2],[8,3],[9,0]],[[1,9],[4,6],[2,0],[2,9]]];
 for(const [a,b,c,d]of specs)pair('geometry '+JSON.stringify([a,b,c,d]),({Position:P,Range:R,Selection:S},role)=>{const p=ctor(role,P,...a),q=ctor(role,P,...b),r=ctor(role,R,p,q),other=ctor(role,R,...c,...d),s=ctor(role,S,p,q),i=r.intersection(other),u=r.union(other),si=s.intersection(other),su=s.union(other),changed=s.with({start:ctor(role,P,0,0)});return{r:range(r),other:range(other),s:selection(s),i:range(i),u:range(u),contains:[r.contains(p),r.contains(q),r.contains(other)],aliases:[r.with()===r,s.with()===s,u===r,u===other],inheritedKinds:[si?.constructor.name,su?.constructor.name,changed.constructor.name],equal:r.isEqual(ctor(role,R,r.start,r.end))};});
 pair('equal endpoints swap references and empty reversal',({Position:P,Range:R,Selection:S},role)=>{const p=ctor(role,P,6,9),q=ctor(role,P,6,9),r=ctor(role,R,p,q),s=ctor(role,S,p,q);return{rangeStartIsQ:r.start===q,rangeEndIsP:r.end===p,selection:selection(s),anchorIsEnd:s.anchor===s.end};});
});
test('numeric malformed and released coercion boundaries retain exact library errors and nonfinite state',()=>{
 const values=[-Number.MIN_VALUE,-3.5,-Infinity,Number.MIN_VALUE,1.75,Number.MAX_SAFE_INTEGER+2,Number.MAX_VALUE,-0,Infinity,NaN,undefined,null,'-2','03',true,1n,Symbol('independent coordinate')];
 for(const value of values)for(const type of ['Position','Range','Selection'])pair('constructor boundary '+type+' '+String(value),(a,role)=>{const v=ctor(role,a[type],...(type==='Position'?[value,3]:[value,3,2,7]));return type==='Position'?position(v):type==='Range'?range(v):selection(v);});
 for(const value of [undefined,null,0,-1,2,'2',false,1n,Symbol('delta')])for(const name of ['translate','with'])pair('option primitive '+name+' '+String(value),({Position:P},role)=>position(ctor(role,P,8,13)[name](value,1)));
});
test('stateful getters preserve original evaluation order through coercion and option conversion',()=>{
 pair('changing option reads',({Position:P},role)=>{const log=[],p=ctor(role,P,6,8),change={get lineDelta(){log.push('lineDelta');return log.filter(x=>x==='lineDelta').length===1?2:'3';},get characterDelta(){log.push('characterDelta');return log.filter(x=>x==='characterDelta').length===1?1:4;}},translated=p.translate(change);return{state:position(translated),log};});
 pair('position-like getters and constructor conversion',({Position:P,Range:R},role)=>{const log=[],v={get line(){log.push('line');return 5;},get character(){log.push('character');return 11;}},p=ctor(role,P,3,7),r=ctor(role,R,v,p);return{r:range(r),log,clone:r.end!==v};});
 pair('coercion throws unchanged custom error',({Position:P},role)=>{const value={valueOf(){throw Error('Owned coercion refusal');}};return position(ctor(role,P,value,1));});
});
test('finite proxies and inherited options are read without property enumeration or prototype writes',()=>{
 pair('proxy options trap order',({Position:P},role)=>{const log=[],v=new Proxy(Object.create({line:5,character:14}),{get(t,k,r){log.push(String(k));return Reflect.get(t,k,r);},ownKeys(){throw Error('Unexpected ownKeys');}}),p=ctor(role,P,4,13);return{state:position(p.with(v)),log,prototypeSafe:!Object.hasOwn(Object.prototype,'line')};});
 pair('malformed range duck and methods',({Range:R},role)=>{const r=ctor(role,R,2,4,7,9),bad={start:{line:3,character:6},end:{line:5,character:8}};return{contains:r.contains(bad),guard:R.isRange(bad),converted:range(R.of(bad))};});
 pair('null range replacement rejects before mutation',({Range:R},role)=>range(ctor(role,R,2,4,7,9).with(undefined,null)));
});
test('actual foreign-realm positions clone into local constructors while local values and Selection aliases remain local',()=>{
 for(const role of ['original','candidate']){const local=api[role],foreign=role==='original'?candidate:second.api;const a=ctor(role,foreign.Position,4,19),b=ctor(role,foreign.Position,6,1),p=ctor(role,local.Position,8,2),r=ctor(role,local.Range,a,b),s=ctor(role,local.Selection,a,b),converted=local.Position.of(a);const row={localExistingAlias:local.Position.of(p)===p,foreignClone:converted!==a,foreignCloneLocal:converted instanceof local.Position,rangeClones:r.start!==a&&r.end!==b,selectionClones:s.anchor!==a&&s.active!==b,range:range(r),selection:selection(s),guards:[local.Position.isPosition(a),local.Range.isRange(r),local.Selection.isSelection(s)]};observations.push({label:'actual realm clone '+role,role,value:encode(row)});if(role==='original')globalThis.__editorRealmExpected=row;else{assert.deepEqual(row,globalThis.__editorRealmExpected);delete globalThis.__editorRealmExpected;counts.pairedExact++;}}
});
test('all selected readonly accessors reject assignment and keep state; raw engine labels are retained separately',()=>{
 for(const [type,property]of [['Position','line'],['Position','character'],['Range','start'],['Range','end'],['Range','isEmpty'],['Range','isSingleLine'],['Selection','anchor'],['Selection','active'],['Selection','isReversed']]){
  const rows=[];for(const role of ['original','candidate']){const value=ctor(role,api[role][type],...(type==='Position'?[9,23]:[9,23,10,7])),before=encode(value[property]),raw=call(role,type+'.readonly '+property,()=>{value[property]=42;return value[property];});assert.equal(raw.ok,false);assert.equal(raw.error.name,'TypeError');assert.deepEqual(encode(value[property]),before);const descriptor=Object.getOwnPropertyDescriptor(api[role][type].prototype,property);rows.push({role,error:raw.error,before,unchanged:true,descriptor:{get:typeof descriptor.get,set:typeof descriptor.set,enumerable:descriptor.enumerable,configurable:descriptor.configurable}});}
  assert.deepEqual(rows[0].before,rows[1].before);assert.deepEqual(rows[0].descriptor,rows[1].descriptor);counts.readonlyReceiverLabelComparisons++;observations.push({label:type+'.readonly '+property,rows,rawMessageEqual:rows[0].error.message===rows[1].error.message,exactMessageComparisonClaim:false});
 }
});
test('protected field mutation and freezing match released shallow immutability rather than inventing deep freezing',()=>{
 pair('writable own coordinate fields',({Position:P,Range:R},role)=>{const p=ctor(role,P,6,2),q=ctor(role,P,8,9),r=ctor(role,R,p,q);p._line=7;const names=Object.keys(p);Object.preventExtensions(p);p._character=4;Object.freeze(p);let error;try{p._line=10;}catch(e){error=e.name;}return{p:position(p),r:range(r),names,frozen:Object.isFrozen(p),error,newValue:position(p.with(9,2))};});
});
test('subclass initialization shadows prototype setters and changed methods preserve original base-type returns',()=>{
 pair('subclass own fields',({Position:P,Range:R,Selection:S},role)=>{class ChildP extends P{set _line(v){throw Error('Setter should be shadowed');}}class ChildR extends R{}class ChildS extends S{}const p=ctor(role,ChildP,9,13),r=ctor(role,ChildR,p,ctor(role,P,11,0)),s=ctor(role,ChildS,p,ctor(role,P,7,4));return{fieldOwn:Object.hasOwn(p,'_line'),p:position(p),same:p.with()===p,changedP:p.translate(1).constructor.name,changedR:r.with(ctor(role,P,0,0)).constructor.name,changedS:s.with(ctor(role,P,0,0)).constructor.name,s:selection(s)};});
});
test('ordinary ES5 legacy call/apply helpers compose valid receivers and preserve exact malformed argument rejection',()=>{
 for(const type of ['Position','Range','Selection'])for(const mode of ['call','apply'])pair('legacy '+type+' '+mode,(a,role)=>{const T=a[type];function Legacy(){}Legacy.prototype=Object.create(T.prototype);Legacy.prototype.constructor=Legacy;const receiver={constructor:Legacy},args=type==='Position'?[4,8]:[4,8,9,1],v=mode==='call'?T.call(receiver,...args):T.apply(receiver,args);return{legacy:v instanceof Legacy,base:v instanceof T,state:type==='Position'?position(v):type==='Range'?range(v):selection(v),receiverUntouched:!Object.hasOwn(receiver,'_line')&&!Object.hasOwn(receiver,'_start')};});
 for(const mode of ['call','apply'])pair('legacy null receiver '+mode,({Position:P})=>P[mode](null,1,2));
});
test('non-documented legacy call/apply constructor-function behavior matches released helper functions',()=>{
 const mismatches=[];for(const type of ['Position','Range','Selection'])for(const mode of ['call','apply']){const rows={};for(const role of ['original','candidate']){const T=api[role][type];function Legacy(){}Legacy.prototype=Object.create(T.prototype);Legacy.prototype.constructor=Legacy;const receiver={constructor:Legacy},args=type==='Position'?[2,9]:[2,9,6,1];rows[role]=call(role,'construct legacy helper '+type+'.'+mode,()=>{const v=Reflect.construct(T[mode],mode==='call'?[receiver,...args]:[receiver,args]);return{legacy:v instanceof Legacy,state:type==='Position'?position(v):type==='Range'?range(v):selection(v)};});}const exact=JSON.stringify(rows.original)===JSON.stringify(rows.candidate);counts[exact?'pairedExact':'pairedUnequal']++;observations.push({label:'legacy helper constructibility '+type+'.'+mode,...rows,exact,documentedPublicEntry:false});if(!exact)mismatches.push(type+'.'+mode);}assert.deepEqual(mismatches,[],'Undocumented helper function constructibility differs');
});
test('corrupt original source and incorrect Node identity reject before any original VM unit executes',async t=>{
 const mirror=path.join(root,'negative-source-mirror');await fs.mkdir(mirror,{recursive:true});t.after(async()=>{assert.ok(mirror.startsWith(root+path.sep));await fs.rm(mirror,{recursive:true,force:true});});
 const names=['src/vs/base/common/errors.ts',...['es5ClassCompat','position','range','selection'].map(n=>'src/vs/workbench/api/common/extHostTypes/'+n+'.ts')];for(const name of names){const dest=path.join(mirror,'source',name+'.snapshot');await fs.mkdir(path.dirname(dest),{recursive:true});await fs.copyFile(path.join(stage,'source',name+'.snapshot'),dest);}await fs.appendFile(path.join(mirror,'source/src/vs/workbench/api/common/extHostTypes/position.ts.snapshot'),'\n// owned negative gate\n');
 const units=oracleTelemetry.sourceUnitsEvaluated,evaluations=oracleTelemetry.vmEvaluations;await assert.rejects(original({sourceRoot:mirror,label:'corrupt-source-gate'}));assert.equal(oracleTelemetry.sourceUnitsEvaluated,units);assert.equal(oracleTelemetry.vmEvaluations,evaluations);await assert.rejects(original({expectedNodeSHA:'0'.repeat(64),label:'node-identity-gate'}));assert.equal(oracleTelemetry.sourceUnitsEvaluated,units);assert.equal(oracleTelemetry.vmEvaluations,evaluations);observations.push({label:'negative provenance gates',sourceRejected:true,nodeRejected:true,originalVmEvaluationsAdded:0});
});
test.after(async()=>{const output=process.env.EDITOR_REVIEW_OUTPUT;assert.ok(output);await fs.mkdir(output,{recursive:true});const b=Buffer.from(JSON.stringify({counts,oracleTelemetry,observations})+'\n');assert.ok(b.length<=8*1024*1024);await fs.writeFile(path.join(output,'comparisons.json'),b,{flag:'wx'});console.log('REA_EDITOR_INDEPENDENT '+JSON.stringify({counts,bytes:b.length,sha256:hash(b),oraclePreparations:oracleTelemetry.preparations,successfulOriginalPreparations:oracleTelemetry.successful,rejectedOriginalPreparations:oracleTelemetry.rejected,sourceUnitsEvaluated:oracleTelemetry.sourceUnitsEvaluated,vmEvaluations:oracleTelemetry.vmEvaluations,originalWorkBenchExecutions:0,originalExtensionHostExecutions:0}));});
