    },
    {
      "id": "grafana.candidate.0b1c28b13bca28cbd6a6",
      "syntaxRole": "table-row",
      "sourceText": "| Community        | <p>Community plugins have dependent technologies that are open source and not for profit.</p><p>Community plugins are published in the official Grafana catalog, and are available to the Grafana community.</p>         |",
      "headingPath": [
        "Plugin signatures",
        "Plugin signature levels"
      ],
      "source": {
