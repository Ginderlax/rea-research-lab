    {
      "id": "grafana.candidate.990af41bab029ed87adb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Some scenarios run entirely in the browser (Streaming Client, Grafana Live, Grafana API, Steps, No Data Points). These scenarios don't send queries to the backend, which means they can't be used with [Grafana Alerting](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/testdata/alerting/) or in any context that requires server-side evaluation.",
      "headingPath": [
        "TestData query editor"
      ],
      "source": {
        "path": "docs/sources/datasources/testdata/query-editor/index.md",
        "gitBlobSha": "f0dbd93c47c5db43b537686a1794db68223719a8",
