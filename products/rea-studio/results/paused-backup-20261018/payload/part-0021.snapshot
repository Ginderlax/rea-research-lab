disk=next(o for o in cc['observations']if o['kind']=='owned-synthetic-disk-record');state=json.loads(browser[disk['path']])
base=[n for n in state['notes'].values()if n['title']=='Unrelated saved baseline'];assert len(base)==1 and base[0]['revision']==2 and base[0]['metadataEdited'] and len(base[0]['history'])==1
assert ident(jsjson(base[0]))==canon['unrelatedRawNoteBefore']
dup=bykind['new-task-commit-held-native-duplicate-and-newer-draft'];assert dup['nativeDuplicatePointerClicks']==2 and dup['firstSaveRequests']==1 and dup['nextSubmittedRevision']==1 and dup['finalRevision']==2 and dup['ordinaryEnabledFieldTyping'] and not dup['programmaticDisabledControlProbe']
own=bykind['new-task-editor-ownership-after-actual-commit'];assert own['oldId']!=own['newId'] and own['oldRevision']==own['newRevision']==1
disp=bykind['new-task-disposal-after-actual-first-commit'];assert disp['lateNotesRequests']==0 and disp['detachedControlObserved'] and not disp['detachedControlScrubbingClaimed']
late=bykind['new-task-postcommit-genuine-list400-newer-draft'];assert late['actualHTTPStatus']==400 and late['restoredBeforeHeldDelivery'] and late['nextSubmittedRevision']==1 and late['finalRevision']==2
refresh=bykind['new-task-committed-save-refresh-failure-explicit-recovery'];assert refresh['actualHTTPStatus']==400 and refresh['restoredBeforeDelivery'] and refresh['explicitRefreshStatus']==200 and refresh['stateBefore']==refresh['stateAfter']
def tarrows(raw):
    with tarfile.open(fileobj=io.BytesIO(raw),mode='r:')as t:
        members=t.getmembers();assert all(m.isfile()for m in members)and len({m.name for m in members})==len(members);return {m.name:t.extractfile(m).read()for m in members}
native=bykind['new-task-actual-jex-native-tar-and-resource-download'];newtar=tarrows(next(browser[x['path']]for x in downloads if x['path'].endswith('.jex')))
original=tarrows(browser['composition-source/'+P+'apps/notes/fixtures/pinned-joplin.jex.snapshot'])
assert len(original)==8 and len(newtar)==9
for n,raw in original.items():assert newtar[n]==raw
assert len([n for n in original if n.endswith('.md')])==7
newname=native['noteId'].replace('-','')+'.md';newtext=newtar[newname].decode();parts=newtext.split('\n\n');assert parts[0]=='New task alongside original records' and parts[1]=='Preserved new task body'
for line in ['parent_id: 11111111111111111111111111111111','is_todo: 1','todo_due: 0','todo_completed: 0','type_: 1']:assert line in newtext.splitlines()
resource=next(browser[x['path']]for x in downloads if x['path'].endswith('.bin'));assert resource==bytes([0,1,2,3,255])
pngs=[raw for n,raw in browser.items()if n.startswith('screenshots/')and n.endswith('.png')];assert len(pngs)==8
for raw in pngs:
    assert raw[:8]==b'\x89PNG\r\n\x1a\n';pos=8;seen=[]
    while pos<len(raw):
        length=struct.unpack('>I',raw[pos:pos+4])[0];kind=raw[pos+4:pos+8];chunk=raw[pos+8:pos+8+length];crc=struct.unpack('>I',raw[pos+8+length:pos+12+length])[0];assert zlib.crc32(kind+chunk)&0xffffffff==crc;seen.append(kind);pos+=12+length
    assert pos==len(raw) and seen[0]==b'IHDR' and seen[-1]==b'IEND'
report={'schema':'rea-independent-actual-corrected-NewTodo111-8-behavior-and-backup-review/v1','status':'passed-actual-hosted-experimental-scope','reviewer':'/root/archive_review_1245','runId':RUN,'headSHA':HEAD,'rawRunAndBothJobsSuccess':True,'artifacts':backups,'all1108MembersCRCAndHashMatchedReadableCopies':True,'rawAPIAndBothLogsAuthenticated':True,'actualFinite':{'groups':111,'passed':111,'failed':0,'files':21,'oldNames':23,'newNames':19},'previouslyFailedGroupsNowPass':regressions,'separateHelperComparisons':[20,4,2],'all8ActualBrowserCasesAndCleanupsPassed':True,'canonicalBaselineWholeNoteIdentity':canon['unrelatedRawNoteBefore'],'genuineEmptyTitle400':True,'nativeDuplicateClickGuardAndNewerDraft':dup,'differentEditorOwnership':own,'disposal':disp,'twoGenuineRestoredIOFault400s':faults,'nativeDownloads':2,'all7OriginalNativeRecordsAndOriginalResourceByteExact':True,'independentTarNewTaskTitleBodyAndMetadataVerified':True,'all8PNGChunksCRCVerified':True,'composerAndBrowserAlwaysPostchecksPassed':True,'sourceOverlay':True,'productionInstalled':False,'applicationSourcesChangedFieldQualification':'False means no mutations during the measured execution interval after composition. The hosted checkout did apply seven explicit application overlays; this is an experiment, not a production installation.','historicalReceiptsRebound':False,'originalFullApplicationExecutions':0,'fullParity':False,'superiority':False,'localProductExecutions':0,'localTests':0,'localBuilds':0,'localBrowserExecutions':0,'localCandidateImports':0,'localSyntaxChecks':0,'activeWrites':0,'gitMutations':0,'errors':[]}
out=W/'new-todo-r5-38930449217-independent-actual-behavior-and-backup-review.json';assert not out.exists();out.write_text(json.dumps(report,indent=2)+'\n',encoding='utf8');print(json.dumps({'report':str(out),'identity':ident(read(out)),'status':report['status']}))
