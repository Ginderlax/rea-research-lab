    {
      "id": "grafana.candidate.0d468a142980f84fc566",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Viewers can access and use [Explore](../../explore/) and perform temporary edits on panels in dashboards they have access to. They cannot save their changes. Default is `false`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[users]`",
        "`viewers_can_edit`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
