    },
    {
      "id": "grafana.candidate.041a77c98f2f61f75a14",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This creates an annotation at every step interval where an alert is firing. The `ALERTS` metric includes labels such as:",
