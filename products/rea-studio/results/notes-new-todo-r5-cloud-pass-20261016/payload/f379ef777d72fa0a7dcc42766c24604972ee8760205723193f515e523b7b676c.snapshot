// Read-only GitHub API and portable evidence backup. No candidate/product runs.
// An exact run/head/job binding and approved reader digest must replace PENDING.
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { createHash } from 'node:crypto';
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab');
const runId='PENDING_ACTUAL_RUN_ID',head='PENDING_COMMITTED_HEAD';
const jobsExpected=new Map([['finite',{id:0,name:'finite-twenty-one-file-selection'}],['browser',{id:0,name:'eight-real-chromium-scenarios'}]]);
const reader={name:'unpack-notes-new-todo-r5-PENDING-v2.py',bytes:0,sha256:'PENDING_APPROVED_READER_DIGEST'};
assert(/^[0-9]+$/.test(runId)&&/^[0-9a-f]{40}$/.test(head),'Unbound template must not run');
assert([...jobsExpected.values()].every(row=>Number.isSafeInteger(row.id)&&row.id>0));assert.equal(new Set([...jobsExpected.values()].map(row=>row.id)).size,2);
const digest=bytes=>createHash('sha256').update(bytes).digest('hex');
const readerBytes=await fs.readFile(path.join(work,reader.name));assert.equal(readerBytes.length,reader.bytes);assert.equal(digest(readerBytes),reader.sha256);
async function exists(filename){try{await fs.access(filename);return true;}catch(error){if(error.code==='ENOENT')return false;throw error;}}
const credential=spawnSync('git',['credential','fill'],{cwd:lab,env:{...process.env,GIT_TERMINAL_PROMPT:'0',GCM_INTERACTIVE:'Never'},input:'protocol=https\nhost=github.com\n\n',encoding:'utf8',windowsHide:true,timeout:20000});assert.equal(credential.status,0,'Saved authentication unavailable');
const fields=Object.fromEntries(credential.stdout.split('\n').filter(line=>line.includes('=')).map(line=>{const at=line.indexOf('=');return[line.slice(0,at),line.slice(at+1)];}));assert(fields.password);
const headers={Accept:'application/vnd.github+json','User-Agent':'REA-cloud-verification','X-GitHub-Api-Version':'2022-11-28',Authorization:'Bearer '+fields.password};
async function request(endpoint,limit){assert(endpoint.startsWith('/repos/Ginderlax/rea-research-lab/actions/'));const response=await fetch('https://api.github.com'+endpoint,{headers,signal:AbortSignal.timeout(60000)});assert.equal(response.status,200);const chunks=[];let size=0;for await(const chunk of response.body){size+=chunk.length;assert(size<=limit);chunks.push(chunk);}return Buffer.concat(chunks);}
const folder=path.join(work,'cloud-verification-backups','run-'+runId);await fs.mkdir(folder,{recursive:true});
const rows=await Promise.all(['run','jobs','artifacts'].map(async kind=>{const endpoint='/repos/Ginderlax/rea-research-lab/actions/runs/'+runId+(kind==='run'?'':'/'+kind+'?per_page=100');const bytes=await request(endpoint,1024*1024);return{kind,bytes,value:JSON.parse(bytes)};}));
const[run,jobs,artifacts]=rows.map(row=>row.value);assert.equal(String(run.id),runId);assert.equal(run.head_sha,head);assert.equal(run.path,'.github/workflows/notes-new-todo-experiment-cloud.yml');assert.equal(run.head_branch,'codex/rea-cloud-recovery-20261015');assert.equal(run.event,'push');assert.equal(run.run_attempt,1);assert.equal(jobs.total_count,2);assert.equal(jobs.jobs.length,2);assert.equal(artifacts.total_count,artifacts.artifacts.length);assert(artifacts.artifacts.length<=2);
const control=path.join(folder,'new-todo-control-plane-'+(run.status==='completed'?'completed':'observation')+'-'+new Date().toISOString().replace(/[:.]/g,'-'));await fs.mkdir(control);
const summary={schema:'rea-Notes-new-todo-R5-two-job-readonly-collection/v2',collectedAtUtc:new Date().toISOString(),runId,attempt:1,headSHA:head,runStatus:run.status,runConclusion:run.conclusion,controlPlane:[],jobs:[],artifacts:[],readerSource:{path:path.join(work,reader.name),bytes:reader.bytes,sha256:reader.sha256},localProductExecutions:0,localTests:0,localBuilds:0,localBrowserExecutions:0,fullParity:false,superiority:false};
for(const row of rows){const filename=path.join(control,row.kind+'.json');await fs.writeFile(filename,row.bytes,{flag:'wx'});summary.controlPlane.push({kind:row.kind,path:filename,bytes:row.bytes.length,sha256:digest(row.bytes)});}
for(const[role,expected]of jobsExpected){const job=jobs.jobs.find(row=>row.id===expected.id);assert(job&&job.name===expected.name&&job.run_id===Number(runId)&&job.head_sha===head);assert(job.labels.includes('windows-2022'));assert.equal(job.runner_group_name,'GitHub Actions');const row={role,jobId:job.id,name:job.name,status:job.status,conclusion:job.conclusion,startedAt:job.started_at,completedAt:job.completed_at,labels:job.labels,runnerGroup:job.runner_group_name,steps:job.steps};
 if(job.status==='completed'){const filename=path.join(work,'cloud-verification-backups','job-'+job.id,'logs.txt');if(!await exists(filename)){const bytes=await request('/repos/Ginderlax/rea-research-lab/actions/jobs/'+job.id+'/logs',20*1024*1024);await fs.mkdir(path.dirname(filename),{recursive:true});await fs.writeFile(filename,bytes,{flag:'wx'});}const bytes=await fs.readFile(filename);row.rawJobLog={path:filename,bytes:bytes.length,sha256:digest(bytes)};}summary.jobs.push(row);
}
const roles=new Set();for(const artifact of artifacts.artifacts){const role=[...jobsExpected.keys()].find(role=>artifact.name==='notes-new-todo-'+role+'-'+runId+'-1');assert(role,'Unexpected artifact role');assert(!roles.has(role),'Duplicate artifact role');roles.add(role);assert.equal(artifact.expired,false);assert.equal(artifact.workflow_run.id,Number(runId));assert.equal(artifact.workflow_run.head_sha,head);const sha256=artifact.digest?.replace(/^sha256:/,'');assert(/^[0-9a-f]{64}$/.test(sha256));
 const filename=path.join(folder,'artifact-'+artifact.id+'.zip');if(!await exists(filename)){const bytes=await request('/repos/Ginderlax/rea-research-lab/actions/artifacts/'+artifact.id+'/zip',32*1024*1024);await fs.writeFile(filename,bytes,{flag:'wx'});}const bytes=await fs.readFile(filename);assert.equal(bytes.length,artifact.size_in_bytes);assert.equal(digest(bytes),sha256);
 const verification=path.join(folder,'artifact-'+artifact.id+'-new-todo-r5-reader-v2','local-new-todo-backup-verification.json');if(!await exists(verification)){const child=spawnSync('C:/Users/evanh/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/python.exe',[path.join(work,reader.name),filename,sha256,role,runId,head],{encoding:'utf8',windowsHide:true,timeout:120000,maxBuffer:4*1024*1024});assert.equal(child.status,0,child.stderr);}
 const readback=JSON.parse(await fs.readFile(verification,'utf8'));assert.equal(readback.allCRCAndBytesReadable,true);assert.equal(readback.runId,runId);assert.equal(readback.sourceCommit,head);assert.equal(readback.role,role);assert.equal(readback.artifactSHA256,sha256);summary.artifacts.push({role,artifactId:artifact.id,artifactName:artifact.name,path:filename,bytes:bytes.length,sha256,verification,readableFiles:readback.files.length,recordedContractPassed:readback.recordedContractPassed,evidenceConsistencyErrors:readback.evidenceConsistencyErrors,sourceProof:readback.sourceProof??null,verifiedObservations:readback.verifiedObservations??null,attempt:readback.attempt});
}
summary.terminalCompleteCollection=run.status==='completed'&&summary.jobs.every(row=>row.status==='completed')&&roles.size===2&&[...jobsExpected.keys()].every(role=>roles.has(role));summary.bothRecordedContractsPassed=summary.terminalCompleteCollection&&run.conclusion==='success'&&summary.jobs.every(row=>row.conclusion==='success')&&summary.artifacts.every(row=>row.recordedContractPassed&&row.evidenceConsistencyErrors.length===0);
await fs.writeFile(path.join(control,'collection-summary.json'),JSON.stringify(summary,null,2)+'\n',{flag:'wx'});if(summary.terminalCompleteCollection&&!await exists(path.join(folder,'new-todo-r5-collection-summary-v2.json')))await fs.writeFile(path.join(folder,'new-todo-r5-collection-summary-v2.json'),JSON.stringify(summary,null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({...summary,jobs:summary.jobs.map(({steps,...row})=>row),artifacts:summary.artifacts.map(({attempt,...row})=>row)}));
