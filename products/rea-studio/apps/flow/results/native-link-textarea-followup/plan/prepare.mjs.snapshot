import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const own=import.meta.dirname,base=path.resolve(own,'../..'),repo=path.join(base,'outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)}),sources=[];
const prefix='products/rea-studio/apps/flow/results/native-link-textarea-followup';
function safe(p){assert(typeof p==='string'&&p&&p.split('/').every(s=>s&&s!=='.'&&s!=='..')&&!/[\\:\x00-\x1f\x7f]/.test(p));return p;}function read(root,p,e){safe(p);let at=root;for(const s of p.split('/')){at=path.join(at,s);assert(!fs.lstatSync(at).isSymbolicLink());}const b=fs.readFileSync(at);assert(b.length<=32*1024*1024);if(e)assert.deepEqual(id(b),{bytes:e.bytes,sha256:e.sha256});sources.push({root:path.relative(base,root).replaceAll('\\','/'),path:p,...id(b)});return b;}function save(p,b){const at=path.join(own,p);fs.mkdirSync(path.dirname(at),{recursive:true});fs.writeFileSync(at,b,{flag:'wx'});}
const definitions=[['static-link-stage','work/flow-native-link-next',457,'0a03866476a81f83762bdfc10d65be639c24f25778b6c03fdac5b9ee906bea5d'],['textarea-correction','work/flow-native-textarea-normalization-fix-next',197,'70c19b06ecca7b79a9461cb53680429cee2bdc91e022c5015fdf19b258f69ce9'],['independent-model-review','work/flow-native-textarea-normalization-independent-review',64,'d96e755f491a5747ede7b612213ecaa12657c1f01dcfd7d55721e3110ec2ca78'],['root-static-review','work/root-flow-link-review-preservation-next',38,'fd3fbb1e3b20cd0d4e21b996717c71e3dab5b504759ec30958488897d06efaaa'],['root-negative-browser','work/root-flow-link-browser-review-next',28,'bae3c0a14e33e8bdd083a86046c6f1e15c455805d4d8e24f899ba0d0793c5f2b']];
const epochs=[],map=[],publicNames=new Set();for(const [name,relative,n,pin] of definitions){const root=path.join(base,relative),mb=read(root,'manifest.json');assert.equal(sha(mb),pin);const m=JSON.parse(mb);assert.equal(m.inventory.length,n);const rows=[...m.inventory,{path:'manifest.json',...id(mb)}];if(fs.existsSync(path.join(root,'freeze.json')))rows.push({path:'freeze.json',...id(read(root,'freeze.json'))});const record={name,sourceRoot:relative,manifest:'manifest.json',manifestIdentity:id(mb),strictPayloads:n,mappedRows:rows.length,sidecars:rows.filter(r=>!m.inventory.some(s=>s.path===r.path)).map(r=>r.path)};epochs.push(record);save('authority/'+name+'.manifest.json.snapshot',mb);for(const r of rows){const b=read(root,r.path,r);assert(!(b[0]===77&&b[1]===90));assert(!(b[0]===80&&b[1]===75));assert(!(b[0]===31&&b[1]===139));assert(!/\.(?:exe|dll|tgz|zip|7z|tar|gz|kdbx)$/i.test(r.path));assert(!r.path.split('/').includes('.local'));const publicPath=prefix+'/'+name+'/frozen/'+r.path+'.snapshot';assert(!publicNames.has(publicPath));publicNames.add(publicPath);map.push({epoch:name,sourceRoot:relative,sourcePath:r.path,publicPath,...id(b),inert:true,originalExecutable:false});}}
const linkRoot=path.join(base,definitions[0][1]),correctionRoot=path.join(base,definitions[1][1]),linkProposal=JSON.parse(read(linkRoot,'installation-proposal.json')),provenance=JSON.parse(read(linkRoot,'source-provenance.json')),acquisition=JSON.parse(read(linkRoot,'acquisition.json'));assert.equal(linkProposal.proposals.length,14);assert.equal(linkProposal.proposals.filter(r=>r.operation==='REPLACE').length,5);assert.equal(linkProposal.proposals.filter(r=>r.operation==='ADD').length,9);
const baseline=provenance.productionBaseline;assert.equal(baseline.length,18);for(const r of baseline)read(repo,r.path,r);save('current-baseline18.json',JSON.stringify(baseline,null,2)+'\n');const app='candidate/products/rea-studio/apps/flow/',rows=[];
for(const p of linkProposal.proposals){const filename=path.posix.basename(p.target);const originalRoot=filename==='link-original.test.mjs'?linkRoot:correctionRoot,sourcePath=filename==='link-original.test.mjs'?p.source:app+filename;const b=read(originalRoot,sourcePath);if(p.operation==='REPLACE')read(repo,p.target,p.before);else assert(!fs.existsSync(path.join(repo,p.target)));save('proposals/'+filename,b);rows.push({destination:p.target,operation:p.operation,before:p.operation==='REPLACE'?p.before:null,sourcePath:'proposals/'+filename,sourceRoot:path.relative(base,originalRoot).replaceAll('\\','/'),originalSourcePath:sourcePath,sourceIdentity:id(b),after:id(b),runtimeSemanticsUnchangedFromAcceptedCandidate:true});}
const seedPath='fixtures/normalization-seed.json',adapters=JSON.parse(read(correctionRoot,'installed-test-adapters.json'));assert.equal(adapters.adapters.length,2);for(const filename of ['normalization-ui-fixture.mjs','normalization-ui.test.mjs','normalization-boundaries.test.mjs',seedPath,'NATIVE-TEXT-SOURCE.md']){const destination='products/rea-studio/apps/flow/'+filename;assert(!fs.existsSync(path.join(repo,destination)));const original=read(correctionRoot,app+filename),a=adapters.adapters.find(a=>a.file===filename);let b=original;if(a){assert.deepEqual(id(original),a.source);let text=original.toString(),inverse;for(const e of a.edits){assert.equal(text.split(e.before).length-1,1);text=text.replace(e.before,e.after);}b=Buffer.from(text);assert.deepEqual(id(b),a.proposal);inverse=text;for(const e of [...a.edits].reverse())inverse=inverse.replace(e.after,e.before);assert.deepEqual(Buffer.from(inverse),original);}save('proposals/'+filename,b);rows.push({destination,operation:'ADD',before:null,sourcePath:'proposals/'+filename,sourceRoot:definitions[1][1],originalSourcePath:app+filename,sourceIdentity:id(original),after:id(b),pathOnlyAdapter:a??null,assertionBodiesUnchanged:!!a});}
assert.equal(rows.length,19);assert.equal(rows.filter(r=>r.operation==='REPLACE').length,5);assert.equal(rows.filter(r=>r.operation==='ADD').length,14);assert.equal(new Set(rows.map(r=>r.destination)).size,19);
const oldOriginal=read(linkRoot,app+'link-original.test.mjs').toString(),installedOriginal=fs.readFileSync(path.join(own,'proposals/link-original.test.mjs'),'utf8'),cacheAdapter=JSON.parse(read(linkRoot,'proposed-live/adapter.json'));assert.equal(cacheAdapter.edits.length,2);let expected=oldOriginal,inverse=installedOriginal;for(const e of cacheAdapter.edits){assert.equal(expected.split(e.before).length-1,1);expected=expected.replace(e.before,e.after);}for(const e of [...cacheAdapter.edits].reverse()){assert.equal(inverse.split(e.after).length-1,1);inverse=inverse.replace(e.after,e.before);}assert.equal(expected,installedOriginal);assert.equal(inverse,oldOriginal);save('test-path-adapters.json',JSON.stringify({schema:'rea-flow-current-layout-path-only-adapters/v1',originalCache:{file:'link-original.test.mjs',before:id(Buffer.from(oldOriginal)),after:id(Buffer.from(installedOriginal)),edits:cacheAdapter.edits,inverseExact:true,originalExecuted:false,scope:'Default original cache path and forwarding the selected cache to its plain test child only.'},normalizationSeed:adapters,preparedOnly:true,testBodiesUnchanged:true},null,2)+'\n');
const authoritySeed=JSON.parse(read(correctionRoot,'authority/browser28-seed.json.snapshot')),installedSeed=JSON.parse(fs.readFileSync(path.join(own,'proposals/'+seedPath)));assert.deepEqual(installedSeed,authoritySeed);
const localOnly=[];for(const pkg of acquisition.packages){const filename=pkg.name==='@node-red/nodes'?'node-red-nodes-5.0.8.tgz':'node-red-runtime-5.0.8.tgz',p='.local/carriers/'+filename,b=read(linkRoot,p,{bytes:pkg.archiveBytes,sha256:pkg.archiveSHA256});localOnly.push({sourceRoot:definitions[0][1],sourcePath:p,...id(b),public:false,reason:'Exact official compressed carrier; complete selected source/license snapshots are public-map eligible instead.'});}for(const r of provenance.officialSources)assert(map.some(m=>m.epoch==='static-link-stage'&&m.sourcePath===r.snapshot&&m.bytes===r.bytes&&m.sha256===r.sha256));assert.equal(provenance.officialSources.length,8);assert.equal(provenance.verificationAuxiliary.length,10);
const registries=[];for(const filename of ['workspace-products.json','visual-products.json','system-products.json']){const b=read(repo,'products/rea-studio/requirements/'+filename),j=JSON.parse(b),caps=filename==='workspace-products.json'?j.capabilities:filename==='visual-products.json'?j.baselineProducts.flatMap(p=>p.requirements):j.products.flatMap(p=>p.capabilities);registries.push({filename,identity:id(b),sourceIDs:j.sources.map(s=>({id:s.id,sha256:s.sha256})),capabilityIDs:caps.map(c=>c.id)});}assert.equal(registries.reduce((n,r)=>n+r.sourceIDs.length,0),159);assert.equal(registries.reduce((n,r)=>n+r.capabilityIDs.length,0),232);save('original-registry-identities.json',JSON.stringify({scope:'At this preparation interval only; later root metadata updates may change whole bytes, original159SHA/232IDs must remain.',registries},null,2)+'\n');
save('excluded-local-carriers.json',JSON.stringify({schema:'rea-flow-publication-local-only-carriers/v1',records:localOnly,nonPayloadPrefixes:['Original installed verification dependencies and generated ignored outputs; no all-work-tree census claim.'],nativeOriginalExecutablesPublished:0,carriersPublished:0},null,2)+'\n');save('base-public-source-map.json',JSON.stringify({schema:'rea-flow-complete-frozen-source-alias-map/v1',publicPrefix:prefix,epochs,records:map,duplicateByteIdentities:map.length-new Set(map.map(r=>r.bytes+':'+r.sha256)).size,allRowsSourceBound:true,noNativeArchivesOrExecutables:true,pendingCorrectedRootBrowser:true},null,2)+'\n');save('base-installation-proposals.json',JSON.stringify({schema:'rea-flow-combined-static-link-textarea-proposals/v1',proposals:rows,paths:19,replacements:5,additions:14,productionWrites:0,documentationOverlayPending:true,currentLayoutTestsExecuted:false,sharedHostChanges:0},null,2)+'\n');save('preparation-source-identities.json',JSON.stringify(sources,null,2)+'\n');save('PREPARATION.md','Source-only preparation. Five exact frozen epochs map completely, without recursive copied history. Nineteen app paths are proposed: five replacements and fourteen additions. Runtime source is exact accepted candidate; original-cache and two seed-path adapters invert exactly. Documentation/public source-link overlays and the root corrected-browser frozen epoch remain pending. No application/host/original/browser/benchmark execution or production/public writes. Original159 source digests and232 capability IDs are bound separately; registry whole-byte pins describe preparation only.\n');console.log(JSON.stringify({prepared:true,epochs:epochs.length,baseMappedRows:map.length,proposedPaths:rows.length,replace:5,add:14,localCarriers:localOnly.length,browserPending:true,productionWrites:0}));
