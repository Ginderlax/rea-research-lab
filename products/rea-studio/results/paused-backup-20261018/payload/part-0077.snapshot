    },
    {
      "id": "grafana.candidate.81f3c58261cc24683d97",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To enable teamsync, you need to add a `groups` mapper to the client configuration in Keycloak. This will add the `groups` claim to the id_token. You can then use the `groups` claim to map groups to teams in Grafana.",
      "headingPath": [
        "Configure Keycloak OAuth2 authentication",
        "Team sync"
      ],
