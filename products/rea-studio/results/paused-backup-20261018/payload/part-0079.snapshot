      "id": "grafana.candidate.799fb20269aee22b7ae6",
      "syntaxRole": "table-row",
      "sourceText": "| Show percent change | Set whether percent change is displayed or not. Disabled by default. This option is applicable when the **Show** setting, under **Value options**, is set to **Calculate**. |",
      "headingPath": [
        "Stat",
        "Configuration options",
        "Stat styles"
      ],
