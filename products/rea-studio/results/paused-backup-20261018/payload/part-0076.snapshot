    {
      "id": "grafana.candidate.81208cca90b873bb6125",
      "syntaxRole": "table-row",
      "sourceText": "| `$__timeGroup(dateColumn,'5m', 0)`        | Same as `$__timeGroup(dateColumn,'5m')`, but includes a fill parameter to ensure missing points in the series are added by Grafana, using `0` as the default value. Fill only applies to time series queries. |",
      "headingPath": [
        "PostgreSQL query editor",
        "Macros",
        "Time-series macros"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/query-editor/_index.md",
        "gitBlobSha": "da418c753c9813f78e1d4eed64e0946e46a50b3e",
        "sha256": "039487ccd5bee34210f2a93dfc270b66e758127ff361f491daa43c2203030f7f",
        "lineStart": 84,
        "lineEnd": 84,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/query-editor/_index.md#L84-L84"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.4b84382ddd38d38cf4f8",
      "syntaxRole": "table-row",
      "sourceText": "| `$__timeGroup(dateColumn,'5m', NULL)`     | Same as `$__timeGroup(dateColumn,'5m', 0)` but `NULL` is used as the value for missing points. Fill only applies to time series queries.                                                                      |",
      "headingPath": [
        "PostgreSQL query editor",
        "Macros",
        "Time-series macros"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/query-editor/_index.md",
