      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.08fda3482447110e3e44",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "It can be difficult to efficiently navigate through the visually cluttered options during the dashboard editing process. With the introduction of the edit mode, we aim to provide an easier way to discover and interact with the dashboard edit experience.",
      "headingPath": [
        "What’s new in Grafana v11.0",
        "Dashboards and visualizations",
        "Scenes powered Dashboards",
        "Edit mode"
      ],
      "source": {
