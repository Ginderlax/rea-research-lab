    },
    {
      "id": "grafana.candidate.7b72b2302a57a62f53ab",
      "syntaxRole": "table-row",
      "sourceText": "| `FUNCTION`   | Required. Specifies the aggregate function to use, and also specifies the name of the metric to be queried. Valid values are AVG, COUNT, MAX, MIN, and SUM.                                                  |",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Query CloudWatch metrics",
        "Use Metrics Insights keywords"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/query-editor/index.md",
        "gitBlobSha": "ef7df40715eb7f51a378b68c41c217a24bf2e54e",
        "sha256": "2fe99ed2b68f84a70ad35679bb7e67dc68175a40df0b6cabd0948aff1ccd7f23",
        "lineStart": 219,
        "lineEnd": 219,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/aws-cloudwatch/query-editor/index.md#L219-L219"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b62c4dd4900569e29e79",
      "syntaxRole": "table-row",
      "sourceText": "| `MetricName` | Required. For example, `CPUUtilization`.                                                                                                                                                                     |",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Query CloudWatch metrics",
        "Use Metrics Insights keywords"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/query-editor/index.md",
        "gitBlobSha": "ef7df40715eb7f51a378b68c41c217a24bf2e54e",
        "sha256": "2fe99ed2b68f84a70ad35679bb7e67dc68175a40df0b6cabd0948aff1ccd7f23",
        "lineStart": 220,
        "lineEnd": 220,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/aws-cloudwatch/query-editor/index.md#L220-L220"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.672876103ab27e248382",
      "syntaxRole": "table-row",
      "sourceText": "| `FROM`       | Required. Specifies the metric's source. You can specify either the metric namespace that contains the metric to be queried, or a SCHEMA table function. Namespace examples include `AWS/EC2`, `AWS/Lambda`. |",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Query CloudWatch metrics",
        "Use Metrics Insights keywords"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/query-editor/index.md",
        "gitBlobSha": "ef7df40715eb7f51a378b68c41c217a24bf2e54e",
        "sha256": "2fe99ed2b68f84a70ad35679bb7e67dc68175a40df0b6cabd0948aff1ccd7f23",
        "lineStart": 221,
        "lineEnd": 221,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/aws-cloudwatch/query-editor/index.md#L221-L221"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.6ba0bd90169b1f257f33",
      "syntaxRole": "table-row",
      "sourceText": "| `SCHEMA`     | Optional. Narrows the query results to only the metrics that are an exact match, or to metrics that do not match.                                                                                            |",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Query CloudWatch metrics",
        "Use Metrics Insights keywords"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/query-editor/index.md",
        "gitBlobSha": "ef7df40715eb7f51a378b68c41c217a24bf2e54e",
        "sha256": "2fe99ed2b68f84a70ad35679bb7e67dc68175a40df0b6cabd0948aff1ccd7f23",
        "lineStart": 222,
        "lineEnd": 222,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/aws-cloudwatch/query-editor/index.md#L222-L222"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.a6587283c46cbb91b39b",
      "syntaxRole": "table-row",
      "sourceText": "| `WHERE`      | Optional. Filters the query results to only the metrics that match your specified expression. For example, `WHERE InstanceType != 'c3.4xlarge'`.                                                             |",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Query CloudWatch metrics",
        "Use Metrics Insights keywords"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/query-editor/index.md",
