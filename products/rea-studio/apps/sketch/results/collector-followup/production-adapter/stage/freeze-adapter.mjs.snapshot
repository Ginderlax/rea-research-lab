import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),stage=path.resolve(here,'../sketch-collector-next'),product=path.resolve(here,'../../outputs/rea-research-lab/products/rea-studio'),digest=b=>createHash('sha256').update(b).digest('hex'),receipt=JSON.parse(await fs.readFile(path.join(here,'validation.json')));assert.equal(receipt.passed,true);assert.equal(receipt.geometrySuiteExecutions,0);
for(const row of receipt.sourceBefore){assert.equal(digest(await fs.readFile(path.join(here,row.path))),row.sha256);assert.equal(digest(await fs.readFile(path.join(here,receipt.runDirectory,'sources',row.path))),row.sha256);}
for(const row of receipt.productionBefore)assert.equal(digest(await fs.readFile(path.join(product,row.path))),row.sha256);const frozen=JSON.parse(await fs.readFile(path.join(stage,'freeze-validation.json')));for(const row of frozen.files)assert.equal(digest(await fs.readFile(path.join(stage,row.path))),row.sha256);assert.equal(digest(await fs.readFile(path.join(stage,'freeze-validation.json'))),receipt.stageFreezeSha256);
async function inventory(folder,prefix=''){const files=[];for(const item of await fs.readdir(folder,{withFileTypes:true})){const name=prefix+item.name;if(name==='freeze-validation.json')continue;assert.ok(!item.isSymbolicLink());if(item.isDirectory())files.push(...await inventory(path.join(folder,item.name),name+'/'));else{const bytes=await fs.readFile(path.join(folder,item.name));files.push({path:name,bytes:bytes.length,sha256:digest(bytes)});}}return files.sort((a,b)=>a.path.localeCompare(b.path));}
const output={schema:'rea-sketch-collector-production-adapter-freeze/v1',createdAt:new Date().toISOString(),validationSha256:digest(await fs.readFile(path.join(here,'validation.json'))),stageFreezeSha256:receipt.stageFreezeSha256,files:await inventory(here),scope:'Production-ready relative-path adapter only, staged and uninstalled. Exact test/helper/source identities and both synthetic modes retained; frozen predecessor and production unchanged. No geometry28 rerun.'};await fs.writeFile(path.join(here,'freeze-validation.json'),JSON.stringify(output,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({files:output.files.length,sha256:digest(await fs.readFile(path.join(here,'freeze-validation.json'))),testSha256:receipt.sourceBefore.find(row=>row.path==='candidate/tests/sketch-collector.test.mjs').sha256}));
