        "lineEnd": 64,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-security/_index.md#L64-L64"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
