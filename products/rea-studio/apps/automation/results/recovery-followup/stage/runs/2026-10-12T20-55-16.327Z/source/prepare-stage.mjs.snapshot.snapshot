import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const stage=path.dirname(fileURLToPath(import.meta.url)),workspace=path.resolve(stage,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),product=path.join(repo,'products/rea-studio'),app=path.join(product,'apps/automation'),review=path.join(workspace,'work/automation-routing-production-review'),hash=b=>createHash('sha256').update(b).digest('hex');
const reviewBytes=await fs.readFile(path.join(review,'review-validation.json'));assert.equal(hash(reviewBytes),'955d30b496e48b7b09025ceec9aebc6277e0a732f2d0b1fd5ed49c7e5203a0eb');
const receiptBytes=await fs.readFile(path.join(app,'results/routing-validation.json')),receipt=JSON.parse(receiptBytes);assert.equal(hash(receiptBytes),'b85b20796ca6c029ff37cc955e91b62b547ec493721dad4a6342413ddfa03801');
const selected=[...receipt.implementationFingerprints,{path:'apps/automation/results/routing-validation.json',bytes:receiptBytes.length,sha256:hash(receiptBytes)},{path:receipt.preservationManifest.path,bytes:(await fs.stat(path.join(product,receipt.preservationManifest.path))).size,sha256:receipt.preservationManifest.sha256}],baseline=[];
for(const entry of selected){const bytes=await fs.readFile(path.join(product,entry.path));assert.equal(hash(bytes),entry.sha256);assert.equal(bytes.length,entry.bytes);const target=path.join(stage,'production-baseline',entry.path+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,bytes,{flag:'wx'});baseline.push(entry);if(!entry.path.includes('/results/')&&!entry.path.startsWith('scripts/')){const executable=path.join(stage,'products/rea-studio',entry.path);await fs.mkdir(path.dirname(executable),{recursive:true});await fs.writeFile(executable,bytes,{flag:'wx'});}}
async function preserve(folder,prefix=''){const rows=[];for(const entry of await fs.readdir(folder,{withFileTypes:true})){const name=prefix+entry.name;if(entry.isDirectory())rows.push(...await preserve(path.join(folder,entry.name),name+'/'));else if(entry.isFile()){const bytes=await fs.readFile(path.join(folder,entry.name)),target=path.join(stage,'review-before',name+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,bytes,{flag:'wx'});rows.push({originalPath:name,snapshotPath:path.relative(stage,target).replaceAll('\\','/'),bytes:bytes.length,sha256:hash(bytes)});}}return rows;}
const reviewFiles=await preserve(review);assert.ok(reviewFiles.length>=53);
await fs.mkdir(path.join(stage,'.local'),{recursive:true});await fs.symlink(path.join(repo,'.local/automation-original'),path.join(stage,'.local/automation-original'),'junction');
const originalManifest=JSON.parse(await fs.readFile(path.join(app,'routing-original-manifest.json'))),ownOriginal=path.join(stage,'.local/automation-routing-original');for(const[name,sha256]of Object.entries(originalManifest.files)){const bytes=await fs.readFile(path.join(repo,'.local/automation-routing-original',name));assert.equal(hash(bytes),sha256);const target=path.join(ownOriginal,name);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,bytes,{flag:'wx'});}
await fs.writeFile(path.join(stage,'production-baseline.json'),JSON.stringify({schema:'rea-automation-routing-recovery-production-baseline/v1',capturedAtUtc:new Date().toISOString(),sourceRoot:product,selectedFiles:baseline,reviewReceiptSha256:hash(reviewBytes),reviewFiles,originalCache:'Existing authenticated automation-original is referenced read-only by an ignored stage junction; selected routing original files are copied into own ignored stage cache. No acquisition command is allowed through the shared cache junction.',scope:'Explicit current implementation/source/doc identities and two selected reviewed historical receipts. Root-owned additions to public results are outside this mutation baseline.'},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({selectedProductionFiles:baseline.length,preservedReviewFiles:reviewFiles.length,originalOwnEntries:Object.keys(originalManifest.files).length}));
