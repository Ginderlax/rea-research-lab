    {
      "id": "grafana.candidate.ef063bd510e81ba0e877",
      "syntaxRole": "list-item",
      "sourceText": "- **Groupings that contain nested groupings**: Only the grouping level you're ungrouping is removed. The nested groupings move up a level, and any groupings at the same level that contain only panels are converted to the same grouping type, so the structure of your dashboard content is preserved.",
      "headingPath": [
        "Dashboard panel groupings",
        "Ungroup panels"
      ],
