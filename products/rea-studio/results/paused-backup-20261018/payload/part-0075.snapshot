    {
      "id": "grafana.candidate.00c112e948cac0c7a58a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The following scenarios show how to combine the query editor's features to solve real monitoring problems.",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Common use cases"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/query-editor/index.md",
