    },
    {
      "id": "grafana.candidate.702c46c8297f2ee3734c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Add alert values to notification templates, so that you can create a single template that prints the annotations, labels, and values for your alerts in a format of your choice.",
      "headingPath": [
        "What's new in Grafana v9.3",
        "Alerting",
        "Support values in notification templates"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-3.md",
