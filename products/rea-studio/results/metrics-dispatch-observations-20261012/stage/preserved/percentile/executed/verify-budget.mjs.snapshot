const receipt={schemaVersion:1,checkedAt:new Date().toISOString(),candidate:path.basename(candidate),sourceSHA256:createHash('sha256').update(source).digest('hex'),cases:cases.map(([name,values])=>({name,samples:values.length})),comparisons,outputAndInputAndStateExact:true,selectionFunctionCoverage:selector,boundedFallbackMarker:marker,boundedFallbackContainingRanges:containing,boundedFallbackExecutionCount:guardCount,scope:'Original execution equality over independently shaped 25000-sample adversarial inputs, with exact-source V8 coverage proving the work-cap fallback branch. Original authentication is separately recorded by full and held-out source verification for this unchanged candidate.',formalPerformance:false};
await fs.writeFile(path.join(here,'results',path.basename(candidate,'.mjs')+'-budget.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({comparisons,guardCount,sourceSHA256:receipt.sourceSHA256}));
