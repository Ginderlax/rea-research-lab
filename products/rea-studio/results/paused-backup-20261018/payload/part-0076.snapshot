    },
    {
      "id": "grafana.candidate.36226e2aeee0f31b18cd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In your `server` section, add the following configuration:",
      "headingPath": [
        "Loki query editor",
        "Create a log query",
        "Tail live logs",
        "Proxying examples"
      ],
      "source": {
        "path": "docs/sources/datasources/loki/query-editor/index.md",
        "gitBlobSha": "fa8cb5cb875450d848fbe24ea8e51347c60f26a8",
        "sha256": "fb91b2da8e977c8a060669eeaffc278336ffb966cb095c2a769e4b29beb50f2e",
        "lineStart": 263,
        "lineEnd": 263,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/loki/query-editor/index.md#L263-L263"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
