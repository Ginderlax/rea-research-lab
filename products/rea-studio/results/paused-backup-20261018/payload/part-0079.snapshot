    {
      "id": "grafana.candidate.d3715fccc50bfc893459",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Welcome to Grafana 10.4! This minor release contains some notable improvements in its own right, as well as early previews of functionality we intend to turn on by default in Grafana v11. Read on to learn about a quicker way to set up alert notifications, an all-new UI for configuring single sign-on, and improvements to our Canvas, Geomap, and Table panels.",
      "headingPath": [
        "What’s new in Grafana v10.4"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-4.md",
