// Verify recorded cleanup evidence only. No browser/application execution.
import assert from'node:assert/strict';import fs from'node:fs';import path from'node:path';import{createHash}from'node:crypto';
const work=import.meta.dirname,folder=path.join(work,'cloud-verification-backups/run-38826470332/artifact-12015233580'),hash=b=>createHash('sha256').update(b).digest('hex');
const verification=JSON.parse(fs.readFileSync(path.join(folder,'local-browser-backup-verification.json')));assert.equal(verification.artifactSHA256,'7cf2c9b40e6385b2622a313d28f3bdf5b3399abe3b528271e23316a8d5f1dbfa');assert.equal(verification.allCRCAndBytesReadable,true);assert.equal(verification.passedRecordedBrowserGatesConsistent,true);
const evidence=path.join(folder,'readable-evidence'),files=new Map(verification.files.map(row=>[row.path,row]));function read(name){assert(files.has(name)&&!name.includes('..')&&!name.includes('\\'));const raw=fs.readFileSync(path.join(evidence,name)),row=files.get(name);assert.equal(raw.length,row.bytes);assert.equal(hash(raw),row.sha256);return JSON.parse(raw);}
const attempt=read('browser-attempt.json');assert.equal(attempt.status,'passed');assert.equal(attempt.summary.tests,12);
const names=[...files.keys()].filter(name=>/^case-.*\.json$/.test(name));assert.equal(names.length,12);const rows=[];
for(const name of names){const value=read(name),t=value.teardown;assert(t);assert.equal(value.serverCloseObserved,true);assert.equal(t.stage,'completed');for(const key of ['drained','contextClosed','serverClosed','heldRoutesFinished','screenshotSaved'])assert.equal(t[key],true);assert.equal(t.pendingOwnedRequests,0);assert.equal(t.requestCounts.failed,0);assert.equal(t.requestCounts.started,t.requestCounts.finished);assert.deepEqual(t.steps.map(row=>row.stage),['release-held-routes','screenshot','drain-owned-page-requests','close-owned-context','close-owned-server']);assert(t.steps.every(row=>row.status==='passed'));assert.deepEqual(value.errors,[]);rows.push({path:name,title:value.title,drained:t.drained,contextClosed:t.contextClosed,serverClosed:t.serverClosed,requestCounts:t.requestCounts,steps:t.steps});}
const workers=[...files.keys()].filter(name=>/^browser-observation-process-\d+\.json$/.test(name));assert.equal(workers.length,1);const worker=read(workers[0]);assert.equal(worker.schema,'rea-cloud-flow-vault-browser-worker-observation/v1');assert.deepEqual(worker.execution,attempt.execution);assert.deepEqual(worker.observation,read('browser-observation.json'));
const result={schema:'rea-local-flow-vault-cleanup-records-backup-verification/v1',runId:'38826470332',sourceCommit:attempt.sourceCommit,summary:attempt.summary,allTwelveCasesDrainedAndClosed:true,ownedContextClosureObservedForAllCases:true,allTwelveUnexpectedErrorsEmpty:true,sameAttemptWorkerRecords:1,cases:rows,interpretation:'The corrected fixture completed all12 scenarios with its recorded owned-resource teardown. This fresh pass does not prove the exact cause of the earlier server-close timeout or establish a broad reliability improvement.',localProductExecutions:0,localBrowserExecutions:0,localTests:0,localBuilds:0};
const output=path.join(folder,'local-owned-cleanup-verification.json');fs.writeFileSync(output,JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({path:output,bytes:fs.statSync(output).size,sha256:hash(fs.readFileSync(output)),allTwelveCasesDrainedAndClosed:true,localProductExecutions:0}));
