// Prepared owned fixture only. The normal Studio server, shell and Flow modules
// are copied unchanged; no routing, event, handler or browser transport adapter.
import fs from 'node:fs/promises';import path from'node:path';import os from'node:os';import assert from'node:assert/strict';import{createHash,randomBytes,timingSafeEqual}from'node:crypto';import{createServer}from'node:http';import{pathToFileURL}from'node:url';
if(!process.argv.includes('--run'))throw new Error('Prepared only. Root must explicitly launch this owned fixture with --run.');
const own=import.meta.dirname,workspace=path.resolve(own,'../..'),candidate=path.join(workspace,'work/flow-native-textarea-normalization-fix-next'),expected='70c19b06ecca7b79a9461cb53680429cee2bdc91e022c5015fdf19b258f69ce9',sha=b=>createHash('sha256').update(b).digest('hex'),sources=JSON.parse(await fs.readFile(path.join(own,'source-before.json'),'utf8')),seed=JSON.parse(await fs.readFile(path.join(own,'seed.json'),'utf8'));
async function verifyCandidate(){const bytes=await fs.readFile(path.join(candidate,'manifest.json'));assert.equal(sha(bytes),expected);const manifest=JSON.parse(bytes);assert.equal(manifest.files,197);assert.equal(manifest.inventory.length,197);for(const row of manifest.inventory){const b=await fs.readFile(path.join(candidate,row.path));assert.equal(b.length,row.bytes,row.path);assert.equal(sha(b),row.sha256,row.path);}return {manifestSHA256:sha(bytes),records:manifest.inventory.length};}
async function verifySources(){assert.equal(sources.length,13);for(const row of sources){const primary=await fs.readFile(path.join(workspace,row.source)),copy=await fs.readFile(path.join(own,row.materialized));assert.equal(primary.length,row.bytes,row.source);assert.equal(sha(primary),row.sha256,row.source);assert(primary.equals(copy));}return sources;}
const before=await verifyCandidate();await verifySources();const runtime=await fs.readFile(process.execPath);assert.equal(sha(runtime),'b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3');
const dataDir=await fs.mkdtemp(path.join(os.tmpdir(),'rea-root-flow-link-browser-')),startedAt=new Date().toISOString(),wire=[];let host,control,controlPort,deadline,closing=false,phase='seed',savedId=null;
async function api(action,input={}){const response=await fetch(host.url+'/api/flow/'+action,{method:'POST',headers:{'Content-Type':'application/json','X-Rea-Token':host.token},body:JSON.stringify(input),signal:AbortSignal.timeout(10000)});const value=await response.json();assert.equal(response.status,200,action+' '+JSON.stringify(value));return value.result;}
async function inventory(directory,prefix=''){const rows=[];for(const e of(await fs.readdir(directory,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const relative=prefix?prefix+'/'+e.name:e.name;if(relative==='.local')continue;if(e.isDirectory())rows.push(...await inventory(path.join(directory,e.name),relative));else if(relative!=='manifest.json'){const b=await fs.readFile(path.join(directory,e.name));rows.push({path:relative,bytes:b.length,sha256:sha(b)});}}return rows;}
async function close(reason){if(closing)return;closing=true;clearTimeout(deadline);phase='final-read';let finalState=null,finalReadError=null,cleanupError=null,sourceError=null,durable=null;try{if(host&&savedId){const exported=await api('native-export',{id:savedId}),inspected=await api('native-inspect',{id:savedId}),validated=await api('native-validate',{text:exported.text}),document=JSON.parse(exported.text),nodes=Array.isArray(document)?document:document.flows,out=nodes.find(n=>n.id==='out'),target=nodes.find(n=>n.id==='in'),last=inspected.runs.at(-1);assert.deepEqual(document.vendor,seed.document.vendor);assert.equal(document.rev,seed.document.rev);assert.deepEqual(out.opaque,seed.document.flows.find(n=>n.id==='out').opaque);assert.deepEqual(out.wires,[['physical-debug']]);finalState={savedId,exportedText:exported.text,exportRevision:exported.revision,deployedRevision:inspected.flow.deployedRevision,metadataPreserved:true,physicalWiresRetained:true,outLinks:out.links??null,inLinks:target.links??null,compiledConnections:validated.linkConnections,stateStored:inspected.stateStored,state:inspected.state,runs:inspected.runs,observed:{completedRun:last?.status==='completed',virtualDebugOnly:last?.status==='completed'&&last.debug.length>0&&last.debug.every(x=>x.node==='virtual-debug'),physicalDebugAbsent:last?.debug?.every(x=>x.node!=='physical-debug')??null,linkEventMatches:last?.debug?.every(x=>x.message._event==='node:out')??null,draftMatchesDeployment:exported.revision===inspected.flow.deployedRevision}};}}catch(error){finalReadError={message:error.message,stack:error.stack};}
 try{if(host)await host.close();if(control)await new Promise((resolve,reject)=>control.close(error=>error?reject(error):resolve()));if(savedId&&finalState){const {createStore}=await import(pathToFileURL(path.join(own,'host/lib/storage.mjs')).href),{inspectNativeState}=await import(pathToFileURL(path.join(own,'host/apps/flow/native.mjs')).href),store=await createStore(path.join(dataDir,'flow/records')),definition=await store.get('flow.native.definition.'+savedId,null),history=await store.get('flow.native.history.'+savedId,[]),packed=await store.get('flow.native.state.'+savedId,null);assert.equal(definition.text,finalState.exportedText);assert.deepEqual(history,finalState.runs);assert.deepEqual(inspectNativeState(packed),finalState.state);durable={reopenedDiskStore:true,exportedTextExact:true,historyExact:true,contextExact:true,additionalHostStarts:0,scope:'Owned direct disk-store read after normal HTTP host close; no browser handler or transport substitution.'};}}catch(error){cleanupError={message:error.message,stack:error.stack};}
 let after=null;try{after=await verifyCandidate();await verifySources();await fs.writeFile(path.join(own,'source-after.json'),JSON.stringify(sources,null,2)+'\n',{flag:'wx'});}catch(error){sourceError={message:error.message,stack:error.stack};}
 let tempRemoved=false,privateControlRemoved=false;try{assert.equal(path.dirname(path.resolve(dataDir)),path.resolve(os.tmpdir()));assert(path.basename(dataDir).startsWith('rea-root-flow-link-browser-'));await fs.rm(dataDir,{recursive:true,force:true});tempRemoved=true;const privateFile=path.join(own,'.local/private-control.json');assert.equal(path.dirname(privateFile),path.join(own,'.local'));await fs.rm(privateFile,{force:true});privateControlRemoved=true;}catch(error){cleanupError??={message:error.message,stack:error.stack};}
 await fs.writeFile(path.join(own,'wire.json'),JSON.stringify({wire,scope:'Normal unchanged shared Studio request finish metadata only: method/path/status/phase/time; query, body, headers and tokens never retained. Seed/final reads are separately labeled from browser requests.'},null,2)+'\n',{flag:'wx'});await fs.writeFile(path.join(own,'validation.json'),JSON.stringify({schema:'rea-root-flow-normal-browser-host/v1',startedAt,endedAt:new Date().toISOString(),reason,before,after,sourceRoster:13,sourceStable:!sourceError,runtime:{version:process.version,sha256:sha(runtime)},savedId,finalState,durable,finalReadError,cleanupError,sourceError,ownedHostClosed:!cleanupError,ownedDataRemoved:tempRemoved,privateControlRemoved,scope:{normalSharedHostExact:true,shellExact:true,candidateFlowExact:true,transportBridge:false,handlerSubstitutions:0,originalExecutions:0,browserAcceptance:'Root must provide separate actual CUA observations; this host receipt does not assert browser workflows completed.',productionWrites:0,user4311Touched:false,fullParity:false,universalSuperiority:false}},null,2)+'\n',{flag:'wx'});const rows=await inventory(own),manifest=Buffer.from(JSON.stringify({schema:'rea-root-flow-browser-host-strict/v1',files:rows.length,excludedPrivate:['.local/private-control.json'],inventory:rows},null,2)+'\n');await fs.writeFile(path.join(own,'manifest.json'),manifest,{flag:'wx'});console.log(JSON.stringify({closed:true,files:rows.length,manifestSHA256:sha(manifest),finalReadError:!!finalReadError,cleanupError:!!cleanupError,sourceError:!!sourceError}));if(finalReadError||cleanupError||sourceError)process.exitCode=1;}
try{const {start}=await import(pathToFileURL(path.join(own,'host/server.mjs')).href);host=await start({port:0,dataDir});host.server.on('request',(req,res)=>{const requestPhase=phase,method=req.method,pathname=new URL(req.url,host.url).pathname;res.once('finish',()=>wire.push({at:new Date().toISOString(),phase:requestPhase,method,path:pathname,status:res.statusCode}));});deadline=setTimeout(()=>void close('Owned fifteen-minute host deadline').catch(error=>{console.error(error);process.exitCode=1;}),15*60*1000);const saved=await api('native-save',{name:seed.name,text:seed.text});savedId=saved.flow.id;const validated=await api('native-validate',{text:seed.text});assert.equal(validated.runReady,true);assert.deepEqual(validated.linkConnections,[{source:'out',target:'in'}]);assert.equal((await api('native-export',{id:savedId})).text,seed.text);await fs.writeFile(path.join(own,'seed-result.json'),JSON.stringify({savedId,name:seed.name,revision:saved.flow.revision,compiledConnections:validated.linkConnections,nodeCount:validated.nodeCount,seedHTTPCalls:3,deployed:false},null,2)+'\n',{flag:'wx'});
 const controlToken=randomBytes(32).toString('hex');control=createServer((req,res)=>{const supplied=Buffer.from(String(req.headers['x-owned-control']??'')),wanted=Buffer.from(controlToken);if(req.headers.host!==`127.0.0.1:${controlPort}`||req.socket.remoteAddress!=='127.0.0.1'||supplied.length!==wanted.length||!timingSafeEqual(supplied,wanted)||req.method!=='POST'||req.url!=='/close'){res.writeHead(403);res.end();return;}res.writeHead(200,{'Content-Type':'application/json'});res.end('{"closing":true}');void close('Explicit owned browser review shutdown').catch(error=>{console.error(error);process.exitCode=1;});});await new Promise((resolve,reject)=>{control.once('error',reject);control.listen(0,'127.0.0.1',resolve);});controlPort=control.address().port;await fs.mkdir(path.join(own,'.local'),{recursive:true});await fs.writeFile(path.join(own,'.local/private-control.json'),JSON.stringify({url:`http://127.0.0.1:${controlPort}/close`,token:controlToken,hostURL:host.url,pid:process.pid,dataDir})+'\n',{flag:'wx'});phase='browser';for(const signal of['SIGINT','SIGTERM'])process.on(signal,()=>void close('Owned '+signal+' shutdown').catch(error=>{console.error(error);process.exitCode=1;}));console.log(JSON.stringify({url:host.url+'/#flow',ownedPID:process.pid,normalSharedHostExact:true,sourceRoster:13,seedName:seed.name,privateControlMetadata:true}));}catch(error){await fs.writeFile(path.join(own,'startup-error.json'),JSON.stringify({message:error.message,stack:error.stack},null,2)+'\n',{flag:'wx'});await close('Owned startup failure');process.exitCode=1;}
