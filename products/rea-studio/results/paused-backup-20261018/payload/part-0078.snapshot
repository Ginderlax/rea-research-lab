    {
      "id": "grafana.candidate.1178d06b3754a54e2c29",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In the screen capture, you can see how the notification template groups the alert instances into two sections: **firing alerts** and **resolved alerts**. Each section includes only the key details for each alert, ensuring the message remains concise and focused. Additionally, the summary and description annotations we created earlier are included, providing affected instance and CPU usage.",
      "headingPath": [
        "Set up the Grafana stack",
        "Step 2: Template notifications",
        "Receiving notifications"
      ],
      "source": {
        "path": "docs/sources/tutorials/alerting-get-started-pt4/index.md",
        "gitBlobSha": "9f8bbbb902ddfaacbb6d4fc7f0b7f8c161b7d364",
        "sha256": "1fbdb4c76470721474136ce1d34e23afb36bab25b241bf04e5eaeb81091d3737",
        "lineStart": 396,
        "lineEnd": 396,
