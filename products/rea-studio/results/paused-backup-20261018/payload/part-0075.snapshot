    {
      "id": "grafana.candidate.b9137cbe21d46017e4a3",
      "syntaxRole": "list-item",
      "sourceText": "- A trace represents a single request or transaction as it flows through multiple spans and services. A span refers to a specific operation within a service.",
      "headingPath": [
        "Examples of trace-based alerts",
        "Alerting on span metrics",
        "Detect slow span operations"
      ],
      "source": {
        "path": "docs/sources/alerting/examples/trace-based-alerts.md",
