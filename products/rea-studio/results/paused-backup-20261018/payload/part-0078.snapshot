    {
      "id": "grafana.candidate.db4bcf5261f401ae9a32",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you have more than one condition, you can choose if you want the action (include/exclude) to be applied on rows that **Match all** conditions or **Match any** of the conditions you added.",
