    {
      "id": "grafana.candidate.10d090c7a32ed41549b6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To avoid overlapping retries with scheduled evaluations, `max_retry_delay` must be less than the rule’s evaluation interval.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[unified_alerting]`",
        "`max_retry_delay`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
