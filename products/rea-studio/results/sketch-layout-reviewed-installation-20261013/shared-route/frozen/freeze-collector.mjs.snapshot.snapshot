n=rel?rel+'/'+e.name:e.name;if(e.isDirectory())return files(path.join(dir,e.name),n);const b=fs.readFileSync(path.join(dir,e.name));return[{path:n,bytes:b.length,sha256:sha(b)}];}).sort((a,b)=>a.path.localeCompare(b.path));}const records=files(),manifest={schema:'rea-sketch-layout-static-route-freeze/v1',at:new Date().toISOString(),records,files:records.length,bytes:records.reduce((n,r)=>n+r.bytes,0)},b=Buffer.from(JSON.stringify(manifest,null,2)+'\n');fs.writeFileSync(path.join(root,'freeze-manifest.json'),b,{flag:'wx'});console.log(JSON.stringify({records:records.length,manifestSHA256:sha(b),validationSHA256:sha(fs.readFileSync(path.join(root,'validation.json'))),runtime}));
