      "id": "grafana.candidate.ed51df1c0970621d3401",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "InfluxDB supports the use of filters for InfluxQL. They allow you to define multiple key/value filters, which Grafana automatically applies to all your InfluxDB queries. Filters also support expressions.",
      "headingPath": [
        "InfluxDB template variables",
        "Use filters"
      ],
