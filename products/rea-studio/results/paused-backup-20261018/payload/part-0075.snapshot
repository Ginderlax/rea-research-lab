    {
      "id": "grafana.candidate.399395d4a1602721414f",
      "syntaxRole": "procedural-step",
      "sourceText": "1. An alert transitions to the `Pending` or `Alerting` state when it crosses the alert threshold.",
      "headingPath": [
        "Queries and conditions",
        "Advanced options: Expressions",
        "Recovery threshold"
      ],
      "source": {
        "path": "docs/sources/alerting/fundamentals/alert-rules/queries-conditions.md",
