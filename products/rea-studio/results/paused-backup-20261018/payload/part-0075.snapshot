    {
      "id": "grafana.candidate.bff439d75439d92e2bd1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Like the `predict_linear` example, a forecast alert can detect whether a signal is expected to exceed a threshold within a future time window.",
      "headingPath": [
        "Alerting on forecasts",
        "Seasonal forecast with Grafana Cloud Machine Learning",
        "Alert on a future prediction"
      ],
