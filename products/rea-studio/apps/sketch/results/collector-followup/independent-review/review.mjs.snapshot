import fs from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import {spawn} from 'node:child_process';
import assert from 'node:assert/strict';

const review=fileURLToPath(new URL('./',import.meta.url));
const workspace=path.resolve(review,'../..'),repo=path.join(workspace,'outputs/rea-research-lab');
const product=path.join(repo,'products/rea-studio'),followup='products/rea-studio/apps/sketch/results/collector-followup';
const digest=bytes=>createHash('sha256').update(bytes).digest('hex');
const pins={
 [`${followup}/integration-validation.json`]:'9f2af4ee3ffa9fc3ddd5fd5b2467e2e222725f02e39e0b165427e235f954191d',
 [`${followup}/preservation-manifest.json`]:'b5346f5d96e41a707823bef3be721f0d8427576f39bdd52d480d980988661bb9',
 [`${followup}/production-adapter/preservation-manifest.json`]:'8117c71aa9e7c6650092f6fff85a72ca3a6c0d5817aec4b65bc222a934f9ee62',
 'products/rea-studio/apps/sketch/results/geometry-validation.json':'728f28d2aa5d7ebf1155db9a553f60d67029df46ddb512c15135ddf431333a91',
 [`${followup}/stage/baseline/scripts/verify-sketch-geometry.mjs.snapshot`]:'cf044f4be673201b19247cb9bc9d31c86d713aef70d51fdb6c3508332a49621d',
};
const read=relative=>fs.readFile(path.join(repo,relative));
const stamp=async relative=>{const bytes=await read(relative);return{path:relative,bytes:bytes.length,sha256:digest(bytes)};};
const explicitNames=['core.mjs','client.mjs','server.mjs','fixtures.mjs','app.test.mjs','client.test.mjs','vendor-oracle.mjs','vendor-oracle.test.mjs','geometry-oracle.mjs','geometry.test.mjs','geometry-client.test.mjs','README.md','THIRD-PARTY-NOTICE.md'];
const identityPaths=new Set(Object.keys(pins));
const start=new Date().toISOString();
await fs.mkdir(path.join(review,'sources'),{recursive:true});
await fs.mkdir(path.join(review,'results'),{recursive:true});
for(const [relative,expected] of Object.entries(pins))assert.equal(digest(await read(relative)),expected,relative);
const integration=JSON.parse(await read(`${followup}/integration-validation.json`));
for(const item of integration.sourceFingerprints){assert.deepEqual(await stamp(item.path),{path:item.path,bytes:item.bytes,sha256:item.sha256});identityPaths.add(item.path);const target=path.join(review,'sources',item.path);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,await read(item.path),{flag:'wx'});}
for(const item of integration.artifacts){assert.deepEqual(await stamp(item.path),item);identityPaths.add(item.path);}
const manifests=[`${followup}/preservation-manifest.json`,`${followup}/production-adapter/preservation-manifest.json`];
const history=[];
for(const manifestPath of manifests){const manifest=JSON.parse(await read(manifestPath));for(const item of manifest.snapshots){const relative=path.posix.join(path.posix.dirname(manifestPath),item.path);assert.deepEqual(await stamp(relative),{path:relative,bytes:item.bytes,sha256:item.sha256});identityPaths.add(relative);}history.push({manifest:manifestPath,sha256:digest(await read(manifestPath)),verifiedSnapshots:manifest.snapshots.length});}
assert.deepEqual(history.map(item=>item.verifiedSnapshots),[54,27]);
for(const name of explicitNames)identityPaths.add(`products/rea-studio/apps/sketch/${name}`);
for(const name of ['geometry-original-observations.json','geometry-tests.stdout.txt','geometry-tests.stderr.txt','geometry-source-study/manifest.json'])identityPaths.add(`products/rea-studio/apps/sketch/results/${name}`);
identityPaths.add('products/rea-studio/lib/storage.mjs');
const before=await Promise.all([...identityPaths].sort().map(stamp));
await fs.writeFile(path.join(review,'source-before.json'),JSON.stringify(before,null,2)+'\n',{flag:'wx'});
await fs.writeFile(path.join(review,'sources/integration-validation.json.snapshot'),await read(`${followup}/integration-validation.json`),{flag:'wx'});
for(const [index,name] of manifests.entries())await fs.writeFile(path.join(review,`sources/preservation-${index+1}.json.snapshot`),await read(name),{flag:'wx'});
await fs.writeFile(path.join(review,'sources/historical-collector.mjs.snapshot'),await read(`${followup}/stage/baseline/scripts/verify-sketch-geometry.mjs.snapshot`),{flag:'wx'});
await fs.writeFile(path.join(review,'sources/historical-geometry-validation.json.snapshot'),await read('products/rea-studio/apps/sketch/results/geometry-validation.json'),{flag:'wx'});
const scratchParent=path.resolve(os.tmpdir()),observationDirectory=await fs.mkdtemp(path.join(scratchParent,'rea-sketch-collector-independent-'));
const args=['--test','--test-concurrency=1','--test-reporter=tap',path.join(product,'tests/sketch-collector.test.mjs')];
const env={...process.env,REA_SKETCH_COLLECTOR_REGRESSION_DIR:observationDirectory};delete env.NODE_TEST_CONTEXT;
const runStartedAt=new Date().toISOString();
const run=await new Promise(resolve=>{
 const child=spawn(process.execPath,args,{cwd:repo,env,shell:false,windowsHide:true,stdio:['ignore','pipe','pipe']});
 const stdout=[],stderr=[];let out=0,err=0,failure=null,settled=false;
 const stop=reason=>{failure??=reason;child.kill('SIGKILL');};
 for(const [stream,rows,key] of [[child.stdout,stdout,'stdout'],[child.stderr,stderr,'stderr']])stream.on('data',bytes=>{const count=key==='stdout'?out:err,take=Math.max(0,Math.min(bytes.length,1024*1024-count));if(take)rows.push(Buffer.from(bytes.subarray(0,take)));if(key==='stdout')out+=take;else err+=take;if(bytes.length>take)stop(key+' reviewer output limit');});
 child.on('error',error=>{failure??=error.message;});
 child.on('close',(exitCode,signal)=>{if(settled)return;settled=true;clearTimeout(timer);resolve({pid:child.pid??null,exitCode,signal,failure,stdout:Buffer.concat(stdout),stderr:Buffer.concat(stderr),stdoutBytes:out,stderrBytes:err});});
 const timer=setTimeout(()=>stop('reviewer 60-second execution deadline'),60000);
});
const runCompletedAt=new Date().toISOString();
await fs.writeFile(path.join(review,'results/tests.stdout.txt'),run.stdout,{flag:'wx'});
await fs.writeFile(path.join(review,'results/tests.stderr.txt'),run.stderr,{flag:'wx'});
let observations=null,observationError=null;
try{const bytes=await fs.readFile(path.join(observationDirectory,'observations.json'));await fs.writeFile(path.join(review,'results/observations.json'),bytes,{flag:'wx'});observations=JSON.parse(bytes);}catch(error){observationError=error.message;}
assert.equal(path.dirname(path.resolve(observationDirectory)),scratchParent);assert.ok(path.basename(observationDirectory).startsWith('rea-sketch-collector-independent-'));
await fs.rm(observationDirectory,{recursive:true,force:true});
const after=await Promise.all([...identityPaths].sort().map(stamp));
await fs.writeFile(path.join(review,'source-after.json'),JSON.stringify(after,null,2)+'\n',{flag:'wx'});
const summary=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(name=>[name,Number(run.stdout.toString('utf8').match(new RegExp(`^# ${name} (\\d+)$`,'m'))?.[1]??-1)]));
const processStates=[];
for(const record of observations?.records??[]){for(const [kind,pid] of [['root',record.pid],['descendant',record.descendantPid]])if(Number.isSafeInteger(pid)&&pid>0){let state='dead',errorCode=null;try{process.kill(pid,0);state='alive-or-pid-reused';}catch(error){errorCode=error.code;if(error.code!=='ESRCH')state='unknown';}processStates.push({record:record.name,kind,pid,state,errorCode});}}
const runtimeBytes=await fs.readFile(process.execPath);
const checks={sourcesStable:JSON.stringify(before)===JSON.stringify(after),exact17:JSON.stringify(summary)===JSON.stringify({tests:17,pass:17,fail:0,cancelled:0,skipped:0,todo:0}),reviewerSuccessful:run.exitCode===0&&run.failure===null,observationsRetained:observations!==null,allRecordedOwnedPidsDead:processStates.every(item=>item.state==='dead'),historySnapshotsVerified:true};
const receipt={schema:'rea-sketch-collector-independent-run/v1',startedAtUtc:start,completedAtUtc:new Date().toISOString(),runStartedAtUtc:runStartedAt,runCompletedAtUtc:runCompletedAt,runtime:{version:process.version,platform:process.platform,exe:process.execPath,exeSHA256:digest(runtimeBytes)},executedTest:args.at(-1),arguments:args,run:{...run,stdout:undefined,stderr:undefined},summary,checks,observationError,history,sourceIdentities:before,recordedChildExecutions:observations?.records.length??null,processStates,ownedObservationDirectory:observationDirectory,ownedObservationDirectoryRemoved:true,geometry28Executed:false,originalExcalidrawHelperExecuted:false,collectorScriptExecuted:false,productionWrites:false,reviewerSourceSHA256:digest(await fs.readFile(fileURLToPath(import.meta.url))),scope:'Exactly the current production17 synthetic collector checks. Collector bootstrap/publication code reviewed statically, never executed. PID observations are point-in-time owned-PID liveness checks, not atomic Windows Job Object guarantees.'};
await fs.writeFile(path.join(review,'results/run-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
assert.ok(Object.values(checks).every(Boolean),JSON.stringify(checks));
console.log(JSON.stringify({summary,checks,sourceIdentities:before.length,history,recordedChildExecutions:observations.records.length,receiptSHA256:digest(await fs.readFile(path.join(review,'results/run-validation.json')))}));
