import test from 'node:test';import assert from 'node:assert/strict';import {fixture,deferred,button,field,openEntry,beginRestore} from './ui-fixture.mjs';
const labels=['Title','Group','Username','Password','URL','Notes','TOTP Base32 secret'];
test('each supported editable value changed before Restore refuses the effect without relying on input events',async t=>{
 for(const label of labels){const f=await fixture(t,'dirty-field-'+label.toLowerCase().replaceAll(' ','-')),restore=await beginRestore(f.root),before=structuredClone(f.store.value),value=label==='TOTP Base32 secret'?'JBSWY3DPEHPK3PXP':'Owned unsaved '+label;field(f.root,label).value=value;const requests=f.requests.length;await restore.start();assert.equal(field(f.root,label).value,value);assert.equal(f.requests.slice(requests).some(r=>r.action==='historyRestore'),false);assert.deepEqual(f.store.value,before);f.observation.dirtyField={label,retained:true,restoreRequests:0,encryptedBytesUnchanged:true};}
});
test('a draft typed while the post-Restore read is held retains editor fields and saves to the same entry',async t=>{
 const entered=deferred(),release=deferred();let afterRestore=false;const f=await fixture(t,'draft-during-restored-read',async(action,input,real)=>{const result=await real();if(action==='historyRestore')afterRestore=true;else if(action==='read'&&afterRestore){afterRestore=false;entered.resolve();await release.promise;}return result;}),restore=await beginRestore(f.root),pending=restore.start();await entered.promise;field(f.root,'Notes').value='Draft during restored read';release.resolve();await pending;assert.equal(field(f.root,'Notes').value,'Draft during restored read');assert.equal(field(f.root,'Password').value,'A second');assert.equal((await f.call('read',{id:f.A})).entry.password,'A original');await button(f.root,'Save encrypted entry').click();assert.equal((await f.call('read',{id:f.A})).entry.notes,'Draft during restored read');assert.equal((await f.call('read',{id:f.B})).entry.notes,'B content');f.observation.retainedDraftSavedToOriginalEntry=true;
});
test('new-entry Save response retains the subsequent draft and its committed identity for the next Save',async t=>{
 const entered=deferred(),release=deferred();let savedId,hold=true;const f=await fixture(t,'new-save-followup-draft',async(action,input,real)=>{const result=await real();if(action==='save'&&hold){hold=false;savedId=result.id;entered.resolve();await release.promise;}return result;});await button(f.root,'New entry').click();field(f.root,'Title').value='New pending';field(f.root,'Notes').value='Submitted new note';const pending=button(f.root,'Save encrypted entry').click();await entered.promise;field(f.root,'Notes').value='Newer unsaved note';release.resolve();await pending;assert.equal(field(f.root,'Title').value,'New pending');assert.equal(field(f.root,'Notes').value,'Newer unsaved note');assert.equal((await f.call('read',{id:savedId})).entry.notes,'Submitted new note');await button(f.root,'Save encrypted entry').click();assert.equal((await f.call('read',{id:savedId})).entry.notes,'Newer unsaved note');assert.equal((await f.call('list')).entries.length,3);f.observation.createdIdentity=savedId;f.observation.secondSaveUpdatesFirstCreatedEntry=true;
});
test('typing and reverting values while Restore is held still preserves the active editor through the input revision',async t=>{
 const entered=deferred(),release=deferred(),f=await fixture(t,'input-revision-same-signature',async(action,input,real)=>{const result=await real();if(action==='historyRestore'){entered.resolve();await release.promise;}return result;}),restore=await beginRestore(f.root),notes=field(f.root,'Notes'),original=notes.value,pending=restore.start();await entered.promise;notes.value='Temporary user edit';notes.listeners.get('input')();notes.value=original;notes.listeners.get('input')();release.resolve();await pending;assert.equal(field(f.root,'Notes'),notes);assert.equal(field(f.root,'Notes').value,original);assert.equal(field(f.root,'Password').value,'A second');assert.equal((await f.call('read',{id:f.A})).entry.password,'A original');f.observation.inputRevisionsPreventSameSignaturePublication=true;
});
test('a delayed Delete response retains newly typed values as a new draft with no deleted identity',async t=>{
 const entered=deferred(),release=deferred(),f=await fixture(t,'delete-followup-draft',async(action,input,real)=>{const result=await real();if(action==='delete'){entered.resolve();await release.promise;}return result;});await openEntry(f.root,'Entry A');field(f.root,'Confirm entry deletion').checked=true;const pending=button(f.root,'Delete entry').click();await entered.promise;field(f.root,'Title').value='Recovered typed draft';field(f.root,'Notes').value='Typed while Delete response pending';release.resolve();await pending;assert.equal(field(f.root,'Title').value,'Recovered typed draft');assert.equal(field(f.root,'Notes').value,'Typed while Delete response pending');await button(f.root,'Save encrypted entry').click();const saved=f.requests.filter(r=>r.action==='save').at(-1);assert.equal(saved.id,undefined);const rows=(await f.call('list')).entries;assert.equal(rows.some(r=>r.id===f.A),false);assert.equal(rows.some(r=>r.id===f.B),true);assert.equal(rows.filter(r=>r.title==='Recovered typed draft').length,1);f.observation.retainedDraftHasNoDeletedIdentity=true;
});
test('a delayed generated-password response cannot overwrite a newer explicitly typed password',async t=>{
 const entered=deferred(),release=deferred(),f=await fixture(t,'generated-password-newer-draft',async(action,input,real)=>{const result=await real();if(action==='generate'){entered.resolve();await release.promise;}return result;});await openEntry(f.root,'Entry A');const pending=button(f.root,'Use generated password').click();await entered.promise;field(f.root,'Password').value='User typed newer secret';release.resolve();await pending;assert.equal(field(f.root,'Password').value,'User typed newer secret');assert.equal(field(f.root,'Generated password').value,'');f.observation.typedPasswordRetained=true;
});
