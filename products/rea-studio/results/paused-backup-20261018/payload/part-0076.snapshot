    },
    {
      "id": "grafana.candidate.95787cc48678c3909c42",
      "syntaxRole": "table-row",
      "sourceText": "| **Rollup indicator**      | Toggle on to display an info icon in panel headers when data aggregation (rollup) occurs. Only available when `Metrictank` is selected.                                                                                                     |",
      "headingPath": [
        "Configure the Graphite data source",
        "Configuration options in the UI"
      ],
      "source": {
