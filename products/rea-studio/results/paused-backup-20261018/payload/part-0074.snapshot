    {
      "id": "grafana.candidate.88fff96c52920e311cf1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Organization administrators can invite users to join their organization. Organization users have access to organization resources based on their role, which is **Admin**, **Editor**, or **Viewer**. Permissions associated with each role determine the tasks a user can perform in the system.",
      "headingPath": [
        "Manage users in an organization"
      ],
      "source": {
        "path": "docs/sources/administration/user-management/manage-org-users/index.md",
        "gitBlobSha": "7805dc56d0f0019f5c25c49944d3a9d99bbe19a9",
        "sha256": "3e59e606187bc851d04c0042d569157c588615a6117b2e8353bb31ede9db9a95",
        "lineStart": 20,
        "lineEnd": 20,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/user-management/manage-org-users/index.md#L20-L20"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.828376ad821565562f2d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Users added at the organization level will have access to all stacks and services by default, without the ability to be filtered by stack unless Single Sign-On (SSO) or Role-Based Access Control (RBAC) is implemented.",
      "headingPath": [
        "Manage users in an organization"
      ],
      "source": {
        "path": "docs/sources/administration/user-management/manage-org-users/index.md",
        "gitBlobSha": "7805dc56d0f0019f5c25c49944d3a9d99bbe19a9",
