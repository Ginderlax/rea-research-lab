assert run['path']=='.github/workflows/development-cloud.yml'and run['head_branch']=='codex/rea-cloud-recovery-20261015'and run['event']in ['pull_request','workflow_dispatch']
jobs=control['jobs'];assert jobs['total_count']==len(jobs['jobs'])==1
job=jobs['jobs'][0];assert str(job['id'])==JOB and str(job['run_id'])==RUN and job['run_attempt']==ATTEMPT and job['status']=='completed'
assert job['runner_group_name']=='GitHub Actions'and'windows-2022'in job['labels']
assert job['name']=='full-oracle-experiment'and job['head_sha']==HEAD
artifacts=control['artifacts'];assert artifacts['total_count']==len(artifacts['artifacts'])==1
artifact=artifacts['artifacts'][0];assert str(artifact['id'])==ARTIFACT and artifact['expired']is False and artifact['name']=='development-oracle-windows-'+RUN+'-'+str(ATTEMPT)
assert str(artifact['workflow_run']['id'])==RUN and artifact['workflow_run']['head_sha']==HEAD
outer=read(source,MAX_ARCHIVE);assert pin(outer)==OUTER_IDENTITY and len(outer)==artifact['size_in_bytes']and artifact['digest']=='sha256:'+pin(outer)['sha256']
folder=source.parent/('artifact-'+ARTIFACT+'-current-698d-full-reader-v1');assert not folder.exists();folder.mkdir()
