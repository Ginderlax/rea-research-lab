import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {syncBuiltinESMExports} from 'node:module';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
import {createWorkspace} from './baseline/lib/storage.mjs';
import {handleNative} from './baseline/apps/backup/restic.mjs';
const root=fileURLToPath(new URL('./',import.meta.url)),manifest=JSON.parse(await fs.readFile(path.join(root,'baseline-manifest.json'),'utf8')),hash=bytes=>createHash('sha256').update(bytes).digest('hex'),actual={mkdir:fs.mkdir,open:fs.open},realNow=Date.now,password='only-own-precommit-deadline-fixtures',cases=[];
async function stable(){for(const item of manifest.sourceFingerprints){assert.equal(hash(await fs.readFile(path.join(manifest.stage,item.path))),item.sha256);assert.equal(hash(await fs.readFile(path.join(root,'baseline',item.path))),item.sha256);}}await stable();
const template=await fs.mkdtemp(path.join(root,'guard-template-')),base=await createWorkspace(path.join(template,'workspace'));await handleNative({action:'nativeInit',input:{repository:'repository',password,version:2},workspace:base});
for(const phase of ['mkdir','open','write']){
 const fixture=await fs.mkdtemp(path.join(root,`guard-fixture-${phase}-`)),workspace=await createWorkspace(path.join(fixture,'workspace'));await fs.cp(base.resolve('repository'),workspace.resolve('repository'),{recursive:true});let offset=0,lateOpen=0,lateWrite=0,lateSync=0,closeCalls=0,rejected;
 Date.now=()=>realNow()+offset;
 fs.mkdir=async(filename,...args)=>{const result=await actual.mkdir(filename,...args);if(phase==='mkdir'&&filename===workspace.resolve('repository/tmp'))offset=120001;return result;};
 fs.open=async(filename,...args)=>{const handle=await actual.open(filename,...args);if(typeof filename==='string'&&filename.startsWith(workspace.root+path.sep)&&filename.endsWith('.pending')){if(offset)lateOpen++;if(phase==='open')offset=120001;const write=handle.writeFile.bind(handle),sync=handle.sync.bind(handle),close=handle.close.bind(handle);handle.writeFile=async(...values)=>{if(offset)lateWrite++;const result=await write(...values);if(phase==='write')offset=120001;return result;};handle.sync=async(...values)=>{if(offset)lateSync++;return sync(...values);};handle.close=async(...values)=>{closeCalls++;return close(...values);};}return handle;};syncBuiltinESMExports();
 try{await handleNative({action:'nativeInfo',input:{repository:'repository',password},workspace});}catch(error){rejected=error.message;}finally{Date.now=realNow;Object.assign(fs,actual);syncBuiltinESMExports();}
 const temporary=await fs.readdir(workspace.resolve('repository/tmp')),locks=await fs.readdir(workspace.resolve('repository/locks'));assert.match(rejected,/exceeded two minutes/);assert.equal(temporary.length,0);assert.equal(locks.length,0);assert.equal(lateOpen,0,'Expired mkdir must not start another open.');assert.equal(lateWrite,0,'Expired open must not start another write.');assert.equal(lateSync,0,'Expired write must not start another sync.');assert.equal(closeCalls,phase==='mkdir'?0:1,'Every opened temp handle must close.');
 cases.push({phase,fixture,clockAdvanceMilliseconds:120001,rejected,observedNewOpenAfterExpiry:lateOpen,observedNewWriteAfterExpiry:lateWrite,observedNewSyncAfterExpiry:lateSync,closeCalls,remainingTemporary:temporary,remainingLocks:locks,expectedNoNewIOAfterAwaitedDeadlineExpiry:true,guardGapReproduced:Boolean(lateOpen||lateWrite||lateSync),allSubsequentIOPrevented:true});
}
await stable();const report={schema:'rea-rabin-fixed-precommit-deadline-review/v1',completedAtUtc:new Date().toISOString(),sourceBytesStableAcrossRun:true,sourceFingerprints:manifest.sourceFingerprints,cases,scope:'Three deterministic child-only clock advances after awaited temp mkdir/open/write, using owned synthetic nativeInfo lock writes. Existing pre-link guard prevented commit and cleaned temps; this separately tests starting extra IO after expiry. No stage or production edits.'};const filename=path.join(root,'precommit-deadline-observations.json');await fs.writeFile(filename,JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({cases:cases.map(({phase,observedNewOpenAfterExpiry,observedNewWriteAfterExpiry,observedNewSyncAfterExpiry,guardGapReproduced})=>({phase,observedNewOpenAfterExpiry,observedNewWriteAfterExpiry,observedNewSyncAfterExpiry,guardGapReproduced})),receiptSha256:hash(await fs.readFile(filename))}));
