    },
    {
      "id": "grafana.candidate.62ae19991cf10fbefd53",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you want to track Grafana usage with Google Analytics specify _your_ Universal Analytics ID here. By default this feature is disabled.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[analytics]`",
        "`google_analytics_ua_id`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
