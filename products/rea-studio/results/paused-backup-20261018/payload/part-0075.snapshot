    {
      "id": "grafana.candidate.536a9af8353df9cba4c9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A built-in data source that generates random walk data and can poll the [TestData](testdata/) data source. Additionally, it can list files and get other data from a Grafana installation. This can be helpful for testing visualizations and running experiments.",
