        "lineStart": 65,
        "lineEnd": 65,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/fundamentals/timeseries-dimensions/index.md#L65-L65"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
