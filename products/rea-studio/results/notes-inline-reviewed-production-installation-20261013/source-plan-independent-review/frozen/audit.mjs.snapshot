const req=await pj('requirements-identity-reference.json'),priorBinding=JSON.parse(await at(req.priorBinding.path,req.priorBinding));const registry=[];
for(const r of req.registries){const b=await read(repo,r.path),j=JSON.parse(b),capabilityIDs=r.path.endsWith('system-products.json')?j.products.flatMap(p=>p.capabilities.map(c=>c.id)):r.path.endsWith('workspace-products.json')?j.capabilities.map(c=>c.id):j.baselineProducts.flatMap(p=>p.requirements.map(c=>c.id));const sources=j.sources.map(s=>({id:s.id,sha256:s.sha256}));const prior=priorBinding.registries.find(p=>r.path.endsWith(p.path));assert.deepEqual(sources,r.sources);assert.deepEqual(sources,prior.sources);assert.deepEqual(capabilityIDs,r.capabilityIDs);assert.deepEqual(capabilityIDs,prior.capabilityIDs);registry.push({path:r.path,...ident(b),wholeOldByteHashRequired:false,sourceCount:sources.length,capabilityCount:capabilityIDs.length});}
assert.equal(req.registries.flatMap(r=>r.sources).length,159);assert.equal(new Set(req.registries.flatMap(r=>r.capabilityIDs)).size,232);await save('current-registry-identity-observation.json',{registry,sourceIDSHAPairs:159,capabilityIDs:232,oldWholeFingerprintRebound:false});
