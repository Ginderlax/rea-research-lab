import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,workspace=path.resolve(here,'../..'),sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)}),rows=[];const author=await fs.readFile(path.join(workspace,'work/editor-search-pattern-next/freeze-manifest.json'));assert.equal(sha(author),'7f975ae3f7a0827f5b9ade231bd121c5b4028f17d88758455fd680962ff0f878');const reconstruction=JSON.parse(await fs.readFile(path.join(here,'public-reconstruction-validation.json')));assert.equal(reconstruction.passed,true);assert.equal(reconstruction.reconstructedExcludedFixtures,82);assert.equal(reconstruction.uniqueMaterializedPublicPayloads,223);const migration=JSON.parse(await fs.readFile(path.join(here,'historical-migration-plan.json')));assert.equal(migration.selectedBeforeAfterStable,true);assert.equal(migration.migrations.length,4);const browser=path.join(workspace,'work/editor-search-pattern-browser-next'),prep=await fs.readFile(path.join(browser,'prepared-sources42.json')),controller=await fs.readFile(path.join(browser,'launch.mjs'));await fs.writeFile(path.join(here,'browser-preparation-reference.json'),JSON.stringify({root:'work/editor-search-pattern-browser-next',preparedSources42:id(prep),controller:id(controller),sourceOnlyPrepared:true,appExecutions:0,hostStarts:0,browserCalls:0,actualAcceptancePending:true,nativeDirtyCloseCancelUnverified:true,source573PreservedIfCRLFCorrectionRequired:true},null,2)+'\n',{flag:'wx'});async function walk(folder=''){for(const e of(await fs.readdir(path.join(here,folder),{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const p=folder?folder+'/'+e.name:e.name;assert.equal(e.isSymbolicLink(),false);if(e.isDirectory())await walk(p);else{assert.ok(e.isFile());if(p!=='freeze-manifest.json')rows.push({path:p,...id(await fs.readFile(path.join(here,p)))});}}}await walk();const m={schema:'rea-editor-pattern-source-publication-plan-freeze/v1',frozenAt:new Date().toISOString(),inventory:rows,payloadCount:rows.length,payloadBytes:rows.reduce((n,r)=>n+r.bytes,0),author573Untouched:true,publicRows492:true,publicUniquePayloads223:true,excludedGeneratedFixtures82:true,publicOnlyReconstruction82Exact:true,installationAccepted:false,browserAccepted:false,productionWrites:0};const mb=Buffer.from(JSON.stringify(m,null,2)+'\n');await fs.writeFile(path.join(here,'freeze-manifest.json'),mb,{flag:'wx'});for(const r of rows)assert.deepEqual(id(await fs.readFile(path.join(here,r.path))),{bytes:r.bytes,sha256:r.sha256});console.log(JSON.stringify({payloads:rows.length,bytes:m.payloadBytes,manifest:id(mb),planValidation:id(await fs.readFile(path.join(here,'plan-validation.json'))),reconstruction:id(await fs.readFile(path.join(here,'public-reconstruction-validation.json'))),migration:id(await fs.readFile(path.join(here,'historical-migration-plan.json'))),sourceOnly:true,appCalls:0,browserCalls:0,productionWrites:0}));
