    {
      "id": "grafana.candidate.25552094120081bb7022",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The **Live tailing feature** allows you to monitor the latest logs in real-time, making it easier to track events as they occur and promptly detect issues.",
      "headingPath": [
        "Logs in Explore",
        "Live tailing"
      ],
      "source": {
