    {
      "id": "grafana.candidate.23fa5fe55b9ff43af468",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The query editor displays pre-processing options when the selected metric has a metric type of `DELTA` or `CUMULATIVE`.",
      "headingPath": [
        "Google Cloud Monitoring query editor",
        "Query metrics",
        "Configure pre-processing options"
      ],
      "source": {
        "path": "docs/sources/datasources/google-cloud-monitoring/query-editor/index.md",
