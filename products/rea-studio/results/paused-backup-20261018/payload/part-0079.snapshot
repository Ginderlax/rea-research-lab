    },
    {
      "id": "grafana.candidate.679fb1f74c49b5c271c6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Annotations are now supported in public dashboards, with the exception of query annotations. They are turned off by default, but can be turned on in your public dashboard settings.",
      "headingPath": [
        "What's new in Grafana v9.3",
        "Public dashboards improvements",
        "Choose to display annotations in public dashboards"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-3.md",
        "gitBlobSha": "acf11473ed5777a12056a218dd89128f81813beb",
        "sha256": "64900ffbe97db576e8db0598932deb044076d62fbd415d6bfd717f2d4b707209",
        "lineStart": 86,
        "lineEnd": 86,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v9-3.md#L86-L86"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.369d113dfa4b75c8547f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Note that because Public Dashboards is an experimental feature, you need to enable it in Grafana using the `publicDashboards` [feature toggle](../../setup-grafana/configure-grafana/#feature_toggles), or open a support ticket requesting public dashboards if you are a Cloud Advanced customer.",
      "headingPath": [
        "What's new in Grafana v9.3",
        "Public dashboards improvements",
        "Choose to display annotations in public dashboards"
      ],
      "source": {
