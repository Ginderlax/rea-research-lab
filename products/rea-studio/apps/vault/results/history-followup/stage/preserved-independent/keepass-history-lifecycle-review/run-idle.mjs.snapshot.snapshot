import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import {spawn} from 'node:child_process';
const own=path.dirname(fileURLToPath(import.meta.url)),stage=path.resolve(process.env.VAULT_REVIEW_STAGE??path.join(own,'../keepass-history-selection-fix-next')),sha=b=>createHash('sha256').update(b).digest('hex'),names=['history.mjs','server.mjs','client.mjs','kdbx.mjs','xml.mjs'];async function fingerprint(){return Promise.all(names.map(async name=>({path:name,sha256:sha(await fs.readFile(path.join(stage,name)))})));}
const before=await fingerprint(),out=path.join(own,'runs',process.env.VAULT_REVIEW_RUN??'host-contract');await fs.mkdir(out,{recursive:true});const child=spawn(process.execPath,['--test',path.join(own,'idle-view.test.mjs')],{cwd:own,windowsHide:true,env:{...process.env,VAULT_REVIEW_STAGE:stage,VAULT_REVIEW_OUTPUT:path.join(own,'observations',process.env.VAULT_REVIEW_RUN??'host-contract')},stdio:['ignore','pipe','pipe']});let stdout='',stderr='';child.stdout.on('data',p=>stdout+=p);child.stderr.on('data',p=>stderr+=p);const timer=setTimeout(()=>child.kill(),20000);const exitCode=await new Promise((resolve,reject)=>{child.once('error',reject);child.once('close',resolve);});clearTimeout(timer);await fs.writeFile(path.join(out,'stdout.txt'),stdout);await fs.writeFile(path.join(out,'stderr.txt'),stderr);const after=await fingerprint();const receipt={schema:'rea-independent-vault-detached-idle-review/v1',exitCode,sourceStable:JSON.stringify(before)===JSON.stringify(after),sourceFingerprints:before,counts:Object.fromEntries(['tests','pass','fail','skipped','cancelled'].map(n=>[n,Number(new RegExp(`(?:ℹ|#) ${n} (\\d+)`).exec(stdout)?.[1]??-1)])),scope:'Finite direct logical idle-timer callback; no elapsed-time measurement, native GUI execution or current HTTP loss claim.'};await fs.writeFile(path.join(out,'validation.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify(receipt));if(exitCode||!receipt.sourceStable)process.exitCode=1;
