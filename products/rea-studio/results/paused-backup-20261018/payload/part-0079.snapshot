    {
      "id": "grafana.candidate.3b7fbea85a5e68bfe346",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can use the Text mode option to control what text the panel renders. If the value is not important, only name and color is, then change the `Text mode` to **Name**. The value will still be used to determine color and is displayed in a tooltip.",
      "headingPath": [
        "What's new in Grafana v7.1",
        "Stat panel text mode"
      ],
