    {
      "id": "grafana.candidate.72716b16cd70bd1267b5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The Plugin Frontend Sandbox is a security feature that isolates plugin frontend code from the main Grafana application. When enabled, plugins run in a separate JavaScript context, which provides several security benefits:",
      "headingPath": [
        "Isolate plugin code with the Plugin Frontend Sandbox"
