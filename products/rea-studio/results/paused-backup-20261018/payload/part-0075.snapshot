    {
      "id": "grafana.candidate.e65989b068c8f99fad38",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The new Grafana Alerting was introduced in Grafana 8 and is a superset of legacy alerting. Learn how to migrate your alerts in the [Upgrade Alerting documentation](https://grafana.com/docs/grafana/v10.4/alerting/set-up/migrating-alerts/).",
      "headingPath": [
        "Breaking changes in Grafana v10.0",
        "General breaking changes",
        "Grafana legacy alerting is deprecated and no longer accepts internal or external contributions",
        "Migration path"
      ],
      "source": {
        "path": "docs/sources/breaking-changes/breaking-changes-v10-0.md",
