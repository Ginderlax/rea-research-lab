  "references": [
    {
      "id": "original-standard-clone",
      "file": "preserved/official/dist/cjs/transformations/fieldReducer.cjs",
      "sha256": "36f6f81fc3ccc8708f8f42a306a0123b717d46320aa888df5acd0e0673514443",
      "lineStart": 433,
      "lineEnd": 439,
      "statement": "Released standard helper clones 19 default properties, checks missing data, then calculates the field-type invariant once."
    },
    {
      "id": "original-first-last-null-count",
      "file": "preserved/official/dist/cjs/transformations/fieldReducer.cjs",
      "sha256": "36f6f81fc3ccc8708f8f42a306a0123b717d46320aa888df5acd0e0673514443",
      "lineStart": 440,
      "lineEnd": 456,
      "statement": "First/last are captured before null handling. Ignore mode skips both null and undefined/holes; count includes NaN but ignore mode excludes nullish."
    },
    {
      "id": "original-numeric-loop",
      "file": "preserved/official/dist/cjs/transformations/fieldReducer.cjs",
      "sha256": "36f6f81fc3ccc8708f8f42a306a0123b717d46320aa888df5acd0e0673514443",
      "lineStart": 460,
      "lineEnd": 488,
      "statement": "Invariant numeric branch surrounds sum/delta/step/extrema updates for every accepted sample. Numeric fields do not reject primitive strings/booleans."
    },
    {
      "id": "original-finalize",
      "file": "preserved/official/dist/cjs/transformations/fieldReducer.cjs",
      "sha256": "36f6f81fc3ccc8708f8f42a306a0123b717d46320aa888df5acd0e0673514443",
      "lineStart": 494,
      "lineEnd": 520,
      "statement": "Extreme sentinels, arithmetic order, all19 result keys and diff/diffperc are observable parts of the helper contract."
    },
    {
      "id": "original-cache-clone",
      "file": "preserved/official/dist/cjs/transformations/fieldReducer.cjs",
      "sha256": "36f6f81fc3ccc8708f8f42a306a0123b717d46320aa888df5acd0e0673514443",
      "lineStart": 180,
      "lineEnd": 201,
      "statement": "Returned calculation results are copied into state.calcs; returning the same object would change mutation isolation."
    },
    {
      "id": "current-type-mode-branches",
      "file": "preserved/current-native-calculations.mjs",
      "sha256": "9269cf8c32be9bf2c075b67019e82e41272d9495f0321fefc17b2c5695a91371",
      "lineStart": 46,
      "lineEnd": 86,
      "statement": "Current object updates and original arithmetic are retained; numeric and null-mode invariants remain checked inside the loop."
    },
    {
      "id": "numeric-guard-scalar-replay",
      "file": "preserved/previous-stage/candidate-numeric.mjs",
      "sha256": "ad42a9ef924fc726e42ca3ef74097d881c67a2da45e10d91fcc16b4f68c123d3",
      "lineStart": 46,
      "lineEnd": 88,
      "statement": "Prior trial removes object updates but adds a per-accepted-sample primitive type guard, many scalar locals, generic replay fallback and changed result assembly. It does not isolate invariant branch removal."
    },
    {
      "id": "count-derived-count",
      "file": "preserved/previous-stage/candidate-count.mjs",
      "sha256": "4e0e551585b54eea1290b6aff2b9808aa33d3c22c029fe7fde8dd6638af8c8db",
      "lineStart": 80,
      "lineEnd": 89,
      "statement": "Prior count trial additionally derives count and changes dispatch; its quiet regression cannot identify the independent cost of any one change."
    },
    {
      "id": "node-memory-api",
      "file": "preserved/node-process.md",
      "sha256": "a6bf8bfdbed98570f5c4e0ebd9d0c56b7d0e2905604c278642924d9d7428de4d",
      "lineStart": 2827,
      "lineEnd": 2899,
      "statement": "MemoryUsage separates V8 heap, external/array-buffer and total resident memory; page inspection itself can add overhead."
    },
    {
      "id": "node-rss-api",
      "file": "preserved/node-process.md",
      "sha256": "a6bf8bfdbed98570f5c4e0ebd9d0c56b7d0e2905604c278642924d9d7428de4d",
      "lineStart": 2906,
      "lineEnd": 2940,
      "statement": "RSS includes resident code/native/runtime data, and the RSS-only call is cheaper than complete memoryUsage."
    },
    {
      "id": "node-resource-api",
      "file": "preserved/node-process.md",
      "sha256": "a6bf8bfdbed98570f5c4e0ebd9d0c56b7d0e2905604c278642924d9d7428de4d",
      "lineStart": 3720,
      "lineEnd": 3823,
      "statement": "maxRSS is process resource history, not a resettable workload-only allocation measurement."
    },
    {
      "id": "node-explicit-gc",
      "file": "preserved/node-cli.md",
      "sha256": "892005c2df4a0e066374947a66bae95ba615598d41bb76d83ab342de660061eb",
      "lineStart": 1288,
      "lineEnd": 1307,
      "statement": "Explicit GC extension is available but experimental; identical calls do not create a normal application workload or force OS pages to return."
    },
    {
      "id": "node-heap-profile",
      "file": "preserved/node-inspector.md",
