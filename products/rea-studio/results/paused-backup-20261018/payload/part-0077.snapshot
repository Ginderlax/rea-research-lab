    {
      "id": "grafana.candidate.014fa9ff5b90a23300d7",
      "syntaxRole": "list-item",
      "sourceText": "- The `/saml/acs` endpoint, which is intended to receive the ACS (Assertion Customer Service) callback. Some providers name it SSO URL or Reply URL.",
      "headingPath": [
        "SAML authentication in Grafana",
        "Identity provider (IdP) registration"
