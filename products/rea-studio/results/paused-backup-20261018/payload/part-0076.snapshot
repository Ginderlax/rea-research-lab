    {
      "id": "grafana.candidate.da55019056d06e78fdf6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Be aware of the following behaviors when using template variables with Microsoft SQL Server.",
      "headingPath": [
        "Microsoft SQL Server template variables",
        "Known behaviors and limitations"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/template-variables/index.md",
        "gitBlobSha": "4ea7d6363212f57604e4d29ba05a2d571c833ef6",
