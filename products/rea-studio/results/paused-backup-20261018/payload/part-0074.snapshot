    {
      "id": "grafana.candidate.57c554be7efbf4293ee0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana has an active provisioning system that uses configuration files. You can define data sources and dashboards using files that can be version controlled, making GitOps more natural.",
