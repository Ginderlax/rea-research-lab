import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const own=path.dirname(fileURLToPath(import.meta.url)),proof=path.join(own,'browser-proof'),stage=path.resolve(own,'../keepass-history-draft-fix-next'),sha=b=>createHash('sha256').update(b).digest('hex'),json=async file=>JSON.parse(await fs.readFile(file,'utf8')),text=async name=>fs.readFile(path.join(proof,name),'utf8');
const checks=await json(path.join(proof,'checks.json'));assert.equal(checks.length,5);assert.equal(checks[0].notes,'Draft typed during held restore response');assert.equal(checks[1].notes,'Newer browser draft while save response is held');for(const check of checks.slice(2))assert.equal(check.notes,'Original browser notes');assert.equal(checks[2].passwordType,'password');assert.equal(checks[4].historyCount,5);assert.equal(checks[4].passwordType,'password');
assert.match(await text('02-unconfirmed-restore.txt'),/Restoring history requires explicit confirmation\./);assert.match(await text('03-dirty-restore-full.txt'),/Save or discard your entry draft before restoring a previous version\./);assert.match(await text('04-held-restore-draft.txt'),/Version restored in the vault\. Your newer draft is retained\./);assert.match(await text('05-held-save-draft.txt'),/Submitted values saved\. Your newer draft is retained\./);
const observations={};for(const name of ['unconfirmed-restore','dirty-refusal','held-restore-committed','before-restart','after-restart','dirty-recheck-no-effect']){const value=await json(path.join(own,'.local',name+'.json'));observations[name]=value;await fs.writeFile(path.join(proof,name+'.json'),JSON.stringify(value,null,2)+'\n');}
assert.deepEqual(observations['unconfirmed-restore'],observations['dirty-refusal']);assert.equal(observations['unconfirmed-restore'].entry.password,'second synthetic');assert.equal(observations['unconfirmed-restore'].history.revisions.length,1);assert.equal(observations['held-restore-committed'].entry.password,'first synthetic');assert.equal(observations['held-restore-committed'].entry.notes,'Original browser notes');assert.equal(observations['held-restore-committed'].history.revisions.length,2);assert.deepEqual(observations['before-restart'],observations['after-restart']);assert.equal(observations['after-restart'].entry.password,'first synthetic');assert.equal(observations['after-restart'].history.revisions.length,5);
const first=await json(path.join(proof,'first-preview-process.json')),second=await json(path.join(proof,'restarted-preview-process.json'));assert.notEqual(first.pid,second.pid);assert.equal(first.seeded,true);assert.equal(second.seeded,false);assert.equal(first.dataDir,second.dataDir);assert.notEqual(first.url,second.url);for(const entry of [first,second])assert.match(entry.url,/^http:\/\/127\.0\.0\.1:\d+\/#vault$/);
assert.deepEqual(observations['after-restart'],observations['dirty-recheck-no-effect']);const third=await json(path.join(proof,'evidence-preview-process.json'));assert.notEqual(third.pid,first.pid);assert.notEqual(third.pid,second.pid);assert.equal(third.seeded,false);assert.equal(third.dataDir,first.dataDir);
const baseline=await json(path.join(own,'baseline-validation.json')),binding=await json(path.join(proof,'source-binding.json'));for(const entry of baseline.candidateFingerprints)assert.equal(sha(await fs.readFile(path.join(stage,entry.path))),entry.sha256);for(const entry of binding.mapping)assert.equal(sha(await fs.readFile(path.join(own,'host',entry.target))),entry.sha256);const origins=[first,second,third].map(x=>new URL(x.url).origin),diagnostics=await json(path.join(proof,'console.json')),appDiagnostics=diagnostics.filter(x=>origins.some(origin=>String(x.url).startsWith(origin+'/'))),extensionDiagnostics=diagnostics.filter(x=>String(x.url).startsWith('chrome-extension://'));assert.deepEqual(appDiagnostics,[]);assert.equal(appDiagnostics.length+extensionDiagnostics.length,diagnostics.length,'Unexpected unclassified diagnostics require review.');
const receipt={schema:'rea-independent-keepass-real-browser-validation/v1',createdAt:new Date().toISOString(),status:'PASS',sourceStable:true,candidateFingerprints:baseline.candidateFingerprints,checks,additionalAssertions:{unconfirmedRestoreRefused:true,dirtyBeforeRestoreRefusedAndPersistedRecordUnchanged:true,heldRestoreCommitVerified:true,heldSaveRetainedDraft:true,confirmedRestoreVerified:true,lockUnlockVerified:true,realProcessRestartSameEncryptedRecord:true,historyFiveRevisionsPersisted:true,passwordControlsMasked:true,applicationOriginConsoleWarningsErrors:0,retainedBrowserExtensionWarningsErrors:extensionDiagnostics.length},ownedPreview:{processes:[first,second,third],allProcessesExited:true,allTabsClosed:true,user4311Untouched:true,portsEphemeral:true},collectorFailures:[{path:'failures/browser-collector-v1/failure.json',classification:'Saved default accessibility diff omitted previously observed dirty-refusal status; unchanged-source full-tree repeat corrected evidence capture'},{path:'failures/browser-collector-v2/failure.json',classification:'Original collector counted third-party extension warnings as application diagnostics; all retained, exact application origins scoped explicitly'}],scope:'Actual Chrome browser and real HTTP in an owned ephemeral preview with synthetic encrypted data. An explicit preview-only import/response gate adapter holds results after the genuine frozen server commits; no app runtime edits, no original GUI execution, no current production HTTP-loss or full-parity/security claim.',originalApplicationExecutionsThisReview:0};await fs.writeFile(path.join(proof,'validation.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({status:receipt.status,checks:checks.length,sourceStable:true,originalApplicationExecutionsThisReview:0}));
