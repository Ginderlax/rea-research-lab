"""Post-window static figures only; no reducer execution or performance work."""
from pathlib import Path
import sys, json, hashlib, platform, importlib.metadata
BASE = Path(__file__).resolve().parent
sys.path.insert(0, str(BASE / '.plot-libs'))
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import numpy as np

SOURCE = BASE / 'measurement-review.json'
source_bytes = SOURCE.read_bytes()
data = json.loads(source_bytes)
plt.rcParams.update({'font.family': 'DejaVu Sans', 'font.size': 10, 'svg.fonttype': 'none', 'svg.hashsalt': 'rea-metrics-quiet-20261012'})
colors = {'original': '#52606d', 'baseline': '#1d6eaa', 'candidate': '#bc4b21'}
labels = {'smallStandard': 'Small standard', 'largeStandard': 'Large standard', 'singlePercentile': 'Single p95', 'allPercentiles': 'All 99 percentiles', 'allCalculations': 'All 124 calculations'}
roles = ['original', 'baseline', 'candidate']
outputs = []

def mark(axis, stats, y, color, scale=1):
    center = stats['median'] / scale
    axis.errorbar([center], [y], xerr=[[center-stats['min']/scale], [stats['max']/scale-center]], fmt='o', color=color, capsize=3, markersize=5, linewidth=1.4)

def save(figure, name):
    for suffix in ['svg', 'png']:
        output = BASE / 'results' / (name + '.' + suffix)
        figure.savefig(output, dpi=165, facecolor='white', bbox_inches='tight', metadata={'Description': 'Source-bound 2026-10-12 Metrics component observations; medians and min–max of seven samples.'} if suffix == 'svg' else {'Description': 'Medians and min–max of seven samples; no significance or machine isolation claim.'})
        raw = output.read_bytes()
        outputs.append({'path': str(output.relative_to(BASE)).replace('\\', '/'), 'bytes': len(raw), 'sha256': hashlib.sha256(raw).hexdigest()})
    plt.close(figure)

fig, axes = plt.subplots(1, 2, figsize=(14, 5.1), sharey=True)
for axis, variant in zip(axes, ['standard', 'percentile']):
    trial = data['timing'][variant]
    for index, row in enumerate(trial['summary']):
        for offset, role in zip([-0.18, 0, 0.18], roles):
            mark(axis, row['millisecondsPerCall'][role], index + offset, colors[role])
    axis.set_xscale('log')
    axis.set_yticks(range(5), [labels[row['caseName']] for row in trial['summary']])
    axis.set_ylim(4.55, -0.55)
    axis.grid(axis='x', alpha=0.2, which='both')
    axis.set_xlabel('Milliseconds per call (log scale; lower is faster)')
    axis.set_title(('Standard dispatch' if variant == 'standard' else 'Isolated percentile') + ' trial')
fig.suptitle('Separate source-bound timing trials', fontsize=15, y=1.01)
fig.legend([plt.Line2D([0], [0], marker='o', color=colors[role], linestyle='') for role in roles], ['Released original', 'Frozen baseline', 'Separate candidate'], loc='lower center', ncol=3, bbox_to_anchor=(0.5, -0.05))
fig.text(0.5, -0.10, 'Dots = medians; bars = full min–max of seven fresh processes. All three reducers loaded for timing correctness.\nCoordinated pause 20:26:14–20:38:55 UTC; unrelated Windows activity uncontrolled. No significance or universal-speed claim.', ha='center', fontsize=9)
fig.tight_layout()
save(fig, 'timing-observations')

for variant in ['standard', 'percentile']:
    fig, axes = plt.subplots(1, 3, figsize=(15, 5.4), sharey=True)
    rows = data['memory'][variant]['summary']
    for index, row in enumerate(rows):
        for offset, role in zip([-0.18, 0, 0.18], roles):
            current = row['implementations'][role]
            for axis, stats in zip(axes, [current['checkpoints']['afterSelectedInitialization']['rss'], current['sampledTransientMaximum']['rss'], current['deltas']['retainedMinusReleased']['heapUsed']]):
                mark(axis, stats, index + offset, colors[role], 1024**2)
    for axis, title, xlabel in zip(axes, ['Initialized process RSS', 'Transient sampled RSS maximum', 'Retained − released heap'], ['Inclusive RSS (MiB)', 'Block-tail maximum RSS (MiB)', 'Heap-used difference (MiB)']):
        axis.set_title(title)
        axis.set_xlabel(xlabel)
        axis.set_yticks(range(5), [labels[row['caseName']] for row in rows])
        axis.set_ylim(4.55, -0.55)
        axis.grid(axis='x', alpha=0.2)
    fig.suptitle(('Standard dispatch' if variant == 'standard' else 'Isolated percentile') + ': one reducer per memory process', fontsize=15, y=1.01)
    fig.legend([plt.Line2D([0], [0], marker='o', color=colors[role], linestyle='') for role in roles], ['Released original', 'Frozen baseline', 'Separate candidate'], loc='lower center', ncol=3, bbox_to_anchor=(0.5, -0.05))
    fig.text(0.5, -0.11, 'Dots = medians; bars = full min–max of seven fresh processes. Fixed shared inputs, retention counts and explicit GC.\nRelease includes common serializer/GC pressure; differences are diagnostics, not allocation totals or leak proof. RSS sampling may miss short peaks.\nUnrelated Windows activity uncontrolled. All other snapshots and negative/noisy deltas remain in JSON/CSV.', ha='center', fontsize=9)
    fig.tight_layout()
    save(fig, 'memory-observations-' + variant)

modules = {name: importlib.metadata.version(name) for name in ['matplotlib', 'numpy', 'pillow', 'contourpy', 'cycler', 'fonttools', 'kiwisolver', 'packaging', 'pyparsing', 'python-dateutil', 'six']}
receipt = {'schemaVersion': 1, 'scope': 'Post-window figure rendering only. No reducer execution or measurements.', 'input': {'path': 'measurement-review.json', 'sha256': hashlib.sha256(source_bytes).hexdigest()}, 'source': {'path': 'plot-measurements.py', 'sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest()}, 'runtime': {'python': platform.python_version(), 'executable': sys.executable, 'executableSHA256': hashlib.sha256(Path(sys.executable).read_bytes()).hexdigest(), 'packages': modules, 'matplotlibSourceSHA256': hashlib.sha256(Path(matplotlib.__file__).read_bytes()).hexdigest(), 'isolatedLibrariesPath': str(BASE / '.plot-libs'), 'applicationRuntimeDependenciesChanged': False}, 'outputs': outputs, 'fullProductComplete': False, 'universalSuperiorityEstablished': False}
(BASE / 'results' / 'figures-validation.json').write_text(json.dumps(receipt, indent=2) + '\n', encoding='utf-8')
print(json.dumps({'figures': len(outputs), 'inputSHA256': receipt['input']['sha256'], 'matplotlib': matplotlib.__version__, 'measurementRun': False}))
