    {
      "id": "grafana.candidate.72d26ab8062fd967fcb0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In a prior release, Cloud Monitoring added _preprocessing_ support in their query editor. This capability has been added to the Cloud Monitoring data source in Grafana.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Grafana OSS features",
        "Data source updates",
        "Google Cloud Monitoring data source"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-0.md",
        "gitBlobSha": "08364874bf79c35cb3f0d907a16891c4cfb0eb1c",
        "sha256": "6f07cb510f8b0da003b838c600c8c34236d365c4cc7688913f7fe726f50a0fd7",
        "lineStart": 232,
        "lineEnd": 232,
