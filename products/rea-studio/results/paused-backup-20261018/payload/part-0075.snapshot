    {
      "id": "grafana.candidate.24f63a9d55425e9c6990",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A connection is the authentication setup between Grafana and an external Git provider, required when you're not using a Personal Access Token or a static token to authenticate. Use it to authorize access to your external repositories, and to generate or refresh the credentials for Git Sync. A single connection can be reused across multiple repositories.",
      "headingPath": [
        "Git Sync key concepts",
        "Key Git Sync components",
        "Git Sync connection resource"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/git-sync/key-concepts.md",
