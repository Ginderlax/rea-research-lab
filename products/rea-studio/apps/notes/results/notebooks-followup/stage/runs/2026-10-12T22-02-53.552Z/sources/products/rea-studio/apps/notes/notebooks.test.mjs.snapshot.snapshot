import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import {handle} from './server.mjs';
import {readJex} from './jex.mjs';
import {canNest,notebookAncestors,folderRecord,ensureOrganization} from './notebooks.mjs';
import {createStore,createWorkspace} from '../../lib/storage.mjs';
import {originalOrganization} from './notebook-original-oracle.mjs';
const fixture=await fs.readFile(new URL('./fixtures/pinned-joplin.jex',import.meta.url)),id=digit=>digit.repeat(32),observations=[];
async function setup(t){const root=await fs.mkdtemp(path.join(os.tmpdir(),'rea-notebook-stage-'));t.after(async()=>{assert.equal(path.dirname(root),path.resolve(os.tmpdir()));assert.ok(path.basename(root).startsWith('rea-notebook-stage-'));await fs.rm(root,{recursive:true,force:true});});const store=await createStore(path.join(root,'store')),workspace=await createWorkspace(path.join(root,'workspace'));return{root,store,workspace,call:(action,input={})=>handle({action,input,store,workspace})};}
async function exported(call){return readJex(Buffer.from((await call('jex-export',{includeTrash:true})).base64,'base64'));}
test('notebook create rename reparent and note move preserve native IDs metadata relationships bytes and roundtrip',async t=>{const{call}=await setup(t);await call('jex-import',{base64:fixture.toString('base64')});const before=await exported(call),original=await call('get',{id:id('3')});let tree=await call('notebook-list');tree=await call('notebook-create',{revision:tree.revision,title:'Destination 🧪'});const destination=tree.notebook.id;tree=await call('notebook-rename',{revision:tree.revision,id:id('1'),title:'Renamed'});assert.equal((await call('get',{id:id('3')})).notebook,'Renamed / Experiments');const renamed=await exported(call);tree=await call('notebook-move',{revision:tree.revision,id:id('1'),parentId:destination});assert.equal((await call('get',{id:id('3')})).notebook,'Destination 🧪 / Renamed / Experiments');const middle=await exported(call);assert.equal(middle.records.get(id('3')).props.parent_id,id('2'));assert.equal(middle.records.get(id('3')).props.user_updated_time,before.records.get(id('3')).props.user_updated_time);assert.equal(middle.records.get(id('3')).props.updated_time,before.records.get(id('3')).props.updated_time);assert.equal(middle.records.get(id('1')).props.user_updated_time,renamed.records.get(id('1')).props.user_updated_time);
 const note=await call('get',{id:id('3')}),moved=await call('note-move',{id:note.id,revision:note.revision,organizationRevision:tree.revision,notebookId:destination});assert.equal(moved.note.id,original.id);assert.equal(moved.note.notebookId,destination);assert.equal((await call('list',{notebookId:destination})).total,1);assert.deepEqual(moved.note.tags,original.tags);const after=await exported(call);assert.equal(after.records.get(id('3')).props.parent_id,destination);assert.equal(after.records.get(id('3')).props.user_updated_time,before.records.get(id('3')).props.user_updated_time);for(const field of ['author','latitude','longitude','altitude','is_todo','todo_due','application_data','created_time'])assert.equal(after.records.get(id('3')).props[field],before.records.get(id('3')).props[field]);assert.equal(after.records.get(id('1')).props.icon,before.records.get(id('1')).props.icon);assert.deepEqual(after.records.get(id('7')),before.records.get(id('7')));assert.deepEqual(after.resources.get(id('5')).bytes,before.resources.get(id('5')).bytes);const other=await setup(t);await other.call('jex-import',{base64:(await call('jex-export')).base64});assert.equal((await other.call('get',{id:id('3')})).notebookId,destination);assert.equal((await other.call('get',{id:id('4')})).notebook,'Destination 🧪 / Renamed');});
test('identity notebook filters distinguish duplicate sibling titles and separator-containing titles',async t=>{const{call}=await setup(t);let tree=await call('notebook-list');tree=await call('notebook-create',{revision:tree.revision,title:'Same'});const first=tree.notebook.id;tree=await call('notebook-create',{revision:tree.revision,title:'Same'});const second=tree.notebook.id;assert.notEqual(first,second);await call('save',{title:'First',notebookId:first});await call('save',{title:'Second',notebookId:second});assert.deepEqual((await call('list',{notebookId:first})).notes.map(note=>note.title),['First']);tree=await call('notebook-create',{revision:(await call('notebook-list')).revision,title:'a / b'});assert.equal(tree.notebook.depth,1);assert.equal(tree.notebook.path,'a / b');});
test('cycle missing IDs stale revisions multiline titles oversized descendant paths and failed commits do not mutate saved state',async t=>{const{call,store}=await setup(t);await call('jex-import',{base64:fixture.toString('base64')});let tree=await call('notebook-list'),note=await call('get',{id:id('3')}),before=JSON.stringify(await store.get('notes-state-v2'));for(const [action,input,error]of[['notebook-move',{id:id('1'),parentId:id('2')},/descendant/],['notebook-move',{id:id('1'),parentId:id('1')},/itself/],['notebook-move',{id:id('1'),parentId:id('f')},/exist/],['notebook-rename',{id:id('1'),title:'x'.repeat(200)},/200/],['notebook-create',{title:'a\nb'},/single line/],['notebook-create',{title:'a',revision:tree.revision-1},/changed/],['note-move',{id:note.id,revision:note.revision,organizationRevision:tree.revision,notebookId:id('f')},/exist/],['note-move',{id:note.id,revision:note.revision,organizationRevision:tree.revision},/ID/]]){await assert.rejects(call(action,{revision:tree.revision,...input}),error);assert.equal(JSON.stringify(await store.get('notes-state-v2')),before);}const set=store.set;store.set=async()=>{throw new Error('owned failed metadata commit');};await assert.rejects(call('notebook-rename',{id:id('1'),revision:tree.revision,title:'No commit'}),/failed metadata/);store.set=set;assert.equal(JSON.stringify(await store.get('notes-state-v2')),before);tree=await call('notebook-rename',{id:id('1'),revision:tree.revision,title:'Winner'});await assert.rejects(call('save',{...note,body:'stale draft'}),/changed/);assert.equal((await call('get',{id:note.id})).body,note.body);await assert.rejects(call('notebook-move',{revision:tree.revision-1,id:id('2'),parentId:''}),/changed/);});
test('legacy notebook text saves still create flat folders while stable-ID history restoration follows current hierarchy',async t=>{const{call}=await setup(t);let note=await call('save',{title:'Legacy flat',notebook:'Old'});const oldId=note.notebookId;note=await call('save',{...note,notebook:'New',body:'second'});assert.notEqual(note.notebookId,oldId);note=await call('history-restore',{id:note.id,revision:note.revision,historyRevision:1});assert.equal(note.notebookId,oldId);let tree=await call('notebook-list');tree=await call('notebook-rename',{revision:tree.revision,id:oldId,title:'Renamed'});note=await call('get',{id:note.id});const restored=await call('history-restore',{id:note.id,revision:note.revision,historyRevision:1});assert.equal(restored.notebookId,oldId);assert.equal(restored.notebook,'Renamed');});
test('shared or trashed notebook mutations and trashed note moves reject while retained metadata can export',async t=>{const{call,store}=await setup(t);await call('jex-import',{base64:fixture.toString('base64')});for(const field of ['share_id','deleted_time']){const saved=await store.get('notes-state-v2');saved.records[id('1')].props[field]=field==='share_id'?'shared-fixture':'1';await store.set('notes-state-v2',saved);const tree=await call('notebook-list'),before=JSON.stringify(await store.get('notes-state-v2'));assert.equal(tree.notebooks.find(row=>row.id===id('2')).editable,false);await assert.rejects(call('notebook-rename',{id:id('2'),revision:tree.revision,title:'Denied'}),/outside/);await assert.rejects(call('notebook-create',{parentId:id('2'),revision:tree.revision,title:'Denied'}),/outside/);assert.equal(JSON.stringify(await store.get('notes-state-v2')),before);assert.ok((await call('jex-export')).base64);delete saved.records[id('1')].props[field];await store.set('notes-state-v2',saved);}let note=await call('get',{id:id('3')});note=await call('delete',{id:note.id,revision:note.revision});await assert.rejects(call('note-move',{id:note.id,revision:note.revision,organizationRevision:(await call('notebook-list')).revision,notebookId:id('1')}),/Restore/);});
test('notebook graph rejects excessive depth record counts and paths without assuming title separators are depth',()=>{const time='2026-01-01T00:00:00.000Z',records={},s={notes:{},records};let parent='';for(let n=1;n<=65;n++){const key=n.toString(16).padStart(32,'0');records[key]=folderRecord(key,'',time,parent);parent=key;}assert.throws(()=>ensureOrganization(s),/64/);const many={notes:{},records:Object.fromEntries(Array.from({length:2001},(_,n)=>{const key=(n+1).toString(16).padStart(32,'0');return[key,folderRecord(key,'a',time)];}))};assert.throws(()=>ensureOrganization(many),/2,000/);});
test('released original Folder nesting/path/move and Note move helpers match finite regular unshared fixtures',async()=>{const time=Date.parse('2026-10-12T00:00:00.000Z'),folders=[{id:id('1'),title:'root',parent_id:'',share_id:'',user_updated_time:11},{id:id('2'),title:'child',parent_id:id('1'),share_id:'',user_updated_time:12},{id:id('3'),title:'grandchild',parent_id:id('2'),share_id:'',user_updated_time:13},{id:id('4'),title:'other',parent_id:'',share_id:'',user_updated_time:14}],notes=[{id:id('5'),parent_id:id('2'),user_updated_time:15,is_conflict:0,deleted_time:0}],oracle=await originalOrganization({folders,notes,time}),records=Object.fromEntries(folders.map(row=>[row.id,{type:2,title:row.title,props:{id:row.id,parent_id:row.parent_id}}]));let comparisons=0;for(const folder of folders)for(const target of ['',...folders.map(row=>row.id)]){assert.equal(canNest(records,folder.id,target),await oracle.Folder.canNestUnder(folder.id,target));comparisons++;}for(const folder of folders){assert.deepEqual(notebookAncestors(records,folder.id).map(row=>row.props.id),Array.from(oracle.Folder.folderPath(folders,folder.id),row=>row.id));comparisons++;}await oracle.Folder.moveToFolder(id('2'),id('4'));assert.equal(oracle.folderRows.get(id('2')).parent_id,id('4'));assert.equal(oracle.folderRows.get(id('2')).user_updated_time,12);assert.equal(oracle.calls[0].options.autoTimestamp,false);await oracle.Note.moveToFolder(id('5'),id('4'));assert.equal(oracle.noteRows.get(id('5')).parent_id,id('4'));assert.equal(oracle.noteRows.get(id('5')).user_updated_time,15);assert.equal(oracle.noteRows.get(id('5')).updated_time,time);comparisons+=2;observations.push({comparisons,bindings:oracle.bindings,scope:oracle.scope,nestingComparisons:20,pathComparisons:4,originalMoveContractExecutions:2});});
test('actual candidate notebook and note move exports match released original helper effects with user times retained',async t=>{const{call}=await setup(t);await call('jex-import',{base64:fixture.toString('base64')});let tree=await call('notebook-list');tree=await call('notebook-create',{revision:tree.revision,title:'Target'});const target=tree.notebook.id,before=await exported(call),numeric=r=>{const out={...r.props,id:r.props.id,title:r.title,share_id:r.props.share_id??''};for(const key of ['created_time','updated_time','user_created_time','user_updated_time'])if(out[key])out[key]=Date.parse(out[key]);return out;},folders=[...before.records.values()].filter(r=>r.type===2).map(numeric),notes=[...before.records.values()].filter(r=>r.type===1).map(numeric);tree=await call('notebook-move',{id:id('2'),parentId:target,revision:tree.revision});const folder=(await exported(call)).records.get(id('2')),folderOracle=await originalOrganization({folders,notes,time:Date.parse(folder.props.updated_time)});await folderOracle.Folder.moveToFolder(id('2'),target);assert.equal(folder.props.parent_id,folderOracle.folderRows.get(id('2')).parent_id);assert.equal(Date.parse(folder.props.updated_time),folderOracle.folderRows.get(id('2')).updated_time);assert.equal(Date.parse(folder.props.user_updated_time),folderOracle.folderRows.get(id('2')).user_updated_time);let note=await call('get',{id:id('3')});note=await call('save',{...note,body:note.body+'\nUser edit before move'});const edited=(await exported(call)).records.get(id('3')),editedRows=notes.map(row=>row.id===note.id?numeric(edited):row);await call('note-move',{id:note.id,revision:note.revision,organizationRevision:tree.revision,notebookId:target});const moved=(await exported(call)).records.get(id('3')),noteOracle=await originalOrganization({folders,notes:editedRows,time:Date.parse(moved.props.updated_time)});await noteOracle.Note.moveToFolder(id('3'),target);const original=noteOracle.noteRows.get(id('3'));for(const key of ['parent_id','conflict_original_id'])assert.equal(moved.props[key],original[key]);for(const key of ['is_conflict','deleted_time'])assert.equal(Number(moved.props[key]),original[key]);for(const key of ['updated_time','user_updated_time'])assert.equal(Date.parse(moved.props[key]),original[key]);observations.push({candidateOriginalMoveComparisons:2,originalMoveExecutions:2,bindings:noteOracle.bindings,scope:noteOracle.scope,priorUserEditTimestampPreserved:true});});
test.after(()=>console.log(JSON.stringify({notebookOriginalObservations:observations})));
