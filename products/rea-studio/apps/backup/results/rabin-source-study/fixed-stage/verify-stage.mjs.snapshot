import * as fs from 'node:fs/promises';
import {createHash} from 'node:crypto';
import {spawn} from 'node:child_process';
import {fileURLToPath} from 'node:url';
import assert from 'node:assert/strict';
const root=new URL('./',import.meta.url),cwd=fileURLToPath(new URL('../../',import.meta.url)),hash=value=>createHash('sha256').update(value).digest('hex'),top=['rabin.mjs','rabin.test.mjs','restic-crypto.mjs','capture-file.mjs','capture-file.test.mjs','snapshot.test.mjs','capture-benchmark.mjs','original-compare.mjs','source-provenance.json','README.md','verify-stage.mjs','preserve-prototype.mjs','update-provenance.mjs'];
async function walk(prefix){const result=[];for(const item of await fs.readdir(new URL(prefix,root),{withFileTypes:true})){const name=prefix+item.name;if(item.isDirectory())result.push(...await walk(name+'/'));else result.push(name);}return result;}
const names=[...top,...await walk('apps/'),...await walk('lib/'),...await walk('references/')].sort(),capture=async()=>Promise.all(names.map(async path=>{const bytes=await fs.readFile(new URL(path,root));return{path,bytes:bytes.length,sha256:hash(bytes)};})),before=await capture(),provenance=JSON.parse(await fs.readFile(new URL('source-provenance.json',root)));for(const item of provenance.references)assert.equal(hash(await fs.readFile(new URL(item.path,root))),item.sha256);assert.equal(hash(await fs.readFile(new URL(provenance.resticDependencyBinding.path,root))),provenance.resticDependencyBinding.sha256);
async function run(name,args){const child=spawn(process.execPath,args,{cwd,windowsHide:true}),out=[],err=[];child.stdout.on('data',value=>out.push(value));child.stderr.on('data',value=>err.push(value));const exitCode=await new Promise(done=>child.on('close',done)),stdout=Buffer.concat(out),stderr=Buffer.concat(err);await fs.writeFile(new URL(`${name}.stdout.txt`,root),stdout);await fs.writeFile(new URL(`${name}.stderr.txt`,root),stderr);return{name,exitCode,stdout:stdout.toString('utf8'),stderr:stderr.toString('utf8'),stdoutSha256:hash(stdout),stderrSha256:hash(stderr)};}
const startedAtUtc=new Date().toISOString(),tests=await run('stage-tests',['--test','--test-concurrency=1','--test-reporter=tap',...['rabin.test.mjs','capture-file.test.mjs','snapshot.test.mjs'].map(name=>fileURLToPath(new URL(name,root)))]),original=await run('stage-original',[fileURLToPath(new URL('original-compare.mjs',root))]),measurement=await run('stage-measurement',[fileURLToPath(new URL('capture-benchmark.mjs',root))]);const after=await capture();assert.deepEqual(after,before,'Stage source bytes changed during validation');const summary=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(label=>[label,Number(tests.stdout.match(new RegExp(`^# ${label} (\\d+)$`,'m'))?.[1]??-1)])),boundary=JSON.parse(await fs.readFile(new URL('original-validation.json',root))),snapshotCommands=JSON.parse(await fs.readFile(new URL('snapshot-original-observations.json',root))),measured=JSON.parse(await fs.readFile(new URL('capture-measurement.json',root))),historical=JSON.parse(await fs.readFile(new URL('historical-prototype/prototype-validation.json',root))),failedProbes=[];
for(const label of ['cat','empty']){const source=await fs.readFile(new URL(`historical-prototype/original-compare.pre-${label}-harness-correction.mjs`,root)),bytes=await fs.readFile(new URL(`historical-prototype/original-validation.pre-${label}-harness-correction.json`,root));failedProbes.push({label,sourceSha256:hash(source),exactSourceSnapshot:source.toString('utf8'),receiptSha256:hash(bytes),observations:JSON.parse(bytes)});}
const report={schema:'rea-native-rabin-stage-validation/v1',checkedAtUtc:new Date().toISOString(),startedAtUtc,runtime:process.version,platform:process.platform,summary,sourceBytesStableAcrossRun:true,sourceFingerprints:after,productionChanges:false,productionIntegrated:false,originalBoundaryComparison:{fileCases:boundary.comparisons.length,orderedChunkEntries:boundary.comparisons.reduce((sum,row)=>sum+row.originalChunks.length,0),originalExecutions:boundary.commands.length,polynomials:boundary.polynomials,exactBoundaryAndOrderedSha256Matches:boundary.comparisons.every(row=>row.orderedBoundaryAndSha256Match),cutFingerprintRuntimeComparison:false,rawReceiptSha256:hash(await fs.readFile(new URL('original-validation.json',root))),raw:boundary},snapshotOriginalExecutions:snapshotCommands,measurement:measured,historicalPrototype:historical,harnessFailuresBeforeCorrection:failedProbes,rawRuns:[tests,original,measurement],limits:{perFileBytes:67108864,snapshotBytes:536870912,minChunkBytes:524288,maxChunkBytes:8388608,windowBytes:64,averageBits:20,inputBlockBytes:524288,inputBlockCount:8192,maximumActiveMilliseconds:120000,computedLiveCaptureBuffersBytes:17825792,hardRssCap:false,forcePreemptsBlockedIOOrSink:false},scope:'Standalone actual original boundary oracle plus staged native encrypted snapshot integration; fixed Rabin controls and documented bounded source/reader subset. No original rolling Cut/runtime-custom-boundary/performance equivalence claim.',fullFeatureParity:false,productionSecurityVerified:false,universalSuperiority:false};await fs.writeFile(new URL('rabin-validation.json',root),JSON.stringify(report,null,2)+'\n');assert.equal(tests.exitCode+original.exitCode+measurement.exitCode,0);assert.equal(summary.tests,10);assert.equal(summary.pass,10);assert.equal(summary.fail+summary.cancelled+summary.skipped+summary.todo,0);assert.equal(boundary.failure,null);assert.equal(boundary.comparisons.length,30);assert.equal(snapshotCommands.length,4);console.log(JSON.stringify({summary,originalFileCases:30,orderedChunks:report.originalBoundaryComparison.orderedChunkEntries,originalExecutions:boundary.commands.length+snapshotCommands.length,sourceFiles:after.length,receiptSha256:hash(await fs.readFile(new URL('rabin-validation.json',root))),measurement:{elapsedMilliseconds:measured.elapsedMilliseconds,sampledPeakRssBytes:measured.sampledPeakRssBytes,computedLiveCaptureBuffersBytes:measured.computedMaximumLiveCaptureBuffersBytes}}));
