    {
      "id": "grafana.candidate.8db2c600f9f81b3233b5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Click the expand icon on a row to toggle the visibility of its nested table:",
      "headingPath": [
        "Table",
        "Nested tables"
      ],
