// Bounded correctness replay only. All prior source/failure epochs are immutable.
import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';import {spawn} from 'node:child_process';
const root=import.meta.dirname,hash=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:hash(b)}),selection=process.argv[2];assert.ok(['author','independent'].includes(selection));
const out=path.join(root,'runs',selection);await fs.mkdir(path.dirname(out),{recursive:true});await fs.mkdir(out,{recursive:false});
const save=async(p,b)=>{await fs.mkdir(path.dirname(p),{recursive:true});await fs.writeFile(p,b,{flag:'wx'});},json=async(p,v)=>save(p,JSON.stringify(v,null,2)+'\n');
async function walk(folder,prefix=''){let rows=[];for(const e of(await fs.readdir(folder,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){assert.equal(e.isSymbolicLink(),false);const rel=prefix+e.name,absolute=path.join(folder,e.name);if(!prefix&&['runs','history'].includes(e.name))continue;if(e.isDirectory())rows.push(...await walk(absolute,rel+'/'));else{assert.ok(e.isFile());rows.push({path:rel,...id(await fs.readFile(absolute))});}}return rows;}
async function authenticate(){const old=JSON.parse(await fs.readFile(path.join(root,'history-authentication-before.json'))),records=[];for(const a of old.authorities){const folder=path.resolve(root,'..',a.directory),mb=await fs.readFile(path.join(folder,a.manifest));assert.equal(hash(mb),a.sha256);const m=JSON.parse(mb),rows=Array.isArray(m.inventory)?m.inventory:Object.entries(m.inventory).map(([path,r])=>({path,...r}));assert.equal(rows.length,a.count);const actual=[];async function paths(dir){for(const e of await fs.readdir(dir,{withFileTypes:true})){assert.equal(e.isSymbolicLink(),false);const p=path.join(dir,e.name);if(e.isDirectory())await paths(p);else{assert.ok(e.isFile());actual.push(path.relative(folder,p).replaceAll('\\','/'));}}}await paths(folder);assert.deepEqual(actual.sort(),[...rows.map(r=>r.path),a.manifest].sort());}
 for(const r of old.records){const b=await fs.readFile(path.resolve(root,'../..',r.sourceRoot,r.sourcePath)),snapshot=await fs.readFile(path.join(root,r.snapshot));assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256},r.sourcePath);assert.deepEqual(id(snapshot),id(b),r.snapshot);records.push({authority:r.authority,sourcePath:r.sourcePath,snapshot:r.snapshot,...id(b)});}assert.equal(records.length,190);
 const c=JSON.parse(await fs.readFile(path.join(root,'execution-controls-before.json'))),Node=id(await fs.readFile(process.execPath));assert.deepEqual(Node,{bytes:c.Node.bytes,sha256:c.Node.sha256});assert.equal(process.version,c.Node.version);const parser=[];for(const r of c.independentOracleParser.records){const p=path.resolve(root,'../..',c.independentOracleParser.sourceRoot,r.path);assert.deepEqual(id(await fs.readFile(p)),{bytes:r.bytes,sha256:r.sha256});parser.push(r);}return{historicalAuthorities:old.authorities,historicalRows:records,Node:{...Node,version:process.version,path:process.execPath},parser};}
const before=await walk(root),authorityBefore=await authenticate();await json(path.join(out,'source-before.json'),before);await json(path.join(out,'authority-before.json'),authorityBefore);for(const r of before)await save(path.join(out,'source-before',r.path+'.snapshot'),await fs.readFile(path.join(root,r.path)));
const bounds={deadlineMs:120000,oldSpaceMiB:256,stdoutBytes:8*1024*1024,stderrBytes:2*1024*1024,rawObservationBytes:(selection==='author'?64:8)*1024*1024,vmUnitDeadlineMs:1000,hardRssWatchdog:false,childIsolation:'one directly spawned Node test process; --test-isolation=none',descendantCleanup:'This source selection does not spawn descendants. Collector owns and stops its directly spawned process on deadline/output caps. Windows descendant race protection is not claimed.'},file=selection==='author'?'compatibility.test.mjs':'review-replay/differential.test.mjs',argv=['--max-old-space-size=256','--test','--test-isolation=none','--test-reporter=tap',path.join(root,file)],started=new Date().toISOString();await json(path.join(out,'invocation.json'),{selection,started,argv,bounds,originalNativeExecutions:0,originalWorkbenchExecutions:0,originalExtensionHostExecutions:0,measurement:false});
const child=spawn(process.execPath,argv,{cwd:root,windowsHide:true,env:{...process.env,...(selection==='author'?{EDITOR_API_OUTPUT:out}:{EDITOR_REVIEW_OUTPUT:out})},stdio:['ignore','pipe','pipe']}),chunks={stdout:[],stderr:[]},bytes={stdout:0,stderr:0};let limit=null,spawnError=null;function stop(reason){if(!limit){limit=reason;child.kill();}}const timer=setTimeout(()=>stop('deadline'),bounds.deadlineMs);for(const name of['stdout','stderr'])child[name].on('data',b=>{bytes[name]+=b.length;if(bytes[name]<=bounds[name+'Bytes'])chunks[name].push(b);else stop(name+'Bytes');});child.on('error',e=>spawnError={name:e.name,message:e.message});const end=await new Promise(resolve=>child.on('close',(code,signal)=>resolve({code,signal})));clearTimeout(timer);const finished=new Date().toISOString();for(const n of['stdout','stderr'])await save(path.join(out,n+'.txt'),Buffer.concat(chunks[n]));
const after=await walk(root),authorityAfter=await authenticate(),sourceStable=JSON.stringify(before)===JSON.stringify(after),authorityStable=JSON.stringify(authorityBefore)===JSON.stringify(authorityAfter);await json(path.join(out,'source-after.json'),after);await json(path.join(out,'authority-after.json'),authorityAfter);const stdout=Buffer.concat(chunks.stdout).toString(),tap=Object.fromEntries(['tests','pass','fail','skipped'].map(n=>[n,Number(new RegExp('^# '+n+' (\\d+)$','m').exec(stdout)?.[1]??NaN)])),marker=new RegExp((selection==='author'?'REA_EDITOR_VALUE_API':'REA_EDITOR_INDEPENDENT')+' (\\{[^\\r\\n]+\\})').exec(stdout),observation=marker?JSON.parse(marker[1]):null,rawPath=selection==='author'?'original-comparisons.json':'comparisons.json';let raw=null;try{const b=await fs.readFile(path.join(out,rawPath));raw={path:rawPath,...id(b)};assert.ok(b.length<=bounds.rawObservationBytes);if(observation)assert.deepEqual(id(b),{bytes:observation.bytes,sha256:observation.sha256});}catch(e){if(e.code!=='ENOENT')throw e;}
const expectedTests=selection==='author'?9:13,success=end.code===0&&!spawnError&&!limit&&sourceStable&&authorityStable&&tap.tests===expectedTests&&tap.pass===expectedTests&&tap.fail===0&&tap.skipped===0&&observation&&raw,receipt={schema:'rea-editor-api-correction-focused-attempt/v1',selection,started,finished,pid:child.pid,argv,bounds,...end,spawnError,limit,bytes,tap,expectedTests,sourceFiles:before.length,sourceStable,authorityStable,historicalRowsAuthenticatedBeforeAfter:190,raw,observation,success:Boolean(success),testBodyFreshness:'Exact author/independent replay; no new held-out bodies claimed',durationMeaning:'Finite correctness verification only; no performance/memory measurement'};await json(path.join(out,'attempt.json'),receipt);console.log(JSON.stringify(receipt,null,2));process.exitCode=success?0:1;
