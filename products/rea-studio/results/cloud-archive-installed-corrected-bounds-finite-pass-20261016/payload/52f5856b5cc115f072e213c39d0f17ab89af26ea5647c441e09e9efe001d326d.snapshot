const journalPath = 'products/rea-studio/results/archive-aes-installed-20261016/installation-receipt.json';
const journalBytes = read(repository, journalPath), journal = JSON.parse(journalBytes);
const gitJournal = spawnSync('git', ['-C', repository, 'show', commit + ':' + journalPath], { shell: false, windowsHide: true, timeout: 30000, maxBuffer: 2 * 1024 * 1024 }); assert.equal(gitJournal.status, 0); assert.deepEqual(journalBytes, gitJournal.stdout);
