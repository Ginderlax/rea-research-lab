assert.equal(metadata.run.value.status,'completed');assert.equal(metadata.run.value.conclusion,'success');assert.equal(metadata.run.value.head_sha,head);assert.equal(metadata.run.value.run_attempt,1);assert.equal(metadata.jobs.value.jobs.length,1);assert.equal(String(metadata.jobs.value.jobs[0].id),job);assert.equal(metadata.jobs.value.jobs[0].conclusion,'success');assert.equal(metadata.jobs.value.jobs[0].runner_group_name,'GitHub Actions');assert(metadata.jobs.value.jobs[0].labels.includes('windows-2022'));assert.equal(metadata.artifacts.value.artifacts.length,1);assert.equal(String(metadata.artifacts.value.artifacts[0].id),artifactId);assert.equal(metadata.artifacts.value.artifacts[0].digest,'sha256:'+digest);
