    {
      "id": "grafana.candidate.88d68d79e429a8ecca71",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In that case add the sub-path to the end of this URL setting.",
      "headingPath": [
        "Configure Grafana",
