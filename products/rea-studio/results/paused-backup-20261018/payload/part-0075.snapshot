        "sha256": "a3943a943a9907ac7c1b3b13ba6b8f1519bbda6b9a19cf01591f2ade20d35b63",
        "lineStart": 71,
        "lineEnd": 71,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/guides/connectivity-errors.md#L71-L71"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
