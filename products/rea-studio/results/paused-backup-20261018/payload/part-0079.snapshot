    },
    {
      "id": "grafana.candidate.a7b58154df7ddd698673",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Correlations is a feature that allows Grafana users to set up links between their data sources. Previously, the link generated would only be from one query to another—meaning results from a query could only generate links to open a second Explore pane with other query results.",
      "headingPath": [
        "What’s new in Grafana v11.3",
        "Correlations",
        "Add correlations to external URLs in Explore"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-3.md",
        "gitBlobSha": "5eb55341a0458eac320b2317223af815e066d128",
        "sha256": "42f0fbcea86ed7f49f166bc9b279b95673f27c4ef505737f7b54ede18c391332",
        "lineStart": 182,
        "lineEnd": 182,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-3.md#L182-L182"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.632725cf5b5090683a0b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "With this feature, users can now link to third party web-based software based on their search results. The format follows the standard Grafana format for using variables.",
      "headingPath": [
        "What’s new in Grafana v11.3",
        "Correlations",
        "Add correlations to external URLs in Explore"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-3.md",
