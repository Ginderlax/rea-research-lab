    {
      "id": "grafana.candidate.e263016efdb7bdbcb72c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You should now see a GitLab login button on the login page and be able to log in or sign up with your GitLab accounts.",
      "headingPath": [
        "Configure GitLab OAuth authentication",
        "Configure GitLab authentication client using the Grafana configuration file",
        "Steps"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/gitlab/index.md",
