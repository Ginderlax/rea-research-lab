        "lineStart": 95,
        "lineEnd": 95,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/service-accounts/_index.md#L95-L95"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
