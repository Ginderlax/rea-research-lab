    {
      "id": "grafana.candidate.3d288310b8cafd51a7ff",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**SCIM support:** Support for SCIM provisioning. Supported Identity Providers are Entra ID and Okta.",
      "headingPath": [
        "Configure authentication"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/_index.md",
        "gitBlobSha": "4eaeb6c9573c12f36370a29ae5cde9ef8903af26",
