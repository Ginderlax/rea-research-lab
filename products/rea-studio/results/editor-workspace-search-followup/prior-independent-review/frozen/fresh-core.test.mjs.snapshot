import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
import {handle} from '../editor-search-fix-next/products/rea-studio/apps/editor/server.mjs';import {createWorkspace} from '../editor-search-fix-next/products/rea-studio/lib/storage.mjs';
const sha=bytes=>createHash('sha256').update(bytes).digest('hex');let count=0;
async function fixture(id){const folder=path.join(import.meta.dirname,'runs',id+'-'+Date.now()+'-'+count++),workspace=await createWorkspace(path.join(folder,'workspace'));return{folder,workspace,put:async(name,value)=>{const file=workspace.resolve(name);await fs.mkdir(path.dirname(file),{recursive:true});await fs.writeFile(file,value,{flag:'wx'});},search:input=>handle({action:'search',input,workspace}),read:name=>handle({action:'read',input:{path:name},workspace})};}
test('returned search paths should be navigable through the same Editor read contract',{timeout:10000},async()=>{const f=await fixture('long-path'),name=Array.from({length:6},(_,i)=>String(i)+'x'.repeat(179)).join('/')+'/result.txt';assert.ok(name.length>1024&&name.length<2048);await f.put(name,'target\n');const result=await f.search({query:'target'});assert.equal(result.truncated,false);assert.equal(result.matches.length,1);assert.equal(result.matches[0].path,name);const observation={pathLength:name.length,result};try{const opened=await f.read(result.matches[0].path);observation.read={accepted:true,content:opened.content};await fs.writeFile(path.join(f.folder,'observation.json'),JSON.stringify(observation,null,2)+'\n');assert.equal(opened.content,'target\n');}catch(error){observation.read={accepted:false,error:error.message};await fs.writeFile(path.join(f.folder,'observation.json'),JSON.stringify(observation,null,2)+'\n');throw error;}});
test('saved UTF-8 bytes and decoded UTF-16 selection coordinates remain linked across a BOM/astral query',{timeout:10000},async()=>{const f=await fixture('unicode-boundary'),bytes=Buffer.from('\ufeff𐐀x\r\ny𐐨z\n');await f.put('astral.txt',bytes);const result=await f.search({query:'𐐀',matchCase:false}),opened=await f.read('astral.txt');assert.deepEqual(result.matches.map(row=>[row.line,row.column,row.endColumn,row.start,row.end]),[[1,1,3,0,2],[2,2,4,6,8]]);for(const row of result.matches){assert.equal(row.revision,sha(bytes));assert.equal(row.revision,opened.revision);assert.ok(['𐐀','𐐨'].includes(opened.content.slice(row.start,row.end)));}assert.ok((await fs.readFile(f.workspace.resolve('astral.txt'))).equals(bytes));});
test('query byte limits count UTF-8 and explicit null case mode is refused',{timeout:10000},async()=>{const f=await fixture('query-bounds');await f.put('small.txt','𐐀 target\n');const exact='𐐀'.repeat(8192);assert.equal(Buffer.byteLength(exact),32768);assert.equal((await f.search({query:exact})).matches.length,0);await assert.rejects(f.search({query:exact+'x'}),/32 KiB/);await assert.rejects(f.search({query:'target',matchCase:null}),/Match case/);assert.equal((await f.search({query:'TARGET',matchCase:false})).matches.length,1);});
test('ignored entries still trigger the directory traversal budget without reading text',{timeout:30000},async()=>{const f=await fixture('entry-bound');for(let start=0;start<10001;start+=32)await Promise.all(Array.from({length:Math.min(32,10001-start)},(_,index)=>f.put('.rea-save-'+String(start+index).padStart(5,'0'),'')));const result=await f.search({query:'target'});await fs.writeFile(path.join(f.folder,'observation.json'),JSON.stringify(result,null,2)+'\n');assert.equal(result.visitedEntries,10001);assert.equal(result.inspectedFiles,0);assert.equal(result.readBytes,0);assert.equal(result.matches.length,0);assert.deepEqual(result.limitReasons,['directory-entry-limit']);assert.equal(result.truncated,true);});
