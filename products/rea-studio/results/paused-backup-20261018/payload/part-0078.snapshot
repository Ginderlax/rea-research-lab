    {
      "id": "grafana.candidate.24a0734e4a975ea001f3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana lets you use the query result from one panel for any other panel in the dashboard. Sharing query results across panels reduces the number of queries made to your data source, which can improve the performance of your dashboard.",
      "headingPath": [
        "Share query results with another panel"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/share-query/index.md",
