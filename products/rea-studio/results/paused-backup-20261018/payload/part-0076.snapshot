      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.37ab85c178c64c05aa09",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Cause:** The connection to InfluxDB timed out before receiving a response. This is common after Grafana upgrades when infrastructure changes (such as database host migrations) happen at the same time.",
      "headingPath": [
        "Troubleshoot InfluxDB data source issues",
        "Connection errors",
        "Request timed out"
      ],
      "source": {
        "path": "docs/sources/datasources/influxdb/troubleshooting/index.md",
        "gitBlobSha": "4a7b13c358eecf6574d0997b79ec479ac54c4614",
