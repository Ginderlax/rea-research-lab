    {
      "id": "grafana.candidate.2422340ad60e6b0088fe",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can also get the index of each item within a range by defining index and value variables at the start of the range:",
      "headingPath": [
        "If",
        "Range"
      ],
      "source": {
