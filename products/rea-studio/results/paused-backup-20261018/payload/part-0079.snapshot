    },
    {
      "id": "grafana.candidate.112fc1fdcd4cd3f0a7a3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Canvas is a new panel that combines the power of Grafana with the flexibility of custom elements. Canvas visualizations are extensible form-built panels that allow you to explicitly place elements within static and dynamic layouts. This empowers you to design custom visualizations and overlay data in ways that aren’t possible with standard Grafana panels, all within Grafana’s UI. If you’ve used popular UI and web design tools, then designing Canvas panels will feel very familiar.",
      "headingPath": [
        "What's new in Grafana v9.3",
        "Canvas panel"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-3.md",
        "gitBlobSha": "acf11473ed5777a12056a218dd89128f81813beb",
        "sha256": "64900ffbe97db576e8db0598932deb044076d62fbd415d6bfd717f2d4b707209",
        "lineStart": 64,
        "lineEnd": 64,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v9-3.md#L64-L64"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.015b589ae64217cf7470",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In Grafana v9.3, we have added icon value mapping support to the Canvas panel. This enables you to dynamically set which icon to display based on your data. To learn more about the Canvas panel, refer to [Canvas](../../panels-visualizations/visualizations/canvas/).",
      "headingPath": [
        "What's new in Grafana v9.3",
        "Canvas panel"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-3.md",
        "gitBlobSha": "acf11473ed5777a12056a218dd89128f81813beb",
        "sha256": "64900ffbe97db576e8db0598932deb044076d62fbd415d6bfd717f2d4b707209",
        "lineStart": 66,
        "lineEnd": 66,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v9-3.md#L66-L66"
      },
      "applicability": {
