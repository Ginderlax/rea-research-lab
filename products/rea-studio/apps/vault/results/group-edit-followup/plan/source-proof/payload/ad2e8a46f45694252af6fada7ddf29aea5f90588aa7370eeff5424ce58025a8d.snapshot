import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';
import {mount,button,field,groupRow,click,type,walk,ids,observations} from './ui-fixture.mjs';
async function open(u,mode){await click(button(u.root,'Show groups'));await click(button(groupRow(u.root,'Selected'),mode==='create'?'New child group':'Edit group details'));await type(field(u.root,'Group name'),mode==='create'?'Independent child':'Independent submitted rename');await type(field(u.root,'Group notes'),'Independent submitted notes');}
function writes(u){const events=[],set=u.store.set.bind(u.store);u.store.set=async(k,v)=>{const item={key:k,before:u.store.identity(),accepted:false};events.push(item);try{const r=await set(k,v);item.accepted=true;item.after=u.store.identity();return r;}catch(e){item.error=e.message;item.after=u.store.identity();throw e;}};return events;}
test('fresh final-list Create continuation commits once then saves newer fields once to the newly created UUID/MAC',async t=>{
 const u=await mount(t,'fresh-final-create-continuation');await open(u,'create');const mutations=writes(u),held=u.hold('recycleGroupList'),pending=click(button(u.root,'Create group'));await held.started.promise;assert.equal(mutations.length,1);assert(mutations[0].accepted);const first=u.calls.find(c=>c.action==='groupCreate');assert(first.result.created);assert.notEqual(first.result.id,ids.target);assert(button(u.root,'Create group').disabled);
 await type(field(u.root,'Group name'),'Independent retained child');await type(field(u.root,'Group notes'),'Independent retained newer notes');held.release.resolve();await pending;assert.equal(mutations.length,1);assert.equal(field(u.root,'Group name').value,'Independent retained child');assert.equal(field(u.root,'Group notes').value,'Independent retained newer notes');await click(button(u.root,'Save group details'));assert.equal(mutations.length,2);assert(mutations.every(r=>r.accepted));const saved=u.calls.filter(c=>c.action==='groupSave');assert.equal(saved.length,1);assert.equal(saved[0].input.id,first.result.id);assert.notEqual(saved[0].input.revision,first.input.revision);assert.match(saved[0].input.revision,/^[a-f0-9]{64}$/);const rows=(await u.direct('recycleGroupList',{bin:false})).groups,child=rows.find(r=>r.id===first.result.id);assert.equal(child.name,'Independent retained child');const details=(await u.direct('recycleGroupRead',{id:child.id,revision:child.recycleRevision})).group;assert.equal(details.notes,'Independent retained newer notes');assert.equal(rows.filter(r=>r.parentId===ids.target).length,2);assert(!walk(u.root).some(r=>r.tagName==='LABEL'&&r._text==='Group name'));observations.push({name:'fresh-singular-create-continuation-writes',newUUID:child.id,actualBackendPersistenceEvents:mutations,successfulCreateCalls:1,successfulSaveCalls:1,newMACUsed:true});
});
test('fresh held final-list Save clears an acknowledged effective draft even after temporary edits return to submitted values',async t=>{
 const u=await mount(t,'fresh-effective-signature');await open(u,'save');const mutations=writes(u),held=u.hold('recycleGroupList'),pending=click(button(u.root,'Save group details'));await held.started.promise;await type(field(u.root,'Group name'),'Temporary input');await type(field(u.root,'Group notes'),'Temporary notes');await type(field(u.root,'Group name'),'Independent submitted rename');await type(field(u.root,'Group notes'),'Independent submitted notes');held.release.resolve();await pending;assert.equal(mutations.length,1);assert(mutations[0].accepted);assert(!walk(u.root).some(r=>r.tagName==='LABEL'&&r._text==='Group name'));const target=(await u.direct('recycleGroupList',{bin:false})).groups.find(r=>r.id===ids.target);assert.equal(target.name,'Independent submitted rename');assert.equal((await u.direct('recycleGroupRead',{id:target.id,revision:target.recycleRevision})).group.notes,'Independent submitted notes');observations.push({name:'fresh-effective-acknowledgment-clearing',actualBackendPersistenceEvents:mutations,temporaryEditsReverted:true,effectiveSubmittedValuesAcknowledged:true});
});
test('fresh failed Save preserves encrypted document/session revision and retries with exactly one accepted persistence write',async t=>{
 const u=await mount(t,'fresh-failed-save-one-commit'),old=(await u.direct('recycleGroupList',{bin:false})).groups.find(r=>r.id===ids.target);await open(u,'save');const mutations=writes(u),before=u.store.identity();u.store.failNext();await click(button(u.root,'Save group details'));assert.equal(u.store.identity(),before);assert.equal(mutations.length,1);assert.equal(mutations[0].accepted,false);assert.equal(mutations[0].before,mutations[0].after);assert.equal(field(u.root,'Group name').value,'Independent submitted rename');assert.equal(field(u.root,'Group notes').value,'Independent submitted notes');const unchanged=(await u.direct('recycleGroupRead',{id:old.id,revision:old.recycleRevision})).group;assert.equal(unchanged.name,'Selected');await click(button(u.root,'Save group details'));assert.equal(mutations.length,2);assert.equal(mutations.filter(r=>r.accepted).length,1);const after=(await u.direct('recycleGroupList',{bin:false})).groups.find(r=>r.id===old.id);assert.notEqual(after.recycleRevision,old.recycleRevision);assert.equal(after.name,'Independent submitted rename');assert.equal((await u.direct('historyList',{id:ids.a})).revisions.length,1);observations.push({name:'fresh-failed-save-retry-persistence',actualBackendPersistenceEvents:mutations,failedRevisionStillValid:true,acceptedWrites:1});
});
test('fresh final-list committed Create disposal scrubs detached controls and never adds a second encrypted write or follow-up read',async t=>{
 const u=await mount(t,'fresh-create-final-list-disposal');await open(u,'create');const mutations=writes(u),held=u.hold('recycleGroupList'),pending=click(button(u.root,'Create group'));await held.started.promise;const name=field(u.root,'Group name'),notes=field(u.root,'Group notes'),calls=u.calls.length;assert.equal(mutations.length,1);u.cleanup();u.host.replaceChildren();held.release.resolve();await pending;assert.equal(name.value,'');assert.equal(notes.value,'');assert.equal(u.root.parentElement,null);assert.equal(mutations.length,1);assert.equal(u.calls.length,calls);observations.push({name:'fresh-final-list-disposal-proof',actualBackendPersistenceEvents:mutations,followupRequestsAfterDisposal:0,detachedControlsScrubbed:true});
});
test.after(async()=>{if(process.env.VAULT_GROUP_REVIEW_OUTPUT)await fs.writeFile(path.join(process.env.VAULT_GROUP_REVIEW_OUTPUT,'observations.json'),JSON.stringify(observations,null,2)+'\n',{flag:'wx'});});
