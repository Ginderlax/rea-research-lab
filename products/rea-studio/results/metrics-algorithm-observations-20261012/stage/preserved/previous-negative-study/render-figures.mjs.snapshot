import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import {spawnSync} from 'node:child_process';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),python='C:/Users/evanh/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/python.exe',name=process.argv[2]??'make-reportlab-figures.py';assert.ok(['make-figures.py','make-reportlab-figures.py'].includes(name));const sha=bytes=>createHash('sha256').update(bytes).digest('hex'),source=await fs.readFile(path.join(here,name)),stem='figure-attempt-'+Date.now(),startedAt=new Date().toISOString();
const child=spawnSync(python,[path.join(here,name)],{cwd:here,windowsHide:true,encoding:'utf8',timeout:60000,maxBuffer:1024*1024});
for(const [suffix,bytes]of [['.source.py.snapshot',source],['.stdout.txt',child.stdout??''],['.stderr.txt',child.stderr??'']])await fs.writeFile(path.join(here,stem+suffix),bytes,{flag:'wx'});
const receipt={startedAt,finishedAt:new Date().toISOString(),script:name,sourceSHA256:sha(source),exitCode:child.status,signal:child.signal,error:child.error?.message??null,stdoutSHA256:sha(child.stdout??''),stderrSHA256:sha(child.stderr??''),scope:'Source-bound vector plotting only; no reducer or measurement workload execution.'};await fs.writeFile(path.join(here,stem+'.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({attempt:stem,...receipt,stdout:child.stdout,stderr:child.stderr}));if(child.status!==0)process.exitCode=1;
