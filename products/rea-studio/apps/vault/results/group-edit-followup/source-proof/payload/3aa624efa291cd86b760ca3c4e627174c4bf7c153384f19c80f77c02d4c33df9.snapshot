import fs from'node:fs/promises';import path from'node:path';import{fileURLToPath}from'node:url';import{createHash}from'node:crypto';
const own=path.dirname(fileURLToPath(import.meta.url)),sha=b=>createHash('sha256').update(b).digest('hex');
const read=p=>fs.readFile(path.join(own,p)),json=async p=>JSON.parse(await read(p));
async function write(p,b){const dest=path.join(own,p);await fs.mkdir(path.dirname(dest),{recursive:true});await fs.writeFile(dest,b,{flag:'wx'});}
async function files(dir=''){const rows=[];for(const entry of(await fs.readdir(path.join(own,dir),{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const relative=path.posix.join(dir,entry.name),st=await fs.lstat(path.join(own,relative));if(st.isSymbolicLink())throw new Error('Symlink excluded '+relative);if(st.isDirectory())rows.push(...await files(relative));else rows.push(relative)}return rows;}
const run=await json('runs/candidate-final-v2/run.json');if(run.exit.code!==0||run.problem!==null||!run.sourceStable||run.summary.tests!==153||run.summary.pass!==153||['fail','skipped','cancelled','todo'].some(k=>run.summary[k]!==0))throw new Error('Accepted final run required');
for(const row of run.after){const b=await read(row.path);if(b.length!==row.bytes||sha(b)!==row.sha256)throw new Error('Final tested bytes changed '+row.path)}
const base=await json('baseline.json');for(const row of base.files){const b=await read('baseline/'+row.path+'.snapshot');if(b.length!==row.bytes||sha(b)!==row.sha256)throw new Error('Backend baseline snapshot mismatch '+row.path)}
const ui=await json('ui-baseline.json');if(sha(await read('authority/client343/manifest.json.snapshot'))!==ui.manifestSha256||sha(await read('authority/client343/client.mjs.snapshot'))!==ui.client.sha256)throw new Error('UI baseline mismatch');
const privateObservations=[];for(const p of(await files('.local')).filter(p=>/^\.local\/vault-history-fixtures\/\d+\/observations\/.*\.json$/.test(p))){const b=await read(p);JSON.parse(b);const dest='preserved-observations/'+p.slice('.local/'.length)+'.snapshot';await write(dest,b);privateObservations.push({source:p,path:dest,bytes:b.length,sha256:sha(b)})}
const editOriginal=await json('runs/candidate-final-v2/observations/group-edit-original.json'),priorOriginal=await json('runs/candidate-final-v2/observations/prior-original/group-original.json');
for(const row of[...editOriginal,...priorOriginal])if(row.exit.code!==0||row.problem!==null||!row.value||row.assemblyLoads!==1)throw new Error('Actual successful original observation required');
const core=[];for(const name of['client.mjs','server.mjs','recycle.mjs','history.mjs','kdbx.mjs','xml.mjs']){const p='products/rea-studio/apps/vault/'+name,b=await read(p);core.push({path:p,bytes:b.length,sha256:sha(b)})}
const validation={schema:'rea-vault-group-edit-finite-validation/v1',createdAt:new Date().toISOString(),status:'Author candidate complete; independent review and full shared-host/normal-browser validation pending. Not installed or published.',acceptedFinalRun:{path:'runs/candidate-final-v2/run.json',sha256:sha(await read('runs/candidate-final-v2/run.json')),tests:153,pass:153,fail:0,skipped:0,cancelled:0,todo:0,sourceStable:true,fileRoster:run.tests},backendBaseline:{manifestSha256:base.stageManifest.sha256,verifiedPriorInventory:777,snapshots:base.files.length},uiBaseline:{manifestSha256:ui.manifestSha256,verifiedPriorInventory:343,client:ui.client,testAuthority:'ui-test-baseline.json'},backendEpoch:'epochs/backend-v1/manifest.json',core,selectedOriginalSourceFiles:17,actualManagedOriginal:{selectedGroupEditAssemblyLoads:editOriginal.length,existingGroupRecycleAssemblyLoads:priorOriginal.length,totalAssemblyLoads:editOriginal.length+priorOriginal.length,selectedCalls:editOriginal.map(r=>r.value.calls),existingCalls:priorOriginal.map(r=>r.value.calls),originalGUI:0,originalFullProgram:0,sourceComposedNameNotes:true,explicitSyntheticClockUuidAdapters:true,scope:'Finite actual managed constructor/AddGroup/Touch and released KDBX save/open comparisons, not GUI event or whole-program equivalence.'},normalBrowserExecutions:0,sharedHostHttpRuns:0,ownedDomClientServer:true,actualFreshNodeStoreRestartTest:1,privateObservationCopies:privateObservations,failuresPreserved:'failure-ledger.json',unchangedCore:['history.mjs','kdbx.mjs','xml.mjs','lib/storage.mjs'],limitations:['Active groups only; recycled parents/groups refuse editor commands.','Only child creation and name/notes; icons/moves/tags/settings/custom data/templates/full group editor remain missing.','Smaller local XML/depth/path/size limits, deterministic comparison clocks.','Not full KeePass/manual parity or universal superiority.','Independent review/normal-browser/full-shared-host checks and installation/publication remain pending.']};await write('validation.json',JSON.stringify(validation,null,2)+'\n');
const inventory=[];for(const p of(await files()).filter(p=>!p.startsWith('.local/')&&!['manifest.json','freeze.json'].includes(p))){const b=await read(p);inventory.push({path:p,bytes:b.length,sha256:sha(b)})}const manifest={schema:'rea-vault-group-edit-strict-preservation/v1',createdAt:new Date().toISOString(),pathsAreStrict:true,files:inventory.length,inventory,excluded:['.local/**','manifest.json','freeze.json'],originalBinariesCopied:false};await write('manifest.json',JSON.stringify(manifest,null,2)+'\n');const manifestBytes=await read('manifest.json');for(const row of inventory){const b=await read(row.path);if(b.length!==row.bytes||sha(b)!==row.sha256)throw new Error('Post-write freeze mismatch '+row.path)}const finalRoster=(await files()).filter(p=>!p.startsWith('.local/')&&!['manifest.json','freeze.json'].includes(p)).sort();if(JSON.stringify(finalRoster)!==JSON.stringify(inventory.map(r=>r.path).sort()))throw new Error('Strict post-write roster changed');await write('freeze.json',JSON.stringify({schema:'rea-vault-group-edit-freeze-receipt/v1',createdAt:new Date().toISOString(),manifestSha256:sha(manifestBytes),files:inventory.length,verified:inventory.length,unlisted:0,core,validationSha256:sha(await read('validation.json'))},null,2)+'\n');console.log(JSON.stringify({files:inventory.length,manifestSha256:sha(manifestBytes),core,tests:153,selectedOriginalLoads:editOriginal.length,priorGroupLoads:priorOriginal.length,originalGui:0,normalBrowser:0}));
