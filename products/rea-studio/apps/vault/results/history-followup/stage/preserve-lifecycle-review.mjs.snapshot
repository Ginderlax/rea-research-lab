import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
const root=import.meta.dirname,source=path.resolve(root,'../keepass-history-lifecycle-review'),sha=b=>createHash('sha256').update(b).digest('hex'),manifest=await fs.readFile(path.join(source,'review-manifest.json')),receipt=await fs.readFile(path.join(source,'review-validation.json'));assert.equal(sha(manifest),'b631915fbfdb7dc40f7f5ba828d456b26aa7dbbeb2137d704fc4a0aa7f8ce939');assert.equal(sha(receipt),'c2df709c43f3d545d34b16815c28a33ad0c8bba1c6a35435cdfdcf59c5b6fc41');const parsed=JSON.parse(manifest),files=parsed.files??parsed.entries;assert.equal(files.length,33);const prefix='preserved-independent/keepass-history-lifecycle-review';for(const e of files){const b=await fs.readFile(path.join(source,e.path));assert.equal(sha(b),e.sha256);assert.equal(b.length,e.bytes);const target=path.join(root,prefix,e.path+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b);}for(const name of ['review-manifest.json','freeze.json'])await fs.copyFile(path.join(source,name),path.join(root,prefix,name+'.snapshot'));
const originalTest=await fs.readFile(path.join(source,'idle-view.test.mjs'),'utf8'),test=originalTest.replace("from './ui-fixture.mjs'","from './lifecycle-ui-fixture.mjs'");assert.notEqual(test,originalTest);const originalFixture=await fs.readFile(path.join(source,'ui-fixture.mjs'),'utf8'),fixture=originalFixture.replace("process.env.VAULT_REVIEW_STAGE??path.join(own,'../keepass-history-selection-fix-next')","process.env.VAULT_REVIEW_STAGE??own").replace("path.join(own,'boundary-observations')","path.join(own,'.local/observations/lifecycle-boundaries')");assert.notEqual(fixture,originalFixture);await fs.writeFile(path.join(root,'idle-view.test.mjs'),test);await fs.writeFile(path.join(root,'lifecycle-ui-fixture.mjs'),fixture);await fs.writeFile(path.join(root,'lifecycle-preservation.json'),JSON.stringify({schema:'rea-vault-lifecycle-preservation/v1',prefix,files,manifestSha256:sha(manifest),receiptSha256:sha(receipt),adaptations:[{path:'idle-view.test.mjs',originalSha256:sha(originalTest),candidateSha256:sha(test),edits:'Local helper import path only; unchanged controlled-timer scenario body.'},{path:'lifecycle-ui-fixture.mjs',originalSha256:sha(originalFixture),candidateSha256:sha(fixture),edits:'Default owned stage and output directory paths only; cleanup capture is present in original reviewed harness.'}],realElapsedTimingComparison:false},null,2)+'\n');
