    {
      "id": "grafana.candidate.3174b862e3dfac4052b0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This example shows how a single alert rule can generate multiple alert instances — one for each label set (or time series). This is called **multi-dimensional alerting**: one alert rule, many alert instances.",
      "headingPath": [
        "Example of multi-dimensional alerts on time series data"
      ],
      "source": {
        "path": "docs/sources/alerting/examples/multi-dimensional-alerts.md",
        "gitBlobSha": "bf496b32b55a4738ca06289b54503b871254f5b5",
