    },
    {
      "id": "grafana.candidate.4210ddc6e89de511ddd3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The logs visualization displays these records from data sources that support logs, such as Elastic, Influx, and Loki. The logs visualization shows, by default, the timestamp, a colored string representing the log status, the log line body, as well as collapsible log events that help you analyze the information generated.",
      "headingPath": [
        "Logs"
      ],
      "source": {
