    },
    {
      "id": "grafana.candidate.791c0d7271c5c6fa5e96",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To configure Generic OAuth to use a refresh token, set `use_refresh_token` configuration option to `true` and perform one or both of the following steps, if required:",
      "headingPath": [
        "Configure Generic OAuth authentication",
        "Configure generic OAuth authentication client using the Grafana configuration file",
        "Configure a refresh token"
      ],
