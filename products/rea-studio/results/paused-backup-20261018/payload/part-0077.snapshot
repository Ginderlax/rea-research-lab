    },
    {
      "id": "grafana.candidate.68ee3fe213bd8b7381d1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You must create a Cloud Access Policy and token to use the Cloud API. To create a Grafana Cloud Access Policy, refer to [Create an access policy](https://grafana.com/docs/grafana-cloud/security-and-account-management/authentication-and-permissions/access-policies/create-access-policies/).",
      "headingPath": [
        "Grafana Cloud API",
        "Authentication"
      ],
      "source": {
        "path": "docs/sources/developer-resources/api-reference/cloud-api/_index.md",
        "gitBlobSha": "47084eda748d5de389c4ac2232795f2413529ff1",
        "sha256": "9de137746f69d61a88f41125f70ae6e307cf09cb6e4ace1eb1c136fb6909ef28",
        "lineStart": 24,
        "lineEnd": 25,
