    {
      "id": "grafana.candidate.dfd2cf1a24c7bc1476de",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If a saved query includes variables, you can substitute the variables in the query without modifying it by mapping them to a custom value. This is useful in environments where variable names or available values differ between dashboards.",
      "headingPath": [
        "Query editor in Explore",
        "Saved queries",
        "Variables in saved queries"
