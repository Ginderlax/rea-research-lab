    },
    {
      "id": "grafana.candidate.fadeea549fbcfa0f7097",
      "syntaxRole": "list-item",
      "sourceText": "- Check if the identity provider supports account federation. In such cases, you can configure it once and let your identity provider federate the accounts from different providers.",
      "headingPath": [
        "Configure authentication",
        "Configuring multiple identity providers"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/_index.md",
