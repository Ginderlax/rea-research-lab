    {
      "id": "grafana.candidate.34212f7731fd68fbe72d",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Let's now use the same steps to reduce each query to the last (most recent) value. Reducing Query `A` to a single value might look like this:",
      "headingPath": [
