    },
    {
      "id": "grafana.candidate.fdf4200c4d0808853bf3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can use [template variables](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/postgres/template-variables/) in queries to create dynamic, reusable dashboards. For example, to filter by a variable named `hostname`:",
      "headingPath": [
        "PostgreSQL query editor",
        "Table queries"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/query-editor/_index.md",
        "gitBlobSha": "da418c753c9813f78e1d4eed64e0946e46a50b3e",
        "sha256": "039487ccd5bee34210f2a93dfc270b66e758127ff361f491daa43c2203030f7f",
        "lineStart": 140,
        "lineEnd": 140,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/postgres/query-editor/_index.md#L140-L140"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
