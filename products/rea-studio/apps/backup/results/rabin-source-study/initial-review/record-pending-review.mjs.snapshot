import * as fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const root=fileURLToPath(new URL('./',import.meta.url)),hash=bytes=>createHash('sha256').update(bytes).digest('hex'),baseline=JSON.parse(await fs.readFile(path.join(root,'baseline-manifest.json'),'utf8'));
for(const item of baseline.files){const bytes=await fs.readFile(path.resolve(root,'../backup-rabin-next',item.path)),copy=await fs.readFile(path.join(root,'baseline',item.path));assert.equal(bytes.length,item.bytes);assert.equal(hash(bytes),item.sha256);assert.equal(hash(copy),item.sha256);}
const sources=[];for(const name of ['baseline-manifest.json','preserve-baseline.mjs','lifecycle-probes.mjs','original-subset.mjs','open-review.md','record-pending-review.mjs']){const bytes=await fs.readFile(path.join(root,name));sources.push({path:name,bytes:bytes.length,sha256:hash(bytes)});}
const report={schema:'rea-rabin-independent-review-pending/v1',checkedAtUtc:new Date().toISOString(),stageReceiptSha256:baseline.stageReceiptSha256,stageAndBaselineExactBytesVerified:true,baselineFiles:baseline.files.length,sourceInspectionComplete:true,probeExecutionStarted:false,openHypotheses:['Missing post-stat abort/deadline guard before sink and final success','Guarded temporary cleanup can reject after snapshot hard-link commit'],waitingFor:'Root signal after Metrics quiet timing window',sourceFingerprints:sources,productionEdits:false,stageEdits:false,fullParityClaim:false,securityVerificationClaim:false};
await fs.writeFile(path.join(root,'pending-review.json'),JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({stageUnchanged:true,baselineFiles:baseline.files.length,probeExecutionStarted:false,receiptSha256:hash(await fs.readFile(path.join(root,'pending-review.json')))}));
