    },
    {
      "id": "grafana.candidate.a11f4b276114c37786e2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can link profile and tracing data using your Pyroscope data source with the Tempo data source.",
      "headingPath": [
        "Pyroscope data source",
        "Visualize traces and profiles data using Trace to profiles"
      ],
      "source": {
