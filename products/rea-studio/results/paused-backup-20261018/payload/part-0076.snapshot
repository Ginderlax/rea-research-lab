    },
    {
      "id": "grafana.candidate.852cd7ac0dfc1c797aa4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana consolidates all Graphite metrics so that Graphite doesn't return more data points than there are pixels in the graph. By default, Grafana consolidates data points using the `avg` function. To control how Graphite consolidates metrics, use the Graphite `consolidateBy()` function.",
      "headingPath": [
        "Graphite query editor",
        "Functions",
        "Consolidate data points"
      ],
      "source": {
        "path": "docs/sources/datasources/graphite/query-editor/index.md",
        "gitBlobSha": "b3c4dd0a3b8fa087860bc7166417b838182a7a0f",
        "sha256": "6ced8f5013d0e7915d51e15ba80ed9f73c86317cb3e7dcc37918a1d2322c61be",
        "lineStart": 82,
        "lineEnd": 84,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/graphite/query-editor/index.md#L82-L84"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.2fdf65f8ccb276c7637f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana calculates legend summary values like `max`, `min`, and `total` on the client side, after data has been calculated. Depending on the consolidation function used, only one or two of these values may be accurate at the same time.",
      "headingPath": [
        "Graphite query editor",
        "Functions",
        "Consolidate data points"
      ],
      "source": {
        "path": "docs/sources/datasources/graphite/query-editor/index.md",
