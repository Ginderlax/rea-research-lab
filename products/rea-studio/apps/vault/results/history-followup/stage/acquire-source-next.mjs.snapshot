import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url));await fs.mkdir(path.join(here,'.local/acquisition'),{recursive:true});const sha=b=>createHash('sha256').update(b).digest('hex');let count=1;const attempts=[JSON.parse(await fs.readFile(path.join(here,'.local/acquisition/00.json')))];
async function acquire(url,limit=8*1024*1024){const startedAtUtc=new Date().toISOString();let data=Buffer.alloc(0),response,error=null;try{response=await fetch(url,{signal:AbortSignal.timeout(10000)});const parts=[];let size=0;for await(const piece of response.body){size+=piece.length;if(size>limit)throw new Error('Response exceeds bound');parts.push(piece);}data=Buffer.concat(parts);}catch(e){error=e.message;}const name=String(count++).padStart(2,'0');await fs.writeFile(path.join(here,'.local/acquisition',name+'.bin'),data,{flag:'wx'});const row={name,url,finalUrl:response?.url,status:response?.status,startedAtUtc,completedAtUtc:new Date().toISOString(),bytes:data.length,sha256:sha(data),timeoutMs:10000,limit,error};attempts.push(row);await fs.writeFile(path.join(here,'.local/acquisition',name+'.json'),JSON.stringify(row,null,2)+'\n',{flag:'wx'});return {data,row};}
const integrity={data:await fs.readFile(path.join(here,'.local/acquisition/00.bin')),row:attempts[0]};assert.equal(sha(integrity.data),integrity.row.sha256);assert.equal(integrity.row.status,200);const raw=integrity.data.toString(),where=raw.indexOf('KeePass-2.61.1-Source.zip');assert.ok(where>0);const excerpt=raw.slice(where,where+1600);const advertised=[...excerpt.matchAll(/711BD9EC\s+70766616\s+78469E51\s+BAE876DE\s+BAC07A08\s+C32F1B1C\s+6B3B8FE5\s+E761C13A/g)];assert.equal(advertised.length,1,'Publisher source digest not found in exact captured page');const expected='711bd9ec7076661678469e51bae876debac07a08c32f1b1c6b3b8fe5e761c13a';let accepted=null;
for(const url of ['https://downloads.sourceforge.net/project/keepass/KeePass%202.x/2.61.1/KeePass-2.61.1-Source.zip','https://github.com/JiriSko/KeePass/releases/download/v2.61.1/KeePass-2.61.1-Source.zip']){const attempt=await acquire(url);if(attempt.row.status===200&&attempt.row.sha256===expected){accepted=attempt;break;}}
await fs.writeFile(path.join(here,'source-acquisition.json'),JSON.stringify({schema:'rea-keepass-history-release-source-acquisition/v1',attempts,publisherExpectedSha256:expected,accepted:accepted?.row??null,openPgpVerified:false},null,2)+'\n',{flag:'wx'});assert.ok(accepted,'Publisher-matched source unavailable; exact failed attempts retained');await fs.writeFile(path.join(here,'.local/KeePass-2.61.1-Source.zip'),accepted.data,{flag:'wx'});console.log(JSON.stringify({accepted:accepted.row,expected}));
