// Source-only planning: no application/original/test/browser invocation or installation.
import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const AUTHOR='work/editor-search-pattern-next',MANIFEST='7f975ae3f7a0827f5b9ade231bd121c5b4028f17d88758455fd680962ff0f878',VALIDATION='b5c3dce47960f6e1611de2c489ba2ca5a1c5d3bce7819588bd18272e4e71cd0a',sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)}),forbidden=new Set(['.local','work','artifacts','tooling','node_modules']);
async function bytes(file){const stat=await fs.lstat(file);assert.equal(stat.isSymbolicLink(),false);assert.ok(stat.isFile());assert.ok(stat.size<=16*1024*1024,'Bounded source-only read');return fs.readFile(file);}
function safeRelative(p){assert.equal(typeof p,'string');assert.ok(p&&!path.isAbsolute(p)&&!p.includes('\\'));assert.ok(p.split('/').every(x=>x&&x!=='.'&&x!=='..'));return p;}
async function strict(root,m){assert.ok(Array.isArray(m.inventory));const names=[];async function walk(folder=''){for(const e of await fs.readdir(path.join(root,folder),{withFileTypes:true})){assert.equal(e.isSymbolicLink(),false);const p=folder?folder+'/'+e.name:e.name;if(e.isDirectory())await walk(p);else{assert.ok(e.isFile());names.push(p);}}}await walk();assert.deepEqual(names.sort(),[...m.inventory.map(r=>r.path),'freeze-manifest.json'].sort());for(const r of m.inventory){safeRelative(r.path);assert.deepEqual(id(await bytes(path.join(root,r.path))),{bytes:r.bytes,sha256:r.sha256});}return names.length;}
export async function prepareEditorPatternPlan({workspaceRoot,publicPrefix='products/rea-studio/results/editor-search-pattern-reviewed-installation-20261013/source-proof'}={}){
 workspaceRoot=path.resolve(workspaceRoot);safeRelative(publicPrefix);assert.ok(publicPrefix.split('/').every(x=>!forbidden.has(x)));const root=path.join(workspaceRoot,AUTHOR),repo=path.join(workspaceRoot,'outputs/rea-research-lab'),mb=await bytes(path.join(root,'freeze-manifest.json'));assert.equal(sha(mb),MANIFEST);const manifest=JSON.parse(mb);assert.equal(manifest.inventory.length,573);assert.equal(await strict(root,manifest),574);const vb=await bytes(path.join(root,'validation.json'));assert.equal(sha(vb),VALIDATION);const validation=JSON.parse(vb);assert.equal(validation.finalFocused.totals.tests,78);assert.equal(validation.finalFocused.passed,true);assert.equal(validation.productionInstalled,false);assert.equal(validation.independentReviewPending,true);
 const base=JSON.parse(await bytes(path.join(root,'production-before.json')));assert.equal(base.rows.length,31);for(const r of base.rows)assert.deepEqual(id(await bytes(path.join(repo,safeRelative(r.path)))),{bytes:r.bytes,sha256:r.sha256});const proposed=JSON.parse(await bytes(path.join(root,'candidate-change-list.json'))).rows;assert.equal(proposed.length,12);assert.equal(proposed.filter(x=>x.kind==='modified').length,4);assert.equal(proposed.filter(x=>x.kind==='new').length,8);const install=[];for(const r of proposed){safeRelative(r.candidatePath);safeRelative(r.installPath);assert.ok(r.installPath.startsWith('products/rea-studio/apps/editor/'));const source=await bytes(path.join(root,r.candidatePath));assert.deepEqual(id(source),r.after);if(r.before)assert.deepEqual(id(await bytes(path.join(repo,r.installPath))),r.before);else{await assert.rejects(fs.lstat(path.join(repo,r.installPath)),e=>e.code==='ENOENT');}install.push({sourceRoot:AUTHOR,sourcePath:r.candidatePath,livePath:r.installPath,kind:r.kind,before:r.before,after:r.after,transformation:'none',sourceBytesExact:true,independentBehaviorAcceptancePending:true});}
 const inventory=[...manifest.inventory,{path:'freeze-manifest.json',...id(mb)}],excluded=[],mapped=[],payloads=new Map();const probe=JSON.parse(await bytes(path.join(root,'original-boundary-probe.json')));
 for(const r of inventory){let reconstruction=null;
  if(r.path.startsWith('.local/original-boundary/')){const name=path.basename(r.path,'.txt'),row=probe.results.find(x=>x.name===name);assert.ok(row);assert.deepEqual(id(Buffer.from(row.content)),{bytes:r.bytes,sha256:r.sha256});reconstruction={input:'original-boundary-probe.json',selector:`results[name=${JSON.stringify(name)}].content`,generator:'original-boundary-probe.mjs',kind:'synthetic original-engine input'};}
  else if(/\/\.local\/editor-save-(?:revision-)?review\/[^/]+\/workspace\/[ab]\.txt$/.test(r.path)){const file=path.basename(r.path),observation=r.path.slice(0,r.path.lastIndexOf('/workspace/'))+'/observation.json',value=JSON.parse(await bytes(path.join(root,observation)));const key=file==='a.txt'?'diskA':'diskB';assert.equal(typeof value[key],'string');assert.deepEqual(id(Buffer.from(value[key])),{bytes:r.bytes,sha256:r.sha256});reconstruction={input:observation,selector:key,generator:file==='a.txt'?'Copied current Save tests/fixture':'Copied current Save tests/fixture',kind:'generated committed synthetic fixture mirror'};}
  else if(/^runs\/original-[^/]+\/synthetic-workspace\/[^/]+\.txt$/.test(r.path)){const input=r.path.slice(0,r.path.indexOf('/synthetic-workspace/'))+'/inputs.json',value=JSON.parse(await bytes(path.join(root,input))),name=path.basename(r.path);assert.deepEqual(id(Buffer.from(value.files[name])),{bytes:r.bytes,sha256:r.sha256});reconstruction={input,selector:`files[${JSON.stringify(name)}]`,generator:'original-pattern-comparison.mjs',kind:'deterministic generated comparison input mirror'};}
  if(reconstruction){excluded.push({epoch:'author573',sourceRoot:AUTHOR,sourcePath:r.path,bytes:r.bytes,sha256:r.sha256,reason:'No extra public payload for an exact generated fixture mirror; full input/generator/raw/census and immutable author manifest retained.',reconstruction});continue;}
  const publicPath=publicPrefix+'/author/content/'+r.sha256+'.snapshot';const row={epoch:'author573',sourceRoot:AUTHOR,sourcePath:r.path,publicPath,bytes:r.bytes,sha256:r.sha256,qualification:r.path.startsWith('official-source/')?'Exact pinned MIT source/license; verification-only, no original runtime import.':r.path.includes('/.local/')?'Exact bounded synthetic raw observation; path represented by metadata and content address.':r.path.startsWith('negative-close/')||r.path.startsWith('failed-initial/')?'Historical negative/assertion-error source epoch; not current acceptance.':r.path.startsWith('runs/')?'Exact executed source/log/observation for the labelled finite epoch; prepared/replayed comparisons, not held-out or full workbench.':'Exact inert author source/metadata or copied before-image; no independent/current installation acceptance.'};mapped.push(row);
  if(payloads.has(publicPath)){assert.deepEqual({bytes:payloads.get(publicPath).bytes,sha256:payloads.get(publicPath).sha256},{bytes:r.bytes,sha256:r.sha256});payloads.get(publicPath).sourceAliases.push(r.path);}else payloads.set(publicPath,{sourceRoot:AUTHOR,sourcePath:r.path,publicPath,bytes:r.bytes,sha256:r.sha256,sourceAliases:[r.path],transformation:'none; inert byte snapshot'});
 }
 assert.equal(mapped.length+excluded.length,574);assert.equal(new Set(mapped.map(r=>r.sourcePath)).size,mapped.length);assert.equal(new Set(excluded.map(r=>r.sourcePath)).size,excluded.length);const finalRows=JSON.parse(await bytes(path.join(root,'candidate-final-sources.json'))).rows;assert.equal(finalRows.length,39);const original=JSON.parse(await bytes(path.join(root,'official-source-provenance.json')));assert.equal(original.fetched.length,5);const license=original.fetched.find(r=>r.sourcePath==='LICENSE.txt');assert.equal(license.sha256,'9480271317925265e806a9a196aaa33410a962fa9d4d1e248a4a5187bc8c9df9');
 const declarations=original.fetched.filter(r=>/search(?:ExtTypes)?\.ts$/.test(r.sourcePath)).map(r=>({...r,qualification:'Pinned official search service/API contract source; declared options are not a claim all fields are implemented.'}));assert.equal(declarations.length,2);
 assert.equal(await strict(root,manifest),574);for(const r of base.rows)assert.deepEqual(id(await bytes(path.join(repo,r.path))),{bytes:r.bytes,sha256:r.sha256});return{schema:'rea-editor-pattern-source-publication-plan/v1',author:{root:AUTHOR,payloads:573,manifest:{path:'freeze-manifest.json',...id(mb)},validation:{path:'validation.json',...id(vb)},strictBeforeAfter:true},publicPrefix,prefixStatus:'prospective-root-confirmation-required',publicMap:mapped,publicCopies:[...payloads.values()].sort((a,b)=>a.publicPath.localeCompare(b.publicPath)),excludedFixtures:excluded,installation:install,currentBeforeImages:base.rows,currentAfterSources:finalRows.map(r=>({path:r.path.slice('candidate/'.length),bytes:r.bytes,sha256:r.sha256})),officialMITFiles:original.fetched,pinnedSearchDeclarations:declarations,license,rawCounts:{mapRows:mapped.length,excludedRows:excluded.length,uniquePayloadAliases:payloads.size,savedDuplicatePayloadCopies:mapped.length-payloads.size,totalCandidateRows:574},installedTestRootBoundary:'Exact three new tests retain source-relative ../../../../../.local. Work stage resolves stage/.local; current live layout resolves outputs/.local. mkdtemp+exact parent checks limit cleanup to owned fresh folders. No silent path adapter or installation transformation.',authorityBoundary:'Full five MIT source/license files and selected source helpers/metadata preserved. Existing acquired release identity and shipped d.ts are not newly executed search workbench; complete declarations do not imply whole-API/extension-host parity.',resourceBoundary:'Module-instance4 workers; absolute5s worker startup/idle/match lifetime;64/16/4MiB V8 old/young/stack;32KiB query/2MiB content+response/1001 spans; not hard process/OS-I/O watchdog. Workspace disposer only; UI generations are not remote cancel.',behaviorAcceptedIndependently:false,browserAccepted:false,productionWrites:0,publicWrites:0,tests:0,originalCalls:0,benchmarks:0,fullParity:false,allWaysSuperior:false};
}
