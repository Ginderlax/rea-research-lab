      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.bbfa3ad633e7b961c499",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The remote write target can be edited by clicking `Edit Remote Write Target` in the upper right on the Recorded Queries tab in Preferences. Select the Prometheus data source that has remote write enabled and enter the remote write path.",
      "headingPath": [
        "Recorded queries (deprecated)",
