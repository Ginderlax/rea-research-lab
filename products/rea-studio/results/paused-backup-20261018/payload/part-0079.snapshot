    {
      "id": "grafana.candidate.527ebbac848bd713b8e1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This update facilitates file provisioning and maintenance for contact points. The feature implements the provisioning API export endpoints for exporting contact points as well as adding export buttons to the contact point list in the UI.",
