  { role: 'browser', job: 117007336495, artifact: 12050033224, digest: 'a43e59c3626108efc5aa1d3bddb2ba8305a1afa087459117527272c11471e121', archiveBytes: 2084714, readableFiles: 474, snapshots: 346, census: 346 }];
