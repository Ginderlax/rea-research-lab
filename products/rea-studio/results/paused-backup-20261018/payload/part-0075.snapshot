          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.2e1aa4330c4671241a3c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can use **Grafana Explore** and the Loki query editor to search for alert state changes.",
      "headingPath": [
        "Meta monitoring",
        "Logs for Grafana-managed alerts"
      ],
      "source": {
