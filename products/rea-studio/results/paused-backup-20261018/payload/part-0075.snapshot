      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.65e6bea2ae489a0f52e4",
      "syntaxRole": "table-row",
      "sourceText": "| `GROUP BY`   | Optional. Groups the query results into multiple time series. For example, `GROUP BY ServiceName`.                                                                                                           |",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Query CloudWatch metrics",
        "Use Metrics Insights keywords"
