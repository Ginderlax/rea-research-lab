    },
    {
      "id": "grafana.candidate.d9e138c0803d6db3fd8e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This query returns all server tag values from series where the `server` tag matches backend\\* and the `app` tag matches the regex-filtered values from another variable ${apps}.",
      "headingPath": [
        "Graphite template variables",
        "Use tag variables"
      ],
      "source": {
        "path": "docs/sources/datasources/graphite/template-variables/index.md",
