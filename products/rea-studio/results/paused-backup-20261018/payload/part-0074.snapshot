    },
    {
      "id": "grafana.candidate.e06de85bf6c6356ec968",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Dashboard and folder permissions enable you to grant a viewer the ability to edit and save dashboard changes, or limit an editor's permission to modify a dashboard.",
      "headingPath": [
        "Manage dashboard permissions"
      ],
      "source": {
        "path": "docs/sources/administration/user-management/manage-dashboard-permissions/index.md",
