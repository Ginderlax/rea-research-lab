    {
      "id": "grafana.candidate.cae29c0122e91de1993d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Interval between keep-alive probes. Default is `30` seconds. For more details, refer to the [`Dialer.KeepAlive`](https://golang.org/pkg/net/#Dialer.KeepAlive) documentation.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[dataproxy]`",
        "`keep_alive_seconds`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
