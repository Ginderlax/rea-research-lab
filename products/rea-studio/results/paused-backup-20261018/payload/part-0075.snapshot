    {
      "id": "grafana.candidate.eaf560ae698a8115d644",
      "syntaxRole": "table-row",
      "sourceText": "| **Namespace**   | The AWS service namespace. Examples: `AWS/EC2`, `AWS/Lambda`.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "CloudWatch Metrics query editor components"
      ],
      "source": {
