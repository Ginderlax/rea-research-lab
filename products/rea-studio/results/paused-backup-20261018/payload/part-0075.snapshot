    {
      "id": "grafana.candidate.ae7709fea30d673e3f5d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This documentation provides an overview of the functions and operators of the Go template language that are available for both notification and alert rule templates.",
      "headingPath": [
        "Alerting template language"
      ],
      "source": {
        "path": "docs/sources/alerting/configure-notifications/template-notifications/language.md",
