import fs from 'node:fs/promises';
import path from 'node:path';
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
const work=import.meta.dirname,base=path.dirname(work),lab=path.join(base,'outputs/rea-research-lab'),own=path.join(work,'editor-vault-reviewed-installation-next'),sha=b=>createHash('sha256').update(b).digest('hex');
const sources=[['editor','editor-pattern-root-installation-plan-next','b5e21ff4810e0b92d066a72deeb8bb41538aed48e499a4bcd8774f8322b81996',637],['vault','vault-group-publication-plan-next','8a575dd9610bf71a6b81169314d45b023aaff96f629a9648d4af9df5222d9521',325]];
function safe(p){assert(typeof p==='string'&&p&&!path.isAbsolute(p)&&!/[\\:\x00-\x1f]/.test(p)&&p.split('/').every(s=>s&&s!=='.'&&s!=='..'));}
async function read(root,p,r){safe(p);const b=await fs.readFile(path.join(root,p));if(r){assert.equal(b.length,r.bytes,p);assert.equal(sha(b),r.sha256,p);}return b;}
async function files(root,p=''){const out=[];for(const e of await fs.readdir(path.join(root,p),{withFileTypes:true})){assert(!e.isSymbolicLink());const rel=p?p+'/'+e.name:e.name;safe(rel);if(e.isDirectory())out.push(...await files(root,rel));else out.push(rel);}return out.sort();}
const plans=[],copies=[],proposals=[];
for(const[role,folder,pin,count]of sources){const root=path.join(work,folder),mb=await read(root,'manifest.json');assert.equal(sha(mb),pin);const m=JSON.parse(mb);assert.equal(m.inventory.length,count);assert.deepEqual(await files(root),[...m.inventory.map(r=>r.path),'manifest.json'].sort());for(const r of m.inventory)await read(root,r.path,r);const plan=JSON.parse(await read(root,'installation-plan.json'));assert.equal(plan.productionEpoch,'f0b4746eae49b2a83694de1a0a28fee63e004257');assert.equal(plan.productionWrites,0);plans.push({role,folder,root,manifest:{bytes:mb.length,sha256:pin},plan});
 for(const r of m.inventory.filter(r=>r.path.startsWith('source-proof/'))){const target=plan.publicSourcePrefix+r.path.slice('source-proof'.length);copies.push({source:'work/'+folder+'/'+r.path,path:target,bytes:r.bytes,sha256:r.sha256,role});}
 for(const r of plan.rows){const destination=r.livePath??r.target,after=r.after??{bytes:r.bytes,sha256:r.sha256},before=r.before??r.expectedBefore??null,source=(r.sourceRoot==='this-plan'?'work/'+folder:r.sourceRoot??'work/keepass-group-active-list-fix-next')+'/'+(r.sourcePath??r.source);safe(destination);assert(destination.startsWith('products/rea-studio/apps/'+role+'/'));await read(base,source,after);if(before)await read(lab,destination,before);else await assert.rejects(fs.access(path.join(lab,destination)),e=>e.code==='ENOENT');proposals.push({source,destination,before,after,role,documentation:!!r.explicitDocumentationOverlay});}
}
assert.equal(proposals.length,30);assert.equal(proposals.filter(r=>r.before).length,8);assert.equal(new Set(proposals.map(r=>r.destination)).size,30);assert.equal(new Set(copies.map(r=>r.path)).size,copies.length);for(const r of copies){await read(base,r.source,r);await assert.rejects(fs.access(path.join(lab,r.path)),e=>e.code==='ENOENT');}
await fs.mkdir(own,{recursive:false});await fs.copyFile(import.meta.filename,path.join(own,'collector.mjs.snapshot'));
const preflight={schema:'rea-editor-vault-reviewed-installation-preflight/v1',at:new Date().toISOString(),plans:plans.map(({role,folder,manifest})=>({role,folder,manifest})),copies,proposals,productionWrites:0,installedBehaviorExecuted:false,oldReceiptsRebound:false,fullParity:false,universalSuperiority:false};await fs.writeFile(path.join(own,'preflight.json'),JSON.stringify(preflight,null,2)+'\n',{flag:'wx'});
if(!process.argv.includes('--install')){console.log(JSON.stringify({preflight:own,proposals:30,copies:copies.length,productionWrites:0}));process.exit(0);}
const approval=process.argv.find(s=>s.startsWith('--review='))?.slice(9);assert(approval,'Exact independent plan review receipt required');const approvalPath=path.resolve(approval);assert.equal(approvalPath,path.join(work,'vault-group-publication-plan-independent-review/review-validation.json'));const reviewRoot=path.dirname(approvalPath),reviewManifest=await read(reviewRoot,'review-manifest.json');assert.equal(sha(reviewManifest),'76acdbe2099ff04afff90e7ed19f2d94ef2328ccdacc13c6ea14e8e4b376cca5');const rm=JSON.parse(reviewManifest);assert.equal(rm.inventory.length,111);for(const r of rm.inventory)await read(reviewRoot,r.path,r);const reviewBytes=await fs.readFile(approvalPath);assert.equal(sha(reviewBytes),'fee821912f84eddc074aa0c444c5e40fe4015b59890982cb93058838e152d158');const review=JSON.parse(reviewBytes);assert.equal(review.schema,'rea-editor-vault-installation-plans-independent-source-review/v1');assert.equal(review.editorPlanAccepted,true);assert.equal(review.vaultPlanAccepted,true);assert.equal(review.productionWrites,0);for(const p of plans){const r=review.finalAuthorities.find(r=>r.name===p.folder);assert(r);assert.equal(r.manifest.sha256,p.manifest.sha256);}await fs.writeFile(path.join(own,'independent-plan-review.json.snapshot'),reviewBytes,{flag:'wx'});await fs.writeFile(path.join(own,'independent-plan-review-manifest.json.snapshot'),reviewManifest,{flag:'wx'});
for(const r of proposals.filter(r=>r.before)){const n='before-images/'+r.destination+'.snapshot';await fs.mkdir(path.dirname(path.join(own,n)),{recursive:true});await fs.writeFile(path.join(own,n),await read(lab,r.destination,r.before),{flag:'wx'});}
for(const r of copies){await fs.mkdir(path.dirname(path.join(lab,r.path)),{recursive:true});await fs.writeFile(path.join(lab,r.path),await read(base,r.source,r),{flag:'wx'});}
for(const r of proposals){await fs.mkdir(path.dirname(path.join(lab,r.destination)),{recursive:true});await fs.writeFile(path.join(lab,r.destination),await read(base,r.source,r.after),{flag:r.before?'w':'wx'});await read(lab,r.destination,r.after);}
for(const p of plans){await read(p.root,'manifest.json',p.manifest);for(const r of JSON.parse(await read(p.root,'manifest.json')).inventory)await read(p.root,r.path,r);}
const record={...preflight,schema:'rea-editor-vault-reviewed-production-installation/v1',at:new Date().toISOString(),installed:proposals,productionWrites:30,installedBehaviorExecuted:false,originalGUIExecutions:0,browserExecutions:0,exactSourcesBeforeAfter:true,independentReview:{path:path.relative(base,approvalPath).replaceAll('\\','/'),bytes:reviewBytes.length,sha256:sha(reviewBytes)}};await fs.writeFile(path.join(own,'installation.json'),JSON.stringify(record,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({installed:30,copies:copies.length,record:path.join(own,'installation.json'),behaviorExecuted:0}));
