    },
    {
      "id": "grafana.candidate.03b332be80b78bf02c6b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Request security allows you to limit requests from the Grafana server by targeting requests generated by users, such as data source metric queries and alert notifications.",
      "headingPath": [
        "Configure request security"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-request-security.md",
        "gitBlobSha": "8164799a6d83c1823b6bdd5552a673513b5442fa",
        "sha256": "d11d40f9b8172eb1ee49336d2c2c454f0abd002efa674a7f0d169531b468a7ef",
        "lineStart": 17,
        "lineEnd": 17,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-security/configure-request-security.md#L17-L17"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.fa79cb3604bdcaa533cc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This can be used to limit access to internal systems that the server Grafana runs on can access but that users of Grafana should not be able to access. This feature does not affect traffic from the Grafana users browser.",
      "headingPath": [
        "Configure request security"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-request-security.md",
        "gitBlobSha": "8164799a6d83c1823b6bdd5552a673513b5442fa",
        "sha256": "d11d40f9b8172eb1ee49336d2c2c454f0abd002efa674a7f0d169531b468a7ef",
        "lineStart": 19,
        "lineEnd": 19,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-security/configure-request-security.md#L19-L19"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.510afa6238946d9a871a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Available in [Grafana Enterprise](../../../introduction/grafana-enterprise/) and to users on select Grafana Cloud account plans. For pricing information, visit our [pricing page](https://grafana.com/pricing/) or contact our sales team.",
      "headingPath": [
        "Configure request security"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-request-security.md",
        "gitBlobSha": "8164799a6d83c1823b6bdd5552a673513b5442fa",
        "sha256": "d11d40f9b8172eb1ee49336d2c2c454f0abd002efa674a7f0d169531b468a7ef",
        "lineStart": 22,
        "lineEnd": 22,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-security/configure-request-security.md#L22-L22"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.a52ce10e52f7ef0873a4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Although request security works with backend plugins, you can create a backend plugin that bypasses this security.",
      "headingPath": [
        "Configure request security"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-request-security.md",
        "gitBlobSha": "8164799a6d83c1823b6bdd5552a673513b5442fa",
        "sha256": "d11d40f9b8172eb1ee49336d2c2c454f0abd002efa674a7f0d169531b468a7ef",
        "lineStart": 26,
        "lineEnd": 26,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-security/configure-request-security.md#L26-L26"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.269f6b50aaaa72791290",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can limit requests based on a hostname, an IP address, or both.",
      "headingPath": [
        "Configure request security",
        "IP and hostname blocking"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-request-security.md",
        "gitBlobSha": "8164799a6d83c1823b6bdd5552a673513b5442fa",
        "sha256": "d11d40f9b8172eb1ee49336d2c2c454f0abd002efa674a7f0d169531b468a7ef",
        "lineStart": 31,
        "lineEnd": 31,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-security/configure-request-security.md#L31-L31"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.5dc297fd45091b5d14f9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If there is at least one entry on the list, then any request to a hostname or IP address not on the list is denied.",
      "headingPath": [
        "Configure request security",
        "IP and hostname blocking",
        "Allow list"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-request-security.md",
        "gitBlobSha": "8164799a6d83c1823b6bdd5552a673513b5442fa",
        "sha256": "d11d40f9b8172eb1ee49336d2c2c454f0abd002efa674a7f0d169531b468a7ef",
        "lineStart": 39,
        "lineEnd": 39,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-security/configure-request-security.md#L39-L39"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.107c4426efb273b6ca7c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can set a list of cookies or headers that are to be dropped from outgoing requests.",
      "headingPath": [
        "Configure request security",
        "Drop headers and cookies"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-request-security.md",
