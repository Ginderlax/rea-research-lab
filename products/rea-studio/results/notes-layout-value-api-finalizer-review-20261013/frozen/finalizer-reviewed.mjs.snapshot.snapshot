import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const base=path.resolve(import.meta.dirname,'..'),lab=path.join(base,'outputs/rea-research-lab'),studio=path.join(lab,'products/rea-studio'),run=path.resolve(process.argv[2]??'MISSING'),sha=b=>createHash('sha256').update(b).digest('hex'),read=p=>JSON.parse(fs.readFileSync(p));const a=read(path.join(run,'attempt-validation.json')),dev=read(path.join(studio,'results/development-validation.json'));assert.equal(a.schema,'rea-notes-layout-value-api-suite-attempt/v1');assert.equal(a.exitCode,0);assert.equal(a.failure,null);assert.equal(a.sourceStable,true);assert.equal(a.summary.tests,a.summary.pass);assert.equal(a.summary.fail+a.summary.cancelled+a.summary.skipped+a.summary.todo,0);assert.deepEqual(a.summary,dev.summary);assert.equal(dev.source_files.length,a.sourceFiles);assert.equal(a.sourceFiles,720);assert.ok(a.summary.tests>811);const before=read(path.join(run,'source-before.json')),after=read(path.join(run,'source-after.json'));assert.deepEqual(before,after);assert.equal(before.length,720);const prefix='results/notes-layout-value-api-combined-20261013',folder=path.join(studio,prefix);assert.equal(fs.existsSync(folder),false);const snapshots=[];function save(n,b,sourcePath=n){const p=path.join(folder,n);fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,b,{flag:'wx'});snapshots.push({sourcePath,path:n,bytes:b.length,sha256:sha(b)});}for(const r of before){const b=fs.readFileSync(path.join(studio,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);const n='source/'+r.path+'.snapshot',old=fs.readFileSync(path.join(run,n));assert.ok(old.equals(b));save(n+'.snapshot',old,n);}for(const n of ['runner.mjs.snapshot','source-before.json','source-after.json','stdout.txt','stderr.txt','attempt-validation.json'])save(n+'.snapshot',fs.readFileSync(path.join(run,n)));save('finalization-collector.mjs.snapshot',fs.readFileSync(import.meta.filename));const db=fs.readFileSync(path.join(studio,'results/development-validation.json')),m={schema:'rea-notes-layout-value-api-suite-preservation/v1',at:new Date().toISOString(),snapshots,summary:a.summary,sourceFiles:720,sourceStable:true,sourceCapturedBeforeExecution:true,sourceSnapshotsInert:true,developmentValidationSHA256:sha(db),priorPublishedCommit:'3baecf4e69fa731afbbb69efc1d4c8c88fdb0ec7',historicalReceiptsRebound:false,fullProductParity:false,universalSuperiority:false},mb=Buffer.from(JSON.stringify(m,null,2)+'\n');fs.writeFileSync(path.join(folder,'preservation-manifest.json'),mb,{flag:'wx'});
const status=read(path.join(studio,'STATUS.json'));status.phase='notebook-inline-confirmation-drawing-layout-editor-value-api';status.current_milestone_record='NOTES-LAYOUT-VALUE-API-MILESTONE.md';status.implemented_milestone=`Accessible notebook confirmation with Cancel/late-response handling; drawing align/distribute with group geometry and exact fractional helper compatibility; developer Position/Range/Selection value API. ${a.summary.pass} implemented-contract checks pass with0skips and720unchanged source files.`;status.next_required_milestone='Continue every documented original-product feature: release-bound atomic inventory; regex/whole-word/multiline search and replace, editing/encoding/extension-host lifecycle; calculation/dashboard; workflow/plugin/provider behavior; drawing bindings/fonts/images/rotation; sync/native protocol/format/group recovery/history settings. Perform comparative speed/resource/usability/reliability acceptance with retained regressions.';status.source_stable_combined_checks={pass:a.summary.pass,skipped:0,source_fingerprints:720,record:prefix+'/preservation-manifest.json'};status.prior_published_checkpoint={commit:m.priorPublishedCommit,checks:811,sourceFingerprints:709,record:'results/milestones/search-trash-recycle-save-3baecf4e-20261013/snapshot-manifest.json',historicalReceiptsRebound:false};status.current_focus_checks.notes_notebook_trash_integration=69;status.current_focus_checks.sketch_application_groups=39;status.current_focus_checks.sketch_shared_route_HTTP_groups=2;status.current_focus_checks.editor_value_api_pure_groups=13;status.current_focus_checks.sketch_literal_layout_pairs=3968;status.current_browser_record='apps/notes/results/inline-confirmation-followup/corrected-browser/validation.json.snapshot';status.current_browser_acceptance={notes_in_page_trash_restore_finite_groups:8,notes_native_confirmation_historical_attempt:false,notes_upload_file_delivery:false,notes_downloaded_fixture_bytes:true,sketch_layout_finite_group