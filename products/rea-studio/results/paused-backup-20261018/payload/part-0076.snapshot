    {
      "id": "grafana.candidate.56d881876611ab53e604",
      "syntaxRole": "table-row",
      "sourceText": "| Min time interval | Defines a lower limit for the auto group by time interval. Grafana recommends aligning this setting with the data write frequency. For example, set it to `1m` if your data is written every minute. Refer to [Min time interval](#min-time-interval) for format examples.                                                                                                                                                                                                                                    |",
      "headingPath": [
        "Configure the PostgreSQL data source",
        "PostgreSQL configuration options",
        "TLS/SSL mode reference"
      ],
