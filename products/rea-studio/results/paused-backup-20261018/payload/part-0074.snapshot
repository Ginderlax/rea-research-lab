    {
      "id": "grafana.candidate.0a9b719840745333fba3",
      "syntaxRole": "list-item",
      "sourceText": "- The `teams.roles:read` action allows a user to see a list of roles associated with each team.",
      "headingPath": [
        "Role-based access control (RBAC) overview",
        "Available RBAC roles",
        "Custom roles"
      ],
      "source": {
        "path": "docs/sources/administration/roles-and-permissions/access-control/_index.md",
        "gitBlobSha": "74dd3ddc8f134bbb82118411a9c878c6245618fa",
        "sha256": "85a1d0f117bae2ef3e87f0861a8a0b5da4e80c5282d771b959d5c8a2a1d0bdd1",
        "lineStart": 210,
        "lineEnd": 210,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/roles-and-permissions/access-control/_index.md#L210-L210"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
