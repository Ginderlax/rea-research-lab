import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{spawn}from'node:child_process';
const here=import.meta.dirname,stage=path.resolve(here,'../editor-search-pattern-next'),run='runs/fresh-'+new Date().toISOString().replace(/[:.]/g,'-'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),json=v=>Buffer.from(JSON.stringify(v,null,2)+'\n');
async function save(p,b){await fs.mkdir(path.dirname(path.join(here,p)),{recursive:true});await fs.writeFile(path.join(here,p),b,{flag:'wx'});}async function tree(root,prefix=''){const a=[];for(const e of await fs.readdir(root,{withFileTypes:true})){assert(!e.isSymbolicLink());const p=prefix+e.name;if(e.isDirectory())a.push(...await tree(path.join(root,e.name),p+'/'));else{assert(e.isFile());a.push(p);}}return a;}
const manifestBytes=await fs.readFile(path.join(stage,'freeze-manifest.json'));assert.equal(id(manifestBytes).sha256,'7f975ae3f7a0827f5b9ade231bd121c5b4028f17d88758455fd680962ff0f878');const manifest=JSON.parse(manifestBytes);assert.equal(manifest.schema,'rea-editor-pattern-candidate-freeze/v1');assert(Array.isArray(manifest.inventory));assert.equal(manifest.inventory.length,573);
async function authenticate(){assert.deepEqual((await tree(stage)).sort(),[...manifest.inventory.map(r=>r.path),'freeze-manifest.json'].sort());const records=[];for(const r of manifest.inventory){const b=await fs.readFile(path.join(stage,r.path));assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256},r.path);records.push({path:r.path,...id(b)});}assert.equal(id(await fs.readFile(path.join(stage,'freeze-manifest.json'))).sha256,id(manifestBytes).sha256);return records;}
const before=await authenticate();await save(run+'/author-before.json',json(before));await save(run+'/author-manifest.json.snapshot',manifestBytes);const named=JSON.parse(await fs.readFile(path.join(stage,'candidate-final-sources.json'))).rows;assert.equal(named.length,39);await save(run+'/candidate39.json.snapshot',json(named));for(const r of named){const b=await fs.readFile(path.join(stage,r.path));assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});await save(run+'/candidate-source/'+r.path+'.snapshot',b);}
const ownNames=['fresh.test.mjs','ui-fixture.mjs','collect-fresh.mjs','fault-worker-startup.mjs','fault-worker-exit.mjs'],ownBefore=[];for(const p of ownNames){const b=await fs.readFile(path.join(here,p));ownBefore.push({path:p,...id(b)});await save(run+'/review-source/'+p+'.snapshot',b);}await save(run+'/review-before.json',json(ownBefore));
const session=await fs.readFile(path.join(stage,'candidate/products/rea-studio/apps/editor/search-pattern-session.mjs'));const faultRows=[];for(const [name,worker]of[['startup','fault-worker-startup.mjs'],['exit','fault-worker-exit.mjs']]){await save(run+'/faults/'+name+'/search-pattern-session.mjs',session);const b=await fs.readFile(path.join(here,worker));await save(run+'/faults/'+name+'/search-pattern-worker.mjs',b);faultRows.push({name,sessionSourceExact:id(session),workerOwnedFault:id(b),dependencyGraphChangedForInjection:true,realCandidateWorkerFailureClaim:false});}await save(run+'/fault-injection-binding.json',json(faultRows));
const node=id(await fs.readFile(process.execPath));assert.equal(node.sha256,'b3094d0b49f9ad602262a9921551737bb97637c05dd357a06ae98188d7290aa3');const env={...process.env,REA_PATTERN_REVIEW_OUTPUT:path.join(here,run),REA_PATTERN_REVIEW_FAULTS:path.join(here,run,'faults')};delete env.NODE_TEST_CONTEXT;delete env.NODE_OPTIONS;delete env.NODE_V8_COVERAGE;
const args=['--max-old-space-size=192','--test','--test-isolation=none','--test-concurrency=1','--test-reporter=tap','fresh.test.mjs'];let out=[],err=[],outBytes=0,errBytes=0,limit=null,spawnError=null;const started=new Date().toISOString(),child=spawn(process.execPath,args,{cwd:here,env,windowsHide:true,stdio:['ignore','pipe','pipe']});const stop=reason=>{limit??=reason;child.kill();},timer=setTimeout(()=>stop('child30s'),30000);
child.stdout.on('data',b=>{const remaining=1048576-outBytes;if(remaining>0)out.push(b.subarray(0,remaining));outBytes+=b.length;if(outBytes>1048576)stop('stdout1MiB');});child.stderr.on('data',b=>{const remaining=1048576-errBytes;if(remaining>0)err.push(b.subarray(0,remaining));errBytes+=b.length;if(errBytes>1048576)stop('stderr1MiB');});const exit=await new Promise(resolve=>{child.on('error',e=>spawnError=String(e));child.on('close',(code,signal)=>resolve({code,signal}));});clearTimeout(timer);const stdout=Buffer.concat(out),stderr=Buffer.concat(err);await save(run+'/stdout.txt',stdout);await save(run+'/stderr.txt',stderr);
const after=await authenticate();assert.deepEqual(after,before);await save(run+'/author-after.json',json(after));const ownAfter=[];for(const p of ownNames){const b=await fs.readFile(path.join(here,p));ownAfter.push({path:p,...id(b)});}assert.deepEqual(ownAfter,ownBefore);await save(run+'/review-after.json',json(ownAfter));const summary={};for(const k of['tests','pass','fail','skipped','cancelled'])summary[k]=Number(stdout.toString().match(new RegExp('^# '+k+' (\\d+)$','m'))?.[1]);const accepted=exit.code===0&&exit.signal===null&&limit===null&&spawnError===null&&summary.tests===16&&summary.pass===16&&summary.fail===0&&summary.skipped===0&&summary.cancelled===0;
await save(run+'/validation.json',json({schema:'rea-editor-pattern-independent-fresh-campaign/v1',started,finished:new Date().toISOString(),accepted,summary,authorFrozenPayloads:573,authorManifestSHA256:id(manifestBytes).sha256,sourceStable:true,candidateNamedSources:39,reviewSources:ownBefore,node,nodeVersion:process.version,args,child:{pid:child.pid,...exit,limit,spawnError},raw:{stdout:id(stdout),stderr:id(stderr),observedStdoutBytes:outBytes,observedStderrBytes:errBytes},groups:{realCandidateCore:10,exactSessionSourceControlledWorkerFaults:2,DOMModelOnly:4},workerFaultDependenciesExplicit:2,applicationOriginalCalls:0,originalGUI:0,browsers:0,hosts:0,benchmarkCommands:0,productionWrites:0,candidateWrites:0,bounds:{childDeadlineMs:30000,stdoutMax:1048576,stderrMax:1048576,oldSpaceMiB:192,hardRSS:false,descendantRaceFree:false},fullProductParity:false,securityEquivalence:false,superiority:false}));process.stdout.write(JSON.stringify({run,accepted,summary,sourceStable:true})+'\n');assert(accepted,'Fresh campaign failed; exact source/raw retained');
