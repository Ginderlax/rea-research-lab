    {
      "id": "grafana.candidate.e5b34842fc6ea26496e8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Define a allowlist of IP addresses or domains with ports, that can be used in data source URLs with the Grafana data source proxy.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[security]`",
        "`data_source_proxy_whitelist`"
