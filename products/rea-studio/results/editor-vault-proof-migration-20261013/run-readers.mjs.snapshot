import assert from 'node:assert/strict';
import {readFileSync,writeFileSync,mkdirSync} from 'node:fs';
import {resolve} from 'node:path';
import {createHash} from 'node:crypto';
import {spawnSync} from 'node:child_process';
const stage=import.meta.dirname,root=resolve(stage,'private-proof-layout-v3'),run=process.argv[2];assert(run&&/^[a-z0-9-]+$/.test(run),'Unique attempt label required');const out=resolve(stage,'runs',run);mkdirSync(out,{recursive:false});const records=JSON.parse(readFileSync(resolve(stage,'transition-records.json'))),sha=b=>createHash('sha256').update(b).digest('hex');
const census=()=>[...records.sources.map(r=>r.path),records.sharedHost.path,...records.verifiers.map(r=>r.path),...records.verifiers.map(r=>r.historicalPath),...records.routes.map(r=>r.historicalPath),...Object.values(records.metadata).map(r=>r.historicalPath)].map(path=>{const b=readFileSync(resolve(root,path));return{path,bytes:b.length,sha256:sha(b)};});const before=census();writeFileSync(resolve(out,'source-before.json'),JSON.stringify(before,null,2)+'\n');
const selections=[['api',"import {verifyEditorValueApiFollowups} from './scripts/verify-editor-value-api-followups.mjs'; console.log(JSON.stringify(verifyEditorValueApiFollowups(process.cwd())));"],['notes-inline',"import {verifyNotesInlineFollowups} from './scripts/verify-notes-inline-followups.mjs';const r=verifyNotesInlineFollowups(process.cwd());console.log(JSON.stringify({...r,resolveHistorical:undefined}));"],['notes-vault',"import {verifyNotesVaultFollowups} from './scripts/verify-notes-vault-followups.mjs';console.log(JSON.stringify(verifyNotesVaultFollowups(process.cwd())));"],['checkpoint847',"import {verifyNotesLayoutValueApiCheckpoint} from './scripts/verify-notes-layout-value-api-checkpoint.mjs';console.log(JSON.stringify(verifyNotesLayoutValueApiCheckpoint(process.cwd())));"],['followup',"import {verifyFollowupRecords} from './scripts/verify-followup-records.mjs';console.log(JSON.stringify(verifyFollowupRecords(process.cwd())));"]];const attempts=[];
for(const [label,body]of selections){const start=new Date().toISOString(),r=spawnSync(process.execPath,['--max-old-space-size=256','--input-type=module','--eval',body],{cwd:root,encoding:'utf8',windowsHide:true,shell:false,timeout:120000,maxBuffer:4*1024*1024});const stdout=r.stdout??'',stderr=r.stderr??'';writeFileSync(resolve(out,label+'.stdout.txt'),stdout);writeFileSync(resolve(out,label+'.stderr.txt'),stderr);attempts.push({label,start,end:new Date().toISOString(),status:r.status,signal:r.signal,error:r.error?{name:r.error.name,code:r.error.code,message:r.error.message}:null,stdout:{bytes:Buffer.byteLength(stdout),sha256:sha(stdout)},stderr:{bytes:Buffer.byteLength(stderr),sha256:sha(stderr)}});}
const after=census();writeFileSync(resolve(out,'source-after.json'),JSON.stringify(after,null,2)+'\n');assert.deepEqual(after,before);writeFileSync(resolve(out,'receipt.json'),JSON.stringify({schema:'rea-editor-vault-private-filesystem-proof-readers/v1',at:new Date().toISOString(),sourceOnly:true,attempts,sourceBeforeAfterStable:true,mandatoryCensus:before.length,newApplicationExecutions:0,newOriginalExecutions:0,newBrowserExecutions:0,rootGlobalVerifierExecuted:false,prospectiveCurrentDevelopmentStillPending:true},null,2)+'\n');console.log(JSON.stringify({sourceOnly:true,attempts:attempts.map(r=>({label:r.label,status:r.status})),sourceStable:true}));if(attempts.some(r=>r.status!==0))process.exitCode=1;

