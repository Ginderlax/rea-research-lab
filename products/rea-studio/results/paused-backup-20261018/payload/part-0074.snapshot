        "lineStart": 36,
        "lineEnd": 36,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/configure-notifications/manage-contact-points/integrations/configure-alertmanager.md#L36-L36"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.ec079f548b620911ae7f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To send all Grafana-managed alerts to an Alertmanager, add it as a data source and enable it to receive all alerts. With this setup, you can configure multiple Alertmanagers to receive all alerts.",
      "headingPath": [
        "Configure an Alertmanager contact point"
      ],
      "source": {
        "path": "docs/sources/alerting/configure-notifications/manage-contact-points/integrations/configure-alertmanager.md",
