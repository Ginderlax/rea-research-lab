      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b68dfc56476c840eea14",
      "syntaxRole": "list-item",
      "sourceText": "- Increase the ephemeral port range by tuning `ip_local_port_range` kernel option.",
      "headingPath": [
        "Set up Grafana Live",
