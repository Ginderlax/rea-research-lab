      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.f7a16597050bffd2049d",
      "syntaxRole": "table-row",
      "sourceText": "| Macro example                             | Description                                                                                                                                                                                                   |",
      "headingPath": [
