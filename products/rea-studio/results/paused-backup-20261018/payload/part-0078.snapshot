    {
      "id": "grafana.candidate.f7a9ee99c601180676d3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Open the alert rule you want to adjust and search for the data source that is being used for the query/alert condition. From there, select the new data source from the drop-down list and save the alert rule.",
      "headingPath": [
        "Upgrade to Grafana v11.2",
