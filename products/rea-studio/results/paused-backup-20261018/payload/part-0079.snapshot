    {
      "id": "grafana.candidate.08db50212d66fe633337",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For more on how to use this transformation, refer to [Rows to fields transform](../../panels-visualizations/query-transform-data/transform-data/#rows-to-fields).",
      "headingPath": [
        "What's new in Grafana v8.1",
        "Annotation panel",
