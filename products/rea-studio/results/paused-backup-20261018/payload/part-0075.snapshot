    {
      "id": "grafana.candidate.ad981e2262ce2c1546fb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The new recording metric can then be used in alert rules and dashboards to optimize their queries. For further details, refer to [Create recording rules](ref:create-recording-rules).",
