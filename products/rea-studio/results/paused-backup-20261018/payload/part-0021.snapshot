    d=Path(v['readableEvidence']);files={r['path']:r for r in v['files']};assert len(files)==count==a['readableFiles']
    with zipfile.ZipFile(io.BytesIO(outer))as oz:
        assert len(oz.infolist())==1;inner=oz.read(oz.namelist()[0])
    data={}
    with zipfile.ZipFile(io.BytesIO(inner))as iz:
        infos=[x for x in iz.infolist()if not x.is_dir()];assert len(infos)==count
        assert {x.filename for x in infos}==set(files)
        for info in infos:
            raw=iz.read(info);row=files[info.filename];assert raw==read(d/info.filename);pin(raw,row);assert f'{zlib.crc32(raw)&0xffffffff:08x}'==row['zipCRC32'];data[info.filename]=raw
    all_data[role]=data
    at=json.loads(data['new-todo-'+role+'-attempt.json'])
    assert at==v['attempt'] and at['status']=='passed' and at['sourceCommit']==HEAD and at['execution']['GITHUB_RUN_ID']==RUN and at['execution']['GITHUB_RUN_ATTEMPT']=='1'
    assert at['sourceOverlay'] and not at['productionInstalled'] and not at['historicalReceiptsRebound'] and at['sourceStable']
    assert at['exactTargets']==7 and at['eligibleTargets']==6 and at['composedNotesFiles']==36
    assert at['applicationSourcesChanged'] is False # means unchanged DURING execution; seven overlays already disclosed.
    assert at['sourceFiles']==393
    census=json.loads(data['composition-source-after.json']);before=json.loads(data['composition-source-before.json'])
    assert len(census)==393 and len(before)==389 and len({r['path']for r in census})==393
    prefix_roots=('apps/','lib/','public/','browser-tests/','scripts/','tests/')
    git_active={p[len(P):]for p in tree if p.startswith(P) and (p[len(P):].startswith(prefix_roots) or p[len(P):]in('server.mjs','catalog.mjs','package.json')) and not set(p[len(P):].split('/'))&{'node_modules','.local','results'} and re.search(r'\.(mjs|json|html|css|ps1)$',p)}
    assert {r['path']for r in before}==git_active
    assert {r['path']for r in census}==git_active|{p[len(P):]for p,r in eligible.items()if r['before']is None}
    for row in census:
        name=P+row['path'];raw=data['active-source/'+row['path']+'.snapshot'];pin(raw,row)
        if name in eligible:pin(raw,eligible[name]['after'])
        else:assert hashlib.sha1(b'blob '+str(len(raw)).encode()+b'\0'+raw).hexdigest()==tree[name]
    composition=json.loads(data['notes-new-todo-composition.json'])
    assert composition['baselineSources']==bundle['baselineNotesSources'] and composition['composedSources']==bundle['composedNotesSources']
    assert composition['proofReadFiles']==60 and composition['proofFileLimit']==64 and composition['proofByteLimit']==8388608
    assert len(composition['currentSourceInputs'])==60
    for row in composition['currentSourceInputs']:pin(data['composition-source/'+row['path']+'.snapshot'],row)
    assert len([n for n in data if n.startswith('composition-baseline-source/')])==56
    assert len([n for n in data if n.startswith('composition-source/')])==60
    assert len([n for n in data if n.startswith('tooling-source/')])==12
    assert len(at['tooling']['paths'])==12
    for row in at['tooling']['paths']:
        raw=data['tooling-source/'+row['path']+'.snapshot'];pin(raw,row);assert hashlib.sha1(b'blob '+str(len(raw)).encode()+b'\0'+raw).hexdigest()==tree[row['path']]
    post=json.loads(data['notes-new-todo-postrun-source-check.json'])
    assert post['status']=='source-verified' and post['sourceStable'] and post['sourceCommit']==HEAD and post['compositionReceipt']==ident(data['notes-new-todo-composition.json'])
    assert post['currentSources']==bundle['composedNotesSources'] and post['sourceAuthentication']=={'activeSixDirectorySources':393,'eligibleNotesSources':34,'exactOverlayAfterimages':6,'allOtherGitBlobs':387,'separatelyPinnedReadme':1,'sourceOverlay':True}
    if role=='browser':
        bp=json.loads(data['new-todo-browser-postrun-source-check.json']);assert bp['status']=='source-verified' and bp['sourceStable'] and bp['priorStatus']=='passed' and bp['sourceAuthentication']==post['sourceAuthentication']
    backups.append({'role':role,'artifactId':aid,'bytes':size,'sha256':digest,'readableMembers':count,'sourceAliasMembers':521,'nonsourceMembers':count-521,'sourceAuthentication':post['sourceAuthentication']})
