import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {here,sha,authenticateOriginal} from './authenticate-original.mjs';
const receiptName='readiness-validation.json',manifestName='freeze-manifest.json',read=async name=>JSON.parse(await fs.readFile(path.join(here,name)));
async function inventory(directory=here){const rows={};for(const item of await fs.readdir(directory,{withFileTypes:true})){const absolute=path.join(directory,item.name),relative=path.relative(here,absolute).replaceAll('\\','/');if([receiptName,manifestName].includes(relative))continue;assert.ok(!item.isSymbolicLink());if(item.isDirectory())Object.assign(rows,await inventory(absolute));else{const bytes=await fs.readFile(absolute);rows[relative]={bytes:bytes.length,sha256:sha(bytes)};}}return rows;}
if(process.argv.includes('--verify-only')){const receipt=await read(receiptName),frozen=await read(manifestName);assert.equal(sha(await fs.readFile(path.join(here,receiptName))),frozen.receiptSHA256);for(const[name,row]of Object.entries(receipt.inventory)){const bytes=await fs.readFile(path.join(here,name));assert.equal(bytes.length,row.bytes,name);assert.equal(sha(bytes),row.sha256,name);}console.log(JSON.stringify({status:'passed',files:Object.keys(receipt.inventory).length,receiptSHA256:frozen.receiptSHA256,manifestSHA256:sha(await fs.readFile(path.join(here,manifestName))),readOnly:true}));process.exit(0);}
const preservation=await read('preservation.json'),manifestBytes=await fs.readFile(path.join(here,'memory-preflight.control.json')),manifest=JSON.parse(manifestBytes),authority=await authenticateOriginal();assert.deepEqual(authority,manifest.authority);assert.equal(sha(await fs.readFile(preservation.productionPath)),preservation.productionSHA256);
const sourceAudit=await read('results/source-binding-audit.json'),harness=await read('results/harness-readiness.json'),memory=await read('results/memory-harness-checks.control.json'),timing=await read('results/timing-readiness.json');assert.equal(sourceAudit.status,'passed');assert.equal(harness.status,'passed');assert.equal(memory.status,'passed');assert.equal(timing.status,'passed');
for(const proof of [harness,memory,timing])for(const[source,hash]of Object.entries(proof.sourceHashesBefore??{})){assert.equal(sha(await fs.readFile(path.join(here,source))),hash);assert.equal(proof.sourceHashesAfter[source],hash);}assert.equal(memory.measurementRun,false);assert.equal(memory.samples.length,3);assert.equal(memory.manifestSHA256,sha(manifestBytes));for(const sample of memory.samples){assert.equal(sample.result.comparisons,21);assert.equal(sample.result.measurementRun,false);assert.equal(sample.result.loadedReducerImplementations,1);assert.deepEqual(sample.result.selectedSources,manifest.implementations[sample.implementation].files);assert.equal(sample.result.checkpoints,undefined);if(sample.implementation==='candidate')assert.equal(sample.result.loadedNativeModuleFiles,2);if(sample.implementation==='original')assert.equal(sample.result.loadedCJSModules.length,6);}
assert.equal(timing.timingMeasurementRun,false);assert.equal(timing.result.comparisons,63);assert.equal(timing.result.loadedReducerImplementations,3);assert.equal(timing.manifestSHA256,sha(manifestBytes));
const attempts=(await fs.readdir(path.join(here,'results'))).filter(name=>/^readiness-attempt-\d+\.json$/.test(name)),attemptRecords=[];for(const name of attempts){const bytes=await fs.readFile(path.join(here,'results',name)),record=JSON.parse(bytes);assert.equal(record.status,'passed');assert.deepEqual(record.sourceHashesBefore,record.sourceHashesAfter);for(const step of record.steps){assert.equal(step.exitCode,0);for(const side of ['stdout','stderr'])assert.equal(sha(await fs.readFile(path.join(here,step[side].path))),step[side].sha256);}attemptRecords.push({path:'results/'+name,bytes:bytes.length,sha256:sha(bytes),steps:record.steps});}assert.equal(attemptRecords.length,1);
const original=await read('original-provenance.json'),archiveIdentities=original.archives;for(const row of archiveIdentities)assert.equal(sha(await fs.readFile(row.source)),row.sha256);for(const row of original.originalCopies)assert.equal(sha(await fs.readFile(path.join(here,row.path))),row.sha256);
const failure=await read('failures/archive-parent-path/failure.json');assert.equal(failure.exitCode,1);assert.equal(sha(await fs.readFile(path.join(here,'failures/archive-parent-path/prepare-manifest.mjs'))),failure.sourceSHA256);assert.equal(sha(await fs.readFile(path.join(here,'failures/archive-parent-path/stderr.tool-console-copy.txt'))),failure.stderrCopySHA256);
const rows=await inventory();assert.equal(Object.keys(rows).some(name=>/^results\/(paired-control-|timing-attempt-|memory-observations-|memory-control-)/.test(name)),false,'Unexpected measurement artifact');
const receipt={schemaVersion:1,checkedAt:new Date().toISOString(),status:'passed',scope:'Frozen prospective measurement readiness for exact 88-file native algorithm candidate; correctness preflight only, no measured workloads.',candidate:{entrySHA256:manifest.implementations.candidate.files[manifest.implementations.candidate.entry],helperSHA256:manifest.implementations.candidate.files[path.join(here,'selector-algorithm.mjs')],baselineSHA256:preservation.productionSHA256},authority,runtime:manifest.runtime,originalArchiveIdentities:archiveIdentities,manifestSHA256:sha(manifestBytes),algorithmStageReceiptSHA256:preservation.candidateReceiptSHA256,algorithmStageManifestSHA256:preservation.candidateManifestSHA256,rootIndependentReviewSHA256:sha(await fs.readFile(path.join(here,'preserved/root-independent-review.json'))),sourceAuditSHA256:sha(await fs.readFile(path.join(here,'results/source-binding-audit.json'))),attemptRecords,checks:{harnessGroups:4,summaryGroups:5,invalidTimestampCases:15,memoryCheckOnlyChildren:3,memoryFreshAndCachePacketChecks:63,timingFreshAndCachePacketChecks:63,freshOriginalCalculations:14,originalCachedReads:28,all88CandidateArtifactsAuthenticatedBeforeAndAfter:true,exactPreviousWorkloads:7,exactInputAndExpectedPacketFixtures:14,newCorrectnessProvenanceInputs:66},correctnessProvenanceOnly:manifest.correctnessProvenanceOnly,preservedFailures:{attempts:1,path:'failures/archive-parent-path/failure.json',automaticRawChildCaptureOfFirstFailure:false,origin:failure.rawOrigin},processControls:{timingChildSeconds:60,timingChildCaptureBytes:2*1024*1024,timingOuterSeconds:600,timingOuterCaptureBytes:4*1024*1024,memoryChildSeconds:manifest.limits.childWallSeconds,memoryChildOldSpaceMiB:manifest.limits.childOldSpaceMiB,memoryChildRSSMiB:manifest.limits.childRSSMiB,memoryCaptureBytes:manifest.limits.stdoutBytes,memoryOuterWatchdog:false,observerNominalMilliseconds:100,numericPIDOnlyNotStartTimeIdentity:true,serializerPressureAndSignedDeltaCensoringDisclosed:true},prospective:{workloads:7,roles:['original','baseline','candidate'],repetitions:7,timingChildren:147,isolatedMemoryChildren:147,separateQuietWindowsRequired:true,schedulingReservationMinutes:{timing:[5,8],memory:[10,15]},estimatesNotNewMeasurements:true},inventory:rows,aggregateBytes:Object.values(rows).reduce((sum,row)=>sum+row.bytes,0),publicationExcludedLocalOriginalArchives:archiveIdentities.map(row=>({...row,reason:'Original registry archive remains local; exact executed source snapshots/provenance are preserved, archive not copied into this stage.'})),nativeExecutableCopied:false,timingMeasurementRun:false,memoryMeasurementRun:false,profileRun:false,measurementBranchExecutionTested:false,machineLevelIsolationEstablished:false,productionChanged:false,selectedForIntegration:null,performanceEstablished:false,universalCorrectnessEstablished:false,fullProductComplete:false,universalSuperiorityEstablished:false};
const bytes=JSON.stringify(receipt,null,2)+'\n';await fs.writeFile(path.join(here,receiptName),bytes,{flag:'wx'});assert.deepEqual(await inventory(),rows);const frozenBytes=JSON.stringify({schemaVersion:1,frozenAt:new Date().toISOString(),receiptSHA256:sha(bytes),files:Object.keys(rows).length,aggregateBytes:receipt.aggregateBytes,inventory:rows,excludes:[receiptName,manifestName],timingMeasurementRun:false,memoryMeasurementRun:false},null,2)+'\n';await fs.writeFile(path.join(here,manifestName),frozenBytes,{flag:'wx'});console.log(JSON.stringify({status:'frozen',receiptSHA256:sha(bytes),manifestSHA256:sha(frozenBytes),inventoryFiles:Object.keys(rows).length,bytes:receipt.aggregateBytes,manifestSHA:sha(manifestBytes),checks:receipt.checks,measurementRun:false}));
