    {
      "id": "grafana.candidate.68e03b92c932a43ff3af",
      "syntaxRole": "list-item",
      "sourceText": "- /docs/grafana/next/release-notes/release-notes-9-0-0",
      "headingPath": [
        "What's new in Grafana v9.0",
        "Breaking changes",
        "Plugins: Most relevant breaking changes"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-0.md",
        "gitBlobSha": "3391f04dcb99b5fd7f3dc4839fe6fdf0d4bf3bae",
        "sha256": "39f11e18287d80cebb61272008eb6acbd2b991b12fd2ca34601c0b2454aa3aa1",
        "lineStart": 242,
        "lineEnd": 242,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v9-0.md#L242-L242"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
