assert a['runId']=='38930449222' and a['headSHA']=='89e00f66c2249a50c701404accede7565094304e'
assert a['jobs']=={'finite':117072777339,'browser':117072777079}
replacements=[('38930449222','38926216091'),('89e00f66c2249a50c701404accede7565094304e','b635c33d971768682360e2c518b9b2bb0840985b'),('117072777339','117058306058'),('117072777079','117058306640')]
diffs={}
