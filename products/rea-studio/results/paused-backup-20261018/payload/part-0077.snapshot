    {
      "id": "grafana.candidate.7dd1ffae6afc9f1c9662",
      "syntaxRole": "table-row",
      "sourceText": "| `allow_sign_up`                 | No       | Yes                | Controls Grafana user creation through the Entra ID login. Only existing Grafana users can log in with Entra ID if set to `false`.                                                                                                                                                                                                                                                                                                                                                              | `true`                                               |",
      "headingPath": [
        "Configure Microsoft Entra ID OAuth authentication",
        "Configuration options"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/entraid/index.md",
