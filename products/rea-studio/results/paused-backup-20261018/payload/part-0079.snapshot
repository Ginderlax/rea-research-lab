    {
      "id": "grafana.candidate.e0c3a6a1a025f77b286f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now query multiple data sources simultaneously in Explore. Select \"Mixed\" from the data source picker and specify a data source for each query.",
      "headingPath": [
        "What’s new in Grafana v10.0",
        "Dashboards and visualizations",
        "Query multiple data sources in Explore"
