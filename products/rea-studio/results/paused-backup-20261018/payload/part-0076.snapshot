    },
    {
      "id": "grafana.candidate.e4ae3ee601edd9d48d10",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use the **Preserve query** toggle to keep your Lucene query when you switch between **Metrics**, **Logs**, **Raw Data**, and **Raw Document**. When the toggle is off (the default for new queries), switching query types clears the Lucene query. Grafana remembers your last Preserve query choice in the browser for new queries.",
      "headingPath": [
        "Elasticsearch query editor",
        "Select a query type"
      ],
      "source": {
        "path": "docs/sources/datasources/elasticsearch/query-editor/index.md",
