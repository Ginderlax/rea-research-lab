    {
      "id": "grafana.candidate.e5f65518e24d512f5aef",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "After you've configured your Grafana permissions, set up the appropriate permissions at your Git provider to write changes. Repository protection settings control write access, branch protection rules, and code review requirements.",
      "headingPath": [
        "Git Sync permissions and access control",
        "Configure Git repository protection"
      ],
