    },
    {
      "id": "grafana.candidate.bd616e880cc2232897ad",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you run Grafana in high availability mode, configuration changes may not get applied to all Grafana instances immediately. You may need to wait a few minutes for the configuration to propagate to all Grafana instances.",
      "headingPath": [
