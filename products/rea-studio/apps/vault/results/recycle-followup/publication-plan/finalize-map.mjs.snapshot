import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import{fileURLToPath}from'node:url';import{createHash}from'node:crypto';
const here=fileURLToPath(new URL('./',import.meta.url)),workspace=fileURLToPath(new URL('../../',import.meta.url)),repo=path.join(workspace,'outputs/rea-research-lab'),app='products/rea-studio/apps/vault/',hash=b=>createHash('sha256').update(b).digest('hex');
const read=async p=>JSON.parse(await fs.readFile(p,'utf8')),ident=async p=>{const b=await fs.readFile(p);return{bytes:b.length,sha256:hash(b)}},write=async(n,x)=>fs.writeFile(path.join(here,n),JSON.stringify(x,null,2)+'\n',{flag:'wx'});
const map=await read(path.join(here,'selected-file-map.json')),auth=await read(path.join(here,'authentication.json'));
assert.deepEqual(auth.productionBefore,auth.productionAfter);assert(auth.allFourStrictInventoriesExact);
const requirementsDir=path.join(repo,'products/rea-studio/requirements'),bindingPath=path.join(requirementsDir,'keepass-manual-supplement/existing-requirements-binding.json'),oldBinding=await read(bindingPath),registries=[],sources=[],capabilities=[];
for(const name of['workspace-products.json','visual-products.json','system-products.json']){const filename=path.join(requirementsDir,name),x=await read(filename);registries.push({path:'products/rea-studio/requirements/'+name,...await ident(filename)});sources.push(...x.sources.map(r=>({registry:name,id:r.id,sha256:r.sha256})));const rows=x.capabilities??(x.baselineProducts??x.products).flatMap(p=>p.requirements??p.capabilities);capabilities.push(...rows.map(r=>({registry:name,id:r.id})));}
const sort=rows=>[...rows].sort((a,b)=>(a.registry+'/'+a.id).localeCompare(b.registry+'/'+b.id));assert.equal(sources.length,159);assert.equal(capabilities.length,232);assert.deepEqual(sort(sources),sort(oldBinding.originalSources));assert.deepEqual(sort(capabilities),sort(oldBinding.capabilityIds));
await write('requirements-binding.json',{schema:'rea-vault-recycle-prospective-requirements-binding/v1',at:new Date().toISOString(),registries,priorSupplementBinding:{path:'products/rea-studio/requirements/keepass-manual-supplement/existing-requirements-binding.json',...await ident(bindingPath)},originalSources:sources,capabilityIds:capabilities,counts:{sources:159,capabilities:232},exactOriginalIdentityProjection:true,registriesModified:false});
const historyManifestName=app+'results/history-followup/preservation-manifest.json',historyManifest=await read(path.join(repo,historyManifestName)),existingBySha=new Map();
for(const r of historyManifest.files??[]){if(r.kind==='public-inert-snapshot'&&!existingBySha.has(r.sha256))existingBySha.set(r.sha256,{path:r.preservedPath,bytes:r.bytes,sha256:r.sha256});}
const reused=new Map(),payload=[];
for(const row of map.payload){const prior=row.publication==='public-source'?existingBySha.get(row.sha256):null;let target= row.proposedPublicBlob?'products/rea-studio/'+row.proposedPublicBlob:null;if(prior){if(!reused.has(prior.sha256)){assert.deepEqual(await ident(path.join(repo,prior.path)),{bytes:prior.bytes,sha256:prior.sha256});reused.set(prior.sha256,prior);}target=prior.path;}assert(target===null||!target.split('/').includes('.local'));payload.push({...row,publicPath:target,publicAction:row.publication==='local-only'?'local-digest-exclusion':prior?'reuse-exact-existing-public-snapshot':'add-exact-inert-blob'});}
await write('public-existing-reuse.json',{schema:'rea-existing-vault-history-exact-byte-reuse/v1',manifest:{path:historyManifestName,...await ident(path.join(repo,historyManifestName))},files:[...reused.values()],allSelectedExistingPublicBytesAuthenticated:true,unrelatedHistoryPayloadNotScanned:true});
const install=map.install.map(r=>({...r})),adapters=[];
for(const name of['recycle-harness.mjs','recycle-original.test.mjs','recycle-http.test.mjs']){const source='work/keepass-recycle-next/'+app+name,b=await fs.readFile(path.join(workspace,source));let text=b.toString();const transforms=[];const replace=(from,to)=>{assert(text.includes(from),name+' missing replacement');text=text.replaceAll(from,to);transforms.push({from,to});};
 if(name==='recycle-harness.mjs'){replace("const work=path.resolve(here,'../../../..');","const work=path.resolve(here,'../..');");replace("path.resolve(here,'../../../../../..','outputs/rea-research-lab/projects/07-keepass/artifacts/portable/KeePass.exe')","path.resolve(here,'../../../..','projects/07-keepass/artifacts/portable/KeePass.exe')");}
 else replace("path.resolve(import.meta.dirname,'../../../..','.local/","path.resolve(import.meta.dirname,'../..','.local/");
 const proposed='proposed-test-adapters/'+name;await fs.writeFile(path.join(here,proposed),text,{flag:'wx'});const row=install.find(r=>r.source===source);assert(row);delete row.bytes;delete row.sha256;row.action='add-adapter';row.sourceIdentity={bytes:b.length,sha256:hash(b)};row.transform=transforms;row.proposedBytesPath=proposed;row.proposedIdentity={bytes:Buffer.byteLength(text),sha256:hash(text)};adapters.push(row);
}
for(const r of install.filter(r=>r.action==='add'&&r.kind!=='runtime'))r.transform='Exact bytes; sibling native imports retain their names. No assertion or oracle behavior change.';
for(const name of['http-runner.mjs','history.mjs','xml.mjs']){const a=await ident(path.join(workspace,'work/keepass-recycle-next',app,name)),b=await ident(path.join(repo,app,name));assert.deepEqual(a,b);if(name==='http-runner.mjs')install.push({kind:'test-only-helper',destination:app+name,source:'work/keepass-recycle-next/'+app+name,...a,existing:b,action:'retain-exact',transform:'Existing shared-host child runner remains exact.'});}
const docs=[{source:'proposed-docs/RECYCLE.md',destination:app+'RECYCLE.md',action:'add'},{source:'proposed-docs/RECYCLE-NOTICE.md',destination:app+'RECYCLE-NOTICE.md',action:'add'},{source:'README-supplement.md',destination:app+'README.md',action:'review-apply-explicit-hunks',existing:await ident(path.join(repo,app+'README.md'))}];
const publicBlobs=new Set(payload.filter(r=>r.publicPath).map(r=>r.publicPath)),newBlobs=new Set(payload.filter(r=>r.publicAction==='add-exact-inert-blob').map(r=>r.publicPath));
await write('selected-file-map.final.json',{...map,schema:'rea-source-only-vault-publication-map/v2',at:new Date().toISOString(),supersedesOwnProposalOnly:{path:'selected-file-map.json',...await ident(path.join(here,'selected-file-map.json'))},payload,install,docs,uniquePublicBlobs:publicBlobs.size,newUniquePublicBlobs:newBlobs.size,reusedExistingUniquePublicBlobs:reused.size,requirementsBinding:'requirements-binding.json',noRecursiveEpochCopy:true,productionCopied:false});
const sourceFiles=[];async function walk(dir,rel=''){for(const e of await fs.readdir(dir,{withFileTypes:true})){assert(!e.isSymbolicLink());if(e.isDirectory()){if(e.name!=='results')await walk(path.join(dir,e.name),rel+e.name+'/');}else sourceFiles.push({path:app+rel+e.name,...await ident(path.join(dir,e.name))});}}await walk(path.join(repo,app));
const epochFiles=[app+'results/history-followup/production-integration/runs/2026-10-12T23-22-44.590Z/validation.json',app+'results/history-followup/preservation-manifest.json'];const currentHistory=[];for(const p of epochFiles)currentHistory.push({path:p,...await ident(path.join(repo,p))});
await write('production-reference-baseline.json',{schema:'rea-vault-recycle-plan-current-production-baseline/v1',at:new Date().toISOString(),sourceFiles:sourceFiles.sort((a,b)=>a.path.localeCompare(b.path)),selectedCurrentHistory:currentHistory,sourceResultsNotInventoried:true,productionModified:false});
const contracts=await read(path.join(workspace,'work/keepass-recycle-next/contract-evidence.json'));
await write('proposed-requirements-supplement.json',{schema:'rea-vault-recycle-finite-supplement-proposal/v1',proposalOnly:true,release:'KeePass2.61.1',original159SourceRowsAnd232CapabilityIdsPreserved:true,binding:'requirements-binding.json',completionGates:{fullProductParity:false,securityParity:false,universalSuperiority:false,inventoryComplete:false},updates:[{id:'KP.ENTRY.001',status:'implemented-local-subset',scope:'Bounded single-entry native recycle, masked bin preview, confirmed previous-existing-group recovery and confirmed native permanent tombstones. Native UUID/content/history/attachments/unknown XML remain represented; active editing/history/TOTP refuses bin entries. Group deletion/recovery, empty bin, multi-selection, arbitrary moves and bin configuration remain open.'},{id:'KP.FORMAT.001',status:'implemented-local-subset',scope:'Candidate export4.1 retains PreviousParentGroup. Actual released default-feature writer4.0 omits it after save/reopen; original comparison uses real QualityCheck=false for conditional4.1 lifecycle, with separate default4.0 loss fixture. No format-parity gate closes.'},{id:'KP.LOCK.001',status:'implemented-local-subset',scope:'Existing accepted lock/disposal protections retained; recycle refreshes recheck bin/view generation after awaited active-list refresh, suppressing stale bin reopening and private preview replacement. This is a finite Studio publication policy, not original GUI parity.'}],sourceContracts:contracts.contracts.map(c=>({id:c.id,source:c.source,sourceSha256:c.sourceSha256,lineStart:c.lineStart,lineEnd:c.lineEnd,evidenceStrength:c.evidenceStrength})),contractIdsAreSupplementOnlyNotNewGlobalCapabilityIds:true,epochs:[{name:'current-history',focusedGroups:41,originalAssemblyLoads:24,scope:'Frozen accepted history before recycle; preserve exact receipt and sources.'},{name:'initial-recycle-author',focusedGroups:68,originalAssemblyLoads:38,scope:'41 prior+27 new; original38=24 prior+14 new; final client superseded by exactly two guards.'},{name:'initial-recycle-independent',groups:11,passed:8,failed:3,originalAssemblyLoads:4,browserChecks:1,scope:'Six semantics plus five UI boundaries; three confirmed stale bin publications retained.'},{name:'client-two-guard-author',groups:38,passed:38,originalAssemblyLoads:0,browserChecks:0,scope:'Frontend-only campaign; same-generation failure diagnostic has invalid stale-token premise, retained as diagnosis rather than candidate defect.'},{name:'client-two-guard-independent',groups:7,passed:7,originalAssemblyLoads:0,browserChecks:1,scope:'Five unchanged bodies plus two unchecked-confirmation controls; normal private browser acceptance.'}],prospectiveCurrentSelection:{groups:79,formula:'retained41 + original new27 + unchanged boundary5 + independent confirmation2 + author controls4',executed:false,requiresRootActualSourceBoundRun:true},currentMilestoneFieldsMustNotRebindHistoricalEvidence:true});
