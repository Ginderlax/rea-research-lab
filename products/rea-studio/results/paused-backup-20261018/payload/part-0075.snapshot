    {
      "id": "grafana.candidate.4677d0937c23dccf760b",
      "syntaxRole": "list-item",
      "sourceText": "- `<API_VERSION>` is the version of the folders API. For example, `folder.grafana.app/v1`.",
      "headingPath": [
