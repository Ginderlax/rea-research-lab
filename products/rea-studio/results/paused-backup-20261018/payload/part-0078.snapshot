    {
      "id": "grafana.candidate.84585407452257d92a68",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Externally shared dashboards allow you to share your Grafana dashboard with anyone. This is useful when you want to make your dashboard available to the world without requiring access to your Grafana organization.",
      "headingPath": [
        "Externally shared dashboards"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/share-dashboards-panels/shared-dashboards.md",
