    {
      "id": "grafana.candidate.3f478145bf40ea07e96f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can navigate from a span in a trace view directly to metrics relevant for that span. This feature is available for the Tempo, Jaeger, and Zipkin data sources.",
      "headingPath": [
        "Traces in Explore",
        "Trace view",
        "Trace to metrics"
      ],
      "source": {
        "path": "docs/sources/visualizations/explore/trace-integration.md",
