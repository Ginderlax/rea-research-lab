import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';
const here=import.meta.dirname,lab=path.resolve(here,'../../outputs/rea-research-lab'),hash=b=>crypto.createHash('sha256').update(b).digest('hex');
const identity=(root,p)=>{const b=fs.readFileSync(path.join(root,p));return{path:p,bytes:b.length,sha256:hash(b)};};
const baseline=JSON.parse(fs.readFileSync(path.join(here,'baseline.json'))),before=JSON.parse(fs.readFileSync(path.join(here,'runs/baseline-2026-10-13T01-40-59.795Z/validation.json'))),after=JSON.parse(fs.readFileSync(path.join(here,'runs/corrected-2026-10-13T01-42-55.099Z/validation.json')));
if(before.summary.tests!==2||before.summary.pass!==1||before.summary.fail!==1||after.summary.tests!==2||after.summary.pass!==2||after.summary.fail!==0||!before.allProductionSourcesStable||!after.allProductionSourcesStable)throw Error('Expected exact targeted before/after receipts');
const raw=fs.readFileSync(path.join(here,'runs/corrected-2026-10-13T01-42-55.099Z/stdout.txt'),'utf8'),line=raw.split(/\r?\n/).find(l=>l.startsWith('# REA_VAULT_HTTP_RECYCLE_EXPORT '));if(!line)throw Error('Missing bounded direct observation marker');const observed=JSON.parse(line.slice('# REA_VAULT_HTTP_RECYCLE_EXPORT '.length));
const original=fs.readFileSync(path.join(here,'baseline/products/rea-studio/apps/vault/app.integration.test.mjs.snapshot'),'utf8'),proposal=fs.readFileSync(path.join(here,'proposed/app.integration.test.mjs'),'utf8');
const first="test('vault HTTP CRUD",second="test('KDBX HTTP import/export",last="  await call('delete',{ id: entry.id,confirm: true }); const empty = await call('exportKdbx',{ password: credentials.password,options }); assert.equal((await importKdbx(Buffer.from(empty.fileBase64,'base64'),credentials)).entries.length,0);";
const firstOld=original.slice(original.indexOf(first),original.indexOf(second)),firstNew=proposal.slice(proposal.indexOf(first),proposal.indexOf(second));
if(firstOld!==firstNew)throw Error('Existing CRUD test body changed');
const prefix=original.slice(original.indexOf(second),original.indexOf(last));if(!proposal.includes(prefix))throw Error('Existing pre-delete KDBX assertions changed');
const sourceAfter=baseline.sources.map(r=>identity(lab,r.path));if(JSON.stringify(sourceAfter)!==JSON.stringify(baseline.sources.map(({snapshotPath,...r})=>r)))throw Error('Production changed before freeze');
const map={schema:'rea-vault-http-recycle-integration-proposal-map/v1',destination:'products/rea-studio/apps/vault/app.integration.test.mjs',before:identity(lab,'products/rea-studio/apps/vault/app.integration.test.mjs'),proposal:identity(here,'proposed/app.integration.test.mjs'),runtimeChanged:false,firstTestBodyByteIdentical:true,preDeleteKDBXAssertionsByteIdentical:true,oldFinalLine:last,obsoletePremise:'Confirmed normal delete permanently removes total exported entries',replacementPremise:'Normal delete recycles and remains exported; confirmed per-entry permanent delete removes and records a tombstone',executionAdapter:'runs/corrected-2026-10-13T01-42-55.099Z/input-adapters.json'};
fs.writeFileSync(path.join(here,'integration-map.json'),JSON.stringify(map,null,2)+'\n');
const receipt={schema:'rea-vault-http-recycle-integration-correction-validation/v1',at:new Date().toISOString(),status:'OUTDATED_TEST_CONFIRMED_CORRECTION_PASS',productionModified:false,runtimeChanged:false,baselineRun:{path:'runs/baseline-2026-10-13T01-40-59.795Z/validation.json',summary:before.summary,originalInputSHA256:before.input.sha256,expectedFailureReproduced:true},correctedRun:{path:'runs/corrected-2026-10-13T01-42-55.099Z/validation.json',summary:after.summary,proposal:after.proposal,executedInput:after.input,sourceStable:after.allProductionSourcesStable},sourceFiles:baseline.sources.length,sourceBefore:before.sourceBefore,sourceAfter,allProductionSourcesStableBeforeAfterAndFreeze:true,observations:observed,integrationMap:identity(here,'integration-map.json'),targetedTestCaseExecutions:4,targetedTestPasses:3,targetedExpectedBaselineFailures:1,finalCorrectedTests:2,finalCorrectedPasses:2,finalCorrectedFailures:0,newOriginalProgramExecutions:0,newOriginalAssemblyLoads:0,newBrowserActions:0,ownedBaselineServerInstances:4,ownedCorrectedServerInstances:6,correctedHostInstanceRestarts:4,actualOSHostProcessRestarts:0,currentRuntimeDefectConfirmed:false,oldReceiptsRebound:false,parentFullSuiteReexecutionClaim:false,originalDefault40PreviousParentLossRebound:false,fixtureCandidateVersion:'KDBX4.1',fullProductParity:false,securityParity:false,universalSuperiority:false,ownedProcessesHostsBrowsersRunning:0};
fs.writeFileSync(path.join(here,'validation.json'),JSON.stringify(receipt,null,2)+'\n');
function files(rel=''){return fs.readdirSync(path.join(here,rel),{withFileTypes:true}).flatMap(d=>{const p=rel?rel+'/'+d.name:d.name;if(d.isDirectory())return files(p);if(!d.isFile())throw Error('Nonregular owned artifact');return[p];});}
const rows=files().filter(p=>!['manifest.json','freeze.json'].includes(p)).sort().map(p=>identity(here,p));
fs.writeFileSync(path.join(here,'manifest.json'),JSON.stringify({schema:'rea-vault-http-recycle-integration-correction-strict-manifest/v1',strict:true,excluded:['manifest.json','freeze.json'],records:rows},null,2)+'\n');
const frozen={schema:'rea-vault-http-recycle-integration-correction-freeze/v1',at:new Date().toISOString(),manifest:identity(here,'manifest.json'),receipt:identity(here,'validation.json'),proposal:map.proposal,artifacts:rows.length,allExecutableTestDocReceiptSourceFrozen:true,productionModified:false,ownedProcessesHostsBrowsersRunning:0};fs.writeFileSync(path.join(here,'freeze.json'),JSON.stringify(frozen,null,2)+'\n');
for(const r of rows){const a=identity(here,r.path);if(a.bytes!==r.bytes||a.sha256!==r.sha256)throw Error('Owned artifact changed during freeze');}console.log(JSON.stringify(frozen));
