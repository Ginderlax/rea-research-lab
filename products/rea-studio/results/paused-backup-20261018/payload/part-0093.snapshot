def recover_envelope(filename,receipt_key,schema,expected_sources,details,groups=False,physical=None):
 need(tables is not None and git is not None,'Pinned source tables and actual Git required')
 stored=data(filename);need(len(stored)<=4*1024*1024,'Fixed gzip stored boundary')
 with gzip.GzipFile(fileobj=io.BytesIO(stored)) as stream: decoded=stream.read(8*1024*1024+1)
 need(len(decoded)<=8*1024*1024,'Fixed gzip decoded boundary');envelope=parsed(decoded);declared=attempt[receipt_key]
 need(set(envelope)=={'schema','sourceCommit','sourceFiles','rawSourceBytes','rows'}|set(details),'Exact envelope fields')
 need(envelope['schema']==schema and envelope['sourceCommit']==git['sourceCommit'] and envelope['sourceFiles']==len(expected_sources)==len(envelope['rows']),'Exact envelope scope/count')
 need(declared['path']==filename and declared['sourceFiles']==len(expected_sources) and declared['separateReadBudget'] is True and declared['stored']==identity(stored) and declared['decoded']==identity(decoded),'Exact receipt-to-gzip binding')
 for key,value in details.items(): need(envelope[key]==value and declared[key]==value,'Exact envelope detail '+key)
 rows={};logical_folded=set();physical_folded=set();total=0;output=folder/(filename.split('.')[0]+'-readable');output.mkdir(exist_ok=False)
 for row in envelope['rows']:
  required={'path','bytes','sha256','base64'}|({'readPath','group','sourceEpoch','historicalView'} if groups else set());need(set(row)==required,'Exact source row fields')
  name=safe(row['path']);need(name in expected_sources and name.casefold() not in logical_folded,'Exact distinct logical source');logical_folded.add(name.casefold())
  expected_pin=expected_sources[name];expected_pin={'bytes':expected_pin[0],'sha256':expected_pin[1]} if isinstance(expected_pin,list) else expected_pin
  need(type(row['bytes']) is int and 0<=row['bytes']<=256*1024 and re.fullmatch(r'[0-9a-f]{64}',row['sha256']) and {k:row[k] for k in ('bytes','sha256')}==expected_pin,'Fixed source byte/SHA256 pin')
  need(isinstance(row['base64'],str) and len(row['base64'])<=4*((256*1024+2)//3),'Bounded base64')
  content=base64.b64decode(row['base64'],validate=True);need(base64.b64encode(content).decode()==row['base64'] and identity(content)==expected_pin,'Canonical base64 and exact decoded identity')
  read_path=name
  if groups:
   expected_row=physical[name];read_path=safe(row['readPath']);need(read_path==expected_row['readPath'] and row['sourceEpoch']==details['historicalSourceEpoch'] and row['historicalView'] is True,'Historical logical-to-physical mapping/epoch')
   need(row['group']==('historical52-proof' if name in tables['NOTES_REVIEWED'] else 'historical4-installed-tooling'),'Historical group is not current behavior')
  need(read_path.casefold() not in physical_folded,'Distinct physical source carrier');physical_folded.add(read_path.casefold());oid=git_content(read_path,content)
  total+=len(content);need(total<=8*1024*1024,'Bounded aggregate decoded sources')
  payload=output/(row['sha256']+'.snapshot')
  if not payload.exists():
   with payload.open('xb') as stream: stream.write(content)
  need(payload.read_bytes()==content,'Readable exact recovered source');recovered_cache[(filename,name)]=content
  rows[name]={'sourcePath':name,'readPath':read_path,'bytes':len(content),'sha256':sha(content),'actualGitBlob':oid,'readablePayload':str(payload),'historicalView':groups,'executed':False}
 need(set(rows)==set(expected_sources) and total==envelope['rawSourceBytes']==declared['rawSourceBytes'],'Complete exact envelope source set/aggregate')
 summary={'verified':True,'schema':schema,'sourceCommit':git['sourceCommit'],'sourceFiles':len(rows),'rawSourceBytes':total,'stored':identity(stored),'decoded':identity(decoded),'allCapturedPhysicalGitBlobsVerified':True,'historicalView':groups,'rows':list(rows.values()),'sourcePayloadsExecuted':False}
 (output/'source-manifest.json').write_text(json.dumps(summary,indent=2)+'\n',encoding='utf-8',newline='');return summary
