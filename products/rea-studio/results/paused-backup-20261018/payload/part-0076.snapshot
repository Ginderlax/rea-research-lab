    {
      "id": "grafana.candidate.eea44c3427557c513302",
      "syntaxRole": "table-row",
      "sourceText": "| **Macro**                                              | **Description**                                                                                                                                                                                                                            |",
      "headingPath": [
        "Microsoft SQL Server query editor",
        "Macros"
      ],
      "source": {
