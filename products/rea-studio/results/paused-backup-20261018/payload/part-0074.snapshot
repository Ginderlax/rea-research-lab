    {
      "id": "grafana.candidate.aa75d75d1d04b8cd917c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Pre-provisioned Loki and Prometheus data source-managed alerts have been deprecated in Grafana Cloud and can not be created in new stacks. New Grafana Cloud stacks will use Grafana-managed alerting (GMA) by default. Datasource-managed alerting (DMA) is not provisioned in new stacks. Existing stacks are not affected.",
      "headingPath": [],
      "source": {
        "path": "docs/sources/alerting/alerting-rules/create-grafana-managed-rule.md",
