import assert from 'node:assert/strict';import {readFileSync,writeFileSync,readdirSync,lstatSync} from 'node:fs';import {resolve} from 'node:path';import {createHash} from 'node:crypto';
const here=import.meta.dirname,work=resolve(here,'..'),repo=resolve(work,'../outputs/rea-research-lab'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),plan=JSON.parse(readFileSync(resolve(here,'installation-plan.json'))),adapters=JSON.parse(readFileSync(resolve(here,'test-path-adaptations.json'))),source=JSON.parse(readFileSync(resolve(here,'source-proof/preservation-manifest.json')));const current=JSON.parse(readFileSync(resolve(here,'current-before.json'))),scope=[];
for(const r of current.rows)assert.deepEqual(id(readFileSync(resolve(repo,r.path))),{bytes:r.bytes,sha256:r.sha256});assert.equal(plan.rows.length,16);const targets=new Set();for(const r of plan.rows){assert(r.target.startsWith('products/rea-studio/apps/vault/')&&!targets.has(r.target));targets.add(r.target);assert.deepEqual(id(readFileSync(resolve(here,r.source))),r.after);assert.equal(r.adapterExecuted,false);const before=current.rows.find(p=>p.path===r.target);assert.deepEqual(r.before,before?{bytes:before.bytes,sha256:before.sha256}:null);if(r.sourceAuthority){let text=readFileSync(resolve(here,r.source),'utf8');for(const c of adapters.changes.filter(c=>c.destination===r.target).slice().reverse()){assert.equal(text.split(c.after).length-1,1);text=text.replace(c.after,c.before);}assert.deepEqual(id(Buffer.from(text)),r.sourceAuthority.original);assert.deepEqual(Buffer.from(text),readFileSync(resolve(work,r.sourceAuthority.root.slice(5),r.sourceAuthority.path)));scope.push({path:r.target,assertionBodyPreserved:true,sourceInverseExact:true,executed:false});}}
for(const r of source.records){const b=readFileSync(r.reusedExistingPublic?resolve(repo,r.publicPath):resolve(here,'source-proof/payload',r.sha256+'.snapshot'));assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});assert(r.publicPath.startsWith('products/rea-studio/'));}assert.equal(source.records.length,1230);assert.equal(source.newUniquePublicPayloads,234);assert.equal(source.reusedAliases,832);assert.equal(source.excluded.length,59);
const payloadFiles=readdirSync(resolve(here,'source-proof/payload')).sort();assert.deepEqual(payloadFiles,source.newPayloads.map(r=>r.sha256+'.snapshot').sort());const lic=JSON.parse(readFileSync(resolve(here,'source-license-provenance.json')));assert.equal(lic.sources.length,17);assert.equal(lic.fullOriginalGPLLicense.sha256,'05646d0e8b70da13b0c0d81aaba2c0526be2e8ffdbcb7322d9c4061d27e2143e');assert.equal(lic.license,'GPL-2.0-or-later');const requirements=JSON.parse(readFileSync(resolve(here,'requirements-binding.json')));for(const r of requirements.registries){const d=JSON.parse(readFileSync(resolve(repo,r.path)));assert.deepEqual(d.sources.map(s=>({id:s.id,sha256:s.sha256})),r.sources);const ids=d.capabilities?.map(s=>s.id)??d.products?.flatMap(p=>p.capabilities.map(c=>c.id))??d.baselineProducts.flatMap(p=>p.requirements.map(c=>c.id));assert.deepEqual(ids,r.capabilityIDs);}assert.equal(requirements.sourceSHAIDPairs,159);assert.equal(requirements.capabilityIDs,232);
const browser=JSON.parse(readFileSync(resolve(work,'root-vault-group-edit-corrected-browser-review-next/browser-observations.json')));const acceptedBrowser=JSON.parse(readFileSync(resolve(work,'root-vault-group-edit-corrected-browser-review-next/validation.json')));assert.equal(browser.schema,'rea-root-vault-corrected-group-browser-observations/v1');assert.equal(browser.correctedClientSHA256,'29f99c9132286e93ffdcc26105daa9d4209591b4aedad438cc6830841f227908');assert.equal(browser.candidateManifestSHA256,'289208dda19cada4aad11b38827414af77faa897b344d40ce71ff6ccec8013d3');assert.equal(browser.observations.length,9);assert(browser.observations.every(r=>r.pass===true));assert.equal(acceptedBrowser.sources,13);assert.equal(acceptedBrowser.sourceStable,true);assert.deepEqual(acceptedBrowser.before,acceptedBrowser.after);assert.equal(acceptedBrowser.before.records,137);assert.equal(acceptedBrowser.scope.sharedHostExact,true);assert.equal(acceptedBrowser.scope.transportBridge,false);assert.equal(acceptedBrowser.scope.handlerSubstitutions,0);assert.equal(acceptedBrowser.scope.originalExecutions,0);assert.equal(acceptedBrowser.ownedHostClosed,true);assert.equal(acceptedBrowser.ownedDataRemoved,true);
