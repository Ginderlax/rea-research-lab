    {
      "id": "grafana.candidate.e71a7ff82157ef66fdd8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A _user_ is defined as any individual who can log in to Grafana. Each user is associated with a _role_ that includes _permissions_. Permissions determine the tasks a user can perform in the system.",
      "headingPath": [
        "Server user management"
      ],
      "source": {
        "path": "docs/sources/administration/user-management/server-user-management/_index.md",
