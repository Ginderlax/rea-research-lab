    },
    {
      "id": "grafana.candidate.d678b7c151d0e4e26e6c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To help make it easier for administrators to assess and interact with Grafana plugins, we are reworking the plugin details page to highlight important metadata, such as when the plugin was last updated.",
      "headingPath": [
        "What’s new in Grafana v11.3",
        "Plugins",
        "Plugin details page redesign"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-3.md",
        "gitBlobSha": "5eb55341a0458eac320b2317223af815e066d128",
        "sha256": "42f0fbcea86ed7f49f166bc9b279b95673f27c4ef505737f7b54ede18c391332",
        "lineStart": 278,
        "lineEnd": 278,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-3.md#L278-L278"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c4e9bf76a9f1ae7efc60",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We intend to further extend this new layout with consistent links for all plugins, to complement the custom links which can currently be optionally configured. This improved consistency will enable simpler interaction with a plugin's developer - whether that is Grafana Labs, our commercial partners, or our community. These links will include actions such as raising feature requests or bug reports, as well as allowing our community developers to indicate available support and sponsorship options for those that depend on their work.",
      "headingPath": [
        "What’s new in Grafana v11.3",
        "Plugins",
        "Plugin details page redesign"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-3.md",
        "gitBlobSha": "5eb55341a0458eac320b2317223af815e066d128",
        "sha256": "42f0fbcea86ed7f49f166bc9b279b95673f27c4ef505737f7b54ede18c391332",
        "lineStart": 280,
        "lineEnd": 280,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-3.md#L280-L280"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.44d6036a0b2a94b43863",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use the new UI to set up your LDAP server as an Identity Provider, to smooth out the setup process and get quick confirmation that it works properly.",
      "headingPath": [
        "What’s new in Grafana v11.3",
        "Authentication and authorization",
        "Configure LDAP through the UI"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-3.md",
        "gitBlobSha": "5eb55341a0458eac320b2317223af815e066d128",
        "sha256": "42f0fbcea86ed7f49f166bc9b279b95673f27c4ef505737f7b54ede18c391332",
        "lineStart": 292,
        "lineEnd": 292,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-3.md#L292-L292"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.bf0b687a22c3a513b1d0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To use LDAP in the UI, enable the feature toggle `ssoSettingsLDAP`.",
      "headingPath": [
        "What’s new in Grafana v11.3",
        "Authentication and authorization",
        "Configure LDAP through the UI"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-3.md",
        "gitBlobSha": "5eb55341a0458eac320b2317223af815e066d128",
        "sha256": "42f0fbcea86ed7f49f166bc9b279b95673f27c4ef505737f7b54ede18c391332",
        "lineStart": 296,
        "lineEnd": 296,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-3.md#L296-L296"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
