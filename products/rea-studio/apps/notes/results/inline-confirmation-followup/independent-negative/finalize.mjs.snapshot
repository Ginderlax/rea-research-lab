import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const here=import.meta.dirname,workspace=path.resolve(here,'../..'),stage=path.resolve(here,'../notes-inline-confirmation-next'),repo=path.join(workspace,'outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),ident=async p=>{const b=await fs.readFile(p);return{bytes:b.length,sha256:sha(b)}},save=(n,v)=>fs.writeFile(path.join(here,n),JSON.stringify(v,null,2)+'\n',{flag:'wx'}),read=async p=>JSON.parse(await fs.readFile(path.join(here,p)));
const before=await read('source-before.json');for(const r of before)assert.deepEqual(await ident(path.join(r.root==='stage'?stage:repo,r.path)),{bytes:r.bytes,sha256:r.sha256},r.path);
const references=JSON.parse(await fs.readFile(path.join(stage,'authority/historical-stage-references.json.snapshot'))).references,historical=[];
for(const r of [...references,{folder:'notes-vault-focused-integration-next',manifest:'freeze-manifest.json',manifestSha256:'22372f04e114fed639ab036aa44bfae4a3ab1cdb327ef3bc223519541618b451',count:149}]){const base=path.resolve(here,'../'+r.folder),b=await fs.readFile(path.join(base,r.manifest));assert.equal(sha(b),r.manifestSha256);const m=JSON.parse(b),rows=m.records??(Array.isArray(m.files)?m.files:Object.entries(m.inventory).map(([p,r])=>({path:p,...r})));assert.equal(rows.length,r.count);for(const e of rows)assert.deepEqual(await ident(path.join(base,e.path)),{bytes:e.bytes,sha256:e.sha256},e.path);if(r.receipt)assert.equal((await ident(path.join(base,r.receipt))).sha256,r.receiptSha256);historical.push({...r,manifestIdentity:{bytes:b.length,sha256:sha(b)},allListedArtifactsAuthenticated:true,authenticationTiming:'Full payload authentication after finite campaign; references already authenticated in candidate214 before campaign.'});assert.equal((await ident(path.join(base,r.manifest))).sha256,r.manifestSha256);}
await save('historical-authentication.json',historical);
const first=await read('attempt.json'),final=await read('runs/final-model/attempt.json');assert.deepEqual(first.counts,{tests:16,pass:14,fail:2,cancelled:0,skipped:0,todo:0});assert.deepEqual(final.counts,{tests:16,pass:15,fail:1,cancelled:0,skipped:0,todo:0});assert.equal(first.sourceStable,true);assert.equal(final.sourceStable,true);
const cases=['before-cancel','after-cancel','after-trash','after-restore-cancel','after-restore','after-dirty-guard','after-reopen'],observations={};for(const n of cases)observations[n]=await read('browser/'+n+'.json');
const a=observations['before-cancel'],b=observations['after-cancel'],added=b.requests.slice(a.requests.length).filter(r=>r.phase==='browser');assert.deepEqual(added.map(r=>[r.method,r.url,r.status]),[['POST','/api/notes/attachment-list',200]]);assert.deepEqual(a.state,b.state);assert.deepEqual(a.organization,b.organization);
const restoreCancel=observations['after-restore-cancel'],trash=observations['after-trash'];assert.equal(trash.state.revision,2);assert.ok(trash.state.deletedAt);assert.deepEqual(restoreCancel.state,trash.state);assert.deepEqual(restoreCancel.organization,trash.organization);
assert.equal(observations['after-restore'].state.revision,3);assert.equal(observations['after-restore'].state.deletedAt,null);assert.equal(observations['after-dirty-guard'].state.revision,3);assert.equal(observations['after-dirty-guard'].state.body,'Owned synthetic browser body.');assert.equal(observations['after-reopen'].state.revision,4);assert.equal(observations['after-reopen'].state.body,'Owned newer browser draft retained.');
const requests=observations['after-reopen'].requests.filter(r=>r.phase==='browser'&&r.method==='POST'),mutationRequests=requests.filter(r=>['/api/notes/notebook-trash','/api/notes/notebook-restore'].includes(r.url));assert.deepEqual(mutationRequests.map(r=>r.url),['/api/notes/notebook-trash','/api/notes/notebook-restore']);
assert.equal((await read('browser/cleanup.json')).hostClosed,true);assert.equal((await read('browser/cleanup.json')).tempDataRemoved,true);assert.equal((await read('browser/tab-cleanup.json')).closeResolved,true);assert.deepEqual(await read('browser/source-before.json'),await read('browser/source-after.json'));
const findings=[{id:'NOTES-CANCEL-READ-1',priority:'P3',status:'confirmed; candidate acceptance withheld',source:{path:'products/rea-studio/apps/notes/client.mjs',sha256:'7bff5337892cefd6cdd9e9de82c0e6660fefdf079bc523a748c927f2eac8a205',line:85},trigger:'Open a saved note, open notebook Trash or Restore confirmation, then Cancel/Escape/Space before submission.',expected:'The documented Cancel policy performs no follow-up backend read or mutation.',actual:'organize finally calls accept(current) after organizationBusy clears, issuing one attachment-list backend read.',modelFailure:'runs/final-model/tests.stdout.txt',actualBrowser:'browser/after-cancel.json',savedDataMutation:false,draftLossDemonstrated:false,originalSourceMismatchClaim:false}];
await save('findings.json',findings);await save('failure-ledger.json',{initialModel:{tests:16,pass:14,fail:2,source:'independent.test.mjs',raw:'tests.stdout.txt'},reviewerAssertionCorrection:{path:'review-test-version-correction.json',classification:'Reviewer fixture error: missing active deleted_time is permitted; preserved strict0 failure is not an app defect.'},finalModel:{tests:16,pass:15,fail:1,source:'independent-v2.test.mjs',raw:'runs/final-model/tests.stdout.txt',failure:'Unchanged genuine Cancel/no-follow-up-read policy check.'},candidateAuthorPreparationFailures:'Retained in immutable214 and authenticated; not recreated or relabeled.',privateBrowserExpectedMissingApp:{path:'browser/steps.json',reason:'Only Notes payload copied. Lab Editor navigation still invokes exact shared-shell disposal but its module is intentionally absent; no Editor product fault claimed.'},allFailuresRetained:true});
await save('review-validation.json',{schema:'rea-notes-inline-confirmation-independent-review/v1',at:new Date().toISOString(),independentAcceptance:false,remainingConfirmedFindings:1,candidateManifest:{files:214,...await ident(path.join(stage,'freeze-manifest.json'))},candidateReceipt:await ident(path.join(stage,'validation.json')),candidateClient:await ident(path.join(stage,'products/rea-studio/apps/notes/client.mjs')),exactFresh9Passed:true,newIndependent7:{pass:6,fail:1},finalModel16:final.counts,initialModel16:first.counts,allStage215Production28OriginalSource31UnchangedBeforeAfter:true,historicalAuthentication:'historical-authentication.json',adapters:'adapters.json',reviewerFixtureCorrection:'review-test-version-correction.json',actualBrowser:{runs:1,sourceCopies:12,exactCandidateSharedHost:true,currentShellCopiedAndAuthenticated:true,realConfirmCancel:true,TabShiftTabEscapeSpaceEnter:true,trashRestoreMutations:2,dirtyGuardSavedRevisionUnchanged:true,saveAndReopenRevision:4,navigationDisposalBeforeConfirm:true,heldResponseDisposalActualBrowser:false,heldResponseDisposalModel:true,confirmedCancellationAttachmentReads:1,saveDiskOrDraftLoss:false,hostClosed:true,ownedTabCloseResolved:true,ownedTempRemoved:true,user4311Touched:false},originalHelperExecutions:0,originalApplicationGuiExecutions:0,benchmarks:0,productionEdits:0,fullProductParity:false,universalSuperiority:false});
for(const r of before)assert.deepEqual(await ident(path.join(r.root==='stage'?stage:repo,r.path)),{bytes:r.bytes,sha256:r.sha256},r.path);console.log(JSON.stringify({final:final.counts,confirmedFindings:1,browserPositiveChecks:true,sourceStable:true,acceptance:false,reviewReceipt:await ident(path.join(here,'review-validation.json'))}));
