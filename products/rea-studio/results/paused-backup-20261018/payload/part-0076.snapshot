      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.97e66ea56fd1a411edc8",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Set the options required by your authentication method in the `[azure]` section of your `.ini` configuration file. For a full description of each option, refer to the [`[azure]` configuration reference](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-grafana/#azure).",
      "headingPath": [
        "Migrate from Prometheus Azure AD to Azure Monitor Managed Service for Prometheus",
        "Troubleshoot migration issues",
        "\"401 Unauthorized\" after migration"
      ],
      "source": {
