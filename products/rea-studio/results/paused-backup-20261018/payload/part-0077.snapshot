        "sha256": "a854d8317e4a2fc51bb82f7a31ee6438dc48f45d8ae483e504521c35e34c73df",
        "lineStart": 118,
        "lineEnd": 118,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md#L118-L118"
      },
      "applicability": {
