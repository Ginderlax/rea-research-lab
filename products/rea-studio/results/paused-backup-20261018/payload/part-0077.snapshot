    {
      "id": "grafana.candidate.2574a51f697bd4bae60f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "SCIM provides automated team management capabilities that go beyond what Team Sync offers. While Team Sync only maps identity provider groups to existing Grafana teams, SCIM can automatically create and delete teams based on group changes in the identity provider.",
      "headingPath": [
        "Manage users and teams with SCIM",
        "Team provisioning with SCIM"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-scim-provisioning/manage-users-teams/_index.md",
