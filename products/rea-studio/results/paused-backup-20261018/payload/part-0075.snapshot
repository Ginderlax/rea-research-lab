    {
      "id": "grafana.candidate.708caf0e95af5c89327f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Real-time notifications (or automatic pulling) is enabled and configured by default in Grafana Cloud.",
      "headingPath": [
