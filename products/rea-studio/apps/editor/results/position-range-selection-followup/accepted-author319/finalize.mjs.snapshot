async function inventory(folder,prefix=''){const rows=[];for(const e of(await fs.readdir(folder,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){assert.equal(e.isSymbolicLink(),false);const rel=prefix+e.name,p=path.join(folder,e.name);if(e.isDirectory())rows.push(...await inventory(p,rel+'/'));else{assert.ok(e.isFile());assert.notEqual(rel,'freeze-manifest.json');rows.push({path:rel,...id(await fs.readFile(p))});}}return rows;}const rows=await inventory(root),manifest={schema:'rea-editor-position-range-selection-correction-strict-freeze/v1',recordedAt:new Date().toISOString(),files:rows.length,bytes:rows.reduce((n,r)=>n+r.bytes,0),inventory:rows,immutableHistoryPayloads:188,immutableHistoryManifests:2,originalNativeArchivesOrExecutablesIncluded:false,localParserModulesIncluded:false,sourceOnlyCandidate:true,independentCorrectionAcceptance:false};await json('freeze-manifest.json',manifest);for(const r of rows)assert.deepEqual(id(await read(r.path)),{bytes:r.bytes,sha256:r.sha256});console.log(JSON.stringify({stage:path.relative(workspace,root).replaceAll('\\','/'),files:rows.length,bytes:manifest.bytes,manifest:await identity('freeze-manifest.json'),validation:await identity('validation.json'),candidate:sourceIdentity,focusedTests:22,pass:22,fail:0,skipped:0,priorRows190Exact:true,independentCorrectionAcceptance:false,StudioWrites:0}));
