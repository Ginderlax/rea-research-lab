// Source-only installed proof receipt and exact parent copy proposal.
import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const here=import.meta.dirname,workspace=path.resolve(here,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),hash=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:hash(b)});
async function write(p,v){await fs.writeFile(path.join(here,p),JSON.stringify(v,null,2)+'\n',{flag:'wx'});}
const raw=await fs.readFile(path.join(here,'installed-proof.stdout.txt')),stderr=await fs.readFile(path.join(here,'installed-proof.stderr.txt'));assert.equal(stderr.length,0);const result=JSON.parse(raw);assert.equal(result.actualInstalledByteVerification,true);assert.equal(result.coreAliases832,832);assert.equal(result.current10Mandatory,10);assert.equal(result.separateIndependentReview45,45);assert.equal(result.totalHistoricalAliases877,877);assert.equal(result.negativeMetadataControls8.length,8);assert.ok(result.negativeMetadataControls8.every(r=>r.rejected));assert.equal(result.sourceBeforeAfterStable,true);assert.equal(result.actualDownloadFileAcceptance,false);
const proposal=[];for(const name of ['scripts/verify-sketch-layout-followups.mjs','scripts/sketch-layout-proof/public-proof-loader.mjs','scripts/sketch-layout-proof/proof-verifier.mjs']){const b=await fs.readFile(path.join(here,'proposed',name));proposal.push({source:'work/sketch-layout-root-proof-integration-next/proposed/'+name,destination:name,...id(b),behaviorAdapter:false,pureSourceVerifier:true});}
assert.equal(proposal[1].sha256,'35fdaf67acd3b223c6f46419189a249c9a9b36d82e10065df2292615b4b74045');assert.equal(proposal[2].sha256,'8116090c18432303df8b6fcb6f0e7ca7d6f6b811ebab9d1ef37090bdfc3d96f5');await write('proposed-script-copy-list.json',{schema:'rea-sketch-layout-root-proof-script-proposal/v1',files:3,records:proposal,rootOwnsActualCopies:true,exactFrozenReviewModules2:true,existingCore832NotModified:true,datasetRemainsExactFrozenAlias:true});
const source=path.join(workspace,'work/sketch-layout-source-plan-independent-review'),mb=await fs.readFile(path.join(source,'freeze-manifest.json'));assert.equal(hash(mb),'dd196558e07a7568d0424dff0a610a1b18627d0bee0b56c0cbbaad90f6f080c7');const manifest=JSON.parse(mb);for(const r of manifest.inventory)assert.deepEqual(id(await fs.readFile(path.join(source,r.path))),{bytes:r.bytes,sha256:r.sha256});await write('review-source-after.json',{strict44AndManifestStillExact:true,manifest:id(mb),rows:[...manifest.inventory,{path:'freeze-manifest.json',...id(mb)}]});
const dataset=JSON.parse(await fs.readFile(path.join(source,'proof-dataset.json'))),current=[];for(const r of dataset.current){const b=await fs.readFile(path.join(repo,r.path));assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});current.push({path:r.path,...id(b)});}await write('current10-postcheck.json',{at:new Date().toISOString(),rows:current,all10Exact:true,beforeAndAfterVerifiedWithinActualWrapper:true,noHistoricalRebinding:true});
await write('validation.json',{schema:'rea-sketch-layout-root-proof-integration-proposal-validation/v1',at:new Date().toISOString(),sourceOnlyInstalledVerificationAccepted:true,proposedRootScripts:proposal,wrapperResult:result,raw:{stdout:{path:'installed-proof.stdout.txt',...id(raw)},stderr:{path:'installed-proof.stderr.txt',...id(stderr)},exitCode:0},historicalOwnReview44AndManifestUnmodified:true,reviewPublicAliases45:'review-public-copy-list.json',publicDatasetSHA256:'5ab5d2fdbea33dc3712c66050a47097170caef5bed7e7bf8fd22bc1637efffc7',current10Mandatory:true,negativeMetadataControls8:true,actualPublicCore832AndReview45Read:true,proposedModules2Exact:true,actualProposedWrapperExecutedFromWork:true,rootScriptsNotCopiedByReviewer:true,productionWrites:0,newApplicationCalls:0,newBehaviorTests:0,newBrowser:0,newOriginalHelpers:0,newOriginalGUI:0,benchmarks:0,profilers:0,fileDownloadAccepted:false,fullParity:false,superiority:false});
console.log(JSON.stringify({installedSourceProofAccepted:true,historicalAliases877:true,current10:true,negatives8:true,proposedScripts:proposal}));
