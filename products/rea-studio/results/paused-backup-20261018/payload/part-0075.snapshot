    },
    {
      "id": "grafana.candidate.94f45cdb3655c0351b58",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In the alert rule, you can choose a contact point to receive the alert notifications or use notification policies instead.",
      "headingPath": [
        "Introduction to Grafana Alerting",
        "Fundamentals",
        "Notification messages"
      ],
      "source": {
        "path": "docs/sources/alerting/fundamentals/_index.md",
