    {
      "id": "grafana.candidate.fc8ecdc1793bf313a907",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The path to the directory where the frontend files (HTML, JS, and CSS files). Defaults to `public` which is why the Grafana binary needs to be executed with working directory set to the installation path.",
      "headingPath": [
