    {
      "id": "grafana.candidate.0dde604c5cc98d1cdca8",
      "syntaxRole": "list-item",
      "sourceText": "- **Template variables aren't supported:** Alert queries don't support dashboard template variables because alerts evaluate independently of any dashboard context. Hard-code values or use [alert rule labels](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/alerting/fundamentals/alert-rules/annotation-label/) instead.",
      "headingPath": [
        "PostgreSQL alerting",
        "Limitations"
      ],
