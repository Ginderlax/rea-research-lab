    {
      "id": "grafana.candidate.c7b18e60f45bfe85f0c7",
      "syntaxRole": "table-row",
      "sourceText": "| `scopes`                     | No       | Yes                | List of comma- or space-separated GitHub OAuth scopes.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                | `user:email,read:org`                         |",
      "headingPath": [
        "Configure GitHub OAuth authentication",
        "Configuration options"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/github/index.md",
        "gitBlobSha": "d2e6241054e4dfdceaf82864b39f2c01b645d35b",
