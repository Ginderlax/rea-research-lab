    {
      "id": "grafana.candidate.e333f7656b4906d73233",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To validate the rules, we recommend testing the rules in the Explore view. This will allow you to see the metrics or logs that would be returned for the rule.",
      "headingPath": [
        "Create LBAC for data source rule",
        "Before you begin",
        "LBAC rule",
        "Best practices"
