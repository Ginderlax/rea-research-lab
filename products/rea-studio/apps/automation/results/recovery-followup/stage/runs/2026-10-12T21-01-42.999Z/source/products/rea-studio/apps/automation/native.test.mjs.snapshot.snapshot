import test from 'node:test';
import assert from 'node:assert/strict';
import {importWorkflow,exportWorkflow,preflight,executeNode,createExecution,advanceExecution,filterCondition,bounded} from './native.mjs';
import {executeOriginalNode,verifyOriginalIntegrity,observations,comparisons} from './original-harness.mjs';
const node=(type,parameters={},name='Test')=>({id:name,name,type:`n8n-nodes-base.${type}`,typeVersion:{manualTrigger:1,set:3.4,if:2.3,httpRequest:4.4,wait:1.1}[type],parameters,position:[0,0]});
const sample=()=>({name:'Native sample',nodes:[node('manualTrigger',{},'Manual'),node('set',{assignments:{assignments:[{id:'one',name:'amount',type:'number',value:150}]}},'Set'),node('if',{conditions:{options:{caseSensitive:true,typeValidation:'strict',version:3},combinator:'and',conditions:[{leftValue:'={{ $json.amount }}',rightValue:100,operator:{type:'number',operation:'gte'}}]},options:{}},'If')],connections:{Manual:{main:[[{node:'Set',type:'main',index:0}]]},Set:{main:[[{node:'If',type:'main',index:0}]]}},settings:{executionOrder:'v1'}});
test('native workflow JSON preserves unknown nodes, metadata, options and non-main connections while preflight refuses unsupported execution',()=>{
 const value=sample();value.meta={unknown:{nested:[null,'Unicode café 😀']}};value.nodes[1].parameters.options={futureOption:{foo:1}};value.nodes.push({...node('future',{},'Unknown'),typeVersion:9,credentials:{provider:{id:'reference-only',name:'Existing'}}});value.connections.Set.ai_tool=[[{node:'Unknown',type:'ai_tool',index:0,extra:'preserve'}]];
 assert.deepEqual(JSON.parse(exportWorkflow(importWorkflow(JSON.stringify(value)))),value);const result=preflight(value);assert.equal(result.executable,false);assert.match(JSON.stringify(result.issues),/futureOption|main connections/);
});
test('native Manual Trigger executes the authenticated exact original node contract',async()=>{const value=node('manualTrigger');assert.deepEqual(await executeNode(value,[]),await executeOriginalNode(value,[]));comparisons.exactOutputMatches++;});
test('native Set modern assignments, conversions, include selection/exclusion, dot notation and expressions match exact original module',async()=>{
 const input=[{json:{keep:3,customer:{name:'Ada',region:'north'},array:[9,8]}}];
 const fields=[['string',3],['string',{a:1}],['number','42.5'],['number',''],['boolean','FALSE'],['boolean',1],['object','{"nested":true}'],['array','[1,2]'],['string',null],['number','={{ $json.missing }}'],['string','={{ $json.customer.name }}']];
 for(const[type,value]of fields){const set=node('set',{assignments:{assignments:[{id:'a',name:'result',type,value}]},includeOtherFields:true,options:{}});assert.deepEqual(await executeNode(set,structuredClone(input)),await executeOriginalNode(set,structuredClone(input)),`${type}: ${JSON.stringify(value)}`);comparisons.exactOutputMatches++;}
 for(const parameters of [
  {includeOtherFields:true,include:'selected',includeFields:'customer.name,array[0]',assignments:{assignments:[]}},
  {includeOtherFields:true,include:'except',excludeFields:'customer.region,array[0]',assignments:{assignments:[]}},
  {options:{dotNotation:false},assignments:{assignments:[{name:'a.b',type:'number',value:7}]}},
  {assignments:{assignments:[{name:'a[0].name',type:'string',value:'yes'}]}},
  {mode:'raw',jsonOutput:'{"new":4,"child.name":"nested"}',includeOtherFields:true},
  {mode:'raw',jsonOutput:'={{ $json.customer }}'},
  {options:{ignoreConversionErrors:true},assignments:{assignments:[{name:'result',type:'number',value:'bad'}]}}
 ]){const set=node('set',parameters);assert.deepEqual(await executeNode(set,structuredClone(input)),await executeOriginalNode(set,structuredClone(input)),JSON.stringify(parameters));comparisons.exactOutputMatches++;}
});
test('native If routes and pairs items using exact original filter extraction and module',async()=>{
 for(const[type,operations,values]of [['number',['equals','notEquals','gt','gte','lt','lte','empty','notEmpty','exists','notExists'],[null,0,7,'7','']],['string',['equals','notEquals','contains','notContains','startsWith','notStartsWith','endsWith','notEndsWith','empty','notEmpty','exists','notExists'],[null,'','Ada','ADA','something']],['boolean',['true','false','equals','notEquals','empty','notEmpty','exists','notExists'],[null,true,false,'false',1]]]){
  for(const operation of operations)for(const strict of [true,false])for(const value of values){const conditions={options:{caseSensitive:false,typeValidation:strict?'strict':'loose',version:3},combinator:'and',conditions:[{leftValue:'={{ $json.value }}',rightValue:type==='number'?7:type==='string'?'Ada':true,operator:{type,operation,singleValue:['true','false','empty','notEmpty','exists','notExists'].includes(operation)}}]};const valueNode=node('if',{conditions,options:{}}),input=[{json:{value}}];let candidate,original,errorA,errorB;try{candidate=await executeNode(valueNode,structuredClone(input));}catch(error){errorA=error;}try{original=await executeOriginalNode(valueNode,structuredClone(input));}catch(error){errorB=error;}assert.equal(!!errorA,!!errorB,`${type}/${operation}/${strict}/${JSON.stringify(value)}`);if(!errorA){assert.deepEqual(candidate,original);comparisons.exactOutputMatches++;}else comparisons.rejectionOutcomeMatches++;}
 }
});
test('native manual graph executes native JSON and persists Wait continuation without blocking',async()=>{
 const value=sample();value.nodes.push(node('wait',{resume:'timeInterval',amount:0.01,unit:'seconds'},'Wait'));value.connections.If={main:[[{node:'Wait',type:'main',index:0}],[]]};
 const execution=createExecution(value),checkpoints=[];await advanceExecution(execution,{now:1000,checkpoint:async state=>checkpoints.push(structuredClone(state))});assert.equal(execution.status,'waiting');assert.equal(execution.waitUntil,new Date(1010).toISOString());assert.deepEqual(execution.outputs.If[0][0].json,{amount:150});const restarted=JSON.parse(JSON.stringify(checkpoints.at(-1)));await advanceExecution(restarted,{now:1009});assert.equal(restarted.status,'waiting');await advanceExecution(restarted,{now:1010});assert.equal(restarted.status,'completed');
});
test('native If array/object/any operators and multi-condition combinators match authenticated original helper execution',async()=>{
 const corpus=[
  ...['array'].flatMap(type=>['empty','notEmpty','exists','notExists','contains','notContains','lengthEquals','lengthNotEquals','lengthGt','lengthLt','lengthGte','lengthLte'].flatMap(operation=>[null,[],['Ada'],['ADA','Beta'],'["Ada"]',7].flatMap(value=>[true,false].map(strict=>({type,operation,value,strict}))))),
  ...['object','any'].flatMap(type=>(type==='object'?['empty','notEmpty','exists','notExists']:['exists','notExists']).flatMap(operation=>[null,{}, {value:1},'{}',[],7].flatMap(value=>[true,false].map(strict=>({type,operation,value,strict})))))
 ];
 for(const{type,operation,value,strict}of corpus){const single=['empty','notEmpty','exists','notExists'].includes(operation),conditions={options:{caseSensitive:false,typeValidation:strict?'strict':'loose',version:3},combinator:'and',conditions:[{leftValue:'={{ $json.value }}',rightValue:operation.startsWith('length')?1:'Ada',operator:{type,operation,singleValue:single,...(!single?{rightType:operation.startsWith('length')?'number':'string'}:{})}}]},valueNode=node('if',{conditions,options:{}}),input=[{json:{value}}];let a,b,ea,eb;try{a=await executeNode(valueNode,structuredClone(input));}catch(error){ea=error;}try{b=await executeOriginalNode(valueNode,structuredClone(input));}catch(error){eb=error;}assert.equal(!!ea,!!eb,`${type}/${operation}/${strict}/${JSON.stringify(value)}`);if(!ea){assert.deepEqual(a,b,`${type}/${operation}/${strict}/${JSON.stringify(value)}`);comparisons.exactOutputMatches++;}else comparisons.rejectionOutcomeMatches++;}
 for(const combinator of ['and','or'])for(const version of [1,2,3]){const conditions={options:{caseSensitive:true,typeValidation:'loose',version},combinator,conditions:[{leftValue:'={{ $json.value }}',rightValue:3,operator:{type:'number',operation:'gt'}},{leftValue:'={{ $json.keep }}',operator:{type:'boolean',operation:'true',singleValue:true}}]},valueNode=node('if',{conditions,options:{}}),items=[{json:{value:5,keep:false},pairedItem:{item:9}},{json:{value:1,keep:true}}];assert.deepEqual(await executeNode(valueNode,structuredClone(items)),await executeOriginalNode(valueNode,structuredClone(items)));comparisons.exactOutputMatches++;}
});
test('native expression, prototype, array growth, structure and semantic option bounds reject before effects',()=>{
 for(const mutate of [v=>v.nodes[1].parameters.assignments.assignments[0].value='={{ process.exit() }}',v=>v.nodes[1].parameters.assignments.assignments[0].name='x[60000]',v=>v.nodes[1].parameters.assignments.assignments[0].name='__proto__.polluted',v=>v.nodes[1].retryOnFail=true,v=>v.nodes[1].typeVersion=3.5,v=>v.connections.If={main:[[{node:'Set',type:'main',index:0}],[]]}]){const value=sample();mutate(value);assert.equal(preflight(value).executable,false);assert.throws(()=>createExecution(value));}
 assert.throws(()=>bounded({a:Array(60000)}),/10,000/);assert.throws(()=>bounded({a:'x'.repeat(1024*1024),b:'x'.repeat(1024*1024)}),/byte bound/);assert.equal({}.polluted,undefined);
});
test('native Set include fields preserve own __proto__ data without invoking setters or changing output prototypes',async()=>{
 const input=[{json:JSON.parse('{"__proto__":{"polluted":true},"constructor":{"kept":1},"safe":2}')}];
 for(const parameters of [{includeOtherFields:true,assignments:{assignments:[]}},{includeOtherFields:true,include:'except',excludeFields:'safe',assignments:{assignments:[]}}]){const value=node('set',parameters),candidate=await executeNode(value,structuredClone(input)),original=await executeOriginalNode(value,structuredClone(input));assert.equal(Object.hasOwn(original[0][0].json,'__proto__'),false);const comparable=structuredClone(candidate);delete comparable[0][0].json.__proto__;assert.deepEqual(JSON.parse(JSON.stringify(comparable)),JSON.parse(JSON.stringify(original)));assert.equal(Object.getPrototypeOf(original[0][0].json).polluted,true);assert.equal(Object.getPrototypeOf(candidate[0][0].json),Object.prototype);assert.equal(Object.hasOwn(candidate[0][0].json,'__proto__'),true);assert.equal(candidate[0][0].json.polluted,undefined);assert.equal({}.polluted,undefined);comparisons.deliberateDeviations++;}
});
test.after(async()=>{await verifyOriginalIntegrity();console.log(`Authenticated original node observations: ${JSON.stringify(observations)}`);console.log(`Original comparison accounting: ${JSON.stringify(comparisons)}`);});
