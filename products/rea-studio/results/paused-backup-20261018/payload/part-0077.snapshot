    {
      "id": "grafana.candidate.f49a8d3feaadc6f0083c",
      "syntaxRole": "table-row",
      "sourceText": "| `token_exchange_timeout`     | No       | Yes                | Timeout in seconds for the OAuth token exchange request. If set to `0` or left unset, defaults to `15` seconds.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       | `15`                                          |",
      "headingPath": [
        "Configure GitHub OAuth authentication",
        "Configuration options"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/github/index.md",
