// Executes five function slices from authenticated Excalidraw 0.18.1 MIT sources.
// Owned axis-aligned bounds and mutation/binding adapters cover only the stated subset.
import fs from'node:fs/promises';import path from'node:path';import vm from'node:vm';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,sha=s=>createHash('sha256').update(s).digest('hex');
export async function createOriginalOracle(){const auth=JSON.parse(await fs.readFile(path.join(here,'original-baseline-authentication.json'))),source={};for(const row of auth.rows.filter(r=>r.sourcePath)){const b=await fs.readFile(path.join(here,row.path));assert.equal(sha(b),row.sha256);source[row.sourcePath]=b.toString('utf8');}const contracts=[];
function slice(file,start,end){const s=source[file],i=s.indexOf(start);assert(i>=0,start);const j=end?s.indexOf(end,i):s.length;assert(j>i,end);const body=s.slice(i,j).trim();contracts.push({file,startLine:s.slice(0,i).split('\n').length,endLine:s.slice(0,j).split('\n').length,originalSliceSHA256:sha(body),declarations:start==='export const alignElements'?2:1});return body;}
const groups=slice('packages/excalidraw/groups.ts','export const getMaximumGroups','export const getNonDeletedGroupIds').replace(/export const getMaximumGroups = \([\s\S]*?\): ExcalidrawElement\[\]\[\] => \{/,'const getMaximumGroups = (elements, elementsMap) => {').replace(/const groups: Map<String, ExcalidrawElement\[\]> = new Map<[\s\S]*?>\(\);/,'const groups = new Map();').replace('(element: ExcalidrawElement)','(element)');
const bbox=slice('packages/excalidraw/element/bounds.ts','export const getCommonBoundingBox','/**\n * returns scene coords').replace(/export const getCommonBoundingBox = \([\s\S]*?\): BoundingBox => \{/,'const getCommonBoundingBox = (elements) => {');
const align=slice('packages/excalidraw/align.ts','export const alignElements').replace(/export const alignElements = \([\s\S]*?\): ExcalidrawElement\[\] => \{/,'const alignElements = (selectedElements,elementsMap,alignment,scene) => {').replace(/const calculateTranslation = \([\s\S]*?\): \{ x: number; y: number \} => \{/,'const calculateTranslation = (group,selectionBoundingBox,{axis,position}) => {').replace('const [min, max]: ["minX" | "minY", "maxX" | "maxY"] =','const [min,max] =');
const distribute=slice('packages/excalidraw/distribute.ts','export const distributeElements').replace(/export const distributeElements = \([\s\S]*?\): ExcalidrawElement\[\] => \{/,'const distributeElements=(selectedElements,elementsMap,distribution)=>{').replaceAll(' as const','');
const adapter=`const getBoundTextElement=()=>null;const updateBoundElements=()=>{};const mutateElement=(element,change)=>Object.assign(element,change);const newElementWith=(element,change)=>({...element,...change});const getCommonBounds=elements=>{const points=elements.flatMap(e=>(e.type==='freedraw'||e.type==='line'||e.type==='arrow')?e.points.map(p=>[e.x+p[0],e.y+p[1]]):[[e.x,e.y],[e.x+e.width,e.y+e.height]]);return[Math.min(...points.map(p=>p[0])),Math.min(...points.map(p=>p[1])),Math.max(...points.map(p=>p[0])),Math.max(...points.map(p=>p[1]))];};`;
const code=[adapter,groups,bbox,align,distribute,'globalThis.output={getMaximumGroups,getCommonBoundingBox,alignElements,distributeElements};'].join('\n'),context=vm.createContext({});vm.runInContext(code,context,{timeout:500});const observations=[];
function execute(action,elements,value){assert(Array.isArray(elements)&&elements.length>0&&elements.length<=200);const clone=structuredClone(elements);assert(clone.every(e=>Number.isFinite(e.x)&&Number.isFinite(e.y)&&Number.isFinite(e.width)&&Number.isFinite(e.height)&&Array.isArray(e.groupIds)&&(!e.points||e.points.length<=5000)));context.input=clone;context.spec=value;context.action=action;const result=vm.runInContext(`(()=>{const map=new Map(input.map(e=>[e.id,e]));if(action==='groups')return output.getMaximumGroups(input,map).map(g=>g.map(e=>e.id));if(action==='bounds')return output.getCommonBoundingBox(input);if(action==='align')return output.alignElements(input,map,spec,{getNonDeletedElementsMap:()=>map});return output.distributeElements(input,map,spec);})()`,context,{timeout:500});const plain=JSON.parse(JSON.stringify(result));observations.push({action,input:structuredClone(elements),spec:value,result:plain});return plain;}
return{contracts,compiledOriginalDeclarations:5,codeSHA256:sha(code),adapters:'Owned unrotated rectangle/diamond/ellipse/text and actual point extrema for signed line/arrow/freehand; own mutation adapter; no-op bound-text/binding adapters; no original renderer/mutation version/frame-membership/full action/GUI execution',observations,groups:e=>execute('groups',e),bounds:e=>execute('bounds',e),align:(e,s)=>execute('align',e,s),distribute:(e,s)=>execute('distribute',e,s)};}
