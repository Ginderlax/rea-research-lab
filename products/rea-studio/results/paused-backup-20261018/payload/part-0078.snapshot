    {
      "id": "grafana.candidate.dec7ff79b736e8f14504",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana supports tracing.",
      "headingPath": [
        "Set up Grafana monitoring"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/set-up-grafana-monitoring.md",
        "gitBlobSha": "aa74b76b1b42b1d1dfa304247306ce2119844e66",
