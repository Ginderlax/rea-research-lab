    },
    {
      "id": "grafana.candidate.eaefa5d7040980de0775",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The Azure Monitor data source also supports querying of [Basic Logs](https://learn.microsoft.com/en-us/azure/azure-monitor/logs/basic-logs-query?tabs=portal-1) tables (if they exist in your Log Analytics workspace). This feature must be enabled in the data source configuration.",
      "headingPath": [
        "Azure Monitor query editor",
        "Query Azure Monitor Logs"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/query-editor/index.md",
