    'preserved': {'expectedExecutableBytes': 3265880, 'expectedExecutableSHA256': '04d29636c393f0c1fc99ff739295494be3adefded93271e44591e8e300225a5a', 'authenticatesBeforeAssemblyLoad': True, 'originalDateRewriting': False, 'initial20GroupBodiesUnchanged': True, 'additionalGroups': 27, 'selectedVaultTestFiles': 45, 'plannedOriginalLibraryChildren': 4, 'comparisonAssertionsChanged': 0, 'originalTestSourceChanged': False, 'serverR5CompatibilityPayloadChanged': False},
