    {
      "id": "grafana.candidate.7ecd05827325cf5092bd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "An alert event is displayed each time an alert instance changes its state over a period of time. All alert events are displayed regardless of whether silences or mute timings are set, so you’ll see a complete set of your data history even if you’re not necessarily being notified.",
      "headingPath": [
        "View alert state history"
      ],
