if attempt is not None: result['attempt']=attempt
def actual_api():
 run=parsed((control/'run.json').read_bytes());jobs=parsed((control/'jobs.json').read_bytes());artifacts=parsed((control/'artifacts.json').read_bytes())
 need(str(run['id'])==RUN and str(run['run_attempt'])==ATTEMPT and run['head_sha']==HEAD and run['head_branch']=='codex/rea-cloud-recovery-20261015','Exact actual run/head')
 need(run['repository']['full_name']==REPOSITORY and run['path']==WORKFLOW and run['event'] in ('pull_request','workflow_dispatch') and run['status']=='completed','Supported completed publication event')
 need(jobs['total_count']==len(jobs['jobs'])==1,'One actual publication job');job=jobs['jobs'][0]
 need(str(job['id'])==JOB and str(job['run_id'])==RUN and job['head_sha']==HEAD and job['name']=='publication-integrity','Exact actual job')
 need(job['status']=='completed' and job['runner_group_name']=='GitHub Actions' and 'windows-2022' in job['labels'],'Verified hosted Windows job')
 need(artifacts['total_count']==len(artifacts['artifacts'])==1,'One actual artifact');artifact=artifacts['artifacts'][0]
 need(str(artifact['id'])==artifact_id and artifact['name']=='publication-integrity-'+RUN+'-'+ATTEMPT and not artifact['expired'],'Exact artifact ID/name')
 need(artifact['digest']=='sha256:'+expected and artifact['size_in_bytes']==len(raw) and str(artifact['workflow_run']['id'])==RUN and artifact['workflow_run']['head_sha']==HEAD,'Actual artifact digest/run binding')
 return {'event':run['event'],'runConclusion':run['conclusion'],'jobConclusion':job['conclusion'],'jobStartedAtUtc':job['started_at'],'jobCompletedAtUtc':job['completed_at']}
api=stage('actualRunJobArtifactApi',actual_api)
git_blobs={}
def tested_git():
 need(api is not None and attempt is not None,'Actual API and producer receipt required')
 need(attempt['schema']=='rea-hosted-publication-validation-attempt/v1' and attempt['status'] in ('passed','failed','interrupted','running'),'Producer receipt schema/state')
 source_commit=attempt['sourceCommit'];need(re.fullmatch(r'[0-9a-f]{40}',source_commit),'Exact tested commit syntax')
 execution=attempt['execution'];need(execution['GITHUB_SHA']==source_commit and execution['GITHUB_RUN_ID']==RUN and execution['GITHUB_RUN_ATTEMPT']==ATTEMPT and execution['GITHUB_REPOSITORY']==REPOSITORY,'Same-attempt receipt execution')
 for key,value in {'CI':'true','GITHUB_ACTIONS':'true','RUNNER_ENVIRONMENT':'github-hosted','RUNNER_OS':'Windows','RUNNER_ARCH':'X64'}.items(): need(execution[key]==value,'Hosted execution '+key)
 need(attempt['runtime']=='v24.16.0' and attempt['candidateOverlay'] is False,'Exact runtime/no overlay')
 commit=parsed((control/'tested-commit.json').read_bytes());tree=parsed((control/'tested-tree.json').read_bytes());head=parsed((control/'head-commit.json').read_bytes())
 need(commit['sha']==source_commit and tree['sha']==commit['tree']['sha'] and tree['truncated'] is False and head['sha']==HEAD,'Actual tested Git objects/head')
 if api['event']=='pull_request':
  need(execution['GITHUB_REF']=='refs/pull/1/merge' and len(commit['parents'])==2 and commit['parents'][1]['sha']==HEAD and source_commit!=HEAD,'Exact PR merge/head-parent bridge')
 else: need(execution['GITHUB_REF']=='refs/heads/codex/rea-cloud-recovery-20261015' and source_commit==HEAD,'Exact manual branch/source bridge')
 need(head['tree']['sha']==tree['sha'],'Tested merge and requested branch have identical source tree')
 blobs={r['path']:r for r in tree['tree'] if r['type']=='blob'};need(24000<len(blobs)<=30000 and len(blobs)==sum(r['type']=='blob' for r in tree['tree']) and len({r['path'] for r in tree['tree']})==len(tree['tree']),'Complete unique Git blob closure; recursive API directory entries are separate')
 for name,row in blobs.items(): safe(name);need(row['mode'] in ('100644','100755'),'Regular Git mode')
 need(attempt['gitTree']==tree['sha'],'Producer tree identity matches actual tree');result['sourceCommit']=source_commit
 git_blobs.update(blobs)
 return {'sourceCommit':source_commit,'tree':tree['sha'],'actualGitBlobRows':len(blobs),'allPayloadBytesDownloadedLocally':False}
git=stage('testedCommitAndExactHeadTreeBridge',tested_git)
def git_content(name,content):
 need(git is not None and name in git_blobs,'Actual captured Git source '+name);row=git_blobs[name]
 need(row['size']==len(content) and hashlib.sha1(b'blob '+str(len(content)).encode()+b'\0'+content).hexdigest()==row['sha'],'Exact captured Git bytes '+name);return row['sha']
