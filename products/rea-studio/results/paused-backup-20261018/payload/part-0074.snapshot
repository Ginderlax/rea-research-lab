    {
      "id": "grafana.candidate.2eb859f8c1bc452e8002",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you previously configured recording rules using the `url` and `basic_auth_*` configuration options, these are no longer supported. You must either:",
