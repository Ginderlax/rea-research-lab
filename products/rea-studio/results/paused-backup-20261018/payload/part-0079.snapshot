    {
      "id": "grafana.candidate.f56628d62db2b8728ddd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The icon element lets you add a supported icon to the canvas. Icons can have their color set based on thresholds or value mappings.",
