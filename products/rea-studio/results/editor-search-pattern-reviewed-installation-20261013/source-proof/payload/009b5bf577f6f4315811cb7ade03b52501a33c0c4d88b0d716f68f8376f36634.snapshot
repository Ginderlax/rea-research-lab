import {createHash}from'node:crypto';
import assert from'node:assert/strict';
import {render}from'../editor-search-pattern-next/candidate/products/rea-studio/apps/editor/client.mjs';

export const revision=s=>createHash('sha256').update(s).digest('hex');
export const uiObservations=[];
export class Element{
 constructor(tag){this.tagName=tag.toUpperCase();this.children=[];this.attributes={};this.style={};this.value='';this.checked=false;this.disabled=false;this.parentElement=null;this._text='';this.selectionStart=this.selectionEnd=0;}
 set textContent(v){this._text=String(v);this.replaceChildren();}get textContent(){return this._text+this.children.map(c=>c.textContent).join('');}
 setAttribute(k,v){this.attributes[k]=String(v);}getAttribute(k){return this.attributes[k]??null;}
 append(...nodes){for(const n of nodes){assert(n instanceof Element);n.parentElement=this;this.children.push(n);}}
 prepend(...nodes){for(const n of nodes.reverse()){assert(n instanceof Element);n.parentElement=this;this.children.unshift(n);}}
 replaceChildren(...nodes){for(const n of this.children)n.parentElement=null;this.children=[];this.append(...nodes);}
 insertBefore(node,before){const at=this.children.indexOf(before);assert(at>=0);node.parentElement=this;this.children.splice(at,0,node);}
 focus(){this.focused=true;}setSelectionRange(start,end){this.selectionStart=start;this.selectionEnd=end;}
 setRangeText(text,start,end){this.value=this.value.slice(0,start)+text+this.value.slice(end);this.selectionStart=this.selectionEnd=start+text.length;}
 dispatchEvent(event){const fn=this['on'+event.type];return fn?.(event);}get isConnected(){return this.connectedRoot===true||this.parentElement?.isConnected===true;}
}
export function all(root){return[root,...root.children.flatMap(all)];}
export function named(root,label){const found=all(root).filter(n=>n.getAttribute('aria-label')===label);assert.equal(found.length,1,label);return found[0];}
export function button(root,label){const found=all(root).filter(n=>n.tagName==='BUTTON'&&n.textContent===label);assert.equal(found.length,1,label);return found[0];}
export function deferred(){let resolve,reject;const promise=new Promise((a,b)=>{resolve=a;reject=b;});return{promise,resolve,reject};}
export async function click(node){assert(node.isConnected,'Detached control');assert.equal(node.disabled,false,'Disabled control');return node.onclick?.();}
export function type(node,value){assert(node.isConnected);assert.equal(node.disabled,false);node.value=value;node.oninput?.({target:node,type:'input'});}
export function toggle(node,value){assert(node.isConnected);assert.equal(node.disabled,false);node.checked=value;node.onchange?.({target:node,type:'change'});}
export async function mount(records={a:'old A',b:'old B'}){
 const oldDocument=globalThis.document,oldWindow=globalThis.window;globalThis.document={createElement:t=>new Element(t)};globalThis.window={confirm:()=>true};
 const host=new Element('main');host.connectedRoot=true;const root=new Element('section');host.append(root);const calls=[],holds=[],saved=new Map(Object.entries(records).map(([k,v])=>[k+'.txt',v]));
 const api=async(action,input={})=>{calls.push({action,input:structuredClone(input)});let data;if(action==='list')data={root:'owned synthetic workspace',files:[...saved.keys()],truncated:false};else if(action==='gitStatus')data={initialized:false};else if(action==='read'){assert(saved.has(input.path));const content=saved.get(input.path);data={path:input.path,content,revision:revision(content),bytes:Buffer.byteLength(content)};}else if(action==='save'){assert.equal(input.revision,revision(saved.get(input.path)));saved.set(input.path,input.content);data={path:input.path,content:input.content,revision:revision(input.content),bytes:Buffer.byteLength(input.content)};}else if(action==='search'){const content=saved.get('a.txt');data={matches:[{path:'a.txt',revision:revision(content),line:1,column:1,endColumn:2,start:0,end:1,preview:content}],matchedFiles:1,searchedFiles:saved.size,skipped:[],truncated:false,limitReasons:[]};}else throw Error('Unexpected synthetic action '+action);
   const hold=holds.find(h=>h.action===action&&!h.used&&(h.path===undefined||h.path===input.path));if(hold){hold.used=true;hold.started.resolve({input:structuredClone(input),data:structuredClone(data)});await hold.release.promise;}return data;};
 const cleanup=await render(root,api);
 let restored=false;
 return{root,host,saved,calls,cleanup,hold(action,path){const h={action,path,used:false,started:deferred(),release:deferred()};holds.push(h);return h;},restore(){if(restored)return;restored=true;uiObservations.push({calls:structuredClone(calls),saved:[...saved],editorValue:all(root).find(n=>n.getAttribute('aria-label')==='File contents')?.value,connected:root.isConnected});cleanup();host.replaceChildren();globalThis.document=oldDocument;globalThis.window=oldWindow;}};
}
