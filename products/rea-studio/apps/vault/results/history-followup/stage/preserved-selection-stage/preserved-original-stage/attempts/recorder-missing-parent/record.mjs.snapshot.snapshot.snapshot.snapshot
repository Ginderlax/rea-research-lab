import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import {here,child} from './harness.mjs';
const label=process.argv[2],files=process.argv.slice(3);if(!/^[a-z0-9-]+$/.test(label??'')||!files.length||files.some(f=>!/^[-a-z0-9.]+\.test\.mjs$/.test(f)))throw new Error('Explicit owned label and test files required.');
const folder=path.join(here,'runs',label);await fs.mkdir(folder,{recursive:false});const sourceNames=['history.mjs','server.mjs','kdbx.mjs','xml.mjs','client.mjs','history-oracle.ps1','harness.mjs','prepare-host.mjs','http-runner.mjs','record.mjs',...files,'host/server.mjs','host/catalog.mjs','host/lib/storage.mjs','host/apps/vault/server.mjs','host/apps/vault/client.mjs'];
for(const optional of ['README.md','SOURCE-CONTRACTS.md'])if(await fs.access(path.join(here,optional)).then(()=>true,()=>false))sourceNames.push(optional);
async function capture(snapshot){const source=[];for(const name of [...new Set(sourceNames)].sort()){const bytes=await fs.readFile(path.join(here,name));source.push({path:name,bytes:bytes.length,sha256:createHash('sha256').update(bytes).digest('hex')});if(snapshot){const dest=path.join(folder,'sources',name+'.snapshot');await fs.mkdir(path.dirname(dest),{recursive:true});await fs.writeFile(dest,bytes)}}return source;}
const sourceBefore=await capture(true);await fs.writeFile(path.join(folder,'source-before.json'),JSON.stringify(sourceBefore,null,2));const env={...process.env};delete env.NODE_TEST_CONTEXT;const started=new Date().toISOString();let result,failure;
try{result=await child(process.execPath,['--test','--test-reporter=tap',...files.map(f=>path.join(here,f))],{env,deadline:60000,cap:4*1024*1024})}catch(e){failure=e.message;result=e.observation??{code:null,stdout:'',stderr:String(e)}}
await fs.writeFile(path.join(folder,'stdout.txt'),result.stdout);await fs.writeFile(path.join(folder,'stderr.txt'),result.stderr);const sourceAfter=await capture(false);const stable=JSON.stringify(sourceBefore)===JSON.stringify(sourceAfter);const readCount=name=>{const m=new RegExp('^# '+name+' (\\d+)$','m').exec(result.stdout);return m?Number(m[1]):null};
const details=[];for(const name of ['history-original','history-http','history-unknown-time']){const file=path.join(here,'.local/observations/'+name+'.json');if(!await fs.access(file).then(()=>true,()=>false))continue;const bytes=await fs.readFile(file);const item=JSON.parse(bytes);const expectedMarker=name==='history-original'?'REA_KEEPASS_HISTORY_ORIGINAL':name==='history-http'?'REA_KEEPASS_HISTORY_HTTP':'REA_KEEPASS_HISTORY_UNKNOWN';if(!result.stdout.includes(expectedMarker))continue;await fs.writeFile(path.join(folder,name+'.json'),bytes);details.push({path:name+'.json',sha256:createHash('sha256').update(bytes).digest('hex'),originalProcessExecutions:item.originalProcessExecutions,hostProcesses:item.httpObservations?.filter(o=>o.event==='host').length??0});}
const receipt={schema:'rea-stage-keepass-history-validation/v1',label,started,completed:new Date().toISOString(),node:process.version,scope:'Stage-only candidate; authenticated original assembly helpers; exact copied shared host with stage adapter; synthetic DOM interaction, not original or browser GUI.',files,sourceBefore,sourceAfter,sourceStable:stable,tests:{tests:readCount('tests'),pass:readCount('pass'),fail:readCount('fail'),skipped:readCount('skipped'),cancelled:readCount('cancelled')},result:{code:result.code,signal:result.signal,sizes:result.sizes,failure},details,originalProcessExecutions:details.reduce((n,d)=>n+d.originalProcessExecutions,0),hostProcesses:details.reduce((n,d)=>n+d.hostProcesses,0),productionChanges:false,originalGuiExecutions:0,fullProductParity:false,securityParity:false,superiority:false};await fs.writeFile(path.join(folder,'validation.json'),JSON.stringify(receipt,null,2));console.log(JSON.stringify({label,tests:receipt.tests,sourceStable:stable,originalProcessExecutions:receipt.originalProcessExecutions,hostProcesses:receipt.hostProcesses,code:result.code}));if(result.code!==0||!stable||receipt.tests.fail!==0||receipt.tests.skipped!==0)process.exitCode=1;
