    },
    {
      "id": "grafana.candidate.b7d7adb4065d10412a4f",
      "syntaxRole": "list-item",
      "sourceText": "- If SAML is supported by the identity provider, you can configure one [Generic OAuth](generic-oauth/) and one [SAML](saml/) (Enterprise and Cloud).",
      "headingPath": [
        "Configure authentication",
        "Configuring multiple identity providers"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/_index.md",
        "gitBlobSha": "4eaeb6c9573c12f36370a29ae5cde9ef8903af26",
