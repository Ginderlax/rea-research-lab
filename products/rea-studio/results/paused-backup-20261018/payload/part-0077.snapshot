    },
    {
      "id": "grafana.candidate.ab7a9bf3334f56e4ce40",
      "syntaxRole": "list-item",
      "sourceText": "- You can set `group_search_base_dns` to specify where the matching groups are defined.",
      "headingPath": [
        "Configure LDAP authentication",
        "Grafana LDAP Configuration",
        "Nested/recursive group membership"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/ldap/index.md",
        "gitBlobSha": "0a7dd45e5855210e94ce8d5db7a2265b63ba0500",
