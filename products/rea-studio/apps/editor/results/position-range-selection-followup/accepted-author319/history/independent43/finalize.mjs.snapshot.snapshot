import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {root,stage,hash,authenticate,pins} from './authority.mjs';
const authority=await authenticate(),run='runs/2026-10-13T02-16-43.116Z',attempt=JSON.parse(await fs.readFile(path.join(root,run,'attempt.json'))),before=JSON.parse(await fs.readFile(path.join(root,run,'source-before.json'))),after=JSON.parse(await fs.readFile(path.join(root,run,'source-after.json'))),detailBytes=await fs.readFile(path.join(root,run,'observations/comparisons.json')),detail=JSON.parse(detailBytes),audit=JSON.parse(await fs.readFile(path.join(root,'declaration-audit.json'))),author=JSON.parse(await fs.readFile(path.join(stage,'validation.json')));
assert.deepEqual(attempt.summary,{tests:13,pass:12,fail:1,cancelled:0,skipped:0,todo:0});assert.equal(attempt.sourceStable,true);assert.deepEqual(before,after);assert.deepEqual(before.authority,authority);for(const r of before.review){const b=await fs.readFile(path.join(root,r.path));assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);}
const differences=detail.observations.filter(r=>r.exact===false),readonly=detail.observations.filter(r=>r.exactMessageComparisonClaim===false);assert.equal(differences.length,6);assert.ok(differences.every(r=>r.documentedPublicEntry===false&&r.original.ok&&r.candidate.error.name==='TypeError'));assert.equal(readonly.length,9);assert.ok(readonly.every(r=>r.rawMessageEqual===false));assert.equal(detail.counts.pairedExact,173);assert.equal(detail.oracleTelemetry.successful,2);assert.equal(detail.oracleTelemetry.rejected,2);assert.equal(detail.oracleTelemetry.sourceUnitsEvaluated,10);assert.equal(detail.oracleTelemetry.vmEvaluations,12);assert.ok(detail.oracleTelemetry.records.filter(r=>!r.success).every(r=>r.vmEvaluations===0));await assert.rejects(fs.stat(path.join(root,'negative-source-mirror')));
const authorMarkers=[];for(const a of author.allAttempts){const stdout=await fs.readFile(path.join(stage,path.dirname(a.path),'tests.stdout.txt'),'utf8').catch(async()=>fs.readFile(path.join(stage,path.dirname(a.path),'stdout.txt'),'utf8'));const line=stdout.split(/\r?\n/).find(s=>s.startsWith('REA_EDITOR_VALUE_API '));assert.ok(line);const value=JSON.parse(line.slice('REA_EDITOR_VALUE_API '.length));assert.deepEqual(value.counts,a.counts);assert.equal(value.sourceLibraryUnits,5);assert.equal(value.vmEvaluations,6);authorMarkers.push({attempt:a.path,counts:value.counts,sourceLibraryUnits:value.sourceLibraryUnits,vmEvaluations:value.vmEvaluations});}
assert.equal(authorMarkers.reduce((n,r)=>n+r.counts.originalDirectApiAttempts,0),author.originalInvocationAccounting.focusedOriginalDirectActionDispatchAttempts);assert.equal(author.originalInvocationAccounting.successfulSourceLibraryUnitEvaluations,22);assert.equal(author.originalInvocationAccounting.successfulVmScriptEvaluations,26);
const receipt={schema:'rea-editor-position-range-selection-independent-review/v1',at:new Date().toISOString(),status:'finite-documented-behavior-passed-with-two-confirmed-scoped-findings',authority,sourceBeforeAfterExact:true,authorCandidateModified:false,productionModified:false,directDocumentedEntries:30,optionFields:6,inheritedRangeNonConstructorEntries:10,inheritedRangeDistinctNames:9,findings:[...audit.findings,{id:'EDITOR-LEGACY-CONSTRUCTIBILITY-01',severity:'P3 extra-helper compatibility gap',documentedPublicEntry:false,sourceReason:'Official es5ClassCompat uses function expressions; candidate uses shorthand methods.',reproductions:6,originalOutcome:'Reflect.construct(call/apply, args) returns a legacy instance.',candidateOutcome:'TypeError: helper is not a constructor.',evidence:run+'/observations/comparisons.json',ordinaryLegacyControlsPassed:true}],freshRun:{...attempt,sourceRecords:before.review,observations:{path:run+'/observations/comparisons.json',bytes:detailBytes.length,sha256:hash(detailBytes)},counts:detail.counts,exactPairedSemanticObservations:173,unequalExtraHelperPairs:6,readonlyPropertyChecks:9,readonlyRawMessagesEqual:0,readonlySemanticStateAndTypeMatch:true,normalizationApplied:false,corpus:'Fresh reviewer-designed after author freeze; source-informed, not blind. Author packet/corpus not used.',countsAreApiInvocationCensus:false,dispatchQualification:'482 role harness dispatches each combine grouped scenario actions and explicit constructors. Two opposite-role foreign position constructions occur per role. Internal and leaf calls inside grouped actions are not separately counted.'},originalComparison:{independentCompiler:'Authenticated official TypeScript5.9.3 AST/module composition, ES2022 field semantics and legacy decorator compilation; source files authenticated before all VM evaluations.',sourceUnitsPerSuccessfulPreparation:5,vmScriptsPerSuccessfulPreparation:6,successfulPreparations:2,rejectedBeforeExecution:2,sourceUnitsEvaluated:10,vmScriptsEvaluated:12,originalNativeProgramExecutions:0,originalWorkbenchExecutions:0,originalExtensionHostExecutions:0,originalGUIExecutions:0,negativeSourceGate:true,negativeNodeGate:true,executedSourcesRetainedInObservationRecords:true},authorEvidenceAudit:{campaignsReexecuted:false,rawMarkers:authorMarkers,recordedAccounting:author.originalInvocationAccounting,scope:'Retained raw markers + exact source inspection; explicit errors and class bodies authentic. Smoke inline source absence remains the author-disclosed gap.',authorReadonlyNormalization:'Only receiver labels in readonly TypeErrors; raw observations retained. Independent review retains nine unequal labels separately.'},toolingEvents:{spawnDelegation:'Thread limit rejected; no child agent created.',readOnlyPathDiscoveryErrors:audit.initialDiscoveryMistakes,applicationFailuresInferredFromTooling:false},cleanup:{ownedDirectChildExited:true,ownedNegativeMirrorRemoved:true,ownedHTTPHosts:0,ownedBrowserTabs:0,ownedNativeExecutions:0},flags:{allAdvertisedScopeAccepted:false,finiteDocumentedBehaviorChecksPassed:true,allErrorsExact:false,universalSemanticCorrectness:false,shippedExtensionHostParity:false,wholeEditorParity:false,fullExtensionApiCoverage:false,performanceClaim:false,securityEquivalent:false,superiority:false}};
await fs.writeFile(path.join(root,'review-validation.json'),JSON.stringify(receipt,null,2)+'\n');
const inventory={};let total=0;async function walk(p){for(const row of await fs.readdir(p,{withFileTypes:true})){const q=path.join(p,row.name);if(row.isDirectory())await walk(q);else{assert.ok(row.isFile());const rel=path.relative(root,q).replaceAll('\\','/');if(rel==='review-manifest.json')continue;const b=await fs.readFile(q);assert.ok(b.length<=32*1024*1024);total+=b.length;assert.ok(total<=128*1024*1024);inventory[rel]={bytes:b.length,sha256:hash(b)};}}}await walk(root);const rb=await fs.readFile(path.join(root,'review-validation.json')),manifest={schema:'rea-editor-position-range-selection-independent-freeze/v1',at:new Date().toISOString(),strict:true,selfExcluded:'review-manifest.json',files:Object.keys(inventory).length,totalBytes:total,receiptSHA256:hash(rb),inventory};await fs.writeFile(path.join(root,'review-manifest.json'),JSON.stringify(manifest,null,2)+'\n');console.log(JSON.stringify({receiptSHA256:hash(rb),manifestSHA256:hash(await fs.readFile(path.join(root,'review-manifest.json'))),files:manifest.files,totalBytes:total,summary:attempt.summary,confirmedFindings:2,normalizationApplied:false}));
