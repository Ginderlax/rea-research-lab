    {
      "id": "grafana.candidate.e16fc18bd99036a4c394",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In your Grafana instance, go to the [Drilldown](https://www.grafana.com/docs/grafana/latest/explore/simplified-exploration/metrics/) view and experience query-less browsing of Prometheus-compatible metrics.",
      "headingPath": [
        "Get started with Grafana and Prometheus",
        "Check Prometheus metrics in Grafana Metrics Drilldown"
      ],
