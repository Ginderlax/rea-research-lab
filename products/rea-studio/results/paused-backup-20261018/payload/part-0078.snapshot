    },
    {
      "id": "grafana.candidate.4395d16732fea44c4a17",
      "syntaxRole": "list-item",
      "sourceText": "- **SQL expression results may not be immediately visible.** You might need to use the data frame selector (dropdown at the bottom of the table panel) to switch between the raw query and the SQL expression result.",
      "headingPath": [
        "SQL expressions",
        "Workflow to build SQL expressions"
      ],
      "source": {
