    },
    {
      "id": "grafana.candidate.29cb9b6c39bb010541bb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When the `profilesExemplars` feature is enabled, an **Exemplars** toggle appears in the **Options** section. Exemplars link individual profile samples to points on a metrics graph, so you can jump from a spike in a time series to the specific profile that produced it.",
      "headingPath": [
        "Query profile data",
        "Pyroscope query editor",
        "Query options",
        "Exemplars"
      ],
      "source": {
        "path": "docs/sources/datasources/pyroscope/query-editor/index.md",
        "gitBlobSha": "f610ea6b5c725af436b9ddfad56ce462b258b8f0",
