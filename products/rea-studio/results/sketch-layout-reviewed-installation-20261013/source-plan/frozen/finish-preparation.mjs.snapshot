import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{spawnSync}from'node:child_process';const here=import.meta.dirname,workspace=path.resolve(here,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),p=path.join(here,'prepare.mjs'),old=await fs.readFile(p);await fs.mkdir(path.join(here,'failures/preparation-ledger-field-v1'),{recursive:true});await fs.writeFile(path.join(here,'failures/preparation-ledger-field-v1/prepare.mjs.snapshot'),old,{flag:'wx'});const updated=old.toString().replace('prior.originalCapabilityIds','prior.capabilityIds');assert.notEqual(updated,old.toString());await fs.writeFile(p,updated);
const registries=[],sources=[],capabilities=[];for(const name of['workspace-products','visual-products','system-products']){const p='products/rea-studio/requirements/'+name+'.json',b=await fs.readFile(path.join(repo,p)),j=JSON.parse(b);registries.push({path:p,bytes:b.length,sha256:sha(b)});for(const r of j.sources)sources.push({registry:name+'.json',id:r.id,sha256:r.sha256});const caps=name==='workspace-products'?j.capabilities:name==='visual-products'?j.baselineProducts.flatMap(p=>p.requirements):j.products.flatMap(p=>p.capabilities);for(const r of caps)capabilities.push({registry:name+'.json',id:r.id});}const prior=JSON.parse(await fs.readFile(path.join(workspace,'work/vault-recycle-publication-plan/requirements-binding.json')));assert.deepEqual(sources,prior.originalSources);assert.deepEqual(capabilities,prior.capabilityIds);assert.equal(sources.length,159);assert.equal(capabilities.length,232);await fs.writeFile(path.join(here,'requirements-binding.json'),JSON.stringify({schema:'rea-sketch-layout-prospective-requirements-binding/v1',at:new Date().toISOString(),registries,originalSources:sources,originalCapabilityIds:capabilities,counts:{sources:159,capabilities:232},exactHistoricalIdentityProjection:true,registriesModified:false,onlyFiniteSupplementProposed:true},null,2)+'\n',{flag:'wx'});
const diagnosticSource="import fs from'node:fs';import assert from'node:assert/strict';const prior=JSON.parse(fs.readFileSync("+JSON.stringify(path.join(workspace,'work/vault-recycle-publication-plan/requirements-binding.json'))+"));assert.deepEqual(prior.capabilityIds,prior.originalCapabilityIds);";const diagPath=path.join(here,'failures/preparation-ledger-field-v1/reproduce-field-error.mjs');await fs.writeFile(diagPath,diagnosticSource,{flag:'wx'});const raw=spawnSync(process.execPath,[diagPath],{encoding:'utf8',windowsHide:true,maxBuffer:2*1024*1024});assert.equal(raw.status,1);await fs.writeFile(path.join(here,'failures/preparation-ledger-field-v1/reproduced.stdout.txt'),raw.stdout);await fs.writeFile(path.join(here,'failures/preparation-ledger-field-v1/reproduced.stderr.txt'),raw.stderr);await fs.writeFile(path.join(here,'failures/preparation-ledger-field-v1/diagnostic.json'),JSON.stringify({originalPreparationExit:1,reproductionExit:raw.status,sourceSHA256:sha(old),cause:'Referenced prior.originalCapabilityIds; frozen previous binding actually names the unchanged232-row field capabilityIds. The159 sourceID/SHA assertion had already passed.',raw:'Reproduced exact bad-field comparison against same frozen prior binding; first tool output was truncated.',productFailure:false,productionMutations:0,correctedComparison232Exact:true,otherMetadataReadDiagnostics:['Unsuffixed run.mjs guessed absent; actual collector run-focused.mjs found.','PowerShell literal glob passed to rg rejected; directory -g fallback worked.','Requirements guessed at repo root absent; actual products/rea-studio/requirements used.']},null,2)+'\n');
const aliases=JSON.parse(await fs.readFile(path.join(here,'public-alias-copy-list.json'))),prov=await fs.readFile(path.join(workspace,'work/sketch-layout-precision-next/source-provenance.json'));await fs.writeFile(path.join(here,'prepare-validation.json'),JSON.stringify({schema:'rea-sketch-layout-publication-plan-preparation/v2',at:new Date().toISOString(),epochs:aliases.epochs,publicAliases:661,liveFiles:8,newTestGroups:11,focusedProspectiveGroups:30,expandedProspectiveGroups:39,sourceOnly:true,syntaxChecks:7,testsExecuted:0,originalHelpersExecuted:0,browser:0,benchmarks:0,productionMutations:0,actualIntegrationAcceptance:false,provenancePin:sha(prov),preparationMetadataFailures:1,preparationCorrection:'Prior registry capability field name only; exact source159/caps232 projections validated.'},null,2)+'\n',{flag:'wx'});console.log('PLAN PARTIAL PREPARATION COMPLETED; SOURCES159/CAPS232 EXACT');
