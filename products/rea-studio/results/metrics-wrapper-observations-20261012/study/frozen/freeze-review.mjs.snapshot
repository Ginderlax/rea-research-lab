import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),sha=bytes=>createHash('sha256').update(bytes).digest('hex'),fp=async file=>{const bytes=await fs.readFile(file);return {bytes:bytes.length,sha256:sha(bytes)};};
async function list(root,relative=''){let names=[];for(const item of await fs.readdir(path.join(root,relative),{withFileTypes:true})){assert.ok(!item.isSymbolicLink());const name=path.posix.join(relative,item.name);if(item.isDirectory())names.push(...await list(root,name));else if(item.isFile())names.push(name);}return names.sort();}
const manifestPath=path.join(here,'freeze-manifest.json');
if(process.argv.includes('--verify-only')){const freeze=JSON.parse(await fs.readFile(manifestPath));assert.deepEqual((await list(here)).filter(name=>name!=='freeze-manifest.json'),Object.keys(freeze.inventory).sort());for(const [name,record]of Object.entries(freeze.inventory))assert.deepEqual(await fp(path.join(here,name)),record);assert.equal((await fp(path.join(here,'measurement-validation.json'))).sha256,freeze.receiptSHA256);console.log(JSON.stringify({status:'frozen exact inventory verified',files:freeze.files,manifestSHA256:(await fp(manifestPath)).sha256,receiptSHA256:freeze.receiptSHA256}));}
else{const receipt=JSON.parse(await fs.readFile(path.join(here,'measurement-validation.json')));assert.equal(receipt.performanceAcceptance,false);assert.equal(receipt.candidateIntegrated,false);assert.equal(receipt.counts.timingChildren,147);assert.equal(receipt.counts.memoryChildren,147);assert.equal(receipt.failureAndCensoring.consolidationFailures.length,1);for(const record of Object.values(receipt.productionBindings))assert.deepEqual(await fp(record.sourcePath),{bytes:record.bytes,sha256:record.sha256});const inventory={};for(const name of await list(here)){assert.notEqual(name,'freeze-manifest.json');assert.ok(!name.split('/').some(part=>['.local','work','artifacts','tooling','node_modules'].includes(part)));assert.ok(!/\.(?:tgz|exe)$/i.test(name));inventory[name]=await fp(path.join(here,name));}const freeze={schema:'rea-metrics-wrapper-measurement-review-freeze/v1',frozenAt:new Date().toISOString(),receiptSHA256:(await fp(path.join(here,'measurement-validation.json'))).sha256,files:Object.keys(inventory).length,aggregateBytes:Object.values(inventory).reduce((sum,row)=>sum+row.bytes,0),inventory,sourceOnly:true,priorNegativeTreeRecopied:false,performanceAcceptance:false,candidateIntegrated:false};await fs.writeFile(manifestPath,JSON.stringify(freeze,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:'frozen',files:freeze.files,aggregateBytes:freeze.aggregateBytes,receiptSHA256:freeze.receiptSHA256,manifestSHA256:(await fp(manifestPath)).sha256}));}
