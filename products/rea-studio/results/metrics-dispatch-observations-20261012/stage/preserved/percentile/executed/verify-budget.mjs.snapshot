  const build=()=>({type:'number',config:{nullValueMode:'connected'},values:values.slice(),state:{}}),expectedField=build(),actualField=build();
  assert.deepEqual(native.reduceField({field:actualField,reducers:[id]}),original.reduceField({field:expectedField,reducers:[id]}),label+':'+id);assert.deepEqual(actualField.values,values);assert.deepEqual(actualField.state,expectedField.state);comparisons++;
}
const {result}=await post('Profiler.takePreciseCoverage');await post('Profiler.stopPreciseCoverage');session.disconnect();
const entry=result.find(row=>row.url===candidateURL),selector=entry?.functions.find(row=>row.functionName==='selectFinitePercentile'),marker=source.indexOf('return selectionUnavailable;',source.indexOf('if (++work > budget)'));
// Detailed coverage proves whether the independently checked corpus entered the
