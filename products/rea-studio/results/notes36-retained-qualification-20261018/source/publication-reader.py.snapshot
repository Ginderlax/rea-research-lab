 with gzip.GzipFile(fileobj=io.BytesIO(stored)) as stream: decoded=stream.read(8*1024*1024+1)
 need(len(decoded)<=8*1024*1024,'Fixed gzip decoded boundary');envelope=parsed(decoded);declared=attempt[receipt_key]
