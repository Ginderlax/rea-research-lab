    },
    {
      "id": "grafana.candidate.c08910fa0ad52fbf1e01",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Values for dashboard variables can be now populated using the [Graphite expand API](https://graphite-api.readthedocs.io/en/latest/api.html#metrics-expand). Expand API is used when the metric query is wrapped in expand() function.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Grafana OSS features",
        "Data source updates",
        "Graphite data source",
        "Variable metric names expand"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-0.md",
        "gitBlobSha": "08364874bf79c35cb3f0d907a16891c4cfb0eb1c",
        "sha256": "6f07cb510f8b0da003b838c600c8c34236d365c4cc7688913f7fe726f50a0fd7",
        "lineStart": 244,
        "lineEnd": 244,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v8-0.md#L244-L244"
      },
      "applicability": {
