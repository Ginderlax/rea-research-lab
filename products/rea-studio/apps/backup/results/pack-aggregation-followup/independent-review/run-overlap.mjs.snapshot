import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import {spawnSync} from 'node:child_process';
const here=path.dirname(fileURLToPath(import.meta.url)),sha=bytes=>createHash('sha256').update(bytes).digest('hex'),source=path.join(here,'overlap-reproduction.mjs'),sourceBefore=sha(await fs.readFile(source)),start=new Date().toISOString();
const child=spawnSync(process.execPath,[source],{encoding:'utf8',timeout:10000,maxBuffer:1024*1024,windowsHide:true}),stdout=child.stdout??'',stderr=child.stderr??'',stem='overlap-attempt-'+Date.now();
await fs.writeFile(path.join(here,stem+'.stdout.txt'),stdout,{flag:'wx'});await fs.writeFile(path.join(here,stem+'.stderr.txt'),stderr,{flag:'wx'});
const receipt={schemaVersion:1,interval:{start,end:new Date().toISOString()},exitCode:child.status,error:child.error?.message,sourceBefore,sourceAfter:sha(await fs.readFile(source)),stdout:{path:stem+'.stdout.txt',bytes:Buffer.byteLength(stdout),sha256:sha(stdout)},stderr:{path:stem+'.stderr.txt',bytes:Buffer.byteLength(stderr),sha256:sha(stderr)},originalRuntimeExecutions:0,productionChanged:false};
await fs.writeFile(path.join(here,stem+'.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({...receipt,stdoutText:stdout,stderrText:stderr}));if(child.status!==0)process.exitCode=1;
