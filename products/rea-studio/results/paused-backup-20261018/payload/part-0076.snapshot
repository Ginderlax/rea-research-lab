        "lineStart": 182,
        "lineEnd": 182,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/mssql/template-variables/index.md#L182-L182"
      },
      "applicability": {
