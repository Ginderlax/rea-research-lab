import test from 'node:test';import assert from 'node:assert/strict';import path from 'node:path';import fs from 'node:fs/promises';import {spawnSync} from 'node:child_process';import {here} from './authenticate-original.mjs';import {canonical} from './canonical.mjs';
test('expected packets preserve numeric edges, holes and shared cache identities',()=>{assert.notEqual(canonical(-0),canonical(0));assert.notEqual(canonical({a:undefined}),canonical({}));assert.notEqual(canonical(Array(2)),canonical([undefined,undefined]));const a=[1],b={allValues:a};assert.notEqual(canonical({result:b,cache:b}),canonical({result:b,cache:{allValues:a}}));assert.notEqual(canonical({result:b,cache:{allValues:a}}),canonical({result:b,cache:{allValues:[1]}}));});
test('both native modules and source import graph bind the candidate as one implementation',async()=>{const manifest=JSON.parse(await fs.readFile(path.join(here,'memory-preflight.control.json'))),binding=manifest.implementations.candidate;assert.equal(Object.keys(binding.files).length,2);assert.deepEqual(Object.keys(binding.nativeImportGraph).sort(),Object.keys(binding.files).sort());const entry=await fs.readFile(binding.entry,'utf8');assert.match(entry,/import \{ singlePercentile, preparePercentileValues \} from '\.\/selector-algorithm\.mjs';/);assert.equal((entry.match(/^import /gm)??[]).length,1);assert.equal((await fs.readFile(path.join(here,'selector-algorithm.mjs'),'utf8')).includes('import '),false);});
test('all measuring branches reject stale, non-ISO and future authorization before workloads',()=>{for(const time of ['1999-01-01T00:00:00Z','October 1, 2001','2099-01-01T00:00:00Z'])for(const args of [[path.join(here,'memory-worker.mjs'),'measure','original','smallStandard',time,'control'],[path.join(here,'memory-runner.mjs'),'--quiet-confirmed',time,'control'],[path.join(here,'timing-worker.mjs'),'measure','original','smallStandard',time],[path.join(here,'timing-runner.mjs'),'--quiet-confirmed',time],[path.join(here,'benchmark.mjs'),'--quiet-confirmed',time]]){const child=spawnSync(process.execPath,args,{encoding:'utf8',timeout:10000,windowsHide:true});assert.notEqual(child.status,0);assert.equal(child.stdout,'');assert.match(child.stderr,/quiet timestamp|quiet.*preflight/);}});
test('owned observer parses without starting observation or a memory workload',()=>{const child=spawnSync('powershell.exe',['-NoProfile','-NonInteractive','-File',path.join(here,'parse-observer.ps1'),'-SourceFile',path.join(here,'watch-owned-process.ps1')],{encoding:'utf8',timeout:10000,windowsHide:true});assert.equal(child.status,0,child.stderr);});
