import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{fileURLToPath}from'node:url';
const studio=fileURLToPath(new URL('../',import.meta.url)),repo=path.resolve(studio,'../..'),prefix='products/rea-studio/results/editor-save-followup/',hash=b=>createHash('sha256').update(b).digest('hex'),requireCurrent=process.argv.includes('--require-current');
function confined(rel){assert.equal(typeof rel,'string');assert(!path.isAbsolute(rel)&&!rel.split(/[\\/]/).some(s=>s==='..'||s==='.local'));const absolute=path.resolve(repo,rel);assert(absolute.startsWith(repo+path.sep));return absolute;}
async function bytes(rel){return fs.readFile(confined(rel));}async function fp(rel){const b=await bytes(rel);return{bytes:b.length,sha256:hash(b)};}async function exact(rel,expected){const value=await fp(rel);assert.deepEqual(value,{bytes:expected.bytes,sha256:expected.sha256},rel);return value;}const json=async rel=>JSON.parse(await bytes(rel));
const planRoot=prefix+'publication-plan/frozen/',pb=await bytes(planRoot+'freeze-manifest.json.snapshot');assert.equal(hash(pb),'3df49c5e2c5b28433876d8cbd759eed74375031d92db8aa43af761fbada32c91');const pm=JSON.parse(pb);assert.equal(pm.files,21);assert.equal(Object.keys(pm.inventory).length,21);for(const[rel,r]of Object.entries(pm.inventory))await exact(planRoot+rel+'.snapshot',r);const plan=await json(planRoot+'selected-file-map.json.snapshot'),census=await json(planRoot+'source-test-census.json.snapshot'),selector=await json(planRoot+'proposed-focused-selection.json.snapshot');assert.equal(plan.payload.length,516);assert.equal(plan.uniquePublicBlobs,174);assert.equal(plan.reusedPublicBlobs,73);assert.equal(plan.newPublicBlobs,101);assert.equal(plan.excluded.length,0);assert.equal(census.files.length,15);assert.equal(selector.expandedEditorSelection.length,15);assert.equal(census.totalProspectiveRegistrations,78);
const installationPath=prefix+'production-installation/installation.json.snapshot',ib=await bytes(installationPath);assert.equal(hash(ib),'498973b4e5f9fdcfa1df8d43b069a340836ece2c9d218f8d3dde0b1808c44907');const installation=JSON.parse(ib);assert.equal(installation.installed.length,8);assert.equal(installation.copies.length,538);await exact(prefix+'production-installation/collector.mjs.snapshot',{bytes:5439,sha256:'d9fabf3f697c7dba5d7ce04218bffb49a785fc2653f1f07aab1ad3ee74734593'});
const copiedBySource=new Map(installation.copies.map(r=>[r.sourceRoot+'/'+r.sourcePath,r])),objects=new Map();const nativeHeaders=['4d5a','504b0304','504b0506','1f8b','377abcaf271c','fd377a585a00','28b52ffd','03d9a29a67fb4bb5'];
for(const r of installation.copies)await exact(r.path,r);for(const r of plan.payload){assert(r.publicPath);const copy=copiedBySource.get(r.sourceRoot+'/'+r.sourcePath);assert(copy);assert.equal(copy.path,r.publicPath);assert.equal(copy.sha256,r.sha256);assert.equal(copy.bytes,r.bytes);if(!objects.has(r.sha256)){const b=await bytes(r.publicPath);assert(!nativeHeaders.some(h=>b.subarray(0,h.length/2).toString('hex')===h));objects.set(r.sha256,{path:r.publicPath,bytes:r.bytes});}}assert.equal(objects.size,174);
for(const e of plan.epochs){const manifestRow=plan.payload.find(r=>r.epoch===e.id&&r.sourcePath==='freeze-manifest.json');assert(manifestRow);assert.equal(manifestRow.sha256,e.manifest.sha256);const em=await json(manifestRow.publicPath);assert.equal(Object.keys(em.inventory).length,e.count);for(const[rel,r]of Object.entries(em.inventory)){const row=plan.payload.find(p=>p.epoch===e.id&&p.sourcePath===rel);assert(row);assert.equal(row.bytes,r.bytes);assert.equal(row.sha256,r.sha256);}}
const historicalPrior=prefix+'prior-search-installation/installation.json.snapshot';await exact(historicalPrior,{bytes:7067,sha256:'6fce8ca3c3614000b897885ceb64896c659b67879199f2f6f0e963011a8f2057'});await exact(prefix+'prior-search-installation/collector.mjs.snapshot.snapshot',{bytes:5974,sha256:'edad5d12081871f45bf6c0d59f3cc308cbe85b7e2cecd8c9645da468ac74834b'});assert.equal((await json(historicalPrior)).copies.length,13);
const currentRoot=prefix+'current-integration/frozen/',cm=await json(currentRoot+'freeze-manifest.json.snapshot');assert.equal(Object.keys(cm.inventory).length,cm.files);for(const[rel,r]of Object.entries(cm.inventory))await exact(currentRoot+rel+'.snapshot',r);const current=await json(currentRoot+'validation.json.snapshot');assert.equal(hash(await bytes(currentRoot+'validation.json.snapshot')),cm.receiptSHA256);assert.deepEqual(current.counts,{tests:78,pass:78,fail:0,cancelled:0,skipped:0,todo:0});assert.equal(current.status,'passed-finite-current-editor-selection');assert.equal(current.sourceStable,true);assert.equal(current.currentSources.length,31);assert.equal(current.selectedTestFiles,15);assert.deepEqual(current.selectedTests,selector.expandedEditorSelection);assert.equal(current.originalEditorEngineOrWorkbenchExecutions,0);assert.equal(current.benchmarks,0);assert.equal(current.metadataCorrection.oldProseFiles,16);assert.equal(current.metadataCorrection.actualBoundSelectionFiles,15);
await exact(currentRoot+current.raw.stdout.path+'.snapshot',current.raw.stdout);await exact(currentRoot+current.raw.stderr.path+'.snapshot',current.raw.stderr);const tap=(await bytes(currentRoot+current.raw.stdout.path+'.snapshot')).toString('utf8');for(const[k,v]of Object.entries(current.counts))assert.equal(Number(tap.match(new RegExp('^# '+k+' (\\d+)$','m'))?.[1]),v);
const liveMismatches=[];for(const r of current.currentSources){await exact(currentRoot+r.snapshot+'.snapshot',r);const live=await fp(r.path).catch(e=>{if(e.code==='ENOENT')return null;throw e;});if(!live||live.sha256!==r.sha256||live.bytes!==r.bytes)liveMismatches.push({path:r.path,testedSha256:r.sha256,liveSha256:live?.sha256??null});}for(const r of installation.installed){const tested=current.currentSources.find(s=>s.path===r.destination);assert(tested);assert.deepEqual({bytes:tested.bytes,sha256:tested.sha256},r.after);}if(requireCurrent)assert.deepEqual(liveMismatches,[],'Current implementation differs from the source-bound78 receipt; historical snapshots remain separate.');
console.log(JSON.stringify({schema:'rea-editor-save-public-followup-verification/v1',passed:true,publicObjects:174,epochRecords:516,epochInventoryCounts:plan.epochs.map(e=>e.count),planInventory21PublicSnapshots22:true,installed8Authenticated:true,currentReceiptTests78:true,selectedFiles15:true,old16FileProsePreservedWithExplicitCorrection:true,currentSourceSnapshots:31,liveSourceMatch:liveMismatches.length===0,liveMismatches,requireCurrent,historicalPriorSearchInstallation13:true,historicalReceiptsNotRebound:true,behavioralTestsExecuted:0,originalEditorEngineExecutions:0,benchmarks:0}));
