    },
    {
      "id": "grafana.candidate.3c27033cc46f395de4a4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Using the `grafana_asserts_prom_rule_file` resource, you can manage these rules as code, enabling version control, review processes, and consistent deployments across environments.",
