const result=await new Promise(resolve=>{const child=spawn(exe,args,{env:{...process.env,ELECTRON_RUN_AS_NODE:'1',VSCODE_DEV:'',VSCODE_CLI:'1'},cwd:root,shell:false,windowsHide:true,stdio:['ignore','pipe','pipe']}),out=[],err=[];let count=0,failure=null;for(const[stream,parts]of [[child.stdout,out],[child.stderr,err]])stream.on('data',b=>{count+=b.length;if(count>1024*1024){failure??='1MiB combined-output bound';child.kill('SIGKILL');}else parts.push(b);});const timer=setTimeout(()=>{failure??='30-second identity child deadline';child.kill('SIGKILL');},30000);child.on('error',e=>failure??=e.message);child.on('close',(exitCode,signal)=>{clearTimeout(timer);resolve({exitCode,signal,failure,stdout:Buffer.concat(out),stderr:Buffer.concat(err)});});});
await fs.writeFile(path.join(root,'identity.stdout.txt'),result.stdout,{flag:'wx'});await fs.writeFile(path.join(root,'identity.stderr.txt'),result.stderr,{flag:'wx'});const lines=result.stdout.toString().trim().split(/\r?\n/);assert.equal(result.exitCode,0);assert.equal(result.failure,null);assert.deepEqual(lines,['1.140.0','07f806f999227108933c2e30515b26eecc1fda74','x64']);assert.ok((await fs.readFile(cli)).equals(cliBefore));assert.ok((await fs.readFile(exe)).equals(executableBytes));
const receipt={schema:'rea-complete-vscode-original-identity/v1',startedAtUtc,completedAtUtc:new Date().toISOString(),product:'Microsoft Visual Studio Code',release:'1.140.0',architecture:'x64',commit:product.commit,executableSHA256:sha(executableBytes),signatureStatus:signature.signatureStatus,signerSubject:signature.signerSubject,packageSHA256:sha(packageBytes),productManifestSHA256:sha(productBytes),cliSourceSHA256:sha(cliBefore),actualOriginalCLIIdentityProcesses:1,originalGUISessions:0,originalEditorBehaviorComparisons:0,arguments:args,exitCode:result.exitCode,stdoutSHA256:sha(result.stdout),stderrSHA256:sha(result.stderr),sourceBytesStable:true,isolatedUserDataAndExtensions:true,userInstalledEditorOrUserDataModified:false,fullReleaseDocumentationCoverage:false,priorMonacoStudyRebound:false,fullProductParity:false,universalSuperiority:false};await fs.writeFile(path.join(root,'identity-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(receipt));
