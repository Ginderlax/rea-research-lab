    {
      "id": "grafana.candidate.fa76d29ba2c964954ed6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To set up Generic OAuth authentication with Descope, follow these steps:",
      "headingPath": [
        "Configure Generic OAuth authentication",
        "Examples of setting up Generic OAuth",
        "Set up OAuth2 with Descope"
      ],
