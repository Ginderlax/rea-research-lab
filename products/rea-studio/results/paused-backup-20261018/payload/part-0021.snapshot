def tarrows(raw):
    with tarfile.open(fileobj=io.BytesIO(raw),mode='r:')as t:
        members=t.getmembers();assert all(m.isfile()for m in members)and len({m.name for m in members})==len(members);return {m.name:t.extractfile(m).read()for m in members}
native=bykind['new-task-actual-jex-native-tar-and-resource-download'];newtar=tarrows(next(browser[x['path']]for x in downloads if x['path'].endswith('.jex')))
original=tarrows(browser['composition-source/'+P+'apps/notes/fixtures/pinned-joplin.jex.snapshot'])
assert len(original)==8 and len(newtar)==9
for n,raw in original.items():assert newtar[n]==raw
assert len([n for n in original if n.endswith('.md')])==7
newname=native['noteId'].replace('-','')+'.md';newtext=newtar[newname].decode();parts=newtext.split('\n\n');assert parts[0]=='New task alongside original records' and parts[1]=='Preserved new task body'
for line in ['parent_id: 11111111111111111111111111111111','is_todo: 1','todo_due: 0','todo_completed: 0','type_: 1']:assert line in newtext.splitlines()
resource=next(browser[x['path']]for x in downloads if x['path'].endswith('.bin'));assert resource==bytes([0,1,2,3,255])
pngs=[raw for n,raw in browser.items()if n.startswith('screenshots/')and n.endswith('.png')];assert len(pngs)==8
for raw in pngs:
    assert raw[:8]==b'\x89PNG\r\n\x1a\n';pos=8;seen=[]
    while pos<len(raw):
        length=struct.unpack('>I',raw[pos:pos+4])[0];kind=raw[pos+4:pos+8];chunk=raw[pos+8:pos+8+length];crc=struct.unpack('>I',raw[pos+8+length:pos+12+length])[0];assert zlib.crc32(kind+chunk)&0xffffffff==crc;seen.append(kind);pos+=12+length
    assert pos==len(raw) and seen[0]==b'IHDR' and seen[-1]==b'IEND'
