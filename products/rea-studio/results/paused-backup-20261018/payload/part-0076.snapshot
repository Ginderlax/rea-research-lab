      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.af76030a8448c102a62e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Select **Table** or **Time Series** as the format. Click the **{}** in the bottom right to format the query. Click the **downward caret** to expand the Code mode editor. **CTRL/CMD + Return** serves as a keyboard shortcut to execute the query.",
      "headingPath": [
        "MySQL query editor",
        "MySQL Code mode"
      ],
      "source": {
        "path": "docs/sources/datasources/mysql/query-editor/_index.md",
