    {
      "id": "grafana.candidate.2ae5df897738793f4050",
      "syntaxRole": "table-row",
      "sourceText": "| **Metrics vs. Logs**           | **Metrics** are lightweight numeric values collected at regular intervals (for example, CPU percentage). **Logs** are detailed records of events with varying schemas (for example, request logs, error messages). Metrics use a visual query builder; Logs require KQL.                                                                  |",
      "headingPath": [
        "Azure Monitor query editor",
        "Key concepts"
      ],
