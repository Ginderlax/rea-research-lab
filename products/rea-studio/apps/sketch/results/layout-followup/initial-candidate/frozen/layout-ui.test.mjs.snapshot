import test from 'node:test';import assert from 'node:assert/strict';import {harness,nodes,find,draw} from './layout-ui-fixture.mjs';import {handle} from './products/rea-studio/apps/sketch/server.mjs';
const fixture={name:'Three boxes',shapes:[{id:'a',type:'rect',x:0,y:20,w:20,h:10},{id:'b',type:'rect',x:100,y:80,w:30,h:20},{id:'c',type:'rect',x:300,y:160,w:40,h:30}],view:{x:25,y:25,zoom:1}};
async function importScene(root,scene=fixture){find(root,'textarea').value=JSON.stringify(scene);await find(root,'button','Import JSON as new scene').click();}
test('six real alignment buttons arrange editable selection and preserve one-step undo/redo',()=>harness(async({root,state})=>{for(const [label,key,end] of [['Align left','x','start'],['Center horizontally','x','center'],['Align right','x','end'],['Align top','y','start'],['Center vertically','y','center'],['Align bottom','y','end']]){await importScene(root);await find(root,'button','Select all').click();const before=state();await find(root,'button',label).click();const after=state(),extent=key==='x'?'w':'h',values=after.shapes.map(s=>s[key]+(end==='start'?0:end==='end'?s[extent]:s[extent]/2));assert.ok(values.every(v=>v===values[0]));await find(root,'button','Undo').click();assert.deepEqual(state(),before);await find(root,'button','Redo').click();assert.deepEqual(state(),after);}}));
test('distribution buttons and pinned keyboard shortcuts apply, persist and reopen real server data',()=>harness(async({root,canvas,state,store})=>{await importScene(root);await find(root,'button','Select all').click();await find(root,'button','Distribute horizontally').click();assert.equal(state().shapes[1].x,145);await canvas.event('keydown',{ctrlKey:true,shiftKey:true,key:'ArrowUp',code:'ArrowUp'});assert.ok(state().shapes.every(s=>s.y===20));await importScene(root);await find(root,'button','Select all').click();await find(root,'button','Distribute vertically').click();assert.equal(state().shapes[1].y,85);await find(root,'button','Undo').click();assert.equal(state().shapes[1].y,80);await find(root,'button','Select all').click();await canvas.event('keydown',{altKey:true,key:'v',code:'KeyV'});assert.equal(state().shapes[1].y,85);await canvas.event('keydown',{altKey:true,key:'h',code:'KeyH'});assert.equal(state().shapes[1].x,145);await find(root,'button','Save').click();const saved=(await handle({action:'list',store})).scenes[0],expected=state();await find(root,'button','New scene').click();const picker=find(root,'select');picker.value=saved.id;await picker.event('change');assert.deepEqual(state().shapes,expected.shapes);const native=(await handle({action:'exportExcalidraw',input:{id:saved.id},store})).document;assert.deepEqual(native.elements.map(e=>({id:e.id,x:e.x,y:e.y})),expected.shapes.map(e=>({id:e.id,x:e.x,y:e.y})));}));
test('arranging a selected group alone creates no undo entry and active gestures refuse layout',()=>harness(async({root,canvas,state})=>{const initial=state();await importScene(root,{...fixture,shapes:fixture.shapes.slice(0,2).map(s=>({...s,groupIds:['g']}))});const before=state();await find(root,'button','Select all').click();await find(root,'button','Align left').click();assert.deepEqual(state(),before);assert.ok(nodes(root).some(n=>n.textContent==='Select at least two separate shapes or groups'));await find(root,'button','Undo').click();assert.deepEqual(state(),initial);await find(root,'button','Redo').click();assert.deepEqual(state(),before);await find(root,'button','Select all').click();await find(root,'button','Ungroup').click();await find(root,'button','Select').click();await canvas.event('pointerdown',{clientX:30,clientY:50});const during=state();await find(root,'button','Align right').click();assert.deepEqual(state(),during);assert.ok(nodes(root).some(n=>n.textContent==='Finish the current gesture before arranging shapes'));await canvas.event('pointercancel');}));
