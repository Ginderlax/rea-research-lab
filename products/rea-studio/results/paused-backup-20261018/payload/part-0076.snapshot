      "id": "grafana.candidate.2ab9c61c10865fd90568",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The standalone plugin requires Grafana 12.3.0 or later. The Prometheus data source bundled with Grafana 13.1 and earlier continues to work as before, and those versions aren't affected by this change.",
