    {
      "id": "grafana.candidate.8d153ebade44cc5c5faa",
      "syntaxRole": "table-row",
      "sourceText": "| Resolve Transition      | The transition name to move the issue to a resolved state when an alert is resolved. Ensure that the value matches a valid transition available in your Jira workflow for the specified issue type. If this field is empty, the issue will not be transitioned to Done.                                               |",
      "headingPath": [
        "Configure Jira for Alerting",
        "Configure Jira for a contact point",
        "Optional Settings"
      ],
      "source": {
        "path": "docs/sources/alerting/configure-notifications/manage-contact-points/integrations/configure-jira.md",
