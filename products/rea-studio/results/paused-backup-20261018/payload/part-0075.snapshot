    },
    {
      "id": "grafana.candidate.36cd4bceb3eb60fdfaf0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To modify permissions, each provisioned folder must include the `_folder.json` metadata file, which gives the folder a stable UID. Without it, the folder's permissions are lost if you move or rename that folder in the Git repository. Refer to [The Git Sync folder metadata file](#the-git-sync-folder-metadata-file) for details about this file and why it exists.",
      "headingPath": [
        "Work with provisioned repositories in Git Sync",
        "Manage folder permissions",
        "Modify folder permissions"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/git-sync/use-git-sync.md",
        "gitBlobSha": "8d06cc9339a384d33e81204a50e24fc585e5f61d",
        "sha256": "f80c982f721ef3b85587eca12c6e547bad8659ff5609fc020a26f14461ee2368",
        "lineStart": 119,
        "lineEnd": 119,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/as-code/observability-as-code/git-sync/use-git-sync.md#L119-L119"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss",
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.98767512590dda3d7245",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Folder permissions attach to the folder's UID (stored in `_folder.json`), not to its repository path, so you can only set them after Git Sync has created the folder. To add or modify folder permissions:",
      "headingPath": [
        "Work with provisioned repositories in Git Sync",
        "Manage folder permissions",
        "Modify folder permissions"
      ],
