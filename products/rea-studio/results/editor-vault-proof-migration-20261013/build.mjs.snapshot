import assert from 'node:assert/strict';
import {readFileSync,writeFileSync,mkdirSync} from 'node:fs';
import {resolve,dirname} from 'node:path';
import {createHash} from 'node:crypto';
const stage=resolve(import.meta.dirname),repo=resolve(stage,'../../outputs/rea-research-lab'),acq=JSON.parse(readFileSync(resolve(stage,'acquisition.json'))),sha=b=>createHash('sha256').update(b).digest('hex'),fp=b=>({bytes:b.length,sha256:sha(b)});
const changes=[];
function patch(name,edits){const original=readFileSync(resolve(stage,'verifier-before',name+'.snapshot'),'utf8');let text=original;for(const [before,after]of edits){assert.equal(text.split(before).length-1,1,name+' unique substitution');text=text.replace(before,after);changes.push({path:'scripts/'+name,before,after,occurrences:1});}writeFileSync(resolve(stage,'candidate/scripts',name),text);}
const imp="import {createEditorVaultProofMigration,createEditorVaultProofMigrationFromRoot} from './editor-vault-proof-migration.mjs';\n";
