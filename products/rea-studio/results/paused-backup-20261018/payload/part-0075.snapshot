    {
      "id": "grafana.candidate.76a7a3238ed7d640ff79",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana Alerting does not support forwarding Grafana-managed alerts to the AlertManager in Amazon Managed Service for Prometheus. For more details, refer to [this GitHub issue](https://github.com/grafana/grafana/issues/64064).",
      "headingPath": [
