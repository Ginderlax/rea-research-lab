import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import {zstdDecompressSync} from 'node:zlib';
import {hash,open,passwordKey,masterKey,base64} from './restic-crypto.mjs';
import {handleNative} from './restic.mjs';
const baseline=new Map();
function json(key,bytes){const plain=open(key,bytes);return JSON.parse(plain[0]===2?zstdDecompressSync(plain.subarray(1)):plain);}
async function inventory(workspace,password){const names=await fs.readdir(workspace.resolve('native/keys')),doc=JSON.parse(await fs.readFile(workspace.resolve(`native/keys/${names[0]}`))),key=masterKey(JSON.parse(open(await passwordKey(doc,password),base64(doc.data)))),packs=new Map();for(const indexID of await fs.readdir(workspace.resolve('native/index'))){const bytes=await fs.readFile(workspace.resolve(`native/index/${indexID}`));assert.equal(hash(bytes),indexID);for(const pack of json(key,bytes).packs){assert.equal(packs.has(pack.id),false,'Owned fixture should have disjoint index rows');const bytes=await fs.readFile(workspace.resolve(`native/data/${pack.id.slice(0,2)}/${pack.id}`));assert.equal(hash(bytes),pack.id);const length=bytes.readUInt32LE(bytes.length-4),start=bytes.length-4-length,header=open(key,bytes.subarray(start,-4)),blobs=[...pack.blobs].sort((a,b)=>a.offset-b.offset);let offset=0,pos=0;for(const blob of blobs){const type=header[pos],width=type>=2?41:37;assert.equal(blob.offset,offset);assert.equal(blob.type,type%2?'tree':'data');assert.equal(blob.length,header.readUInt32LE(pos+1));assert.equal(blob.id,header.subarray(pos+(type>=2?9:5),pos+width).toString('hex'));if(type>=2)assert.equal(blob.uncompressed_length,header.readUInt32LE(pos+5));else assert.equal(blob.uncompressed_length,undefined);let data=open(key,bytes.subarray(offset,offset+blob.length));if(blob.uncompressed_length)data=zstdDecompressSync(data,{maxOutputLength:blob.uncompressed_length});assert.equal(data.length,blob.uncompressed_length??blob.length-32);assert.equal(hash(data),blob.id);offset+=blob.length;pos+=width;}assert.equal(pos,header.length);assert.equal(offset,start);assert.ok(blobs.every(blob=>blob.type===blobs[0].type));packs.set(pack.id,{id:pack.id,bytes:bytes.length,type:blobs[0].type,blobs});}}return [...packs.values()].sort((a,b)=>a.id.localeCompare(b.id));}
function shape(packs){return packs.filter(p=>p.type==='data').map(p=>({id:p.id,bytes:p.bytes,blobs:p.blobs}));}
export async function verifyStructure({workspace,snapshot,password}){const packs=await inventory(workspace,password),data=shape(packs);assert.equal(packs.length,snapshot.newPacks,'Reported completed packs must equal authenticated index/physical packs in initial repository');assert.ok(packs.filter(p=>p.type==='tree').every(p=>p.blobs.length===1));const inspected=await handleNative({action:'nativeInspect',input:{repository:'native',password,id:snapshot.id},workspace}),expected=[...new Set(inspected.entries.filter(e=>e.type==='file').flatMap(e=>e.content))].sort(),rows=data.flatMap(p=>p.blobs);assert.deepEqual(rows.map(b=>b.id).sort(),expected);assert.equal(expected.length,rows.length,'One physical/index record per unique content ID');assert.ok(expected.length>=2,'Owned binary and Unicode files have distinct real data blobs');baseline.set(workspace.root,data);console.log(JSON.stringify({nativePackPolicyObservation:{phase:'first-snapshot',snapshot:snapshot.id,totalPacks:packs.length,dataPacks:data.length,uniqueDataBlobs:expected.length,dataRows:rows,allStorageHeaderPayloadAndIndexVerified:true}}));return data;}
export async function verifyBatch(options){const data=await verifyStructure(options);assert.equal(data.length,1,'Entire owned three-file fixture must fit one data pack');assert.ok(data[0].bytes<=16*1024*1024);}
export async function verifyUnchanged({workspace,password}){assert.ok(baseline.has(workspace.root));const current=shape(await inventory(workspace,password));assert.deepEqual(current,baseline.get(workspace.root),'Repeat snapshot must retain exact physical data-pack identities and index rows');console.log(JSON.stringify({nativePackPolicyObservation:{phase:'repeat-snapshot',dataPacks:current.length,dataRows:current.flatMap(p=>p.blobs).length,addedDataPacks:0,addedDataRows:0}}));}
