    },
    {
      "id": "grafana.candidate.e52e582e0f850fda70dc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Only the MySQL driver supports isolation levels in Grafana. In case the value is empty, the driver's default isolation level is applied. Available options are \"READ-UNCOMMITTED\", \"READ-COMMITTED\", \"REPEATABLE-READ\" or \"SERIALIZABLE\".",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[database]`",
        "`isolation_level`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
        "sha256": "110d223ee731dd41043e8181cce5c9d3503e4a9cb7ddd744807966a1d3b235c6",
