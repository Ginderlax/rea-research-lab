      "id": "grafana.candidate.fe5189a068c2358ec5d2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This syntax is easy to read, but it doesn't allow you to use a variable in the middle of a word. **Example:** apps.frontend.$server.requests.count",
      "headingPath": [
