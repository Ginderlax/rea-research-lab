    {
      "id": "grafana.candidate.55e8bc1881b593de3fc6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now generate a report with a different time range from the dashboard it is based on. This means that you no longer have to apply workarounds, such as copying dashboards or carefully aligning report generation with the end of the month, to generate reports that cover the period you want.",
      "headingPath": [
        "What's new in Grafana v7.2",
        "Grafana Enterprise features",
        "Report time range"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-2.md",
