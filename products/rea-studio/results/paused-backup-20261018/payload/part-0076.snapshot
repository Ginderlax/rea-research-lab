    {
      "id": "grafana.candidate.615834d9280d693dedb4",
      "syntaxRole": "list-item",
      "sourceText": "- **`$<varname>`** - Use this syntax for standalone variable references. It doesn't allow you to use a variable in the middle of a word or expression.",
      "headingPath": [
        "InfluxDB template variables",
        "Choose a variable syntax"
      ],
      "source": {
        "path": "docs/sources/datasources/influxdb/template-variables/index.md",
        "gitBlobSha": "456916b3c3ccdcf5700d556ce2f5c5e2f7dccd09",
