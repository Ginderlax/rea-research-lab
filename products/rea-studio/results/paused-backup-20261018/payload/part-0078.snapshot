    {
      "id": "grafana.candidate.62408b81b8fe89a2477b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The character `.` doesn't match newline characters `\\n` and `\\r` by default. If your data contains multiline strings, use `[\\s\\S]` in place of `.` to match any character including newlines. For more detailed information, refer to the [Multiline regular expression example](#multiline-regular-expression-example).",
      "headingPath": [
        "Configure value mappings",
        "Types of value mappings",
        "Regex"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/configure-value-mappings/index.md",
