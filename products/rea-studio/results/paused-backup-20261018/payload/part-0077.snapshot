    },
    {
      "id": "grafana.candidate.4eeb08beb71068ad0302",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The cookie name for storing the auth token. Default is `grafana_session`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[auth]`",
        "`login_cookie_name`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
