      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.7ca4479816aff019d492",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In Grafana Enterprise or self-managed OSS, update the `.ini` configuration file. Refer to [Configuration file location](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-grafana/#configuration-file-location) to locate your `.ini` file.",
      "headingPath": [
