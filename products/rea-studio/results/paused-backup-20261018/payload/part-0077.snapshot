        "lineStart": 54,
        "lineEnd": 54,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-security/configure-request-security.md#L54-L54"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
