    },
    {
      "id": "grafana.candidate.b2e9051b09289a1cbdb9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Specify the Client ID and Secret in the [Grafana configuration file](../../../configure-grafana/#configuration-file-location). For example:",
      "headingPath": [
        "Configure Google OAuth authentication",
        "Configure Google authentication client using the Grafana configuration file",
        "Enable Google OAuth in Grafana"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md",
        "gitBlobSha": "53ca46b6aee0a719a8cbd28a536c33a8fe2e5733",
        "sha256": "a3ff08724962dd5598b98503415b00b745cf0225af5d2b42cdc330ad5f2f46e8",
        "lineStart": 87,
        "lineEnd": 87,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md#L87-L87"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.bf4728673ad2f31d8f55",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You may have to set the `root_url` option of `[server]` for the callback URL to be correct. For example, in case you are serving Grafana behind a proxy.",
      "headingPath": [
        "Configure Google OAuth authentication",
        "Configure Google authentication client using the Grafana configuration file",
        "Enable Google OAuth in Grafana"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md",
        "gitBlobSha": "53ca46b6aee0a719a8cbd28a536c33a8fe2e5733",
        "sha256": "a3ff08724962dd5598b98503415b00b745cf0225af5d2b42cdc330ad5f2f46e8",
        "lineStart": 105,
        "lineEnd": 106,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md#L105-L106"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.fff0f8199c3bea59b08d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Restart the Grafana backend. You should now see a Google login button on the login page. You can now login or sign up with your Google accounts. The `allowed_domains` option is optional, and domains were separated by space.",
      "headingPath": [
        "Configure Google OAuth authentication",
        "Configure Google authentication client using the Grafana configuration file",
        "Enable Google OAuth in Grafana"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md",
        "gitBlobSha": "53ca46b6aee0a719a8cbd28a536c33a8fe2e5733",
        "sha256": "a3ff08724962dd5598b98503415b00b745cf0225af5d2b42cdc330ad5f2f46e8",
        "lineStart": 108,
        "lineEnd": 110,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md#L108-L110"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.0c122d95a480875a7cf9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You may allow users to sign-up via Google authentication by setting the `allow_sign_up` option to `true`. When this option is set to `true`, any user successfully authenticating via Google authentication will be automatically signed up.",
      "headingPath": [
        "Configure Google OAuth authentication",
        "Configure Google authentication client using the Grafana configuration file",
        "Enable Google OAuth in Grafana"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md",
        "gitBlobSha": "53ca46b6aee0a719a8cbd28a536c33a8fe2e5733",
        "sha256": "a3ff08724962dd5598b98503415b00b745cf0225af5d2b42cdc330ad5f2f46e8",
        "lineStart": 112,
        "lineEnd": 115,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md#L112-L115"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.cf92895051d114f9e953",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You may specify a domain to be passed as `hd` query parameter accepted by Google's OAuth 2.0 authentication API. Refer to Google's OAuth [documentation](https://developers.google.com/identity/openid-connect/openid-connect#hd-param).",
      "headingPath": [
        "Configure Google OAuth authentication",
        "Configure Google authentication client using the Grafana configuration file",
        "Enable Google OAuth in Grafana"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md",
        "gitBlobSha": "53ca46b6aee0a719a8cbd28a536c33a8fe2e5733",
        "sha256": "a3ff08724962dd5598b98503415b00b745cf0225af5d2b42cdc330ad5f2f46e8",
        "lineStart": 117,
        "lineEnd": 118,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md#L117-L118"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.3168efd9c63787aedeb7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Since Grafana 10.3.0, the `hd` parameter retrieved from Google ID token is also used to determine the user's hosted domain. The Google Oauth `allowed_domains` configuration option is used to restrict access to users from a specific domain. If the `allowed_domains` configuration option is set, the `hd` parameter from the Google ID token must match the `allowed_domains` configuration option. If the `hd` parameter from the Google ID token does not match the `allowed_domains` configuration option, the user is denied access.",
      "headingPath": [
        "Configure Google OAuth authentication",
        "Configure Google authentication client using the Grafana configuration file",
        "Enable Google OAuth in Grafana"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md",
        "gitBlobSha": "53ca46b6aee0a719a8cbd28a536c33a8fe2e5733",
        "sha256": "a3ff08724962dd5598b98503415b00b745cf0225af5d2b42cdc330ad5f2f46e8",
        "lineStart": 121,
        "lineEnd": 121,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md#L121-L121"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.45a9c14542e7f9d6a75e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When an account does not belong to a google workspace, the `hd` claim will not be available.",
      "headingPath": [
        "Configure Google OAuth authentication",
        "Configure Google authentication client using the Grafana configuration file",
        "Enable Google OAuth in Grafana"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md",
        "gitBlobSha": "53ca46b6aee0a719a8cbd28a536c33a8fe2e5733",
        "sha256": "a3ff08724962dd5598b98503415b00b745cf0225af5d2b42cdc330ad5f2f46e8",
        "lineStart": 123,
        "lineEnd": 123,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md#L123-L123"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.0428c36b0f349148118a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This validation is enabled by default. To disable this validation, set the `validate_hd` configuration option to `false`. The `allowed_domains` configuration option will use the email claim to validate the domain.",
      "headingPath": [
        "Configure Google OAuth authentication",
        "Configure Google authentication client using the Grafana configuration file",
        "Enable Google OAuth in Grafana"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md",
        "gitBlobSha": "53ca46b6aee0a719a8cbd28a536c33a8fe2e5733",
        "sha256": "a3ff08724962dd5598b98503415b00b745cf0225af5d2b42cdc330ad5f2f46e8",
        "lineStart": 125,
        "lineEnd": 125,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md#L125-L125"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.06b6324e5ced42aa63ad",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "IETF's [RFC 7636](https://datatracker.ietf.org/doc/html/rfc7636) introduces \"proof key for code exchange\" (PKCE) which provides additional protection against some forms of authorization code interception attacks. PKCE will be required in [OAuth 2.1](https://datatracker.ietf.org/doc/html/draft-ietf-oauth-v2-1-03).",
      "headingPath": [
        "Configure Google OAuth authentication",
        "Configure Google authentication client using the Grafana configuration file",
        "Enable Google OAuth in Grafana",
        "PKCE"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md",
        "gitBlobSha": "53ca46b6aee0a719a8cbd28a536c33a8fe2e5733",
        "sha256": "a3ff08724962dd5598b98503415b00b745cf0225af5d2b42cdc330ad5f2f46e8",
        "lineStart": 130,
        "lineEnd": 133,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md#L130-L133"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.7c1257b1b55fe42c8a83",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can disable PKCE in Grafana by setting `use_pkce` to `false` in the`[auth.google]` section.",
      "headingPath": [
        "Configure Google OAuth authentication",
        "Configure Google authentication client using the Grafana configuration file",
        "Enable Google OAuth in Grafana",
        "PKCE"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md",
        "gitBlobSha": "53ca46b6aee0a719a8cbd28a536c33a8fe2e5733",
        "sha256": "a3ff08724962dd5598b98503415b00b745cf0225af5d2b42cdc330ad5f2f46e8",
        "lineStart": 136,
        "lineEnd": 136,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md#L136-L136"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b663a9ff00a707b0358a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When a user logs in using an OAuth provider, Grafana verifies that the access token has not expired. When an access token expires, Grafana uses the provided refresh token (if any exists) to obtain a new access token.",
      "headingPath": [
        "Configure Google OAuth authentication",
        "Configure Google authentication client using the Grafana configuration file",
        "Enable Google OAuth in Grafana",
        "Configure refresh token"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md",
        "gitBlobSha": "53ca46b6aee0a719a8cbd28a536c33a8fe2e5733",
        "sha256": "a3ff08724962dd5598b98503415b00b745cf0225af5d2b42cdc330ad5f2f46e8",
        "lineStart": 141,
        "lineEnd": 141,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md#L141-L141"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.85ec365b66bedde0fbd2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana uses a refresh token to obtain a new access token without requiring the user to log in again. If a refresh token doesn't exist, Grafana logs the user out of the system after the access token has expired.",
      "headingPath": [
        "Configure Google OAuth authentication",
        "Configure Google authentication client using the Grafana configuration file",
        "Enable Google OAuth in Grafana",
        "Configure refresh token"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md",
        "gitBlobSha": "53ca46b6aee0a719a8cbd28a536c33a8fe2e5733",
        "sha256": "a3ff08724962dd5598b98503415b00b745cf0225af5d2b42cdc330ad5f2f46e8",
        "lineStart": 143,
        "lineEnd": 143,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md#L143-L143"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.5514166d0582ffccaf4c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, Grafana includes the `access_type=offline` parameter in the authorization request to request a refresh token.",
      "headingPath": [
        "Configure Google OAuth authentication",
        "Configure Google authentication client using the Grafana configuration file",
        "Enable Google OAuth in Grafana",
        "Configure refresh token"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md",
        "gitBlobSha": "53ca46b6aee0a719a8cbd28a536c33a8fe2e5733",
        "sha256": "a3ff08724962dd5598b98503415b00b745cf0225af5d2b42cdc330ad5f2f46e8",
        "lineStart": 145,
        "lineEnd": 145,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md#L145-L145"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.5157c9f051283aa81c72",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Refresh token fetching and access token expiration check is enabled by default for the Google provider since Grafana v10.1.0. If you would like to disable access token expiration check then set the `use_refresh_token` configuration value to `false`.",
      "headingPath": [
        "Configure Google OAuth authentication",
        "Configure Google authentication client using the Grafana configuration file",
        "Enable Google OAuth in Grafana",
        "Configure refresh token"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md",
        "gitBlobSha": "53ca46b6aee0a719a8cbd28a536c33a8fe2e5733",
        "sha256": "a3ff08724962dd5598b98503415b00b745cf0225af5d2b42cdc330ad5f2f46e8",
        "lineStart": 147,
        "lineEnd": 147,
