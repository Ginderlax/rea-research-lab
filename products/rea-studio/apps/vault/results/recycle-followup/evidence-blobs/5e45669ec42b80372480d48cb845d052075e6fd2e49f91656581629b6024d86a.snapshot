import fs from 'node:fs/promises';
import path from 'node:path';
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {fileURLToPath} from 'node:url';
const root=fileURLToPath(new URL('./',import.meta.url)),hash=b=>createHash('sha256').update(b).digest('hex');
const identity=async p=>{const b=await fs.readFile(path.join(root,p));return{path:p,bytes:b.length,sha256:hash(b)};};
const before=JSON.parse(await fs.readFile(path.join(root,'stage-before.json'))),after=JSON.parse(await fs.readFile(path.join(root,'stage-after.json')));assert.deepEqual(before.runtime,after.runtime);assert.ok(after.all546ArtifactsUnchanged);
const number=(s,n)=>Number(new RegExp('^# '+n+' (\\d+)$','m').exec(s)?.[1]);const groups=[];for(const p of ['bin-boundaries','semantic']){const text=await fs.readFile(path.join(root,p+'.stdout.txt'),'utf8');groups.push({name:p,tests:number(text,'tests'),pass:number(text,'pass'),fail:number(text,'fail'),skipped:number(text,'skipped'),stdout:await identity(p+'.stdout.txt'),stderr:await identity(p+'.stderr.txt'),source:await identity(p+'.test.mjs')});}assert.deepEqual(groups.map(x=>[x.tests,x.pass,x.fail,x.skipped]),[[5,2,3,0],[6,6,0,0]]);
const browser={schema:'rea-owned-vault-recycle-browser-review/v1',completedAt:new Date().toISOString(),host:JSON.parse(await fs.readFile(path.join(root,'browser-host.json'))),cleanup:JSON.parse(await fs.readFile(path.join(root,'browser-cleanup.json'))),actualBrowser:'Chrome extension; one agent-created tab closed',runtime:before.runtime,scope:['confirmed move into bin','read-only masked synthetic preview','confirmed restore to previous group','one retained history row','lock/reopen persistence'],screenshots:await Promise.all(['browser-recycled-preview.png','browser-restored-history.png','browser-reopened-history.png'].map(identity)),accessibility:await Promise.all(['browser-recycled-preview.txt','browser-restored-history.txt','browser-reopened-history.txt'].map(identity)),originalGUI:0,delayedHTTPRaceExecuted:false,userHostsTouched:false};assert.equal(browser.cleanup.fixtureRemoved,true);await fs.writeFile(path.join(root,'browser-validation.json'),JSON.stringify(browser,null,2)+'\n',{flag:'wx'});
const receipt={schema:'rea-keepass-recycle-independent-review/v1',completedAt:new Date().toISOString(),candidate:before.stage,candidateValidation:before.validation,candidateManifest:before.manifest,runtime:before.runtime,strict546BeforeAfter:true,reviewGroups:groups,counts:{tests:11,pass:8,fail:3,skip:0,ownAuthenticatedOriginalProcesses:4,originalGUI:0,ownedBrowserHosts:1,actualBrowserWorkflows:1},findings:[{priority:2,status:'confirmed',source:'products/rea-studio/apps/vault/client.mjs',lines:[92,94],behavior:'After awaited active list, stale Restore/Purge may reopen a closed bin or erase a newer preview.',failures:3,persistedContentLossDemonstrated:false}],harnessFailures:['authentication-v1','audit-final-v1','audit-final-v2'],authorOriginalRawAccounting:after.authorFinalOriginal,originalSourceArchive:after.sourceArchive,selectedExactOriginalFiles:16,contractSpans:12,baselineNotesIdentity:await identity('notes-identity.json'),browser:await identity('browser-validation.json'),sourceBefore:await identity('stage-before.json'),sourceAfter:await identity('stage-after.json'),testHelper:await identity('ui-helper.mjs'),scope:'Finite native/API/original-library and normal actual-browser checks; stale publication reproductions use actual client/server with a controlled DOM transport.',integrationAccepted:false,productionModified:false,authorStageModified:false,fullCompatibility:false,securityClaim:false,performanceClaim:false};await fs.writeFile(path.join(root,'review-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
async function walk(dir=root,prefix=''){let rows=[];for(const e of await fs.readdir(dir,{withFileTypes:true})){assert.equal(e.isSymbolicLink(),false);const rel=prefix+e.name;if(e.isDirectory())rows.push(...await walk(path.join(dir,e.name),rel+'/'));else if(!['review-manifest.json','review-freeze.json'].includes(rel))rows.push(await identity(rel));}return rows;}
const files=(await walk()).sort((a,b)=>a.path.localeCompare(b.path)),manifest={schema:'rea-strict-independent-review-preservation/v1',files,excludes:['review-manifest.json','review-freeze.json']};await fs.writeFile(path.join(root,'review-manifest.json'),JSON.stringify(manifest,null,2)+'\n',{flag:'wx'});const freeze={schema:'rea-frozen-independent-review/v1',at:new Date().toISOString(),validation:await identity('review-validation.json'),manifest:await identity('review-manifest.json'),files:files.length};await fs.writeFile(path.join(root,'review-freeze.json'),JSON.stringify(freeze,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(freeze));
