    {
      "id": "grafana.candidate.8fbfe64a899440273d82",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use TLS (Transport Layer Security) for an additional layer of security when working with Elasticsearch. For information on setting up TLS encryption with Elasticsearch, refer to [Configure TLS](https://www.elastic.co/guide/en/elasticsearch/reference/8.8/configuring-tls.html#configuring-tls). You must add TLS settings to your Elasticsearch configuration file **prior** to setting these options in Grafana.",
      "headingPath": [
        "Configure the Elasticsearch data source",
        "Authentication",
        "TLS settings"
      ],
      "source": {
        "path": "docs/sources/datasources/elasticsearch/configure/index.md",
