      "id": "grafana.candidate.45e38c17e40743feaf28",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The query editor is the interface where you construct the query for a data source. Each data source's query editor provides a customized user interface that helps you write queries that take advantage of its unique capabilities.",
      "headingPath": [
        "Query editor in Explore"
      ],
      "source": {
        "path": "docs/sources/visualizations/explore/query-editor.md",
        "gitBlobSha": "b49d7dfcb7a47b5b87f13a07fe6dcba55bea8e06",
        "sha256": "a982a81157db3577475bb5c3776cf48937fdfa2ce1dceec658e2990ec657ad64",
        "lineStart": 18,
        "lineEnd": 19,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/explore/query-editor.md#L18-L19"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.f80611df16c5cdd97fa0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Because of the differences between query languages, each data source query editor looks and functions differently. Depending on your data source, the query editor might provide auto-completion features, metric names, variable suggestions, or a visual query-building interface.",
      "headingPath": [
        "Query editor in Explore"
      ],
      "source": {
