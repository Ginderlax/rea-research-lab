    {
      "id": "grafana.candidate.f8be092f2d68e6c1be06",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The redesigned reporting feature is currently in public preview. Grafana Labs offers limited support, and breaking changes might occur prior to the feature being made generally available. To use this feature, enable the `newShareReportDrawer` feature toggle in your Grafana configuration file or, for Grafana Cloud, contact Support.",
      "headingPath": [
        "Create and manage reports"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/create-reports/_index.md",
        "gitBlobSha": "f6e395abe8c144a9faa4899b27aef3d7aa6d9a97",
        "sha256": "5f797514c362142504fb59496b663b1eff8fc43cb59de71120eda2041b67b145",
        "lineStart": 84,
        "lineEnd": 84,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/dashboards/create-reports/_index.md#L84-L84"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.7f8292b192ee28848770",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Reporting** allows you to send automated and scheduled emails from any of your dashboards. You can configure several elements of these reports and generate PDFs and CSV files. Any changes you make to a dashboard used in a report are reflected the next time the report is sent.",
      "headingPath": [
        "Create and manage reports"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/create-reports/_index.md",
        "gitBlobSha": "f6e395abe8c144a9faa4899b27aef3d7aa6d9a97",
        "sha256": "5f797514c362142504fb59496b663b1eff8fc43cb59de71120eda2041b67b145",
        "lineStart": 88,
        "lineEnd": 90,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/dashboards/create-reports/_index.md#L88-L90"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.3425766a6e74344cc1fc",
      "syntaxRole": "list-item",
      "sourceText": "- SMTP must be configured for reports to be sent. Refer to [SMTP configuration documentation](ref:smtp) for more information.",
      "headingPath": [
        "Create and manage reports",
        "Requirements"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/create-reports/_index.md",
        "gitBlobSha": "f6e395abe8c144a9faa4899b27aef3d7aa6d9a97",
