    {
      "id": "grafana.candidate.d01f852226008f67b19a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "All the other usage insights features are turned off as soon as the license expires, meaning that you will not be able to see dashboard usage, presence indicators, or use improved search. Grafana continues to collect usage data and you will have access to it as soon as you update your license.",
      "headingPath": [
