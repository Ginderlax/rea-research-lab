    {
      "id": "grafana.candidate.fa5a5dba280424908ae0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Add a rewrite rule to each location block:",
      "headingPath": [
        "Introduction",
        "Configure reverse proxy",
        "Configure nginx"
      ],
      "source": {
        "path": "docs/sources/tutorials/run-grafana-behind-a-proxy/index.md",
        "gitBlobSha": "b1ea811531ae6e815c3d6ec9a28516c9435affa8",
        "sha256": "94e43b955137ac2d61d664709e09902bef58100e672e968916f32f9720523bdb",
        "lineStart": 120,
        "lineEnd": 120,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/tutorials/run-grafana-behind-a-proxy/index.md#L120-L120"
      },
      "applicability": {
