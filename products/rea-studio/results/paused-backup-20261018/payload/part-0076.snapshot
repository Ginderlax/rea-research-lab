    },
    {
      "id": "grafana.candidate.68a1ffcabcc84344207f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set the **Custom all value** field in the variable settings to `%`, then use `LIKE` in your query:",
      "headingPath": [
        "Microsoft SQL Server template variables",
        "Handle the \"All\" option in SQL queries",
        "Pattern: Use a custom \"All\" value with `LIKE`"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/template-variables/index.md",
        "gitBlobSha": "4ea7d6363212f57604e4d29ba05a2d571c833ef6",
        "sha256": "443ead52d051116a1045f23c7efa4c7495a5beee835bab7fcc48bf49e213a183",
        "lineStart": 175,
        "lineEnd": 175,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/mssql/template-variables/index.md#L175-L175"
      },
      "applicability": {
