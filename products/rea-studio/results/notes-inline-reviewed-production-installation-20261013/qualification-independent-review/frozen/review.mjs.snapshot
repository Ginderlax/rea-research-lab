// Source-only independent review of a frozen publication metadata correction.
import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash}from'node:crypto';
const root=import.meta.dirname,workspace=path.resolve(root,'../..'),candidate=path.join(workspace,'work/notes-inline-browser-qualification-fix-next');
const id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),records=[],guards=[];
async function save(p,b){const d=path.join(root,p);await fs.mkdir(path.dirname(d),{recursive:true});await fs.writeFile(d,Buffer.isBuffer(b)?b:JSON.stringify(b,null,2)+'\n',{flag:'wx'});}
async function read(p,e){const b=await fs.readFile(path.join(candidate,p));if(e)assert.deepEqual(id(b),{bytes:e.bytes,sha256:e.sha256});records.push({path:p,...id(b)});return b;}
async function walk(p=''){const out=[];for(const e of await fs.readdir(path.join(candidate,p),{withFileTypes:true})){assert.equal(e.isSymbolicLink(),false);const n=p+e.name;assert.ok(!/[\\:\x00-\x1f]/.test(n)&&n.split('/').every(s=>s&&s!=='.'&&s!=='..'));if(e.isDirectory())out.push(...await walk(n+'/'));else {assert.ok(e.isFile());out.push(n);}}return out;}
await save('source-before.mjs.snapshot',await fs.readFile(import.meta.filename));
const mb=await read('freeze-manifest.json');assert.equal(id(mb).sha256,'913cfe7fbd41c638a624483deca1713c8fb4df44e56d65a0f3fe6458b606cf0a');const manifest=JSON.parse(mb);assert.equal(manifest.schema,'rea-notes-browser-qualification-correction-strict-freeze/v1');assert.equal(Object.keys(manifest.inventory).length,31);assert.deepEqual((await walk()).sort(),[...Object.keys(manifest.inventory),'freeze-manifest.json'].sort());for(const [p,e]of Object.entries(manifest.inventory))await read(p,e);assert.equal(Object.values(manifest.inventory).reduce((n,r)=>n+r.bytes,0),1821158);
const baseBytes=await fs.readFile(path.join(workspace,'work/notes-inline-publication-plan-browser-next/public-preservation-map.json'));assert.equal(id(baseBytes).sha256,'ec5839d46fd9ff16e0e752bfac86b850689731b0bfa6a9fb87ffd4d4aaa8c2d7');const base=JSON.parse(baseBytes);
const ob=await read('qualification-overrides.json');assert.equal(id(ob).sha256,'50a6f287e52f68c73988a487e2e045e4e0b1652d8ac5c8d9a2804d8e9f872804');const override=JSON.parse(ob),cb=await read('public-preservation-map.corrected.json');assert.equal(id(cb).sha256,'48d1677a8a5b4faa80102caadd61f072c6cc90efd1e60b79a31ea1d21d1e3e66');const corrected=JSON.parse(cb);
function check(o,c){assert.equal(o.schema,'rea-notes-corrected-browser-qualification-overrides/v1');assert.equal(o.rows.length,12);assert.equal(o.baseMap.sha256,id(baseBytes).sha256);assert.equal(o.baseMap.bytes,baseBytes.length);assert.equal(o.authority.correctedClientSHA256,'90886819feef847847fcae8c442e0a401a1146a7a4aa1fd862a54b5e01f41da9');const imageRows=base.payload.filter(r=>r.epoch==='corrected-browser'&&r.actualMediaType==='image/jpeg');assert.equal(imageRows.length,12);assert.equal(new Set(o.rows.map(r=>r.publicPath)).size,12);assert.deepEqual(o.rows.map(r=>r.publicPath).sort(),imageRows.map(r=>r.publicPath).sort());let changed=0;for(let i=0;i<base.payload.length;i++){const b=base.payload[i],a=c.payload[i],r=o.rows.find(r=>r.publicPath===b.publicPath);if(r){assert.equal(r.changedField,'qualification');assert.equal(r.epoch,'corrected-browser');assert.deepEqual(r.before,b);assert.deepEqual(r.after,a);for(const k of ['epoch','sourceRoot','sourcePath','publicPath','bytes','sha256'])assert.deepEqual(r[k],b[k]);assert.deepEqual({...a,qualification:b.qualification},b);assert.equal(typeof a.qualification,'string');assert.notEqual(a.qualification,b.qualification);assert.match(a.qualification,/corrected-browser87/);assert.match(a.qualification,/90886819/);assert.match(a.qualification,/upload acceptance remains false/);assert.match(a.qualification,/download-event bridge timeout retained/);assert.match(a.qualification,/adds no new browser execution or whole-product parity/);changed++;}else assert.deepEqual(a,b);}assert.equal(changed,12);assert.deepEqual({...c,payload:base.payload},base);return changed;}
assert.equal(check(override,corrected),12);for(const r of base.payload.filter(r=>r.epoch==='independent-negative'&&r.actualMediaType))assert.deepEqual(corrected.payload.find(x=>x.publicPath===r.publicPath),r);
for(const [name,mutate]of [['missing-override',o=>o.rows.pop()],['identity-rebind',o=>o.rows[0].sha256='0'.repeat(64)],['old-image-target',o=>o.rows[0].publicPath=base.payload.find(r=>r.epoch==='independent-negative'&&r.actualMediaType).publicPath],['additional-row-field',o=>o.rows[0].after.bytes++]]){const copy=structuredClone(override);mutate(copy);assert.throws(()=>check(copy,corrected));guards.push({name,rejected:true,applicationTests:0});}
for(const r of records)assert.deepEqual(id(await fs.readFile(path.join(candidate,r.path))),{bytes:r.bytes,sha256:r.sha256});assert.deepEqual((await walk()).sort(),[...Object.keys(manifest.inventory),'freeze-manifest.json'].sort());
for(const p of ['freeze-manifest.json','validation.json','qualification-overrides.json','public-preservation-map.corrected.json','qualification-override.mjs'])await save('authority/'+p+'.snapshot',await fs.readFile(path.join(candidate,p)));
await save('authentication-before-after.json',{sourceStable:true,strictFiles:31,records});await save('negative-source-gates.json',guards);
await save('review-validation.json',{schema:'rea-notes-browser-qualification-independent-acceptance/v1',at:new Date().toISOString(),acceptance:true,sourceOnly:true,metadataCorrectionAccepted:true,sourceStable:true,strictCandidateFiles:31,candidateManifestSHA256:id(mb).sha256,candidateValidationSHA256:'bca38c114fcc6aa2f90daf54e017d667c2a6fcaaafe8bfc67c50a6a7d543a429',overrideSHA256:id(ob).sha256,correctedMapSHA256:id(cb).sha256,baseMapSHA256:id(baseBytes).sha256,changedRows:12,unchangedRows:806,soleChangedField:'qualification',byteIdentitiesPathsEpochsUnchanged:true,earlierSixImageScopeUnchanged:true,publicMapRecords:818,excludedRecords:11,productAcceptanceExpanded:false,applicationTests:0,originalExecutions:0,browserExecutions:0,hosts:0,benchmarks:0,productionWrites:0,registryWrites:0,negativeSourceGates:4,old46Unmodified:true,old162Unmodified:true,old17Unmodified:true,wholeProductParity:false,securityEquivalence:false,superiority:false});
console.log(JSON.stringify({acceptance:true,sourceOnly:true,candidateFiles31:true,changedQualifications:12,unchangedOtherFields:true,negativeGates:4,newBehaviorExecutions:0}));
