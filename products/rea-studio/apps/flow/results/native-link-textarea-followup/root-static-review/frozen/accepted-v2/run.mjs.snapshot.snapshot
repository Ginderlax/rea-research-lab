import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';import {spawn} from 'node:child_process';
const own=import.meta.dirname,stage=path.resolve(own,'../flow-native-link-next'),sha=b=>createHash('sha256').update(b).digest('hex');
const mb=await fs.readFile(path.join(stage,'manifest.json'));assert.equal(sha(mb),'0a03866476a81f83762bdfc10d65be639c24f25778b6c03fdac5b9ee906bea5d');const manifest=JSON.parse(mb);assert.equal(manifest.inventory.length,457);
async function authenticate(){for(const r of manifest.inventory){const b=await fs.readFile(path.join(stage,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256,r.path);}return {manifestSHA256:sha(await fs.readFile(path.join(stage,'manifest.json'))),files:457};}
const before=await authenticate();await fs.writeFile(path.join(own,'author-manifest.json.snapshot'),mb,{flag:'wx'});await fs.writeFile(path.join(own,'authority-before.json'),JSON.stringify(before,null,2)+'\n',{flag:'wx'});
for(const name of ['review.test.mjs','run.mjs'])await fs.writeFile(path.join(own,name+'.snapshot'),await fs.readFile(path.join(own,name)),{flag:'wx'});
for(const name of ['native.mjs','native-link.mjs','client.mjs','server.mjs','link-ui-fixture.mjs'])await fs.writeFile(path.join(own,name+'.snapshot'),await fs.readFile(path.join(stage,'candidate/products/rea-studio/apps/flow',name)),{flag:'wx'});
const env={...process.env};delete env.NODE_TEST_CONTEXT;const startedAtUtc=new Date().toISOString();
const outcome=await new Promise(resolve=>{const child=spawn(process.execPath,['--test','--test-reporter=tap','--test-concurrency=1',path.join(own,'review.test.mjs')],{env,windowsHide:true,shell:false,stdio:['ignore','pipe','pipe']});const out=[],err=[];let failure=null,size=0;const timer=setTimeout(()=>{failure='60-second review deadline';child.kill();},60000);for(const [stream,list]of[[child.stdout,out],[child.stderr,err]])stream.on('data',b=>{size+=b.length;if(size>4194304){failure='4MiB capture limit';child.kill();}else list.push(b);});child.on('error',e=>failure=e.message);child.on('close',(exitCode,signal)=>{clearTimeout(timer);resolve({exitCode,signal,failure,stdout:Buffer.concat(out),stderr:Buffer.concat(err)});});});
await fs.writeFile(path.join(own,'stdout.txt'),outcome.stdout,{flag:'wx'});await fs.writeFile(path.join(own,'stderr.txt'),outcome.stderr,{flag:'wx'});const after=await authenticate();assert.deepEqual(after,before);await fs.writeFile(path.join(own,'authority-after.json'),JSON.stringify(after,null,2)+'\n',{flag:'wx'});
const raw=outcome.stdout.toString(),summary=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo','duration_ms'].map(n=>[n,Number(raw.match(new RegExp('^# '+n+' ([\\d.]+)$','m'))?.[1]??-1)]));
const result={schema:'rea-root-flow-link-independent-review/v1',startedAtUtc,completedAtUtc:new Date().toISOString(),summary,exitCode:outcome.exitCode,signal:outcome.signal,failure:outcome.failure,authorSourceFiles:457,sourceStable:true,originalCompilerCalls:JSON.parse(await fs.readFile(path.join(own,'observations.json'))).originalCompilerCalls,originalRuntimeHosts:0,originalGUI:0,browser:0,benchmarks:0,candidateOrProductionWrites:0,fullProductParity:false,universalSuperiority:false};
await fs.writeFile(path.join(own,'validation.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(result));
assert.equal(outcome.exitCode,0,raw+'\n'+outcome.stderr);assert.equal(outcome.failure,null);assert.equal(summary.tests,7);assert.equal(summary.pass,7);assert.equal(summary.fail+summary.skipped+summary.cancelled+summary.todo,0);
