import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import {createHash} from 'node:crypto';
import {pathToFileURL} from 'node:url';
const work=import.meta.dirname,stage=path.join(work,'notes-notebooks-next'),out=path.join(work,'notes-notebooks-root-review'),sha=b=>createHash('sha256').update(b).digest('hex');await fs.mkdir(out,{recursive:true});
const receiptBytes=await fs.readFile(path.join(stage,'stage-validation.json'));assert.equal(sha(receiptBytes),'588dec534d9994a7ecccfa76930ad3a0cc363b5e90ca7562e1d280217c63d7f8');const receipt=JSON.parse(receiptBytes);
const manifestBytes=await fs.readFile(path.join(stage,'strict-manifest.json'));assert.equal(sha(manifestBytes),'825f8881734b845a8fac1c3fd26696dc0bf0ee79cc67a02cd6cd3d3c779d2f5c');const manifest=JSON.parse(manifestBytes);assert.equal(manifest.entries.length,283);
async function authenticate(){for(const e of manifest.entries){assert.ok(e.path&&!e.path.startsWith('/')&&!e.path.includes('\\')&&!e.path.split('/').includes('..'));const b=await fs.readFile(path.join(stage,e.path));assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256,e.path);}}
await authenticate();assert.deepEqual(receipt.focused,{tests:28,pass:28,fail:0,skipped:0,cancelled:0});
const{handle}=await import(pathToFileURL(path.join(stage,'products/rea-studio/apps/notes/server.mjs'))),{createStore,createWorkspace}=await import(pathToFileURL(path.join(stage,'products/rea-studio/lib/storage.mjs')));
function gate(){let enter,release;const entered=new Promise(r=>enter=r),held=new Promise(r=>release=r);return {enter,release,entered,held};}
async function scenario(firstFails){const dir=await fs.mkdtemp(path.join(os.tmpdir(),'rea-notebook-root-review-'));try{
 const store=await createStore(path.join(dir,'store')),workspace=await createWorkspace(path.join(dir,'workspace')),call=(action,input)=>handle({action,input,store,workspace});
 let tree=await call('notebook-list',{});tree=await call('notebook-create',{revision:tree.revision,title:'Original parent'});const folderID=tree.notebook.id;
 const note=await call('save',{title:'Owned note',notebookId:folderID,body:'Bytes remain unchanged'}),before=await store.get('notes-state-v2'),control=gate(),primary=new Error('Owned held metadata failure'),realSet=store.set;let setCalls=0;
 store.set=async(...args)=>{setCalls++;if(setCalls===1){control.enter();await control.held;if(firstFails)throw primary;}return realSet(...args);};
 const first=call('notebook-rename',{revision:tree.revision,id:folderID,title:'First contender'}).then(value=>({value}),error=>({error}));await control.entered;
 const second=call('notebook-rename',{revision:tree.revision,id:folderID,title:'Second contender'}).then(value=>({value}),error=>({error}));
 assert.deepEqual(await store.get('notes-state-v2'),before);assert.equal((await call('get',{id:note.id})).notebook,'Original parent');
 control.release();const a=await first,b=await second;store.set=realSet;
 if(firstFails){assert.equal(a.error,primary);assert.ok(b.value);assert.equal(b.error,undefined);assert.equal(setCalls,2);}else{assert.ok(a.value);assert.match(b.error?.message??'',/changed since they were loaded/);assert.equal(setCalls,1);}
 const after=await store.get('notes-state-v2'),name=firstFails?'Second contender':'First contender',saved=await call('get',{id:note.id});
 assert.equal(after.organization.revision,before.organization.revision+1);assert.equal(after.records[folderID].title,name);assert.equal(saved.id,note.id);assert.equal(saved.body,note.body);assert.equal(saved.notebookId,note.notebookId);assert.equal(saved.notebook,name);assert.equal(saved.revision,note.revision+1);assert.equal(saved.history.length,1);assert.equal(saved.history[0].notebook,'Original parent');assert.equal(JSON.stringify(after).includes(firstFails?'First contender':'Second contender'),false);
 return {firstFails,heldSavedBytesUnchanged:true,exclusiveRevisionSelection:true,persistedWinner:name,metadataWritesAttempted:setCalls,onlyCommittedPathRecordedInHistory:true,primaryErrorIdentityPreserved:firstFails,stableNativeNoteAndFolderIDs:true};
 }finally{assert.equal(path.dirname(dir),path.resolve(os.tmpdir()));assert.ok(path.basename(dir).startsWith('rea-notebook-root-review-'));await fs.rm(dir,{recursive:true,force:true});}}
const observations=[await scenario(false),await scenario(true)];await authenticate();
const review={schema:'rea-root-notebook-independent-review/v1',checkedAt:new Date().toISOString(),passed:true,manifestSHA256:sha(manifestBytes),stageReceiptSHA256:sha(receiptBytes),authenticatedArtifacts:283,reviewedStageTests:28,independentHeldPersistenceCases:2,observations,sourceBytesStable:true,productionChanged:false,originalRuntimeExecutionsInThisReview:0,fullParity:false,universalSuperiority:false};await fs.writeFile(path.join(out,'review-validation.json'),JSON.stringify(review,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(review));
