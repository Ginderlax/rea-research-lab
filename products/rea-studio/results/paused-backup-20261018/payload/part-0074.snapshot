    },
    {
      "id": "grafana.candidate.5ff6d9b6575ff36cee57",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana installs dashboards at the root level if you don't set the `folder` field.",
      "headingPath": [
        "Provision Grafana",
        "Dashboards",
        "Example dashboard configuration file"
      ],
      "source": {
