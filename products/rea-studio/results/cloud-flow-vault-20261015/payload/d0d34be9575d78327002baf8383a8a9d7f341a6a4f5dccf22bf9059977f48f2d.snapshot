<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>REA Studio — development applications</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header><div class="brand">REA <strong>Studio</strong></div><div class="header-note">Local applications · development</div></header>
  <div class="shell">
    <aside><p class="eyebrow">YOUR WORKSPACE</p><nav id="navigation" aria-label="Applications"></nav><div class="aside-note">Files and records are stored on this machine.</div></aside>
    <main><div id="app-heading"></div><div id="app-root" aria-live="polite">Loading applications…</div></main>
  </div>
  <script type="module" src="/studio.mjs"></script>
</body>
</html>
