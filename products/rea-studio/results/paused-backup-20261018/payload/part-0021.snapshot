    assert ident((REPO/actualp).read_bytes())==pin
notespaths={r['path'] for r in bundle['baselineNotesSources']}
actual={p.relative_to(REPO).as_posix() for p in (REPO/'products/rea-studio/apps/notes').rglob('*') if p.is_file() and 'results' not in p.relative_to(REPO/'products/rea-studio/apps/notes').parts}
assert actual==notespaths
for row in bundle['baselineNotesSources']: assert source(row['path'])==row
oldpub=literal(producer,'NOTES_REVIEWED')
oldtools=literal(producer,'NOTES_INSTALLED_TOOLING')
assert len(oldpub)==52 and len(oldtools)==4
assert {r['path'] for r in oldobjects}==set(oldpub)
for p,pair in {**oldpub,**oldtools}.items(): assert source(p)=={'path':p,'bytes':pair[0],'sha256':pair[1]}
