    {
      "id": "grafana.candidate.68763f6ca97c16a9ebf8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "All **Date & time** format units in Grafana (such as **Datetime ISO** or **Datetime US**) expect input values to be in milliseconds since the Unix epoch (January 1, 1970). If your data source provides timestamps in seconds, these will be incorrectly interpreted as dates very close to January 1, 1970.",
      "headingPath": [
        "Configure standard options",
        "Standard options",
        "Unit",
        "Custom units",
        "Time format units"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/configure-standard-options/index.md",
