      "id": "grafana.candidate.583453400c89cc217c98",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use this transformation to address issues when a data source returns time series data in a format that isn't compatible with the desired visualization. This transformation allows you to convert time series data between wide and long formats, providing flexibility in data frame structures.",
      "headingPath": [
        "Transform data",
        "Transformation functions",
        "Prepare time series"
      ],
