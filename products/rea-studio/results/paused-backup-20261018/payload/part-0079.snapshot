        "lineStart": 248,
        "lineEnd": 248,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v9-4.md#L248-L248"
      },
      "applicability": {
