        "sha256": "443ead52d051116a1045f23c7efa4c7495a5beee835bab7fcc48bf49e213a183",
        "lineStart": 186,
        "lineEnd": 186,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/mssql/template-variables/index.md#L186-L186"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
