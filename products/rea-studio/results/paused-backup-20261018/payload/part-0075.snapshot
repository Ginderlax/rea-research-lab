    {
      "id": "grafana.candidate.05fcceae933bd499010a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Because file provisioning is managed as code using the same `Repository` Custom Resource Definition (CRD) as Git Sync, you can define it in a YAML file and push it to Grafana with `gcx`. This approach enables automated, GitOps-style workflows for managing file provisioning instead of using the Grafana UI.",
      "headingPath": [
        "Set up file provisioning",
        "Set up file provisioning as code"
      ],
      "source": {
