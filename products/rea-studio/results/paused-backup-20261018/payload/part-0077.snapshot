        "lineStart": 558,
        "lineEnd": 558,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md#L558-L558"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.288a3d60f4821742dba4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The default is `\"redis://localhost:6379\"`.",
      "headingPath": [
        "Configure Grafana Enterprise",
        "[caching.redis]",
        "url"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md",
        "gitBlobSha": "51174e643296aefdf7f2a277d5fe604eeb1d2300",
        "sha256": "43ec22c446ce6485d8d3dc90918a7efc784c7b19118c82019ee5ab6cb8881586",
        "lineStart": 560,
        "lineEnd": 560,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md#L560-L560"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.ca7e66a668e4a31a46d2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A comma-separated list of Redis cluster members, either in `host:port` format or using the full Redis URLs (`redis://username:password@localhost:6379`). For example, `localhost:7000, localhost: 7001, localhost:7002`. If you use the full Redis URLs, then you can specify the scheme, username, and password only once. For example, `redis://username:password@localhost:0000,localhost:1111,localhost:2222`. You cannot specify a different username and password for each URL.",
      "headingPath": [
        "Configure Grafana Enterprise",
        "[caching.redis]",
        "cluster"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md",
        "gitBlobSha": "51174e643296aefdf7f2a277d5fe604eeb1d2300",
        "sha256": "43ec22c446ce6485d8d3dc90918a7efc784c7b19118c82019ee5ab6cb8881586",
        "lineStart": 564,
        "lineEnd": 565,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md#L564-L565"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
