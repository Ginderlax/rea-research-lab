    {
      "id": "grafana.candidate.7acfb0c9bcd17a974b93",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Multiple conditions in the same rule use **AND** (`,`), while multiple rules across teams use **OR**.",
