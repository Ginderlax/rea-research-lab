      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.4540a1a28d31fbbe6d0c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "However, there are times when you need to configure permissions on a more granular level. For these cases, Grafana allows you to override permissions for specific dashboards.",
      "headingPath": [
        "Introduction",
        "Define granular permissions"
      ],
      "source": {
