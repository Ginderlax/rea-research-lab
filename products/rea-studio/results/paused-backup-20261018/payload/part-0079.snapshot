    },
    {
      "id": "grafana.candidate.e9a94e79b58898e0639f",
      "syntaxRole": "table-row",
      "sourceText": "| Text alignment | Select an alignment mode. Choose from: <ul><li>**Auto** - If only a single value is shown (no repeat), then the value is centered. If multiple series or rows are shown, then the value is left-aligned.</li><li>**Center** - Stat value is centered.</li></ul> |",
      "headingPath": [
        "Stat",
        "Configuration options",
        "Stat styles"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/stat/index.md",
