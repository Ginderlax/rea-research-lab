    {
      "id": "grafana.candidate.3a0b5447486152f096ae",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Each data source's query editor provides a customized user interface that helps you write queries that take advantage of its unique capabilities.",
      "headingPath": [
        "Query and transform data",
        "About queries",
        "Query editors"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/_index.md",
