    },
    {
      "id": "grafana.candidate.ef3849aa1e6c3344b38b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you grant user permissions for folders, that setting applies to all dashboards and subfolders contained in the folder. Consider using this approach to assigning dashboard and folder permissions when you have users, service accounts or teams who require access to groups of related dashboards or folders.",
      "headingPath": [
        "Manage dashboard permissions",
        "Grant folder permissions"
      ],
