    },
    {
      "id": "grafana.candidate.43c245230bc614c0a976",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you want to track Grafana usage via Azure Application Insights, then specify _your_ Application Insights connection string. Since the connection string contains semicolons, you need to wrap it in backticks (`). By default, tracking usage is disabled.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[analytics]`",
        "`application_insights_connection_string`"
