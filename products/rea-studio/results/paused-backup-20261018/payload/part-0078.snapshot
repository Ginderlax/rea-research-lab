    {
      "id": "grafana.candidate.9179c70e9064f3d49a86",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When things go bad, it often helps if you understand the context in which the failure occurred. Time of last deploy, system changes, or database migration can offer insight into what might have caused an outage. Annotations allow you to represent such events directly on your graphs.",
      "headingPath": [
        "Introduction",
        "Annotate events"
      ],
