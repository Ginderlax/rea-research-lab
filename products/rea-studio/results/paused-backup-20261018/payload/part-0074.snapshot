    {
      "id": "grafana.candidate.e58d594bd42aa7698109",
      "syntaxRole": "table-row",
      "sourceText": "| `permissions` | Provides users access to Grafana resources. For a list of permissions, refer to [RBAC permissions actions and scopes](ref:rbac-role-definitions). If you do not know which permissions to assign, you can create and assign roles without any permissions as a placeholder. Using the `from` attribute, you can specify additional permissions or permissions to remove by adding a `state` to your permission list. |",
      "headingPath": [
        "Create custom RBAC roles",
        "Create custom roles using file-based provisioning"
      ],
