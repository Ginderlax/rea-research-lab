import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {readFileSync,writeFileSync,mkdirSync,existsSync} from 'node:fs';
import {join,dirname} from 'node:path';
const base='C:/Users/evanh/Documents/Codex/2026-10-12/go',lab=join(base,'outputs/rea-research-lab'),product=join(lab,'products/rea-studio'),stage=join(base,'work/sketch-collector-next'),prefix='products/rea-studio/apps/sketch/results/collector-followup',destination=join(lab,prefix),sha=b=>createHash('sha256').update(b).digest('hex');
const freezeBytes=readFileSync(join(stage,'freeze-validation.json'));assert.equal(sha(freezeBytes),'59629ecca2019b50da247e4226498d583a65d503ae47350a47b0fe7499c88765');const freeze=JSON.parse(freezeBytes);assert.equal(freeze.files.length,51);assert.ok(!existsSync(join(destination,'preservation-manifest.json')));
const baseline=JSON.parse(readFileSync(join(stage,'production-baseline-manifest.json')));for(const entry of baseline.files){const b=readFileSync(join(product,entry.path));assert.equal(b.length,entry.bytes);assert.equal(sha(b),entry.sha256,`Collector stage baseline changed: ${entry.path}`);}
assert.equal(sha(readFileSync(join(product,'scripts/verify-sketch-geometry.mjs'))),'cf044f4be673201b19247cb9bc9d31c86d713aef70d51fdb6c3508332a49621d');assert.equal(sha(readFileSync(join(product,'apps/sketch/results/geometry-validation.json'))),'728f28d2aa5d7ebf1155db9a553f60d67029df46ddb512c15135ddf431333a91');
const snapshots=[];function snapshot(path,b){const target='stage/'+path+'.snapshot';mkdirSync(dirname(join(destination,target)),{recursive:true});writeFileSync(join(destination,target),b,{flag:'wx'});snapshots.push({sourcePath:path,path:target,bytes:b.length,sha256:sha(b)});}
for(const entry of freeze.files){assert.ok(!entry.path.split('/').includes('..'));const b=readFileSync(join(stage,entry.path));assert.equal(b.length,entry.bytes);assert.equal(sha(b),entry.sha256);snapshot(entry.path,b);}snapshot('freeze-validation.json',freezeBytes);
const copied=[];for(const[sourcePath,path,expected]of [['candidate/verify-sketch-geometry.mjs','scripts/verify-sketch-geometry.mjs','ef5b156aef48f825b6522bed77a88ab821202147a33f2cffc92ac9e96ae93016'],['candidate/sketch-collector-process.mjs','scripts/sketch-collector-process.mjs','ffafa889dd99c201c9a2d9682e9a8e3e7033f88e35ab1ef9498aa48f3319ec61']]){const b=readFileSync(join(stage,sourcePath));assert.equal(sha(b),expected);writeFileSync(join(product,path),b);copied.push({path:'products/rea-studio/'+path,bytes:b.length,sha256:sha(b),exactStageSource:sourcePath});}
writeFileSync(join(destination,'preservation-manifest.json'),JSON.stringify({schema:'rea-sketch-collector-followup-preservation/v1',createdAtUtc:new Date().toISOString(),stageFreezeSha256:sha(freezeBytes),stageValidationSha256:freeze.validationSha256,snapshots,baselineFiles:baseline.files.length,productionCopies:copied,historicalGeometryReceiptSha256:'728f28d2aa5d7ebf1155db9a553f60d67029df46ddb512c15135ddf431333a91',historicalCollectorSha256:'cf044f4be673201b19247cb9bc9d31c86d713aef70d51fdb6c3508332a49621d',geometryBehaviorRerun:false,scope:'Exact 17-check synthetic collector stage, old 28-check geometry evidence and old collector retained. Collector/helper copied exactly; production regression adapter is separately recorded. Child bounds do not establish bootstrap/fingerprint I/O deadlines or race-free Windows descendant isolation.'},null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({snapshots:snapshots.length,baselineFiles:baseline.files.length,copied,manifestSha256:sha(readFileSync(join(destination,'preservation-manifest.json')))}));
