        "lineStart": 319,
        "lineEnd": 319,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/auth-proxy/index.md#L319-L319"
      },
      "applicability": {
