    },
    {
      "id": "grafana.candidate.a8a67609e051270c0a90",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Correlation creates a data link only if all variables have values in the selected data row. [Global variables](/docs/grafana/latest/dashboards/variables/add-template-variables/#global-variables) are exception to this rule and are not required to be filled in from the returned data. These variables are interpolated automatically by data sources.",
      "headingPath": [
        "Correlation",
        "Target query",
        "Correlation Variables"
      ],
      "source": {
        "path": "docs/sources/administration/correlations/correlation-configuration/index.md",
        "gitBlobSha": "f01ef51d6708806dc074f63e55f543c0408d633b",
        "sha256": "fb4525128741c7b02cd6822866bed335a5a601af49f7ae89cdb7775390d7a0e1",
        "lineStart": 62,
        "lineEnd": 62,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/correlations/correlation-configuration/index.md#L62-L62"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.ad63f987cffad19250b1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Correlations provide a way to extract more variables out of field values. The output of transformations is a set of new variables that can be accessed as any other variable.",
      "headingPath": [
        "Correlation",
        "Target query",
        "Correlation Transformations"
      ],
      "source": {
        "path": "docs/sources/administration/correlations/correlation-configuration/index.md",
        "gitBlobSha": "f01ef51d6708806dc074f63e55f543c0408d633b",
        "sha256": "fb4525128741c7b02cd6822866bed335a5a601af49f7ae89cdb7775390d7a0e1",
        "lineStart": 66,
        "lineEnd": 66,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/correlations/correlation-configuration/index.md#L66-L66"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.3f6730e643b48cf8809e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Each transformation uses a selected field value as the input. The output of a transformation is a set of new variables based on the type and options of the transformation.",
      "headingPath": [
        "Correlation",
        "Target query",
        "Correlation Transformations"
      ],
      "source": {
        "path": "docs/sources/administration/correlations/correlation-configuration/index.md",
