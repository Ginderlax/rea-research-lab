    {
      "id": "grafana.candidate.6daaa978a14d956961dc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "How long the data proxy should wait before timing out. Default is 30 seconds.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[dataproxy]`",
        "`timeout`"
      ],
