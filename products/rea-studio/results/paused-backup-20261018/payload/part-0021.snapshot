assert(!fs.existsSync(target)); fs.mkdirSync(target);
const sha = bytes => createHash('sha256').update(bytes).digest('hex'), identity = bytes => ({ bytes: bytes.length, sha256: sha(bytes) });
const payloads = [];
function save(relative, bytes, origin) {
  const destination = path.join(target, relative); fs.mkdirSync(path.dirname(destination), { recursive: true });
  fs.writeFileSync(destination, bytes, { flag: 'wx' });
  const row = { path: relative, ...identity(bytes), origin }; payloads.push(row); return row;
}
