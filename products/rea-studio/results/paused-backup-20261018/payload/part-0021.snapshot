def funcs(text):
    matches=list(re.finditer(r'^(?:async )?function ([A-Za-z0-9_]+)\(',text,re.M))
    bodies={}
    for i,m in enumerate(matches):
        span=text[m.start():matches[i+1].start() if i+1<len(matches) else len(text)]
        first=span.split('\n',1)[0]
        if first.endswith('}'): body=first+'\n'
        else:
            end=re.search(r'^}\n',span,re.M)
            assert end,m.group(1)
            body=span[:end.end()]
        bodies[m.group(1)]=body
    return bodies
