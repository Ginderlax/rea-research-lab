      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.299e130a78992db39af5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Table format queries support a `timeend` column in addition to the `time` column. When both are present, Grafana treats the row as a time range rather than a single point. This is useful for displaying events with duration, such as maintenance windows or deployments.",
      "headingPath": [
        "PostgreSQL query editor",
        "Table queries",
        "Table query with time range columns"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/query-editor/_index.md",
