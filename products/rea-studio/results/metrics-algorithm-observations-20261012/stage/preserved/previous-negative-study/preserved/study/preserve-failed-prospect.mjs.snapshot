import fs from 'node:fs/promises';import path from 'node:path';import {here,sha} from './authenticate-original.mjs';
const folder=path.join(here,'failures/organ-pipe-p1-hypothesis');await fs.mkdir(folder,{recursive:true});const files=['verify-adversarial.mjs','workloads.mjs','prepare-manifest.mjs','memory-preflight.control.json','results/adversarial-readiness.json'],snapshots=[];
for(const name of files){const bytes=await fs.readFile(path.join(here,name)),target=path.join(folder,name+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,bytes,{flag:'wx'});snapshots.push({path:name,bytes:bytes.length,sha256:sha(bytes)});}
const diagnosis={schemaVersion:1,preservedAt:new Date().toISOString(),exitCode:1,error:'AssertionError: Fixed organ-pipe/p1 workload must exercise work-cap fallback',reason:'The42-case correctness checks matched both controls, but the prospective organ-pipe/p1 coverage claim failed: fallback count0. Other tested ranks/shapes have6 fallback executions. This was correctness coverage selection before any timings/memory; no measured trial or superiority threshold changed.',initialResultFileCaveat:'The initial script wrote a status:passed correctness receipt before asserting the extra chosen-fallback hypothesis. This preserved attempt is failed for the chosen workload claim despite passing output comparisons.',snapshots,timingMeasurementRun:false,memoryMeasurementRun:false};await fs.writeFile(path.join(folder,'failure.json'),JSON.stringify(diagnosis,null,2)+'\n',{flag:'wx'});
