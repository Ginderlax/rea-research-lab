    },
    {
      "id": "grafana.candidate.d1a0045942755afa5dc8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can also create a query with at least one non-numeric, non-`datetime` column. Azure Monitor considers those columns to be dimensions, and they become labels in the response.",
      "headingPath": [
        "Azure Monitor query editor",
        "Query Azure Monitor Logs",
        "Logs query examples"
      ],
