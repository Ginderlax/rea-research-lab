    },
    {
      "id": "grafana.candidate.3d1198763e0ccfad1b47",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To run a specific version of Grafana, add it in the command <version number> section:",
      "headingPath": [
        "Configure a Grafana Docker image",
