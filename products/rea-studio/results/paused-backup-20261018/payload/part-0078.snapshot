    {
      "id": "grafana.candidate.8a79dcee2d25f6a7398b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Since the alert rule that you have created has been configured to always fire, once the evaluation interval has concluded, you should receive an alert notification in the Webhook endpoint.",
      "headingPath": [
