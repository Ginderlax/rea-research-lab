import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
const work=import.meta.dirname,sha=b=>createHash('sha256').update(b).digest('hex');
async function frozen(root,filename,schema){const inventory={};async function walk(rel=''){for(const e of(await fs.readdir(path.join(root,rel),{withFileTypes:true})).sort((a,b)=>a.name<b.name?-1:1)){const n=rel?rel+'/'+e.name:e.name;if(e.isDirectory())await walk(n);else{assert.ok(e.isFile());assert.notEqual(n,filename);const b=await fs.readFile(path.join(root,n));inventory[n]={bytes:b.length,sha256:sha(b)};}}}await walk();const manifest={schema,frozenAtUtc:new Date().toISOString(),files:Object.keys(inventory).length,aggregateBytes:Object.values(inventory).reduce((s,r)=>s+r.bytes,0),inventory};const b=Buffer.from(JSON.stringify(manifest,null,2)+'\n');await fs.writeFile(path.join(root,filename),b,{flag:'wx'});return{files:manifest.files,sha256:sha(b)};}
const browser=path.join(work,'editor-search-browser'),stage=path.join(work,'editor-search-fix-next'),sourceBefore=JSON.parse(await fs.readFile(path.join(browser,'source-before.json'),'utf8')),after={};for(const[n,r]of Object.entries(sourceBefore)){const b=await fs.readFile(path.join(stage,n));after[n]={bytes:b.length,sha256:sha(b)};assert.deepEqual(after[n],r);}await fs.writeFile(path.join(browser,'source-after.json'),JSON.stringify(after,null,2)+'\n',{flag:'wx'});
const observations=JSON.parse(await fs.readFile(path.join(browser,'observations.json'),'utf8'));assert.equal(observations.length,8);assert.equal(observations.filter(r=>r.passed).length,7);assert.equal(observations[2].passed,false);assert.equal(observations[4].priorObservationIndex,2);assert.equal(observations[4].passed,true);assert.equal(observations[2].observed.value,observations[4].observedValue);assert.ok((await fs.readFile(path.join(browser,'dirty-result.ax.txt'),'utf8')).includes('Your current draft was retained'));
const bytes={};for(const[n,expected]of Object.entries({'editor/workspace/src/unicode.txt':'🧪needle\r\nNeedle repeated needle\n','editor/workspace/second.txt':'second needle\n','editor/workspace/literal.txt':'literal .* $& 🧪\n'})){const b=await fs.readFile(path.join(browser,'synthetic-data',n));assert.equal(b.toString(),expected);bytes[n]={bytes:b.length,sha256:sha(b)};}
const host=JSON.parse(await fs.readFile(path.join(browser,'host.json'),'utf8'));let listenerOpen=false;try{await fetch(host.url,{signal:AbortSignal.timeout(2000)});listenerOpen=true;}catch{}assert.equal(listenerOpen,false);
await fs.writeFile(path.join(browser,'freeze-collector.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});
const receipt={schema:'rea-editor-workspace-search-actual-browser-validation/v1',completedAtUtc:new Date().toISOString(),sourceStage:'editor-search-fix-next',sourceManifestSHA256:'b858a4cf15312f962bf0ac5ba2fd6b6c17466248ff1394c727a49ee0e665e9ef',sourceFiles:124,sourceStable:true,actualOwnedBrowserSessions:1,actualOwnedHTTPHosts:1,browserReloads:1,distinctSuccessfulWorkflowChecks:7,rawObservations:8,ownedDiagnosticFailures:1,diagnosticCorrection:'The first preservation diagnostic expected the wrong status wording; the original false observation is retained. Text content and the actual retained-draft message pass the corrected diagnostic.',applicationFailuresObserved:0,initialAXFileIsNoChangeDiff:true,fullAXFiles:['open-result.ax.txt','reload.ax.txt','final.ax.txt'],syntheticWorkspaceFinalBytes:bytes,tabClosedViaCUA:true,hostShutdown:{transport:'Ctrl+C',reportedExitCode:1,closedHandlerReceiptPresent:await fs.access(path.join(browser,'host-closed.json')).then(()=>true,()=>false),listenerVerifiedClosed:true,gracefulCloseConfirmed:false},browserLogs:JSON.parse(await fs.readFile(path.join(browser,'console-logs.json'),'utf8')).length,userPort4311Touched:false,originalGUIExecutions:0,currentPathCorrectionBrowserTested:false,hotExitOrDraftPersistenceClaim:false,fullParity:false,universalSuperiority:false};await fs.writeFile(path.join(browser,'validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
const browserFreeze=await frozen(browser,'freeze-manifest.json','rea-editor-workspace-search-browser-preservation/v1');
const audit=path.join(work,'metrics-wrapper-observations-root-audit');for(const[name,source]of Object.entries({'stdout.txt':'metrics-wrapper-observations-root-audit.stdout.txt','stderr.txt':'metrics-wrapper-observations-root-audit.stderr.txt'})){await fs.copyFile(path.join(work,source),path.join(audit,name),fs.constants.COPYFILE_EXCL);}await fs.writeFile(path.join(audit,'freeze-collector.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});const auditReceipt=JSON.parse(await fs.readFile(path.join(audit,'validation.json'),'utf8'));assert.equal(auditReceipt.status,'PASS');assert.equal(auditReceipt.newMeasurements,0);assert.equal(auditReceipt.frozenArtifacts,1154);const auditFreeze=await frozen(audit,'freeze-manifest.json','rea-root-metrics-wrapper-observation-audit-preservation/v1');console.log(JSON.stringify({status:'FROZEN',browser:browserFreeze,metricsAudit:auditFreeze}));
