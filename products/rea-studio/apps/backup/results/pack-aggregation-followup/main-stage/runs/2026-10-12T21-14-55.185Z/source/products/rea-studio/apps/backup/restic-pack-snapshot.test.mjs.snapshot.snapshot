import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import {fileURLToPath} from 'node:url';
import {execFile} from 'node:child_process';
import {promisify} from 'node:util';
import {syncBuiltinESMExports} from 'node:module';
import {zstdDecompressSync,zstdCompressSync} from 'node:zlib';
import {createWorkspace} from '../../lib/storage.mjs';
import {handleNative} from './restic.mjs';
import {hash,open,seal,passwordKey,masterKey} from './restic-crypto.mjs';
const exec=promisify(execFile),MiB=1024*1024,stage=fileURLToPath(new URL('../../../../',import.meta.url)),artifacts=path.join(stage,'projects/09-restic/artifacts'),password='owned-multiple-data-pack-fixture',observations=[];
async function fixture(t,name){const root=await fs.mkdtemp(path.join(os.tmpdir(),'rea-multi-pack-')),workspace=await createWorkspace(path.join(root,'workspace'));t.after(async()=>{assert.equal(path.dirname(root),path.resolve(os.tmpdir()));assert.ok(path.basename(root).startsWith('rea-multi-pack-'));await fs.rm(root,{recursive:true,force:true});});const exeBytes=await fs.readFile(path.join(artifacts,'unpacked/restic_0.19.1_windows_amd64.exe'));assert.equal(hash(exeBytes),'b0dd1fd21eea5d8fe1325f55f7118213c21f36de8a261e04c0624a5ab9fd7830');assert.equal(hash(await fs.readFile(path.join(artifacts,'restic_0.19.1_windows_amd64.zip'))),'da948ad707ed690426473aaba2046cd61f8f90f6f0e7dab6be0d5796531de67d');const exe=path.join(root,'original-restic.exe');await fs.writeFile(exe,exeBytes,{flag:'wx'});const row={name,commands:[],fixtureFiles:[]};observations.push(row);return{root,workspace,row,api:(action,input={})=>handleNative({action,input:{repository:'repository',password,...input},workspace}),original:async args=>{const result=await exec(exe,['--no-cache','-r',workspace.resolve('repository'),...args],{cwd:workspace.root,env:{...process.env,RESTIC_PASSWORD:password,RESTIC_PASSWORD_FILE:'',RESTIC_PASSWORD_COMMAND:'',RESTIC_REPOSITORY:''},windowsHide:true,timeout:60000,maxBuffer:4*MiB});row.commands.push({args,exitCode:0,stdout:result.stdout,stderr:result.stderr});return result.stdout;}};}
async function keys(f){const names=await fs.readdir(f.workspace.resolve('repository/keys')),doc=JSON.parse(await fs.readFile(f.workspace.resolve(`repository/keys/${names[0]}`),'utf8'));return masterKey(JSON.parse(open(await passwordKey(doc,password),Buffer.from(doc.data,'base64'))));}
function metadata(key,bytes){const plain=open(key,bytes);return JSON.parse(plain[0]===2?zstdDecompressSync(plain.subarray(1)):plain);}
async function inventory(f){const key=await keys(f),rows=[];for(const id of await fs.readdir(f.workspace.resolve('repository/index'))){const doc=metadata(key,await fs.readFile(f.workspace.resolve(`repository/index/${id}`)));for(const pack of doc.packs){const bytes=await fs.readFile(f.workspace.resolve(`repository/data/${pack.id.slice(0,2)}/${pack.id}`));assert.equal(hash(bytes),pack.id);const len=bytes.readUInt32LE(bytes.length-4),header=open(key,bytes.subarray(bytes.length-4-len,-4));let offset=0,pos=0;for(const blob of pack.blobs){assert.equal(blob.offset,offset);assert.equal(header[pos] % 2,blob.type==='tree'?1:0);assert.equal(header.readUInt32LE(pos+1),blob.length);const compressed=header[pos]>=2;assert.equal(header.subarray(pos+(compressed?9:5),pos+(compressed?41:37)).toString('hex'),blob.id);if(compressed)assert.equal(header.readUInt32LE(pos+5),blob.uncompressed_length);offset+=blob.length;pos+=compressed?41:37;}assert.equal(pos,header.length);assert.equal(offset,bytes.length-4-len);rows.push({id:pack.id,bytes:bytes.length,type:pack.blobs[0].type,blobs:pack.blobs});}}return{key,rows};}
async function sources(f,{repeat=false}={}){await fs.mkdir(f.workspace.resolve('source/nested/empty'),{recursive:true});const files={};for(let i=0;i<24;i++)files[`nested/item-${String(i).padStart(2,'0')}.txt`]=Buffer.from(`unique ${i} — 雪 `+'compressible ordinary text '.repeat(150));files['duplicate-a.txt']=Buffer.from('same file bytes '.repeat(500));files['duplicate-b.txt']=Buffer.from(files['duplicate-a.txt']);files['empty.bin']=Buffer.alloc(0);if(repeat)files['repeated.bin']=Buffer.alloc(16*MiB+127,0x41);for(const[name,bytes]of Object.entries(files)){await fs.writeFile(f.workspace.resolve(`source/${name}`),bytes);f.row.fixtureFiles.push({path:name,bytes:bytes.length,sha256:hash(bytes)});}return files;}
async function compare(f,files,root){for(const[name,bytes]of Object.entries(files))assert.equal(hash(await fs.readFile(path.join(root,'source',name))),hash(bytes),name);}
for(const [version,mode]of [[1,'off'],[2,'auto'],[2,'off'],[2,'fastest'],[2,'better'],[2,'max']])test(`original check/restore accepts v${version}/${mode} multiple-data-blob packs and native reopening`,async t=>{const f=await fixture(t,`native-${version}-${mode}`);await f.api('nativeInit',{version});const files=await sources(f,{repeat:version===2&&mode==='auto'}),snapshot=await f.api('nativeSnapshot',{source:'source',compression:mode}),inv=await inventory(f),data=inv.rows.filter(r=>r.type==='data');assert.ok(data.some(r=>r.blobs.length>=25));assert.ok(data.every(r=>r.blobs.every(b=>b.type==='data')));assert.ok(inv.rows.filter(r=>r.type==='tree').every(r=>r.blobs.length===1));assert.equal(data.flatMap(r=>r.blobs).filter(b=>b.id===hash(files['duplicate-a.txt'])).length,1);if(version===2&&mode==='auto'){const entry=(await f.api('nativeInspect',{id:snapshot.id})).entries.find(e=>e.path==='source/repeated.bin');assert.equal(entry.content.length,3);assert.equal(entry.content[0],entry.content[1]);assert.equal(data.flatMap(r=>r.blobs).filter(b=>b.id===entry.content[0]).length,1);}assert.equal((await f.api('nativeCheck',{id:snapshot.id})).verified,true);await f.original(['check','--read-data']);const originalTarget=path.join(f.root,'original-restore');await f.original(['restore',snapshot.id,'--target',originalTarget]);await compare(f,files,originalTarget);await f.api('nativeRestore',{id:snapshot.id,destination:'native-restore',confirm:true});await compare(f,files,f.workspace.resolve('native-restore'));const ids=data.flatMap(r=>r.blobs).map(b=>b.id).sort();const again=await f.api('nativeSnapshot',{source:'source',compression:mode==='off'?'auto':'off'}),after=await inventory(f);assert.deepEqual(after.rows.filter(r=>r.type==='data').flatMap(r=>r.blobs).map(b=>b.id).sort(),ids);assert.equal((await f.api('nativeCheck',{id:again.id})).verified,true);f.row.dataPacks=data.map(r=>({id:r.id,bytes:r.bytes,count:r.blobs.length}));f.row.repeatSnapshotAddedDataBlobs=0;assert.deepEqual(await fs.readdir(f.workspace.resolve('repository/locks')),[]);assert.deepEqual(await fs.readdir(f.workspace.resolve('repository/tmp')),[]);});
test('native reads/restores original multiple-blob v2 snapshot and appends deduplicated compatible packs',async t=>{const f=await fixture(t,'original-to-native-and-append'),files=await sources(f);await f.original(['init','--repository-version','2']);await f.original(['backup','source','--json']);const snapshots=JSON.parse(await f.original(['snapshots','--json'])),id=snapshots.at(-1).id,first=await inventory(f);assert.ok(first.rows.some(r=>r.type==='data'&&r.blobs.length>1));assert.equal((await f.api('nativeCheck',{id})).verified,true);await f.api('nativeRestore',{id,destination:'native-from-original',confirm:true});await compare(f,files,f.workspace.resolve('native-from-original'));const previous=new Set(first.rows.filter(r=>r.type==='data').flatMap(r=>r.blobs).map(b=>b.id));files['added.txt']=Buffer.from('new native appended file');await fs.writeFile(f.workspace.resolve('source/added.txt'),files['added.txt']);const snapshot=await f.api('nativeSnapshot',{source:'source',compression:'auto'}),second=await inventory(f),data=second.rows.filter(r=>r.type==='data').flatMap(r=>r.blobs);assert.equal(data.filter(b=>!previous.has(b.id)).length,1);await f.original(['check','--read-data']);const target=path.join(f.root,'original-appended');await f.original(['restore',snapshot.id,'--target',target]);await compare(f,files,target);f.row.originalDataPacks=first.rows.filter(r=>r.type==='data').map(r=>({id:r.id,count:r.blobs.length}));});
test('authenticated changed second-blob index offset rejects before restore output',async t=>{const f=await fixture(t,'second-blob-index-corruption');await f.api('nativeInit',{version:2});await sources(f);const snapshot=await f.api('nativeSnapshot',{source:'source'}),key=await keys(f);for(const indexID of await fs.readdir(f.workspace.resolve('repository/index'))){const doc=metadata(key,await fs.readFile(f.workspace.resolve(`repository/index/${indexID}`))),pack=doc.packs.find(p=>p.blobs[0].type==='data'&&p.blobs.length>1);if(!pack)continue;pack.blobs[1].offset++;const sealed=seal(key,Buffer.concat([Buffer.from([2]),zstdCompressSync(Buffer.from(JSON.stringify(doc)))])),newID=hash(sealed);await fs.writeFile(f.workspace.resolve(`repository/index/${newID}`),sealed);await fs.unlink(f.workspace.resolve(`repository/index/${indexID}`));break;}await assert.rejects(f.api('nativeRestore',{id:snapshot.id,destination:'bad-index',confirm:true}),/index and authenticated pack header disagree/);await assert.rejects(fs.stat(f.workspace.resolve('bad-index')),{code:'ENOENT'});assert.deepEqual(await fs.readdir(f.workspace.resolve('repository/locks')),[]);});
test('deadline after awaited aggregate data-pack write prevents sync/index/snapshot and cleans owned temp/lock',async t=>{const f=await fixture(t,'aggregate-deadline-after-write');await f.api('nativeInit',{version:2});await sources(f);const key=await keys(f),realOpen=fs.open,realNow=Date.now;let offset=0,expiredSync=0,closed=0,dataWrites=0;Date.now=()=>realNow()+offset;fs.open=async(filename,...args)=>{const handle=await realOpen(filename,...args);if(typeof filename!=='string'||!filename.startsWith(f.workspace.root+path.sep)||!filename.endsWith('.pending'))return handle;const write=handle.writeFile.bind(handle),sync=handle.sync.bind(handle),close=handle.close.bind(handle);let ownsData=false;handle.writeFile=async bytes=>{const result=await write(bytes);try{const length=bytes.readUInt32LE(bytes.length-4),header=open(key,bytes.subarray(bytes.length-4-length,-4));if(header[0]===0||header[0]===2){ownsData=true;dataWrites++;offset=120001;}}catch{}return result;};handle.sync=async()=>{if(offset)expiredSync++;return sync();};handle.close=async()=>{const result=await close();if(ownsData)closed++;return result;};return handle;};syncBuiltinESMExports();try{await assert.rejects(f.api('nativeSnapshot',{source:'source'}),/exceeded two minutes/);}finally{fs.open=realOpen;Date.now=realNow;syncBuiltinESMExports();}assert.equal(dataWrites,1);assert.equal(expiredSync,0);assert.equal(closed,1);for(const name of ['index','snapshots','tmp','locks'])assert.deepEqual(await fs.readdir(f.workspace.resolve(`repository/${name}`)),[]);f.row.deadline={dataWrites,expiredSync,closed};});
test.after(()=>console.log(JSON.stringify({packAggregationOriginalObservations:observations})));
