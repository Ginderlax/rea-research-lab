          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.e06e571af7000a0e7a51",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Refresh token fetching and access token expiration check is enabled by default for the Entra ID provider since Grafana v10.1.0. If you would like to disable access token expiration check then set the `use_refresh_token` configuration value to `false`.",
      "headingPath": [
        "Configure Microsoft Entra ID OAuth authentication",
        "Configure the Entra ID authentication client using the Grafana configuration file",
        "Configure refresh token"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/entraid/index.md",
