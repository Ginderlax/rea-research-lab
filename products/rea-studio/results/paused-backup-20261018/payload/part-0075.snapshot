    {
      "id": "grafana.candidate.661b9b8bd29c4882e89e",
      "syntaxRole": "list-item",
      "sourceText": "- Any changes made in the provisioned files are reflected in the Grafana database. The Grafana UI reads the database and updates the UI to reflect these changes.",
      "headingPath": [
