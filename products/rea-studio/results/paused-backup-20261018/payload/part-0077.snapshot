    {
      "id": "grafana.candidate.cbd499a3a5069e220080",
      "syntaxRole": "table-row",
      "sourceText": "| `role_attribute_path`    | No       | Yes                | [JMESPath](http://jmespath.org/examples.html) expression to use for Grafana role lookup. Grafana will first evaluate the expression using the Okta OIDC ID token. If no role is found, the expression will be evaluated using the user information obtained from the UserInfo endpoint. The result of the evaluation should be a valid Grafana role (`None`, `Viewer`, `Editor`, `Admin` or `GrafanaAdmin`). For more information on user role mapping, refer to [Configure role mapping](#configure-role-mapping). |                               |",
      "headingPath": [
        "Configure Okta OIDC authentication",
        "Configuration options"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/okta/index.md",
        "gitBlobSha": "4de8751f865ff55ac58451811f4eafc681a66671",
        "sha256": "fe422737ef152e83e92f9b6cbc00fc7578d6b44c697ed6a6486447f716916c6d",
        "lineStart": 306,
        "lineEnd": 306,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/okta/index.md#L306-L306"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.db91cc49e419705ee7bf",
      "syntaxRole": "table-row",
      "sourceText": "| `role_attribute_strict`  | No       | Yes                | Set to `true` to deny user login if the Grafana org role cannot be extracted using `role_attribute_path` or `org_mapping`. For more information on user role mapping, refer to [Configure role mapping](#configure-role-mapping).                                                                                                                                                                                                                                                                                   | `false`                       |",
      "headingPath": [
        "Configure Okta OIDC authentication",
        "Configuration options"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/okta/index.md",
        "gitBlobSha": "4de8751f865ff55ac58451811f4eafc681a66671",
        "sha256": "fe422737ef152e83e92f9b6cbc00fc7578d6b44c697ed6a6486447f716916c6d",
        "lineStart": 307,
        "lineEnd": 307,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/okta/index.md#L307-L307"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
