import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import path from 'node:path';import {layoutSelection} from './products/rea-studio/apps/sketch/layout.mjs';import {bounds,importExcalidraw,exportExcalidraw,validateScene} from './products/rea-studio/apps/sketch/core.mjs';import {loadLayoutOracle} from './layout-oracle.mjs';
const shape=(id,x,y,w,h,extra={})=>({id,type:'rect',x,y,w,h,...extra}),scene=shapes=>validateScene({name:'Layout fixtures',shapes}),positions=s=>s.shapes.map(s=>({id:s.id,x:s.x,y:s.y})),ops=['x','y'].flatMap(axis=>[...['start','center','end'].map(position=>({kind:'align',axis,position})),{kind:'distribute',axis}]);
function native(shapes){return shapes.map(s=>({id:s.id,type:s.type==='rect'?'rectangle':s.type,x:s.x,y:s.y,width:s.w,height:s.h,angle:0,groupIds:s.groupIds??[],...(s.type==='freedraw'?{points:s.points}:['line','arrow'].includes(s.type)?{points:[[0,0],[s.w,s.h]]}:{})}));}
function compare(original,input,op,packets){const ids=input.shapes.map(s=>s.id),elements=native(input.shapes),map=new Map(elements.map(e=>[e.id,e])),selected=op.kind==='align'?original.oracle.alignElements(elements,map,op,{getNonDeletedElementsMap:()=>map}):original.oracle.distributeElements(elements,map,{axis:op.axis,space:'between'}),byId=new Map(selected.map(s=>[s.id,{id:s.id,x:s.x,y:s.y}])),actual=layoutSelection(input,ids,op).scene;const expected=input.shapes.map(s=>byId.get(s.id)),current=positions(actual),signed=rows=>rows.map(r=>({id:r.id,xNegativeZero:Object.is(r.x,-0),yNegativeZero:Object.is(r.y,-0)}));packets.push({operation:op,input:structuredClone(input),expected,current,expectedSignedZeros:signed(expected),currentSignedZeros:signed(current)});assert.deepEqual(current,expected);return actual;}
test('six alignments preserve signed geometry, freehand points, input ownership and unrelated shapes',()=>{const a=scene([shape('a',30,-10,40,20),shape('b',180,70,-30,50,{type:'line'}),shape('c',-15,150,0,0,{type:'freedraw',points:[[-20,5],[10,-15],[70,30]]}),shape('other',650,300,10,10)]),before=structuredClone(a);for(const op of ops.filter(o=>o.kind==='align')){const result=layoutSelection(a,['a','b','c'],op).scene,key=op.axis==='x'?'x':'y',extent=op.axis==='x'?'w':'h',values=result.shapes.slice(0,3).map(s=>{const b=bounds(s);return b[key]+(op.position==='start'?0:op.position==='end'?b[extent]:b[extent]/2);});assert.ok(values.every(v=>v===values[0]));assert.deepEqual(result.shapes[3],a.shapes[3]);assert.deepEqual(result.shapes[2].points,a.shapes[2].points);assert.equal(result.shapes[1].w,-30);assert.deepEqual(a,before);}});
test('selected nested groups translate together; one group is a no-op; partial group selection expands',()=>{const a=scene([shape('a',0,5,20,10,{groupIds:['inner','outer']}),shape('b',30,20,10,10,{groupIds:['outer']}),shape('c',200,90,40,20)]),r=layoutSelection(a,['a','c'],{kind:'align',axis:'y',position:'end'});assert.equal(r.groupCount,2);assert.equal(r.scene.shapes[1].y-r.scene.shapes[0].y,15);assert.deepEqual(layoutSelection(a,['a'],{kind:'align',axis:'x',position:'start'}).changedIds,[]);});
test('native alignment retains unknown records, appearance, ids and deletion state, and changes only geometry/version',()=>{const doc=exportExcalidraw(scene([shape('a',0,10,20,30),shape('b',100,90,40,20)]));doc.custom={retained:true};doc.elements[0].customData={keep:7};doc.elements[0].roughness=2;const input=importExcalidraw(doc,'Native layout'),r=layoutSelection(input,['a','b'],{kind:'align',axis:'y',position:'start'}),out=exportExcalidraw(r.scene);assert.deepEqual(out.custom,doc.custom);assert.deepEqual(out.elements[0],doc.elements[0]);assert.deepEqual(out.elements[1],{...doc.elements[1],y:10,version:2});assert.deepEqual(out.elements[0].customData,{keep:7});assert.equal(out.elements[0].roughness,2);});
test('mixed opaque groups and external binding constraints reject without mutating the source',()=>{const doc=exportExcalidraw(scene([shape('a',0,10,20,30,{groupIds:['mixed']}),shape('b',100,90,40,20)]));doc.elements.push({...doc.elements[0],id:'opaque',type:'image'});const input=importExcalidraw(doc,'Opaque group'),before=structuredClone(input);assert.throws(()=>layoutSelection(input,['a','b'],ops[0]),/non-editable/);assert.deepEqual(input,before);doc.elements.pop();doc.elements[0].groupIds=[];doc.elements[0].boundElements=[{id:'unknown',type:'arrow'}];const bound=importExcalidraw(doc,'Bound'),copy=structuredClone(bound);assert.throws(()=>layoutSelection(bound,['a','b'],ops[0]),/external bindings/);assert.deepEqual(bound,copy);});
test('invalid inputs and coordinate overflow reject atomically; empty selection is a stable no-op',()=>{const input=scene([shape('a',900000,0,1,1,{type:'freedraw',points:[[-900000,0],[-800000,0]]}),shape('b',900000,20,1,1)]),before=structuredClone(input);for(const ids of [['a','a'],['missing'],null])assert.throws(()=>layoutSelection(input,ids,ops[0]));assert.throws(()=>layoutSelection(input,['a','b'],{kind:'align',axis:'z',position:'start'}));assert.throws(()=>layoutSelection(input,['a','b'],{kind:'align',axis:'x',position:'center'}),/coordinate/);assert.deepEqual(input,before);assert.deepEqual(layoutSelection(input,[],ops[0]).changedIds,[]);});
test('pinned source helpers match six alignment and two distribution actions on authored fixtures and 240 seeded scenes',()=>{const original=loadLayoutOracle(),fixtures=[scene([shape('a',0,0,10,10),shape('b',80,60,20,30),shape('c',200,200,40,40)]),scene([shape('a',0,0,100,100),shape('b',20,30,100,100),shape('c',35,35,100,100)]),scene([shape('a',0,0,20,40,{groupIds:['g']}),shape('b',30,15,10,30,{groupIds:['g']}),shape('c',200,200,50,50),shape('d',400,500,-60,70,{type:'line'})])];const packets=[];let seed=0x53a821de,paired=0;const random=()=>{seed=(Math.imul(seed,1664525)+1013904223)>>>0;return seed/2**32;};for(let i=0;i<240;i++){const items=[];for(let j=0,n=3+Math.floor(random()*6);j<n;j++){const s=shape('s'+j,Math.round(random()*800-400),Math.round(random()*800-400),Math.round(random()*100),Math.round(random()*100));if(j<2&&i%3===0)s.groupIds=['outer'];if(j===2&&i%4===0){s.type='line';s.w=-s.w;}if(j===3&&i%5===0){s.type='freedraw';s.points=[[0,0],[-s.w,s.h],[s.w+10,-s.h]];}items.push(s);}fixtures.push(scene(items));}for(const fixture of fixtures)for(const op of ops){compare(original,fixture,op,packets);paired++;}const record={pairedScenesAndActions:paired,authoredFixtures:3,seededScenes:240,seed:'0x53a821de',originalHelperCalls:original.calls,source:original.source,vmEvaluations:original.vmEvaluations,ownedGeometryAdapter:true,exactOriginalMutationHelpersExecuted:true,ownedTimestampRandomSceneAndUnboundBindingAdapters:true,packets,originalRendererOrAppExecuted:false,independentHeldOutClaim:false,fullParity:false,superiority:false};const output=process.env.REA_LAYOUT_OBSERVATIONS;assert.ok(output,'Collector must select an owned observation path');fs.mkdirSync(path.dirname(output),{recursive:true});fs.writeFileSync(output,JSON.stringify(record,null,2)+'\n',{flag:'wx'});console.log('LAYOUT_ORIGINAL_ACTION_PAIRS '+paired);});
