    {
      "id": "grafana.candidate.ff364c824404d72df8a2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Amazon CloudWatch Logs data sources categorize logs by the service or application that generates them and by the type of log. They complement log groups and let you query logs without knowing individual log group names. For details about how Amazon CloudWatch categorizes logs, refer to [Data source discovery and management](https://docs.aws.amazon.com/AmazonCloudWatch/latest/logs/data-source-discovery-management.html) in the AWS documentation.",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Query CloudWatch Logs",
        "Specify Amazon CloudWatch Logs data sources to query"
      ],
      "source": {
