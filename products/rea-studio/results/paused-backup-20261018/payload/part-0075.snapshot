    {
      "id": "grafana.candidate.a7df489c4c519211b438",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This guide outlines the steps and references to provision alerting resources using YAML files. For a practical demo, you can clone and try [this example using Grafana OSS and Docker Compose](https://github.com/grafana/provisioning-alerting-examples/tree/main/config-files).",
      "headingPath": [
        "Use configuration files to provision alerting resources"
      ],
      "source": {
