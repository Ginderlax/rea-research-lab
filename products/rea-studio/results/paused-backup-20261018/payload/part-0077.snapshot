    {
      "id": "grafana.candidate.e7f06bb02eb8ff0a976d",
      "syntaxRole": "list-item",
      "sourceText": "- `org_mapping = *:2:Editor` to map all users to the organization which ID is `2` in Grafana as Editors.",
      "headingPath": [
