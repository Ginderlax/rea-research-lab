// Unbound read-only raw evidence collector; no audit, product, candidate, test or syntax execution.
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { createHash } from 'node:crypto';
const RUN = '39169535767', HEAD = '698d2e301765d1b878fb251b3d59dadb5a3c9bac', JOB = '117799523471';
assert(/^\d+$/.test(RUN) && /^[0-9a-f]{40}$/.test(HEAD) && /^\d+$/.test(JOB), 'UNBOUND template refuses before files, credentials or API');
const own = import.meta.dirname, base = path.resolve(own, '../..'), lab = path.join(base, 'outputs/rea-research-lab');
const repo = '/repos/Ginderlax/rea-research-lab';
const expectedSources = [
  { path: 'scripts/audit-proof-delivery.mjs', bytes: 52515, sha256: '2ae56eda012a6783f7661ec4381e320e39e83057a5506dbee59a926ab929a1f3' },
  { path: '.github/workflows/proof-delivery-audit-cloud.yml', bytes: 5110, sha256: 'd97e03fbf1e962751db45cd2705cba9f9bf0358b7c1d5310fb59b83a639615ec' },
];
const credential = spawnSync('git', ['credential', 'fill'], { cwd: lab,
  env: { ...process.env, GIT_TERMINAL_PROMPT: '0', GCM_INTERACTIVE: 'Never' },
  input: 'protocol=https\nhost=github.com\n\n', encoding: 'utf8', windowsHide: true, timeout: 20000, maxBuffer: 128 * 1024 });
assert.equal(credential.status, 0, 'Saved GitHub authentication unavailable');
const fields = Object.fromEntries(credential.stdout.split('\n').filter(line => line.includes('=')).map(line => {
  const at = line.indexOf('='); return [line.slice(0, at), line.slice(at + 1)];
})); assert(fields.password);
const headers = { Accept: 'application/vnd.github+json', 'User-Agent': 'REA-six-projection-raw-backup',
  'X-GitHub-Api-Version': '2022-11-28', Authorization: 'Bearer ' + fields.password };
const identity = bytes => ({ bytes: bytes.length, sha256: createHash('sha256').update(bytes).digest('hex') });
async function get(endpoint, maximum, allowed = [200]) {
  assert(endpoint.startsWith(repo + '/'));
  const response = await fetch('https://api.github.com' + endpoint, { method: 'GET', headers, signal: AbortSignal.timeout(60000) });
  assert(allowed.includes(response.status), 'Read-only GitHub response outside reviewed statuses');
  const length = Number(response.headers.get('content-length')); assert(!length || length <= maximum);
  const chunks = []; let size = 0;
  for await (const chunk of response.body) { size += chunk.length; assert(size <= maximum); chunks.push(chunk); }
  return { bytes: Buffer.concat(chunks), status: response.status, endpoint };
}
const initial = await Promise.all(['run', 'jobs', 'artifacts'].map(async kind => {
  const endpoint = repo + '/actions/runs/' + RUN + (kind === 'run' ? '' : '/' + kind + '?per_page=100');
  const response = await get(endpoint, 1024 * 1024); return { kind, ...response, value: JSON.parse(response.bytes) };
}));
const [run, jobs, artifacts] = initial.map(row => row.value);
assert.equal(String(run.id), RUN); assert.equal(run.head_sha, HEAD); assert.equal(run.run_attempt, 1);
assert.equal(run.path, '.github/workflows/proof-delivery-audit-cloud.yml'); assert.equal(run.head_branch, 'codex/rea-cloud-recovery-20261015');
assert.equal(run.repository.full_name, 'Ginderlax/rea-research-lab'); assert.equal(run.head_repository.full_name, 'Ginderlax/rea-research-lab');
assert(['push', 'workflow_dispatch'].includes(run.event)); assert.equal(jobs.total_count, 1); assert.equal(jobs.jobs.length, 1);
const job = jobs.jobs[0]; assert.equal(String(job.id), JOB); assert.equal(String(job.run_id), RUN); assert.equal(job.head_sha, HEAD);
assert.equal(job.name, 'audit'); assert.equal(job.runner_group_name, 'GitHub Actions'); assert(job.labels.includes('windows-2022'));
const folder = path.join(own, 'run-' + RUN + '-observation-' + new Date().toISOString().replace(/[:.]/g, '-'));
await fs.mkdir(folder);
const rows = [];
async function save(name, response) {
  assert(/^[a-zA-Z0-9._-]+$/.test(name)); const file = path.join(folder, name);
  await fs.writeFile(file, response.bytes, { flag: 'wx' }); assert.deepEqual(await fs.readFile(file), response.bytes);
  const row = { name, httpStatus: response.status, endpoint: response.endpoint, ...identity(response.bytes) }; rows.push(row); return row;
}
for (const row of initial) await save(row.kind + '.json', row);
const result = { schema: 'rea-six-projection-audit-readonly-raw-collection/v1', at: new Date().toISOString(), runId: RUN,
  headSHA: HEAD, jobId: JOB, runStatus: run.status, runConclusion: run.conclusion, jobStatus: job.status,
  jobConclusion: job.conclusion, rows, sourceAPIs: [], artifact: null, rawBackupOnly: true,
  sourceOrControlQualificationPerformed: false, globalProofDeliveryAccepted: false, productExecutions: 0,
  originalExecutions: 0, auditExecutionsLocally: 0, tests: 0, builds: 0, syntaxChecks: 0, dispatches: 0,
  historicalMissingArtifactAndCancelledRunFactsUnchanged: true };
if (run.status === 'completed' && job.status === 'completed') {
  const logs = await get(repo + '/actions/jobs/' + JOB + '/logs', 8 * 1024 * 1024, [200, 404, 410]);
  await save('job-' + JOB + '-logs' + (logs.status === 200 ? '.txt' : '-unavailable.json'), logs);
  assert.equal(artifacts.total_count, artifacts.artifacts.length); assert(artifacts.artifacts.length <= 1);
  if (artifacts.artifacts.length === 1) {
    const artifact = artifacts.artifacts[0]; assert.equal(artifact.name, 'proof-delivery-audit-' + RUN + '-1');
    assert.equal(String(artifact.workflow_run.id), RUN); assert.equal(artifact.workflow_run.head_sha, HEAD);
    assert.equal(artifact.expired, false); assert(/^sha256:[0-9a-f]{64}$/.test(artifact.digest));
    assert(Number.isSafeInteger(artifact.size_in_bytes) && artifact.size_in_bytes > 0 && artifact.size_in_bytes <= 32 * 1024 * 1024);
    const response = await get(repo + '/actions/artifacts/' + artifact.id + '/zip', 32 * 1024 * 1024);
    assert.equal(response.bytes.length, artifact.size_in_bytes); assert.equal(identity(response.bytes).sha256, artifact.digest.slice(7));
    result.artifact = { artifactId: String(artifact.id), ...(await save('artifact-' + artifact.id + '.zip', response)),
      completeUploadedMemberReadbackPending: true, finiteControlsAndUnresolvedComparisonPending: true };
  } else result.artifactState = 'No uploaded artifact on the exact terminal run; missing evidence is unaccepted.';
  const commitResponse = await get(repo + '/git/commits/' + HEAD, 1024 * 1024); await save('commit.json', commitResponse);
  const commit = JSON.parse(commitResponse.bytes); assert.equal(commit.sha, HEAD); assert(/^[0-9a-f]{40}$/.test(commit.tree.sha));
  const treeResponse = await get(repo + '/git/trees/' + commit.tree.sha + '?recursive=1', 32 * 1024 * 1024);
  await save('tree.json', treeResponse); const tree = JSON.parse(treeResponse.bytes);
  assert.equal(tree.sha, commit.tree.sha); assert.equal(tree.truncated, false); assert(tree.tree.length <= 250000);
  for (const [index, source] of expectedSources.entries()) {
    const matches = tree.tree.filter(row => row.path === source.path); assert.equal(matches.length, 1);
    const row = matches[0]; assert.equal(row.type, 'blob'); assert(['100644', '100755'].includes(row.mode));
    assert.equal(row.size, source.bytes); const response = await get(repo + '/git/blobs/' + row.sha, 1024 * 1024);
    const saved = await save('source-' + index + '-blob.json', response);
    result.sourceAPIs.push({ expectedPath: source.path, expectedSourceIdentity: { bytes: source.bytes, sha256: source.sha256 },
      actualTreeGitBlob: row.sha, rawBlobAPI: saved, sourceBytesNotExecuted: true, strictByteQualificationPending: true });
  }
}
await fs.writeFile(path.join(folder, 'collection-summary.json'), JSON.stringify(result, null, 2) + '\n', { flag: 'wx' });
console.log(JSON.stringify({ folder, runId: RUN, jobId: JOB, status: run.status, conclusion: run.conclusion,
  artifact: result.artifact, qualificationPerformed: false }));
