    {
      "id": "grafana.candidate.efdf00076f0970b0b0a9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Instruct headless browser instance to use a default device scale factor when not provided by Grafana, for example, when rendering panel image of alert. Default is `1`. Using a higher value produces more detailed images (higher DPI), but requires more disk space to store an image.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[plugin.grafana-image-renderer]`",
        "`rendering_viewport_device_scale_factor`"
      ],
      "source": {
