          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.d4780d4bff34ab12bd9d",
      "syntaxRole": "list-item",
      "sourceText": "- Grafana permissions are additive. A user's basic role, such as Viewer, can grant access to the data source independently of team-scoped rules. Remove role and team permissions that aren't required so that only the intended teams have **Query** permission on the LBAC data source.",
      "headingPath": [
        "Troubleshoot Loki data source issues",
        "Label-based access control (LBAC) issues",
        "Teams can still query all logs"
      ],
      "source": {
        "path": "docs/sources/datasources/loki/troubleshooting/index.md",
