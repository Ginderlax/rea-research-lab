import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
const root=import.meta.dirname,go=path.resolve(root,'../..'),sha=b=>createHash('sha256').update(b).digest('hex'),json=async p=>JSON.parse(await fs.readFile(path.join(root,p))),write=async(p,v)=>fs.writeFile(path.join(root,p),JSON.stringify(v,null,2)+'\n');
async function fp(p){const b=await fs.readFile(path.join(root,p));return{path:p,bytes:b.length,sha256:sha(b)};}
async function walk(prefix=''){const out=[];for(const e of await fs.readdir(path.join(root,prefix),{withFileTypes:true})){const p=(prefix?prefix+'/':'')+e.name;if(e.isSymbolicLink())throw new Error('Symlink');if(e.isDirectory())out.push(...await walk(p));else out.push(p);}return out.sort();}
const acquired=await json('acquisition.json');
for(const row of [...acquired.records,...acquired.parser.selectedFiles]){const b=await fs.readFile(path.join(root,row.path));if(b.length!==row.bytes||sha(b)!==row.sha256)throw new Error('Acquired byte mutation '+row.path);}
const archive=await fs.readFile(path.join(root,'.local/typescript-5.9.3.tgz'));if('sha512-'+createHash('sha512').update(archive).digest('base64')!==acquired.parser.integrity)throw new Error('Parser SRI changed');
const source=await fs.readFile(path.join(root,'source/vscode.d.ts.snapshot')),packaged=await fs.readFile(path.join(go,acquired.releaseComparison.path));
const normalizedEqual=source.toString().replaceAll('\r\n','\n')===packaged.toString().replaceAll('\r\n','\n');if(!normalizedEqual)throw new Error('Released declaration differs beyond newlines');
await write('release-byte-comparison.json',{rawSource:await fp('source/vscode.d.ts.snapshot'),releasedCarrierPath:acquired.releaseComparison.path,releasedBytes:packaged.length,releasedSha256:sha(packaged),rawByteEquality:source.equals(packaged),crlfToLfTextEquality:normalizedEqual,normalization:'Only CRLF pairs replaced with LF for this separate comparison. Inventory offsets/hashes use original official Git LF bytes.',originalProgramExecutions:0,wholeCarrierReauthenticatedHere:false,priorVendorCarrier:acquired.releaseComparison.vendorCarrierMetadata});
const initialAcquisition=await json('failures/acquire-notice-v1/attempt.json'),receivedPostcheck=[];for(const r of initialAcquisition.received){const now=await fp(r.path);receivedPostcheck.push({...now,unchanged:now.bytes===r.bytes&&now.sha256===r.sha256});}if(receivedPostcheck.some(r=>!r.unchanged))throw new Error('Acquisition attempt bytes changed');await write('acquisition-failure-postcheck.json',{at:new Date().toISOString(),earliestReceivedFilesUnchanged:receivedPostcheck,initialFailuresAreToolTranscriptions:true,networkRequestsAcrossThreeAttempts:18,extraInitialWebOpenCalls:3,webGitTreeOpenResult:'Internal Error; subsequent direct official GitHub commit API acquisition succeeded.'});
const runs=[];for(const name of ['initial','corrected','final']){const r=await json('runs/'+name+'/validation.json');if(!r.sourceStable)throw new Error('Run source changed');runs.push({name,receipt:await fp('runs/'+name+'/validation.json'),...r,stdoutCaptureCap:'4MiB per stream; cap-stopped run preserves collected chunks and does not claim complete diagnostic output.'});}
const final=runs.at(-1);if(final.steps.length!==2||final.steps.some(r=>r.code!==0||r.problem))throw new Error('Final run failed');for(const r of final.inputSources){const now=await fp(r.path);if(now.bytes!==r.bytes||now.sha256!==r.sha256)throw new Error('Final tested source changed');}
const raw=(await fs.readFile(path.join(root,'runs/final/test.stdout.txt'))).toString(),number=n=>Number(new RegExp('^# '+n+' (\\d+)$','m').exec(raw)?.[1]),marker=JSON.parse(/^# REA_API_DISCOVERY_PARSER (.+)$/m.exec(raw)[1]);if(number('tests')!==8||number('pass')!==8||number('fail')!==0||number('skipped')!==0||marker.parseCalls!==9)throw new Error('Final TAP count mismatch');
const inventory=await json('results/api-inventory.json'),summary=await json('results/summary.json'),comments=await json('results/source-comment-census.json');if(inventory.source.sha256!==sha(source)||summary.inventory.sha256!==(await fp('results/api-inventory.json')).sha256||comments.source.sha256!==sha(source)||!comments.sourceStable)throw new Error('Output binding changed');
if(Object.values(inventory.counts.byKind).reduce((a,b)=>a+b,0)!==inventory.counts.declarations||Object.values(inventory.counts.byKind).some(v=>!Number.isSafeInteger(v)))throw new Error('Constructor count invalid');
const oldLocation='outputs/rea-research-lab/products/rea-studio/requirements/keepass-manual-supplement/existing-requirements-binding.json',oldBytes=await fs.readFile(path.join(go,oldLocation)),old=JSON.parse(oldBytes),registries=[],sources=[],ids=[];
for(const name of ['system-products.json','workspace-products.json','visual-products.json']){const p='outputs/rea-research-lab/products/rea-studio/requirements/'+name,b=await fs.readFile(path.join(go,p)),j=JSON.parse(b),cap=name==='system-products.json'?j.products.flatMap(p=>p.capabilities.map(r=>r.id)):name==='workspace-products.json'?j.capabilities.map(r=>r.id):j.baselineProducts.flatMap(p=>p.requirements.map(r=>r.id));registries.push({path:p,bytes:b.length,sha256:sha(b)});sources.push(...j.sources.map(r=>({registry:name,id:r.id,sha256:r.sha256})));ids.push(...cap.map(id=>({registry:name,id})));}
const stable=a=>JSON.stringify(a.sort((a,b)=>(a.registry+'/'+a.id).localeCompare(b.registry+'/'+b.id)));if(stable(sources)!==stable(old.originalSources)||stable(ids)!==stable(old.capabilityIds))throw new Error('Original registry identities changed');
await write('registry-identity-binding.json',{at:new Date().toISOString(),sourceSHAIdentities:159,capabilityIDs:232,allMatchHistoricalSupplement:true,historicalBinding:{path:oldLocation,bytes:oldBytes.length,sha256:sha(oldBytes)},currentParentMetadataObservation:registries,oldWholeRegistryByteHashesRebound:false,registryModified:false,purpose:'Read-only identity comparison; supplementary API declarations do not modify original fingerprint/capability denominators.'});
const all=await walk(),local=all.filter(p=>p.startsWith('.local/'));await write('local-only-cache.json',{schema:'rea-source-study-local-cache/v1',count:local.length,records:await Promise.all(local.map(fp)),reason:'Authenticated parser archive/runtime/package and notices are prerequisites kept local; no archive/native executable is proposed for public preservation.',fullParserDistribution:false});
const sourceBindings=await Promise.all(['source/vscode.d.ts.snapshot','source/LICENSE.txt.snapshot','source/package.json.snapshot','source/commit.json.snapshot','source/vendor-release-metadata.json.snapshot','parser/npm-metadata.json.snapshot','parser/LICENSE.txt.snapshot','parser/ThirdPartyNoticeText.txt.snapshot','inventory.mjs','inventory.test.mjs','parser-loader.mjs','build.mjs','run.mjs','comment-census.mjs'].map(fp));
const receipt={schema:'rea-vscode-extension-api-discovery-validation/v1',at:new Date().toISOString(),release:'1.140.0',commit:'07f806f999227108933c2e30515b26eecc1fda74',sourceBindings,inventory:await fp('results/api-inventory.json'),summary:await fp('results/summary.json'),commentCensus:await fp('results/source-comment-census.json'),counts:inventory.counts,publicNamedDeclarationsExcludingInlineRecords:inventory.counts.declarations-inventory.counts.inlineSignatureAndTypeLiteralMembers,final:{tests:8,pass:8,fail:0,skip:0,cancelled:0,sourceStable:true,inputFingerprints:19,buildAstParseCalls:1,testAstParseCalls:9,totalAstParseCalls:10,parserModuleProcesses:2,receipt:await fp('runs/final/validation.json')},operations:{directAcquisitionHTTPRequests:18,initialWebOpenCalls:3,completedBuildProcesses:3,testCampaigns:3,parserModuleProcessesAcrossCampaigns:6,commentCensusParserModuleProcesses:1,commentScannerCalls:1,corpusAstParsesAcrossBuildsAndTests:6,allAstParseCallsAcrossCampaigns:{minimum:28,maximum:29,reason:'Cap-stopped campaign has no final marker; final test-file parse count uncertain by one.'},originalVSCodeProgramExecutions:0,originalExtensionHostExecutions:0,originalGUIExecutions:0,performanceMeasurements:0},campaignHistory:runs.map(r=>({name:r.name,receipt:r.receipt,steps:r.steps,sourceStable:r.sourceStable})),commentCounts:{sourceComments:comments.sourceComments,sourceJSDocForms:comments.sourceJSDocForms,publicJSDocAttachments:comments.publicJSDocAttachmentCount,uniquePublicJSDocComments:comments.uniquePublicJSDocComments,unattached:comments.unattachedToPublicInventory},releaseByteComparison:await fp('release-byte-comparison.json'),redistribution:{fullApiDeclarationPermitted:true,license:'MIT',licenseProof:await fp('source/LICENSE.txt.snapshot'),notice:'Retain exact Microsoft copyright and MIT permission notice alongside source/derived inventory; scope excludes product binary/marketplace/other materials.',parser:'Apache-2.0, local-only runtime/archive; exact licen