    {
      "id": "grafana.candidate.9a2cbe7ec094efc45923",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Silences stop notifications from being created for a specified time window but do not interrupt alert evaluation. Use them to temporarily prevent alert notifications, such as during incident response or a maintenance window.",
      "headingPath": [
        "Configure silences"
      ],
      "source": {
