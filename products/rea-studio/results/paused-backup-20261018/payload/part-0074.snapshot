    {
      "id": "grafana.candidate.985b931f382b53d64773",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use **Default** to create basic query conditions and route alerts directly to a contact point. Use **Advanced** for more complex query definitions, or to route alerts using notification policies.",
      "headingPath": [
        "Configure Grafana-managed alert rules",
        "Before you begin",
        "Default versus Advanced options"
      ],
      "source": {
