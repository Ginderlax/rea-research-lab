"""Lightweight independent source/lineage audit. Candidate code is read as data only."""
from pathlib import Path
import hashlib,json,re,subprocess
BASE=Path(__file__).resolve().parent.parent
W=BASE/'work'; REPO=BASE/'outputs/rea-research-lab'
S=W/'notes-new-todo-cloud-r4-final-r4-next'; C=S/'public-candidate'
P='products/rea-studio/'; E=P+'experiments/notes-new-todo/'
T=E+'failure-transition-38926216286/'
HEAD='b635c33d971768682360e2c518b9b2bb0840985b'
def ident(b): return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def read(p):
    assert p.is_file() and not p.is_symlink(),str(p)
    return p.read_bytes()
def load(p): return json.loads(read(p).decode('utf-8-sig'))
def pin(b,row):
    assert ident(b)=={k:row[k] for k in ('bytes','sha256')},row.get('path')
def git(*args):
    return subprocess.run(['git',*args],cwd=REPO,check=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE).stdout
def text(p): return read(p).decode('utf-8-sig').replace('\r\n','\n')
def source(name): return read(C/name) if (C/name).is_file() else git('show',HEAD+':'+name)
