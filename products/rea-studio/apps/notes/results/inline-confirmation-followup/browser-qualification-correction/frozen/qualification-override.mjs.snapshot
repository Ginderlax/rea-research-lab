// Source-only publication metadata correction; no application imports/actions.
import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
export const BASE_MAP_SHA256='ec5839d46fd9ff16e0e752bfac86b850689731b0bfa6a9fb87ffd4d4aaa8c2d7';
const hash=b=>createHash('sha256').update(b).digest('hex');
export function applyQualificationOverrides(baseBytes,override){
 assert.ok(Buffer.isBuffer(baseBytes)&&baseBytes.length<=2*1024*1024);assert.equal(hash(baseBytes),BASE_MAP_SHA256);assert.equal(override.schema,'rea-notes-corrected-browser-qualification-overrides/v1');assert.equal(override.baseMap.sha256,BASE_MAP_SHA256);assert.equal(override.baseMap.bytes,baseBytes.length);assert.equal(override.rows.length,12);
 const base=JSON.parse(new TextDecoder('utf-8',{fatal:true}).decode(baseBytes));assert.equal(base.schema,'rea-notes-inline-browser-final-public-map/v1');assert.equal(base.payload.length,818);const corrected=JSON.parse(JSON.stringify(base)),keys=new Set();for(const r of override.rows){assert.equal(r.changedField,'qualification');assert.equal(r.epoch,'corrected-browser');assert.equal(r.sourceRoot,'work/notes-inline-cancel-no-read-browser-next');assert.ok(!keys.has(r.publicPath));keys.add(r.publicPath);const old=base.payload.find(p=>p.publicPath===r.publicPath),current=corrected.payload.find(p=>p.publicPath===r.publicPath);assert.ok(old&&current);assert.deepEqual(old,r.before);assert.equal(old.actualMediaType,'image/jpeg');assert.equal(old.originalFilenameExtensionMismatch,true);for(const k of['epoch','sourceRoot','sourcePath','publicPath','bytes','sha256'])assert.deepEqual(old[k],r[k]);assert.equal(typeof r.after.qualification,'string');assert.ok(r.after.qualification.length>0&&r.after.qualification!==old.qualification);assert.deepEqual({...r.after,qualification:old.qualification},old);assert.deepEqual(r.originalWrongQualification,old.qualification);current.qualification=r.after.qualification;}
 const allCorrectedJpeg=base.payload.filter(p=>p.epoch==='corrected-browser'&&p.actualMediaType==='image/jpeg');assert.equal(allCorrectedJpeg.length,12);assert.deepEqual([...keys].sort(),allCorrectedJpeg.map(r=>r.publicPath).sort());assert.equal(corrected.payload.length,base.payload.length);for(let i=0;i<base.payload.length;i++){const a=base.payload[i],b=corrected.payload[i];assert.deepEqual(keys.has(a.publicPath)?{...b,qualification:a.qualification}:b,a);}assert.deepEqual({...corrected,payload:base.payload},base);assert.equal(hash(baseBytes),BASE_MAP_SHA256);return corrected;
}
