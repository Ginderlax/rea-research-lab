import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const root=import.meta.dirname,sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)}),rows=[];const source=JSON.parse(await fs.readFile(path.join(root,'candidate-final41.json')));for(const r of source)assert.deepEqual(id(await fs.readFile(path.join(root,r.path))),{bytes:r.bytes,sha256:r.sha256});async function walk(folder=''){for(const e of(await fs.readdir(path.join(root,folder),{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const p=folder?folder+'/'+e.name:e.name;assert.equal(e.isSymbolicLink(),false);if(e.isDirectory())await walk(p);else{assert.ok(e.isFile());if(p!=='freeze-manifest.json')rows.push({path:p,...id(await fs.readFile(path.join(root,p)))});}}}await walk();const m={schema:'rea-editor-pattern-textarea-correction-freeze/v1',strict:true,frozenAt:new Date().toISOString(),inventory:rows,payloads:rows.length,payloadBytes:rows.reduce((n,r)=>n+r.bytes,0),focused100Source41:true,old573Plan44Retained:true,negative141StrictReference:true,productionWrites:0,actualCorrectedBrowserAcceptance:false,independentAcceptancePending:true};const b=Buffer.from(JSON.stringify(m,null,2)+'\n');await fs.writeFile(path.join(root,'freeze-manifest.json'),b,{flag:'wx'});for(const r of rows)assert.deepEqual(id(await fs.readFile(path.join(root,r.path))),{bytes:r.bytes,sha256:r.sha256});console.log(JSON.stringify({payloads:rows.length,bytes:m.payloadBytes,manifest:id(b),validation:id(await fs.readFile(path.join(root,'validation.json'))),client:id(await fs.readFile(path.join(root,'candidate/products/rea-studio/apps/editor/client.mjs'))),overlay:id(await fs.readFile(path.join(root,'correction-public-overlay.json'))),strictAfter:true}));
