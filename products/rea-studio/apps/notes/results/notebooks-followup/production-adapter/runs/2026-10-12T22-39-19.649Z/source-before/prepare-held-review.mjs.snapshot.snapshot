import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
const here=import.meta.dirname,work=path.dirname(here),source=await fs.readFile(path.join(work,'review-notes-notebooks.mjs'),'utf8');let output=source;
const prefix='products/rea-studio/apps/notes/results/notebooks-followup/stage';
for(const [old,next] of [["stage=path.join(work,'notes-notebooks-next')","stage=work"],["out=path.join(work,'notes-notebooks-root-review')","out=path.join(work,'.local/root-held-review')"],["path.join(stage,'stage-validation.json')","path.join(stage,'"+prefix+"/stage-validation.json.snapshot')"],["path.join(stage,'strict-manifest.json')","path.join(stage,'"+prefix+"/strict-manifest.json.snapshot')"],["path.join(stage,e.path)","path.join(stage,'"+prefix+"',e.path+'.snapshot')"],["schema:'rea-root-notebook-independent-review/v1'","schema:'rea-adapted-root-notebook-held-review/v1'"],["reviewedStageTests:28","historicalReviewedStageTests:28,actualAdapterHeldPersistenceCases:2"]]){if(!output.includes(old))throw new Error('Missing exact held-review adaptation '+old);output=output.replace(old,next)}
await fs.writeFile(path.join(here,'held-review.mjs'),output);await fs.writeFile(path.join(here,'held-review-adaptations.json'),JSON.stringify({originalSha256:createHash('sha256').update(source).digest('hex'),adapterSha256:createHash('sha256').update(output).digest('hex'),scenarioBodiesUnchanged:true,changes:'Root paths, preserved historical input paths, owned output path and evidence scope fields only.'},null,2));
