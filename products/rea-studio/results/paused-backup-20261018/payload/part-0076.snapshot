    {
      "id": "grafana.candidate.80094739e4c81ac65e26",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Select spans from a specific service or match services by pattern. You can use the [Service Graph view](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/tempo/service-graph/) to identify which services have high error rates or latency, then query those services with TraceQL.",
      "headingPath": [
