    {
      "id": "grafana.candidate.4b726696d67a7300e4ed",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can switch between options at any time. After you create an alert rule, Grafana remembers your last selection and uses it as the default for the next rule.",
      "headingPath": [
        "Configure Grafana-managed alert rules",
        "Before you begin",
        "Default versus Advanced options"
      ],
      "source": {
        "path": "docs/sources/alerting/alerting-rules/create-grafana-managed-rule.md",
