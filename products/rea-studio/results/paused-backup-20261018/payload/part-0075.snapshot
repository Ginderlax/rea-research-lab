        "lineStart": 340,
        "lineEnd": 340,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/breaking-changes/breaking-changes-v10-0.md#L340-L340"
