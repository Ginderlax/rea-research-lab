    {
      "id": "grafana.candidate.76eb4967500f6ba63789",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Some metrics also have dimensions, which associate additional metadata. Dimensions are represented as key-value pairs assigned to each value of a metric. Grafana can display and filter metrics based on dimension values.",
      "headingPath": [
        "Azure Monitor query editor",
        "Query Azure Monitor Metrics",
        "Filter with dimensions"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/query-editor/index.md",
