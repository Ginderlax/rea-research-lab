// Exact capture and import helper bodies used by the real browser campaign.
async (label,shot=false)=>{ var dom=await sketchTab.playwright.domSnapshot(); var read=await sketchTab.playwright.evaluate(()=>({scene:JSON.parse(document.querySelector('textarea[aria-label="Studio scene JSON"]').value),status:document.querySelector('#app-root [role="status"]').textContent,selection:document.querySelector('#app-root canvas').nextElementSibling.textContent,canvas:{x:document.querySelector('#app-root canvas').getBoundingClientRect().x,y:document.querySelector('#app-root canvas').getBoundingClientRect().y,width:document.querySelector('#app-root canvas').getBoundingClientRect().width,height:document.querySelector('#app-root canvas').getBoundingClientRect().height},savedOptions:Array.from(document.querySelector('select[aria-label="Saved scenes"]').options,o=>({value:o.value,text:o.textContent}))})); var row={label,at:new Date().toISOString(),dom,read,tabId:sketchTab.id}; if(shot){var b=Buffer.from(await sketchTab.screenshot({fullPage:false}));var media=b.subarray(0,3).toString('hex')==='ffd8ff'?'image/jpeg':'image/png';var file=label+(media==='image/jpeg'?'.jpeg':'.png');await sketchFs.writeFile(sketchRoot+'/'+file,b,{flag:'wx'});row.screenshot={path:file,bytes:b.length,sha256:sketchCrypto.createHash('sha256').update(b).digest('hex'),actualMediaType:media,qualification:'Owned actual Chrome raster on exact corrected188 Sketch runtime with declared private layout route; pair with DOM/HTTP/disk observations. No original GUI or whole-product claim.'};} sketchSteps.push(row);await sketchFs.writeFile(sketchRoot+'/browser-steps.json',JSON.stringify(sketchSteps,null,2)+'\n');return row;}
async (which,label)=>{await sketchTab.playwright.getByLabel('Studio scene JSON',{exact:true}).fill(JSON.stringify(sketchFixtures[which]));await sketchTab.playwright.getByRole('button',{name:'Import JSON as new scene',exact:true}).click();return(await sketchCapture(label)).read;}
(a,b)=>sketchAssert.equal(JSON.stringify(a),JSON.stringify(b))
