// Strict independent source-only receipt freeze; no behavior is run.
import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const root=import.meta.dirname,hash=b=>createHash('sha256').update(b).digest('hex'),inventory=[];
async function walk(d,p=''){for(const e of(await fs.readdir(d,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){assert.equal(e.isSymbolicLink(),false);const name=p+e.name,q=path.join(d,e.name);if(e.isDirectory())await walk(q,name+'/');else{assert.ok(e.isFile());assert.notEqual(name,'freeze-manifest.json');const b=await fs.readFile(q);inventory.push({path:name,bytes:b.length,sha256:hash(b)});}}}
const validation=await fs.readFile(path.join(root,'review-validation.json')),completion=await fs.readFile(path.join(root,'completion-validation.json'));assert.equal(JSON.parse(validation).sourceOnlyAcceptance,true);assert.equal(JSON.parse(completion).strictSevenEpochsStillExact,true);await walk(root);const manifest={schema:'rea-sketch-layout-independent-source-plan-review-freeze/v1',at:new Date().toISOString(),files:inventory.length,totalBytes:inventory.reduce((n,r)=>n+r.bytes,0),inventory,selfExcluded:true,validationSHA256:hash(validation),completionSHA256:hash(completion),sourceOnly:true,productionWrites:0},b=Buffer.from(JSON.stringify(manifest,null,2)+'\n');await fs.writeFile(path.join(root,'freeze-manifest.json'),b,{flag:'wx'});for(const r of inventory){const b=await fs.readFile(path.join(root,r.path));assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);}console.log(JSON.stringify({files:manifest.files,bytes:manifest.totalBytes,manifestSHA256:hash(b),validationSHA256:hash(validation),completionSHA256:hash(completion),sourceOnlyAccepted:true,behaviorExecutions0:true}));
