    {
      "id": "grafana.candidate.acd714835dd4fb5782e5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The most common problems are related to the query and response from your data source. Even if it looks like a bug or visualization issue in Grafana, it is almost always a problem with the data source query or the data source response. Start by inspecting your panel query and response.",
      "headingPath": [
        "Troubleshoot queries",
        "Inspect your query request and response"
      ],
