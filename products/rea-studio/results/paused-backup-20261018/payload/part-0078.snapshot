    {
      "id": "grafana.candidate.b9972a132247af9b6afa",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The input and output results sets can help you debug a transformation.",
      "headingPath": [
        "Transform data",
        "Debug a transformation"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/transform-data/index.md",
