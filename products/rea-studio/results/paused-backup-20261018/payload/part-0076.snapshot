          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.d817e827ea592bc229f8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For Prometheus data sources, this view is read-only. To modify these rules, update your Prometheus rule files directly.",
      "headingPath": [
        "Prometheus alerting",
        "View data source-managed rules"
      ],
      "source": {
