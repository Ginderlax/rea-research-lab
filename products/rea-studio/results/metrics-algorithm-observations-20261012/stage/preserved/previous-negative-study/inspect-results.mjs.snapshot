import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),source=path.resolve(here,'../metrics-selector-measurement-next'),read=async name=>JSON.parse(await fs.readFile(path.join(source,name)));
const timing=await read('results/timing-attempt-1791843146474.json'),paired=JSON.parse(await fs.readFile(timing.result.output)),memory=await read('results/memory-observations-control-1791843441822.json'),manifest=await read('memory-preflight.control.json');
const median=rows=>[...rows].sort((a,b)=>a-b)[Math.floor(rows.length/2)],stats=rows=>({n:rows.length,median:median(rows),min:Math.min(...rows),max:Math.max(...rows)}),roles=['original','baseline','candidate'];
const timingSummary=Object.keys(manifest.expectedFiles).map(name=>{const values=Object.fromEntries(roles.map(role=>[role,paired.records.filter(row=>row.caseName===name&&row.implementation===role).map(row=>row.result.millisecondsPerCall)]));const result=Object.fromEntries(roles.map(role=>[role,stats(values[role])]));return {name,...result,candidateVsBaselinePct:100*(result.candidate.median/result.baseline.median-1),candidateVsOriginalPct:100*(result.candidate.median/result.original.median-1)};});
const memorySummary=Object.keys(manifest.expectedFiles).map(name=>{const values=Object.fromEntries(roles.map(role=>[role,memory.samples.filter(row=>row.caseName===name&&row.implementation===role).map(row=>{const checkpoint=label=>row.result.checkpoints.find(value=>value.name===label);return {observedPeakRSS:row.ownedPIDObserver.peakRSS,lifetimePeakRSS:Math.max(...row.result.checkpoints.map(value=>value.lifetimePeakResidentKiB))*1024,retainedHeapSigned:checkpoint('retainedAfterGC').heapUsed-checkpoint('beforeRetention').heapUsed,releasedHeapSigned:checkpoint('releasedAfterGC').heapUsed-checkpoint('beforeRetention').heapUsed};})]));return {name,roles:Object.fromEntries(roles.map(role=>[role,Object.fromEntries(Object.keys(values[role][0]).map(metric=>[metric,stats(values[role].map(value=>value[metric]))]))]))};});
assert.equal(paired.records.length,147);assert.equal(memory.samples.length,147);
console.log(JSON.stringify({timingPath:timing.result.output,timingInterval:timing.interval,pairedInterval:paired.interval,memoryInterval:memory.interval,timingCounts:paired.records.length,memoryCounts:memory.samples.length,memoryComparisons:memory.samples.reduce((sum,row)=>sum+row.result.comparisons,0),timingResultKeys:Object.keys(paired.records[0].result),memorySampleKeys:Object.keys(memory.samples[0]),memoryCheckpointNames:memory.samples[0].result.checkpoints.map(row=>row.name),manifestKeys:Object.keys(manifest),manifestLimits:manifest.limits,timingSummary,memorySummary},null,2));
