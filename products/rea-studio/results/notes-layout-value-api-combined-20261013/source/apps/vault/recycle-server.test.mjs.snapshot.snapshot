import test from 'node:test';import assert from 'node:assert/strict';import{randomUUID}from'node:crypto';import{handle,dispose}from'./server.mjs';
const password='Synthetic-recycle-master';
async function fixture(t){const records=new Map(),workspace={root:'recycle-'+randomUUID()},store={get:async(k,d)=>records.has(k)?structuredClone(records.get(k)):d,set:async(k,v)=>{records.set(k,structuredClone(v))}},api=(action,input={})=>handle({action,input,store,workspace});t.after(()=>dispose(workspace));await api('create',{password});await api('save',{title:'A',group:'Old',password:'only-synthetic-A',notes:'A notes'});await api('save',{title:'B',group:'New',password:'only-synthetic-B'});return {records,workspace,store,api};}
test('actual encrypted session recycle/recover/purge persists across lock/reload and retains history',async t=>{const f=await fixture(t),rows=(await f.api('list')).entries,a=rows.find(e=>e.title==='A');const old=(await f.api('read',{id:a.id})).entry;await f.api('save',{...old,password:'A newer'});const current=(await f.api('read',{id:a.id})).entry;await f.api('recycleDelete',{id:a.id,revision:current.recycleRevision,confirm:true});assert.equal((await f.api('list')).entries.length,1);await assert.rejects(f.api('read',{id:a.id}),/not found/);await f.api('lock');await f.api('unlock',{password});const bin=(await f.api('recycleList')).entries;assert.equal(bin.length,1);const preview=(await f.api('recycleRead',{id:a.id,revision:bin[0].recycleRevision})).entry;assert.equal(preview.password,'A newer');await f.api('recycleRestore',{id:a.id,revision:bin[0].recycleRevision,confirm:true});assert.equal((await f.api('historyList',{id:a.id})).revisions.length,1);const fresh=(await f.api('read',{id:a.id})).entry;await f.api('recycleDelete',{id:a.id,revision:fresh.recycleRevision,confirm:true,permanent:true});await f.api('lock');await f.api('unlock',{password});assert.equal((await f.api('recycleList')).entries.length,0);await assert.rejects(f.api('read',{id:a.id}),/not found/);assert(!JSON.stringify(f.records.get('vault.database')).includes('only-synthetic'));});
test('failed persistence publishes neither deletion nor history/bin mutation',async t=>{const f=await fixture(t),[a]= (await f.api('list')).entries,before=structuredClone(f.records.get('vault.database'));f.store.set=async()=>{throw new Error('Synthetic rejected persistence')};await assert.rejects(f.api('recycleDelete',{id:a.id,revision:a.recycleRevision,confirm:true}),/rejected persistence/);assert.deepEqual(f.records.get('vault.database'),before);assert.equal((await f.api('list')).entries.length,2);assert.equal((await f.api('recycleList')).entries.length,0);});
test('queued caller input is captured and stale competing deletion rejects after durable commit',async t=>{const f=await fixture(t),[a]= (await f.api('list')).entries;let release,entered;const gate=new Promise(r=>release=r),start=new Promise(r=>entered=r),set=f.store.set;f.store.set=async(k,v)=>{entered();await gate;return set(k,v)};const captured={id:a.id,revision:a.recycleRevision,confirm:true};const first=f.api('recycleDelete',captured);captured.id='bad';await start;const second=f.api('recycleDelete',{id:a.id,revision:a.recycleRevision,confirm:true});release();await first;await assert.rejects(second,/selection changed/);assert.equal((await f.api('recycleList')).entries.length,1);});
test('group deletion and whole-bin emptying explicitly reject with encrypted bytes unchanged',async t=>{const f=await fixture(t),before=structuredClone(f.records.get('vault.database'));for(const action of['deleteGroup','recycleGroup','emptyRecycleBin'])await assert.rejects(f.api(action,{confirm:true}),/unsupported/);assert.deepEqual(f.records.get('vault.database'),before);});
test('recycled entries cannot be edited or restored through active history/TOTP commands',async t=>{const f=await fixture(t),[a]=(await f.api('list')).entries,old=(await f.api('read',{id:a.id})).entry;await f.api('save',{...old,password:'only-synthetic-version'});const revision=(await f.api('historyList',{id:a.id})).revisions[0],fresh=(await f.api('read',{id:a.id})).entry;await f.api('recycleDelete',{id:a.id,revision:fresh.recycleRevision,confirm:true});const before=structuredClone(f.records.get('vault.database'));for(const action of['historyList','historyRead','historyRestore','totp'])await assert.rejects(f.api(action,{id:a.id,...revision,confirm:true}),/recycled entry/);await assert.rejects(f.api('save',{...old}),/recycled entry/);assert.deepEqual(f.records.get('vault.database'),before);});
