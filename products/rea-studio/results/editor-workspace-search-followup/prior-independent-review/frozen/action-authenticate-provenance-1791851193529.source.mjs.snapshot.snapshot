import fs from 'node:fs/promises';
import {createReadStream} from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
const here=import.meta.dirname,source=path.resolve(here,'../vscode-original-acquisition-record'),candidate=path.resolve(here,'../editor-search-next'),sha=bytes=>createHash('sha256').update(bytes).digest('hex');
const fp=async file=>{const bytes=await fs.readFile(file);return {bytes:bytes.length,sha256:sha(bytes)};},streamFP=async file=>{const hash=createHash('sha256');let bytes=0;for await(const chunk of createReadStream(file)){bytes+=chunk.length;hash.update(chunk);}return {bytes,sha256:hash.digest('hex')};};
const manifestBytes=await fs.readFile(path.join(source,'freeze-manifest.json')),manifest=JSON.parse(manifestBytes),validation=await fp(path.join(source,'validation.json'));assert.equal(validation.sha256,'6e93be73c9fdc10d011272fbbd6a2c5219c01efda0ff614e201b59f821bf028d');assert.equal(manifest.inventory.length,14);assert.deepEqual((await fs.readdir(source)).sort(),[...manifest.inventory.map(row=>row.path),'freeze-manifest.json'].sort());
for(const row of manifest.inventory)assert.deepEqual(await fp(path.join(source,row.path)),{bytes:row.bytes,sha256:row.sha256});
const beforeBytes=await fs.readFile(path.join(source,'unpacked-source-before.json')),afterBytes=await fs.readFile(path.join(source,'unpacked-source-after.json'));assert.ok(beforeBytes.equals(afterBytes));const tree=JSON.parse(beforeBytes);assert.equal(tree.length,3246);assert.equal(tree.reduce((sum,row)=>sum+row.bytes,0),1044655528);assert.equal(new Set(tree.map(row=>row.path)).size,tree.length);
const acquisition=JSON.parse(await fs.readFile(path.join(source,'acquisition.json.snapshot'))),publisher=JSON.parse(await fs.readFile(path.join(source,'microsoft-update-metadata.json.snapshot'))),identity=JSON.parse(await fs.readFile(path.join(source,'identity-validation.json.snapshot'))),archive=await streamFP(acquisition.archive);assert.deepEqual(archive,{bytes:acquisition.bytes,sha256:acquisition.sha256});assert.equal(archive.sha256,publisher.sha256hash);assert.equal(acquisition.productVersion,publisher.productVersion);assert.equal(acquisition.productCommit,publisher.version);
const unpacked=path.join(path.dirname(acquisition.archive),'unpacked'),verified=[];for(const row of tree){assert.ok(!path.isAbsolute(row.path)&&!row.path.split(/[\\/]/).includes('..'));assert.deepEqual(await streamFP(path.join(unpacked,row.path)),{bytes:row.bytes,sha256:row.sha256});verified.push(row);}
const engineRelative='07f806f999/resources/app/node_modules.asar.unpacked/@vscode/ripgrep-universal/bin/win32-x64/rg.exe',engine=tree.find(row=>row.path===engineRelative);assert.ok(engine);const code=tree.find(row=>row.path==='07f806f999/Code.exe');assert.equal(code.sha256,identity.executableSHA256);assert.equal(identity.exitCode,0);assert.equal(identity.originalGUISessions,0);assert.equal((await fp(path.join(source,'identity.stdout.txt.snapshot'))).sha256,identity.stdoutSHA256);
const candidateManifestBytes=await fs.readFile(path.join(candidate,'freeze-manifest.json')),candidateManifest=JSON.parse(candidateManifestBytes);assert.equal(sha(candidateManifestBytes),'44e8efd72f09c7cc5caa598f43dbe099dd73982477249ecfed2fddfb2a26a7a6');assert.equal(Object.keys(candidateManifest.inventory).length,140);for(const [name,row]of Object.entries(candidateManifest.inventory))assert.deepEqual(await fp(path.join(candidate,name)),row);
const snapshots=[];for(const [root,names,prefix]of [[source,[...manifest.inventory.map(row=>row.path),'freeze-manifest.json'],'provenance'],[candidate,[...Object.keys(candidateManifest.inventory),'freeze-manifest.json'],'candidate']])for(const name of names){const bytes=await fs.readFile(path.join(root,name)),relative='preserved/'+prefix+'/'+name.replaceAll('node_modules','synthetic-excluded-dependency')+'.snapshot';await fs.mkdir(path.dirname(path.join(here,relative)),{recursive:true});await fs.writeFile(path.join(here,relative),bytes,{flag:'wx'});snapshots.push({sourcePath:path.join(root,name),path:relative,bytes:bytes.length,sha256:sha(bytes)});}
for(const row of manifest.inventory)assert.deepEqual(await fp(path.join(source,row.path)),{bytes:row.bytes,sha256:row.sha256});for(const [name,row]of Object.entries(candidateManifest.inventory))assert.deepEqual(await fp(path.join(candidate,name)),row);assert.deepEqual(await streamFP(acquisition.archive),archive);assert.deepEqual(await streamFP(path.join(unpacked,engineRelative)),{bytes:engine.bytes,sha256:engine.sha256});
const receipt={schema:'rea-vscode-original-independent-provenance-authentication/v1',checkedAt:new Date().toISOString(),status:'passed',inventoryFiles:14,manifestSHA256:sha(manifestBytes),receiptSHA256:validation.sha256,all14BeforeAfterAuthenticated:true,extractedFilesAuthenticatedNow:verified.length,extractedBytesAuthenticatedNow:1044655528,extractedLedgerBeforeAfterExact:true,archive,archivePublisherSHA256Matched:true,signatureFreshlyRevalidated:false,historicalMicrosoftValidSignatureBound:true,historicalOriginalCLIInvocations:1,completeHistoricalOSProcessCount:false,newOriginalCLIOrGUIInvocations:0,engine:{path:path.join(unpacked,engineRelative),...engine},candidate:{inventoryFiles:140,manifestSHA256:sha(candidateManifestBytes),receiptSHA256:'bbe91e0d976f3fe15a7f17b9eb8bed49a6c24023ef9fd0090ff4d7c76e98acde',beforeAfterAuthenticated:true,accepted:false},snapshots,archivesAndBinariesCopied:false,coverage:'Full acquired archive/tree byte identity and frozen provenance. Signature status is the exact historical publisher-signature observation, not a new OS validation. No whole Editor/workbench or universal search parity.',fullParity:false,universalSuperiority:false};
await fs.writeFile(path.join(here,'provenance-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:'passed',provenanceFiles:14,extractedFiles:3246,candidateFiles:140,engineSHA256:engine.sha256,exactSnapshots:snapshots.length}));
