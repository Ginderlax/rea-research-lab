import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import{createHash}from'node:crypto';
const work=import.meta.dirname,workspace=path.dirname(work),lab=path.join(workspace,'outputs/rea-research-lab'),prior=path.join(work,'root-flow-link-browser-review-next'),candidate=path.join(work,'flow-native-textarea-normalization-fix-next'),own=path.join(work,'root-flow-corrected-browser-review-next'),sha=b=>createHash('sha256').update(b).digest('hex');
const oldPin='bae3c0a14e33e8bdd083a86046c6f1e15c455805d4d8e24f899ba0d0793c5f2b',newPin='70c19b06ecca7b79a9461cb53680429cee2bdc91e022c5015fdf19b258f69ce9';
async function authority(folder,pin,count){const b=await fs.readFile(path.join(folder,'manifest.json'));assert.equal(sha(b),pin);const m=JSON.parse(b);assert.equal(m.inventory.length,count);for(const r of m.inventory){assert(!r.path.includes('..')&&!r.path.includes('\\')&&!path.isAbsolute(r.path));const q=await fs.readFile(path.join(folder,r.path));assert.equal(q.length,r.bytes);assert.equal(sha(q),r.sha256);}return b;}
const oldManifest=await authority(prior,oldPin,28),newManifest=await authority(candidate,newPin,197);await fs.mkdir(own);
const oldHost=await fs.readFile(path.join(prior,'host.mjs'));assert.equal(sha(oldHost),'23a36c4a38c60f8cc3ba51278746a44c2c2bf7ec4e96b2955949ac88b8d72260');let text=oldHost.toString();
const substitutions=[['work/flow-native-link-next','work/flow-native-textarea-normalization-fix-next'],['0a03866476a81f83762bdfc10d65be639c24f25778b6c03fdac5b9ee906bea5d',newPin],['manifest.files,457','manifest.files,197'],['manifest.inventory.length,457','manifest.inventory.length,197']];
for(const [before,after]of substitutions){assert.equal(text.split(before).length-1,1);text=text.replace(before,after);}let inverse=text;for(const [before,after]of [...substitutions].reverse()){assert.equal(inverse.split(after).length-1,1);inverse=inverse.replace(after,before);}assert.equal(inverse,oldHost.toString());
await fs.writeFile(path.join(own,'host.mjs'),text,{flag:'wx'});await fs.writeFile(path.join(own,'host-before.mjs.snapshot'),oldHost,{flag:'wx'});await fs.writeFile(path.join(own,'collector-adapter.json'),JSON.stringify({substitutions,inverseExact:true,changedOnlyFrozenCandidateAuthority:true,handlerSubstitutions:0,browserTransportAdapters:0},null,2)+'\n',{flag:'wx'});
await fs.writeFile(path.join(own,'prior-browser-manifest.json.snapshot'),oldManifest,{flag:'wx'});await fs.writeFile(path.join(own,'candidate-manifest.json.snapshot'),newManifest,{flag:'wx'});
for(const file of ['seed.json','expected-info.json'])await fs.writeFile(path.join(own,file),await fs.readFile(path.join(prior,file)),{flag:'wx'});
const sources=[];for(const [origin,base,name]of [...['server.mjs','catalog.mjs','lib/storage.mjs','public/index.html','public/studio.mjs','public/style.css'].map(n=>['current-shared-host',path.join(lab,'products/rea-studio'),n]),...['client','server','core','native','native-link','native-regex-worker'].map(n=>['corrected197-candidate',path.join(candidate,'candidate/products/rea-studio'),'apps/flow/'+n+'.mjs'])]){const source=path.join(base,name),b=await fs.readFile(source);if(name==='server.mjs')assert.equal(sha(b),'85fe09b1b52a1d91e9d09c85d99c6e768ac4b793f5d7694a1760a4c0560a0a94');const p=path.join(own,'host',name);await fs.mkdir(path.dirname(p),{recursive:true});await fs.writeFile(p,b,{flag:'wx'});sources.push({origin,source:path.relative(workspace,source).replaceAll('\\','/'),materialized:path.relative(own,p).replaceAll('\\','/'),bytes:b.length,sha256:sha(b)});}
const collector=await fs.readFile(path.join(own,'host.mjs'));sources.push({origin:'authority-only adapted owned collector',source:path.relative(workspace,path.join(own,'host.mjs')).replaceAll('\\','/'),materialized:'host.mjs',bytes:collector.length,sha256:sha(collector)});assert.equal(sources.length,13);await fs.writeFile(path.join(own,'source-before.json'),JSON.stringify(sources,null,2)+'\n',{flag:'wx'});
await authority(prior,oldPin,28);await authority(candidate,newPin,197);for(const r of sources){const q=await fs.readFile(path.join(workspace,r.source));assert.equal(q.length,r.bytes);assert.equal(sha(q),r.sha256);assert(q.equals(await fs.readFile(path.join(own,r.materialized))));}
await fs.writeFile(path.join(own,'preparation-collector.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});await fs.writeFile(path.join(own,'preparation.json'),JSON.stringify({at:new Date().toISOString(),preparedOnly:true,hostStarted:false,browserStarted:false,sourceCount:13,sourceStable:true,oldNegativeBrowserManifestSHA256:oldPin,correctedAuthorManifestSHA256:newPin,collectorSHA256:sha(collector),authorityOnlySubstitutions:4,inverseExact:true,originalExecutions:0,productionWrites:0,independentReviewPending:true,browserAcceptancePending:true,user4311Touched:false},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({preparedOnly:true,collectorSHA256:sha(collector),sourceCount:13,hostStarted:false,browserStarted:false}));
