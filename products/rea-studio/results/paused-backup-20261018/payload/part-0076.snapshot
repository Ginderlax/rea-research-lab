    {
      "id": "grafana.candidate.dc1a206b9041f95bc15c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Builder mode** allows you to build queries using a visual interface. This mode is great for users who prefer a guided query experience or are just getting started with SQL.",
