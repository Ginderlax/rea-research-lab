    {
      "id": "grafana.candidate.3377410ec02e001038b8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Secure JSON data is a map of settings encrypted with a [secret key](../../setup-grafana/configure-grafana/#secret_key). The encryption hides the JSON data from the users of Grafana. You should use secure JSON data to store TLS certificates and passwords for data source HTTP requests. All of these settings are optional.",
      "headingPath": [
        "Provision Grafana",
        "Data sources",
        "Example data source configuration file",
        "Secure JSON data"
      ],
