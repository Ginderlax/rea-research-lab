import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const own=path.dirname(fileURLToPath(import.meta.url)),work=path.resolve(own,'..'),bundle=path.join(work,'keepass-history-production-integration-bundle-ready'),repo=path.join(work,'../outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),json=async file=>JSON.parse(await fs.readFile(file,'utf8'));async function id(file){const b=await fs.readFile(file);return{bytes:b.length,sha256:sha(b)}}
const pins={'integration-manifest.json':'5a27d0e6e4c3772ef79bd46cc6b748e86775f3424719c6db4c690c670ae90758','integration-validation.json':'68d8ff9eefa9b56ecbb86b5d1fd74cd33861cd2bc82aa3713a0c098d63f642ab','integration-copy-list.json':'7469f024f5c802b31cf59c568ba1b22f4e797042e7cf9a9bf2ef1f9b5b5f504b'};for(const[name,hash]of Object.entries(pins))assert.equal((await id(path.join(bundle,name))).sha256,hash);
const manifest=await json(path.join(bundle,'integration-manifest.json')),receipt=await json(path.join(bundle,'integration-validation.json')),copy=await json(path.join(bundle,'integration-copy-list.json')),mapping=await json(path.join(bundle,'source-preservation-mappings.json'));assert.equal(manifest.count,1822);assert.equal(manifest.files.length,1822);assert.equal(copy.count,1679);assert.equal(copy.files.length,1679);const manifestByPath=new Map();let aggregateBytes=0;for(const e of manifest.files){assert.ok(!manifestByPath.has(e.path));const file=path.resolve(bundle,e.path);assert.ok(file.startsWith(bundle+path.sep));const actual=await id(file);assert.deepEqual(actual,{bytes:e.bytes,sha256:e.sha256});manifestByPath.set(e.path,e);aggregateBytes+=e.bytes;}
const binaryRoot=path.join(repo,'projects/07-keepass/artifacts/portable'),nativePayloads=[];for(const e of receipt.originalNativeArtifacts){const bytes=await fs.readFile(path.join(binaryRoot,e.path));assert.equal(bytes.length,e.bytes);assert.equal(sha(bytes),e.sha256);nativePayloads.push({name:e.path,bytes,sha256:e.sha256})}
const sourceZipHash='711bd9ec7076661678469e51bae876debac07a08c32f1b1c6b3b8fe5e761c13a',forbiddenHashes=new Set([sourceZipHash,...nativePayloads.map(e=>e.sha256)]),publicEntries=[],seenTargets=new Set();let publicBytes=0;
for(const e of copy.files){assert.ok(e.targetPath.startsWith('products/rea-studio/apps/vault/'));assert.equal(e.path,e.targetPath);assert.ok(!/(^|\/)\.local(\/|$)/i.test(e.path));assert.ok(!e.path.includes('\\'));assert.ok(!e.path.split('/').includes('..'));assert.ok(!seenTargets.has(e.targetPath));seenTargets.add(e.targetPath);assert.ok(['live-app-proposal','inert-evidence'].includes(e.kind));const bound=manifestByPath.get(e.path);assert.ok(bound);assert.equal(bound.sha256,e.sha256);assert.equal(bound.bytes,e.bytes);const bytes=await fs.readFile(path.join(bundle,e.path));assert.ok(!(bytes[0]===0x4d&&bytes[1]===0x5a),'MZ prefix in '+e.path);assert.ok(!(bytes[0]===0x50&&bytes[1]===0x4b),'PK prefix in '+e.path);assert.ok(!forbiddenHashes.has(sha(bytes)),'Original binary/archive identity in '+e.path);for(const native of nativePayloads)if(bytes.length>=native.bytes.length)assert.equal(bytes.indexOf(native.bytes),-1,'Complete native artifact embedded in '+e.path);if(e.kind==='inert-evidence')assert.ok(e.path.startsWith('products/rea-studio/apps/vault/results/history-followup/'));publicEntries.push(e);publicBytes+=bytes.length;}
assert.equal(publicEntries.filter(e=>e.kind==='live-app-proposal').length,23);assert.equal(publicEntries.filter(e=>e.kind==='inert-evidence').length,1656);const stagePrefix='products/rea-studio/apps/vault/results/history-followup/stage/',stagePublic=publicEntries.filter(e=>e.path.startsWith(stagePrefix));assert.equal(stagePublic.length,1442);assert.equal(receipt.localSourceZipCarriers.length,12);for(const e of receipt.localSourceZipCarriers){assert.ok(e.path.startsWith('.local/stage-carriers/'));assert.equal(e.sha256,sourceZipHash);assert.ok(!seenTargets.has(e.path));assert.ok(manifestByPath.has(e.path));assert.equal((await id(path.join(bundle,e.path))).sha256,sourceZipHash)}
const accepted=await json(path.join(work,'keepass-history-draft-independent-review/review-validation.json'));for(const e of accepted.candidateFingerprints){const target='products/rea-studio/apps/vault/'+e.path;assert.deepEqual(await id(path.join(bundle,target)),{bytes:e.bytes,sha256:e.sha256});assert.ok(seenTargets.has(target));}
const reviewRoot=path.join(work,'keepass-history-draft-independent-review'),reviewManifestPath=path.join(reviewRoot,'review-manifest.json');assert.equal((await id(reviewManifestPath)).sha256,'26aa8c0588d740fa6edc164a70d37642204ae0b2fab17a6a839fc1e002aaa9d7');const reviewManifest=await json(reviewManifestPath);assert.equal(reviewManifest.count,82);const reviewPrefix='products/rea-studio/apps/vault/results/history-followup/final-independent-review/';const finalReviewMappings=[];for(const e of reviewManifest.files){const p=reviewPrefix+e.path+'.snapshot';assert.ok(seenTargets.has(p),'Missing exact final review snapshot '+p);assert.deepEqual(await id(path.join(bundle,p)),{bytes:e.bytes,sha256:e.sha256});assert.deepEqual(await id(path.join(reviewRoot,e.path)),{bytes:e.bytes,sha256:e.sha256});finalReviewMappings.push({original:e.path,publicPath:p,sha256:e.sha256})}
for(const e of mapping.files){const p=path.resolve(bundle,e.preservedPath);assert.ok(p.startsWith(bundle+path.sep));assert.deepEqual(await id(p),{bytes:e.bytes,sha256:e.sha256})}assert.equal(mapping.count,mapping.files.length);
const failedAssemblies=publicEntries.filter(e=>e.path.includes('/assembly-failures/'));assert.ok(failedAssemblies.some(e=>e.path.endsWith('assembly.failed-v1.mjs.snapshot')));assert.ok(failedAssemblies.some(e=>e.path.endsWith('assembly.failed-v2.mjs.snapshot')));assert.ok(!failedAssemblies.some(e=>/\.(exe|dll|zip)$/i.test(e.path)));for(const e of failedAssemblies)assert.ok(e.path.endsWith('.snapshot')||e.path.endsWith('.txt')||e.path.endsWith('.json'));
const prose=await fs.readFile(path.join(bundle,'INTEGRATION.md'),'utf8');assert.ok(prose.includes('Four authenticated full original source ZIP copies'));const findings=[{classification:'Non-blocking frozen prose discrepancy',path:'INTEGRATION.md',claim:'Four authenticated full original source ZIP copies',actual:'12 total bundle-local carriers: four named historical ZIP copies and eight acquisition descendants',resolution:'Root will preserve exact historical prose and correct current public documentation; frozen bundle unchanged',binaryLeak:false}];
for(const e of manifest.files)assert.deepEqual(await id(path.join(bundle,e.path)),{bytes:e.bytes,sha256:e.sha256});for(const[name,hash]of Object.entries(pins))assert.equal((await id(path.join(bundle,name))).sha256,hash);
const result={schema:'rea-independent-vault-integration-bundle-audit/v1',createdAt:new Date().toISOString(),status:'PASS_INTEGRITY_AND_PUBLIC_EXCLUSIONS_WITH_PROSE_NOTE',bundle,authenticatedPins:pins,strictBundle:{artifacts:1822,aggregateBytes,allBeforeAndAfterMatch:true},copyList:{files:1679,liveAppFiles:23,inertEvidenceFiles:1656,publicBytes,uniqueConfinedTargets:true,noPublicLocalDirectorySegments:true},stagePreservation:{originalStageArtifacts:1454,publicStageFiles:1442,bundleLocalSourceZipCarriers:12,archiveSha256:sourceZipHash,noCarrierInCopyList:true},acceptedRuntime:accepted.candidateFingerprints,finalIndependentReview:{artifacts:82,manifestSHA256:'26aa8c0588d740fa6edc164a70d37642204ae0b2fab17a6a839fc1e002aaa9d7',receiptSHA256:'5f529c2497a237f8af210c28df117d836f17ba65f42e909dc302bd39576434d0',browserSHA256:'90789c37a8b9216645b313002331c78ed40a3bf71328fcc0eac77504b4567d73',allExactSnapshots:true},allMappingRecordsAuthenticated:mapping.count,publicContentAudit:{files:1679,rejectedMZAndPKPrefixes:true,rejectedExactSourceZipIdentity:true,rejectedExactOriginalExeDllIdentities:true,rejectedEmbeddedCompleteOriginalNativeArtifactBytes:true,authenticatedOriginalNativeArtifacts:nativePayloads.map(e=>({name:e.name,bytes:e.bytes.length,sha256:e.sha256})),scope:'File prefixes and exact entire original payloads; unrelated two-byte substrings inside text/PNG compression are not executable carriers.'},failedAssemblyProvenance:{publicFiles:failedAssemblies.length,sourceTextOnly:true,executed:false},findings,readOnlyLookupFailure:{path:'preserved-final-review-bundle/preservation-manifest.json',reason:'Wrong initially assumed extension; preserved metadata is .json.snapshot; no execution or mutation'},executions:{behavioralTests:0,originalApplication:0,browser:0,measurements:0},productionModified:false,bundleModified:false,scope:'Byte integrity and publication carrier exclusion audit only. Existing41 and11 acceptance counts are attributed to their frozen receipts; no new behavioral acceptance or full parity/security/superiority claim.'};await fs.writeFile(path.join(own,'review-validation.json'),JSON.stringify(result,null,2)+'\n');await fs.writeFile(path.join(own,'final-review-mappings.json'),JSON.stringify({schema:'rea-independent-vault82-snapshot-mappings/v1',files:finalReviewMappings},null,2)+'\n');const files=[];for(const name of ['audit-bundle.mjs','review-validation.json','final-review-mappings.json'])files.push({path:name,...await id(path.join(own,name))});await fs.writeFile(path.join(own,'review-manifest.json'),JSON.stringify({schema:'rea-independent-vault-bundle-audit-strict-manifest/v1',count:files.length,files},null,2)+'\n');console.log(JSON.stringify({status:result.status,receipt:await id(path.join(own,'review-validation.json')),manifest:await id(path.join(own,'review-manifest.json')),publicFiles:1679,unchanged:true}));
