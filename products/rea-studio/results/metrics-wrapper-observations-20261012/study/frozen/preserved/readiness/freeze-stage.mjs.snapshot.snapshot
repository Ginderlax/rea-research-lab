import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {here,sha,authenticateOriginal} from './authenticate-original.mjs';
const receiptName='readiness-validation.json',manifestName='freeze-manifest.json',read=async name=>JSON.parse(await fs.readFile(path.join(here,name))),fp=async file=>{const data=await fs.readFile(file);return {bytes:data.length,sha256:sha(data)};};
async function inventory(dir=here){const result={};for(const row of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const file=path.join(dir,row.name),name=path.relative(here,file).replaceAll('\\','/');if([receiptName,manifestName].includes(name))continue;assert.ok(!row.isSymbolicLink());if(row.isDirectory())Object.assign(result,await inventory(file));else {assert.ok(row.isFile());result[name]=await fp(file);}}return result;}
async function authenticateCopies(){const preservation=await read('preservation.json');for(const copy of preservation.copies){const expected={bytes:copy.bytes,sha256:copy.sha256};assert.deepEqual(await fp(path.join(here,copy.path)),expected);assert.deepEqual(await fp(path.join(copy.sourceRoot,copy.sourcePath)),expected);}assert.equal(preservation.wrapperStage.copies.length,87);assert.equal(preservation.latestMixedStudy.copies.length,2218);assert.equal((await fp(preservation.productionPath)).sha256,preservation.productionSHA256);return preservation;}
const preservation=await authenticateCopies(),manifestBytes=await fs.readFile(path.join(here,'memory-preflight.control.json')),manifest=JSON.parse(manifestBytes),authority=await authenticateOriginal();assert.deepEqual(authority,manifest.authority);
const audit=await read('results/source-binding-audit.json'),harness=await read('results/harness-readiness.json'),memory=await read('results/memory-harness-checks.control.json'),timing=await read('results/timing-readiness.json');for(const row of [audit,harness,memory,timing])assert.equal(row.status,'passed');assert.equal(memory.measurementRun,false);assert.equal(timing.timingMeasurementRun,false);assert.equal(memory.samples.length,3);assert.equal(timing.result.comparisons,63);assert.equal(timing.result.loadedReducerImplementations,3);assert.equal(memory.manifestSHA256,sha(manifestBytes));assert.equal(timing.manifestSHA256,sha(manifestBytes));
for(const row of [harness,memory,timing]){assert.deepEqual(row.sourceHashesBefore,row.sourceHashesAfter);for(const [name,digest]of Object.entries(row.sourceHashesBefore))assert.equal((await fp(path.join(here,name))).sha256,digest);}for(const sample of memory.samples){assert.equal(sample.result.comparisons,21);assert.equal(sample.result.measurementRun,false);assert.equal(sample.result.loadedReducerImplementations,1);assert.equal(sample.result.checkpoints,undefined);assert.deepEqual(sample.result.selectedSources,manifest.implementations[sample.implementation].files);if(sample.implementation==='candidate')assert.equal(sample.result.loadedNativeModuleFiles,2);if(sample.implementation==='original')assert.equal(sample.result.loadedCJSModules.length,6);}
for(const fixture of Object.values(manifest.expectedFiles)){assert.equal((await fp(path.join(here,fixture.path))).sha256,fixture.sha256);assert.equal((await fp(path.join(here,fixture.inputPath))).sha256,fixture.inputFileSHA256);}const old=await read('preserved/previous-memory-preflight.control.json');assert.deepEqual(manifest.expectedFiles,old.expectedFiles);assert.deepEqual(manifest.limits,old.limits);
if(process.argv.includes('--verify-only')){const receipt=await read(receiptName),frozen=await read(manifestName);assert.equal((await fp(path.join(here,receiptName))).sha256,frozen.receiptSHA256);for(const [name,row]of Object.entries(receipt.inventory))assert.deepEqual(await fp(path.join(here,name)),row);console.log(JSON.stringify({status:'passed',files:Object.keys(receipt.inventory).length,receiptSHA256:frozen.receiptSHA256,manifestSHA256:(await fp(path.join(here,manifestName))).sha256,readOnly:true}));process.exit(0);}
const readinessAttempts=[],actionAttempts=[];for(const name of(await fs.readdir(path.join(here,'results'))).sort()){if(/^readiness-attempt-\d+\.json$/.test(name)){const row=await read('results/'+name);assert.equal(row.status,'passed');assert.deepEqual(row.sourceHashesBefore,row.sourceHashesAfter);for(const step of row.steps){assert.equal(step.exitCode,0);for(const side of ['stdout','stderr'])assert.equal((await fp(path.join(here,step[side].path))).sha256,step[side].sha256);}readinessAttempts.push({path:'results/'+name,...await fp(path.join(here,'results/'+name)),steps:row.steps});}if(/^action-.*-\d+\.json$/.test(name)){const row=await read('results/'+name),stem='results/'+name.slice(0,-5);for(const [suffix,digest]of [['.source.mjs.snapshot',row.sourceSHA256],['.stdout.txt',row.stdoutSHA256],['.stderr.txt',row.stderrSHA256]])assert.equal((await fp(path.join(here,stem+suffix))).sha256,digest);assert.equal(row.sourceSHA256,row.sourceAfterSHA256);actionAttempts.push({path:'results/'+name,...await fp(path.join(here,'results/'+name)),source:row.name,exitCode:row.exitCode,sourceSHA256:row.sourceSHA256,start:row.start,end:row.end});}}
assert.equal(readinessAttempts.length,1);assert.equal(actionAttempts.length,4);assert.equal(actionAttempts.filter(row=>row.exitCode!==0).length,1);const failure=actionAttempts.find(row=>row.exitCode!==0);assert.equal(failure.source,'prepare-stage.mjs');assert.equal(failure.sourceSHA256,'8aa250dbb45d67f71094b69691641d51efaa2596dd7ea0fcc261453579930309');
const provenance=await read('original-provenance.json');for(const row of provenance.archives)assert.deepEqual(await fp(row.source),{bytes:row.bytes,sha256:row.sha256});for(const row of provenance.originalCopies)assert.deepEqual(await fp(path.join(here,row.path)),{bytes:row.bytes,sha256:row.sha256});assert.equal(provenance.originalCopies.length,6);assert.equal(provenance.archives.length,2);assert.equal((await fp(process.execPath)).sha256,manifest.runtime.executableSHA256);
const rows=await inventory();assert.equal(Object.keys(rows).some(name=>/^results\/(paired-control-|timing-attempt-|memory-observations-|memory-control-)/.test(name)),false);const receipt={schema:'rea-metrics-wrapper-measurement-readiness/v1',checkedAt:new Date().toISOString(),status:'passed; prospective only, no measurements authorized',scope:'Exact frozen86 wrapper candidate, unchanged seven workloads/14 fixtures and same-window baseline/original controls. Source-attribution is hypothesis, no posthoc threshold.',candidate:{entrySHA256:manifest.implementations.candidate.files[manifest.implementations.candidate.entry],helperSHA256:manifest.implementations.candidate.files[path.join(here,'selector-algorithm.mjs')],baselineSHA256:preservation.productionSHA256},manifestSHA256:sha(manifestBytes),authority,runtime:manifest.runtime,sourceAuditSHA256:(await fp(path.join(here,'results/source-binding-audit.json'))).sha256,wrapperStage:{inventoryFiles:86,exactSnapshotsIncludingManifest:87,receiptSHA256:preservation.candidateReceiptSHA256,manifestSHA256:preservation.candidateManifestSHA256,sourceStable:true},latestMixedStudy:{inventoryFiles:2217,exactSnapshotsIncludingManifest:2218,receiptSHA256:'2ae7afaf499cffc9fa88b40b095b697849608b64ae5d485af8602e316f408b23',manifestSHA256:preservation.latestMixedStudy.manifestSHA256,sourceStable:true,observationsNotReboundToCandidate:true},attemptRecords:readinessAttempts,preparationActionAttempts:actionAttempts,preservedCurrentPreparationFailures:{attempts:1,record:failure,automaticSourceAndRawCapture:true,metadataOnly:true,correctedWithoutOverwritingPriorPreparedBytes:true,candidateWorkersLoopsBoundsUnchanged:true},checks:{harnessGroups:4,signedSummaryGroups:5,invalidTimestampCases:15,memoryCheckOnlyChildren:3,memoryFreshAndCachePacketChecks:63,timingFreshAndCachePacketChecks:63,freshOriginalCalculations:14,originalCachedReads:28,exactFixedWorkloadSpecs:7,exactInputAndExpectedFiles:14,originalRuntimeFiles:6,originalArchivesAuthenticated:2,wrapper86AndMixed2217BeforeAfterAuthenticated:true,correctnessProvenanceOnlyInputs:66},historicalFullCampaignReused:true,fullCorrectnessRerunDuringReadiness:false,correctnessProvenanceOnly:manifest.correctnessProvenanceOnly,processControls:{timingChildSeconds:60,timingChildCaptureBytes:2*1024*1024,timingOuterSeconds:600,timingOuterCaptureBytes:4*1024*1024,memoryChildSeconds:manifest.limits.childWallSeconds,memoryOldSpaceMiB:manifest.limits.childOldSpaceMiB,memoryObservedRSSMiB:manifest.limits.childRSSMiB,memoryCaptureBytes:manifest.limits.stdoutBytes,memoryOuterWatchdog:false,observerNominalMilliseconds:100,numericPIDOnlyNotProcessStartIdentity:true,signedDeltasAndZeroControlUnavailabilityRetained:true},prospective:{roles:['original','baseline','candidate'],fixedWorkloads:7,repetitions:7,timingChildren:147,isolatedMemoryChildren:147,separateFreshQuietWindowsRequired:true,schedulingReservationMinutes:{timing:[5,8],memory:[10,15]},prospectiveBoundsNotMeasurements:true,unchangedAllPercentilesWarmup:2,unchangedAllPercentilesIterations:3,diagnosticCausationEstablished:false,noPosthocThreshold:true},inventory:rows,aggregateBytes:Object.values(rows).reduce((sum,row)=>sum+row.bytes,0),publicationExcludedLocalOriginalArchives:provenance.archives,nativeExecutableCopied:false,timingMeasurementRun:false,memoryMeasurementRun:false,profileRun:false,measurementBranchExecutionTested:false,machineLevelIsolationEstablished:false,productionChanged:false,selectedForIntegration:false,performanceAcceptance:false,fullPerformanceNonRegressionEstablished:false,universalCorrectnessEstablished:false,universalSuperiorityEstablished:false,fullParityEstablished:false,fullProductComplete:false};await fs.writeFile(path.join(here,receiptName),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});assert.deepEqual(await inventory(),rows);const frozen={schema:'rea-metrics-wrapper-readiness-freeze/v1',frozenAt:new Date().toISOString(),receiptSHA256:(await fp(path.join(here,receiptName))).sha256,files:Object.keys(rows).length,aggregateBytes:receipt.aggregateBytes,inventory:rows,excludes:[receiptName,manifestName],timingMeasurementRun:false,memoryMeasurementRun:false,profileRun:false};await fs.writeFile(path.join(here,manifestName),JSON.stringify(frozen,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:'frozen readiness',receiptSHA256:frozen.receiptSHA256,freezeManifestSHA256:(await fp(path.join(here,manifestName))).sha256,measurementManifestSHA256:sha(manifestBytes),inventoryFiles:frozen.files,bytes:frozen.aggregateBytes,checks:receipt.checks,measurementRun:false}));
