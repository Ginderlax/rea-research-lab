import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const base=path.resolve(import.meta.dirname,'..'),lab=path.join(base,'outputs/rea-research-lab'),owned=path.join(base,'work/root-notes-sketch-implementation-references-next'),sha=b=>createHash('sha256').update(b).digest('hex');fs.mkdirSync(owned,{recursive:true});
const devBytes=fs.readFileSync(path.join(lab,'products/rea-studio/results/development-validation.json'));assert.equal(sha(devBytes),'1175423a8aa2660f3baea923f2ed0fdc932a53d176c0040901054eec0f1bd859');const dev=JSON.parse(devBytes);assert.equal(dev.source_files.length,720);assert.equal(dev.summary.pass,847);
const spec=[['workspace-products.json','e6cec8352d716b559bff4898b9467399338a5d5a31741b0b25d7ef78b81d83ea',[
 'products/rea-studio/apps/notes/client.mjs','products/rea-studio/apps/notes/README.md','products/rea-studio/apps/notes/notebook-trash-publication-boundaries.test.mjs','products/rea-studio/apps/notes/notebook-trash-review-fixture.mjs','products/rea-studio/apps/notes/notebook-trash-review.test.mjs','products/rea-studio/apps/notes/notebook-trash.ui.test.mjs']],
 ['visual-products.json','a7c9344511a1fefd53ee5c5bedc270d0dc01c178276aaa61c06bc4eee41e399f',['products/rea-studio/apps/sketch/client.mjs','products/rea-studio/apps/sketch/README.md']]];
for(const n of['stdout','stderr'])fs.copyFileSync(path.join(base,`work/notes-layout-value-api-records.${n}.txt`),path.join(owned,`failed-publication-check.${n}.txt`),fs.constants.COPYFILE_EXCL);
const changes=[];
for(const[name,pin,allowed]of spec){const relative='products/rea-studio/requirements/'+name;assert.ok(dev.source_files.every(e=>![(e.path??e.name),'products/rea-studio/'+(e.path??e.name)].includes(relative)),'Registry must not change a tested720 source');const target=path.join(lab,relative),before=fs.readFileSync(target);assert.equal(sha(before),pin);assert.ok(Buffer.from(JSON.stringify(JSON.parse(before),null,2)+'\n').equals(before));fs.writeFileSync(path.join(owned,name+'.before.snapshot'),before,{flag:'wx'});const document=JSON.parse(before),identities={sources:structuredClone(document.sources),capabilities:structuredClone(name==='workspace-products.json'?document.capabilities:document.baselineProducts.map(p=>p.requirements))};const entries=name==='workspace-products.json'?document.localImplementationEvidence:document.baselineProducts.flatMap(p=>p.implementationFiles??[]),changed=[];
 for(const e of entries){const live=fs.readFileSync(path.join(lab,e.path));if(sha(live)===e.sha256)continue;assert.ok(allowed.includes(e.path));const old=structuredClone(e);e.bytes=live.length;e.sha256=sha(live);changed.push({path:e.path,before:old,after:structuredClone(e)});}assert.deepEqual(changed.map(r=>r.path).sort(),[...allowed].sort());assert.deepEqual(document.sources,identities.sources);assert.deepEqual(name==='workspace-products.json'?document.capabilities:document.baselineProducts.map(p=>p.requirements),identities.capabilities);
 const after=Buffer.from(JSON.stringify(document,null,2)+'\n');const inverse=structuredClone(document),inverseEntries=name==='workspace-products.json'?inverse.localImplementationEvidence:inverse.baselineProducts.flatMap(p=>p.implementationFiles??[]);for(const r of changed){const e=inverseEntries.find(e=>e.path===r.path);Object.assign(e,r.before);}assert.ok(Buffer.from(JSON.stringify(inverse,null,2)+'\n').equals(before));fs.writeFileSync(target,after);fs.writeFileSync(path.join(owned,name+'.after.snapshot'),after,{flag:'wx'});changes.push({path:relative,before:{bytes:before.length,sha256:sha(before)},after:{bytes:after.length,sha256:sha(after)},rows:changed,inverseExact:true});}
const receipt={schema:'rea-current-implementation-reference-update/v1',at:new Date().toISOString(),changes,updatedImplementationRows:8,originalSourceRecordsUnchanged:true,capabilityRowsUnchanged:true,fullSuite847ReceiptAnd720SourcesUnchanged:true,appWrites:0,productBehaviorFailures:0,newBehaviorExecutions:0,reason:'Finalizer added milestone metadata but retained eight superseded implementation references; update only the current implementation byte/SHA fields, preserve exact prior registries and original159/232 identities.'};fs.writeFileSync(path.join(owned,'transformation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({updatedImplementationRows:8,registries:changes.map(e=>({path:e.path,after:e.after})),originalSourcesAndCapabilitiesUnchanged:true,appWrites:0}));
