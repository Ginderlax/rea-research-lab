    {
      "id": "grafana.candidate.33b76558147d6faaaf45",
      "syntaxRole": "table-row",
      "sourceText": "| `$__timeEpoch(dateColumn)`                | Converts to UNIX epoch (seconds) and renames the column to `time`. Example: `extract(epoch from dateColumn) as \"time\"`. Requires a column argument.                                                           |",
      "headingPath": [
        "PostgreSQL query editor",
        "Macros",
        "Time-series macros"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/query-editor/_index.md",
