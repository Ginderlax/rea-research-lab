import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';
import {here,sha,fp,authenticate} from './source-binding.mjs';
const test=JSON.parse(await fs.readFile(path.join(here,'test-validation.json'))),original=JSON.parse(await fs.readFile(path.join(here,'fresh-original-validation.json'))),after=await authenticate();assert.deepEqual(after,test.after);assert.equal(test.tests,18);assert.equal(test.pass,18);assert.equal(test.fail,0);assert.equal(original.status,'passed');assert.equal(original.completedGroups,12);assert.equal(original.observedPositions,267);assert.equal(original.actualBoundedOriginalEngineInvocations,13);
for(const record of test.records){assert.deepEqual(await fp(path.join(here,record.name)),record.source);assert.equal(record.exitCode,0);assert.equal(record.signal,null);for(const kind of ['stdout','stderr'])assert.deepEqual(await fp(path.join(here,record[kind].path)),{bytes:record[kind].bytes,sha256:record[kind].sha256});}
for(const row of test.preserved)assert.deepEqual(await fp(path.join(here,row.path)),{bytes:row.bytes,sha256:row.sha256});
for(const child of original.children){assert.equal(child.code===0||child.code===1,true);assert.equal(child.failure,null);assert.equal(child.signal,null);for(const kind of ['stdout','stderr'])assert.deepEqual(await fp(path.join(original.run,child[kind].path)),{bytes:child[kind].bytes,sha256:child[kind].sha256});}
const observations=[],generated=[];async function walk(folder){for(const entry of await fs.readdir(path.join(here,folder),{withFileTypes:true})){const name=folder+'/'+entry.name;if(entry.isDirectory())await walk(name);else if(entry.name==='observation.json')observations.push({path:name,...await fp(path.join(here,name))});else if(name.includes('/workspace/'))generated.push({path:name,...await fp(path.join(here,name))});}}await walk('runs');assert.equal(observations.length,18);
await fs.writeFile(path.join(here,'generated-fixture-census.json'),JSON.stringify({schema:'rea-editor-path-review-generated-fixture-census/v1',files:generated.length,totalBytes:generated.reduce((sum,row)=>sum+row.bytes,0),filesList:generated,scope:'All owned runs/*/workspace payloads, generated by the exact preserved tests or original collector. They can be excluded from a later public payload only with this exact census and generator/observations retained; whole private freeze includes them.'},null,2)+'\n',{flag:'wx'});
const prior=path.resolve(here,'../editor-search-independent-review'),longPath='runs/old-long-path-1791852426602-0/observation.json',pressurePath='runs/response-boundary-1791852426770-7/observation.json',long=JSON.parse(await fs.readFile(path.join(here,longPath))),pressure=JSON.parse(await fs.readFile(path.join(here,pressurePath)));assert.equal(long.result.skipped[0].path.length,1085);assert.equal(pressure.matchCount,684);assert.equal(pressure.outputBytes,2031138);
const sourceFiles={};for(const name of ['file-path.mjs','workspace-search.mjs','client.mjs','server.mjs'])sourceFiles[name]=await fp(path.resolve(here,'../editor-search-path-fix-next/products/rea-studio/apps/editor/'+name));
