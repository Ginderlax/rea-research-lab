      "id": "grafana.candidate.f6b5216f317dde3f7fa5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The **Share view** option allows you to link the movement and zoom actions of multiple map visualizations within the same dashboard. The map visualizations that have this option enabled act in tandem when one of them is moved or zoomed, leaving the other ones independent.",
      "headingPath": [
        "Geomap",
        "Configuration options",
        "Map view options",
        "Share view"
      ],
