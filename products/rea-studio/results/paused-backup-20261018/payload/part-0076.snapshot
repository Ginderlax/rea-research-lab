    },
    {
      "id": "grafana.candidate.61e903c5d71984f89d08",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The query returns multiple columns representing minimum and maximum values within the defined range.",
      "headingPath": [
        "MySQL query editor",
        "Time series queries"
      ],
      "source": {
        "path": "docs/sources/datasources/mysql/query-editor/_index.md",
        "gitBlobSha": "337ba0971e35a147687cf26c4fbdfca2d0957e12",
        "sha256": "72419911caa4b30f1d8ca7cd56d58b2003ddcafbcc4e7f730eecabb535398ee3",
        "lineStart": 252,
        "lineEnd": 252,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/mysql/query-editor/_index.md#L252-L252"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
