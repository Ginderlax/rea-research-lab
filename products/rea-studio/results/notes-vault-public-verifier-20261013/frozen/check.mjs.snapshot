import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';
const here=import.meta.dirname, root=path.resolve(here,'../../outputs/rea-research-lab');
const hash=b=>crypto.createHash('sha256').update(b).digest('hex');
const run=path.join(here,'runs',new Date().toISOString().replaceAll(':','-'));
fs.mkdirSync(run,{recursive:true});
const source=fs.readFileSync(path.join(here,'verify-notes-vault-followups.mjs'));
fs.writeFileSync(path.join(run,'verifier.mjs.snapshot'),source);
const rows=[];let status='PASS',result,error;
try {const {verifyNotesVaultFollowups}=await import('./verify-notes-vault-followups.mjs');result=verifyNotesVaultFollowups(root,{onFile:r=>rows.push(r)});}
catch(e){status='FAIL';error={name:e.name,message:e.message,stack:e.stack};}
const after=fs.readFileSync(path.join(here,'verify-notes-vault-followups.mjs'));
const receipt={schema:'rea-public-proof-verifier-owned-run/v1',at:new Date().toISOString(),status,sourceBefore:{bytes:source.length,sha256:hash(source)},sourceAfter:{bytes:after.length,sha256:hash(after)},sourceStable:source.equals(after),rows,result,error,originalExecutions:0,behavioralTests:0};
fs.writeFileSync(path.join(run,'validation.json'),JSON.stringify(receipt,null,2)+'\n');
console.log(JSON.stringify({run,status,result,error}));process.exitCode=status==='PASS'?0:1;
