    },
    {
      "id": "grafana.candidate.e8f3a5ab259881943cb0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana Cloud users can access this feature by [opening a support ticket in the Cloud Portal](/profile/org#support).",
      "headingPath": [
        "What's new in Grafana v9.1",
        "OSS",
        "Auth and security",
        "Organization role mapping for GitHub OAuth2 authentication"
      ],
      "source": {
