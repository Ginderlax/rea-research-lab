    },
    {
      "id": "grafana.candidate.086e3854b4b67f04407a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Alerting infrastructure is often complex, with many pieces of the pipeline that often live in different places. Scaling this across multiple teams and organizations is an especially challenging task. Importing and exporting (or provisioning) your alerting resources in Grafana Alerting makes this process easier by enabling you to create, manage, and maintain your alerting data in a way that best suits your organization.",
      "headingPath": [
        "Provision Alerting resources"
      ],
      "source": {
        "path": "docs/sources/alerting/set-up/provision-alerting-resources/_index.md",
        "gitBlobSha": "90467ce5d6bd2775672b71a98f4636833e0712e5",
        "sha256": "7d22c33ca6f3a70de93c95c4e0cab884b45b05ec5e217593c5d9677270f7d0be",
        "lineStart": 48,
        "lineEnd": 48,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/set-up/provision-alerting-resources/_index.md#L48-L48"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.6df1637e0a5a2445d4c7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can import alert rules, contact points, notification policies, mute timings, and templates.",
      "headingPath": [
        "Provision Alerting resources"
      ],
      "source": {
        "path": "docs/sources/alerting/set-up/provision-alerting-resources/_index.md",
