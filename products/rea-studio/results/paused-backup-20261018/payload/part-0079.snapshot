    },
    {
      "id": "grafana.candidate.33d1d5367f4dbdd2acd3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Also, in addition to querying Log Analytics Workspaces, you can now query the logs for any individual [supported resource](https://docs.microsoft.com/en-us/azure/azure-monitor/essentials/metrics-supported), or for all resources in a subscription or resource group.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Grafana OSS features",
        "Data source updates",
        "Azure Monitor data source"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-0.md",
