import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import {gunzipSync} from 'node:zlib';
import {createRequire} from 'node:module';
import assert from 'node:assert/strict';

const here=path.dirname(fileURLToPath(import.meta.url)),source=path.resolve(here,'../metrics-wrapper-measurement-next'),sha=bytes=>createHash('sha256').update(bytes).digest('hex'),roles=['original','baseline','candidate'];
const fp=async file=>{const bytes=await fs.readFile(file);return {bytes:bytes.length,sha256:sha(bytes)};};
const inside=(root,file)=>{const relative=path.relative(root,file);return relative!==''&&!path.isAbsolute(relative)&&relative!=='..'&&!relative.startsWith('..'+path.sep);};
const resolve=name=>{assert.equal(typeof name,'string');const result=path.resolve(source,name);assert.ok(inside(source,result),'Outside-study evidence path');return result;};
const read=async name=>JSON.parse(await fs.readFile(resolve(name)));
const median=values=>{assert.ok(values.length&&values.every(Number.isFinite));const sorted=[...values].sort((a,b)=>a-b);return sorted[Math.floor(sorted.length/2)];};
const stats=values=>({samples:values.length,median:median(values),min:Math.min(...values),max:Math.max(...values),values});
const nullableStats=values=>{const finite=values.filter(Number.isFinite);return {samples:finite.length,missingOrUnavailable:values.length-finite.length,censored:finite.length!==values.length,median:finite.length?median(finite):null,min:finite.length?Math.min(...finite):null,max:finite.length?Math.max(...finite):null,values};};
const difference=(candidate,reference)=>candidate.map((value,index)=>value-reference[index]);
const overlap=(left,right)=>{const lower=Math.max(left.min,right.min),upper=Math.min(left.max,right.max);return {overlap:lower<=upper,intersection:lower<=upper?[lower,upper]:null};};
const rawBindings={};
async function bind(name,{digest,maxBytes}={}){const actual=await fp(resolve(name));if(digest)assert.equal(actual.sha256,digest);if(maxBytes!==undefined)assert.ok(actual.bytes<=maxBytes);rawBindings[name]=actual;return actual;}
function tarMembers(bytes){const tar=gunzipSync(bytes,{maxOutputLength:32*1024*1024}),members=new Map();for(let offset=0;offset+512<=tar.length;){const header=tar.subarray(offset,offset+512);if(header.every(value=>value===0))break;const name=header.subarray(0,100).toString().split('\0')[0],prefix=header.subarray(345,500).toString().split('\0')[0],length=parseInt(header.subarray(124,136).toString().replaceAll('\0','').trim(),8);assert.ok(Number.isSafeInteger(length)&&length>=0&&offset+512+length<=tar.length);members.set(prefix?prefix+'/'+name:name,tar.subarray(offset+512,offset+512+length));offset+=512+Math.ceil(length/512)*512;}return members;}

const readinessBytes=await fs.readFile(resolve('readiness-validation.json'));assert.equal(sha(readinessBytes),'705c4540bb54ef37e6b396ed9082aaf7ffe4d944b362b03ac85bd0d76ec3c32c');
const readiness=JSON.parse(readinessBytes);assert.equal(Object.keys(readiness.inventory).length,2426);
for(const [name,record]of Object.entries(readiness.inventory))assert.deepEqual(await fp(resolve(name)),record);
await bind('readiness-validation.json',{digest:sha(readinessBytes)});
const manifestBytes=await fs.readFile(resolve('memory-preflight.control.json')),manifest=JSON.parse(manifestBytes);assert.equal(sha(manifestBytes),'4ef9d10a58ef0d58600e389ce82b2774f347a61c7ccfd5c8ac4152001b404438');
const provenance=await read('original-provenance.json'),sourceProof=await read('preserved/sources.json'),release=await fs.readFile(provenance.archives[0].source),lodash=await fs.readFile(provenance.archives[1].source);
for(const row of provenance.archives)assert.deepEqual(await fp(row.source),{bytes:row.bytes,sha256:row.sha256});
for(const row of provenance.originalCopies){await bind(row.path,{digest:row.sha256});assert.deepEqual(await fp(row.source),{bytes:row.bytes,sha256:row.sha256});}
assert.equal(sha(release),manifest.authority.archiveSHA256);assert.equal(sha(release),sourceProof.archiveSha256);assert.equal('sha512-'+createHash('sha512').update(release).digest('base64'),sourceProof.registryIntegrity);
assert.equal(sha(lodash),manifest.authority.dependencyArchiveSHA256);assert.equal(sha(lodash),sourceProof.oracleDependency.sha256);assert.equal('sha512-'+createHash('sha512').update(lodash).digest('base64'),sourceProof.oracleDependency.integrity);
const official=tarMembers(release),dependency=tarMembers(lodash),originalSourceBindings={};
for(const [name,digest]of Object.entries(manifest.authority.files)){const bytes=await fs.readFile(name);assert.equal(sha(bytes),digest);const archived=name.endsWith('lodash.js')?dependency.get('package/lodash.js'):official.get('package/'+name.replaceAll('\\','/').split('/artifacts/package/')[1]);assert.ok(archived);assert.ok(bytes.equals(archived));originalSourceBindings[name]={bytes:bytes.length,sha256:digest};}
assert.equal(Object.keys(originalSourceBindings).length,6);assert.equal(path.resolve(createRequire(manifest.authority.entry).resolve('lodash')),path.resolve(manifest.authority.lodashPath));
assert.equal((await fp(manifest.runtime.execPath)).sha256,manifest.runtime.executableSHA256);
const preservation=await read('preservation.json');assert.equal((await fp(preservation.productionPath)).sha256,readiness.candidate.baselineSHA256);
await bind('freeze-manifest.json',{digest:'6bb39d2051d18147987ff2028d349b219f279d48216159ff00f5d7f2bc7858c3'});
for(const fixture of Object.values(manifest.expectedFiles)){await bind(fixture.path,{digest:fixture.sha256});await bind(fixture.inputPath,{digest:fixture.inputFileSHA256});}
const semanticBytes=await fs.readFile(resolve(manifest.fullSemanticReceipt));assert.equal(sha(semanticBytes),manifest.fullSemanticReceiptSHA256);const semantic=JSON.parse(semanticBytes);assert.equal(semantic.failedAcceptanceAttempts,0);assert.equal(semantic.bothNativeModulesBoundBeforeAndAfter,true);
assert.equal(semantic.candidate.entrySHA256,readiness.candidate.entrySHA256);assert.equal(semantic.candidate.helperSHA256,readiness.candidate.helperSHA256);
for(const binding of Object.values(manifest.implementations))for(const [name,digest]of Object.entries(binding.files))assert.equal((await fp(name)).sha256,digest);

const timingName='results/timing-attempt-1791849618765.json',timing=await read(timingName);await bind(timingName);assert.equal(timing.status,'passed');assert.equal(timing.timingMeasurementRun,true);assert.equal(timing.memoryMeasurementRun,false);assert.equal(timing.quietFrom,'2026-10-12T23:58:13Z');
assert.deepEqual(timing.sourceHashesBefore,timing.sourceHashesAfter);for(const [name,digest]of Object.entries(timing.sourceHashesBefore))await bind(name,{digest});
await bind(timing.stdout.path,{digest:timing.stdout.sha256,maxBytes:4*1024*1024});await bind(timing.stderr.path,{digest:timing.stderr.sha256,maxBytes:4*1024*1024});assert.deepEqual(JSON.parse(await fs.readFile(resolve(timing.stdout.path))),timing.result);
const pairedName=path.relative(source,timing.result.output).replaceAll('\\','/');assert.ok(inside(source,path.resolve(timing.result.output)));const paired=await read(pairedName);await bind(pairedName);assert.equal(paired.status,'passed');assert.equal(paired.records.length,147);assert.equal(paired.manifestSHA256,sha(manifestBytes));assert.deepEqual(paired.sourceHashesBefore,paired.sourceHashesAfter);
assert.equal(paired.quietFrom,timing.quietFrom);assert.equal(paired.loadedAllThreeForTimingCorrectnessChecks,true);assert.equal(paired.memoryIsNotIsolated,true);
const allImplementationFiles=Object.fromEntries(Object.entries(manifest.implementations).map(([name,row])=>[name,row.files]));
let timingComparisons=0;
for(const record of paired.records){
  assert.equal(record.exitCode,0);assert.equal(record.signal,null);assert.equal(record.error,undefined);const spec=manifest.expectedFiles[record.caseName];assert.ok(spec);assert.ok(roles.includes(record.implementation));
  await bind(record.stdout.path,{digest:record.stdout.sha256,maxBytes:2*1024*1024});await bind(record.stderr.path,{digest:record.stderr.sha256,maxBytes:2*1024*1024});assert.deepEqual(JSON.parse(await fs.readFile(resolve(record.stdout.path))),record.result);
  const result=record.result;assert.equal(result.kind,'result');assert.equal(result.mode,'measure');assert.equal(result.measurementRun,true);assert.equal(result.loadedReducerImplementations,3);assert.equal(result.memoryIsNotIsolated,true);assert.deepEqual(result.allImplementationFiles,allImplementationFiles);assert.equal(result.manifestSHA256,sha(manifestBytes));assert.equal(result.inputSHA256,spec.inputSHA256);assert.equal(result.outputCacheSHA256,spec.canonicalOutputSHA256);
  assert.equal(result.implementation,record.implementation);assert.equal(result.caseName,record.caseName);assert.equal(result.iterations,spec.spec.iterations);assert.equal(result.warmup,spec.spec.warmup);assert.equal(result.samples,spec.spec.n);assert.equal(result.selectionCount,spec.spec.reducers.length);assert.equal(result.millisecondsPerCall,result.elapsedMilliseconds/result.iterations);assert.equal(result.comparisons,9);timingComparisons+=result.comparisons;
}
const timingSummary=Object.keys(manifest.expectedFiles).map(name=>{
  const grouped=Object.fromEntries(roles.map(role=>{const rows=paired.records.filter(row=>row.caseName===name&&row.implementation===role).sort((a,b)=>a.runNumber-b.runNumber);assert.deepEqual(rows.map(row=>row.runNumber),[0,1,2,3,4,5,6]);return [role,rows.map(row=>row.result.millisecondsPerCall)];})),per=Object.fromEntries(roles.map(role=>[role,stats(grouped[role])])),comparisons={};
  for(const reference of ['baseline','original'])comparisons[reference]={medianRatioPercent:100*(per.candidate.median/per[reference].median-1),pairedDifferenceMilliseconds:stats(difference(grouped.candidate,grouped[reference])),pairedRatioPercent:stats(grouped.candidate.map((value,index)=>100*(value/grouped[reference][index]-1))),observedRanges:overlap(per.candidate,per[reference]),candidateSlowerPairs:grouped.candidate.filter((value,index)=>value>grouped[reference][index]).length};
  const recorded=paired.summary.find(row=>row.caseName===name);for(const role of roles)assert.deepEqual(recorded.implementations[role],{samples:7,median:per[role].median,min:per[role].min,max:per[role].max});return {caseName:name,millisecondsPerCall:per,candidateComparedWith:comparisons};
});

const memoryName='results/memory-observations-control-1791850160778.json',memory=await read(memoryName);await bind(memoryName,{digest:'774d033a1682f71a19bd0a288108accf645573eadec815e5058a40b366d02679'});assert.equal(memory.status,'passed');assert.equal(memory.measurementRun,true);assert.equal(memory.samples.length,147);assert.equal(memory.singleImplementationPerWorker,true);assert.equal(memory.quietFrom,'2026-10-13T00:05:01Z');assert.deepEqual(memory.sourceHashesBefore,memory.sourceHashesAfter);assert.equal(memory.manifestSHA256,sha(manifestBytes));for(const [name,digest]of Object.entries(memory.sourceHashesBefore))await bind(name,{digest});
const names=await fs.readdir(resolve('results')),memoryRows=[];let memoryComparisons=0,observerSamples=0;
for(const sample of memory.samples){
  assert.equal(sample.code,0);assert.equal(sample.signal,null);assert.equal(sample.failure,undefined);const fixture=manifest.expectedFiles[sample.caseName];assert.ok(fixture);assert.ok(roles.includes(sample.implementation));const result=sample.result;assert.equal(result.pid,sample.pid);assert.equal(result.loadedReducerImplementations,1);assert.equal(result.implementation,sample.implementation);assert.equal(result.caseName,sample.caseName);assert.equal(result.measurementRun,true);assert.equal(result.manifestSHA256,sha(manifestBytes));assert.deepEqual(result.selectedSources,manifest.implementations[sample.implementation].files);
  if(sample.implementation!=='original'){assert.equal(result.loadedCJSModules.length,0);assert.equal(result.loadedNativeModuleFiles,sample.implementation==='candidate'?2:1);}else assert.deepEqual(new Set(result.loadedCJSModules),new Set(Object.keys(manifest.authority.files)));
  assert.equal(result.comparisons,3*(fixture.spec.retained+2));memoryComparisons+=result.comparisons;
  const prefix='memory-control-'+sample.implementation+'-'+sample.caseName+'-'+sample.runNumber+'-',matches=names.filter(name=>name.startsWith(prefix)&&name.endsWith('.stdout.txt'));assert.equal(matches.length,1);const stem=matches[0].slice(0,-'.stdout.txt'.length),file='results/'+stem;
  await bind(file+'.stdout.txt',{digest:sample.stdoutSHA256,maxBytes:manifest.limits.stdoutBytes});await bind(file+'.stderr.txt',{digest:sample.stderrSHA256,maxBytes:manifest.limits.stdoutBytes});await bind(file+'.observer.txt',{maxBytes:manifest.limits.stdoutBytes});await bind(file+'.observer-errors.txt',{maxBytes:65536});assert.equal((await fs.readFile(resolve(file+'.stderr.txt'))).length,0);assert.equal((await fs.readFile(resolve(file+'.observer-errors.txt'))).length,0);
  const raw=(await fs.readFile(resolve(file+'.stdout.txt'),'utf8')).trim().split('\n').map(line=>JSON.parse(line));assert.deepEqual(raw.find(row=>row.kind==='result'),result);assert.equal(raw.filter(row=>row.kind==='result').length,1);assert.deepEqual(raw.filter(row=>row.kind==='snapshot').map(({kind,...row})=>row),result.checkpoints);
  const observer=(await fs.readFile(resolve(file+'.observer.txt'),'utf8')).trim().split('\n').map(line=>JSON.parse(line));assert.equal(observer.length,sample.ownedPIDObserver.samples);assert.ok(observer.length>0);assert.ok(observer.every(row=>row.pid===sample.pid&&Number.isFinite(row.rss)&&row.rss>0&&row.rss<=manifest.limits.childRSSMiB*1024*1024));assert.equal(Math.max(...observer.map(row=>row.rss)),sample.ownedPIDObserver.peakRSS);observerSamples+=observer.length;
  const checkpoint=label=>{const found=result.checkpoints.filter(row=>row.name===label);assert.equal(found.length,1);return found[0];};for(const row of result.checkpoints){assert.equal(row.pid,sample.pid);for(const metric of ['rss','heapTotal','heapUsed','external','arrayBuffers','lifetimePeakResidentKiB'])assert.ok(Number.isFinite(row[metric]));assert.ok(row.rss<=manifest.limits.childRSSMiB*1024*1024);}
  const warm=checkpoint('warmBase'),before=checkpoint('beforeRetention'),retained=checkpoint('retainedAfterGC'),released=checkpoint('releasedAfterGC'),initial=checkpoint('beforeSelectedImport'),initialized=checkpoint('afterSelectedInitialization');
  const metrics={observedPeakRSSBytes:sample.ownedPIDObserver.peakRSS,lifetimePeakRSSBytes:Math.max(...result.checkpoints.map(row=>row.lifetimePeakResidentKiB))*1024,checkpointPeakRSSBytes:Math.max(...result.checkpoints.map(row=>row.rss)),checkpointPeakHeapUsedBytes:Math.max(...result.checkpoints.map(row=>row.heapUsed))};
  for(const metric of ['rss','heapUsed','external','arrayBuffers']){metrics['initialized-'+metric+'-signedBytes']=initialized[metric]-initial[metric];metrics['retained-'+metric+'-signedBytes']=retained[metric]-before[metric];metrics['released-'+metric+'-signedBytes']=released[metric]-before[metric];metrics['releasedFromWarmBase-'+metric+'-signedBytes']=released[metric]-warm[metric];}
  memoryRows.push({implementation:sample.implementation,caseName:sample.caseName,runNumber:sample.runNumber,pid:sample.pid,rawStem:file,observerSamples:observer.length,metrics});
}
const memorySummary=Object.keys(manifest.expectedFiles).map(name=>{
  const grouped=Object.fromEntries(roles.map(role=>{const rows=memoryRows.filter(row=>row.caseName===name&&row.implementation===role).sort((a,b)=>a.runNumber-b.runNumber);assert.deepEqual(rows.map(row=>row.runNumber),[0,1,2,3,4,5,6]);return [role,rows];})),metricNames=Object.keys(grouped.original[0].metrics),per=Object.fromEntries(roles.map(role=>[role,Object.fromEntries(metricNames.map(metric=>[metric,stats(grouped[role].map(row=>row.metrics[metric]))]))])),compared={};
  for(const reference of ['baseline','original'])compared[reference]=Object.fromEntries(metricNames.map(metric=>[metric,{medianDifferenceBytes:per.candidate[metric].median-per[reference][metric].median,pairedDifferenceBytes:stats(grouped.candidate.map((row,index)=>row.metrics[metric]-grouped[reference][index].metrics[metric])),observedRanges:overlap(per.candidate[metric],per[reference][metric]),pairedPercentChange:nullableStats(grouped.candidate.map((row,index)=>grouped[reference][index].metrics[metric]===0?null:100*(row.metrics[metric]-grouped[reference][index].metrics[metric])/grouped[reference][index].metrics[metric])),percentageDefinition:'Signed difference divided by signed control; unavailable when control is zero; not a physical allocation efficiency ratio for signed deltas.'}]));
  return {caseName:name,metricsByImplementation:per,candidateComparedWith:compared};
});
const measuredNames=new Set([timingName,pairedName,memoryName,...Object.keys(rawBindings).filter(name=>/^results\/(?:timing-attempt-|timing-(?:original|baseline|candidate)-|memory-control-)/.test(name))]);
const expectedAdded=Object.keys(rawBindings).filter(name=>!Object.hasOwn(readiness.inventory,name)&&name!=='readiness-validation.json'&&name!=='freeze-manifest.json');assert.equal(expectedAdded.length,887);
assert.equal(paired.records.length*2,294);assert.equal(memory.samples.length*4,588);
const timingDurationSeconds=(Date.parse(timing.interval.end)-Date.parse(timing.interval.start))/1000,memoryDurationSeconds=(Date.parse(memory.interval.end)-Date.parse(memory.interval.start))/1000;
const windows={timing:{authorizedFrom:'2026-10-12T23:58:13Z',explicitlyClosedAt:'2026-10-13T00:05:01Z',interval:timing.interval,pairedInterval:paired.interval,actualControllerSeconds:timingDurationSeconds,prospectiveReservationMinutes:[5,8],finishedWithinReservation:true},memory:{authorizedFrom:'2026-10-13T00:05:01Z',explicitlyClosedAt:'2026-10-13T00:09:53Z',interval:memory.interval,actualControllerSeconds:memoryDurationSeconds,prospectiveReservationMinutes:[10,15],finishedWithinReservation:true},rootAndAgentsPaused:true,acknowledgments:'Root explicitly authorized and closed each window; other agents had acknowledged pause. No root/agent tests, builds, browser, publication or source scans overlapped. These coordination messages are operational trusted-session evidence, not cryptographic attestation.',unrelatedWindowsBackgroundUncontrolled:true,machineLevelIsolation:false,idleOwnedPreviewServers:true,unrelatedUserActivityUncontrolled:true};
assert.ok(Date.parse(windows.timing.authorizedFrom)<=Date.parse(timing.interval.start)&&Date.parse(timing.interval.end)<=Date.parse(windows.timing.explicitlyClosedAt));assert.ok(Date.parse(windows.memory.authorizedFrom)<=Date.parse(memory.interval.start)&&Date.parse(memory.interval.end)<=Date.parse(windows.memory.explicitlyClosedAt));
const output={schema:'rea-metrics-wrapper-measurement-independent-summary/v1',checkedAt:new Date().toISOString(),status:'authenticated and recomputed; candidate retained without integration',readinessReceipt:{bytes:readinessBytes.length,sha256:sha(readinessBytes)},readinessInventoryFiles:2426,readinessInventoryUnchanged:true,manifestSHA256:sha(manifestBytes),candidate:readiness.candidate,originalSourceBindings,runtime:manifest.runtime,currentProductionSourcesAuthenticatedUnchanged:{[preservation.productionPath]:readiness.candidate.baselineSHA256},historicalSemantics:manifest.selectorSemanticBinding,historicalFullSemanticReceipt:manifest.fullSemanticReceipt,historicalFullSemanticReceiptSHA256:manifest.fullSemanticReceiptSHA256,fullCorpusRerun:false,semanticCorrectnessScope:'Frozen86 wrapper and nine new independent root corpora are correctness provenance; the66-input inherited selector fixture is retained as correctness provenance, not a measured workload replacement or universal proof. Finite historical source-identical 2,910,751 reducer comparisons including48,240 cache comparisons plus14,240 helper comparisons; new readiness/held-out/adversarial controls remain exact preserved claims, not new exhaustive verification.',windows,counts:{timingChildren:147,memoryChildren:147,timingFreshAndCachedPacketChecks:timingComparisons,memoryFreshAndCachedPacketChecks:memoryComparisons,ownedPIDObserverSamples:observerSamples,newMeasurementArtifacts:expectedAdded.length,timingChildRawLogs:294,memoryChildAndObserverRawLogs:588},timingSummary,memorySummary,memorySignedPerChildRows:memoryRows,allValuesAndNegativeDifferencesRetained:true,failureAndCensoring:{timingBranchFailures:0,memoryBranchFailures:0,partialChildren:0,failedOrLimitHitChildren:0,killedChildren:0,all147Plus147Completed:true,currentPreparationFailurePreserved:readiness.preservedCurrentPreparationFailures,preparationFailureAutomaticallyCaptured:true,historicalMetadataAndLookupErrorsRetainedInExactWrapper86:true,rawObserverHashesFirstComputedAtConsolidation:true},rejection:{candidateIntegrated:false,fullPerformanceNonRegressionEstablished:false,observedAllPercentilesMedianChangePercent:timingSummary.find(row=>row.caseName==='allPercentiles').candidateComparedWith.baseline.medianRatioPercent,observedAllCalculationsMedianChangePercent:timingSummary.find(row=>row.caseName==='allCalculations').candidateComparedWith.baseline.medianRatioPercent,reason:'Single/constructed/adversarial p95 medians improve in this finite window, but small-standard has a positive median change and overlapping ranges. Untouched multi-selection controls also overlap baseline. This does not establish whole-candidate nonregression, universal superiority, source-layout causation or authorize integration.',numericAcceptanceThresholdIntroducedAfterMeasurements:false,universalSuperiority:false,fullProductComplete:false},rawBindings,limitations:['Seven repetitions on one Windows Node24 host; ranges are descriptive, not confidence intervals.','Timing children load all three implementations for common prevalidation; memory diagnostics from those children are not isolated.','Memory children load exactly one implementation and authenticate its native two-module graph or original six CJS files.','100ms observer and checkpoint RSS can miss intermediate peaks; lifetime maxRSS measures the complete child, not only reduction.','Release diagnostics include both releasedAfterGC-minus-beforeRetention (historical comparable) and releasedAfterGC-minus-warmBase (prospective plan). Retained/released signed deltas include GC variation and common serializer/cache-read validation pressure; negative values are preserved without clipping and are not a leak proof.','256MiB old-space and512MiB observed RSS do not establish an OS process memory sandbox or cumulative allocations.','Observer numeric PID matches each owned child result, but there is no process-start identity proof or atomic PID-reuse/process-tree protection. Memory controller has no outer watchdog.','Current metrics production and older source/receipts remain unchanged; no new measured run, tuning, integration or publication was performed.']};
const reviewPreservation=JSON.parse(await fs.readFile(path.join(here,'preservation.json')));
output.preservation=reviewPreservation;
output.windows.idleOwnedPreviewSessionIDs=[54824,54899,59765,54465];
