    {
      "id": "grafana.candidate.a38672822f5ca805830e",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Create a Descope Project [here](https://app.descope.com/gettingStarted), and go through the Getting Started Wizard to configure your authentication. You can skip step if you already have Descope project set up.",
      "headingPath": [
        "Configure Generic OAuth authentication",
        "Examples of setting up Generic OAuth",
        "Set up OAuth2 with Descope"
      ],
