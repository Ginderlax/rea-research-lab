        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.d206c1fb993517d879de",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Verify network connectivity from the Grafana server to your InfluxDB endpoint. Check DNS resolution, firewall rules, and port access.",
      "headingPath": [
        "Troubleshoot InfluxDB data source issues",
        "Connection errors",
        "Request timed out"
      ],
      "source": {
