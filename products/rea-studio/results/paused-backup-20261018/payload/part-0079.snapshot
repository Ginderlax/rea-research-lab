    },
    {
      "id": "grafana.candidate.12238b05f76b8e7628e3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We've added the option to manage library panel permissions through role-based access control (RBAC). With this feature, you can choose who can create, edit, and read library panels. RBAC provides a standardized way of granting, changing, and revoking access when it comes to viewing and modifying Grafana resources, such as dashboards, reports, and administrative settings.",
      "headingPath": [
        "What’s new in Grafana v10.4",
        "Dashboards and visualizations",
        "Set library panel permissions with RBAC"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-4.md",
