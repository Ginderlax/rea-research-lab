    {
      "id": "grafana.candidate.df6741a59413e46e7d4b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For \"sqlite3\" only. [Shared cache](https://www.sqlite.org/sharedcache.html) setting used for connecting to the database. (private, shared) Defaults to `private`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[database]`",
        "`cache_mode`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
