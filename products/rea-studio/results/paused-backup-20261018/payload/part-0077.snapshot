    {
      "id": "grafana.candidate.52d25ab3769df6ab4bf9",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Fix any configuration issues and test your login setup.",
      "headingPath": [
        "Configure authentication",
        "Extended authentication settings",
        "Avoid automatic login",
        "How to use"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/_index.md",
