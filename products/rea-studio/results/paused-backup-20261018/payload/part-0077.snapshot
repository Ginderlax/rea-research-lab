    {
      "id": "grafana.candidate.f38f4811313c6bd1c62a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set this to `false` to disable loading other custom base maps and hide them in the Grafana UI. Default is `true`.",
