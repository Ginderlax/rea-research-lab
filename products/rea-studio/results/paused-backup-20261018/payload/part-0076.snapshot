    {
      "id": "grafana.candidate.d31ba34dc2b71d7f056a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The SQL query editor provides two modes:",
      "headingPath": [
        "InfluxDB query editor",
        "SQL query editor"
