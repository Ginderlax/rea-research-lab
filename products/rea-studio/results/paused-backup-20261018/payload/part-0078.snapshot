    {
      "id": "grafana.candidate.c7f5cbdddc0c2f34c9c5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If the template is passed the sorted labels for an alert then dot refers to the list of sorted labels:",
      "headingPath": [
        "If",
        "Templates",
        "Execute templates"
      ],
      "source": {
