      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.ab5b9980f5431d26abf0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "While Azure Monitor Metrics stores only simplified numerical data, Logs can store different data types, each with their own structure. You can also perform complex analysis of Logs data by using KQL.",
      "headingPath": [
        "Azure Monitor query editor",
        "Query Azure Monitor Logs"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/query-editor/index.md",
