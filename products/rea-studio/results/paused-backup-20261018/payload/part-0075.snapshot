    {
      "id": "grafana.candidate.3c6d8394e76e58f2ef2c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, all Grafana instances in a high-availability cluster evaluate all alert rules. This means query load on data sources is multiplied by the number of Grafana instances. Single-node evaluation mode changes this so that only one instance evaluates alert rules, reducing query load from N times to 1.",
      "headingPath": [
        "Configure high availability",
        "Single-node evaluation mode"
      ],
      "source": {
