    {
      "id": "grafana.candidate.1aa9858d49ef84285e44",
      "syntaxRole": "procedural-step",
      "sourceText": "1. To install a plugin from a custom URL, use the following convention to specify the URL: `<plugin ID>@[<plugin version>]@<url to plugin zip>`.",
