    {
      "id": "grafana.candidate.41c6cc80552b68675256",
      "syntaxRole": "list-item",
      "sourceText": "- We use a **\\<proxy>** configuration block for applying our authentication rules to every proxied request. These rules include requiring basic authentication where user:password credentials are stored in the **/etc/apache2/grafana_htpasswd** file. This file can be created with the `htpasswd` command.",
      "headingPath": [
        "Configure auth proxy authentication",
        "Making Apache’s auth work together with Grafana’s AuthProxy",
        "Apache BasicAuth",
        "Apache configuration"
      ],
      "source": {
