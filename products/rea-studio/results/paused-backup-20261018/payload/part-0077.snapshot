        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.8ef1570fdbd896a0a7d8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The `callback_url` can also be configured to support usage of the image renderer running as a plugin with support for SSL / HTTPS. For example https://localhost:3000/.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[rendering]`",
        "`callback_url`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
