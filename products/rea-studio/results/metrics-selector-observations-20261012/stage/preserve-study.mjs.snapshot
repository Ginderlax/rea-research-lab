import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),source=path.resolve(here,'../metrics-selector-measurement-next'),sha=bytes=>createHash('sha256').update(bytes).digest('hex'),fp=async file=>{const bytes=await fs.readFile(file);return {bytes:bytes.length,sha256:sha(bytes)};};
async function inventory(dir=source){const result={};for(const row of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const file=path.join(dir,row.name),relative=path.relative(source,file).replaceAll('\\','/');if(relative==='.local')continue;assert.ok(!row.isSymbolicLink());if(row.isDirectory())Object.assign(result,await inventory(file));else {assert.ok(row.isFile());result[relative]=await fp(file);}}return result;}
const summary=JSON.parse(await fs.readFile(path.join(here,'recomputed-summary.json'))),readiness=JSON.parse(await fs.readFile(path.join(source,'readiness-validation.json'))),before=await inventory();
assert.equal(Object.keys(before).length,1005);for(const [name,record]of Object.entries(readiness.inventory))assert.deepEqual(before[name],record);for(const [name,record]of Object.entries(summary.rawBindings))assert.deepEqual(before[name],record);
const expected=new Set([...Object.keys(readiness.inventory),'readiness-validation.json',...Object.keys(summary.rawBindings)]);assert.deepEqual(new Set(Object.keys(before)),expected);
const excluded=new Set(readiness.publicationExcludedArchives.map(row=>row.path)),copies=[];assert.equal(excluded.size,2);
for(const [name,record]of Object.entries(before)){if(excluded.has(name))continue;const file=path.join(here,'preserved/study',name);await fs.mkdir(path.dirname(file),{recursive:true});await fs.writeFile(file,await fs.readFile(path.join(source,name)),{flag:'wx'});assert.deepEqual(await fp(file),record);copies.push({path:'preserved/study/'+name,sourcePath:name,...record});}
const after=await inventory();assert.deepEqual(after,before);
const output={schema:'rea-metrics-selector-measured-study-preservation/v1',preparedAt:new Date().toISOString(),sourceStage:'../metrics-selector-measurement-next',sourceInventory:before,sourceFiles:1005,sourceBeforeAfterStable:true,preservedFiles:copies.length,preservedBytes:copies.reduce((sum,row)=>sum+row.bytes,0),copies,publicationExcludedArchives:readiness.publicationExcludedArchives,inventoryExclusions:readiness.inventoryExcludedPaths,sourceOnlyPreservationOfRejectedStudy:true,productionCandidateProposalPrepared:false,originalLibrarySourcesAreEvidenceOnly:true,sourceOrMeasurementsChanged:false};
await fs.writeFile(path.join(here,'study-preservation.json'),JSON.stringify(output,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({files:1005,preservedFiles:copies.length,preservedBytes:output.preservedBytes,excludedArchives:output.publicationExcludedArchives,sourceStable:true}));
