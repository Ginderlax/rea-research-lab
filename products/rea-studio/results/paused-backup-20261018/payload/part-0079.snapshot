    {
      "id": "grafana.candidate.5aca6e2727a0cc93129f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The new TraceQL-powered editor makes it much easier to build your query by way of static filters, better input/selection validation, copy query to the TraceQL tab, query preview, dedicated status filter, and the ability to run aggregate by (metrics summary) queries.",
      "headingPath": [
