    },
    {
      "id": "grafana.candidate.91b934fa760e97262fd5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana allows you to configure more than one authentication provider, however it is not possible to configure the same type of authentication provider twice. For example, you can have [SAML](saml/) (Enterprise and Cloud) and [Generic OAuth](generic-oauth/) configured, but you cannot have two different [Generic OAuth](generic-oauth/) configurations.",
      "headingPath": [
        "Configure authentication",
        "Configuring multiple identity providers"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/_index.md",
        "gitBlobSha": "4eaeb6c9573c12f36370a29ae5cde9ef8903af26",
        "sha256": "c0d14f6586dd5c3329bd35640260ccf0154fa243faff94f744821a626f330ebe",
        "lineStart": 65,
        "lineEnd": 66,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/_index.md#L65-L66"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.a47d992cd91fde5405df",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "> Note: Grafana does not support multiple identity providers resolving the same user. Make sure no user account overlaps between the different providers.",
      "headingPath": [
        "Configure authentication",
        "Configuring multiple identity providers"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/_index.md",
        "gitBlobSha": "4eaeb6c9573c12f36370a29ae5cde9ef8903af26",
