// Finite DOM model only: disabled-aware clicks, ordinary select/input values.
// No original/browser renderer or native focus/keyboard semantics are claimed.
class Text{constructor(value){this.textContent=value;this.parentNode=null;}}
class Element{constructor(tag){this.tagName=tag.toUpperCase();this.children=[];this.parentNode=null;this.listeners=new Map();this.attributes=new Map();this.disabled=false;this.checked=false;this._value='';}
 set textContent(value){this.replaceChildren(new Text(String(value)));}get textContent(){return this.children.map(c=>c.textContent).join('');}get firstChild(){return this.children[0]??null;}get options(){return this.children.filter(c=>c.tagName==='OPTION');}get value(){return this.tagName==='SELECT'?(this._value||this.options[0]?.value||''):this._value;}set value(v){this._value=String(v);if(this.tagName==='SELECT'&&!this.options.some(o=>o.value===this._value))this._value='';}
 append(...nodes){for(const n of nodes){n.parentNode=this;this.children.push(n);}}replaceChildren(...nodes){for(const n of this.children)n.parentNode=null;this.children=[];if(this.tagName==='SELECT')this._value='';this.append(...nodes);}setAttribute(k,v){this.attributes.set(k,String(v));}getAttribute(k){return this.attributes.get(k)??null;}addEventListener(k,fn){const a=this.listeners.get(k)??[];a.push(fn);this.listeners.set(k,a);}async emit(k){for(const fn of this.listeners.get(k)??[])await fn({target:this,type:k});}async click(){if(!this.disabled)await this.emit('click');}querySelectorAll(selector){const tags=selector.split(',').map(x=>x.trim().toUpperCase());return descendants(this).filter(c=>tags.includes(c.tagName));}}
function descendants(root){return root.children.flatMap(c=>c instanceof Element?[c,...descendants(c)]:[]);}
export function makeDom(){const previous=globalThis.document;globalThis.document={createElement:tag=>new Element(tag)};const root=new Element('div');return{root,field:label=>{const found=descendants(root).find(c=>c.tagName==='LABEL'&&c.firstChild?.textContent===label);if(!found)throw new Error('Owned field missing: '+label);return found.children.find(c=>c instanceof Element);},button:label=>{const found=descendants(root).find(c=>c.tagName==='BUTTON'&&c.textContent===label);if(!found)throw new Error('Owned button missing: '+label);return found;},restore(){globalThis.document=previous;}};}
export function deferred(){let resolve,reject;const promise=new Promise((a,b)=>{resolve=a;reject=b;});return{promise,resolve,reject};}
