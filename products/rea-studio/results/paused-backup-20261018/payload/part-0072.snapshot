const commonReproduction=`## Reproduction and preservation

Run from this project directory with Node.js 24 and a tar utility. The reconstruction demonstration needs no vendor artifact or external dependency.

\`\`\`powershell
node demo.mjs
# Acquire only when the exact pinned package is absent locally.
node acquire.mjs
node reproduce.mjs
\`\`\`

The reproduction wrapper verifies the selected released files against the retained hashes before invoking the original comparison harness. New tests save results under a fresh \`artifacts/replays/test-*\` directory. The recorded \`test-results.json\` remains the historical baseline. Acquisition checks both SHA-256 and the registry SHA-512 integrity value before extraction; no mutable latest-version lookup is used.

To reproduce the static analysis separately, provide \`REA_CLI\` pointing to the published REA 6.4.0 entry point and run \`node analyze.mjs\`. The locally retained sibling REA backup is the default. A repository checkout alone requires that external REA runtime; it is not bundled into this project. Analysis uses a 512 MB heap, a 4 MB semi-space, and a 120000 ms analysis timeout. New analysis evidence and its summary save under fresh \`artifacts/replays/rea-*\` directories. \`REA_REUSE_ANALYSIS=1\` reuses the preserved original analysis while saving new follow-up results separately.

The shipped tarball, extracted package, focused input, raw REA Evidence JSON, follow-up requests, and diagnostic output remain local under \`artifacts/\`. GitHub contains original study code, result and evidence summaries, hashes, and the reports. Artifact evidence IDs identify the retained run; replays can have different IDs and timestamps.
`;
function evidenceTable(e){return `| Operation | Evidence ID |
| --- | --- |
| JavaScript application analysis | \`${e.analysisEvidenceId}\` |
| Analysis summary view | \`${e.summaryEvidenceId}\` |
| Module feature trace | \`${e.traceEvidenceId}\` |
| JavaScript semantic trace | \`${e.semanticEvidenceId}\` |`;}
function identity(p){return `The official npm release **${p.name} ${p.version}** was acquired on 12 October 2026. The ${p.bytes.toLocaleString('en-US')}-byte tarball has SHA-256 \`${p.sha256}\`. Its observed SHA-512 integrity value equals the registry value in [provenance.json](provenance.json). The [pinned distributable](${p.tarballUrl}) remains local. Matching checksums establish consistency with the retained release metadata; they do not independently attest the publisher or build process.`;}
const configs=[
{
dir:'04-excalidraw',product:'Excalidraw',version:'0.18.1',license:'MIT',mechanism:'Scene and viewport coordinates plus scene version calculations',differential:4004,invariants:1500,
title:'Excalidraw camera transforms and scene version calculations',
abstract:`Four public pure functions in Excalidraw's minified production release support a small interoperability layer for mapping pointer coordinates and inspecting scene versions. An independently executed reconstruction agrees with exact released expressions on 4,004 differential comparisons; 1,500 additional reconstruction round trips satisfy a 1e-9 coordinate tolerance. REA supplies a focused static graph and a partial parameter trace, while the released expressions supply the behavioral oracle. Version sums admit collisions and the version fingerprint is order sensitive in the recorded example. These findings support camera and version interoperability in a declared numerical domain, rather than recovery of Excalidraw's drawing editor or collaboration service.`,
questions:`The principal question is whether the shipped production export contract can be reconstructed without loading React or the complete editor. H1 predicts agreement for finite nonzero zoom with the original forward and inverse coordinate functions. H2 predicts agreement for the scene-version sum and unsigned 32-bit fingerprint on generated element lists. H3 predicts that the forward and inverse reconstruction compose to the original scene point within a numerical tolerance. H3 is a model invariant, not an additional original-product comparison.

The practical use is an inspection or migration tool that translates scene positions into display coordinates and preserves existing version conventions. The study does not quantify developer savings or commercial value.`,
artifact:`The selected source is the shipped \`dist/prod/chunk-K2UTITRG.js\`, SHA-256 \`72b54e8e9b3c17c69f1dd5e40203bfaed62313bc611b86ecb8a1625a12562e51\`. A Babel-based export-resolution step located the minified declarations through the shipped ESM export chain. [slice-manifest.json](slice-manifest.json) records four exact half-open byte ranges and individual hashes:

| Public export | Local symbol | Byte range |
| --- | --- | --- |
| viewportCoordsToSceneCoords | Dn | 19966 to 20105 |
| sceneCoordsToViewportCoords | ta | 20106 to 20243 |
| getSceneVersion | nY | 427393 to 427429 |
| hashElementsVersion | rY | 427430 to 427517 |

Character offsets and byte offsets differ for the later declarations because earlier Unicode changes UTF-8 lengths; the oracle uses byte ranges. The analysis modules wrap the exact released slices in \`var\` and \`export\` declarations. The wrapper is laboratory code. Upstream source and source maps were not used to reconstruct these mechanisms. Inspection of the original emitted JavaScript means this is not a clean-room or blinded implementation.`,
rea:`REA parsed four JavaScript files and the focused package manifest: 690 text bytes and 200 AST nodes, with zero parse failures. Its application graph has 15 nodes, zero relations, and complete coverage of this focused input. The broader semantic graph has 125 nodes, 86 relations, and 38 unknowns; its overall coverage status is \`unknown\`. These are different graph layers and must not be conflated.

The module trace labels its coverage \`complete-within-source\` and selects two nodes for the camera slice. This establishes a seed match in the focused inventory. The parameter \`e\` of minified function \`Dn\` is traced by semantic node \`jsrg_node_528fd7ebbe1687c2dbceb9b9afc3888e0765a0dab58f2232a32edce998a16223\`. That trace reports \`found\`, two nodes, one relation, one relevant unknown, and partial coverage. It supports a local static relationship candidate, not a complete causal explanation of camera behavior.`,
contract:`For a scene point s, scroll vector t, viewport offset o, and zoom z, the recovered forward relation is \`viewport = (s + t) * z + o\`. The inverse is \`scene = (viewport - o) / z - t\`. A reconstruction preserves JavaScript arithmetic order to retain floating-point behavior. The scene version adds each element's \`version\`; the fingerprint starts at 5381, repeatedly applies \`state = 33 * state + versionNonce\` using the released shift/add semantics, and returns the final unsigned 32-bit value.

The demonstration in [demo.mjs](demo.mjs) composes these functions into a camera inspection record. [reconstruction.mjs](reconstruction.mjs) implements the recovered contract; it does not load or embed the production chunk.`,
results:`The oracle verifies both the production chunk digest and each selected byte-slice digest, then evaluates the original expression in an isolated VM. React, application bootstrap, and drawing behavior are absent. The fixed seed \`0x5eed1234\` generates 1,500 camera states and points over six positive zooms: 0.1, 0.5, 1, 1.25, 2, and 5. Each case compares the forward and inverse original calls, giving 3,000 comparisons. Four additional inverse calls probe zero, negative, infinite, and NaN zoom; these characterize released arithmetic outside the invertible domain.

Five hundred generated lists, including empty lists, compare both version functions, giving 1,000 comparisons. Thus **4,004 differential comparisons pass with zero mismatches**. The separate 1,500 reconstruction round trips pass with absolute coordinate error at most 1e-9. [test-results.json](test-results.json) reports 5,504 passing checks in total, but only 4,004 use an original-artifact oracle.

The recorded examples show that element versions [2,5] and [3,4] share a version sum, and that reversing nonce values [1,2] changes the fingerprint. These observations prevent interpreting either function as a cryptographic or universally unique scene identifier. They are examples, not an exhaustive collision analysis.`,
limits:`The corpus does not establish equivalence for arbitrary JavaScript objects, getters, invalid state shapes, huge version values, or every floating-point bit pattern. Round-trip agreement tests the reconstruction alone; it is not independent evidence about the original beyond the separate differential calls. AST extraction and VM evaluation preserve the chosen expressions but omit module initialization and downstream callers. Seeded examples are deterministic engineering coverage, not independent statistical samples, so a zero mismatch rate is not a justified universal failure probability.

Drawing tools, shape serialization, text rendering, selection, undo, pointer event scheduling, synchronization, end-to-end encryption, and collaboration servers are outside scope. REA's partial semantic graph remains partial even when behavioral comparisons pass.`,
sources:`[Official repository](https://github.com/excalidraw/excalidraw), [release package](https://www.npmjs.com/package/@excalidraw/excalidraw/v/0.18.1), and [upstream MIT license at v0.18.1](https://raw.githubusercontent.com/excalidraw/excalidraw/v0.18.1/LICENSE) identify the product and licensing context. The algorithmic claims above are supported by the retained released bytes and execution records.`,
claims:[
['EXC-01','observation','The acquired npm tarball matches retained SHA-256 and registry SHA-512 values.',['provenance.json'],'Checksum agreement is not publisher attestation.'],
['EXC-02','static-inference','REA found a local forward parameter influence in the camera slice.',['rea-evidence-summary.json#semanticTrace'],'The trace has one relevant unknown and partial coverage.'],
['EXC-03','execution-comparison','The four reconstructed functions match the released expression oracle on 4,004 comparisons.',['test-results.json','test.mjs','slice-manifest.json'],'Limited to the fixed corpus and extracted expressions.'],
['EXC-04','model-invariant','1,500 reconstruction camera round trips satisfy 1e-9 tolerance.',['test-results.json#counts.roundTrips','test.mjs'],'These are model invariants, not original-product differential cases.'],
['EXC-05','execution-observation','The tested version sum has a collision and the tested fingerprint changes with order.',['test-results.json#observations'],'Finite illustrative examples; no cryptographic or global uniqueness claim.'],
['EXC-06','unknown','The full application and collaboration service are not recovered.',['REPORT.md#Study limits'],'Focused analysis contains only four pure exported mechanisms.']]
},
{
dir:'05-joplin',product:'Joplin',version:'3.7.1',license:'AGPL-3.0-or-later',mechanism:'Resource URL parsing and collision-safe heading anchors',differential:1630,invariants:0,
title:'Joplin resource links and heading anchor reconstruction',
abstract:`Joplin's released renderer contains a compact resource-link grammar and a deterministic heading-anchor allocator that matter to note export and navigation interoperability. A reconstruction matches unchanged released URL utilities and the heading plugin on 1,630 differential comparisons, including malformed decoding, duplicate headings, Unicode, and newline boundaries. A minimal token host executes the actual heading plugin without loading the note application. REA's final focused analysis covers both files after an initial resource-limited partial run; its semantic parameter trace remains partial. The study recovers URL and anchor contracts for synthetic inputs, without reconstructing Joplin synchronization, storage, or complete Markdown rendering.`,
questions:`The first question is whether a compatibility layer can preserve Joplin internal links rather than treating them as ordinary web addresses. H1 predicts agreement for resource recognition and parsing over the declared Cartesian fixture matrix. H2 predicts agreement for percent-decoding outcomes, including error classes. H3 predicts that the reconstructed heading allocator preserves the released plugin's collision decisions for the selected heading batches.

These contracts can support note migration and export checks. Their value follows from preserving existing link destinations; the study makes no measured claim about migration success on real notebooks. All fixtures are synthetic and contain no user notes.`,
artifact:`The exact emitted CommonJS files are \`urlUtils.js\`, SHA-256 \`06072f09ef26b92ed6625dd4457be6a76e34cb71e7fd446401a8d19f89a50ae6\`, and \`headerAnchor.js\`, SHA-256 \`cb043c965a0b1e1daf611fd1d6cf768e5c3c692fe0b236a57fe685a0aa8f27e3\`. The focused input also includes the original package manifest. The package records upstream git head \`c17c205049ce74e449dc1ce08cbd1c875410d7d5\`.

The reconstruction is source assisted through inspection of the emitted release code, with a separate original execution path. No source maps were used to recover the contract. This is not clean-room development, and source visibility makes this a readable-artifact interoperability study rather than an opaque native decompilation result.`,
rea:`The final analysis parses both selected JavaScript files: 6,092 text bytes, 512 AST nodes, nine findings, and zero parse failures. The application graph has 14 nodes, zero relations, and complete coverage of the selected input. The semantic graph has 339 nodes, 293 relations, and 106 unknowns with overall coverage \`unknown\`. The module trace's \`complete-within-source\` status refers to this restricted application graph.

The final semantic trace follows parameter \`url\` in \`parseResourceUrl\`, semantic node \`jsrg_node_2ae7131fcaba4c7d2e2a93d6b42e2b26e46a5992dfe562cc3581b672e4829eeb\`. It reports \`found\`, four nodes, three relations, one relevant unknown, and partial coverage. These observations support selected static relationships; exact runtime behavior comes from the original execution comparisons.`,
contract:`Resource recognition accepts the case-sensitive prefixes \`:/\` and \`joplin://\`, then exactly 32 ASCII alphanumeric identifier characters. This grammar is broader than hexadecimal. An optional hash has no whitespace. The optional title annotation is one whitespace character followed by a quoted title; the released regex rejects embedded line terminators in that title. Invalid recognition yields false and parsing yields null. A recognized fragment is decoded with plus interpreted as space; malformed percent encoding raises URIError in the tested calls.

The heading allocator retains ASCII letters and digits, collapses other runs into hyphens, trims edge hyphens, and lowercases the result. It checks the complete set of allocated names, adding successive numeric suffixes until unused. This matters when a naturally suffixed heading, such as \`a-title-1\`, competes with a duplicate \`A title\`. Non-ASCII-only headings can yield an empty base; repeated empty bases then receive suffixes. These compatibility rules preserve released behavior rather than applying a new Unicode slug policy.

[reconstruction.mjs](reconstruction.mjs) exports the URL helpers and heading allocator. [demo.mjs](demo.mjs) presents a synthetic notebook navigation record.`,
results:`The URL oracle loads the unchanged released \`urlUtils.js\`. Seven candidate identifier strings, five prefixes, and 21 tails generate 735 strings. Each string is compared for recognition and parsing, giving 1,470 comparisons. Tail fixtures include empty hashes, plus signs, percent-encoded Japanese, malformed escapes, quoted annotations, tabs, CR/LF combinations, and Unicode line separators.

Ten decoding calls compare either values or thrown error names, including malformed escape sequences, null, and a number. The heading oracle registers the actual released plugin into a minimal Markdown token host. It supplies heading-open, inline, and heading-close tokens and reads the emitted anchor names. One hundred fifty batches vary duplicates, punctuation, digits, underscores, non-ASCII headings, and suffix competition. **All 1,630 differential comparisons pass with zero mismatches**, as recorded in [test-results.json](test-results.json). Comparing error class names does not establish equality of error messages or stacks.`,
failure:`## Resource constraints and corrected requests

The first analysis, Evidence ID \`ev_e82a598f507758a18233f8b504de56f288cb4cd700dab7cb729b44cd4be238a1\`, retained only one parsed JavaScript file. The application graph explicitly reports partial coverage, and its limitations identify \`headerAnchor.js\` worker-startup heap exhaustion. Its parse-failure count is zero; this does not mean both files were analyzed. The raw partial run remains in \`artifacts/partial-evidence-run/\`.

The same session preserved a later summary-view allocation failure in \`artifacts/evidence/summary.allocation-failure.stderr.txt\`. After memory pressure was released, the focused analysis and follow-ups succeeded with the bounded settings recorded in [analyze.mjs](analyze.mjs). These are environment failures and cannot be presented as recovered product behavior.

An initial feature-trace request used \`source\` instead of the required \`application\` field. REA rejected it as \`invalid_request\`, recording missing \`application\` and unknown \`source\`. The preserved \`trace.invalid-request.json\` is a harness request error. The successful corrected request and trace coexist with that record; the failed request is not counted as a successful trace.
`,
limits:`The heading oracle mocks the Markdown token host and compares generated names rather than the full token structure, HTML output, parser, or plugin ordering. The URL grammar corpus is finite; recognition tests use string inputs, while non-string coercion is characterized only in the separate decoder calls. No assumption about all Unicode categories, regex engine versions, prototype mutations, or object accessors follows from these tests.

Joplin synchronization, encryption, notebook databases, Markdown parsing, attachments, UI navigation, and third-party plugins remain outside scope. The implementation may serve as a compatibility component, but a real migration requires end-to-end checks against the actual notebook format. Source-assisted reasoning and a shared researcher can produce correlated mistakes; the original released oracle and bounded evidence reduce, but do not eliminate, that threat.`,
sources:`[Official repository](https://github.com/laurent22/joplin), [renderer package](https://www.npmjs.com/package/@joplin/renderer/v/3.7.1), and [the recorded upstream license](https://raw.githubusercontent.com/laurent22/joplin/c17c205049ce74e449dc1ce08cbd1c875410d7d5/LICENSE) identify the release context. The package and upstream license specify AGPL-3.0-or-later. This project's source is conservatively distributed under that same license; the upstream notice is preserved separately. No Joplin logos or icons are included.`,
claims:[
['JOP-01','observation','The npm tarball matches retained SHA-256 and registry SHA-512 values.',['provenance.json'],'Integrity agreement alone does not attest the publisher.'],
['JOP-02','static-observation','The final REA run parsed both focused JavaScript files and the semantic graph retains 106 unknowns.',['rea-evidence-summary.json'],'Complete application inventory coverage is not complete semantic or full-product coverage.'],
['JOP-03','execution-comparison','Resource recognition, parsing, decoding, and heading names agree on 1,630 comparisons.',['test-results.json','test.mjs'],'Heading host is mocked; names and error classes are compared.'],
['JOP-04','artifact-interpretation','Identifiers use a 32-character ASCII alphanumeric grammar and heading allocation checks all previously used names.',['artifacts/package/urlUtils.js','artifacts/package/headerAnchor.js','reconstruction.mjs'],'Readable released code informed this source-assisted interpretation.'],
['JOP-05','failure-observation','The first worker-limited REA run is partial despite zero parse failures; a later focused run covers both files.',['artifacts/partial-evidence-run/analysis.json','rea-evidence-summary.json'],'Resource failure is not evidence of absent product functionality.'],
['JOP-06','unknown','Full rendering, synchronization, storage, and real-notebook interoperability remain unestablished.',['REPORT.md#Study limits'],'Only selected synthetic URL and heading contracts were executed.']]
},
{
dir:'06-node-red',product:'Node-RED',version:'5.0.8',license:'Apache-2.0',mechanism:'Switch scalar predicates and segmented otherwise routing',differential:924,invariants:0,
title:'Node RED Switch routing reconstruction',
abstract:`A bounded Node-RED Switch reconstruction preserves the released node's scalar predicates, routing modes, and otherwise-segment behavior. The unchanged release constructor and input handler provide an oracle under a minimal RED host. Twenty-one rule configurations, 22 payload kinds, and two evaluation modes produce 924 routing or error comparisons, all passing. REA exposes an application inventory and a semantic trace that explicitly remains ambiguous. Original execution, rather than the unresolved static trace, establishes the recorded routing behavior. The implementation is useful for offline inspection of selected flow decisions, while JSONata, context, sequence repair, scheduling, and full flow execution remain outside its contract.`,
questions:`The first question is whether the Switch node's externally observable port-selection behavior can be reproduced without running a complete Node-RED server. H1 predicts agreement on zero-based port indices for the declared scalar rule and payload matrix in both all-match and first-match modes. H2 predicts agreement on the error class for an invalid regular expression. H3 predicts that otherwise eligibility is segmented by the original rule iterator, including configurations with multiple otherwise clauses.

The practical use is an offline explanation of why a synthetic message reaches selected branches in a flow. The study does not establish semantic equivalence of an arbitrary imported flow or quantify production reliability.`,
artifact:`The selected emitted file is \`core/function/10-switch.js\`, SHA-256 \`ca835b0d47bb3eb7cd877ea1ad7e589e87a942e31bec0111878d17f4c2b37434\`, together with the original package manifest. The entire exact npm tarball remains local. The original Switch module is loaded unchanged, while the laboratory supplies a minimal RED registration and property-evaluation host.

Inspection of the shipped implementation informs the reconstruction. This is source-assisted analysis of readable JavaScript and is not clean-room development or recovery of an opaque application. The original constructor, input event handler, rule iteration, sends, and errors are executed as the oracle.`,
rea:`REA parsed one JavaScript file and its manifest: 20,295 text bytes, 2,365 AST nodes, one finding, and zero parse failures. The focused application graph has six nodes, zero relations, and complete coverage of the selected input. The semantic graph contains 1,745 nodes, 1,596 relations, and 538 unknowns with overall coverage \`unknown\`.

The module feature trace labels its coverage \`complete-within-source\` and matches both an asset and a module for \`10-switch.js\`. The \`applyRule\` parameter \`property\`, semantic node \`jsrg_node_3f78e30f5e06cc13f8114fe7056b3ee36ba617a996f5b3ded3112783fc4f297d\`, produces an **ambiguous** forward-influence trace: four nodes, four relations, nine relevant unknowns, and partial coverage. REA explicitly states that candidate relations do not establish a resolved semantic path. Behavioral reconstruction therefore rests on shipped-code interpretation and original execution; it cannot be advertised as automatic semantic recovery.`,
contract:`The reconstruction returns the zero-based indices of matching output ports. It supports equality and inequality with the released JavaScript coercion behavior, ordered comparisons, inclusive between with either endpoint order, containment, regular expressions, strict true/false, null/non-null, emptiness for strings/arrays/buffers/objects, selected type tests, and an own-key predicate. It resolves scalar numeric, string, and boolean operands, with a bounded direct \`payload\` property lookup.

In all-match mode, multiple ports can be selected; first-match mode stops at the first selected rule. An otherwise rule starts a fresh eligibility segment before a successful match consumes it. Consequently, multiple otherwise clauses do not simply act as a single global fallback. The rules themselves determine which later segment can match. This interpretation is exercised by multiple-otherwise configurations rather than inferred solely from a static graph.

[reconstruction.mjs](reconstruction.mjs) exposes \`matches\` and \`route\`. [demo.mjs](demo.mjs) demonstrates branch decisions on synthetic inputs. Unsupported operand types and operators are outside the bounded interface.`,
results:`The host stub implements direct message property lookup and numeric, string, and boolean operand evaluation. It captures output ports from the original node's sends and error names from the original error callback. It does not substitute a copied rule evaluator for the original node. Configurations cover coercive equality, ordered comparisons, reversed between bounds, containment, case-insensitive regex, booleans, null, empty/nonempty, nine type conditions, own-key checks, multiple otherwise segments, a malformed regex, and an empty rule set.

Payloads include undefined, null, booleans, ordinary numbers, NaN, Infinity, numeric-looking strings, empty and nonempty arrays/objects, and empty/nonempty buffers. With 21 rule configurations × 22 payload kinds × 2 modes, **all 924 comparisons pass with zero mismatches**, as recorded in [test-results.json](test-results.json). Error comparisons preserve classes rather than messages or stacks. Port comparisons do not verify the content, cloning, timing, or sequence metadata of emitted messages.`,
failure:`## Corrected feature trace request

An initial feature-trace request used an unsupported \`source\` field rather than \`application\`. REA rejected it as \`invalid_request\`. The failed JSON remains in \`artifacts/evidence/trace.invalid-request.json\`, alongside the corrected successful module trace. This request error is not product behavior and is not counted as a successful REA observation. The later semantic result remains ambiguous even though it completed successfully.
`,
limits:`The minimal host limits external validity: real property traversal, context stores, JSONata, prior-value rules, sequence/group repair, asynchronous runtime scheduling, deployed credentials, and interactions with other nodes are excluded. The payload corpus is finite and can miss rare coercion, prototype, accessor, or regex engine behavior. Shared author access to emitted source can correlate oracle and reconstruction assumptions; the unchanged release path provides stronger evidence than self-consistency alone, but does not prove independence of interpretation.

The study preserves the selected node's routing results on its corpus. It does not establish a complete flow simulator, deployment compatibility, full application recovery, or behavior of future Node-RED releases. The unresolved REA semantic relationships remain explicit limits.`,
sources:`[Official repository](https://github.com/node-red/node-red) and [the exact nodes package](https://www.npmjs.com/package/@node-red/nodes/v/5.0.8) identify the product and release context. The tarball supplies the OpenJS Foundation Apache-2.0 license, preserved in this project. This project's implementation and harness are distributed under Apache-2.0; upstream copyright attribution is retained.`,
claims:[
['NRD-01','observation','The npm tarball matches retained SHA-256 and registry SHA-512 values.',['provenance.json'],'Integrity agreement alone does not attest the publisher.'],
['NRD-02','static-observation','REA parses the focused node but its applyRule parameter trace remains ambiguous and partial.',['rea-evidence-summary.json#semanticTrace'],'Four candidate relations and nine unknowns do not establish a resolved runtime path.'],
['NRD-03','execution-comparison','The reconstructed port selections or error names agree with the release node on 924 cases.',['test-results.json','test.mjs'],'Minimal RED host; excludes timing, emitted message contents, and sequence metadata.'],
['NRD-04','artifact-interpretation','Otherwise rules implement segmented eligibility in all-match routing.',['artifacts/package/core/function/10-switch.js','reconstruction.mjs','test.mjs'],'Only the declared scalar rule configurations and host are validated.'],
['NRD-05','unknown','Real context, JSONata, sequences, scheduling, and complete flows are not reconstructed.',['REPORT.md#Study limits'],'These interfaces are outside the tested model.']]
}
];
for(const c of configs){
 const dir=path.join(lab,c.dir),p=json(path.join(dir,'provenance.json')),e=json(path.join(dir,'rea-evidence-summary.json')),r=json(path.join(dir,'test-results.json'));
 if(r.failed!==0||r.total!==c.differential+c.invariants)throw Error('Recorded-count disagreement '+c.dir);
 const report=`# ${c.title}\n\n## Abstract\n\n${c.abstract}\n\n## Research questions and hypotheses\n\n${c.questions}\n\n## Release identity and selected artifacts\n\n${identity(p)}\n\n${c.artifact}\n\n## REA observations and evidential scope\n\n${evidenceTable(e)}\n\n${c.rea}\n\nThe recorded IDs and exact selected file digests are retained in [rea-evidence-summary.json](rea-evidence-summary.json). Static graph observations do not prove runtime execution.\n\n## Recovered contract and implementation\n\n${c.contract}\n\n## Original comparison and results\n\n${c.results}\n\n${c.failure??''}\n## Study limits\n\n${c.limits}\n\n${commonReproduction}\n## Sources and licensing\n\n${c.sources}\n\n[NOTICE.md](NOTICE.md) states publication scope and attribution. [claim-ledger.json](claim-ledger.json) classifies observations, interpretations, execution results, and unknowns. This is an engineering study with academic structure; it has not undergone independent peer review.\n`;
 fs.writeFileSync(path.join(dir,'REPORT.md'),report);
 const claims=c.claims.map(([claimId,classification,claim,support,limitation])=>({claimId,classification,claim,support,limitation}));
 fs.writeFileSync(path.join(dir,'claim-ledger.json'),JSON.stringify({product:c.product,version:c.version,claims},null,2)+'\n');
 const study={schemaVersion:1,project:c.dir,product:c.product,component:p.name,version:c.version,status:'completed-bounded-study',mechanism:c.mechanism,method:'Source-assisted released-artifact interpretation, actual REA static analysis, independent execution reconstruction, finite original-artifact comparison',cleanRoom:false,fullProductReconstruction:false,artifact:{url:p.tarballUrl,sha256:p.sha256,bytes:p.bytes,integrityVerified:p.integrityVerified},rea:{version:e.reaVersion,analysisEvidenceId:e.analysisEvidenceId,summaryEvidenceId:e.summaryEvidenceId,featureTraceEvidenceId:e.traceEvidenceId,semanticTraceEvidenceId:e.semanticEvidenceId,semanticTraceStatus:e.semanticTrace.status,semanticTraceCoverage:e.semanticTrace.coverage.status,semanticGraphUnknowns:e.semanticGraph.unknowns},tests:{recordedAt:r.testedAt,differentialComparisons:c.differential,modelInvariants:c.invariants,totalChecks:r.total,passed:r.passed,failed:r.failed,resultsFile:'test-results.json'},license:c.license,report:'REPORT.md',claimLedger:'claim-ledger.json',reproduction:{demo:'node demo.mjs',acquisition:'node acquire.mjs',comparison:'node reproduce.mjs',rea:'node analyze.mjs',freshReplayOutputs:true},limitations:r.scope};
 fs.writeFileSync(path.join(dir,'study.json'),JSON.stringify(study,null,2)+'\n');
 const checks=c.dir==='04-excalidraw'?`const manifest=JSON.parse(fs.readFileSync(new URL('./slice-manifest.json',import.meta.url),'utf8'));\nfor(const entry of manifest.entries){const bytes=fs.readFileSync(new URL(entry.file,import.meta.url));if(sha(bytes)!==entry.fileSha256||sha(bytes.subarray(entry.byteStart,entry.byteEnd))!==entry.sliceSha256)throw Error('Released chunk or slice digest mismatch');}\n`:`const evidence=JSON.parse(fs.readFileSync(new URL('./rea-evidence-summary.json',import.meta.url),'utf8'));\nfor(const entry of evidence.selectedFiles){if(sha(fs.readFileSync(new URL('./artifacts/package/'+entry.path,import.meta.url)))!==entry.sha256)throw Error('Released file digest mismatch: '+entry.path);}\n`;
 fs.writeFileSync(path.join(dir,'reproduce.mjs'),`import fs from 'node:fs';\nimport crypto from 'node:crypto';\nimport {spawnSync} from 'node:child_process';\nimport {fileURLToPath} from 'node:url';\nconst sha=b=>crypto.createHash('sha256').update(b).digest('hex');\n${checks}const child=spawnSync(process.execPath,[fileURLToPath(new URL('./test.mjs',import.meta.url))],{stdio:'inherit'});\nif(child.error)throw child.error;process.exitCode=child.status??1;\n`);
 const notice=`# ${c.product} study attribution and publication scope\n\nThis project studies ${p.name} ${p.version}, acquired as an exact official npm tarball. The original tarball, extracted release code, and full raw REA runs remain local under artifacts and are excluded from Git. The published material comprises research reports, manifests, selected evidence summaries, the laboratory reconstruction, demonstrations, and comparison harnesses.\n\nThe implementation was informed by inspection of emitted upstream code. It is not a clean-room implementation. This project uses ${c.license} conservatively for its research code and preserves upstream attribution. Copyright 2026 Ginderlax for original laboratory additions. The product name identifies the studied release and does not imply endorsement.\n\n${c.dir==='04-excalidraw'?'Upstream Excalidraw copyright (c) 2020 Excalidraw. The version-pinned upstream MIT license is retained in LICENSE.':c.dir==='05-joplin'?'Upstream copyright (c) 2016-2025 Laurent Cozic. The shipped upstream license notice is retained in UPSTREAM-LICENSE; LICENSE contains the AGPL version 3 text. Research source is offered under AGPL-3.0-or-later. Joplin is a registered trademark of JOPLIN SAS. No logos or icons are included.':'Upstream copyright OpenJS Foundation and other contributors, https://openjsf.org/. The complete shipped Apache License 2.0 text and upstream copyright notice are retained in LICENSE. No upstream NOTICE file is present at the root of this exact package.'}\n`;
 fs.writeFileSync(path.join(dir,'NOTICE.md'),notice);
 console.log(JSON.stringify({project:c.dir,status:study.status,differential:c.differential,invariants:c.invariants,reportBytes:Buffer.byteLength(report)}));
}
fs.copyFileSync(path.join(lab,'05-joplin/artifacts/package/LICENSE'),path.join(lab,'05-joplin/UPSTREAM-LICENSE'));
fs.copyFileSync(path.join(lab,'06-node-red/artifacts/package/LICENSE'),path.join(lab,'06-node-red/LICENSE'));
const licenses=[['04-excalidraw','https://raw.githubusercontent.com/excalidraw/excalidraw/v0.18.1/LICENSE'],['05-joplin','https://www.gnu.org/licenses/agpl-3.0.txt']];
for(const [dir,url] of licenses){const response=await fetch(url);if(!response.ok)throw Error('License acquisition '+response.status);const bytes=Buffer.from(await response.arrayBuffer());fs.writeFileSync(path.join(lab,dir,'LICENSE'),bytes);fs.writeFileSync(path.join(lab,dir,'license-provenance.json'),JSON.stringify({url,acquiredAt:new Date().toISOString(),sha256:sha(bytes),bytes:bytes.length},null,2)+'\n');}
import http from 'node:http';
import { readFile } from 'node:fs/promises';
const source = await readFile(new URL('../outputs/rea-research-lab/products/rea-studio/apps/flow/client.mjs',import.meta.url));
const html = `<!doctype html><meta charset="utf-8"><title>Private Flow lifecycle reproduction</title><main id="root"></main><p id="trace" role="status"></p><script type="module">
import {render} from '/client.mjs';
const definitions = Object.fromEntries(['A','B'].map(id => [id,{id,name:'Flow '+id,text:JSON.stringify([{id:'same',type:'inject',props:[],wires:[['out']]},{id:'out',type:'debug',complete:'true',wires:[]}]),starts:[{id:'same',name:'same'}],deployedStarts:[{id:'same',name:'same'}],deployedRevision:'deployed'}]));
let queue=Promise.resolve();
async function run(action,input){
 document.getElementById('trace').textContent=action+' '+(input.id||'');
 if(action==='list')return{flows:[],example:{name:'Local example',nodes:[],edges:[]}};
 if(action==='native-list')return{flows:Object.values(definitions)};
 if(action==='native-validate')return{nodeCount:2,starts:[{id:'same',name:'same'}],revision:'deployed',runReady:true,issues:[],schedules:[]};
 if(action==='native-inspect'){if(input.id==='A')await new Promise(r=>setTimeout(r,3000));return{flow:definitions[input.id],state:{selectedContext:input.id},runs:[]};}
 if(action==='native-inject')return{run:{status:'completed',executed_saved_definition:input.id,payload:'Message from Flow '+input.id}};
 throw Error(action);
}
const api=(action,input)=>{const operation=queue.then(()=>run(action,input));queue=operation.catch(()=>{});return operation;};
await render(document.getElementById('root'),api);
</script>`;
const server=http.createServer((req,res)=>{res.setHeader('Content-Type',req.url==='/client.mjs'?'text/javascript':'text/html');res.end(req.url==='/client.mjs'?source:html);});
server.listen(0,'127.0.0.1',()=>console.log('http://127.0.0.1:'+server.address().port));
process.on('SIGINT',()=>server.close(()=>process.exit(0)));
