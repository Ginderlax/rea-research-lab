        "lineEnd": 90,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/configure-custom-branding/index.md#L90-L90"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c1a5fa3b30459c1dd584",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "With custom branding, you can modify the following elements. Hover your cursor over a number to learn more about each element.",
      "headingPath": [
        "Configure custom branding"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/configure-custom-branding/index.md",
