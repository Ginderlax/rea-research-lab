    {
      "id": "grafana.candidate.3c54cfcee780ed9a9582",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We’ve rethought the panel information architecture, added additional interaction points, and reduced visual clutter. To start, we’ve improved the support of panels without a header, made a distinction between details set by you and data-induced information, and then included all essential components in the header of the panel. All of these are laid out from left to right in a row, so there are no overlapping, unusable components.",
      "headingPath": [
        "What's new in Grafana v9.4",
        "Dashboards and visualizations",
        "Dashboard panel redesign"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-4.md",
        "gitBlobSha": "45ce56665ca4f35f5a04a6213b45a29d1a3ddfc8",
        "sha256": "0149bcb00d079050a094ddb9bace1bde360efead88bd7cff979538dbd3130f77",
        "lineStart": 62,
