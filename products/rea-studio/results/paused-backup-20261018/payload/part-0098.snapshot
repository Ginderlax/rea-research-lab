"""Selected text/data authoring only. No candidate, verifier or product import."""
import datetime, hashlib, json, pathlib

BASE = pathlib.Path(r'C:\Users\evanh\Documents\Codex\2026-10-12\go')
REPO = BASE / 'outputs/rea-research-lab'
STAGE = BASE / 'work/vault-group-edit-document-route-next'
CAND = STAGE / 'candidate'
DOC = 'products/rea-studio/apps/vault/GROUP-EDIT.md'
MIGRATION = 'scripts/editor-vault-proof-migration.mjs'
PRODUCER = 'scripts/verify-cloud-publication.mjs'
CONTROLS = 'scripts/publication-integrity-controls.mjs'
ROOT = 'scripts/verify-records.mjs'
PREFIX = 'products/rea-studio/results/vault-group-edit-document-route-20261015/'
TARGET = 'products/rea-studio/apps/vault/results/group-edit-followup/plan/source-proof/preservation-manifest.json.snapshot'
OWNER = 'products/rea-studio/results/flow-vault-reviewed-installation-20261013/preservation-manifest.json'

def ident(path):
    b = path.read_bytes()
    return {'bytes': len(b), 'sha256': hashlib.sha256(b).hexdigest()}

def text(path):
    return path.read_bytes().decode('utf-8')

def write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(value.encode('utf-8'))

def writejson(path, value):
    write(path, json.dumps(value, indent=2, ensure_ascii=False) + '\n')

def once(value, before, after):
    if value.count(before) != 1:
        raise ValueError('Expected one exact source anchor: ' + before[:100])
    return value.replace(before, after, 1)

pins = {
    ROOT: (148558, 'a78a9467ecd76ae44c3d2413b6d341c735bb1f98a657646d3b00a13dccf066f8'),
    MIGRATION: (71277, '32c55edd351ea5145bc0b7c973fac32d8480386f7c172248aa90a340ac50903b'),
    PRODUCER: (25836, '54d2bfa62c2e5f2ae5543a61df9e664a2f4a7c5f4871df152f4028ea1d61a4d8'),
    CONTROLS: (27820, '148fc50127f0b663e1ddb779704657ccafefffe1462268021ad37041adf73d2e'),
    DOC: (7847, 'a06a163ce96424fb4e5923b29c4acfdc9e9c7e2fa780f07e4751dad3fc30b8c4'),
    TARGET: (822763, '313984a337af3c6b6d9d6fd28a97670f4e74fb62fd2f903932f9700e4a679ec8'),
    OWNER: (681325, 'bffe7c47f0447cb26dbebfbbd9353da8d7605e4a5df0a2b5e8e99e921dbac288')
}
for name, (size, sha) in pins.items():
    if ident(REPO / name) != {'bytes': size, 'sha256': sha}:
        raise ValueError('Wrong actual current source epoch: ' + name)
    if name in [ROOT, MIGRATION, PRODUCER, CONTROLS, DOC]:
        preserve = STAGE / 'before' / (name + '.snapshot')
        preserve.parent.mkdir(parents=True, exist_ok=True)
        if preserve.exists() and preserve.read_bytes() != (REPO / name).read_bytes():
            raise ValueError('Refusing to overwrite preserved source')
        preserve.write_bytes((REPO / name).read_bytes())

owner = json.loads(text(REPO / OWNER))
declared = [r for r in owner['records'] if r['path'] == TARGET]
if len(declared) != 1 or {k: declared[0][k] for k in ['bytes', 'sha256']} != ident(REPO / TARGET):
    raise ValueError('Existing original installation does not declare exact target')

old_href = 'results/group-edit-followup/source-proof/preservation-manifest.json'
new_href = 'results/group-edit-followup/plan/source-proof/preservation-manifest.json.snapshot'
doc = once(text(REPO / DOC), '](' + old_href + ')', '](' + new_href + ')')
write(CAND / DOC, doc)
before_image = PREFIX + 'before/products/rea-studio/apps/vault/GROUP-EDIT.md.snapshot'
old_migration = PREFIX + 'verifier-before/editor-vault-proof-migration.mjs.snapshot'
for name, source in [(before_image, DOC), (old_migration, MIGRATION)]:
    target = CAND / name
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes((REPO / source).read_bytes())

declaration = {
    'schema': 'rea-vault-group-edit-document-link-transition/v1',
    'status': 'source-authored-unexecuted-document-link-correction',
    'sourceOnly': True,
    'target': DOC,
    'before': ident(REPO / DOC),
    'after': ident(CAND / DOC),
    'beforeImage': {'path': before_image, **ident(CAND / before_image)},
    'oldMigration': {'path': old_migration, **ident(CAND / old_migration)},
    'records': [{'path': before_image, **ident(CAND / before_image)}, {'path': old_migration, **ident(CAND / old_migration)}],
    'href': {'before': old_href, 'after': new_href},
    'existingDeliveredTarget': {'path': TARGET, **ident(REPO / TARGET)},
    'existingTargetDeclaredBy': {'path': OWNER, **ident(REPO / OWNER), 'record': declared[0]},
    'rootSourceUnchanged': {'path': ROOT, **ident(REPO / ROOT)},
