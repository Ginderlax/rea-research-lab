      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.3401095dfbd6228d93a4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Simplifies editing the evaluation interval for an alert rule within a new group. You no longer have to save the alert rule and group before editing the evaluation interval.",
      "headingPath": [
        "What's new in Grafana v9.4",
        "Alerting",
        "Alerting: alert rules",
        "Edit alert rule evaluation interval"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v9-4.md",
