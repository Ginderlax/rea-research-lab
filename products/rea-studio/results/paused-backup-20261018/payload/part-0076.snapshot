    {
      "id": "grafana.candidate.88c5bb739de47efcd2c9",
      "syntaxRole": "list-item",
      "sourceText": "- **Set realistic evaluation intervals:** Choose an evaluation interval that gives your query enough time to complete. If your query takes 10 seconds, don't evaluate every 10 seconds—allow for headroom.",
      "headingPath": [
        "PostgreSQL alerting",
        "Best practices"
      ],
      "source": {
