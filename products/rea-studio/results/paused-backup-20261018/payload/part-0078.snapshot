    },
    {
      "id": "grafana.candidate.82660c2200bf6f291738",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "`tns_request_duration_seconds_count` is a _counter_, a type of metric whose value only ever increases. Rather than visualizing the actual value, you can use counters to calculate the _rate of change_, i.e. how fast the value increases.",
      "headingPath": [
        "Introduction",
        "Explore your metrics"
      ],
