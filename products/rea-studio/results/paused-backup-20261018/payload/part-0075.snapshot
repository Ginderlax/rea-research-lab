        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/guides/alerting-on-forecasts.md#L122-L122"
      },
      "applicability": {
        "status": "excluded-by-paid-or-hosted-section-heading",
        "products": [
