import fs from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import assert from 'node:assert/strict';
import {execFileSync} from 'node:child_process';
const info=JSON.parse(await fs.readFile(new URL('browser-host.json',import.meta.url)));
assert.equal(info.ownedSyntheticOnly,true);assert.equal(info.sourceStage,'work/keepass-recycle-next');assert.ok(Number.isSafeInteger(info.pid));
const command=execFileSync('powershell.exe',['-NoProfile','-Command',`(Get-CimInstance Win32_Process -Filter 'ProcessId = ${info.pid}').CommandLine`],{encoding:'utf8',timeout:10000}).trim();
assert.ok(command.includes('work/keepass-recycle-independent-review/preview-host.mjs'),command);
const target=path.resolve(info.dataDir);assert.equal(path.dirname(target),path.resolve(os.tmpdir()));assert.ok(path.basename(target).startsWith('rea-recycle-browser-review-'));
process.kill(info.pid);await new Promise(resolve=>setTimeout(resolve,200));
await fs.rm(target,{recursive:true,force:true});
const observation={at:new Date().toISOString(),stoppedPid:info.pid,verifiedCommand:command,fixtureRemoved:!(await fs.stat(target).then(()=>true,()=>false)),reason:'Non-TTY host stdin was closed; verified owned PID and confined synthetic temporary fixture before cleanup.'};
await fs.writeFile(new URL('browser-cleanup.json',import.meta.url),JSON.stringify(observation,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(observation));
