    {
      "id": "grafana.candidate.27b84676a45281397271",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "How many data points is your query returning? A query that returns lots of data points will be slow. Try this:",
      "headingPath": [
        "Troubleshoot queries",
        "My query is slow"
      ],
