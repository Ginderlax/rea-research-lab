    },
    {
      "id": "grafana.candidate.4b6f182b5ac0dfaaf210",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Query variables query the Pyroscope data source to populate drop-down values. When you create a query variable, select a Pyroscope data source and choose a query type.",
      "headingPath": [
        "Pyroscope template variables",
        "Query variable types"
      ],
      "source": {
        "path": "docs/sources/datasources/pyroscope/template-variables/index.md",
        "gitBlobSha": "caf634b1a820210b00d4bdb88707f26b3153956d",
