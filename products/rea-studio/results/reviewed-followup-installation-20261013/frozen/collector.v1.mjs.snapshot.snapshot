import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';
import assert from 'node:assert/strict';
const base=path.resolve(import.meta.dirname,'..'), lab=path.join(base,'outputs/rea-research-lab'), studio=path.join(lab,'products/rea-studio');
const run=path.join(base,'work/notes-vault-production-installation');
fs.mkdirSync(run,{recursive:true});
const sha=b=>crypto.createHash('sha256').update(b).digest('hex');
const read=p=>JSON.parse(fs.readFileSync(p));
const identity=p=>{const b=fs.readFileSync(p);return {bytes:b.length,sha256:sha(b)};};
function exact(p,r){assert.deepEqual(identity(p),{bytes:r.bytes,sha256:r.sha256},p);return fs.readFileSync(p);}
function safe(root,relative){assert.equal(path.isAbsolute(relative),false);const p=path.resolve(root,relative);assert.ok(p.startsWith(root+path.sep),relative);return p;}
function writeExact(p,b){if(fs.existsSync(p)){assert.deepEqual(fs.readFileSync(p),b,p);return 'reuse';}fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,b,{flag:'wx'});return 'add';}
const sources=[], copies=[], installed=[];
function remember(p,r){exact(p,r);sources.push({absolute:p,...r});}
function rows(m){return m.records??m.files??m.entries??m.inventory;}
function manifest(root,name,expected){const p=safe(root,name);assert.equal(identity(p).sha256,expected,p);const m=read(p), rr=rows(m);assert.ok(Array.isArray(rr));for(const r of rr)remember(safe(root,r.path),r);remember(p,identity(p));return m;}
function publicBytes(b,p){assert.ok(p.endsWith('.snapshot'));assert.ok(!/(^|\/)(?:\.local|node_modules|\.git)(\/|$)/.test(p));const h=b.subarray(0,8).toString('hex');assert.ok(!h.startsWith('4d5a')&&!h.startsWith('504b0304')&&!h.startsWith('03d9a29a67fb4bb5')&&!h.startsWith('7f454c46')&&!h.startsWith('1f8b'));assert.notEqual(b.subarray(257,262).toString(),'ustar');}
function publish(root,r,repoPath){const b=exact(safe(root,r.path??r.sourcePath),r);publicBytes(b,repoPath);const action=writeExact(safe(lab,repoPath),b);copies.push({sourceRoot:path.relative(base,root).replaceAll('\\','/'),sourcePath:r.path??r.sourcePath,path:repoPath,...identity(safe(lab,repoPath)),action});}
function planCopy(folder,name,hash,prefix){const root=safe(base,'work/'+folder),m=manifest(root,name,hash);const rr=[...rows(m),{path:name,...identity(safe(root,name))},{path:'freeze.json',...identity(safe(root,'freeze.json'))}];for(const r of rr)publish(root,r,`products/rea-studio/${prefix}/${r.path}.snapshot`);return root;}
const historical=read(path.join(studio,'results/milestones/packs-notebooks-history-455ab6c-20261012/snapshot-manifest.json'));
const old=new Map([...historical.sourceSnapshots,...historical.metadataSnapshots].map(r=>[r.sourcePath,r]));
function oldIdentity(dest){if(!fs.existsSync(safe(lab,dest)))return null;const r=old.get(dest);assert.ok(r,'Missing preserved455 baseline '+dest);exact(safe(lab,r.snapshotPath),r);exact(safe(lab,dest),r);return {bytes:r.bytes,sha256:r.sha256};}
function install(p,r,dest,meta){const b=exact(p,r),before=oldIdentity(dest);fs.mkdirSync(path.dirname(safe(lab,dest)),{recursive:true});fs.writeFileSync(safe(lab,dest),b);exact(safe(lab,dest),r);installed.push({destination:dest,before,after:r,...meta});}
try{
 const notes=planCopy('notes-trash-publication-plan-final','manifest.json','e7cad54fc3fae5a3b67c9ad35f15ea9d920a1b158c92c9cec6bc4f5369535c49','apps/notes/results/notebook-trash-followup/publication-plan');
 const initial=safe(base,'work/notes-trash-publication-plan');const initialManifest=read(path.join(initial,'manifest.json'));assert.equal(rows(initialManifest).length,25);
 planCopy('notes-trash-publication-plan','manifest.json',identity(path.join(initial,'manifest.json')).sha256,'apps/notes/results/notebook-trash-followup/prior-publication-plan');
 const refs=read(path.join(notes,'references.json')).references;
 for(const ref of refs){const root=safe(base,'work/'+ref.folder);const m=manifest(root,ref.manifest,ref.manifestSha256);assert.equal(rows(m).length,ref.count);assert.equal(identity(safe(root,ref.receipt)).sha256,ref.receiptSha256);}
 const notesMap=read(path.join(notes,'public-preservation-map.json'));assert.equal(notesMap.records.length,920);
 for(const r of notesMap.records)publish(safe(base,r.sourceRoot),r,'products/rea-studio/'+r.destination);
 const notesExcluded=read(path.join(notes,'local-exclusions.json')).excluded;assert.equal(notesExcluded.length,15);
 for(const r of notesExcluded){const ref=refs.find(v=>v.id===r.reference);exact(safe(safe(base,'work/'+ref.folder),r.sourcePath),r);}
 const binding=read(path.join(notes,'registry-identity-binding.json'));for(const r of binding.registries)exact(safe(studio,r.path),r);
 const vault=planCopy('vault-recycle-publication-plan','manifest.json','afab12d14c078695c15b50de94c892f63c616d2cea77e941392384a91e18c1fe','apps/vault/results/recycle-followup/publication-plan');
 const vaultMap=read(path.join(vault,'selected-file-map.final.json'));
 for(const e of vaultMap.epochs){const root=safe(base,e.folder);const m=manifest(root,e.manifestName,e.manifestSha);assert.equal(rows(m).length,e.count);for(const [name,r] of [[e.receiptName,e.receipt],[e.freezeName,e.freeze]])remember(safe(root,name),r);}
 const vaultBaseline=read(path.join(vault,'production-reference-baseline.json'));for(const r of [...vaultBaseline.sourceFiles,...vaultBaseline.selectedCurrentHistory])exact(safe(lab,r.path),r);
 assert.equal(vaultMap.payload.length,858);for(const r of vaultMap.payload){const root=safe(base,r.sourceRoot);remember(safe(root,r.sourcePath),r);if(r.publication==='public-source')publish(root,r,r.publicPath);else{assert.equal(r.publication,'local-only');assert.equal(r.sha256,'c79b1d0ea208df44fa0f137eb0ea9c5d0239212a58474834d11d63ea0d7f4d77');}}
 assert.equal(new Set(vaultMap.payload.filter(r=>r.publication==='public-source').map(r=>r.publicPath)).size,471);
 // Authenticate every installation source and proposal before modifying live runtime.
 const noteInst=read(path.join(notes,'live-copy-list.json')).proposals;
 for(const r of noteInst){exact(safe(base,r.source),{bytes:r.sourceBytes,sha256:r.sourceSha256});exact(safe(notes,r.proposalPath),{bytes:r.proposedBytes,sha256:r.proposedSha256});oldIdentity('products/rea-studio/'+r.destination);}
 const vaultInst=vaultMap.install.map(r=>({...r,sourceIdentity:r.sourceIdentity??{bytes:r.bytes,sha256:r.sha256},proposal:r.proposedBytesPath?safe(vault,r.proposedBytesPath):safe(base,r.source),outputIdentity:r.proposedIdentity??{bytes:r.bytes,sha256:r.sha256}}));
 for(const r of vaultInst){exact(safe(base,r.source),r.sourceIdentity);exact(r.proposal,r.outputIdentity);if(r.existing)exact(safe(lab,r.destination),r.existing);else assert.equal(fs.existsSync(safe(lab,r.destination)),false);}
 const vaultDocs=read(path.join(vault,'documentation-map.json')).docs;for(const r of vaultDocs){exact(safe(vault,r.source),r);oldIdentity(r.destination);}
 for(const r of noteInst)install(safe(notes,r.proposalPath),{bytes:r.proposedBytes,sha256:r.proposedSha256},'products/rea-studio/'+r.destination,{study:'notes',source:r.source,sourceIdentity:{bytes:r.sourceBytes,sha256:r.sourceSha256},changes:r.changes,byteIdentical:r.byteIdentical});
 for(const r of vaultInst){if(r.action==='retain-exact'){exact(safe(lab,r.destination),r.outputIdentity);installed.push({destination:r.destination,before:r.existing,after:r.outputIdentity,study:'vault',action:r.action});}else install(r.proposal,r.outputIdentity,r.destination,{study:'vault',source:r.source,sourceIdentity:r.sourceIdentity,transform:r.transform,outputTransform:r.outputTransform??null,action:r.action});}
 for(const r of vaultDocs)install(safe(vault,r.source),{bytes:r.bytes,sha256:r.sha256},r.destination,{study:'vault',source:r.source,documentation:true});
 for(const r of sources)exact(r.absolute,r);
 const receipt={schema:'rea-notes-vault-reviewed-followup-production-installation/v1',at:new Date().toISOString(),notesPlan:{manifestSha256:'e7cad54fc3fae5a3b67c9ad35f15ea9d920a1b158c92c9cec6bc4f5369535c49',frozenArtifacts:26,publicSnapshots:920,excludedNativeCopies:15},vaultPlan:{manifestSha256:'afab12d14c078695c15b50de94c892f63c616d2cea77e941392384a91e18c1fe',frozenArtifacts:45,pathRecords:858,publishablePathRecords:857,uniqueByteObjects:471,excludedNativeCopies:1},sourcesAuthenticatedBeforeAfter:sources.length,allSourceBytesStableBeforeAfter:true,copies,installed,behaviorTestsRun:0,originalExecutions:0,browserWorkflows:0,prospectiveFocusedTests:{notes:59,vault:79},fullProductParity:false,universalSuperiority:false};
 fs.writeFileSync(path.join(run,'installation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
 fs.copyFileSync(import.meta.filename,path.join(run,'collector.mjs.snapshot'));
 for(const app of ['notes','vault']){const dest=path.join(studio,`apps/${app}/results/${app==='notes'?'notebook-trash-followup':'recycle-followup'}/production-installation`);fs.mkdirSync(dest,{recursive:true});for(const name of ['installation.json','collector.mjs.snapshot'])writeExact(path.join(dest,name+'.snapshot'),fs.readFileSync(path.join(run,name)));}
 console.log(JSON.stringify({pass:true,installed:installed.length,publicPathRecords:copies.length,uniquePublicPaths:new Set(copies.map(r=>r.path)).size,originalExecutions:0,tests:0}));
}catch(error){fs.writeFileSync(path.join(run,'failure-'+Date.now()+'.json'),JSON.stringify({at:new Date().toISOString(),error:String(error),stack:error.stack,installed,copies},null,2)+'\n');throw error;}
