    {
      "id": "grafana.candidate.f28bd42d0e6d022a89c1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now use generative AI to assist you in your Grafana dashboards. So far generative AI can help you generate **panel and dashboard titles and descriptions** - You can now generate a title and description for your panel or dashboard based on the data you've added to it. This is useful when you want to quickly visualize your data and don't want to spend time coming up with a title or description.",
      "headingPath": [
        "What’s new in Grafana v11.0",
        "Dashboards and visualizations",
        "Use AI to generate titles and descriptions for panels and dashboards"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-0.md",
        "gitBlobSha": "718032fb1fcee4d964da6aa4e9da332a64bf509a",
        "sha256": "4ac4a4d84503349934037643cc351a7722532a4c4189aab283838810ba2f6731",
        "lineStart": 164,
        "lineEnd": 164,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-0.md#L164-L164"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.1623f245cf3ebc2f9c4f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Make sure to enable and configure Grafana's LLM app plugin. For more information, refer to the [Grafana LLM app plugin documentation](https://grafana.com/docs/grafana-cloud/alerting-and-irm/machine-learning/llm-plugin/).",
      "headingPath": [
        "What’s new in Grafana v11.0",
        "Dashboards and visualizations",
        "Use AI to generate titles and descriptions for panels and dashboards"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-0.md",
        "gitBlobSha": "718032fb1fcee4d964da6aa4e9da332a64bf509a",
        "sha256": "4ac4a4d84503349934037643cc351a7722532a4c4189aab283838810ba2f6731",
        "lineStart": 166,
        "lineEnd": 166,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-0.md#L166-L166"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.fefc69b056e979f64eb5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When enabled, look for the **✨ Auto generate** option next to the **Title** and **Description** fields in your panels and dashboards, or when you press the **Save** button.",
      "headingPath": [
        "What’s new in Grafana v11.0",
        "Dashboards and visualizations",
        "Use AI to generate titles and descriptions for panels and dashboards"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-0.md",
