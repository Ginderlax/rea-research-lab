import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
const work=import.meta.dirname,lab=path.join(work,'../outputs/rea-research-lab'),stage=path.join(work,'editor-search-path-fix-next'),review=path.join(work,'editor-search-path-independent-review'),recordRoot=path.join(work,'editor-search-production-installation'),sha=b=>createHash('sha256').update(b).digest('hex');await fs.mkdir(recordRoot,{recursive:true});
const manifestBytes=await fs.readFile(path.join(stage,'freeze-manifest.json'));assert.equal(sha(manifestBytes),'d071d370be094646a4738de79adadca9c28d794de53dfb940604f5d52d056edf');const manifest=JSON.parse(manifestBytes);for(const[n,r]of Object.entries(manifest.inventory)){const b=await fs.readFile(path.join(stage,n));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);}
const rb=await fs.readFile(path.join(review,'review-validation.json'));assert.equal(sha(rb),'424c2973b77c6c9c8cb4a578f0a73dea2da92f55bc6322c78be17fe38f487553');const reviewed=JSON.parse(rb);assert.equal(reviewed.status,'passed finite independent review');assert.equal(reviewed.tests.pass,18);assert.equal(reviewed.tests.fail,0);
const baseline=JSON.parse(await fs.readFile(path.join(stage,'baseline.json'),'utf8'));for(const row of baseline.files){const b=await fs.readFile(path.join(lab,row.path));assert.equal(sha(b),row.sha256,'Editor baseline changed:'+row.path);}
const copies=[];for(const[n,r]of Object.entries(manifest.inventory).filter(([n])=>n.startsWith('products/rea-studio/apps/editor/'))){const b=await fs.readFile(path.join(stage,n));let old;try{old=await fs.readFile(path.join(lab,n));}catch(e){assert.equal(e.code,'ENOENT');}if(old?.equals(b))continue;await fs.mkdir(path.dirname(path.join(lab,n)),{recursive:true});await fs.writeFile(path.join(lab,n),b);copies.push({path:n,sourcePath:n,beforeSHA256:old?sha(old):null,bytes:b.length,sha256:sha(b),exact:true});}
let searchDoc=await fs.readFile(path.join(stage,'SEARCH.md'),'utf8');searchDoc+='\nThe installed path correction shares the existing1024 UTF-16-unit read/save limit with search. Longer files or directories are skipped before recording or descending, with an explicit `editor-path-contract` incomplete-coverage notice. Independent tests reproduced the earlier1096-unit failure, verified1024/1025 and astral boundaries, exercised delayed query/navigation/draft/revision cases and replayed twelve prepared original-engine query groups covering267 positions. Those twelve groups reused the earlier prepared seed after correcting the reviewer’s BOM offset mapper; they are not a newly selected held-out corpus. No original workbench GUI was run. See [the preserved search study](../../results/editor-workspace-search-followup/README.md) for exact epochs and negative results.\n';const docPath='products/rea-studio/apps/editor/SEARCH.md';await fs.writeFile(path.join(lab,docPath),searchDoc,{flag:'wx'});copies.push({path:docPath,sourcePath:'SEARCH.md',bytes:Buffer.byteLength(searchDoc),sha256:sha(Buffer.from(searchDoc)),exact:false,adaptation:'App-local documentation with reviewed path limits and preserved evidence links; no runtime change.'});
const regressionCopies=[];for(const[sourceName,targetName]of Object.entries({'held-current.test.mjs':'workspace-search-review-held.test.mjs','path-boundaries.test.mjs':'workspace-search-review-path.test.mjs','fresh-ui.test.mjs':'workspace-search-review-ui.test.mjs'})){
 const original=await fs.readFile(path.join(review,sourceName),'utf8');let adapted=original.replaceAll('../editor-search-path-fix-next/products/rea-studio/apps/editor/','./').replaceAll('../editor-search-path-fix-next/products/rea-studio/lib/','../../lib/');assert.ok(adapted!==original);assert.equal(adapted.split("path.join(import.meta.dirname,'runs',").length,2);adapted=adapted.replace("path.join(import.meta.dirname,'runs',","path.join(REVIEW_TEST_ROOT,");
 const prefix="import os from 'node:os';import {after} from 'node:test';\nconst REVIEW_TEST_ROOT=await fs.mkdtemp(path.join(os.tmpdir(),'rea-editor-search-review-'));after(async()=>{assert.equal(path.dirname(REVIEW_TEST_ROOT),path.resolve(os.tmpdir()));assert.ok(path.basename(REVIEW_TEST_ROOT).startsWith('rea-editor-search-review-'));await fs.rm(REVIEW_TEST_ROOT,{recursive:true,force:true});});\n";adapted=prefix+adapted;
 const inverse=adapted.slice(prefix.length).replaceAll("path.join(REVIEW_TEST_ROOT,","path.join(import.meta.dirname,'runs',").replaceAll("from './","from '../editor-search-path-fix-next/products/rea-studio/apps/editor/").replaceAll("from '../../lib/","from '../editor-search-path-fix-next/products/rea-studio/lib/");assert.equal(inverse,original,'Adapted reviewer body changed:'+sourceName);
 const n='products/rea-studio/apps/editor/'+targetName,b=Buffer.from(adapted);await fs.writeFile(path.join(lab,n),b,{flag:'wx'});const row={path:n,sourcePath:sourceName,sourceSHA256:sha(Buffer.from(original)),bytes:b.length,sha256:sha(b),adaptations:['Import paths','Owned temporary fixture root','One verified temporary-root cleanup hook'],testBodiesUnchanged:true};copies.push(row);regressionCopies.push(row);
}
const receipt={schema:'rea-editor-workspace-search-production-installation/v1',installedAtUtc:new Date().toISOString(),acceptedCandidateManifestSHA256:sha(manifestBytes),independentReviewSHA256:sha(rb),focusedStageTests:42,independentTests:18,newBehaviorRunsDuringCopy:0,copies,regressionCopies,previousPublishedCheckpoint:'455ab6c46461981e6e4331ba5612d5362bf4ad22',fullProductParity:false,universalSuperiority:false};await fs.writeFile(path.join(recordRoot,'installation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});await fs.writeFile(path.join(recordRoot,'collector.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});console.log(JSON.stringify({status:'INSTALLED_FOR_COMBINED_VALIDATION',copied:copies.length,adaptedReviewerTests:3,runtimeFromAcceptedFrozenStage:true}));
