      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.56b7b6dd742ba9876a16",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Select the **No Data Points** scenario. The backend returns an empty result, which triggers the alert rule's **no data** state. Use this to verify that your rule is configured to alert, keep the last state, or resolve when no data is received. Configure this behavior in the alert rule's **No data and error handling** section.",
      "headingPath": [
        "TestData alerting",
        "Test error and no-data conditions",
        "No data"
      ],
      "source": {
        "path": "docs/sources/datasources/testdata/alerting/index.md",
        "gitBlobSha": "526f2432d34ad25382f4112893fa3beb53ea371c",
