    {
      "id": "grafana.candidate.93378e1708b4652cba65",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The following is a partial example for using Vault to set up a Grafana configuration file's email and database credentials. Refer to [Configuration](../../../configure-grafana/) for more information.",
      "headingPath": [
        "Integrate Grafana with Hashicorp Vault",
        "Using the Vault expander",
        "Examples",
        "Configuration"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-database-encryption/integrate-with-hashicorp-vault/index.md",
