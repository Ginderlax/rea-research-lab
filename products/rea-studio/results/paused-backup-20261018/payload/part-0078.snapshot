    {
      "id": "grafana.candidate.6d0b2d2eb1c8063aa406",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Symbolic links, also known as symlinks, enable you to create pointers to existing LetsEncrypt files in the `/etc/grafana` directory. By using symlinks rather than copying files, you can use `certbot` to refresh or request updated certificates from LetsEncrypt without the need to reconfigure the Grafana settings.",
      "headingPath": [
        "Set up Grafana HTTPS for secure web traffic",
        "Obtain a certificate and key",
        "Obtain a signed certificate from LetsEncrypt",
        "Set up symlinks to Grafana"
