    {
      "id": "grafana.candidate.4899d077b83e4b2a9411",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Geomap now supports tooltips with data-links across multiple layers.",
      "headingPath": [
        "What's new in Grafana v8.4",
        "OSS",
        "New panel options",
        "Geomap"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-4.md",
        "gitBlobSha": "252f5beb8e3fcec627862bf9d7133a82ac790f48",
        "sha256": "698f50f998678faa1ffd85c3becf29427f209d103b67f78883e8ff9c47004eec",
        "lineStart": 105,
        "lineEnd": 105,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v8-4.md#L105-L105"
      },
      "applicability": {
