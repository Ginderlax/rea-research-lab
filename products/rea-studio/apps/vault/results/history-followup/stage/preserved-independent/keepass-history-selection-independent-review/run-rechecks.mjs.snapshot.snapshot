import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import {spawn} from 'node:child_process';
const own=path.dirname(fileURLToPath(import.meta.url)),stage=path.resolve(own,'../keepass-history-selection-fix-next'),sha=b=>createHash('sha256').update(b).digest('hex'),names=['history.mjs','server.mjs','client.mjs','kdbx.mjs','xml.mjs'];async function fingerprint(){return Promise.all(names.map(async name=>({path:name,sha256:sha(await fs.readFile(path.join(stage,name)))})));}
const before=await fingerprint(),output=path.join(own,'runs/rechecks');await fs.mkdir(output,{recursive:true});const child=spawn(process.execPath,['--test','--test-concurrency=1',path.join(own,'restore-selection.test.mjs'),path.join(own,'selection-boundaries.test.mjs')],{cwd:own,windowsHide:true,stdio:['ignore','pipe','pipe']});let stdout='',stderr='';child.stdout.on('data',part=>stdout+=part);child.stderr.on('data',part=>stderr+=part);const timer=setTimeout(()=>child.kill(),20000);const exitCode=await new Promise((resolve,reject)=>{child.once('error',reject);child.once('close',resolve);});clearTimeout(timer);await fs.writeFile(path.join(output,'stdout.txt'),stdout);await fs.writeFile(path.join(output,'stderr.txt'),stderr);const after=await fingerprint(),counts=Object.fromEntries(['tests','pass','fail','skipped','cancelled'].map(name=>[name,Number(new RegExp(`(?:ℹ|#) ${name} (\\d+)`).exec(stdout)?.[1]??-1)]));const receipt={schema:'rea-independent-keepass-fixed-selection-run/v1',exitCode,counts,sourceStable:JSON.stringify(before)===JSON.stringify(after),sourceFingerprints:before,inputs:await Promise.all(['restore-selection.test.mjs','selection-boundaries.test.mjs','ui-fixture.mjs','run-rechecks.mjs'].map(async name=>({path:name,sha256:sha(await fs.readFile(path.join(own,name)))}))),scope:'Seven previously preserved independent safety assertions/control cases; test bodies unchanged.'};await fs.writeFile(path.join(output,'validation.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify(receipt));if(exitCode||!receipt.sourceStable)process.exitCode=1;
