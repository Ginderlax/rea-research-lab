    {
      "id": "grafana.candidate.157c31a5624ec5fc0738",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "View the details of the query that is used for the alert rule, including the expressions and intermediate values for each step of the expression pipeline. A graph view is included for range queries and data sources that return time series-like data frames.",
      "headingPath": [
