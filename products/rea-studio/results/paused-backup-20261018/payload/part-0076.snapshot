    },
    {
      "id": "grafana.candidate.a194c22099bd5d6bb9e6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This document provides instructions for configuring the Prometheus data source and explains the available configuration options. The Prometheus data source is preinstalled in Grafana, so you don't need to install it manually. For general information on adding a data source to Grafana, refer to [Add a data source](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/#add-a-data-source).",
      "headingPath": [
        "Configure the Prometheus data source"
      ],
      "source": {
