    {
      "id": "grafana.candidate.9f8c9962af5fe88e4288",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "LBAC for data sources is generally available on Grafana Cloud for Prometheus data sources created with basic authentication. You create a new data source as described in [LBAC Configuration for new Prometheus data source](#task-1-lbac-configuration-for-new-prometheus-data-source). Provisioning is currently not available.",
      "headingPath": [
        "Configure LBAC for data sources for Prometheus data source",
        "Grafana Cloud"
