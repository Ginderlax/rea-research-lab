    {
      "id": "grafana.candidate.21c1c689e70901c17aec",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana Assistant on-premise keeps the Assistant experience inside your Grafana deployment. After setup, you can use Assistant to work with metrics, logs, traces, profiles, and databases, create and update dashboards, generate queries, and navigate Grafana resources from natural language prompts. However, it doesn’t include every Grafana Cloud feature. Refer to [Available Assistant features for Grafana on-prem](#available-assistant-features-for-grafana-on-prem) for details on the supported services.",
      "headingPath": [
        "Grafana Assistant"
      ],
