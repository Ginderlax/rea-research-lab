    {
      "id": "grafana.candidate.27c9f5a6d09acc4e9d30",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For example, entering `us-central[1-3]-[af]` matches all values that start with \"us-central\", then are followed by a number in the range of 1 to 3, a dash, and then either an \"a\" or an \"f\".",
      "headingPath": [
        "Google Cloud Monitoring query editor",
        "Query metrics",
        "Apply a filter",
        "Use regular expressions"
      ],
      "source": {
