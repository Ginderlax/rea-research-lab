    {
      "id": "grafana.candidate.8b616decf76ef7cb53b6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "SQL Expressions are server-side expressions that manipulate and transform the results of data source queries using MySQL-like syntax. They allow you to easily query and transform your data after the data source returns it, using SQL, which provides a familiar and powerful syntax that can handle everything from simple filters to highly complex, multi-step transformations.",
      "headingPath": [
        "SQL expressions"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/sql-expressions/index.md",
