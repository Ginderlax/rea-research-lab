    },
    {
      "id": "grafana.candidate.82144135f26a706bcc24",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The full Redis URL of your Redis server. For example: `redis://username:password@localhost:6379`. To enable TLS, use the `rediss` scheme.",
      "headingPath": [
        "Configure Grafana Enterprise",
        "[caching.redis]",
        "url"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md",
