    {
      "id": "grafana.candidate.68313fb82021e017be09",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana encrypts secrets using Advanced Encryption Standard in Cipher FeedBack mode (AES-CFB). You might prefer to use AES in Galois/Counter Mode (AES-GCM) instead, to meet your company’s security requirements or in order to maintain consistency with other services.",
      "headingPath": [
        "Configure database encryption",
        "Changing your encryption mode to AES-GCM"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-database-encryption/_index.md",
        "gitBlobSha": "936ab7c1d208cbcd86c66db25b399c78675a122b",
