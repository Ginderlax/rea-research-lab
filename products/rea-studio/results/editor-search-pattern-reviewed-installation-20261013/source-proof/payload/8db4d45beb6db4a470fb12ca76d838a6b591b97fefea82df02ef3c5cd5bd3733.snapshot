import test from'node:test';import assert from'node:assert/strict';import{mkdtemp,writeFile,rm,mkdir}from'node:fs/promises';import os from'node:os';import path from'node:path';
import{pathToFileURL}from'node:url';
import{createPatternSession,disposePatternSearches,patternWorkerState,PATTERN_LIMITS}from'../editor-search-pattern-next/candidate/products/rea-studio/apps/editor/search-pattern-session.mjs';
import{searchWorkspace}from'../editor-search-pattern-next/candidate/products/rea-studio/apps/editor/workspace-search.mjs';
import{createWorkspace}from'../editor-search-pattern-next/candidate/products/rea-studio/lib/storage.mjs';
import{sourcePattern,unicodePattern,scanPatternFile}from'../editor-search-pattern-next/candidate/products/rea-studio/apps/editor/search-pattern.mjs';
import{mount,button,named,all,click,type,toggle,uiObservations}from'./ui-fixture.mjs';

const options=query=>({query,matchCase:true,wholeWord:false,useRegex:true}),observations=[];
async function owned(t,files){const root=await mkdtemp(path.join(os.tmpdir(),'rea-pattern-independent-'));const ws=await createWorkspace(root);for(const [p,v]of Object.entries(files)){const at=await ws.resolve(p);await mkdir(path.dirname(at),{recursive:true});await writeFile(at,v);}t.after(async()=>{await disposePatternSearches(ws);const absolute=path.resolve(root),tmp=path.resolve(os.tmpdir());assert(absolute.startsWith(tmp+path.sep)&&path.basename(absolute).startsWith('rea-pattern-independent-'));await rm(absolute,{recursive:true,force:true});});return ws;}
async function session(t,query,ms=5000){const key={ownedReview:Symbol('workspace')},s=await createPatternSession(key,options(query),performance.now()+ms);t.after(async()=>{await s.close();assert.equal(patternWorkerState().active,0);});return{s,key};}
test('fresh admission: four ready workers reserve slots until awaited exit and fifth is refused',async t=>{const key={},sessions=[];t.after(async()=>{await disposePatternSearches(key);assert.equal(patternWorkerState().active,0);});for(let i=0;i<4;i++)sessions.push(await createPatternSession(key,options('x'),performance.now()+5000));assert.equal(patternWorkerState().active,4);await assert.rejects(createPatternSession({},options('y'),performance.now()+5000),e=>e.code==='busy');const closing=sessions[0].close();assert.equal(patternWorkerState().active,4);await closing;assert.equal(patternWorkerState().active,3);await Promise.all(sessions.slice(1).map(s=>s.close()));assert.equal(patternWorkerState().active,0);});
test('fresh pending admission/dispose: rejected match is closed without reusable active ownership',async t=>{const{s,key}=await session(t,'(x+)+y');const pending=s.match('x'.repeat(80000),10);await assert.rejects(s.match('x',1),e=>e.code==='busy');const disposed=disposePatternSearches(key);await assert.rejects(pending,e=>e.code==='disposed');await disposed;assert.equal(patternWorkerState().active,0);await assert.rejects(s.match('x',1),e=>e.code==='disposed');await disposePatternSearches(key);});
test('fresh deadline: catastrophic worker leaves main loop responsive and termination is awaitable',async t=>{const{s}=await session(t,'(x+)+y',1000);const matching=s.match('x'.repeat(90000),2);await new Promise(resolve=>setImmediate(resolve));assert.equal(patternWorkerState().active,1);await assert.rejects(matching,e=>e.code==='timeout');await s.close();assert.equal(patternWorkerState().active,0);});
test('fresh per-request and output guards reject before returning oversized spans',async t=>{const{s}=await session(t,'.');await assert.rejects(s.match('x',1002),e=>e.code==='failed');await assert.rejects(s.match('\ud800'.repeat(1001),1001),e=>e.code==='failed');const ready=await s.match('Z',1);assert.equal(ready.length,1);assert.equal(ready[0].start,0);});
test('fresh malformed or unsupported regex rejects before any workspace filesystem call',async()=>{let resolved=0;const ws={resolve(){resolved++;throw Error('filesystem must not be touched');}};for(const query of ['[','(?<bad-name>x)','[\\W]'])await assert.rejects(searchWorkspace(ws,{query,useRegex:true}),/Invalid or unsupported/);assert.equal(resolved,0);assert.equal(patternWorkerState().active,0);});
test('fresh scalar advancement: adjacent empty and nonempty matches never enter astral pairs',()=>{const text='😀A😀\r\n😀Z\n',pattern=new RegExp(unicodePattern(sourcePattern('A|(?=.)',{useRegex:true})),'gu'),rows=scanPatternFile(text,pattern,100);assert.deepEqual(rows.map(r=>[r.line,r.column,r.start,r.end]),[[1,1,0,0],[1,3,2,3],[1,4,3,3],[2,1,7,7],[2,3,9,9]]);for(const r of rows){assert(![1,4,8].includes(r.start));assert(r.preview.length<=400);}observations.push({name:'scalar',rows});});
test('fresh workspace literal defaults remain separate from whole-word regex and revisions identify bytes',async t=>{const bytes='cat scatter cat\r\n😀cat cat\n';const ws=await owned(t,{'a.txt':bytes});const literal=await searchWorkspace(ws,{query:'cat'}),whole=await searchWorkspace(ws,{query:'cat',wholeWord:true});assert.equal(literal.matches.length,5);assert.equal(whole.matches.length,4);assert.deepEqual(literal.matches.map(r=>[r.line,r.column,r.endColumn]),[[1,1,4],[1,6,9],[1,13,16],[2,3,6],[2,7,10]]);assert.equal(literal.matches[0].revision,whole.matches[0].revision);assert.equal(Object.hasOwn(literal,'patternLanguage'),false);assert.equal(patternWorkerState().active,0);});
test('fresh per-file and global match count limit preserves visible incomplete coverage',async t=>{const ws=await owned(t,{'a.txt':'q\n'.repeat(1200)});const result=await searchWorkspace(ws,{query:'q',useRegex:true});assert.equal(result.matches.length,1000);assert(result.truncated);assert(result.limitReasons.includes('match-limit'));assert.equal(result.matches.at(-1).line,1000);assert.equal(patternWorkerState().active,0);});
test('fresh Unicode escaped classes preserve bracket escapes and common word properties',async t=>{const ws=await owned(t,{'class.txt':'] é中 a\u0301 [ x\u200c 7\u0662\r\n'});const result=await searchWorkspace(ws,{query:'[\\w\\]]+',useRegex:true});assert.deepEqual(result.matches.map(r=>[r.column,r.endColumn]),[[1,2],[3,5],[6,8],[11,13],[14,16]]);assert.equal(result.truncated,false);observations.push({name:'escaped-Unicode-class',matches:result.matches});});
test('fresh absolute idle deadline frees the slot and retains timeout reason after expiry',async t=>{const{s}=await session(t,'x',250);await s.match('x',1);await new Promise(resolve=>setTimeout(resolve,350));await s.close();assert.equal(patternWorkerState().active,0);await assert.rejects(s.match('x',1),e=>e.code==='timeout');});
test('fresh controlled startup error executes exact session source with an owned throwing worker',async()=>{assert(process.env.REA_PATTERN_REVIEW_FAULTS);const module=await import(pathToFileURL(path.join(process.env.REA_PATTERN_REVIEW_FAULTS,'startup/search-pattern-session.mjs')).href);await assert.rejects(module.createPatternSession({},options('x'),performance.now()+1000),e=>e.code==='failed');assert.equal(module.patternWorkerState().active,0);});
test('fresh controlled pending exit releases exact session ownership and closes awaitably',async()=>{assert(process.env.REA_PATTERN_REVIEW_FAULTS);const module=await import(pathToFileURL(path.join(process.env.REA_PATTERN_REVIEW_FAULTS,'exit/search-pattern-session.mjs')).href),key={};const s=await module.createPatternSession(key,options('x'),performance.now()+1000);try{await assert.rejects(s.match('x',1),e=>e.code==='failed');await s.close();assert.equal(module.patternWorkerState().active,0);}finally{await module.disposePatternSearches(key);}});
test('fresh UI option change refuses a held search and a held navigation read',async()=>{const u=await mount();try{const query=named(u.root,'Find in saved files'),word=named(u.root,'Whole word in workspace search'),results=named(u.root,'Workspace search results');type(query,'old');const hold=u.hold('search'),pending=click(button(u.root,'Search saved files'));await hold.started.promise;toggle(word,true);hold.release.resolve();await pending;assert.equal(results.children.length,0);await click(button(u.root,'Search saved files'));const result=all(results).find(n=>n.tagName==='BUTTON');const held=u.hold('read','a.txt'),opening=click(result);await held.started.promise;toggle(named(u.root,'Regular expression in workspace search'),true);held.release.resolve();await opening;assert.equal(named(u.root,'File contents').value,'');assert.equal(named(u.root,'File contents').disabled,true);}finally{u.restore();}});
test('fresh UI Save response with changed search options retains enabled newer draft and byte revision',async()=>{const u=await mount();try{await click(button(u.root,'a.txt'));const editor=named(u.root,'File contents');type(editor,'written A');const held=u.hold('save','a.txt'),saving=click(button(u.root,'Save file'));await held.started.promise;type(editor,'newer A draft');toggle(named(u.root,'Whole word in workspace search'),true);held.release.resolve();await saving;assert.equal(editor.value,'newer A draft');assert.equal(u.saved.get('a.txt'),'written A');assert(all(u.root).some(n=>n.tagName==='BUTTON'&&n.textContent==='a.txt •'));await click(button(u.root,'Save file'));assert.equal(u.saved.get('a.txt'),'newer A draft');}finally{u.restore();}});
test('fresh UI view disposal drops held search publication without authorizing remote cancellation',async()=>{const u=await mount();try{type(named(u.root,'Find in saved files'),'old');const held=u.hold('search'),pending=click(button(u.root,'Search saved files'));await held.started.promise;const results=named(u.root,'Workspace search results');u.cleanup();u.host.replaceChildren();held.release.resolve();await pending;assert.equal(results.children.length,0);assert.deepEqual(u.calls.filter(c=>c.action==='search').map(c=>c.input),[{query:'old',matchCase:true,wholeWord:false,useRegex:false}]);}finally{u.restore();}});
test('fresh UI overlapping visible option changes preserve the last request snapshot and dirty tab',async()=>{const u=await mount();try{await click(button(u.root,'b.txt'));type(named(u.root,'File contents'),'B draft');type(named(u.root,'Find in saved files'),'old');toggle(named(u.root,'Regular expression in workspace search'),true);await click(button(u.root,'Search saved files'));const result=all(named(u.root,'Workspace search results')).find(n=>n.tagName==='BUTTON');await click(result);assert.equal(named(u.root,'File contents').value,'old A');const tab=all(u.root).find(n=>n.tagName==='BUTTON'&&n.textContent==='b.txt •');await click(tab);assert.equal(named(u.root,'File contents').value,'B draft');assert.equal(u.saved.get('b.txt'),'old B');}finally{u.restore();}});
test.after(async()=>{assert.equal(patternWorkerState().active,0);if(process.env.REA_PATTERN_REVIEW_OUTPUT){const fs=await import('node:fs/promises');await fs.writeFile(path.join(process.env.REA_PATTERN_REVIEW_OUTPUT,'fresh-observations.json'),JSON.stringify({observations,uiObservations,workerLimit:PATTERN_LIMITS.activeWorkers},null,2)+'\n',{flag:'wx'});}});
