    {
      "id": "grafana.candidate.6db98b721dea80904eee",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The new Grafana APIs track version history for resources. You can retrieve the history of any resource by using the standard List endpoint with specific query parameters. This page documents how to list resource history, using dashboards as an example. The same pattern applies to any resource.",
      "headingPath": [
        "Resource History HTTP API"
      ],
      "source": {
        "path": "docs/sources/developer-resources/api-reference/http-api/resource-history.md",
