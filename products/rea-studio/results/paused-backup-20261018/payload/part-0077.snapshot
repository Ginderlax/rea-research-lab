      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.dcedd503d551a878377f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Access policies and tokens use `access policy`, `token`, `scope`, `realm`, `labelselector` and `conditions` resources. For more information about these resources, refer to [Grafana Cloud Access Policies](https://grafana.com/docs/grafana-cloud/security-and-account-management/authentication-and-permissions/access-policies/).",
      "headingPath": [
        "Grafana Cloud API",
        "Access policies and tokens"
      ],
      "source": {
        "path": "docs/sources/developer-resources/api-reference/cloud-api/_index.md",
