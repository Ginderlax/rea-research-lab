    },
    {
      "id": "grafana.candidate.36523d285b6924cc0f71",
      "syntaxRole": "list-item",
      "sourceText": "- General components (tooltips, color pickers, modals, dropdowns, and so forth): we’ve ensured they’re keyboard navigable, improved focus trapping, and improved screen reader support.",
      "headingPath": [
        "What's new in Grafana v8.4",
        "OSS",
        "Ease of use",
        "Accessibility improvements"
      ],
      "source": {
