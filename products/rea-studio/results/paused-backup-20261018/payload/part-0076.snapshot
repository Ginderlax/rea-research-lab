    },
    {
      "id": "grafana.candidate.a64f0c9f9ec611f68892",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can add macros to your queries to simplify the syntax and enable dynamic elements, such as date range filters.",
      "headingPath": [
        "PostgreSQL query editor",
        "Macros"
      ],
      "source": {
        "path": "docs/sources/datasources/postgres/query-editor/_index.md",
