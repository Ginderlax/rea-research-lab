      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.af78130872fa8e4daa60",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Here are some of the benefits of create-plugin:",
      "headingPath": [
        "Breaking changes in Grafana v10.0",
        "For Plugin Developers",
        "grafana/toolkit CLI commands have been removed and migrated to the create-plugin package",
        "Description"
      ],
