    {
      "id": "grafana.candidate.cefe6bb84af776ed652f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This guide provides introductory examples and distinct approaches for setting up **trace-based alerts** in Grafana. Tracing data is commonly collected using **OpenTelemetry (OTel)** instrumentation. OTel allows you to integrate trace data from a wide range of applications and environments into Grafana.",
      "headingPath": [
        "Examples of trace-based alerts"
      ],
      "source": {
        "path": "docs/sources/alerting/examples/trace-based-alerts.md",
        "gitBlobSha": "cd408cc1ac4233936b4335774add7a545187fc22",
        "sha256": "7c271591aca8b13f2218029af9a904919669dd7ad0bf2978df084575f3f9c654",
        "lineStart": 38,
        "lineEnd": 38,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/examples/trace-based-alerts.md#L38-L38"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.280c88d33e6d03c641f9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "OpenTelemetry provides processors that convert tracing data into Prometheus-style metrics.",
      "headingPath": [
        "Examples of trace-based alerts",
        "Alerting on span metrics"
      ],
      "source": {
        "path": "docs/sources/alerting/examples/trace-based-alerts.md",
