import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const work=import.meta.dirname,folder=path.join(work,'flow-native-textarea-normalization-independent-review'),own=path.join(work,'root-flow-corrected-browser-review-next'),sha=b=>createHash('sha256').update(b).digest('hex'),b=await fs.readFile(path.join(folder,'manifest.json'));assert.equal(sha(b),'d96e755f491a5747ede7b612213ecaa12657c1f01dcfd7d55721e3110ec2ca78');const m=JSON.parse(b);assert.equal(m.inventory.length,64);for(const r of m.inventory){assert(!r.path.includes('..')&&!r.path.includes('\\')&&!path.isAbsolute(r.path));const q=await fs.readFile(path.join(folder,r.path));assert.equal(q.length,r.bytes);assert.equal(sha(q),r.sha256);}const review=JSON.parse(await fs.readFile(path.join(folder,'review-validation.json')));assert.equal(review.finiteModelAcceptance,true);assert.equal(review.confirmedFaults.length,0);assert.equal(review.finalRun.tests,24);assert.equal(review.finalRun.pass,24);for(const k of ['fail','cancelled','skipped','todo'])assert.equal(review.finalRun[k],0);assert.equal(review.finalRun.sourceStable,true);assert.equal(review.author.manifestSHA256,'70c19b06ecca7b79a9461cb53680429cee2bdc91e022c5015fdf19b258f69ce9');await fs.writeFile(path.join(own,'independent-review-manifest.json.snapshot'),b,{flag:'wx'});await fs.writeFile(path.join(own,'root-review-auth.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});await fs.writeFile(path.join(own,'root-review-auth.json'),JSON.stringify({at:new Date().toISOString(),sourceOnly:true,strictIndependentReviewFiles:64,manifestSHA256:sha(b),acceptedFiniteModelGroups:24,newApplicationOriginalBrowserExecutions:0,productionWrites:0},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({acceptedFiniteModel:true,strictFiles:64,newBehaviorExecutions:0}));
