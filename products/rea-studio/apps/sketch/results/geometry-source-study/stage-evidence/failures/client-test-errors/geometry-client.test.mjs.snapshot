import test from 'node:test';
import assert from 'node:assert/strict';
import {render} from './client.mjs';
import {handle} from './server.mjs';
import {exportExcalidraw} from './core.mjs';

class Element{
 constructor(tag){this.tagName=tag;this.children=[];this.style={};this.listeners=new Map();this.attributes={};this.value='';this.calls=[];}
 append(...children){this.children.push(...children);}replaceChildren(...children){this.children=children;}get childElementCount(){return this.children.length;}setAttribute(key,value){this.attributes[key]=value;}
 addEventListener(type,fn){if(!this.listeners.has(type))this.listeners.set(type,[]);this.listeners.get(type).push(fn);}async event(type,values={}){for(const fn of this.listeners.get(type)||[])await fn({button:0,pointerId:1,clientX:0,clientY:0,preventDefault(){},...values});}click(){return this.event('click');}focus(){}setPointerCapture(){}
 getBoundingClientRect(){return{left:0,top:0,width:800,height:560};}getContext(){return new Proxy({measureText:text=>({width:text.length*10})},{get:(target,key)=>key in target?target[key]:(...args)=>this.calls.push([key,...args])});}
}
const nodes=root=>[root,...root.children.flatMap(nodes)],find=(root,tag,text)=>nodes(root).find(node=>node.tagName===tag&&(text===undefined||node.textContent===text));
async function harness(fn){const old={document:globalThis.document,window:globalThis.window,ResizeObserver:globalThis.ResizeObserver};globalThis.document={createElement:tag=>new Element(tag)};globalThis.window={devicePixelRatio:1};globalThis.ResizeObserver=class{observe(){}disconnect(){}};const saved=new Map(),store={get:async(key,fallback)=>structuredClone(saved.has(key)?saved.get(key):fallback),set:async(key,value)=>saved.set(key,structuredClone(value))},root=new Element('root'),cleanup=await render(root,(action,input)=>handle({action,input,store}));try{await fn({root,store,canvas:find(root,'canvas'),state:()=>JSON.parse(find(root,'textarea').value)});}finally{cleanup();for(const[key,value]of Object.entries(old))value===undefined?delete globalThis[key]:globalThis[key]=value;}}
const draw=async(canvas,start,end)=>{await canvas.event('pointerdown',{clientX:start[0],clientY:start[1]});await canvas.event('pointermove',{clientX:end[0],clientY:end[1]});await canvas.event('pointerup');};

test('UI Line preserves signed draw/resize endpoints and paints no arrowhead or fill',async()=>harness(async({root,canvas,state})=>{
 await find(root,'button','New scene').click();await find(root,'button','Line').click();await draw(canvas,[225,225],[125,175]);let line=state().shapes[0];assert.deepEqual({type:line.type,x:line.x,y:line.y,w:line.w,h:line.h,fill:line.fill},{type:'line',x:200,y:200,w:-100,h:-50,fill:'none'});
 await find(root,'button','Select').click();await draw(canvas,[125,175],[85,125]);line=state().shapes[0];assert.deepEqual({x:line.x,y:line.y,w:line.w,h:line.h},{x:200,y:200,w:-140,h:-100});canvas.calls.length=0;await find(root,'button','Apply style/text to selected').click();assert.equal(state().shapes[0].fill,'none');assert.deepEqual(canvas.calls.filter(row=>row[0]==='moveTo'),[['moveTo',200,200]]);assert.deepEqual(canvas.calls.filter(row=>row[0]==='lineTo'),[['lineTo',60,100]]);assert.equal(canvas.calls.filter(row=>row[0]==='fill').length,0);assert.equal(canvas.calls.filter(row=>row[0]==='closePath').length,0);
}));
test('UI Diamond reverse drag normalizes geometry and paints the exact bounded polygon',async()=>harness(async({root,canvas,state})=>{
 await find(root,'button','New scene').click();await find(root,'button','Diamond').click();await draw(canvas,[425,225],[325,145]);const d=state().shapes[0];assert.deepEqual({type:d.type,x:d.x,y:d.y,w:d.w,h:d.h},{type:'diamond',x:300,y:120,w:100,h:80});canvas.calls.length=0;await find(root,'button','Select all').click();assert.deepEqual(canvas.calls.filter(row=>row[0]==='moveTo'),[['moveTo',351,120]]);assert.deepEqual(canvas.calls.filter(row=>row[0]==='lineTo'),[['lineTo',400,161],['lineTo',351,200],['lineTo',300,161]]);assert.equal(canvas.calls.filter(row=>row[0]==='closePath').length,1);assert.equal(canvas.calls.filter(row=>row[0]==='fill').length,1);
 await find(root,'button','Select').click();await canvas.event('pointerdown',{clientX:326,clientY:146});await canvas.event('pointerup');assert.match(find(root,'p','No shape selected')?.textContent??nodes(root).find(node=>node.tagName==='p'&&node.textContent==='No shape selected')?.textContent??'','No shape selected');
}));
test('UI line/diamond/freehand grouping, group dragging, undo/redo, save/reload preserve real scene data',async()=>harness(async({root,canvas,state,store})=>{
 await find(root,'button','New scene').click();await find(root,'button','Line').click();await draw(canvas,[125,125],[225,125]);await find(root,'button','Diamond').click();await draw(canvas,[325,125],[425,225]);await find(root,'button','Freehand').click();await draw(canvas,[125,325],[175,350]);await find(root,'button','Select all').click();await find(root,'button','Group').click();const grouped=state();assert.ok(grouped.shapes.every(item=>item.groupIds?.length===1));await find(root,'button','Select').click();await draw(canvas,[175,125],[195,155]);const moved=state();for(let i=0;i<moved.shapes.length;i++){assert.equal(moved.shapes[i].x,grouped.shapes[i].x+20);assert.equal(moved.shapes[i].y,grouped.shapes[i].y+30);}await find(root,'button','Undo').click();assert.deepEqual(state(),grouped);await find(root,'button','Redo').click();assert.deepEqual(state(),moved);await find(root,'button','Save').click();const saved=(await handle({action:'list',store})).scenes[0],native=(await handle({action:'exportExcalidraw',input:{id:saved.id},store})).document;assert.deepEqual(native.elements.map(item=>item.type),['line','diamond','freedraw']);const picker=nodes(root).find(node=>node.tagName==='select');await find(root,'button','New scene').click();picker.value=saved.id;await picker.event('change');assert.deepEqual(state().shapes,saved.shapes);
}));
test('UI imported native line/diamond export retains unknown metadata after geometry edit',async()=>harness(async({root,canvas,state,store})=>{
 const doc=exportExcalidraw({name:'Native geometry',shapes:[{id:'native-line',type:'line',x:50,y:100,w:-20,h:0},{id:'native-diamond',type:'diamond',x:250,y:100,w:100,h:80}]});doc.elements[0].customData={retain:['unknown',17]};doc.elements[1].customData={retain:true};doc.unknownDocument={inert:true};const file=nodes(root).find(node=>node.tagName==='input'&&node.type==='file'),text=JSON.stringify(doc);file.files=[{name:'Geometry.excalidraw',size:Buffer.byteLength(text),text:async()=>text}];await file.event('change');assert.equal(state().shapes.length,2);await find(root,'button','Select').click();await draw(canvas,[65,125],[75,145]);await find(root,'button','Save').click();const saved=(await handle({action:'list',store})).scenes[0],output=(await handle({action:'exportExcalidraw',input:{id:saved.id},store})).document;assert.deepEqual(output.unknownDocument,doc.unknownDocument);assert.deepEqual(output.elements[0].customData,doc.elements[0].customData);assert.deepEqual(output.elements[1],doc.elements[1]);assert.equal(output.elements[0].x,60);assert.equal(output.elements[0].y,120);assert.deepEqual(output.elements[0].points,[[0,0],[-20,0]]);
}));
