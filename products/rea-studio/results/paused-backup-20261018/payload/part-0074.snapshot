    },
    {
      "id": "grafana.candidate.9f358bb35bc35fb2fc87",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Service accounts can't be used for instance-wide operations, such as global user management and organization management. These tasks require a user with [Grafana server administrator permissions](ref:roles-and-permissions).",
      "headingPath": [
        "Service accounts",
        "When to use service accounts",
        "Service account limitations"
      ],
      "source": {
        "path": "docs/sources/administration/service-accounts/_index.md",
