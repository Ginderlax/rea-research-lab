import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const root=import.meta.dirname,workspace=path.resolve(root,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)});async function write(p,v){const q=path.join(root,p);await fs.mkdir(path.dirname(q),{recursive:true});await fs.writeFile(q,Buffer.isBuffer(v)?v:JSON.stringify(v,null,2)+'\n',{flag:'wx'});}
const run=(await fs.readdir(path.join(root,'runs'))).filter(n=>n.startsWith('focused-')).sort().at(-1),record=JSON.parse(await fs.readFile(path.join(root,'runs',run,'validation.json'))),current=JSON.parse(await fs.readFile(path.join(root,'runs',run,'source-after.json')));assert.equal(record.passed,true);assert.equal(record.totals.tests,100);assert.equal(record.sourceRows,41);for(const r of current)assert.deepEqual(id(await fs.readFile(path.join(root,r.path))),{bytes:r.bytes,sha256:r.sha256});await write('candidate-final41.json',current);
const deltas=JSON.parse(await fs.readFile(path.join(root,'correction-deltas.json'))).rows,inverses=[];for(const file of new Set(deltas.map(r=>r.file))){let content=await fs.readFile(path.join(root,file),'utf8');const steps=[];for(const row of deltas.filter(r=>r.file===file).reverse()){assert.deepEqual(id(Buffer.from(content)),row.idAfter);assert.equal(content.split(row.after).length-1,row.occurrences);content=content.replaceAll(row.after,row.before);assert.deepEqual(id(Buffer.from(content)),row.idBefore);steps.push({label:row.label,occurrences:row.occurrences,before:row.idAfter,after:row.idBefore});}const expected=await fs.readFile(path.join(root,'before-image',file+'.snapshot'));assert.equal(content,expected.toString());inverses.push({path:file,inverseExact:true,reconstructed:id(Buffer.from(content)),steps});}await write('inverse-validation.json',{inverseExact:true,rows:inverses,old573FilesNotModified:true});
const old=JSON.parse(await fs.readFile(path.join(root,'history/author573/candidate-final-sources.json.snapshot'))).rows,old12=JSON.parse(await fs.readFile(path.join(root,'history/author573/candidate-change-list.json.snapshot'))).rows,overlay=[];for(const row of current){const before=old.find(r=>r.path===row.path);if(!before||before.sha256!==row.sha256)overlay.push({sourcePath:row.path,livePath:row.path.slice('candidate/'.length),kind:before?'replace-author573-proposal':'add-correction-only',before:before?{bytes:before.bytes,sha256:before.sha256}:null,after:{bytes:row.bytes,sha256:row.sha256},publicPath:'products/rea-studio/results/editor-search-pattern-reviewed-installation-20261013/source-proof/textarea-correction/content/'+row.sha256+'.snapshot',epoch:'textarea-correction',historicalAuthor573ProposalRebound:false});}assert.equal(overlay.length,4);assert.equal(overlay.filter(r=>r.before).length,2);const combined=old12.map(row=>{const change=overlay.find(x=>x.sourcePath===row.candidatePath);return{sourceRoot:'work/editor-search-pattern-textarea-fix-next',sourcePath:row.candidatePath,livePath:row.installPath,kind:row.kind,before:row.before,after:change?.after??row.after,original573After:row.after,changedFrom573:!!change,transformation:'none; exact new epoch source',installationAccepted:false};});for(const row of overlay.filter(r=>!r.before))combined.push({sourceRoot:'work/editor-search-pattern-textarea-fix-next',sourcePath:row.sourcePath,livePath:row.livePath,kind:'new',before:null,after:row.after,changedFrom573:false,correctionOnly:true,transformation:'none; exact source',installationAccepted:false});assert.equal(combined.length,14);assert.equal(combined.filter(r=>r.changedFrom573).length,2);await write('correction-public-overlay.json',{schema:'rea-editor-pattern-textarea-source-overlay/v1',prefixRootApproved:true,oldAuthor573ManifestSHA256:'7f975ae3f7a0827f5b9ade231bd121c5b4028f17d88758455fd680962ff0f878',oldPlan44ManifestSHA256:'480b15c9c47c095b70d972b550312ead3e0