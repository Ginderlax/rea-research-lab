 if(sf.parseDiagnostics.length)throw new Error('Syntax diagnostics: '+sf.parseDiagnostics.map(d=>ts.flattenDiagnosticMessageText(d.messageText,' ')).join('; '));
 const prefix=new Uint32Array(text.length+1);for(let i=0;i<text.length;i++){const c=text.charCodeAt(i);if(c>=0xd800&&c<=0xdbff&&text.charCodeAt(i+1)>=0xdc00&&text.charCodeAt(i+1)<=0xdfff){prefix[i+1]=prefix[i]+3;prefix[i+2]=prefix[i]+4;i++;}else prefix[i+1]=prefix[i]+(c<128?1:c<2048?2:3);}
