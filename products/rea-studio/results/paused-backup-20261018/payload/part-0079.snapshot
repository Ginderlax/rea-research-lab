      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c57f998ca6aa8ddbc783",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To test the changes, you can use the `menuShouldPortal` property:",
      "headingPath": [
        "What's new in Grafana v8.1",
        "Annotation panel",
        "Upcoming changes to the Select component"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-1.md",
