    {
      "id": "grafana.candidate.99e9dac91a69876535d4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Metric aggregations can be specified without a field if a script is provided. You can now deselect fields for metrics aggregation when they support scripting.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Grafana OSS features",
        "Data source updates",
        "Elasticsearch data source",
        "Allow omitting field for metrics that support inline scripts"
      ],
      "source": {
