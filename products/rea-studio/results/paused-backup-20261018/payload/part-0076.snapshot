    {
      "id": "grafana.candidate.4cce3d29ef2cb80b8bbc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana also supports **nested variables**, which allow you to reference other variables in a query.",
      "headingPath": [
        "Graphite template variables",
