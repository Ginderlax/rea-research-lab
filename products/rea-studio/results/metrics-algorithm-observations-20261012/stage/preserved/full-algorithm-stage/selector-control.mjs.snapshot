const selectionUnavailable = Symbol('selection unavailable');
/** Private finite-number input only. Other values use the exact stable sort path.
 * Partition work is capped; even an adversarial pivot arrangement falls back to sort. */
function selectFinitePercentile(values, index) {
  if (!values.length) return selectionUnavailable;
  for (let i = 0; i < values.length; i++) if (!Number.isFinite(values[i]) || Object.is(values[i], -0)) return selectionUnavailable;
  let left = 0, right = values.length - 1, work = 0;
  const budget = values.length * 8;
  while (left < right) {
    const mid = Math.floor((left + right) / 2), a = values[left], b = values[mid], c = values[right];
    const pivot = a < b ? (b < c ? b : a < c ? c : a) : (a < c ? a : b < c ? c : b);
    let low = left, current = left, high = right;
    while (current <= high) {
      if (++work > budget) return selectionUnavailable;
      const value = values[current];
      if (value < pivot) { values[current] = values[low]; values[low++] = value; current++; }
      else if (value > pivot) { values[current] = values[high]; values[high--] = value; }
      else current++;
    }
    if (index < low) right = low - 1;
    else if (index > high) left = high + 1;
    else return pivot;
  }
  return values[left];
}

export function singlePercentile(id, field, ignore, zero) {
  let candidates = field.values;
  if (ignore) candidates = candidates.filter(value => value !== null);
  if (zero) candidates = candidates.map(value => value === null ? 0 : value);
  const privateValues = candidates.slice();
  const index = Math.round((privateValues.length - 1) * (Number(id.slice(1)) / 100));
  const selected = selectFinitePercentile(privateValues, index);
  if (selected !== selectionUnavailable) return { [id]: selected };
  privateValues.sort((a, b) => a - b);
  return { [id]: privateValues[index] };
}

