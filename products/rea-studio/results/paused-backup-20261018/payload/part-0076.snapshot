        "lineStart": 166,
        "lineEnd": 166,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/influxdb/query-editor/index.md#L166-L166"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b226aa4a5fd7a27dc9d2",
      "syntaxRole": "table-row",
      "sourceText": "| `$__dateBinAlias(<column>)`   | Applies the [`date_bin`](https://docs.influxdata.com/influxdb/cloud-serverless/reference/sql/functions/time-and-date/#date_bin) function with a `_binned` suffix alias. Column must be a timestamp. |",
      "headingPath": [
        "InfluxDB query editor",
        "SQL query editor",
        "Macros"
      ],
      "source": {
        "path": "docs/sources/datasources/influxdb/query-editor/index.md",
