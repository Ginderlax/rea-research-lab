        "lineStart": 138,
        "lineEnd": 138,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/alerting-rules/templates/reference.md#L138-L138"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.190c245070cbf0c3a703",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Variable names that start with a number (for example, `1B`) are not [valid identifiers in Go templates](https://go.dev/ref/spec#Identifiers).",
      "headingPath": [
        "Annotation and label template reference",
        "Variables",
        "$values"
      ],
      "source": {
        "path": "docs/sources/alerting/alerting-rules/templates/reference.md",
