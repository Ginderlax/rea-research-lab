    {
      "id": "grafana.candidate.dbc6bb361ff6cfc11b1b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can control the time range of a dashboard by providing the following query parameters in the dashboard URL:",
      "headingPath": [],
      "source": {
        "path": "docs/sources/shared/dashboards/time-range-URLs.md",
