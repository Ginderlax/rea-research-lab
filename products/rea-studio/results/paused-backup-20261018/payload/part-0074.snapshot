    },
    {
      "id": "grafana.candidate.ca51e37f4b40cc5755a6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To access a value or label whose key starts with a number, use the `index` function:",
      "headingPath": [
        "Annotation and label template reference",
