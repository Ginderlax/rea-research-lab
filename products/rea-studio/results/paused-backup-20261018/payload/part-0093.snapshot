def common_attempt(bundle,receipt,after,expected_auth):
 assert result['rawControlContext']['jobStatus']=='completed'and result['rawControlContext']['jobConclusion']=='success'
 attempt=load('notes36-'+ROLE+'-attempt.json');assert attempt['schema']=='rea-Notes36-installed-'+ROLE+'-attempt/v1'and attempt['status']=='passed'and attempt['phase']==ROLE and attempt['role']==ROLE and attempt['execution']==execution and attempt['sourceCommit']==HEAD
 for key in('sourceOverlay','sourceInstallationPerformedByCollector','installationJournalAuthenticated','historicalReceiptsRebound','applicationSourcesChanged'):assert attempt[key]is False
 assert attempt['currentNotesSourcesCommitted']is True and attempt['sourceStable']is True and attempt['exactTargets']==7 and attempt['eligibleTargets']==6 and attempt['currentNotesFiles']==36 and attempt['installedSourceCheck']==identity(content('notes36-source-check.json'))
 for key in('originalFullApplicationExecutions','originalDatabaseExecutions','originalGuiExecutions'):assert attempt[key]==0
 assert attempt['sourceFiles']==len(after)and attempt['sourceCapturedBeforeExecution']is True and attempt['notesSourceAuthentication']==expected_auth and attempt['sourceAuthentication']==expected_auth
 assert load('notes36-'+ROLE+'-source-before.json')==load('notes36-'+ROLE+'-source-after.json')==after
 tooling=attempt['tooling'];assert tooling['paths']==TOOLING and tooling['readFiles']==tooling['fileLimit']==12 and tooling['byteLimit']==8388608 and tooling['readBytes']==sum(row['bytes']for row in TOOLING)<=8388608
 assert {row['path']for row in files if row['path'].startswith('tooling-source/')}=={'tooling-source/'+row['path']+'.snapshot'for row in TOOLING}
 for row in TOOLING:
  data=content('tooling-source/'+row['path']+'.snapshot');assert len(data)<=262144 and identity(data)==pin(row);gitbound(row['path'],data)
 assert tooling['selfSource']=={'path':COLLECTOR,**PINS[COLLECTOR],'GitBound':True}and COLLECTOR not in {row['path']for row in TOOLING}
 assert len(attempt['children'])==1;child=attempt['children'][0];assert child['exitCode']==0 and child['signal']is None and child['closeObserved']is True and child['spawnError']is None and child['stopReason']is None and child['droppedOutputBytes']==0
 assert child['stdoutBytes']==len(content(ROLE+'-stdout.txt'))and child['stderrBytes']==len(content(ROLE+'-stderr.txt'))
 events=[json.loads(line)for line in content(ROLE+'-events.jsonl').decode().splitlines()];assert events and [row['sequence']for row in events]==list(range(1,len(events)+1))and events[0]['kind']=='child-started'and events[-1]['kind']=='child-closed'
 workflow=load('notes36-workflow-attempt.json');assert workflow['schema']=='rea-Notes36-installed-workflow-attempt/v1'and workflow['role']==ROLE and workflow['sourceCommit']==HEAD and workflow['runId']==RUN and workflow['runAttempt']=='1'and workflow['runnerEnvironment']=='github-hosted'
 for key in('checkoutOutcome','sourceBeforeOutcome','verificationOutcome','sourceAfterOutcome'):assert workflow[key]=='success'
 for key in('sourceOverlay','sourceInstallationPerformedByWorkflow','installationJournalAuthenticated','historicalReceiptsRebound','fullParity','superiority'):assert workflow[key]is False
 assert workflow['exactInstalledTargets']==7 and workflow['eligibleInstalledTargets']==6 and workflow['currentNotesFiles']==36 and workflow['historicalR5DeclarationRemainsProposalEpoch']is True
 if ROLE=='browser':assert workflow['acquisitionOutcome']=='success'and workflow['browserPostcheckOutcome']=='success'
 return attempt
// A distinct hosted-only committed Notes36 source boundary. No installation/composition.
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import {createHash} from 'node:crypto';
import {spawnSync} from 'node:child_process';
import {fileURLToPath} from 'node:url';
const repository=path.resolve(fileURLToPath(new URL('../../../',import.meta.url))),studio=path.join(repository,'products/rea-studio');
const self='products/rea-studio/scripts/verify-notes36-installed-cloud.mjs';
export const declarationSource={path:'products/rea-studio/results/notes36-source-transition-20261016/current-source-declaration.json',bytes:PENDING_DECLARATION_BYTES,sha256:'PENDING_DECLARATION_SHA256'};
export const sourceLimits={files:2000,totalBytes:64*1024*1024,fileBytes:8*1024*1024,depth:32};
export const identity=bytes=>({bytes:bytes.length,sha256:createHash('sha256').update(bytes).digest('hex')});
const pin=row=>({bytes:row.bytes,sha256:row.sha256});
export function safe(name){assert(typeof name==='string'&&name.length>0&&name.length<=4096&&!/[\\:\x00-\x1f\x7f]/.test(name)&&!name.startsWith('/')&&name.split('/').every(part=>part&&part!=='.'&&part!=='..'));return name;}
export function git(args,maxBuffer=32*1024*1024){const result=spawnSync('git',args,{cwd:repository,windowsHide:true,shell:false,timeout:30000,maxBuffer});assert.equal(result.error,undefined);assert.equal(result.status,0);return result.stdout;}
export function readSource(name,maxBytes=8*1024*1024){let at=repository;for(const part of safe(name).split('/')){at=path.join(at,part);assert(!fs.lstatSync(at).isSymbolicLink());}const item=fs.lstatSync(at);assert(item.isFile()&&item.size<=maxBytes);const bytes=fs.readFileSync(at);assert.equal(bytes.length,item.size);return bytes;}
export function gitSource(name){const bytes=readSource(name);assert.deepEqual(bytes,git(['show','HEAD:'+safe(name)]));return bytes;}
export function execution(){return Object.fromEntries(['CI','GITHUB_ACTIONS','RUNNER_ENVIRONMENT','RUNNER_OS','RUNNER_ARCH','GITHUB_SHA','GITHUB_RUN_ID','GITHUB_RUN_ATTEMPT','GITHUB_REPOSITORY','GITHUB_JOB'].map(name=>{assert.equal(typeof process.env[name],'string');return[name,process.env[name]];}));}
export function assertHosted(){assert.equal(process.platform,'win32');assert.equal(process.version,'v24.16.0');assert.equal(process.env.CI,'true');assert.equal(process.env.GITHUB_ACTIONS,'true');assert.equal(process.env.RUNNER_ENVIRONMENT,'github-hosted');assert.equal(process.env.RUNNER_OS,'Windows');assert.equal(process.env.RUNNER_ARCH,'X64');assert.equal(process.env.GITHUB_REPOSITORY,'Ginderlax/rea-research-lab');assert(['finite-twenty-one-file-selection','eight-real-chromium-scenarios'].includes(process.env.GITHUB_JOB));for(const name of['GITHUB_SHA','GITHUB_RUN_ID','GITHUB_RUN_ATTEMPT','RUNNER_TEMP'])assert(process.env[name]);assert.equal(git(['rev-parse','HEAD']).toString('utf8').trim(),process.env.GITHUB_SHA);assert.equal(git(['rev-parse','--show-object-format']).toString('utf8').trim(),'sha1');assert.equal(path.resolve(fileURLToPath(import.meta.url)),path.join(repository,self));gitSource(self);assert.equal(git(['status','--porcelain=v1','-z','--untracked-files=all']).length,0,'Committed Notes36 requires a clean checkout; no overlays');}
export function ownedEvidence(value){assert(path.isAbsolute(value));const root=fs.realpathSync(value),temporary=fs.realpathSync(process.env.RUNNER_TEMP),relative=path.relative(temporary,root);assert(relative&&relative!=='..'&&!relative.startsWith('..'+path.sep)&&!path.isAbsolute(relative));assert(!fs.lstatSync(root).isSymbolicLink());return root;}
export function evidenceBytes(root,name){let filename=root;for(const part of safe(name).split('/')){filename=path.join(filename,part);assert(!fs.lstatSync(filename).isSymbolicLink());}const item=fs.lstatSync(filename);assert(item.isFile()&&item.size<=8*1024*1024);const bytes=fs.readFileSync(filename);assert.equal(bytes.length,item.size);return bytes;}
export function saveBytes(root,name,bytes){const filename=path.join(root,safe(name));fs.mkdirSync(path.dirname(filename),{recursive:true});fs.writeFileSync(filename,bytes,{flag:'wx'});}
export function saveJSON(root,name,value){saveBytes(root,name,Buffer.from(JSON.stringify(value,null,2)+'\n'));}
function noteFiles(directory,depth=0){assert(depth<=32);assert(fs.lstatSync(directory).isDirectory()&&!fs.lstatSync(directory).isSymbolicLink());const names=[];for(const item of fs.readdirSync(directory,{withFileTypes:true})){if(item.name==='results')continue;assert(!item.isSymbolicLink());const filename=path.join(directory,item.name);if(item.isDirectory())names.push(...noteFiles(filename,depth+1));else{assert(item.isFile());names.push(path.relative(repository,filename).replaceAll('\\','/'));}}return names.sort();}
export function activeCensus(){const rows=[],budget={files:0,bytes:0};function add(filename){const item=fs.lstatSync(filename);assert(item.isFile()&&!item.isSymbolicLink()&&item.size<=sourceLimits.fileBytes);budget.files++;budget.bytes+=item.size;assert(budget.files<=sourceLimits.files&&budget.bytes<=sourceLimits.totalBytes);const bytes=fs.readFileSync(filename);assert.equal(bytes.length,item.size);rows.push({path:path.relative(studio,filename).replaceAll('\\','/'),...identity(bytes)});}function walk(directory,depth=0){assert(depth<=sourceLimits.depth);assert(fs.lstatSync(directory).isDirectory()&&!fs.lstatSync(directory).isSymbolicLink());for(const item of fs.readdirSync(directory,{withFileTypes:true})){if(['node_modules','.local','results'].includes(item.name))continue;assert(!item.isSymbolicLink());const filename=path.join(directory,item.name);if(item.isDirectory())walk(filename,depth+1);else if(item.isFile()&&/\.(mjs|json|html|css|ps1)$/.test(item.name))add(filename);}}for(const name of['apps','lib','public','browser-tests','scripts','tests'])walk(path.join(studio,name));for(const name of['server.mjs','catalog.mjs','package.json'])add(path.join(studio,name));return rows.sort((a,b)=>a.path.localeCompare(b.path));}
function tree(){const result=new Map();for(const raw of git(['ls-tree','-r','-z','--full-tree','HEAD','--','products/rea-studio']).toString('utf8').split('\0').filter(Boolean)){const match=/^(100644|100755) blob ([0-9a-f]{40})\t(.+)$/.exec(raw);assert(match,'Only ordinary committed source blobs');assert(!result.has(match[3]));result.set(match[3],match[2]);}return result;}
function eligible(name){const relative=name.slice('products/rea-studio/'.length);if(['server.mjs','catalog.mjs','package.json'].includes(relative))return true;const parts=relative.split('/');return['apps','lib','public','browser-tests','scripts','tests'].includes(parts[0])&&!parts.some(part=>['node_modules','.local','results'].includes(part))&&/\.(mjs|json|html|css|ps1)$/.test(parts.at(-1));}
export function authenticateCensus(rows,declaration){assertHosted();const objects=tree(),expected=[...objects.keys()].filter(eligible).map(name=>name.slice('products/rea-studio/'.length)).sort();assert.equal(new Set(rows.map(row=>row.path)).size,rows.length);assert.deepEqual(rows.map(row=>safe(row.path)).sort(),expected,'Complete committed six-directory name closure');let notes=0;for(const row of rows){const name='products/rea-studio/'+safe(row.path),bytes=readSource(name);assert.deepEqual(identity(bytes),pin(row));assert.equal(createHash('sha1').update(Buffer.from('blob '+bytes.length+'\0')).update(bytes).digest('hex'),objects.get(name));if(row.path.startsWith('apps/notes/')){const fixed=declaration.currentNotesSources.find(item=>item.path===name);assert(fixed);assert.deepEqual(pin(row),pin(fixed));notes++;}}assert.equal(notes,34);return{activeSixDirectorySources:rows.length,eligibleNotesSources:34,allNotesFiles:36,exactInstalledTargets:7,eligibleInstalledTargets:6,allEligibleGitBlobs:rows.length,excludedGitTargets:[],sourceOverlay:false,allOtherGitBlobsAuthenticated:true};}
export function proof(){assertHosted();const captured=new Map();let total=0;function read(row){const bytes=readSource(row.path,256*1024);assert.deepEqual(identity(bytes),pin(row));assert.deepEqual(bytes,git(['show','HEAD:'+row.path]));assert(!captured.has(row.path),'Distinct fixed proof paths');captured.set(row.path,bytes);total+=bytes.length;assert(captured.size<=64&&total<=8*1024*1024);return bytes;}
 const raw=read(declarationSource),declaration=JSON.parse(raw);assert.equal(declaration.schema,'rea-Notes36-current-source-declaration/v1');assert.equal(declaration.sourceOnly,true);assert.equal(declaration.sourceInstallationPerformedByDeclaration,false);assert.equal(declaration.actualInstalledBehaviorAccepted,false);assert.equal(declaration.historicalReceiptsRebound,false);assert.equal(declaration.externalDeclarationPinRequired,true);assert.equal(declaration.selfIdentityContained,false);assert.equal(declaration.otherProofRowCount,59);assert.equal(declaration.combinedProofRowCount,60);assert.equal(declaration.proofFileLimit,64);assert.equal(declaration.proofByteLimit,8*1024*1024);assert.equal(declaration.proofIndividualByteLimit,256*1024);assert.equal(declaration.otherProofRows.length,59);assert(!declaration.otherProofRows.some(row=>row.path===declarationSource.path));
 for(const row of declaration.otherProofRows)read(row);assert.equal(captured.size,60);assert.equal(declaration.currentNotesSources.length,36);assert.equal(new Set(declaration.currentNotesSources.map(row=>row.path)).size,36);assert.deepEqual(noteFiles(path.join(studio,'apps/notes')),declaration.currentNotesSources.map(row=>row.path).sort());for(const row of declaration.currentNotesSources)assert.deepEqual(identity(captured.get(row.path)),pin(row));
 const bundle=JSON.parse(captured.get(declaration.frozenFeatureBundle.path));assert.deepEqual(identity(captured.get(declaration.frozenFeatureBundle.path)),pin(declaration.frozenFeatureBundle));assert.equal(bundle.schema,'rea-Notes-new-to-do-cloud-source-bundle/v1');assert.equal(bundle.productionInstalled,false);assert.equal(bundle.historicalReceiptsRebound,false);assert.deepEqual(bundle.featureAuthority,declaration.frozenFeatureAuthority);assert.deepEqual(bundle.featureIndependentPeer,declaration.frozenFeatureIndependentPeer);assert.deepEqual(bundle.composedNotesSources,declaration.currentNotesSources);assert.deepEqual(bundle.transitions,declaration.installedTargets);assert.equal(bundle.transitions.length,7);assert.equal(bundle.transitions.filter(row=>row.before).length,3);assert.equal(bundle.transitions.filter(row=>!row.before).length,4);assert.equal(bundle.transitions.filter(row=>/\.(mjs|json|html|css|ps1)$/.test(row.path)).length,6);
 for(const row of bundle.transitions){assert.deepEqual(identity(captured.get(row.path)),pin(row.after));assert.deepEqual(identity(captured.get(row.afterImage.path)),pin(row.after));if(row.before)assert.deepEqual(identity(captured.get(row.beforeImage.path)),pin(row.before));else assert.equal(row.beforeImage,null);}
 assert.equal(bundle.payloads.length,17);for(const row of bundle.payloads)assert.deepEqual(identity(captured.get(row.path)),pin(row));assert.deepEqual(bundle.fixedTests,declaration.fixedTests);assert.equal(bundle.fixedTests.length,21);assert.deepEqual(declaration.currentNotesSources.filter(row=>row.path.endsWith('.test.mjs')).map(row=>row.path).sort(),[...bundle.fixedTests].sort());assert.equal(bundle.plannedGroups,111);assert.equal(declaration.finiteGroups,111);assert.equal(bundle.oldNamedGroupsRequired.length,23);assert.equal(bundle.newNamedGroupsRequired.length,19);assert.deepEqual(bundle.oldNamedGroupsRequired,declaration.oldNamedGroupsRequired);assert.deepEqual(bundle.newNamedGroupsRequired,declaration.newNamedGroupsRequired);assert.deepEqual(bundle.separateComparisonCounts,{existingConversionAndCompletion:20,newParentAndType:4,newDesktopCommandArguments:2,addedToTestGroupCounts:false});assert.deepEqual(bundle.separateComparisonCounts,declaration.separateComparisonCounts);
 return{declaration,bundle,captured,readFiles:60,readBytes:total,fileLimit:64,byteLimit:8*1024*1024,currentSources:declaration.currentNotesSources.map(row=>({...row})),sourceInputs:[...captured].map(([name,bytes])=>({path:name,...identity(bytes)}))};}
const sameAttempt=value=>{assert.deepEqual(value.execution,execution());assert.equal(value.sourceCommit,process.env.GITHUB_SHA);};
function expectedAuthentication(current,census){return{allNotesFiles:36,eligibleNotesSources:34,installedTargets:7,eligibleInstalledTargets:6,sourceOverlay:false,all36NotesGitBlobsAuthenticated:true,sourceInputs:current.sourceInputs,proofReadFiles:60,proofReadBytes:current.readBytes,proofFileLimit:64,proofByteLimit:8*1024*1024,sourceAuthentication:authenticateCensus(census,current.declaration)};}
export function readInstalled(root){assertHosted();root=ownedEvidence(root);const raw=evidenceBytes(root,'notes36-source-check.json'),value=JSON.parse(raw),current=proof(),before=JSON.parse(evidenceBytes(root,'notes36-source-before.json'));assert.equal(value.schema,'rea-Notes36-committed-source-check/v1');assert.equal(value.status,'verified-unexecuted-committed-sources');sameAttempt(value);assert.equal(value.phase,'before');assert.equal(value.sourceOnly,true);assert.equal(value.sourceOverlay,false);assert.equal(value.sourceMutationPerformed,false);assert.equal(value.sourceInstallationPerformedByHelper,false);assert.equal(value.historicalReceiptsRebound,false);assert.equal(value.applicationExecutions+value.originalExecutions+value.browserExecutions,0);assert.deepEqual(value.declaration,declarationSource);assert.deepEqual(value.currentSources,current.currentSources);assert.deepEqual(value.authentication,expectedAuthentication(current,before));assert.deepEqual(value.census,identity(evidenceBytes(root,'notes36-source-before.json')));assert.deepEqual(activeCensus(),before);return{declaration:current.declaration,bundle:current.bundle,receipt:identity(raw),value,current,before,after:before,root};}
export function verifyPostcheck(root,installation){const raw=evidenceBytes(root,'notes36-postrun-source-check.json'),value=JSON.parse(raw);assert.equal(value.schema,'rea-Notes36-committed-postrun-source-check/v1');assert.equal(value.status,'source-verified');sameAttempt(value);assert.equal(value.sourceOverlay,false);assert.equal(value.sourceMutationPerformed,false);assert.equal(value.sourceInstallationPerformedByHelper,false);assert.equal(value.historicalReceiptsRebound,false);assert.deepEqual(value.beforeReceipt,installation.receipt);assert.deepEqual(value.currentSources,installation.current.currentSources);assert.deepEqual(value.authentication,installation.value.authentication);assert.equal(value.sourceStable,true);assert.equal(value.applicationExecutions+value.originalExecutions+value.browserExecutions,0);assert.deepEqual(JSON.parse(evidenceBytes(root,'notes36-source-after.json')),installation.before);return identity(raw);}
function command(){assertHosted();const args=process.argv.slice(2);assert.equal(args.length,4);assert.equal(args[0],'--phase');assert(['before','after'].includes(args[1]));assert.equal(args[2],'--evidence');const root=ownedEvidence(args[3]),phase=args[1],after=phase==='after',name=after?'notes36-postrun-source-check.json':'notes36-source-check.json';let value={schema:after?'rea-Notes36-committed-postrun-source-check/v1':'rea-Notes36-committed-source-check/v1',status:'failed',phase,execution:execution(),sourceCommit:process.env.GITHUB_SHA,sourceOnly:true,sourceOverlay:false,sourceMutationPerformed:false,sourceInstallationPerformedByHelper:false,historicalReceiptsRebound:false,applicationExecutions:0,originalExecutions:0,browserExecutions:0,fullParity:false,superiority:false};try{const current=proof(),census=activeCensus();value.declaration=declarationSource;value.currentSources=current.currentSources;value.authentication=expectedAuthentication(current,census);saveJSON(root,after?'notes36-source-after.json':'notes36-source-before.json',census);if(after){const installed=readInstalled(root);assert.deepEqual(value.authentication,installed.value.authentication);value.beforeReceipt=installed.receipt;value.sourceStable=true;value.status='source-verified';}else{for(const[name,bytes]of current.captured)saveBytes(root,'notes36-proof-source/'+name+'.snapshot',bytes);value.census=identity(evidenceBytes(root,'notes36-source-before.json'));value.status='verified-unexecuted-committed-sources';}}catch(error){value.failure={name:error.name,message:error.message,stack:error.stack};process.exitCode=1;}saveJSON(root,name,value);console.log(JSON.stringify({phase,status:value.status,allNotesFiles:value.authentication?.allNotesFiles??null,sourceCommit:value.sourceCommit}));}
if(process.argv[1]&&path.resolve(process.argv[1])===path.resolve(fileURLToPath(import.meta.url)))command();
# Proposed committed Notes36 epoch â€” architecture only

This is a work-only design against `89e00f66c2249a50c701404accede7565094304e`. It authorizes no copy, installation, test execution, receipt amendment or acceptance. The active application still contains32 Notes files. The independently reviewed R5 experiment passed111 finite groups and8 Chromium cases on a composed derivative; that evidence is not an installed-source receipt. All implementation, source review, atomic copy review and fresh committed-source campaigns below remain pending.

The companion `source-inventory.json` was made by a lightweight data-only reader. It authenticates the actual current32 files, all7 proposed transitions and all60 proposed experimental proof identities without importing or executing application, verifier, test, browser or original code. It also captures exact current module/producer/control/reader/tooling before pins. These are a baseline, not permission to rebase silently if the parent commits more evidence before implementation.

## Established evidence and what it proves

The corrected R5 experiment is run38930449217 at89e: finite job117072778435 and browser job117072778039, both successful. The exact original ZIPs retain538 finite files and570 browser files,1108 total, with independent readback and strict source checks. Its finite selection is21 files/111 groups, retaining all17 old test files and23 old authored group names plus19 new authored names. The20 existing conversion/completion helper comparisons,4 new model parent/type comparisons and2 desktop-command argument comparisons are separate counts. They do not become test groups or original database/full-GUI sessions.

The separate current32 installed control is run38930449222 at89e: finite job117072777339 and browser job117072777079, both successful. Its451+500=951 actual uploaded members are readable. It proves the old fixed17-file92-group and old8-case contract on the committed32-source epoch, with32 app sources,8 old after pins,27 dependencies and independent postchecks. It does not validate R5 installation. Its summary is `work/cloud-verification-backups/run-38930449222/installed-collection-summary-v2.json`. The R5 summary is in `work/cloud-verification-backups/run-38930449217/new-todo-r5-collection-summary-v2.json`.

The earlier failed R4 experiment38926216286 remains a failed run with107/111 finite groups passed (4 failed) and7/8 browser cases passed (1 failed). Its original1110 uploaded members, failed collector records and observer-reader versions remain immutable. The R5 success does not replace those records.

## Application transition and unchanged material

Copy only the7 exact R5 after-images already accepted by the source authority and cloud experiment: replace `apps/notes/client.mjs`, `apps/notes/server.mjs` and `apps/notes/README.md`; add `new-todo-original.test.mjs`, `new-todo.integration.test.mjs`, `new-todo.test.mjs` and `new-todo.ui.test.mjs`. The exact before/after/image paths are in the inventory's `transitions`; there are3 replacements and4 additions,6 census-eligible changed paths plus the separately pinned README. The other29 current Notes files remain byte-identical. The closed current app inventory becomes36 files,34 eligible source files plus README and pinned JEX. All17 old test files remain unchanged; the closed finite roster becomes21 files.

The installed client must be exactly29,531B/d6f301dcc803c4bfd12a1c03eb71896710d1b42053fa10ee13d25e76d6930daa. The corrected integration must be exactly6,131B/e98cfe05932c8b0a6c2bf15582aeaef4257e9aa67f2ed8409856789a3aad6bcf. These include the independently reviewed ownership repair and canonical-baseline assertions. Installation must not introduce another untested runtime or wording epoch. The frozen R5 README's prospective study language must be explicitly qualified by the new installation journal/current index; it cannot be treated as a current execution receipt or silently rewritten to claim installation. The old8 target set and new7 target set have12 distinct app paths: the5 unchanged old Todo targets remain mandatory through the36-source inventory, alongside all7 R5 targets.

Retain the genuine12-file R5 feature authority12444/3761f2727dc549992c6a0e56c601d0f7c674fba10cfd770d5de039b82c93d310 and complete composite peer6520/f1fe470de0346126b69920f7b321b197d549800dce519fc3fafab33c114625bc as historical feature-source authorities. All R3/R4/R5 source and failure-transition histories remain exact. A new installation declaration is a separate object with its own reviewed authority; no old authority is rebound to new bytes.

## A new committed-source campaign replaces both inapplicable automatic contracts

Two existing push workflows assume a32-file baseline: `.github/workflows/notes-installed-cloud.yml` and `.github/workflows/notes-new-todo-experiment-cloud.yml`. The first requires current32 and92/17; the second composes R5 onto current32. After installation neither is a valid automatic current-source contract. Leaving either on app-change pushes would create predictable failures; skipping their assertions or allowing either32 or36 in the same validator would weaken the epoch boundary.

Create a separate current36 workflow, proposed `.github/workflows/notes-new-todo-installed-cloud.yml`, with a new committed-source helper `products/rea-studio/scripts/verify-notes36-installed-cloud.mjs` and standalone finite/browser collector `products/rea-studio/scripts/verify-notes36-cloud.mjs`. These names are proposed paths, not created implementation files. The new workflow must execute actual111/21 and the same8 R5 cases on a clean committed36 checkout, with no composition, write to app sources, target exclusions, test omission, retry or rerun acceptance. Both existing workflows' complete89e bytes must be preserved in a new historical source transition before removing only their automatic push contracts. Their source helpers, experimental composer, collectors, bundles and receipts remain frozen; a manual historical campaign remains valid only on an actual matching historical checkout/ref, not on current36. No successful current36 outcome can be credited to retiring old triggers. The new automatic current36 validation must be in the same reviewed installation commit.

Keep `verify-notes-installed-cloud.mjs`, the old `verify-cloud.mjs` installed32 scope, old shared browser installed32 mode, `compose-notes-new-todo-cloud.mjs`, `verify-notes-new-todo-cloud.mjs` and all historical scopes unchanged. Their strict pins continue to describe their own epochs. The new standalone collector must not import the old composer. The current shared browser collector may be reused only for its already supported clean four-argument acquisition command; its default and historical acceptance modes need no source changes.

The new helper authenticates all36 literal app identities and the exact closed names, all7 installed R5 target pins, every selected original/payload/host dependency, and every eligible file against the actual committed Git tree. There is no allowed dirty path set: Git status must be empty before and after. Before receipts say verified/unexecuted and contain actual execution identity; after receipts independently reauthenticate36/7 and every dependency. Both share actual repository SHA/run/attempt/job and bind the same-attempt before receipt bytes. The collector's own file is Git-bound; its independent fixed tooling table is authenticated before importing the helper, avoiding a helper/collector/table self-pin cycle.

Reuse the exact existing R5 browser spec/config/roster if the final source review confirms their source-only experimental wording is merely provenance: they already pin all36 after identities and do not invoke composition. Preserve all8 case bodies, scenario names and enabled UI interactions byte-for-byte. Keep the browser job's existing `eight-real-chromium-scenarios` name so its explicit guard remains accurate. The new collector changes only the source-authentication/receipt boundary to committed36 and a distinct schema. If any spec source must change for that boundary, preserve the old spec and obtain full review of a new epoch rather than relabeling old evidence.

The browser acceptance remains3 successful actual response holds plus1 held genuine failed response; two genuine owned I/O list400 faults, drain and exact restore before response delivery; actual title400 and explicit retry;2 genuine native downloads,8 CRC-readable PNGs,8 synthetic state/cleanup records, native JEX/TAR raw-record and binary preservation, no unexpected HTTP/page errors, no skip/flaky/retry. These are the same R5 cases, not the old8-case installed32 roster. Keep actual fault mechanism and canonical revision2/metadataEdited:true/history1/full-JSON digest observations strict.

The new workflow uses the already pinned checkout/setup-node/upload actions, read-only contents permission, no persisted credentials, verified `windows-2022` GitHub-hosted Windows/X64 and Node24.16.0 guards, the same owned RUNNER_TEMP evidence/data roots, and no paid resources. Its exact push paths must cover all36 app files, the new declaration/helper/collector/workflow, frozen R5 proof inputs, reused browser spec/config/roster, browser metadata/package/lock/default acquisition inputs, shared server/catalog/lib/public/package dependencies. Manual dispatch is retained. Both jobs independently always run the committed-source postcheck after every started source check, including failed tests. The browser has an additional always full six-directory postcheck that binds its prior attempt and the helper postcheck. Package complete success or failure evidence with the existing2500-file/96MiB raw/8MiB individual/15MiB ZIP limits, retention1day; bounded fallback is explicitly incomplete and cannot pass.

## Closed proof/read groups and publication artifact budget

Budgets must remain distinct; an app source, a proof object, a tooling role, a publication artifact file and an uploaded workflow artifact member are different counts.

| Group | Current state | Proposed state and fixed bound |
| --- | --- | --- |
| General migration reader |159 paths |Keep the existing path budget159/160; do not add Notes group paths into this common set. |
| Archive fixed proof reader |94 paths |Unchanged94/96, existing8MiB aggregate. |
| Legacy Notes proof |52 paths,1,077,301B |Keep a closed52-path historical view,64/8MiB/256KiB per object. Only3 explicitly named current32 path reads project to exact R5 before-images; other49 are direct. |
| Legacy publication Notes envelope |52 proof+4 tooling=56,1,243,634B |New versioned historical-storage mapping preserves all56 logical identities and old schemas/receipts. The old workflow's full bytes become an explicit retained snapshot. No old reader or old artifact is amended. |
| New current36 proof |Existing R5 composed proof60 paths/650,028B |Exactly60 paths,64/8MiB/256KiB per object. Replace the frozen experiment workflow's slot with the new current36 declaration. Expected raw size635,070B plus actual declaration length, which must be pinned and bounded before freeze. |
| New current tooling |Existing experiment12 fixed roles+self Git |Keep12 fixed roles/12/8MiB plus separately Git-bound collector self. Substitute the new helper for composer, current36 declaration for old bundle, new installed workflow for experiment workflow; retain spec/config/roster and6 acquisition dependencies. The declaration is intentionally also read in the60 group and must match the same bytes in both. |
| Current publication artifact |92 actual files under96 |Preserve old historical envelope plus add one60-source envelope and one12-tooling envelope: predicted94 under the unchanged96 cap. This assumes other existing roles stay unchanged; freeze an exact final artifact-role table before cloud and reject any unlisted additions. No extra sidecar is assumed free. |

The data audit derives the60 closure as36 current app files +17 frozen R5 payload files +2 released model sources +3 shared host sources +1 frozen R5 bundle +1 workflow. The proposed installed proof swaps that last workflow role for the new declaration, preserving the count and keeping the old bundle's original workflow pointer as historical data. It must never dereference that pointer as a current installed dependency. A new declaration supplies explicit current proof/read identities, exact historical aliases and the21-file roster. The new helper must assert the60 name set and each role's fixed fingerprint, not derive expected after pins from live candidate bytes. Its60 rows include all7 after-images,3 before-images, R5 source contract,4 original data snapshots,2 real feature review slots and the6 released/original source/license/command inputs in their existing distinct roles. The2 released models are Note.ts45,302B/5f1a200d... and BaseModel.ts26,960B/c0a19f6d... from Joplin3.6.14 commit7e2765a3857754d12dbadea442b60ceaf9d4b23d; the4 new original snapshots remain in the17 payloads. Shared host inputs are server.mjs, catalog.mjs and lib/storage.mjs. Package.json and all other active sources are separately Git-authenticated in the full census; the fixed tooling group covers browser acquisition inputs.

Use separate bounded gzip/base64 envelopes for the legacy56, current60 and tooling12 groups. Each has exact distinct role/path sets, fixed bytes/SHA, canonical base64, per-row/aggregate limits and stored+decoded hashes. Current60 and tooling12 are current Git sources; legacy56 records explicit logical sourcePath, physical retained readPath and original source epoch, rather than suggesting all old bytes are current live paths. Reuse the established4MiB stored/8MiB decoded envelope caps independently, with per-row256KiB and64-row bound on the two Notes proof envelopes, and12-row bound on tooling. These are independently bounded source groups, not112 or128 rows hidden inside a64-file claim. The publication artifact still counts every outer envelope file and all other roles under96. Historical sources/journals/peers are ordinary public payload records and remain subject to publication inventory and portability checks; any fixed proof read newly required for them must receive an explicit closed group/role and be included in the final budget before implementation approval.

## Versioned root migration and reader impacts

The existing52-path `notesSourceTransition` and selected old92/8 raw metadata remain fixed. Its current implementation directly reads the old8 app after pins and therefore fails on the3 new replacements. A resolver-only branch is insufficient: the direct mandatory reads in `verifyNotesSourceTransition` must receive an explicit historical32 data view. Author a new independent current36 verifier first, then supply the old verifier with a closed projection only for client/server/README, each to the exact R5 before-image already authenticated in the60 group. For every other path use the unchanged raw reader. Never use a broad fallback, catch-and-accept, newest-file lookup, directory alias or recursively call the migration resolver while constructing this view. Record the3 projections and report the old52 check as historical source-plan authentication; its old field names must not imply8 current R5 targets or fresh installed behavior. The new summary separately reports36 mandatory current app sources,7 installed target pins and the pending or actual fresh acceptance record.

The resolver must test the new7-target map before the old Notes map. For each replaced path, only the exact R5 after fingerprint resolves to current/null; its exact current32 predecessor resolves to the R5 before-image; the still-older pre-Todo identity resolves through the existing old before-image. For each4 addition only its exact R5 after identity is current; no invented before identity exists. Missing or unknown identities reject. The5 unchanged old Todo target paths retain their existing exact routes. Thus requirements and historical34/69/720/937 claims continue to read their original source bytes without rebinding a receipt or declaring that old behavior was rerun.

Existing consumer paths already call the migration reader and should remain unchanged unless a concrete source read proves otherwise: `verify-records.mjs` historical937 block, historical847/720 and requirement evidence; `verify-followup-records.mjs` old inline8 loop at145 and focused69 loop at169; `verify-notes-inline-followups.mjs`; `verify-notes-vault-followups.mjs`; and `verify-notes-layout-value-api-checkpoint.mjs`. Both previously identified direct followup reads already route expected identities in89e. The future source review must exercise the exact old current32/client/server/README and still-older fingerprints at every affected site as source-only negative controls. Do not generalize unaffected old helper137 or other historical source readers.

Keep the current root149,123B/b5d48417..., followup46,118B/4129e5ea..., generic86,074B/e58d4ba7... and shared browser48,600B/86dc714b... byte-identical if the explicit migration projection suffices. Preserve the migration177,849B/23b964a2..., producer47,328B/b036f37a..., controls54,066B/3ea26c86... full before bytes before authoring their successors. Their precise pins are in the inventory. The current root reader is not the earlier3,878-byte epoch; no remembered before pair may substitute for this actual89e source. Moduleâ†’producer and producerâ†’control pins must be updated together in the new epoch. Old producer/readers/whole-source controls and actual208 receipts remain immutable historical objects.

The new producer verifies the versioned historical56 mapping and new current60/tooling12 envelopes, updates its exact current source pin table and preserves complete failures. Of the old4 installed tooling identities, only the retired automatic workflow requires a physical historical snapshot under this design; the old helper/generic/shared browser remain direct exact files. Negative controls must retain all208 existing semantic controls. Where an old control assumed `migration.resolve(old32After)===null`, preserve its old source/expectation as historical and replace only that assertion's expected exact historical alias in the new epoch; that is a declared source-epoch correction, not deletion of the control. For the3 replaced live Notes paths, split the old fixed-current mutation expectation into an explicit current36 mutation rejection and an independent historical32-before-image mutation rejection; do not merely mutate a path that the new historical projection deliberately no longer reads. All other existing old52 mutation controls retain their actual named scope. Add meaningful new36 controls for every mandatory current file,7 after pins,3 before aliases, exact file census/addition/absence, every original/tooling/declaration envelope identity, old/older/unknown/missing resolver identities, projection boundaries and aggregate/file limits. Derive the new total from the frozen actual control rows; do not guess it or keep208 by omitting new controls. Every previous fixture, original-authentication and publication-repeat clock guard stays strict. Future backup readers must have a new schema/pin set for the actual new producer; the old208/52/56 readers remain untouched.

## Fresh acceptance after a separately reviewed copy

First freeze the complete new declaration/helper/collector/workflow/migration/producer/control proposal with exact89e or explicitly reviewed later before-images. Obtain independent full source/pin/closed-budget review and a reviewed copy-only installer. The installer verifies all current32 pins and7 before/absent states, writes only the7 exact app after-images and reviewed tooling/proof/workflow changes, preserves every changed before-image, checks all36 after identities and all unchanged sources, and emits a source-only journal. A source journal never says behavioral acceptance passed.

After the parent commits and pushes the reviewed installation, run the new committed36 two-job111/8 workflow, the full current development suite, required syntax/source checks and the new publication controls/root-before/root-after on that actual committed Git epoch. The previous full suite passed1100 groups; adding all4 fixed new files with19 groups predicts a1119 strict-superset roster only if the exact discovered names and unchanged old roster prove it. It is not an accepted result. Authenticate the complete old roster as a strict subset, require every19 new name once, check no removal, then record actual totals. Syntax and full-census counts must be derived from the new Git tree and actual output, not extrapolated from old959 or393 observations.

Preserve complete real APIs, terminal run/job conclusions, original outer ZIPs, raw child output and all source/native roles for success or failure. Require no skips/retries/cancellations/todos, no truncated logs or output, source stability, both independent postchecks, actual command linkage and job-qualified execution identity. A separately versioned lightweight reader must authenticate full exact Git name closure,36 current sources,60+12 proof roles and genuine browser cleanup/download/fault restore data before accepting a new summary. Independent byte/source review and PNG/native readback precede public filing. Only then import derived current metadata after a fresh exact-payload publication check; metadata-only changes receive their own fresh check. Keep all prior32, experimental and failed receipts unchanged and retain recoverable local ZIPs/readable exports.

Even a successful installed111/8 plus strict full-suite/publication campaign establishes implemented feature contracts only. Reminders, sorting questions, all remaining documented features, full original GUI/database comparisons, performance/resource/usability studies, security and complete-product parity/superiority remain open.

## Implementation phases proposed for parent review

1. Approve this architecture and its explicit52/56 historical,60 current,12 tooling,159 common,94 Archive and94 predicted publication-artifact counts. Resolve any peer-discovered direct read or budget mismatch before authoring executable sources.
2. Author the independent current36 declaration/helper and closed versioned root projection/resolver in work only; freeze their authority and obtain full independent review before tooling assembly.
3. Author the no-overlay standalone111/8 collector/current workflow, preserve old automatic-workflow before-images, and author bounded producer/control/envelope changes. Freeze complete source/pin tables and final artifact roles; independent source review precedes any copy or execution.
4. Parent reviews/copies/commits the concrete proposal, then verified cloud execution and independent portable readback determine actual acceptance. No installation is performed by this plan.
