import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,workspace=path.resolve(here,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),prefix='products/rea-studio/apps/editor/results/position-range-selection-followup/';
async function tree(d,p=''){const out=[];for(const e of await fs.readdir(d,{withFileTypes:true})){assert(!e.isSymbolicLink());if(e.isDirectory())out.push(...await tree(path.join(d,e.name),p+e.name+'/'));else out.push(p+e.name);}return out;}
export async function strict(folder,name,pin,count){const root=path.join(workspace,'work',folder),mb=await fs.readFile(path.join(root,name));assert.equal(sha(mb),pin,folder);const m=JSON.parse(mb),rows=Array.isArray(m.inventory)?m.inventory:Array.isArray(m.records)?m.records:Object.entries(m.inventory).map(([path,r])=>({path,...r}));assert.equal(rows.length,count);for(const r of rows){assert(safeSource(r.path));const b=await fs.readFile(path.join(root,r.path));assert.equal(b.length,r.bytes,r.path);assert.equal(sha(b),r.sha256,r.path);}assert.deepEqual((await tree(root)).sort(),[...rows.map(r=>r.path),name].sort());return{folder,root,name,pin,count,rows,manifest:{path:name,bytes:mb.length,sha256:sha(mb)}};}
function safeSource(p){return typeof p==='string'&&p.length>0&&!p.includes('\\')&&!p.startsWith('/')&&!p.includes(':')&&p.split('/').every(x=>x&&x!=='.'&&x!=='..');}
function safePublic(p){return safeSource(p)&&p.startsWith(prefix)&&p.endsWith('.snapshot')&&p.split('/').every(x=>/^[A-Za-z0-9._-]+$/.test(x)&&!['.local','work','node_modules','artifacts','tooling'].includes(x));}
function headerSafe(b){const hex=b.subarray(0,8).toString('hex');return!['4d5a','504b0304','504b0506','504b0708','1f8b','377abcaf271c','7f454c46','fd377a585a00','425a68'].some(m=>hex.startsWith(m))&&!b.subarray(0,16).toString().startsWith('SQLite format 3');}
export async function authenticate(){const scopes=await Promise.all([strict('editor-value-api-publication-plan-next','freeze-manifest.json','0322b822798739f44b4d719a8a7d61647465532c19277c1523cc98af04b5ee9b',57),strict('editor-value-api-guide-proposal-next','freeze-manifest.json','08b546c762589b233c5edbca116f8caa7e1a5feb291f379ad34d6111622fefc8',14),strict('editor-position-range-selection-fix-next','freeze-manifest.json','77ae818b4539341ab6f2f0126efaf8974117136f207747450d821df7c09baa1d',319),strict('editor-position-range-selection-correction-independent-review','review-manifest.json','7eb5f10cca861c1ac31b2e6362df8c33d49a1c02f6f0f59c38cd7549cb2aba27',81),strict('editor-position-range-selection-next','freeze-manifest.json','8e423a7d82ea58c696f9bc3d91f6d3df460c51a2041cbcdcc87d2806c0997ee5',145),strict('editor-position-range-selection-independent-review','review-manifest.json','978bfd0fc13f4c148d980d7d1221edd2618e716adffd0831d16a08f522459a09',43),strict('sketch-layout-publication-plan','plan-manifest.json','e444af9b00de3466ac3284e73d72e41e0bae8786291bfdb5b18eafa9e301e700',43)]);const base=scopes[0],guide=scopes[1],sourceByRoot=new Map(scopes.slice(0,4).map(s=>['work/'+s.folder,new Map([...s.rows,s.manifest].map(r=>[r.path,r]))])),byFolder=new Map(scopes.map(s=>[s.folder,s]));assert.equal(sha(await fs.readFile(path.join(base.root,'validation.json'))),'46bfda5afd39b4b022937004a8bfaaea6c2b13b77aae9d0a8d0256dabe48d1eb');assert.equal(sha(await fs.readFile(path.join(guide.root,'validation.json'))),'5c9f75d808bc323256f48838418133ea4ace05a08b9d1d045d099e3b52b345e1');
const map=JSON.parse(await fs.readFile(path.join(base.root,'public-preservation-map.json')));assert.equal(map.payload.length,402);assert.equal(new Set(map.payload.map(r=>r.sha256)).size,166);const seen=new Set();function validateRow(r){assert(r&&typeof r==='object');for(const f of['sourceRoot','sourcePath','publicPath','bytes','sha256'])assert(Object.hasOwn(r,f),'Missing field '+f);assert(typeof r.sourceRoot==='string'&&sourceByRoot.has(r.sourceRoot),'Unlisted source root');assert(safeSource(r.sourcePath),'Unsafe source path');assert(safePublic(r.publicPath),'Unsafe public path');assert(Number.isSafeInteger(r.bytes)&&r.bytes>=0);assert(/^[a-f0-9]{64}$/.test(r.sha256));const known=sourceByRoot.get(r.sourceRoot).get(r.sourcePath);assert(known,'Unlisted source path');assert.equal(r.bytes,known.bytes);assert.equal(r.sha256,known.sha256);assert(!seen.has(r.publicPath),'Duplicate public path');seen.add(r.publicPath);}
for(const r of map.payload){validateRow(r);assert.equal(r.inertExact,true);assert.equal(r.publishable,true);}for(const s of scopes.slice(2,4)){const rows=map.payload.filter(r=>r.sourceRoot==='work/'+s.folder);assert.deepEqual(rows.map(r=>r.sourcePath).sort(),[...s.rows,s.manifest].map(r=>r.path).sort());}
const extra=[];for(const[s,part]of[[base,'publication-plan/frozen/'],[guide,'documentation-proposal-override/frozen/']])for(const r of[...s.rows,s.manifest])extra.push({sourceRoot:'work/'+s.folder,sourcePath:r.path,publicPath:prefix+part+r.path+'.snapshot',bytes:r.bytes,sha256:r.sha256});for(const r of extra)validateRow(r);const all=[...map.payload,...extra];assert.equal(all.length,475);const scan={files:0,bytes:0,strictUTF8:true,leadingNativeHeaders:0,archiveExecutablePaths:0,absoluteAuthorWorkspaceReferences:0};for(const r of all){const b=await fs.readFile(path.join(workspace,r.sourceRoot,r.sourcePath));assert(headerSafe(b),r.sourcePath);new TextDecoder('utf-8',{fatal:true}).decode(b);assert(!/\.(exe|dll|zip|7z|tgz|gz|tar|zst)$/i.test(r.sourcePath));scan.files++;scan.bytes+=b.length;if(b.includes(Buffer.from('C:\\Users\\evanh'))||b.includes(Buffer.from('C:/Users/evanh')))scan.absoluteAuthorWorkspaceReferences++;}
const embedded=JSON.parse(await fs.readFile(path.join(base.root,'embedded-historical145-43-map.json')));assert.equal(embedded.rows.length,190);for(const r of embedded.rows){const oldRoot=path.join(workspace,r.historicalSourceRoot),old=await fs.readFile(path.join(oldRoot,r.historicalSourcePath)),copy=await fs.readFile(path.join(scopes[2].root,r.preservedSourcePath));assert.equal(old.length,r.bytes);assert.equal(sha(old),r.sha256);assert.equal(sha(copy),r.sha256);const row=map.payload.find(x=>x.sourceRoot==='work/editor-position-range-selection-fix-next'&&x.sourcePath===r.preservedSourcePath);assert(row);assert.equal(row.publicPath,r.publicPath);}
