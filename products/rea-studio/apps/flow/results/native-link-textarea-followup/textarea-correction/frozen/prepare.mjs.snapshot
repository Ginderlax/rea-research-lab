import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const own=import.meta.dirname,workspace=path.resolve(own,'../..'),old=path.join(workspace,'work/flow-native-link-next'),browser=path.join(workspace,'work/root-flow-link-browser-review-next'),sha=b=>createHash('sha256').update(b).digest('hex');async function verify(dir,name,expected){const b=await fs.readFile(path.join(dir,name));assert.equal(sha(b),expected);const m=JSON.parse(b);for(const r of m.inventory){const bytes=await fs.readFile(path.join(dir,r.path));assert.equal(bytes.length,r.bytes);assert.equal(sha(bytes),r.sha256);}return{path:path.relative(workspace,dir).replaceAll('\\','/'),manifest:name,bytes:b.length,sha256:sha(b),records:m.inventory.length};}const baseline=await verify(old,'manifest.json','0a03866476a81f83762bdfc10d65be639c24f25778b6c03fdac5b9ee906bea5d'),actualBrowser=await verify(browser,'manifest.json','bae3c0a14e33e8bdd083a86046c6f1e15c455805d4d8e24f899ba0d0793c5f2b'),oldReceipt=JSON.parse(await fs.readFile(path.join(old,'validation.json'),'utf8'));const before=[];for(const row of oldReceipt.candidateSources){const b=await fs.readFile(path.join(old,'candidate',row.path));assert.equal(b.length,row.bytes);assert.equal(sha(b),row.sha256);const target=path.join(own,'candidate',row.path);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b,{flag:'wx'});before.push({...row,source:'work/flow-native-link-next/candidate/'+row.path});}await fs.writeFile(path.join(own,'candidate-before.json'),JSON.stringify(before,null,2)+'\n',{flag:'wx'});await fs.copyFile(path.join(old,'run.mjs'),path.join(own,'run.mjs'));await fs.mkdir(path.join(own,'authority'),{recursive:true});for(const [folder,name,prefix]of[[old,'manifest.json','flow457'],[old,'validation.json','flow457'],[browser,'manifest.json','browser28'],[browser,'validation.json','browser28'],[browser,'browser-observations.json','browser28'],[browser,'seed.json','browser28']]){await fs.copyFile(path.join(folder,name),path.join(own,'authority',prefix+'-'+name+'.snapshot'));}
const app=path.join(own,'candidate/products/rea-studio/apps/flow'),fixture=await fs.readFile(path.join(app,'link-ui-fixture.mjs'),'utf8'),edits=[{before:'set value(value){this._value=String(value);}',after:"set value(value){this._value=this.tagName==='textarea'?String(value).replace(/\\r\\n?/g,'\\n'):String(value);}"},{before:'fixture({scene=linkScene(),hold}={})',after:'fixture({scene=linkScene(),rawText,hold}={})'},{before:"text:JSON.stringify(scene,null,3)+'\\n'",after:"text:rawText??JSON.stringify(scene,null,3)+'\\n'"},{before:"if(this.disabled&&['click','input','change'].includes(name))return;",after:"if(this.disabled&&!event.programmatic&&['click','input','change'].includes(name))return;"},{before:'const prior=globalThis.document;globalThis.document=',after:"const downloads=[],priorCreate=URL.createObjectURL,priorRevoke=URL.revokeObjectURL;URL.createObjectURL=blob=>{downloads.push(blob);return 'blob:owned-flow-export-'+downloads.length;};URL.revokeObjectURL=()=>{};const prior=globalThis.document;globalThis.document="},{before:'return {root,section,store,calls,saved,field,button,held,release,load,dispose,async close()',after:'return {root,section,store,calls,saved,field,button,held,release,load,dispose,downloads,async close()'},{before:'globalThis.document=prior;}};',after:'globalThis.document=prior;URL.createObjectURL=priorCreate;URL.revokeObjectURL=priorRevoke;}};'}];let afterFixture=fixture;for(const e of edits){assert.equal(afterFixture.split(e.before).length-1,1,e.before);afterFixture=afterFixture.replace(e.before,e.after);}let inverse=afterFixture;for(const e of [...edits].reverse())inverse=inverse.replace(e.after,e.before);assert.equal(inverse,fixture);await fs.writeFile(path.join(app,'normalization-ui-fixture.mjs'),afterFixture);await fs.writeFile(path.join(own,'fixture-adapter.json'),JSON.stringify({schema:'rea-flow-native-textarea-model-adapter/v1',before:{path:'candidate/products/rea-studio/apps/flow/link-ui-fixture.mjs',bytes:Buffer.byteLength(fixture),sha256:sha(fixture)},after:{path:'candidate/products/rea-studio/apps/flow/normalization-ui-fixture.mjs',bytes:Buffer.byteLength(afterFixture),sha256:sha(afterFixture)},edits,inverseExact:true,scope:'Same actual client/handle fixture; textarea.value setter models CRLF/bareCR→LF, preserving U+2028 and all other Unicode. Explicit programmatic dispatch is a defensive held-response probe, not real typing into disabled controls. URL Blob observation is test-only, not actual browser download delivery.'},null,2)+'\n');const seed=JSON.parse(await fs.readFile(path.join(browser,'seed.json'),'utf8'));await fs.writeFile(path.join(own,'source-authority.json'),JSON.stringify({schema:'rea-flow-textarea-correction-authority/v1',at:new Date().toISOString(),baseline,actualBrowser,old457Unchanged:true,browser28Unchanged:true,rootSeed:{bytes:Buffer.byteLength(seed.text),sha256:sha(seed.text),startsCRLF:seed.text.startsWith('\r\n'),endsCRLF:seed.text.endsWith('\r\n')},candidateFiles:before.length,preparationAppExecutions:0,productionWrites:0,noRecursiveOldEvidenceRecopy:true},null,2)+'\n');console.log(JSON.stringify({baseline:baseline.records,browser:actualBrowser.records,candidateFiles:before.length,rootSeedBytes:Buffer.byteLength(seed.text),rootSeedSHA256:sha(seed.text)}));
