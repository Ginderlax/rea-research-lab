new="positive('four-fixed-followup-verifier-epochs', () => {\n    assert.equal(migration.resolve('scripts/verify-followup-records.mjs', { bytes: 46118, sha256: '4129e5ea25fca6b91804a6ee1ab12a3b0f7a9efa8f0e9bf8c766738a2e4ed019' }), null);"
alias='products/rea-studio/results/notes-todo-source-transition-20261016/verifier-before/verify-followup-records.mjs.snapshot'
bad="assert.equal(migration.resolve('scripts/verify-followup-records.mjs', { bytes: 45876, sha256: '856eeba61b820260f7e1bdc8d9bb9e8924e3ae3183a0c3c0495471e6152a8b5f' }), null);"
good=bad[:-6]+"'"+alias+"');"
assert after.count(new.encode())==after.count(good.encode())==1
assert after.replace(new.encode(),old.encode()).replace(good.encode(),bad.encode())==before
assert b'assert.equal(rows.length, 208)' in after
assert b"negative('unknown-followup-verifier-epoch'" in after
