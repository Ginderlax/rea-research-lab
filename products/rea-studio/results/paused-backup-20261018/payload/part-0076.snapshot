    {
      "id": "grafana.candidate.0a12f1704f5e22abdc3f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Don't manually wrap variables in quotes (for example, `'${var}'`). Since Grafana v11.3, multi-value variables are automatically quoted when used with the `IN` operator. Manually adding quotes results in double-quoting (for example, `''value''`), which breaks queries.",
      "headingPath": [
        "Microsoft SQL Server template variables",
        "Format variables for SQL queries",
        "Use `sqlstring` for safe single-value interpolation"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/template-variables/index.md",
