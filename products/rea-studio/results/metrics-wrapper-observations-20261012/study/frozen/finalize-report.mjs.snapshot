import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),sha=bytes=>createHash('sha256').update(bytes).digest('hex'),fp=async file=>{const bytes=await fs.readFile(file);return {bytes:bytes.length,sha256:sha(bytes)};};
const summary=JSON.parse(await fs.readFile(path.join(here,'recomputed-summary.json'))),analysis=JSON.parse(await fs.readFile(path.join(here,'analysis-validation.json'))),source=summary.preservation.readiness.source;
const actionNames=(await fs.readdir(here)).filter(name=>/^action-.*\.json$/.test(name)),actions=[];for(const name of actionNames){const record=JSON.parse(await fs.readFile(path.join(here,name))),stem=name.slice(0,-5);for(const [suffix,key]of [['.source.mjs.snapshot','sourceSHA256'],['.stdout.txt','stdoutSHA256'],['.stderr.txt','stderrSHA256']])assert.equal((await fp(path.join(here,stem+suffix))).sha256,record[key]);actions.push({path:name,...await fp(path.join(here,name)),...record});}
const failures=actions.filter(row=>row.exitCode!==0);assert.equal(failures.length,1);assert.equal(failures[0].name,'make-outputs.mjs');
const productionRoot=path.resolve(here,'../../outputs/rea-research-lab/products/rea-studio/apps/metrics'),productionFiles=['client.mjs','core.mjs','server.mjs','native-calculations.mjs','results/native-calculations-verification.json'],productionBindings={};
for(const name of productionFiles){const file=path.join(productionRoot,name),bytes=await fs.readFile(file),record={bytes:bytes.length,sha256:sha(bytes)},relative='preserved/current-metrics-production/'+name+'.snapshot';await fs.mkdir(path.dirname(path.join(here,relative)),{recursive:true});await fs.writeFile(path.join(here,relative),bytes,{flag:'wx'});assert.deepEqual(await fp(file),record);productionBindings[name]={sourcePath:file,path:relative,...record};}
assert.equal(productionBindings['native-calculations.mjs'].sha256,summary.candidate.baselineSHA256);
let readme=await fs.readFile(path.join(here,'README.md'),'utf8');assert.ok(readme.includes('No new consolidation action failed.'));readme=readme.replace('No new consolidation action failed.','One new consolidation summary cross-check failed before writing outputs because it demanded bit-identical percentages from differently ordered floating arithmetic. Its exact source/stdout/stderr are retained. The successful retry applies the already declared roundoff-equivalence bound to memory percentages too; recorded values, candidate, workload, performance criteria and measured attempts never changed.');await fs.writeFile(path.join(here,'README.md'),readme);
const timing=JSON.parse(await fs.readFile(path.join(source,'results/timing-attempt-1791849618765.json'))),memory=JSON.parse(await fs.readFile(path.join(source,'results/memory-observations-control-1791850160778.json')));
const receipt={schema:'rea-metrics-wrapper-measurement-review/v1',checkedAt:new Date().toISOString(),status:'source-authenticated finite observations; candidate unaccepted',candidate:summary.candidate,summary:{path:'recomputed-summary.json',...await fp(path.join(here,'recomputed-summary.json'))},readiness:{receiptPath:path.join(source,'readiness-validation.json'),receiptSHA256:'705c4540bb54ef37e6b396ed9082aaf7ffe4d944b362b03ac85bd0d76ec3c32c',manifestSHA256:'6bb39d2051d18147987ff2028d349b219f279d48216159ff00f5d7f2bc7858c3',inventoryFiles:2426,allBeforeAfterAuthenticated:true},attempts:{timing:{path:path.join(source,'results/timing-attempt-1791849618765.json'),...await fp(path.join(source,'results/timing-attempt-1791849618765.json')),status:timing.status},pairedTiming:{path:path.join(source,'results/paired-control-1791849618749.json'),...await fp(path.join(source,'results/paired-control-1791849618749.json'))},memory:{path:path.join(source,'results/memory-observations-control-1791850160778.json'),...await fp(path.join(source,'results/memory-observations-control-1791850160778.json')),status:memory.status}},windows:summary.windows,counts:summary.counts,pureSummaryCrossCheck:analysis,sourceSnapshots:{copiedOriginalReviewFiles:summary.preservation.copies.length,newCurrentMetricsProductionSnapshots:productionFiles.length,fullWrapper86AndManifestPreserved:true,newObservationFiles:887,priorPublicTreesReferencedNotRecopied:summary.preservation.publicHistory,archivesAndNativeExecutableCopied:false},productionBindings,findings:summary.timingSummary.map(row=>({caseName:row.caseName,baselineMedianPercent:row.candidateComparedWith.baseline.medianRatioPercent,baselinePairedMedianPercent:row.candidateComparedWith.baseline.pairedRatioPercent.median,candidateSlowerPairs:row.candidateComparedWith.baseline.candidateSlowerPairs,baselineRangeOverlap:row.candidateComparedWith.baseline.observedRanges.overlap,originalMedianPercent:row.candidateComparedWith.original.medianRatioPercent})),positiveMemoryFindings:summary.memorySummary.flatMap(row=>Object.entries(row.candidateComparedWith.baseline).filter(([,value])=>value.medianDifferenceBytes>0||value.pairedDifferenceBytes.median>0).map(([metric,value])=>({caseName:row.caseName,metric,medianDifferenceBytes:value.medianDifferenceBytes,pairedMedianDifferenceBytes:value.pairedDifferenceBytes.median,range:value.pairedDifferenceBytes,observedRanges:value.observedRanges}))),failureAndCensoring:{...summary.failureAndCensoring,consolidationFailures:failures,consolidationActions:actions,floatingSummaryRoundoffCorrection:true,recordedValuesRetainedWithoutChanges:true},sourceBeforeAfterAuthenticated:true,causalWrapperCompilerAttributionEstablished:false,numericPerformanceThresholdIntroducedAfterMeasurements:false,candidateIntegrated:false,performanceAcceptance:false,fullPerformanceNonRegressionEstablished:false,universalSuperiorityEstablished:false,fullParityEstablished:false,fullProductComplete:false,newMeasurementRun:false,productionChangedByThisTask:false};
for(const record of summary.preservation.copies){assert.deepEqual(await fp(record.sourcePath),{bytes:record.bytes,sha256:record.sha256});assert.deepEqual(await fp(path.join(here,record.path)),{bytes:record.bytes,sha256:record.sha256});}
for(const record of Object.values(productionBindings))assert.deepEqual(await fp(record.sourcePath),{bytes:record.bytes,sha256:record.sha256});
await fs.writeFile(path.join(here,'measurement-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({status:receipt.status,receiptSHA256:(await fp(path.join(here,'measurement-validation.json'))).sha256,sourceSnapshots:summary.preservation.copies.length+productionFiles.length,consolidationFailures:failures.length}));
