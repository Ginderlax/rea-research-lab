    {
      "id": "grafana.candidate.d9cbdb5a4d06a4c39c82",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "InfluxDB plugin versions earlier than 13.1.0 could write API tokens to Grafana server logs in plain text at default log levels. Before troubleshooting with logs, upgrade to plugin version 13.1.0 or later. Treat log files as sensitive, and rotate any tokens that may have been exposed.",
      "headingPath": [
        "Troubleshoot InfluxDB data source issues",
        "Enable debug logging"
