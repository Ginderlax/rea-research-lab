import test,{after}from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import{layoutSelection}from'../sketch-alignment-next/products/rea-studio/apps/sketch/layout.mjs';import{createOriginalOracle,negativeZeroPaths}from'./original-oracle.mjs';import{shape,scene,originalElements}from'./fixtures.mjs';const oracle=await createOriginalOracle(),packets=[],ops=['x','y'].flatMap(axis=>[...['start','center','end'].map(position=>({kind:'align',axis,position})),{kind:'distribute',axis}]);after(()=>fs.writeFileSync(process.env.SKETCH_REVIEW_OBSERVATIONS,JSON.stringify({packets,contracts:oracle.contracts,counts:oracle.counts,observations:oracle.observations,adapters:oracle.adapters,exactMutationHelpersExecuted:true},null,2)+'\n',{flag:'wx'}));
test('collect every fractional comparison including signed line and freehand edge arithmetic',()=>{const inputs=[scene([shape('a',1/3,-0,1/7,1/11),shape('b',2/3,-0,-1/9,-1/13,{type:'line'}),shape('c',4/3,.3,.2,.1)]),scene([shape('a',-0,-0,0,0),shape('b',.1,.2,.01,.03),shape('c',.6,.7,.13,.17)]),scene([shape('a',.1,.1,0,0,{type:'freedraw',points:[[.2,.3],[-.04,-.05]]}),shape('b',.7,.9,.11,.12),shape('c',1.3,1.2,-.6,-.7,{type:'line'})])],positions=es=>es.map(e=>({id:e.id,x:e.x,y:e.y})).sort((a,b)=>a.id.localeCompare(b.id));for(const input of inputs)for(const op of ops){const elements=originalElements(input),expected=positions(op.kind==='align'?oracle.align(elements,op):oracle.distribute(elements,{axis:op.axis,space:'between'})),actual=positions(layoutSelection(input,input.shapes.map(s=>s.id),op).scene.shapes);let exact=true;try{assert.deepEqual(actual,expected);}catch{exact=false;}packets.push({input,op,actual,expected,exact,negativeZero:{actual:negativeZeroPaths(actual),expected:negativeZeroPaths(expected)}});}console.log('FRACTIONAL_PAIRS '+packets.length+' EXACT '+packets.filter(p=>p.exact).length);assert.equal(packets.filter(p=>!p.exact).length,0,'Finite literal numeric comparisons differ');});
