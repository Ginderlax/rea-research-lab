        "lineStart": 28,
        "lineEnd": 28,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/elasticsearch/template-variables/index.md#L28-L28"
      },
      "applicability": {
