    {
      "id": "grafana.candidate.fe17d9f039d4de13c809",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "At the configuration file, extend the `scopes` in `[auth.okta]` section with `offline_access` and set `use_refresh_token` to `true`.",
      "headingPath": [
        "Configure Okta OIDC authentication",
