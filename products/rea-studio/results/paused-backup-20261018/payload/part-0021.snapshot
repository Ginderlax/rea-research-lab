assert sorted(r['path'][len(P):]for r in d['currentNotesSources']if r['path'].endswith('.test.mjs'))==sorted(d['fixedTests'])and len(d['fixedTests'])==21
for r in old_tests:pin(source(r['path']),r)
for t in bundle['transitions']:
