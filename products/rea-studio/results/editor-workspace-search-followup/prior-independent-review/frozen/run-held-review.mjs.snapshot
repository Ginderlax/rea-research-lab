import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import {spawnSync} from 'node:child_process';import assert from 'node:assert/strict';
const here=import.meta.dirname,sha=bytes=>createHash('sha256').update(bytes).digest('hex'),fp=async file=>{const bytes=await fs.readFile(file);return {bytes:bytes.length,sha256:sha(bytes)};},stages=[['editor-search-next','44e8efd72f09c7cc5caa598f43dbe099dd73982477249ecfed2fddfb2a26a7a6',140],['editor-search-fix-next','b858a4cf15312f962bf0ac5ba2fd6b6c17466248ff1394c727a49ee0e665e9ef',124]],bindings=[];
for(const [name,digest,count]of stages){const root=path.resolve(here,'../'+name),bytes=await fs.readFile(path.join(root,'freeze-manifest.json')),manifest=JSON.parse(bytes);assert.equal(sha(bytes),digest);assert.equal(Object.keys(manifest.inventory).length,count);for(const [name,row]of Object.entries(manifest.inventory))assert.deepEqual(await fp(path.join(root,name)),row);bindings.push({name,root,manifestSHA256:digest,inventory:manifest.inventory});}
const originalTest=await fs.readFile(path.join(here,'held-search.test.mjs'),'utf8'),fixedTest=originalTest.replaceAll('../editor-search-next/','../editor-search-fix-next/');assert.notEqual(originalTest,fixedTest);await fs.writeFile(path.join(here,'held-fixed.test.mjs'),fixedTest,{flag:'wx'});
const snapshots=[];for(const binding of bindings.filter(row=>row.name==='editor-search-fix-next'))for(const name of [...Object.keys(binding.inventory),'freeze-manifest.json']){const bytes=await fs.readFile(path.join(binding.root,name)),relative='preserved/fixed-candidate/'+name.replaceAll('node_modules','synthetic-excluded-dependency')+'.snapshot';await fs.mkdir(path.dirname(path.join(here,relative)),{recursive:true});await fs.writeFile(path.join(here,relative),bytes,{flag:'wx'});snapshots.push({sourcePath:path.join(binding.root,name),path:relative,bytes:bytes.length,sha256:sha(bytes)});}
const results=[];for(const [name,expectedCode,expectedPass,expectedFail]of [['held-search.test.mjs',1,3,2],['held-fixed.test.mjs',0,5,0],['fresh-core.test.mjs',null,null,null]]){const before=await fp(path.join(here,name)),start=new Date().toISOString(),child=spawnSync(process.execPath,['--test','--test-reporter=tap',path.join(here,name)],{encoding:'utf8',timeout:60000,maxBuffer:2*1024*1024,windowsHide:true}),stdout=child.stdout??'',stderr=child.stderr??'',stem='source-bound-'+name+'-'+Date.now();for(const [suffix,value]of [['.stdout.txt',stdout],['.stderr.txt',stderr]])await fs.writeFile(path.join(here,stem+suffix),value,{flag:'wx'});assert.deepEqual(await fp(path.join(here,name)),before);const counts=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(key=>[key,Number(stdout.match(new RegExp('^# '+key+' (\\d+)$','m'))?.[1])])),record={name,start,end:new Date().toISOString(),exitCode:child.status,signal:child.signal,error:child.error?.message,source:before,stdout:{path:stem+'.stdout.txt',bytes:Buffer.byteLength(stdout),sha256:sha(stdout)},stderr:{path:stem+'.stderr.txt',bytes:Buffer.byteLength(stderr),sha256:sha(stderr)},counts};results.push(record);if(expectedCode!==null){assert.equal(child.status,expectedCode);assert.equal(counts.pass,expectedPass);assert.equal(counts.fail,expectedFail);}assert.equal(child.signal,null);assert.equal(counts.cancelled,0);assert.equal(counts.skipped,0);}
for(const binding of bindings)for(const [name,row]of Object.entries(binding.inventory))assert.deepEqual(await fp(path.join(binding.root,name)),row);
await fs.writeFile(path.join(here,'held-review-validation.json'),JSON.stringify({schema:'rea-independent-editor-held-search-review/v1',checkedAt:new Date().toISOString(),sourceBeforeAfterAuthenticated:true,bindings:bindings.map(({inventory,...row})=>({...row,files:Object.keys(inventory).length})),results,fixedSnapshots:snapshots,oldReproductionReplayedWithFullSourceBindings:true,exactSameHeldTestExceptImportPaths:true,actualClientModule:true,finiteElementModel:true,actualBrowserExecution:false,newTimingMemoryOrProfilerRuns:0,productionChanged:false,fullParity:false},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:'completed; observed failures retained',results:results.map(row=>({name:row.name,exitCode:row.exitCode,counts:row.counts})),fixedSnapshots:snapshots.length}));
