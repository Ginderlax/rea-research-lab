 ["import fs from'node:fs/promises';",imp+"import fs from'node:fs/promises';"],
 ["const planRoot=prefix+", "const migration=createEditorVaultProofMigrationFromRoot(repo);\nconst planRoot=prefix+"],
 ["if(requireCurrent)assert.deepEqual(liveMismatches,[],'Current implementation differs from the source-bound78 receipt; historical snapshots remain separate.');", "const declaredMismatches=migration.editorMismatchesIncludingHistoricalHost(current.currentSources);assert.deepEqual(liveMismatches,declaredMismatches,'Only fixed named replacements and the separately pinned historical host transition are allowed');for(const r of current.currentSources){const historical=migration.resolve(r.path,r);if(historical)await exact(historical,r);}if(requireCurrent)assert.deepEqual(liveMismatches,[],'Historical78 is not current implementation evidence; all installed after identities are mandatory separately.');"],
 ['currentSourceSnapshots:31,liveSourceMatch:', 'sourceMigration:migration.summary(),historical78NotCurrentAcceptance:true,currentAfterIdentitiesMandatory:true,currentSourceSnapshots:31,liveSourceMatch:']
]);
