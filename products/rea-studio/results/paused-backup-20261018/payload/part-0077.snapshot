    {
      "id": "grafana.candidate.ef8fd783c773b3d96d5c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For SQL data sources (MySql, Postgres, MSSQL) you can override the default maximum connection lifetime specified in seconds (default: 14400). The value configured in data source settings is preferred over the default value.",
      "headingPath": [
