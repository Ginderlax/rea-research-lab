    },
    {
      "id": "grafana.candidate.78638a9f3fd5ec7790cb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When the traffic is very low, even a single slow or failing request can trigger the alerts.",
      "headingPath": [
        "Examples of trace-based alerts",
        "Alerting on span metrics",
        "Enable traffic guardrails"
      ],
      "source": {
