      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.0ae2027a57dba67653d8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Building on everything you already know and love about Grafana open source, Grafana Enterprise includes [exclusive data source plugins](#enterprise-data-sources) and [additional features](#enterprise-features). You also get 24x7x365 support and training from the core Grafana team.",
      "headingPath": [
        "Grafana Enterprise"
      ],
      "source": {
        "path": "docs/sources/introduction/grafana-enterprise.md",
        "gitBlobSha": "e38a5224ae017dd1425773dd44ad264a1b93350e",
