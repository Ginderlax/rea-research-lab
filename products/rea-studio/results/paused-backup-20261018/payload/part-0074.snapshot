    {
      "id": "grafana.candidate.04d14a30205cf325bfb3",
      "syntaxRole": "list-item",
      "sourceText": "- **User account -** Affects the individual user. Set by the user on their own account.",
      "headingPath": [
        "Organization preferences"
      ],
      "source": {
        "path": "docs/sources/administration/organization-preferences/index.md",
