// Hosted-only authentication of committed Notes sources. No source installation.
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import { createHash } from 'node:crypto';
import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
const repository=path.resolve(fileURLToPath(new URL('../../../',import.meta.url)));
const studio=path.join(repository,'products/rea-studio');
const NOTES=[{"path":"apps/notes/README.md","bytes":18406,"sha256":"65b8eec8da3295d44adb0afd0b9840fe38107b676af750d0a2be27243857705d"},{"path":"apps/notes/app.integration.test.mjs","bytes":4297,"sha256":"b4ac48818f2508f21c873edf6d34e09432b3e50361b066d8cfe54ab207d2a1e8"},{"path":"apps/notes/app.test.mjs","bytes":6974,"sha256":"aa1891fc26b4dfecf771e53994c67bd2cadc4fa92c5ed86253a47a852a689cbd"},{"path":"apps/notes/client.mjs","bytes":28048,"sha256":"09f7a63badf83336b1b0fd36935256461babcb31333ff500b192307b587928db"},{"path":"apps/notes/core.mjs","bytes":2657,"sha256":"06bf9ad2485e39d6c7dea51a3be9a232fefe9d1a2ed1e46482b0459d605aa44c"},{"path":"apps/notes/fixtures/oracle-verification.json","bytes":4843,"sha256":"82b53a9c9c0594b0364f2752e78bef85d374d53a2f4a5b2580daa8edc6079d9f"},{"path":"apps/notes/fixtures/pinned-joplin.jex","bytes":9728,"sha256":"044885c906ba7d8cb97a95fbdd6bc2323ba31a3c301e7ed1d6e592acec8944af"},{"path":"apps/notes/fixtures/pinned-joplin.json","bytes":6174,"sha256":"cabc16edfc51e2e58fa0f147f31f5b5b54345a49597a3567583c3623d0fad220"},{"path":"apps/notes/interop-fixture-tool.mjs","bytes":12119,"sha256":"8dfd56500bb9d31c0f3f77537bb8a4c7cad8bc4f8207a0f81a8c550825ee9f2f"},{"path":"apps/notes/jex.mjs","bytes":13323,"sha256":"02785fd47baad48c2ae34c01fd066ad9efa1b0d1784258bfcdadac0e9c75570f"},{"path":"apps/notes/jex.test.mjs","bytes":14190,"sha256":"21f9883954fa1d00d092751f70f4a482eaedc838a8d037e3276d1d72d2549fdf"},{"path":"apps/notes/markdown.mjs","bytes":5135,"sha256":"409b2bcc489c785e725d3257f21af1c6a3cd4f1f78fa0d0ca74d538876f24915"},{"path":"apps/notes/notebook-confirmation-cancel-open-note.ui.test.mjs","bytes":1389,"sha256":"bd6a5217713ead7019f298c64366097aebe372a4df9ec8bfb0997a8c3c1ba7f4"},{"path":"apps/notes/notebook-confirmation.ui.test.mjs","bytes":9358,"sha256":"007fd300093c25cedf078ed0784c61e6b77f07eede734646a0517d950e87d693"},{"path":"apps/notes/notebook-original-oracle.mjs","bytes":3699,"sha256":"9e5ec3357b64e2af290866da6453361c12716f82f7122b3fa9e82f817588045f"},{"path":"apps/notes/notebook-trash-fresh-boundaries.test.mjs","bytes":4480,"sha256":"820b38cd108d3d392496225a298e42f6239dbdd1fa6971ef505a9682e0dea95d"},{"path":"apps/notes/notebook-trash-original-oracle.mjs","bytes":5974,"sha256":"077fa22e13d0ba84eaf7553b117d54c3f95e1bd4a9c6fa27f79fcb35ce4a1b8a"},{"path":"apps/notes/notebook-trash-publication-boundaries.test.mjs","bytes":6778,"sha256":"9bb8f4dba56a0c5e7d106bed026aab7de67a7ed8627507edd883e75a087fe07b"},{"path":"apps/notes/notebook-trash-review-fixture.mjs","bytes":3296,"sha256":"8ffd7a3c87ca203900bc9dc2806aef036034edbba9a947701d491828f001486c"},{"path":"apps/notes/notebook-trash-review.test.mjs","bytes":8836,"sha256":"a2b47baadeab95035c1255865bb216943f685776e779495793607001fe897518"},{"path":"apps/notes/notebook-trash.integration.test.mjs","bytes":4078,"sha256":"378d6499959631c3842df3ed142f45abe3d2ee66b1b71d4743d713f08a6b2b67"},{"path":"apps/notes/notebook-trash.mjs","bytes":6150,"sha256":"a94a44d754ca5f20c5d5e8dbac9753c31650b7c929ceab6d196acc0c3690edb4"},{"path":"apps/notes/notebook-trash.test.mjs","bytes":14015,"sha256":"e4f574932cee5c65b512f31a035f6c5066109ce5e075de63d101019dc4e18eba"},{"path":"apps/notes/notebook-trash.ui.test.mjs","bytes":2503,"sha256":"d00d0e84abaf6e18f3626f49e4eb7c29929e834542dc469370aeff5077e480a9"},{"path":"apps/notes/notebooks.integration.test.mjs","bytes":3279,"sha256":"b14ef6c52503b634d3a66e0b73d83fe3a577b783a0da9a5d76d8ce016993a75c"},{"path":"apps/notes/notebooks.mjs","bytes":6902,"sha256":"4ba3d49563b87d1a37ebb4314d4f513f84e0c8681f9404842c380bc49175edc9"},{"path":"apps/notes/notebooks.test.mjs","bytes":14161,"sha256":"4e14c0e2d99d856e67fff9b9dec8216858be354c63019a24599e60a3505bc82d"},{"path":"apps/notes/server.mjs","bytes":24800,"sha256":"492ab5fb79a077a888376f8f8b6b13c830fc4004e21a0e2033546e90e0e36181"},{"path":"apps/notes/todo-original.test.mjs","bytes":4397,"sha256":"51e4f9594525b046ae3b6a5ed2af92736df158743049e792fff50e9b774717d0"},{"path":"apps/notes/todo.integration.test.mjs","bytes":5802,"sha256":"442da2522755a4a0c02a6602a8a63ce367a20d2a65d940a53062a7dc08e9d05e"},{"path":"apps/notes/todo.test.mjs","bytes":10873,"sha256":"38c66f3b553888923098c98bb083899f00ca42df45dab30ad66548d4ff576e18"},{"path":"apps/notes/todo.ui.test.mjs","bytes":8623,"sha256":"65de552f75be2e7b6ebbd45723740c76e55bda09d13d550bf38ec6228e4d83f5"}];
const bundleSource={path:'products/rea-studio/experiments/notes-todo/bundle.json',bytes:10977,sha256:'6489170855483748eaff4ece03bdbadc29f79ab87cf9a16015dede504891bd62'};
const browserBundleSource={path:'products/rea-studio/experiments/notes-todo-browser/bundle.json',bytes:3113,sha256:'5153f72e1ee05c6974c8da5f274038914e4ab5f1dbeb884b4fe79706f5e25a1c'};
const indexSource={"path":"products/rea-studio/apps/notes/results/todo-followup/publication-index.json","bytes":5086,"sha256":"3889a8d676930dde323edd5a37a74393093dc334ee7557ded90804ed925cc731"};
const workflowSource={"path":".github/workflows/notes-installed-cloud.yml","bytes":14895,"sha256":"3cfb0b71128ad57c19162dd3dc1722689ea6c4831c5cd2f793c0a45e91519c5f"};
const browserResultHelper={path:'products/rea-studio/scripts/verify-notes-todo-browser-cloud.mjs',bytes:20439,sha256:'3afc8bb1ca5b496454c1cae10181e9b32466b39fd8ec0a908320c41ad6a027f0'};
const identity=bytes=>({bytes:bytes.length,sha256:createHash('sha256').update(bytes).digest('hex')});
const pin=row=>({bytes:row.bytes,sha256:row.sha256});
const names=['CI','GITHUB_ACTIONS','RUNNER_ENVIRONMENT','RUNNER_OS','RUNNER_ARCH','GITHUB_SHA','GITHUB_RUN_ID','GITHUB_RUN_ATTEMPT','GITHUB_REPOSITORY'];
function relative(name){assert(typeof name==='string'&&name&&name.length<4096&&!/[\\:\x00-\x1f\x7f]/.test(name)&&!name.startsWith('/')&&name.split('/').every(s=>s&&s!=='.'&&s!=='..'));return name;}
function read(base,name){relative(name);let at=base;for(const part of name.split('/')){at=path.join(at,part);assert(!fs.lstatSync(at).isSymbolicLink());}const stat=fs.lstatSync(at);assert(stat.isFile()&&stat.size<=8*1024*1024);const bytes=fs.readFileSync(at);assert.equal(bytes.length,stat.size);return bytes;}
function git(args,maxBuffer=32*1024*1024){const r=spawnSync('git',args,{cwd:repository,windowsHide:true,shell:false,timeout:30000,maxBuffer});assert.equal(r.error,undefined);assert.equal(r.status,0);return r.stdout;}
function execution(){return Object.fromEntries(names.map(n=>{assert.equal(typeof process.env[n],'string');return[n,process.env[n]];}));}
function guard(){assert.equal(process.platform,'win32');assert.equal(process.version,'v24.16.0');assert.equal(process.env.CI,'true');assert.equal(process.env.GITHUB_ACTIONS,'true');assert.equal(process.env.RUNNER_ENVIRONMENT,'github-hosted');assert.equal(process.env.RUNNER_OS,'Windows');assert.equal(process.env.RUNNER_ARCH,'X64');assert.equal(process.env.GITHUB_REPOSITORY,'Ginderlax/rea-research-lab');assert.equal(git(['rev-parse','HEAD']).toString('utf8').trim(),process.env.GITHUB_SHA);assert.equal(git(['status','--porcelain=v1','-z','--untracked-files=all']).length,0,'Installed Notes needs a clean committed checkout');}
function committed(row){const bytes=read(repository,row.path);assert.deepEqual(identity(bytes),pin(row));assert.deepEqual(bytes,git(['show','HEAD:'+relative(row.path)]));const gitBlob=createHash('sha1').update(Buffer.from('blob '+bytes.length+'\0')).update(bytes).digest('hex');return{bytes,row:{path:row.path,...identity(bytes),gitBlob}};}
function evidenceRoot(value){assert(path.isAbsolute(value));const root=fs.realpathSync(value),temporary=fs.realpathSync(process.env.RUNNER_TEMP),rel=path.relative(temporary,root);assert(rel&&rel!=='..'&&!rel.startsWith('..'+path.sep)&&!path.isAbsolute(rel));return root;}
function receiptFile(evidence,manifest){assert.equal(path.resolve(manifest).toLowerCase(),path.join(evidence,'notes-installed-source-check.json').toLowerCase());return read(evidence,'notes-installed-source-check.json');}
function write(evidence,name,bytes){relative(name);const filename=path.join(evidence,name);fs.mkdirSync(path.dirname(filename),{recursive:true});fs.writeFileSync(filename,bytes,{flag:'wx'});}
function jsonWrite(evidence,name,value){write(evidence,name,Buffer.from(JSON.stringify(value,null,2)+'\n'));}
function appFiles(directory,depth=0){assert(depth<=32);const rows=[];for(const e of fs.readdirSync(directory,{withFileTypes:true})){assert(!e.isSymbolicLink());if(e.name==='results')continue;const name=path.join(directory,e.name);if(e.isDirectory())rows.push(...appFiles(name,depth+1));else{assert(e.isFile());rows.push(path.relative(studio,name).replaceAll('\\','/'));}}return rows.sort();}
function authenticate(){
 guard();assert.equal(git(['rev-parse','--show-object-format']).toString('utf8').trim(),'sha1');
 assert.equal(NOTES.length,32);assert.equal(new Set(NOTES.map(r=>r.path)).size,32);assert.deepEqual(appFiles(path.join(studio,'apps/notes')),NOTES.map(r=>r.path).sort());
 const currentSources=NOTES.map(row=>committed({path:'products/rea-studio/'+row.path,...pin(row)}).row);
 const bundle=JSON.parse(committed(bundleSource).bytes),browserBundle=JSON.parse(committed(browserBundleSource).bytes),index=JSON.parse(committed(indexSource).bytes);
 assert.equal(bundle.schema,'rea-notes-todo-hosted-source-bundle/v1');assert.equal(bundle.productionInstalled,false);assert.equal(bundle.transitions.length,8);assert.equal(bundle.payloads.length,17);assert.equal(bundle.tests.length,17);assert.equal(bundle.authoredAdditionalGroups,23);assert.equal(bundle.originalHelperComparisons,20);
 const targets=bundle.transitions.map(row=>({path:row.target,...pin(row.after)}));
 for(const row of targets){const actual=currentSources.find(item=>item.path===row.path);assert(actual);assert.deepEqual(pin(actual),pin(row));}
 const sources=[...bundle.payloads.map(row=>({path:'products/rea-studio/experiments/notes-todo/'+row.path,...pin(row)})),bundleSource,browserBundleSource,bundle.originalNote,indexSource,workflowSource,browserResultHelper,...browserBundle.browserSources,browserBundle.contract];
 const dependencies=sources.map(row=>committed(row).row);
 assert.equal(index.schema,'rea-notes-todo-installed-source-publication-map/v1');assert.equal(index.sourceOnly,true);assert.equal(index.actualInstallationReceiptAuthenticated,false);assert.equal(index.currentTargets.length,8);
 assert.equal(browserBundle.schema,'rea-notes-todo-real-browser-source-bundle/v1');assert.equal(browserBundle.productionInstalled,false);assert.equal(browserBundle.browserSources.length,3);assert.equal(browserBundle.scenarios.length,8);assert.equal(new Set(browserBundle.scenarios).size,8);
 const tests=NOTES.filter(row=>row.path.endsWith('.test.mjs')).map(row=>'products/rea-studio/'+row.path).sort();assert.deepEqual(tests,[...bundle.tests].sort());
 const authentication={schema:'rea-Notes-committed-source-authentication/v1',allNotesFiles:32,eligibleNotesSources:30,separateReadme:1,separatePinnedJex:1,exactAfterTargets:8,
  all32NotesGitBlobsAuthenticated:true,all8AfterPinsAuthenticated:true,currentSources,exactTargets:targets,dependencies,
  sourceBundle:bundleSource,browserSourceBundle:browserBundleSource,sourcePublicationIndex:indexSource,installedWorkflow:workflowSource,
  testFiles:17,authoredNewGroups:23,originalHelperComparisonsSeparate:20,browserCases:8,
  frozenReadmeScope:'The exact reviewed README retains its prospective/unexecuted/not-installed proposal wording. Actual committed-source campaigns are recorded separately; that frozen text is not a current acceptance statement.'};
 return{authentication,bundle,browserBundle,roster:browserBundle.scenarios,currentSources,targets:new Set(),status:[]};
}
export function verifyInstalledNotesReceipt(manifest,evidence){
 const proof=authenticate(),root=evidenceRoot(evidence),bytes=receiptFile(root,manifest),value=JSON.parse(bytes);
 assert.equal(value.schema,'rea-Notes-hosted-installed-source-check/v1');assert.equal(value.status,'verified-unexecuted-committed-afterimages');assert.equal(value.mode,'notes-todo-installed');assert.deepEqual(value.execution,execution());assert.equal(value.sourceCommit,process.env.GITHUB_SHA);assert.deepEqual(value.authentication,proof.authentication);assert.equal(value.sourceOnly,true);assert.equal(value.sourceMutationPerformed,false);assert.equal(value.installationPerformedByCommand,false);assert.equal(value.historicalReceiptsRebound,false);assert.equal(value.applicationExecutions+value.originalExecutions+value.browserExecutions,0);
 return{...proof,receipt:identity(bytes),value,evidence:root};
}
export function authenticateInstalledNotesCensus(rows,proof){
 guard();const tree=new Map();for(const item of git(['ls-tree','-r','-z','--full-tree','HEAD','--','products/rea-studio']).toString('utf8').split('\0').filter(Boolean)){const match=/^(100644|100755) blob ([0-9a-f]{40})\t(.+)$/.exec(item);if(match)tree.set(match[3],match[2]);}
 const names=new Set();let noteSources=0;for(const row of rows){const name='products/rea-studio/'+relative(row.path);assert(!names.has(name));names.add(name);const bytes=read(repository,name);assert.deepEqual(identity(bytes),pin(row));assert(tree.has(name));assert.equal(createHash('sha1').update(Buffer.from('blob '+bytes.length+'\0')).update(bytes).digest('hex'),tree.get(name));if(row.path.startsWith('apps/notes/')){assert(proof.currentSources.some(r=>r.path===name&&r.sha256===row.sha256&&r.bytes===row.bytes));noteSources++;}}
 assert.equal(noteSources,30);return{allEligibleGitBlobs:rows.length,allEligibleNotesSources:30,allNotesFiles:32,exactNotesTargets:8,sourceOverlay:false,allOtherEligibleSourcesGitBound:true};
}
export function verifyInstalledNotesPostcheck(evidence,proof){
 const root=evidenceRoot(evidence),bytes=read(root,'notes-installed-postrun-source-check.json'),value=JSON.parse(bytes);assert.equal(value.schema,'rea-Notes-hosted-installed-postrun-source-check/v1');assert.equal(value.status,'source-verified');assert.deepEqual(value.execution,execution());assert.equal(value.sourceCommit,process.env.GITHUB_SHA);assert.equal(value.sourceStable,true);assert.deepEqual(value.beforeReceipt,proof.receipt);assert.deepEqual(value.authentication,proof.authentication);assert.equal(value.applicationExecutions+value.originalExecutions+value.browserExecutions,0);return identity(bytes);
}
async function command(){
 assert.equal(process.argv.length,6);assert.equal(process.argv[2],'--phase');assert(['before','after'].includes(process.argv[3]));assert.equal(process.argv[4],'--evidence');guard();
 const root=evidenceRoot(process.argv[5]),phase=process.argv[3];
 const value={schema:phase==='before'?'rea-Notes-hosted-installed-source-check/v1':'rea-Notes-hosted-installed-postrun-source-check/v1',status:'running',phase,mode:'notes-todo-installed',sourceOnly:true,sourceCommit:process.env.GITHUB_SHA,execution:execution(),sourceMutationPerformed:false,installationPerformedByCommand:false,productionInstallationReceiptAuthenticated:false,historicalReceiptsRebound:false,applicationExecutions:0,originalExecutions:0,browserExecutions:0,fullParity:false,superiority:false};
 const name=phase==='before'?'notes-installed-source-check.json':'notes-installed-postrun-source-check.json';
 try{const proof=authenticate();value.authentication=proof.authentication;if(phase==='before'){
   for(const row of proof.authentication.currentSources)write(root,'installed-source/'+row.path+'.snapshot',read(repository,row.path));
   for(const row of proof.authentication.dependencies)write(root,'installed-dependencies/'+row.path+'.snapshot',read(repository,row.path));
   value.status='verified-unexecuted-committed-afterimages';
  }else{const previous=verifyInstalledNotesReceipt(path.join(root,'notes-installed-source-check.json'),root);assert.deepEqual(previous.authentication,proof.authentication);value.beforeReceipt=previous.receipt;value.sourceStable=true;value.status='source-verified';}
 }catch(error){value.status='failed';value.failure={name:error.name,message:error.message};process.exitCode=1;}
 jsonWrite(root,name,value);console.log(JSON.stringify({phase,status:value.status,sourceCommit:value.sourceCommit,allNotesFiles:value.authentication?.allNotesFiles??null}));
}
if(process.argv[1]&&path.resolve(process.argv[1])===path.resolve(fileURLToPath(import.meta.url)))await command();
