    },
    {
      "id": "grafana.candidate.224a6b80e0f5c5287982",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "[Auditing](../../setup-grafana/configure-security/audit-grafana/) was updated to reflect these changes.",
      "headingPath": [
