    },
    {
      "id": "grafana.candidate.efed881b5b012ee531dc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Afterward, you will have two contexts set up; one for your local Grafana OSS/Enterprise installation and one for Grafana Cloud. The `grr config use-context` command allows you to switch between the two instances while using Grizzly.",
      "headingPath": [
        "Migrate from Grafana OSS/Enterprise to Grafana Cloud manually",
        "Migrate Grafana resources",
        "Migrate dashboards, folders, data sources, library panels, and alert rules using Grizzly"
      ],
      "source": {
        "path": "docs/sources/administration/migration-guide/manually-migrate-to-grafana-cloud.md",
        "gitBlobSha": "ec67ca7782261b3d96c30c162036cf6fe27e88b5",
        "sha256": "c9d95a24ed04bfff932d37d3bc549d6e090c208de06681aefa008a7d06eef4b7",
        "lineStart": 172,
        "lineEnd": 172,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/migration-guide/manually-migrate-to-grafana-cloud.md#L172-L172"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": []
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
