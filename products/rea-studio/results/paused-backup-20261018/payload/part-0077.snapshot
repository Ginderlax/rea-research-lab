    {
      "id": "grafana.candidate.dd7336bce4628c2fc6fe",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Launch the Grafana container, using our custom `grafana.ini` to replace `/etc/grafana/grafana.ini`. We don't expose any ports for this container as it will only be connected to by our Apache container.",
