from pathlib import Path
import base64,copy,gzip,hashlib,io,json,subprocess,zipfile

BASE=Path(__file__).resolve().parent.parent
W=BASE/'work';LAB=BASE/'outputs/rea-research-lab'
RUN=W/'cloud-verification-backups/run-38922041634'
BACKUP=RUN/'artifact-12055985724';E=BACKUP/'readable-evidence'
ident=lambda b:{'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def read(p):
    assert p.is_file() and not p.is_symlink(),str(p)
    return p.read_bytes()
def load(p):return json.loads(read(p).decode('utf-8-sig'))
def pin(b,r):assert ident(b)=={k:r[k] for k in ('bytes','sha256')}
def git(args):return subprocess.run(['git','-C',str(LAB),*args],capture_output=True,check=True).stdout

collection=load(RUN/'collection-summary.json')
assert collection['runId']=='38922041634' and collection['jobId']=='117044145324'
assert collection['headSHA']=='25b54d733ad6fd59a0b0d2a28fad3d6fa014700a'
assert collection['runStatus']=='completed' and collection['runConclusion']==collection['jobConclusion']=='success'
for r in collection['metadata']:pin(read(Path(r['path'])),r)
pin(read(Path(collection['rawJobLog']['path'])),collection['rawJobLog'])
assert {r['kind'] for r in collection['metadata']}=={'run','jobs','artifacts'}
raw_metadata={r['kind']:load(Path(r['path'])) for r in collection['metadata']}
assert raw_metadata['run']['id']==38922041634 and raw_metadata['run']['head_sha']==collection['headSHA']
assert raw_metadata['run']['status']=='completed' and raw_metadata['run']['conclusion']=='success'
jobs=raw_metadata['jobs']['jobs'];assert len(jobs)==raw_metadata['jobs']['total_count']==1
assert jobs[0]['id']==117044145324 and jobs[0]['status']=='completed' and jobs[0]['conclusion']=='success'
arts=raw_metadata['artifacts']['artifacts'];assert len(arts)==raw_metadata['artifacts']['total_count']==1
assert arts[0]['id']==12055985724 and arts[0]['expired'] is False
outer=read(RUN/'artifact-12055985724.zip')
assert ident(outer)=={'bytes':3284328,'sha256':'3512d5e1d084377e20ccbace34d38fb07ca12b99b389029c6c43f57bec4b05d6'}
assert arts[0]['digest']=='sha256:'+ident(outer)['sha256']
verification=load(BACKUP/'local-backup-verification.json');files=verification['files']
assert len(files)==92 and len({r['path'] for r in files})==92
for r in files:pin(read(E/r['path']),r)
with zipfile.ZipFile(io.BytesIO(outer)) as z:
    assert z.testzip() is None and len(z.namelist())==1
    inner=z.read(z.namelist()[0])
with zipfile.ZipFile(io.BytesIO(inner)) as z:
    assert z.testzip() is None
    names=[n for n in z.namelist() if not n.endswith('/')]
    assert len(names)==92 and set(names)=={r['path'] for r in files}
    for n in names:assert z.read(n)==read(E/n)
attempt=load(E/'attempt-validation.json');controls=load(E/'controls.json')
assert attempt['status']=='passed' and attempt['sourceCommit']=='fee4a29bf635d42f54fa069bd0aa1268fcb7ff8a'
assert attempt['execution']['GITHUB_RUN_ID']=='38922041634' and attempt['execution']['GITHUB_RUN_ATTEMPT']=='1'
assert attempt['execution']['RUNNER_ENVIRONMENT']=='github-hosted' and attempt['execution']['RUNNER_OS']=='Windows'
assert attempt['runtime']=='v24.16.0' and attempt['candidateOverlay'] is False
assert attempt['controls']=={'status':'passed','checks':208}
assert controls['status']=='passed' and controls['sourceOnly'] is True
rows=controls['rows'];assert len(rows)==len({r['name'] for r in rows})==208 and all(r['passed'] is True for r in rows)
assert sum(r['name']=='four-fixed-followup-verifier-epochs' for r in rows)==1
assert not any(r['name']=='three-fixed-followup-verifier-epochs' for r in rows)
events=[json.loads(s) for s in read(E/'events.jsonl').decode().splitlines()]
started=[r for r in events if r['type']=='control-started'];passed=[r for r in events if r['type']=='control-passed']
assert len(started)==len(passed)==208
assert [r['name'] for r in started]==[r['name'] for r in passed]==[r['name'] for r in rows]
assert events[-1]['type']=='terminal' and events[-1]['status']=='passed'
phases=attempt['phases'];assert [r['name'] for r in phases]==['publication-write','publication-recheck']
for i,p in enumerate(phases):
    assert p['status']=='passed' and p['exitCode']==0 and p['signal'] is None and p['closeObserved'] is True
    assert p['failure'] is None and p['droppedBytes']==p['stderrBytes']==0 and p['stdoutBytes']==36890
    expected=['scripts/verify-records.mjs']+(['--write'] if i==0 else [])
    assert p['command'][1:]==expected and p['command'][0].endswith('node.exe')
    stdout=read(E/(p['name']+'.stdout.txt'));stderr=read(E/(p['name']+'.stderr.txt'))
    assert len(stdout)==p['stdoutBytes'] and stderr==b''
    pin(stdout,attempt['repeatComparison'][('first','second')[i]]['rawStdout'])
first=json.loads(read(E/'publication-write.stdout.txt'));second=json.loads(read(E/'publication-recheck.stdout.txt'))
assert first['status']==second['status']=='passed'
assert first['javascript_syntax_checks']==second['javascript_syntax_checks']==959
assert first['payload_files']==second['payload_files']==28386
assert first['payload_bytes']==second['payload_bytes']==1342588854
# Only named observer clocks vary; compare every other retained root result recursively.
def project(x):
    x=copy.deepcopy(x);x.pop('checked_at_utc',None)
    for k in ('sketch_verification','sketchVerification'):
        if isinstance(x.get(k),dict):
            x[k].pop('startedAt',None);x[k].pop('finishedAt',None)
    return x
assert attempt['repeatComparison']['status']=='passed'
assert attempt['repeatComparison']['onlyNamedObservationClocksProjected'] is True
assert attempt['repeatComparison']['allOtherFieldsDeepEqual'] is True
assert attempt['payloadBefore']==attempt['payloadAfter'] and attempt['payloadStable'] is True
assert attempt['payloadBefore']['files']==28386 and attempt['payloadBefore']['bytes']==1342588854
assert attempt['derivedWorktreePaths']==['PUBLICATION-MANIFEST.json','VALIDATION.json']
assert {r['path'] for r in attempt['derived']}=={'PUBLICATION-MANIFEST.json','VALIDATION.json'}
for r in attempt['derived']:pin(read(E/'derived'/r['path']),r)
pin(read(E/'derived/PUBLICATION-MANIFEST.json'),attempt['generatedManifest'])
assert attempt['generatedManifestValidated'] is True and attempt['firstRootWritePassed'] is True
assert attempt['applicationTestsExecuted']==attempt['originalExecutions']==0
for k in ('historicalReceiptsRewritten','fullDevelopmentSuiteAcceptance','fullParity','superiority'):assert attempt[k] is False
envelope_meta=attempt['notesSourceProofEnvelope'];stored=read(E/envelope_meta['path']);pin(stored,envelope_meta['stored'])
expanded=gzip.decompress(stored);pin(expanded,envelope_meta['decoded']);envelope=json.loads(expanded)
assert envelope['sourceCommit']==attempt['sourceCommit'] and envelope['sourceFiles']==len(envelope['rows'])==56
assert envelope_meta['sourceFiles']==56 and envelope_meta['proofSourceFiles']==52 and envelope_meta['installedToolingSourceFiles']==4
assert envelope['rawSourceBytes']==sum(r['bytes'] for r in envelope['rows'])==1243634
assert len({r['path'] for r in envelope['rows']})==56
assert sum(r.get('group')=='installed-Notes-tooling' for r in envelope['rows'])==4
assert git(['rev-parse',collection['headSHA']+'^{tree}']).decode().strip()==attempt['gitTree']=='ba8bbd8c4b30772d12521e65bed2478cce7b8704'
tree={}
for line in git(['ls-tree','-rz',attempt['gitTree']]).split(b'\0'):
    if line:
        meta,name=line.split(b'\t',1);mode,kind,blob=meta.split()
        if kind==b'blob':tree[name.decode()]=blob.decode()
for r in envelope['rows']:
    data=base64.b64decode(r['base64'],validate=True);pin(data,r);assert r['bytes']<=262144
    assert hashlib.sha1(b'blob '+str(len(data)).encode()+b'\0'+data).hexdigest()==tree[r['path']]
report={'schema':'rea-independent-publication208-success-portable-byte-audit/v1','status':'passed','runId':38922041634,'jobId':117044145324,'branchHead':collection['headSHA'],'testedMerge':attempt['sourceCommit'],'recordedTestedTree':attempt['gitTree'],'headTreeIndependentlyMatchesRecordedTestedTree':True,'actualOuterZip':ident(outer),'all92UploadedMembersCrcHashAndReadbackExact':True,'controlGroups':208,'allControlRowsAndStartedPassedEventsMatchOnce':True,'correctedFourEpochControlPassed':True,'bothRootWriteAndRecheckPhasesPassed':True,'syntaxChecks':959,'stablePayloadFiles':28386,'stablePayloadBytes':1342588854,'notesProofRows':52,'separateInstalledToolingRows':4,'all56EnvelopeSourceBytesAndGitBlobsIndependentlyMatch':True,'historicalReceiptsRewritten':False,'behavioralTestsRerunByThisPublication':0,'localProductExecutions':0,'localTests':0,'localBuilds':0,'localCandidateImports':0,'localSyntaxChecks':0,'errors':[]}
out=W/'publication208-success-38922041634-independent-byte-audit.json'
out.write_text(json.dumps(report,indent=2)+'\n',encoding='utf8')
print(json.dumps({'report':str(out),'identity':ident(read(out))}))
