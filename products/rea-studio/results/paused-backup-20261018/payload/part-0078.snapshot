    {
      "id": "grafana.candidate.48773fccc320524454af",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The following examples show how to create correlations using the Correlations Editor in Explore. If you'd like to follow these examples, make sure to set up a [test data source](/docs/grafana/<GRAFANA_VERSION>/datasources/testdata/#testdata-data-source).",
