    {
      "id": "grafana.candidate.dce364d1f11565cf4159",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The **Service graph** setting configures the [Service Graph](https://grafana.com/docs/tempo/<TEMPO_VERSION>/metrics-from-traces/service_graphs/enable-service-graphs/) data.",
      "headingPath": [
        "Additional settings",
        "Service graph"
      ],
      "source": {
        "path": "docs/sources/datasources/tempo/configure-tempo-data-source/additional-settings.md",
