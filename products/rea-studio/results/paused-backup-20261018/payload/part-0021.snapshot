from pathlib import Path
import json,hashlib
W=Path(r'C:/Users/evanh/Documents/Codex/2026-10-12/go/work')
R=W.parent/'outputs/rea-research-lab'
S=W/'notes36-installed-implementation-next'
C=S/'public-candidate'
def pin(b):return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def current(p):return(R/p).read_bytes()
def write(p,b):
 f=C/p;f.parent.mkdir(parents=True,exist_ok=True);assert not f.exists(),p;f.write_bytes(b)
def object(p):return json.loads(current(p))
inv=json.loads((W/'notes36-installed-architecture-r2-next/source-inventory.json').read_bytes())
assert inv['sourceCommit']=='d24db80660e2af640882ad48c01174b27ffcda51'
for row in inv['protectedSourcePins']:assert pin(current(row['path']))=={k:row[k]for k in['bytes','sha256']},row['path']
bp='products/rea-studio/experiments/notes-new-todo/bundle.json'
b=object(bp)
prefix='products/rea-studio/results/notes36-source-transition-20261016/'
declaration=prefix+'current-source-declaration.json'
for row in b['transitions']:
 if row['before']:assert pin(current(row['path']))==row['before']
 else:assert not(R/row['path']).exists()
 content=current(row['afterImage']['path']);assert pin(content)==row['after'];write(row['path'],content)
oldflows=['.github/workflows/notes-installed-cloud.yml','.github/workflows/notes-new-todo-experiment-cloud.yml']
flowhistory=[]
for name in oldflows:
 stored=prefix+'historical-workflows/'+Path(name).name+'.snapshot';content=current(name);write(stored,content);flowhistory.append({'sourcePath':name,'storedPath':stored,**pin(content),'sourceEpoch':inv['sourceCommit'],'historicalOnly':True})
legacy=[]
transitions={r['path']:r for r in b['transitions']}
for row in inv['legacy52Proof']['objects']:
 p=row['path'];target=transitions.get(p)
 physical=target['beforeImage']['path'] if target and target['before'] else p
 assert pin(current(physical))==row['stored']
 legacy.append({'sourcePath':p,'readPath':physical,**row['stored'],'sourceRole':'historical32-proof','liveCurrent':False if physical!=p else None})
assert len(legacy)==52 and len({r['sourcePath']for r in legacy})==52 and len({r['readPath']for r in legacy})==52
legacytools=[]
for p,pair in inv['legacy56PublicationEnvelope']['tooling'].items():
 alias=next((r for r in flowhistory if r['sourcePath']==p),None)
 legacytools.append({'sourcePath':p,'readPath':alias['storedPath'] if alias else p,'bytes':pair[0],'sha256':pair[1],'sourceRole':'historical32-installed-tooling','historicalOnly':True})
rows=[{'path':r['path'],'bytes':r['bytes'],'sha256':r['sha256'],'groups':r['groups']}for r in inv['future60Proof']['rows']if r['path']!='.github/workflows/notes-new-todo-experiment-cloud.yml']
assert len(rows)==59 and len({r['path']for r in rows})==59 and declaration not in {r['path']for r in rows}
decl={'schema':'rea-Notes36-current-source-declaration/v1','sourceOnly':True,'status':'reviewed-source-proposal-not-behavioral-receipt','sourceBaselineCommit':inv['sourceCommit'],
 'sourceInstallationPerformedByDeclaration':False,'actualInstalledBehaviorAccepted':False,'historicalReceiptsRebound':False,'requirementRegistriesRewritten':False,
 'externalDeclarationPinRequired':True,'selfIdentityContained':False,'otherProofRows':rows,'otherProofRowCount':59,'combinedProofRowCount':60,'proofFileLimit':64,'proofByteLimit':8*1024*1024,'proofIndividualByteLimit':256*1024,
 'currentNotesSources':b['composedNotesSources'],'allNotesFiles':36,'eligibleNotesSources':34,'separateReadmeFiles':1,'separatePinnedJexFiles':1,'installedTargets':b['transitions'],'installedTargetCount':7,'eligibleInstalledTargets':6,'newFiles':4,'replacedFiles':3,
 'frozenFeatureBundle':{'path':bp,**pin(current(bp))},'frozenFeatureAuthority':b['featureAuthority'],'frozenFeatureIndependentPeer':b['featureIndependentPeer'],
 'fixedTests':b['fixedTests'],'finiteGroups':111,'oldNamedGroupsRequired':b['oldNamedGroupsRequired'],'newNamedGroupsRequired':b['newNamedGroupsRequired'],'separateComparisonCounts':b['separateComparisonCounts'],
 'browserCases':8,'browserScenarios':object('products/rea-studio/browser-tests/notes-new-todo-roster.json'),'successfulResponseHolds':3,'failedResponseHolds':1,'genuineList400Faults':2,'actualDownloads':2,'completeOwnedCleanups':8,
 'legacy52LogicalToPhysicalRows':legacy,'legacy52Rows':52,'legacyInstalledToolingRows':legacytools,'legacy56Rows':56,'historicalWorkflowSources':flowhistory,
 'interpretation':'Frozen R5 payloads/README and prior bundles retain their historical proposal language. This declaration separately pins current36 source identities. It performs no copy, original GUI/database run or behavioral acceptance. Every current app and eligible active Git blob is mandatory; no composition/exclusion is permitted. A future fresh committed-source111/8 and full-suite/publication campaign is required.'}
db=(json.dumps(decl,indent=2)+'\n').encode();write(declaration,db)
helper=(W/'notes36-helper-template.mjs').read_text(encoding='utf-8')
assert helper.count('PENDING_DECLARATION_BYTES')==1 and helper.count('PENDING_DECLARATION_SHA256')==1
helper=helper.replace('PENDING_DECLARATION_BYTES',str(len(db))).replace('PENDING_DECLARATION_SHA256',pin(db)['sha256'])
hp='products/rea-studio/scripts/verify-notes36-installed-cloud.mjs';write(hp,helper.encode())
files=[]
for f in sorted(C.rglob('*')):
 if f.is_file():
  p=f.relative_to(C).as_posix();before=pin(current(p))if(R/p).is_file()else None;files.append({'path':p,'before':before,'after':pin(f.read_bytes())})
authority={'schema':'rea-Notes36-phase1-source-authority/v1','sourceOnly':True,'sourceCommit':inv['sourceCommit'],'candidateRoot':str(C),'files':files,'candidateFiles':len(files),'applicationTargets':7,'currentNotesSources':36,'declarationOtherRows':59,'combinedProofRows':60,'proofLimits':{'files':64,'bytes':8*1024*1024,'individualBytes':256*1024},'legacyLogicalPhysicalRows':52,'legacyToolingRows':4,'oldHelperComposerCollectorsReceiptsChanged':False,'applicationInstallationPerformed':False,'candidateExecutions':0,'sourceAuthor':{'path':'work/author-notes36-phase1.py',**pin(Path(__file__).read_bytes())}}
S.mkdir(exist_ok=True);(S/'phase1-authority.json').write_text(json.dumps(authority,indent=2)+'\n',encoding='utf-8')
print(json.dumps({'authority':pin((S/'phase1-authority.json').read_bytes()),'declaration':{'path':declaration,**pin(db)},'helper':{'path':hp,**pin(helper.encode())},'candidateFiles':len(files),'current60Bytes':sum(r['bytes']for r in rows)+len(db)},indent=2))
