// Separate correction of an own source-only collector assumption; no GUI rerun.
import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';const root=import.meta.dirname,hash=b=>createHash('sha256').update(b).digest('hex'),before=await fs.readFile(path.join(root,'finalize.mjs'));let text=before.toString();const changes=[
 ["json=async(p,v)=>fs.writeFile(path.join(root,p),JSON.stringify(v,null,2)+'\\n',{flag:'wx'})","json=async(p,v)=>{const b=Buffer.from(JSON.stringify(v,null,2)+'\\n');try{await fs.writeFile(path.join(root,p),b,{flag:'wx'});}catch(e){if(e.code!=='EEXIST')throw e;assert.deepEqual(await read(p),b,'Retained successful partial output must remain exact: '+p);}}"],
 ["assert.ok(api.every(r=>r.upstreamStatus===200&&r.response.ok));","assert.ok(api.every(r=>r.upstreamStatus===200&&r.response.result&&!Object.hasOwn(r.response,'error')));"],
];for(const[a,b]of changes){assert.equal(text.split(a).length-1,1);text=text.replace(a,b);}await fs.writeFile(path.join(root,'finalize-v2.mjs'),text,{flag:'wx'});const ledger={schema:'rea-sketch-browser-source-only-finalizer-correction/v1',oldSource:{path:'finalize.mjs',bytes:before.length,sha256:hash(before)},newSource:{path:'finalize-v2.mjs',bytes:Buffer.byteLength(text),sha256:hash(text)},changes:changes.map(([before,after])=>({before,after})),failedAttempt:{source:'finalize.mjs',stdout:'finalize.stdout.txt',stderr:'finalize.stderr.txt',exitCode:1,cause:'Own collector expected nonexisting JSON ok flag. Authenticated actual host success envelope is {result}; HTTP status and result/error envelope are the correct evidence.',successfulPartialAuthorityAfterPreserved:true},appFinding:false,GUIReruns:0,candidateChanges:0,StudioWrites:0};await fs.writeFile(path.join(root,'finalizer-correction.json'),JSON.stringify(ledger,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({sourceOnlyCorrection:true,GUIReruns:0,changes:2}));
