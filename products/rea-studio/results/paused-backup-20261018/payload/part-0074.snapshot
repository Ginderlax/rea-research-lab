    {
      "id": "grafana.candidate.a335e00034896365e1c2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To administer, update, or delete your plugins, or to submit a new plugin, sign in to the [Plugins Admin page](https://grafana.com/orgs/grafana/plugins). Note that you need to be an administrator for the Grafana Cloud organization being used to publish the plugin.",
      "headingPath": [
        "Plugin management",
        "Advanced options",
        "Learn more"
      ],
      "source": {
        "path": "docs/sources/administration/plugin-management/_index.md",
        "gitBlobSha": "1dfa1a5dc30d517b03eea082166f35ef2ad7832d",
        "sha256": "41a275a3b91c3236cb8e56a77d0aaf420d0549ae95f3c41a69bd3c77a9df4497",
        "lineStart": 141,
        "lineEnd": 141,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/plugin-management/_index.md#L141-L141"
      },
      "applicability": {
        "status": "mixed-edition-statement-requires-review",
        "products": [
          "enterprise",
          "cloud",
          "oss"
        ]
