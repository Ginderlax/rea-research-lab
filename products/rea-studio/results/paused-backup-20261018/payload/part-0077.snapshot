    {
      "id": "grafana.candidate.4d07d974931e9a4628a7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The duration in time a verification email, used to update the email address of a user, remains valid before expiring. This setting should be expressed as a duration. Examples: 6h (hours), 2d (days), 1w (week). Default is 1h (1 hour).",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[users]`",
        "`verification_email_max_lifetime_duration`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
