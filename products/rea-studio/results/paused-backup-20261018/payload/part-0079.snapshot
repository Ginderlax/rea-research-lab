    },
    {
      "id": "grafana.candidate.3706a1d54324d7d69c0d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Data source plugin developers can now use any plugin to visualize data in Explore. Similar to `preferredVisualizationType`, we've introduced an experimental API to render visualizations by plugin ID. In the returned data frame, set the meta option `preferredVisualisationPluginId` to the plugin ID you want to be used when showing the data for given data frame.",
      "headingPath": [
        "What’s new in Grafana v10.1",
        "Explore",
        "Panel plugins in Explore"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-1.md",
