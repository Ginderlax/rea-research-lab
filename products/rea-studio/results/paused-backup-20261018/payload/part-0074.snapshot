    },
    {
      "id": "grafana.candidate.9ae824e7e6025b68e9e9",
      "syntaxRole": "list-item",
      "sourceText": "- For logs: `{namespace=\"dev\", cluster=\"us-west-0\"}` filters log lines matching both `namespace=\"dev\"` and `cluster=\"us-west-0\"`.",
      "headingPath": [
        "Create LBAC for data source rule",
        "Before you begin",
        "LBAC rule"
      ],
