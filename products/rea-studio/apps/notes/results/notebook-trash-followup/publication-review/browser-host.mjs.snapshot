import fs from 'node:fs/promises';import path from 'node:path';import os from 'node:os';import {createServer} from 'node:http';
import {start} from '../notes-trash-publication-fix-next/products/rea-studio/server.mjs';
const root=import.meta.dirname,temporary=await fs.mkdtemp(path.join(os.tmpdir(),'rea-notes-fixed-review-')),observations=[];let upstream=await start({port:0,dataDir:temporary}),armed=null,held=[],closing=false;
async function api(action,input={}){const r=await fetch(upstream.url+'/api/notes/'+action,{method:'POST',headers:{'content-type':'application/json','x-rea-token':upstream.token},body:JSON.stringify(input),signal:AbortSignal.timeout(10000)}),value=await r.json();if(!r.ok)throw new Error(action+' '+value.error);return value.result;}
let tree=await api('notebook-create',{title:'Browser parent',revision:0});const parent=tree.notebook.id;tree=await api('notebook-create',{title:'Browser child',parentId:parent,revision:tree.revision});const child=tree.notebook.id,note=await api('save',{title:'Owned browser note',body:'Owned saved browser body',notebookId:child,tags:['owned']});
const app=new URL('../notes-trash-publication-fix-next/products/rea-studio/apps/notes/',import.meta.url);
const preview=createServer(async(req,res)=>{try{const url=new URL(req.url,'http://127.0.0.1'),send=(code,b,type='application/json')=>{res.writeHead(code,{'content-type':type,'cache-control':'no-store'});res.end(type==='application/json'?JSON.stringify(b):b);};if(req.method==='GET'&&url.pathname==='/'){return send(200,'<!doctype html><meta charset="utf-8"><title>Owned Notes correction review</title><style>body{font:16px system-ui;margin:24px}input,select,textarea,button{margin:6px;padding:8px}textarea{display:block;width:800px}button{cursor:pointer}.card{padding:12px;border:1px solid #ccc;margin:12px 0}.row{display:flex;flex-wrap:wrap}</style><main></main><script type="module" src="/browser-preview.mjs"></script>','text/html');}if(req.method==='GET'&&url.pathname==='/browser-preview.mjs')return send(200,await fs.readFile(path.join(root,'browser-preview.mjs')),'text/javascript');if(req.method==='GET'&&/^\/apps\/notes\/(client|markdown)\.mjs$/.test(url.pathname))return send(200,await fs.readFile(new URL(path.basename(url.pathname),app)),'text/javascript');if(req.method==='GET'&&url.pathname==='/control'){const operation=url.searchParams.get('op');if(operation==='arm'){const value=url.searchParams.get('action');if(!['save','list','notebook-list'].includes(value))throw new Error('Unsupported synthetic hold action');armed=value;}else if(operation==='release'){for(const item of held)item.release();held=[];}else if(operation==='state'){const state=await api('get',{id:note.id});return send(200,{note:state,tree:await api('notebook-list'),heldActions:held.map(h=>h.action),observations});}else if(operation==='restart'){if(held.length)throw new Error('Release held response first');await upstream.close();upstream=await start({port:0,dataDir:temporary});observations.push({kind:'upstreamHostReopen',url:upstream.url,processRestart:false});}else if(operation==='close'){send(200,{closing:true});setImmediate(close);return;}return send(200,{armed,heldActions:held.map(h=>h.action)});}if(url.pathname==='/api/session'){const r=await fetch(upstream.url+'/api/session');return send(r.status,await r.json());}if(req.method==='POST'&&/^\/api\/notes\/[a-z-]+$/.test(url.pathname)){const chunks=[];let size=0;for await(const c of req){size+=c.length;if(size>512*1024)throw new Error('Synthetic browser request budget');chunks.push(c);}const input=JSON.parse(Buffer.concat(chunks).toString()||'{}'),action=url.pathname.split('/').at(-1),r=await fetch(upstream.url+url.pathname,{method:'POST',headers:{'content-type':'application/json','x-rea-token':upstream.token},body:JSON.stringify(input),signal:AbortSignal.timeout(10000)}),value=await r.json();observations.push({kind:'request',action,input,result:value,status:r.status});if(action===armed){armed=null;await new Promise(release=>held.push({action,release}));}return send(r.status,value);}return send(404,{error:'Private review route unavailable'});}catch(e){res.writeHead(500,{'content-type':'application/json'});res.end(JSON.stringify({error:e.message}));}});
await new Promise(r=>preview.listen(0,'127.0.0.1',r));const url='http://127.0.0.1:'+preview.address().port;await fs.writeFile(path.join(root,'browser-host.json'),JSON.stringify({url,parent,child,noteId:note.id,source:'Actual fixed client served unchanged; private HTML/transport relay to actual frozen shared HTTP host',upstreamURL:upstream.url},null,2)+'\n');console.log(JSON.stringify({url,parent,child,noteId:note.id}));
async function close(){if(closing)return;closing=true;for(const item of held)item.release();held=[];await new Promise(r=>preview.close(r));await upstream.close();if(path.dirname(temporary)!==path.resolve(os.tmpdir())||!path.basename(temporary).startsWith('rea-notes-fixed-review-'))throw new Error('Unsafe cleanup');await fs.rm(temporary,{recursive:true,force:true});await fs.writeFile(path.join(root,'browser-server-observations.json'),JSON.stringify({observations,cleanup:{temporaryRemoved:true,upstreamClosed:true,previewClosed:true},counts:{hostProcessCount:1,upstreamHostStarts:1+observations.filter(o=>o.kind==='upstreamHostReopen').length,upstreamSameProcessReopens:observations.filter(o=>o.kind==='upstreamHostReopen').length,originalExecutions:0},scope:'Owned proxy delays completed actual HTTP responses; unchanged candidate client in real browser. Restart operation is same-process host reopen, not process restart.'},null,2)+'\n');console.log('OWNED_NOTES_REVIEW_CLOSED');}
process.on('SIGINT',close);process.on('SIGTERM',close);setTimeout(()=>close(),10*60*1000).unref();
