import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{fileURLToPath}from'node:url';
const here=fileURLToPath(new URL('./',import.meta.url)),workspace=fileURLToPath(new URL('../../',import.meta.url)),repo=path.join(workspace,'outputs/rea-research-lab'),hash=b=>createHash('sha256').update(b).digest('hex'),ident=async p=>{const b=await fs.readFile(p);return{bytes:b.length,sha256:hash(b)}},read=async n=>JSON.parse(await fs.readFile(path.join(here,n))),write=async(n,x)=>fs.writeFile(path.join(here,n),JSON.stringify(x,null,2)+'\n',{flag:'wx'});
const map=await read('selected-file-map.final.json'),docs=await read('documentation-map.json'),requirements=await read('requirements-binding.json'),baseline=await read('production-reference-baseline.json'),auth=await read('authentication.json'),classification=await read('content-classification.json');
async function walk(dir,prefix='',skipLocal=false){const rows=[];for(const e of await fs.readdir(dir,{withFileTypes:true})){assert(!e.isSymbolicLink());const rel=prefix+e.name;if(e.isDirectory()){if(!(skipLocal&&rel==='.local'))rows.push(...await walk(path.join(dir,e.name),rel+'/',skipLocal));}else rows.push(rel);}return rows.sort();}
const stageAfter=[];for(const e of map.epochs){const base=path.join(workspace,e.folder);assert.deepEqual(await ident(path.join(base,e.manifestName)),e.manifest);assert.deepEqual(await ident(path.join(base,e.receiptName)),e.receipt);assert.deepEqual(await ident(path.join(base,e.freezeName)),e.freeze);const m=JSON.parse(await fs.readFile(path.join(base,e.manifestName))),rows=m.files??m.records;assert.equal(rows.length,e.count);assert.deepEqual((await walk(base,'',e.skipLocal)).filter(p=>![e.manifestName,e.freezeName].includes(p)),rows.map(r=>r.path).sort());for(const r of rows)assert.deepEqual(await ident(path.join(base,r.path)),{bytes:r.bytes,sha256:r.sha256});stageAfter.push({id:e.id,count:e.count,receipt:e.receipt,manifest:e.manifest,freeze:e.freeze,strictInventoryExact:true});}
for(const r of baseline.sourceFiles)assert.deepEqual(await ident(path.join(repo,r.path)),{bytes:r.bytes,sha256:r.sha256});for(const r of baseline.selectedCurrentHistory)assert.deepEqual(await ident(path.join(repo,r.path)),{bytes:r.bytes,sha256:r.sha256});for(const r of requirements.registries)assert.deepEqual(await ident(path.join(repo,r.path)),{bytes:r.bytes,sha256:r.sha256});assert.deepEqual(await ident(path.join(repo,requirements.priorSupplementBinding.path)),{bytes:requirements.priorSupplementBinding.bytes,sha256:requirements.priorSupplementBinding.sha256});assert.deepEqual(auth.productionBefore,auth.productionAfter);
const publicRows=map.payload.filter(r=>r.publicPath),unique=new Map(publicRows.map(r=>[r.sha256,r]));assert.equal(unique.size,471);assert.equal(map.payload.length,858);assert.equal(map.excludedNativeCarriers.length,1);for(const r of publicRows)assert(!r.publicPath.split('/').includes('.local'));
const installation=[];for(const r of map.install){if(r.kind==='runtime'||r.action==='add'){const x=await ident(path.join(workspace,r.source));assert.deepEqual(x,{bytes:r.bytes,sha256:r.sha256});installation.push({destination:r.destination,action:r.action,...x});}else if(r.proposedBytesPath){const x=await ident(path.join(here,r.proposedBytesPath));assert.deepEqual(x,r.proposedIdentity);assert.deepEqual(await ident(path.join(workspace,r.source)),r.sourceIdentity);installation.push({destination:r.destination,action:r.action,adapter: r.proposedBytesPath,...x});}else if(r.action==='retain-exact'){const x=await ident(path.join(repo,r.destination));assert.deepEqual(x,{bytes:r.bytes,sha256:r.sha256});installation.push({destination:r.destination,action:r.action,...x});}}
for(const r of docs.docs)assert.deepEqual(await ident(path.join(here,r.source)),{bytes:r.bytes,sha256:r.sha256});
const history=JSON.parse(await fs.readFile(path.join(repo,baseline.selectedCurrentHistory[0].path)));assert.equal(history.summary.tests,41);assert.equal(history.originalAccounting.assemblyLoads,24);const proposedTests=[...history.selectedTests,...['recycle.test.mjs','recycle-server.test.mjs','recycle-ui.test.mjs','recycle-http.test.mjs','recycle-original.test.mjs','recycle-boundaries.test.mjs','recycle-confirmation.test.mjs','recycle-controls.test.mjs'].map(n=>'apps/vault/'+n)];await write('proposed-focused-selection.json',{schema:'rea-vault-recycle-prospective-focused-selection/v1',cwd:'products/rea-studio',testFiles:proposedTests,commandArguments:['--test','--test-concurrency=1',...proposedTests],expectedGroups:79,formula:'41+27+5+2+4',executed:false,ordinaryLegacyTestsAdditional:true,originalFixtureAcquisitionRequired:true,resultsOutputMustBeOutsideAppsResults:true});
const ownPayload=[];for(const rel of await walk(here)){if(['manifest.json','freeze.json'].includes(rel))continue;const b=await fs.readFile(path.join(here,rel));assert(!['4d5a','504b0304','504b0506','1f8b','377abcaf271c','03d9a29a67fb4bb5'].some(s=>b.subarray(0,s.length/2).toString('hex')===s),rel);ownPayload.push({path:rel,bytes:b.length,sha256:hash(b)});}
await write('failure-ledger.json',{schema:'rea-vault-publication-plan-own-failures/v1',failures:[{id:'documentation-collector-v1',classification:'Own syntax failure before all execution; await occurred in synchronous map callback.',source:'write-docs.v1.mjs.snapshot',...await ident(path.join(here,'write-docs.v1.mjs.snapshot')),stderr:{path:'write-docs.stderr.txt',...await ident(path.join(here,'write-docs.stderr.txt'))},candidateExecuted:false},{id:'documentation-collector-v2',classification:'Own metadata output failure after three exact proposed docs were written; Object passed to fs.writeFile. v3 authenticated identical existing docs, corrected JSON serialization, no document rebinding.',source:'write-docs.v2.mjs.snapshot',...await ident(path.join(here,'write-docs.v2.mjs.snapshot')),stderr:{path:'write-docs.v2.stderr.txt',...await ident(path.join(here,'write-docs.v2.stderr.txt'))},candidateExecuted:false}],completedAttempt:'write-docs.v3.stdout.txt',allVersionsAndRawRetained:true});
const sources=[];for(const n of ['build.mjs','review-content.mjs','finalize-map.mjs','write-docs.mjs','freeze-plan.mjs','selected-file-map.final.json','documentation-map.json','requirements-binding.json','proposed-requirements-supplement.json','production-reference-baseline.json','content-scan.json','content-classification.json','public-existing-reuse.json','INTEGRATION.md','proposed-focused-selection.json'])sources.push({path:n,...await ident(path.join(here,n))});
const receipt={schema:'rea-vault-recycle-source-only-publication-plan-validation/v1',frozenAt:new Date().toISOString(),sourceOnly:true,stageBefore:auth.before,stageAfter,allFourInventoriesUnchangedBeforeAfter:true,currentProductionSourceFiles:baseline.sourceFiles,currentProductionSourceFilesUnchanged:true,currentSelectedHistoryUnchanged:baseline.selectedCurrentHistory,requirementsRegistriesUnchanged:requirements.registries,originalSources159AndCapabilityIds232Exact:true,payload:{originalManifestEntries:850,originalManifestAndFreezeObjects:8,totalPathRecords:858,publishablePathRecords:857,uniquePublicByteObjects:471,reusedExistingPublicByteObjects:27,newInertByteObjects:444,localOnlyNativeCarriers:map.excludedNativeCarriers.map(r=>({epoch:r.epoch,path:r.sourcePath,bytes:r.bytes,sha256:r.sha256})),publicPathsHaveLocalSegment:false,recursiveEpochCopy:false},installation,docs:docs.docs,sources,scan:{nativePublicHeaderMatches:0,nativeQuotedBase64Matches:0,exactOriginalExeOrZipMatches:0,oneExcludedKdbx:true,syntheticCredentialLikeValues:17,unresolvedClassification:0,localWindowsUsernamePathByteObjects:226,vendorCopyrightEmail:true,scope:'Finite header/literal/source-origin study; not proof of absence of every secret or personal datum.'},historicalEvidenceEpochsRemainSeparate:true,fullProductParity:false,securityParity:false,universalSuperiority:false,executions:{candidateRuntime:0,behavioralTests:0,originalProgram:0,browser:0,benchmarks:0},prospectiveFocusedGroups:79,proposalUnexecuted:true,ownFailuresPreserved:'failure-ledger.json',productionModified:false};
await write('validation.json',receipt);await write('verification-summary.json',{authenticatedStageEntries:[546,61,208,35],productionFiles:31,sourceIdentities:159,capabilityIds:232,publicUnique471:true,reused27:true,new444:true,nativeExcluded1:true,onlySourceMetadataExecuted:true,validation:await ident(path.join(here,'validation.json'))});
const files=[];for(const rel of await walk(here))if(!['manifest.json','freeze.json'].includes(rel))files.push({path:rel,...await ident(path.join(here,rel))});await write('manifest.json',{schema:'rea-vault-recycle-publication-plan-strict-manifest/v1',count:files.length,files});await write('freeze.json',{schema:'rea-vault-recycle-publication-plan-freeze/v1',frozenAt:receipt.frozenAt,receipt:{path:'validation.json',...await ident(path.join(here,'validation.json'))},manifest:{path:'manifest.json',count:files.length,...await ident(path.join(here,'manifest.json'))},noOwnedChildrenHostsBrowser: true,sourceOnlyNoProductionWrites:true});console.log(JSON.stringify(JSON.parse(await fs.readFile(path.join(here,'freeze.json')))));
