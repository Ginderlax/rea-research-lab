    {
      "id": "grafana.candidate.1fec8059a910523e6810",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can use Microsoft SQL Server queries as annotation sources to overlay events on your dashboard graphs. For detailed instructions, query examples, and best practices, refer to [Microsoft SQL Server annotations](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/mssql/annotations/).",
      "headingPath": [
