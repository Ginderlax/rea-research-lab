import fs from'node:fs/promises';import path from'node:path';import{createHash}from'node:crypto';import assert from'node:assert/strict';
const here=import.meta.dirname,work=path.resolve(here,'..'),hash=b=>createHash('sha256').update(b).digest('hex'),ident=async p=>{const b=await fs.readFile(p);return{bytes:b.length,sha256:hash(b)}},epochs=[{name:'accepted126',dir:'editor-search-path-fix-next',count:126,manifest:'freeze-manifest.json',manifestSha:'d071d370be094646a4738de79adadca9c28d794de53dfb940604f5d52d056edf',receipt:'validation.json',receiptSha:'62a30543071d2962d2e978fd880d23840b9e797d788087cd9d6776ef1d3b183e'},{name:'negative166',dir:'editor-save-independent-review',count:166,manifest:'freeze-manifest.json',manifestSha:'0fba64bafa48e5235635951f50b17e22d6767e43d8e62836faf1f35d7e6b69fa',receipt:'review-validation.json',receiptSha:'2a5ca220fcbea44b692686a8419241ff07f0d9e664d29d5afc3e437ac8b783f4'}];
async function walk(base,rel=''){const rows=[];for(const e of await fs.readdir(base,{withFileTypes:true})){assert(!e.isSymbolicLink());if(e.isDirectory())rows.push(...await walk(path.join(base,e.name),rel+e.name+'/'));else rows.push(rel+e.name);}return rows.sort();}
const records=[];for(const e of epochs){const base=path.join(work,e.dir),mbytes=await fs.readFile(path.join(base,e.manifest)),m=JSON.parse(mbytes);assert.equal(hash(mbytes),e.manifestSha);assert.equal(Object.keys(m.inventory).length,e.count);assert.deepEqual((await walk(base)).filter(p=>p!==e.manifest),Object.keys(m.inventory).sort());for(const [rel,r]of Object.entries(m.inventory))assert.deepEqual(await ident(path.join(base,rel)),r);assert.equal((await ident(path.join(base,e.receipt))).sha256,e.receiptSha);records.push({...e,allInventoryExact:true,manifestIdentity:await ident(path.join(base,e.manifest)),receiptIdentity:await ident(path.join(base,e.receipt))});}
await fs.mkdir(path.join(here,'baseline-sources'),{recursive:true});const selected=[['editor-search-path-fix-next','products/rea-studio/apps/editor/client.mjs'],['editor-search-path-fix-next','products/rea-studio/apps/editor/server.mjs'],['editor-save-independent-review','held-save.test.mjs']];const sources=[];for(const[dir,rel]of selected){const b=await fs.readFile(path.join(work,dir,rel)),destination='baseline-sources/'+dir+'-'+path.basename(rel)+'.snapshot';await fs.writeFile(path.join(here,destination),b,{flag:'wx'});sources.push({epoch:dir,source:rel,preserved:destination,bytes:b.length,sha256:hash(b)});}const receipt={schema:'rea-editor-save-correction-review-before-authentication/v1',at:new Date().toISOString(),epochs:records,selectedSources:sources,negativeBodiesExecuted:false,productionModified:false,originalExecutions:0,benchmarks:0};await fs.writeFile(path.join(here,'before-authentication.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({authenticated:[126,166],negativeCasesReplayed:false,sourceSnapshots:sources.length}));
