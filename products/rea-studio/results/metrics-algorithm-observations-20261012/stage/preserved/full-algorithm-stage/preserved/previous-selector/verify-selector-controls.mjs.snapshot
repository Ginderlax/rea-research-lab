  for(const [ignore,zero]of [[false,false],[false,true],[true,false],[true,true],['truthy',0],[0,'truthy']]){const invoke=implementation=>{const field={type:'number',values:values.slice(),config:{}};let result,error;try{result=implementation.fieldReducers.get('p95').reduce(field,ignore,zero);}catch(thrown){error=thrown.name;}return {result,values:field.values,error};},expected=invoke(original);for(const role of roles){note('registry:'+label+':'+ignore+':'+zero,role,expected,invoke(implementations[role]));counts[role].registry++;registryCount++;}}
}
const all=Object.keys(original.ReducerID),percentiles=all.filter(id=>/^p\d+$/.test(id));for(const [label,values]of cases.filter(([label])=>['quadratic-drift-25000','rank-ties-25000','null-gap-runs-25000'].includes(label)))for(const mode of modes)for(const reducers of [percentiles,all]){const expected=run(original,values,'number',mode,reducers,{unrelated:'kept'});for(const role of roles){note('bounded-multi:'+label+':'+mode+':'+reducers.length,role,expected,run(implementations[role],values,'number',mode,reducers,{unrelated:'kept'}));counts[role].boundedMulti++;boundedMultiCount++;}}
