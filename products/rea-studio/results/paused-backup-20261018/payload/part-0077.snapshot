    },
    {
      "id": "grafana.candidate.ac5cd151067800ce670e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If set to `true`, the Grafana server hides the running version number for unauthenticated users. Version numbers might reveal if you are running an outdated and vulnerable version of Grafana.",
      "headingPath": [
        "Configure security hardening",
        "Additional security hardening",
        "Hide the version number"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-security-hardening/index.md",
