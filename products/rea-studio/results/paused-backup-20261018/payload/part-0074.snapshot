    {
      "id": "grafana.candidate.bddaf51dbbbe5df57141",
      "syntaxRole": "table-row",
      "sourceText": "| Commercial       | <p>Commercial plugins have dependent technologies that are closed source or commercially backed.</p><p>Commercial plugins are published on the official Grafana catalog, and are available to the Grafana community.</p> |",
      "headingPath": [
        "Plugin signatures",
        "Plugin signature levels"
      ],
      "source": {
