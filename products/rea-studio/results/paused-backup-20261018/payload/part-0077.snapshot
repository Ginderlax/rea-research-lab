        "sha256": "b225f8d5068b6e330e18c0916c7295be963d055af907c0790708a7bbd383b7af",
        "lineStart": 128,
        "lineEnd": 128,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/_index.md#L128-L128"
      },
      "applicability": {
        "status": "unresolved-no-explicit-oss-products-label",
        "products": []
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
