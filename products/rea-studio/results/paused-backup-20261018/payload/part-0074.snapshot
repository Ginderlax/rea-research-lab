    },
    {
      "id": "grafana.candidate.b0415833f51b2d86d199",
      "syntaxRole": "list-item",
      "sourceText": "- The `equal` field ensures suppression only applies when source and target share the same `cluster` and `namespace` label values.",
      "headingPath": [
        "Configure inhibition rules",
        "Example: suppress warning alerts"
      ],
      "source": {
        "path": "docs/sources/alerting/configure-notifications/inhibition-rules.md",
