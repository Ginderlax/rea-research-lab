    {
      "id": "grafana.candidate.ea19272b833932105468",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The news visualization displays an RSS feed. By default, it displays articles from the Grafana Labs blog, but you can change this by entering a different RSS feed URL.",
      "headingPath": [
        "News"
      ],
