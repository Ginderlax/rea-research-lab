    {
      "id": "grafana.candidate.5c3f081f4fbb27c0f4a2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To rotate data keys, use the `/encryption/rotate-data-keys` endpoint of the Grafana [Admin API](../../../developers/http_api/admin/#rotate-data-encryption-keys). It's safe to call more than once, more recommended under maintenance mode.",
      "headingPath": [
        "Configure database encryption",
        "Operational work",
        "Rotate data keys"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-security/configure-database-encryption/_index.md",
        "gitBlobSha": "936ab7c1d208cbcd86c66db25b399c78675a122b",
        "sha256": "511e359127e5ceaf00a6eeb39834e100fdb31f51a3261d71f49ab872f60129bc",
        "lineStart": 88,
        "lineEnd": 88,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-security/configure-database-encryption/_index.md#L88-L88"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
