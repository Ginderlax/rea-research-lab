// Bounded direct selected-engine preparation probe, not original workbench.
import fs from 'node:fs/promises';import path from 'node:path';import {spawn} from 'node:child_process';import {createHash} from 'node:crypto';
const root=import.meta.dirname,workspace=path.resolve(root,'../..'),meta=JSON.parse(await fs.readFile(path.join(root,'original-engine.json'))),engine=path.join(workspace,meta.path),hash=b=>createHash('sha256').update(b).digest('hex');
const before=await fs.readFile(engine);if(hash(before)!==meta.identity.sha256)throw Error('Engine identity mismatch');
const dir=path.join(root,'.local','original-boundary');await fs.mkdir(dir,{recursive:true});
const specs=[['empty','', '^'],['blank','\n','^|$'],['terminal','a\n','^|$'],['crlf','a\r\n\r\n','^|$'],['zero-astral','🧪a','(?:)'],['empty-or-a','a','(?:)|a'],['optional','a','a?'],['word-unicode','é éa aé 漢 漢字 á áb\u200ca a\u200cb a_b','\\bé\\b|\\b漢\\b|\\ba\\b'],['digits','1١１','\\d+'],['word-class','é 漢 á \u200c','\\w+'],['zero-follow','aaa','a*'],['empty-string-match','x',''],['crlf-dollar','a\r\nb','.$'],['barecr','a\rb','.$']];
const results=[];
for(let i=0;i<specs.length;i++){const[name,content,pattern]=specs[i],file=path.join(dir,name+'.txt');await fs.writeFile(file,content);const args=['--no-config','--json','--crlf','--engine','auto','--regexp',pattern,'--',file];const out=await new Promise((resolve,reject)=>{const child=spawn(engine,args,{windowsHide:true,shell:false});let stdout='',stderr='',size=0;const timeout=setTimeout(()=>child.kill(),10000);for(const[key,s]of[['stdout',child.stdout],['stderr',child.stderr]])s.on('data',b=>{size+=b.length;if(size>1024*1024)child.kill();if(key==='stdout')stdout+=b;else stderr+=b;});child.on('error',reject);child.on('close',(code,signal)=>{clearTimeout(timeout);resolve({code,signal,stdout,stderr});});});await fs.writeFile(path.join(root,'original-probe-'+i+'.stdout.txt'),out.stdout,{flag:'wx'});await fs.writeFile(path.join(root,'original-probe-'+i+'.stderr.txt'),out.stderr,{flag:'wx'});results.push({name,content,pattern,args,code:out.code,signal:out.signal,matches:out.stdout.split('\n').filter(Boolean).map(s=>JSON.parse(s)).filter(x=>x.type==='match').map(x=>x.data)});}
if(hash(await fs.readFile(engine))!==meta.identity.sha256)throw Error('Engine changed');await fs.writeFile(path.join(root,'original-boundary-probe.json'),JSON.stringify({engine:meta.identity,originalCalls:specs.length,wholeAppCalls:0,results},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(results.map(x=>({name:x.name,code:x.code,rows:x.matches.map(m=>({line:m.line_number,text:m.lines.text,spans:m.submatches.map(s=>[s.start,s.end])}))}))));
