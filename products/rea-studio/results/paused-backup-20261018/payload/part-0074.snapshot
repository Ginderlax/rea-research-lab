    {
      "id": "grafana.candidate.408192ef3a32e89378c3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Traces use attributes, not labels, for access control, and rely on TraceQL-style attribute selectors rather than LogQL. Traces LBAC is available only at the team level.",
      "headingPath": [
        "Label Based Access Control (LBAC) for data sources",
