// Bounded verification collector; no timing or memory comparative workload.
import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import {spawn} from 'node:child_process';import assert from 'node:assert/strict';
const root=path.dirname(fileURLToPath(import.meta.url)),hash=b=>createHash('sha256').update(b).digest('hex'),attempt=process.argv[2]??'attempt-01';assert.match(attempt,/^attempt-\d{2}$/);const out=path.join(root,'.local',attempt);await fs.mkdir(out,{recursive:true});
async function identity(p){const b=await fs.readFile(p);return{bytes:b.length,sha256:hash(b)};}
async function inventory(dir,prefix=''){let a=[];for(const e of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){if(!prefix&&['.local','results','validation.json','freeze-manifest.json'].includes(e.name))continue;const rel=prefix+e.name,abs=path.join(dir,e.name);if(e.isSymbolicLink())throw new Error('Unexpected source link');if(e.isDirectory())a.push(...await inventory(abs,rel+'/'));else a.push({path:rel,...await identity(abs)});}return a;}
const before=await inventory(root),started=new Date().toISOString(),runtime={path:process.execPath,version:process.version,...await identity(process.execPath)},bounds={childDeadlineMs:120000,childOldSpaceMiB:256,stdoutBytes:8*1024*1024,stderrBytes:2*1024*1024,retainedComparisonsBytes:64*1024*1024,hardProcessRssWatchdog:false,childIsolation:'Node --test-isolation=none: one directly spawned verification process, no default node:test subprocess'};
await fs.writeFile(path.join(out,'source-before.json'),JSON.stringify(before,null,2)+'\n',{flag:'wx'});for(const r of before){const dest=path.join(out,'source-before',r.path+'.snapshot');await fs.mkdir(path.dirname(dest),{recursive:true});await fs.copyFile(path.join(root,r.path),dest);}await fs.writeFile(path.join(out,'invocation.json'),JSON.stringify({started,runtime,bounds,argv:['--max-old-space-size=256','--test','--test-isolation=none','--test-reporter=tap','compatibility.test.mjs'],originalNativeExeExecutions:0,originalWorkbenchExecutions:0,originalExtensionHostExecutions:0},null,2)+'\n',{flag:'wx'});
const child=spawn(process.execPath,['--max-old-space-size=256','--test','--test-isolation=none','--test-reporter=tap',path.join(root,'compatibility.test.mjs')],{cwd:root,env:{...process.env,EDITOR_API_OUTPUT:out},windowsHide:true,stdio:['ignore','pipe','pipe']}),chunks={stdout:[],stderr:[]},totals={stdout:0,stderr:0};let limit=null,spawnError=null;
const stop=reason=>{if(!limit){limit=reason;child.kill();}},timer=setTimeout(()=>stop('childDeadline'),bounds.childDeadlineMs);for(const name of['stdout','stderr'])child[name].on('data',b=>{totals[name]+=b.length;if(totals[name]<=bounds[name+'Bytes'])chunks[name].push(b);else stop(name+'Bytes');});child.on('error',e=>spawnError={name:e.name,message:e.message});const ended=await new Promise(resolve=>child.on('close',(code,signal)=>resolve({code,signal})));clearTimeout(timer);
for(const name of['stdout','stderr'])await fs.writeFile(path.join(out,name+'.txt'),Buffer.concat(chunks[name]),{flag:'wx'});const after=await inventory(root),stable=JSON.stringify(before)===JSON.stringify(after);await fs.writeFile(path.join(out,'source-after.json'),JSON.stringify(after,null,2)+'\n',{flag:'wx'});
const stdout=Buffer.concat(chunks.stdout).toString('utf8'),tap={tests:Number(/^# tests (\d+)$/m.exec(stdout)?.[1]??NaN),pass:Number(/^# pass (\d+)$/m.exec(stdout)?.[1]??NaN),fail:Number(/^# fail (\d+)$/m.exec(stdout)?.[1]??NaN),skipped:Number(/^# skipped (\d+)$/m.exec(stdout)?.[1]??NaN)},marker=/REA_EDITOR_VALUE_API (\{[^\r\n]+\})/.exec(stdout);const receipt={schema:'rea-editor-value-api-focused-attempt/v1',started,finished:new Date().toISOString(),runtime,bounds,pid:child.pid,...ended,spawnError,limit,totals,tap,sourceFiles:before.length,sourceStable:stable,observation:marker?JSON.parse(marker[1]):null,durationMeaning:'Verification duration only; no comparative benchmark or profiler was run'};for(const name of['stdout','stderr','source-before.json','source-after.json','invocation.json'])receipt[name]=await identity(path.join(out,name.includes('.')?name:name+'.txt'));await fs.writeFile(path.join(out,'attempt.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(receipt,null,2));process.exitCode=ended.code===0&&!spawnError&&!limit&&stable&&tap.tests===9&&tap.pass===9&&tap.fail===0&&tap.skipped===0&&receipt.observation?0:1;
