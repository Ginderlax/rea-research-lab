    {
      "id": "grafana.candidate.d3c33216fc96b4b3d8f9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you enable **Heatmap**, use the **Heatmap Type** option to choose how samples are aggregated:",
      "headingPath": [
        "Query profile data",
