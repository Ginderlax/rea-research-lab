        "lineStart": 99,
        "lineEnd": 99,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-3.md#L99-L99"
      },
      "applicability": {
