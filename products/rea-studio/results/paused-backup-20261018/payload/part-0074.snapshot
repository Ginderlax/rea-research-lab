        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.4a7626882bfa1f85e085",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To use a recorded query, create one and add it to a dashboard. After that, it can be managed in **Preferences** from the **Recorded queries** tab.",
      "headingPath": [
        "Recorded queries (deprecated)",
        "Using a recorded query"
