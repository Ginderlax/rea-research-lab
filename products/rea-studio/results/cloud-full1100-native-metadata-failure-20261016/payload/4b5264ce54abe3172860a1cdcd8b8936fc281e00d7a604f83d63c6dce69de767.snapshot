const job=collection.jobId,selectedArtifact=collection.artifacts[0],artifactId=String(selectedArtifact.artifactId),digest=selectedArtifact.sha256;assert(/^\d+$/.test(job)&&/^\d+$/.test(artifactId)&&/^[0-9a-f]{64}$/.test(digest));assert.equal(selectedArtifact.readabilityVerified,true);
