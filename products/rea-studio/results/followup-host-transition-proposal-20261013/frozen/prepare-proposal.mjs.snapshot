import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,repo=path.resolve(here,'../../outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),source=await fs.readFile(path.join(here,'before/scripts/verify-followup-records.mjs.snapshot'));assert.equal(sha(source),'7727409e4214511af330efb5f61bc1ba6fcb63837638748fea8539bdd9f90969');const text=source.toString(),addition=`
 const editorHostTransition={path:'products/rea-studio/server.mjs',before:{bytes:7741,sha256:'807a473ec0334f60dfd58f2df8901c722f1bd4eb1d64c62d9ba1ea65c2b6b55f'},after:{bytes:7840,sha256:'85fe09b1b52a1d91e9d09c85d99c6e768ac4b793f5d7694a1760a4c0560a0a94'},insertedLine:"        ['/apps/sketch/layout.mjs', ['apps/sketch/layout.mjs', 'text/javascript; charset=utf-8']],\\n",publicPrefix:'products/rea-studio/results/sketch-layout-reviewed-installation-20261013/shared-route/frozen',manifestSHA256:'86de6ef0f1f39a03d7c6b4039cbbc78d0230c0ab09aec6ea61aa105edaedb3f9'};
 const hostProofManifestBytes=readFileSync(join(root,editorHostTransition.publicPrefix,'freeze-manifest.json.snapshot'));assert.equal(sha(hostProofManifestBytes),editorHostTransition.manifestSHA256);const hostProofManifest=JSON.parse(hostProofManifestBytes);assert.equal(hostProofManifest.schema,'rea-sketch-layout-static-route-freeze/v1');assert.equal(hostProofManifest.files,51);assert.equal(hostProofManifest.records.length,51);const hostProofRows=new Map();for(const r of hostProofManifest.records){safe(r.path);assert.ok(!hostProofRows.has(r.path));hostProofRows.set(r.path,r);const b=readFileSync(join(root,editorHostTransition.publicPrefix,r.path+'.snapshot'));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);}assert.deepEqual(files(join(root,editorHostTransition.publicPrefix)).sort(),[...hostProofManifest.records.map(r=>r.path+'.snapshot'),'freeze-manifest.json.snapshot'].sort());
 const hostProofValidation=JSON.parse(readFileSync(join(root,editorHostTransition.publicPrefix,'validation.json.snapshot')));assert.equal(hostProofValidation.schema,'rea-sketch-layout-static-route-validation/v1');assert.equal(hostProofValidation.runtime.path,editorHostTransition.path);assert.deepEqual(hostProofValidation.runtime.before,editorHostTransition.before);assert.deepEqual(hostProofValidation.runtime.after,editorHostTransition.after);assert.equal(hostProofValidation.runtime.exactInsertedLine,editorHostTransition.insertedLine);assert.equal(hostProofValidation.runtime.inverseReconstructsCurrentServer,true);assert.equal(Buffer.byteLength(editorHostTransition.insertedLine),99);
 const oldEditorHostBytes=historical3baBytes(editorHostTransition.path,editorHostTransition.before),newEditorHostProofBytes=readFileSync(join(root,editorHostTransition.publicPrefix,editorHostTransition.path+'.snapshot'));assert.equal(newEditorHostProofBytes.length,editorHostTransition.after.bytes);assert.equal(sha(newEditorHostProofBytes),editorHostTransition.after.sha256);assert.equal(newEditorHostProofBytes.toString().split(editorHostTransition.insertedLine).length,2);const inverseEditorHostBytes=Buffer.from(newEditorHostProofBytes.toString().replace(editorHostTransition.insertedLine,''));assert.equal(inverseEditorHostBytes.length,editorHostTransition.before.bytes);assert.equal(sha(inverseEditorHostBytes),editorHostTransition.before.sha256);assert.deepEqual(inverseEditorHostBytes,oldEditorHostBytes);
 function currentEditorBytes(r){safe(r.path);const live=readFileSync(join(root,r.path));if(r.path!==editorHostTransition.path)return live;assert.equal(r.bytes,editorHostTransition.before.bytes);assert.equal(r.sha256,editorHostTransition.before.sha256);assert.equal(live.length,editorHostTransition.after.bytes);assert.equal(sha(live),editorHostTransition.after.sha256);return oldEditorHostBytes;}
`;
const changes=[];function change(before,after){assert.equal(text.split(before).length,2,'Unique source anchor');changes.push({before,after,beforeStartLine:text.slice(0,text.indexOf(before)).split('\n').length});}change(" const notesInstallPrefix=",addition+" const notesInstallPrefix=");change("for(const r of currentEditorSource){safe(r.path);const b=readFileSync(join(root,r.path));","for(const r of currentEditorSource){safe(r.path);const b=currentEditorBytes(r);");change("for(const name of ['shared-shell-identities.json','shared-host-identities.json']){const rows=proofs[17].json(name);assert.equal(rows.length,3);for(const r of rows){const b=readFileSync(join(root,r.path));","for(const name of ['shared-shell-identities.json','shared-host-identities.json']){const rows=proofs[17].json(name);assert.equal(rows.length,3);for(const r of rows){const b=currentEditorBytes(r);");change("[join(root,'scripts/verify-editor-save-followup.mjs'),'--require-current']","[join(root,'scripts/verify-editor-save-followup.mjs')]");change("const editorVerification=JSON.parse(editorChild.stdout);assert.equal(editorVerification.liveSourceMatch,true);","const editorVerification=JSON.parse(editorChild.stdout);assert.equal(editorVerification.schema,'rea-editor-save-public-followup-verification/v1');assert.equal(editorVerification.passed,true);assert.equal(editorVerification.requireCurrent,false);assert.equal(editorVerification.liveSourceMatch,false);assert.equal(editorVerification.currentSourceSnapshots,31);assert.equal(editorVerification.behavioralTestsExecuted+editorVerification.originalEditorEngineExecutions+editorVerification.benchmarks,0);assert.deepEqual(editorVerification.liveMismatches,[{path:editorHostTransition.path,testedSha256:editorHostTransition.before.sha256,liveSha256:editorHostTransition.after.sha256}]);currentEditorBytes({path:editorHostTransition.path,...editorHostTransition.before});");change("return{notesInlineVerification:","return{editorHostTransition:{path:editorHostTransition.path,before:editorHostTransition.before,after:editorHostTransition.after,addedStaticMapLineBytes:99,authenticatedRootRoutePayloads:51,historical3baHostAndInverseExact:true,onlyEditorSaveLiveMismatch:true,currentEditorOther30RowsMandatory:true,currentSharedHostOther2RowsMandatory:true,oldEditorSaveProofNotRebound:true,behavioralTestsExecuted:0},notesInlineVerification:");let proposed=text;for(const c of changes)proposed=proposed.replace(c.before,c.after);assert.notEqual(proposed,text);let inverse=proposed;for(const c of [...changes].reverse())inverse=inverse.replace(c.after,c.before);assert.equal(inverse,text);await fs.mkdir(path.join(here,'proposed'),{recursive:true});await fs.writeFile(path.join(here,'proposed/verify-followup-records.mjs'),proposed,{flag:'wx'});await fs.writeFile(path.join(here,'transformations.json'),JSON.stringify({schema:'rea-followup-host-transition-source-proposal/v1',parentPath:'scripts/verify-followup-records.mjs',before:{bytes:source.length,sha256:sha(source)},after:{bytes:Buffer.byteLength(proposed),sha256:sha(proposed)},changes,inverseExact:true,childVerifierUnchanged:{path:'scripts/verify-editor-save-followup.mjs',bytes:6745,sha256:'4b93961b46b79fe901eafcfc3e1eda564803b60a12be411feb58350da604f001'},onlyHostException:'products/rea-studio/server.mjs',genericHistoricalFallback:false,rootRuntimeMutations:0},null,2)+'\n',{flag:'wx'});
const childInputs=['verify-notes-vault-followups.mjs','verify-notes-inline-followups.mjs'];for(const f of childInputs){const b=await fs.readFile(path.join(repo,'scripts',f));await fs.writeFile(path.join(here,'before',f+'.snapshot'),b,{flag:'wx'});}console.log(JSON.stringify({beforeSHA256:sha(source),afterSHA256:sha(proposed),bytes:Buffer.byteLength(proposed),changes:changes.map(c=>({line:c.beforeStartLine,anchor:c.before.slice(0,70)})),inverseExact:true}));
