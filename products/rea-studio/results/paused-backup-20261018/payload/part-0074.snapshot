    {
      "id": "grafana.candidate.ba0b982cf92f9ff2ac95",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Server administrators can add and remove users in organizations. To do this as an organization administrator, see [Manage users in an organization](../../manage-org-users/).",
      "headingPath": [
        "Add or remove a user in an organization"
      ],
      "source": {
        "path": "docs/sources/administration/user-management/server-user-management/add-remove-user-to-org/index.md",
        "gitBlobSha": "b785940f96fccc2066f07370d7379998a9ac9a1f",
