// Test-only original helper execution; upstream AGPL-3.0-or-later notices apply.
import test from 'node:test';
import assert from 'node:assert/strict';
import { readFile } from 'node:fs/promises';
import { createHash } from 'node:crypto';
import { stripTypeScriptTypes } from 'node:module';
import vm from 'node:vm';
import { changeTodo } from './todo.mjs';

const digest = value => createHash('sha256').update(value).digest('hex');
const sourceHash = '5f1a200dc970179ad6fd193f7ffc47f09f88261cff8f893ccc793517ebbe9647';
const sourceUrl = 'https://github.com/laurent22/joplin/blob/7e2765a3857754d12dbadea442b60ceaf9d4b23d/packages/lib/models/Note.ts';
function selectedMethod(text, name) {
  const start = text.indexOf(`public static ${name}(`); if (start < 0 || text.indexOf(`public static ${name}(`, start + 1) >= 0) throw new Error('Original helper must occur exactly once.');
  const open = text.indexOf('{', start); let depth = 0;
  for (let at = open; at < text.length; at++) {
    if (text[at] === '{') depth++;
    if (text[at] === '}' && --depth === 0) { const source = text.slice(start, at + 1); return { source, name, startLine: text.slice(0, start).split('\n').length, endLine: text.slice(0, at + 1).split('\n').length, sha256: digest(source) }; }
  }
  throw new Error('Original helper did not terminate.');
}
const fields = value => ({ is_todo: Number(value.is_todo), todo_due: Number(value.todo_due), todo_completed: Number(value.todo_completed) });
const candidateFields = value => ({ is_todo: Number(value.todo.isTodo), todo_due: value.todo.due, todo_completed: value.todo.completed });

test('20 finite to-do field transitions match two authenticated released Joplin helpers with a fixed clock', async () => {
  const bytes = await readFile(new URL('./results/notebooks-followup/stage/original/packages/lib/models/Note.ts.snapshot.snapshot', import.meta.url)); assert.equal(bytes.length, 45302); assert.equal(digest(bytes), sourceHash);
  const slices = ['changeNoteType', 'toggleTodoCompleted'].map(name => selectedMethod(bytes.toString('utf8'), name)), now = 1_790_000_000_123;
  const OriginalNote = vm.runInNewContext(stripTypeScriptTypes(`class Note {\n${slices.map(row => row.source).join('\n')}\n}; Note;`), { Date: { now: () => now } }, { timeout: 1000 });
  let conversionComparisons = 0, completionComparisons = 0;
  for (const is_todo of [0, 1]) for (const todo_due of [0, 1700000000123]) for (const todo_completed of [0, 1600000000456]) for (const type of ['note', 'todo']) {
    const input = { id: 'a'.repeat(32), title: 'Retained', body: 'Unchanged body', is_todo, todo_due, todo_completed, author: 'Original author' }, before = structuredClone(input);
    const original = OriginalNote.changeNoteType(input, type), changed = changeTodo({ joplin: { props: Object.fromEntries(Object.entries(input).map(([key, value]) => [key, String(value)])) } }, { action: 'todo-type', type }, now);
    const actual = changed.todo ? candidateFields(changed) : fields(input);
    assert.deepEqual(actual, fields(original)); assert.deepEqual(input, before); assert.equal(original.author, input.author); assert.equal(original.body, input.body); conversionComparisons++;
  }
  for (const todo_due of [0, 1700000000123]) for (const todo_completed of [0, 1600000000456]) {
    const input = { is_todo: 1, todo_due, todo_completed, author: 'Retained' }, before = structuredClone(input), original = OriginalNote.toggleTodoCompleted(input);
    const candidate = changeTodo({ todo: { isTodo: true, due: todo_due, completed: todo_completed } }, { action: 'todo-completed', completed: !todo_completed }, now);
    assert.deepEqual(candidateFields(candidate), fields(original)); assert.deepEqual(input, before); assert.equal(original.author, 'Retained'); completionComparisons++;
  }
  assert.equal(conversionComparisons, 16); assert.equal(completionComparisons, 4);
  console.log(JSON.stringify({ notesTodoOriginalComparisons: { sourceUrl, sourceSha256: sourceHash, bindings: slices.map(({ source, ...binding }) => binding), conversionComparisons, completionComparisons, clock: now, originalFullApplicationExecutions: 0, originalDatabaseExecutions: 0, originalGuiSessions: 0, scope: 'Only two exact helpers. API persistence, revisions, due editing, filters and UI are candidate-only checks. Same-state explicit API no-ops and shared/locked-note refusal are app policies.' } }));
});
import test from 'node:test';
import assert from 'node:assert/strict';
import { mkdtemp, rm, readFile } from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
import { start } from '../../server.mjs';
import { readJex } from './jex.mjs';
import { todoState } from './todo.mjs';

async function setup(t) {
  const dataDir = await mkdtemp(path.join(os.tmpdir(), 'rea-notes-todo-http-')); let host = await start({ port: 0, dataDir });
  t.after(async () => { await host.close(); assert.equal(path.dirname(dataDir), path.resolve(os.tmpdir())); assert.ok(path.basename(dataDir).startsWith('rea-notes-todo-http-')); await rm(dataDir, { recursive: true, force: true }); });
  const call = async (action, input = {}, expectedStatus = 200) => { const response = await fetch(`${host.url}/api/notes/${action}`, { method: 'POST', headers: { 'content-type': 'application/json', 'x-rea-token': host.token }, body: JSON.stringify(input) }); const payload = await response.json(); assert.equal(response.status, expectedStatus, payload.error); return payload.result ?? payload; };
  return { call, moduleResponse: () => fetch(`${host.url}/apps/notes/todo.mjs`), restart: async () => { await host.close(); host = await start({ port: 0, dataDir }); } };
}

test('real HTTP cold restarts retain to-do transitions, history, due metadata and static browser module delivery', async t => {
  const f = await setup(t); let note = await f.call('save', { title: 'Cold restart', body: 'saved body' }); note = (await f.call('todo-type', { id: note.id, revision: note.revision, type: 'todo' })).note; note = (await f.call('todo-due', { id: note.id, revision: note.revision, due: 1_800_000_000_123 })).note;
  await f.restart(); let opened = await f.call('get', { id: note.id }); assert.deepEqual(todoState(opened), { isTodo: true, due: 1_800_000_000_123, completed: 0 });
  opened = (await f.call('todo-completed', { id: opened.id, revision: opened.revision, completed: true })).note; const completed = opened.todo.completed;
  await f.restart(); opened = await f.call('get', { id: note.id }); assert.equal(opened.todo.completed, completed); assert.equal(opened.history.at(-1).todo.completed, 0); assert.equal((await f.call('list', { todoFilter: 'completed' })).notes[0].id, note.id);
  opened = await f.call('history-restore', { id: opened.id, revision: opened.revision, historyRevision: 3 }); assert.equal(opened.todo.completed, 0); assert.equal(opened.todo.due, 1_800_000_000_123);
  const moduleResponse = await f.moduleResponse(); assert.equal(moduleResponse.status, 200); assert.match(await moduleResponse.text(), /export function todoState/);
});

test('editing imported to-do preserves exact resource bytes, IDs, relationships and unrelated JEX metadata over restart/export', async t => {
  const f = await setup(t), bytes = await readFile(new URL('./fixtures/pinned-joplin.jex', import.meta.url)); await f.call('jex-import', { base64: bytes.toString('base64') }); const before = readJex(Buffer.from((await f.call('jex-export')).base64, 'base64')); let note = await f.call('get', { id: '3'.repeat(32) });
  note = (await f.call('todo-type', { id: note.id, revision: note.revision, type: 'note' })).note; note = (await f.call('todo-type', { id: note.id, revision: note.revision, type: 'todo' })).note; note = (await f.call('todo-due', { id: note.id, revision: note.revision, due: 1_800_000_000_123 })).note;
  await f.restart(); const result = await f.call('jex-export'), after = readJex(Buffer.from(result.base64, 'base64')), record = after.records.get(note.id), old = before.records.get(note.id);
  assert.equal(record.props.is_todo, '1'); assert.equal(record.props.todo_due, '1800000000123'); assert.equal(record.props.todo_completed, '0');
  for (const key of ['id', 'parent_id', 'created_time', 'user_created_time', 'author', 'source_url', 'latitude', 'longitude', 'altitude', 'application_data']) assert.equal(record.props[key], old.props[key]);
  assert.equal(record.title, old.title); assert.equal(record.body, old.body); assert.deepEqual(after.resources.get('5'.repeat(32)).bytes, before.resources.get('5'.repeat(32)).bytes); assert.deepEqual(after.records.get('7'.repeat(32)), before.records.get('7'.repeat(32)));
  const binary = await f.call('attachment-get', { noteId: note.id, id: '5'.repeat(32) }); assert.deepEqual(Buffer.from(binary.base64, 'base64'), before.resources.get('5'.repeat(32)).bytes);
});
import test from 'node:test';
import assert from 'node:assert/strict';
import { handle } from './server.mjs';
import { todoState, changeTodo, todoMatches, todoTimestamp } from './todo.mjs';
import { readJex } from './jex.mjs';

function fixture() {
  const data = new Map(); let writes = 0;
  const store = { get: async (key, fallback) => structuredClone(data.get(key) ?? fallback), set: async (key, value) => { writes++; data.set(key, structuredClone(value)); }, list: async prefix => [...data.keys()].filter(key => key.startsWith(prefix)) };
  return { data, store, writes: () => writes, call: (action, input = {}) => handle({ action, input, store }) };
}
const defaults = { isTodo: false, due: 0, completed: 0 };
const command = (call, note, action, fields) => call(action, { id: note.id, revision: note.revision, ...fields });

test('conversion, completion/reopening and due dates persist without changing title/body/identity/notebook/tags', async () => {
  const { call } = fixture(); let note = await call('save', { title: 'Release checklist', body: 'Keep body ðŸ§ª', notebook: 'Study', tags: ['release'] }); const before = structuredClone(note);
  note = (await command(call, note, 'todo-type', { type: 'todo' })).note;
  assert.deepEqual(todoState(note), { ...defaults, isTodo: true });
  note = (await command(call, note, 'todo-due', { due: 1_790_000_000_123 })).note;
  const lower = Date.now(); note = (await command(call, note, 'todo-completed', { completed: true })).note; const upper = Date.now();
  assert.ok(note.todo.completed >= lower && note.todo.completed <= upper); assert.equal(note.todo.due, 1_790_000_000_123);
  note = (await command(call, note, 'todo-completed', { completed: false })).note; assert.equal(note.todo.completed, 0);
  note = (await command(call, note, 'todo-type', { type: 'note' })).note; assert.deepEqual(note.todo, defaults);
  for (const key of ['id', 'title', 'body', 'notebook', 'notebookId', 'createdAt']) assert.equal(note[key], before[key]); assert.deepEqual(note.tags, before.tags); assert.equal(note.revision, 6);
});

test('already desired state is an explicit no-write/no-revision no-op but a stale no-op still rejects', async () => {
  const f = fixture(); let note = await f.call('save', { title: 'Idempotent' });
  const firstWrites = f.writes(); assert.equal((await command(f.call, note, 'todo-type', { type: 'note' })).changed, false); assert.equal(f.writes(), firstWrites);
  note = (await command(f.call, note, 'todo-type', { type: 'todo' })).note;
  const writes = f.writes(), before = JSON.stringify([...f.data]);
  for (const [action, fields] of [['todo-type', { type: 'todo' }], ['todo-completed', { completed: false }], ['todo-due', { due: 0 }]]) assert.equal((await command(f.call, note, action, fields)).changed, false);
  assert.equal(f.writes(), writes); assert.equal(JSON.stringify([...f.data]), before);
  await assert.rejects(f.call('todo-type', { id: note.id, revision: note.revision - 1, type: 'todo' }), /changed/);
});

test('all malformed commands and unsupported transitions reject before persistence', async () => {
  const f = fixture(); let note = await f.call('save', { title: 'Strict' });
  await assert.rejects(command(f.call, note, 'todo-completed', { completed: true }), /Convert/); await assert.rejects(command(f.call, note, 'todo-due', { due: 1 }), /Convert/);
  note = (await command(f.call, note, 'todo-type', { type: 'todo' })).note; const before = JSON.stringify([...f.data]);
  for (const type of ['', 'task', 1, null, undefined]) await assert.rejects(command(f.call, note, 'todo-type', { type }), /note or todo/);
  for (const completed of [0, 1, 'true', null, undefined]) await assert.rejects(command(f.call, note, 'todo-completed', { completed }), /Boolean/);
  for (const due of [-1, 0.1, NaN, Infinity, '1', null, undefined, 8.64e15 + 1]) await assert.rejects(command(f.call, note, 'todo-due', { due }), /timestamp/);
  assert.equal(JSON.stringify([...f.data]), before); assert.equal(todoTimestamp(8.64e15), 8.64e15);
});

test('concurrent explicit completion commands accept one revision and reject the stale rival', async () => {
  const f = fixture(); let note = await f.call('save', { title: 'Race' }); note = (await command(f.call, note, 'todo-type', { type: 'todo' })).note;
  const outcomes = await Promise.allSettled([true, false].map(completed => command(f.call, note, 'todo-completed', { completed })));
  assert.equal(outcomes.filter(row => row.status === 'fulfilled').length, 1); assert.equal(outcomes.filter(row => row.status === 'rejected').length, 1); assert.ok(todoState(await f.call('get', { id: note.id })).completed);
});

test('request primitives are frozen before a queued store read and cannot change command ownership', async () => {
  const f = fixture(), first = await f.call('save', { title: 'First' }), other = await f.call('save', { title: 'Other' });
  const input = { id: first.id, revision: first.revision, type: 'todo' }, pending = f.call('todo-type', input); input.id = other.id; input.type = 'note'; input.revision = -1;
  assert.equal((await pending).note.id, first.id); assert.equal(todoState(await f.call('get', { id: first.id })).isTodo, true); assert.equal(todoState(await f.call('get', { id: other.id })).isTodo, false);
});

test('failed atomic persistence preserves prior state and an explicit retry succeeds', async () => {
  const f = fixture(), note = await f.call('save', { title: 'Atomic' }), before = JSON.stringify([...f.data]), set = f.store.set;
  f.store.set = async () => { throw new Error('Synthetic metadata write denied'); };
  await assert.rejects(command(f.call, note, 'todo-type', { type: 'todo' }), /write denied/); assert.equal(JSON.stringify([...f.data]), before);
  f.store.set = set; assert.equal((await command(f.call, note, 'todo-type', { type: 'todo' })).note.revision, 2);
});

test('history restores captured to-do metadata as a fresh revision; earlier snapshots without this field retain current state', async () => {
  const f = fixture(); let note = await f.call('save', { title: 'History' }); note = (await command(f.call, note, 'todo-type', { type: 'todo' })).note; note = (await command(f.call, note, 'todo-due', { due: 99 })).note; const revision = note.revision;
  note = (await command(f.call, note, 'todo-completed', { completed: true })).note;
  note = await f.call('history-restore', { id: note.id, revision: note.revision, historyRevision: revision }); assert.deepEqual(note.todo, { isTodo: true, due: 99, completed: 0 });
  const saved = f.data.get('notes-state-v2'); delete saved.notes[note.id].history[0].todo;
  const restored = await f.call('history-restore', { id: note.id, revision: note.revision, historyRevision: 1 }); assert.deepEqual(restored.todo, note.todo);
});

test('JEX roundtrip carries edited local to-do fields and independent JSON copies retain validated state', async () => {
  const f = fixture(); let note = await f.call('save', { title: 'Export' }); note = (await command(f.call, note, 'todo-type', { type: 'todo' })).note; note = (await command(f.call, note, 'todo-due', { due: 123 })).note;
  const jex = await f.call('jex-export'), record = readJex(Buffer.from(jex.base64, 'base64')).records.get(note.id.replaceAll('-', '')); assert.equal(record.props.is_todo, '1'); assert.equal(record.props.todo_due, '123'); assert.equal(record.props.todo_completed, '0');
  const target = fixture(); await target.call('jex-import', { base64: jex.base64 }); assert.deepEqual(todoState(await target.call('get', { id: record.props.id })), note.todo);
  const bundle = await f.call('export'), result = await target.call('import-bundle', { content: bundle.content }); assert.deepEqual(todoState(await target.call('get', { id: result.ids[0] })), note.todo);
  const invalid = JSON.parse(bundle.content); invalid.notes[0].todo.due = -1; const before = JSON.stringify([...target.data]); await assert.rejects(target.call('import-bundle', { content: JSON.stringify(invalid) }), /timestamp/); assert.equal(JSON.stringify([...target.data]), before);
});

test('import-style metadata is read without normalization; changing type resets only due/completion fields', async () => {
  const note = { title: 'Retain', body: 'body', joplin: { props: { is_todo: '1', todo_due: '123', todo_completed: '456', author: 'Author' } } }, before = structuredClone(note);
  assert.deepEqual(todoState(note), { isTodo: true, due: 123, completed: 456 }); assert.equal(changeTodo(note, { action: 'todo-type', type: 'todo' }, 999), note);
  const changed = changeTodo(note, { action: 'todo-type', type: 'note' }, 999); assert.deepEqual(changed.todo, defaults); assert.deepEqual(changed.joplin, before.joplin); assert.deepEqual(note, before);
});

test('all five app filters distinguish note/open/completed state and combine with existing text/tag/notebook/trash filters', async () => {
  const f = fixture(), note = await f.call('save', { title: 'plain', tags: ['study'], notebook: 'Lab' }); let open = await f.call('save', { title: 'open', tags: ['study'], notebook: 'Lab' }), done = await f.call('save', { title: 'done', tags: ['other'] });
  open = (await command(f.call, open, 'todo-type', { type: 'todo' })).note; done = (await command(f.call, done, 'todo-type', { type: 'todo' })).note; done = (await command(f.call, done, 'todo-completed', { completed: true })).note;
  for (const [todoFilter, expected] of [['all', 3], ['notes', 1], ['todos', 2], ['open', 1], ['completed', 1]]) assert.equal((await f.call('list', { todoFilter })).total, expected);
  assert.equal((await f.call('list', { todoFilter: 'open', tag: 'study', search: 'open', notebook: 'Lab' })).notes[0].id, open.id);
  await command(f.call, open, 'delete', {}); assert.equal((await f.call('list', { todoFilter: 'open' })).total, 0); assert.equal((await f.call('list', { todoFilter: 'open', trash: true })).total, 1);
  await assert.rejects(f.call('list', { todoFilter: 'unknown' }), /filter/); await assert.rejects(fixture().call('list', { todoFilter: 'unknown' }), /filter/); assert.equal(todoMatches(note, 'notes'), true);
});

test('trashed, shared and locked note commands reject without changing saved bytes', async () => {
  const f = fixture(); let note = await f.call('save', { title: 'Bounded permissions' }); note = await command(f.call, note, 'delete', {}); let before = JSON.stringify([...f.data]); await assert.rejects(command(f.call, note, 'todo-type', { type: 'todo' }), /Restore/); assert.equal(JSON.stringify([...f.data]), before);
  note = await command(f.call, note, 'restore', {});
  for (const props of [{ share_id: 'shared' }, { is_locked: '1' }]) { const state = f.data.get('notes-state-v2'); state.notes[note.id].joplin = { props }; before = JSON.stringify([...f.data]); await assert.rejects(command(f.call, note, 'todo-type', { type: 'todo' }), /outside/); assert.equal(JSON.stringify([...f.data]), before); }
});
import test from 'node:test';
import assert from 'node:assert/strict';
import { ui, gate, find } from './notebook-trash-review-fixture.mjs';
import { todoState } from './todo.mjs';
const status = f => find(f.root, node => node.attributes.role === 'status');
const mutations = f => f.calls.filter(row => row.action.startsWith('todo-'));

test('saved-note UI converts, completes, reopens, edits/clears due metadata and filters actual saved results', async t => {
  const f = await ui(t); await f.open();
  assert.equal(f.byText('Mark complete').disabled, true); await f.click(f.byText('Convert to to-do')); assert.equal(todoState(f.read().notes[f.note.id]).isTodo, true);
  await f.click(f.byText('Mark complete')); assert.ok(todoState(f.read().notes[f.note.id]).completed); await f.click(f.byText('Mark incomplete')); assert.equal(todoState(f.read().notes[f.note.id]).completed, 0);
  const due = f.byLabel('To-do due date in local time'); due.value = '2027-04-05T12:34:56.123'; await f.click(f.byText('Set due date')); assert.equal(todoState(f.read().notes[f.note.id]).due, new Date('2027-04-05T12:34:56.123').getTime());
  await f.click(f.byText('Clear due date')); assert.equal(todoState(f.read().notes[f.note.id]).due, 0);
  const filter = f.byLabel('Filter note type'); filter.value = 'notes'; await filter.onchange(); assert.equal(find(f.root, node => node.tagName === 'button' && node.textContent.startsWith('A note Â·')), null);
  filter.value = 'open'; await filter.onchange(); assert.ok(find(f.root, node => node.tagName === 'button' && node.textContent.startsWith('A note Â·')));
  await f.click(f.byText('Convert to note')); assert.deepEqual(todoState(f.read().notes[f.note.id]), { isTodo: false, due: 0, completed: 0 });
});

test('unsaved drafts submit no to-do command and retain every typed field', async t => {
  const f = await ui(t); await f.open(); f.type(f.byLabel('Note title'), 'Newer title'); f.type(f.byLabel('Note tags'), 'new-tag'); f.type(f.byLabel('Markdown note'), 'Newer body'); const before = JSON.stringify(f.read()), count = mutations(f).length;
  await f.click(f.byText('Convert to to-do')); assert.match(status(f).textContent, /Save your draft/); assert.equal(mutations(f).length, count); assert.equal(JSON.stringify(f.read()), before); assert.equal(f.byLabel('Note title').value, 'Newer title'); assert.equal(f.byLabel('Markdown note').value, 'Newer body');
});

test('blank or invalid due inputs submit nothing; unchanged millisecond precision is retained', async t => {
  const f = await ui(t); await f.open(); await f.click(f.byText('Convert to to-do')); const due = f.byLabel('To-do due date in local time'), before = mutations(f).length;
  for (const value of ['', 'invalid', '1960-01-01T00:00:00.000']) { due.value = value; await f.click(f.byText('Set due date')); assert.equal(mutations(f).length, before); }
  due.value = '2027-04-05T12:34:56.123'; await f.click(f.byText('Set due date')); const saved = todoState(f.read().notes[f.note.id]).due, revision = f.read().notes[f.note.id].revision; await f.click(f.byText('Set due date'));
  assert.equal(todoState(f.read().notes[f.note.id]).due, saved); assert.equal(f.read().notes[f.note.id].revision, revision); assert.match(status(f).textContent, /already current/);
});

test('actual committed held response blocks duplicate mutations and preserves a newer typed draft at the new revision', async t => {
  const g = gate(); let hold = true; const f = await ui(t, async ({ action }) => { if (action === 'todo-type' && hold) { g.enter(); await g.held; } }); await f.open();
  const pending = f.click(f.byText('Convert to to-do')); await g.started; assert.equal(todoState(f.read().notes[f.note.id]).isTodo, true); assert.equal(f.byText('Convert to to-do').disabled, true);
  await f.byText('Convert to to-do').onclick(); assert.equal(mutations(f).length, 1);
  f.type(f.byLabel('Markdown note'), 'Typed while committed response was held'); hold = false; g.release(); await pending;
  assert.equal(f.byLabel('Markdown note').value, 'Typed while committed response was held'); assert.match(status(f).textContent, /newer note draft is retained/);
  await f.click(f.byText('Save note')); assert.equal(f.read().notes[f.note.id].body, 'Typed while committed response was held'); assert.equal(f.read().notes[f.note.id].revision, 3); assert.equal(todoState(f.read().notes[f.note.id]).isTodo, true);
});

test('selecting a new draft while a committed response is held keeps the new editor ownership', async t => {
  const g = gate(); const f = await ui(t, async ({ action }) => { if (action === 'todo-type') { g.enter(); await g.held; } }); await f.open(); const pending = f.click(f.byText('Convert to to-do')); await g.started;
  await f.click(f.byText('New note')); f.type(f.byLabel('Note title'), 'Independent draft'); f.type(f.byLabel('Markdown note'), 'Must survive'); g.release(); await pending;
  assert.equal(f.byLabel('Note title').value, 'Independent draft'); assert.equal(f.byLabel('Markdown note').value, 'Must survive'); assert.equal(f.byText('Convert to to-do').disabled, true); assert.equal(todoState(f.read().notes[f.note.id]).isTodo, true);
});

test('disposing after actual commit suppresses every late read/publication without undoing saved state', async t => {
  const g = gate(); const f = await ui(t, async ({ action }) => { if (action === 'todo-type') { g.enter(); await g.held; } }); await f.open(); const pending = f.click(f.byText('Convert to to-do')); await g.started;
  f.dispose(); const text = status(f).textContent, count = f.calls.length; g.release(); await pending;
  assert.equal(status(f).textContent, text); assert.equal(f.calls.length, count); assert.equal(todoState(f.read().notes[f.note.id]).isTodo, true); await f.byText('Convert to to-do').onclick(); assert.equal(f.calls.length, count);
});

test('failed persistence restores enabled controls and supports a later explicit retry', async t => {
  const f = await ui(t); await f.open(); const before = JSON.stringify(f.read()), set = f.store.set; f.store.set = async () => { throw new Error('Synthetic to-do write denied'); };
  await f.click(f.byText('Convert to to-do')); assert.equal(JSON.stringify(f.read()), before); assert.equal(f.byText('Convert to to-do').disabled, false); assert.match(status(f).textContent, /write denied/);
  f.store.set = set; await f.click(f.byText('Convert to to-do')); assert.equal(todoState(f.read().notes[f.note.id]).isTodo, true); assert.equal(f.byText('Convert to note').disabled, false);
});
