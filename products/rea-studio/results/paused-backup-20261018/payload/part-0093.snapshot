# Unbound current36 publication95/306 backup templates

The old92/208 b036 reader is preserved unchanged. These separate unbound templates refuse before filesystem/credentials/API access until exact run/head/job constants are bound in new versioned files after independent source review. The read-only collector pins the whole data-only reader. No template/reader/collector or captured candidate code has run.

The collector first retains authenticated raw APIs/logs and the original uploaded ZIP. A bounded data-only receipt header peek selects the exact tested Git commit for read-only API retrieval. The full reader checks the actual PR merge second parent and identical branch tree (or exact manual branch/source), full Git tree, all captured reviewed/producer/control sources and all recovered envelopes against actual Git blob identities. Unbound-source discovery grants no acceptance.

The historical56 envelope uses52 proof+4 old installed tooling logical paths and exact declaration-pinned physical historical carriers. Its source epoch is not rewritten as current36 behavior. Current60 proof sources, all36 committed Notes files/exact21 test names, fixed12 tooling sources and the separate collector-self95th role have independent bounds and source identities. Every base64 payload is canonical, safe, bounded, byte exact, locally recovered and never executed. The declaration's own external pin and other59 rows remain closed.

A passed attempt requires exactly95 roles under the unchanged96-member/35MiBraw/12MiBindividual/15MiBinnerZIP gates, all306 raw named control rows/events, two passed original root phases, exact derived records and manifest/path/payload identity. Exactly three original source-observation clocks are validated inside their owning phases; all other JSON values compare deeply with type distinctions. The actual syntax count is checked against raw output, never forecast. No application tests or original products execute in this reader or publication job. Full payload byte rehashing is not repeated locally.

Failed or incomplete attempts retain all uploaded bytes, partial source qualification and exact raw failures without95/306 acceptance. Artifact completeness, historical source view, current source view, root publication acceptance, app behavior and actual source installation journal are separate units. Neither source-only historical proposal text nor any earlier behavioral receipt is rebound. Root full source read plus independent full source peer is required before actual run binding, with a separate narrow binding peer before use.
// Read-only cloud evidence backup. Captured application/producer sources are never executed.
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import {spawnSync} from 'node:child_process';
import {createHash} from 'node:crypto';
const RUN='PENDING_RUN',HEAD='PENDING_HEAD',JOB='PENDING_JOB',ATTEMPT='1';
const READER='unpack-publication-notes36-306-PENDING.py',READER_BYTES='PENDING_READER_BYTES',READER_SHA256='PENDING_READER_SHA256';
assert(/^\d+$/.test(RUN)&&/^\d+$/.test(JOB)&&/^[0-9a-f]{40}$/.test(HEAD)&&Number.isSafeInteger(READER_BYTES)&&/^[0-9a-f]{64}$/.test(READER_SHA256),'UNBOUND template refuses before credentials, files or API');
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab'),repo='/repos/Ginderlax/rea-research-lab';
const sha=bytes=>createHash('sha256').update(bytes).digest('hex'),identity=bytes=>({bytes:bytes.length,sha256:sha(bytes)});
async function exists(file){try{await fs.lstat(file);return true;}catch(error){if(error.code==='ENOENT')return false;throw error;}}
async function regular(file,maximum){const stat=await fs.lstat(file);assert(stat.isFile()&&!stat.isSymbolicLink()&&stat.size<=maximum);const bytes=await fs.readFile(file);assert.equal(bytes.length,stat.size);return bytes;}
const credential=spawnSync('git',['credential','fill'],{cwd:lab,env:{...process.env,GIT_TERMINAL_PROMPT:'0',GCM_INTERACTIVE:'Never'},input:'protocol=https\nhost=github.com\n\n',encoding:'utf8',windowsHide:true,timeout:20000,maxBuffer:128*1024});assert.equal(credential.status,0,'Saved GitHub authentication unavailable');
const fields=Object.fromEntries(credential.stdout.split('\n').filter(line=>line.includes('=')).map(line=>{const at=line.indexOf('=');return[line.slice(0,at),line.slice(at+1)];}));assert(fields.password);
const headers={Accept:'application/vnd.github+json','User-Agent':'REA-current36-publication-backup','X-GitHub-Api-Version':'2022-11-28',Authorization:'Bearer '+fields.password};
async function get(endpoint,maximum){assert(endpoint.startsWith(repo+'/'));const response=await fetch('https://api.github.com'+endpoint,{headers,signal:AbortSignal.timeout(60000)});assert.equal(response.status,200,'Read-only GitHub GET failed');const length=Number(response.headers.get('content-length'));assert(!length||length<=maximum);let size=0;const chunks=[];for await(const chunk of response.body){size+=chunk.length;assert(size<=maximum);chunks.push(chunk);}return Buffer.concat(chunks);}
const folder=path.join(work,'cloud-verification-backups','run-'+RUN);await fs.mkdir(folder,{recursive:true});const control=path.join(folder,'notes36-publication-control-plane-'+new Date().toISOString().replace(/[:.]/g,'-'));await fs.mkdir(control);
const metadata=await Promise.all(['run','jobs','artifacts'].map(async kind=>{const bytes=await get(repo+'/actions/runs/'+RUN+(kind==='run'?'':'/'+kind),512*1024),value=JSON.parse(bytes),file=path.join(control,kind+'.json');await fs.writeFile(file,bytes,{flag:'wx'});assert.deepEqual(await fs.readFile(file),bytes);return{kind,path:file,...identity(bytes),value};}));
const [run,jobs,artifacts]=metadata.map(row=>row.value);assert.equal(String(run.id),RUN);assert.equal(String(run.run_attempt),ATTEMPT);assert.equal(run.head_sha,HEAD);assert.equal(run.head_branch,'codex/rea-cloud-recovery-20261015');assert.equal(run.repository.full_name,'Ginderlax/rea-research-lab');assert.equal(run.path,'.github/workflows/publication-integrity-cloud.yml');assert(['pull_request','workflow_dispatch'].includes(run.event));assert.equal(jobs.total_count,1);assert.equal(jobs.jobs.length,1);const job=jobs.jobs[0];assert.equal(String(job.id),JOB);assert.equal(String(job.run_id),RUN);assert.equal(job.head_sha,HEAD);assert.equal(job.name,'publication-integrity');assert.equal(job.runner_group_name,'GitHub Actions');assert(job.labels.includes('windows-2022'));
const summary={schema:'rea-current36-publication-readonly-collection/v1',collectedAtUtc:new Date().toISOString(),runId:RUN,jobId:JOB,headSHA:HEAD,runAttempt:ATTEMPT,runStatus:run.status,runConclusion:run.conclusion,jobStatus:job.status,jobConclusion:job.conclusion,metadata:metadata.map(({value,...row})=>row),artifacts:[],localCandidateExecutions:0,localProductExecutions:0,localTests:0,localBuilds:0,localSyntaxChecks:0,applicationBehaviorAccepted:false,metadataImported:false,fullParity:false,superiority:false};
if(run.status!=='completed'||job.status!=='completed'){
 summary.collectionState='Nonterminal API snapshot only; no complete backup or acceptance.';await fs.writeFile(path.join(control,'nonterminal-observation.json'),JSON.stringify(summary,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(summary));
}else{
 async function saveApi(kind,endpoint,maximum){const bytes=await get(endpoint,maximum),file=path.join(control,kind+'.json');JSON.parse(bytes);await fs.writeFile(file,bytes,{flag:'wx'});assert.deepEqual(await fs.readFile(file),bytes);summary.metadata.push({kind,path:file,...identity(bytes)});return JSON.parse(bytes);}
 const log=await get(repo+'/actions/jobs/'+JOB+'/logs',4*1024*1024),logFile=path.join(control,'job-'+JOB+'-logs.txt');await fs.writeFile(logFile,log,{flag:'wx'});summary.rawJobLog={path:logFile,...identity(log)};
 assert.equal(artifacts.total_count,1);assert.equal(artifacts.artifacts.length,1);const artifact=artifacts.artifacts[0];assert.equal(artifact.name,'publication-integrity-'+RUN+'-'+ATTEMPT);assert.equal(artifact.expired,false);assert.equal(String(artifact.workflow_run.id),RUN);assert.equal(artifact.workflow_run.head_sha,HEAD);assert(Number.isSafeInteger(artifact.id)&&artifact.id>0&&artifact.size_in_bytes>0&&artifact.size_in_bytes<=32*1024*1024);assert(/^sha256:[0-9a-f]{64}$/.test(artifact.digest));
 const expected=artifact.digest.slice(7),zip=path.join(folder,'artifact-'+artifact.id+'.zip');if(!await exists(zip)){const bytes=await get(repo+'/actions/artifacts/'+artifact.id+'/zip',32*1024*1024);assert.equal(bytes.length,artifact.size_in_bytes);assert.equal(sha(bytes),expected);await fs.writeFile(zip,bytes,{flag:'wx'});}const zipped=await regular(zip,32*1024*1024);assert.equal(zipped.length,artifact.size_in_bytes);assert.equal(sha(zipped),expected);
 const reader=path.join(work,READER),readerBytes=await regular(reader,256*1024);assert.equal(readerBytes.length,READER_BYTES);assert.equal(sha(readerBytes),READER_SHA256);
 const python='C:/Users/evanh/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/python.exe';
 async function observedReader(label,args){const child=spawnSync(python,[reader,...args],{encoding:'utf8',windowsHide:true,timeout:120000,maxBuffer:4*1024*1024}),stdout=Buffer.from(child.stdout??''),stderr=Buffer.from(child.stderr??'');for(const[kind,bytes]of [['stdout',stdout],['stderr',stderr]])await fs.writeFile(path.join(control,label+'-'+kind+'.txt'),bytes,{flag:'wx'});const receipt={label,reader:READER,...identity(readerBytes),exitCode:child.status,signal:child.signal??null,error:child.error?{name:child.error.name,code:child.error.code??null}:null,stdout:identity(stdout),stderr:identity(stderr)};return{receipt,stdout};}
 const peek=await observedReader('data-only-header-discovery',['--peek',zip,expected]);summary.headerDiscoveryInvocation=peek.receipt;let tested=null;
 if(peek.receipt.exitCode===0){const header=JSON.parse(peek.stdout);assert.equal(header.schema,'rea-data-only-publication-header-discovery/v1');if(header.sourceCommit!==null){assert(/^[0-9a-f]{40}$/.test(header.sourceCommit));tested=header.sourceCommit;}}
 await saveApi('head-commit',repo+'/git/commits/'+HEAD,512*1024);
 if(tested){const commit=await saveApi('tested-commit',repo+'/git/commits/'+tested,512*1024);assert.equal(commit.sha,tested);assert(/^[0-9a-f]{40}$/.test(commit.tree.sha));const tree=await saveApi('tested-tree',repo+'/git/trees/'+commit.tree.sha+'?recursive=1',32*1024*1024);assert.equal(tree.sha,commit.tree.sha);assert.equal(tree.truncated,false);}
 const report=path.join(folder,'artifact-'+artifact.id+'-notes36-publication-reader-v1','local-notes36-publication-backup-verification.json');
 if(!await exists(report)){const child=await observedReader('data-only-full-backup-reader',[zip,expected,control,String(artifact.id)]);summary.backupReaderInvocation=child.receipt;if(child.receipt.exitCode!==0){summary.artifacts.push({artifactId:String(artifact.id),path:zip,...identity(zipped),readabilityVerified:false});summary.collectionState='Original uploaded ZIP/API/logs retained; data-only backup reader failed. No publication acceptance.';await fs.writeFile(path.join(control,'collection-summary-reader-failed.json'),JSON.stringify(summary,null,2)+'\n',{flag:'wx'});throw new Error('Data-only95-role backup reader failed; raw ZIP and observation retained.');}}
 const verified=JSON.parse(await regular(report,4*1024*1024));assert.equal(verified.schema,'rea-local-current36-publication-backup/v1');assert.equal(verified.runId,RUN);assert.equal(verified.headSHA,HEAD);assert.equal(verified.jobId,JOB);assert.equal(verified.artifactId,String(artifact.id));assert.deepEqual(verified.artifactIdentity,identity(zipped));assert.equal(verified.allCRCAndBytesReadable,true);
 summary.artifacts.push({artifactId:String(artifact.id),path:zip,...identity(zipped),readabilityVerified:true,readableFileCount:verified.files.length,backupVerification:report,publicationAcceptance:verified.publicationAcceptance,qualification:verified.qualification,auditErrors:verified.auditErrors});summary.collectionState='Complete uploaded bytes retained before qualification; failed/partial source or publication attempts remain unaccepted.';const file=path.join(control,'collection-summary.json');await fs.writeFile(file,JSON.stringify(summary,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({...summary,artifacts:summary.artifacts.map(({qualification,...row})=>row)}));
}
"""Data-only current36 publication backup qualification; captured code is never executed."""
import sys,json,zipfile,hashlib,stat,re,io,gzip,base64,ast,copy,datetime
from pathlib import Path
RUN='PENDING_RUN'
HEAD='PENDING_HEAD'
JOB='PENDING_JOB'
if not (RUN.isdigit() and JOB.isdigit() and re.fullmatch(r'[0-9a-f]{40}',HEAD)):
 raise RuntimeError('UNBOUND template refuses before filesystem, credentials or API access')
ATTEMPT='1';REPOSITORY='Ginderlax/rea-research-lab';WORKFLOW='.github/workflows/publication-integrity-cloud.yml'
PRODUCER={'bytes':79976,'sha256':'7093aac7045aaea5fc31c1354ff222f530d32c1c0bd42ba6860d01ef1a083128'}
CONTROLS={'bytes':74921,'sha256':'6178c7eedc355b2f5e9ba9be009d6558b0fcf99158803437268289682ee1b51d'}
DECLARATION='products/rea-studio/results/notes36-source-transition-20261016/current-source-declaration.json'
DECLARATION_PIN={'bytes':60830,'sha256':'c0a488389094d898a7f6d308e9977192327f194ce3d271135dfcd2007e8a73bb'}
EXPECTED_MEMBERS=__EXACT_95_PUBLICATION_ROLES__
sha=lambda b:hashlib.sha256(b).hexdigest()
identity=lambda b:{'bytes':len(b),'sha256':sha(b)}
def need(condition,label):
 if not condition: raise AssertionError(label)
def safe(name):
 need(isinstance(name,str) and name and len(name)<=4096 and not name.startswith('/') and not re.search(r'[\\:\x00-\x1f\x7f]',name),'Safe portable path')
 need(all(p and p not in ('.','..') for p in name.split('/')),'Safe portable components');return name
def parsed(data): return json.loads(data.decode('utf-8-sig'))
def utc(value):
 need(isinstance(value,str) and re.fullmatch(r'\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{3}Z',value),'Exact millisecond UTC')
 result=datetime.datetime.fromisoformat(value.replace('Z','+00:00'));need(result.isoformat(timespec='milliseconds').replace('+00:00','Z')==value,'Round-trip UTC');return result
if len(sys.argv)==4 and sys.argv[1]=='--peek':
 source=Path(sys.argv[2]).resolve();expected=sys.argv[3];base=Path(__file__).resolve().parent/'cloud-verification-backups'
 need(source.is_relative_to(base.resolve()) and re.fullmatch(r'[0-9a-f]{64}',expected),'Owned bounded header discovery')
 content=source.read_bytes();need(len(content)<=32*1024*1024 and sha(content)==expected,'Exact API-bound header ZIP')
 with zipfile.ZipFile(io.BytesIO(content)) as outer:
  entries=outer.infolist();need(len(entries)<=4 and sum(e.file_size for e in entries)<=32*1024*1024,'Bounded outer header container')
  leaves=[e for e in entries if not e.is_dir()];need(len(leaves)==1 and leaves[0].filename.endswith('.zip') and leaves[0].file_size<=15*1024*1024,'One bounded inner header ZIP')
  for entry in entries: safe(entry.filename.rstrip('/'));need(not stat.S_ISLNK(entry.external_attr>>16) and not entry.flag_bits&1,'Regular header carrier')
  inner=outer.read(leaves[0])
 with zipfile.ZipFile(io.BytesIO(inner)) as archive:
  entries=archive.infolist();need(len(entries)<=96 and sum(e.file_size for e in entries)<=35*1024*1024 and all(e.file_size<=12*1024*1024 for e in entries),'Fixed inner header boundaries')
  names=[e.filename for e in entries];need(len({n.casefold() for n in names})==len(names),'Unique header members')
  for entry in entries: safe(entry.filename.rstrip('/'));need(not stat.S_ISLNK(entry.external_attr>>16) and not entry.flag_bits&1,'Regular header member')
  found=[e for e in entries if e.filename=='attempt-validation.json'];need(len(found)<=1,'One producer receipt header')
  if found: need(found[0].file_size<=256*1024,'Bounded receipt header')
  receipt=parsed(archive.read(found[0])) if found else None
 candidate=receipt.get('sourceCommit') if isinstance(receipt,dict) else None
 need(candidate is None or isinstance(candidate,str) and re.fullmatch(r'[0-9a-f]{40}',candidate),'Discovered source SHA syntax')
 print(json.dumps({'schema':'rea-data-only-publication-header-discovery/v1','sourceCommit':candidate,'receiptPresent':receipt is not None,'scope':'Unqualified sourceCommit discovery for read-only actual Git API retrieval; no source/product/publication acceptance.'}));sys.exit(0)
need(len(sys.argv)==5,'ZIP SHA256 raw-control-folder artifact-ID')
source=Path(sys.argv[1]).resolve();expected=sys.argv[2];control=Path(sys.argv[3]).resolve();artifact_id=sys.argv[4]
base=Path(__file__).resolve().parent/'cloud-verification-backups'
need(source.is_relative_to(base.resolve()) and source.is_file() and control.is_relative_to(base.resolve()) and control.is_dir(),'Owned backup/API directories')
need(re.fullmatch(r'[0-9a-f]{64}',expected) and artifact_id.isdigit(),'Artifact identity syntax')
raw=source.read_bytes();need(len(raw)<=32*1024*1024 and sha(raw)==expected,'Bounded exact uploaded ZIP')
folder=source.parent/(source.stem+'-notes36-publication-reader-v1');folder.mkdir(exist_ok=False)
def unpack(data,directory,entries_limit,raw_limit,file_limit):
 directory.mkdir(parents=True,exist_ok=False);rows=[];seen=set()
 with zipfile.ZipFile(io.BytesIO(data)) as zipped:
  entries=zipped.infolist();need(len(entries)<=entries_limit and sum(x.file_size for x in entries)<=raw_limit,'Fixed ZIP count/raw bound')
  for entry in entries:
   name=entry.filename;normal=name[:-1] if entry.is_dir() else name;safe(normal)
   need(normal.casefold() not in seen,'Unique case-independent ZIP path');seen.add(normal.casefold())
   need(not entry.flag_bits&1 and not stat.S_ISLNK(entry.external_attr>>16) and entry.file_size<=file_limit,'Regular unencrypted bounded member')
