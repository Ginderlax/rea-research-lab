    {
      "id": "grafana.candidate.8ec6f65f290f7a963488",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If the configuration option requires a JMESPath expression that includes a colon, enclose the entire expression in quotes to prevent parsing errors. For example `role_attribute_path: \"role:view\"`",
