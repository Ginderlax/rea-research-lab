import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import os from 'node:os';import{start}from'../../server.mjs';
const observations=[];
function scene(){return {vendor:{raw:'retained'},flows:[{id:'tab',type:'tab'},{id:'other',type:'tab'},{id:'start',type:'inject',z:'tab',props:[],wires:[['remember']]},{id:'remember',type:'change',z:'tab',rules:[{t:'set',p:'last',pt:'global',to:'payload',tot:'msg'},{t:'set',p:'source',pt:'flow',to:'payload',tot:'msg'}],wires:[['out']]},{id:'out',type:'link out',z:'tab',links:[],wires:[['unsupported-ignored']]},{id:'in',type:'link in',z:'other',links:['out'],wires:[['destination']]},{id:'destination',type:'change',z:'other',rules:[{t:'set',p:'copy',pt:'msg',to:'last',tot:'global'},{t:'set',p:'destination',pt:'flow',to:'payload',tot:'msg'}],wires:[['debug']]},{id:'debug',type:'debug',z:'other',complete:'true',active:true,tosidebar:true,wires:[]},{id:'unsupported-ignored',type:'community-not-implemented',z:'tab',wires:[]}]};}
async function owned(){const directory=await fs.mkdtemp(path.join(os.tmpdir(),'rea-flow-link-http-'));let host=await start({port:0,dataDir:directory}),starts=1,closed=false;const calls=[];async function request(action,input={},auth=true){const response=await fetch(host.url+'/api/flow/'+action,{method:'POST',headers:{'Content-Type':'application/json',...(auth?{'X-Rea-Token':host.token}:{})},body:JSON.stringify(input)});const result=await response.json();calls.push({action,status:response.status,input:structuredClone(input),response:structuredClone(result)});return {status:response.status,...(result.result??result)};}return{directory,calls,request,get host(){return host;},async restart(){await host.close();closed=true;host=await start({port:0,dataDir:directory});starts++;closed=false;},async close(label){if(!closed)await host.close();closed=true;assert.equal(path.dirname(directory),path.resolve(os.tmpdir()));assert(path.basename(directory).startsWith('rea-flow-link-http-'));await fs.rm(directory,{recursive:true,force:true});observations.push({label,hostStarts:starts,hostClosed:true,tempRemoved:true,calls});}};}
test.after(async()=>{const output=process.env.FLOW_LINK_OBSERVATIONS??path.join(os.tmpdir(),'rea-flow-link-http-observations-'+process.pid);await fs.mkdir(output,{recursive:true});await fs.writeFile(path.join(output,'link-http.json'),JSON.stringify({scope:'Actual unchanged shared Studio host, real HTTP and disk store; five owned ephemeral host starts across three finite cases, no browser/original GUI/benchmark',observations},null,2)+'\n');});
test('real HTTP cross-tab virtual links persist exact raw document/context/deployment across disk restart',async()=>{const f=await owned();try{const raw='\r\n'+JSON.stringify(scene(),null,3)+'\r\n',saved=await f.request('native-save',{name:'HTTP link fixture',text:raw});assert.equal(saved.status,200);const id=saved.flow.id;const validated=await f.request('native-validate',{text:raw});assert.equal(validated.runReady,true);assert.deepEqual(validated.linkConnections,[{source:'out',target:'in'}]);assert(validated.issues.some(x=>x.node==='unsupported-ignored'));assert.equal((await f.request('native-deploy',{id})).status,200);const run=(await f.request('native-inject',{id,messages:[{_msgid:'fixed',payload:17}]})).run;assert.equal(run.status,'completed');assert.deepEqual(run.debug.map(x=>x.node),['debug']);assert.deepEqual(run.debug[0].message,{_msgid:'fixed',payload:17,copy:17,_event:'node:out'});const state=(await f.request('native-inspect',{id})).state;assert.equal(state.global.last,17);assert.equal(state.flows.tab.source,17);assert.equal(state.flows.other.destination,17);const changed=scene();changed.flows[4].links=[];changed.flows[5].links=[];const draft=JSON.stringify(changed);await f.request('native-save',{id,name:'HTTP link fixture',text:draft});await f.restart();const exported=await f.request('native-export',{id});assert.equal(exported.text,draft);const stillOld=(await f.request('native-inject',{id,messages:[{_msgid:'next',payload:23}]})).run;assert.deepEqual(stillOld.debug.map(x=>x.node),['debug']);assert.equal(stillOld.deployedRevision,run.deployedRevision);const reopened=await f.request('native-inspect',{id});assert.equal(reopened.state.global.last,23);assert.equal(reopened.runs.length,2);await f.request('native-deploy',{id});const next=(await f.request('native-inject',{id,messages:[{_msgid:'new',payload:31}]})).run;assert.equal(next.status,'completed');assert.equal(next.debug.length,0);assert.notEqual(next.deployedRevision,run.deployedRevision);await f.request('native-save',{id,name:'HTTP link fixture',text:raw});assert.equal((await f.request('native-export',{id})).text,raw);}finally{await f.close('cross-tab-restart');}});
test('real HTTP preflight refuses bad virtual targets and unsupported reachable nodes before deployment; private controls remain enforced',async()=>{const f=await owned();try{for(const kind of['missing','not-link-in','unsupported-after-in','return-mode','call-mode']){const nodes=scene();if(kind==='missing')nodes.flows[4].links=['absent'];if(kind==='not-link-in')nodes.flows[4].links=['debug'];if(kind==='unsupported-after-in')nodes.flows[5].wires=[['unsupported-ignored']];if(kind==='return-mode')nodes.flows[4].mode='return';if(kind==='call-mode')nodes.flows[4].type='link call';const text=JSON.stringify(nodes),validation=await f.request('native-validate',{text});assert.equal(validation.status,200);assert.equal(validation.runReady,false);const saved=await f.request('native-save',{name:kind,text});assert.equal(saved.status,200);assert.equal((await f.request('native-deploy',{id:saved.flow.id})).status,400);assert.equal((await f.request('native-inspect',{id:saved.flow.id})).stateStored,false);}assert.equal((await f.request('native-list',{},false)).status,403);const privateResponse=await fetch(f.host.url+'/apps/flow/native-link.mjs');assert.equal(privateResponse.status,404);f.calls.push({action:'private-helper-static-route',status:privateResponse.status});}finally{await f.close('preflight-private-controls');}});
test('real HTTP cycle budget failure rolls back changed context and leaves prior successful state across reopening',async()=>{const f=await owned();try{const nodes=scene(),saved=await f.request('native-save',{name:'Rollback fixture',text:JSON.stringify(nodes)}),id=saved.flow.id;await f.request('native-deploy',{id});assert.equal((await f.request('native-inject',{id,messages:[{_msgid:'good',payload:5}]})).run.status,'completed');const before=(await f.request('native-inspect',{id})).state;nodes.flows[5].wires=[['out']];await f.request('native-save',{id,name:'Rollback fixture',text:JSON.stringify(nodes)});await f.request('native-deploy',{id});const failed=(await f.request('native-inject',{id,messages:[{_msgid:'cycle',payload:99}]})).run;assert.equal(failed.status,'failed');assert.match(failed.error,/5,000|5000/);assert.deepEqual((await f.request('native-inspect',{id})).state,before);await f.restart();const after=await f.request('native-inspect',{id});assert.deepEqual(after.state,before);assert.equal(after.runs.at(-1).status,'failed');assert.equal(after.runs.length,2);}finally{await f.close('cycle-context-rollback');}});
