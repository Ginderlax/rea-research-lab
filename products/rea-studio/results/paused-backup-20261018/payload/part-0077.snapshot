    {
      "id": "grafana.candidate.f09885d774c2360e15c3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To determine that Grafana is running, open a browser window and type `IP_ADDRESS:3000`. The sign in screen should appear.",
      "headingPath": [
        "Run Grafana Docker image",
        "Run Grafana via Docker Compose",
        "Run the latest stable version of Grafana"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/installation/docker/index.md",
