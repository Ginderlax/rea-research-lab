import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import {spawnSync} from 'node:child_process';
const own=path.dirname(fileURLToPath(import.meta.url)),stage=path.resolve(own,'../keepass-history-next'),repo=path.resolve(own,'../../outputs/rea-research-lab'),sha=bytes=>createHash('sha256').update(bytes).digest('hex');
async function preserve(source,relative,expected){const bytes=await fs.readFile(source),digest=sha(bytes);if(expected&&digest!==expected)throw new Error('Authentication mismatch: '+source);const target=path.join(own,'original-baseline-v2',relative+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,bytes,{flag:'wx'});return{path:relative,source,bytes:bytes.length,sha256:digest,snapshot:path.relative(own,target).replaceAll('\\','/')};}
const baseline=JSON.parse(await fs.readFile(path.join(stage,'baseline-validation.json'))),census=JSON.parse(await fs.readFile(path.join(stage,'source-census.final.json'))),rows=[];
for(const row of baseline.appFiles){rows.push(await preserve(path.join(stage,'baseline',row.path+'.snapshot'),'baseline/'+row.path,row.sha256));if(sha(await fs.readFile(path.join(repo,row.path)))!==row.sha256)throw new Error('Current production differs from author baseline: '+row.path);}
rows.push(await preserve(path.join(stage,'baseline/compatibility-evidence.json.snapshot'),'baseline/compatibility-evidence.json',baseline.oldCompatibilityReceiptSha256));
for(const row of census.selectedFiles)rows.push(await preserve(path.join(stage,'source',row.path),'source/'+row.path,row.sha256));
for(const name of ['baseline-validation.json','source-census.final.json','source-acquisition.final.json','source-acquisition.json','contract-map.json','SOURCE-CONTRACTS.md'])rows.push(await preserve(path.join(stage,name),name));
const publisherMeta=JSON.parse(await fs.readFile(path.join(stage,'.local/acquisition/00.json'))),publisher=await preserve(path.join(stage,'.local/acquisition/00.bin'),'publisher-integrity.html',publisherMeta.sha256);rows.push(publisher);const publisherRaw=await fs.readFile(path.join(stage,'.local/acquisition/00.bin'),'utf8'),sourceSection=publisherRaw.slice(publisherRaw.indexOf('KeePass-2.61.1-Source.zip'),publisherRaw.indexOf('KeePass-2.61.1-Source.zip')+1800).replace(/\s+/g,'').toLowerCase();if(!sourceSection.includes(census.archiveSha256))throw new Error('Retained publisher source ZIP digest not found.');
const contracts=JSON.parse(await fs.readFile(path.join(stage,'contract-map.json')));for(const row of contracts.contracts){const bytes=await fs.readFile(path.join(stage,'source',row.file));if(sha(bytes)!==row.fileSha256||sha(bytes.subarray(row.utf8ByteOffset,row.utf8ByteOffset+row.utf8ByteLength))!==row.spanSha256)throw new Error('Contract source/span mismatch: '+row.id);}
const archive=path.join(stage,'.local/KeePass-2.61.1-Source.zip'),archiveBytes=await fs.readFile(archive);if(sha(archiveBytes)!==census.archiveSha256)throw new Error('Source ZIP digest differs.');const executable=path.join(repo,'projects/07-keepass/artifacts/portable/KeePass.exe'),exeBytes=await fs.readFile(executable),exeSha=sha(exeBytes);if(exeSha!=='04d29636c393f0c1fc99ff739295494be3adefded93271e44591e8e300225a5a')throw new Error('Original released executable identity differs.');
const child=spawnSync('pwsh',['-NoProfile','-File',path.join(own,'verify-original-archive.ps1'),'-Archive',archive,'-Census',path.join(stage,'source-census.final.json')],{windowsHide:true,encoding:'utf8',timeout:10000,maxBuffer:1024*1024});await fs.writeFile(path.join(own,'original-auth.stdout.txt'),child.stdout??'');await fs.writeFile(path.join(own,'original-auth.stderr.txt'),child.stderr??'');if(child.status!==0)throw new Error('Independent ZIP source check failed.');const result=JSON.parse(child.stdout);const receipt={schema:'rea-independent-keepass-original-baseline/v1',createdAt:new Date().toISOString(),productionBaselineFiles:baseline.appFiles.length,productionBaselineUnchanged:true,originalSelectedSources:census.selectedFiles.length,originalSourceArchive:{path:archive,bytes:archiveBytes.length,sha256:census.archiveSha256,independentZipReader:'PowerShell .NET ZipFile; stream SHA256 of exact selected ZIP entries'},originalExecutable:{path:executable,bytes:exeBytes.length,sha256:exeSha,executed:false},publisherDigestBytesAuthenticated:true,openPgpVerified:false,contractSpansAuthenticated:contracts.contracts.length,rows,sourceZipCheck:result,candidateBytesNotYetBound:true,initialToolObservations:[{kind:'Path discovery',result:'Expected original/ directory absent; actual retained source/ used.'},{kind:'Search syntax',result:'Windows rg literal wildcard argument failed; subsequent directory/file reads used.'},{kind:'Overbroad original-project search',result:'Search returned oversized minified JSON; truncated output not used as evidence.'}]};await fs.writeFile(path.join(own,'original-baseline-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({productionFiles:receipt.productionBaselineFiles,selectedOriginalSources:receipt.originalSelectedSources,sourceZipEntries:result.archiveEntries,originalArchiveSha256:census.archiveSha256,contractSpans:receipt.contractSpansAuthenticated,candidateExecuted:false}));
