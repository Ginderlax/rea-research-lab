        "products": [
          "cloud",
          "enterprise",
          "oss"
        ],
        "restriction": "What's new in Grafana v8.4 > Grafana Enterprise > Performance improvements > Recorded queries is more stable and usable"
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
