    },
    {
      "id": "grafana.candidate.fd0b11fcb2be7f3ac4bf",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Data from other queries or expressions are referenced with the RefID prefixed with a dollar sign, for example `$A`. If the variable has spaces in the name, then you can use a brace syntax like `${my variable}`.",
      "headingPath": [
        "Write expression queries",
        "About expressions",
        "Operations",
        "Math"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/expression-queries/index.md",
