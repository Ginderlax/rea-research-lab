import fs from 'node:fs/promises';
import {createHash} from 'node:crypto';
import {stripTypeScriptTypes} from 'node:module';
import vm from 'node:vm';
const root=new URL('./results/notebook-trash-followup/stage/',import.meta.url),hash=bytes=>createHash('sha256').update(bytes).digest('hex');
export function method(source,name){const start=source.search(new RegExp(`public static (?:async )?${name}\\(`));if(start<0)throw new Error('Original method not found: '+name);let depth=0;const brace=source.indexOf('{',start);for(let pos=brace;pos<source.length;pos++){if(source[pos]==='{')depth++;if(source[pos]==='}'&&!--depth)return{source:source.slice(start,pos+1),startLine:source.slice(0,start).split('\n').length,endLine:source.slice(0,pos+1).split('\n').length};}throw new Error('Original method did not terminate.');}
export async function originalOrganization({folders,notes=[],time}){const provenance=JSON.parse(await fs.readFile(new URL('prior-source-provenance.json.snapshot',root))),sources=await Promise.all(['packages/lib/models/Folder.ts','packages/lib/models/Note.ts'].map(async name=>{const record=provenance.sources.find(row=>row.url.endsWith('/'+name)),bytes=await fs.readFile(new URL(record.path+'.snapshot',root));if(hash(bytes)!==record.sha256)throw new Error('Original source authentication failed.');return{name,text:bytes.toString('utf8'),...record};})),slices=sources.flatMap(source=>(source.name.endsWith('/Folder.ts')?['folderPath','canNestUnder','moveToFolder']:['moveToFolder']).map(name=>({path:source.name,method:name,...method(source.text,name)}))),folderRows=new Map(folders.map(row=>[row.id,structuredClone(row)])),noteRows=new Map(notes.map(row=>[row.id,structuredClone(row)])),calls=[];
 const additional=JSON.parse(await fs.readFile(new URL('license-and-special-id-provenance.json.snapshot',root))),special=additional.find(row=>row.url.endsWith('/getConflictFolderId.ts')),specialBytes=await fs.readFile(new URL(special.path+'.snapshot',root));if(hash(specialBytes)!==special.sha256)throw new Error('Original reserved-ID helper authentication failed.');const conflictId=vm.runInNewContext(stripTypeScriptTypes(specialBytes.toString('utf8').replace('export default','')));
 const context={_:value=>value,time:{unixMs:()=>time},isRootSharedFolder:folder=>Boolean(folder?.share_id&&!folder?.parent_id)};const Folder=vm.runInNewContext(stripTypeScriptTypes('class Folder {\n'+slices.filter(s=>s.path.endsWith('/Folder.ts')).map(s=>s.source).join('\n')+'\n};Folder;'),context);Folder.load=async id=>structuredClone(folderRows.get(id));Folder.conflictFolderId=conflictId;Folder.save=async(value,options)=>{calls.push({model:'Folder',value:structuredClone(value),options:structuredClone(options)});const row={...folderRows.get(value.id),...value};folderRows.set(row.id,row);return row;};
 const Note=vm.runInNewContext(stripTypeScriptTypes('class Note {\n'+slices.find(s=>s.path.endsWith('/Note.ts')).source+'\n};Note;'),context);Note.getClass=()=>Folder;Note.save=async(value,options)=>{calls.push({model:'Note',value:structuredClone(value),options:structuredClone(options)});const row={...noteRows.get(value.id),...value};noteRows.set(row.id,row);return row;};
 return{Folder,Note,calls,folderRows,noteRows,bindings:slices.map(({source,...row})=>({...row,sourceSha256:sources.find(s=>s.name===row.path).sha256,sliceSha256:hash(source)})),scope:'Four exact released Desktop3.6.14 methods; in-memory load/save and fixed-clock stubs. No original database, synchronization, desktop UI or release executable is executed.'};}
