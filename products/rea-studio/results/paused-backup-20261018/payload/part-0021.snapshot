  else: expect(ident(current(row['path']))==row['before'],'Exact current before pin '+row['path'])
 checks['allBefore32Protected13AndModified8AuthenticatedToActualGit']=True;checks['selectedCurrentGitBlobs']=len(required)
 stage='current36-and21-roster'
 decl_name='products/rea-studio/results/notes36-source-transition-20261016/current-source-declaration.json';decl=json.loads(proposed(decl_name))
