    },
    {
      "id": "grafana.candidate.5fba2453fb633cf3cddb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The text element lets you add text to the canvas. The element also supports an editing mode, triggered via either double clicking or the edit menu option in the context menu.",
      "headingPath": [
        "Canvas",
        "Elements",
        "Element types",
        "Text"
      ],
