def stable(value,phase,recorded):
    value=copy.deepcopy(value);s=value['followup_evidence']['notesLayoutValueApiCheckpoint']['sketch']
    assert s['schema']=='rea-sketch-layout-installed-source-proof/v1' and s['sourceOnly'] is True
    clocks={'checked_at_utc':value['checked_at_utc'],'sketchStarted':s['started'],'sketchFinished':s['finished'],'phaseStartedAtUtc':phase['startedAtUtc'],'phaseCompletedAtUtc':phase['completedAtUtc']}
    assert clocks==recorded['clocks']
    sequence=[clocks[k] for k in ('phaseStartedAtUtc','sketchStarted','sketchFinished','checked_at_utc','phaseCompletedAtUtc')]
    values=[]
    for text in sequence:
        dt=datetime.datetime.fromisoformat(text.replace('Z','+00:00'))
        assert dt.isoformat(timespec='milliseconds').replace('+00:00','Z')==text
        values.append(dt)
    assert values==sorted(values)
    del value['checked_at_utc'];del s['started'];del s['finished']
    return value
