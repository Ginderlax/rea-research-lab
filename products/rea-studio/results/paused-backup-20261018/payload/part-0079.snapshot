    {
      "id": "grafana.candidate.f425c80f61bd16055d6c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Pause and resume alert rule evaluation directly from the Alert rules list and details view. This helps Improve visibility of when alert rules have been paused by displaying “Paused” as the alert rule state.",
      "headingPath": [
        "What’s new in Grafana v11.1",
        "Alerting",
        "Improved paused alert visibility"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v11-1.md",
        "gitBlobSha": "914523a7f78d131db0348f0b42b05c53d8e00499",
        "sha256": "1e4e918c2b86d971d299831800abebdb03ca2c14febfc7d86e97f691b765b0b0",
        "lineStart": 123,
        "lineEnd": 123,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v11-1.md#L123-L123"
      },
      "applicability": {
