    },
    {
      "id": "grafana.candidate.13d8efe0a2409f965323",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This query would return a table with three columns with data types time, number, and string respectively:",
      "headingPath": [
        "Time series dimensions",
        "Multiple dimensions in table format",
        "Single dimension"
      ],
      "source": {
        "path": "docs/sources/fundamentals/timeseries-dimensions/index.md",
