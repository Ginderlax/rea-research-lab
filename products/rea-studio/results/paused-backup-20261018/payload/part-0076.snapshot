    {
      "id": "grafana.candidate.c66baa7af86d9967967b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Alternative cause:** A proxy between Grafana and Prometheus requires authentication. When proxy authentication fails, the proxy redirects the request to an HTML authentication page. Grafana cannot parse the HTML response, which results in a parse error. This appears to be a query issue but is actually a proxy authentication issue.",
      "headingPath": [
        "Troubleshoot Prometheus data source issues",
        "Query errors",
        "Query syntax error"
      ],
