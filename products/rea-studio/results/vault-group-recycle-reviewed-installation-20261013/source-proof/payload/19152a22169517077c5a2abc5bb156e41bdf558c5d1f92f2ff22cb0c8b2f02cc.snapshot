import fs from'node:fs/promises';import path from'node:path';import{fileURLToPath}from'node:url';import{createHash}from'node:crypto';import assert from'node:assert/strict';const own=path.dirname(fileURLToPath(import.meta.url)),old=path.resolve(own,'../keepass-group-recycle-next'),review=path.resolve(own,'../keepass-group-postfreeze-review'),sha=b=>createHash('sha256').update(b).digest('hex');
async function auth(dir,name,pin){const mb=await fs.readFile(path.join(dir,name));assert.equal(sha(mb),pin);const m=JSON.parse(mb);for(const r of m.inventory){const b=await fs.readFile(path.join(dir,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);}return{path:path.relative(path.resolve(own,'../..'),dir).replaceAll('\\','/')+'/'+name,bytes:mb.length,sha256:sha(mb),records:m.inventory.length};}
const refs=[await auth(old,'manifest.json','048fc56fded29bb89cf43830919c4b717a82d055e531644028b85ef07917e28d'),await auth(review,'manifest.json','fca7b59a86ecb99ed54b20b2c2cca82d0a36df4349db29778bf5909eadd2590a')];
async function copy(relative){const source=path.join(old,relative),dest=path.join(own,relative);await fs.mkdir(path.dirname(dest),{recursive:true});await fs.copyFile(source,dest);}async function dir(relative){for(const e of await fs.readdir(path.join(old,relative),{withFileTypes:true})){const p=relative+'/'+e.name;if(e.isDirectory())await dir(p);else await copy(p);}}
for(const p of ['products/rea-studio/apps/vault','products/rea-studio/lib','baseline','source-study','manual-study'])await dir(p);for(const p of['baseline-source.json','authority-baseline.json','source-provenance.json','contract-map.json','run.mjs'])await copy(p);
for(const[dir,names,prefix]of[[old,['manifest.json','validation.json','freeze.json'],'references/initial777'],[review,['manifest.json','validation.json','probe.test.mjs','run.mjs','failure.json','control.json','stdout.txt','stderr.txt'],'references/negative10']])for(const name of names){const dest=path.join(own,prefix,name+'.snapshot');await fs.mkdir(path.dirname(dest),{recursive:true});await fs.copyFile(path.join(dir,name),dest);}
const baseline=[];for(const n of(await fs.readdir(path.join(own,'products/rea-studio/apps/vault'))).sort()){const b=await fs.readFile(path.join(own,'products/rea-studio/apps/vault',n)),destination='candidate-before/'+n+'.snapshot';await fs.mkdir(path.dirname(path.join(own,destination)),{recursive:true});await fs.writeFile(path.join(own,destination),b);baseline.push({path:'products/rea-studio/apps/vault/'+n,bytes:b.length,sha256:sha(b),destination});}
await fs.writeFile(path.join(own,'source-before.json'),JSON.stringify({schema:'rea-keepass-group-coherence-source-before/v1',refs,files:baseline,oldStagesUnchanged:true,productionWrites:0},null,2)+'\n');console.log(JSON.stringify({refs,baseline:baseline.length}));
