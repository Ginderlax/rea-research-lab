{
  "schemaVersion": 1,
  "createdAt": "2026-10-12T18:57:34.798Z",
  "productionChanged": false,
  "trials": [
    {
      "file": "candidate-percentile.mjs",
      "sha256": "fe1f1cf3b5b0228208be1845e4c4155b41793a5d3fffa460b261d01b28c4fc50",
      "change": "Remove redundant percentile slice after private filter/map.",
      "status": "unvalidated",
      "formalPairedTiming": false
    },
    {
      "file": "candidate-scalar.mjs",
      "sha256": "30f44a868683d724c205d43612099ce5e9d63ce7d1c09b6c122fc9795ff0fb02",
      "change": "Local standard accumulators; assemble complete result once, preserving arithmetic order.",
      "status": "unvalidated",
      "formalPairedTiming": false
    },
    {
      "file": "candidate-combined.mjs",
      "sha256": "35ba628ee6a84e3fe0f27fd20cb281d372555d899733f45b912c278e246910a8",
      "change": "Both independent changes.",
      "status": "unvalidated",
      "formalPairedTiming": false
    },
    {
      "file": "candidate-numeric.mjs",
      "sha256": "ad42a9ef924fc726e42ca3ef74097d881c67a2da45e10d91fcc16b4f68c123d3",
      "change": "Guarded primitive numeric standard path, unchanged generic fallback, private percentile copy removal.",
      "status": "unvalidated",
      "formalPairedTiming": false
    },
    {
      "file": "candidate-selection.mjs",
      "sha256": "3a45156c31de463181dbb63b915def3b234ee9431ab2750f225d0348cc44ea3d",
      "change": "Bounded finite primitive single-percentile partition selection; stable-sort fallback for signed-zero/nonfinite/null/string/sparse values; previous numeric/copy changes.",
      "status": "unvalidated",
      "formalPairedTiming": false
    },
    {
      "file": "candidate-dispatch.mjs",
      "sha256": "68d30156e15354fa062c0968ba68c07398e6a20ed77638fa21491d9c0b72d407",
      "change": "Allocation-free selection classification for standard requests; preserve special/empty/unknown/duplicate dispatch, with prior numeric/single-percentile trials.",
      "status": "unvalidated",
      "formalPairedTiming": false
    },
    {
      "file": "candidate-count.mjs",
      "sha256": "4e0e551585b54eea1290b6aff2b9808aa33d3c22c029fe7fde8dd6638af8c8db",
      "change": "Derive numeric count from length or non-null-plus-NaN counts; type guard before numeric NaN check. Prior dispatch and percentile changes.",
      "status": "unvalidated",
      "formalPairedTiming": false
    },
    {
      "file": "candidate-lean.mjs",
      "sha256": "ce2bc94f9dbdcfcdfdc554f45a9fe9547eaaea39464aee6a1a43a498e1d9376c",
      "change": "Narrow single-percentile-only selection. Standard body/queue/cache dispatch and shared sort retain production source; private-copy elimination and scalar/count changes excluded.",
      "status": "unvalidated",
      "formalPairedTiming": false,
      "selectionPlanning": "Scope narrowed after an overlapping exploratory run; no reliable performance rejection inference is made from that run."
    },
    {
      "file": "candidate-isolated.mjs",
      "sha256": "6ac1153c008d960de23766af1e4325cc0e77a5ab10c49be604d4d6e203f6e26f",
      "change": "Separate bounded single-percentile function and specialized/registry routing. Standard and complete existing shared-special function are source-identical; original generic queue/cache dispatch changes only its single-specialized expression.",
      "unchangedStandardSectionSHA256": "ab0fdec4eaa8c59f359e776ccb2e6fa39a293d09033d4bab124b6afcacc0278b",
      "unchangedSharedSpecialSectionSHA256": "ca982effcb595b039959e294aa830a3fe6e325a41c1273db73e1a4418041447d",
      "status": "unvalidated",
      "formalPairedTiming": false,
      "selectionPlanning": "Created after clean lean trial showed an all-percentile median regression; causal explanation is unproven and the prior receipt is retained."
    }
  ]
}
