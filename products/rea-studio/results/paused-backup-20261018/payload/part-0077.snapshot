      "sourceText": "- `rsa-sha256`: Recommended for most use cases",
      "headingPath": [
        "Configure SAML signing and encryption",
        "Signature algorithm",
        "Supported algorithms"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/configure-saml-signing-encryption/_index.md",
        "gitBlobSha": "62d939014dc2ac54e0cb6909b85905561839011d",
        "sha256": "033450d5f2b6a51e5aba8688130947990c7f9cb0d18ea203c6011d6e6938cd29",
