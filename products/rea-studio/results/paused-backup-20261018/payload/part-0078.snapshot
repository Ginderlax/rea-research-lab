    {
      "id": "grafana.candidate.2491bf7f68c9ac38c150",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Optional: Add a description to help the on-call engineer to better understand what the alert rule is about. Eg. This alert monitors CPU usage across instances and triggers if any instance exceeds a usage threshold of 75%.",
      "headingPath": [
