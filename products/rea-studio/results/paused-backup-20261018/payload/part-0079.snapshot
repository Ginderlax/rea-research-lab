    {
      "id": "grafana.candidate.76a30a0756c5da344069",
      "syntaxRole": "list-item",
      "sourceText": "- **Switching symbol name alignment**: Symbols with long names may be hard to differentiate if they have the same prefix. This new option allows you to align the text to the left or right so you can see the part of the symbol name that's important.",
      "headingPath": [
        "What’s new in Grafana v10.1",
        "Dashboards and visualizations",
        "Flame graph improvements"
      ],
