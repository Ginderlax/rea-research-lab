    {
      "id": "grafana.candidate.344391837e75da2695cf",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "A derived field produces a single value per log line, so you can't combine multiple labels or capture groups into one field or link. Create a separate derived field for each value you need to surface.",
      "headingPath": [
        "Troubleshoot Loki data source issues",
        "Derived field and log-to-trace link issues",
        "A single link needs values from more than one field"
      ],
