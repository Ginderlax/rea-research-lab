Use only the frozen tooling inputs assigned by the parent; the resulting work-only
proposal still requires independent complete review. This performs no installation.
"""
from pathlib import Path
import json,hashlib,sys,re
W=Path(r'C:/Users/evanh/Documents/Codex/2026-10-12/go/work');R=W.parent/'outputs/rea-research-lab';S=W/'notes36-installed-implementation-next'
def pin(b):return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
assert len(sys.argv)==2
toolroot=Path(sys.argv[1]).resolve();assert toolroot.is_relative_to(W.resolve()) and toolroot.is_dir()
collectorPath='products/rea-studio/scripts/verify-notes36-cloud.mjs';workflowPath='.github/workflows/notes-new-todo-installed-cloud.yml'
assert(toolroot/collectorPath).is_file()and(toolroot/workflowPath).is_file()
F=S/'producer-controls-assembled-r3-next';C=F/'public-candidate';assert not F.exists()
phase=S/'phase1-r2-next/public-candidate';migration=S/'integration-r2-next/public-candidate'
mp='scripts/editor-vault-proof-migration.mjs';mraw=(migration/mp).read_bytes();assert pin(mraw)=={'bytes':186405,'sha256':'6519e83c4315e60b503b67f306ed0a265cbcc141ff48b79db86d7da457026abf'}
dp='products/rea-studio/results/notes36-source-transition-20261016/current-source-declaration.json';db=(phase/dp).read_bytes();assert pin(db)=={'bytes':60830,'sha256':'c0a488389094d898a7f6d308e9977192327f194ce3d271135dfcd2007e8a73bb'};d=json.loads(db)
hp='products/rea-studio/scripts/verify-notes36-installed-cloud.mjs';hb=(phase/hp).read_bytes();assert pin(hb)=={'bytes':16788,'sha256':'648f28c93ee6f08f93fb6d715e9208f31dd12e8af45097fef01d58161ec2cbe2'}
def get(p):
 for base in[toolroot,phase,migration,R]:
  if(base/p).is_file():return(base/p).read_bytes()
 raise FileNotFoundError(p)
roleplan=json.loads((S/'publication-artifact-role-plan.json').read_bytes());artifactPaths=[r['path']for r in roleplan['rows']];assert len(set(artifactPaths))==95
toolNames=[hp,dp,workflowPath,'products/rea-studio/browser-tests/notes-new-todo.spec.mjs','products/rea-studio/browser-tests/playwright.notes-new-todo.config.mjs','products/rea-studio/browser-tests/notes-new-todo-roster.json','products/rea-studio/scripts/verify-cloud-browser.mjs','products/rea-studio/browser-tests/package.json','products/rea-studio/browser-tests/package-lock.json','products/rea-studio/browser-tests/browser-metadata.json','products/rea-studio/browser-tests/playwright.config.mjs','products/rea-studio/browser-tests/flow-vault.spec.mjs']
assert len(set(toolNames))==12
tooling={p:[pin(get(p))['bytes'],pin(get(p))['sha256']]for p in toolNames};selfrow={'path':collectorPath,**pin(get(collectorPath))};assert selfrow['bytes']<=256*1024
current={dp:pin(db),**{r['path']:{k:r[k]for k in['bytes','sha256']}for r in d['otherProofRows']}};assert len(current)==60 and sum(r['bytes']for r in current.values())==695900
for p,expected in current.items():assert pin(get(p))==expected,p
pp='scripts/verify-cloud-publication.mjs';pb=(R/pp).read_bytes();assert pin(pb)=={'bytes':47328,'sha256':'b036f37acbe88690ac1b22f7538d9e0f83935a1fd1b0622224879cc76cf6cd8b'}
cp='scripts/publication-integrity-controls.mjs';cb=(R/cp).read_bytes();assert pin(cb)=={'bytes':54066,'sha256':'3ea26c86c77d84e1f29af38b642183c7bcb143aac38125bfa9d7d72cfd869190'}
def normal(raw):return raw.decode().replace('\r\n','\n')
def replace_once(s,a,b):assert s.count(a)==1,(a,s.count(a));return s.replace(a,b)
producer=normal(pb)
producer=replace_once(producer,"'scripts/editor-vault-proof-migration.mjs': [177849, '23b964a261787e419e47ca0013706a4d6d616a4fe067f37d862e177d82cc1ac5']","'scripts/editor-vault-proof-migration.mjs': ["+str(len(mraw))+", '"+pin(mraw)['sha256']+"']")
gates=(W/'notes36-producer-fixed-gates-template.mjs').read_text();gates=replace_once(gates,'NOTES36_TOOLING_LITERAL',json.dumps(tooling,indent=2));gates=replace_once(gates,'NOTES36_COLLECTOR_SOURCE_LITERAL',json.dumps(selfrow,indent=2));gates=replace_once(gates,'NOTES36_ARTIFACT_PATHS_LITERAL',json.dumps(artifactPaths,indent=2))
marker='// BEGIN exact publication repeat projection (only three owned observation clocks).';assert producer.count(marker)==1
producer=producer.replace(marker,'const NOTES36_CURRENT='+json.dumps(current,indent=2)+';\n'+gates+'\n'+marker)
start=producer.index('  const notesRows=[];');end=producer.index("  for (const name of ['scripts/verify-cloud-publication.mjs'",start)
capture=(W/'notes36-producer-capture-template.mjs').read_text();producer=producer[:start]+capture+producer[end:]
guard="  assert.equal(receipt.publicationResult.historical937Tests, 937); assert.equal(receipt.publicationResult.finiteHosted282Tests, 282);"
rolecheck="""  const produced=[];function evidenceNames(directory,prefix=''){for(const item of fs.readdirSync(directory,{withFileTypes:true})){assert(!item.isSymbolicLink());const name=prefix+item.name;if(item.isDirectory())evidenceNames(path.join(directory,item.name),name+'/');else{assert(item.isFile());produced.push(name);}}}evidenceNames(evidence);assert.equal(produced.length,94);assert.equal(produced.includes('workflow-attempt.json'),false);verifyNotes36ArtifactRoles([...produced,'workflow-attempt.json']);receipt.artifactRoleContract.producerFilesVerified=94;receipt.artifactRoleContract.exactRoleSetVerifiedBeforeWorkflow=true;save();\n"""
producer=replace_once(producer,guard,guard+'\n'+rolecheck.rstrip('\n'))
producerBytes=producer.replace('\n','\r\n').encode();assert len(producerBytes)<=256*1024
controls=normal(cb)
old="assert.equal(s.notesCurrentSourcesMandatory,8);";new="assert.equal(s.notesCurrentSourcesMandatory,12);assert.equal(s.notesHistorical32SourcePlanMandatoryTargets,8);";controls=replace_once(controls,old,new)
old="for(const r of notesSources){assert.equal(migration.resolve(r.path,r.after),null);if(r.before)assert.equal(migration.resolve(r.path,r.before),r.beforeImage);}});"
new="for(const r of notesSources){const newer=notes36HistoricalAfterRoutes.find(row=>row.path===r.path);assert.equal(migration.resolve(r.path,r.after),newer?newer.beforeImage.path:null);if(r.before)assert.equal(migration.resolve(r.path,r.before),r.beforeImage);}});"
controls=replace_once(controls,old,new)
controls=replace_once(controls,"  positive('notes-eight-current-three-before-and-historical-metadata'","  const notes36HistoricalAfterRoutes=JSON.parse(read('"+dp+"')).installedTargets.filter(row=>row.before);\n  positive('notes-eight-current-three-before-and-historical-metadata'")
controls=replace_once(controls,'{"bytes":47328,"sha256":"b036f37acbe88690ac1b22f7538d9e0f83935a1fd1b0622224879cc76cf6cd8b"}',json.dumps(pin(producerBytes),separators=(',',':')))
insertion=(W/'notes36-publication-controls-insertion-r2.mjs').read_text();insertion=replace_once(insertion,'NOTES36_CONTROL_TOOLING_LITERAL',json.dumps(tooling,indent=2));insertion=replace_once(insertion,'NOTES36_CONTROL_SELF_LITERAL',json.dumps(selfrow,indent=2));insertion=replace_once(insertion,'NOTES36_CONTROL_ARTIFACT_PATHS_LITERAL',json.dumps(artifactPaths,indent=2))
controls=replace_once(controls,'  assert.equal(rows.length, 208);',insertion+'\n  assert.equal(rows.length, 306);')
controlBytes=controls.replace('\n','\r\n').encode();assert len(controlBytes)<=256*1024
def write(p,b):
 f=C/p;f.parent.mkdir(parents=True,exist_ok=True);assert not f.exists();f.write_bytes(b)
write(pp,producerBytes);write(cp,controlBytes)
prefix='products/rea-studio/results/notes36-source-transition-20261016/before-source/'
write(prefix+pp+'.snapshot',pb);write(prefix+cp+'.snapshot',cb)
files=[{'path':p,'before':pin((R/p).read_bytes())if(R/p).is_file()else None,'after':pin(f.read_bytes())}for f in sorted(C.rglob('*'))if f.is_file()for p in[f.relative_to(C).as_posix()]]
authority={'schema':'rea-Notes36-producer-controls-source-proposal/v3','sourceOnly':True,'status':'unexecuted-source-proposal-independent-full-review-required','files':files,'candidateFiles':len(files),'inputs':{'helper':{'path':hp,**pin(hb)},'declaration':{'path':dp,**pin(db)},'migration':{'path':mp,**pin(mraw)},'collector':selfrow,'workflow':{'path':workflowPath,**pin(get(workflowPath))}},'fixedTooling':tooling,'plannedControls':{'retained':208,'new':98,'total':306,'actualExecutionClaimed':False},'plannedArtifactRoles':{'roles':95,'capUnchanged':96,'current60Envelope':1,'tooling12Envelope':1,'separateSelfSnapshot':1},'sourceGroupBoundsUnchanged':True,'oldReceiptOrHelperRebinding':False,'localCandidateExecutions':0,'activeWrites':0,'sourceAuthor':{'path':'work/assemble-notes36-producer-controls-source-r3.py',**pin(Path(__file__).read_bytes())}}
(F/'change-authority.json').write_text(json.dumps(authority,indent=2)+'\n',encoding='utf-8');print(json.dumps({'authority':pin((F/'change-authority.json').read_bytes()),'producer':pin(producerBytes),'controls':pin(controlBytes),'files':len(files)},indent=2))
