    {
      "id": "grafana.candidate.0815087eb7cdf4ebfb2c",
      "syntaxRole": "list-item",
      "sourceText": "- Removed the **Value groups/tags** feature from variables. Any tags will be removed.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Breaking changes",
        "Variables"
      ],
      "source": {
