import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),sha=value=>createHash('sha256').update(value).digest('hex'),baseline=await fs.readFile(path.join(here,'candidate-baseline.mjs'),'utf8'),inline=await fs.readFile(path.join(here,'candidate-inline-control.mjs'),'utf8');assert.equal(sha(baseline),'9269cf8c32be9bf2c075b67019e82e41272d9495f0321fefc17b2c5695a91371');assert.equal(sha(inline),'6ac1153c008d960de23766af1e4325cc0e77a5ab10c49be604d4d6e203f6e26f');
const start=inline.indexOf('const selectionUnavailable ='),stop=inline.indexOf('function special(',start);assert.ok(start>0&&stop>start);const block=inline.slice(start,stop),helper=block.replace('function singlePercentile(', 'export function singlePercentile('),candidate="import { singlePercentile } from './selector-control.mjs';\n"+inline.slice(0,start)+inline.slice(stop);
