    {
      "id": "grafana.candidate.ca150508fa2661adf74b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Paginated endpoints optionally accept both `pageSize` and `pageCursor` query parameters. If you omit the `pageCursor` parameter, or provide an empty `pageCursor` value, you receive the first page.",
      "headingPath": [
        "Grafana Cloud API",
