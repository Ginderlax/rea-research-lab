    },
    {
      "id": "grafana.candidate.2028d782c96b1a6352b0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When creating a report, you can now choose to export Table panels as .csv files attached to your report email. This makes it easier for recipients to view and work with that data.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Enterprise features",
        "Reporting updates"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-0.md",
        "gitBlobSha": "08364874bf79c35cb3f0d907a16891c4cfb0eb1c",
        "sha256": "6f07cb510f8b0da003b838c600c8c34236d365c4cc7688913f7fe726f50a0fd7",
        "lineStart": 315,
        "lineEnd": 315,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v8-0.md#L315-L315"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.3cb9cc223f9195504ccf",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can also link back to the dashboard directly from the email, for users who want to see the data live in Grafana. This release also includes some improvements to the Reports list view.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Enterprise features",
        "Reporting updates"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-0.md",
