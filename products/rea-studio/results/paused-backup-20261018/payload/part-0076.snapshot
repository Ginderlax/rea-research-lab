    {
      "id": "grafana.candidate.17b0ae124a98c87dfdf6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can set a lower bound for these variables with the **Min time interval** option in the [data source configuration](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/postgres/configure/#min-time-interval) or the panel's query options.",
      "headingPath": [
