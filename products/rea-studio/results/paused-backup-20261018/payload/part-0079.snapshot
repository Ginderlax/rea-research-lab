    {
      "id": "grafana.candidate.4483d26544fec61dc95b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The status bar shows metadata about the flame graph and currently applied modifications, like what part of the graph is in focus or what function is shown in sandwich view. Click the **X** in the status bar pill to remove that modification.",
      "headingPath": [
        "Flame graph",
