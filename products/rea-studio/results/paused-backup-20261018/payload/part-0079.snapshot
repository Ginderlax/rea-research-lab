    {
      "id": "grafana.candidate.2c497fb31228eb75f1d0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To try out the new alert history page, enable the `alertingCentralAlertHistory` feature toggle and [configure Loki annotations](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/alerting/set-up/configure-alert-state-history/).",
      "headingPath": [
        "What’s new in Grafana v11.2",
        "Alerting",
        "Centralized alert history page"
      ],
