    {
      "id": "grafana.candidate.a8da1afe636c3858ed64",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Both types of templates can use the same keywords, functions, and comparison operators of the Go template language, such as `range`, `if`, `and`, `index`, `eq`, and more.",
