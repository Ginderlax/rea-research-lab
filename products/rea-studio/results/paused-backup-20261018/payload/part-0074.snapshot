    },
    {
      "id": "grafana.candidate.3c33425c332c963889ed",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The force logout action can apply to one device that is logged in to Grafana, or all devices logged in to Grafana.",
