    {
      "id": "grafana.candidate.f6882493572313de8d90",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Pyroscope returns profiles aggregated over a selected time range. The absolute values in the flame graph grow as the time range gets bigger while keeping the relative values meaningful. You can zoom in on the time range to get a higher granularity profile up to the point of a single scrape interval.",
      "headingPath": [
        "Query profile data",
