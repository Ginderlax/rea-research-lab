// Owned source-only fixture assembly. No application, original, host or browser execution.
import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash}from'node:crypto';
import {verifyNotesInlineFollowups,assertNotesInlinePublicPath,assertNotesInlineInertBytes,createNotesInlineHistoricalResolver}from'./verify-notes-inline-followups.mjs';
const root=import.meta.dirname,workspace=path.resolve(root,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),output=path.join(root,'runs',process.argv[2]??'final'),mirror=path.join(output,'private-proof-layout'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});
const publicPrefix='products/rea-studio/apps/notes/results/inline-confirmation-followup/';
const records=[],controls=[],sourceHashes=[];
async function save(p,value){const dest=path.join(output,p);await fs.mkdir(path.dirname(dest),{recursive:true});await fs.writeFile(dest,typeof value==='string'||Buffer.isBuffer(value)?value:JSON.stringify(value,null,2)+'\n',{flag:'wx'});}
async function copy(base,src,dest,expected){assert.ok(!dest.includes('..')&&!dest.includes('\\')&&!dest.startsWith('/')&&!dest.includes(':'));const b=await fs.readFile(path.join(base,src));if(expected)assert.deepEqual(id(b),{bytes:expected.bytes,sha256:expected.sha256});const at=path.join(mirror,dest);await fs.mkdir(path.dirname(at),{recursive:true});await fs.writeFile(at,b,{flag:'wx'});records.push({sourceRoot:path.relative(workspace,base).replaceAll('\\','/'),sourcePath:src,path:dest,...id(b)});return b;}
for(const p of ['check.mjs','verify-notes-inline-followups.mjs']){const b=await fs.readFile(path.join(root,p));await save('source-before/'+p+'.snapshot',b);sourceHashes.push({path:p,...id(b)});}await save('source-before.json',{files:sourceHashes,applicationExecutions:0});
const plan=path.join(workspace,'work/notes-inline-publication-plan-next'),addon=path.join(workspace,'work/notes-inline-publication-plan-browser-next');
const map=JSON.parse(await fs.readFile(path.join(addon,'public-preservation-map.json')));assert.equal(id(await fs.readFile(path.join(addon,'public-preservation-map.json'))).sha256,'ec5839d46fd9ff16e0e752bfac86b850689731b0bfa6a9fb87ffd4d4aaa8c2d7');
for(const r of map.payload)await copy(path.join(workspace,r.sourceRoot),r.sourcePath,r.publicPath,r);
const mb=await fs.readFile(path.join(addon,'freeze-manifest.json')),m=JSON.parse(mb);for(const [p,r]of Object.entries(m.inventory))await copy(addon,p,publicPrefix+'browser-publication-plan/frozen/'+p+'.snapshot',r);await copy(addon,'freeze-manifest.json',publicPrefix+'browser-publication-plan/frozen/freeze-manifest.json.snapshot',id(mb));
const license=JSON.parse(await fs.readFile(path.join(plan,'license-source-provenance.json')));for(const r of license.sourcePrerequisites31)await copy(repo,r.path,r.path,r);const alias=JSON.parse(await fs.readFile(path.join(plan,'current-notice-alias-reference.json')));for(const r of [alias,alias.repair])await copy(repo,r.path,r.path,r);
const req=JSON.parse(await fs.readFile(path.join(plan,'requirements-identity-reference.json')));for(const r of req.registries)await copy(repo,r.path,r.path);
const observations=[];const prospective=verifyNotesInlineFollowups(mirror,{requireCurrent:false,onFile:r=>observations.push(r)});assert.equal(prospective.currentBytesChecked,false);assert.equal(prospective.installedBehaviorAcceptance,false);assert.equal(prospective.publicAliases,836);assert.equal(prospective.localCarriersRead,0);assert.equal(prospective.imageScopeOverride.records,12);controls.push({name:'source-only-public836-layout-without-local-work-or-native-fixtures',pass:true,files:prospective.authenticatedFiles});
const before=JSON.parse(await fs.readFile(path.join(plan,'installation-before34.json'))),proposals=JSON.parse(await fs.readFile(path.join(plan,'live-copy-list.json'))).proposals;
for(const r of before){const p=proposals.find(p=>p.destination===r.path);if(p)await copy(plan,p.proposalPath,r.path,p.after);else await copy(plan,r.snapshot,r.path,r);}for(const p of proposals.filter(p=>!p.before))await copy(plan,p.proposalPath,p.destination,p.after);
const installed=verifyNotesInlineFollowups(mirror);assert.equal(installed.currentBytesChecked,true);assert.equal(installed.installedBehaviorAcceptance,false);controls.push({name:'exact-current36-identities-without-app-execution',pass:true});
const resolver=createNotesInlineHistoricalResolver(mirror);for(const r of before){const result=resolver(r.path,r);assert.equal(result.historicalIdentity.sha256,r.sha256);const p=proposals.find(p=>p.destination===r.path);assert.equal(result.currentExpected.sha256,p?.after.sha256??r.sha256);}for(const p of proposals.filter(p=>!p.before))assert.equal(resolver(p.destination,p.after),undefined);controls.push({name:'historical34-resolver-and-two-new-paths-outside-historical-matrix',pass:true});
function rejects(name,fn){assert.throws(fn);controls.push({name,pass:true,expectedReject:true});}
rejects('historical-resolver-rejects-altered-expected-identity',()=>resolver(before[0].path,{...before[0],sha256:'0'.repeat(64)}));
for(const p of ['../escape','C:/absolute','a\\b','a//b','/a','a/.local/b','a/work/b'])rejects('unsafe-public-path:'+p,()=>assertNotesInlinePublicPath(p));
for(const [name,hex]of [['MZ','4d5a'],['ZIP','504b0304'],['ELF','7f454c46'],['KDBX','03d9a29a67fb4bb5'],['GZIP','1f8b']])rejects('leading-carrier:'+name,()=>assertNotesInlineInertBytes(Buffer.from(hex,'hex')));
const tamperPath=path.join(mirror,map.payload[0].publicPath),original=await fs.readFile(tamperPath);await fs.writeFile(tamperPath,Buffer.from('wrong bytes'));rejects('public-source-byte-tamper',()=>verifyNotesInlineFollowups(mirror,{requireCurrent:false}));await fs.writeFile(tamperPath,original);
const client=path.join(mirror,before[0].path),current=await fs.readFile(client),old=await fs.readFile(path.join(plan,before[0].snapshot));await fs.writeFile(client,old);rejects('historical-client-is-not-current-corrected-client',()=>verifyNotesInlineFollowups(mirror));verifyNotesInlineFollowups(mirror,{requireCurrent:false});await fs.writeFile(client,current);
const excludedPath=path.join(mirror,publicPrefix+'unlisted-local-fixture.snapshot');await fs.writeFile(excludedPath,'not a declared public proof');rejects('extra-unlisted-public-alias',()=>verifyNotesInlineFollowups(mirror,{requireCurrent:false}));await fs.unlink(excludedPath);
const final=verifyNotesInlineFollowups(mirror);assert.equal(final.publicAliases,836);for(const r of sourceHashes)assert.deepEqual(id(await fs.readFile(path.join(root,r.path))),{bytes:r.bytes,sha256:r.sha256});
await save('public-layout-map.json',{files:records.length,records,localExcludedCarriersCopied:0,nativeFixturesRequired:false,syntheticOwnCopyOnly:true});await save('source-after.json',{sourceStable:true,files:sourceHashes});await save('controls.json',{controls,applicationTests:0,originalExecutions:0,sourceOnly:true});await save('authenticated-reads.json',observations);
const {resolveHistorical,...summary}=final;await save('validation.json',{schema:'rea-notes-inline-public-verifier-source-only-validation/v1',at:new Date().toISOString(),sourceStable:true,controls:controls.length,allPass:true,publicLayoutCopies:records.length,strictPublicAliases:836,noExcludedCarriersCopied:true,noPrivateSourceDependencies:true,prospectiveAcceptanceFalse:true,currentByteVerificationSeparateFromBehavior:true,module:id(await fs.readFile(path.join(root,'verify-notes-inline-followups.mjs'))),summary,newApplicationExecutions:0,newOriginalExecutions:0,newBrowserExecutions:0,hosts:0,benchmarks:0,productionWrites:0,registryWrites:0,publishedCopies:0,fullParity:false,superiority:false});console.log(JSON.stringify({sourceOnly:true,controls:controls.length,allPass:true,publicAliases:836,copies:records.length,excludedCopied:0,module:id(await fs.readFile(path.join(root,'verify-notes-inline-followups.mjs')))}));
