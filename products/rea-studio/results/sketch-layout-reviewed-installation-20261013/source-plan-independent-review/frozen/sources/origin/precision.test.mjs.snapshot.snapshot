import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import path from 'node:path';import {layoutSelection} from './products/rea-studio/apps/sketch/layout.mjs';import {validateScene} from './products/rea-studio/apps/sketch/core.mjs';import {loadLayoutOracle} from './layout-oracle.mjs';
const shape=(id,x,y,w,h,extra={})=>({id,type:'rect',x,y,w,h,...extra}),scene=shapes=>validateScene({name:'Fractional layout regression',shapes}),ops=['x','y'].flatMap(axis=>[...['start','center','end'].map(position=>({kind:'align',axis,position})),{kind:'distribute',axis}]);
function originalElements(input){return input.shapes.map(s=>({id:s.id,type:s.type==='rect'?'rectangle':s.type,x:s.x,y:s.y,width:s.w,height:s.h,angle:0,groupIds:s.groupIds??[],...(s.type==='freedraw'?{points:s.points}:['line','arrow'].includes(s.type)?{points:[[0,0],[s.w,s.h]]}:{})}));}
function compareAll(fixtures,label){const original=loadLayoutOracle(),packets=[];for(const input of fixtures)for(const operation of ops){const before=structuredClone(input),elements=originalElements(input),map=new Map(elements.map(e=>[e.id,e])),out=operation.kind==='align'?original.oracle.alignElements(elements,map,operation,{getNonDeletedElementsMap:()=>map}):original.oracle.distributeElements(elements,map,{axis:operation.axis,space:'between'}),byId=new Map(out.map(s=>[s.id,s])),expected=input.shapes.map(s=>({id:s.id,x:byId.get(s.id).x,y:byId.get(s.id).y})),actual=layoutSelection(input,input.shapes.map(s=>s.id),operation).scene.shapes.map(s=>({id:s.id,x:s.x,y:s.y}));let exact=true;try{assert.deepEqual(actual,expected);}catch{exact=false;}const signed=rows=>rows.map(s=>({id:s.id,x:Object.is(s.x,-0),y:Object.is(s.y,-0)}));packets.push({input,operation,expected,actual,expectedSignedZero:signed(expected),actualSignedZero:signed(actual),exact});assert.deepEqual(input,before);}
 const target=path.join(process.env.REA_LAYOUT_PRECISION_OBSERVATIONS,label+'.json');fs.mkdirSync(path.dirname(target),{recursive:true});fs.writeFileSync(target,JSON.stringify({label,packets,pairs:packets.length,exactPairs:packets.filter(p=>p.exact).length,originalHelperCalls:original.calls,source:original.source,vmEvaluations:1,numericToleranceApplied:false,originalRendererOrAppExecuted:false,fullParity:false},null,2)+'\n',{flag:'wx'});console.log('PRECISION '+label+' PAIRS '+packets.length+' EXACT '+packets.filter(p=>p.exact).length);assert.equal(packets.filter(p=>!p.exact).length,0,'Literal fractional helper coordinates differ');}
test('replay all24 fractional review diagnostics without rounding or tolerance',()=>{compareAll([scene([shape('a',1/3,-0,1/7,1/11),shape('b',2/3,-0,-1/9,-1/13,{type:'line'}),shape('c',4/3,.3,.2,.1)]),scene([shape('a',-0,-0,0,0),shape('b',.1,.2,.01,.03),shape('c',.6,.7,.13,.17)]),scene([shape('a',.1,.1,0,0,{type:'freedraw',points:[[.2,.3],[-.04,-.05]]}),shape('b',.7,.9,.11,.12),shape('c',1.3,1.2,-.6,-.7,{type:'line'})])],'review24-replay');});
test('new seeded fractional rectangles, signed lines, freehand and nested groups match literal helpers',()=>{let seed=0x671ea912;const random=()=>{seed=(Math.imul(seed,1664525)+1013904223)>>>0;return seed/2**32;},fraction=()=>Math.floor(random()*300-150)/(3+Math.floor(random()*29)),fixtures=[];for(let i=0;i<250;i++){const shapes=[];for(let j=0,n=3+Math.floor(random()*5);j<n;j++){const s=shape('s'+j,fraction(),fraction(),Math.abs(fraction()),Math.abs(fraction()));if(j<2&&i%3===0)s.groupIds=['inner','outer'];if(j===2){s.type=i%2?'arrow':'line';s.w=-s.w;s.h=i%4?-s.h:s.h;}if(j===3){s.type='freedraw';s.points=[[fraction(),fraction()],[fraction(),fraction()],[fraction(),fraction()]];}shapes.push(s);}fixtures.push(scene(shapes));}compareAll(fixtures,'seed671ea912-250');});
