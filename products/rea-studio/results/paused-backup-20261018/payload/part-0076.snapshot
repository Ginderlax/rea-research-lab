    {
      "id": "grafana.candidate.0ec0f7de9f8b25174b72",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If your annotations aren't appearing or behaving as expected, refer to [Troubleshoot Microsoft SQL Server data source issues](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/mssql/troubleshooting/) for common solutions.",
