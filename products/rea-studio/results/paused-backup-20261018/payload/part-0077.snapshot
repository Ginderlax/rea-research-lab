    {
      "id": "grafana.candidate.c4214475450afcd501e4",
      "syntaxRole": "table-row",
      "sourceText": "| `allow_sign_up`              | No       | Yes                | Controls Grafana user creation through the Google login. Only existing Grafana users can log in with Google if set to `false`.                                                                                                                                                                                                                                                                                                                                                                  | `true`                                             |",
      "headingPath": [
