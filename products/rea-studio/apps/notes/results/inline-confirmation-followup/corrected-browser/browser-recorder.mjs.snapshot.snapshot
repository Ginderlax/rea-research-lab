async(label,screenshot=false)=>{const ax=await correctedNotesTab.getAXState({emit:false});const visible=await correctedNotesTab.playwright.evaluate(()=>({title:document.querySelector('[aria-label="Note title"]')?.value,body:document.querySelector('[aria-label="Markdown note"]')?.value,tags:document.querySelector('[aria-label="Note tags"]')?.value,notebook:document.querySelector('[aria-label="Notebook"]')?.value,managed:document.querySelector('[aria-label="Manage notebook"]')?.value,status:document.querySelector('[role="status"]')?.textContent,focus:{tag:document.activeElement?.tagName,label:document.activeElement?.getAttribute('aria-label'),text:document.activeElement?.textContent},dialogs:Array.from(document.querySelectorAll('[role="alertdialog"]')).map(d=>({text:d.textContent,busy:d.getAttribute('aria-busy'),buttons:Array.from(d.querySelectorAll('button')).map(b=>({text:b.textContent,disabled:b.disabled}))})),controls:Array.from(document.querySelectorAll('#app-root button,#app-root input,#app-root select,#app-root textarea')).map(n=>({tag:n.tagName,text:n.textContent?.slice(0,100),label:n.getAttribute('aria-label'),disabled:n.disabled})),rootInert:Array.from(document.querySelector('#app-root')?.children??[]).map(n=>({tag:n.tagName,inert:n.inert})),url:location.href}));cancelBrowserSteps.push({label,at:new Date().toISOString(),ax,visible});await cancelBrowserFs.writeFile(cancelBrowserFolder+'/browser-steps.json',JSON.stringify(cancelBrowserSteps,null,2)+'\n');if(screenshot)await cancelBrowserFs.writeFile(cancelBrowserFolder+'/'+label+'.png',await correctedNotesTab.getScreenshot({emit:false}));nodeRepl.write({label,...visible});}
