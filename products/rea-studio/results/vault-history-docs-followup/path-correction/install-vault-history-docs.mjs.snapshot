import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import fs from 'node:fs/promises';
import path from 'node:path';
const source=path.join(import.meta.dirname,'keepass-history-docs-next'),lab=path.resolve(import.meta.dirname,'../outputs/rea-research-lab'),app='products/rea-studio/apps/vault/',prefix='products/rea-studio/results/vault-history-docs-followup/',out=path.join(lab,prefix),sha=b=>createHash('sha256').update(b).digest('hex');
const manifestBytes=await fs.readFile(path.join(source,'docs-manifest.json'));assert.equal(sha(manifestBytes),'86fcdea39e7c44d09f81c959495bcf9b283b31d525d28f6010d483527d908b17');const manifest=JSON.parse(manifestBytes),entries=manifest.files??manifest.entries;assert.equal(entries.length,24);
const receiptBytes=await fs.readFile(path.join(source,'docs-validation.json'));assert.equal(sha(receiptBytes),'733e38ba4164795a6044f942b7b9476979f790db66810d8704d95a862568b541');const deltaBytes=await fs.readFile(path.join(source,'README-delta.json'));assert.equal(sha(deltaBytes),'a2bd1c548eb0238857f4eed100d5c8cb5de8c89c753ac4e8ee087457ffe748d7');const delta=JSON.parse(deltaBytes),old=await fs.readFile(path.join(lab,app+'README.md'));assert.equal(sha(old),delta.baseline.sha256);assert.equal(old.length,delta.baseline.bytes);
let text=old.toString('utf8');for(const change of delta.changes){assert.equal(text.split(change.from).length,2);text=text.replace(change.from,change.to);}const proposal=await fs.readFile(path.join(source,'README.proposal.md')),history=await fs.readFile(path.join(source,'HISTORY.md'));assert.equal(sha(proposal),'30dbc0f5d04f131e385f049d0efd0462939289d9203a9ed41d11c3de6c1f2ff3');assert.equal(sha(history),'50cad13e2357efa57f47d317f72b2ca3d22ea10d4f7395a7f115d3222339d2f1');assert.equal(text,proposal.toString('utf8'));
await fs.mkdir(out,{recursive:true});const snapshots=[];for(const e of [...entries,{path:'docs-manifest.json',bytes:manifestBytes.length,sha256:sha(manifestBytes)}]){assert.ok(e.path&&!e.path.startsWith('/')&&!e.path.includes('\\')&&!e.path.split('/').includes('..'));const b=await fs.readFile(path.join(source,e.path));assert.equal(b.length,e.bytes);assert.equal(sha(b),e.sha256);const p=e.path+'.snapshot',target=path.join(out,p);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b,{flag:'wx'});snapshots.push({sourcePath:e.path,path:p,bytes:b.length,sha256:sha(b)});}
await fs.writeFile(path.join(lab,app+'README.md'),proposal);await fs.writeFile(path.join(lab,app+'HISTORY.md'),history,{flag:'wx'});
const record={schema:'rea-vault-history-docs-preservation/v1',snapshots,originalManifestSHA256:sha(manifestBytes),originalReceiptSHA256:sha(receiptBytes),deltaSHA256:sha(deltaBytes),previousReadme:{path:prefix+'README.baseline.md.snapshot',bytes:old.length,sha256:sha(old)},copies:[{path:app+'README.md',bytes:proposal.length,sha256:sha(proposal)},{path:app+'HISTORY.md',bytes:history.length,sha256:sha(history)}],documentationOnly:true,runtimeChanges:0,testChanges:0,originalEvidenceRebound:false,carrierProseCorrection:{oldFrozenBundleProseCount:4,currentTotalLocalOnlyCarriers:12,namedZipCopies:4,acquisitionCopies:8},newBehavioralExecutions:0,fullProductParity:false,universalSuperiority:false};const bytes=JSON.stringify(record,null,2)+'\n';await fs.writeFile(path.join(out,'preservation-manifest.json'),bytes,{flag:'wx'});console.log(JSON.stringify({snapshots:snapshots.length,manifestSHA256:sha(Buffer.from(bytes)),previousReadmeSHA256:sha(old),currentReadmeSHA256:sha(proposal),historySHA256:sha(history),runtimeChanges:0}));
