    {
      "id": "grafana.candidate.0f989aa3504392b31d08",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use this method when your Grafana instance authenticates users with Google OAuth and you want each query to run as the signed-in user instead of as a shared service account. This enables per-user access control: a viewer who lacks Cloud Monitoring permissions on a project sees no data from that project, even when the dashboard's data source is shared.",
      "headingPath": [
        "Google authentication",
        "Use Forward OAuth Identity"
      ],
      "source": {
        "path": "docs/sources/datasources/google-cloud-monitoring/google-authentication/index.md",
