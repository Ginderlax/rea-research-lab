import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import {spawn} from 'node:child_process';
const root=path.dirname(fileURLToPath(import.meta.url)),hash=bytes=>createHash('sha256').update(bytes).digest('hex'),run=path.join(root,'runs',new Date().toISOString().replaceAll(':','-'));await fs.mkdir(run,{recursive:true});const baseline=JSON.parse(await fs.readFile(path.join(root,'baseline.json')));
async function fingerprint(){const rows=[];async function walk(directory,prefix){for(const entry of await fs.readdir(directory,{withFileTypes:true})){const relative=prefix+'/'+entry.name;if(entry.isDirectory())await walk(path.join(directory,entry.name),relative);else{const bytes=await fs.readFile(path.join(directory,entry.name));rows.push({path:relative,bytes:bytes.length,sha256:hash(bytes)});}}}for(const name of ['products/rea-studio/apps/notes','original'])await walk(path.join(root,name),name);for(const relative of ['products/rea-studio/server.mjs','products/rea-studio/catalog.mjs','products/rea-studio/lib/storage.mjs','run.mjs','source-provenance.json','license-and-special-id-provenance.json']){const bytes=await fs.readFile(path.join(root,relative));rows.push({path:relative,bytes:bytes.length,sha256:hash(bytes)});}return rows.sort((a,b)=>a.path.localeCompare(b.path));}
const before=await fingerprint();for(const row of before){const target=path.join(run,'sources',row.path+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,await fs.readFile(path.join(root,row.path)));}
const files=['app.test.mjs','app.integration.test.mjs','jex.test.mjs','notebooks.test.mjs','notebooks.integration.test.mjs'].map(name=>'products/rea-studio/apps/notes/'+name),out=await fs.open(path.join(run,'stdout.txt'),'wx'),err=await fs.open(path.join(run,'stderr.txt'),'wx'),child=spawn(process.execPath,['--test','--test-concurrency=1',...files],{cwd:root,windowsHide:true,stdio:['ignore','pipe','pipe']});let stdout='',stderr='';child.stdout.on('data',bytes=>{stdout+=bytes;out.write(bytes);});child.stderr.on('data',bytes=>{stderr+=bytes;err.write(bytes);});const exitCode=await new Promise((resolve,reject)=>{child.once('error',reject);child.once('close',resolve);});await out.close();await err.close();const after=await fingerprint(),counts=Object.fromEntries(['tests','pass','fail','skipped','cancelled'].map(name=>[name,Number(new RegExp(`(?:ℹ|#) ${name} (\\d+)`).exec(stdout)?.[1]??-1)])),sourceStable=JSON.stringify(before)===JSON.stringify(after),production=await Promise.all(baseline.sources.filter(row=>!row.path.includes('/requirements/')).map(async row=>({path:row.path,unchanged:hash(await fs.readFile(row.source))===row.sha256})));const result={schema:'rea-notes-notebooks-run/v1',exitCode,counts,sourceStable,productionBaselineUnchanged:production.every(row=>row.unchanged),production,sourceFingerprints:before,testFiles:files,stderr};await fs.writeFile(path.join(run,'validation.json'),JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify({run:path.relative(root,run).replaceAll('\\','/'),exitCode,counts,sourceStable,productionBaselineUnchanged:result.productionBaselineUnchanged}));if(exitCode||!sourceStable||!result.productionBaselineUnchanged)process.exitCode=1;
