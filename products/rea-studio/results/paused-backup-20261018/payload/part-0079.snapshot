    {
      "id": "grafana.candidate.e2e10684044d9e9f3ce4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana determines the log level from the first matching `level`, `detected_level`, `lvl`, or `loglevel` label and updates color accordingly. If the log doesn't have one of these labels, Grafana tries to find out if its content matches any of the supported expressions. If Grafana can't determine a log level, it visualizes the line with **unknown** log level. Refer to [supported log levels and mappings of log level abbreviation and expressions](ref:log-levels).",
      "headingPath": [
        "Logs",
        "Log level"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/logs/index.md",
        "gitBlobSha": "85e2c4734572a18668063acf060c2fbdefc96d36",
