    {
      "id": "grafana.candidate.fda5533e1ca6212411a7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "An announcement banner shows at the top of every page in Grafana. You can use the announcement banner to communicate information to your users, such as maintenance windows, new features, or other important updates.",
      "headingPath": [
        "Create an announcement banner"
      ],
      "source": {
        "path": "docs/sources/administration/announcement-banner/_index.md",
