    {
      "id": "grafana.candidate.d3bd77ddfb65b638fddd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can remove and reset default filters and group by dimensions, and see your recent ones:",
      "headingPath": [
        "Filter and group by controls",
