    {
      "id": "grafana.candidate.43d048c037f85e289c4e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The table has been updated with improved hover behavior for cells that have longer content than what fits the current column width. As you can see in the animated gif below the cell will automatically expand to show you full content of the cell.",
      "headingPath": [
        "What's new in Grafana v7.3",
        "Table improvements and new image cell mode"
      ],
      "source": {
