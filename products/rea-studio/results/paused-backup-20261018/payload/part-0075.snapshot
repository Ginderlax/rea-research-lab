    {
      "id": "grafana.candidate.72ac88abf58e296f0879",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Schedule regular reviews of existing alerts. Remove alerts that don’t lead to action, and tune alerts or thresholds that fire too often without providing useful signal. Reduce false positives to combat alert fatigue.",
      "headingPath": [
        "Alerting best practices",
        "Alerts should be continuously improved"
      ],
      "source": {
