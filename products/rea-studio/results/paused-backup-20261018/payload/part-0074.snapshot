        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/migration-guide/cloud-migration-assistant.md#L232-L232"
      },
      "applicability": {
        "status": "excluded-by-paid-or-hosted-section-heading",
        "products": [],
        "restriction": "Grafana Cloud Migration Assistant > Migrate multiple organizations"
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
