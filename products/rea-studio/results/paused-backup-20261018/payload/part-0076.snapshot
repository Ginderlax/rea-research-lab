    {
      "id": "grafana.candidate.916ce9f86d64ffe10da2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use `alias` functions, such as `aliasByNode()` or `aliasSub()`, to change metric names on Grafana tables or graphs.",
      "headingPath": [
        "Graphite query editor",
        "Functions",
        "Modify the metric name in my tables or charts"
      ],
      "source": {
        "path": "docs/sources/datasources/graphite/query-editor/index.md",
