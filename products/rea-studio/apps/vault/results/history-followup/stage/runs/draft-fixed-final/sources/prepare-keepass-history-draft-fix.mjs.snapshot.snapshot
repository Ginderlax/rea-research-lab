import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
const work=import.meta.dirname,old=path.join(work,'keepass-history-selection-fix-next'),next=path.join(work,'keepass-history-draft-fix-next'),sha=b=>createHash('sha256').update(b).digest('hex');
const manifestBytes=await fs.readFile(path.join(old,'selection-preservation-manifest.json'));if(sha(manifestBytes)!=='d6c09b4a6e4d45b3729ad8c8692b2352686e8e7e88e5ad791905fbb26b8b52de')throw new Error('Frozen selection manifest changed.');const manifest=JSON.parse(manifestBytes);if(manifest.count!==546)throw new Error('Frozen selection count changed.');const receipt=await fs.readFile(path.join(old,'selection-validation.final.json'));if(sha(receipt)!=='03ab5a44043d808181cee2f69ed6fc50fa839eb0c2e1c3ca18c1e90a08bbe055')throw new Error('Frozen selection receipt changed.');
await fs.mkdir(next,{recursive:false});for(const e of manifest.files){if(!e.path||e.path.includes('\\')||e.path.startsWith('/')||e.path.split('/').includes('..'))throw new Error('Unsafe frozen path');const b=await fs.readFile(path.join(old,e.path));if(b.length!==e.bytes||sha(b)!==e.sha256)throw new Error('Frozen selection artifact changed '+e.path);for(const target of [path.join(next,e.path),path.join(next,'preserved-selection-stage',e.path+'.snapshot')]){await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b);}}
for(const name of ['selection-preservation-manifest.json','selection-freeze.json'])await fs.copyFile(path.join(old,name),path.join(next,'preserved-selection-stage',name+'.snapshot'));
const reviews=[];for(const [name,count,manifestName,manifestHash,receiptHash]of [['keepass-history-independent-review',101,'review-manifest.json','659a694609e032da24f51b625d9f6528b0d9a5c3e558c9bc0d9fe7a0cf6f35d1','4a65c02b9bd8e2a74754fededf10d0eec1f86b20fb72f87178467abc9ef07f34'],['keepass-history-selection-independent-review',36,'review-manifest.json','df87b099e0234bb611b76dd6079e09482f526696037a0124bd4374318738dd6d','059feac3ce9285fd36f51b0dab6a88209c6090d64bcc95d6a38f99ee99b4d9c1']]){const source=path.join(work,name),m=await fs.readFile(path.join(source,manifestName));if(sha(m)!==manifestHash)throw new Error('Frozen independent manifest changed.');const parsed=JSON.parse(m),files=parsed.files??parsed.entries;if(files.length!==count)throw new Error('Independent count changed.');const r=await fs.readFile(path.join(source,'review-validation.json'));if(sha(r)!==receiptHash)throw new Error('Independent receipt changed.');const prefix='preserved-independent/'+name;for(const e of files){const b=await fs.readFile(path.join(source,e.path));if(b.length!==e.bytes||sha(b)!==e.sha256)throw new Error('Independent artifact changed '+e.path);const target=path.join(next,prefix,e.path+'.snapshot');await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,b);}for(const file of [manifestName,'review-freeze.json'])if(await fs.access(path.join(source,file)).then(()=>true,()=>false))await fs.copyFile(path.join(source,file),path.join(next,prefix,file+'.snapshot'));reviews.push({name,prefix,count,manifestSha256:manifestHash,receiptSha256:receiptHash,files});}
await fs.writeFile(path.join(next,'draft-correction-baseline.json'),JSON.stringify({schema:'rea-vault-draft-correction-baseline/v1',selectionStageManifestSha256:sha(manifestBytes),selectionStageReceiptSha256:sha(receipt),selectionStageFiles:manifest.files,preservationPrefix:'preserved-selection-stage/',suffix:'.snapshot',independentReviews:reviews,productionEdited:false},null,2));await fs.copyFile(import.meta.filename,path.join(next,'prepare-keepass-history-draft-fix.mjs'));console.log(JSON.stringify({next,preservedSelectionArtifacts:546,preservedIndependentArtifacts:137}));
