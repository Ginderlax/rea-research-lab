    },
    {
      "id": "grafana.candidate.7ee5d8a0147c792774b6",
      "syntaxRole": "table-row",
      "sourceText": "| **Span end time shift**   | Shifts the end time for the logs query, based on the span's end time. You can use time units. Default: `0`.                                                                                                                                                                                     |",
      "headingPath": [
        "Configure the Zipkin data source",
        "Trace to logs",
        "Trace to logs settings"
      ],
      "source": {
