    {
      "id": "grafana.candidate.e08572c525a378358226",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This section shows you how to run Grafana using Docker Compose. The examples in this section use Compose version 3. For more information about compatibility, refer to [Compose and Docker compatibility matrix](https://docs.docker.com/compose/compose-file/compose-file-v3/).",
      "headingPath": [
        "Run Grafana Docker image",
        "Run Grafana via Docker Compose",
        "Run the latest stable version of Grafana"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/installation/docker/index.md",
