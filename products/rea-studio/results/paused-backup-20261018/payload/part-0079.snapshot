    {
      "id": "grafana.candidate.ba0576e9a0a7b495216f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The pie chart visualization is ideal when you have data that adds up to a total and you want to show the proportion of each value compared to other slices, as well as to the whole of the pie.",
      "headingPath": [
        "Pie chart"
      ],
