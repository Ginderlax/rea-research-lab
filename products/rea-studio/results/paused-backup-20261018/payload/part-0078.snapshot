    },
    {
      "id": "grafana.candidate.573976a87982e35b1c0a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Querying spansets with a large number of spans can negatively impact performance. You can use the **Span Limit** field in **Options** section of the TraceQL query editor. This field sets the maximum number of spans to return for each span set. By default, the maximum value that you can set for the **Span Limit** value (or the spss query) is 100. In Tempo configuration, this value is controlled by the `max_spans_per_span_set` parameter and can be modified by your Tempo administrator. Entering a value higher than the default results in an error.",
      "headingPath": [
        "Before you begin",
        "View query results"
      ],
      "source": {
        "path": "docs/sources/shared/datasources/tempo-editor-traceql.md",
        "gitBlobSha": "003a449fd9604839ca39a071ca081b2985cca7ad",
        "sha256": "9c7845760d6acd3125be422446a3a81278de8126cebeba1e25349ed54ac6152a",
        "lineStart": 133,
        "lineEnd": 138,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/shared/datasources/tempo-editor-traceql.md#L133-L138"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
