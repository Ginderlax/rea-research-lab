    {
      "id": "grafana.candidate.646514554d1f0f70062b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In addition to data source integration, events can be sent to dashboards by posting metrics to the new live endpoint: `/api/live/push` endpoint.",
      "headingPath": [
        "What's new in Grafana v8.0",
        "Grafana OSS features",
        "Real-time streaming"
      ],
      "source": {
