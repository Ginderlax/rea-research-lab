export const shape=(id,x,y,w=20,h=10,extra={})=>({id,type:'rect',x,y,w,h,stroke:'#263238',fill:'none',strokeWidth:2,groupIds:[],...extra});
export const scene=(shapes)=>({version:1,name:'Owned alignment review',shapes,view:{zoom:1,x:0,y:0}});
export const signedGeometry=()=>scene([shape('signed-line',80,50,-70,-30,{type:'line'}),shape('freehand',-15,30,1,1,{type:'freedraw',points:[[0,0],[50,-10],[-25,30]]}),shape('diamond',150,-30,40,20,{type:'diamond'})]);
export const nested=()=>scene([shape('inner-a',10,20,10,10,{groupIds:['inner','outer']}),shape('inner-b',35,25,10,10,{groupIds:['inner','outer']}),shape('outer-c',75,10,10,20,{groupIds:['other-inner','outer']}),shape('isolated',180,90,20,30)]);
export const collision=()=>scene([shape('first',10,10,10,10,{groupIds:['collision']}),shape('second',40,10,10,10,{groupIds:['collision']}),shape('collision',100,40,10,10),shape('far',210,70,15,10)]);
export const overlapOrders=()=>[scene([shape('wide',0,0,300,10),shape('near',30,20,5,10),shape('middle',120,40,20,10),shape('right',250,60,10,10)]),scene([shape('left',0,0,180,10),shape('right',80,0,160,10),shape('mid',70,0,100,10)]),scene([shape('same-a',0,0,100,10),shape('same-b',20,0,60,10),shape('same-c',45,0,10,10)])];
export const boundary=()=>scene([shape('small',2,10,10,10),shape('offset-freehand',1000000,10,0,10,{type:'freedraw',points:[[-1000000,0],[-999990,10]]}),shape('max',999990,30,10,10)]);
export const nativeDocument=(elements)=>({type:'excalidraw',version:2,source:'owned-independent-fixture',elements,appState:{viewBackgroundColor:'#ffffff',unknownOwnedAppState:{keep:'unchanged'}},files:{ownedOpaque:{id:'ownedOpaque',dataURL:'data:application/octet-stream;base64,AAEC',created:1,unknown:'retained'}},unknownOwnedDocument:{keep:[1,2,3]}});
export const nativeRect=(id,x,y,width=20,height=10,extra={})=>({id,type:'rectangle',x,y,width,height,angle:0,strokeColor:'#263238',backgroundColor:'transparent',strokeWidth:2,groupIds:[],version:7,versionNonce:321,updated:123456,seed:91,isDeleted:false,boundElements:null,unknownOwnedElement:{retain:'yes'},...extra});
export function originalElements(scene){return scene.shapes.map(s=>({id:s.id,type:s.type==='rect'?'rectangle':s.type,x:s.x,y:s.y,width:s.w,height:s.h,angle:0,version:1,versionNonce:0,updated:0,groupIds:[...(s.groupIds??[])],...(s.type==='freedraw'?{points:structuredClone(s.points)}:['line','arrow'].includes(s.type)?{points:[[0,0],[s.w,s.h]]}:{})}));}
