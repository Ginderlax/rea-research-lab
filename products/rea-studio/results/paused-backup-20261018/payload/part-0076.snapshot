    {
      "id": "grafana.candidate.8f2ead0815ceb6f196d0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Error message:** `rpc error: code = Unavailable desc = credentials require transport level security`",
      "headingPath": [
        "Troubleshoot Tempo data source issues",
        "Streaming issues",
        "gRPC transport security error"
