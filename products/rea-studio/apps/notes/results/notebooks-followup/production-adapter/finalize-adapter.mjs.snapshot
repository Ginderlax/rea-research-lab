import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';
const root=import.meta.dirname,sha=b=>createHash('sha256').update(b).digest('hex'),read=r=>fs.readFile(path.join(root,r)),run='runs/2026-10-12T22-39-19.649Z',receipt=JSON.parse(await read(run+'/validation.json'));
assert.deepEqual(receipt.totals,{tests:28,pass:28,fail:0,cancelled:0,skipped:0});assert.equal(receipt.sourceStable,true);assert.equal(receipt.actualAdapterHeldPersistenceCases,2);
const preserved=JSON.parse(await read('products/rea-studio/apps/notes/results/notebooks-followup/preservation-manifest.json'));assert.equal(preserved.files.length,283);for(const e of preserved.files){const b=await read('products/rea-studio/apps/notes/results/notebooks-followup/stage/'+e.preservedPath);assert.equal(sha(b),e.sha256);assert.equal(b.length,e.bytes);}
for(const e of receipt.sourceFingerprints){const b=await read(e.path);assert.equal(sha(b),e.sha256,'Tested source changed: '+e.path);}
const failure='failures/prepare-manifest-literal';await fs.mkdir(path.join(root,failure),{recursive:true});for(const name of ['prepare-notes-notebooks-adapter.mjs.snapshot','failure.json'])await fs.copyFile(path.resolve(root,'../notes-notebooks-production-adapter-bootstrap',name),path.join(root,failure,name));
const review={schema:'rea-notebook-production-adapter-review/v1',checkedAt:new Date().toISOString(),status:'FROZEN_ADAPTER_ONLY',productionEdited:false,run,focused:receipt.totals,additionalHeldPersistenceCases:2,exactOriginalArtifacts:283,originalArtifactHashesUnchanged:true,permittedAppAdaptations:receipt.adaptations.changed,implementationAndTestSemanticsUnchanged:true,originalAccounting:receipt.originalAccounting,originalRuntimeExecutedByApplication:false,normalTestsWriteAppResults:false,privateHostSource404Routes:receipt.routes,old22SerializerReceipt:receipt.old22SerializerReceipt,sourceStable:true,selectedSourceLicense:'AGPL-3.0-or-later; exact original notices/package/license bytes preserved; no broader distribution-license conclusion',finiteReviewScope:['Exact release and source/helper binding preservation','App-relative offline oracle path changes and unchanged test semantics','Root-authored held metadata success/failure and exclusive revision selection','Copied actual host persistence/restarts and source-only route boundaries','Normal-test output confinement and no vendor execution in app import graph'],unresolvedConfirmedIntegrationDefects:0,limitations:['This adapter review is not an exhaustive independent correctness/security audit.','Original helper methods use fixed clock and memory persistence stubs; original database/GUI/full product execution remain zero.','Historical source/stage/browser/22-check receipts retain their original identities; no rebasing.','Parent shared/catalog/requirement changes are outside this adapter.','New private browser checks were not performed by this adapter.'],fullProductParity:false,universalSuperiority:false,failuresPreserved:[failure]};await fs.writeFile(path.join(root,'adapter-validation.json'),JSON.stringify(review,null,2)+'\n',{flag:'wx'});
async function inventory(relative=''){const result=[];for(const entry of await fs.readdir(path.join(root,relative),{withFileTypes:true})){const next=relative?relative+'/'+entry.name:entry.name;if(['adapter-manifest.json','adapter-freeze.json'].includes(next))continue;if(entry.isDirectory())result.push(...await inventory(next));else if(entry.isFile()){const b=await read(next);result.push({path:next,bytes:b.length,sha256:sha(b)});}else throw new Error('Unexpected link '+next);}return result;}
const entries=(await inventory()).sort((a,b)=>a.path.localeCompare(b.path));const manifest={schema:'rea-notebook-production-adapter-strict-manifest/v1',frozenAt:new Date().toISOString(),count:entries.length,entries};await fs.writeFile(path.join(root,'adapter-manifest.json'),JSON.stringify(manifest,null,2)+'\n',{flag:'wx'});const freeze={schema:'rea-notebook-production-adapter-freeze/v1',frozenAt:new Date().toISOString(),files:entries.length,receipt:{path:'adapter-validation.json',sha256:sha(await read('adapter-validation.json'))},manifest:{path:'adapter-manifest.json',sha256:sha(await read('adapter-manifest.json'))},runtime:{client:receipt.sourceFingerprints.find(e=>e.path.endsWith('/apps/notes/client.mjs')),server:receipt.sourceFingerprints.find(e=>e.path.endsWith('/apps/notes/server.mjs')),notebooks:receipt.sourceFingerprints.find(e=>e.path.endsWith('/apps/notes/notebooks.mjs')),oracle:receipt.sourceFingerprints.find(e=>e.path.endsWith('/apps/notes/notebook-original-oracle.mjs'))},sourceStable:true,productionChanged:false};await fs.writeFile(path.join(root,'adapter-freeze.json'),JSON.stringify(freeze,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(freeze));
