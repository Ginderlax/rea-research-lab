        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.d880dddac120acbfeaff",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Prevents SAML response replay attacks and internal clock skews between the SP (Grafana) and the IdP. You can set a maximum amount of time between the SP issuing the AuthnRequest and the SP (Grafana) processing it.",
      "headingPath": [
        "Configure SAML authentication using the Grafana configuration file",
        "Maximum issue delay"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md",
        "gitBlobSha": "ebf440506007cea9a23b9cd51b45e422bec7a72a",
        "sha256": "aa7d4408f0aa916ba78bd0df3d21ea94d1044b7ec6151c8e80d2a8369735d016",
        "lineStart": 77,
        "lineEnd": 77,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md#L77-L77"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.3e18d11853189d9f07b3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "SP metadata is likely to expire at some point, perhaps due to a certificate rotation or change of location binding. Grafana allows you to specify for how long the metadata should be valid. Leveraging the `validUntil` field, you can tell consumers until when your metadata is going to be valid. The duration is computed by adding the duration to the current time.",
      "headingPath": [
        "Configure SAML authentication using the Grafana configuration file",
        "Metadata valid duration"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md",
        "gitBlobSha": "ebf440506007cea9a23b9cd51b45e422bec7a72a",
        "sha256": "aa7d4408f0aa916ba78bd0df3d21ea94d1044b7ec6151c8e80d2a8369735d016",
        "lineStart": 83,
        "lineEnd": 83,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md#L83-L83"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.f34839dbcfe4a2468ac2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, new Grafana users using SAML authentication will have an account created for them automatically. To decouple authentication and account creation and ensure only users with existing accounts can log in with SAML, set the `allow_sign_up` option to false.",
      "headingPath": [
        "Configure SAML authentication using the Grafana configuration file",
        "Allow new user sign up"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md",
        "gitBlobSha": "ebf440506007cea9a23b9cd51b45e422bec7a72a",
        "sha256": "aa7d4408f0aa916ba78bd0df3d21ea94d1044b7ec6151c8e80d2a8369735d016",
        "lineStart": 89,
        "lineEnd": 89,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md#L89-L89"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.1cc5d28cb7599c09e4fc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set `auto_login` option to true to attempt login automatically, skipping the login screen. This setting is ignored if multiple auth providers are configured to use auto login.",
      "headingPath": [
        "Configure SAML authentication using the Grafana configuration file",
        "Configure automatic login"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md",
        "gitBlobSha": "ebf440506007cea9a23b9cd51b45e422bec7a72a",
        "sha256": "aa7d4408f0aa916ba78bd0df3d21ea94d1044b7ec6151c8e80d2a8369735d016",
        "lineStart": 93,
        "lineEnd": 94,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md#L93-L94"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.10c78c81c41c204b7b7a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For more information about automatic login behavior and troubleshooting, see [Automatic login](/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-access/configure-authentication/#automatic-oauth-login).",
      "headingPath": [
        "Configure SAML authentication using the Grafana configuration file",
        "Configure automatic login"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md",
        "gitBlobSha": "ebf440506007cea9a23b9cd51b45e422bec7a72a",
        "sha256": "aa7d4408f0aa916ba78bd0df3d21ea94d1044b7ec6151c8e80d2a8369735d016",
        "lineStart": 96,
        "lineEnd": 96,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md#L96-L96"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c29eeb1f6373fdff77fe",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "With the [`allowed_organizations`](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-grafana/enterprise-configuration/#allowed_organizations) option you can specify a list of organizations where the user must be a member of at least one of them to be able to log in to Grafana.",
      "headingPath": [
        "Configure SAML authentication using the Grafana configuration file",
        "Configure allowed organizations"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md",
        "gitBlobSha": "ebf440506007cea9a23b9cd51b45e422bec7a72a",
        "sha256": "aa7d4408f0aa916ba78bd0df3d21ea94d1044b7ec6151c8e80d2a8369735d016",
        "lineStart": 104,
        "lineEnd": 104,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md#L104-L104"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.13e6dde3e9cd42a23521",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To get the list of user's organizations from SAML attributes, you must configure the `assertion_attribute_org` option. This option specifies which SAML attribute contains the list of organizations the user belongs to.",
      "headingPath": [
        "Configure SAML authentication using the Grafana configuration file",
        "Configure allowed organizations"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md",
        "gitBlobSha": "ebf440506007cea9a23b9cd51b45e422bec7a72a",
        "sha256": "aa7d4408f0aa916ba78bd0df3d21ea94d1044b7ec6151c8e80d2a8369735d016",
        "lineStart": 106,
        "lineEnd": 106,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md#L106-L106"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.5edcd0cda1abaff24f12",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To put values containing spaces in the list, use the following JSON syntax:",
      "headingPath": [
        "Configure SAML authentication using the Grafana configuration file",
        "Configure allowed organizations"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md",
        "gitBlobSha": "ebf440506007cea9a23b9cd51b45e422bec7a72a",
        "sha256": "aa7d4408f0aa916ba78bd0df3d21ea94d1044b7ec6151c8e80d2a8369735d016",
        "lineStart": 108,
        "lineEnd": 108,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md#L108-L108"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.12f1583138f76fc6a632",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If multiple bindings are supported for SAML Single Sign-On (SSO) by the Identity Provider (IdP), Grafana will use the `HTTP-Redirect` binding by default. If the IdP only supports the `HTTP-Post binding` then updating the `content_security_policy_template` (in case `content_security_policy = true`) and `content_security_policy_report_only_template` (in case `content_security_policy_report_only = true`) might be required to allow Grafana to initiate a POST request to the IdP. These settings are used to define the [Content Security Policy (CSP)](https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Content-Security-Policy) headers that are sent by Grafana.",
      "headingPath": [
        "Configure SAML authentication using the Grafana configuration file",
        "Configuring SAML with HTTP-Post binding"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md",
        "gitBlobSha": "ebf440506007cea9a23b9cd51b45e422bec7a72a",
        "sha256": "aa7d4408f0aa916ba78bd0df3d21ea94d1044b7ec6151c8e80d2a8369735d016",
        "lineStart": 116,
        "lineEnd": 116,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md#L116-L116"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.bcf09bd787bb58033d67",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To allow Grafana to initiate a POST request to the IdP, update the `content_security_policy_template` and `content_security_policy_report_only_template` settings in the Grafana configuration file and add the identity provider domain to the `form-action` directive. By default, the `form-action` directive is set to `self` which only allows POST requests to the same domain as Grafana. To allow POST requests to the identity provider domain, update the `form-action` directive to include the identity provider domain, for example: `form-action 'self' https://idp.example.com`.",
      "headingPath": [
        "Configure SAML authentication using the Grafana configuration file",
        "Configuring SAML with HTTP-Post binding"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md",
        "gitBlobSha": "ebf440506007cea9a23b9cd51b45e422bec7a72a",
        "sha256": "aa7d4408f0aa916ba78bd0df3d21ea94d1044b7ec6151c8e80d2a8369735d016",
        "lineStart": 118,
        "lineEnd": 118,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md#L118-L118"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.68e37f2046a9873a6dd3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For Grafana Cloud instances, please contact Grafana Support to update the `content_security_policy_template` and `content_security_policy_report_only_template` settings of your Grafana instance. Please provide the metadata URL/file of your IdP.",
      "headingPath": [
        "Configure SAML authentication using the Grafana configuration file",
        "Configuring SAML with HTTP-Post binding"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md",
        "gitBlobSha": "ebf440506007cea9a23b9cd51b45e422bec7a72a",
        "sha256": "aa7d4408f0aa916ba78bd0df3d21ea94d1044b7ec6151c8e80d2a8369735d016",
        "lineStart": 121,
        "lineEnd": 121,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md#L121-L121"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.59b58058a675c798fd78",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, Grafana allows only service provider (SP) initiated logins (when the user logs in with SAML via the login page in Grafana). If you want users to log in into Grafana directly from your identity provider (IdP), set the `allow_idp_initiated` configuration option to `true` and configure `relay_state` with the same value specified in the IdP configuration.",
      "headingPath": [
        "Configure SAML authentication using the Grafana configuration file",
        "IdP-initiated Single Sign-On (SSO)"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md",
        "gitBlobSha": "ebf440506007cea9a23b9cd51b45e422bec7a72a",
        "sha256": "aa7d4408f0aa916ba78bd0df3d21ea94d1044b7ec6151c8e80d2a8369735d016",
        "lineStart": 126,
        "lineEnd": 126,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md#L126-L126"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.2f431d601db8f1593520",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "IdP-initiated SSO has some security risks, so make sure you understand the risks before enabling this feature. When using IdP-initiated login, Grafana receives unsolicited SAML responses and can't verify that login flow was started by the user. This makes it hard to detect whether SAML message has been stolen or replaced. Because of this, IdP-initiated login is vulnerable to login cross-site request forgery (CSRF) and man in the middle (MITM) attacks. We do not recommend using IdP-initiated login and keeping it disabled whenever possible.",
      "headingPath": [
        "Configure SAML authentication using the Grafana configuration file",
        "IdP-initiated Single Sign-On (SSO)"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md",
        "gitBlobSha": "ebf440506007cea9a23b9cd51b45e422bec7a72a",
        "sha256": "aa7d4408f0aa916ba78bd0df3d21ea94d1044b7ec6151c8e80d2a8369735d016",
        "lineStart": 128,
        "lineEnd": 128,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md#L128-L128"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.55a7272dcd4ff105d350",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "`assertion_attribute_name` is a special assertion mapping that can either be a simple key, indicating a mapping to a single assertion attribute on the SAML response, or a complex template with variables using the `$__saml{<attribute>}` syntax. If this property is misconfigured, Grafana will log an error message on startup and disallow SAML sign-ins. Grafana will also log errors after a login attempt if a variable in the template is missing from the SAML response.",
      "headingPath": [
        "Configure SAML authentication using the Grafana configuration file",
        "Assertion mapping"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md",
        "gitBlobSha": "ebf440506007cea9a23b9cd51b45e422bec7a72a",
        "sha256": "aa7d4408f0aa916ba78bd0df3d21ea94d1044b7ec6151c8e80d2a8369735d016",
        "lineStart": 132,
        "lineEnd": 132,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md#L132-L132"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.c2aa87e5d18be31c335e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Refer to [Assertion mapping](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-access/configure-authentication/saml#assertion-mapping) for more information.",
      "headingPath": [
        "Configure SAML authentication using the Grafana configuration file",
        "Assertion mapping"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md",
        "gitBlobSha": "ebf440506007cea9a23b9cd51b45e422bec7a72a",
        "sha256": "aa7d4408f0aa916ba78bd0df3d21ea94d1044b7ec6151c8e80d2a8369735d016",
        "lineStart": 134,
        "lineEnd": 134,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-file/_index.md#L134-L134"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud",
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.e0768752218ad17050cd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Available in [Grafana Enterprise](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/introduction/grafana-enterprise/) version 10.0 and later, and to customers on select Grafana Cloud plans. For pricing information, visit [Pricing](https://grafana.com/pricing/) or contact our sales team.",
      "headingPath": [
        "Configure SAML authentication using the Grafana user interface"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/saml/saml-ui/_index.md",
        "gitBlobSha": "a9b448b96ab4cdfbe54f234798c5d3884f1b6c70",
        "sha256": "e0629082b9702e9220daa90875013b72915e1e39ff6cf86a723e78376f3d1c68",
        "lineStart": 20,
