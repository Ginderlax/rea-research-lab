import fs from 'node:fs/promises';
import path from 'node:path';
import assert from 'node:assert/strict';
import {here,lab,sha,authenticateOriginal} from './authenticate-original.mjs';
const old=path.resolve(here,'../metrics-standard-next'),plans=path.resolve(here,'../metrics-standard-next-next'),production=path.join(lab,'products/rea-studio/apps/metrics'),oldReceiptBytes=await fs.readFile(path.join(old,'optimization-stage.json')),planReceiptBytes=await fs.readFile(path.join(plans,'plan-validation.json'));assert.equal(sha(oldReceiptBytes),'b5b4897fa9978b830f4d1eefdc39a8ff16c9214dd4c8011de70caf108691021c');assert.equal(sha(planReceiptBytes),'208ab8495e904e03aa67051ff4c9d0b04c0c83f888424f96a290be1846a46207');
async function checkInventory(root,receipt){for(const [name,row]of Object.entries(receipt.inventory)){const bytes=await fs.readFile(path.join(root,name));assert.equal(bytes.length,row.bytes);assert.equal(sha(bytes),row.sha256,name);}return Object.keys(receipt.inventory).length;}
const previousInventoryCount=await checkInventory(old,JSON.parse(oldReceiptBytes)),planInventoryCount=await checkInventory(plans,JSON.parse(planReceiptBytes));assert.equal(sha(await fs.readFile(path.join(production,'native-calculations.mjs'))),'9269cf8c32be9bf2c075b67019e82e41272d9495f0321fefc17b2c5695a91371');assert.equal(sha(await fs.readFile(path.join(production,'results/native-calculations-verification.json'))),'064dc86d91eafd1a438359481f84a1bc35cd56c8c7d3243c833441da2d9919cd');
const authority=await authenticateOriginal(),full=JSON.parse(await fs.readFile(path.join(here,'results/candidate-invariant-dispatch.json'))),supplementary=JSON.parse(await fs.readFile(path.join(here,'results/final-supplementary-checks.json'))),harness=JSON.parse(await fs.readFile(path.join(here,'results/final-harness-checks.json')));assert.equal(full.status,'passed');assert.equal(full.failures.length,0);assert.equal(harness.status,'passed');assert.equal(harness.memoryMeasurementRun,false);assert.equal(harness.timingMeasurementRun,false);
for(const [name,hash]of Object.entries(harness.sourceHashesAfter))assert.equal(sha(await fs.readFile(path.join(here,name))),hash,name);for(const [name,hash]of Object.entries(supplementary.sourcesAfter))assert.equal(sha(await fs.readFile(path.join(here,name))),hash,name);assert.ok(supplementary.steps.every(step=>step.exitCode===0));
const candidates={},readiness={};for(const variant of ['standard','percentile']){const manifestBytes=await fs.readFile(path.join(here,'memory-preflight.'+variant+'.json')),manifest=JSON.parse(manifestBytes),candidateBytes=await fs.readFile(manifest.implementations.candidate.entry),memory=JSON.parse(await fs.readFile(path.join(here,'results/memory-harness-checks.'+variant+'.json'))),timing=JSON.parse(await fs.readFile(path.join(here,'results/timing-readiness.'+variant+'.json')));assert.equal(memory.status,'passed');assert.equal(timing.status,'passed');assert.equal(memory.manifestSHA256,sha(manifestBytes));assert.equal(timing.manifestSHA256,sha(manifestBytes));assert.equal(memory.samples.length,3);assert.ok(memory.samples.every(sample=>sample.result.comparisons===5&&sample.result.loadedReducerImplementations===1&&!sample.result.measurementRun));for(const [name,hash]of Object.entries(memory.sourceHashesAfter))assert.equal(sha(await fs.readFile(path.join(here,name))),hash);for(const [name,hash]of Object.entries(timing.sourceHashesAfter))assert.equal(sha(await fs.readFile(path.join(here,name))),hash);for(const fixture of Object.values(manifest.expectedFiles))assert.equal(sha(await fs.readFile(path.join(here,fixture.path))),fixture.sha256);const receiptBytes=await fs.readFile(path.join(here,manifest.fullSemanticReceipt));assert.equal(sha(receiptBytes),manifest.fullSemanticReceiptSHA256);assert.equal(JSON.parse(receiptBytes).implementationSha256,sha(candidateBytes));candidates[variant]={file:path.basename(manifest.implementations.candidate.entry),sha256:sha(candidateBytes),completeSemanticReceipt:{path:manifest.fullSemanticReceipt,sha256:sha(receiptBytes),historicalUnchangedCopy:variant==='percentile'}};readiness[variant]={manifestSHA256:sha(manifestBytes),freshWorkerComparisons:15,implementationsLoadedPerWorker:1,memoryMeasurementRun:false,timingMeasurementRun:false};}
const baseline=await fs.readFile(path.join(here,'candidate-baseline.mjs'),'utf8'),standard=await fs.readFile(path.join(here,candidates.standard.file),'utf8'),genericStart=baseline.indexOf('  for (let index = 0;',baseline.indexOf('export function doStandardCalcs(')),genericEnd=baseline.indexOf('  if (result.max ===',genericStart),generic=baseline.slice(genericStart,genericEnd),tail=baseline.slice(baseline.indexOf('\nfunction special('));assert.ok(standard.includes(generic));assert.equal(standard.slice(standard.indexOf('\nfunction special(')),tail);
await fs.mkdir(path.join(here,'preserved/executed-final'),{recursive:true});const executedNames=new Set([...Object.keys(harness.sourceHashesAfter),...Object.keys(supplementary.sourcesAfter),'verify-candidate.mjs','run-validation.mjs','prepare-memory.mjs','build-candidate.mjs']);for(const name of executedNames)await fs.copyFile(path.join(here,name),path.join(here,'preserved/executed-final',name));
const inventory={};async function walk(directory){for(const entry of await fs.readdir(directory,{withFileTypes:true})){const filename=path.join(directory,entry.name);if(entry.isDirectory())await walk(filename);else{const relative=path.relative(here,filename).split(path.sep).join('/');if(relative==='dispatch-validation.json')continue;const bytes=await fs.readFile(filename);inventory[relative]={bytes:bytes.length,sha256:sha(bytes)};}}}await walk(here);
const receipt={schemaVersion:1,checkedAt:new Date().toISOString(),scope:'Frozen ignored separate standard-dispatch candidate plus source-identical historical percentile candidate, correctness and unmeasured isolated/timing harness readiness. No production integration or publication.',candidates,authority,productionSourceSHA256:'9269cf8c32be9bf2c075b67019e82e41272d9495f0321fefc17b2c5695a91371',productionVerificationSHA256:'064dc86d91eafd1a438359481f84a1bc35cd56c8c7d3243c833441da2d9919cd',previousStage:{sha256:sha(oldReceiptBytes),inventoryFilesVerifiedUnchanged:previousInventoryCount},frozenPlans:{sha256:sha(planReceiptBytes),inventoryFilesVerifiedUnchanged:planInventoryCount},standardSourceGuards:{preservedGenericLoopSHA256:sha(generic),completeTailSHA256:sha(tail),completeTailSourceIdentical:true,resultObjectArithmeticRetained:true,perSamplePrimitiveGuard:false,scalarRewrite:false,derivedCount:false},standardComparisons:{fullReducers:full.comparisons,cacheIncluded:full.cacheComparisons,separateFullHelpers:full.standardHelperComparisons,independentLongReducers:9600,independentLongHelpers:1920,mutationCacheAliasScenarios:24,heldOutPercentileReducers:3888,heldOutDirectRegistry:864,adversarialBoundedSelections:18,partitionGuardApplicable:false},correctnessIntervals:{full:JSON.parse(await fs.readFile(path.join(here,'results/candidate-invariant-dispatch-validation.interval.json'))),supplementary:supplementary.steps.map(({script,startedAt,completedAt})=>({script,startedAt,completedAt})),harness:harness.steps.map(({name,startedAt,completedAt})=>({name,startedAt,completedAt})),rootConcurrentActivityAllowed:true,notPerformanceMeasurements:true},harnessTests:5,harnessReadiness:readiness,completeOriginalExpectedFixtures:5,originalFreshPreflightCallsForBothManifests:5,measurementModesExecutionTested:false,estimatedDurationOnly:{timingSecondsPerCandidate:[65,85],memorySecondsPerCandidate:[120,180],basedOn:'Earlier timings and frozen operation counts, not executed new-stage observations.'},historicalFailedAndRejectedTrialsPreserved:true,historicalReceiptsRebound:false,sourceSnapshots:'preserved/executed-final',inventory,timingMeasurementRun:false,memoryMeasurementRun:false,performanceEstablished:false,selectedForIntegration:null,productionChanged:false,allDocumentedFeaturesEnumerated:false,fullProductComplete:false,universalSuperiorityEstablished:false};const output=JSON.stringify(receipt,null,2)+'\n';try{await fs.access(path.join(here,'dispatch-validation.json'));throw Error('Freeze exists; retain it and write any later measurement review separately.');}catch(error){if(error.code!=='ENOENT')throw error;}await fs.writeFile(path.join(here,'dispatch-validation.json'),output);console.log(JSON.stringify({receipt:path.join(here,'dispatch-validation.json'),sha256:sha(output),inventoryFiles:Object.keys(inventory).length,candidates,readiness,previousInventoryCount,planInventoryCount}));
