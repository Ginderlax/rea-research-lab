"""Independent byte/portable-backup reader; never imports or executes products."""
from pathlib import Path
import gzip, hashlib, io, json, re, subprocess, zipfile

BASE=Path(__file__).resolve().parent.parent
WORK=BASE/'work'
LAB=BASE/'outputs/rea-research-lab'
STAGE=WORK/'cloud-corrected-full-pass-public-20261016-next'
RUN=WORK/'cloud-verification-backups/run-38911252546'
BACKUP=RUN/'artifact-12051991455'
EVIDENCE=BACKUP/'readable-evidence'
TESTED='b7bb3010fa7f08a45bef8758515f5fbef5566917'
HEAD='016ecd175c0700d1a94d5219af6719989a4a6e45'
PREFIX='products/rea-studio/results/cloud-corrected-full-pass-20261016'

def ident(b): return {'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def load(p): return json.loads(p.read_bytes())
def read(p):
    assert p.is_file() and not p.is_symlink(), str(p)
    return p.read_bytes()
def pin(b,r): assert ident(b)=={'bytes':r['bytes'],'sha256':r['sha256']},r
def safe(n):
    assert isinstance(n,str) and n and not re.search(r'[\\:\x00-\x1f\x7f]',n)
    assert not n.startswith('/') and all(x not in ('','.','..') for x in n.split('/'))
    return n
def gitblob(b): return hashlib.sha1(b'blob '+str(len(b)).encode()+b'\0'+b).hexdigest()

authority=load(STAGE/'copy-authority.json')
authority_pin=ident(read(STAGE/'copy-authority.json'))
assert authority_pin['bytes']==16839 and authority_pin['sha256'].startswith('34fb1210')
assert authority['files']==55 and authority['bytes']==757162
candidate=STAGE/'public-candidate'
rows=authority['rows']
assert len({r['path'] for r in rows})==55
assert sorted(p.relative_to(candidate).as_posix() for p in candidate.rglob('*') if p.is_file())==sorted(r['path'] for r in rows)
for r in rows:
    safe(r['path']); pin(read(candidate/r['path']),r)
assert sum(r['bytes'] for r in rows)==757162
target=candidate/PREFIX
manifest=load(target/'preservation-manifest.json')
pin(read(target/'preservation-manifest.json'),authority['manifest'])
records=manifest['records']
assert len(records)==83 and len({r['sourcePath'] for r in records})==83
decoded={}
objects=set()
collection=load(RUN/'collection-summary.json')
completed={r['kind']:Path(r['path']) for r in collection['metadata']}
source_originals={
    'readers/unpack-cloud-attempt.py':WORK/'unpack-cloud-attempt.py',
    'readers/collect-readonly-016-1245.mjs':WORK/'collect-readonly-016-1245.mjs',
    'readers/rea-cloud-github.mjs':WORK/'rea-cloud-github.mjs',
    'readers/preservation-collector.mjs':WORK/'preserve-cloud-corrected-full-pass-20261016.mjs',
    'source-context/corrected-bounds-source-transition.json':LAB/'products/rea-studio/results/archive-aes-properties-fixture-correction-20261016/source-transition.json',
    'local/local-backup-verification.json':BACKUP/'local-backup-verification.json',
    'local/collection-summary.json':RUN/'collection-summary.json',
    'wrapper/job-117010840674.txt':WORK/'cloud-verification-backups/job-117010840674/logs.txt',
}
for r in records:
    safe(r['path']); safe(r['sourcePath'])
    stored=read(target/r['path']); pin(stored,r['storage']); objects.add(r['path'])
    assert r['storage']['encoding'] in ('identity','gzip')
    raw=gzip.decompress(stored) if r['storage']['encoding']=='gzip' else stored
    pin(raw,r); decoded[r['sourcePath']]=raw
    role=r['sourcePath']
    if role.startswith('artifact/'):
        original=EVIDENCE/role[len('artifact/'):]
    elif role.startswith('control-plane-completed/'):
        original=completed[role.split('/')[-1][:-5]]
    elif role.startswith('control-plane-observations/'):
        original=RUN/role[len('control-plane-observations/'):]
    else:
        original=source_originals[role]
    assert raw==read(original),role
assert len(objects)==53
assert set(objects)=={p.relative_to(target).as_posix() for p in (target/'payload').iterdir()}

verification=load(BACKUP/'local-backup-verification.json')
