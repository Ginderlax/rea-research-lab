    {
      "id": "grafana.candidate.863673366b55f89b2374",
      "syntaxRole": "table-row",
      "sourceText": "| Send only from Monday to Friday | For reports that have an hourly or daily frequency, you can choose to send them only from Monday to Friday. |",
      "headingPath": [
