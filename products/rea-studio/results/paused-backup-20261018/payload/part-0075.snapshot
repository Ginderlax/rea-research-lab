    {
      "id": "grafana.candidate.5053e705673d3c7390d5",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In **OpenSearch SQL**, you can specify log groups in multiple ways. For details, refer to the [Query log groups and Amazon CloudWatch Logs data sources with OpenSearch SQL](#query-log-groups-with-opensearch-sql) section.",
      "headingPath": [
        "Amazon CloudWatch query editor",
        "Query CloudWatch Logs",
        "Specify Amazon CloudWatch Logs data sources to query"
      ],
      "source": {
