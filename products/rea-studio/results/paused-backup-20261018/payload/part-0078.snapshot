    {
      "id": "grafana.candidate.ee73ca12e4b5cbd1aad7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use the time picker to select a time range for your query. The default is **last hour**. You can select a different option from the dropdown or use an absolute time range. You can also change the timezone associated with the query, or use a fiscal year.",
      "headingPath": [
