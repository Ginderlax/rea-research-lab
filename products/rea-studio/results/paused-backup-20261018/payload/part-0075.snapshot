        "lineStart": 220,
        "lineEnd": 220,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/set-up/configure-high-availability/_index.md#L220-L220"
      },
      "applicability": {
