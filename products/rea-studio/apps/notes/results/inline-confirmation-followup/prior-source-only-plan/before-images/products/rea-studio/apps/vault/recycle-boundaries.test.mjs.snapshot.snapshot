import test from 'node:test';
import assert from 'node:assert/strict';
import {fixture,trashA,button,field,descendants,deferred,openEntry} from './recycle-boundary-fixture.mjs';
for(const operation of ['restore','purge'])test('Close bin during post-'+operation+' active-list refresh remains closed',async t=>{
 let armed=false;const entered=deferred(),release=deferred();t.after(()=>release.resolve());const f=await fixture(t,'close-after-'+operation,async(action,input,real)=>{const value=await real();if(action==='list'&&armed){armed=false;entered.resolve();await release.promise;}return value;});await trashA(f.root);armed=true;
 field(f.root,operation==='restore'?'Confirm restoring this entry to its previous group':'Confirm permanent deletion of this recycled entry').checked=true;
 const pending=button(f.root,operation==='restore'?'Restore recycled entry':'Permanently delete recycled entry').click();await entered.promise;await button(f.root,'Close recycle bin').click();f.observe.closedBeforeRelease=!descendants(f.root).some(n=>n.textContent==='Close recycle bin');assert.equal(f.observe.closedBeforeRelease,true);release.resolve();await pending;f.observe.closedAfterRelease=!descendants(f.root).some(n=>n.textContent==='Close recycle bin');f.observe.currentBinRequests=f.requests.filter(r=>r.action==='recycleList').length;assert.equal(f.observe.closedAfterRelease,true,'Late active-list completion must not reopen a bin the user closed.');
});
test('post-restore active-list refresh does not erase a newer bin preview generation',async t=>{
 let armed=false;const entered=deferred(),release=deferred();t.after(()=>release.resolve());const f=await fixture(t,'new-preview-during-active-refresh',async(action,input,real)=>{const value=await real();if(action==='list'&&armed){armed=false;entered.resolve();await release.promise;}return value;});await trashA(f.root);const b=(await f.call('read',{id:f.B})).entry;await f.call('recycleDelete',{id:f.B,revision:b.recycleRevision,confirm:true});await button(f.root,'Show recycle bin').click();const row=descendants(f.root).find(n=>n.tagName==='section'&&n.children.some(c=>c.tagName==='strong'&&c.textContent==='A'));field(row,'Confirm restoring this entry to its previous group').checked=true;armed=true;const pending=button(row,'Restore recycled entry').click();await entered.promise;await button(f.root,'Show recycle bin').click();await button(f.root,'Preview recycled entry').click();f.observe.secretBeforeRelease=field(f.root,'Recycled password').value;assert.equal(f.observe.secretBeforeRelease,'B-owned-secret');release.resolve();await pending;f.observe.secretAfterRelease=descendants(f.root).find(n=>n.tagName==='label'&&n.ownText==='Recycled password')?.children[0]?.value??null;assert.equal(f.observe.secretAfterRelease,'B-owned-secret','Late older operation must retain the newer bin preview.');
});
test('held recycled read rejected after cleanup cannot expose password or rearm detached controls',async t=>{const entered=deferred(),release=deferred();t.after(()=>release.resolve());const f=await fixture(t,'disposed-held-preview',async(action,input,real)=>{const value=await real();if(action==='recycleRead'){entered.resolve();await release.promise;}return value;});await trashA(f.root);const pending=button(f.root,'Preview recycled entry').click();await entered.promise;f.cleanup();release.resolve();await pending;assert.equal(descendants(f.root).some(n=>n.value==='A-owned-secret'),false);assert.equal(descendants(f.root).some(n=>n.value==='B-owned-secret'),false);});
test('held permanent-delete response keeps newer same-editor draft as a new entry without resurrecting deleted UUID',async t=>{const entered=deferred(),release=deferred();t.after(()=>release.resolve());const f=await fixture(t,'delete-keeps-newer-draft',async(action,input,real)=>{const value=await real();if(action==='delete'){entered.resolve();await release.promise;}return value;});await openEntry(f.root,'A');field(f.root,'Confirm entry deletion').checked=true;const pending=button(f.root,'Delete entry').click();await entered.promise;field(f.root,'Notes').value='owned newer draft';release.resolve();await pending;assert.equal(field(f.root,'Notes').value,'owned newer draft');await button(f.root,'Save encrypted entry').click();const latest=f.requests.filter(r=>r.action==='save').at(-1);assert.equal(latest.input.id,undefined);const rows=(await f.call('list')).entries;assert.equal(rows.some(r=>r.id===f.A),false);assert.equal((await f.call('recycleList')).entries.some(r=>r.id===f.A),true);assert.equal(rows.some(r=>r.title==='A'),true);});
