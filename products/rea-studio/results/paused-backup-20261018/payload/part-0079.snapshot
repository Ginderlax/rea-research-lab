    {
      "id": "grafana.candidate.51672dd7f47545f9bfa0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can now configure organization-wide report settings, such as report branding, in the Settings tab on the Reporting page. Settings are applied to all the reports of your current organization.",
      "headingPath": [
        "What's new in Grafana v7.2",
        "Grafana Enterprise features",
        "Organization-wide report settings"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-2.md",
