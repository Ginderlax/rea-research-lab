    {
      "id": "grafana.candidate.26b654d2766f0275a034",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set this to `true` to have date formats automatically derived from your browser location. Defaults to `false`. This is an experimental feature.",
