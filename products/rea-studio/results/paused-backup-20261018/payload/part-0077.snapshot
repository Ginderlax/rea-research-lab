    {
      "id": "grafana.candidate.3da00e2ca87efcf8fcb0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Options are `debug`, `info`, `warn`, `error`. `critical` is an alias for `error`. Default is `info`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[log]`",
        "`level`"
      ],
