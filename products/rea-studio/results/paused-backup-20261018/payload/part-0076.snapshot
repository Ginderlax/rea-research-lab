    {
      "id": "grafana.candidate.3fdfdf87d2a42b32b897",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Configure the **Span start time shift** and **Span end time shift** fields.",
      "headingPath": [
        "Configure trace to logs correlation",
        "Configure the Tempo data source"
      ],
      "source": {
        "path": "docs/sources/datasources/tempo/configure-tempo-data-source/configure-trace-to-logs.md",
        "gitBlobSha": "79b27dac6a84e3f457842a932b3a17ddb32c8024",
        "sha256": "4d7afd408b01ca0c2aa1c730ba09ae552d1706bd6b64758bccbbe6576f533f78",
        "lineStart": 57,
        "lineEnd": 57,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/tempo/configure-tempo-data-source/configure-trace-to-logs.md#L57-L57"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
