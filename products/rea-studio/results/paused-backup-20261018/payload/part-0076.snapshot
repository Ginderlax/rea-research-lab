        "lineStart": 127,
        "lineEnd": 127,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/mssql/query-editor/index.md#L127-L127"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.0cc35a8de0aeeafc0f1d",
      "syntaxRole": "table-row",
      "sourceText": "| `$__timeFilter(dateColumn)`                            | Adds a time range filter for the specified column. Example: `dateColumn BETWEEN '2017-04-21T05:01:17Z' AND '2017-04-21T05:06:17Z'`                                                                                                         |",
      "headingPath": [
        "Microsoft SQL Server query editor",
        "Macros"
      ],
      "source": {
        "path": "docs/sources/datasources/mssql/query-editor/index.md",
        "gitBlobSha": "bbb58af24aced7414605130f50521c1a8bc6ca8c",
        "sha256": "9f485e1051e44b457c0808272de96a8616d75e95d5fb6d630bec71d225529f99",
        "lineStart": 128,
        "lineEnd": 128,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/mssql/query-editor/index.md#L128-L128"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
