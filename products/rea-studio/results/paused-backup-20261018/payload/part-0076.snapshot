    {
      "id": "grafana.candidate.d98cbf30d98a5a746d8a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Error message:** `Tempo echo endpoint returned status 404` when selecting **Save & test**",
      "headingPath": [
        "Troubleshoot Tempo data source issues",
        "Authentication errors",
        "Save and test returns 404"
      ],
      "source": {
        "path": "docs/sources/datasources/tempo/troubleshooting/index.md",
