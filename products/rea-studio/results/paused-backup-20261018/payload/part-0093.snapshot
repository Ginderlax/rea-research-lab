const lab = 'C:/Users/evanh/Documents/Codex/2026-10-12/go/outputs/rea-research-lab';
const env = { ...process.env, GIT_TERMINAL_PROMPT: '0', GCM_INTERACTIVE: 'Never' };
function git(args) {
  const result = spawnSync('git', args, { cwd: lab, env, encoding: 'utf8', timeout: 300000, maxBuffer: 8 * 1024 * 1024 });
  assert.equal(result.status, 0, 'Git preparation failed.');
  return result.stdout.trim();
}
assert.equal(git(['remote', 'get-url', 'origin']), 'https://github.com/Ginderlax/rea-research-lab.git');
git(['add', '--all']);
const files = git(['ls-files', '-z']).split('\0').filter(Boolean).filter(path => !['PUBLICATION-MANIFEST.json', 'VALIDATION.json'].includes(path));
const forbidden = /(^|\/)(artifacts|node_modules|tooling|__pycache__|work|\.local)(\/|$)|\.(exe|dll|zip|tgz|bundle|tar|7z|pyc)$/i;
const syntheticZip = { path: 'products/rea-studio/apps/archive/fixtures/zstd/native-zip93.zip', sha256: 'e9282f76dbd3c080d0e12ef95489458523ebbc65c2951f4b8f3cb880a16c5d8b' };
const objectFormat = git(['rev-parse', '--show-object-format']);
const staged = new Map(git(['ls-files', '--stage', '-z']).split('\0').filter(Boolean).map(entry => {
  const split = entry.indexOf('\t');
  return [entry.slice(split + 1), entry.slice(0, split).split(' ')[1]];
}));
const records = files.sort().map(path => {
  const bytes = readFileSync(join(lab, path));
  assert.ok(!forbidden.test(path) || path === syntheticZip.path && createHash('sha256').update(bytes).digest('hex') === syntheticZip.sha256, `Excluded material: ${path}`);
  assert.equal(createHash(objectFormat).update(`blob ${bytes.length}\0`).update(bytes).digest('hex'), staged.get(path), `Staged bytes differ: ${path}`);
  return { path, bytes: bytes.length, sha256: createHash('sha256').update(bytes).digest('hex') };
});
const manifest = JSON.parse(readFileSync(join(lab, 'PUBLICATION-MANIFEST.json'), 'utf8'));
manifest.files = records;
writeFileSync(join(lab, 'PUBLICATION-MANIFEST.json'), JSON.stringify(manifest, null, 2));
git(['add', 'PUBLICATION-MANIFEST.json']);
const validation = spawnSync(process.execPath, ['scripts/verify-records.mjs', '--write'], { cwd: lab, env, encoding: 'utf8', timeout: 300000 });
assert.equal(validation.status, 0, validation.stderr);
git(['add', 'VALIDATION.json']);
assert.equal(git(['diff', '--name-only']), '', 'Unstaged changes after validation.');
console.log(validation.stdout.trim());
console.log(git(['diff', '--cached', '--stat']));
