    {
      "id": "grafana.candidate.240058f171d9a05623f1",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This feature is automatically available in Grafana 10 (and newer) and Grafana Cloud.",
      "headingPath": [
        "Before you begin"
      ],
      "source": {
        "path": "docs/sources/shared/datasources/tempo-editor-traceql.md",
