    {
      "id": "grafana.candidate.a0cfede46eabd32c1763",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you still need to configure Azure AD authentication on the core Prometheus data source (for example, on older Grafana versions), refer to [Configure Azure Active Directory (AD) authentication](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/azure-monitor/#configure-azure-active-directory-ad-authentication).",
      "headingPath": [
