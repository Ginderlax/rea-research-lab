    {
      "id": "grafana.candidate.4af2252acf3549da2f46",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Template variables let you create dynamic, reusable dashboards by replacing hard-coded values, such as service names or profile types, with selectable variables. Grafana displays these variables as drop-down menus at the top of the dashboard, letting viewers change the displayed data without editing queries.",
      "headingPath": [
        "Pyroscope template variables"
      ],
      "source": {
        "path": "docs/sources/datasources/pyroscope/template-variables/index.md",
        "gitBlobSha": "caf634b1a820210b00d4bdb88707f26b3153956d",
        "sha256": "a557cc0df0191ca0078ee4f1d6c14f8525e2489d04c09038c1f384ac8d67663e",
        "lineStart": 22,
        "lineEnd": 22,
