 stored=load('new-todo-finite-observations.json');assert stored==attempt['finite']and stored['summary']==summary and stored['execution']==execution and stored['sourceCommit']==HEAD and stored['fixedFiles']==bundle['fixedTests']and stored['oldNamedGroupsObserved']==23 and stored['newNamedGroupsObserved']==19 and stored['separateComparisonCounts']==bundle['separateComparisonCounts']
