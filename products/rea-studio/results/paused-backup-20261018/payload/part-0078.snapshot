    {
      "id": "grafana.candidate.d41fb53b0005a50cdb3a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana enforces the following limits on SQL expressions. Administrators can configure them in the `[expressions]` section of the Grafana configuration. For more information, refer to [Configure Grafana](ref:configure-expressions).",
      "headingPath": [
        "SQL expressions",
        "Known limitations",
        "Query limits"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/sql-expressions/index.md",
