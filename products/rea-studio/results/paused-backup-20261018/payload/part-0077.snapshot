    {
      "id": "grafana.candidate.27d94756a66785ba3937",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This topic explains how to install Grafana dependencies, install Grafana on Linux Debian or Ubuntu, and start the Grafana server on your Debian or Ubuntu system.",
      "headingPath": [
