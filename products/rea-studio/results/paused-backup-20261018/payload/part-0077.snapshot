    {
      "id": "grafana.candidate.0a2ac3c9cef369c669f7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Delete a role with the given UID, and it's permissions. If the role is assigned, the deletion operation will fail, unless the `force` query param is set to `true`, and in that case all assignments will also be deleted.",
      "headingPath": [
        "RBAC API",
        "Create and manage custom roles",
        "Delete a custom role"
      ],
