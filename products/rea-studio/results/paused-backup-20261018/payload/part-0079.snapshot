        "lineStart": 197,
        "lineEnd": 198,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v9-1.md#L197-L198"
      },
      "applicability": {
        "status": "excluded-by-paid-or-hosted-section-heading",
