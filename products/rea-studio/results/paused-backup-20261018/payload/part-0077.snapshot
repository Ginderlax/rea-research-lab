      "id": "grafana.candidate.0189073ebc0601743434",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For more information about screenshots, refer to [Images in notifications](../../alerting/configure-notifications/template-notifications/images-in-notifications/).",
