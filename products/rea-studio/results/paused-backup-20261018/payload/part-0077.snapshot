    },
    {
      "id": "grafana.candidate.0c22962fddbddba7a07f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If the query is updated to select and group by more than just one string column, for example, `GROUP BY BUCKET(StartTime, 1h), Location, Sensor`, then an additional dimension is added:",
      "headingPath": [
        "Time series dimensions",
        "Multiple dimensions in table format",
        "Multiple dimensions"
      ],
