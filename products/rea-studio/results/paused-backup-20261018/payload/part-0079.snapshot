      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Learn more about reporting in our [documentation](../../dashboards/create-reports/)",
      "headingPath": [
        "What's new in Grafana v9.4",
        "Reporting: Zoom in and out on your dashboard in a report PDF"
      ],
