    {
      "id": "grafana.candidate.de314e9a73c73f4546d3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The minimum sync interval that you can set for a repository. Indicates how often the controller will check for changes in the repository that were not propagated by a webhook. The minimum value is `10s`. Default is `10s`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[provisioning]`",
        "`min_sync_interval`"
      ],
