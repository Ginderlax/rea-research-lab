import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs/promises';import path from'node:path';import{start}from'../../server.mjs';
test('actual authenticated HTTP regex/whole-word navigation revisions and invalid errors survive restart',async t=>{
 const base=path.resolve(import.meta.dirname,'../../../../../.local/pattern-http');await fs.mkdir(base,{recursive:true});const dataDir=await fs.mkdtemp(path.join(base,'owned-'));let host=await start({port:0,dataDir});t.after(async()=>{await host.close();assert.equal(path.dirname(dataDir),base);await fs.rm(dataDir,{recursive:true,force:true});});const call=async(action,input,expected=200)=>{const response=await fetch(host.url+'/api/editor/'+action,{method:'POST',headers:{'content-type':'application/json','x-rea-token':host.token},body:JSON.stringify(input)}),data=await response.json();assert.equal(response.status,expected,JSON.stringify(data));return data;};
 const saved=(await call('save',{path:'a.txt',content:'🧪cat cats\r\ncat_ cat!\n',revision:null})).result;const before=(await call('search',{query:'cat',wholeWord:true})).result;assert.deepEqual(before.matches.map(m=>[m.line,m.column,m.endColumn,m.revision]),[[1,3,6,saved.revision],[2,6,9,saved.revision]]);const regex=(await call('search',{query:'^🧪(cat)',useRegex:true})).result;assert.equal(regex.matches[0].start,0);assert.equal(regex.matches[0].end,5);
 assert.match((await call('search',{query:'[',useRegex:true},400)).error,/Invalid/);await call('search',{query:'cat',wholeWord:null},400);const denied=await fetch(host.url+'/api/editor/search',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({query:'cat',useRegex:true})});assert.equal(denied.status,403);assert.equal((await fetch(host.url+'/apps/editor/client.mjs')).status,200);
 await host.close();host=await start({port:0,dataDir});const after=(await call('search',{query:'cat',wholeWord:true})).result;assert.deepEqual(after.matches,before.matches);assert.equal((await call('read',{path:'a.txt'})).result.revision,saved.revision);console.log(JSON.stringify({editorPatternHTTP:{hostInstances:2,restarts:1,authenticatedRequests:7,deniedRequests:1,staticRequests:1,originalCalls:0,browserCalls:0}}));
});
