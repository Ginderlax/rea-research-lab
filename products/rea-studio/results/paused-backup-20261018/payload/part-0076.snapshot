    {
      "id": "grafana.candidate.75f092c83ca2f1ca4d88",
      "syntaxRole": "table-row",
      "sourceText": "| `$__timeFrom()`                           | Replaces the value with the start of the currently active time selection (RFC3339Nano). Example: `'2020-07-13T20:19:09.254Z'`.                                                                                |",
      "headingPath": [
        "PostgreSQL query editor",
        "Macros",
        "Time-series macros"
      ],
      "source": {
