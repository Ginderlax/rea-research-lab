      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.65beada7e0090623b0bd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use the aforementioned tooling and warnings to plan migrations to React based [visualizations](https://grafana.com/docs/grafana/latest/panels-visualizations/) and [data sources](https://grafana.com/docs/grafana/latest/datasources/) included in Grafana or from the [Grafana plugins catalog](https://grafana.com/grafana/plugins/).",
      "headingPath": [
        "What’s new in Grafana v10.4",
        "Dashboards and visualizations",
        "AngularJS plugin warnings in dashboards"
      ],
