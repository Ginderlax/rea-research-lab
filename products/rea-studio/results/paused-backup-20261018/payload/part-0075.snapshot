      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.5cbc05894f7df1f1555e",
      "syntaxRole": "table-row",
      "sourceText": "| `$__timeFrom()`                 | Returns the start of the dashboard time range. Example: `datetime(2018-06-05T18:09:58.907Z)`.                                                                                                                                                                                                                                                                                                                                                                                  |",
      "headingPath": [
        "Azure Monitor query editor",
        "Query Azure Monitor Logs",
        "Use macros in Logs queries"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/query-editor/index.md",
        "gitBlobSha": "7e9d70541f1e4e273a619ba9e62b5958327ea3ee",
        "sha256": "06c986577af5c0ca3965b3815e378dc6ecf5d82a71accceca9354c5baeafb011",
        "lineStart": 296,
        "lineEnd": 296,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/azure-monitor/query-editor/index.md#L296-L296"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.5c96cf8a2c37e72f6ea6",
      "syntaxRole": "table-row",
      "sourceText": "| `$__timeTo()`                   | Returns the end of the dashboard time range. Example: `datetime(2018-06-05T20:09:58.907Z)`.                                                                                                                                                                                                                                                                                                                                                                                    |",
      "headingPath": [
        "Azure Monitor query editor",
        "Query Azure Monitor Logs",
        "Use macros in Logs queries"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/query-editor/index.md",
        "gitBlobSha": "7e9d70541f1e4e273a619ba9e62b5958327ea3ee",
        "sha256": "06c986577af5c0ca3965b3815e378dc6ecf5d82a71accceca9354c5baeafb011",
        "lineStart": 297,
        "lineEnd": 297,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/azure-monitor/query-editor/index.md#L297-L297"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
