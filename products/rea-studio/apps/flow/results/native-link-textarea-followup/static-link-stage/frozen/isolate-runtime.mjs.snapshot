import fs from 'node:fs/promises';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { createHash } from 'node:crypto';
const own = path.dirname(fileURLToPath(import.meta.url));
const app = path.join(own, 'candidate/products/rea-studio/apps/flow');
const sourcePath = path.join(app, 'link-original.test.mjs');
const source = await fs.readFile(sourcePath, 'utf8');
const preserved = path.join(own, 'preserved-original-v1');
await fs.mkdir(preserved, { recursive: true });
await fs.writeFile(path.join(preserved, 'link-original.test.mjs.snapshot'), source, { flag: 'wx' });
const marker = "test('real released Node-RED/test-helper flows";
const index = source.indexOf(marker);
if (index < 0) throw new Error('Expected exact third comparison group');
const prefixEnd = source.indexOf("test('exact released");
let prefix = source.slice(0, prefixEnd).replace("import test from'node:test';", '');
const hookStart = prefix.indexOf('test.after(');
const cloneStart = prefix.indexOf('\nconst clone', hookStart);
if (hookStart < 0 || cloneStart < 0) throw new Error('Expected observation hook');
prefix = prefix.slice(0, hookStart) + prefix.slice(cloneStart);
const bodyStart = source.indexOf('async t=>{', index) + 'async t=>{'.length;
let body = source.slice(bodyStart, source.lastIndexOf('});'));
// Remove only the callback's closing brace. The old third body is preserved above.
if (!body.endsWith('}')) throw new Error('Expected callback closing brace');
body = body.slice(0, -1);
body = body.replace("try{await new Promise((r,j)=>helper.startServer", "try{await journal({kind:'starting-original-host',directory});await new Promise((r,j)=>helper.startServer");
body = body.replace("started=true;for(const item of cases){await authenticate();", "started=true;await journal({kind:'original-host-started',directory});for(const item of cases){await authenticate();await journal({kind:'starting-original-flow',name:item.name});");
body = body.replace("assert.deepEqual(candidate,observed);await helper.unload();", "await journal();assert.deepEqual(candidate,observed);await helper.unload();await journal({kind:'original-flow-unloaded',name:item.name});");
const worker = prefix + `\nasync function journal(value){if(value)observations.push(value);await fs.writeFile(path.join(out,'link-runtime-journal.json'),JSON.stringify({authority,observations,originalGUI:0,originalEditor:0,benchmarks:0},null,2)+'\\n');}\nasync function executeReleasedRuntime(){` + body + `}\ntry{await journal({kind:'worker-start',node:process.version,nodeTestContext:process.env.NODE_TEST_CONTEXT??null});await executeReleasedRuntime();await authenticate();await journal();console.log(JSON.stringify({schema:'rea-flow-link-original-child/v1',cases:observations.filter(x=>x.kind==='released-full-runtime').length,allExact:true}));}catch(error){await journal({kind:'worker-error',message:error.message,stack:error.stack});throw error;}\n`;
await fs.writeFile(path.join(app, 'link-runtime-worker.mjs'), worker);
const replacement = `test('real released Node-RED/test-helper flows run in an isolated plain Node child',async()=>{const {spawn}=await import('node:child_process');const env={...process.env,FLOW_LINK_OBSERVATIONS:out};delete env.NODE_TEST_CONTEXT;const child=spawn(process.execPath,[path.join(here,'link-runtime-worker.mjs')],{windowsHide:true,env});const chunks={stdout:[],stderr:[]};let bytes=0,problem;const timer=setTimeout(()=>{problem='Original worker30s deadline';child.kill();},30000);for(const name of Object.keys(chunks))child[name].on('data',b=>{bytes+=b.length;if(bytes>2097152){problem='Original worker2MiB combined capture';child.kill();}else chunks[name].push(b);});const exit=await new Promise(resolve=>child.on('close',(code,signal)=>resolve({code,signal})));clearTimeout(timer);for(const name of Object.keys(chunks))await fs.writeFile(path.join(out,'link-runtime-child-'+name+'.txt'),Buffer.concat(chunks[name]));observations.push({kind:'released-runtime-child',exit,problem:problem??null,plainNode:true,nodeTestContextRemoved:true});assert.equal(problem,undefined);assert.equal(exit.code,0,Buffer.concat(chunks.stderr).toString());const marker=Buffer.concat(chunks.stdout).toString().trim().split(/\\r?\\n/).map(x=>{try{return JSON.parse(x);}catch{return null;}}).find(x=>x?.schema==='rea-flow-link-original-child/v1');assert.equal(marker?.cases,8);assert.equal(marker?.allExact,true);});\n`;
await fs.writeFile(sourcePath, source.slice(0, index) + replacement);
const sha = b => createHash('sha256').update(b).digest('hex');
await fs.writeFile(path.join(preserved, 'transformation.json'), JSON.stringify({schema:'rea-flow-original-child-isolation/v1',before:{bytes:Buffer.byteLength(source),sha256:sha(source)},after:{bytes:Buffer.byteLength(source.slice(0,index)+replacement),sha256:sha(source.slice(0,index)+replacement)},worker:{bytes:Buffer.byteLength(worker),sha256:sha(worker)},scope:'Owned comparator only; preserve old exact third body, execute unchanged released algorithms with fixture public-init settings in plain Node child; remove inherited NODE_TEST_CONTEXT. No vendor changes.',priorFailure:'Node24 native InternalCallbackScope assertion in test-helper host; not candidate mismatch',orphanTemporaryDirectory:'C:/Users/evanh/AppData/Local/Temp/rea-link-original-runtime-8Tb0Lr',orphanCleanup:'Automatic approval review rejected recursive cleanup as blocked by policy; retained pending.'},null,2)+'\n');
