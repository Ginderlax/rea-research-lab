function el(tag, text, attrs = {}) { const n = document.createElement(tag); if (text !== undefined) n.textContent = text; Object.assign(n, attrs); return n; }
function button(label, fn) { const b = el('button', label, { type: 'button', className: 'button' }); b.addEventListener('click', fn); return b; }
export async function render(root, api) {
  root.replaceChildren(); const initial = await api('list', {}); let flows = initial.flows; let flow = structuredClone(initial.example); let id = '';
  const status = el('p', 'Ready', { className: 'status', role: 'status' }); const picker = el('select'); const name = el('input', undefined, { value: flow.name, placeholder: 'Flow name' }); const editor = el('textarea', undefined, { rows: 22 }); editor.style.width = '100%'; const cards = el('div', undefined, { className: 'grid' }); const start = el('select'); const messages = el('textarea', undefined, { rows: 5, value: '[{"payload":28,"topic":"temperature"},{"payload":19,"topic":"temperature"}]' }); messages.style.width = '100%'; const output = el('pre'); output.style.whiteSpace = 'pre-wrap'; const inspect = el('pre'); inspect.style.whiteSpace = 'pre-wrap'; const runs = el('div');
  async function attempt(fn) { try { await fn(); status.style.color = ''; } catch (error) { status.textContent = error.message; status.style.color = '#b42318'; } }
  function refresh() { picker.replaceChildren(el('option', 'Choose saved flow', { value: '' })); for (const f of flows) picker.append(el('option', f.name, { value: f.id })); picker.value = id; name.value = flow.name; editor.value = JSON.stringify(flow, null, 2); cards.replaceChildren(); start.replaceChildren(); for (const node of flow.nodes) { if (node.type === 'inject') start.append(el('option', node.id, { value: node.id })); const card = el('article', undefined, { className: 'card' }); card.append(el('h3', `${node.id} · ${node.type}`), el('pre', JSON.stringify(node.config || {}, null, 2)), el('p', flow.edges.filter(e => e.from === node.id).map(e => `→ ${e.to} [${e.port || 0}]`).join('\n'))); cards.append(card); } }
  async function details() { if (!id) { inspect.textContent = 'Save a flow to retain counters and batch buffers.'; runs.replaceChildren(); return; } const response = await api('inspect', { id }); inspect.textContent = JSON.stringify(response.state, null, 2); runs.replaceChildren(); for (const run of [...response.runs].reverse()) runs.append(button(`${run.startedAt} · ${run.status}`, () => { output.textContent = JSON.stringify(run, null, 2); })); }
  picker.addEventListener('change', () => attempt(async () => { const selected = flows.find(f => f.id === picker.value); if (selected) { flow = structuredClone(selected); id = selected.id; refresh(); await details(); status.textContent = 'Loaded'; } }));
  name.addEventListener('input', () => { flow.name = name.value; editor.value = JSON.stringify(flow, null, 2); });
  const actions = el('div', undefined, { className: 'row' }); actions.append(picker, button('New', () => { flow = structuredClone(initial.example); flow.name = 'New event flow'; delete flow.id; id = ''; refresh(); details(); }), button('Save JSON', () => attempt(async () => { const parsed = JSON.parse(editor.value); parsed.name = name.value; const response = await api('save', { id: id || undefined, flow: parsed }); flow = response.flow; id = flow.id; flows = (await api('list', {})).flows; refresh(); await details(); status.textContent = 'Saved'; })), button('Reset state', () => attempt(async () => { if (!id) throw new Error('Save a flow first'); await api('reset', { id }); await details(); status.textContent = 'State reset'; })), button('Delete', () => attempt(async () => { if (!id) throw new Error('Choose a flow'); if (!confirm('Delete this saved flow?')) return; await api('delete', { id }); id = ''; flows = (await api('list', {})).flows; refresh(); await details(); status.textContent = 'Deleted; current definition remains in editor'; })));
  const builder = el('div', undefined, { className: 'card' }); builder.append(el('h3', 'Flow definition'), el('p', 'Edit JSON to connect nodes. Switch ports are zero-based rule indexes. Other nodes use port 0.'), editor, button('Validate and preview', () => attempt(async () => { const parsed = JSON.parse(editor.value); await api('validate', { flow: parsed }); flow = parsed; name.value = flow.name; refresh(); status.textContent = 'Valid flow; save before injecting'; })), button('Export JSON', () => { const blob = new Blob([editor.value], { type: 'application/json' }); const a = el('a', '', { href: URL.createObjectURL(blob), download: 'event-flow.json' }); a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 500); }));
  const runner = el('div', undefined, { className: 'card' }); runner.append(el('h3', 'Inject events'), start, messages, button('Inject messages', () => attempt(async () => { if (!id) throw new Error('Save a flow before injecting'); const { run } = await api('inject', { id, start: start.value, messages: JSON.parse(messages.value) }); output.textContent = JSON.stringify(run, null, 2); await details(); status.textContent = run.status === 'completed' ? 'Events delivered' : run.error; })), output); const state = el('div', undefined, { className: 'card' }); state.append(el('h3', 'Persistent node state'), inspect, el('h3', 'Run history'), runs);
  root.append(el('h2', 'Flow · stateful event routing'), el('p', 'Inject JSON messages, route through switch rules, transform fields, delay delivery, collect batches and observe debug outputs.', { className: 'muted' }), status, name, actions, cards, builder, runner, state); refresh(); await details(); const localFormat = el('details'); localFormat.append(el('summary', 'Local flow format'), ...Array.from(root.childNodes)); root.append(localFormat); return await renderNative(root, api);
}

async function renderNative(root, api) {
  const section = el('section', undefined, { className: 'card' });
  const status = el('p', 'Import a Node-RED flow JSON file or paste its native JSON.', { role: 'status' });
  const picker = el('select', undefined, { ariaLabel: 'Saved native flows' });
  const name = el('input', undefined, { value: 'Native flow', ariaLabel: 'Native flow name' });
  const text = el('textarea', undefined, { rows: 18, ariaLabel: 'Native Node-RED flow JSON' }); text.style.width = '100%';
  const file = el('input', undefined, { type: 'file', accept: '.json,application/json', ariaLabel: 'Import Node-RED flow file' });
  const summary = el('p'), warnings = el('ul'), diagram = el('div'), start = el('select', undefined, { ariaLabel: 'Native inject node' });
  const messages = el('textarea', undefined, { rows: 3, value: '[{}]', ariaLabel: 'Native input messages' }); messages.style.width = '100%';
  const output = el('pre'); output.style.whiteSpace = 'pre-wrap';
  const contextView = el('pre'); contextView.style.whiteSpace = 'pre-wrap';
  const history = el('div'); let flows = [], current = null, busy = false, generation = 0,linkConnections=[],disposed=false;
  const viewCurrent=()=>!disposed&&section.parentElement===root;
  const transport=api;api=async(action,input)=>{if(!viewCurrent())throw new Error('This native flow view is closed');const result=await transport(action,input);if(!viewCurrent())throw new Error('This native flow view is closed');return result;};
  const selectedLabel = el('p', 'Choose a node in the diagram to edit its native properties.');
  const nodeEditor = el('textarea', undefined, { rows: 10, ariaLabel: 'Selected native node properties' }); nodeEditor.style.width = '100%'; let selected = '';
  const from = el('select', undefined, { ariaLabel: 'Native wire source' }), to = el('select', undefined, { ariaLabel: 'Native wire destination' });
  const port = el('input', undefined, { type: 'number', min: '0', max: '99', value: '0', ariaLabel: 'Native wire output port' });
  const linkFrom=el('select',undefined,{ariaLabel:'Static Link Out source'}),linkTo=el('select',undefined,{ariaLabel:'Static Link In destination'});
  function clearSelection() { selected = ''; nodeEditor.value = ''; selectedLabel.textContent = 'Choose a node in the diagram to edit its native properties.'; }
  function label(title, control) { const wrapper = el('label', title); wrapper.append(control); return wrapper; }
  async function attempt(fn) {
    if(!viewCurrent())return;
    if (busy) { picker.value = current?.id || ''; return; }
    busy = true; section.setAttribute('aria-busy', 'true');
    const controls = Array.from(section.querySelectorAll('button,input,select,textarea')).map(control => [control, control.disabled]);
    for (const [control] of controls) control.disabled = true;
    try { await fn(); if(viewCurrent())status.style.color = ''; } catch (error) { if(viewCurrent()){status.textContent = error.message; status.style.color = '#b42318';} }
    finally { for (const [control, disabled] of controls) control.disabled = disabled; busy = false; section.setAttribute('aria-busy', 'false'); }
  }
  function nodes() { const parsed = JSON.parse(text.value); return Array.isArray(parsed) ? parsed : parsed.flows; }
  function updateNode(id, fn) {
    const document = JSON.parse(text.value), list = Array.isArray(document) ? document : document.flows;
    const index = list.findIndex(n => n.id === id); if (index < 0) throw new Error('Native node does not exist'); fn(list[index], list, index);
    text.value = JSON.stringify(document, null, 2); status.textContent = 'Draft changed; save and deploy to run the new revision.';
  }
  function renderDiagram() {
    diagram.replaceChildren(); from.replaceChildren(); to.replaceChildren();linkFrom.replaceChildren();linkTo.replaceChildren();
    let list; try { list = nodes(); if (!Array.isArray(list)) return; } catch { return; }
    const drawn = list.filter(n => !['tab', 'group', 'comment'].includes(n.type));
    const ns = 'http://www.w3.org/2000/svg', svg = document.createElementNS(ns, 'svg');
    svg.setAttribute('viewBox', '0 0 1100 700'); svg.setAttribute('role', 'img'); svg.setAttribute('aria-label', 'Native flow nodes and connections'); svg.style.width = '100%'; svg.style.maxHeight = '650px'; svg.style.background = '#f8fafc';
    const points = new Map(drawn.map((n, index) => [n.id, { x: Math.max(100, Math.min(1000, Number.isFinite(n.x) ? n.x : 130 + index % 4 * 260)), y: Math.max(40, Math.min(650, Number.isFinite(n.y) ? n.y : 60 + Math.floor(index / 4) * 100)) }]));
    svg.setAttribute('viewBox', `0 0 1100 ${Math.max(220, ...Array.from(points.values()).map(p => p.y + 60))}`);
    for (const n of drawn) for (let p = 0; p < (n.wires || []).length; p++) for (const target of n.wires[p]) {
      if(n.type==='link out'&&n.links)continue;
      const a = points.get(n.id), b = points.get(target); if (!b) continue;
      const line = document.createElementNS(ns, 'path'); line.setAttribute('d', `M ${a.x + 75} ${a.y + p * 8} C ${a.x + 150} ${a.y + p * 8}, ${b.x - 150} ${b.y}, ${b.x - 75} ${b.y}`); line.setAttribute('stroke', '#64748b'); line.setAttribute('fill', 'none'); line.setAttribute('stroke-width', '2'); svg.append(line);
    }
    for(const connection of linkConnections){const a=points.get(connection.source),b=points.get(connection.target);if(!a||!b)continue;const line=document.createElementNS(ns,'path');line.setAttribute('d',`M ${a.x+75} ${a.y} C ${a.x+150} ${a.y}, ${b.x-150} ${b.y}, ${b.x-75} ${b.y}`);line.setAttribute('stroke','#7c3aed');line.setAttribute('stroke-dasharray','6 4');line.setAttribute('fill','none');line.setAttribute('stroke-width','2');line.setAttribute('aria-label',`Static link ${connection.source} to ${connection.target}`);svg.append(line);}
    for (const n of drawn) {
      if(n.type==='link out')linkFrom.append(el('option',n.name||n.id,{value:n.id}));if(n.type==='link in')linkTo.append(el('option',n.name||n.id,{value:n.id}));
      from.append(el('option', `${n.name || n.id} · ${n.type}`, { value: n.id })); to.append(el('option', `${n.name || n.id} · ${n.type}`, { value: n.id }));
      const point = points.get(n.id), group = document.createElementNS(ns, 'g'); group.setAttribute('tabindex', '0'); group.setAttribute('role', 'button'); group.setAttribute('aria-label', `Edit native node ${n.id}`); group.style.cursor = 'grab';
      const rect = document.createElementNS(ns, 'rect'); rect.setAttribute('x', String(point.x - 75)); rect.setAttribute('y', String(point.y - 22)); rect.setAttribute('width', '150'); rect.setAttribute('height', '44'); rect.setAttribute('rx', '8'); rect.setAttribute('fill', ['inject', 'change', 'switch', 'json', 'debug','link in'].includes(n.type)||(n.type==='link out'&&(n.mode||'link')==='link') ? '#dbeafe' : '#fef3c7'); rect.setAttribute('stroke', '#475569');
      const title = document.createElementNS(ns, 'text'); title.setAttribute('x', String(point.x)); title.setAttribute('y', String(point.y - 3)); title.setAttribute('text-anchor', 'middle'); title.setAttribute('font-size', '12'); title.textContent = String(n.name || n.id).slice(0, 22);
      const type = document.createElementNS(ns, 'text'); type.setAttribute('x', String(point.x)); type.setAttribute('y', String(point.y + 13)); type.setAttribute('text-anchor', 'middle'); type.setAttribute('font-size', '10'); type.textContent = n.type;
      const select = () => {if(!viewCurrent()||busy)return; selected = n.id; selectedLabel.textContent = `${n.id} · ${n.type}`; nodeEditor.value = JSON.stringify(nodes().find(v => v.id === n.id), null, 2); };
      group.addEventListener('click', select); group.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(); } });
      let drag;
      group.addEventListener('pointerdown', e => { if (!viewCurrent() || busy || e.button !== 0) return; group.setPointerCapture(e.pointerId); drag = { x: e.clientX, y: e.clientY, originalX: point.x, originalY: point.y }; });
      group.addEventListener('pointermove', e => { if (!viewCurrent() || busy) { drag = null; group.removeAttribute('transform'); return; } if (!drag) return; const scale = 1100 / svg.getBoundingClientRect().width; group.setAttribute('transform', `translate(${(e.clientX - drag.x) * scale},${(e.clientY - drag.y) * scale})`); });
      group.addEventListener('pointerup', e => { if (!viewCurrent() || busy) { drag = null; group.removeAttribute('transform'); return; } if (!drag) return; const scale = 1100 / svg.getBoundingClientRect().width, dx = (e.clientX - drag.x) * scale, dy = (e.clientY - drag.y) * scale; if (Math.abs(dx) + Math.abs(dy) > 3) { const x = Math.round(Math.max(100, Math.min(1000, drag.originalX + dx))), y = Math.round(Math.max(40, Math.min(650, drag.originalY + dy))); updateNode(n.id, node => { node.x = x; node.y = y; }); drag = null; renderDiagram(); } else drag = null; });
      group.addEventListener('pointercancel', () => { drag = null; group.removeAttribute('transform'); }); group.append(rect, title, type); svg.append(group);
    }
    diagram.append(svg);
  }
  async function refreshList() { const result=await api('native-list',{});if(!viewCurrent())return;flows=result.flows; picker.replaceChildren(el('option', 'Choose saved native flow', { value: '' })); for (const flow of flows) picker.append(el('option', flow.name, { value: flow.id })); picker.value = current?.id || ''; }
  async function preview() {
    const epoch = generation, draft = text.value; const result = await api('native-validate', { text: draft });
    if (!viewCurrent()||epoch !== generation || draft !== text.value) return;
    linkConnections=result.linkConnections??[];
    summary.textContent = `${result.nodeCount} nodes · ${current?.deployedRevision ? current.deployedRevision === result.revision ? 'draft matches deployment' : 'draft differs from deployment' : 'not deployed'} · ${result.runReady ? 'first inject path can run' : result.runError}`;
    const previousStart = start.value; start.replaceChildren(); for (const s of current?.deployedRevision ? current.deployedStarts : result.starts) start.append(el('option', s.name, { value: s.id }));
    if (Array.from(start.options).some(option => option.value === previousStart)) start.value = previousStart;
    warnings.replaceChildren(); for (const issue of result.issues) warnings.append(el('li', `${issue.node}: ${issue.reason}`));
    if (result.schedules.length) warnings.append(el('li', `Scheduled injects are retained but run manually here: ${result.schedules.join(', ')}`));
    renderDiagram();
  }
  async function inspect() { if (!current) { history.replaceChildren(); contextView.textContent = '{}'; return; } const epoch = generation, expectedId = current.id; const result = await api('native-inspect', { id: expectedId }); if (!viewCurrent()||epoch !== generation || expectedId !== current?.id) return; current = result.flow; contextView.textContent = JSON.stringify(result.state, null, 2); history.replaceChildren(); for (const run of [...result.runs].reverse()) history.append(button(`${run.startedAt} · ${run.status}`, () => { output.textContent = JSON.stringify(run, null, 2); })); }
  picker.addEventListener('change', () => attempt(async () => { generation++; current = flows.find(f => f.id === picker.value) || null; clearSelection(); output.textContent = ''; if (!current) { await inspect(); return; } name.value = current.name; text.value = current.text; await preview(); await inspect(); status.textContent = 'Native flow loaded'; }));
  file.addEventListener('change', () => attempt(async () => { const epoch=++generation; const source = file.files[0]; if (!source) return; if (source.size > 4 * 1024 * 1024) throw new Error('Native JSON file exceeds 4 MiB'); const imported=await source.text();if(!viewCurrent()||epoch!==generation)return;text.value=imported; name.value = source.name.replace(/\.json$/i, '').slice(0, 120) || 'Native flow'; current = null; picker.value = ''; clearSelection(); output.textContent = ''; await inspect(); await preview(); status.textContent = 'Native UTF-8 JSON imported into draft; unchanged export preserves its JSON text.'; }));
  const documentEditor = el('details'); documentEditor.append(el('summary', 'Native JSON document'), label('Native JSON', text));
  const actions = el('div', undefined, { className: 'row' }); actions.append(button('Validate native flow', () => attempt(preview)), button('Save native draft', () => attempt(async () => { current = (await api('native-save', { id: current?.id, name: name.value, text: text.value })).flow; await refreshList(); await preview(); status.textContent = 'Native draft saved'; })), button('Deploy native flow', () => attempt(async () => { if (!current) throw new Error('Save the native draft first'); if (text.value !== current.text) throw new Error('Save the edited draft before deploying'); current = (await api('native-deploy', { id: current.id })).flow; await refreshList(); await preview(); status.textContent = 'Native flow deployed; manual injections run this saved revision.'; })), button('Export Node-RED JSON', () => attempt(async () => { await api('native-validate', { text: text.value }); const url = URL.createObjectURL(new Blob([text.value], { type: 'application/json' })), link = el('a', '', { href: url, download: `${name.value.replace(/[^\w-]/g, '-').slice(0, 100) || 'native-flow'}.json` }); link.click(); setTimeout(() => URL.revokeObjectURL(url), 1000); })));
  const nodeActions = el('div', undefined, { className: 'row' }); nodeActions.append(button('Apply native node changes', () => attempt(async () => { if (!selected) throw new Error('Choose a node'); const changed = JSON.parse(nodeEditor.value); if (changed.id !== selected) throw new Error('Keep the selected node id'); const document = JSON.parse(text.value), list = Array.isArray(document) ? document : document.flows, index = list.findIndex(n => n.id === selected); if (index < 0) { clearSelection(); throw new Error('Selected node is no longer in this draft; choose a node again'); } list[index] = changed; const next = JSON.stringify(document, null, 2); await api('native-validate', { text: next }); text.value = next; await preview(); status.textContent = 'Native node draft updated; save and deploy to run it.'; })));
  const wiring = el('div', undefined, { className: 'row' }); wiring.append(label('Source', from), label('Output port', port), label('Destination', to), button('Connect native nodes', () => attempt(async () => { const p = Number(port.value); if (!Number.isInteger(p) || p < 0 || p > 99) throw new Error('Use output port 0–99'); updateNode(from.value, node => { node.wires ||= []; while (node.wires.length <= p) node.wires.push([]); if (!node.wires[p].includes(to.value)) node.wires[p].push(to.value); }); await preview(); })), button('Disconnect native nodes', () => attempt(async () => { const p = Number(port.value); if (!Number.isInteger(p) || p < 0 || p > 99) throw new Error('Use output port 0–99'); updateNode(from.value, node => { if (node.wires?.[p]) node.wires[p] = node.wires[p].filter(id => id !== to.value); }); await preview(); })));
  async function editLink(connect){const epoch=generation,draft=text.value,document=JSON.parse(draft),list=Array.isArray(document)?document:document.flows,source=list.find(n=>n.id===linkFrom.value),target=list.find(n=>n.id===linkTo.value);if(source?.type!=='link out'||target?.type!=='link in')throw new Error('Choose a Link Out and Link In pair');if((source.mode||'link')!=='link')throw new Error('Only static Link Out link mode can be connected here');for(const n of[source,target])if(n.links&&!Array.isArray(n.links))throw new Error('Static link lists must be arrays');if(connect){source.links=source.links||[];target.links=target.links||[];if(!source.links.includes(target.id))source.links.push(target.id);if(!target.links.includes(source.id))target.links.push(source.id);}else{if(Array.isArray(source.links))source.links=source.links.filter(id=>id!==target.id);if(Array.isArray(target.links))target.links=target.links.filter(id=>id!==source.id);}const next=JSON.stringify(document,null,2);await api('native-validate',{text:next});if(!viewCurrent()||epoch!==generation||draft!==text.value)return;text.value=next;await preview();status.textContent=connect?'Static link connected in both native lists; save and deploy.':'Static link removed from both native lists; save and deploy.';}
  const linkControls=el('div',undefined,{className:'row'});linkControls.append(label('Link Out',linkFrom),label('Link In',linkTo),button('Connect static link',()=>attempt(()=>editLink(true))),button('Disconnect static link',()=>attempt(()=>editLink(false))));
  section.append(el('h2', 'Native Node-RED flows'), el('p', 'Preserve native JSON, edit nodes and connections, then deploy a revision. Manual execution supports bounded Inject, Change, Switch, JSON, Debug and static Link In/Link Out configurations. Warnings identify other capabilities.'), status, label('Saved flow', picker), label('Flow name', name), label('Import file', file), documentEditor, actions, summary, warnings, diagram, wiring, linkControls, selectedLabel, label('Selected node properties', nodeEditor), nodeActions, el('h3', 'Run the deployed revision'), label('Inject node', start), label('Input messages', messages), button('Inject native messages', () => attempt(async () => { if (!current) throw new Error('Save and deploy a native flow'); const { run } = await api('native-inject', { id: current.id, start: start.value, messages: JSON.parse(messages.value) }); output.textContent = JSON.stringify(run, null, 2); await inspect(); status.textContent = run.status === 'completed' ? 'Native messages delivered' : run.error; })), button('Reset native context', () => attempt(async () => { if (!current) throw new Error('Choose a saved native flow'); await api('native-reset', { id: current.id }); await inspect(); status.textContent = 'Native context reset'; })), output, el('h3', 'Native flow and global context'), contextView, el('h3', 'Native run history'), history);
  root.insertBefore(section, root.firstChild); await refreshList();return()=>{if(disposed)return;disposed=true;generation++;current=null;selected='';linkConnections=[];for(const control of section.querySelectorAll('input,textarea'))control.value='';contextView.textContent='';output.textContent='';section.replaceChildren();};
}
