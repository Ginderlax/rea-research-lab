    },
    {
      "id": "grafana.candidate.75ef5bde99be5f277366",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use the IP address of the Prometheus container, or the hostname if you are using Docker Compose. Alternatively, you can use `http://host.docker.internal:9090` to reference the host machine.",
      "headingPath": [
        "Configure the Prometheus data source",
        "Configuration options",
