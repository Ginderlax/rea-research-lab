    },
    {
      "id": "grafana.candidate.90001235d3645ab05b35",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Code mode supports autocompletion of tables, columns, SQL keywords, standard SQL functions, Grafana template variables, and Grafana macros.",
      "headingPath": [
        "Microsoft SQL Server query editor",
        "Code mode",
        "Use autocompletion"
      ],
      "source": {
