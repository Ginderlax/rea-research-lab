import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import {spawnSync} from 'node:child_process';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),lab=path.resolve(here,'../../outputs/rea-research-lab'),studio=path.join(lab,'products/rea-studio'),root=path.join(studio,'apps/backup/results/rabin-recorder-review'),hash=b=>createHash('sha256').update(b).digest('hex'),read=async p=>JSON.parse(await fs.readFile(p,'utf8'));
const receiptBytes=await fs.readFile(path.join(root,'integration-validation.json'));assert.equal(hash(receiptBytes),'a4fd7c71761376c1799426ae075e500ebd2b2a2068861019ae1261b260a7d16e');const receipt=JSON.parse(receiptBytes),manifestBytes=await fs.readFile(path.join(root,'preservation-manifest.json')),manifest=JSON.parse(manifestBytes);assert.equal(hash(manifestBytes),'8e41633e8ed5b84fe3e3a7035f1e7881b2abb583f62f77a38f873b9428ac56b1');assert.equal(manifest.snapshots.length,73);assert.equal(manifest.parentBehaviorReceiptSha256,'a0e8198e438fb9c5cc08d0394793bc684682efa82fde7c4bca0ca202038bfec0');assert.equal(manifest.behavioralTestsRerunForCollectorChange,0);assert.equal(receipt.historicalBehaviorEvidenceReboundToCurrentCollector,false);assert.equal(receipt.historicalBehaviorTestsRerun,0);
await fs.mkdir(path.join(here,'baseline'),{recursive:true});const rows=[],prefix='products/rea-studio/apps/backup/results/rabin-recorder-review/';
async function preserve(source,relative){const bytes=await fs.readFile(source),target=path.join(here,'baseline',relative);await fs.mkdir(path.dirname(target),{recursive:true});await fs.writeFile(target,bytes,{flag:'wx'});rows.push({source:path.relative(lab,source).replaceAll('\\','/'),path:'baseline/'+relative,bytes:bytes.length,sha256:hash(bytes)});return bytes;}
for(const row of manifest.snapshots){assert.ok(row.path.startsWith(prefix));assert.ok(!row.path.includes('\\')&&!row.path.split('/').includes('..'));const source=path.join(lab,row.path),bytes=await preserve(source,'preserved/'+row.path.slice(prefix.length));assert.equal(bytes.length,row.bytes);assert.equal(hash(bytes),row.sha256);}
for(const row of receipt.implementationFingerprints){const bytes=await preserve(path.join(lab,row.path),'current/'+row.path);assert.equal(bytes.length,row.bytes);assert.equal(hash(bytes),row.sha256);}await preserve(path.join(root,'integration-validation.json'),'integration-validation.json');for(const row of receipt.rawEvidence){const bytes=await preserve(path.join(lab,row.path),'current/'+row.path);assert.equal(hash(bytes),row.sha256);}
const license=await preserve(path.join(lab,manifest.nodeLicense.path),'NODE-LICENSE.txt');assert.equal(license.length,manifest.nodeLicense.bytes);assert.equal(hash(license),manifest.nodeLicense.sha256);assert.ok(license.toString().includes('Copyright Node.js contributors. All rights reserved.'));assert.ok(license.toString().includes('The above copyright notice and this permission notice shall be included'));
for(const name of await fs.readdir(path.join(root,'production-failed-livelogger')))await preserve(path.join(root,'production-failed-livelogger',name),'failed-livelogger/'+name);
const old=await fs.readFile(path.join(lab,manifest.historicalCollector.snapshotPath));assert.equal(hash(old),manifest.historicalCollector.sha256);const current=await fs.readFile(path.join(lab,manifest.currentCollector.path));assert.equal(hash(current),'a7068f3e4d8db328636e2daa1e9cd55a7c5d7327320f19edeedc88ed28466dba');assert.deepEqual(current,await fs.readFile(new URL('../backup-rabin-production-review/independent-decoder.mjs',import.meta.url)));
const history=await read(path.join(studio,'apps/backup/results/rabin-validation.json'));assert.equal(history.summary.tests,47);assert.equal(history.summary.pass,47);const historicCollector=history.implementationFingerprints.find(row=>row.path.endsWith('scripts/read-rabin-tap.mjs'));assert.equal(historicCollector.sha256,manifest.historicalCollector.sha256);const historicBefore=await read(path.join(root,'review/baseline/final47/rabin-source-before.json'));assert.equal(hash(await fs.readFile(path.join(root,'review/baseline/final47/rabin-validation.json'))),manifest.parentBehaviorReceiptSha256);
const unchangedBehavior=[];for(const row of history.implementationFingerprints.filter(row=>row.path.includes('/apps/backup/')&&row.path.endsWith('.mjs'))){assert.equal(hash(await fs.readFile(path.join(lab,row.path))),row.sha256);unchangedBehavior.push(row);}
const test=await fs.readFile(path.join(studio,'tests/rabin-recorder.test.mjs'),'utf8');assert.ok(test.includes('const childEnv={...process.env};delete childEnv.NODE_TEST_CONTEXT;'));assert.ok(test.includes('env:childEnv'));assert.ok(test.includes('finally{'));assert.ok(test.includes("basename(folder).startsWith('rea-rabin-recorder-')"));assert.ok(test.includes('await fs.rm(folder,{recursive:true,force:true})'));
const run=spawnSync(process.execPath,['--test','--test-reporter=tap','--test-concurrency=1','tests/rabin-recorder.test.mjs'],{cwd:studio,encoding:'utf8',windowsHide:true,timeout:30000,maxBuffer:4*1024*1024});await fs.writeFile(path.join(here,'tests.stdout.txt'),run.stdout,{flag:'wx'});await fs.writeFile(path.join(here,'tests.stderr.txt'),run.stderr,{flag:'wx'});assert.equal(run.status,0,run.stderr);const summary=Object.fromEntries(['tests','pass','fail','cancelled','skipped','todo'].map(name=>[name,Number(run.stdout.match(new RegExp('^# '+name+' (\\d+)$','m'))?.[1])]));assert.deepEqual(summary,{tests:8,pass:8,fail:0,cancelled:0,skipped:0,todo:0});for(const row of rows)assert.equal(hash(await fs.readFile(path.join(lab,row.source))),row.sha256,'Frozen current/preserved bytes changed '+row.source);
const output={schema:'rea-rabin-recorder-independent-integration-review/v1',checkedAtUtc:new Date().toISOString(),runtime:process.version,platform:process.platform,scope:'Read-only current recorder integration review. Only eight recorder tests run; no original or native Backup 47 behavioral case rerun, no results mutation.',accepted:true,currentRecorderExactProposedBytes:true,preservationSnapshotsVerified:73,nodeLicenseVerified:{bytes:license.length,sha256:hash(license),url:manifest.nodeLicense.url,noticePresent:true,externalDownloadInThisReview:false},historicalBehaviorReceiptSha256:manifest.parentBehaviorReceiptSha256,historicalCollectorSha256:manifest.historicalCollector.sha256,currentCollectorSha256:hash(current),historicalSourceBeforeRecordKeys:Object.keys(historicBefore),historicalBehaviorEvidenceRebound:false,unchangedCurrentBackupBehaviorFiles:unchangedBehavior.length,threeHistoricalLogsCovered:true,currentLiveSyntheticLoggerTests:1,inheritedNodeTestContextRemovedFromChildCopy:true,callerProcessEnvironmentNotMutatedByChildEnvPreparation:true,ownedTemporaryCleanupGuardPresent:true,failedSevenOfEightLiveLoggerAttemptPreserved:true,summary,sourceBytesStableAcrossRun:true,reviewedIntegrationReceiptSha256:hash(receiptBytes),preservationManifestSha256:hash(manifestBytes),fingerprints:rows,rawEvidence:{stdoutSha256:hash(run.stdout),stderrSha256:hash(run.stderr)},confirmedFindings:[],limits:['License identity is checked against the frozen manifest and retained notice, without a new external download.','Collector requires an intact unique marker prefix and bounds contiguous fragment count/text size; general unframed arbitrary stdout recovery is not claimed.','Cleanup confines its owned lexical temporary parent/prefix; hostile external replacement races or kernel failures are not exhaustively tested.','This review tests only current recorder reconstruction and one synthetic logger, not fresh original restic behavior, security or performance.'],fullParity:false,securityCertified:false,performanceSuperiority:false};const bytes=JSON.stringify(output,null,2)+'\n';await fs.writeFile(path.join(here,'review-validation.json'),bytes,{flag:'wx'});console.log(JSON.stringify({summary,snapshots:73,backupBehaviorFilesUnchanged:unchangedBehavior.length,receiptSha256:hash(bytes),readyForQuietPause:true}));
