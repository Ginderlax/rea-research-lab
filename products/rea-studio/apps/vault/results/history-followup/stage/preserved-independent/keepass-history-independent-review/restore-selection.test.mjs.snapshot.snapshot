import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';import {fileURLToPath} from 'node:url';import path from 'node:path';
import {render} from '../keepass-history-next/client.mjs';import {handle,dispose} from '../keepass-history-next/server.mjs';
const own=path.dirname(fileURLToPath(import.meta.url));
class Element{constructor(tag){this.tagName=tag;this.children=[];this.listeners=new Map();this.value='';this.checked=false;this.ownText='';this.parentElement=null;this.disabled=false;}set textContent(value){this.ownText=String(value);for(const child of this.children)child.parentElement=null;this.children=[];}get textContent(){return this.ownText+this.children.map(child=>child.textContent).join('');}append(...items){for(const child of items){if(child.parentElement)child.parentElement.children=child.parentElement.children.filter(value=>value!==child);child.parentElement=this;this.children.push(child);}}replaceChildren(...items){for(const child of this.children)child.parentElement=null;this.children=[];this.ownText='';this.append(...items);}addEventListener(name,callback){this.listeners.set(name,callback);}async click(){if(!this.disabled)return this.listeners.get('click')?.();}}
const descendants=root=>[root,...root.children.flatMap(descendants)];
function button(root,title){const found=descendants(root).find(node=>node.tagName==='button'&&node.textContent===title);assert.ok(found,'Expected button '+title);return found;}
function field(root,title){const found=descendants(root).find(node=>node.tagName==='label'&&node.ownText===title);assert.ok(found,'Expected field '+title);return found.children[0];}
function entryButton(root,title){const row=descendants(root).find(node=>node.tagName==='section'&&node.children.some(child=>child.tagName==='strong'&&child.textContent===title));assert.ok(row,'Expected entry row '+title);return button(row,'Open entry');}
test('late post-restore read must not redirect the newly selected editor save to a different entry',async t=>{
 const workspace={root:path.join(own,'.local/restore-selection-synthetic')},store={value:null,async get(){return structuredClone(this.value)},async set(key,value){this.value=structuredClone(value)}},call=(action,input={})=>handle({action,input,workspace,store});
 globalThis.document={createElement:tag=>new Element(tag)};const root=new Element('main'),requests=[],observations={};
 t.after(async()=>{const lock=descendants(root).find(node=>node.tagName==='button'&&node.textContent==='Lock now');if(lock)await lock.click();dispose(workspace);delete globalThis.document;await fs.writeFile(path.join(own,'restore-selection-observation.json'),JSON.stringify({schema:'rea-independent-keepass-restore-editor-race/v1',requests,observations,scope:'Actual frozen client/server with owned DOM element model and deterministic held transport response; no original GUI or current HTTP data-loss claim.'},null,2)+'\n');});
 await call('create',{password:'owned synthetic master pass'});const A=(await call('save',{title:'Entry A',password:'A original',notes:'A content'})).id,B=(await call('save',{title:'Entry B',password:'B original',notes:'B content'})).id;const previous=(await call('read',{id:A})).entry;await call('save',{...previous,password:'A second'});
 let armed=false,release,heldResolve;const held=new Promise(resolve=>heldResolve=resolve);
 const transport=async(action,input)=>{requests.push({action,id:input?.id,title:input?.title});const result=await call(action,input);if(action==='historyRestore')armed=true;if(action==='read'&&input.id===A&&armed){armed=false;heldResolve();return new Promise(resolve=>release=()=>resolve(result));}return result;};
 await render(root,transport);await entryButton(root,'Entry A').click();await button(root,'Show entry history').click();await button(root,'View this version').click();field(root,'Confirm restoring this version and saving the current version in history').checked=true;const pending=button(root,'Restore this version').click();await held;
 await entryButton(root,'Entry B').click();observations.visibleEditorBeforeRelease={title:field(root,'Title').value,password:field(root,'Password').value};release();await pending;observations.visibleEditorAfterRelease={title:field(root,'Title').value,password:field(root,'Password').value};
 field(root,'Title').value='Entry B user edit';await button(root,'Save encrypted entry').click();observations.ids={A,B};observations.after={A:(await call('read',{id:A})).entry,B:(await call('read',{id:B})).entry};observations.lastSave=requests.filter(row=>row.action==='save').at(-1);observations.wrongEntryChanged=observations.after.A.title==='Entry B user edit'&&observations.after.B.title==='Entry B';
 assert.equal(observations.lastSave.id,B,'The visible Entry B editor must save Entry B rather than the late restored Entry A.');
});
