import assert from 'node:assert/strict';
import {readFileSync,writeFileSync,readdirSync,lstatSync} from 'node:fs';
import {resolve} from 'node:path';
import {createHash} from 'node:crypto';
import {spawnSync} from 'node:child_process';
import {createEditorVaultProofMigration} from './candidate/scripts/editor-vault-proof-migration.mjs';
import {verifyEditorValueApiProofBytes} from './candidate/scripts/verify-editor-value-api-followups.mjs';
const stage=import.meta.dirname,repo=resolve(stage,'../../outputs/rea-research-lab'),records=JSON.parse(readFileSync(resolve(stage,'transition-records.json'))),sha=b=>createHash('sha256').update(b).digest('hex'),checks=[],reads=new Map();
function source(p){const verifier=records.verifiers.find(r=>r.path===p);if(verifier)return resolve(stage,'candidate',p);const before=records.verifiers.find(r=>r.historicalPath===p);if(before)return resolve(stage,'verifier-before',before.path.slice(8)+'.snapshot');return resolve(repo,p);}
function raw(p){const b=readFileSync(source(p));const id={bytes:b.length,sha256:sha(b)};if(reads.has(p))assert.deepEqual(id,reads.get(p),'Preflight source drift');else reads.set(p,id);return b;}
function check(name,run){run();checks.push({name,passed:true});}
function rejected(name,modify){let error;try{createEditorVaultProofMigration(p=>modify(p,raw(p)));}catch(e){error=e;}assert(error,'Expected rejection '+name);checks.push({name,passed:true,rejected:true,error:{name:error.name,message:error.message}});}
check('exact30 installed +sharedhost+seven candidate verifiers authenticate',()=>assert.equal(createEditorVaultProofMigration(raw).summary().currentInstalledSourcesMandatory,30));
const migration=createEditorVaultProofMigration(raw);
check('all8 named prior identities map only to fixed aliases',()=>{for(const r of records.routes){assert.equal(migration.resolve(r.path,r.before),r.historicalPath);assert.equal(migration.resolve(r.path,r.after),null);assert.throws(()=>migration.resolve(r.path,{...r.before,sha256:'0'.repeat(64)}));assert.throws(()=>migration.resolve(r.path));}});
check('unknown paths never mapped and path escapes rejected',()=>{assert.equal(migration.resolve('products/rea-studio/apps/editor/unknown.mjs',{bytes:0,sha256:'0'.repeat(64)}),null);for(const p of ['../x','work/x','/x','a\\b'])assert.throws(()=>migration.resolve(p));});
check('only exact old dev/status metadata names accepted',()=>{assert.equal(sha(migration.historicalMetadata('development')),records.metadata.development.sha256);assert.equal(sha(migration.historicalMetadata('status')),records.metadata.status.sha256);assert.throws(()=>migration.historicalMetadata('current'));});
check('all7 historical verifier beforeimages exact and no arbitrary reader',()=>{for(const r of records.verifiers)assert.equal(sha(migration.historicalVerifier(r.path)),r.before.sha256);assert.throws(()=>migration.historicalVerifier('scripts/unlisted.mjs'));});
for(const [name,p]of [['after-source',records.sources[0].path],['host',records.sharedHost.path],['after-verifier',records.verifiers[0].path],['historical-source',records.routes[0].historicalPath],['old-dev',records.metadata.development.historicalPath],['old-status',records.metadata.status.historicalPath],['installation-manifest',records.installation.manifest.path],['installation-record',records.installation.record.path],['historical-verifier',records.verifiers[0].historicalPath],['old847-capsule-manifest',records.oldCapsule.path]])rejected('reject mutation: '+name,(at,b)=>at===p?Buffer.concat([b,Buffer.from('\n')]):b);
check('full API475 +focus27 +failed13 public proof through pure reader',()=>{const io={read:raw,list(p){const out=[];function visit(n){for(const d of readdirSync(resolve(repo,n),{withFileTypes:true})){assert(!d.isSymbolicLink());const path=n+d.name;if(d.isDirectory())visit(path+'/');else out.push(path);}}visit(p);return out;}};const result=verifyEditorValueApiProofBytes(io);assert.equal(result.currentAdditions,4);assert.equal(result.unchangedEditor24,20);assert.equal(result.explicitLaterEditorReplacements,4);writeFileSync(resolve(stage,'api-preflight-result.json'),JSON.stringify(result,null,2)+'\n');});
for(const name of readdirSync(resolve(stage,'candidate/scripts'))){const child=spawnSync(process.execPath,['--check',resolve(stage,'candidate/scripts',name)],{encoding:'utf8',windowsHide:true,timeout:10000,maxBuffer:128*1024});writeFileSync(resolve(stage,'syntax-'+name+'.stdout.txt'),child.stdout??'');writeFileSync(resolve(stage,'syntax-'+name+'.stderr.txt'),child.stderr??'');assert.equal(child.status,0,name);checks.push({name:'syntax '+name,passed:true,sourceOnly:true});}
for(const [p,r]of reads){const b=readFileSync(source(p));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256,p);}
const result={schema:'rea-editor-vault-source-only-preflight/v1',at:new Date().toISOString(),checks,checkCount:checks.length,sourceBeforeAfter:[...reads].map(([path,r])=>({path,...r})),sourceStable:true,pureReaderCandidateOverride:'Only exact seven candidate verifier paths and their seven explicitly named private beforeimages; public source paths use actual installed bytes.',newApplicationTests:0,originalExecutions:0,browsers:0,benchmarks:0,wholeRootVerifierExecuted:false};writeFileSync(resolve(stage,'preflight-validation.json'),JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify({passed:true,checks:checks.length,authenticatedFiles:reads.size,sourceStable:true,newApplicationTests:0}));
