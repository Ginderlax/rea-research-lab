    {
      "id": "grafana.candidate.8ae6a4c23e6e5a8e5aad",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Preview how your alert instances will be routed if they fire while you're creating your alert rule. You can view routing for each Alertmanager you've configured to receive Grafana-managed alerts, and if required, easily make adjustments to your custom labels to change the way your alert instances are routed.",
      "headingPath": [
        "What’s new in Grafana v10.1",
        "Alerting",
        "Alert rules",
        "Alert instance routing preview"
      ],
      "source": {
