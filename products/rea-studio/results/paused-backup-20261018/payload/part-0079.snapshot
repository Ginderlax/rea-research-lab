    {
      "id": "grafana.candidate.3ce27557dc7f8918e4f9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To try it out, enable the `publicDashboards` feature toggle. If you’re using Grafana Cloud, and would like to enable this feature, please contact customer support.",
      "headingPath": [
        "What’s new in Grafana v10.0",
