    {
      "id": "grafana.candidate.fc0a4341f6fa62cbaf77",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you toggle on the switch, the **Tooltip placement** option, which controls where the tooltip box opens upon hover, is also displayed. Select one of the following options: **Auto**, **Top**, **Right**, **Bottom**, and **Left**.",
      "headingPath": [
        "Table",
        "Configuration options",
        "Cell options",
        "Tooltip from field"
