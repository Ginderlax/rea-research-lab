import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const work=import.meta.dirname,old=path.join(work,'root-vault-group-browser-review-next'),fresh=path.join(work,'root-vault-group-browser-visible-control'),sha=b=>createHash('sha256').update(b).digest('hex'),manifest=await fs.readFile(path.join(old,'manifest.json'));assert.equal(sha(manifest),'f14ce1bfd7b22ea78e37d239bcf3f83f0935617d3d8591b27a1d220177886a0f');for(const row of JSON.parse(manifest).inventory){const b=await fs.readFile(path.join(old,row.path));assert.equal(b.length,row.bytes);assert.equal(sha(b),row.sha256);}await fs.mkdir(fresh,{recursive:false});const source=await fs.readFile(path.join(old,'host.mjs'));await fs.writeFile(path.join(fresh,'host.mjs'),source,{flag:'wx'});const wire=JSON.parse(await fs.readFile(path.join(old,'wire.json'))).wire;assert.equal(wire.filter(r=>r.url==='/api/vault/recycleGroupList').length,0);await fs.writeFile(path.join(fresh,'input-control-preparation.json'),JSON.stringify({scope:'Owned browser input delivery control in a fresh visible in-app tab. Exact same host collector/runtime and frozen343; no product source fix/adapter. The prior hidden tab delivered no observed group API requests, so product/browser diagnosis remains unresolved.',previousManifestSha256:sha(manifest),previousWireRequests:wire.length,previousGroupAPIRequests:0,collectorSHA256:sha(source),sourceChanges:0,priorScreenshotLocalCopy:false},null,2)+'\n',{flag:'wx'});await fs.copyFile(import.meta.filename,path.join(fresh,'input-control-preparation.mjs.snapshot'));console.log(JSON.stringify({stage:fresh,collectorExact:true}));
