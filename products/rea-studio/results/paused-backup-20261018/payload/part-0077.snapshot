    {
      "id": "grafana.candidate.1ce94efba812231eb626",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Instead of using the `annotate` flag, you can still use the `--record` flag. However, it has been deprecated and will be removed in the future version of Kubernetes. See: https://github.com/kubernetes/kubernetes/issues/40422",
      "headingPath": [
