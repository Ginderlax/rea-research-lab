  original:{receipt:{path:'fresh-original-validation.json',...await fp(path.join(here,'fresh-original-validation.json'))},actualInvocations:13,queryGroups:12,positions:267,seed:'0x712ace05',reuseDisclosure:'These were the twelve inputs prepared in the prior review, whose initial collector stopped during group zero. All twelve were executed and verified here; they are held out from root20-group replay but not a newly generated second seed.',engine:original.engine,engineBeforeAfterExact:true,sourceBeforeAfterExact:true,changedSyntheticFiles:false,deadlineMsPerChild:30000,combinedOutputLimitPerChild:1048576,workbenchOrGUIExecution:false},
