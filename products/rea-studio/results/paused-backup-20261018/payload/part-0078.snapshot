    {
      "id": "grafana.candidate.c85399cad76059e9eaac",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Start Grafana by executing `grafana-server.exe`, located in the `bin` directory, preferably from the command line. If you want to run Grafana as a Windows service, then download [NSSM](https://nssm.cc/). It is very easy to add Grafana as a Windows service using that tool.",
      "headingPath": [
