    },
    {
      "id": "grafana.candidate.f5991f1d054825096f59",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Check out the [Grafana Community](https://community.grafana.com/) for more troubleshooting help (you must be logged in to post or comment).",
      "headingPath": [
        "Troubleshooting",
        "More help"
      ],
      "source": {
        "path": "docs/sources/troubleshooting/_index.md",
        "gitBlobSha": "f343f7580ebb991fa8dc2099cee36730d1fbe3ee",
