    {
      "id": "grafana.candidate.f4e15a46408d5c3e49b8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Unless the `skip_org_role_sync` option is enabled, the user's role will be set to the role mapped from Google upon user login. If no mapping is set the default instance role is used.",
      "headingPath": [
        "Configure Google OAuth authentication",
        "Configure Google authentication client using the Grafana configuration file",
        "Configure team synchronization",
        "Configure role mapping"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md",
        "gitBlobSha": "53ca46b6aee0a719a8cbd28a536c33a8fe2e5733",
        "sha256": "a3ff08724962dd5598b98503415b00b745cf0225af5d2b42cdc330ad5f2f46e8",
        "lineStart": 233,
        "lineEnd": 233,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/google/index.md#L233-L233"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.af1aef7aab6957cf3e03",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The user's role is retrieved using a [JMESPath](http://jmespath.org/examples.html) expression from the `role_attribute_path` configuration option. To map the server administrator role, use the `allow_assign_grafana_admin` configuration option.",
      "headingPath": [
