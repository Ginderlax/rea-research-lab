      "id": "KVH-REVIEW-SAME-EDITOR-DRAFT",
      "priority": "P2",
      "source": "client.mjs",
      "sourceSha256": "157e34dfaa5dce136f4225aa04dcfcd7f69d8a4880c4c42b657c265adaa3ebfd",
      "trigger": "Hold the completed Restore or Save transport response, type a new Notes draft into the same still-enabled editor after request capture, then release the response.",
      "actual": "Restore rebuilds the editor from the historical Notes value; Save rebuilds a blank New entry editor. In each case the newly typed draft disappears.",
      "expected": "Disable editor inputs during that mutation, or capture/track their draft state and preserve changes made after request capture before replacing the editor.",
      "reasonExistingFixInsufficient": "View/selection/editor generations do not change when values are typed in the same editor.",
      "reproductions": [
        "boundary-observations/same-editor-restore-draft.json",
        "boundary-observations/same-editor-save-draft.json"
      ],
      "scope": "Actual authenticated fixed client/server, synthetic encrypted in-memory store and owned DOM model with deterministic delayed response. No actual HTTP loss or original GUI execution claim.",
      "saveBoundaryPreExisting": true,
      "restoreBoundaryNew": true
    }
  ],
