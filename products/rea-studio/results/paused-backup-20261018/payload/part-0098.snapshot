let readme=readFileSync(join(product,'README.md'),'utf8');readme=readme.replace('serialized per-application operations','serialized local mutations and immediate WebDAV busy rejection').replace('7Z Copy/DEFLATE,','7Z Copy/DEFLATE/LZMA/LZMA2,').replace('Local comparison and copy synchronization','Local rules and generic WebDAV synchronization').replace(/The current record contains \d+ passing tests and \d+ skips\./,`The current record contains ${count} passing tests and 0 skips.`).replace('The [native workflows and synchronization milestone](NATIVE-WORKFLOWS-MILESTONE.md) describes the current capabilities and measured follow-ups.','The [compression and remote synchronization milestone](COMPRESSION-REMOTE-MILESTONE.md) describes the current capabilities. The [native workflows milestone](NATIVE-WORKFLOWS-MILESTONE.md) preserves the preceding 345-test checkpoint.').replace('[current native-workflow/synchronization checks](results/browser-native-workflows-verification.json)','[historical native-workflow/synchronization checks](results/browser-native-workflows-verification.json) and [current compression/remote synchronization checks](results/browser-compression-remote-verification.json)');writeFileSync(join(product,'README.md'),readme);
let rootReadme=readFileSync(join(lab,'README.md'),'utf8');rootReadme=rootReadme.replace(/The current \[native workflow\/synchronization\/archive milestone\][\s\S]*?passing implemented-contract tests and 0 skips\./,`The historical [native workflow milestone](products/rea-studio/NATIVE-WORKFLOWS-MILESTONE.md) records 345 passing checks. The current [compression and remote synchronization milestone](products/rea-studio/COMPRESSION-REMOTE-MILESTONE.md) adds compressed LZMA/LZMA2 archives, compressed restic v2 writing and generic WebDAV synchronization with ${count} passing implemented-contract checks and 0 skips.`);writeFileSync(join(lab,'README.md'),rootReadme);
const historical=join(product,'NATIVE-WORKFLOWS-MILESTONE.md');let old=readFileSync(historical,'utf8');if(!old.includes('Historical checkpoint at revision'))old=old.replace('\n\n','\n\nHistorical checkpoint at revision `64238267b332bb3a8ac5435a613a596a06311f59`. Its eight receipts and 200 source/proof snapshots are preserved in the [snapshot manifest](results/milestones/native-workflows-20261012/snapshot-manifest.json). The [compression/remote milestone](COMPRESSION-REMOTE-MILESTONE.md) supersedes its descriptions of current capabilities.\n\n');writeFileSync(historical,old);
