    },
    {
      "id": "grafana.candidate.8a63ddc67456c9e13d41",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If the remote HTTP image renderer service runs on a different server than the Grafana server you may have to configure this to a URL where Grafana is reachable, for example, http://grafana.domain/.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[rendering]`",
        "`callback_url`"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/_index.md",
        "gitBlobSha": "840897d3e561f7771511009edaca25f1998321d0",
