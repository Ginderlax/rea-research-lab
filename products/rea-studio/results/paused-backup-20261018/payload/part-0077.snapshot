    },
    {
      "id": "grafana.candidate.da807404b383db04560a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set to `true` for Grafana to log all HTTP requests (not just errors). These are logged as Info level events to the Grafana log.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[server]`",
        "`router_logging`"
      ],
