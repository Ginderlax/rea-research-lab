    {
      "id": "grafana.candidate.65db0ef615a142d3c838",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To limit access to authenticated users who are members of one or more Entra ID groups, set `allowed_groups` to a _comma-_ or _space-separated_ list of group object IDs.",
      "headingPath": [
        "Configure Microsoft Entra ID OAuth authentication",
        "Configure the Entra ID authentication client using the Grafana configuration file",
        "Configure allowed groups"
      ],
      "source": {
