// Final source-only gates/freeze. Never imports application or original code.
import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const root=import.meta.dirname,workspace=path.resolve(root,'../..'),repo=path.join(workspace,'outputs/rea-research-lab'),id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')});
async function save(p,j){const d=path.join(root,p);await fs.mkdir(path.dirname(d),{recursive:true});await fs.writeFile(d,JSON.stringify(j,null,2)+'\n',{flag:'wx'});}const json=async p=>JSON.parse(await fs.readFile(path.join(root,p)));
const map=await json('public-preservation-map.json'),live=await json('live-copy-list.json'),base=await json('current-editor24-before.json'),scope=await json('pure-regression-scope.json'),run=await json('runs/final-pure13/validation.json');assert.equal(map.payload.length,402);assert.equal(map.uniqueByteObjects,166);assert.equal(live.proposals.length,4);assert.equal(scope.nestedOptionalFields.length,6);assert.equal(scope.selectionInheritedDeclarations.length,10);assert.equal(new Set(scope.selectionInheritedDeclarations.map(r=>r.member)).size,9);assert.deepEqual(run.summary,{tests:13,pass:13,fail:0,skipped:0});assert.equal(run.sourceStable,true);
const authenticated=[];for(const r of map.payload){const b=await fs.readFile(path.join(workspace,r.sourceRoot,r.sourcePath));assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});authenticated.push({path:r.sourceRoot+'/'+r.sourcePath,...id(b)});}for(const r of base){assert.deepEqual(id(await fs.readFile(path.join(repo,r.path))),{bytes:r.bytes,sha256:r.sha256});}for(const r of live.proposals){const b=await fs.readFile(path.join(root,r.proposalPath));assert.deepEqual(id(b),r.after);if(r.before)assert.deepEqual(id(await fs.readFile(path.join(repo,r.destination))),r.before);else await assert.rejects(fs.access(path.join(repo,r.destination)),{code:'ENOENT'});}
const README=live.proposals.find(r=>r.destination.endsWith('/README.md')),readme=await fs.readFile(path.join(root,README.proposalPath)),before=await fs.readFile(path.join(root,'before-images/'+README.destination+'.snapshot'));assert.ok(readme.subarray(0,before.length).equals(before));const links=[];const pubPaths=new Set(map.payload.map(r=>r.publicPath));for(const m of readme.toString().matchAll(/\[[^\]]*\]\(([^)]+)\)/g)){if(/^(https?:|#)/.test(m[1]))continue;const p=path.posix.normalize(path.posix.join(path.posix.dirname(README.destination),m[1]));if(live.proposals.some(r=>r.destination===p))links.push({path:p,resolves:'proposal'});else if(pubPaths.has(p))links.push({path:p,resolves:'exact402-public-alias'});else {await fs.access(path.join(repo,p));links.push({path:p,resolves:'existing-repository'});}}await save('readme-relative-link-gates.json',{links,networkFetches:0,allResolve:true,existingPrefixBytes:before.length});
const guards=[];const checkRows=rs=>{const paths=new Set();for(const r of rs){assert.ok(r.publicPath.startsWith('products/rea-studio/apps/editor/results/position-range-selection-followup/')&&!r.publicPath.includes('/.local/')&&!r.publicPath.includes('\\')&&!r.publicPath.includes(':')&&r.publicPath.split('/').every(s=>s&&s!=='.'&&s!=='..'));assert.ok(!paths.has(r.publicPath));paths.add(r.publicPath);assert.match(r.sha256,/^[0-9a-f]{64}$/);assert.ok(Number.isSafeInteger(r.bytes)&&r.bytes>=0&&r.bytes<=32*1024*1024);}};checkRows(map.payload);for(const [name,mutate]of [['duplicate-public-path',rs=>rs.push(rs[0])],['unsafe-local-segment',rs=>rs[0].publicPath='products/rea-studio/apps/editor/results/position-range-selection-followup/.local/a.snapshot'],['traversal',rs=>rs[0].publicPath='products/rea-studio/apps/editor/results/position-range-selection-followup/../a.snapshot'],['invalid-identity',rs=>rs[0].sha256='invalid']]){const rows=structuredClone(map.payload);mutate(rows);assert.throws(()=>checkRows(rows));guards.push({name,rejected:true,sourceOnly:true});}await save('negative-source-gates.json',{guards,applicationTests:0,originalExecutions:0});
const provenance=await json('source-and-license-provenance.json');assert.equal(provenance.officialSourceRecords.length,6);assert.equal(provenance.license,'MIT');const notice=await fs.readFile(path.join(root,live.proposals.find(r=>r.destination.endsWith('.NOTICE.md')).proposalPath)),license=await fs.readFile(path.join(workspace,'work/editor-position-range-selection-fix-next',provenance.fullLicense.path));assert.ok(notice.subarray(notice.length-license.length).equals(license));
await save('final-source-authentication.json',{inputRows402:authenticated,acceptedEpochsUnchanged:true,currentEditor24Unchanged:true,proposalRuntimeExact:true,READMEPrefixExact:true,MITTextExact:true,originalExecutions:0,StudioWrites:0});
const receipt={schema:'rea-editor-value-api-production-publication-plan-validation/v1',at:new Date().toISOString(),sourceOnlyPlan:true,rootReviewPending:true,productionInstalled:false,productionWrites:0,registryWrites:0,hostActions:0,browserActions:0,originalEvaluationsByPlan:0,originalProgramExecutionsByPlan:0,benchmarks:0,acceptedCandidate319Manifest:'77ae818b4539341ab6f2f0126efaf8974117136f207747450d821df7c09baa1d',acceptedIndependent81Manifest:'7eb5f10cca861c1ac31b2e6362df8c33d49a1c02f6f0f59c38cd7549cb2aba27',runtimeSHA256:'9f5d89b260e88fc1c2197d23a9c2b0ca25fcff688c5eba839471c7a4fe499aa8',incoming402PublicPathRecords:402,incoming400Payloads:400,incomingTwoManifests:2,uniqueIncomingByteObjects:166,excludedIncomingCarrierFiles:0,embeddedOld14543Rows:190,liveProposals:4,newPaths:3,READMEReplacements:1,currentEditor24SourceStable:true,proposalSourceStable:true,directDeclarationEntries:30,optionalFields:6,inheritedNonConstructorEntries:10,inheritedDistinctNames:9,constructibleHelpersOutsideDenominator:6,pureRegressionGroups:13,pureRegressionPass:13,pureRegressionSkip:0,pureReceipt:{path:'runs/final-pure13/validation.json',...id(await fs.readFile(path.join(root,'runs/final-pure13/validation.json')))},initialProvisionalPure13NotAddedToFinalCount:true,sourceOnlyPreparationAttempts:3,sourceOnlyPreparationFailures:2,originalReplay22HistoricalNotRerun:true,independentFresh9HistoricalNotRerun:true,oldStrictnessAndErrorControlRawPreserved:true,ownNormalTestOriginalDependencies:0,normalTestsWriteAppsResults:false,sourceBasedMITNoticesRetained:true,clientSelectionBinding:false,wholeExtensionAPI:false,semanticExhaustiveness:false,fullProductParity:false,securityEquivalence:false,superiority:false};await save('validation.json',receipt);
async function walk(p=''){const out=[];for(const e of(await fs.readdir(path.join(root,p),{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const n=p+e.name;if(n==='freeze-manifest.json')continue;assert.equal(e.isSymbolicLink(),false);if(e.isDirectory())out.push(...await walk(n+'/'));else{assert.ok(e.isFile());const b=await fs.readFile(path.join(root,n)),h=b.subarray(0,8).toString('hex');assert.ok(!['4d5a','7f454c46','504b0304','504b0506','504b0708','1f8b','377abcaf271c','fd377a585a00','28b52ffd','03d9a29a'].some(x=>h.startsWith(x)));assert.notEqual(b.subarray(257,262).toString(),'ustar');new TextDecoder('utf-8',{fatal:true}).decode(b);out.push({path:n,...id(b)});}}return out;}
const files=await walk();await save('freeze-manifest.json',{schema:'rea-editor-value-api-publication-plan-strict-freeze/v1',at:new Date().toISOString(),strict:true,selfExcluded:true,files:files.length,bytes:files.reduce((n,r)=>n+r.bytes,0),receiptSHA256:id(await fs.readFile(path.join(root,'validation.json'))).sha256,inventory:Object.fromEntries(files.map(r=>[r.path,{bytes:r.bytes,sha256:r.sha256}]))});for(const r of files)assert.deepEqual(id(await fs.readFile(path.join(root,r.path))),{bytes:r.bytes,sha256:r.sha256});console.log(JSON.stringify({files:files.length,receipt:id(await fs.readFile(path.join(root,'validation.json'))),manifest:id(await fs.readFile(path.join(root,'freeze-manifest.json'))),proposals:live.proposals.map(({destination,before,after})=>({destination,before,after})),mapped402:true,sourceStable:true,pure13:true}));
