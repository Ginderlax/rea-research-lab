{"snapshots":9,"manifestSHA256":"97c95c26dc40f420774a269b4c1ff756c5503f96976497eb5069696467120170","receiptSHA256":"2ce8c65b1c03e9bc0427b01ed7cd1805f42a26438c65bd47c6d514c843757de8"}
from pathlib import Path
import hashlib
import json

work = Path(__file__).resolve().parent
inventory_path = work / "full-archive-feature-inventory.json"
inventory = json.loads(inventory_path.read_text(encoding="utf-8"))
sources = {s["id"]: s for s in inventory["sources"]}
issues = []
line_counts = {}
for s in sources.values():
    data = Path(s["path"]).read_bytes()
    line_counts[s["id"]] = len(data.splitlines())
    if hashlib.sha256(data).hexdigest() != s["sha256"] or len(data) != s["bytes"]:
        issues.append({"type": "source fingerprint", "source": s["id"]})
ids = [c["id"] for c in inventory["contracts"]]
if len(ids) != len(set(ids)):
    issues.append({"type": "duplicate atom ID"})
references = [c["source"] for c in inventory["contracts"]]
for conflict in inventory["document_conflicts"]:
    for key, value in conflict.items():
        if key.endswith("references"):
            references.extend(value)
for r in references:
    original = sources[r["id"]]
    if r["path"] != original["path"] or r["sha256"] != original["sha256"]:
        issues.append({"type": "reference fingerprint", "source": r["id"]})
    if not 1 <= r["line_start"] <= r["line_end"] <= line_counts[r["id"]]:
        issues.append({"type": "line range", "source": r["id"], "reference": r})
empty_functional = [
    row for row in inventory["scope_and_completeness"]["manual_coverage"]
    if not row["contracts"] and not row["disposition"].startswith("excluded")
]
if empty_functional:
    issues.append({"type": "empty functional document", "documents": empty_functional})
for example in inventory["source_examples"]:
    if not 1 <= example["line_start"] <= example["line_end"] <= line_counts[example["source_id"]]:
        issues.append({"type": "example line range", "source": example["source_id"]})
base = work / "full-archive-baseline-20261012"
replay = work / "full-archive-manual-replay-20261012"
manual_files = {p.relative_to(base / "manual").as_posix(): p for p in (base / "manual").rglob("*") if p.is_file()}
replay_files = {p.relative_to(replay).as_posix(): p for p in replay.rglob("*") if p.is_file()}
if set(manual_files) != set(replay_files):
    issues.append({"type": "manual replay file set"})
for name in manual_files.keys() & replay_files.keys():
    if manual_files[name].read_bytes() != replay_files[name].read_bytes():
        issues.append({"type": "manual replay bytes", "file": name})
manifest_release = json.loads((base / "release-26.04.json").read_text(encoding="utf-8-sig"))
digests = {a["name"]: a["digest"] for a in manifest_release["assets"]}
for asset in inventory["release_binding"]["acquired_assets"]:
    digest = hashlib.sha256(Path(asset["path"]).read_bytes()).hexdigest()
    if "sha256:" + digest != digests[asset["name"]] or digest != asset["sha256"]:
        issues.append({"type": "publisher asset digest", "asset": asset["name"]})
result = {
    "status": "pass" if not issues else "fail",
    "atoms": len(ids),
    "exact_sources": len(sources),
    "line_references_checked": len(references),
    "examples_checked": len(inventory["source_examples"]),
    "manual_replay_files": len(manual_files),
    "publisher_assets_checked": len(inventory["release_binding"]["acquired_assets"]),
    "issues": issues,
    "scope": "Inventory hashes, unique IDs, line ranges, page coverage, asset digests and exact manual extraction replay; no broad product conformance.",
}
(work / "full-archive-inventory-verification.json").write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
print(json.dumps(result, indent=2))
raise SystemExit(0 if not issues else 1)
