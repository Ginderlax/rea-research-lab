    },
    {
      "id": "grafana.candidate.5324f288c65d72e5da0d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The caching backend to use when storing cached queries. Options: `memory`, `redis`, and `memcached`.",
      "headingPath": [
        "Configure Grafana Enterprise",
        "[caching]",
        "backend"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md",
