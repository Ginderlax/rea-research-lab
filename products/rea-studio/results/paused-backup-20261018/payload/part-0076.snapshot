    {
      "id": "grafana.candidate.36a585f5d349645f62a3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can provision the trace to metrics configuration using the `tracesToMetrics` block in your data source YAML file. For the full provisioning YAML example including all Tempo settings, refer to [Provision the Tempo data source](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/tempo/configure-tempo-data-source/provision/).",
      "headingPath": [
        "Configure trace to metrics correlation",
        "Provisioning"
      ],
      "source": {
        "path": "docs/sources/datasources/tempo/configure-tempo-data-source/configure-trace-to-metrics.md",
        "gitBlobSha": "3a874f96d0fd6bc3d0ed6847f9cf1e6fda46c416",
