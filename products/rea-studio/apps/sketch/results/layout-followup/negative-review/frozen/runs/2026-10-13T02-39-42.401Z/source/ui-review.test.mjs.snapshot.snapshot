import test,{after}from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import{harness,find,nodes}from'./ui-fixture.mjs';import{shape,scene,nativeDocument,nativeRect,boundary}from'./fixtures.mjs';import{handle}from'../sketch-alignment-next/products/rea-studio/apps/sketch/server.mjs';
const observations=[];after(()=>fs.writeFileSync(process.env.SKETCH_UI_OBSERVATIONS,JSON.stringify({groups:observations,actualBrowser:0,realServerHandle:true,inMemoryStore:true,fullParity:false},null,2)+'\n',{flag:'wx'}));
async function importScene(root,input){find(root,'textarea').value=JSON.stringify(input);await find(root,'button','Import JSON as new scene').click();}
const fixture=()=>scene([shape('a',10,20,10,20),shape('b',60,100,30,40),shape('c',190,210,10,20)]);
test('already aligned action creates no history entry and retains redo history',()=>harness(async({root,state})=>{const input=fixture();input.shapes[1].x=100;input.shapes[2].x=210;await importScene(root,input);const original=state();await find(root,'button','Select all').click();await find(root,'button','Align left').click();const aligned=state();await find(root,'button','Align left').click();assert.deepEqual(state(),aligned);assert.ok(nodes(root).some(n=>n.textContent==='Selection already arranged'));await find(root,'button','Undo').click();assert.deepEqual(state(),original);await find(root,'button','Select all').click();await find(root,'button','Distribute horizontally').click();assert.deepEqual(state(),original);await find(root,'button','Redo').click();assert.deepEqual(state(),aligned);observations.push({case:'no-op-history',original,aligned});}));
test('overflowing layout displays refusal without replacing input or adding history',()=>harness(async({root,state})=>{const initial=state();await importScene(root,boundary());const before=state();await find(root,'button','Select all').click();await find(root,'button','Align right').click();assert.deepEqual(state(),before);assert.ok(nodes(root).some(n=>n.textContent==='Scene contains an invalid coordinate'));await find(root,'button','Undo').click();assert.deepEqual(state(),initial);await find(root,'button','Redo').click();assert.deepEqual(state(),before);observations.push({case:'atomic-overflow-ui',before});}));
test('native grouped alignment saves and reopens with unknown records preserved through actual handle',()=>harness(async({root,state,store})=>{const doc=nativeDocument([nativeRect('a',10,20,10,20,{groupIds:['inner','outer']}),nativeRect('b',40,40,10,10,{groupIds:['outer']}),nativeRect('c',190,150,20,30),nativeRect('opaque',600,700,1,1,{type:'image',fileId:'ownedOpaque'})]);find(root,'textarea').value=JSON.stringify(doc);await find(root,'button','Import JSON as new scene').click();await find(root,'button','Select all').click();const before=state();await find(root,'button','Align bottom').click();const aligned=state();assert.equal(aligned.shapes[1].y-aligned.shapes[0].y,20);await find(root,'button','Save').click();const saved=(await handle({action:'list',store})).scenes[0],native=(await handle({action:'exportExcalidraw',input:{id:saved.id},store})).document;assert.deepEqual(native.elements[3],doc.elements[3]);assert.deepEqual(native.unknownOwnedDocument,doc.unknownOwnedDocument);assert.deepEqual(native.files,doc.files);await find(root,'button','New scene').click();const picker=find(root,'select');picker.value=saved.id;await picker.event('change');assert.deepEqual(state().shapes,aligned.shapes);observations.push({case:'native-save-reopen',before,aligned,saved,native});}));
test('keyboard alignment and distribution preserve one-step undo with outer groups',()=>harness(async({root,canvas,state})=>{const input=fixture();input.shapes[0].groupIds=['outer'];input.shapes[1].groupIds=['outer'];input.shapes.push(shape('d',400,350,20,30));await importScene(root,input);await find(root,'button','Select all').click();const before=state();await canvas.event('keydown',{ctrlKey:true,shiftKey:true,key:'ArrowDown',code:'ArrowDown'});const aligned=state();assert.equal(aligned.shapes[1].y-aligned.shapes[0].y,80);assert.equal(aligned.shapes[2].y+aligned.shapes[2].h,380);await find(root,'button','Undo').click();assert.deepEqual(state(),before);await find(root,'button','Select all').click();await canvas.event('keydown',{altKey:true,key:'h',code:'KeyH'});const distributed=state();assert.equal(distributed.shapes[1].x-distributed.shapes[0].x,50);assert.equal(distributed.shapes[2].x,240);await find(root,'button','Undo').click();assert.deepEqual(state(),before);observations.push({case:'group-keyboard-undo',before,aligned,distributed});}));
