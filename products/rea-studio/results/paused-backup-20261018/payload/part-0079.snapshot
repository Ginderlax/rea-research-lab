    {
      "id": "grafana.candidate.ff471c2d727cfa1e6ebb",
      "syntaxRole": "table-row",
      "sourceText": "| X Bucket | This setting determines how the x-axis is split into buckets. You can specify a time interval in the **Size** input. For example, a time range of `1h` makes the cells 1-hour wide on the x-axis. You can also set an interval based on **Count**.  |",
      "headingPath": [
        "Heatmap",
        "Configuration options",
        "Heatmap options"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/heatmap/index.md",
        "gitBlobSha": "26f146fc90a96db28152234a4f2b29fa80d22cd2",
        "sha256": "3707c3b75cabf6775b51701a3da3b83509e28b6df092b42f6aad0c341cc47b1a",
