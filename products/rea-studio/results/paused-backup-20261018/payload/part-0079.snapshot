    {
      "id": "grafana.candidate.45719496253c9e51987c",
      "syntaxRole": "table-row",
      "sourceText": "| Fill opacity        | The series area fill color using the **Fill opacity** slider. |",
      "headingPath": [
        "Table",
        "Configuration options",
        "Cell options",
        "Sparkline"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/table/index.md",
