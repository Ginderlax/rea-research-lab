import fs from'node:fs/promises';import path from'node:path';import{fileURLToPath}from'node:url';import{createHash}from'node:crypto';import assert from'node:assert/strict';const own=path.dirname(fileURLToPath(import.meta.url)),workspace=path.resolve(own,'../..'),sha=b=>createHash('sha256').update(b).digest('hex'),before=JSON.parse(await fs.readFile(path.join(own,'source-before.json'),'utf8'));
for(const ref of before.refs){const mb=await fs.readFile(path.join(workspace,ref.path));assert.equal(sha(mb),ref.sha256);const dir=path.dirname(path.join(workspace,ref.path));for(const r of JSON.parse(mb).inventory){const b=await fs.readFile(path.join(dir,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);}}
const prod=JSON.parse(await fs.readFile(path.join(own,'baseline-source.json'),'utf8'));for(const r of prod.files){const b=await fs.readFile(path.join(workspace,r.source));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);assert.ok(b.equals(await fs.readFile(path.join(own,r.destination))));}
const run=JSON.parse(await fs.readFile(path.join(own,'runs/final-focused/run.json'),'utf8'));assert.equal(run.exit.code,0);assert.equal(run.sourceStable,true);const raw=await fs.readFile(path.join(own,'runs/final-focused/stdout.txt'),'utf8'),counts=Object.fromEntries(['tests','pass','fail','skipped'].map(k=>[k,Number(raw.match(new RegExp('ℹ '+k+' (\\d+)'))?.[1])]));assert.deepEqual(counts,{tests:77,pass:77,fail:0,skipped:0});for(const r of run.before){const b=await fs.readFile(path.join(own,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);assert.ok(b.equals(await fs.readFile(path.join(own,'runs/final-focused/source',path.basename(r.path)+'.snapshot'))));}
const changed=run.before.filter(r=>before.files.some(b=>b.path===r.path&&b.sha256!==r.sha256)),added=run.before.filter(r=>!before.files.some(b=>b.path===r.path));assert.deepEqual(changed.map(r=>path.basename(r.path)).sort(),['client.mjs','GROUP-RECYCLE.md'].sort());
const previous=await fs.readFile(path.join(own,'candidate-before/client.mjs.snapshot')),current=await fs.readFile(path.join(own,'products/rea-studio/apps/vault/client.mjs')),blines=previous.toString().split(/(?<=\n)/),alines=current.toString().split(/(?<=\n)/);const get=(list,token)=>{const values=list.filter(l=>l.includes(token));assert.equal(values.length,1);return values[0];};const listAfter=get(alines,'async function list(internal=false)'),index=alines.indexOf(listAfter),transforms=[{before:get(blines,'async function list()'),after:listAfter+alines[index+1]},{before:get(blines,"button(gate,'Search',list); await list();"),after:get(alines,"button(gate,'Search',list); await list(true)")},{before:get(blines,'async function mutate(action,confirmation,permanent)'),after:get(alines,'async function mutate(action,confirmation,permanent)')}];
let inverse=current.toString();for(const t of transforms){assert.equal(inverse.split(t.after).length,2);inverse=inverse.replace(t.after,t.before);}assert.ok(Buffer.from(inverse).equals(previous));await fs.writeFile(path.join(own,'client-transformations.json'),JSON.stringify({schema:'rea-vault-group-active-list-transform/v1',before:{bytes:previous.length,sha256:sha(previous)},after:{bytes:current.length,sha256:sha(current)},changes:transforms,inverseExact:true},null,2)+'\n');
const backend=['server.mjs','recycle.mjs','history.mjs','kdbx.mjs','xml.mjs'];for(const n of backend){const b=before.files.find(r=>r.path.endsWith('/'+n));assert.equal(sha(await fs.readFile(path.join(own,b.path))),b.sha256);}
const census=[];for(const n of run.tests){const b=await fs.readFile(path.join(own,'products/rea-studio/apps/vault',n)),staticCalls=(b.toString().match(/\btest\s*\(/g)||[]).length,extra=['recycle-boundaries.test.mjs','recycle-controls.test.mjs','group-coherence-replay.test.mjs'].includes(n)?1:0;census.push({name:n,staticCalls,parameterizedExtra:extra,tests:staticCalls+extra,bytes:b.length,sha256:sha(b)});}assert.equal(census.reduce((n,r)=>n+r.tests,0),77);
const parent=JSON.parse(await fs.readFile(path.join(own,'references/initial456/validation.json.snapshot'),'utf8')),receipt={schema:'rea-keepass-group-active-list-correction-validation/v1',at:new Date().toISOString(),refs:before.refs,refsStableBeforeAfter:true,counts,sourceStable:true,sourceFiles:run.before.length,implementationFingerprints:run.before,changedExisting:changed,addedSourceFiles:added,census,productionBaselineFiles:prod.files.length,productionBaselineUnchanged:true,finalRun:'runs/final-focused/run.json',finalRunSHA256:sha(await fs.readFile(path.join(own,'runs/final-focused/run.json'))),collector:run.collector,clientInverseExact:true,clientTransformations:'client-transformations.json',backendFiveUnchanged:backend,exactRootReplay:{cases:6,adapters:'root-test-adapter.json',semanticBodyChanges:0},newFreshControls:3,originalHistorical:parent.historicalOriginal,currentExecutions:{originalManagedLoads:0,originalGUI:0,originalProgram:0,browser:0,HTTPHost:0,benchmark:0},installationProposal:'installation-proposal.json',scope:'Confirmed effect invalidates+clears active list; external Search refuses before IO during effect; known postcommit/initial-view reads use internal path. Failed write permits explicit Search and fresh reconfirmed retry. Previous456/initial777/negative evidence immutable. No original GUI semantics or process isolation claim.',remainingGaps:parent.limits,acceptance:{authorFinite:true,independent:false,production:false,fullParity:false,superiority:false},cleanup:{childExit:0,ownedProcessesFinished:true,hostsStarted:0,browserTabsOpened:0,user4311Touched:false},repoWrites:0,registryWrites:0};await fs.writeFile(path.join(own,'validation.json'),JSON.stringify(receipt,null,2)+'\n');
const inventory=[];async function walk(dir,prefix=''){for(const e of(await fs.readdir(dir,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){const p=prefix?prefix+'/'+e.name:e.name;if(e.name==='.local'||p==='manifest.json'||p==='freeze.json')continue;if(e.isDirectory())await walk(path.join(dir,e.name),p);else{const b=await fs.readFile(path.join(dir,e.name));assert(!/\.(?:exe|dll|zip|7z|kdbx|tar|gz|zst)$/i.test(p));assert(!b.subarray(0,2).equals(Buffer.from('MZ'))&&!b.subarray(0,2).equals(Buffer.from('PK')));inventory.push({path:p,bytes:b.length,sha256:sha(b)});}}}await walk(own);const mb=Buffer.from(JSON.stringify({schema:'rea-keepass-group-active-list-strict-preservation/v1',inventory,files:inventory.length,pathsAreStrict:true,excluded:['.local/**','manifest.json','freeze.json'],recursiveHistoryCopy:false,originalCarrierBytesCopied:false},null,2)+'\n');await fs.writeFile(path.join(own,'manifest.json'),mb);const vb=await fs.readFile(path.join(own,'validation.json')),frozen={schema:'rea-keepass-group-active-list-freeze/v1',at:new Date().toISOString(),manifest:{path:'manifest.json',bytes:mb.length,sha256:sha(mb),records:inventory.length},validation:{path:'validation.json',bytes:vb.length,sha256:sha(vb)},client:{path:'products/rea-studio/apps/vault/client.mjs',bytes:current.length,sha256:sha(current)},sourceFrozen:true,independentAcceptancePending:true};await fs.writeFile(path.join(own,'freeze.json'),JSON.stringify(frozen,null,2)+'\n');console.log(JSON.stringify(frozen));
