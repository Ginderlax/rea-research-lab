async function recordEditor(label){const state=await editorReviewTab.getAXState({emit:false});const visible=await editorReviewTab.playwright.evaluate(()=>{const field=document.querySelector('textarea[aria-label="File contents"]');return {url:location.href,editor:field?{value:field.value,disabled:field.disabled,selectionStart:field.selectionStart,selectionEnd:field.selectionEnd}:null,statuses:Array.from(document.querySelectorAll('[role="status"]')).map(n=>n.textContent),tabs:Array.from(document.querySelectorAll('button[aria-pressed]')).map(n=>({text:n.textContent,pressed:n.getAttribute('aria-pressed')})),saveEnabled:Array.from(document.querySelectorAll('button')).find(n=>n.textContent==='Save file')?.disabled===false};});const row={label,at:new Date().toISOString(),state,visible};editorBrowserSteps.push(row);await notesFs.writeFile(editorBrowserFolder+'browser-steps.json',JSON.stringify(editorBrowserSteps,null,2)+'\n');nodeRepl.write(state);nodeRepl.write(visible);}
