    {
      "id": "grafana.candidate.7a944af151140a175c83",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "[Auditing](../../configure-security/audit-grafana/) allows you to track important changes to your Grafana instance. By default, audit logs are logged to file but the auditing feature also supports sending logs directly to Loki.",
      "headingPath": [
