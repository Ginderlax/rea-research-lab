    {
      "id": "grafana.candidate.5f9d2d36b9c617af787a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana reads its default configuration from `<WORKING DIRECTORY>/conf/defaults.ini`.",
      "headingPath": [
        "Provision Grafana",
        "Configuration file",
        "Configuration file locations"
      ],
      "source": {
