    },
    {
      "id": "grafana.candidate.2ba6c965f1eeef0d525f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The `basic_editor` and `basic_viewer` roles often include:",
      "headingPath": [
        "Role-based access control (RBAC) overview",
        "New permissions",
        "Stop automatic access to new features"
      ],
      "source": {
