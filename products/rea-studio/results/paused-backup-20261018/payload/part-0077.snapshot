    {
      "id": "grafana.candidate.176c970578604e1bae9e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "**Image rendering:** run a dedicated renderer fleet with multiple workers, isolated from Grafana instances. Each renderer worker uses approximately 1 GB of memory. Refer to [Set up image rendering](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/setup-grafana/image-rendering/).",
      "headingPath": [
        "Install Grafana",
