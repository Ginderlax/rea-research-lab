        "sha256": "b2ee34090eb03b41b5a98cc5e30a4f89026d2d107741ed9b6c5d1018e0b81df2",
        "lineStart": 130,
        "lineEnd": 130,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/alerting/fundamentals/alert-rule-evaluation/nodata-and-error-states.md#L130-L130"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.dd5ca800b6f01d0a462d",
      "syntaxRole": "list-item",
      "sourceText": "- `alertname`: Either `DatasourceNoData` or `DatasourceError` depending on the state.",
      "headingPath": [
        "No Data and Error states",
