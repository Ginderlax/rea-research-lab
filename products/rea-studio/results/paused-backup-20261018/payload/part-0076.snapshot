    {
      "id": "grafana.candidate.1f8dda9eb99f7affe553",
      "syntaxRole": "list-item",
      "sourceText": "- **No fill mode in alerts:** The fill parameter in `$__timeGroup` (for example, `$__timeGroup(col, '5m', 0)`) isn't applied during alert evaluation. Missing data points remain as gaps.",
      "headingPath": [
        "PostgreSQL alerting",
        "Limitations"
      ],
      "source": {
