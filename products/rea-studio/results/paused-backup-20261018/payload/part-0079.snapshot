    {
      "id": "grafana.candidate.1b752e7b8e54ef0af25e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "We've also made it easier to find the correct dashboard variable by displaying available variables in the fields that support them, either in the drop-down or as a suggestion when you type **$** or press Ctrl + Space.",
      "headingPath": [
