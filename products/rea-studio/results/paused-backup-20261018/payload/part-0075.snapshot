    },
    {
      "id": "grafana.candidate.bc3d373a466c2c2f0692",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Each notification policy decides where to send the alert (contact point) and when to send the notification (timing options).",
      "headingPath": [
