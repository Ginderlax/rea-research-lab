    {
      "id": "grafana.candidate.3adc2e9d4b7ed3587df7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "While public addresses are always allowed, to prevent server-side request forgery (SSRF), repository URLs that resolve to loopback, private (RFC 1918), link-local, or unspecified addresses are rejected by default.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
