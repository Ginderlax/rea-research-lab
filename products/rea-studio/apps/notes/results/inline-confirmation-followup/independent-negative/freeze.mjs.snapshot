import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const here=import.meta.dirname,sha=b=>createHash('sha256').update(b).digest('hex'),inventory={};async function walk(base,prefix=''){for(const e of (await fs.readdir(base,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){assert(!e.isSymbolicLink());const rel=prefix+e.name;if(e.isDirectory())await walk(path.join(base,e.name),rel+'/');else{assert.notEqual(rel,'review-manifest.json');const b=await fs.readFile(path.join(base,e.name));inventory[rel]={bytes:b.length,sha256:sha(b)};}}}await walk(here);const receipt=await fs.readFile(path.join(here,'review-validation.json')),manifest={schema:'rea-notes-inline-confirmation-independent-freeze/v1',at:new Date().toISOString(),files:Object.keys(inventory).length,totalBytes:Object.values(inventory).reduce((n,r)=>n+r.bytes,0),receiptSHA256:sha(receipt),inventory,strict:true,selfExcluded:true,independentAcceptance:false};const b=Buffer.from(JSON.stringify(manifest,null,2)+'\n');await fs.writeFile(path.join(here,'review-manifest.json'),b,{flag:'wx'});for(const[p,r]of Object.entries(inventory)){const current=await fs.readFile(path.join(here,p));assert.deepEqual({bytes:current.length,sha256:sha(current)},r);}console.log(JSON.stringify({files:manifest.files,receiptSHA256:sha(receipt),manifestSHA256:sha(b),acceptance:false}));
