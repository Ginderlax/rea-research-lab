    {
      "id": "grafana.candidate.f276143e7442b3b74aaf",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "After you have configured your Elasticsearch data source options, click **Save & test** to test the connection. A successful connection displays the following message:",
