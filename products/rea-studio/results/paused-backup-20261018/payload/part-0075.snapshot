    {
      "id": "grafana.candidate.9f7aba2a329a98a3fcb3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "This query uses `order by` to sort the properties by the `name` property in ascending (`asc`) order. You can change which property to sort by and the order (`asc` or `desc`). This query uses `project` to show only the listed properties in the results. You can use this to add or remove properties in your queries.",
      "headingPath": [
        "Azure Monitor query editor",
