        "lineStart": 66,
        "lineEnd": 66,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/prometheus/configure/_index.md#L66-L66"
      },
      "applicability": {
