    {
      "id": "grafana.candidate.129a395dcc5d4340b7ca",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The Tempo data source supports streaming responses to TraceQL queries so you can see partial query results as they come in without waiting for the whole query to finish.",
      "headingPath": [
        "Write TraceQL queries using Search",
        "Run queries and view results",
        "Stream results"
      ],
      "source": {
        "path": "docs/sources/shared/datasources/tempo-search-traceql.md",
