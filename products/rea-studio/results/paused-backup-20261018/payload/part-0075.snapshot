    {
      "id": "grafana.candidate.c7d2cf573610ed43c0c6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Amazon CloudWatch is the AWS native monitoring and observability service that collects, aggregates, and stores metrics, logs, and events from AWS resources, applications, and services. CloudWatch enables you to visualize performance data, track system health, and set up automated alerts based on defined thresholds. The Amazon CloudWatch data source in Grafana extends these capabilities by allowing you to query CloudWatch data and create rich, interactive visualizations that can be correlated with data from other systems within unified dashboards.",
      "headingPath": [
        "Amazon CloudWatch data source"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/_index.md",
        "gitBlobSha": "4070ab100d9ddd86a3cb83208e426f7d3a1510cb",
