import fs from'node:fs/promises';import path from'node:path';import{fileURLToPath}from'node:url';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const here=fileURLToPath(new URL('./',import.meta.url)),workspace=fileURLToPath(new URL('../../',import.meta.url)),repo=path.join(workspace,'outputs/rea-research-lab'),app='products/rea-studio/apps/vault/',sha=b=>createHash('sha256').update(b).digest('hex');const map=JSON.parse(await fs.readFile(path.join(here,'selected-file-map.final.json'))),contracts=JSON.parse(await fs.readFile(path.join(workspace,'work/keepass-recycle-next/contract-evidence.json'))),provenance=JSON.parse(await fs.readFile(path.join(workspace,'work/keepass-recycle-next/source-provenance.json')));
const link=(epoch,source)=>{const row=map.payload.find(r=>r.epoch===epoch&&r.sourcePath===source);assert(row?.publicPath,source);return path.posix.relative(app,row.publicPath);};const write=async(n,t)=>fs.writeFile(path.join(here,n),t,{flag:'wx'});await fs.mkdir(path.join(here,'proposed-docs'),{recursive:true});
const contractRows=contracts.contracts.map(c=>{const src=provenance.files.find(s=>s.upstreamPath===c.source);assert(src);return`| ${c.id} | [${c.source}](${link('recycle-stage',src.path)}) ${c.lineStart}–${c.lineEnd} | ${c.meaning} |`;}).join('\n');
const epochRows=map.epochs.map(e=>`| ${e.id} | ${e.count} | [receipt](${link(e.id,e.receiptName)}) \`${e.receipt.sha256}\` | [exact manifest](${link(e.id,e.manifestName)}) \`${e.manifest.sha256}\` |`).join('\n');
await write('proposed-docs/RECYCLE.md',`# Vault entry recycle and recovery\n\nThis source-assisted bounded slice implements single-entry native recycling, read-only masked bin preview, recovery to an existing previous parent group and confirmed permanent deletion. It is a partial KeePass2.61.1 contract. Application actions execute native JavaScript; they do not launch KeePass or import the original assembly.\n\nNormal Delete moves the complete entry to the UUID-designated bin when recycling is enabled. New local vaults enable recycling by default. Imported native settings are honored: disabled recycling, an entry already inside the bin or its descendants, or an explicit permanent choice removes the entry and records its native UUID/time tombstone. A missing bin is created beneath the root with trash icon43, searching/Auto-Type disabled and expanded state. Recovery requires an existing, different previous parent outside the bin. UUID, represented content, protected flags, history, attachment references and unknown native XML are retained. Delete updates access/usage without adding a history revision; recovery updates placement/location and records the old bin as the new previous parent.\n\nThe active list excludes bin entries. Editing, history and TOTP actions reject bin entries. Show bin exposes a separate private preview which begins masked. Recovery and permanent purge require confirmation. New recycle commands require a private-key/whole-native-graph-bound revision; represented database, attachment or key changes invalidate it. The legacy confirmed ID-only \`delete\` alias remains accepted without stale-selection protection. These guards are Studio policies, not claims about an original KeePass API.\n\nClient publication checks view and bin generations after awaited active-list refresh. Closing/reopening the bin or choosing a new preview prevents an older mutation refresh from reopening it or clearing that preview. Existing dirty-editor, enabled-field pending-draft, selection, lock and disposal safeguards remain in place. The exact correction comprises two post-list \`viewCurrent()\`→\`binCurrent()\` checks; backend source bytes are unchanged from the original recycle candidate.\n\n## Released behavior and deliberate limits\n\nThe independent oracle is the exact KeePass2.61.1 portable assembly SHA256 \`04d29636c393f0c1fc99ff739295494be3adefded93271e44591e8e300225a5a\`. The source carrier is5,333,853 bytes with SHA256 \`711bd9ec7076661678469e51bae876debac07a08c32f1b1c6b3b8fe5e761c13a\`; its1381-entry census and16 selected source/license files are retained as finite provenance. Publisher digest matching was recorded; OpenPGP signature verification is not claimed. See [RECYCLE-NOTICE.md](RECYCLE-NOTICE.md).\n\nThe released writer chooses KDBX4.0 for the default tested feature set and omits PreviousParentGroup on save/reopen. The lifecycle oracle uses a real QualityCheck=false feature to select4.1; candidate4.1 exports retain the previous-parent reference and the original4.1 reader reads it. A later original save without a4.1-only feature can downgrade and lose the reference again. The default4.0 loss fixture remains separate; conditional4.1 equality must not be reported as default-release lifecycle equality.\n\nDelete/restore orchestration and fixed clock assignments in the comparison are composed from authenticated released source. The actual library performs database New/Open/Save, collection removal/AddEntry, CreateBackup/Touch, tombstone construction and the private static EnsureRecycleBin helper in finite fixtures. Original GUI handlers execute0 times. Exact original wall-clock/event/dialog behavior is not established. The unused bin expiry differs: released construction uses process-global PwDefs.DtDefaultNow, candidate construction uses the operation clock; Expires=false in both. Raw unadapted expiry observations are retained.\n\nThe slice bounds preserved XML plus attachment base64 text at8MiB; entries, groups and tombstones at10,000 each; XML nodes at100,000; XML depth64 and group depth63. It checks capacity before bin creation, uses uint64 usage arithmetic and accepts strict UTC clocks in years0001–9999 with seconds or three fractional digits. Incoming API data is privately captured before queued awaits with12MiB text/key bytes,100,000 nodes and depth64. Existing KDBX/KDF bounds apply. These are accepted input bounds, not process-memory isolation or preemption of blocked I/O.\n\nGroup deletion/recovery, whole-bin emptying, multiple selected entries, arbitrary group movement, bin settings/localization/collapse configuration and general previous-group recovery outside the bin remain absent. Root-as-bin malformed metadata is rejected. Full XML/schema validation, synchronization, broader history deletion/age policies, expiration workflows, Auto-Type, providers and other manual/product contracts remain open. Full compatibility, full product parity, security parity and superiority are unestablished.\n\n## Separate evidence epochs\n\nThe previously accepted current-layout history campaign remains41 focused groups and24 original assembly loads. Its sources/receipt stay historical. Original recycle author68 groups comprise prior41 plus new27 (12 native,5 server,4 DOM,2 HTTP,4 original groups);38 assembly loads comprise prior24 plus new14. That campaign used the older client. The initial independent review has11 groups:8 passed and3 confirmed stale bin publication failures, plus4 additional original library executions and one normal private browser acceptance. Those failures are preserved.\n\nThe two-guard correction author campaign passes38 frontend groups with0 original/HTTP/browser executions. A failed same-generation preview diagnostic had an invalid stale-token premise; raw/source records remain, with a passing explicit stale-token control. It is not another confirmed application defect. The final independent review passes the unchanged five boundary bodies plus two unchecked-confirmation controls (7/7), and one normal private-browser recovery/history/lock/restart acceptance; original executions in this campaign are0. Counts from these epochs must not be added as one unique corpus or rebound to new production bytes.\n\n| Epoch | Manifest entries | Receipt | Manifest |\n| --- | ---: | --- | --- |\n${epochRows}\n\nPublication maps858 historical path records (850 manifest entries plus8 manifest/freeze objects) to471 unique public byte objects, with one synthetic1911-byte KDBX carrier retained locally by digest.27 public objects can reuse existing exact history snapshots, leaving444 new inert blobs. Original exact manifests and all negative raw/source records remain intact via explicit path→blob maps; no recursive history recopy is required. Public paths contain no .local segment. Raw records intentionally retain synthetic test passwords and local Windows username/path metadata; the source author copyright email is vendor attribution. No claim of universal secret/personal-data absence is made.\n\n## Reproduce the proposed current-layout selection\n\nAfter root installs the reviewed sources and path-only adapters, the prospective selection is79 groups: retained history41 + new recycle27 + boundary5 + confirmation2 + controls4. This publication plan has not executed that selection. Root must record the actual current-source result, real UI acceptance and shared suite separately. Existing legacy app/KDBX tests remain additional regression coverage.\n\nUse Windows, Node24.16.0, Windows PowerShell/.NET and the authenticated local KeePass2.61.1 assembly. REA_KEEPASS_EXE overrides the default repository-local acquisition path. The test-only helper checks the release before process launch and assembly load; the runtime never uses it. All files/passwords are owned synthetic fixtures. Adapted tests write detailed observations only to Studio .local or owned temporary directories; future test runs must not mutate apps/results. Child output is bounded1MiB and ordinary child deadline30 seconds, with5-second host cleanup. Descendant isolation and hard fingerprint-I/O preemption are not claimed.\n`);
const license=provenance.files.find(r=>r.upstreamPath==='Docs/License.txt');await write('proposed-docs/RECYCLE-NOTICE.md',`# Recycle source and license notice\n\nThe bounded entry recycle/history implementation is source-assisted by KeePass2.61.1, Copyright Dominik Reichl and the KeePass contributors, GPL-2.0-or-later. Existing runtime/source copyright notices remain intact. No upstream executable/DLL is an application dependency.\n\nThe [exact released GPL license](${link('recycle-stage',license.path)}) is18,710 bytes, SHA256 \`${license.sha256}\`. The [source provenance](${link('recycle-stage','source-provenance.json')}) binds16 full selected files and [contract spans](${link('recycle-stage','contract-evidence.json')}) bind12 selective study contracts from source ZIP SHA256 \`${provenance.archive.sha256}\`. These selective contracts do not replace the complete manual inventory or close its gaps.\n\n| Contract | Exact released source and lines | Studied behavior |\n| --- | --- | --- |\n${contractRows}\n\nThe source-composed oracle and deterministic clock adaptation are test scaffolding. Finite actual released library/helper executions are reported separately from source-only study and GUI executions0. The original executable and full source archive remain local acquisition artifacts. Public source snapshots keep their complete attribution/license bytes and are inert.\n`);
const original=await fs.readFile(path.join(repo,app+'README.md'),'utf8');let current=original;const transforms=[['- Entry creation, editing and confirmed deletion;', '- Entry creation, editing and confirmed native recycling/permanent deletion;'],['history comparison/deletion/settings/age cleanup and recycle-bin recovery;', 'history comparison/deletion/settings/age cleanup; group recycling/recovery and whole-bin emptying;']];for(const[from,to]of transforms){assert(current.includes(from));current=current.replace(from,to);}current+='\n\n## Entry recycle and previous-group recovery\n\nNormal confirmed Delete moves an entry to its native UUID-designated recycle bin when enabled; new vaults enable recycling by default. Show bin offers a separate masked preview, confirmed recovery to an existing previous group and permanent purge with native tombstones. Imported disabled recycling and entries already in the bin take the permanent path. Content, UUID, history, attachments and unknown native XML remain represented. Generation guards prevent an older refresh reopening a closed/newer bin or clearing its preview.\n\n[RECYCLE.md](RECYCLE.md) describes exact bounds, release-specific KDBX4.0 previous-parent loss versus conditional4.1 interoperability, legacy ID-only alias limits, original execution boundaries and retained negative results. [RECYCLE-NOTICE.md](RECYCLE-NOTICE.md) binds the source-assisted GPL provenance. The pre-recycle41 history and author68/38-original-load epochs remain historical; final frontend38 and independent7/browser1 are separate. Root will add current production-source results after installation; this proposal makes no new behavioral pass claim. Group recovery, empty bin, multi-selection and complete KeePass parity remain open.\n';
await write('proposed-docs/README.md',current);await write('README-supplement.md',`# Proposed README supplement\n\nThis is an exact reviewable proposal against current README SHA256 \`${sha(original)}\`. Root should apply the prepared proposed-docs/README.md after checking that baseline; no production bytes changed here.\n\nTwo existing sentences are edited:\n\n${transforms.map(([a,b])=>'- Replace '+JSON.stringify(a)+' with '+JSON.stringify(b)+'.').join('\n')}\n\nThe final Entry recycle and previous-group recovery section is appended, linking RECYCLE.md and RECYCLE-NOTICE.md. Existing history41 evidence and current history manifest paragraph, including its corrected12 local source ZIP carriers, remain exact. Proposed group count79 is prospective and must be replaced/appended by root only after actual source-bound verification.\n`);
const docs=map.docs.map(row=>{const source=row.source==='README-supplement.md'?'proposed-docs/README.md':row.source;return{...row,source,proposalOnly:true,bytes:Buffer.byteLength(source.endsWith('/README.md')?current:await fs.readFile(path.join(here,source),'utf8')),sha256:sha(await fs.readFile(path.join(here,source))),transforms:source.endsWith('/README.md')?transforms:undefined};});await write('documentation-map.json',{schema:'rea-vault-recycle-proposed-documentation-map/v1',docs,publicationPathsWillResolveAfterMappedPayloadInstalled:true,productionModified:false});
console.log(JSON.stringify({docs:docs.map(d=>({path:d.source,sha256:d.sha256})),contracts:contracts.contractCount,originalSourceFiles:provenance.selectedUniqueFileCount,testsExecuted:false}));
