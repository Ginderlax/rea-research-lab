    },
    {
      "id": "grafana.candidate.8292a3de4d6972444b3a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If `validate_id_token` is set to `true`, you must configure `jwk_set_url`. Authentication will fail if the JWK Set URL is not provided or if the ID token signature cannot be verified.",
      "headingPath": [
        "Configure Generic OAuth authentication",
        "Configure generic OAuth authentication client using the Grafana configuration file",
        "Configure JWT ID token validation"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/generic-oauth/index.md",
        "gitBlobSha": "996494cdc76551860001d5497ab4650b4563badf",
        "sha256": "93bacfb30c084c7dd0e225675e875cd091c4a0ef7a5053c330ccb6c9cd367d87",
        "lineStart": 251,
        "lineEnd": 251,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/generic-oauth/index.md#L251-L251"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.3d67c0cff79630066b82",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Unless `skip_org_role_sync` option is enabled, the user's role will be set to the role retrieved from the auth provider upon user login.",
      "headingPath": [
        "Configure Generic OAuth authentication",
        "Configure generic OAuth authentication client using the Grafana configuration file",
        "Configure role mapping"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/generic-oauth/index.md",
        "gitBlobSha": "996494cdc76551860001d5497ab4650b4563badf",
        "sha256": "93bacfb30c084c7dd0e225675e875cd091c4a0ef7a5053c330ccb6c9cd367d87",
        "lineStart": 256,
        "lineEnd": 256,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/generic-oauth/index.md#L256-L256"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.1dd73070cab089e32e53",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The user's role is retrieved using a [JMESPath](http://jmespath.org/examples.html) expression from the `role_attribute_path` configuration option. Grafana will first evaluate the expression using the OAuth2 ID token. If no role is found, the expression will be evaluated using the user information obtained from the UserInfo endpoint. If still no role is found, the expression will be evaluated using the OAuth2 access token. To map the server administrator role, use the `allow_assign_grafana_admin` configuration option. Refer to [configuration options](#configuration-options) for more information.",
      "headingPath": [
        "Configure Generic OAuth authentication",
        "Configure generic OAuth authentication client using the Grafana configuration file",
        "Configure role mapping"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/generic-oauth/index.md",
        "gitBlobSha": "996494cdc76551860001d5497ab4650b4563badf",
        "sha256": "93bacfb30c084c7dd0e225675e875cd091c4a0ef7a5053c330ccb6c9cd367d87",
        "lineStart": 258,
        "lineEnd": 261,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/generic-oauth/index.md#L258-L261"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.cd8a05b1e395b8632114",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If no valid role is found, the user is assigned the role specified by [the `auto_assign_org_role` option](../../../configure-grafana/#auto_assign_org_role). You can disable this default role assignment by setting `role_attribute_strict = true`. This setting denies user access if no role or an invalid role is returned after evaluating the `role_attribute_path` and the `org_mapping` expressions.",
      "headingPath": [
        "Configure Generic OAuth authentication",
        "Configure generic OAuth authentication client using the Grafana configuration file",
        "Configure role mapping"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/generic-oauth/index.md",
        "gitBlobSha": "996494cdc76551860001d5497ab4650b4563badf",
        "sha256": "93bacfb30c084c7dd0e225675e875cd091c4a0ef7a5053c330ccb6c9cd367d87",
        "lineStart": 263,
        "lineEnd": 264,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/generic-oauth/index.md#L263-L264"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.1928f231403a5fd12127",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can use the `org_attribute_path` and `org_mapping` configuration options to assign the user to organizations and specify their role. For more information, refer to [Org roles mapping example](#org-roles-mapping-example). If both org role mapping (`org_mapping`) and the regular role mapping (`role_attribute_path`) are specified, then the user will get the highest of the two mapped roles.",
      "headingPath": [
        "Configure Generic OAuth authentication",
        "Configure generic OAuth authentication client using the Grafana configuration file",
        "Configure role mapping"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/generic-oauth/index.md",
        "gitBlobSha": "996494cdc76551860001d5497ab4650b4563badf",
        "sha256": "93bacfb30c084c7dd0e225675e875cd091c4a0ef7a5053c330ccb6c9cd367d87",
        "lineStart": 266,
        "lineEnd": 266,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/generic-oauth/index.md#L266-L266"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.df3d9ac5b7b231661569",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When using `org_attribute_path`, the value returned by the JMESPath expression must be an array, not a string.",
      "headingPath": [
        "Configure Generic OAuth authentication",
        "Configure generic OAuth authentication client using the Grafana configuration file",
        "Configure role mapping"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-access/configure-authentication/generic-oauth/index.md",
        "gitBlobSha": "996494cdc76551860001d5497ab4650b4563badf",
        "sha256": "93bacfb30c084c7dd0e225675e875cd091c4a0ef7a5053c330ccb6c9cd367d87",
        "lineStart": 271,
        "lineEnd": 271,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-access/configure-authentication/generic-oauth/index.md#L271-L271"
      },
