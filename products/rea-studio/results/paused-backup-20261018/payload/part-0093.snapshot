def projected(value,phase):
 need(value['status']=='passed' and phase['status']=='passed' and phase['exitCode']==0 and phase['signal'] is None and phase['closeObserved'] is True and phase['failure'] is None and phase['droppedBytes']==0,'Passed complete original root phase')
