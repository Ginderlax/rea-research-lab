    {
      "id": "grafana.candidate.dae425e9625e2548bfff",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The interval between sending gossip messages. By lowering this value (more frequent) gossip messages are propagated across cluster more quickly at the expense of increased bandwidth usage. The default value is `200ms`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[unified_alerting]`",
        "`ha_gossip_interval`"
      ],
      "source": {
