    },
    {
      "id": "grafana.candidate.8b4c5ae8a4746feb03fe",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When using multi-value variables in tag queries, append `${var:regex}` to the variable name to apply regex formatting.",
      "headingPath": [
        "Graphite template variables",
        "Use tag variables",
        "Filter with multiple expressions"
      ],
      "source": {
        "path": "docs/sources/datasources/graphite/template-variables/index.md",
