    {
      "id": "grafana.candidate.a26960f2d1c90d035eda",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The current alerting system doesn't support high availability. Alert notifications are not deduplicated and load balancing is not supported between instances; for example, silences from one instance will not appear in the other.",
      "headingPath": [
        "Clustering"
      ],
      "source": {
