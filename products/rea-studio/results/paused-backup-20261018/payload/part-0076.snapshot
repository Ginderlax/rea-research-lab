    {
      "id": "grafana.candidate.543a1602b64c493658d8",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The standalone plugin requires Grafana 12.3.0 or later. The Jaeger data source bundled with Grafana 12.2 and earlier continues to work as before. These versions are unaffected by the change.",
      "headingPath": [
        "Jaeger data source",
        "Plugin updates"
      ],
      "source": {
        "path": "docs/sources/datasources/jaeger/_index.md",
