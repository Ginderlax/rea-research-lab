    {
      "id": "grafana.candidate.135bdc4105d311cb0ca0",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Name of the header that carries the real client IP, used to key per-client rate limiting on the webhook endpoint. When empty, rate-limiter keys on the real TCP peer address.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[provisioning]`",
        "`webhook_trusted_ip_header`"
