    {
      "id": "grafana.candidate.c3de5d8d4162a4d79ebf",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To enable this feature, you must first enable the `canvasPanelPanZoom` [feature toggle](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-grafana/feature-toggles/).",
      "headingPath": [
        "What’s new in Grafana v10.3",
