// Exact hosted source experiment. This composer performs no product execution.
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import { createHash } from 'node:crypto';
import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
export const repository=path.resolve(fileURLToPath(new URL('../../../',import.meta.url)));
export const studio=path.join(repository,'products/rea-studio');
const self='products/rea-studio/scripts/compose-notes-new-todo-cloud.mjs';
const bundleSource={path:'products/rea-studio/experiments/notes-new-todo/bundle.json',bytes:30920,sha256:'65d14eab3dab5a7952963689ec7b4af7d269cb0e2b099ce0fc48194a11a98bd6'};
const authorityPin={bytes:7958,sha256:'f34bc8608b1661202c11acf42f531051706b1c29b24db155945766cae841be64'};
const peerPin={bytes:9942,sha256:'94069513adb32e1bb98b4b2eee4b28c47fd1ccf5fcb0a64f9011c81fef940379'};
export const sourceLimits={files:2000,fileBytes:8*1024*1024,totalBytes:64*1024*1024,depth:128};
export const identity=bytes=>({bytes:bytes.length,sha256:createHash('sha256').update(bytes).digest('hex')});
const pin=row=>({bytes:row.bytes,sha256:row.sha256});
export const execution=()=>Object.fromEntries(['CI','GITHUB_ACTIONS','RUNNER_ENVIRONMENT','RUNNER_OS','RUNNER_ARCH','GITHUB_SHA','GITHUB_RUN_ID','GITHUB_RUN_ATTEMPT','GITHUB_REPOSITORY'].map(name=>[name,process.env[name]??null]));
export function safe(name){assert(typeof name==='string'&&name&&name.length<4096&&!/[\\:\x00-\x1f\x7f]/.test(name)&&!name.startsWith('/')&&name.split('/').every(p=>p&&p!=='.'&&p!=='..'));return name;}
export function git(args,maxBuffer=32*1024*1024){const result=spawnSync('git',args,{cwd:repository,windowsHide:true,shell:false,timeout:30000,maxBuffer});assert.equal(result.error,undefined);assert.equal(result.status,0);return result.stdout;}
export function readSource(name,maxBytes=8*1024*1024){let at=repository;for(const part of safe(name).split('/')){at=path.join(at,part);assert(!fs.lstatSync(at).isSymbolicLink());}const item=fs.lstatSync(at);assert(item.isFile()&&item.size<=maxBytes);const bytes=fs.readFileSync(at);assert.equal(bytes.length,item.size);return bytes;}
export function gitSource(name){const bytes=readSource(name);assert.deepEqual(bytes,git(['show','HEAD:'+safe(name)]));return bytes;}
export function gitStatus(){return git(['status','--porcelain=v1','-z','--untracked-files=all']).toString('utf8').split('\0').filter(Boolean).map(row=>({status:row.slice(0,2),path:row.slice(3)})).sort((a,b)=>a.path.localeCompare(b.path));}
export function assertHosted(){assert.equal(process.platform,'win32');assert.equal(process.version,'v24.16.0');assert.equal(process.env.CI,'true');assert.equal(process.env.GITHUB_ACTIONS,'true');assert.equal(process.env.RUNNER_ENVIRONMENT,'github-hosted');assert.equal(process.env.RUNNER_OS,'Windows');assert.equal(process.env.RUNNER_ARCH,'X64');assert.equal(process.env.GITHUB_REPOSITORY,'Ginderlax/rea-research-lab');for(const name of ['GITHUB_SHA','GITHUB_RUN_ID','GITHUB_RUN_ATTEMPT','RUNNER_TEMP'])assert(process.env[name]);assert.equal(git(['rev-parse','HEAD']).toString('utf8').trim(),process.env.GITHUB_SHA);assert.equal(git(['rev-parse','--show-object-format']).toString('utf8').trim(),'sha1');assert.equal(path.resolve(fileURLToPath(import.meta.url)),path.join(repository,self));gitSource(self);}
export function ownedEvidence(value){assert(path.isAbsolute(value));const temporary=fs.realpathSync(process.env.RUNNER_TEMP),root=fs.realpathSync(value),relative=path.relative(temporary,root);assert(relative&&relative!=='..'&&!relative.startsWith('..'+path.sep)&&!path.isAbsolute(relative));assert.equal(root.toLowerCase(),path.resolve(value).toLowerCase());assert(!fs.lstatSync(root).isSymbolicLink());return root;}
export function evidenceBytes(root,name){const filename=path.join(root,safe(name));assert(!fs.lstatSync(filename).isSymbolicLink());const item=fs.lstatSync(filename);assert(item.isFile()&&item.size<=8*1024*1024);return fs.readFileSync(filename);}
export function saveBytes(root,name,bytes){const filename=path.join(root,safe(name));fs.mkdirSync(path.dirname(filename),{recursive:true});fs.writeFileSync(filename,bytes,{flag:'wx'});}
export function saveJSON(root,name,value){saveBytes(root,name,Buffer.from(JSON.stringify(value,null,2)+'\n'));}
export function bundle(){const bytes=gitSource(bundleSource.path);assert.deepEqual(identity(bytes),pin(bundleSource));const value=JSON.parse(bytes);assert.equal(value.schema,'rea-Notes-new-to-do-cloud-source-bundle/v1');assert.equal(value.productionInstalled,false);assert.equal(value.historicalReceiptsRebound,false);assert.deepEqual(value.featureAuthority,authorityPin);assert.deepEqual(value.featureIndependentPeer,peerPin);assert.equal(value.transitions.length,7);assert.equal(value.payloads.length,17);assert.equal(value.baselineNotesSources.length,32);assert.equal(value.composedNotesSources.length,36);assert.equal(value.fixedTests.length,21);assert.equal(value.plannedGroups,111);assert.equal(value.oldNamedGroupsRequired.length,23);assert.equal(value.newNamedGroupsRequired.length,19);assert.deepEqual(value.separateComparisonCounts,{existingConversionAndCompletion:20,newParentAndType:4,newDesktopCommandArguments:2,addedToTestGroupCounts:false});assert.equal(value.composerProofReadPaths,60);assert.equal(value.composerProofReadFileLimit,64);assert.equal(value.composerProofReadByteLimit,8*1024*1024);return value;}
function noteFiles(directory,depth=0){assert(depth<=32);assert(fs.lstatSync(directory).isDirectory()&&!fs.lstatSync(directory).isSymbolicLink());const names=[];for(const item of fs.readdirSync(directory,{withFileTypes:true})){if(item.name==='results')continue;assert(!item.isSymbolicLink());const filename=path.join(directory,item.name);if(item.isDirectory())names.push(...noteFiles(filename,depth+1));else{assert(item.isFile());names.push(path.relative(repository,filename).replaceAll('\\','/'));}}return names.sort();}
export function activeCensus(){const rows=[],budget={files:0,bytes:0};function add(filename){const item=fs.lstatSync(filename);assert(item.isFile()&&!item.isSymbolicLink()&&item.size<=sourceLimits.fileBytes);budget.files++;budget.bytes+=item.size;assert(budget.files<=sourceLimits.files&&budget.bytes<=sourceLimits.totalBytes);const bytes=fs.readFileSync(filename);assert.equal(bytes.length,item.size);rows.push({path:path.relative(studio,filename).replaceAll('\\','/'),...identity(bytes)});}function walk(directory,depth=0){assert(depth<=sourceLimits.depth);assert(fs.lstatSync(directory).isDirectory()&&!fs.lstatSync(directory).isSymbolicLink());for(const item of fs.readdirSync(directory,{withFileTypes:true})){if(['node_modules','.local','results'].includes(item.name))continue;assert(!item.isSymbolicLink());const filename=path.join(directory,item.name);if(item.isDirectory())walk(filename,depth+1);else if(item.isFile()&&/\.(mjs|json|html|css|ps1)$/.test(item.name))add(filename);}}for(const name of ['apps','lib','public','browser-tests','scripts','tests'])walk(path.join(studio,name));for(const name of ['server.mjs','catalog.mjs','package.json'])add(path.join(studio,name));return rows.sort((a,b)=>a.path.localeCompare(b.path));}
function tree(){const result=new Map();for(const item of git(['ls-tree','-r','-z','--full-tree','HEAD','--','products/rea-studio']).toString('utf8').split('\0').filter(Boolean)){const match=/^(100644|100755) blob ([0-9a-f]{40})\t(.+)$/.exec(item);assert(match);result.set(match[3],match[2]);}return result;}
export function authenticateCensus(rows,value,composed){const objects=tree(),targets=new Map(value.transitions.filter(row=>/\.(mjs|json|html|css|ps1)$/.test(row.path)).map(row=>[row.path,row]));assert.equal(targets.size,6);let changed=0,notes=0;const seen=new Set();for(const row of rows){const name='products/rea-studio/'+safe(row.path);assert(!seen.has(name));seen.add(name);const bytes=readSource(name);assert.deepEqual(identity(bytes),pin(row));if(composed&&targets.has(name)){assert.deepEqual(identity(bytes),pin(targets.get(name).after));changed++;}else{assert(objects.has(name));assert.equal(createHash('sha1').update(Buffer.from('blob '+bytes.length+'\0')).update(bytes).digest('hex'),objects.get(name));}if(row.path.startsWith('apps/notes/'))notes++;}assert.equal(notes,composed?34:30);assert.equal(changed,composed?6:0);return{activeSixDirectorySources:rows.length,eligibleNotesSources:notes,exactOverlayAfterimages:changed,allOtherGitBlobs:rows.length-changed,separatelyPinnedReadme:1,sourceOverlay:composed};}
function statusAfter(value){return value.transitions.map(row=>({path:row.path,status:row.before?' M':'??'})).sort((a,b)=>a.path.localeCompare(b.path));}
function proof(value,composed){const seen=new Map(),captured=new Map();let bytes=0;function read(row,committed=true){const content=readSource(row.path,256*1024);assert.deepEqual(identity(content),pin(row));if(committed)assert.deepEqual(content,git(['show','HEAD:'+row.path]));if(!seen.has(row.path)){seen.set(row.path,identity(content));captured.set(row.path,content);bytes+=content.length;assert(seen.size<=64&&bytes<=8*1024*1024);}else assert.deepEqual(identity(content),seen.get(row.path));return content;}
 read(bundleSource);for(const row of value.payloads)read(row);for(const row of value.historicalOriginalDependencies)read(row);for(const row of value.sharedHostSources)read(row);read(value.workflow);
 const definitions=composed?value.composedNotesSources:value.baselineNotesSources;assert.deepEqual(noteFiles(path.join(studio,'apps/notes')),definitions.map(row=>row.path).sort());
 const targets=new Map(value.transitions.map(row=>[row.path,row]));for(const row of definitions){const target=targets.get(row.path);read(row,!(composed&&target));if(composed&&target&&target.before){const original=git(['show','HEAD:'+row.path]);assert.deepEqual(identity(original),pin(target.before));}if(composed&&target&&!target.before)assert(!tree().has(row.path));}
 assert.equal(seen.size,composed?60:56);
 const authority=JSON.parse(read(value.payloads.find(row=>row.kind==='review'&&row.path.endsWith('/source-authority-r4.json.snapshot'))));assert.deepEqual(identity(captured.get(value.payloads.find(row=>row.path.endsWith('/source-authority-r4.json.snapshot')).path)),authorityPin);assert.equal(authority.candidateFiles,12);assert.equal(authority.authoredAdditionalGroups,19);assert.equal(authority.plannedFutureNotesGroups,111);
 for(const row of authority.files){const target=targets.get(row.path),data=value.payloads.find(item=>item.path===row.path);if(target)assert.deepEqual(pin(target.after),row.after);else{assert(data);assert.deepEqual(pin(data),row.after);}}
 assert.deepEqual(definitions.filter(row=>row.path.endsWith('.test.mjs')).map(row=>row.path.slice('products/rea-studio/'.length)).sort(),composed?[...value.fixedTests].sort():value.fixedTests.filter(name=>!targets.has('products/rea-studio/'+name)).sort());
 return{currentSources:definitions.map(row=>({path:row.path,...pin(row)})),sourceInputs:[...seen].map(([name,p])=>({path:name,...p})),readFiles:seen.size,readBytes:bytes,fileLimit:64,byteLimit:8*1024*1024,captured};
}
export function assertComposedState(value){assertHosted();assert.deepEqual(gitStatus(),statusAfter(value));return proof(value,true);}
function sameAttempt(value){assert.deepEqual(value.execution,execution());assert.equal(value.sourceCommit,process.env.GITHUB_SHA);}
export function readComposition(root){assertHosted();root=ownedEvidence(root);const value=bundle(),bytes=evidenceBytes(root,'notes-new-todo-composition.json'),receipt=JSON.parse(bytes);assert.equal(receipt.schema,'rea-Notes-new-todo-composition/v1');assert.equal(receipt.status,'composed-unexecuted');sameAttempt(receipt);assert.equal(receipt.productionInstalled,false);assert.equal(receipt.applicationExecutions+receipt.originalExecutions+receipt.browserExecutions,0);assert.deepEqual(receipt.bundle,identity(gitSource(bundleSource.path)));assert.deepEqual(receipt.allowedDirtyPaths,statusAfter(value));const current=assertComposedState(value);assert.deepEqual(receipt.composedSources,current.currentSources);const before=JSON.parse(evidenceBytes(root,'composition-source-before.json')),after=JSON.parse(evidenceBytes(root,'composition-source-after.json'));assert.deepEqual(receipt.baselineCensus,identity(evidenceBytes(root,'composition-source-before.json')));assert.deepEqual(receipt.composedCensus,identity(evidenceBytes(root,'composition-source-after.json')));assert.deepEqual(activeCensus(),after);assert.deepEqual(authenticateCensus(after,value,true),receipt.composedSourceAuthentication);return{bundle:value,receipt:identity(bytes),value:receipt,current,before,after,root};}
export function verifyPostcheck(root,composition){const bytes=evidenceBytes(root,'notes-new-todo-postrun-source-check.json'),value=JSON.parse(bytes);assert.equal(value.schema,'rea-Notes-new-todo-postrun-source-check/v1');assert.equal(value.status,'source-verified');sameAttempt(value);assert.deepEqual(value.compositionReceipt,composition.receipt);assert.deepEqual(value.currentSources,composition.current.currentSources);assert.equal(value.sourceStable,true);assert.equal(value.applicationExecutions+value.originalExecutions+value.browserExecutions,0);return identity(bytes);}
function compose(root){assert.deepEqual(gitStatus(),[]);const value=bundle(),initial=proof(value,false),before=activeCensus(),baselineAuthentication=authenticateCensus(before,value,false);saveJSON(root,'composition-source-before.json',before);for(const row of value.transitions){if(row.before)assert.deepEqual(identity(readSource(row.path)),pin(row.before));else assert(!fs.existsSync(path.join(repository,row.path)));const bytes=readSource(row.afterImage.path);assert.deepEqual(identity(bytes),pin(row.after));const filename=path.join(repository,row.path);fs.writeFileSync(filename,bytes,{flag:row.before?'w':'wx'});assert.deepEqual(identity(readSource(row.path)),pin(row.after));}
 const current=assertComposedState(value),after=activeCensus(),composedAuthentication=authenticateCensus(after,value,true),beforeMap=new Map(before.map(row=>[row.path,row])),afterMap=new Map(after.map(row=>[row.path,row])),eligible=new Map(value.transitions.filter(row=>/\.(mjs|json|html|css|ps1)$/.test(row.path)).map(row=>[row.path.slice('products/rea-studio/'.length),row]));for(const [name,row]of beforeMap){if(eligible.has(name))assert.deepEqual(pin(row),pin(eligible.get(name).before));else assert.deepEqual(afterMap.get(name),row);}for(const [name,row]of afterMap){if(eligible.has(name))assert.deepEqual(pin(row),pin(eligible.get(name).after));else assert(beforeMap.has(name));}
 saveJSON(root,'composition-source-after.json',after);for(const[name,bytes]of current.captured)saveBytes(root,'composition-source/'+name+'.snapshot',bytes);
 return{schema:'rea-Notes-new-todo-composition/v1',status:'composed-unexecuted',execution:execution(),sourceCommit:process.env.GITHUB_SHA,bundle:identity(gitSource(bundleSource.path)),productionInstalled:false,historicalReceiptsRebound:false,applicationExecutions:0,originalExecutions:0,browserExecutions:0,baselineSourceAuthentication:baselineAuthentication,composedSourceAuthentication:composedAuthentication,baselineSources:initial.currentSources,composedSources:current.currentSources,baselineCensus:identity(evidenceBytes(root,'composition-source-before.json')),composedCensus:identity(evidenceBytes(root,'composition-source-after.json')),allowedDirtyPaths:statusAfter(value),currentSourceInputs:current.sourceInputs,proofReadFiles:current.readFiles,proofReadBytes:current.readBytes,proofFileLimit:64,proofByteLimit:8*1024*1024,exactTargets:7,eligibleTargets:6,separateReadmeTargets:1,fullParity:false,superiority:false};
}
function command(){assertHosted();const args=process.argv.slice(2);assert.equal(args.length,4);assert.equal(args[0],'--phase');assert(['compose','postcheck'].includes(args[1]));assert.equal(args[2],'--evidence');const root=ownedEvidence(args[3]),post=args[1]==='postcheck',name=post?'notes-new-todo-postrun-source-check.json':'notes-new-todo-composition.json';let result={schema:post?'rea-Notes-new-todo-postrun-source-check/v1':'rea-Notes-new-todo-composition/v1',status:'failed',execution:execution(),sourceCommit:process.env.GITHUB_SHA,productionInstalled:false,historicalReceiptsRebound:false,applicationExecutions:0,originalExecutions:0,browserExecutions:0,fullParity:false,superiority:false};try{if(!post)result=compose(root);else{const value=readComposition(root);result={...result,status:'source-verified',compositionReceipt:value.receipt,currentSources:value.current.currentSources,sourceStable:true,sourceAuthentication:authenticateCensus(activeCensus(),value.bundle,true),proofReadFiles:value.current.readFiles,proofReadBytes:value.current.readBytes};}}catch(error){result.failure={name:error.name,message:error.message};process.exitCode=1;}saveJSON(root,name,result);console.log(JSON.stringify({phase:args[1],status:result.status,sourceCommit:result.sourceCommit}));}
if(process.argv[1]&&path.resolve(process.argv[1])===path.resolve(fileURLToPath(import.meta.url)))command();
{
  "schema": "rea-Notes-new-todo-source-draft/v3",
  "workflow": {
    "bytes": 14891,
    "sha256": "74515726d13057c165df0c1249b36c48fe12d32bdd21bad61fd8166b8b58e63a"
  },
  "bundle": {
    "bytes": 30920,
    "sha256": "f71de368f593bbc979f30e7536e0527b2133d33b9ea41d8d3bab4d7b06f3aeb3"
  },
  "composer": {
    "bytes": 19431,
    "sha256": "ee410826f7d0bf46aa9bb950529b244610fb7c522976f3f62dbc26e5cd615e09"
  },
  "sourceOnly": true,
  "activeRepositoryWrites": 0,
  "localCandidateExecutions": 0,
  "fixes": [
    "composer command and trigger path selected explicitly",
    "two accidental trailing quote characters removed",
    "composer binds corrected exact workflow through bundle"
  ]
}
{
  "workflow": {
    "path": ".github/workflows/notes-new-todo-experiment-cloud.yml",
    "bytes": 14888,
    "sha256": "d1f18fbe0075de2aec122dd92e2b6d93a4d6e9dd6ce3157bc5e8b1b8a996960c"
  },
  "bundle": {
    "path": "products/rea-studio/experiments/notes-new-todo/bundle.json",
    "bytes": 30920,
    "sha256": "65d14eab3dab5a7952963689ec7b4af7d269cb0e2b099ce0fc48194a11a98bd6"
  },
  "payloads": 17,
  "targets": 7,
  "proofReadPaths": 60,
  "sourceOnly": true,
  "localTests": 0,
  "localProductExecutions": 0,
  "activeRepositoryWrites": 0
}
name: Experimental New To-do acceptance

on:
  workflow_dispatch:
  push:
    branches: [codex/rea-cloud-recovery-20261015]
    paths:
      - '.github/workflows/notes-new-todo-experiment-cloud.yml'
      - 'products/rea-studio/apps/notes/**'
      - 'products/rea-studio/experiments/notes-new-todo/**'
      - 'products/rea-studio/scripts/compose-notes-new-todo-cloud.mjs'
      - 'products/rea-studio/scripts/verify-notes-new-todo-cloud.mjs'
      - 'products/rea-studio/scripts/verify-cloud-browser.mjs'
      - 'products/rea-studio/browser-tests/notes-new-todo.spec.mjs'
      - 'products/rea-studio/browser-tests/playwright.notes-new-todo.config.mjs'
      - 'products/rea-studio/browser-tests/notes-new-todo-roster.json'
      - 'products/rea-studio/browser-tests/package.json'
      - 'products/rea-studio/browser-tests/package-lock.json'
      - 'products/rea-studio/browser-tests/playwright.config.mjs'
      - 'products/rea-studio/browser-tests/flow-vault.spec.mjs'
      - 'products/rea-studio/server.mjs'
      - 'products/rea-studio/catalog.mjs'
      - 'products/rea-studio/lib/**'
      - 'products/rea-studio/public/**'
      - 'products/rea-studio/package.json'

permissions:
  contents: read
concurrency:
  group: notes-new-todo-${{ github.ref }}
  cancel-in-progress: false

jobs:
  finite-twenty-one-file-selection:
    runs-on: windows-2022
    timeout-minutes: 30
    env:
      CI: 'true'
    steps:
      - name: Enable long research paths
        shell: pwsh
        run: git config --global core.longpaths true
      - name: Check out exact committed source
        id: checkout
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
          fetch-depth: 1
      - name: Select pinned Node runtime
        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '24.16.0'
          architecture: x64
          check-latest: false
      - name: Select owned evidence outside source paths
        shell: pwsh
        run: |
          $evidence=Join-Path $env:RUNNER_TEMP ('rea-notes-new-todo-finite-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT)
          New-Item -ItemType Directory -Path $evidence|Out-Null
          'REA_NOTES_NEW_TODO_EVIDENCE='+$evidence|Out-File -FilePath $env:GITHUB_ENV -Encoding utf8 -Append

      - name: Compose exactly seven reviewed Notes targets on a clean committed baseline
        id: sourcebefore
        shell: pwsh
        run: node products/rea-studio/scripts/compose-notes-new-todo-cloud.mjs --phase compose --evidence "$env:REA_NOTES_NEW_TODO_EVIDENCE"
      - name: Execute all twenty-one Notes files on the exact experimental composition
        id: verify
        shell: pwsh
        run: |
          node products/rea-studio/scripts/verify-notes-new-todo-cloud.mjs --phase finite --evidence "$env:REA_NOTES_NEW_TODO_EVIDENCE"
      - name: Independently authenticate all36 composed Notes files after every started composition
        id: sourceafter
        if: always() && steps.sourcebefore.outcome != '' && steps.sourcebefore.outcome != 'skipped'
        shell: pwsh
        run: node products/rea-studio/scripts/compose-notes-new-todo-cloud.mjs --phase postcheck --evidence "$env:REA_NOTES_NEW_TODO_EVIDENCE"
      - name: Package bounded complete success or failure evidence
        id: evidence
        if: always()
        shell: pwsh
        run: |
          $evidence=$env:REA_NOTES_NEW_TODO_EVIDENCE
          if(-not $evidence){$evidence=Join-Path $env:RUNNER_TEMP ('rea-notes-new-todo-finite-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT)}
          New-Item -ItemType Directory -Path $evidence -Force|Out-Null
          @{schema='rea-Notes-new-todo-experiment-workflow-attempt/v1';role='finite';sourceCommit=$env:GITHUB_SHA;runId=$env:GITHUB_RUN_ID;runAttempt=$env:GITHUB_RUN_ATTEMPT;runnerEnvironment=$env:RUNNER_ENVIRONMENT;checkoutOutcome='${{ steps.checkout.outcome }}';acquisitionOutcome='${{ steps.acquire.outcome }}';sourceBeforeOutcome='${{ steps.sourcebefore.outcome }}';verificationOutcome='${{ steps.verify.outcome }}';sourceAfterOutcome='${{ steps.sourceafter.outcome }}';browserPostcheckOutcome='${{ steps.browserpost.outcome }}';sourceOverlay=$true;exactOverlayTargets=7;composedNotesFiles=36;productionInstallationPerformedByWorkflow=$false;productionInstallationReceiptAuthenticated=$false;historicalReceiptsRebound=$false;frozenReadmeIsProposalEpoch=$true;fullParity=$false;superiority=$false}|ConvertTo-Json -Depth 6|Set-Content -LiteralPath (Join-Path $evidence 'new-todo-workflow-attempt.json') -Encoding utf8
          $files=@(Get-ChildItem -LiteralPath $evidence -File -Recurse)
          $rawBytes=($files|Measure-Object Length -Sum).Sum
          $bounded=$files.Count -le 2500 -and $rawBytes -le 96*1024*1024 -and @($files|Where-Object {$_.Length -gt 8*1024*1024}).Count -eq 0
          $archive=Join-Path $env:RUNNER_TEMP ('rea-notes-new-todo-finite-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT+'.zip')
          Add-Type -AssemblyName System.IO.Compression.FileSystem
          if($bounded){[IO.Compression.ZipFile]::CreateFromDirectory($evidence,$archive,[IO.Compression.CompressionLevel]::Optimal,$false)}
          $archiveBytes=if($bounded){(Get-Item -LiteralPath $archive).Length}else{$null}
          if(-not $bounded -or $archiveBytes -gt 15*1024*1024){
            $fallback=Join-Path $env:RUNNER_TEMP ('rea-notes-new-todo-incomplete-finite-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT)
            New-Item -ItemType Directory -Path $fallback|Out-Null
            foreach($file in Get-ChildItem -LiteralPath $evidence -File){if($file.Length -le 1024*1024){Copy-Item -LiteralPath $file.FullName -Destination (Join-Path $fallback $file.Name)}}
            @{schema='rea-cloud-evidence-storage-failure/v1';status='failed';role='finite';completeEvidenceUploaded=$false;sourceSnapshotsUploaded=$false;rawLogsComplete=$false;rawFiles=$files.Count;rawBytes=$rawBytes;archiveBytes=$archiveBytes;rawFileLimit=2500;rawByteLimit=96*1024*1024;individualByteLimit=8*1024*1024;zipLimit=15*1024*1024;reason='Complete New To-do evidence exceeded a fixed bound; fallback is not portable acceptance.'}|ConvertTo-Json|Set-Content -LiteralPath (Join-Path $fallback 'storage-failure.json') -Encoding utf8
            $archive=Join-Path $env:RUNNER_TEMP ('rea-notes-new-todo-incomplete-finite-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT+'.zip')
            [IO.Compression.ZipFile]::CreateFromDirectory($fallback,$archive,[IO.Compression.CompressionLevel]::Optimal,$false)
            if((Get-Item -LiteralPath $archive).Length -le 15*1024*1024){'artifact_path='+$archive|Out-File -FilePath $env:GITHUB_OUTPUT -Encoding utf8 -Append}
            throw 'Complete New To-do evidence exceeded a fixed bound; fallback is explicitly incomplete.'
          }
          'artifact_path='+$archive|Out-File -FilePath $env:GITHUB_OUTPUT -Encoding utf8 -Append
      - name: Preserve complete evidence or explicit incomplete failure record
        if: always() && steps.evidence.outputs.artifact_path != ''
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: notes-new-todo-finite-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ steps.evidence.outputs.artifact_path }}
          if-no-files-found: error
          compression-level: 0
          retention-days: 1

  eight-real-chromium-scenarios:
    runs-on: windows-2022
    timeout-minutes: 30
    env:
      CI: 'true'
    steps:
      - name: Enable long research paths
        shell: pwsh
        run: git config --global core.longpaths true
      - name: Check out exact committed source
        id: checkout
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
          fetch-depth: 1
      - name: Select pinned Node runtime
        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '24.16.0'
          architecture: x64
          check-latest: false
      - name: Select owned evidence outside source paths
        shell: pwsh
        run: |
          $evidence=Join-Path $env:RUNNER_TEMP ('rea-notes-new-todo-browser-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT)
          New-Item -ItemType Directory -Path $evidence|Out-Null
          'REA_NOTES_NEW_TODO_EVIDENCE='+$evidence|Out-File -FilePath $env:GITHUB_ENV -Encoding utf8 -Append
          'REA_BROWSER_EVIDENCE='+$evidence|Out-File -FilePath $env:GITHUB_ENV -Encoding utf8 -Append
          'PLAYWRIGHT_BROWSERS_PATH='+(Join-Path $env:RUNNER_TEMP ('rea-notes-new-todo-playwright-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT))|Out-File -FilePath $env:GITHUB_ENV -Encoding utf8 -Append
      - name: Acquire locked Chromium tooling on the clean committed checkout
        id: acquire
        shell: pwsh
        run: node products/rea-studio/scripts/verify-cloud-browser.mjs --phase acquire --evidence "$env:REA_NOTES_NEW_TODO_EVIDENCE"
      - name: Compose exactly seven reviewed Notes targets on a clean committed baseline
        id: sourcebefore
        shell: pwsh
        run: node products/rea-studio/scripts/compose-notes-new-todo-cloud.mjs --phase compose --evidence "$env:REA_NOTES_NEW_TODO_EVIDENCE"
      - name: Execute eight real Chromium New To-do scenarios on the seven-target composition
        id: verify
        shell: pwsh
        run: |
          node products/rea-studio/scripts/verify-notes-new-todo-cloud.mjs --phase browser --evidence "$env:REA_NOTES_NEW_TODO_EVIDENCE"
      - name: Independently authenticate all36 composed Notes files after every started composition
        id: sourceafter
        if: always() && steps.sourcebefore.outcome != '' && steps.sourcebefore.outcome != 'skipped'
        shell: pwsh
        run: node products/rea-studio/scripts/compose-notes-new-todo-cloud.mjs --phase postcheck --evidence "$env:REA_NOTES_NEW_TODO_EVIDENCE"
      - name: Independently recheck every eligible browser Git blob after failures too
        id: browserpost
        if: always() && steps.sourcebefore.outcome != '' && steps.sourcebefore.outcome != 'skipped'
        shell: pwsh
        run: |
          node products/rea-studio/scripts/verify-notes-new-todo-cloud.mjs --phase browser-postcheck --evidence "$env:REA_NOTES_NEW_TODO_EVIDENCE"
      - name: Package bounded complete success or failure evidence
        id: evidence
        if: always()
        shell: pwsh
        run: |
          $evidence=$env:REA_NOTES_NEW_TODO_EVIDENCE
          if(-not $evidence){$evidence=Join-Path $env:RUNNER_TEMP ('rea-notes-new-todo-browser-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT)}
          New-Item -ItemType Directory -Path $evidence -Force|Out-Null
          @{schema='rea-Notes-new-todo-experiment-workflow-attempt/v1';role='browser';sourceCommit=$env:GITHUB_SHA;runId=$env:GITHUB_RUN_ID;runAttempt=$env:GITHUB_RUN_ATTEMPT;runnerEnvironment=$env:RUNNER_ENVIRONMENT;checkoutOutcome='${{ steps.checkout.outcome }}';acquisitionOutcome='${{ steps.acquire.outcome }}';sourceBeforeOutcome='${{ steps.sourcebefore.outcome }}';verificationOutcome='${{ steps.verify.outcome }}';sourceAfterOutcome='${{ steps.sourceafter.outcome }}';browserPostcheckOutcome='${{ steps.browserpost.outcome }}';sourceOverlay=$true;exactOverlayTargets=7;composedNotesFiles=36;productionInstallationPerformedByWorkflow=$false;productionInstallationReceiptAuthenticated=$false;historicalReceiptsRebound=$false;frozenReadmeIsProposalEpoch=$true;fullParity=$false;superiority=$false}|ConvertTo-Json -Depth 6|Set-Content -LiteralPath (Join-Path $evidence 'new-todo-workflow-attempt.json') -Encoding utf8
          $files=@(Get-ChildItem -LiteralPath $evidence -File -Recurse)
          $rawBytes=($files|Measure-Object Length -Sum).Sum
          $bounded=$files.Count -le 2500 -and $rawBytes -le 96*1024*1024 -and @($files|Where-Object {$_.Length -gt 8*1024*1024}).Count -eq 0
          $archive=Join-Path $env:RUNNER_TEMP ('rea-notes-new-todo-browser-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT+'.zip')
          Add-Type -AssemblyName System.IO.Compression.FileSystem
          if($bounded){[IO.Compression.ZipFile]::CreateFromDirectory($evidence,$archive,[IO.Compression.CompressionLevel]::Optimal,$false)}
          $archiveBytes=if($bounded){(Get-Item -LiteralPath $archive).Length}else{$null}
          if(-not $bounded -or $archiveBytes -gt 15*1024*1024){
            $fallback=Join-Path $env:RUNNER_TEMP ('rea-notes-new-todo-incomplete-browser-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT)
            New-Item -ItemType Directory -Path $fallback|Out-Null
            foreach($file in Get-ChildItem -LiteralPath $evidence -File){if($file.Length -le 1024*1024){Copy-Item -LiteralPath $file.FullName -Destination (Join-Path $fallback $file.Name)}}
            @{schema='rea-cloud-evidence-storage-failure/v1';status='failed';role='browser';completeEvidenceUploaded=$false;sourceSnapshotsUploaded=$false;rawLogsComplete=$false;rawFiles=$files.Count;rawBytes=$rawBytes;archiveBytes=$archiveBytes;rawFileLimit=2500;rawByteLimit=96*1024*1024;individualByteLimit=8*1024*1024;zipLimit=15*1024*1024;reason='Complete New To-do evidence exceeded a fixed bound; fallback is not portable acceptance.'}|ConvertTo-Json|Set-Content -LiteralPath (Join-Path $fallback 'storage-failure.json') -Encoding utf8
            $archive=Join-Path $env:RUNNER_TEMP ('rea-notes-new-todo-incomplete-browser-'+$env:GITHUB_RUN_ID+'-'+$env:GITHUB_RUN_ATTEMPT+'.zip')
            [IO.Compression.ZipFile]::CreateFromDirectory($fallback,$archive,[IO.Compression.CompressionLevel]::Optimal,$false)
            if((Get-Item -LiteralPath $archive).Length -le 15*1024*1024){'artifact_path='+$archive|Out-File -FilePath $env:GITHUB_OUTPUT -Encoding utf8 -Append}
            throw 'Complete New To-do evidence exceeded a fixed bound; fallback is explicitly incomplete.'
          }
          'artifact_path='+$archive|Out-File -FilePath $env:GITHUB_OUTPUT -Encoding utf8 -Append
      - name: Preserve complete evidence or explicit incomplete failure record
        if: always() && steps.evidence.outputs.artifact_path != ''
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: notes-new-todo-browser-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ steps.evidence.outputs.artifact_path }}
          if-no-files-found: error
          compression-level: 0
          retention-days: 1
