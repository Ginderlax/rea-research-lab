    {
      "id": "grafana.candidate.f7fd302f3df6365861b4",
      "syntaxRole": "table-row",
      "sourceText": "| Style               | Choose whether to display your time-series data as **Lines**, **Bars**, or **Points**. You can use overrides to combine multiple styles in the same graph. |",
      "headingPath": [
        "Table",
        "Configuration options",
        "Cell options",
        "Sparkline"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/table/index.md",
