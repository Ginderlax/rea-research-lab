    {
      "id": "grafana.candidate.64d2c0648d8ae2998e11",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To configure SAML authentication in Grafana using the configuration file, follow these steps:",
      "headingPath": [
        "Configure SAML authentication using the Grafana configuration file"
      ],
      "source": {
