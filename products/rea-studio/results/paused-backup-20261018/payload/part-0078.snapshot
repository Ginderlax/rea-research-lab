      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b9889713e825291c485f",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Get a license token in the name of your cluster's shared hostname.",
      "headingPath": [
        "Set up Grafana for high availability",
        "Grafana Enterprise only: License your Grafana servers"
      ],
      "source": {
