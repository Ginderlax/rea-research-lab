    {
      "id": "grafana.candidate.60e988d9ce2ab404496a",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Each row in the source data becomes a separate field. Each field now has a maximum configuration option set. Options such as **Min**, **Max**, **Unit**, and **Thresholds** are part of the field configuration. If set, they are used by the visualization instead of any options manually configured in the panel editor options pane.",
      "headingPath": [
        "Transform data",
        "Transformation functions",
        "Config from query results",
        "Example"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/query-transform-data/transform-data/index.md",
        "gitBlobSha": "9cd072609170b1783ea50740845dd11e18b0fede",
