    {
      "id": "grafana.candidate.e35ead0da503c8f5f695",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you want to enable CORS for your Grafana instance, run Grafana behind a reverse proxy and configure the CORS headers in the reverse proxy.",
      "headingPath": [
        "Configure security",
        "Proxy server",
        "Configure CORS"
      ],
      "source": {
