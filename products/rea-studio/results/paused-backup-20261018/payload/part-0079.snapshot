        "lineStart": 59,
        "lineEnd": 61,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v9-1.md#L59-L61"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
