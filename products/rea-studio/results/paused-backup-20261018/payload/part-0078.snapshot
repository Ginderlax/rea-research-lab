    },
    {
      "id": "grafana.candidate.58129cce34c54f649097",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The query history contains the list of queries that you created in Explore. You can also add queries from the history to your saved queries. Refer to [Query history](/docs/grafana/<GRAFANA_VERSION>/explore/query-management/#query-history) for detailed information on working with your query history.",
      "headingPath": [
        "Get started with Explore",
        "Explore elements",
        "Query history"
      ],
      "source": {
        "path": "docs/sources/visualizations/explore/get-started-with-explore.md",
        "gitBlobSha": "8f5dffb77daf93f254dfa94bc379b04d3071471e",
        "sha256": "d9598c4a3a1a79d06034c181a325f3fd1282885baaffe6c11a50d4c1da29f8aa",
        "lineStart": 113,
        "lineEnd": 115,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/explore/get-started-with-explore.md#L113-L115"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.375f34a13023f0978d2d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The query inspector provides detailed statistics regarding your query. Inspector functions as a kind of debugging tool that \"inspects\" your query. It provides query statistics under **Stats**, request response time under **Query**, data frame details under **{} JSON**, and the shape of your data under **Data**. Refer to [Query inspector in Explore](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/visualizations/explore/explore-inspector/) for additional information.",
      "headingPath": [
        "Get started with Explore",
        "Explore elements",
        "Query inspector"
      ],
      "source": {
        "path": "docs/sources/visualizations/explore/get-started-with-explore.md",
        "gitBlobSha": "8f5dffb77daf93f254dfa94bc379b04d3071471e",
        "sha256": "d9598c4a3a1a79d06034c181a325f3fd1282885baaffe6c11a50d4c1da29f8aa",
