    {
      "id": "grafana.candidate.4db27f681ad2aeb45ba9",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The following toggles require explicitly setting Grafana's [app mode](../#app_mode) to 'development' before you can enable this feature toggle. These features tend to be experimental.",
