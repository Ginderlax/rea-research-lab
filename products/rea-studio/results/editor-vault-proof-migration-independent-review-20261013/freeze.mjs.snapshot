import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import{createHash}from'node:crypto';
const own=import.meta.dirname,base=path.resolve(own,'../..'),stage=path.join(base,'work/editor-vault-proof-migration-next'),sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)});
const final=fs.readFileSync(path.join(own,'final/review-validation.json'));const result=JSON.parse(final);assert.equal(result.migrationAccepted,true);assert.equal(result.installerSourceAccepted,true);assert.equal(result.productionWrites,0);assert.equal(result.checkCount,35);assert.equal(result.freshProofOnlyRejectionChecks,26);
fs.writeFileSync(path.join(own,'review-validation.json'),final,{flag:'wx'});fs.writeFileSync(path.join(own,'final/review.mjs.snapshot'),fs.readFileSync(path.join(own,'review.mjs')),{flag:'wx'});
const stageManifest=fs.readFileSync(path.join(stage,'freeze-manifest.json'));assert.equal(sha(stageManifest),'e54e383a182201e6971ac1201ab41a5c20351e4f6dd3f28a35daab8faa6f9ead');for(const r of JSON.parse(stageManifest).inventory)assert.deepEqual(id(fs.readFileSync(path.join(stage,r.path))),{bytes:r.bytes,sha256:r.sha256});
const currentInstaller=fs.readFileSync(path.join(base,'work/install-editor-vault-proof-migration.mjs'));assert.equal(sha(currentInstaller),result.installerSHA256);assert.deepEqual(currentInstaller,fs.readFileSync(path.join(own,'final/source/root-installer.mjs.snapshot')));
function files(p=''){const out=[];for(const d of fs.readdirSync(path.join(own,p),{withFileTypes:true})){assert(!d.isSymbolicLink());const n=p?p+'/'+d.name:d.name;if(d.isDirectory())out.push(...files(n));else{assert(d.isFile());if(n!=='manifest.json')out.push(n);}}return out;}const inventory=files().sort().map(p=>({path:p,...id(fs.readFileSync(path.join(own,p)))}));assert.equal(new Set(inventory.map(r=>r.path)).size,inventory.length);for(const r of inventory){const b=fs.readFileSync(path.join(own,r.path));assert(b.length<=32*1024*1024);assert(!(b[0]===0x4d&&b[1]===0x5a));assert(!(b[0]===0x50&&b[1]===0x4b));}
const manifest={schema:'rea-editor-vault-proof-migration-independent-source-only-strict-freeze/v1',at:new Date().toISOString(),strict:true,inventory,files:inventory.length,authorManifestSHA256:sha(stageManifest),reviewReceipt:{path:'review-validation.json',...id(final)},migrationAccepted:true,installerSourceAccepted:true,productionWrites:0,applicationExecutions:0,originalExecutions:0,browserExecutions:0,benchmarks:0,scope:'Finite independent source/proof review. No historical behavior rebinding or new app acceptance.'};const b=Buffer.from(JSON.stringify(manifest,null,2)+'\n');fs.writeFileSync(path.join(own,'manifest.json'),b,{flag:'wx'});console.log(JSON.stringify({files:inventory.length,manifest:id(b),receipt:id(final),installer:id(currentInstaller),accepted:true,productionWrites:0}));
