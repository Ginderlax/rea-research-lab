        },
        {
          "path": "products/rea-studio/apps/vault/app.integration.test.mjs",
          "test_case": "HTTP persisted operations across host restart"
        },
        {
          "path": "products/rea-studio/apps/vault/kdbx.interop.test.mjs",
          "test_case": "KeePass 2.61.1 independently creates and opens KDBX across every supported KDF/cipher pair",
          "boundary": "Preserved digest-verified original assembly independently creates/opens six synthetic cipher/KDF pairs and compares contents; not every database feature or original workflow."
        },
        {
          "path": "products/rea-studio/apps/vault/kdbx.interop.test.mjs",
          "test_case": "original KeePass 3.1/Salsa20 import and 4.0 import preserve history and attachments on 4.1 export",
          "boundary": "Original synthetic 3.1/4.0 fixtures with gzip/none; compatible subset upgrade, not complete format acceptance."
        },
        {
          "path": "products/rea-studio/apps/vault/kdbx.interop.test.mjs",
          "test_case": "independent original opens fresh Lab database; password + XML keyfile and keyfile-only work in both directions",
          "boundary": "Independent original XML v2 keyfile/password combinations and fresh file opening."
        }
      ],
      "acceptance_checks": [
        "Match managed hierarchical groups, custom fields, expiration, history and deletion/recycle behavior."
      ],
      "original_release_comparison": "bounded-independent-KeePass-2.61.1-format-fixtures; full-capability-parity-not-established",
      "completion_gate": "not-passed"
    },
