import fs from 'node:fs/promises';import path from 'node:path';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';
const here=import.meta.dirname,sha=bytes=>createHash('sha256').update(bytes).digest('hex'),fp=async file=>{const bytes=await fs.readFile(file);return{bytes:bytes.length,sha256:sha(bytes)};},load=async name=>JSON.parse(await fs.readFile(path.join(here,name))),base=await load('review-observations.json');assert.deepEqual(base.test.counts,{tests:7,pass:4,fail:3,cancelled:0,skipped:0,todo:0});
const observations=[];for(const name of (await fs.readdir(path.join(here,'runs'))).sort()){const relative='runs/'+name+'/observation.json';observations.push({path:relative,...await fp(path.join(here,relative)),observation:await load(relative)});}assert.equal(observations.length,7);const typing=observations.find(row=>row.observation.markerAfterResponse),disposed=observations.find(row=>row.observation.disposedBeforeResponse),disposedError=observations.find(row=>row.observation.disposedBeforeFailure);assert.equal(typing.observation.diskA,'captured save A\n');assert.equal(typing.observation.editorValue,'captured save A\n');assert.equal(typing.observation.markerAfterResponse,'a.txt');assert.match(typing.observation.differenceAfterResponse,/Minimal line edits: 0/);
const root=path.resolve(here,'../editor-search-path-fix-next'),manifest=JSON.parse(await fs.readFile(path.join(root,'freeze-manifest.json')));for(const [name,row]of Object.entries(manifest.inventory))assert.deepEqual(await fp(path.join(root,name)),row);assert.equal((await fp(path.join(root,'freeze-manifest.json'))).sha256,base.candidateManifestSHA256);for(const row of base.snapshots)assert.deepEqual(await fp(path.join(here,row.path)),{bytes:row.bytes,sha256:row.sha256});
const receipt={schema:'rea-editor-save-independent-negative-final/v1',checkedAt:new Date().toISOString(),status:'two concrete save publication defects confirmed; negative epoch preserved',acceptance:false,derivedFromImmutableAccepted126:true,candidateManifestSHA256:base.candidateManifestSHA256,sourceBeforeAfterStable:true,test:base.test,
  findings:[{priority:'P1',source:'editor-search-path-fix-next/products/rea-studio/apps/editor/client.mjs:126',title:'Late successful save overwrites a newer in-memory draft',observationPath:typing.path,diskCommit:'captured save A\n',typingAfterCommit:'newer unsaved A\n',afterResponse:{dirtyMarker:typing.observation.markerAfterResponse,difference:typing.observation.differenceAfterResponse,afterTabNavigation:typing.observation.editorValue},mechanism:'Object.assign(item,data) overwrites item.content with captured request text after awaiting API. The textarea still temporarily displays newer text but its document item becomes clean; tab navigation drops the newer text.'},{priority:'P2',source:'editor-search-path-fix-next/products/rea-studio/apps/editor/client.mjs:41,126',title:'Settled save response publishes to a disposed view',successObservationPath:disposed.path,failureObservationPath:disposedError.path,mechanism:'Successful save updates tabs/status without mounted check; run() publishes the injected held rejection status without mounted check.',failureControlScope:'The success case holds a real completed handle Save. The rejection control injects a synthetic API failure and performs no handle Save or disk commit.'}],
  controlResults:{noTyping:'pass: captured content is committed and clean',newDraft:'pass: unrelated new draft remains active and absent on disk',selection:'pass: selected B stays active and its bytes remain unchanged',confirmedClose:'pass: closed tab is not reopened; captured write remains committed'},
  observations,preservedAcceptedSnapshots:base.snapshots.length,snapshots:base.snapshots,allSourceAndDiskCommitObservationsRetained:true,actualClientModules:true,actualReadSaveHandlersForSuccessfulCases:true,finiteElementModel:true,actualBrowser:false,httpHost:false,originalEngineExecutions:0,benchmarkMemoryProfilerRuns:0,productionChanged:false,oldStagesChanged:false,universalUIOrFilesystemProof:false,
  nextAction:'Author a separate correction derived from accepted126 only after this negative epoch is frozen. Root must obtain an independent review before installation.',scope:'Seven bounded cases; current search acceptance and original engine observations remain separate, unchanged historical evidence.'};await fs.writeFile(path.join(here,'review-validation.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
await fs.writeFile(path.join(here,'README.md'),`# Editor save publication independent negative review\n\nSeven actual-client cases against immutable accepted126 produced four passing controls and three failing expectations. The source-bound success API invokes the real Editor Save handler, captures exact committed bytes, then holds only its response. No original engine, browser, host or benchmark ran.\n\nP1: typing after the captured write commits produces a newer draft. The late response overwrites the document item's content with the captured request text, removes the dirty marker and reports zero diff while the textarea temporarily still shows the newer text. Selecting B then A drops the newer draft. The original disk commit is correct and remains distinct from this in-memory loss.\n\nP2: a late success mutates tabs/status after disposal; a synthetic held failure changes the disposed status via the generic run() catch. The synthetic failure case performs no handle Save or disk commit. Exact raw observations preserve both boundaries.\n\nNo-typing, new-draft, selection and confirmed-close controls passed their content/active-tab requirements. Closing did not reopen the tab. This finite element model does not establish browser/workbench parity, complete process behavior or filesystem race safety. The source126 before/after proof and 127 inert snapshots remain exact.\n\nA later correction must use a new stage after this negative epoch is frozen; no accepted126, previous review or production bytes were changed.\n`,{flag:'wx'});console.log(JSON.stringify({receipt:await fp(path.join(here,'review-validation.json')),counts:base.test.counts,observations:observations.length}));
