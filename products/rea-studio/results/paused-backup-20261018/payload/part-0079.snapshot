        "lineStart": 213,
        "lineEnd": 215,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v9-1.md#L213-L215"
      },
      "applicability": {
        "status": "excluded-by-paid-or-hosted-section-heading",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ],
        "restriction": "What's new in Grafana v9.1 > Grafana Enterprise > Authentication and security > RBAC for app plugins, usage insights, and query caching"
      },
