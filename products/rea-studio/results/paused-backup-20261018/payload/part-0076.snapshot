    {
      "id": "grafana.candidate.15e95bcfb289c07cf45c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Alert queries don't support template variables. Grafana evaluates alert rules on the backend without dashboard context, so variables like `$instance` or `$job` aren't resolved.",
      "headingPath": [
        "Prometheus alerting",
        "Limitations",
        "Template variables not supported"
      ],
      "source": {
