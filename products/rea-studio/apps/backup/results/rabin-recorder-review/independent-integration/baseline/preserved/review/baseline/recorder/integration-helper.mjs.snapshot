import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {readFileSync,writeFileSync,mkdirSync,copyFileSync,readdirSync} from 'node:fs';
import {join,dirname} from 'node:path';
const workspace='C:/Users/evanh/Documents/Codex/2026-10-12/go',lab=join(workspace,'outputs/rea-research-lab'),app=join(lab,'products/rea-studio/apps/backup');
const stage=join(workspace,'work/backup-rabin-fixed-next'),destination='products/rea-studio/apps/backup/results/rabin-source-study',hash=b=>createHash('sha256').update(b).digest('hex');
const history=JSON.parse(readFileSync(join(lab,'products/rea-studio/results/milestones/compression-remote-20261012/snapshot-manifest.json')));
assert.equal(history.source_revision,'b9f6b71b215028d786af5eaa3d41ae46cc3ec9ac');
const baseline=history.source_snapshots.find(e=>e.path==='products/rea-studio/apps/backup/restic.mjs');assert.ok(baseline);assert.equal(hash(readFileSync(join(app,'restic.mjs'))),baseline.sha256);
assert.equal(hash(readFileSync(join(stage,'rabin-validation.json'))),'e50f1858132f6af08709f64a9d47e022c2303c060820d62cdfedf63daa535ab6');
const finalReview=join(workspace,'work/backup-rabin-final-review');assert.equal(hash(readFileSync(join(finalReview,'review-validation.json'))),'5a86c3e557408f985dfaf8c4d187fc8a9b1afd1a910d59aaadcfd190a9cfc7ac');
const final=JSON.parse(readFileSync(join(finalReview,'review-validation.json')));assert.equal(final.acceptedFiniteSlice,true);assert.equal(final.summary.pass,20);assert.equal(final.summary.diagnosticsPassed,3);
for(const e of final.sourceFingerprints){assert.equal(hash(readFileSync(join(stage,e.path))),e.sha256,e.path);}
const snapshots=[],seen=new Set();
function preserve(base,name,group,expected){assert.ok(name&&!name.split('/').includes('..')&&!name.includes('\\'));const bytes=readFileSync(join(base,name));if(expected)assert.equal(hash(bytes),expected,name);const path=destination+'/'+group+'/'+name.replace(/\.(mjs|js|md|zip)$/i,'.$1.snapshot');if(seen.has(path))return;seen.add(path);mkdirSync(dirname(join(lab,path)),{recursive:true});copyFileSync(join(base,name),join(lab,path));snapshots.push({group,originalPath:name,path,bytes:bytes.length,sha256:hash(bytes)});}
function walk(base,prefix=''){for(const e of readdirSync(join(base,prefix),{withFileTypes:true})){const name=prefix+e.name;if(e.isDirectory())walk(base,name+'/');else {assert.ok(!/\.(exe|dll|zip|tgz|7z)$/i.test(name));preserve(base,name,base===stage?'fixed-stage':'author-stage');}}}
walk(join(workspace,'work/backup-rabin-next'));walk(stage);
for(const [folder,group]of[['backup-rabin-review','initial-review'],['backup-rabin-fixed-review','first-fixed-review'],['backup-rabin-final-review','final-review']]){
 const base=join(workspace,'work',folder),r=JSON.parse(readFileSync(join(base,'review-validation.json')));preserve(base,'review-validation.json',group);
 for(const e of r.stageSourceFingerprints??r.exactCopiedBaselineFingerprints??r.exactBaselineFingerprints??[])preserve(base,'baseline/'+e.path,group,e.sha256);
 for(const e of [...(r.reviewSourceFingerprints??[]),...(r.evidenceFingerprints??[]),...(r.reviewFingerprints??[])])preserve(base,e.path,group,e.sha256);
}
const transformations=[];
function install(name,text,source){writeFileSync(join(app,name),text);transformations.push({sourcePath:source,destinationPath:'products/rea-studio/apps/backup/'+name,sourceSha256:hash(readFileSync(join(stage,source))),destinationSha256:hash(Buffer.from(text)),changes:'Only documented module/path/test-observation adaptation where specified.'});}
install('rabin.mjs',readFileSync(join(stage,'rabin.mjs'),'utf8'),'rabin.mjs');
install('capture-rabin-file.mjs',readFileSync(join(stage,'capture-file.mjs'),'utf8'),'capture-file.mjs');
install('restic.mjs',readFileSync(join(stage,'apps/backup/restic.mjs'),'utf8').replace("'../../capture-file.mjs'","'./capture-rabin-file.mjs'"),'apps/backup/restic.mjs');
install('rabin.test.mjs',readFileSync(join(stage,'rabin.test.mjs'),'utf8'),'rabin.test.mjs');
install('capture-rabin-file.test.mjs',readFileSync(join(stage,'capture-file.test.mjs'),'utf8').replaceAll("'./capture-file.mjs'","'./capture-rabin-file.mjs'"),'capture-file.test.mjs');
let snapshot=readFileSync(join(stage,'snapshot.test.mjs'),'utf8').replace("'./lib/storage.mjs'","'../../lib/storage.mjs'").replaceAll("'./apps/backup/","'./").replace("path.resolve('outputs/rea-research-lab/projects/09-restic/artifacts')","fileURLToPath(new URL('../../../../projects/09-restic/artifacts/',import.meta.url))").replace("import os from 'node:os';","import os from 'node:os';\nimport {fileURLToPath} from 'node:url';").replace("test.after(async()=>{await fs.writeFile(new URL('snapshot-original-observations.json',import.meta.url),JSON.stringify(observations,null,2)+'\\n');});","test.after(()=>console.log(JSON.stringify({rabinSnapshotOriginalObservations:observations})));");
assert.ok(!snapshot.includes('snapshot-original-observations.json'));install('restic-rabin-snapshot.test.mjs',snapshot,'snapshot.test.mjs');
let oracle=readFileSync(join(stage,'original-compare.mjs'),'utf8').replace("path.resolve('outputs/rea-research-lab/projects/09-restic/artifacts/unpacked/restic_0.19.1_windows_amd64.exe')","fileURLToPath(new URL('../../../../projects/09-restic/artifacts/unpacked/restic_0.19.1_windows_amd64.exe',import.meta.url))").replace("path.resolve('outputs/rea-research-lab/projects/09-restic/artifacts/restic_0.19.1_windows_amd64.zip')","fileURLToPath(new URL('../../../../projects/09-restic/artifacts/restic_0.19.1_windows_amd64.zip',import.meta.url))").replaceAll("'./restic-crypto.mjs'","'./restic-crypto.mjs'").replace("await fs.writeFile(new URL('original-validation.json',import.meta.url),JSON.stringify(report,null,2)+'\\n');","console.log(JSON.stringify({rabinBoundaryOriginalObservations:report}));");
assert.ok(!oracle.includes("new URL('original-validation.json'"));install('rabin-original-compare.mjs',oracle,'original-compare.mjs');
writeFileSync(join(app,'rabin-original.test.mjs'),"import test from 'node:test';\nimport assert from 'node:assert/strict';\nimport {compareOriginal} from './rabin-original-compare.mjs';\ntest('authenticated released restic matches thirty ordered Rabin boundary and plaintext identity cases',async()=>{const result=await compareOriginal();assert.deepEqual(result,{files:30,chunks:126,originalExecutions:30});});\n");
let lifecycle=readFileSync(join(finalReview,'lifecycle.test.mjs'),'utf8').replace("import path from 'node:path';","import path from 'node:path';\nimport os from 'node:os';").replace("'./baseline/capture-file.mjs'","'./capture-rabin-file.mjs'").replace("'./baseline/apps/backup/restic.mjs'","'./restic.mjs'").replace("'./baseline/lib/storage.mjs'","'../../lib/storage.mjs'");
const beginning="const root=fileURLToPath(new URL('./',import.meta.url)),manifest=JSON.parse(await fs.readFile(path.join(root,'baseline-manifest.json'),'utf8')),hash=bytes=>createHash('sha256').update(bytes).digest('hex')";
assert.ok(lifecycle.includes(beginning));lifecycle=lifecycle.replace(beginning,"const root=await fs.mkdtemp(path.join(os.tmpdir(),'rea-rabin-lifecycle-')),hash=bytes=>createHash('sha256').update(bytes).digest('hex'),sourceUrls=['restic.mjs','capture-rabin-file.mjs','rabin.mjs','restic-compression.mjs','restic-crypto.mjs','restic-kdf-policy.mjs','../../lib/storage.mjs'].map(name=>({name,url:new URL(name,import.meta.url)})),manifest={sourceFingerprints:await Promise.all(sourceUrls.map(async e=>({path:e.name,sha256:hash(await fs.readFile(e.url))}))) }");
const from=lifecycle.indexOf('async function stable()'),to=lifecycle.indexOf('\nawait stable();',from);assert.ok(from>=0&&to>from);lifecycle=lifecycle.slice(0,from)+"async function stable(){for(const e of sourceUrls)assert.equal(hash(await fs.readFile(e.url)),manifest.sourceFingerprints.find(r=>r.path===e.name).sha256);}"+lifecycle.slice(to);
const after=lifecycle.indexOf('test.after(');assert.ok(after>0);lifecycle=lifecycle.slice(0,after)+"test.after(async()=>{await stable();console.log(JSON.stringify({rabinLifecycleObservations:{schema:'rea-rabin-production-lifecycle/v1',sourceFingerprints:manifest.sourceFingerprints,observations,sourceBytesStableAcrossRun:true,scope:'Finite owned fixtures and child-only fault injection against actual production modules.'}}));assert.equal(path.dirname(root),path.resolve(os.tmpdir()));assert.ok(path.basename(root).startsWith('rea-rabin-lifecycle-'));await fs.rm(root,{recursive:true,force:true});});\n";
writeFileSync(join(app,'restic-rabin-lifecycle.test.mjs'),lifecycle);
transformations.push({sourcePath:'../backup-rabin-final-review/lifecycle.test.mjs',sourceSha256:hash(readFileSync(join(finalReview,'lifecycle.test.mjs'))),destinationPath:'products/rea-studio/apps/backup/restic-rabin-lifecycle.test.mjs',destinationSha256:hash(Buffer.from(lifecycle)),changes:'Use actual production modules, temporary fixture root and live before/after fingerprints; print observations rather than mutate source-bound evidence during tests.'});
writeFileSync(join(lab,destination,'preservation-manifest.json'),JSON.stringify({schema:'rea-restic-rabin-source-preservation/v1',recordedAtUtc:new Date().toISOString(),previousRevision:history.source_revision,acceptedReviewSha256:hash(readFileSync(join(finalReview,'review-validation.json'))),stageReceiptSha256:hash(readFileSync(join(stage,'rabin-validation.json'))),snapshots,transformations,fullFeatureParityEstablished:false,universalSuperiorityEstablished:false},null,2)+'\n');
console.log(JSON.stringify({preserved:snapshots.length,transformations:transformations.length,productionIntegrated:true,fullFeatureParityEstablished:false}));
