    {
      "id": "grafana.candidate.d25bab500672645ab547",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The SDK supports multiple programming languages, including Go, TypeScript, Python, PHP, and Java, so you can choose the one that best fits your development environment. Refer to the [Grafana Foundation SDK](https://github.com/grafana/grafana-foundation-sdk) GitHub repository for further details.",
      "headingPath": [
        "Get started with the Grafana Foundation SDK"
      ],
      "source": {
