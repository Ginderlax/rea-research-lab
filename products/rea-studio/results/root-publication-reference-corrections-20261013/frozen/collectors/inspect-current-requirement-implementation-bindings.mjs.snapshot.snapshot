import fs from'node:fs';import path from'node:path';import{createHash}from'node:crypto';import assert from'node:assert/strict';
const lab=path.resolve(import.meta.dirname,'../outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),index=JSON.parse(fs.readFileSync(path.join(lab,'products/rea-studio/requirements/INDEX.json'))),mb=fs.readFileSync(path.join(lab,'products/rea-studio/results/milestones/search-trash-recycle-save-3baecf4e-20261013/snapshot-manifest.json'));assert.equal(sha(mb),'d969655ed6d1e73f925147c277261b38333e2d095b18a486f2c7c2a7700689ff');const capsule=JSON.parse(mb);
for(const registry of index.registries){const file='products/rea-studio/requirements/'+registry.file,b=fs.readFileSync(path.join(lab,file)),record=JSON.parse(b),rows=registry.file==='workspace-products.json'?record.localImplementationEvidence:registry.file==='visual-products.json'?record.baselineProducts.flatMap(p=>p.implementationFiles??[]):record.products.flatMap(p=>p.local_implementation_evidence??[]);const mismatches=rows.flatMap(e=>{const live=fs.readFileSync(path.join(lab,e.path));if(sha(live)===e.sha256)return[];const old=capsule.sourceSnapshots.find(r=>r.sourcePath===e.path);return[{...e,currentBytes:live.length,currentSHA256:sha(live),historical3ba:old?{bytes:old.bytes,sha256:old.sha256,snapshotPath:old.snapshotPath}:null}];});console.log(JSON.stringify({registry:registry.file,registrySHA256:sha(b),rows:rows.length,mismatches}));}
