import fs from 'node:fs/promises';
import path from 'node:path';
import crypto from 'node:crypto';
import assert from 'node:assert/strict';
import {fileURLToPath} from 'node:url';

// Source-only review: no candidate imports, application execution or source writes.
const own = path.dirname(fileURLToPath(import.meta.url));
const workspace = path.resolve(own, '..', '..');
const repo = path.join(workspace, 'outputs/rea-research-lab');
const planRoot = 'work/flow-static-link-textarea-publication-plan-next';
const prefix = 'products/rea-studio/apps/flow/results/native-link-textarea-followup';
const pins = {
  'manifest.json': '7fe69cfdd42a44716e31c07b3a65a2ee29634e105acfdb35865bc4e9beb5d7a4',
  'validation.json': '1a8b0eafa6f9a61d15af7339aa19414cf861ec0adf334efdcf2282ff830a36a2',
  'public-source-map.json': 'd02325a6e0143ee58c32472a62e3eb4aa58f2b67ac6fd21950d48a3baf949575',
  'installation-proposals.json': '6f619d3beb2a30539f0940d4869dfbdbe41a2116129999a4151fa6c6f8e58c5a'
};
const expectedEpochs = [
  ['static-link-stage','work/flow-native-link-next',457,'0a03866476a81f83762bdfc10d65be639c24f25778b6c03fdac5b9ee906bea5d',['manifest.json','freeze.json']],
  ['textarea-correction','work/flow-native-textarea-normalization-fix-next',197,'70c19b06ecca7b79a9461cb53680429cee2bdc91e022c5015fdf19b258f69ce9',['manifest.json','freeze.json']],
  ['independent-model-review','work/flow-native-textarea-normalization-independent-review',64,'d96e755f491a5747ede7b612213ecaa12657c1f01dcfd7d55721e3110ec2ca78',['manifest.json']],
  ['root-static-review','work/root-flow-link-review-preservation-next',38,'fd3fbb1e3b20cd0d4e21b996717c71e3dab5b504759ec30958488897d06efaaa',['manifest.json']],
  ['root-negative-browser','work/root-flow-link-browser-review-next',28,'bae3c0a14e33e8bdd083a86046c6f1e15c455805d4d8e24f899ba0d0793c5f2b',['manifest.json']],
  ['root-corrected-browser','work/root-flow-corrected-browser-review-next',38,'0ca2b70bfab5f5da6537e0eabd8829e0bbf0d582b4580926b06bc47ed89a5bee',['manifest.json']]
];
const hash = b => crypto.createHash('sha256').update(b).digest('hex');
const identity = b => ({bytes:b.length,sha256:hash(b)});
const observed = new Map();
const checks = [];
const negatives = [];
const read = async (root, rel) => {
  safeRelative(rel);
  const full = path.join(root==='repo'?repo:workspace,root==='repo'?'':root,rel);
  const b = await fs.readFile(full);
  const key = `${root}/${rel}`;
  const row = {root,path:rel,...identity(b)};
  if (observed.has(key)) assert.deepEqual(row,observed.get(key),`Changed during review: ${key}`);
  observed.set(key,row);
  return b;
};
function safeRelative(rel) {
  assert.equal(typeof rel,'string');
  assert(rel.length>0 && !rel.includes('\\') && !path.isAbsolute(rel));
  assert(rel.split('/').every(s=>s && s!=='.' && s!=='..'));
}
const parsed = async (root,rel) => JSON.parse((await read(root,rel)).toString('utf8'));
const match = (b,expected,label) => {
  assert.equal(hash(b),expected.sha256,label+' SHA');
  if (expected.bytes!==undefined) assert.equal(b.length,expected.bytes,label+' bytes');
};
async function walk(root, rel='', skipLocal=false, exclusions=[]) {
  const out=[];
  for(const e of await fs.readdir(path.join(workspace,root,rel),{withFileTypes:true})) {
    const p=rel?`${rel}/${e.name}`:e.name;
    if(exclusions.includes(p) || (skipLocal && e.name==='.local')) continue;
    assert(!e.isSymbolicLink(),`Link not allowed: ${root}/${p}`);
    if(e.isDirectory()) out.push(...await walk(root,p,skipLocal,exclusions));
    else { assert(e.isFile()); out.push(p); }
  }
  return out.sort();
}
async function strictEpoch(root,manifest,sidecars,count,skipLocal=false) {
  const j=await parsed(root,manifest);
  assert.equal(j.inventory.length,count);
  assert.equal(new Set(j.inventory.map(r=>r.path)).size,count);
  for(const r of j.inventory) match(await read(root,r.path),r,`${root}/${r.path}`);
  const files=await walk(root,'',skipLocal,j.excludedPrivate??[]);
  assert.deepEqual(files,[...j.inventory.map(r=>r.path),...sidecars].sort(),`Strict epoch census ${root}`);
  return j;
}
function check(name,details={}) {checks.push({name,accepted:true,...details});console.log(JSON.stringify(checks.at(-1)));}
function reject(name,fn) {let caught=false;try{fn();}catch(e){caught=true;negatives.push({name,rejected:true,error:e.message});}assert(caught,`Negative accepted: ${name}`);}
function validateMap(rows,expected) {
  assert.equal(rows.length,expected.size);
  const publicSeen=new Set(),sourceSeen=new Set();
  for(const r of rows) {
    safeRelative(r.sourcePath); safeRelative(r.sourceRoot); safeRelative(r.publicPath);
    assert.equal(r.publicPath,`${prefix}/${r.epoch}/frozen/${r.sourcePath}.snapshot`);
    assert(!r.publicPath.split('/').some(p=>['.local','node_modules','tooling'].includes(p)));
    assert(!/\.(?:tgz|exe|zip|dll)(?:\.snapshot)?$/i.test(r.publicPath));
    assert.equal(r.inert,true);assert.equal(r.originalExecutable,false);
    const key=`${r.sourceRoot}/${r.sourcePath}`;
    assert(!publicSeen.has(r.publicPath));assert(!sourceSeen.has(key));
    publicSeen.add(r.publicPath);sourceSeen.add(key);
    assert.deepEqual({bytes:r.bytes,sha256:r.sha256},expected.get(key));
  }
}
function reverse(text,edits) {
  for(const e of [...edits].reverse()) {
    if(e.appendOnly) { assert(text.endsWith(e.after));text=text.slice(0,-e.after.length); }
    else { assert.equal(text.split(e.after).length-1,e.occurrences??1);text=text.replace(e.after,e.before); }
  }
  return Buffer.from(text,'utf8');
}
function resolveDocLinks(text,destination,available) {
  let count=0;
  for(const m of text.matchAll(/\[[^\]]*\]\(([^)]+)\)/g)) {
    const url=m[1];if(/^(?:https?:|#|mailto:)/.test(url))continue;
    const rel=decodeURIComponent(url.split('#')[0]);
    const target=path.posix.normalize(path.posix.join(path.posix.dirname(destination),rel));
    assert(available.has(target),`Missing document link: ${destination} -> ${url} (${target})`);count++;
  }
  return count;
}

const start = new Date().toISOString();
let failure = null;
let details = {};
try {
