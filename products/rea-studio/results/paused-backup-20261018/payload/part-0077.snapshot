      "syntaxRole": "table-row",
      "sourceText": "| `allowed_organizations`      | No       | Yes                | List of comma- or space-separated Azure tenant identifiers. The user should be a member of at least one tenant to log in.                                                                                                                                                                                                                                                                                                                                                                       |                                                    |",
      "headingPath": [
        "Configure Google OAuth authentication",
