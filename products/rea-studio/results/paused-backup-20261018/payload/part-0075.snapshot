    {
      "id": "grafana.candidate.944cb560fd863ff8aaaf",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The data source health check validates both metrics and logs permissions. If your IAM policy only grants access to one of these (for example, metrics-only or logs-only), the health check displays a red status. However, the service you have permissions for is still usable—you can query metrics or logs based on whichever permissions are configured.",
      "headingPath": [
        "Troubleshoot Amazon CloudWatch data source issues"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/troubleshooting/index.md",
        "gitBlobSha": "beaeae2cfe415b08e86f250d421cb38d035fbede",
        "sha256": "79b4e209733bce22ae7957e88f953312e123bcebdda66984b637a9800c34625b",
        "lineStart": 29,
        "lineEnd": 29,
