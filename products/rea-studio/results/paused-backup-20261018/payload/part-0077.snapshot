    },
    {
      "id": "grafana.candidate.010adecec363facaa777",
      "syntaxRole": "list-item",
      "sourceText": "- You need to rotate or replace a compromised token.",
      "headingPath": [
        "Plan your IAM integration strategy",
        "Access to external systems",
        "Service accounts",
        "Service account tokens"
      ],
      "source": {
