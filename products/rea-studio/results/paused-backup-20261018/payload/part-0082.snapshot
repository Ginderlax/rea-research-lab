import { readFile, writeFile } from 'node:fs/promises';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { createHash } from 'node:crypto';
import { authored } from './authored.mjs';
const root = path.dirname(fileURLToPath(import.meta.url)), outputRoot = path.resolve(root, '..');
const receipt = JSON.parse(await readFile(path.join(root, 'acquisition.json'), 'utf8'));
if (receipt.verifiedFiles !== 772 || receipt.failures.length) throw new Error('Corpus is incomplete.');
const sha = text => createHash('sha256').update(text).digest('hex');
function frontmatter(lines) {
  const end = lines[0] === '---' ? lines.indexOf('---', 1) : -1, front = end >= 0 ? lines.slice(1, end) : [];
  let products = [], collecting = false, baseIndent;
  for (const line of front) {
    const match = /^(\s*)products:\s*(.*)$/.exec(line);
    if (match) { collecting = true; baseIndent = match[1].length; if (match[2]) products.push(...match[2].replace(/[\[\]"']/g, '').split(',').map(value => value.trim())); continue; }
    if (collecting) { const entry = /^(\s*)-\s+(\w+)\s*$/.exec(line); if (entry && entry[1].length > baseIndent) products.push(entry[2]); else if (line.trim()) collecting = false; }
  }
  const title = front.find(line => /^title:\s*/.test(line))?.replace(/^title:\s*/, '').replace(/^['"]|['"]$/g, '');
  return { end, products, title };
}
function applicability(products, headings, text) {
  const section = headings.join(' > '), contextual = `${section} ${text}`;
  if (products.length && !products.includes('oss')) return { status: 'excluded-by-explicit-document-products', products };
  if (/Grafana (?:Cloud|Enterprise)|(?:Cloud|Enterprise)[ -]only/i.test(section) && !/OSS|open.source/i.test(section)) return { status: 'excluded-by-paid-or-hosted-section-heading', products, restriction: section };
  if (/(?:only available|available only|requires? (?:a|an)? ?(?:Grafana )?Enterprise|Enterprise[ -]only|Cloud[ -]only)/i.test(contextual)) return { status: 'conditional-or-paid-restriction-requires-review', products };
  if (/Grafana (?:Cloud|Enterprise)|\b(?:Cloud|Enterprise)\b/.test(text)) return { status: 'mixed-edition-statement-requires-review', products };
  if (products.includes('oss')) return { status: 'oss-labelled-source-candidate-not-yet-reviewed', products };
  return { status: 'unresolved-no-explicit-oss-products-label', products };
}
function platform(sourcePath) {
  if (/\/installation\/windows\//.test(sourcePath)) return { classification: 'Windows-specific-source', scopeVerified: true };
  if (/\/installation\/mac\//.test(sourcePath)) return { classification: 'macOS-specific-source', scopeVerified: true };
  if (/\/installation\/debian\//.test(sourcePath)) return { classification: 'Debian/Ubuntu-specific-source', scopeVerified: true };
  if (/\/installation\/redhat-rhel-fedora\//.test(sourcePath)) return { classification: 'RedHat/RHEL/Fedora-specific-source', scopeVerified: true };
  if (/\/installation\/suse-opensuse\//.test(sourcePath)) return { classification: 'SUSE/openSUSE-specific-source', scopeVerified: true };
  if (/\/installation\/docker\//.test(sourcePath)) return { classification: 'Docker-specific-source', scopeVerified: true };
  if (/kubernetes|helm/.test(sourcePath)) return { classification: 'Kubernetes/Helm-context-requires-review', scopeVerified: false };
  return { classification: 'platform-scope-not-yet-normalized', scopeVerified: false };
}
const documents = [], candidates = [], contracts = [], headings = [], dependencies = [], referencedUrls = new Map(), loaded = new Map();
function source(record, start, end = start) { return { path: record.path, gitBlobSha: record.gitBlobSha, sha256: record.sha256, lineStart: start, lineEnd: end, url: `${record.url}#L${start}-L${end}` }; }
for (const record of receipt.files) {
  const bytes = await readFile(record.localPath); if (sha(bytes) !== record.sha256) throw new Error(`Corpus hash changed: ${record.path}`);
  const text = bytes.toString('utf8'), lines = text.split(/\r?\n/), metadata = frontmatter(lines); loaded.set(record.path, { record, text, lines, metadata });
  for (const [at, line] of lines.entries()) for (const match of line.matchAll(/https?:\/\/(?:<[^>\s]+>|[^\s<>"')\]])+/g)) { const url = match[0]; if (!referencedUrls.has(url)) referencedUrls.set(url, { url, sourceLocations: [], contentPinnedByThisInventory: false, lexicalReferenceOnly: true, templateAndMarkdownResolution: 'not-completed' }); const entry = referencedUrls.get(url); entry.sourceLocations.push(source(record, at + 1)); }
  let context = [], fence = false, block = [], start = 0, candidateCount = 0, headingCount = 0, includeCount = 0, codeLines = 0;
  function add(statement, first, last, kind) {
    if (statement.length < 12 || !/[A-Za-z]/.test(statement)) return;
    const id = `grafana.candidate.${sha(`${record.path}\0${first}\0${last}\0${statement}`).slice(0,20)}`;
    candidates.push({ id, syntaxRole: kind, sourceText: statement, headingPath: [...context], source: source(record, first, last), applicability: applicability(metadata.products, context, statement), atomicity: 'unreviewed-may-require-splitting-or-deduplication', acceptanceContract: null, verificationStatus: 'not-tested' }); candidateCount++;
  }
  function flush(last) { if (!block.length) return; const paragraph = block.join(' '); if (/\b(?:can|cannot|can't|must|should|supports?|allows?|returns?|provides?|includes?|requires?|only|default|automatically|when|if|select|click|use|configure|set|enable|disable|create|delete|add|remove|save|install|start|export|import|display|query|grant|revoke)\b/i.test(paragraph)) add(paragraph, start + 1, last + 1, 'declarative-or-imperative-paragraph'); block = []; }
