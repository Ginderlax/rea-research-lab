    {
      "id": "grafana.candidate.82758b2002359201e249",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "After lots of testing and user feedback, we removed the beta label from the configuration options in the Field and Override tabs. This release also includes the following feature enhancements.",
      "headingPath": [
        "What's new in Grafana v7.2",
        "Field options are out of beta!"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v7-2.md",
