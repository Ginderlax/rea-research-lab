import test from 'node:test';import assert from 'node:assert/strict';import {randomUUID}from'node:crypto';import fs from'node:fs/promises';import os from'node:os';import path from'node:path';import {spawn}from'node:child_process';
import {handle,dispose} from './server.mjs';import {createStore} from '../../lib/storage.mjs';
const password='Owned synthetic group editor master';
async function fixture(t){const records=new Map(),workspace={root:'owned-group-edit-'+randomUUID()},store={get:async(k,d)=>records.has(k)?structuredClone(records.get(k)):d,set:async(k,v)=>records.set(k,structuredClone(v))},api=(action,input={})=>handle({action,input,store,workspace});t.after(()=>dispose(workspace));await api('create',{password});await api('save',{title:'A',group:'Parent/Selected',password:'Synthetic entry A'});await api('save',{title:'B',group:'Parent/Selected/Deep',password:'Synthetic entry B'});return{records,workspace,store,api};}
async function group(f,name='Selected'){return(await f.api('recycleGroupList')).groups.find(g=>g.name===name)}
test('encrypted group creation/edit survives lock/reopen and updates projected child paths without leaking index notes',async t=>{
 const f=await fixture(t),g=await group(f),created=await f.api('groupCreate',{id:g.id,revision:g.recycleRevision,name:'Empty child',notes:'Synthetic child note'});assert(created.created);assert.equal((await f.api('list')).entries.length,2);let current=await group(f);await f.api('groupSave',{id:current.id,revision:current.recycleRevision,name:'Renamed',notes:'Synthetic private group note'});await f.api('lock');await f.api('unlock',{password});assert.equal((await f.api('list')).entries.find(e=>e.title==='B').group,'Parent/Renamed/Deep');const renamed=await group(f,'Renamed'),read=await f.api('recycleGroupRead',{id:renamed.id,revision:renamed.recycleRevision});assert.equal(read.group.notes,'Synthetic private group note');assert((await f.api('recycleGroupList')).groups.some(g=>g.id===created.id));assert(!JSON.stringify(await f.api('recycleGroupList')).includes('Synthetic private'));assert(!JSON.stringify(f.records.get('vault.database')).includes('Synthetic child note'));
});
test('failed encrypted writes leave create/edit memory and durable bytes untouched with retryable revision',async t=>{
 for(const action of['groupCreate','groupSave']){const f=await fixture(t),g=await group(f),before=structuredClone(f.records.get('vault.database')),real=f.store.set;f.store.set=async()=>{throw new Error('Owned persistence rejection')};await assert.rejects(f.api(action,{id:g.id,revision:g.recycleRevision,name:'Failed name',notes:'Failed note'}),/persistence rejection/);assert.deepEqual(f.records.get('vault.database'),before);assert.equal((await group(f)).recycleRevision,g.recycleRevision);assert.equal((await f.api('list')).entries.find(e=>e.title==='A').group,'Parent/Selected');f.store.set=real;await f.api(action,{id:g.id,revision:g.recycleRevision,name:'Succeeded',notes:''});}
});
test('serialized competing edits reject stale revisions and privately capture queued caller text',async t=>{
 const f=await fixture(t),g=await group(f);let entered,release;const started=new Promise(r=>entered=r),gate=new Promise(r=>release=r),real=f.store.set;f.store.set=async(k,v)=>{entered();await gate;return real(k,v)};const input={id:g.id,revision:g.recycleRevision,name:'Captured name',notes:'Captured notes'},first=f.api('groupSave',input);input.name='Caller mutation';input.notes='Caller notes mutation';await started;const second=f.api('groupCreate',{id:g.id,revision:g.recycleRevision,name:'Stale child',notes:''});release();await first;await assert.rejects(second,/selection changed/);const row=await group(f,'Captured name');assert(row);assert.equal((await f.api('recycleGroupRead',{id:row.id,revision:row.recycleRevision})).group.notes,'Captured notes');assert(!(await f.api('recycleGroupList')).groups.some(g=>g.name==='Stale child'));
});
test('locked, malformed and unsupported editing inputs refuse before writing',async t=>{
 const f=await fixture(t),g=await group(f),before=structuredClone(f.records.get('vault.database'));for(const extra of[{iconId:48},{move:true},{name:undefined},{notes:null},{revision:undefined}])await assert.rejects(f.api('groupSave',{id:g.id,revision:g.recycleRevision,name:'X',notes:'',...extra}));assert.deepEqual(f.records.get('vault.database'),before);await f.api('lock');await assert.rejects(f.api('groupCreate',{id:g.id,revision:g.recycleRevision,name:'X',notes:''}),/locked/);assert.deepEqual(f.records.get('vault.database'),before);
});
test('recycle-bin group editor attempts are rejected without durable change',async t=>{
 const f=await fixture(t),g=await group(f);await f.api('recycleGroupDelete',{id:g.id,revision:g.recycleRevision,confirm:true});const recycled=(await f.api('recycleGroupList',{bin:true})).groups.find(row=>row.id===g.id),before=structuredClone(f.records.get('vault.database'));for(const action of['groupSave','groupCreate'])await assert.rejects(f.api(action,{id:g.id,revision:recycled.recycleRevision,name:'X',notes:''}),/recycled/);assert.deepEqual(f.records.get('vault.database'),before);
});
test('disk store survives actual fresh Node process with empty group and renamed descendants',async t=>{
 const directory=await fs.mkdtemp(path.join(os.tmpdir(),'rea-group-edit-restart-'));t.after(async()=>{assert.equal(path.dirname(directory),path.resolve(os.tmpdir()));assert(path.basename(directory).startsWith('rea-group-edit-restart-'));await fs.rm(directory,{recursive:true,force:true})});const workspace={root:directory},store=await createStore(directory),api=(action,input={})=>handle({action,input,workspace,store});t.after(()=>dispose(workspace));await api('create',{password});await api('save',{title:'Restart A',group:'Parent/Selected',password:'Owned entry'});let g=(await api('recycleGroupList')).groups.find(g=>g.name==='Selected');const created=await api('groupCreate',{id:g.id,revision:g.recycleRevision,name:'Persisted empty',notes:'Persisted notes'});g=(await api('recycleGroupList')).groups.find(g=>g.name==='Selected');await api('groupSave',{id:g.id,revision:g.recycleRevision,name:'Restart renamed',notes:'Owned renamed notes'});dispose(workspace);
 const server=new URL('./server.mjs',import.meta.url).href,storage=new URL('../../lib/storage.mjs',import.meta.url).href,code=`import {handle,dispose} from ${JSON.stringify(server)};import{createStore}from ${JSON.stringify(storage)};const workspace={root:process.argv[1]},store=await createStore(workspace.root),api=(action,input={})=>handle({action,input,workspace,store});await api('unlock',{password:process.argv[2]});console.log(JSON.stringify({groups:(await api('recycleGroupList')).groups,entries:(await api('list')).entries}));dispose(workspace);`,child=spawn(process.execPath,['--input-type=module','-e',code,directory,password],{windowsHide:true}),out=[],err=[];child.stdout.on('data',b=>out.push(b));child.stderr.on('data',b=>err.push(b));const timer=setTimeout(()=>child.kill(),15000),exit=await new Promise(r=>child.on('close',r));clearTimeout(timer);assert.equal(exit,0,Buffer.concat(err).toString());const value=JSON.parse(Buffer.concat(out).toString());assert.equal(value.entries[0].group,'Parent/Restart renamed');assert(value.groups.some(g=>g.id===created.id&&g.name==='Persisted empty'));
});
test('saving an entry after ancestor rename preserves its native group UUID and previous entry history',async t=>{const f=await fixture(t),g=await group(f),A=(await f.api('list')).entries.find(e=>e.title==='A'),before=await f.api('read',{id:A.id});await f.api('groupSave',{id:g.id,revision:g.recycleRevision,name:'Edited ancestor',notes:''});const current=await f.api('read',{id:A.id});assert.equal(current.entry.kdbxGroupId,before.entry.kdbxGroupId);assert.equal(current.entry.group,'Parent/Edited ancestor');await f.api('save',{...current.entry,password:'Owned updated entry A'});const updated=await f.api('read',{id:A.id});assert.equal(updated.entry.kdbxGroupId,before.entry.kdbxGroupId);assert.equal(updated.entry.group,'Parent/Edited ancestor');assert.equal((await f.api('historyList',{id:A.id})).revisions.length,1);const groupAfter=(await f.api('recycleGroupList')).groups.find(row=>row.id===g.id);assert.equal(groupAfter.entryCount,2);});
