          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.8bc18987c63b0fa4b900",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can use links to navigate between commonly-used dashboards or to connect others to your visualizations. Links let you create shortcuts to other dashboards, panels, and even external websites.",
      "headingPath": [
        "Manage dashboard links"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/build-dashboards/manage-dashboard-links/index.md",
        "gitBlobSha": "e53be0570abf82defc56129246dfc97ccfa76701",
        "sha256": "b5cd3221c140c551880b99966f2505f71592a051c006aed1ef8725cb79e31848",
        "lineStart": 31,
        "lineEnd": 31,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/dashboards/build-dashboards/manage-dashboard-links/index.md#L31-L31"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.a45432b793e997884ddb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana supports dashboard links, panel links, and data links. Dashboard links are displayed at the top of the dashboard. Panel links are accessible by clicking the icon next to the panel title.",
      "headingPath": [
        "Manage dashboard links"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/build-dashboards/manage-dashboard-links/index.md",
