        "lineStart": 32,
        "lineEnd": 32,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/data-source-management/teamlbac/configure-teamlbac-for-tempo/index.md#L32-L32"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.233ac5a919aaee7e31d2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "LBAC rules use **attribute selectors**, such as:",
