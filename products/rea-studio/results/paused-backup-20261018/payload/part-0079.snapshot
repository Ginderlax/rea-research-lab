    {
      "id": "grafana.candidate.5cf4f783281a0626cb61",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To control the display of fields inside a nested table&mdash;for example, to apply thresholds, units, or a different cell type&mdash;use [field overrides](#field-overrides) with the **Target fields** option set to **Nested**. For more information, refer to [Apply overrides to nested table fields](#apply-overrides-to-nested-table-fields).",
      "headingPath": [
        "Table",
        "Nested tables"
      ],
