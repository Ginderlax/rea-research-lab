import fs from 'node:fs/promises';import path from 'node:path';import {spawnSync} from 'node:child_process';import assert from 'node:assert/strict';import {here,sha} from './authenticate-original.mjs';
const[mode,quietFrom]=process.argv.slice(2);assert.equal(mode,'--quiet-confirmed','New root quiet authorization required.');const manifestBytes=await fs.readFile(path.join(here,'memory-preflight.control.json')),manifest=JSON.parse(manifestBytes);assert.ok(/^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{3})?Z$/.test(quietFrom)&&Date.parse(quietFrom)>Date.parse(manifest.checkedAt)&&Date.parse(quietFrom)<=Date.now(),'New coordinator quiet timestamp must follow preflight.');
const startedAt=new Date().toISOString(),records=[],orders=[['original','baseline','candidate'],['candidate','original','baseline'],['baseline','candidate','original']],boundNames=['benchmark.mjs','timing-worker.mjs','canonical.mjs','workloads.mjs','authenticate-original.mjs','candidate-baseline.mjs','candidate-wrapper.mjs','selector-algorithm.mjs'],before={};for(const name of boundNames)before[name]=sha(await fs.readFile(path.join(here,name)));
let failure;
try{for(let runNumber=0;runNumber<7;runNumber++)for(const caseName of Object.keys(manifest.expectedFiles))for(const implementation of orders[runNumber%3]){
 const start=new Date().toISOString(),child=spawnSync(process.execPath,['--expose-gc',path.join(here,'timing-worker.mjs'),'measure',implementation,caseName,quietFrom],{encoding:'utf8',timeout:60000,maxBuffer:2*1024*1024,windowsHide:true}),stdout=child.stdout??'',stderr=child.stderr??'',stem='timing-'+implementation+'-'+caseName+'-'+runNumber+'-'+Date.now();
 await fs.writeFile(path.join(here,'results',stem+'.stdout.txt'),stdout,{flag:'wx'});await fs.writeFile(path.join(here,'results',stem+'.stderr.txt'),stderr,{flag:'wx'});const record={runNumber,caseName,implementation,start,completedAt:new Date().toISOString(),exitCode:child.status,signal:child.signal,error:child.error?.message,stdout:{path:'results/'+stem+'.stdout.txt',sha256:sha(stdout)},stderr:{path:'results/'+stem+'.stderr.txt',sha256:sha(stderr)}};records.push(record);assert.equal(child.status,0,'Timing child failed; raw output preserved');record.result=JSON.parse(stdout);assert.equal(record.result.manifestSHA256,sha(manifestBytes));assert.equal(record.result.measurementRun,true);assert.deepEqual(record.result.allImplementationFiles,Object.fromEntries(Object.entries(manifest.implementations).map(([name,binding])=>[name,binding.files])));
}}catch(error){failure=error.message;}
const after={};for(const name of boundNames)after[name]=sha(await fs.readFile(path.join(here,name)));if(JSON.stringify(after)!==JSON.stringify(before))failure??='Timing source changed';
const median=values=>[...values].sort((a,b)=>a-b)[Math.floor(values.length/2)],summary=Object.keys(manifest.expectedFiles).map(caseName=>{const per=role=>records.filter(row=>row.caseName===caseName&&row.implementation===role&&row.result).map(row=>row.result.millisecondsPerCall);return{caseName,implementations:Object.fromEntries(['original','baseline','candidate'].map(role=>{const values=per(role);return[role,{samples:values.length,median:values.length?median(values):null,min:values.length?Math.min(...values):null,max:values.length?Math.max(...values):null}];}))};});
const receipt={schemaVersion:3,checkedAt:new Date().toISOString(),status:failure?'failed':'passed',failure,interval:{start:startedAt,end:new Date().toISOString()},quietFrom,sourceHashesBefore:before,sourceHashesAfter:after,manifestSHA256:sha(manifestBytes),records,summary,allRangesAndRegressionsRetained:true,sequentialFreshChildren:true,samplesPerImplementationAndWorkload:7,expectedChildren:147,timingMeasurementRun:true,loadedAllThreeForTimingCorrectnessChecks:true,memoryIsNotIsolated:true,prospectiveSourceLayoutHypothesis:false,prospectiveAlgorithmHypothesis:false,prospectiveWrapperHypothesis:true,selectedForIntegration:null,fullProductComplete:false,universalSuperiorityEstablished:false},output=path.join(here,'results','paired-control-'+Date.now()+'.json');await fs.writeFile(output,JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({output,status:receipt.status,children:records.length,summary}));if(failure)process.exitCode=1;
