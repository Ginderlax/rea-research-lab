    {
      "id": "grafana.candidate.c0211c01e5877e621f3e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "These tags can be used in the custom query with `${__tags}` variable. This variable interpolates the mapped tags as list in an appropriate syntax for the data source. Only tags present in the span are included. Tags that aren't present are omitted.",
      "headingPath": [
        "Before you begin",
        "Configure a custom query"
      ],
      "source": {
        "path": "docs/sources/shared/datasources/tempo-traces-to-profiles.md",
