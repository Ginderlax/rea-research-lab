    {
      "id": "grafana.candidate.41f6ad5b4d2f28475ed2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For CloudWatch Logs queries, Grafana polls AWS until the query completes or a timeout is reached. During alert evaluation, the timeout defined in the [Grafana configuration file](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-grafana/) takes precedence over the **Query Result Timeout** setting on the data source. Set the configuration timeout high enough for your log queries to finish.",
      "headingPath": [
        "Amazon CloudWatch alerting",
        "CloudWatch Logs timeouts during alert evaluation"
      ],
      "source": {
