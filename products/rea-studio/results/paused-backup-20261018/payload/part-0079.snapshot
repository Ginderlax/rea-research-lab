      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.f5530cdf07013f7ac4b7",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Service accounts are a major evolution for machine access within Grafana. You can create multiple API tokens per service account with independent expiration dates, and temporarily disable a service account without deleting it. These benefits make Service Accounts a more flexible way for Terraform and other apps to authenticate with Grafana. Service accounts also work with [fine-grained access control](/docs/grafana/latest/enterprise/access-control/) in [Grafana Enterprise](/docs/grafana/latest/enterprise/): you can improve security by granting service accounts specific roles to limit the functions they can perform. Service accounts are available in beta; you can try them out by enabling the `service-accounts` [feature toggle](/docs/grafana/v8.5/administration/service-accounts/enable-service-accounts) or, if you use Grafana Cloud, [reaching out to our support team](/orgs/raintank/tickets#) for early access. Learn more about Service Accounts in our [docs](/docs/grafana/latest/administration/service-accounts).",
      "headingPath": [
        "What's new in Grafana v8.5",
        "OSS",
        "Service accounts (beta)"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v8-5.md",
        "gitBlobSha": "15f3fc25db59e3bac75e15217a2aedc351624e69",
        "sha256": "786bd58d8bd4959f301bf1e3d7b428b4f76f342335b19cd744f6500e818040c8",
