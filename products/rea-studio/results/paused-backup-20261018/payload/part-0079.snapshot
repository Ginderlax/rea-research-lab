    {
      "id": "grafana.candidate.f7de4d2b1ae0c28b8beb",
      "syntaxRole": "table-row",
      "sourceText": "| X-axis tick label max length | Sets the maximum length of bar chart labels. Labels longer than the maximum length are truncated, and appended with `...`. This option is available when **Rotate x-axis tick labels** isn't `0`. |",
      "headingPath": [
        "Bar chart",
        "Configuration options",
        "Bar chart options"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/bar-chart/index.md",
