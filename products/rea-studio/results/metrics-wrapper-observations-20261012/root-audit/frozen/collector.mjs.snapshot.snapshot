import assert from 'node:assert/strict';import fs from 'node:fs/promises';import path from 'node:path';import{createHash}from'node:crypto';
const stage=path.join(import.meta.dirname,'metrics-wrapper-measurement-review-next'),measure=path.join(import.meta.dirname,'metrics-wrapper-measurement-next'),destination=path.join(import.meta.dirname,'metrics-wrapper-observations-root-audit'),sha=b=>createHash('sha256').update(b).digest('hex'),read=async file=>JSON.parse(await fs.readFile(file,'utf8'));
await fs.mkdir(destination,{recursive:true});await fs.writeFile(path.join(destination,'collector.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});const startedAtUtc=new Date().toISOString(),manifestBytes=await fs.readFile(path.join(stage,'freeze-manifest.json'));assert.equal(sha(manifestBytes),'7c36f6c5bc33187fe63c34f09a62121cbe4f7f7621b4da335feb283ffb855e18');const manifest=JSON.parse(manifestBytes);await fs.writeFile(path.join(destination,'review-manifest.json.snapshot'),manifestBytes,{flag:'wx'});
async function authenticate(){const found={};async function walk(relative=''){for(const e of(await fs.readdir(path.join(stage,relative),{withFileTypes:true})).sort((a,b)=>a.name<b.name?-1:1)){const name=relative?`${relative}/${e.name}`:e.name;if(e.isDirectory())await walk(name);else{assert.ok(e.isFile());if(name==='freeze-manifest.json')continue;const b=await fs.readFile(path.join(stage,name));found[name]={bytes:b.length,sha256:sha(b)};assert.notEqual(b.subarray(0,2).toString(),'MZ');assert.notEqual(b.subarray(0,2).toString(),'PK');}}}await walk();assert.deepEqual(found,manifest.inventory);assert.equal(Object.keys(found).length,1154);return found;}
const before=await authenticate();await fs.writeFile(path.join(destination,'before.json'),JSON.stringify(before,null,2)+'\n',{flag:'wx'});const receipt=await read(path.join(stage,'measurement-validation.json')),summary=await read(path.join(stage,'recomputed-summary.json')),preservation=await read(path.join(stage,'preservation.json'));assert.equal(sha(await fs.readFile(path.join(stage,'measurement-validation.json'))),'bd84dc28fee7f1c3d90c68ad94b318afa73c54a18fb9f4bc098de61807b15bf9');assert.equal(sha(await fs.readFile(path.join(stage,'recomputed-summary.json'))),receipt.summary.sha256);
const copies=new Map(preservation.copies.map(row=>[path.resolve(row.sourcePath),row]));
async function frozenRaw(relative){const row=copies.get(path.resolve(measure,relative));assert.ok(row,`Retained raw source:${relative}`);const b=await fs.readFile(path.join(stage,row.path));assert.equal(sha(b),row.sha256);assert.equal(b.length,row.bytes);return b;}
const timing=JSON.parse(await frozenRaw('results/paired-control-1791849618749.json')),memory=JSON.parse(await frozenRaw('results/memory-observations-control-1791850160778.json'));assert.equal(timing.records.length,147);assert.equal(memory.samples.length,147);assert.deepEqual(timing.sourceHashesBefore,timing.sourceHashesAfter);assert.deepEqual(memory.sourceHashesBefore,memory.sourceHashesAfter);
const cases=['smallStandard','largeStandard','singlePercentile','allPercentiles','allCalculations','constructedPercentile','adversarialFallbackPercentile'],roles=['original','baseline','candidate'],median=values=>{const sorted=[...values].sort((a,b)=>a-b);return sorted[Math.floor(sorted.length/2)];},near=(a,b)=>assert.ok(Math.abs(a-b)<=512*Number.EPSILON*Math.max(1,Math.abs(a),Math.abs(b)),`Arithmetic mismatch:${a}/${b}`);
function stats(values,record){assert.equal(record.samples,values.length);assert.deepEqual(record.values,values);assert.equal(record.median,median(values));assert.equal(record.min,Math.min(...values));assert.equal(record.max,Math.max(...values));}
let timingChecks=0,memoryChecks=0,observerSamples=0,childNegative=0,pairedNegative=0,nullPercentages=0,statisticChecks=0,rawLogs=0;
const timingIndex=new Map();
for(const row of timing.records){assert.equal(row.exitCode,0);assert.equal(row.signal,null);assert.equal(row.result.loadedReducerImplementations,3);near(row.result.millisecondsPerCall,row.result.elapsedMilliseconds/row.result.iterations);for(const file of [row.stdout,row.stderr]){const b=await frozenRaw(file.path);assert.equal(sha(b),file.sha256);rawLogs++;if(file===row.stdout){const result=b.toString().trim().split(/\r?\n/).map(line=>JSON.parse(line)).filter(value=>value.kind==='result');assert.equal(result.length,1);assert.deepEqual(result[0],row.result);}}timingChecks+=row.result.comparisons;const key=`${row.caseName}/${row.implementation}/${row.runNumber}`;assert.equal(timingIndex.has(key),false);timingIndex.set(key,row.result.millisecondsPerCall);}
const memoryIndex=new Map();
for(const row of memory.samples){assert.equal(row.code,0);assert.equal(row.signal,null);assert.equal(row.result.loadedReducerImplementations,1);assert.equal(row.pid,row.result.pid);memoryChecks+=row.result.comparisons;const saved=summary.memorySignedPerChildRows.find(r=>r.caseName===row.caseName&&r.implementation===row.implementation&&r.runNumber===row.runNumber);assert.ok(saved);const checkpoints=row.result.checkpoints,byName=Object.fromEntries(checkpoints.map(cp=>[cp.name,cp]));for(const cp of checkpoints)assert.equal(cp.pid,row.pid);const metrics={observedPeakRSSBytes:row.ownedPIDObserver.peakRSS,lifetimePeakRSSBytes:Math.max(...checkpoints.map(cp=>cp.lifetimePeakResidentKiB))*1024,checkpointPeakRSSBytes:Math.max(...checkpoints.map(cp=>cp.rss)),checkpointPeakHeapUsedBytes:Math.max(...checkpoints.map(cp=>cp.heapUsed))};for(const field of ['rss','heapUsed','external','arrayBuffers'])for(const[label,after,before]of[['initialized','afterSelectedInitialization','beforeSelectedImport'],['retained','retainedAfterGC','beforeRetention'],['released','releasedAfterGC','beforeRetention'],['releasedFromWarmBase','releasedAfterGC','warmBase']])metrics[`${label}-${field}-signedBytes`]=byName[after][field]-byName[before][field];assert.deepEqual(metrics,saved.metrics);childNegative+=Object.values(metrics).filter(value=>value<0).length;
 for(const suffix of ['stdout.txt','stderr.txt','observer.txt','observer-errors.txt']){const b=await frozenRaw(`${saved.rawStem}.${suffix}`);rawLogs++;if(suffix==='stdout.txt'){assert.equal(sha(b),row.stdoutSHA256);const result=b.toString().trim().split(/\r?\n/).map(line=>JSON.parse(line)).filter(value=>value.kind==='result');assert.equal(result.length,1);assert.deepEqual(result[0],row.result);}if(suffix==='stderr.txt')assert.equal(sha(b),row.stderrSHA256);if(suffix==='observer.txt'){const samples=b.toString().trim().split(/\r?\n/).filter(Boolean).map(line=>JSON.parse(line));assert.equal(samples.length,row.ownedPIDObserver.samples);for(const sample of samples)assert.equal(sample.pid,row.pid);assert.equal(Math.max(...samples.map(sample=>sample.rss)),row.ownedPIDObserver.peakRSS);observerSamples+=samples.length;}}
 const key=`${row.caseName}/${row.implementation}/${row.runNumber}`;assert.equal(memoryIndex.has(key),false);memoryIndex.set(key,metrics);
}
for(const name of cases){const timingRow=summary.timingSummary.find(row=>row.caseName===name),memoryRow=summary.memorySummary.find(row=>row.caseName===name);assert.ok(timingRow&&memoryRow);for(const role of roles){const times=Array.from({length:7},(_,run)=>timingIndex.get(`${name}/${role}/${run}`));stats(times,timingRow.millisecondsPerCall[role]);statisticChecks++;for(const metric of Object.keys(memoryRow.metricsByImplementation[role])){const values=Array.from({length:7},(_,run)=>memoryIndex.get(`${name}/${role}/${run}`)[metric]);stats(values,memoryRow.metricsByImplementation[role][metric]);statisticChecks++;}}
 for(const control of ['original','baseline']){const cand=timingRow.millisecondsPerCall.candidate.values,base=timingRow.millisecondsPerCall[control].values,paired=cand.map((value,i)=>value-base[i]),pcts=cand.map((value,i)=>(value-base[i])/base[i]*100),record=timingRow.candidateComparedWith[control];stats(paired,record.pairedDifferenceMilliseconds);for(let i=0;i<7;i++)near(pcts[i],record.pairedRatioPercent.values[i]);near(median(pcts),record.pairedRatioPercent.median);near((median(cand)-median(base))/median(base)*100,record.medianRatioPercent);assert.equal(record.candidateSlowerPairs,paired.filter(value=>value>0).length);
  for(const[metric,record]of Object.entries(memoryRow.candidateComparedWith[control])){const a=memoryRow.metricsByImplementation.candidate[metric].values,b=memoryRow.metricsByImplementation[control][metric].values,d=a.map((value,i)=>value-b[i]);stats(d,record.pairedDifferenceBytes);assert.equal(record.medianDifferenceBytes,median(a)-median(b));pairedNegative+=d.filter(value=>value<0).length;const p=a.map((value,i)=>b[i]===0?null:(value-b[i])/b[i]*100);assert.equal(record.pairedPercentChange.missingOrUnavailable,p.filter(value=>value===null).length);nullPercentages+=p.filter(value=>value===null).length;for(let i=0;i<7;i++){if(p[i]===null)assert.equal(record.pairedPercentChange.values[i],null);else near(p[i],record.pairedPercentChange.values[i]);}}
 }}
assert.equal(timingChecks,1323);assert.equal(memoryChecks,1311282);assert.equal(observerSamples,1835);assert.equal(childNegative,20);assert.equal(pairedNegative,849);assert.equal(nullPercentages,686);assert.equal(rawLogs,882);assert.equal(statisticChecks,441);
for(const row of Object.values(receipt.productionBindings)){const b=await fs.readFile(row.sourcePath);assert.equal(sha(b),row.sha256);}for(const row of preservation.publicHistory){const b=await fs.readFile(path.join(import.meta.dirname,'../outputs/rea-research-lab',row.repositoryRelativePath));assert.equal(sha(b),row.sha256);assert.equal(row.publicationCommit,'455ab6c46461981e6e4331ba5612d5362bf4ad22');assert.equal(row.fullTreeRecopied,false);}
for(const name of ['candidateIntegrated','performanceAcceptance','fullPerformanceNonRegressionEstablished','universalSuperiorityEstablished','fullParityEstablished','fullProductComplete','causalWrapperCompilerAttributionEstablished'])assert.equal(receipt[name],false);
const after=await authenticate();assert.deepEqual(after,before);await fs.writeFile(path.join(destination,'after.json'),JSON.stringify(after,null,2)+'\n',{flag:'wx'});const result={schema:'rea-independent-metrics-wrapper-observation-audit/v1',startedAtUtc,completedAtUtc:new Date().toISOString(),status:'PASS',frozenArtifacts:1154,frozenManifestSHA256:sha(manifestBytes),stageReceiptSHA256:manifest.receiptSHA256,allBeforeAfterHashesExact:true,timingChildren:147,memoryChildren:147,timingPacketChecks:timingChecks,memoryPacketChecks:memoryChecks,rawLogsAuthenticatedAndRead:rawLogs,numericPIDObserverSamples:observerSamples,negativeSignedChildValues:childNegative,negativePairedMemoryValues:pairedNegative,unavailableZeroControlPercentages:nullPercentages,recomputedAggregateStatistics:statisticChecks,allSevenWorkloads:true,currentMetricsProductionFilesExact:5,priorPublicManifestBindingsExact:2,priorPublicFullTreesRecopied:false,newMeasurements:0,newReducerCalls:0,sourceEdits:0,processIdentityBeyondNumericPIDVerified:false,samplingAllRSSSpikesCaptured:false,machineIsolation:false,candidateAccepted:false,candidateIntegrated:false,fullParity:false,universalSuperiority:false,lookupFailure:'An initial root lookup guessed a nonexistent .observer.stdout.txt suffix. Correct .observer.txt path was discovered by file listing. Tool error only; no source/measurement changes or standalone raw error capture.'};await fs.writeFile(path.join(destination,'validation.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:'PASS',frozenArtifacts:1154,rawLogs,statisticChecks,receiptSHA256:sha(Buffer.from(JSON.stringify(result,null,2)+'\n'))}));
