// Reversible evidence-filing correction only. Preserve the complete original candidate.
import assert from 'node:assert/strict';import fs from 'node:fs';import path from 'node:path';import{createHash}from'node:crypto';
const work=import.meta.dirname,original=path.join(work,'cloud-followup-6301492-public-next'),destination=path.join(work,'cloud-followup-6301492-public-r2-next');
const hash=b=>createHash('sha256').update(b).digest('hex'),identity=b=>({bytes:b.length,sha256:hash(b)});
const authorityBytes=fs.readFileSync(path.join(original,'copy-authority.json'));assert.equal(hash(authorityBytes),'bcc1856d03fd6a00085f936656989987b3fe9ee1063db83cc7483d63539019d8');const authority=JSON.parse(authorityBytes);
assert(!fs.existsSync(destination));const publicRoot=path.join(destination,'public-candidate');
for(const row of authority.rows){assert(!row.path.includes('..')&&!row.path.includes('\\')&&!path.isAbsolute(row.path));const source=path.join(original,'public-candidate',row.path),raw=fs.readFileSync(source);assert.deepEqual(identity(raw),{bytes:row.bytes,sha256:row.sha256});const target=path.join(publicRoot,row.path);fs.mkdirSync(path.dirname(target),{recursive:true});fs.writeFileSync(target,raw,{flag:'wx'});}
const prefix=authority.prefix,root=path.join(publicRoot,prefix),file=path.join(root,'archive-browser-failed/preservation-manifest.json'),before=fs.readFileSync(file),manifest=JSON.parse(before);
assert.equal(hash(before),'9fd33db11c7e377e6aaf45c5d2fe7b8473feeea1b4a6dec951598babac43d646');assert(manifest.failure.includes('disabled format control'));
manifest.failure='The first scenario times out because its exact getByLabel selector does not find the Archive format combobox, which the actual accessibility snapshot shows enabled. The replacement Playwright worker then receives EEXIST opening browser-observation.json. Two scenarios fail and four do not run. The first fixture closes its actual server; one failed-case observation and screenshots are retained. No archive UI acceptance is established.';
manifest.descriptionCorrection={priorPublicCandidateAuthoritySHA256:hash(authorityBytes),priorManifest:{bytes:before.length,sha256:hash(before)},reason:'Independent source review checked the actual failed accessibility snapshot. The format combobox was enabled; the old exact label locator did not match. No receipt, result, artifact payload or test count changes.',historicalAttemptRebound:false};
const collector=fs.readFileSync(import.meta.filename),collectorName='payload/'+hash(collector)+'.snapshot';fs.writeFileSync(path.join(root,'archive-browser-failed',collectorName),collector,{flag:'wx'});manifest.records.push({sourcePath:'readers/correct-public-failure-wording-r2.mjs',path:collectorName,...identity(collector),storage:{encoding:'identity',...identity(collector)},nativePNG:false});manifest.uniquePublicObjects++;manifest.storedBytes+=collector.length;
const after=Buffer.from(JSON.stringify(manifest,null,2)+'\n');fs.writeFileSync(file,after);
const indexFile=path.join(root,'preservation-index.json'),index=JSON.parse(fs.readFileSync(indexFile)),entry=index.capsules.find(row=>row.name==='archive-browser-failed');Object.assign(entry,identity(after),{records:manifest.records.length,objects:manifest.uniquePublicObjects,storedPayloadBytes:manifest.storedBytes});index.descriptionCorrection='Archive locator failure attribution corrected against actual enabled-combobox accessibility snapshot; prior work-only candidate preserved unchanged.';fs.writeFileSync(indexFile,JSON.stringify(index,null,2)+'\n');
const rows=[];function walk(dir){for(const item of fs.readdirSync(dir,{withFileTypes:true})){const filename=path.join(dir,item.name);assert(!item.isSymbolicLink());if(item.isDirectory())walk(filename);else rows.push({path:path.relative(publicRoot,filename).replaceAll('\\','/'),...identity(fs.readFileSync(filename))});}}walk(publicRoot);const bytes=rows.reduce((s,row)=>s+row.bytes,0);assert(bytes<=4*1024*1024);
const next={...authority,createdAt:new Date().toISOString(),publicCandidate:publicRoot,files:rows.length,bytes,rows,priorCandidate:{path:original,copyAuthoritySHA256:hash(authorityBytes),preservedUnchanged:true},correction:'Factual locator diagnosis wording only, plus the exact reviewer-owned correction source. All failed receipts and original uploaded artifact bytes remain unchanged.'};fs.writeFileSync(path.join(destination,'copy-authority.json'),JSON.stringify(next,null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({destination,files:rows.length,bytes,archiveManifest:identity(after),copyAuthority:identity(fs.readFileSync(path.join(destination,'copy-authority.json'))),priorCandidateUnchanged:true,activeRepositoryChanged:false,localProductExecutions:0}));
