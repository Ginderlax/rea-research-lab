    },
    {
      "id": "grafana.candidate.96018c979462ffc8fe1d",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To connect to Redis over TLS, use a `rediss://` connection URL as the engine address:",
      "headingPath": [
        "Set up Grafana Live",
        "Configure Grafana Live HA setup",
        "Configure Redis Live engine"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/set-up-grafana-live.md",
        "gitBlobSha": "0aa7adff7477bf1c9cc08fa8d9bf3408b5a587b2",
        "sha256": "6a26e75e2110d530ee4277995d1c57bed1fd7312df4d2c2e40d2e5bafd3b9eab",
        "lineStart": 280,
        "lineEnd": 280,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/set-up-grafana-live.md#L280-L280"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.0e394fe13e0be35458dc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The `redis://` scheme is also supported. Both schemes accept credentials and a database number in the URL, for example `redis://username:password@localhost:6379/0`. A password set in the URL (even an explicitly empty one) takes precedence; `ha_engine_password` applies when the URL sets no password. Grafana verifies server certificates against the operating system's trusted certificate authorities; verification cannot be disabled through this setting.",
      "headingPath": [
        "Set up Grafana Live",
        "Configure Grafana Live HA setup",
        "Configure Redis Live engine"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/set-up-grafana-live.md",
        "gitBlobSha": "0aa7adff7477bf1c9cc08fa8d9bf3408b5a587b2",
        "sha256": "6a26e75e2110d530ee4277995d1c57bed1fd7312df4d2c2e40d2e5bafd3b9eab",
        "lineStart": 288,
        "lineEnd": 288,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/set-up-grafana-live.md#L288-L288"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
