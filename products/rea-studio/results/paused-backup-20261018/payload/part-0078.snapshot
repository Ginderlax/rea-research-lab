    {
      "id": "grafana.candidate.214390a509d16ab69721",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Toggle the **Series visibility** switch on to add the corresponding filter control next to or above the legend. This lets you narrow the visible series by name or by label without editing the query, which is useful when a panel renders many series and you want to focus on a subset.",
      "headingPath": [
        "Configure a legend",
        "Legend options",
        "Series visibility"
      ],
      "source": {
