import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath}from'node:url';import {createHash}from'node:crypto';import {spawn}from'node:child_process';
const own=path.dirname(fileURLToPath(import.meta.url)),app=path.join(own,'products/rea-studio/apps/vault'),[name,...tests]=process.argv.slice(2);if(!/^[a-z0-9-]+$/.test(name??'')||!tests.length||tests.some(t=>!/^[-a-z0-9.]+\.test\.mjs$/.test(t)))throw new Error('Finite owned run name/test roster required.');
const out=path.join(own,'runs',name);await fs.mkdir(out,{recursive:false});const hash=b=>createHash('sha256').update(b).digest('hex');
async function census(snapshot){const list=[];for(const name of(await fs.readdir(app,{withFileTypes:true})).filter(f=>f.isFile()).map(f=>f.name).sort()){const b=await fs.readFile(path.join(app,name));list.push({path:'products/rea-studio/apps/vault/'+name,bytes:b.length,sha256:hash(b)});if(snapshot){await fs.mkdir(path.join(out,'source'),{recursive:true});await fs.writeFile(path.join(out,'source',name+'.snapshot'),b);}}return list;}
const before=await census(true),collector=await fs.readFile(fileURLToPath(import.meta.url));await fs.writeFile(path.join(out,'source/run.mjs.snapshot'),collector);const startedAt=new Date().toISOString(),env={...process.env,GROUP_EDIT_OBSERVATIONS:path.join(out,'observations'),GROUP_OBSERVATIONS:path.join(out,'observations/prior-original'),REA_KEEPASS_EXE:path.resolve(own,'../../outputs/rea-research-lab/projects/07-keepass/artifacts/portable/KeePass.exe')};await fs.mkdir(env.GROUP_EDIT_OBSERVATIONS,{recursive:true});const child=spawn(process.execPath,['--test','--test-concurrency=1',...tests.map(t=>path.join(app,t))],{windowsHide:true,env}),chunks={stdout:[],stderr:[]},sizes={stdout:0,stderr:0};let problem=null;const timer=setTimeout(()=>{problem='Finite test deadline180s';child.kill()},180000);for(const channel of['stdout','stderr'])child[channel].on('data',b=>{sizes[channel]+=b.length;if(sizes[channel]>4*1024*1024){problem='Stream bound4MiB';child.kill()}else chunks[channel].push(b)});const exit=await new Promise(r=>child.on('close',(code,signal)=>r({code,signal})));clearTimeout(timer);const stdout=Buffer.concat(chunks.stdout).toString(),summary=Object.fromEntries(['tests','pass','fail','skipped','cancelled','todo'].map(k=>[k,Number(new RegExp('^# '+k+' (\\d+)$','m').exec(stdout)?.[1]??NaN)])),after=await census(false);for(const channel of['stdout','stderr'])await fs.writeFile(path.join(out,channel+'.txt'),Buffer.concat(chunks[channel]));const receipt={schema:'rea-vault-group-edit-attempt/v1',name,startedAt,finishedAt:new Date().toISOString(),tests,exit,problem,summary,before,after,sourceStable:JSON.stringify(before)===JSON.stringify(after),collector:{path:'run.mjs',bytes:collector.length,sha256:hash(collector)},limits:{deadlineMs:180000,perStreamBytes:4194304}};await fs.writeFile(path.join(out,'run.json'),JSON.stringify(receipt,null,2)+'\n');process.stdout.write(stdout);process.stderr.write(Buffer.concat(chunks.stderr));console.log(JSON.stringify({name,summary,sourceStable:receipt.sourceStable,exit}));process.exitCode=exit.code===0&&receipt.sourceStable&&Object.values(summary).every(Number.isFinite)&&summary.fail===0&&summary.skipped===0&&summary.cancelled===0&&summary.todo===0&&!problem?0:1;
