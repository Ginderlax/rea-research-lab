    },
    {
      "id": "grafana.candidate.3f5df7912ace28c79ab5",
      "syntaxRole": "list-item",
      "sourceText": "- We have removed the deprecated `/api/tsdb/query` metrics endpoint. Use `/api/ds/query` instead [PR #49916](https://github.com/grafana/grafana/pull/49916)",
      "headingPath": [
        "What's new in Grafana v9.0",
        "Breaking changes",
        "Plugins: Most relevant breaking changes"
