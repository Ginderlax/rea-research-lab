const prefix='products/rea-studio/results/vault-group-recycle-reviewed-installation-20261013/source-proof/';
async function currentPlan(){const raw=await fs.readFile(path.join(stage,'manifest.json'));assert.equal(id(raw).sha256,'8a575dd9610bf71a6b81169314d45b023aaff96f629a9648d4af9df5222d9521');const m=JSON.parse(raw);assert.equal(m.schema,'rea-strict-work-review/v1');assert.equal(m.files,325);assert.equal(m.inventory.length,325);assert.deepEqual((await tree(stage)).sort(),[...m.inventory.map(r=>r.path),'manifest.json'].sort());const seen=new Set();for(const r of m.inventory){safe(r.path);assert(!seen.has(r.path));seen.add(r.path);assert.deepEqual(id(await fs.readFile(path.join(stage,r.path))),{bytes:r.bytes,sha256:r.sha256},r.path);}return{manifest:id(raw),rows:m.inventory};}
function validateMap(map,bytesByPath){assert.equal(map.schema,'rea-vault-group-source-preservation/v1');assert.equal(map.fullProductParity,false);assert.equal(map.universalSuperiority,false);assert.equal(map.historicalReceiptsRebound,false);assert.equal(map.originalExecutableBytesPublic,0);assert.equal(map.originalArchiveBytesPublic,0);assert.equal(map.privateSessionTokensPublic,0);assert.equal(map.records.length,1703);assert.equal(map.sourceAliases,1703);assert.equal(map.payloads.length,316);assert.equal(map.uniquePublicPayloads,316);assert.equal(map.epochs.length,10);const payloads=new Map(),used=new Set(),keys=new Set();for(const row of map.payloads){assert.equal(row.path,prefix+'payload/'+row.sha256+'.snapshot');assert.match(row.sha256,/^[a-f0-9]{64}$/);assert(!payloads.has(row.path));const b=bytesByPath.get(row.path);assert(b);assert.deepEqual(id(b),{bytes:row.bytes,sha256:row.sha256});assert(Buffer.from(b.toString('utf8')).equals(b));assert(!/^(4d5a|7f454c46|504b0304|1f8b|377abcaf271c|03d9a29a|28b52ffd)/.test(b.subarray(0,8).toString('hex')));payloads.set(row.path,row);}for(const row of map.records){safe(row.sourcePath);assert(pins.some(p=>p[0]===row.epoch));const key=row.epoch+'\0'+row.sourcePath;assert(!keys.has(key));keys.add(key);const p=payloads.get(row.publicPath);assert(p);assert.deepEqual({bytes:row.bytes,sha256:row.sha256},{bytes:p.bytes,sha256:p.sha256});used.add(row.publicPath);}assert.equal(used.size,payloads.size);return{aliases:keys.size,payloads:payloads.size,used:used.size};}
try{
 await save('collector.mjs.snapshot',await fs.readFile(import.meta.filename));const before=await currentPlan();await save('plan-before.json',json(before));
 const proofRaw=await fs.readFile(path.join(stage,'source-proof/preservation-manifest.json')),proof=JSON.parse(proofRaw),planRaw=await fs.readFile(path.join(stage,'installation-plan.json')),plan=JSON.parse(planRaw);
 assert.deepEqual(id(proofRaw),{bytes:817242,sha256:'01fa9054914e8fda1a206a3a649fa2c2b9206551361f632dbcdf7bc84511403d'});await save('source/preservation-manifest.json.snapshot',proofRaw);await save('source/installation-plan.json.snapshot',planRaw);await save('source/plan-manifest.json.snapshot',await fs.readFile(path.join(stage,'manifest.json')));
