    },
    {
      "id": "grafana.candidate.a1322d6ad3ceaac6d0cd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Not all data sources have the same configuration settings, only the most common ones are fields in the data source provisioning file. To provision the rest of a data source's settings, include them as JSON in the `jsonData` field.",
      "headingPath": [
        "Provision Grafana",
