        "lineStart": 466,
        "lineEnd": 466,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-grafana/enterprise-configuration/index.md#L466-L466"
      },
      "applicability": {
        "status": "excluded-by-explicit-document-products",
        "products": [
          "enterprise"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
