for k in('originalFullApplicationExecutions','originalDatabaseExecutions','originalGuiExecutions'):assert fo[k]==0
fa=json.loads(finite['new-todo-finite-attempt.json']);assert fa['command']==fa['children'][0]['command'] and fa['children'][0]['exitCode']==0 and fa['children'][0]['closeObserved'] and fa['productTests']==111
assert fa['command'][1:4]==['--test','--test-reporter=tap','--test-concurrency=1'] and fa['command'][4:]==bundle['fixedTests']
browser=all_data['browser'];cases=[json.loads(raw)for n,raw in browser.items()if n.startswith('case-')and n.endswith('.json')]
