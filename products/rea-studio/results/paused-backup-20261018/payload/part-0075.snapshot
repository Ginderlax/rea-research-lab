    {
      "id": "grafana.candidate.c05791cbde5fea63413f",
      "syntaxRole": "table-row",
      "sourceText": "| `$__timeFilter()`               | Expands to `timestamp ≥ datetime(2018-06-05T18:09:58.907Z) and timestamp ≤ datetime(2018-06-05T20:09:58.907Z)`, where the from and to date-time values are from the Grafana time picker.                                                                                                                                                                                                                                                                                          |",
      "headingPath": [
        "Azure Monitor query editor",
        "Query Azure Resource Graph",
        "Use macros in Resource Graph queries"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/query-editor/index.md",
        "gitBlobSha": "7e9d70541f1e4e273a619ba9e62b5958327ea3ee",
        "sha256": "06c986577af5c0ca3965b3815e378dc6ecf5d82a71accceca9354c5baeafb011",
        "lineStart": 392,
        "lineEnd": 392,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/azure-monitor/query-editor/index.md#L392-L392"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.ab8683255a180516d195",
      "syntaxRole": "table-row",
      "sourceText": "| `$__timeFilter(datetimeColumn)` | Expands to `datetimeColumn ≥ datetime(2018-06-05T18:09:58.907Z) and datetimeColumn ≤ datetime(2018-06-05T20:09:58.907Z)`, where the from and to date-time values are from the Grafana time picker.                                                                                                                                                                                                                                                                                |",
      "headingPath": [
        "Azure Monitor query editor",
        "Query Azure Resource Graph",
        "Use macros in Resource Graph queries"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/query-editor/index.md",
        "gitBlobSha": "7e9d70541f1e4e273a619ba9e62b5958327ea3ee",
        "sha256": "06c986577af5c0ca3965b3815e378dc6ecf5d82a71accceca9354c5baeafb011",
        "lineStart": 393,
        "lineEnd": 393,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/azure-monitor/query-editor/index.md#L393-L393"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.f35acb6ed364f10a1361",
      "syntaxRole": "table-row",
      "sourceText": "| `$__timeFrom()`                 | Returns the start of the dashboard time range from the Grafana picker. Example: `datetime(2018-06-05T18:09:58.907Z)`.                                                                                                                                                                                                                                                                                                                                                             |",
      "headingPath": [
        "Azure Monitor query editor",
        "Query Azure Resource Graph",
        "Use macros in Resource Graph queries"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/query-editor/index.md",
        "gitBlobSha": "7e9d70541f1e4e273a619ba9e62b5958327ea3ee",
        "sha256": "06c986577af5c0ca3965b3815e378dc6ecf5d82a71accceca9354c5baeafb011",
        "lineStart": 394,
        "lineEnd": 394,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/azure-monitor/query-editor/index.md#L394-L394"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.bbcb8114cf9eafc7b0cd",
      "syntaxRole": "table-row",
      "sourceText": "| `$__timeTo()`                   | Returns the end of the dashboard time range from the Grafana picker. Example: `datetime(2018-06-05T20:09:58.907Z)`.                                                                                                                                                                                                                                                                                                                                                               |",
      "headingPath": [
        "Azure Monitor query editor",
        "Query Azure Resource Graph",
        "Use macros in Resource Graph queries"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/query-editor/index.md",
        "gitBlobSha": "7e9d70541f1e4e273a619ba9e62b5958327ea3ee",
        "sha256": "06c986577af5c0ca3965b3815e378dc6ecf5d82a71accceca9354c5baeafb011",
        "lineStart": 395,
        "lineEnd": 395,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/azure-monitor/query-editor/index.md#L395-L395"
      },
