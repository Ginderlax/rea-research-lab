    },
    {
      "id": "grafana.candidate.62b92597f12bae250eea",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Enabling this flag does not retroactively validate existing contact points. Admins should manually audit existing contact points after enabling this setting to ensure all recipients are org members.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[unified_alerting]`",
