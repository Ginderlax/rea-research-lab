    {
      "id": "grafana.candidate.a4c887ab421717915e88",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You can configure the data source using either the data source interface in Grafana or using a configuration file. This page explains how to set up and enable the data source capabilities using Grafana.",
