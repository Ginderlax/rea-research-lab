    {
      "id": "grafana.candidate.3e6ccba2311dd83e6ab3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "> You can disable PKCE in Grafana by setting `use_pkce` to `false` in the`[auth.azuread]` section.",
      "headingPath": [
