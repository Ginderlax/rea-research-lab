    {
      "id": "grafana.candidate.1a4d5767b5691e56ae9c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Manage your alerting resources using configuration files that can be version controlled. When Grafana starts, it provisions the resources defined in your configuration files. [Provisioning](ref:provisioning) can create, update, or delete existing resources in your Grafana instance.",
      "headingPath": [
        "Use configuration files to provision alerting resources"
      ],
      "source": {
        "path": "docs/sources/alerting/set-up/provision-alerting-resources/file-provisioning/index.md",
