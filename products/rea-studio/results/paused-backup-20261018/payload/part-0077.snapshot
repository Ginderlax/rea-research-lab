    {
      "id": "grafana.candidate.570791c0146d508b490e",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The dashboard count threshold assumes roughly 10-20 panels per dashboard with refresh intervals of 30 seconds or longer. Dashboards with more panels or shorter refresh intervals produce proportionally more query load and should be weighted toward the higher tier. Similarly, the data source count assumes a mix of source types. Deployments that rely heavily on proxied SQL sources should plan for the next tier up.",
      "headingPath": [
        "Install Grafana",
        "Hardware recommendations",
        "Deployment tiers"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/installation/_index.md",
        "gitBlobSha": "0375272bc13891108a61af95a43d5fdbb29272d4",
        "sha256": "d47c19597705e01e7f35bb165ea58a752edc5fc63824e8ae3ba55574a5cf4adb",
        "lineStart": 76,
        "lineEnd": 76,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/installation/_index.md#L76-L76"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.637f9b12f509b94132eb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "These thresholds are starting points. Validate sizing with a load test that reflects your actual dashboard complexity, panel count, and refresh rates before committing to production hardware. Size for your current workload and include headroom for traffic spikes and growth.",
      "headingPath": [
        "Install Grafana",
        "Hardware recommendations",
        "Deployment tiers"
      ],
