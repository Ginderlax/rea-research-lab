    {
      "id": "grafana.candidate.8fb283ae397eecaba3bc",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Enable single-node evaluation mode for alerting in high availability. When enabled, only one Grafana instance in the cluster evaluates alert rules instead of all instances evaluating all rules. This reduces query load on data sources from N times to 1. The default value is `false`.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[unified_alerting]`",
        "`ha_single_node_evaluation`"
      ],
      "source": {
