    {
      "id": "grafana.candidate.4f3132e8db371dc4bebb",
      "syntaxRole": "list-item",
      "sourceText": "- Permission to read and write Grafana folders is added.",
      "headingPath": [
        "Manage RBAC roles",
        "Update role permissions",
        "Update basic role permissions in the configuration file",
        "Example: Modify the Grafana Admin role"
      ],
      "source": {
        "path": "docs/sources/administration/roles-and-permissions/access-control/manage-rbac-roles/index.md",
        "gitBlobSha": "ea0a862bb162a4d71c0f3227505ebaba435602be",
