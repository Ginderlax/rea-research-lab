    },
    {
      "id": "grafana.candidate.5272a74d789b8eb2f3ff",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When you're browsing Grafana - for example, exploring the dashboard and metrics related to an alert - it's easy to end up far from where you started and hard get back to where you came from. The ‘Return to previous’ button is an easy way to go back to the previous context, like the alert rule that kicked off your exploration. This first release works for Alerts, and we plan to expand to other apps and features in Grafana in future releases to make it easier to navigate around.",
      "headingPath": [
        "What’s new in Grafana v10.4",
        "Return to previous"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-4.md",
        "gitBlobSha": "2d82968c8f6eabe7b14bdd8962cbdce219ab422d",
        "sha256": "203895157d3f22d5f55cc7f8125152903f42bace9b6fee1e21cdcd09d4ae1aa3",
        "lineStart": 147,
        "lineEnd": 147,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-4.md#L147-L147"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.a07853ef4a2cf6ab25bd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Return to Previous is rolling out across Grafana Cloud now. To try Return to Previous in self-managed Grafana, turn on the `returnToPrevious` [feature toggle](https://grafana.com/docs/grafana/latest/setup-grafana/configure-grafana/feature-toggles/) in Grafana v10.4 or newer.",
      "headingPath": [
        "What’s new in Grafana v10.4",
        "Return to previous"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-4.md",
        "gitBlobSha": "2d82968c8f6eabe7b14bdd8962cbdce219ab422d",
        "sha256": "203895157d3f22d5f55cc7f8125152903f42bace9b6fee1e21cdcd09d4ae1aa3",
