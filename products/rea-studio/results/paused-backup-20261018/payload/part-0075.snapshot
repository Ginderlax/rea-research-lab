    {
      "id": "grafana.candidate.721a594fd3da115065a3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "With Git Sync you can place synced resources in Grafana in two ways:",
      "headingPath": [
        "Git Sync key concepts",
        "How does Git Sync behave?",
        "Sync targets"
      ],
      "source": {
        "path": "docs/sources/as-code/observability-as-code/git-sync/key-concepts.md",
        "gitBlobSha": "42567b5161bf94b42a306fa4fdb130a74696e7d1",
        "sha256": "a4c77de1b3e14dd2cc3fab3017051ab5602b01b90d5d7d990f7d3539c73769c8",
        "lineStart": 109,
        "lineEnd": 109,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/as-code/observability-as-code/git-sync/key-concepts.md#L109-L109"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss",
          "cloud"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
