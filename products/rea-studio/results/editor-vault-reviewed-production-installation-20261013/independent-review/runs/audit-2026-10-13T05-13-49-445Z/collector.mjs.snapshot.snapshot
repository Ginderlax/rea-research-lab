import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{spawnSync}from'node:child_process';
const here=import.meta.dirname,work=path.resolve(here,'..'),workspace=path.resolve(work,'..'),lab=path.join(workspace,'outputs/rea-research-lab'),stage=path.join(work,'vault-group-publication-plan-next');
const id=b=>({bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}),json=v=>Buffer.from(JSON.stringify(v,null,2)+'\n');
const run='runs/audit-'+new Date().toISOString().replace(/[:.]/g,'-'),base=path.join(here,run);async function save(p,b){await fs.mkdir(path.dirname(path.join(base,p)),{recursive:true});await fs.writeFile(path.join(base,p),b,{flag:'wx'});}
function safe(p){assert(typeof p==='string'&&p&&!path.isAbsolute(p)&&!path.win32.isAbsolute(p)&&!/[\\:\x00-\x1f]/.test(p));assert(p.split('/').every(s=>s&&s!=='.'&&s!=='..'));}
async function tree(root,prefix=''){const list=[];for(const e of await fs.readdir(root,{withFileTypes:true})){assert(!e.isSymbolicLink());const p=prefix+e.name;if(e.isDirectory())list.push(...await tree(path.join(root,e.name),p+'/'));else{assert(e.isFile());list.push(p);}}return list;}
