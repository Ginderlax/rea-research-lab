import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const folder=path.join(import.meta.dirname,'root-flow-corrected-browser-review-next'),seed=JSON.parse(await fs.readFile(path.join(folder,'seed.json'))),sha=b=>createHash('sha256').update(b).digest('hex'),records=[];
for(const [file,target,phase]of [['C:/Users/evanh/Downloads/Owned-static-Link-In-Out-fixture (1).json','browser-downloaded-imported-native.json.snapshot','after real File.text native import; before Save'],['C:/Users/evanh/Downloads/Owned-static-Link-In-Out-fixture (2).json','browser-downloaded-imported-saved-native.json.snapshot','after real File.text native import and unchanged Save']]){const b=await fs.readFile(file),stat=await fs.stat(file);assert(b.equals(Buffer.from(seed.text)));assert.equal(b.length,1812);assert.equal(sha(b),'a3dfefae54ddcdee0f1a86a900cadfacf3a147a02e34c63915b6825a4080fa19');await fs.writeFile(path.join(folder,target),b,{flag:'wx'});records.push({downloadPath:file,phase,bytes:b.length,sha256:sha(b),mtimeUTC:stat.mtime.toISOString(),nativeDownloadEventObserved:true,rawSeedUTF8Exact:true,CRLFPrefixSuffixPreserved:true});}
await fs.writeFile(path.join(folder,'import-download-capture-collector.mjs.snapshot'),await fs.readFile(import.meta.filename),{flag:'wx'});await fs.writeFile(path.join(folder,'import-download-validation.json'),JSON.stringify({at:new Date().toISOString(),actualNativeBrowserFileChooser:true,actualFileTextDecode:true,syntheticOwnedSource:true,records,newOriginalExecutions:0,productionWrites:0},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({actualBrowserImported:true,exactUTF8Downloads:records.length,bytesEach:1812,CRLFExact:true}));
