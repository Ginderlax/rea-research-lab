    {
      "id": "grafana.candidate.33c3d5ac10ef74ffde91",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "When enabled, email contact point recipients are restricted to users that belong to the organization (including disabled users). This validation is applied only when creating or updating contact points, not at notification send time.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[unified_alerting]`",
        "`limit_email_to_org_members`"
      ],
      "source": {
