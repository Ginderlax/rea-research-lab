    "documentationCatalogues": "GET each recursive Git tree API at its exact commit; require truncated=false; apply selectionPredicate; sort paths using JavaScript code-point comparison; hash JSON.stringify(files.map(({path,gitBlobSha,bytes})=>({path,gitBlobSha,bytes}))) as UTF-8; compare inventorySha256 and each Git blob SHA.",
    "localEvidence": "Verify each local evidence path SHA-256. Ignored downloaded component archives remain local; obtain them through the original project acquisition scripts if absent.",
