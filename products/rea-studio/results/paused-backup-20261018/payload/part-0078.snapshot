        "lineStart": 33,
        "lineEnd": 33,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/visualizations/dashboards/build-dashboards/manage-dashboard-links/index.md#L33-L33"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.27f436424d5e3082b633",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Start by figuring out how you're currently navigating between dashboards. If you're often jumping between a set of dashboards and struggling to find the same context in each, links can help optimize your workflow.",
      "headingPath": [
        "Manage dashboard links",
        "Which link should you use?"
      ],
      "source": {
        "path": "docs/sources/visualizations/dashboards/build-dashboards/manage-dashboard-links/index.md",
