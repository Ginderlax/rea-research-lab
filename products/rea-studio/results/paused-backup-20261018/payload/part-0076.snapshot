    },
    {
      "id": "grafana.candidate.357f31acc3cb60b4ac47",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Using the Parca data source, you can embed profiling data in your dashboards alongside other signals like logs and metrics. For example, you can place a [flame graph panel](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/panels-visualizations/visualizations/flame-graph/) showing CPU profiles next to a metrics panel tracking request latency to correlate performance bottlenecks with application behavior.",
      "headingPath": [
        "Parca data source",
        "Integrate profiles into dashboards"
      ],
      "source": {
