    {
      "id": "grafana.candidate.addd44f880afdb37a38b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "`$__rate_interval` is a Grafana-specific variable designed for use with `rate()` and `increase()`. It guarantees a range window large enough to capture at least four scrape samples, preventing gaps or inaccuracies in results.",
      "headingPath": [
        "Prometheus template variables",
        "Use `$__rate_interval`"
      ],
      "source": {
        "path": "docs/sources/datasources/prometheus/template-variables/_index.md",
