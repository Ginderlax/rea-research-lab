import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const own='work/flow-native-link-next',base=process.cwd(),lab=path.join(base,'outputs/rea-research-lab'),sha=b=>createHash('sha256').update(b).digest('hex'),before=JSON.parse(fs.readFileSync(own+'/source-before.json')),acq=JSON.parse(fs.readFileSync(own+'/acquisition.json'));for(const r of before){const b=fs.readFileSync(path.join(lab,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);const old=fs.readFileSync(path.join(own,'before',r.path.replace('products/rea-studio/','')+'.snapshot'));assert.ok(old.equals(b))}for(const p of acq.packages)for(const r of p.sources){const b=fs.readFileSync(path.join(own,r.snapshot)),cache=fs.readFileSync(path.join(lab,'.local/flow-original/node_modules',p.name,r.path));assert.equal(b.length,r.bytes);assert.equal(sha(b),r.sha256);assert.ok(b.equals(cache))}fs.writeFileSync(own+'/initial-authority-check.json',JSON.stringify({schema:'rea-flow-link-authority-check/v1',at:new Date().toISOString(),baseline18Unchanged:true,official8AndInstalledCacheExact:true,acquisitionSHA256:sha(fs.readFileSync(own+'/acquisition.json')),sourceBeforeSHA256:sha(fs.readFileSync(own+'/source-before.json')),preparationDiagnostics:['First read-only attempted runtime path omitted candidate/ prefix, failed without execution; actual paths inventoried before subsequent reads.'],originalExecutions:0,repoWrites:0},null,2)+'\n');console.log(JSON.stringify({baseline:before.length,sourceUnits:acq.officialSourceUnits,cacheExact:true}));
