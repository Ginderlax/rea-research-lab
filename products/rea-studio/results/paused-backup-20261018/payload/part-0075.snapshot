    },
    {
      "id": "grafana.candidate.7f9de632119cbb3c7f44",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Alert instances are grouped together if they have the same exact label values for the labels configured in the `Group by` option.",
      "headingPath": [
        "Group alert notifications",
        "Group notifications"
      ],
      "source": {
        "path": "docs/sources/alerting/fundamentals/notifications/group-alert-notifications.md",
