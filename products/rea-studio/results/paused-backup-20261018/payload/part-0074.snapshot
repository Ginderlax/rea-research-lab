    },
    {
      "id": "grafana.candidate.d5aec1db8ac66cf0c24c",
      "syntaxRole": "list-item",
      "sourceText": "- **Team -** Affects all users assigned to a team. Set by an Organization Admin or Team Admin. To learn more about these roles, refer to [Teams and permissions](../roles-and-permissions/#teams-and-permissions).",
      "headingPath": [
        "Organization preferences"
      ],
      "source": {
