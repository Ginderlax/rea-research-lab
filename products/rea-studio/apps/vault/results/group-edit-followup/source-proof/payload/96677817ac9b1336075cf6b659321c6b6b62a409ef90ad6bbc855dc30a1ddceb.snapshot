import fs from'node:fs/promises';import path from'node:path';import{fileURLToPath}from'node:url';import{createHash}from'node:crypto';
const own=path.dirname(fileURLToPath(import.meta.url)),prior=path.resolve(own,'../keepass-group-active-list-fix-next'),hash=b=>createHash('sha256').update(b).digest('hex'),bytes=await fs.readFile(path.join(prior,'manifest.json'));if(hash(bytes)!=='d24b555cc9f35f4720920d385c97496803e787f69f76caca4af0fcf2b4c4acdd')throw new Error('UI authority mismatch');const manifest=JSON.parse(bytes),bound=[];
for(const row of manifest.inventory.filter(r=>/^products\/rea-studio\/apps\/vault\/[^/]+\.test\.mjs$/.test(r.path)&&!/^(?:app|kdbx|history|unknown-time|recycle|group)-(?:edit|server|original)/.test(path.basename(r.path))&&!['app.test.mjs','app.integration.test.mjs','kdbx.test.mjs','kdbx.interop.test.mjs','history.test.mjs','unknown-time.test.mjs','recycle.test.mjs','group-recycle.test.mjs'].includes(path.basename(r.path)))){const b=await fs.readFile(path.join(prior,row.path));if(b.length!==row.bytes||hash(b)!==row.sha256)throw new Error('Pinned UI test mismatch '+row.path);const dst=path.join(own,'authority/client343/tests',path.basename(row.path)+'.snapshot');await fs.mkdir(path.dirname(dst),{recursive:true});await fs.writeFile(dst,b);await fs.writeFile(path.join(own,row.path),b);bound.push(row)}
await fs.writeFile(path.join(own,'ui-test-baseline.json'),JSON.stringify({schema:'rea-vault-group-edit-ui-test-baseline/v1',sourceManifestSha256:hash(bytes),files:bound,mixed777TestAttempt:'runs/existing-ui-v1/run.json; 23/24 passed, historical same detached control retry expectation differs from343 intentional fresh reconfirmation policy'},null,2)+'\n');console.log(JSON.stringify(bound.map(r=>({path:r.path,bytes:r.bytes,sha256:r.sha256}))));
