    {
      "id": "grafana.candidate.c43347863495fe4d7cdb",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Each production instance includes a paired development instance and a paired test instance. Development and test instances receive the same user count as the production instance they're paired with.",
      "headingPath": [
        "Grafana Enterprise license",
        "Grafana Enterprise license restrictions",
        "Active users limit",
        "Development and test instances"
      ],
      "source": {
        "path": "docs/sources/administration/enterprise-licensing/_index.md",
        "gitBlobSha": "3f209b4f6d26e8686e726eeaaed3d61652d34061",
        "sha256": "9717448c8bca522a70657832fd68c57dc91d7d88d2dd5a0964173e72250aa58b",
        "lineStart": 249,
        "lineEnd": 249,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/enterprise-licensing/_index.md#L249-L249"
      },
      "applicability": {
        "status": "excluded-by-paid-or-hosted-section-heading",
        "products": [
          "enterprise",
          "oss"
        ],
        "restriction": "Grafana Enterprise license > Grafana Enterprise license restrictions > Active users limit > Development and test instances"
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.4500a6f27cfd6ad28f73",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For example, if you have 3 production instances with 60 users allocated to each, then each production instance's paired development and test instances also get 60 users.",
      "headingPath": [
        "Grafana Enterprise license",
        "Grafana Enterprise license restrictions",
        "Active users limit",
        "Development and test instances"
      ],
      "source": {
        "path": "docs/sources/administration/enterprise-licensing/_index.md",
        "gitBlobSha": "3f209b4f6d26e8686e726eeaaed3d61652d34061",
        "sha256": "9717448c8bca522a70657832fd68c57dc91d7d88d2dd5a0964173e72250aa58b",
        "lineStart": 251,
        "lineEnd": 251,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/administration/enterprise-licensing/_index.md#L251-L251"
      },
      "applicability": {
        "status": "excluded-by-paid-or-hosted-section-heading",
        "products": [
          "enterprise",
          "oss"
        ],
        "restriction": "Grafana Enterprise license > Grafana Enterprise license restrictions > Active users limit > Development and test instances"
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.828b409da2cfec6061cd",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Grafana only counts and enforces the _total_ number of active users in your Grafana instance. For example, if you purchase 150 active users, you can have 20 admins, 70 editors, and 60 viewers, or you can have 150 admins. Grafana will enforce the total number of active users even if you use a license that grants a specific number of admins or editors and a certain number of viewers. This is a more permissive policy than before, which gives you the flexibility to change users' roles.",
      "headingPath": [
        "Grafana Enterprise license",
        "Grafana Enterprise license restrictions",
        "Tiered licensing (deprecated)"
      ],
      "source": {
        "path": "docs/sources/administration/enterprise-licensing/_index.md",
        "gitBlobSha": "3f209b4f6d26e8686e726eeaaed3d61652d34061",
        "sha256": "9717448c8bca522a70657832fd68c57dc91d7d88d2dd5a0964173e72250aa58b",
