    },
    {
      "id": "grafana.candidate.c6d83864b2b4cdfdae5f",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you've customized the `forward_settings_to_plugins` setting under `[azure]`, verify that `grafana-azure-monitor-datasource` is included. Refer to [Managed Identity Grafana server configuration](#managed-identity-grafana-server-configuration) for details.",
      "headingPath": [
        "Configure the Azure Monitor data source",
        "Configure authentication",
        "Current User",
        "Current User Grafana server configuration"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/configure/index.md",
        "gitBlobSha": "919384f53d9fafa0c605f03c3a584a26e4d9130a",
        "sha256": "6eb14e0ca3df71ab6d1092349af5a09af935ff0a05b241d8abf6201b518ebbc4",
        "lineStart": 424,
        "lineEnd": 424,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/azure-monitor/configure/index.md#L424-L424"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.b4e817e78eff39274428",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Current User authentication doesn't support backend functionality like alerting, reporting, and recorded queries because user credentials aren't available for background operations.",
      "headingPath": [
        "Configure the Azure Monitor data source",
        "Configure authentication",
        "Current User",
        "Limitations and fallback credentials"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/configure/index.md",
        "gitBlobSha": "919384f53d9fafa0c605f03c3a584a26e4d9130a",
        "sha256": "6eb14e0ca3df71ab6d1092349af5a09af935ff0a05b241d8abf6201b518ebbc4",
        "lineStart": 429,
        "lineEnd": 429,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/azure-monitor/configure/index.md#L429-L429"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.8c723904621536864f96",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To support these features, you must configure **fallback service credentials**, typically an App Registration with client secret. When enabled, Grafana uses the fallback credentials for backend operations. Operations using fallback credentials are limited to the permissions of those credentials, not the user's permissions.",
      "headingPath": [
        "Configure the Azure Monitor data source",
        "Configure authentication",
        "Current User",
        "Limitations and fallback credentials"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/configure/index.md",
        "gitBlobSha": "919384f53d9fafa0c605f03c3a584a26e4d9130a",
        "sha256": "6eb14e0ca3df71ab6d1092349af5a09af935ff0a05b241d8abf6201b518ebbc4",
        "lineStart": 431,
        "lineEnd": 431,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/azure-monitor/configure/index.md#L431-L431"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.6122c8b6d4373d5c58f4",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you use Current User authentication without configuring fallback service credentials, alerting rules, recording rules, and reports fail with authentication errors. Refer to the [alerting documentation](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/datasources/azure-monitor/alerting/) for more details.",
      "headingPath": [
        "Configure the Azure Monitor data source",
        "Configure authentication",
        "Current User",
        "Limitations and fallback credentials"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/configure/index.md",
        "gitBlobSha": "919384f53d9fafa0c605f03c3a584a26e4d9130a",
        "sha256": "6eb14e0ca3df71ab6d1092349af5a09af935ff0a05b241d8abf6201b518ebbc4",
        "lineStart": 434,
        "lineEnd": 434,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/azure-monitor/configure/index.md#L434-L434"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.69c4a948be1a8082d293",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Query and resource caching is disabled by default for data sources using Current User authentication.",
      "headingPath": [
        "Configure the Azure Monitor data source",
        "Configure authentication",
        "Current User",
        "Limitations and fallback credentials"
      ],
      "source": {
        "path": "docs/sources/datasources/azure-monitor/configure/index.md",
