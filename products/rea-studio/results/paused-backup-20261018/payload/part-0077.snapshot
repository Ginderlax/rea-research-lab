    {
      "id": "grafana.candidate.5d70c56d2cf841790296",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Default behavior for the \"Manage alerts via Alerting UI\" toggle when configuring a data source. It only works if the data source's `jsonData.manageAlerts` prop does not contain a previously configured value.",
