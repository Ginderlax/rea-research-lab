    },
    {
      "id": "grafana.candidate.507bd2927159a413b6e1",
      "syntaxRole": "procedural-step",
      "sourceText": "1. Click the arrow next to **Administration** in the left-side menu, click **Users and access**, and select **Teams**.",
      "headingPath": [
        "Administer Grafana Teams",
        "View a list of Teams"
      ],
      "source": {
        "path": "docs/sources/administration/team-management/administering-grafana-teams.md",
