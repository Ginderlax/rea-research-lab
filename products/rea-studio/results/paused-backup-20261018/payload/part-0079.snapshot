    },
    {
      "id": "grafana.candidate.d503842190ed04b523f2",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Not sure where to start? We’ve also updated our **CloudWatch Logs cheat sheet** with the most commonly used queries so you can paste and customize to fit exactly what you need. Clicking on any of the example queries prefills the query input field.",
      "headingPath": [
        "What’s new in Grafana v11.4",
        "Query Cloudwatch Logs Insights with PPL and SQL"
      ],
