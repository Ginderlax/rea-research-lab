    {
      "id": "grafana.candidate.1ecf0ad7b04cba48df50",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "By default, Docker container logs are directed to `STDOUT`, a common practice in the Docker community. You can change this by setting a different [log mode](../configure-grafana/#mode) such as `console`, `file`, or `syslog`. You can use one or more modes by separating them with spaces, for example, `console file`. By default, both `console` and `file` modes are enabled.",
      "headingPath": [
        "Configure a Grafana Docker image",
        "Logging"
      ],
      "source": {
        "path": "docs/sources/setup-grafana/configure-docker.md",
        "gitBlobSha": "d91b83cf21311b97e3e286b7c1efc686959b4b9f",
        "sha256": "c76f5bf33aa9948420698d8a2f35a8495645f0e19c57f16743f2e31ec133f9a7",
        "lineStart": 217,
        "lineEnd": 217,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/setup-grafana/configure-docker.md#L217-L217"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
