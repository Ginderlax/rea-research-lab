    {
      "id": "grafana.candidate.03435781da7742d26d01",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If you're using an older version of Microsoft SQL Server like 2008 or 2008R2, you may need to set Encrypt to **Disable** or **False** to connect.",
