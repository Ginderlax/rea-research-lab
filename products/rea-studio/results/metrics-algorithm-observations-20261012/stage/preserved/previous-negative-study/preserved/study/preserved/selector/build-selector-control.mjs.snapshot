const multi=section(baseline,'  const result = doStandardCalcs(', '\n/** Lossless JSON transport');assert.equal(section(candidate,'  const result = doStandardCalcs(', '\n/** Lossless JSON transport'),multi);assert.equal(candidate.slice(candidate.indexOf('/** Lossless JSON transport')),baseline.slice(baseline.indexOf('/** Lossless JSON transport')));assert.equal(candidate.replace("import { singlePercentile } from './selector-control.mjs';\n",'').replace('function special(',block+'function special('),inline);
for(const [name,source]of Object.entries({'candidate-module-control.mjs':candidate,'selector-control.mjs':helper}))await fs.writeFile(path.join(here,name),source,{flag:'wx'});
const contract={schemaVersion:1,createdAt:new Date().toISOString(),entry:'candidate-module-control.mjs',entrySHA256:sha(candidate),helper:'selector-control.mjs',helperSHA256:sha(helper),baselineSHA256:sha(baseline),inlineComparatorSHA256:sha(inline),sourceGuards:{standardBodySHA256:sha(standard),completeSharedSpecialBodySHA256:sha(special),multiSelectionAndCacheTailSHA256:sha(multi),standardAndSharedBodiesByteIdenticalToBaseline:true,multiSelectionAndCacheTailByteIdenticalToBaseline:true,selectorBodyReexportOnlyByteIdenticalToInlineComparator:true,inlineEntryExactlyReconstructedByRemovingImportAndReinsertingHelper:true},changes:'Static native ESM import replaces inline selector declaration; identical selected-path and direct-registry dispatch. No standard/shared arithmetic, collection, threshold, partition or cache changes.',importsOriginalVendorRuntime:false,hypothesisOnly:true,status:'unvalidated',timingMeasurementRun:false,memoryMeasurementRun:false,selectedForIntegration:null,fullProductComplete:false,universalSuperiorityEstablished:false};await fs.writeFile(path.join(here,'candidate-contract.json'),JSON.stringify(contract,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(contract));
