    {
      "id": "grafana.candidate.d3317898f3b47b783ed3",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In the previous example, SSL is enabled and an encrypted port has been configured. If your Active Directory doesn't support SSL, use `enable_ssl = false` and `port = 389` instead.",
