import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const owned=fileURLToPath(new URL('./',import.meta.url)),stage=fileURLToPath(new URL('../notes-trash-next/',import.meta.url)),hash=b=>createHash('sha256').update(b).digest('hex');
async function identity(p){const b=await fs.readFile(p);return{bytes:b.length,sha256:hash(b)};}
const receipt=await identity(path.join(stage,'trash-validation.final.json')),manifestIdentity=await identity(path.join(stage,'preservation-manifest.json')),freezeIdentity=await identity(path.join(stage,'freeze.json'));assert.equal(receipt.sha256,'f7d210df1eb4312a1de9a8c3d51a63a83b99de9c056964edfcfb525e1b99a9f3');assert.equal(manifestIdentity.sha256,'aaa0b6f1f3fcf3b642e6cf23aec76b7596006cb39d49b073bac55b6af2af563b');const manifest=JSON.parse(await fs.readFile(path.join(stage,'preservation-manifest.json'))),freeze=JSON.parse(await fs.readFile(path.join(stage,'freeze.json')));assert.equal(manifest.records.length,325);assert.deepEqual(receipt,{bytes:freeze.receipt.bytes,sha256:freeze.receipt.sha256});assert.deepEqual(manifestIdentity,{bytes:freeze.manifest.bytes,sha256:freeze.manifest.sha256});
const paths=new Set();for(const row of manifest.records){assert.ok(!paths.has(row.path));paths.add(row.path);assert.ok(!path.isAbsolute(row.path)&&!row.path.split('/').includes('..'));assert.deepEqual(await identity(path.join(stage,row.path)),{bytes:row.bytes,sha256:row.sha256},row.path);}
async function inventory(dir=stage,prefix=''){const result=[];for(const entry of await fs.readdir(dir,{withFileTypes:true})){const p=prefix+entry.name;if(entry.isDirectory()){if(entry.name==='.local')continue;result.push(...await inventory(path.join(dir,entry.name),p+'/'));}else if(!['freeze.json','preservation-manifest.json'].includes(p))result.push(p);}return result;}
assert.deepEqual((await inventory()).sort(),[...paths].sort());for(const row of freeze.implementation)assert.deepEqual(await identity(path.join(stage,row.path)),{bytes:row.bytes,sha256:row.sha256},row.path);assert.deepEqual(await identity(path.join(stage,'trash-validation.final.json')),receipt);assert.deepEqual(await identity(path.join(stage,'preservation-manifest.json')),manifestIdentity);assert.deepEqual(await identity(path.join(stage,'freeze.json')),freezeIdentity);
const result={schema:'rea-notes-frozen-identity-recheck/v1',checkedAt:new Date().toISOString(),stage:'work/notes-trash-next',receipt,manifest:{...manifestIdentity,files:325},freeze:freezeIdentity,strictInventory:true,beforeAfterIdentityStable:true,implementation:freeze.implementation,stageMutated:false,behaviorExecuted:false,scope:'Authentication of my own prior authored Notes stage identity only; not an independent correctness review of that implementation.'};await fs.mkdir(owned,{recursive:true});await fs.writeFile(path.join(owned,'notes-identity.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({pass:true,receipt:receipt.sha256,manifest:manifestIdentity.sha256,freeze:freezeIdentity.sha256,files:325}));
