    {
      "id": "grafana.candidate.34da82bfc36b51ee19c6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "If Prometheus is running locally, use `http://localhost:9090`. If it's hosted on a networked server, provide the server's URL along with the port where Prometheus is running. Example: `http://prometheus.example.orgname:9090`.",
      "headingPath": [
        "Configure the Prometheus data source",
        "Configuration options",
        "Connection"
      ],
      "source": {
        "path": "docs/sources/datasources/prometheus/configure/_index.md",
        "gitBlobSha": "a1a3fd736210bc04f6d5396f44fbd51007b0b737",
        "sha256": "8f55c60524f648dcca948fcbb550ecdf916cf54bf2cc152f1e84db0d2c51c35b",
        "lineStart": 63,
        "lineEnd": 63,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/datasources/prometheus/configure/_index.md#L63-L63"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
