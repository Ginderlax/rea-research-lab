import fs from 'node:fs/promises';import path from 'node:path';import {fileURLToPath} from 'node:url';import {createHash} from 'node:crypto';import {spawnSync} from 'node:child_process';import assert from 'node:assert/strict';
const here=path.dirname(fileURLToPath(import.meta.url)),name=process.argv[2];assert.ok(['prepare-review.mjs','recompute.mjs','preserve-study.mjs','preserve-algorithm.mjs','prepare-outputs.mjs','make-tables.mjs','render-figures.mjs'].includes(name));
const sha=bytes=>createHash('sha256').update(bytes).digest('hex'),source=await fs.readFile(path.join(here,name)),startedAt=new Date().toISOString(),stem='action-'+name.replace('.mjs','')+'-'+Date.now();
const child=spawnSync(process.execPath,[path.join(here,name)],{cwd:here,windowsHide:true,encoding:'utf8',timeout:120000,maxBuffer:2*1024*1024});
for(const [suffix,data]of [['.source.mjs.snapshot',source],['.stdout.txt',child.stdout??''],['.stderr.txt',child.stderr??'']])await fs.writeFile(path.join(here,stem+suffix),data,{flag:'wx'});
const receipt={source:name,startedAt,finishedAt:new Date().toISOString(),sourceSHA256:sha(source),sourceAfterSHA256:sha(await fs.readFile(path.join(here,name))),exitCode:child.status,signal:child.signal,error:child.error?.message??null,stdoutSHA256:sha(child.stdout??''),stderrSHA256:sha(child.stderr??''),measurementWorkloadsExecuted:false};assert.equal(receipt.sourceSHA256,receipt.sourceAfterSHA256);
await fs.writeFile(path.join(here,stem+'.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({attempt:stem,...receipt,stdout:child.stdout,stderr:child.stderr}));if(child.status!==0)process.exitCode=1;
