    },
    {
      "id": "grafana.candidate.9ded49089023abc00106",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "In addition to `Query` and `Edit` access, you can now grant users, teams, or basic roles `Admin` access to data sources. Users with `Admin` access to a data source can grant and revoke permissions to the data source, as well as to manage query caching settings for the data source. Users are automatically granted `Admin` access to data sources that they create.",
      "headingPath": [
        "What’s new in Grafana v10.3",
        "Data sources",
        "Data source Admin permission\\*"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-3.md",
        "gitBlobSha": "e43fdcd331e25519da2fbdea223ad59ec4f7ad4c",
        "sha256": "0e1c94c3c83b280306b5bf6a8543bb3a2707c17132691f3d48d3818f08b029c7",
        "lineStart": 321,
        "lineEnd": 321,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-3.md#L321-L321"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.9785094d8aecd5a46455",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Introducing query caching for async queries in the Athena and Redshift data source plugins. We previously introduced async queries for the Athena and Redshift plugins, and this feature adds support for caching those queries. To use this, you must have query caching enabled for the Athena or Redshift data source you wish to cache. This feature was previously available behind a feature toggle and is now generally available and enabled by default.",
      "headingPath": [
        "What’s new in Grafana v10.3",
        "Data sources",
        "Redshift and Athena: Async query caching"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-3.md",
        "gitBlobSha": "e43fdcd331e25519da2fbdea223ad59ec4f7ad4c",
        "sha256": "0e1c94c3c83b280306b5bf6a8543bb3a2707c17132691f3d48d3818f08b029c7",
        "lineStart": 329,
        "lineEnd": 329,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-3.md#L329-L329"
      },
      "applicability": {
        "status": "oss-labelled-source-candidate-not-yet-reviewed",
        "products": [
          "cloud",
          "enterprise",
          "oss"
        ]
      },
      "atomicity": "unreviewed-may-require-splitting-or-deduplication",
      "acceptanceContract": null,
      "verificationStatus": "not-tested"
    },
    {
      "id": "grafana.candidate.088e38caa4f5078d5826",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "The `useCachingService` feature toggle must also be enabled to use this feature.",
      "headingPath": [
        "What’s new in Grafana v10.3",
        "Data sources",
        "Redshift and Athena: Async query caching"
      ],
      "source": {
        "path": "docs/sources/whatsnew/whats-new-in-v10-3.md",
        "gitBlobSha": "e43fdcd331e25519da2fbdea223ad59ec4f7ad4c",
        "sha256": "0e1c94c3c83b280306b5bf6a8543bb3a2707c17132691f3d48d3818f08b029c7",
        "lineStart": 333,
        "lineEnd": 333,
        "url": "https://raw.githubusercontent.com/grafana/grafana/6193dc03311b631b9727b560d24369e683dc396e/docs/sources/whatsnew/whats-new-in-v10-3.md#L333-L333"
      },
      "applicability": {
