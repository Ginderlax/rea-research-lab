// Preserve an authenticated downloaded backup; never load application code.
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import {createHash} from 'node:crypto';
const work=import.meta.dirname,lab=path.resolve(work,'../outputs/rea-research-lab');
const run=38816488430,artifact=12009924943,artifactSHA256='160d6bed2a77cbab304acfbc3928d5cab5f89087f0bbe1965efe180ec476458f';
const parent=path.join(work,'cloud-verification-backups/run-'+run),backup=path.join(parent,'artifact-'+artifact),source=path.join(backup,'readable-evidence');
const prefix='products/rea-studio/results/cloud-windows-path-installed-pass-20261015',target=path.join(lab,prefix);
const sha=b=>createHash('sha256').update(b).digest('hex'),identity=b=>({bytes:b.length,sha256:sha(b)});
function safe(name){assert(typeof name==='string'&&name&&!/[\\:\x00-\x1f\x7f]/.test(name)&&!name.startsWith('/')&&name.split('/').every(p=>p&&p!=='.'&&p!=='..'));return name;}
function read(base,name){safe(name);let at=base;for(const part of name.split('/')){at=path.join(at,part);assert(!fs.lstatSync(at).isSymbolicLink());}const stat=fs.lstatSync(at);assert(stat.isFile()&&stat.size<=4*1024*1024);const b=fs.readFileSync(at);assert.equal(b.length,stat.size);return b;}
const localBytes=read(backup,'local-backup-verification.json'),local=JSON.parse(localBytes);
assert.equal(local.schema,'rea-local-cloud-attempt-backup/v1');assert.equal(local.artifactSHA256,artifactSHA256);assert.equal(local.allCRCAndBytesReadable,true);
const zip=fs.readFileSync(backup+'.zip');assert.equal(sha(zip),artifactSHA256);assert.equal(zip.length,1481612);
const inventory=new Map();for(const r of local.files){safe(r.path);assert(!inventory.has(r.path));inventory.set(r.path,r);}
function evidence(name){const b=read(source,name),r=inventory.get(name);assert(r);assert.deepEqual(identity(b),{bytes:r.bytes,sha256:r.sha256});return b;}
const a=JSON.parse(evidence('attempt-validation.json')),merge='4a69ae1f8e0156fa9608faf357d415f536ba95f7';
assert.equal(a.repositoryCommit,merge);assert.equal(a.scope,'windows-path-installed');assert.equal(a.status,'passed');assert.equal(a.exitCode,0);
assert.deepEqual(a.summary,{tests:47,pass:47,fail:0,cancelled:0,skipped:0,todo:0,duration_ms:23485.6173});assert.equal(a.sourceFiles,772);assert.equal(a.sourceSnapshotFiles,350);assert.equal(a.sourceStable,true);
assert.deepEqual(evidence('source-before.json'),evidence('source-after.json'));
const initialBytes=evidence('windows-path-installed-source-check.json'),initial=JSON.parse(initialBytes),post=JSON.parse(evidence('windows-path-installed-postrun-source-check.json'));
assert.equal(sha(initialBytes),'59ed23253f9df027191a1c74a8fbb8b9374440828489d60afc5f4124c411f544');assert.equal(initial.status,'verified-unexecuted-committed-afterimages');assert.equal(post.status,'passed');assert.equal(post.sourceStable,true);assert.equal(post.checkedTargets,3);assert.equal(post.initialSourceCheckSHA256,sha(initialBytes));
for(const v of [initial,post]){assert.equal(v.sourceCommit,merge);assert.equal(v.sourceMutationPerformed,false);assert.equal(v.productionInstallationReceiptVerified,false);assert.equal(v.installationPerformedByThisCommand,false);assert.deepEqual(v.gitStatus,[]);assert.equal(v.execution.GITHUB_RUN_ID,String(run));assert.equal(v.execution.GITHUB_RUN_ATTEMPT,'1');}
assert.deepEqual(initial.committedTargets,post.committedTargets);assert.equal(initial.committedTargets.length,3);
assert.equal(a.windowsPathInstalled.gitBaselineEligibleActiveFiles,350);assert.equal(a.windowsPathInstalled.gitBaselineEligibleActiveBytesAuthenticated,true);assert.equal(a.windowsPathInstalled.gitWorkingTreeCleanAfter,true);assert.equal(a.windowsPathInstalled.sha256,sha(initialBytes));
const selection=JSON.parse(evidence('windows-path-mode-selection.json'));assert.equal(selection.status,'selected-committed-source-epoch');assert.equal(selection.mode,'windows-path-installed');assert(selection.committedTargetStates.every(r=>r.state==='after'));
const workflow=JSON.parse(evidence('windows-path-workflow-attempt.json'));assert.equal(workflow.runId,String(run));assert.equal(workflow.selectedScope,'windows-path-installed');assert.equal(workflow.compositionOutcome,'skipped');for(const key of ['epochSelectionOutcome','installedSourceCheckOutcome','testOutcome','postcheckOutcome'])assert.equal(workflow[key],'success');
const alias=a.windowsPathAliasObservation;assert.equal(alias.differentSpelling,true);assert.equal(alias.observedShortComponent,true);assert.equal(alias.syntheticAliasConstructed,false);
const raw=evidence('stdout.txt').toString('utf8');for(const[key,value]of Object.entries(a.summary)){const matches=[...raw.matchAll(new RegExp('^# '+key+' (\\d+(?:\\.\\d+)?)\\r?$','gm'))];assert.equal(matches.length,1);assert.equal(Number(matches[0][1]),value);}assert.equal(evidence('stderr.txt').length,0);
const omitted=[...inventory.values()].filter(r=>r.path.startsWith('source/')).map(r=>({sourcePath:r.path,bytes:r.bytes,sha256:r.sha256}));assert.equal(omitted.length,350);
const retained=[...inventory.keys()].filter(n=>!n.startsWith('source/'));assert(retained.length<=100);
assert(!fs.existsSync(target));fs.mkdirSync(target);fs.mkdirSync(path.join(target,'payload'));
const records=[],objects=new Set();let copied=0;
function save(sourcePath,b){safe(sourcePath);assert(!records.some(r=>r.sourcePath===sourcePath));assert(!/\b(?:ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,}|AKIA[0-9A-Z]{16})\b|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----/.test(b.toString('utf8')));copied+=b.length;assert(copied<=16*1024*1024);const r=identity(b),name='payload/'+r.sha256+'.snapshot';if(!objects.has(name)){fs.writeFileSync(path.join(target,name),b,{flag:'wx'});objects.add(name);}assert.deepEqual(read(target,name),b);records.push({sourcePath,path:name,...r});}
for(const name of retained)save(name,evidence(name));save('local-backup-verification.json',localBytes);save('wrapper-job-log.txt',read(path.join(work,'cloud-verification-backups/job-116702342201'),'logs.txt'));for(const name of ['jobs.json','artifacts.json'])save('control-plane/'+name,read(parent,name));save('backup-reader.py',fs.readFileSync(path.join(work,'unpack-cloud-attempt.py')));save('preservation-collector.mjs',fs.readFileSync(import.meta.filename));
const manifest={schema:'rea-cloud-windows-path-installed-pass-preservation/v1',at:new Date().toISOString(),status:'passed-finite-committed-source-contracts',runId:run,runAttempt:1,jobId:116702342201,runURL:'https://github.com/Ginderlax/rea-research-lab/actions/runs/'+run,sourceCommit:merge,pullRequestHead:'464be289452a4df50fc1af14a27685e0dbfb2eec',testedReference:'refs/pull/1/merge',artifactId:artifact,artifactSHA256,artifactBytes:1481612,summary:a.summary,sourceFiles:772,sourceStable:true,activeSourceSnapshotsInVerifiedLocalBackup:350,committedCurrentAfterImages:initial.committedTargets,allEligibleActiveSourcesAuthenticatedToGit:350,gitWorkingTreeCleanAfter:true,sourceMutationPerformedByWorkflow:false,productionInstallationReceiptVerifiedByWorkflow:false,localSourceInstallationReceipt:'products/rea-studio/results/windows-path-installed-20261015/installation-receipt.json',localSourceInstallationReceiptSHA256:'6523a7c30a99077af473620305e46409838f174f764f69e8a6b065071c975417',actualWindowsShortPathObservation:alias,separatePostrunSourceCheck:'passed',completeReadableLocalBackupVerified:true,localBackupFiles:inventory.size,retainedArtifactFiles:retained.length,publicSourceSnapshotPayloads:0,omittedSourceSnapshotPayloads:omitted,records,uniqueInertObjects:objects.size,allCopiesExact:true,allPayloadsInert:true,completedTestReceipt:true,fullDevelopmentSuiteAcceptance:false,browserAcceptance:false,historicalReceiptsRebound:false,fullParity:false,superiority:false,localProductExecutions:0,localTests:0,localBuilds:0,acceptanceScope:'47 finite Editor Git/Sync WebDAV checks passed on clean committed after-images with an actual Windows short-root spelling. All350 eligible active sources were Git-bound and the separate same-attempt postcheck passed. The source-installation receipt is a separate local authoring record, not authenticated by this workflow. Full-suite, browser and all-product acceptance remain separate.'};
const b=Buffer.from(JSON.stringify(manifest,null,2)+'\n');fs.writeFileSync(path.join(target,'preservation-manifest.json'),b,{flag:'wx'});
const result={prefix,manifestSHA256:sha(b),records:records.length,objects:objects.size,retainedArtifactFiles:retained.length,omittedSnapshots:350,verifiedReadableFiles:inventory.size,summary:a.summary,localProductExecutions:0};fs.writeFileSync(path.join(work,'cloud-recovery-20261015/windows-path-installed-pass-preservation.json'),JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify(result));
