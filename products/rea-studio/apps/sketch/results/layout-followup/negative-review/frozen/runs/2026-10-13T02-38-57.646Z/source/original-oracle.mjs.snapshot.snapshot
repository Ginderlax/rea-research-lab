const counts={groups:0,bounds:0,align:0,distribute:0,elementBounds:0,boundTextNoOp:0,bindingNoOp:0,clock:0,random:0,sceneLookup:0,elbowPredicate:0},unreachable=()=>{throw new Error('Fixture reached an excluded original dependency');},adapter={arrayToMap:es=>new Map(es.map(e=>[e.id,e])),Scene:{getScene:()=>{counts.sceneLookup++;return undefined;}},ShapeCache:{delete:unreachable},isElbowArrow:e=>{counts.elbowPredicate++;assert.notEqual(e.elbowed,true);return false;},getSizeFromPoints:unreachable,toBrandedType:unreachable,updateElbowArrowPoints:unreachable,getUpdatedTimestamp:()=>{counts.clock++;return 987;},randomInteger:()=>{counts.random++;return 321;},getBoundTextElement:()=>{counts.boundTextNoOp++;return null;},updateBoundElements:()=>{counts.bindingNoOp++;},getElementBounds:e=>{counts.elementBounds++;assert.equal(e.angle,0);if(e.points){const points=e.points.map(p=>[e.x+p[0],e.y+p[1]]);return[Math.min(...points.map(p=>p[0])),Math.min(...points.map(p=>p[1])),Math.max(...points.map(p=>p[0])),Math.max(...points.map(p=>p[1]))];}return[Math.min(e.x,e.x+e.width),Math.min(e.y,e.y+e.height),Math.max(e.x,e.x+e.width),Math.max(e.y,e.y+e.height)];}};
