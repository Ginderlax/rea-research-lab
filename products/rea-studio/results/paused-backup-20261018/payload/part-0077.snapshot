    {
      "id": "grafana.candidate.b909a8053a4299a03c3c",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "For enhanced security, set `cookie_secure` to `true`, which forces cookies to be sent only via HTTPS.",
      "headingPath": [
