import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';
const c=JSON.parse(await fs.readFile(path.join(import.meta.dirname,'.local/private-control.json')));assert.equal(c.pid,66028);assert.equal(c.hostURL,'http://127.0.0.1:61576');const url=new URL(c.url);assert.equal(url.hostname,'127.0.0.1');assert.equal(url.pathname,'/close');
const r=await fetch(c.url,{method:'POST',headers:{'x-owned-control':c.token},signal:AbortSignal.timeout(10000)});assert.equal(r.status,200);console.log(JSON.stringify({ownedShutdownRequested:true,status:r.status}));
