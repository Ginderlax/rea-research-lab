    {
      "id": "grafana.candidate.31b0bcd36dee96632ead",
      "syntaxRole": "table-row",
      "sourceText": "| Size | Configures the size of the nodes. The default is `Fixed size`, which makes all node sizes the same regardless of the data; however, there is also an option to size the nodes based on data corresponding to a selected field. `Min` and `Max` node sizes have to be set such that the nodes can scale within this range. |",
      "headingPath": [
        "Geomap",
        "Configuration options",
        "Map layers options",
        "Network layer",
        "Node styles options"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/geomap/index.md",
        "gitBlobSha": "63538536072461656f914e26183413137e6e6b8c",
