    {
      "id": "grafana.candidate.7f41003c12461f459ba4",
      "syntaxRole": "list-item",
      "sourceText": "- **Include frozen indices** - Toggle on when the `X-Pack enabled` setting is active. Includes frozen indices in searches. You can configure Grafana to include [frozen indices](https://www.elastic.co/guide/en/elasticsearch/reference/7.13/frozen-indices.html) when performing search requests.",
      "headingPath": [
        "Configure the Elasticsearch data source",
        "Additional settings",
        "Elasticsearch details"
      ],
