import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
const here=import.meta.dirname,sha=b=>createHash('sha256').update(b).digest('hex'),source=await fs.readFile(path.join(here,'independent.test.mjs'),'utf8'),old="f.read().records[f.parent].props.deleted_time,'0'",replacement="f.read().records[f.parent].props.deleted_time??'0','0'";assert.equal(source.split(old).length,2);const corrected=source.replace(old,replacement);await fs.writeFile(path.join(here,'independent-v2.test.mjs'),corrected,{flag:'wx'});
let runner=await fs.readFile(path.join(here,'run.mjs'),'utf8');runner=runner.replace("const before=JSON.parse", "const out=path.join(here,'runs/final-model');await fs.mkdir(out,{recursive:true});const write=(n,v)=>fs.writeFile(path.join(out,n),JSON.stringify(v,null,2)+'\\n',{flag:'wx'});\nconst before=JSON.parse").replaceAll("await save(","await write(").replace("'run.mjs','fixture.mjs','fresh-replay.test.mjs','independent.test.mjs'","'run-final.mjs','fixture.mjs','fresh-replay.test.mjs','independent-v2.test.mjs'").replace("path.join(here,'observations')","path.join(out,'observations')").replace("'fresh-replay.test.mjs','independent.test.mjs'","'fresh-replay.test.mjs','independent-v2.test.mjs'").replace("path.join(here,'tests.'+name+'.txt')","path.join(out,'tests.'+name+'.txt')");await fs.writeFile(path.join(here,'run-final.mjs'),runner,{flag:'wx'});
await fs.writeFile(path.join(here,'review-test-version-correction.json'),JSON.stringify({initial:{path:'independent.test.mjs',bytes:Buffer.byteLength(source),sha256:sha(source)},corrected:{path:'independent-v2.test.mjs',bytes:Buffer.byteLength(corrected),sha256:sha(corrected)},change:{old,replacement,reason:'An active created folder may omit deleted_time. Omitted active time has the same semantic zero value; initial strict explicit0 assertion was a reviewer fixture mistake.'},cancelFollowupReadAssertion:'Unchanged: retains the genuine finite failing Cancel/no-follow-up-read policy check.',candidateSourceChanges:0,initialRawAndObservationsUnchanged:true},null,2)+'\n',{flag:'wx'});
