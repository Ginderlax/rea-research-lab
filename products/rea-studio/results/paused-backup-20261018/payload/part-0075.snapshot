    },
    {
      "id": "grafana.candidate.7e93edc9d2fdd0ef1473",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Use the **Endpoint** field to specify a custom endpoint URL that overrides the default AWS service API endpoint. Leave this field blank to use the default generated endpoint.",
      "headingPath": [
        "Configure AWS authentication",
        "Use a custom endpoint"
      ],
      "source": {
        "path": "docs/sources/datasources/aws-cloudwatch/aws-authentication/index.md",
