    {
      "id": "grafana.candidate.91f25db2a0f101d06b60",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "To learn more about Team Sync, refer to [Configure Team Sync](https://grafana.com/docs/grafana/<GRAFANA_VERSION>/setup-grafana/configure-access/configure-team-sync/).",
      "headingPath": [
