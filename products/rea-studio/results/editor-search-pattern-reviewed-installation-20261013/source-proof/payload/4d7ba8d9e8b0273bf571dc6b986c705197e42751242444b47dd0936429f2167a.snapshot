import fs from'node:fs/promises';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const here=import.meta.dirname,workspace=path.resolve(here,'../..'),folder='work/editor-search-pattern-independent-review',root=path.join(workspace,folder),sha=b=>createHash('sha256').update(b).digest('hex'),id=b=>({bytes:b.length,sha256:sha(b)}),name='review-manifest.json',mb=await fs.readFile(path.join(root,name));assert.equal(sha(mb),'76c89a780e5c8e2a7774d925073b500a1e8a5f5c164c86a6e4e71b809717db31');const m=JSON.parse(mb),rows=Object.entries(m.inventory).map(([path,r])=>({path,...r}));assert.equal(rows.length,141);async function strict(){const names=[];async function walk(f=''){for(const e of await fs.readdir(path.join(root,f),{withFileTypes:true})){assert.equal(e.isSymbolicLink(),false);const p=f?f+'/'+e.name:e.name;if(e.isDirectory())await walk(p);else{assert.ok(e.isFile());names.push(p);}}}await walk();assert.deepEqual(names.sort(),[...rows.map(r=>r.path),name].sort());for(const r of rows)assert.deepEqual(id(await fs.readFile(path.join(root,r.path))),{bytes:r.bytes,sha256:r.sha256});}await strict();const selected=[...rows.filter(r=>r.path==='review-validation.json'||r.path==='finding.json'||r.path==='browser-host.mjs'||r.path==='stop-owned-browser-host.ps1'||r.path.startsWith('runs/browser-')&&!r.path.includes('/source/')),{path:name,...id(mb)}];for(const r of selected){const b=await fs.readFile(path.join(root,r.path)),out=path.join(here,'history/negative141-reference',r.path+'.snapshot');assert.deepEqual(id(b),{bytes:r.bytes,sha256:r.sha256});await fs.mkdir(path.dirname(out),{recursive:true});await fs.writeFile(out,b,{flag:'wx'});}await strict();await fs.writeFile(path.join(here,'negative-reference.json'),JSON.stringify({sourceRoot:folder,manifest:{path:name,...id(mb)},schema:m.schema,strictPayloads141BeforeAfter:true,full141PayloadsNotRecopied:true,selectedExactRawRecords:selected,reviewSHA256:'c1844013df67cdb8be1d1e414e3ebd84ef10674079afec172860719da5b9abc4',findingSHA256:'e255c66d0c4fab1f1e8fca5e0e26ee328dc5afffd3abfa1b03af7466aa2788a1',browserFailureAndProductionControlPreserved:true,sourceCoreFresh16Passed:true,originalFresh6Exact30Positions2UnequalAndErrorPresenceOnlyPreserved:true,originalEngineCalls:10,newOriginalCalls:0,nativeWireLogsDurable:false,localScreenshot:false,forcedOwnedCleanupDisclosed:true,fullProductParity:false},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({strict141BeforeAfter:true,selectedRetained:selected.length,allHistoricalBytesUnchanged:true,appCalls:0}));
