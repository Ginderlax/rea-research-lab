    },
    {
      "id": "grafana.candidate.c2faf603adb899edcc83",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "You must escape the dollar (`$`) character in YAML values because it can be used to interpolate environment variables:",
