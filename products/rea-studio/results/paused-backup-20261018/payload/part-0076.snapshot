    {
      "id": "grafana.candidate.524ced54909ec099775b",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Reference the variable in a query with its name, prefixed by `$`. For a single-value variable, use an exact match:",
      "headingPath": [
        "Loki template variables",
