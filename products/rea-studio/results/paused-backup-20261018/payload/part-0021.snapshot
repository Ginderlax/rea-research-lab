"""Read fixed source JSON constants and backups; never import or execute candidates."""
import gzip
import hashlib
import json
import subprocess
from pathlib import Path

work = Path(__file__).resolve().parent
repo = work.parent / 'outputs' / 'rea-research-lab'
stage = work / 'notes-installed-source-proof-phase12-next'
candidate = stage / 'candidate'
ident = lambda data: {'bytes': len(data), 'sha256': hashlib.sha256(data).hexdigest()}
pin = lambda row: {key: row[key] for key in ('bytes', 'sha256')}
authority_bytes = (stage / 'change-authority.json').read_bytes()
assert ident(authority_bytes) == {'bytes': 12211, 'sha256': '2fa1c7435a085fd45c9a61b9563561b99be4578134b0815082257249bf6513c2'}
authority = json.loads(authority_bytes)
assert len(authority['files']) == authority['candidateFiles'] == 21
assert len({row['path'] for row in authority['files']}) == 21
assert {path.relative_to(candidate).as_posix() for path in candidate.rglob('*') if path.is_file()} == {row['path'] for row in authority['files']}
total = 0
for row in authority['files']:
    data = (candidate / row['path']).read_bytes()
    assert ident(data) == row['after'], row['path']
    total += len(data)
    if row['before'] is not None:
        previous = subprocess.run(['git', '-C', str(repo), 'show', authority['baseCommit'] + ':' + row['path']], capture_output=True, check=True, timeout=30).stdout
        assert ident(previous) == row['before']
assert total == authority['candidateBytes'] == 1057619

def literal(text, marker):
    start = text.index(marker) + len(marker)
    value, length = json.JSONDecoder().raw_decode(text[start:])
    assert text[start + length:].lstrip().startswith(';')
    return value

module = (candidate / 'scripts/editor-vault-proof-migration.mjs').read_text(encoding='utf-8')
plan = literal(module, 'const notesSourceTransition=')
producer = (candidate / 'scripts/verify-cloud-publication.mjs').read_text(encoding='utf-8')
projection = literal(producer, 'const NOTES_REVIEWED=')
assert len(plan['objects']) == len(projection) == 52 and len(plan['roles']) == 55
objects = {row['path']: row for row in plan['objects']}
assert len(objects) == 52 and set(objects) == set(projection)
stored_total = 0
for name, row in objects.items():
    path = candidate / name if (candidate / name).is_file() else repo / name
    data = path.read_bytes()
    assert ident(data) == row['stored']
    assert [len(data), ident(data)['sha256']] == projection[name]
    assert len(data) <= 256 * 1024
    stored_total += len(data)
assert stored_total <= 8 * 1024 * 1024
roles, decoded_total, decoded = {}, 0, {}
for row in plan['roles']:
    assert row['path'] in objects and row['stored'] == objects[row['path']]['stored']
    path = candidate / row['path'] if (candidate / row['path']).is_file() else repo / row['path']
    stored = path.read_bytes()
    if row.get('decoded') is not None:
        assert row['encoding'] in ('identity', 'gzip')
        raw = gzip.decompress(stored) if row['encoding'] == 'gzip' else stored
        assert len(raw) <= 256 * 1024 and ident(raw) == row['decoded']
    else:
        raw = stored
    decoded_total += len(raw)
    roles[row['role']] = roles.get(row['role'], 0) + 1
    if row['role'].startswith(('immutable-Notes92/', 'immutable-Notes8/')):
        assert roles[row['role']] == 1
        decoded[row['role']] = raw
    if row['role'].startswith('immutable-Notes92/'):
        name = row['role'].removeprefix('immutable-Notes92/')
        original = work / 'cloud-verification-backups/run-38903252258/artifact-12047197582/readable-evidence' / name
        assert original.read_bytes() == raw
    if row['role'].startswith('immutable-Notes8/artifact/'):
        name = row['role'].removeprefix('immutable-Notes8/artifact/')
        original = work / 'cloud-verification-backups/run-38908759571/artifact-12049048068-reader-v2/readable-evidence' / name
        assert original.read_bytes() == raw
bundle = json.loads((repo / plan['bundle']['path']).read_bytes())
assert ident((repo / plan['bundle']['path']).read_bytes()) == pin(plan['bundle'])
assert len(bundle['payloads']) == 17 and len(bundle['transitions']) == len(plan['sources']) == 8
for row in bundle['payloads']:
    name = 'products/rea-studio/experiments/notes-todo/' + row['path']
    assert objects[name]['stored'] == pin(row)
for row in plan['sources']:
    original = next(item for item in bundle['transitions'] if item['target'] == row['path'])
    assert row['after'] == pin(original['after'])
    assert row['afterImage'] in objects
    assert objects[row['path']]['stored'] == objects[row['afterImage']]['stored'] == row['after']
    if row['before'] is not None:
        assert row['before'] == pin(original['before'])
        assert objects[row['beforeImage']]['stored'] == row['before']
    else:
        assert original['before'] is None and row['beforeImage'] is None
assert len([row for row in plan['sources'] if row['before'] is not None]) == 3
for row in plan['readerBeforeImages']:
    assert objects[row['path']]['stored'] == pin(row)
    previous = subprocess.run(['git', '-C', str(repo), 'show', authority['baseCommit'] + ':' + row['reader']], capture_output=True, check=True, timeout=30).stdout
    assert ident(previous) == pin(row)
for row in plan['currentVerifierAfter']:
    assert ident((candidate / row['path']).read_bytes()) == pin(row)
fragment = (work / 'notes-installed-proof-function.fragment.txt').read_text(encoding='utf-8').strip()
actual_fragment = module[module.index('function verifyNotesSourceTransition('):module.index('export function createEditorVaultProofMigration(')].strip()
assert actual_fragment == fragment
source_declaration = json.loads((candidate / plan['manifest']['path']).read_bytes())
source_index = json.loads((candidate / plan['index']['path']).read_bytes())
assert source_declaration['sources'] == source_index['currentTargets'] == plan['sources']
assert source_declaration['readerBeforeImages'] == plan['readerBeforeImages']
assert source_declaration['currentVerifierAfter'] == plan['currentVerifierAfter']
assert source_declaration['publicationIndex'] == plan['index']
result = {'schema': 'rea-notes-installed-phase12-independent-byte-audit/v1', 'authority': ident(authority_bytes), 'candidateFiles': 21, 'candidateBytes': total, 'allCandidatePinsExact': True, 'allReplacementBeforeImagesMatchedExact016GitBytes': True, 'closedPhysicalPaths': len(objects), 'logicalRoles': len(plan['roles']), 'closedStoredBytes': stored_total, 'decodedLogicalRoleBytes': decoded_total, 'maxStoredFileBytes': max(row['stored']['bytes'] for row in objects.values()), 'all52ObjectsAndProducerProjectionExact': True, 'all55LogicalStoredAndDecodedRoleIdentitiesExact': True, 'selectedHistoricalArtifactRolesMatchedOriginalReadableBackups': True, 'immutableBundle17PayloadsAndEightAfterAliasesAuthenticated': True, 'exactThreeAppBeforeAndThreeReaderBeforeImagesAuthenticated': True, 'newCurrentRootAndFollowupPinsExact': True, 'fragmentMatchesCompleteCandidateFunction': True, 'localCandidateImports': 0, 'localProductExecutions': 0, 'localTests': 0, 'localBuilds': 0, 'activeRepositoryMutations': 0}
with (work / 'notes-installed-phase12-independent-byte-audit-20261016.json').open('x', encoding='utf-8') as stream:
