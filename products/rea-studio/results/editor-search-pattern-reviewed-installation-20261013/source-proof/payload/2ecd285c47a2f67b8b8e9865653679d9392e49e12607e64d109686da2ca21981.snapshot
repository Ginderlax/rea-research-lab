      "after": "          const selection=textareaSelection(item.content,match.start,match.end,editor.value);\n          if(!selection){state.textContent='The saved result does not match the text shown or its positions. Save or reopen the file, then search again.';return;}\n          editor.focus();editor.setSelectionRange(selection.start,selection.end);state.textContent=",
