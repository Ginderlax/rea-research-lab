   expected_row=physical[name];read_path=safe(row['readPath']);need(read_path==expected_row['readPath'] and row['sourceEpoch']==details['historicalSourceEpoch'] and row['historicalView'] is True,'Historical logical-to-physical mapping/epoch')
   need(row['group']==('historical52-proof' if name in tables['NOTES_REVIEWED'] else 'historical4-installed-tooling'),'Historical group is not current behavior')
