    {
      "id": "grafana.candidate.65317ac176ce7dfa5a7d",
      "syntaxRole": "table-row",
      "sourceText": "| Graph mode | Select a graph sparkline mode. Choose from: <ul><li>**None** - Hides the graph sparkline and only shows the value.</li><li>**Area** - Shows the graph sparkline in the background of the value. This requires that your query returns a time column.</li></ul> The graph sparkline is automatically hidden if the panel becomes too small.|",
      "headingPath": [
        "Stat",
        "Configuration options",
        "Stat styles"
      ],
      "source": {
        "path": "docs/sources/visualizations/panels-visualizations/visualizations/stat/index.md",
