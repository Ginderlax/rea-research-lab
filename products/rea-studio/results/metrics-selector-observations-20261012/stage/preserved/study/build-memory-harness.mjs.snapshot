import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {here,sha} from './authenticate-original.mjs';
const changes=[];
function replace(source,from,to,label){assert.ok(source.includes(from),'Missing exact baseline '+label);changes.push(label);return source.replace(from,to);}
let worker=await fs.readFile(path.join(here,'preserved/harness-baseline/memory-worker.mjs'),'utf8');
worker=replace(worker,"import {canonical,packet,valuesFor,metadataFor} from './canonical.mjs';","import {canonical,packet,metadataFor} from './canonical.mjs';\nimport {valuesForSpec} from './workloads.mjs';",'worker input generator');
worker=replace(worker,"variant='standard'","variant='control'",'worker variant default');worker=replace(worker,"['standard','percentile'].includes(variant)","variant==='control'",'worker variant guard');
worker=replace(worker,"const checkpoints=[]","assert.equal(sha(await fs.readFile(path.join(here,'workloads.mjs'))),manifest.workloadSourceSHA256);\nconst checkpoints=[]",'worker workload-source binding');
worker=replace(worker,'values=valuesFor(spec.n)','values=valuesForSpec(spec)','worker selected fixed input');
worker=replace(worker,'comparisons++;};','comparisons++;assert.equal(sha(canonical(packet(pair.field,native.reduceField({field:pair.field,reducers:spec.reducers})))),fixture.repeatOutputSHA256);comparisons++;assert.equal(sha(canonical(packet(pair.field,native.reduceField({field:pair.field,reducers:[spec.reducers[0]]})))),fixture.subsetOutputSHA256);comparisons++;};','worker repeated/cache reads outside snapshots');
worker=replace(worker,"caseName:mode==='check-only'?'all-five':caseName","caseName:mode==='check-only'?'all-seven':caseName",'worker seven-case label');
worker=replace(worker,'loadedReducerImplementations:1,loadedCJSModules','loadedReducerImplementations:1,loadedNativeModuleFiles:selected.format===\'esm\'?Object.keys(selected.files).length:undefined,loadedCJSModules','worker two native modules one reducer disclosure');
worker=replace(worker,"Returned/cache results are validated after retained snapshot and before release/GC.","Returned/cache results and two cached rereads per retained field are validated after retained snapshot and before release/GC.",'worker serializer pressure disclosure');
let runner=await fs.readFile(path.join(here,'preserved/harness-baseline/memory-runner.mjs'),'utf8');
runner=replace(runner,"variant='standard'","variant='control'",'runner variant default');runner=replace(runner,"['standard','percentile'].includes(variant)","variant==='control'",'runner variant guard');
runner=replace(runner,"'authenticate-original.mjs'],before={}","'authenticate-original.mjs','workloads.mjs','candidate-baseline.mjs','candidate-module-control.mjs','selector-control.mjs'],before={}",'runner both-module/controller bindings');
runner=replace(runner,'sample.result.comparisons,5','sample.result.comparisons,21','runner seven-case reread count');
runner=replace(runner,"assert.equal(JSON.parse(fullBytes).status,'passed');assert.equal(JSON.parse(fullBytes).implementationSha256,Object.values(manifest.implementations.candidate.files)[0]);","const full=JSON.parse(fullBytes);assert.equal(full.failedAcceptanceAttempts,0);assert.equal(full.bothNativeModulesBoundBeforeAndAfter,true);assert.equal(full.candidate.entrySHA256,before['candidate-module-control.mjs']);assert.equal(full.candidate.helperSHA256,before['selector-control.mjs']);",'runner preserved exact two-module semantic receipt');
runner=replace(runner,'for(const fixture of Object.values(manifest.expectedFiles))assert.equal(sha(await fs.readFile(path.join(here,fixture.path))),fixture.sha256);','for(const fixture of Object.values(manifest.expectedFiles)){assert.equal(sha(await fs.readFile(path.join(here,fixture.path))),fixture.sha256);assert.equal(sha(await fs.readFile(path.join(here,fixture.inputPath))),fixture.inputFileSHA256);}', 'runner actual input fixture binding');
runner=replace(runner,"run(implementation,'all-five',0)","run(implementation,'all-seven',0)",'runner seven-case label');
for(const[name,source]of [['memory-worker.mjs',worker],['memory-runner.mjs',runner]])await fs.writeFile(path.join(here,name),source,{flag:'wx'});
await fs.writeFile(path.join(here,'memory-adaptation.json'),JSON.stringify({schemaVersion:1,changes,workerSHA256:sha(worker),runnerSHA256:sha(runner),lifecycleAndObserverHandshakeBodiesPreserved:true,measuredWarmTransientRetentionAndGCSnapshotLoopsPreserved:true,changeInValidationPressure:'Fresh packet plus two cached rereads are serialized for every retained field after retained snapshot; release/RSS can reflect common serializer capacity.',memoryMeasurementRun:false},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({changes:changes.length,measurementRun:false}));
