// Strict work-only proposal freeze; no new proof or application execution.
import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';const root=import.meta.dirname,hash=b=>createHash('sha256').update(b).digest('hex'),records=[];
async function walk(d,p=''){for(const e of(await fs.readdir(d,{withFileTypes:true})).sort((a,b)=>a.name.localeCompare(b.name))){assert.equal(e.isSymbolicLink(),false);const n=p+e.name,q=path.join(d,e.name);if(e.isDirectory())await walk(q,n+'/');else{assert.ok(e.isFile());assert.notEqual(n,'freeze-manifest.json');const b=await fs.readFile(q);records.push({path:n,bytes:b.length,sha256:hash(b)});}}}const validation=await fs.readFile(path.join(root,'validation.json'));assert.equal(JSON.parse(validation).sourceOnlyInstalledVerificationAccepted,true);await walk(root);const m={schema:'rea-sketch-layout-root-proof-integration-proposal-freeze/v1',at:new Date().toISOString(),files:records.length,totalBytes:records.reduce((n,r)=>n+r.bytes,0),records,selfExcluded:true,validationSHA256:hash(validation),sourceOnly:true,productionWrites:0},b=Buffer.from(JSON.stringify(m,null,2)+'\n');await fs.writeFile(path.join(root,'freeze-manifest.json'),b,{flag:'wx'});for(const r of records){const b=await fs.readFile(path.join(root,r.path));assert.equal(b.length,r.bytes);assert.equal(hash(b),r.sha256);}console.log(JSON.stringify({files:m.files,bytes:m.totalBytes,manifestSHA256:hash(b),validationSHA256:hash(validation),sourceOnlyAccepted:true}));
