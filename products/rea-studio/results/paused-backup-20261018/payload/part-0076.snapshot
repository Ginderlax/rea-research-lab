    {
      "id": "grafana.candidate.15feba29361915d8bc57",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "After configuring your Graphite data source options, click **Save & test** at the bottom to test the connection. You should see a confirmation dialog box that says:",
      "headingPath": [
        "Configure the Graphite data source",
        "Configuration options in the UI"
      ],
