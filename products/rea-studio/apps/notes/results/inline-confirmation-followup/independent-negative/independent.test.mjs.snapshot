import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs/promises';
import {ui,gate,find} from './fixture.mjs';
const observations=[],dialog=f=>find(f.root,n=>n.attributes.role==='alertdialog'),button=(p,s)=>find(p,n=>n.tagName==='button'&&n.textContent===s),mutations=f=>f.calls.filter(r=>['notebook-trash','notebook-restore'].includes(r.action)),status=f=>find(f.root,n=>n.attributes.role==='status');
function key(p,k,shiftKey=false){let prevented=false;p.onkeydown({key:k,shiftKey,preventDefault(){prevented=true;}});return prevented;}
function snapshot(root){return JSON.stringify(root,(k,v)=>k==='onclick'||k.startsWith('on')?undefined:v);}
test('cancel then select child and reopen ignores retained old Confirm and mutates only newly named child',async t=>{
 const f=await ui(t);f.manage();const first=f.click(f.byText('Move notebook to trash')),old=button(dialog(f),'Confirm move to trash');await f.click(button(dialog(f),'Cancel'));await first;const choice=f.byLabel('Manage notebook');choice.value=f.child;choice.onchange();const next=f.click(f.byText('Move notebook to trash')),panel=dialog(f);assert.match(panel.children[1].textContent,/Parent.*Child/);await old.onclick();assert.equal(mutations(f).length,0);assert.equal(dialog(f),panel);await f.click(button(panel,'Confirm move to trash'));await next;assert.deepEqual(mutations(f).map(c=>c.input.id),[f.child]);assert.equal(f.read().records[f.parent].props.deleted_time,'0');assert.notEqual(f.read().records[f.child].props.deleted_time,'0');assert.equal(choice.value,f.child);observations.push({case:'cancel/reselect/retained old button',mutations:1,target:'child',parentActive:true});
});
test('confirmed Restore remains a single request while held; pending reverse Tab focuses dialog and Escape does not cancel commit',async t=>{
 const g=gate();let held=false;const f=await ui(t,async({action})=>{if(action==='notebook-restore'&&held){g.enter();await g.held;}});f.manage();await f.confirmNotebook('Move notebook to trash');held=true;const p=f.confirmNotebook('Restore notebook');await g.started;const panel=dialog(f);assert.ok(!f.read().notes[f.note.id].deletedAt);assert.equal(key(panel,'Tab',true),true);assert.equal(document.activeElement,panel);assert.equal(key(panel,'Escape'),true);await button(panel,'Confirm restore notebook').onclick();await button(panel,'Cancel').onclick();assert.deepEqual(mutations(f).map(c=>c.action),['notebook-trash','notebook-restore']);g.release();await p;assert.equal(dialog(f),null);assert.equal(f.byLabel('Manage notebook').value,f.parent);observations.push({case:'held Restore duplicate/keyboard',mutations:2});
});
test('dispose during post-commit note read suppresses late acceptance and all later reads',async t=>{
 const g=gate();let held=false;const f=await ui(t,async({action})=>{if(action==='get'&&held){g.enter();await g.held;}});await f.open();f.manage();held=true;const p=f.confirmNotebook('Move notebook to trash');await g.started;assert.ok(f.read().notes[f.note.id].deletedAt);f.dispose();const before=snapshot(f.root),count=f.calls.length;g.release();await p;assert.equal(snapshot(f.root),before);assert.equal(f.calls.length,count);observations.push({case:'dispose while post-commit get held',committed:true,latePublications:0,lateReads:0});
});
test('dispose during post-commit first refresh read suppresses notebook-list and late view writes',async t=>{
 const g=gate();let held=false;const f=await ui(t,async({action})=>{if(action==='list'&&held){g.enter();await g.held;}});f.manage();held=true;const p=f.confirmNotebook('Move notebook to trash');await g.started;f.dispose();const before=snapshot(f.root),count=f.calls.length;g.release();await p;assert.equal(snapshot(f.root),before);assert.equal(f.calls.length,count);observations.push({case:'dispose during list',latePublications:0,lateReads:0});
});
test('held second refresh read keeps typing and notebook selection disabled; disposing refuses late publication',async t=>{
 const g=gate();let held=false;const f=await ui(t,async({action})=>{if(action==='notebook-list'&&held){g.enter();await g.held;}});await f.open();f.manage();held=true;const p=f.confirmNotebook('Move notebook to trash');await g.started;assert.equal(f.byLabel('Manage notebook').disabled,true);assert.equal(f.byLabel('Markdown note').disabled,true);assert.throws(()=>f.type(f.byLabel('Markdown note'),'Impossible disabled typing'),/disabled/);f.dispose();const before=snapshot(f.root),count=f.calls.length;g.release();await p;assert.equal(snapshot(f.root),before);assert.equal(f.calls.length,count);observations.push({case:'held notebook-list',ordinaryTypingBlocked:true,latePublications:0});
});
test('late rejected persistence after disposal publishes no error and does not change owned state',async t=>{
 const g=gate();const f=await ui(t);f.manage();const before=JSON.stringify(f.read());f.store.set=async()=>{g.enter();await g.held;throw new Error('Owned deferred persistence rejection');};const p=f.confirmNotebook('Move notebook to trash');await g.started;f.dispose();const text=status(f).textContent,count=f.calls.length;g.release();await p;assert.equal(status(f).textContent,text);assert.equal(JSON.stringify(f.read()),before);assert.equal(f.calls.length,count);assert.equal(dialog(f),null);observations.push({case:'dispose before rejected persistence',mutation:false,errorPublication:false});
});
test('clean notebook cancellation preserves active note revision/body, all preexisting inert flags and trigger focus',async t=>{
 const f=await ui(t);await f.open();f.manage();for(let i=0;i<f.root.children.length;i++)f.root.children[i].inert=i%2===0;const inert=f.root.children.map(n=>n.inert),body=f.byLabel('Markdown note').value,rev=f.read().notes[f.note.id].revision,count=f.calls.length;const p=f.click(f.byText('Move notebook to trash')),panel=dialog(f);assert.equal(key(panel,'Tab',true),true);assert.equal(document.activeElement,button(panel,'Confirm move to trash'));key(panel,'Escape');await p;assert.deepEqual(f.root.children.map(n=>n.inert),inert);assert.equal(f.byLabel('Markdown note').value,body);assert.equal(f.read().notes[f.note.id].revision,rev);assert.equal(f.calls.length,count);assert.equal(document.activeElement,f.byText('Move notebook to trash'));observations.push({case:'cancel clean revision/inert',stateUnchanged:true});
});
test.after(async()=>{const folder=new URL(process.env.NOTES_REVIEW_OUTPUT);await fs.mkdir(folder,{recursive:true});await fs.writeFile(new URL('independent.json',folder),JSON.stringify(observations,null,2)+'\n');});
