    {
      "id": "grafana.candidate.ac878400152c79df11a6",
      "syntaxRole": "declarative-or-imperative-paragraph",
      "sourceText": "Set this when `[server] root_url` points at a cluster-internal address (for example, when Grafana runs behind a private ingress) but provisioning needs an externally-reachable host. This is analogous to `[rendering] callback_url`, which serves the same purpose for the image renderer plugin.",
      "headingPath": [
        "Configure Grafana",
        "Configuration options",
        "`[provisioning]`",
        "`public_root_url`"
      ],
      "source": {
